<http://radio.liv.ac.uk/bme/HumanMadeObject/f8a0d7e4> a crm:E22_Human-Made_Object ;
    scho:identifier "f8a0d7e4" ;
    scho:name "John Lennon's Round 'Granny' Glasses" ;
    scho:description "A pair of round, nickel-rimmed glasses famously worn by John Lennon during the mid-to-late 1960s. This style became an inseparable part of his public image during the psychedelic era and his subsequent solo career." ;
    scho:caption "The iconic eyewear of a music and cultural legend. These glasses were a key element of John Lennon's distinctive look, symbolizing his transformation from Beatle to countercultural icon. Worn during the height of The Beatles' fame and throughout his solo career, they remain a powerful emblem of his enduring influence on music and popular culture." ;
    scho:category wd:Q115866017 ;
    scho:additionalType aat:300236409 ;
    scho:itemLocation "6" ;
    scho:isPartOf <http://radio.liv.ac.uk/bme/Exhibition/Zone3> ;
    scho:image <https://c.files.bbci.co.uk/c24f/live/b4199d60-4e81-11ef-8b97-e7e1e12cdeb2.jpg> ;
