        </skos:inScheme>
        <skos:inScheme rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/Subject">
        </skos:inScheme>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1070958">
        </skos:exactMatch>
    </rdf:Description>
