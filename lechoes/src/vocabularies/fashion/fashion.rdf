        <skos:prefLabel xml:lang="it">acquerello</skos:prefLabel>
        <skos:prefLabel xml:lang="sr">akvarel</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">akvarell</skos:prefLabel>
