        <skos:prefLabel xml:lang="nl">kaardersborstel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Rectangular wooden block with iron pins to untangle rabbit and hare skins and remove dirt.</skos:scopeNote>
