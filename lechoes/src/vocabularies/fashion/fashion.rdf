        <skos:prefLabel xml:lang="nl">piepschuim</skos:prefLabel>
        <skos:prefLabel xml:lang="es">poliestireno</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">poliestireno</skos:prefLabel>
