        <skos:prefLabel xml:lang="fr">polystyrène</skos:prefLabel>
        <skos:prefLabel xml:lang="el">Πολυστυρένιο</skos:prefLabel>
        <skos:prefLabel xml:lang="sr">полистирен</skos:prefLabel>
