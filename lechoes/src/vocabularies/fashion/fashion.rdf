        <skos:prefLabel xml:lang="fr">fer à repasser</skos:prefLabel>
        <skos:prefLabel xml:lang="it">ferro da stiro</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">ferro de engomar</skos:prefLabel>
