        <skos:prefLabel xml:lang="en">table cloth</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">tafelkleed</skos:prefLabel>
        <skos:prefLabel xml:lang="it">tovaglia</skos:prefLabel>
