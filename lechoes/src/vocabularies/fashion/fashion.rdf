        </rdf:type>
        <skos:prefLabel xml:lang="de">Statuette</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">beeldje</skos:prefLabel>
        <skos:prefLabel xml:lang="sr">statueta</skos:prefLabel>
