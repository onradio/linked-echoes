        <skos:prefLabel xml:lang="it">puntaspilli</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">smärgeldyna</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">speldenkussen</skos:prefLabel>
