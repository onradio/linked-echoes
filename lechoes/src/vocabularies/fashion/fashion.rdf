        </skos:broader>
        <skos:inScheme rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/Materials">
        </skos:inScheme>
        <skos:inScheme rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/Subject">
        </skos:inScheme>
    </rdf:Description>
