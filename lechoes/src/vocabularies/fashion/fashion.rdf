        <skos:prefLabel xml:lang="es">acero inoxidable</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">acier inoxydable</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">aço corten</skos:prefLabel>
