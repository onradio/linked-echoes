        <skos:prefLabel xml:lang="he">מפה</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers, often made of cloth, used over tables (AAT).</skos:scopeNote>
        <skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300204969">
