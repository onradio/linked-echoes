        </skos:inScheme>
        <skos:inScheme rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/Type">
        </skos:inScheme>
    </rdf:Description>
    <rdf:Description rdf:about="http://thesaurus.europeanafashion.eu/thesaurus/11348" xmlns:skos="http://www.w3.org/2004/02/skos/core#">
