        </rdf:type>
        <skos:prefLabel xml:lang="de">Kappen (Kopfbedeckung)</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">barrete</skos:prefLabel>
        <skos:prefLabel xml:lang="it">berretti</skos:prefLabel>
