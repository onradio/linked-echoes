        <skos:prefLabel xml:lang="nl">biscuit (porselein, materiaal)</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">biskviporslin</skos:prefLabel>
        <skos:prefLabel xml:lang="sr">biskvit</skos:prefLabel>
