        <skos:prefLabel xml:lang="el">αξεσουάρ μαλλιών</skos:prefLabel>
        <skos:prefLabel xml:lang="he">אביזר שיער</skos:prefLabel>
        <skos:altLabel xml:lang="de">Frisurzubehör</skos:altLabel>
