        "Masenqo"@pl,
        "Masenqo"@sv,
        "马森科"@zh .

mimo:3193 a skos:Concept ;
    skos:definition "A nyckelharpa (Swedish: [ˈnʏ̂kːɛlˌharːpa], \"keyed fiddle\", or literally \"key harp\", plural nyckelharpor) is the national musical instrument of Sweden. It is a string instrument or chordophone. Its keys are attached to tangents which, when a key is depressed, serve as frets to change the pitch of the string. The nyckelharpa is similar in appearance to a fiddle or the big Sorb geige or viol. Structurally, it is more closely related to the hurdy-gurdy, both employing key-actuated tangents to change the pitch."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Nyckelharpa"@ca,
        "Nyckelharpa"@de,
        "Nyckelharpa"@en,
        "Nyckelharpa"@es,
        "Nyckelharpa"@fr,
        "Nyckelharpa"@it,
        "Nyckelharpa"@nl,
        "Nyckelharpa"@pl,
