    skos:inScheme lev:aat ;
    skos:prefLabel "stūpī"@en .

aat:300446745 a skos:Concept ;
    skos:definition "In Indian architecture, a jewel band (decorative motif)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratnāvali"@en .

aat:300446746 a skos:Concept ;
    skos:definition "In Indian architecture, a jewel frieze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratnamālā"@en .

aat:300446747 a skos:Concept ;
    skos:definition "In Indian architecture, a jewel motif; diamond or lozenge-shaped decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratna"@en .

