euf:11112 a skos:Concept ;
    skos:altLabel "oil paints"@en ;
    skos:definition "A paint made by grinding pigments with a drying oil such as linseed oil. After 1940 alkyd binders were often added to oil paint to provide faster drying times (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Ölfarbe"@de,
        "λαδομπογιά"@el,
        "oil paint"@en,
        "óleo"@es,
        "peinture à l'huile"@fr,
