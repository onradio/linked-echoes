        "catsuit"@it,
        "catsuit"@nl,
        "catsuit"@pt,
        "mačije odelo"@sr,
        "catsuit"@sv .

euf:10425 a skos:Concept ;
    skos:altLabel "caftans"@en,
        "kaftans"@nl ;
    skos:definition "Long, coatlike garments, fastened at the waist with a sash, having extra long sleeves.Originally men's garments worn in Turkey and other eastern countries, but later became fashionable garments for men and women in the west (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kaftan"@de,
        "καφτάνι"@el,
        "caftan"@en,
