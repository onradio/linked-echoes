        "hanbok"@pt .

euf:11340 a skos:Concept ;
    skos:definition "Type of skirt (Korean clothing)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "chima"@de,
        "chima"@en,
        "chima"@es,
        "chima"@fr,
        "chima"@it,
        "chima"@nl .

euf:11341 a skos:Concept ;
    skos:definition "Scutching tools refer to a set of implements or devices specifically designed for the process of scutching. These tools are utilized in the separation of fibers from the stems or stalks of fibrous plants such as flax or hemp. They include various instruments and equipment such as scutching swords, scutching knives, scutching boards, and scutching mills, which are employed to effectively remove and separate fibers from the woody or fibrous parts of the plant, preparing them for further processing in the textile industry."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "scutching tools"@en,
        "gereedschap voor het zwingelen"@nl .

euf:11342 a skos:Concept ;
    skos:definition "Hats, typically with a broad brim worn in sunny climates to protect the head from the sun's rays (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sun hat"@en,
        "capeline"@fr,
        "zonnehoed"@nl,
        "Solhatt"@sv .

euf:11343 a skos:Concept ;
    skos:definition "Cutting tools consisting of two bevel-edged cutting blades and handles, and being movable past one another on a pivot in the center by which they are held together (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schere"@de,
        "Ψαλίδι"@el,
        "scissors"@en,
        "tijera"@es,
        "paire de ciseaux"@fr,
        "מספריים"@he,
        "forbici"@it,
        "schaar"@nl,
        "tesoura"@pt,
        "Makaze"@sr,
        "sax"@sv .

euf:11344 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "punch card"@en,
        "ponskaart"@nl .

euf:11345 a skos:Concept ;
    skos:definition "A pricking pattern in textile production, particularly in lace-making, refers to a pattern or design transferred onto a sheet of paper by pricking holes in specific configurations. This paper with holes, known as pricking, is then used as a guide for lace-making. The pattern is created by punching these holes in a specific sequence and position, forming a visual representation of how the lace should be woven. The pricking pattern is essential for lace makers as it serves as a blueprint for producing the final lacework."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pricking pattern"@en,
        "prikking patroon"@nl .

euf:11347 a skos:Concept ;
    skos:definition "Small mat, often crocheted, laid on furniture for protection or decoration, used especially to keep heat or scratches from polished surfaces (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "doily"@en,
        "onderlegger (kleedje)"@nl .

euf:11348 a skos:Concept ;
    skos:definition "Relatively small pieces of cloth or paper used for wiping the mouth and hands and protecting clothes while dining (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Serviette"@de,
        "napkin (culinary textile)"@en,
        "servilleta"@es,
        "serviette de table"@fr,
        "מפית"@he,
        "tovagliolo"@it,
        "servet"@nl,
        "guardanapo"@pt,
        "салвета"@sr,
        "servett"@sv .

euf:11349 a skos:Concept ;
    skos:definition "Any of various small, round, or cylindrical devices usually of bone, wood, or metal on which threads are wound for use in textile fabrication (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kops"@de,
        "bobbin"@en,
        "Bobina de hilo"@es,
        "bobine"@fr,
        "Rocchetto"@it,
        "klos"@nl,
        "bobina"@pt,
        "bobin"@sv .

euf:11350 a skos:Concept ;
    skos:definition "Decorative strips or loops, as of cloth, cord, or metal, designed to hold a curtain or drapery back to one side, so that it is draped in a partially open position (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "tieback (fastener)"@en,
        "embrasse"@fr,
        "gordijnophouder"@nl .

euf:11351 a skos:Concept ;
    skos:definition "Wooden blocks in the form of a hat, used by hat makers to shape a felt or straw hat. Modern hat blocks may be made of other materials (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "hat block"@en,
        "hoedenvorm"@nl .

euf:11352 a skos:Concept ;
    skos:definition "Devices, often having a basic shape similar to a boat-shaped weaver's shuttle, but used to carry thread as a spool; used for sewing, knotting, tatting, and embroidery. May be highly decorative and of precious materials (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "shuttle (sewing tool)"@en,
        "spoel (naaigereedschap)"@nl .

euf:11353 a skos:Concept ;
    skos:definition "Cards displaying samples of small merchandise items, such as beads and buttons (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sample card"@en,
        "staalkaart"@nl .

euf:11354 a skos:Concept ;
    skos:definition "Sheets of glass coated with light-sensitive emulsion that have been exposed and developed, and that are intended as matrices for the creation of positive photographic prints on another support (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Glasnegativ"@de,
        "glass plate negative"@en,
        "négatif sur plaque de verre"@fr,
        "glasplaatnegatief"@nl,
        "negativo de vidro"@pt .

euf:11355 a skos:Concept ;
    skos:definition "Positive transparencies in mounts suitable for projection, usually 35mm film in a mount of 2 by 2 inches. An image on film or glass, usually positive, intended to be viewed by means of light passing through the image and base using a viewer or projector (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Dia"@de,
        "slide (photograph)"@en,
        "diapositiva"@es,
        "diapositive"@fr,
        "diapositiva"@it,
        "día"@nl,
        "diapositivo"@pt,
        "diabild"@sv .

euf:11356 a skos:Concept ;
    skos:definition "Consecrated, relatively small stiffened squares of linen used to cover the top of the chalice. The purpose of the pall is to keep dust and insects from falling into the Eucharistic elements (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Palla (Liturgie)"@de,
        "pall (chalice cover)"@en,
        "Palia"@es,
        "pale"@fr,
        "palla"@it,
        "palla"@nl,
        "pala"@pt .

euf:11357 a skos:Concept ;
    skos:definition "Sacklike removable and washable coverings for pillows, often matching bolster cases and sheets (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kopfkissenbezug"@de,
        "μαξιλαροθήκη"@el,
        "pillow case"@en,
        "funda de almohada"@es,
        "taie d'oreiller"@fr,
        "federa"@it,
        "kussensloop"@nl,
        "fronha"@pt .

euf:11358 a skos:Concept ;
    skos:definition "Devices of various designs, often a slender bar-like object, used in weaving or netting. In weaving, it passes the thread or yarn of the weft to and from one edge of the cloth to the other between the threads or yarns of the warp (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Weberschiffchen"@de,
        "shuttle (weaving tool)"@en,
        "navette"@fr,
        "בוכיר"@he,
        "navetta"@it,
        "schietspoel"@nl,
        "lançadeira"@pt,
        "Чунак"@sr,
        "skyttel"@sv .

euf:11359 a skos:Concept ;
    skos:definition "Any of various machines for sewing material such as textile or leather, usually having needle and shuttle to carry thread and powered by treadle, waterpower, or electricity (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Nähmaschine"@de,
        "ραπτομηχανή"@el,
        "sewing machine"@en,
        "máquina de coser"@es,
        "machine à coudre"@fr,
        "מכונת תפירה"@he,
        "macchina per cucire"@it,
        "naaimachine"@nl,
        "máquina de costura"@pt,
        "шиваћа машина"@sr,
        "symaskin"@sv .

euf:11360 a skos:Concept ;
    skos:definition "Cloth coverings for altars often with decorative edgings and individual embroidered motifs (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Altartuch"@de,
        "altar cloth"@en,
        "paño de altar"@es,
        "nappe d'autel"@fr,
        "altaarkleed"@nl,
        "Toalha de altar"@pt,
        "Altarduk"@sv .

euf:11361 a skos:Concept ;
    skos:definition "Consecrated, square white linen or hemp cloths upon which the chalice and paten are placed when the Eucharist is celebrated. The cloths were originally large enough to cover the surface of the altar, but since the 12th century, corporals have become smaller, only large enough to contain the chalice and host. According to liturgical rules, the cloth may be edged with fine lace, and a cross may be embroidered at the front edge, but it is not permitted to have any embroidery in its center in order to maintain an even surface to support the chalice (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Korporale"@de,
        "corporal (altar cloth)"@en,
        "corporal"@es,
        "corporal"@fr,
        "corporale"@it,
        "corporale"@nl,
        "corporal"@pt,
        "Korporale"@sv .

euf:11362 a skos:Concept ;
    skos:altLabel "koorhemd"@nl ;
    skos:definition "Loose, white vestments with long, full sleeves worn by priests for non-Eucharistic purposes, and commonly today over the cassock by both clergy and lay persons (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Chorhemd"@de,
        "surplice"@en,
        "sobrepelliz"@es,
        "surplis"@fr,
        "Cotta"@it,
        "superplie"@nl,
        "sobrepeliz"@pt,
        "röklin"@sv .

euf:11363 a skos:Concept ;
    skos:definition "Ecclesiastical vestments worn by bishops and priests consisting of a long narrow cloth band worn around the neck and falling from the shoulders. In the Western church, the sides of the stole are crossed over the chest (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "stole (vestment)"@en,
        "stola (liturgische kleding)"@nl .

euf:11365 a skos:Concept ;
    skos:definition "Refer to various textile products specifically designed and used for interior decoration and functionality. These include but are not limited to curtains, carpets, cushions, blankets, tablecloths, and other textile items employed to enhance the aesthetics, comfort, and style of indoor spaces such as homes, offices, and commercial buildings."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "interior textile objects"@en,
        "interieur textielobjecten"@nl .

euf:11366 a skos:Concept ;
    skos:altLabel "stoffering"@nl ;
    skos:definition "Fabrics used to cover furniture such as sofas, chairs, and other seating elements. These fabrics are often durable, versatile, and aesthetically pleasing, intended for both decorative and functional purposes."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "upholstery fabric"@en,
        "meubelstof"@nl .

euf:11367 a skos:Concept ;
    skos:definition "Textiles specifically designed or suitable for making curtains or draperies, typically varying in thickness, pattern, and texture to control light and provide privacy within a space."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "curtain fabric"@en,
        "gordijnstof"@nl .

euf:11368 a skos:Concept ;
    skos:definition "Rectangular pieces of cloth, paper, or other absorbent material, used for wiping or drying (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Handtuch"@de,
        "πετσέτα"@el,
        "towel"@en,
        "toalla"@es,
        "serviette de bain"@fr,
        "מגבת"@he,
        "asciugamano"@it,
        "handdoek"@nl,
        "toalha"@pt,
        "пешкир"@sr,
        "handduk"@sv .

euf:11369 a skos:Concept ;
    skos:definition "Long, full, close-sleeved garments worn by Chrisitan clergy and as secular garments in Greco-Roman and later times, often white in color. Albs are worn by Christian priests and occasionally by consecrated kings, often beneath other vestments. They are white in the Western Church and of varying colors in the Eastern Church. Albs were sometimes decorated with richly embroidered apparels at the wrists and along the bottom (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Albe"@de,
        "alb"@en,
        "alba"@es,
        "aube"@fr,
        "אלב"@he,
        "camice"@it,
        "albe"@nl,
        "alva"@pt,
        "Alba"@sv .

euf:11370 a skos:Concept ;
    skos:altLabel "lavabodoekje"@nl ;
    skos:definition "Towels on which a priest dries his hands after washing them before celebrating Mass (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "manuterge"@en,
        "manuterge"@fr,
        "Manutergio"@it,
        "kelkdoekje"@nl .

euf:11371 a skos:Concept ;
    skos:definition "Bed coverings of cotton, linen, or the like, commonly used in pairs so that one is immediately above and the other immediately below the sleeper (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bettwäsche"@de,
        "σεντόνι"@el,
        "sheet (bed covering)"@en,
        "sábana"@es,
        "drap"@fr,
        "סדין"@he,
        "lenzuolo"@it,
        "laken"@nl,
        "lençol"@pt,
        "чаршав"@sr,
        "lakan"@sv .

euf:11372 a skos:Concept ;
    skos:definition "Low, circular, brimless hats (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Pillbox-Hut"@de,
        "pillbox (hat)"@en,
        "gorro redondo"@es,
        "bibi"@fr,
        "pillbox (hoed)"@nl,
        "Тока"@sr,
        "Pillerburk"@sv .

euf:11373 a skos:Concept ;
    skos:definition "Close-fitting white ecclesiastical vestments resembling a surplice usually with long close sleeves but sometimes winged or sleeveless that is worn especially by bishops and privileged prelates in some ceremonies (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Rochett"@de,
        "rochet"@en,
        "Roquete"@es,
        "rochet"@fr,
        "Rocchetto"@it,
        "rochet"@nl,
        "Rochet"@pt,
        "Rochett"@sv .

euf:11374 a skos:Concept ;
    skos:definition "Long, narrow textiles used as furniture coverings, to protect polished surfaces and as decoration. Shorter and narrower than scarves for furniture (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "runner (furniture covering)"@en,
        "corremesa"@es,
        "loper"@nl,
        "bordslöpare"@sv .

euf:11375 a skos:Concept ;
    skos:definition "Term used from the mid-19th century onward for a variety of bedcovers, especially those which are large, lightweight cloths that cover the full bed and pillow and often extend to the floor (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Tagesdecke"@de,
        "κάλυμμα κρεββατιού"@el,
        "bedspread"@en,
        "colcha"@es,
        "couvre-lit"@fr,
        "copriletto"@it,
        "bedsprei"@nl,
        "manta"@pt,
        "Överkast"@sv .

euf:11377 a skos:Concept ;
    skos:definition "Square textile coverings used to cover both chalice and paten before and after communion. A chalice veil is placed over the chalice, paten, and purificator when the vessels are prepared for the Eucharist and placed on the altar; it is removed before the Consecration. It may be embellished and of the same color as the liturgical vestments. For stiff squares covering just the top of the chalice, use palls (chalice covers) (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kelchvelum"@de,
        "chalice veil"@en,
        "Velo cubrecáliz"@es,
        "voile de calice"@fr,
        "velo di calice"@it,
        "kelkvelum"@nl,
        "Véu do Cálice"@pt,
        "velum"@sv .

euf:11378 a skos:Concept ;
    skos:definition "Print or nonprint materials used for the purpose of imparting knowledge, attitudes, or skills to others (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Lernmittel"@de,
        "εκπαιδευτικό υλικό"@el,
        "instructional material"@en,
        "medio de aprendizaje"@es,
        "matériel éducatif"@fr,
        "חומר לימוד"@he,
        "materiale pedagogico"@it,
        "leermiddel"@nl,
        "образовни материјал"@sr,
        "läromedel"@sv .

euf:11379 a skos:Concept ;
    skos:definition "Envelope-like cases formed from two squares of stiffened material or of cardboard lined with fabric; used to carry and hold the folded corporal (altar cloth). In Roman form the burse is ordinarily made of two juxtaposed pieces about twenty-five centimeters (or ten inches) square, bound together at three edges, leaving the fourth open to receive the corporal. The fabric of the case is of the liturgical color appropriate to the liturgical calendar. The use of the burse is relatively recent. When the corporal reached its present small dimensions, it was carried to the altar in the Missal or in a bag (burse) or box (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bursa (Liturgie)"@de,
        "bursa"@en,
        "bolsa de corporales"@es,
        "bourse"@fr,
        "borsa"@it,
        "bursa"@nl .

euf:11380 a skos:Concept ;
    skos:definition "Books of blank pages, usually ruled, used for taking notes (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Notizbuch"@de,
        "Τετράδιο"@el,
        "notebook"@en,
        "cuaderno"@es,
        "cahier"@fr,
        "מחברת"@he,
        "taccuino"@it,
        "schrift"@nl,
        "caderno"@pt,
        "Свеска"@sr,
        "anteckningsbok"@sv .

euf:11381 a skos:Concept ;
    skos:definition "Pre-knotted ties that are attached around the neck with a strap, or to a shirt's collarband by a metal clip. These can be either bow-ties or long neckties (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pre-tied tie"@en,
        "schijnstropdas"@nl .

euf:11382 a skos:Concept ;
    skos:definition "Heatable devices usually with a flat metal base of some weight that are used to smooth, finish, or press cloth (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bügeleisen"@de,
        "σίδερο"@el,
        "iron (tool)"@en,
        "plancha de ropa"@es,
        "fer à repasser"@fr,
        "מגהץ"@he,
        "ferro da stiro"@it,
        "strijkijzer"@nl,
        "ferro de engomar"@pt,
        "пегла"@sr,
        "strykjärn"@sv .

euf:11383 a skos:Concept ;
    skos:definition "Sleeveless outer vestments in the form of a wide cloak or mantle that slips over the wearer's head and remains open at the sides. Chasubles are worn over the alb and stole by the celebrant at Mass (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kasel"@de,
        "φελόνιο"@el,
        "chasuble"@en,
        "casulla"@es,
        "chasuble"@fr,
        "casula"@it,
        "kazuifel"@nl,
        "casula"@pt,
        "Mässhake"@sv .

euf:11386 a skos:Concept ;
    skos:definition "Blocks, usually of wood, that either are cut to print an image, whether on paper, fabric, or other material, or that support other materials that form the actual printing surface (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "printing block (printing surface)"@en,
        "drukblok"@nl .

euf:11387 a skos:Concept ;
    skos:definition "Ankle-length garments of various types, but usually having long, narrow sleeves; worn especially members of the clergy and others participating in church services (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Soutane"@de,
        "ράσο"@el,
        "cassock"@en,
        "sotana"@es,
        "soutane"@fr,
        "abito talare"@it,
        "soutane"@nl,
        "batina"@pt,
        "мантија"@sr,
        "prästrock"@sv .

euf:11388 a skos:Concept ;
    skos:definition "Small cushions into which pins are stuck until needed (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Nadelkissen"@de,
        "pincushion"@en,
        "alfiletero"@es,
        "pelote à épingles"@fr,
        "puntaspilli"@it,
        "speldenkussen"@nl,
        "smärgeldyna"@sv .

euf:11389 a skos:Concept ;
    skos:definition "Wheels for winding yarn or thread typically consisting of an expandable cage that swivels on a verical shaft and a finial cup, designed to be free standing on its own legs, attachted to the lids of sewing baskets or designed to be clamped on to the edge of a table. A skein of yarn is placed over the cage and turned, swiveling to order to wind a neat ball of yarn (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "swift"@en,
        "haspel"@nl .

euf:11390 a skos:Concept ;
    skos:definition "Pillows on which a certain type of lace is made (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Klöppelkissen"@de,
        "lace pillow"@en,
        "carreau de dentellière"@fr,
        "kantkloskussen"@nl .

euf:11391 a skos:Concept ;
    skos:definition "Fasteners used to attach washed laundry to clotheslines. There are two common types: a one-piece forked peg, and a clamp made of two pieces of wood or plastic held together with a tensioned spring, forming a pincer (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Wäscheklammer"@de,
        "Μανταλάκι"@el,
        "clothespin"@en,
        "pinza de tender"@es,
        "pince à linge"@fr,
        "אטב כביסה"@he,
        "molletta da bucato"@it,
        "wasknijper"@nl,
        "Prendedor"@pt,
        "Штипаљка"@sr,
        "klädnypa"@sv .

euf:11392 a skos:Concept ;
    skos:altLabel "kleurentabel"@nl ;
    skos:definition "Diagrams of colors assembled to illustrate a scheme of color nomenclature or classification, to demonstrate a color theory, or to show the colors available in a manufacturer's line of goods (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Farbtonberater"@de,
        "color chart"@en,
        "muestrario de colores"@es,
        "nuancier"@fr,
        "kleurkaart"@nl .

euf:11393 a skos:Concept ;
    skos:definition "Frames, devices, or machines of various designs, used for interlacing at right angles two or more sets of threads or yarns to form a cloth (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Webstuhl"@de,
        "αργαλειός"@el,
        "loom (textile tool)"@en,
        "telar"@es,
        "métier à tisser"@fr,
        "נול"@he,
        "telaio"@it,
        "weefgetouw"@nl,
        "tear"@pt,
        "разбој"@sr,
        "vävstol"@sv .

euf:11394 a skos:Concept ;
    skos:definition "Long, narrow ornamental bands generally with fringe at either end, worn over the left arm near the wrist by priests, deacons, and subdeacons. Originally it was a cloth of fine quality used to wipe away perspiration, or an ornamental handkerchief, generally carried in the hand as an ornament. Ornamental handkerchiefs or cloths of this kind were originally carried by people of rank in ordinary life (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Manipel"@de,
        "maniple"@en,
        "manípulo"@es,
        "manipule"@fr,
        "Manipolo"@it,
        "manipel"@nl,
        "manípulo"@pt,
        "manipel"@sv .

euf:11395 a skos:Concept ;
    skos:definition "Pocket-size containers, such as bags or rolls of cloth, for carrying small articles such as thread, needles and scissors (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "housewife (container)"@en,
        "naaidoos"@nl .

euf:11396 a skos:Concept ;
    skos:definition "Vestments comprising long, oblong veils or shawls used in the Roman rite, worn over the shoulders of the celebrant; generally made of silk. They are most often used during the Exposition and Benediction of the Blessed Sacrament. The ends of the humeral veil are used to envelop the hands of the celebrant when he holds up the monstrance, as a mark of respect for the sacred vessel. The item grew out of the tradition of sudaria cloths in ancient Rome (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Velum (liturgische Kleidung)"@de,
        "humeral veil"@en,
        "Humeral"@es,
        "voile huméral"@fr,
        "Velo omerale"@it,
        "schoudervelum"@nl,
        "véu umeral"@pt .

euf:11398 a skos:Concept ;
    skos:definition "Representations or copies of an object that are larger or smaller than the actual size of the object being represented, and manufactured precisely according to relative size. Typically, the scale model is smaller than the original and used for illustrating the object, for a toy or collectible, or as a guide to constructing it in full size. Scale models may be one- or two-dimensional. Scale models are generally built according to a standard scale for the particular product; for example, model trains may be HO scale (1:87 scale), model ships may be 1:500 scale, and dollhouse furniture may be 1:12 scale (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Miniaturmodell"@de,
        "μακέτα"@el,
        "scale model"@en,
        "maqueta"@es,
        "maquette"@fr,
        "דגם להרכבה"@he,
        "maquette"@it,
        "schaalmodel"@nl,
        "maquete"@pt,
        "skalmodell"@sv .

euf:11399 a skos:Concept ;
    skos:definition "Long, semi-circular cloaklike garments fastened at the neck with a morse; worn by ecclesiastics in processions and on other ceremonial occasions. Also, similar garments worn as coronation or processional robes by laymen (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Pluviale"@de,
        "cope"@en,
        "capa pluvial"@es,
        "chape"@fr,
        "piviale"@it,
        "koorkap"@nl,
        "pluvial"@pt,
        "Pluviale"@sv .

euf:11400 a skos:Concept ;
    skos:definition "Reproductive prints of architectural plans, maps, mechanical drawings, and other technical drawings, characterized by having white images on blue backgrounds and produced by the blueprint process (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Diazotypie"@de,
        "blueprint (reprographic copy)"@en,
        "Blueprint"@es,
        "blueprint"@fr,
        "cianografia"@it,
        "blauwdruk"@nl,
        "planta"@pt,
        "blåkopia"@sv .

euf:11401 a skos:Concept ;
    skos:definition "Machines for turning fiber into thread or yarn, in which the formation of the thread is performed by the help of a wheel worked either by a hand or foot pedal that spins the thread onto a single spindle. Said to have been invented in India, they were introduced into Europe via the Middle East in the Medieval period, and were in common use there and in North America after colonization into the 18th century (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Spinnrad"@de,
        "spinning wheel"@en,
        "máquina de hilar"@es,
        "rouet"@fr,
        "גלגל טווייה"@he,
        "filatoio ad alette"@it,
        "spinnewiel"@nl,
        "roda de fiar"@pt,
        "Коловрат"@sr,
        "Spinnrock"@sv .

euf:11402 a skos:Concept ;
    skos:definition "Generally, textile that is woven, felted, knit, pounded, or otherwise made into a flat piece (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stoff"@de,
        "fabric (cloth)"@en,
        "tela"@es,
        "tissu"@fr,
        "בד"@he,
        "tela"@it,
        "stof (textiel)"@nl,
        "tyg"@sv .

euf:11403 a skos:Concept ;
    skos:definition "Bags or similar containers made typically of cloth, leather, or rubber stuffed with a resilient material and used to give support or ease to the body while sitting, reclining, or kneeling (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kissen"@de,
        "μαξιλάρι"@el,
        "cushion"@en,
        "cojín"@es,
        "coussin"@fr,
        "kussen"@nl,
        "almofada"@pt,
        "јастук"@sr .

euf:11404 a skos:Concept ;
    skos:definition "Neckwear consisting of two white, downward-hanging bands of fabric. These are typically worn as part of the professional regalia of lawyers, judges, and university professors (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "band (neckwear)"@en,
        "bef"@nl .

euf:11405 a skos:Concept ;
    skos:definition "Small bell-shaped covers worn over the fingertip to protect it when pushing a needle through material in sewing (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Fingerhut"@de,
        "Δαχτυλήθρα"@el,
        "thimble"@en,
        "dedal"@es,
        "dé à coudre"@fr,
        "אצבעון"@he,
        "Ditale"@it,
        "vingerhoed"@nl,
        "dedal"@pt,
        "напрстак"@sr,
        "Fingerborg"@sv .

euf:11406 a skos:Concept ;
    skos:definition "Natural fiber extracted from the stem of the banana plant. These fibers are known for their strength, durability, and eco-friendly properties, making them suitable for various textile and craft applications."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "banana fiber"@en,
        "bananenvezel"@nl .

euf:11407 a skos:Concept ;
    skos:altLabel "bast fiber"@en,
        "bastvezel"@nl ;
    skos:definition "Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants. Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bastfaser"@de,
        "bast"@en,
        "fibra liberiana"@es,
        "fibre libérienne"@fr,
        "fibra liberiana"@it,
        "bast"@nl,
        "fibra liberiana"@pt,
        "bast"@sv .

euf:11408 a skos:Concept ;
    skos:definition "Stone with less commercial value than those classified as precious (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Halbedelstein"@de,
        "semiprecious stone"@en,
        "piedra semipreciosa"@es,
        "pierre fine"@fr,
        "pietra semipreziosa"@it,
        "halfedelsteen"@nl,
        "pedra semipreciosa"@pt,
        "Halvädelsten"@sv .

euf:11409 a skos:Concept ;
    skos:definition "Timber sawn into thin pieces, and having considerable extent of surface on two sides, with the other two sides being narrow. Usually reserved for rectangular pieces having much greater length than breadth (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Holzbrett"@de,
        "woodboard"@en,
        "tabla de madera"@es,
        "planche de bois"@fr,
        "plank"@nl .

euf:11410 a skos:Concept ;
    skos:definition "A material, typically used for building, composed of 100% wood fibers. Fibers are usually obtained from wood chips, sawdust, and board trimmings; they are broken into fine particles by grinding (dry process) or by steam (wet process). The interfelted fibers are consolidated with heat and pressure (at least 31 pounds per cubic foot) to form a dense, rigid sheet that is held together by naturally occurring lignin with no additional adhesive. Hardboards range from a dark brown to a light tan in color and have one very smooth surface; the reverse side has a wire screen impression. Some hardboards contain a small amount of oil on the surface either as a residual lubricant or as an additive to increase weather resistance; these oils may hinder the adherence of paint or gesso and may be removed with acetone (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Harte Faserplatte"@de,
        "hardboard"@en,
        "tablero de fibra de alta densidad"@es,
        "panneau dur"@fr,
        "hardboard"@nl,
        "hardboard"@pt,
        "hård träfiberskiva"@sv .

euf:11411 a skos:Concept ;
    skos:definition "Long, slender, flexible, roughly cylindrical construction of fibrous material, usually made of several strands twisted together. Cord is typically made from a type of bast fiber such as cotton, jute, flax, ramie, hemp, sisal, olona, gravata, agel, widuri, caraguata, or others (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Fädelschnur"@de,
        "cord (fiber product)"@en,
        "cuerda (producto de fibra)"@es,
        "corde (cord)"@fr,
        "koord (vezelproduct)"@nl .

euf:11412 a skos:Concept ;
    skos:definition "Fiber made from chemical substances, used for textile production (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "synthetic fiber"@en,
        "fibra sintética"@es,
        "fibre synthétique"@fr,
        "kunstvezel"@nl .

euf:11413 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Modacrylic"@en,
        "Modacrylvezel"@nl .

euf:11414 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Pt and atomic number 78; a lustrous, malleable, ductile, silvery white metal, considered a precious metal. Use also for this metal as processed and formed, usually in combination with other substances, to make objects and materials (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Platin"@de,
        "λευκόχρυσος"@el,
        "platinum"@en,
        "platino"@es,
        "platine"@fr,
        "פלטינה"@he,
        "platino"@it,
        "platina"@nl,
        "platina"@pt,
        "платина"@sr,
        "platina"@sv .

euf:11415 a skos:Concept ;
    skos:altLabel "PP"@en,
        "propylene resin"@en ;
    skos:definition "Tough, lightweight, rigid plastic made by the polymerization of high-purity propylene gas in the presence of an organometallic catalyst at relatively low pressure and temperature (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Polypropylen"@de,
        "Πολυπροπυλένιο"@el,
        "polypropylene"@en,
        "polipropileno"@es,
        "polypropylène"@fr,
        "פוליפרופילן"@he,
        "polipropilene"@it,
        "polypropeen"@nl,
        "polipropileno"@pt,
        "полипропилен"@sr,
        "polypropen"@sv .

euf:11416 a skos:Concept ;
    skos:altLabel "polyethyleen"@nl ;
    skos:definition "A group of polyolefin polymers derived from ethylene by polymerization by heat and pressure (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Polyethylen"@de,
        "Πολυαιθυλένιο"@el,
        "polyethylene"@en,
        "polietileno"@es,
        "polyéthylène"@fr,
        "פוליאתילן"@he,
        "polietilene"@it,
        "polyetheen"@nl,
        "polietileno"@pt,
        "polyeten"@sv .

euf:11417 a skos:Concept ;
    skos:definition "General term for wood from several species of trees, characterized by being very hard, yellowish brown in color, and having a satiny luster; used especially for fine woodworking and tools (AAT).Satijnwood (Dutch) refers to a very hard, yellowish-brown wood from an East Indian tree species (Chloroxylon swietenia) belonging to the Meliaceae family; the wood has a satin-like sheen and is primarily used for fine woodworking and for tools (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "satinwood (wood)"@en,
        "madera satinada"@es,
        "clavalier à coeur jaune (madera)"@fr,
        "satijnhout"@nl .

euf:11420 a skos:Concept ;
    skos:definition "Fancy trimming used on furnishings and costume, such as braid, cord, fringe, gimp, or tassel, often in combination (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Posament"@de,
        "passementerie (material)"@en,
        "pasamanería"@es,
        "passementerie"@fr,
        "passamaneria"@it,
        "passement"@nl .

euf:11421 a skos:Concept ;
    skos:definition "Alloy in which zinc is the principle element (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Zinklegierung"@de,
        "zinc alloy"@en,
        "aleación de zinc"@es,
        "alliage de zinc"@fr,
        "lega di zinco"@it,
        "zinklegering"@nl,
        "легура цинка"@sr,
        "zinklegering"@sv .

euf:11422 a skos:Concept ;
    skos:definition "Trademarked name for a group of alloys having zinc as the main component. The alloys have a relatively low melting point and can be easily cast. The name is an acronym derived from the German names for the metals from which the material is composed: Zink, Aluminium, Magnesium, Kupfer (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Zamak-Legierung"@de,
        "Zamak (TM)"@en,
        "zamak"@es,
        "Zamak"@fr,
        "zamak"@it,
        "Zamak"@nl,
        "Zamak"@pt .

euf:11423 a skos:Concept ;
    skos:definition "Metal that does not have iron as its major ingredient (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Nichteisenmetall"@de,
        "Έγχρωμα μέταλλα"@el,
        "nonferrous metal"@en,
        "Metal no ferroso"@es,
        "le metal non magnet"@fr,
        "metallo non ferroso"@it,
        "non-ferrometaal"@nl,
        "Обојени метали"@sr,
        "Icke-Järnmetallurgi"@sv .

euf:11424 a skos:Concept ;
    skos:definition "A synthetic fabric with a thick, soft pile, used for outer clothing and blankets. Originally developed in 1979 by Malden Mills, a Massachusetts textile maker. Made from polyethylene terephthalate (PET), it has been adopted as an alternative to wool in applications that require warmth. It can be made from fibers recycled from plastic PET bottles (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Fleece"@de,
        "Φλις"@el,
        "polyester fleece"@en,
        "forro polar"@es,
        "polaire"@fr,
        "פליס"@he,
        "pile"@it,
        "fleece"@nl,
        "fleece"@sv .

euf:11425 a skos:Concept ;
    skos:altLabel "baled cotton"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "bale cotton"@en,
        "baalkatoen"@nl .

euf:11428 a skos:Concept ;
    skos:definition "Material comprising the hide or skin of an animal, usually a mammal, with the hair or wool left on (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pelt (animal material)"@en,
        "piel (material procesado)"@es,
        "pels"@nl .

euf:11429 a skos:Concept ;
    skos:definition "A compound -- generally a complex organic material that dissolves or is suspended in a liquid -- that absorbs into and colors another material. Distinguished from a pigment, which is insoluble in the vehicle, but instead is held in a suspension (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Farbstoff"@de,
        "dye"@en,
        "tinte"@es,
        "teinture"@fr,
        "פיגמנטי צביעה"@he,
        "colorante"@it,
        "verfstof"@nl,
        "corante"@pt,
        "фарба"@sr,
        "färgämne"@sv .

euf:11430 a skos:Concept ;
    skos:altLabel "cutwork stitch"@en ;
    skos:definition "Refers to a type of embroidery technique where parts of the fabric are intentionally cut or left open, creating voids or openings in the textile. The open areas are typically surrounded or embellished by carefully executed stitches, contributing to a decorative and airy design. This technique is commonly used in various forms of needlework, including cutwork and other embroidery styles, to achieve intricate and delicate patterns in the fabric."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "openwork stitch"@en,
        "ajoursteek"@nl .

euf:11431 a skos:Concept ;
    skos:altLabel "cannetille"@nl ;
    skos:definition "Fine gold or silver twisted thread that is used spirally in embroidery and is often made for stringing for robes or as a military braid (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kantille"@de,
        "cannetille"@en,
        "Canutillo (hilo)"@es,
        "cannetille"@fr,
        "canetille"@nl .

euf:11432 a skos:Concept ;
    skos:altLabel "ciselé fluweel"@nl,
        "ciselé-fluweel"@nl ;
    skos:definition "Velvet having a pattern formed by cut and uncut pile (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "ciselé velvet"@en,
        "terciopelo labrado por corte"@es,
        "velours ciselé"@fr,
        "ciseléfluweel"@nl .

euf:11433 a skos:Concept ;
    skos:altLabel "linen weave"@en,
        "taffeta weave (process)"@en,
        "linnenbinding (procedé)"@nl ;
    skos:definition "A process of weaving in which each weft thread always passes alternately over then under every successive warp thread. Both sides of such weaving are structurally identical (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Leinwandbindung"@de,
        "tabby (process)"@en,
        "ligamento tafetán"@es,
        "toile"@fr,
        "tela"@it,
        "effenbinding (procedé)"@nl,
        "tuskaft"@sv .

euf:11434 a skos:Concept ;
    skos:altLabel "dekensteek"@nl ;
    skos:definition "Buttonhole stitches worked on the edge of a blanket or other material too thick to be hemmed (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "blanket stitch"@en,
        "festonsteek"@nl .

euf:11435 a skos:Concept ;
    skos:definition "Rich (Medieval) fabric woven with gold thread or a combination of gold and silk."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Goldstoff"@de,
        "cloth of gold"@en,
        "Tejido de oro"@es,
        "toile d'or"@fr,
        "goudlaken"@nl .

euf:11436 a skos:Concept ;
    skos:definition "Refers to the process of using thread to create two stitches of the same length that cross each other to form crosses or x shapes. It is often used to make designs on fine fabrics or heavy canvas or carpet. It is also used to secure seams or splices in pieces of fabric (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kreuzstich"@de,
        "cross-stitching"@en,
        "punto cruz"@es,
        "point croisé"@fr,
        "kruissteek"@nl,
        "ponto-cruz"@pt,
        "korsstyg"@sv .

euf:11437 a skos:Concept ;
    skos:definition "Refers to a stitching technique where the thread passes through the fabric diagonally only once, as opposed to a full cross stitch where the thread goes diagonally twice, creating an 'X' shape."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "half cross-stitching"@en,
        "halve kruissteek"@nl .

euf:11438 a skos:Concept ;
    skos:definition "Refers broadly to the activity of fashioning in wood (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Holzverarbeitung"@de,
        "ξυλουργική"@el,
        "woodworking"@en,
        "trabajo de la madera"@es,
        "travail du bois"@fr,
        "עיבוד עץ"@he,
        "lavorazione del legno"@it,
        "houtbewerken"@nl,
        "marcenaria"@pt,
        "обрада дрвета"@sr,
        "snickeri"@sv .

euf:11439 a skos:Concept ;
    skos:definition "Twilled weave is characterized by a diagonal pattern created when each weft thread passes over two or more warp threads before going under one or more warp threads. This results in a diagonal line in the fabric, known as the twill line."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "twilled weave"@en,
        "keperbinding (procedé)"@nl .

euf:11440 a skos:Concept ;
    skos:definition "The act or process of shaping things out of metal or of decorating with metal (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Metallverarbeitung"@de,
        "μεταλλοτεχνία"@el,
        "metalworking"@en,
        "metalistería"@es,
        "traitement des métaux"@fr,
        "עיבוד מתכת"@he,
        "lavorazione dei metalli"@it,
        "metaalbewerken"@nl,
        "indústria metalomecânica"@pt,
        "металургија"@sr,
        "metallbearbetning"@sv .

euf:11441 a skos:Concept ;
    skos:definition "Photographic processes that produce an additive color image using a screen of minute red, green, and blue filters to record the relative intensity of each hue on a panchromatic, black-and-white emulsion which is processed to form a transparency. When viewed through a similar filter, each filter contributes its hue with its intensity modulated by the silver image (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "screen processes"@en,
        "proceso con filtro"@es,
        "zeefdrukprocedé"@nl .

euf:11442 a skos:Concept ;
    skos:altLabel "whitework embroidery (technique)"@en ;
    skos:definition "Embroidery where white threads are used on white fabric. Whitework techniques can include various stitches such as satin stitches, cutwork stitches (creating openings in the fabric), richelieu stitches, and other decorative stitch patterns. This technique is often employed in creating delicate embroidery on garments, linens, and other textile items where a refined and sophisticated look is desired."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Weißstickerei"@de,
        "whitework (technique)"@en,
        "wit borduurwerk (techniek)"@nl .

euf:11443 a skos:Concept ;
    skos:definition "Making clusters of short threads for decorative effect, as in candlewicking, or as a finish to the tying or holding stitches of quilts and upholstery (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "tufting"@en,
        "tuften"@nl .

euf:11444 a skos:Concept ;
    skos:definition "A synthetic textile fiber used in the production of fabrics. It is a type of polyester fiber, manufactured from polymers derived from petroleum products. Terlenka is commonly used in the textile industry due to its durability, wrinkle resistance, and relative affordability."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "terlenka"@en,
        "terlenka"@nl .

euf:11445 a skos:Concept ;
    skos:definition "Object used to hold needles for security or storage, often made of textile or leather. For a case used to store needles, often made of bone or metal, use needle case (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "needle holder"@en,
        "naaldenhouder (gemaakt van textiel of leer)"@nl .

euf:11446 a skos:Concept ;
    skos:definition "Two circles of wood, metal or plastic that fit one inside the other, and that can be tightened with fabric stretched over the inner hoop to keep it taught while being worked (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stickrahmen"@de,
        "embroidery hoop"@en,
        "tambour à broder"@fr,
        "Telaio da ricamo"@it,
        "borduurring"@nl,
        "broderibåge"@sv .

euf:11447 a skos:Concept ;
    skos:definition "Refers to a range of tools, machinery, and supplies employed in the process of applying designs, patterns, or images onto textiles."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for printing"@en,
        "equipment voor het drukken"@nl .

euf:11448 a skos:Concept ;
    skos:definition "Refers to a variety of tools, machinery, and materials specifically designed for the art of embellishing fabric with decorative stitches and patterns."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for embroidering"@en,
        "equipment voor het borduren"@nl .

euf:11449 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for textile working"@en,
        "equipment voor het vervaardigen van textiel"@nl .

euf:11450 a skos:Concept ;
    skos:definition "Refers to a range of tools, machinery, and supplies utilized in the embellishment and ornamentation of textiles."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for textile decoration"@en,
        "equipment voor het decoreren van textiel"@nl .

euf:11451 a skos:Concept ;
    skos:definition "Refers to a diverse range of tools and materials essential for the craft of knitting."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for knitting"@en,
        "equipment voor het breien"@nl .

euf:11452 a skos:Concept ;
    skos:definition "Tools or equipment for working fibers, generally restricted to fibers other than textile fibers (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for fiberworking"@en,
        "equipment voor vezelbewerking"@nl .

euf:11453 a skos:Concept ;
    skos:definition "Refers to a set of tools and materials specifically designed for creating lace through needlework techniques."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for lace (needlework)"@en,
        "equipment voor het kantklossen"@nl .

euf:11455 a skos:Concept ;
    skos:definition "Refers to a diverse array of tools and machinery essential for the craft of weaving textiles."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for weaving"@en,
        "equipment voor het weven"@nl .

euf:11456 a skos:Concept ;
    skos:definition "Refers to a variety of tools and materials used in the craft of crocheting."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for crocheting"@en,
        "equipment voor het haken"@nl .

euf:11457 a skos:Concept ;
    skos:definition "Tools and equipment used for sewing, which uses the process of joining, attaching, or decorating flexible materials with needle and thread (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for sewing"@en,
        "equipment voor het naaien"@nl .

euf:11458 a skos:Concept ;
    skos:definition "Refers to various tools, devices, and machinery used in the care, cleaning, and upkeep of textiles."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for textile maintenance"@en,
        "equipment voor onderhoud van textiel"@nl .

euf:11459 a skos:Concept ;
    skos:definition "Refers to various tools, machinery, and accessories used in the process of creating hats (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for hatmaking"@en,
        "equipment voor het maken van hoeden"@nl .

euf:11460 a skos:Concept ;
    skos:definition "Refers to a range of tools, machinery, and supplies utilized in the craft of producing jewelry."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "equipment for jewelry making"@en,
        "equipment voor het maken van sieraden"@nl .

euf:11461 a skos:Concept ;
    skos:altLabel "maatstok (meetinstrument)"@nl,
        "meetlat"@nl ;
    skos:definition "Straight-edged strips or cylinders of medium size, usually of wood, metal, plastic, or ivory and having demarcations to indicate units of measurement, used for measuring and for guiding a pen, pencil, or other marking-instrument in forming straight lines upon paper or another material. They are used in geometry, drafting, drawing, carpentry, building, interior design, crafts, and other disciplines (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Lineal"@de,
        "Κανόνας"@el,
        "ruler (measuring device)"@en,
        "regla"@es,
        "règle"@fr,
        "סרגל"@he,
        "riga"@it,
        "liniaal"@nl,
        "régua"@pt,
        "Лењир"@sr,
        "linjal"@sv .

euf:11462 a skos:Concept ;
    skos:definition "Tool with hinged top for breaking the wooden core of flax stems (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "flax breaker"@en,
        "vlasbraak"@nl .

euf:11463 a skos:Concept ;
    skos:definition "Mechanisms designed to prepare fibers for spinning by cleansing, disentangling, and collecting them together. These consist mainly of a large roller surrounded by smaller rollers, all covered in small teeth. As the fiber progresses into the machine, the teeth become progressively closer together on the rollers. Fiber leaves the machine as a 'sliver;' a large rope of fibres. These machines alleviated the problem of hand carding, a task that slowed the newly mechanized production of textiles in the 18th century. Several inventors developed machines to perform carding, including John Kay, Oliver Evans, Lewis Paul, R. Arkwright, and Johann Bodmer (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "carding machine"@en,
        "kaardmachine"@nl .

euf:11464 a skos:Concept ;
    skos:definition "Rods, usually tapered at both ends, used as axes in hand spinning. Fibers are drawn and twisted onto the spindle from a mass of wool or other material that is gathered on the distaff. The image of the spindle and distaff has been associated historically with feminine power or virtue (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Handspindel"@de,
        "spindle (textile working equipment)"@en,
        "huso"@es,
        "fuseau"@fr,
        "פלך"@he,
        "fuso"@it,
        "spintol (textielbewerkingsuitrusting)"@nl,
        "fuso"@pt,
        "вретено"@sr,
        "slända"@sv .

euf:11465 a skos:Concept ;
    skos:definition "A tool used in the art of embroidery to secure and stretch fabric, providing a stable surface for the creation of intricate and detailed stitches."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "embroidery frame"@en,
        "métier à broder"@fr,
        "borduurraam"@nl,
        "bastidor"@pt .

euf:11466 a skos:Concept ;
    skos:definition "A specialized piece of equipment designed for automating and enhancing the process of embroidery."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "embroidery machine"@en,
        "borduurmachine"@nl .

euf:11467 a skos:Concept ;
    skos:definition "Embroidery needles have sharp tips and larger eyes than regular sewing needles, so the eye can accommodate embroidery threads. The sharp tips help the needle penetrate tightly woven embroidery fabrics, as well as felt. They are also sometimes referred to as crewel needles as they are used for crewel embroidery (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "embroidery needle"@en,
        "borduurnaald"@nl .

euf:11468 a skos:Concept ;
    skos:definition "Tools comprising thin pieces of material, such as metal, paper, cardboard, or stencil film, into which is cut, inscribed, or otherwise indicated a pattern, in such a way so that paint or ink applied to the surface of the stencil tool will produce a corresponding pattern on a second surface through the cut-out (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schablone"@de,
        "Στένσιλ"@el,
        "stencil (image-making tool)"@en,
        "estarcido"@es,
        "pochoir"@fr,
        "שבלונה"@he,
        "stencil"@it,
        "sjabloon (uitrusting)"@nl,
        "estêncil"@pt,
        "schablon"@sv .

euf:11469 a skos:Concept ;
    skos:definition "Bags for garments on hangers while in storage or when traveling. Made of cloth, paper, or plastic, often with a zipper down the front and a closed bottom (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "garment bag"@en,
        "funda para ropa"@es,
        "housse à vêtements"@fr,
        "kledinghoes"@nl .

euf:11470 a skos:Concept ;
    skos:altLabel "kleerborstel"@nl ;
    skos:definition "Brush used to remove loose hair, dirt, or dust off the surface of costume (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kleiderbürste"@de,
        "βούρτσα ρούχων"@el,
        "clothes brush"@en,
        "brosse à vêtement"@fr,
        "מברשת בגדים"@he,
        "spazzola per abiti"@it,
        "kledingborstel"@nl,
        "četka za odeću"@sr,
        "klädbortse"@sv .

euf:11471 a skos:Concept ;
    skos:definition "Flat board or other surfaces, usually cloth-covered and with one tapered end, on which clothing or similar articles are ironed; may be freestanding and supported with collapsible legs or attached to a vertical surface (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bügelbrett"@de,
        "ironing board"@en,
        "tabla de planchar"@es,
        "table à repasser"@fr,
        "strijkplank"@nl,
        "strykbräda"@sv .

euf:11472 a skos:Concept ;
    skos:definition "Small generally straight implements used for looping stitches over one another in crochet (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "crochet hook"@en,
        "haaknaald"@nl .

euf:11473 a skos:Concept ;
    skos:definition "A long, slender, weighted bobbin used in bobbin lace making."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "μπομπίνα δαντέλλας"@el,
        "lace bobbin"@en,
        "bolillo"@es,
        "fuseau à dentelle"@fr,
        "bobina per merletti"@it,
        "kantklos"@nl,
        "bobina para rendas"@pt .

euf:11474 a skos:Concept ;
    skos:definition "Shapes made of fabric or paper, in modern times often tissue paper, used as guides to cut out sections of fabric that can be stitched together into finished works (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sewing pattern"@en,
        "naaipatroon"@nl .

euf:11475 a skos:Concept ;
    skos:definition "Shapes made of fabric or paper, in modern times often tissue paper, used as guides to cut out sections of fabric that can be stitched together into articles of clothing (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "clothes pattern"@en,
        "kledingpatroon"@nl .

euf:11476 a skos:Concept ;
    skos:definition "Frames, often made of wire, used as a fitting model in making dresses. Often custom shaped to the person for whom the dress is designed (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schneiderpuppe"@de,
        "dress form"@en,
        "paspop (pasmodel)"@nl,
        "Provdocka"@sv .

euf:11477 a skos:Concept ;
    skos:definition "Refer to a diverse range of textile items specifically crafted and utilized for religious or ceremonial purposes within the context of worship and religious rituals. These objects often include vestments, altar cloths, chasubles, stoles, paraments, and other textile articles employed in religious ceremonies and services."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "liturgical textile objects"@en,
        "liturgische textielobjecten"@nl .

euf:11478 a skos:Concept ;
    skos:definition "Pieces of cloth or other flexible material, usually attached along one side to a pole or cord, intended for such purposes as symbolizing a nation or organization, or as a means of signaling (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Flagge"@de,
        "σημαία"@el,
        "flag"@en,
        "bandera"@es,
        "drapeau"@fr,
        "דגל"@he,
        "bandiera"@it,
        "vlag"@nl,
        "bandeira"@pt,
        "застава"@sr,
        "flagga"@sv .

euf:11479 a skos:Concept ;
    skos:definition "Tapering flags (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Wimpel"@de,
        "pennant"@en,
        "wimpel"@nl,
        "flâmula"@pt,
        "vimpel"@sv .

euf:11480 a skos:Concept ;
    skos:definition "Curtains hung around the altar, particularly in a temple or church. They were hung in front of, or to close off the sides of, an altar during the service. As with rood screens, altar veils were liturgical barriers marking the boundaries between the congregation's space and the holy of holies; the Lenten veil is a type of altar veil, used in Catholic and other churches in the season prior to Easter. Beginning in the early days of the Reformation, altar vela began to be used in certain Protestant churches during the entire liturgical year. In some cases, altar veils may be associated with the altar canopy (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "altar veil"@en,
        "altaarvelum"@nl .

euf:11481 a skos:Concept ;
    skos:definition "Panels or hangings for the front of a Christian altar, pulpit, or lectern; may be carved, painted, embroidered, or otherwise decorated. Antependia are of various materials including wood, ivory, precious metals, and embroidered textiles. The exposed position of precious antependia meant that they were sometimes moved on top of the altar for safety, thus becoming retables. If the coverings are continued around the sides and back they are called paraments or paliotti (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Antependium"@de,
        "antependium"@en,
        "Frontal (arquitectura)"@es,
        "antependium"@fr,
        "paliotto"@it,
        "antependium"@nl,
        "Antependium"@sv .

euf:11482 a skos:Concept ;
    skos:definition "Carved, painted, embroidered, or otherwise decorated panels or hangings that cover all four sides of a Christian altar, as distinct from an antependium which covers the front alone. The term may also refer to similar hangings or ornaments of a room of state. The term formerly referred to both the vestments worn by the celebrants of Christian services and the hangings around the altar; over time it has come to mean only the hangings and panels (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "parament (hangings)"@en,
        "parements d'autel"@fr,
        "paliotti (parament)"@nl .

euf:11483 a skos:Concept ;
    skos:definition "The vestments worn by the celebrants of Christian services (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Parament"@de,
        "parament (vestment)"@en,
        "parament (liturgische gewaden)"@nl .

euf:11484 a skos:Concept ;
    skos:definition "Pieces of ornament or entire textile works created by applying shapes or patterns in one material onto another material. The works are typically further decorated with embroidery that is used to secure and embellish the design. The term may refer to a single cutout decoration that is intended to be fastened to the larger piece of material, or to the material having the piece attached. Works may be intended to be framed or formed into apparel, hangings, bed linens, or other household items. Appliqué, along with embroidery, are among the most ancient and universal types of decorated textile works (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "appliqué (textile visual work)"@en,
        "applicatie (textielwerk)"@nl .

euf:11485 a skos:Concept ;
    skos:definition "Appliqué in which cut pieces of fabric with embroidery stitches are applied to a secondary ground fabric, or in which the embroidery itself acts to attach the applied material to the ground (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "appliqué embroidery"@en,
        "bordado de aplicación"@es,
        "applicatieborduurwerk"@nl,
        "applikationsbroderi"@sv .

euf:11486 a skos:Concept ;
    skos:definition "Refers to works characterized by a pattern or design executed in stitches using thread or fine wire. The designs are typically executed on textiles, but leather, paper, or another media may also be used; the designs may be intended to be framed, or to decorate apparel, bed linens, furniture coverings, pillows, altar cloths, ceremonial hangings, or other items (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stickerei"@de,
        "κέντημα"@el,
        "embroidery (visual work)"@en,
        "bordado"@es,
        "broderie"@fr,
        "ricamo"@it,
        "borduurwerk"@nl,
        "bordado (produto)"@pt .

euf:11487 a skos:Concept ;
    skos:definition "Needlework done in white on a white ground (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Weißstickerei"@de,
        "whitework"@en,
        "bordado en blanco"@es,
        "wit borduurwerk"@nl,
        "bordado branco"@pt,
        "Vitbroderi"@sv .

euf:11488 a skos:Concept ;
    skos:definition "Refers to works done with one or more needles and thread, yarn or cord. The term generally refers to work done by hand. Needlework includes sewing, embroidery, knitting, and other works. Until the 20th century plain sewing was the most widely practiced form of needlework in Western cultures. Most females learned basic sewing and knitting, which was used in the construction of clothing and the finishing of household textiles. With the introduction of machine sewing, needlework done by hand was often limited to decorative work (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Handarbeit"@de,
        "needlework (visual work)"@en,
        "labores de aguja"@es,
        "travaux d'aiguille"@fr,
        "naaldwerk"@nl,
        "lavores"@pt .

euf:11489 a skos:Concept ;
    skos:definition "Long, wide-sleeved tunics of the type worn as Christian liturgical vestments, or as secular dress in earlier periods, with or without a belt. In modern times it has been sometimes worn by kings or emperors. In the western church, the dalmatic is the outer liturgical vestment of the deacon, worn by bishops under the chasuble at solemn pontifical Masses, and by priests only with permission and on certain occasions; normally priests wear chasubles and subdeacons wear tunicles (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Dalmatik"@de,
        "dalmatic"@en,
        "dalmática"@es,
        "dalmatique"@fr,
        "dalmatica"@it,
        "dalmatiek"@nl,
        "dalmática"@pt,
        "Dalmatika"@sv .

euf:11490 a skos:Concept ;
    skos:altLabel "ambtskleding"@nl ;
    skos:definition "Costume indicative or characteristic of a calling, rank, or function (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "habit"@en,
        "habijt"@nl .

euf:11491 a skos:Concept ;
    skos:definition "Leather or metal cases for carrying small firearms such as pistols, revolvers, or, originally, harquebuses, designed to be worn on a belt or shoulder harness or attached to a saddle. They are shaped to conform to the outlines of the firearm and are open at the top to facilitate quick withdrawl (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Holster"@de,
        "holster"@en,
        "funda de pistola"@es,
        "Holster"@fr,
        "Fondina"@it,
        "holster"@nl,
        "coldre"@pt,
        "Hölster"@sv .

euf:11492 a skos:Concept ;
    skos:definition "Towels for drying dishes (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Geschirrtuch"@de,
        "dish towel"@en,
        "Paño de cocina"@es,
        "strofinaccio"@it,
        "theedoek"@nl .

euf:11493 a skos:Concept ;
    skos:definition "Distinctive clothing worn by clerics and members of religious orders; the term often refers primarily to Christian religious orders, but it may apply to habits used by any religious group. For the ceremonial garments worn of priests and others officiating at religious rituals, use liturgical clothing (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "religious habit"@en,
        "hábito religioso"@es,
        "abito religioso"@it,
        "ordekleed"@nl,
        "hábito religioso"@pt .

euf:11494 a skos:Concept ;
    skos:definition "Distinctive clothing worn by members of monastic religious orders, by which their membership is typically identified (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "monastic clothing"@en,
        "kloosterkleding"@nl .

euf:11495 a skos:Concept ;
    skos:definition "Liturgical vestments comprising a shield-shaped panel of embroidery, artificially stiffened and sometimes adorned with a fringe, attached to the back of the cope. Cope shields evolved from the cappa or hood on the oldest form of copes (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "cope shield"@en,
        "koorkapschild"@nl .

euf:11496 a skos:Concept ;
    skos:definition "Term generally applied to any textile used to cover a bed (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bettware"@de,
        "bed covering"@en,
        "ropa de cama"@es,
        "linge de lit"@fr,
        "מצעים"@he,
        "biancheria da letto"@it,
        "beddengoed"@nl,
        "roupa de cama"@pt,
        "постељина"@sr,
        "sängkläder"@sv .

euf:11497 a skos:Concept ;
    skos:altLabel "aurifries"@nl ;
    skos:definition "Borders of particularly rich embroidery or woven designs in gold thread and colored silk, often embellished with jewels or beads, used as ornamental bands on clothing, such as on royal or ecclesiastical vestments. Term refers to the Phrygians, who were noted for their skill in embroidering with gold (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "aurifrisum"@en,
        "aurifrisum"@nl .

euf:11498 a skos:Concept ;
    skos:definition "Pall, usually of black, purple, or white velvet, used during the funeral ceremony to cover the coffin, hearse, or tomb. May be decorated with commemorative inscriptions or funerary portraits (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bahrtuch"@de,
        "funeral pall"@en,
        "paño mortuorio"@es,
        "drap mortuaire"@fr,
        "פרוכת ארון קבורה"@he,
        "baarkleed"@nl,
        "pano mortuário"@pt,
        "Bårtäcke"@sv .

euf:11499 a skos:Concept ;
    skos:definition "Curtains hung on either side of an altar (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "riddel"@en,
        "baldakijn (altaarhangsel)"@nl .

euf:11500 a skos:Concept ;
    skos:altLabel "banier (processie)"@nl ;
    skos:definition "Banners carried at the head of a procession, usually mounted upon a long staff or handle. They are usually rectangular, but may be triangular or of another shape. They are usually suspended at the top edge, but may be fixed on a stiff frame on all sides. They may be painted or richly embroidered; used in religious processions, royal processions, and for other occasions. They may carry the identification of a confraternity, congregation, or parish (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "processional banner"@en,
        "processievaandel"@nl .

euf:11501 a skos:Concept ;
    skos:altLabel "vaandel"@nl ;
    skos:definition "Pieces of cloth or other flexible material painted with signs or decorative designs and intended to be displayed by hanging or suspending. In heraldry, refers to square flags bearing heraldic devices. For other cloths intended to symbolize or to signal, use flags (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Banner"@de,
        "banner"@en,
        "pendón"@es,
        "bannière"@fr,
        "vessillo"@it,
        "banier"@nl,
        "estandarte"@pt,
        "baner"@sv .

euf:11502 a skos:Concept ;
    skos:definition "Small triangular flags in paper or fabric, illustrated with a saint, the church or chapel where the saint is venerated, and occasionally scenes from the life of the saint, or events occurring at the church or chapel. These were typically sold as souvenirs of the pilgrimage itself (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pilgrimage pennant"@en,
        "bedevaartvaantje"@nl .

euf:11503 a skos:Concept ;
    skos:definition "Underbodices worn over a corset with sleeves or built-up straps (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "corset cover"@en,
        "cubrecorsé"@es,
        "cache-corset"@fr,
        "cache-corset"@nl .

euf:11504 a skos:Concept ;
    skos:definition "Coverings made of cloth, generally of precious material and decorated, designed to cover the ciborium, which is a vessel for the Christian eucharistic bread (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "ciborium veil"@en,
        "ciborievelum"@nl .

euf:11505 a skos:Concept ;
    skos:definition "Linen coverings for the credence, often matching the altar cloth (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "credence cloth"@en,
        "credenskleed"@nl,
        "mantel de credência"@pt .

euf:11507 a skos:Concept ;
    skos:altLabel "diving suit"@en,
        "duikerspak"@nl ;
    skos:definition "Garment or device designed to protect a diver from the underwater environment."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Tauchanzug"@de,
        "diver's suit"@en,
        "traje acuático"@es,
        "combinaison de plongée"@fr,
        "חליפת צלילה"@he,
        "muta subacquea"@it,
        "duikpak"@nl,
        "dykardräkt"@sv .

euf:11508 a skos:Concept ;
    skos:altLabel "halsdoek"@nl ;
    skos:definition "Pieces of cloth made in varying widths and lengths and worn for decoration or warmth across the shoulders, around the neck, over the head, or about the waist (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schal"@de,
        "scarf"@en,
        "bufanda"@es,
        "écharpe"@fr,
        "צעיף"@he,
        "sciarpa"@it,
        "sjaal"@nl,
        "cachecol"@pt,
        "шал"@sr,
        "halsduk"@sv .

euf:11509 a skos:Concept ;
    skos:definition "Large curtains hung in front of the altar during Lent to conceal it from the view of the congregation. The veils are often decorated, for example, stenciled or embroidered (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Fastentuch"@de,
        "Lenten veil"@en,
        "velo de cuaresma"@es,
        "Toile de la Passion"@fr,
        "tela della Passione"@it,
        "hongerdoek"@nl,
        "fasteduk"@sv .

euf:11510 a skos:Concept ;
    skos:definition "Refers to screens comprising two or more panels in a frame which has hinged sections that can be folded to adjust coverage. They are often decorated. Early examples include the Chinese form, mentioned as early as the 2nd century BCE. The earliest surviving examples date to the Ming dynasty. Folding screens were introduced to Japan from China in the 8th century; such screens were often designed in pairs in Japan. From the early 17th century eastern folding screens were imported to Europe and the form was soon adopted by European craftsmen (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Spanische Wand"@de,
        "folding screen"@en,
        "mampara"@es,
        "paravent"@fr,
        "paravento"@it,
        "kamerscherm"@nl,
        "biombo"@pt,
        "Vikvägg"@sv .

euf:11511 a skos:Concept ;
    skos:definition "Refers to a set of instructions or a formula detailing the specific quantities and proportions of different colors that should be mixed together to achieve a desired or specified color. This term is commonly used in the context of color mixing for various applications such as painting, printing, or dyeing, where precise color matching is essential. The color recipe provides a systematic guide for reproducing a particular hue consistently (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "color recipe"@en,
        "kleurrecept"@nl .

euf:11512 a skos:Concept ;
    skos:definition "Hangings attached to the front of or covering a lectern, often embroidered or painted, sometimes in the liturgical color corresponding to the current season of the church calendar (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "lectern cover"@en,
        "lezenaarsantependium"@nl .

euf:11513 a skos:Concept ;
    skos:definition "A lingerie set refers to a coordinated ensemble of intimate apparel worn by individuals, typically consisting of matching or complementary pieces such as bras, panties, garters, and, sometimes, additional accessories like stockings or garter belts."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "lingerie set"@en,
        "lingerie set"@nl .

euf:11514 a skos:Concept ;
    skos:definition "Cutting instruments consisting of a blade with a sharpened longitudinal edge fixed in a handle, either rigidly as in a table-, carving, or sheath-knife, or with a joint as in a pocket- or clasp-knife. Knives may be used to cut food, especially in serving and eating, as weapons, and for other purposes. The blade may be of steel or another metal or stone, as in the flint knives of early man, or of another material such as ivory or wood (as with a paperknife). The term also refers to tools that are shaped or used as knives, even if the edge is not particularly sharp or actually used for cutting (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Messer"@de,
        "Μαχαίρι"@el,
        "knife"@en,
        "cuchillo"@es,
        "couteau"@fr,
        "סכין"@he,
        "coltello"@it,
        "mes"@nl,
        "faca"@pt,
        "нож"@sr,
        "kniv"@sv .

euf:11515 a skos:Concept ;
    skos:definition "Any of various small pincer-shaped tools used for plucking, holding, or manipulating (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Pinzette"@de,
        "tweezer"@en,
        "pinza"@es,
        "pince à épiler"@fr,
        "מלקטת"@he,
        "pinzette"@it,
        "pincet"@nl,
        "pinça"@pt,
        "пинцета"@sr,
        "pincett"@sv .

euf:11516 a skos:Concept ;
    skos:definition "Coverings and curtains, usually black in color, placed over sculptures, paintings, mirrors, and other elements at an altar or elsewhere in a church, or in another public or private building; used to signify mourning, such as during a requiem service or during a mourning period (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "mourning cloths"@en,
        "rouwbekleding"@nl .

euf:11517 a skos:Concept ;
    skos:definition "A sacrament banner is a ceremonial and often decorative flag or banner used in religious contexts, particularly within Christian traditions. It is designed to symbolize and honor specific sacraments, such as baptism, confirmation, marriage, and the Eucharist. Sacrament banners typically display religious symbols, icons, or imagery associated with the sacrament being celebrated. These banners are often used in church ceremonies, processions, and liturgical events to visually represent and emphasize the sacred nature of the sacraments within the Christian faith."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sacrament banner"@en,
        "sacramentvaandel"@nl .

euf:11518 a skos:Concept ;
    skos:definition "Short cloaks covering the shoulders, especially as adopted by certain religious orders as part of their ordinary costume. An example of usage is when scapulars were prescribed by the Rule of St. Benedict, originally worn by monks when engaged in manual labor (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Skapulier"@de,
        "scapular (cloak)"@en,
        "escapulario"@es,
        "scapulaire"@fr,
        "scapolare"@it,
        "scapulier"@nl,
        "escapulário"@pt .

euf:11519 a skos:Concept ;
    skos:definition "Cords, narrow bands, or the like worn at the waist, especially those worn as an ecclesiastical vestment (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Zingulum"@de,
        "cincture (girdle)"@en,
        "Cíngulo"@es,
        "cingolo"@it,
        "singel (gordel)"@nl,
        "cíngulo"@pt,
        "Cingulum"@sv .

euf:11520 a skos:Concept ;
    skos:definition "A die cutter refers to a tool or machine designed for precision cutting of materials such as paper, cardboard, fabric, or metal. It operates by pressing a die (a shaped cutting tool) into the material to create a specific shape or pattern."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "die cutter"@en,
        "stansijzer"@nl .

euf:11521 a skos:Concept ;
    skos:definition "Neckwear comprising narrow strips of fabric, typically white in color and sometimes trimmed with lace, that are basted as liners inside the neck of an ecclesiastical stole or other similar non-ecclesiastical garment to protect it from soiling due to contact with the skin (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "stole collar (liner)"@en,
        "stoolkraag"@nl .

euf:11522 a skos:Concept ;
    skos:definition "Needles with long-shaped eyes that take flat, darning threads (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stopfnadel"@de,
        "darning needle"@en,
        "stopnaald"@nl,
        "stoppnål"@sv .

euf:11523 a skos:Concept ;
    skos:definition "A tabernacle curtain, also known as a tabernacle veil or tabernacle hanging, is a liturgical fabric suspended in front of the tabernacle, a sacred receptacle typically found in Christian churches."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "tabernacle curtain"@en,
        "tabernakelgordijn"@nl .

euf:11524 a skos:Concept ;
    skos:definition "A tabernacle veil is a decorative fabric employed in religious settings, specifically within Christian traditions, to cover and embellish the tabernacle."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "tabernacle veil"@en,
        "tabernakelvelum"@nl .

euf:11525 a skos:Concept ;
    skos:definition "Any of various looms or weaving devices operated wholly or partly by hand or foot power (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Handwebstuhl"@de,
        "handloom"@en,
        "telar a mano"@es,
        "métier à bras"@fr,
        "telaio a mano"@it,
        "handgetouw"@nl,
        "tear manual"@pt,
        "handvävstol"@sv .

euf:11526 a skos:Concept ;
    skos:definition "Devices incorporated in special looms to control individual warp yarns via a system of punched cards. This invention, by Joseph Marie Jacquard, and first demonstrated in 1801, enabled looms to produce fabrics with complex patterns and images such as tapestry, brocade, damask, and matelasse (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "jacquardloom"@en,
        "jaquardgetouw"@nl .

euf:11527 a skos:Concept ;
    skos:definition "A felting needle is a specialized tool used in the craft of felting, a process of matting and compacting fibers to create a dense and cohesive fabric. The felting needle has a pointed tip with tiny barbs along its shaft. During felting, the needle is repeatedly pushed into the fiber or wool, entangling the fibers and binding them together. Felting needles come in various sizes and shapes, allowing for precision in shaping and detailing during the felting process. This tool is widely employed in both wet felting and needle felting techniques, enabling artisans to create intricate and three-dimensional felted designs in various textile projects."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "felting needle"@en,
        "viltnaald"@nl .

euf:11528 a skos:Concept ;
    skos:definition "Refers to a specialized tool used in the field of weaving or textile arts. This needle plays a crucial role in the process of warping, which is the initial stage of setting up a loom for weaving. The primary function of the warping needle is to facilitate the precise and systematic arrangement of warp threads on the loom."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "warping needle"@en,
        "weefnaald"@nl .

euf:11529 a skos:Concept ;
    skos:definition "Portable cases in which a priest carries articles such as anointing oils, etc. to administer the sacrament of the sick (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sick call set"@en,
        "ziekenbeurs"@nl .

euf:11530 a skos:Concept ;
    skos:altLabel "klein naaigerief"@nl,
        "naaigerief"@nl ;
    skos:definition "Refer to a diverse range of small, often decorative, and functional items used in sewing and needlework. These items include but are not limited to needles, pins, buttons, snaps, zippers, ribbons, threads, and other accessories that aid in the sewing process."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sewing notions"@en,
        "naaigerei"@nl .

euf:11531 a skos:Concept ;
    skos:definition "Items comprising relatively short lengths of rope or cord, designed to be used in various contexts, including but not limited to the following: to hold a whistle, knife, or other item around the neck of a person, to wear as a symbol of a military citation, to attach something to a costume, to attach a sign or name tag to an item, to fasten something on a ship (particularly rope passing through deadeyes to extend shrouds or stays), or to fire a cannon, sound a whistle, or activate some other system (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "lanyard"@en,
        "koord"@nl .

euf:11532 a skos:Concept ;
    skos:definition "Parts and components of textiles (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Textilkomponente"@de,
        "textile component"@en,
        "componente de textil"@es,
        "componente tessile"@it,
        "textielonderdeel"@nl .

euf:11533 a skos:Concept ;
    skos:definition "A long and narrow piece of textile material characterized by finished or treated edges. These strips are often cut intentionally for various purposes, such as crafting, quilting, or sewing projects. The finished edges contribute to the neatness and durability of the strip, making it suitable for use in a variety of applications. Fabric strips can be employed in creative endeavors like patchwork, appliqué, or garment embellishments, and they may serve both functional and decorative roles within textile projects."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "fabric strip"@en,
        "boord (textielonderdeel)"@nl .

euf:11534 a skos:Concept ;
    skos:definition "Refers to a long and narrow piece of textile material characterized by unprocessed or untreated edges."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "raw-adged fabric strip"@en,
        "strook (textielonderdeel)"@nl .

euf:11535 a skos:Concept ;
    skos:definition "Rectangular pieces of white cloth, usually linen, worn around the neck and partly under the alb; designed to protect other vestments from perspiration (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Amikt"@de,
        "amice"@en,
        "Amito"@es,
        "amict"@fr,
        "Amitto"@it,
        "amict"@nl,
        "amito"@pt,
        "Halslin"@sv .

euf:11537 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sample bundle"@en,
        "stalenbundel"@nl .

euf:11538 a skos:Concept ;
    skos:definition "A container holding a selection of material samples, typically organized for easy access and reference. Sample boxes are commonly used in industries like textiles, allowing individuals to review and compare different material options conveniently."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sample box"@en,
        "stalendoos"@nl .

euf:11539 a skos:Concept ;
    skos:definition "A folder or portfolio containing individual material samples, organized for easy reference. Sample folders are often used in contexts like interior design or product development to present and evaluate material options in a structured manner."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sample folder"@en,
        "stalenmap"@nl .

euf:11540 a skos:Concept ;
    skos:definition "A compact, fan-shaped collection of material samples, designed for easy browsing and comparison. Sample fans are commonly used in various industries to showcase a range of material options, facilitating the decision-making process by allowing users to assess colors, textures, and patterns in a hands-on and organized manner."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sample fan"@en,
        "stalenwaaier"@nl .

euf:11542 a skos:Concept ;
    skos:definition "Refers to the collection of historical documents, records, and materials accumulated by a business or organization over time. These archives may include financial records, legal documents, correspondence, reports, and other relevant materials that provide a historical perspective on the company's activities and development. The management of a business archive involves organizing, preserving, and making accessible these historical records for reference, research, and compliance purposes."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "company archive"@en,
        "bedrijfsarchief"@nl .

euf:11543 a skos:Concept ;
    skos:definition "Documentation material comprises written, visual, or digital content created to record, explain, or communicate information within a specific context. It includes a wide range of materials such as manuals, guides, reports, diagrams, and other resources designed to convey knowledge, procedures, or details related to a subject, project, or process. The purpose of documentation material is to facilitate understanding, support decision-making, and provide a reference for users, stakeholders, or collaborators. Effective documentation is crucial for maintaining clarity, consistency, and accessibility of information within various professional and organizational settings."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "documentation material"@en,
        "documentatie materiaal"@nl .

euf:11544 a skos:Concept ;
    skos:definition "Types of textual, graphic, electronic, or physical items having the primary and original purpose to record or convey specific information."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "information form (object)"@en,
        "informatievorm"@nl .

euf:11545 a skos:Concept ;
    skos:altLabel "patronentijdschrift"@nl ;
    skos:definition "A pattern magazine is a publication that features a variety of sewing patterns along with related content such as sewing tips, tutorials, and fashion inspiration. These magazines serve as valuable resources for individuals interested in sewing and crafting their own garments. They typically include paper patterns or pattern inserts that readers can use to create specific clothing items."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pattern magazine"@en,
        "naaitijdschrift"@nl .

euf:11546 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "technical data sheet"@en,
        "technische fiche"@nl .

euf:11547 a skos:Concept ;
    skos:altLabel "catalogus"@nl ;
    skos:definition "Enumerations of items, such as a file of bibliographic records or a list of art objects, usually arranged systematically and with descriptive details; may be in book or pamphlet form, on cards, or online. Catalogs are created according to specific and uniform principles of construction and usually under the control of an authority file (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "catalog (document)"@en,
        "cataloog"@nl .

euf:11548 a skos:Concept ;
    skos:altLabel "verkoopscatalogus"@nl ;
    skos:definition "Catalogs that enumerate items that are for sale (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "sales catalog"@en,
        "verkoopscataloog"@nl .

euf:11549 a skos:Concept ;
    skos:definition "Blank books or albums designed so that a variety of items may be affixed to the pages, including photographs, clippings, and other memorabilia (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "scrapbook"@en,
        "plakboek"@nl .

euf:11550 a skos:Concept ;
    skos:definition "Pieces of paper, leather, fabric, or small tablets inscribed and affixed to something for identification or description. In the context of bookbinding, refers specifically to paper or other material separate from that used to cover a book, on which the author's name and the title are printed or engraved and glued to the spine or front board (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "label"@en,
        "etiket"@nl .

euf:17968 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Cluny Spitze"@de,
        "Cluny bobbin lace"@en,
        "dentelle de Cluny"@fr,
        "Clunykant"@nl,
        "Cluny-spets"@sv .

aat:300000202 a skos:Concept ;
    skos:definition "Aggregations of buildings, other structures, and/or open spaces, often multifunctional, and more extensive than single built works, usually shaped over a longer period of time by more participants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "complexes"@en .

aat:300000206 a skos:Concept ;
    skos:definition "Complexes where plants or animals are raised for livelihood or commerce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farms"@en .

aat:300000210 a skos:Concept ;
    skos:definition "Farms consisting of many small holdings collected into a single unit for joint operation by a community under public or state supervision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collective farms"@en .

aat:300000211 a skos:Concept ;
    skos:definition "Pieces of land rented or sold to a farmer or other laborer by county or local authorities for purposes of cultivation, often as a supplement to primary income."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small holdings"@en .

aat:300000214 a skos:Concept ;
    skos:definition "Farms chiefly devoted to the raising of dairy cattle and the production of milk, butter, and cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dairy farms"@en .

aat:300000218 a skos:Concept ;
    skos:definition "Farms or areas of forest used to raise trees, typically managed in a way that ensures the regular production of trees to replace those extracted for timber or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tree farms"@en .

aat:300000222 a skos:Concept ;
    skos:definition "Farms that are considered historical because they preserve methods of rural life and farming from past centuries, whether for tourists, historical preservation, or to produce crops or livestock. For former farms that have been abandoned, use \"abandoned farms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic farms"@en .

aat:300000226 a skos:Concept ;
    skos:definition "Yards or enclosures attached to a farmhouse or surrounded by farm buildings, used for airing livestock and other purposes. Yards or enclosures attached to a farmhouse or surrounded by farm buildings, used for airing livestock and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farmyards"@en .

aat:300000228 a skos:Concept ;
    skos:definition "Facilities where fish eggs are hatched and the fry raised, especially to stock lakes, streams, and ponds. Facilities where fish eggs are hatched and the fry raised, especially to stock lakes, streams, and ponds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish hatcheries"@en .

aat:300000231 a skos:Concept ;
    skos:definition "Large Spanish landed estates common to 17th century Seville used as farms, or ranches. Also applies to Spanish-American estates and the main building of such a complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haciendas"@en .

aat:300000235 a skos:Concept ;
    skos:definition "Large, ancient Roman agricultural estates; for modern Spanish Latin American contexts, prefer \"haciendas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latifundia"@en .

aat:300000238 a skos:Concept ;
    skos:definition "Landed estates administered as units and consisting of the main residence (manor house), demesnes, and the land over which the lord has privileges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manors"@en .

aat:300000240 a skos:Concept ;
    skos:definition "Generally, agricultural complexes usually worked by resident labor. More specifically, large estates in tropical or subtropical regions that are usually cultivated by resident unskilled or semi-skilled labor under central direction. Meaning and usage overlap with \"estates(commercial agricultural holding),\" although such estates are typically smaller enterprises than plantations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plantations"@en .

aat:300000241 a skos:Concept ;
    skos:definition "Denotes establishments with extensive landholdings usually for the grazing of cattle; larger than farms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranches"@en .

aat:300000243 a skos:Concept ;
    skos:definition "Ranches devoted primarily to the raising of beef cattle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle ranches"@en .

aat:300000245 a skos:Concept ;
    skos:definition "Ranches that provide entertainment for paying guests and tourists who wish to learn to ride horses or bulls, herd cattle, or do other activities associated with ranching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dude ranches"@en .

aat:300000246 a skos:Concept ;
    skos:definition "Tracts of land devoted to rearing sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheep farms"@en .

aat:300000248 a skos:Concept ;
    skos:definition "Tracts of land on which grapevines are cultivated; plantations of vines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vineyards"@en .

aat:300000256 a skos:Concept ;
    skos:definition "Marketplaces, usually consisting of a network of covered streets, stalls, booths, and shops, common in parts of North Africa and West Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bazaars"@en .

aat:300000271 a skos:Concept ;
    skos:definition "Buildings housing the offices, stages, backlots, sound stages, and other studios and operations of a motion picture studio company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion picture studios"@en .

aat:300000277 a skos:Concept ;
    skos:definition "Designates internment centers established outside ordinary detention systems in which persons are confined for military or political security or for punishment or exploitation; persons are generally imprisoned by decree or military order, often including classes or groups of people without regard for their individual culpability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concentration camps"@en .

aat:300000280 a skos:Concept ;
    skos:definition "Distant or overseas settlements established for punishing criminals by forced labour and isolation from society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penal colonies"@en .

aat:300000281 a skos:Concept ;
    skos:definition "Minimum-security facilities where inmates work on, usually government-sponsored, forest, woods, or park conservation or maintenance projects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prison camps"@en .

aat:300000283 a skos:Concept ;
    skos:definition "Collective concept referring to the types of living arrangements of a particular group. For the specific structures or groups of structures designed for these arrangements, use the descriptors collocated under \"dwellings\", <housing complexes>, or \"settlements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housing"@en .

aat:300000289 a skos:Concept ;
    skos:definition "Dwellings grouped closely together to form relatively compact units, with the space between clusters usually allocated to pedestrian circulation and cooperative recreational use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cluster housing"@en .

aat:300000291 a skos:Concept ;
    skos:definition "Designates the dwelling, land, and outbuildings, if any, where a family lives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homesteads"@en .

aat:300000293 a skos:Concept ;
    skos:definition "Housing of two to four stories accessible by stairs only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-rise housing"@en .

aat:300000297 a skos:Concept ;
    skos:definition "Housing that is intended to provide accommodation for residents for a relatively short period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temporary housing"@en .

aat:300000304 a skos:Concept ;
    skos:definition "Housing provided consequent upon a sudden state of danger or calamity that has made people's regular housing inaccessible or unsafe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency housing"@en .

aat:300000307 a skos:Concept ;
    skos:definition "Planned residential developments, generally publicly built and operated, intended for low- and moderate-income tenants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housing projects"@en .

aat:300000311 a skos:Concept ;
    skos:definition "Housing constructed or altered to facilitate the particular needs of the disabled, particularly the physically disabled, for example including wheelchair ramps rather than or in addition to stairways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housing for the handicapped"@en .

aat:300000312 a skos:Concept ;
    skos:definition "Apartment complexes, single family dwellings, or other housing owned by one individual or corporation and rented or leased to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rental housing"@en .

aat:300000313 a skos:Concept ;
    skos:definition "Housing built or renovated by nonprofit groups or single families whose labor is counted as part of the homeowner's equity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-help housing"@en .

aat:300000317 a skos:Concept ;
    skos:definition "Housing in which multiple individuals, couples, or nuclear families have some shared facilities (for example, laundry facilities or gardening services) but maintain primarily separate living spaces that have been constructed in quantity, either as multiple dwellings under one roof (such as in an apartment house) or in single units (such as a retirement community). When communal housing comprises separate buildings, the buildings typically have a uniform or coordinated appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communal housing"@en .

aat:300000319 a skos:Concept ;
    skos:definition "The dwellings or buildings of Fourierist communities. The dwellings or buildings of Fourierist communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phalansteries"@en .

aat:300000322 a skos:Concept ;
    skos:definition "Housing provided by an industry to its employees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial housing"@en .

aat:300000323 a skos:Concept ;
    skos:definition "Low cost housing, owned, sponsored, or administered by a municipal or other governmental agency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public housing"@en .

aat:300000324 a skos:Concept ;
    skos:definition "Public housing units, either new or rehabilitated, located on noncontiguous sites and intended to promote racial integration by placing relatively small housing units within the context of existing neighborhoods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scattered-site housing"@en .

aat:300000325 a skos:Concept ;
    skos:definition "Ancient Roman tenements or apartment houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insulae"@en .

aat:300000326 a skos:Concept ;
    skos:definition "Distinguished from \"trailer camps\" by being only for infrequently moved prefabricated structures designed for year-round living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobile home parks"@en .

aat:300000329 a skos:Concept ;
    skos:definition "Multistory, multiroom complex dwellings, often built on mesas or in cliffs, common among certain Indian cultures of the southwestern United States; distinguished from \"Great Houses (complexes)\" by their location and agglutinated construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pueblos"@en .

aat:300000330 a skos:Concept ;
    skos:definition "Groupings of educational buildings and other facilities; if possible, use a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational complexes"@en .

aat:300000333 a skos:Concept ;
    skos:definition "Grounds of colleges or universities, including the open space between or around the buildings. The term is also used to refer to the grounds of other building complexes with layouts similar to colleges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campuses"@en .

aat:300000340 a skos:Concept ;
    skos:definition "Farms attached to education facilities either for the purpose of teaching agriculture or providing meats and produce to the parent institution. Farms attached to education facilities either for the purpose of teaching agriculture or providing meats and produce to the parent institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school farms"@en .

aat:300000348 a skos:Concept ;
    skos:definition "Gardens, parks, or other grounds in which wild animals, and sometimes also domestic animals, are kept for public exhibition, usually in enclosures. Animals in zoos can generally be given more intensive care than is possible in nature reserves or wildlife refuges. Marine invertebrates, fish, and sometimes marine mammals, are often kept in separate aquariums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoos"@en .

aat:300000351 a skos:Concept ;
    skos:definition "Zoos designed for the education and enjoyment of children and young adults, often including a petting zoo, animal shows, and exhibits of baby animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's zoos"@en .

aat:300000353 a skos:Concept ;
    skos:definition "Places where collections of wild or unusual animals are kept or exhibited in cages, particularly the early collections of emperors, kings, or other elite collectors, or 19th- and early 20th-century traveling exhibitions of caged animals. Traveling menageries were distinct from circuses in that the animals did not normally perform tricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menageries"@en .

aat:300000354 a skos:Concept ;
    skos:definition "Zoos in which many or all of the animals have access to open-air enclosures that resemble the animals' natural habitats, in contrast to early zoos where most animals were confined to relatively small cages. Zoos in which many or all of the animals have access to open-air enclosures that resemble the animals' natural habitats, in contrast to early zoos where most animals were confined to relatively small cages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open-air zoos"@en .

aat:300000357 a skos:Concept ;
    skos:definition "Distinguished from \"safari parks\" by the complete and planned separation of the visiting public from the animals, who are allowed to roam freely within bounded natural habitats. Distinguished from \"safari parks\" by the complete and planned separation of the visiting public from the animals, who are allowed to roam freely within bounded natural habitats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wild animal parks"@en .

aat:300000367 a skos:Concept ;
    skos:definition "Underground systems of passages used as cemeteries, generally unsystematic and irregular in plan with networks of galleries and multiple levels over extensive areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catacombs"@en .

aat:300000368 a skos:Concept ;
    skos:definition "Places reserved for depositing ashes or ash urns of the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cineraria"@en .

aat:300000370 a skos:Concept ;
    skos:definition "Sepulchral chambers lined with rows of niches for cinerary urns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columbaria"@en .

aat:300000372 a skos:Concept ;
    skos:definition "Large elaborate cemeteries of ancient cities or ancient or prehistoric burying places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "necropolises"@en .

aat:300000375 a skos:Concept ;
    skos:definition "Burial grounds established and maintained by a nation for the interment of military persons, civilian leaders, and other important national figures. In the United States, an official designation for 139 burial grounds established by the Congress of the United States in 1862 for the interment of armed forces servicemen and women whose last service ended honorably, but also containing the remains of certain civilian leaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national cemeteries"@en .

aat:300000376 a skos:Concept ;
    skos:definition "Refers to cemeteries set aside for the burial of pets or other animals, usually domestic animals. Refers to cemeteries set aside for the burial of pets or other animals, usually domestic animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pet cemeteries"@en .

aat:300000378 a skos:Concept ;
    skos:definition "Public burial places for paupers, unknown persons, and criminals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potter's fields"@en .

aat:300000380 a skos:Concept ;
    skos:definition "Refers to burial sites specifically for victims of a battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "war cemeteries"@en .

aat:300000385 a skos:Concept ;
    skos:definition "Use generally for any grouping of diversified industrial buildings and related facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial complexes"@en .

aat:300000386 a skos:Concept ;
    skos:definition "Plants where heating and illuminating gas are manufactured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasworks"@en .

aat:300000388 a skos:Concept ;
    skos:definition "Industrical complexes focusing on extraction of minerals, oil, or other material from the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extracting complexes"@en .

aat:300000389 a skos:Concept ;
    skos:definition "Excavations from which gravel or sand is or has been obtained, particularly excavations where the holes have been dug vertically into the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravel pits"@en .

aat:300000390 a skos:Concept ;
    skos:definition "Excavation or systems of excavations, including pits or tunnels, made underground for the extraction of metals, metallic ores, coal, salt, precious stones, building stone, clay, or another substance, or an open-air excavation for the extraction of such substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mines"@en .

aat:300000398 a skos:Concept ;
    skos:definition "Mines from which the primary extraction is copper, which is an element and reddish metal that is very malleable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper mines"@en .

aat:300000399 a skos:Concept ;
    skos:definition "Mines from which the primary extraction is iron, which is an element and lustrous, silvery, soft metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron mines"@en .

aat:300000400 a skos:Concept ;
    skos:definition "Mines from which the primary extraction is tin, which is an element and a soft, pliable, silvery white metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin mines"@en .

aat:300000401 a skos:Concept ;
    skos:definition "Areas of land or seabed under which are found oil-bearing strata, particularly when the oil is found in pools and in amounts large enough to support commercial exploitation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil fields"@en .

aat:300000402 a skos:Concept ;
    skos:definition "Open-air excavations from which stone for building or other purposes is or has been obtained by cutting or blasting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarries"@en .

aat:300000403 a skos:Concept ;
    skos:definition "Places or enclosures where ships are built or repaired. For places servicing small vessels, use \"boatyards.\" Places or enclosures where boats or ships are built or repaired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipyards"@en .

aat:300000410 a skos:Concept ;
    skos:definition "Groups of houses or tents and associated facilities designed as a residence for loggers who are temporarily in a forest to cut down and transport timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumber camps"@en .

aat:300000411 a skos:Concept ;
    skos:definition "Refers to areas zoned and planned for so-called clean industries, developed and managed as a unit, where plots are offered fully equipped with transport and installation facilities, often already including a number of multi-use buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial parks"@en .

aat:300000414 a skos:Concept ;
    skos:definition "Complexes of buildings and other structures with machinery for generating electricity from various types of fuel, such as fossil fuels, nuclear, biomass, geothermal, and solar thermal energy sources. For individual buildings in which electricity, or other forms of power, are generated for the operation of machinery or vehicles, or supplying power to other buildings in a complex, use \"powerhouses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power plants"@en .

aat:300000420 a skos:Concept ;
    skos:definition "Power plants in which gas is burned, with compressed air or oil, to run steam-driven turbines that produce electrical energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas-turbine power plants"@en .

aat:300000425 a skos:Concept ;
    skos:definition "Power plants using water pumped to and stored at a high elevation during periods of low energy demand, for use when demand is high, when water is released to operate hydraulic turbines to produce needed electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumped storage power plants"@en .

aat:300000426 a skos:Concept ;
    skos:definition "Facilities designed to extract and store energy, employing one or more of the following methods, or other methods: harnessing energy from the differences between high tides and low tides by employing a \"barrage\" or type of dam to block receding water during ebb periods, the subsequent release of the water through a turbine generating electricity as the tide rises (similar to the workings of hydroelectric dams); using tidal stream power by utilizing ocean currents to drive turbines, particularly in areas around islands or coasts where these currents are fast, including systems that employ tidal fences where turbines are stretched across a channel or tidal turbines that resemble underwater wind turbines; using wave power systems to harness energy from the up-and-down motion of waves to drive energy production, installed in shoreline areas as well as offshore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tidal power plants"@en .

aat:300000428 a skos:Concept ;
    skos:definition "Facilities that harness and distribute energy derived from the sun's radiation by producing heat, causing chemical reactions, or generating electricity in any of several methods, including but not limited to the following: by the using direct solar radiation to heat air, water, or another carrier fluid; by using arrays of lenses or mirrors as solar collectors to concentrate sunlight to produce high temperatures in a solar furnace; or by using solar cells (photovoltaic cells) to convert solar radiation into electricity when a small electric voltage is generated in the solar cell as light strikes the junction between a metal and a semiconductor (such as silicon) or the junction between two different semiconductors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar power plants"@en .

aat:300000430 a skos:Concept ;
    skos:definition "Power plants producing electricity by utilizing temperature differentials between surface water heated by the sun and deep cold water pumped to the surface. Power plants producing electricity by utilizing temperature differentials between surface water heated by the sun and deep cold water pumped to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ocean thermal energy conversion plants"@en .

aat:300000431 a skos:Concept ;
    skos:definition "Power plants in which the prime movers, usually turbines, connected to the generators are driven by steam to produce electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam power plants"@en .

aat:300000434 a skos:Concept ;
    skos:definition "Steam-producing, electric power generating plants using coal as the primary fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal-fired power plants"@en .

aat:300000438 a skos:Concept ;
    skos:definition "Power plants using steam generated by geothermal sources, such as geysers, hot springs, or volcanoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geothermal power plants"@en .

aat:300000439 a skos:Concept ;
    skos:definition "Facilities that create and distribute power obtained from nuclear reactors, which initiate and control a self-sustaining series of nuclear fissions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear power plants"@en .

aat:300000444 a skos:Concept ;
    skos:definition "Large scale energy conversion centers that burn the fossil fuel oil to produce electricity. Large scale energy conversion centers that burn the fossil fuel oil to produce electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil-fired power plants"@en .

aat:300000445 a skos:Concept ;
    skos:definition "Facilities designed for the creation and distribution of power derived from wind, where turbines convert the kinetic energy of wind into mechanical or electrical energy that can be used for power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind power plants"@en .

aat:300000448 a skos:Concept ;
    skos:definition "Buildings serving as a repository or magazine for arms and military equipment. For buildings used for military training, where some arms may also be stored, use \"armories (military training buildings)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arsenals"@en .

aat:300000451 a skos:Concept ;
    skos:definition "Use only for military weapons testing; for small arms target ranges, use \"shooting ranges\" or a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firing ranges"@en .

aat:300000455 a skos:Concept ;
    skos:definition "Use generally in contemporary contexts for permanent centers of operations; use \"military camps\" for contemporary nonpermanent posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military bases"@en .

aat:300000456 a skos:Concept ;
    skos:definition "Bases for the operation of military aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air bases"@en .

aat:300000459 a skos:Concept ;
    skos:definition "Land-based military airbases for the military aviation division of the navy of a nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval air bases"@en .

aat:300000461 a skos:Concept ;
    skos:definition "Permanent group of installations for which a local commander is responsible, consisting of support facilities necessary for army activities, including security, internal communications, and utility systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "army bases"@en .

aat:300000462 a skos:Concept ;
    skos:definition "Military bases for the storage and deployment of guided missiles, which are self-propelled projectiles used as weapons, including but not limited to long-range ballistic missiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guided missile bases"@en .

aat:300000465 a skos:Concept ;
    skos:definition "Facilities specializing in the training of military personnel, typically including training in the use of weapons, discipline, endurance, and survival training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military training camps"@en .

aat:300000467 a skos:Concept ;
    skos:definition "Area naval commands normally including a seaport, which integrates shore activities that provide local logistic services to the fleet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval bases"@en .

aat:300000472 a skos:Concept ;
    skos:definition "Naval bases that build, repair, dock, or convert warships, and are manned by civilian engineers and workers and administered by engineer duty officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval shipyards"@en .

aat:300000475 a skos:Concept ;
    skos:definition "Military bases that shelter and deploy submarines and personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submarine bases"@en .

aat:300000476 a skos:Concept ;
    skos:definition "In contemporary military contexts this refers to groups of huts, tents, or other shelters set up temporarily for troops. In historical contexts the term connotes permanent or semipermanent places of encampment. Use \"military bases\" for contemporary permanent installations. In contemporary military contexts this refers to groups of huts, tents, or other shelters set up temporarily for troops. In historical contexts the term connotes permanent or semipermanent places of encampment. Use \"military bases\" for contemporary permanent installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military camps"@en .

aat:300000484 a skos:Concept ;
    skos:definition "Multifunctional Islamic fortified outposts generally reserved for warriors of the Faith who are committed to defense of frontiers and to proselytizing. Multifunctional Islamic fortified outposts generally reserved for warriors of the Faith who are committed to defense of frontiers and to proselytizing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribats"@en .

aat:300000485 a skos:Concept ;
    skos:definition "Target range for guided missiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guided missile ranges"@en .

aat:300000486 a skos:Concept ;
    skos:definition "Buildings for the storage and distribution of ammunition, weapons, military vehicles, and equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordnance depots"@en .

aat:300000490 a skos:Concept ;
    skos:definition "Building complexes that house offices and facilities for the support of the offices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office complexes"@en .

aat:300000491 a skos:Concept ;
    skos:definition "Areas of land or property where many office buildings may be grouped together and developed specifically to attract corporate offices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office parks"@en .

aat:300000498 a skos:Concept ;
    skos:definition "Commercially developed real estate tracts commonly consisting of one- to four-unit dwellings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housing developments"@en .

aat:300000500 a skos:Concept ;
    skos:definition "Relatively large-scale real estate projects incorporating several revenue-producing functions, having a highly intensive use of land, and developed from a coherent plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed-use developments"@en .

aat:300000506 a skos:Concept ;
    skos:definition "Designates groups of mostly commercial enterprises, usually a mix of fast-food restaurants, motels, and service stations, among others, arranged directly alongside well-traveled roads, providing nearly unlimited roadway access, and designed to attract the attention of motorists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial strips"@en .

aat:300000508 a skos:Concept ;
    skos:definition "Areas of land divided into blocks or lots, provided with streets or roads and open spaces, and then offered for sale or lease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subdivisions"@en .

aat:300000510 a skos:Concept ;
    skos:definition "Land and water spaces and associated structures set aside for recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreation areas"@en .

aat:300000512 a skos:Concept ;
    skos:definition "Commercially operated areas containing rides, stalls, and shows, and other entertainment attractions intended to attract a large number of visitors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amusement parks"@en .

aat:300000515 a skos:Concept ;
    skos:definition "Amusement parks organized round a unifying idea or group of ideas, for example, Medieval castles or science fiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theme parks"@en .

aat:300000516 a skos:Concept ;
    skos:definition "In the context of amusement parks, exhibitions, fairs, etc., the central avenues along which the chief exhibits or amusements are placed. In the context of amusement parks, exhibitions, fairs, etc., the central avenues along which the chief exhibits or amusements are placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "midways"@en .

aat:300000517 a skos:Concept ;
    skos:definition "Temporary short-term habitation complexes, with permanent recreational facilities and often offering a structured program of activities. Temporary short-term habitation complexes, with permanent recreational facilities and often offering a structured program of activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camps"@en .

aat:300000521 a skos:Concept ;
    skos:definition "Camps providing care and activities for children during daylight hours, usually including outdoor activities during warm seasons, but not including overnight housing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day camps"@en .

aat:300000522 a skos:Concept ;
    skos:definition "Permanent or temporary camps where inhabitants engage in indoor and outdoor recreational activites without the restriction of clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nudist camps"@en .

aat:300000523 a skos:Concept ;
    skos:definition "Seating, tents, buildings, or other facilities intended to accommodate religious camp meetings, particularly the type of outdoor revival meetings that were held on the American frontier during the 19th century by various Protestant denominations. Seating, tents, buildings, or other facilities intended to accommodate religious camp meetings, particularly the type of outdoor revival meetings that were held on the American frontier during the 19th century by various Protestant denominations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious camps"@en .

aat:300000524 a skos:Concept ;
    skos:definition "Camps run by a particular religious group and focusing on activities that promote the beliefs of the religion; church camps often cater to children, but may also include adults. The term is often distinguished from \"religious camps,\" which often refers specifically to 19th-century camps for revival meetings on the American frontier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church camps"@en .

aat:300000525 a skos:Concept ;
    skos:definition "Camps run by a particular school, and typically promoting or supplementing the educational program of the school; typical school camps are outdoors and designed for children. Camps run by a particular school, and typically promoting or supplementing the educational program of the school; typical school camps are outdoors and designed for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school camps"@en .

aat:300000532 a skos:Concept ;
    skos:definition "Camps providing recreational and sporting facilities during the summer holiday period, usually intended for children and often including overnight accommodations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer camps"@en .

aat:300000534 a skos:Concept ;
    skos:definition "Distinguished from \"mobile home parks\" by being only for the temporary parking of travel trailers, camping trailers, motor homes, or the like, for recreational purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trailer camps"@en .

aat:300000541 a skos:Concept ;
    skos:definition "Facilities for the congregation of the team and other members of a polo club, which is an association involved with the equestrian team sport of polo. Facilities for the congregation of the team and other members of a polo club, which is an association involved with the equestrian team sport of polo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polo clubs"@en .

aat:300000542 a skos:Concept ;
    skos:definition "Clubhouses whose primary recreational focus is a bathing beach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach clubs"@en .

aat:300000544 a skos:Concept ;
    skos:definition "Seaside, lakeshore, or riverside facilities for the congregation of members of a yacht club, which is a group of people involved with the sport of sailing and yachting. Yacht clubs typically include a marina, a delimited section of the beach, safe offshore anchorages, and buildings for the meeting and refreshment of the members. Seaside, lakeshore, or riverside facilities for the congregation of members of a yacht club, which is a group of people involved with the sport of sailing and yachting. Yacht clubs typically include a marina, a delimited section of the beach, safe offshore anchorages, and buildings for the meeting and refreshment of the members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yacht clubs"@en .

aat:300000545 a skos:Concept ;
    skos:definition "Clubs, including the premises and grounds, that are located in or near the countryside rather than in an urban environment, and that are typically characterized by having a restricted membership and facilities for recreation and social intercourse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "country clubs"@en .

aat:300000547 a skos:Concept ;
    skos:definition "Buildings and other facilities located in a scenic, sporting, or other desirable area, and providing lodgings, entertainment, and other amenities for vacationers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resorts"@en .

aat:300000550 a skos:Concept ;
    skos:definition "Resorts located on the seaside or beach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seaside resorts"@en .

aat:300000553 a skos:Concept ;
    skos:definition "Resorts specializing in maintaining or improving the health or rejuvination of its clients, often including dietary and exercise instruction, bathing in mineral waters, breathing of fresh air, and formerly, extended exposure to sunshine (which was formerly considered healthy). Resorts specializing in maintaining or improving the health or rejuvination of its clients, often including dietary and exercise instruction, bathing in mineral waters, breathing of fresh air, and formerly, extended exposure to sunshine (which was formerly considered healthy)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health resorts"@en .

aat:300000557 a skos:Concept ;
    skos:definition "Areas of land or water set apart for the protection of natural landscapes or wildlife, or for the rearing of game or fish; in some preserves, limited hunting is permitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preserves"@en .

aat:300000558 a skos:Concept ;
    skos:definition "Resorts that operate seasonally during the summer months."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer resorts"@en .

aat:300000559 a skos:Concept ;
    skos:definition "Facilities usually located on a mountain or large hill and designed for winter sports, typically skiing, snow boarding, and other such activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter resorts"@en .

aat:300000560 a skos:Concept ;
    skos:definition "Building complexes and associated grounds that are designed for playing sports and the accommodation of large crowds of viewers, including seating or other viewing areas, dining facilities, tracks, pools, or various other playing areas. For inhabited places having sports as a focus, use \"sporting centers (inhabited places).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports complexes"@en .

aat:300000567 a skos:Concept ;
    skos:definition "Athletic fields designed or used for playing baseball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baseball fields"@en .

aat:300000571 a skos:Concept ;
    skos:definition "Refers to the entire playing area upon which softball is played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "softball fields"@en .

aat:300000575 a skos:Concept ;
    skos:definition "Areas used for the game of football (American or gridiron football), in professional play having standard official dimensions of 360 x 160 feet (109.7 x 48.8 m), with a goal line near each end of the field, 100 yards (91.4 m) apart. Areas used for the game of football (American or gridiron football), in professional play having standard official dimensions of 360 x 160 feet (109.7 x 48.8 m), with a goal line near each end of the field, 100 yards (91.4 m) apart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "football fields"@en .

aat:300000577 a skos:Concept ;
    skos:definition "Refers to the entire playing areas upon which field hockey is played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hockey fields"@en .

aat:300000578 a skos:Concept ;
    skos:definition "Refers to the entire playing areas upon which lacrosse is played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacrosse fields"@en .

aat:300000579 a skos:Concept ;
    skos:definition "Outdoor or indoor areas of turf for play of the equestrian sport of polo. The outdoor polo field has dimensions of 300 x 160 yards, with goals located at each end between two vertical goal posts that are 24 feet apart and light enough to break in case of collision. Outdoor or indoor areas of turf for play of the equestrian sport of polo. The outdoor polo field has dimensions of 300 x 160 yards, with goals located at each end between two vertical goal posts that are 24 feet apart and light enough to break in case of collision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polo fields"@en .

aat:300000580 a skos:Concept ;
    skos:definition "Refers to the entire playing areas upon which rugby is played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rugby fields"@en .

aat:300000586 a skos:Concept ;
    skos:definition "Outdoor area where the sport of golf is played, consisting of a teeing ground, fairway, rough, hazards, and a series of greens containing the 18 holes into which the ball is hit sequentially."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf courses"@en .

aat:300000590 a skos:Concept ;
    skos:definition "Courses designed for the sport of miniature golf, typically consisting of a series of putting greens set with colorful and whimsical hazards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature golf courses"@en .

aat:300000591 a skos:Concept ;
    skos:definition "Areas containing an assortment of obstacles to be negotiated, used for sporting events, military training, or animal competitions. Obstacle courses typically include a series of challenging physical obstacles that an individual, team, or animal (often a horse or dog) must navigate while being timed. Obstacles may include water ditches, open ditches, walls, fences, hurdles, and other hazards encountered while the participant is running, jumping, crawling, climbing, or balancing, with the goal of winning a contest, testing endurance or tactical skills, physical training, team building, or problem solving. Runners of the standard obstacle course as a sporting event must negotiate seven water jumps and 28 hurdle jumps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obstacle courses"@en .

aat:300000592 a skos:Concept ;
    skos:definition "Self-contained districts within or near a city that is hosting the Olympics sporting events, providing accommodation and amenities for competitors and other people who have an official connection with the Olympic games. Self-contained districts within or near a city that is hosting the Olympics sporting events, providing accommodation and amenities for competitors and other people who have an official connection with the Olympic games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Olympic villages"@en .

aat:300000593 a skos:Concept ;
    skos:definition "Typically oval courses or tracks on which races of any kind are held, including foot races, bicycle races, horse or dog races, and automobile races. Typically oval courses or tracks on which races of any kind are held, including foot races, bicycle races, horse or dog races, and automobile races."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racetracks"@en .

aat:300000597 a skos:Concept ;
    skos:definition "Tracks, usually oval in shape, designed or used primarily for the racing of automobiles; surfaces may be made of dirt, asphalt, brick, or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automobile racetracks"@en .

aat:300000599 a skos:Concept ;
    skos:definition "Tracks or strips of road, dry lake beds, or another flat surface used for drag racing, which is an automobile race over a flat, straight course, most commonly 1/4 mile in length. Drag racing as an organized sport began in the 1930s on dry lake beds in southern California. Tracks or strips of road, dry lake beds, or another flat surface used for drag racing, which is an automobile race over a flat, straight course, most commonly 1/4 mile in length. Drag racing as an organized sport began in the 1930s on dry lake beds in southern California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drag strips"@en .

aat:300000600 a skos:Concept ;
    skos:definition "Arenas designed or used for bicycle racing; modern velodromes comprise a steeply banked oval track having two 180-degree circular bends connected by two straight passages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velodromes"@en .

aat:300000604 a skos:Concept ;
    skos:definition "Tracks designed or primarily used for the racing of greyhounds or other dogs. Tracks designed or primarily used for the racing of greyhounds or other dogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog tracks"@en .

aat:300000608 a skos:Concept ;
    skos:definition "Racetracks designed or used for horse racing. For ancient Greek or Roman oblong structures designed for horse and chariot racing, use \"hippodromes (Greek sports buildings)\" or \"circuses (Roman arenas)\" respectively. Racetracks designed or used for horse racing. For ancient Greek or Roman oblong structures designed for horse and chariot racing, use \"hippodromes (Greek sports buildings)\" or \"circuses (Roman arenas)\" respectively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse racetracks"@en .

aat:300000612 a skos:Concept ;
    skos:definition "Areas designed or used primarily for the sport of skateboarding, including straight tracks as well as a variety of slopes and banked surfaces for sudden turns and stunts. Areas designed or used primarily for the sport of skateboarding, including straight tracks as well as a variety of slopes and banked surfaces for sudden turns and stunts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skateboarding parks"@en .

aat:300000617 a skos:Concept ;
    skos:definition "Areas equipped with targets for practice in shooting weapons; when possible use a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranges"@en .

aat:300000618 a skos:Concept ;
    skos:definition "Areas designed or used primarily the sport of archery, which consists of shooting with bow and arrow at targets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archery ranges"@en .

aat:300000619 a skos:Concept ;
    skos:definition "Areas or facilities designed or used primarily for shooting guns at targets, whether for sport or as training. Typically the area includes various ranges or distances marked off between the respective firing points and the targets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shooting ranges"@en .

aat:300000620 a skos:Concept ;
    skos:definition "Areas designed or used primarily for the shooting of rifles at targets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rifle ranges"@en .

aat:300000621 a skos:Concept ;
    skos:definition "Semicircular range designed or used primarily for the shooting of skeets, a sport involving clay-pigeon targets projected at a variety of shooting angles. Semicircular range designed or used primarily for the shooting of skeets, a sport involving clay-pigeon targets projected at a variety of shooting angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeet ranges"@en .

aat:300000623 a skos:Concept ;
    skos:definition "Refers to structures located along ski lifts and designed for loading and unloading skiers, which usually include ski-lift controls and shelter for operators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski-lift stations"@en .

aat:300000625 a skos:Concept ;
    skos:definition "Trails or slopes prepared for skiing, particularly trails through the landscape or trees, as distinguished from ski runs that are always downhill, and usually marked, patrolled, and graded according to difficulty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski trails"@en .

aat:300000626 a skos:Concept ;
    skos:definition "Various types of paths or tracks worn by the passage of persons or animals travelling in a wilderness area, or deliberately maintained for passage through various outdoor environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trails"@en .

aat:300000627 a skos:Concept ;
    skos:definition "Organized and labeled trails laid out to follow points of interest concerning the local history of a region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heritage trails"@en .

aat:300000630 a skos:Concept ;
    skos:definition "Footpaths through nature reserves or other area of countryside for the observation of plants, animals, and natural phenomena, frequently marked by posted signs and discussed in associated descriptive literature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nature trails"@en .

aat:300000632 a skos:Concept ;
    skos:definition "Facilities for groups of people living together or near each other, and subscribing to the tenets of a particular religion, including those who have taken vows and belong to the structure of a particular order, as well as more loosely organized groups of people. For the religious officials or functionaries of a religion, use \"clergy.\" For the formal, organized groups themselves, use \"religious orders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious communities"@en .

aat:300000634 a skos:Concept ;
    skos:definition "Communal facilities established for the sisterhood of Béguines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "béguinages"@en .

aat:300000635 a skos:Concept ;
    skos:definition "In common usage, the word \"convent\" is used for the facilities of a company of women living together in the discipline of a religious order and under one superior. For facilities for a company of males, use \"monasteries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convents"@en .

aat:300000638 a skos:Concept ;
    skos:definition "Early Christian meeting houses and community centers, derived from utilitarian domestic structures, serving the religious, administrative, and charitable needs of the congregation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domus ecclesiae"@en .

aat:300000640 a skos:Concept ;
    skos:definition "Dwelling places of solitary hermits or of groups of religious in a relatively secluded setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hermitages"@en .

aat:300000641 a skos:Concept ;
    skos:definition "Built complexes for religious retirement or seclusion from the world for monks, who are people living a celibate life according to the rule of a particular religious order and adhering to vows, especially of poverty, chastity, and obedience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monasteries"@en .

aat:300000642 a skos:Concept ;
    skos:definition "Designates independent and canonically erected monasteries, ruled by an abbot if occupied by monks and by an abbess if occupied by nuns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbeys"@en .

aat:300000643 a skos:Concept ;
    skos:definition "Religious houses for communities of both men and women, dwelling in contiguous establishments, united under the rule of one superior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double monasteries"@en .

aat:300000644 a skos:Concept ;
    skos:definition "Buildings and other facilities for friars, a community of men who focus on the sacred ministry of preaching, moving from place to place (in contrast to monks)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friaries"@en .

aat:300000645 a skos:Concept ;
    skos:definition "Religious houses that rank immediately below abbeys and are presided over by a prior or prioress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "priories"@en .

aat:300000650 a skos:Concept ;
    skos:definition "Carthusian monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charterhouses"@en .

aat:300000660 a skos:Concept ;
    skos:definition "Monastic complexes of the eastern Mediterranean in which hermit monks live in a loosely organized group of cells around a common central complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavras"@en .

aat:300000661 a skos:Concept ;
    skos:definition "Monasteries or convents in pre-Islamic India; usually Brahmanical, sometimes Jaina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathas"@en .

aat:300000663 a skos:Concept ;
    skos:definition "Communities of Buddhist monks; may also be used for Jain religious communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanghas"@en .

aat:300000665 a skos:Concept ;
    skos:definition "Use only for dervish monasteries; for rest houses for Islamic pilgrims, use \"hospices.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tekkes"@en .

aat:300000666 a skos:Concept ;
    skos:definition "Primarily refers to Indian Buddhist monasteries; may also be used for Sinhalese Buddhist temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viharas"@en .

aat:300000667 a skos:Concept ;
    skos:definition "Siamese Buddhist temples; may also be used for Siamese Buddhist monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wats"@en .

aat:300000672 a skos:Concept ;
    skos:definition "Complexes where testing of weapons or vehicles is conducted under close-hand scrutiny; for locations where weapons are exploded at a distance from observers, use \"test sites.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proving grounds"@en .

aat:300000676 a skos:Concept ;
    skos:definition "Designates areas where a large number of high-capacity storage tanks are located, usually used for crude oil or other petroleum products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tank farms"@en .

aat:300000677 a skos:Concept ;
    skos:definition "Buildings or complexes providing transportation facilities or otherwise serving transportation needs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation complexes"@en .

aat:300000678 a skos:Concept ;
    skos:definition "Complexes containing facilities to accommodate people, functions, and vehicles having to do with air transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air transportation complexes"@en .

aat:300000679 a skos:Concept ;
    skos:definition "Areas prepared for the landing and takeoff of aircraft; may or may not be provided with associated buildings, equipment, or other installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airfields"@en .

aat:300000681 a skos:Concept ;
    skos:definition "Typically refers to large tracts of open, level land upon which runways, hangars, terminals, and other buildings have been constructed to allow for the takeoffs, landings, loading and unloading, and maintenance of aircraft. For smaller areas that have a runway but no or few additional facilities, see \"airfields.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airports"@en .

aat:300000686 a skos:Concept ;
    skos:definition "Landing places for helicopters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliports"@en .

aat:300000688 a skos:Concept ;
    skos:definition "Facilities at which rocket, missile, or spacecraft launches are conducted, usually having launch pads, equipment, and various buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "launch complexes"@en .

aat:300000690 a skos:Concept ;
    skos:definition "Areas consisting of a network of railway tracks, sidings, and sheds for storing, maintaining, and joining engines and railcars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad yards"@en .

aat:300000691 a skos:Concept ;
    skos:definition "Railroad yards in which trains are assembled from individual cars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marshalling yards"@en .

aat:300000700 a skos:Concept ;
    skos:definition "The higher sections of ancient cities, usually comprising fortifications and public buildings. Primary examples are in Greece, where the acropolis typically contains temples and some public buildings; used as places of refuge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acropolises"@en .

aat:300000705 a skos:Concept ;
    skos:definition "Territorial divisions as for administrative or electoral purposes, or settlement areas with distinguishing characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "districts"@en .

aat:300000707 a skos:Concept ;
    skos:definition "Districts defined by administrative boundaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administrative districts"@en .

aat:300000709 a skos:Concept ;
    skos:definition "Districts created for the administration of elections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "election districts"@en .

aat:300000710 a skos:Concept ;
    skos:definition "Electoral constituencies that elect one member of a congress. In the United States, territorial divisions of a state from which a member of the United States House of Representatives is elected. Other nations having congressional districts are the Philippines and Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "congressional districts"@en .

aat:300000712 a skos:Concept ;
    skos:definition "Urban or regional administrative areas, within the boundaries of which administrators have responsibility for the maintenance and development of all parks and recreation areas. Urban or regional administrative areas, within the boundaries of which administrators have responsibility for the maintenance and development of all parks and recreation areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "park districts"@en .

aat:300000713 a skos:Concept ;
    skos:definition "Areas defined for the purposes of designing or controlling of urban or economic development. Areas defined for the purposes of designing or controlling of urban or economic development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planning districts"@en .

aat:300000717 a skos:Concept ;
    skos:definition "Administrative areas having their own board and power of taxation and serving as the smallest units for administration of a public school system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school districts"@en .

aat:300000721 a skos:Concept ;
    skos:definition "Areas, the boundaries of which are defined for property values and tax assessment purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assessment districts"@en .

aat:300000723 a skos:Concept ;
    skos:definition "Administrative areas, within the boundaries of which an agency, usually governmental, supplies water for drinking, bathing, and other household and commercial uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water districts"@en .

aat:300000724 a skos:Concept ;
    skos:definition "Districts defined by land use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land use districts"@en .

aat:300000725 a skos:Concept ;
    skos:definition "Central areas or other commercial areas of a town or city, typically areas that are zoned to allow the operation of businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business districts"@en .

aat:300000732 a skos:Concept ;
    skos:definition "Areas of a town or city designed for, zoned for, or used primarily by stores and other establishments selling goods. Characteristics may include sections that are open only to pedestrian traffic, adequate parking facilities for automobiles, and other features that attract shoppers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shopping districts"@en .

aat:300000737 a skos:Concept ;
    skos:definition "Former administrative or electoral districts that have been designated by a modern governing body as being culturally or historically significant, or embodying distinctive characteristics of a period, method of construction, or inhabitants. For historic areas of a city or town, use \"historic quarters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic districts"@en .

aat:300000739 a skos:Concept ;
    skos:definition "Refers to areas set aside for or occupied primarily by buildings that house industrial activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial districts"@en .

aat:300000742 a skos:Concept ;
    skos:definition "Areas of a town or city zoned for or used primarily for single- or multiple-family dwellings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "residential districts"@en .

aat:300000750 a skos:Concept ;
    skos:definition "Districts of cities in which members of a minority racial or cultural group live, especially because of social, legal, and economic pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghettos"@en .

aat:300000751 a skos:Concept ;
    skos:definition "Islamic cities; may also be used for certain districts in North African cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medinas"@en .

aat:300000752 a skos:Concept ;
    skos:definition "Areas within cities frequented by homeless persons and vagrants and generally characterized by a high proportion of rescue missions, saloons, and unusually inexpensive lodging houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skid rows"@en .

aat:300000753 a skos:Concept ;
    skos:definition "Densely populated usually urban areas characerized by crowding, dirty run-down housing, poverty, and social disorganization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slums"@en .

aat:300000754 a skos:Concept ;
    skos:definition "May be used generally for ancient Roman urban residential neighborhoods and for Roman or Medieval merchants' quarters or small villages, usually located outside the walls of nearby military settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vici"@en .

aat:300000759 a skos:Concept ;
    skos:definition "Divisions of French departments and some French cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrondissements"@en .

aat:300000762 a skos:Concept ;
    skos:definition "Regions, districts, localities, or other divisions of a town or city. Whereas the term technically refers to areas resulting from division of a larger area into four parts, quarters are instead typically defined by habitation by a certain group or community, or by having a particular character or use, regardless of the total number of such parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarters"@en .

aat:300000765 a skos:Concept ;
    skos:definition "Areas designated, usually by a governmental agency, as appropriate for industrial and economic development, often to improve stagnant economies and bring employment opportunities into the region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "development areas"@en .

aat:300000766 a skos:Concept ;
    skos:definition "Urban areas in which brothels are located, whether operating legally or illegally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red-light districts"@en .

aat:300000768 a skos:Concept ;
    skos:definition "General term for offices, departments, or other branches or representatives that have authority to oversee, direct, manage, and administer on behalf of an institution or other group. Use \"governing bodies\" specifically for organizations who exercise executive power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administrative bodies"@en .

aat:300000769 a skos:Concept ;
    skos:definition "Constituent political and administrative divisions within some European nations under a federal system, such as Switzerland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantons"@en .

aat:300000771 a skos:Concept ;
    skos:definition "The domains or territories of counts. In current usage, usually refers to particular divisions that have been made to an area for administrative, judicial, and political purposes. In Britain, counties are defined by various official methods, and serve as the most important divisional units in the country. In the United States, counties are the political and administrative divisions below the state and above the city; a few U.S. states call such divisions \"districts\" or \"parishes\" rather than \"counties.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counties"@en .

aat:300000772 a skos:Concept ;
    skos:definition "Particular areas into which a city or larger administrative entity are divided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "departments"@en .

aat:300000773 a skos:Concept ;
    skos:definition "Divisions of a larger ecclesiastical administrative area committed to the care and authority of one pastor. Also refers to divisions of local government, such as in England and the state of Louisiana, based on or derived from original ecclesiastical divisions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parishes"@en .

aat:300000774 a skos:Concept ;
    skos:definition "The constituent political and administrative divisions within various sovereign states, including historic ones such as the Roman Empire and modern nations under a federal system such as Canada and Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provinces"@en .

aat:300000775 a skos:Concept ;
    skos:definition "Refers to particular administrative units, defined differently in different jurisdictions, for example a province or district under the rule of a governor, archbishop, sheriff, or steward. Refers to particular administrative units, defined differently in different jurisdictions, for example a province or district under the rule of a governor, archbishop, sheriff, or steward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shires"@en .

aat:300000776 a skos:Concept ;
    skos:definition "The constituent political and administrative units of various nations under a federal system of government, such as Australia and the United States of America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "states"@en .

aat:300000778 a skos:Concept ;
    skos:definition "Incorporated, primarily urban divisions whose population and, usually, territorial area are smaller than those of cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boroughs"@en .

aat:300000786 a skos:Concept ;
    skos:definition "Districts within a city, town, or other community marked out for specific governmental or administrative purposes, such as for electoral, school, or police services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precincts"@en .

aat:300000790 a skos:Concept ;
    skos:definition "Refers to the complete domain of a lord, especially a feudal lord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seigneuries"@en .

aat:300000792 a skos:Concept ;
    skos:definition "Any of various international territorial divisions, typically a section of a county forming a unit of local government. In the United States, surveyed tracts of public land measuring 6 miles square and divided into 36 sections of 1 square mile each."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "townships"@en .

aat:300000794 a skos:Concept ;
    skos:definition "Expanses or extended areas of land, outdoor space, or territory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracts"@en .

aat:300000796 a skos:Concept ;
    skos:definition "Districts having boundaries defined by religious groups or religions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious districts"@en .

aat:300000797 a skos:Concept ;
    skos:definition "Administrative divisions of a church, under the authority of an archbishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archdioceses"@en .

aat:300000799 a skos:Concept ;
    skos:definition "Administrative divisions of church government under the authority of a bishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dioceses"@en .

aat:300000802 a skos:Concept ;
    skos:definition "Precincts, usually walled, around cathedrals and their dependent buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closes"@en .

aat:300000805 a skos:Concept ;
    skos:definition "Ancient sacred areas, usually enclosed and containing the principal shrine and other associated subsidiary buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temene"@en .

aat:300000809 a skos:Concept ;
    skos:definition "Pieces of land or other physical positions on which something is located, particularly where human habitation or activities have taken place. Examples include sites that have archaeological or other historical context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sites"@en .

aat:300000810 a skos:Concept ;
    skos:definition "Locations where human activities once took place and some form of material evidence has been left behind, particularly sites where evidence of past activity is being or has been investigated using the discipline of archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological sites"@en .

aat:300000811 a skos:Concept ;
    skos:definition "Places where one or more buildings are located, formerly were located, are under construction, or will be constructed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building sites"@en .

aat:300000815 a skos:Concept ;
    skos:definition "Lots or portions of land sufficient for and intended to be used or currently being used as the site of a house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homesites"@en .

aat:300000816 a skos:Concept ;
    skos:definition "Building sites upon which one or more industries are planned or located. For a grouping of industrial buildings, use \"industrial complexes\" or \"industrial parks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial sites"@en .

aat:300000819 a skos:Concept ;
    skos:definition "Individual locations, within organized campgrounds or as isolated sites, set aside or otherwise marked for camping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camp sites"@en .

aat:300000820 a skos:Concept ;
    skos:definition "Cleared and bounded areas, devoid of artifacts, and of unknown function found associated with hunter-gatherer camps, especially those of the North American Great Basin. Cleared and bounded areas, devoid of artifacts, and of unknown function found associated with hunter-gatherer camps, especially those of the North American Great Basin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance grounds"@en .

aat:300000824 a skos:Concept ;
    skos:definition "Places where refuse, discarded excess materials, or temporarily useless products of human activities are deposited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumps"@en .

aat:300000828 a skos:Concept ;
    skos:definition "Junkyards for automobiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automobile graveyards"@en .

aat:300000830 a skos:Concept ;
    skos:definition "Dumps where refuse is collected, usually low-lying ground, and often as a means to reclaim the land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landfills"@en .

aat:300000831 a skos:Concept ;
    skos:definition "Refuse dumps over which layers of earth or ashes are heaped regularly to control pests and odors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanitary landfills"@en .

aat:300000832 a skos:Concept ;
    skos:definition "Piles of fused refuse or dross separated from metal in the process of smelting; also refers to piles of unwanted tailings or refuse that are the by-products of mining ore, coal, or other substances. Piles of fused refuse or dross separated from metal in the process of smelting; also refers to piles of unwanted tailings or refuse that are the by-products of mining ore, coal, or other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slag heaps"@en .

aat:300000833 a skos:Concept ;
    skos:definition "Parcels of land with historic significance due to historic events, architectural, engineering or archaeological activities, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic sites"@en .

aat:300000835 a skos:Concept ;
    skos:definition "Locations where a hostile meetings of opposing military forces in the course of a war have taken place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battlefields"@en .

aat:300000837 a skos:Concept ;
    skos:definition "Parcels of land with fixed boundaries occupied or capable of being occupied by one building or use, including accessory buildings, and not divided by any public highway or alley. Distinguished from \"plats (land),\" because plats tend to be somewhat larger than lots and are often in the countryside, while lots are typically smaller and located within a settlement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lots"@en .

aat:300000843 a skos:Concept ;
    skos:definition "Refers to districts or other divisions into which a larger area is divided for the purpose of conducting a census."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "census tracts"@en .

aat:300000853 a skos:Concept ;
    skos:definition "Areas set off by a governing body for specific use, such as residential, commercial, or industrial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zones"@en .

aat:300000854 a skos:Concept ;
    skos:definition "Strips established to separate and protect one type of land use from another (e.g., industry versus housing)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffer zones"@en .

aat:300000857 a skos:Concept ;
    skos:definition "Designates areas undergoing an orderly conversion from one predominant use to another, as from residential to higher-density residential plus commercial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transition zones"@en .

aat:300000861 a skos:Concept ;
    skos:definition "Largest core areas within the incorporated limits of metropolitan areas; often used to distinguish the center from the suburban or newer outlying sections of metropolitan areas; generally excludes the central business district and inner city sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "central cities"@en .

aat:300000868 a skos:Concept ;
    skos:definition "The high-density cores of cities or towns, where activities are principally retail, commercial, service, and often governmental."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "central business districts"@en .

aat:300000873 a skos:Concept ;
    skos:definition "Refers to the usually older and more densely populated central sections of cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inner cities"@en .

aat:300000874 a skos:Concept ;
    skos:definition "Compactly developed or developing, usually residential, areas on the outskirts of a central city; distinguished from central cities by their more homogeneous socio-economic and physical character, although rarely is there an identifiable boundary between suburbs and central cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suburbs"@en .

aat:300000879 a skos:Concept ;
    skos:definition "Suburbs designed to incorporate large tracts of green spaces and to control internal growth and development with an emphasis on residential communities. Distinguished from \"garden cities\" by their smaller size and location outside urban centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden suburbs"@en .

aat:300000880 a skos:Concept ;
    skos:definition "Small, usually prosperous, communities situated beyond the suburbs of a city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exurbs"@en .

aat:300000885 a skos:Concept ;
    skos:definition "Forms, structural or decorative, developed originally or primarily as components of architecture, often adapted to other habitable spaces, such as in large vehicles, and often borrowed or imitated for structural or decorative use on other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural elements"@en .

aat:300000888 a skos:Concept ;
    skos:definition "Masses, usually of masonry, that support and receive the thrust of arches, vaults, or trusses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abutments"@en .

aat:300000891 a skos:Concept ;
    skos:definition "Pierlike masonry elements built to strengthen or support walls or resist the lateral thrust of vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttresses"@en .

aat:300000900 a skos:Concept ;
    skos:definition "Strengthening or supporting elements (buttresses) located at the juncture of two walls. Also used for similar elements found on furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner buttresses"@en .

aat:300000901 a skos:Concept ;
    skos:definition "Paired buttresses set at right angles, forming the corner of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle buttresses"@en .

aat:300000902 a skos:Concept ;
    skos:definition "Buttresses which in plan are squares or rectangles penetrated by the corner of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clasping buttresses"@en .

aat:300000903 a skos:Concept ;
    skos:definition "Buttresses extending at about a 45-degree angle from the corner of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagonal buttresses"@en .

aat:300000905 a skos:Concept ;
    skos:definition "Exterior arched supports transmitting the thrust of a vault or roof from the upper part of a wall outward to a pier or buttress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying buttresses"@en .

aat:300000911 a skos:Concept ;
    skos:definition "Elements resembling buttresses, but supported by corbels rather than having separate foundations and therefore not serving as true structural buttresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging buttresses"@en .

aat:300000917 a skos:Concept ;
    skos:definition "Sloping tops of buttresses or projecting piers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amortizements"@en .

aat:300000919 a skos:Concept ;
    skos:definition "Parts of structures, usually located below ground level, that transmit building loads to the soil or rock underneath; when specifically distinguishing the support systems and areas of structures below ground, including the foundation, from the above-ground portions, use \"substructures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundations"@en .

aat:300000922 a skos:Concept ;
    skos:definition "Watertight boxes or cylinders serving to hold out water during excavation below the water table, often used for foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caissons"@en .

aat:300000923 a skos:Concept ;
    skos:definition "Substructures supported on piles, which are single or clustered timber, steel, or precast concrete columns serving as subsurface supports for vertical loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile foundations"@en .

aat:300000924 a skos:Concept ;
    skos:definition "Continuous foundations under the full extent of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raft foundations"@en .

aat:300000931 a skos:Concept ;
    skos:definition "Portions of the foundations of some structures which transmit loads directly to the soil; used to distribute the weight of the superstructure over a greater area to prevent or reduce settlings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footings"@en .

aat:300000937 a skos:Concept ;
    skos:definition "Frameworks of heavy timbers, steel, or reinforced concrete beams laid longitudinally and crossed by similar members laid on them to spread a heavy load over a larger area; includes similar structures used to distribute a concentrated load over the top of the footing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grillages"@en .

aat:300000938 a skos:Concept ;
    skos:definition "Timber, steel, or precast concrete columns serving as subsurface supports for vertical loads; distinct from \"piers (foundation components)\" which are larger and are never clustered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piles"@en .

aat:300000940 a skos:Concept ;
    skos:definition "Concrete piles that are poured at their permanent location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cast-in-place piles"@en .

aat:300000942 a skos:Concept ;
    skos:definition "Concrete piles that are driven together with their steel casing, which is later removed and replaced by a permanent casing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cased piles"@en .

aat:300000945 a skos:Concept ;
    skos:definition "Reinforced concrete piles manufactured in a casting plant or at the site prior to placement in their final positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precast piles"@en .

aat:300000948 a skos:Concept ;
    skos:definition "Piles driven into position at the site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driven piles"@en .

aat:300000950 a skos:Concept ;
    skos:definition "Piles (usually sections of pipe spliced together) which are forced into the ground to a bearing stratum, jacking it against a building or structure above, used primarily for underpinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacked piles"@en .

aat:300000951 a skos:Concept ;
    skos:definition "Vertical poles serving as anchorages, such as for suspension cables or to elevate antennae, on ships or other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masts"@en .

aat:300000953 a skos:Concept ;
    skos:definition "Refers to relatively isolated, solid supports of masonry or another material designed to sustain vertical pressure, including a square or rectangular pillar or pilaster, the solid masonry between doors and windows, the pillars from which an arch springs, or the pillars or posts of a gate or door. A pier may also be a solid structure of masonry or ironwork supporting a telescope or other large instrument. It is sometimes distinguished from columns or posts by being more massive in size and often square or rectangular in cross section. For cylindrical uprights and for all uprights in steel and concrete frames, the term \"columns (architectural elements)\" is more often appropriate; for wooden uprights square in cross-section, \"posts\" may be more appropriate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piers"@en .

aat:300000958 a skos:Concept ;
    skos:definition "Piers composed of several engaged columns or pilasters grouped around a central core. For supports formed by three or more closely spaced columns in a group, use \"grouped columns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compound piers"@en .

aat:300000965 a skos:Concept ;
    skos:definition "Ground-level columns or piers, either external or externally visible, which create a feeling of openness beneath an elevated building mass, as in the architecture of Le Corbusier and his followers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilotis"@en .

aat:300000967 a skos:Concept ;
    skos:definition "Piers serving both as buttresses and as regular supporting and dividing elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttress piers"@en .

aat:300000968 a skos:Concept ;
    skos:definition "Piers, such as would include several columns or pilasters, that are thickenings of or projections from a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall piers"@en .

aat:300000969 a skos:Concept ;
    skos:definition "Parts or components of piers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pier components"@en .

aat:300000970 a skos:Concept ;
    skos:definition "In Roman and later classicizing architecture, those parts of a pier that form arch abutments and flank a central engaged column or pilaster carrying an architrave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alettes"@en .

aat:300000976 a skos:Concept ;
    skos:definition "Continuous pedestals or bases of buildings; appropriate for such elements in Roman or Etruscan temples. For similar features found in Greek temples prefer \"stylobates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "podiums"@en .

aat:300000981 a skos:Concept ;
    skos:definition "Boned corsets, made in one or two pieces, with or without shoulder straps, that assume a conical form when fastened. Boned corsets, made in one or two pieces, with or without shoulder straps, that assume a conical form when fastened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stays"@en .

aat:300000982 a skos:Concept ;
    skos:definition "Substructures supporting the columns of Greek temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereobates"@en .

aat:300000983 a skos:Concept ;
    skos:definition "Stepped platforms of Classical temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crepidomas"@en .

aat:300000986 a skos:Concept ;
    skos:definition "Course of pavement on which columns rest in Greek temples. For similar features in other building types, including Roman or Etruscan temples, use \"podiums (building divisions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylobates"@en .

aat:300000992 a skos:Concept ;
    skos:definition "The general classes of load-distributing devices, based on structural principles, used in built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structures"@en .

aat:300000994 a skos:Concept ;
    skos:definition "Structural elements, typically curved, spanning openings and transmitting vertical loads to either side of the opening; also, structural elements or freestanding structures that resemble arches or act structurally like arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arches"@en .

aat:300000999 a skos:Concept ;
    skos:definition "Arches constructed on the principle of the catenary, the shape assumed by a cord suspended at its ends from two supports in equilibrium under given forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catenary arches"@en .

aat:300001001 a skos:Concept ;
    skos:definition "Arches which have cusps or foliations worked on the intrados."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cusped arches"@en .

aat:300001013 a skos:Concept ;
    skos:definition "Arches having the form of a semiellipse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elliptical arches"@en .

aat:300001015 a skos:Concept ;
    skos:definition "Arches in which neither intrados nor extrados has any curvature, yet is composed of voussoirs arranged so that lateral thrusts are generated from vertical loads; for arches with very slight curvature, use \"camber arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat arches"@en .

aat:300001018 a skos:Concept ;
    skos:definition "Arches whose intrados, and possibly the extrados, has a very slight rise; for arches with no curvature, use \"flat arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camber arches"@en .

aat:300001019 a skos:Concept ;
    skos:definition "Flat arches in which the joints of the voussoirs do not radiate but all slope outward from the center at the same angle on both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French arches"@en .

aat:300001022 a skos:Concept ;
    skos:definition "Round arches in which the voussoirs increase in length as they approach the center, so that the curve of the extrados is more vertical in proportion than the curve of the intrados. For similar arches when pointed, use \"Italian pointed arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Florentine arches"@en .

aat:300001023 a skos:Concept ;
    skos:definition "Arches turned upside down, so that the intrados is below the springing; used, for example, to distribute loads in foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inverted arches"@en .

aat:300001032 a skos:Concept ;
    skos:definition "Pointed arches composed of two reversed curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ogee arches"@en .

aat:300001040 a skos:Concept ;
    skos:definition "Four-centered pointed arches. Four-centered pointed arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tudor arches"@en .

aat:300001049 a skos:Concept ;
    skos:definition "Arches with jambs that are not at right angles to the faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skew arches"@en .

aat:300001051 a skos:Concept ;
    skos:definition "Arches struck from a single center, such as semicircular, segmental, or horseshoe arches. Arches struck from a single center, such as semicircular, segmental, or horseshoe arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-centered arches"@en .

aat:300001053 a skos:Concept ;
    skos:definition "Arches in which the curves are carried below the springing line so that the opening at the bottom of the arch is less than its greatest span."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horseshoe arches"@en .

aat:300001059 a skos:Concept ;
    skos:definition "Arches in the shape of a segment of a circle that is less than a semicircle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "segmental arches"@en .

aat:300001062 a skos:Concept ;
    skos:definition "Arches with intradoses that are full semicircles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semicircular arches"@en .

aat:300001072 a skos:Concept ;
    skos:definition "Arches composed of two intersecting arcs of a circle, struck so that the apex of the arch is a point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointed arches"@en .

aat:300001076 a skos:Concept ;
    skos:definition "Pointed arches with radii that are located within the span of the arch, whether or not the centers are above, at, or below the springing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop arches"@en .

aat:300001079 a skos:Concept ;
    skos:definition "Pointed arches in which a line from the springing point to the pointed center equals the span between the springing points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equilateral arches"@en .

aat:300001081 a skos:Concept ;
    skos:definition "Pointed arches whose curves are struck from centers farther apart than the span of the arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lancet arches"@en .

aat:300001086 a skos:Concept ;
    skos:definition "Arches in which the impost on one side is higher than the impost on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rampant arches"@en .

aat:300001089 a skos:Concept ;
    skos:definition "Arches having only one half of their sweep developed. Arches having only one half of their sweep developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semiarches"@en .

aat:300001090 a skos:Concept ;
    skos:definition "Arches sprung from a point above the imposts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilted arches"@en .

aat:300001091 a skos:Concept ;
    skos:definition "Semicircular stilted arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surmounted arches"@en .

aat:300001093 a skos:Concept ;
    skos:definition "Refers to the arch marking the separation of chancel from nave. Refers to the arch marking the separation of chancel from nave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chancel arches"@en .

aat:300001098 a skos:Concept ;
    skos:definition "Arches which separate the bays of vaults, particularly in a groin- or barrel-vaulted space; in a ribbed vault context, use \"transverse ribs\"; for arches across a nave or hall that support walls rather than vaults, use \"diaphragm arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transverse arches"@en .

aat:300001103 a skos:Concept ;
    skos:definition "Wood or metal arches hinged at the two springing points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-hinged arches"@en .

aat:300001104 a skos:Concept ;
    skos:definition "Wood or metal arches that are hinged at the two springing points and at the crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-hinged arches"@en .

aat:300001107 a skos:Concept ;
    skos:definition "Arches that carry the primary thickness of a wall over an opening, usually a door or window, when the rest of the wall is carried by other means, such as a lintel, an arch of different form or size, or a decorated frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back arches"@en .

aat:300001112 a skos:Concept ;
    skos:definition "Arches in which the opening is permanently closed by the wall construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind arches"@en .

aat:300001117 a skos:Concept ;
    skos:definition "Round arches supported by large corbels with curved lower edges, giving the opening a bell-shaped outline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell arches"@en .

aat:300001119 a skos:Concept ;
    skos:definition "Arches that counteract the thrust of another arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter arches"@en .

aat:300001120 a skos:Concept ;
    skos:definition "Arches with a clearly marked extrados more or less parallel to the intrados."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extradosed arches"@en .

aat:300001121 a skos:Concept ;
    skos:definition "Arches built of bricks that are slightly wedge-shaped, so that the joints of the arches radiate from a common center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauged arches"@en .

aat:300001124 a skos:Concept ;
    skos:definition "Arches carried on piers, particularly the arches which divide nave from aisles in basilican churches. Arches carried on piers, particularly the arches which divide nave from aisles in basilican churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pier arches"@en .

aat:300001125 a skos:Concept ;
    skos:definition "Arches which deflect the weight off of another arch, opening, or other structural member located beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relieving arches"@en .

aat:300001130 a skos:Concept ;
    skos:definition "Arches in which bricks or other small voussoirs are arranged in separate concentric rings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rowlock arches"@en .

aat:300001136 a skos:Concept ;
    skos:definition "Spanning members consisting of straight lintels carried on corbels projecting into the opening and usually cut into hollow curves under the projecting ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shouldered arches"@en .

aat:300001137 a skos:Concept ;
    skos:definition "Flat arches in brick, with the bricks set with their long sides vertical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soldier arches"@en .

aat:300001138 a skos:Concept ;
    skos:definition "Arches with intradoses having a greater radius at one face of the arch than at the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splayed arches"@en .

aat:300001140 a skos:Concept ;
    skos:definition "Arches whose extradoses are stepped to correspond with the courses of masonry units in the wall around the opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepped arches"@en .

aat:300001141 a skos:Concept ;
    skos:definition "Arches introduced to resist the deformation of piers under stress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straining arches"@en .

aat:300001148 a skos:Concept ;
    skos:definition "Parts or components of arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch components"@en .

aat:300001152 a skos:Concept ;
    skos:definition "Architraves modified by being carried around a curved opening instead of a rectangular one, specifically the continuous curved molded or decorated bands framing the face of an arch. Examples include bands stacked in a series framing a portal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archivolts"@en .

aat:300001154 a skos:Concept ;
    skos:definition "The highest points of arches or vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowns"@en .

aat:300001155 a skos:Concept ;
    skos:definition "The outer surfaces of vaults or arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extradoses"@en .

aat:300001158 a skos:Concept ;
    skos:definition "Projecting members, often molded, on which the ends of an arch rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imposts"@en .

aat:300001163 a skos:Concept ;
    skos:definition "Stones, usually with the shape of a truncated inverted pyramid, placed between capitals and the arches that spring from them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impost blocks"@en .

aat:300001166 a skos:Concept ;
    skos:definition "Inner curves or faces of arches or vaults forming the concave underside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intradoses"@en .

aat:300001176 a skos:Concept ;
    skos:definition "Minor arches beneath and enclosed by outer arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subarches"@en .

aat:300001177 a skos:Concept ;
    skos:definition "Masonry units, often wedge-shaped, that form an arch or vault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voussoirs"@en .

aat:300001183 a skos:Concept ;
    skos:definition "Central wedge-shaped voussoirs in arches or central stones in vaults; often decorated or enlarged. Faux keystones may be applied as ornaments on the heads of doors or windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keystones"@en .

aat:300001189 a skos:Concept ;
    skos:definition "Consoles which act as the keystone of an arch. Consoles which act as the keystones of an arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key consoles"@en .

aat:300001194 a skos:Concept ;
    skos:definition "Structures in which cables are essential to the system of support, as for example by suspension or staying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable structures"@en .

aat:300001198 a skos:Concept ;
    skos:definition "Cable structures that use vertical or sloping compression masts from which straight cables run to critical points or to horizontally spanning or cantilevered members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable-stayed structures"@en .

aat:300001200 a skos:Concept ;
    skos:definition "Designates structural systems in which the structural elements or the roofing elements are hung from cables or in which the roofing is supported by cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspension structures"@en .

aat:300001203 a skos:Concept ;
    skos:definition "Structures based on horizontal, rigid, planar elements, typically of monolithic materials, with depths small in relation to their other dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate structures"@en .

aat:300001205 a skos:Concept ;
    skos:definition "Structural systems based on one-way plates given additional stiffness by folding into a series of long, narrow planes, the typical sections resembling a series of interconnected Ws or splay-sided Us."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folded plate structures"@en .

aat:300001208 a skos:Concept ;
    skos:definition "Flat, thick plates, usually of concrete, functioning as structural elements and capable of sustaining loads, often serving as floors and roofs; also, use collectively, for the structural systems based on such elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slabs"@en .

aat:300001210 a skos:Concept ;
    skos:definition "Structural systems based on concrete slabs in which loads are transferred in one direction only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-way structural systems"@en .

aat:300001214 a skos:Concept ;
    skos:definition "One-way structural systems in which reinforced concrete slabs are supported on beams or girders that run in one direction only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-way beam and slab systems"@en .

aat:300001223 a skos:Concept ;
    skos:definition "Structural systems based on concrete slabs in which loads are transferred in two directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-way structural systems"@en .

aat:300001227 a skos:Concept ;
    skos:definition "Structural systems based on two-way concrete slabs with drop panels and often with capitals but without beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat slab systems"@en .

aat:300001233 a skos:Concept ;
    skos:definition "Structural systems based on two-way concrete slabs employing no beams, drop panels, or column capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat plate systems"@en .

aat:300001235 a skos:Concept ;
    skos:definition "Two-way, flat concrete slabs supported by beams spanning between columns in both directions; the slab and beams are poured to be monolithic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-way beam and slab systems"@en .

aat:300001249 a skos:Concept ;
    skos:definition "Trusses in which the members are arranged three-dimensionally rather than in only one plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space frames"@en .

aat:300001262 a skos:Concept ;
    skos:definition "Structures of thin, flexible surfaces that carry loads primarily through the development of tension stresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membrane structures"@en .

aat:300001264 a skos:Concept ;
    skos:definition "Membrane structures that attain stability by internal pressurization, usually by air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pneumatic structures"@en .

aat:300001266 a skos:Concept ;
    skos:definition "Pneumatic structures in which closed membranes, used as building elements, are inflated; for pneumatic structures supported by pressurization of the habitable space, use \"air-supported structures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-inflated structures"@en .

aat:300001270 a skos:Concept ;
    skos:definition "Pneumatic structures supported by pressurization of the habitable space; for pneumatic structures in which closed membranes, used as building elements, are inflated, use \"air-inflated structures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-supported structures"@en .

aat:300001274 a skos:Concept ;
    skos:definition "Membrane structures in which fabric is stretched across or supported on masts or poles, with or without the aid of guys. Membrane structures in which fabric is stretched across or supported on masts or poles, with or without the aid of guys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tent structures"@en .

aat:300001276 a skos:Concept ;
    skos:definition "Curved enclosing structures, almost always of concrete and very thin in relation to their span, and depending for structural stability on actions that may be computed by the membrane theory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell structures"@en .

aat:300001280 a skos:Concept ;
    skos:definition "Rounded vaults comprising spheres or portions of spheres sitting on circular, elliptical, or polygonal bases, forming the roof of any building or part of a building. They are constructed so that they exert equal thrust in all directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domes"@en .

aat:300001283 a skos:Concept ;
    skos:definition "Domes in the form of a cone with curved sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beehive domes"@en .

aat:300001285 a skos:Concept ;
    skos:definition "Pointed bulbous domes characterized by a distinctive tapering bulb or onion shape that has a diameter greater than the drum upon which it is placed, and typically having a height that exceeds its width. Onion domes first saw widespread use in Islamic architecture in about the 8th century, when they often topped minarets or were placed over the central space or on the corners of mosques and domestic buildings in the Middle East and India. They were then used in Russia, Spain, Austria, Bavaria, and Eastern Europe by the 18th century; use spread to other Western styles and locations in the 19th century. For small domes, often resembling overturned cups or pointed, and placed over a turret, use \"cupolas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onion domes"@en .

aat:300001287 a skos:Concept ;
    skos:definition "Denotes hemispherical, caplike domes; the term applies to small semidomes lacking a drum or lantern, small shallow domes used in the ceilings of rooms to increase headroom, small domes not pierced by oculi, and domelike plaster surfaces suspended within double-shell domes and often decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calottes"@en .

aat:300001288 a skos:Concept ;
    skos:definition "Structures consisting of numerous similar, light, straight-line elements (usually in tension) which form a grid in the shape of a dome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geodesic domes"@en .

aat:300001291 a skos:Concept ;
    skos:definition "Domes with a rise less than the radius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saucer domes"@en .

aat:300001293 a skos:Concept ;
    skos:definition "Domes consisting of an irregular triangular mesh of hinged bars, as introduced by Schwedler in Berlin in 1863. Domes consisting of an irregular triangular mesh of hinged bars, as introduced by Schwedler in Berlin in 1863."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schwedler domes"@en .

aat:300001296 a skos:Concept ;
    skos:definition "Domes with inner surfaces continuous with the surfaces of their pendentives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendentive domes"@en .

aat:300001297 a skos:Concept ;
    skos:definition "Domes consisting of one quarter of a sphere, such as would surmount an arched niche."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semidomes"@en .

aat:300001300 a skos:Concept ;
    skos:definition "Melonlike ribbed domes (either exterior or interior), found especially in Islamic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbrella domes"@en .

aat:300001308 a skos:Concept ;
    skos:definition "Domes having ribs; also, domes, usually of wood or metal, with vertical members converging at the crown, intersected by horizontal members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbed domes"@en .

aat:300001309 a skos:Concept ;
    skos:definition "Parts or components of domes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dome components"@en .

aat:300001313 a skos:Concept ;
    skos:definition "The vertical wall, circular or polygonal in plan, that carries a dome. The vertical wall, circular or polygonal in plan, that carries a dome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drums"@en .

aat:300001316 a skos:Concept ;
    skos:definition "Roughly triangular or wedge-shaped segments of objects, as found in domes, globes, umbrellas, or skirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gores"@en .

aat:300001319 a skos:Concept ;
    skos:definition "Curved wall surfaces which form a transition between a dome (or its drum) and the supporting masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendentives"@en .

aat:300001322 a skos:Concept ;
    skos:definition "Arches or corbeled transitional elements that span the interior corners of a square or polygonal structure serving to support a circular or polygonal superstructure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squinches"@en .

aat:300001323 a skos:Concept ;
    skos:definition "Rings or chains that encircle domes in order to contain their outward thrusts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tension rings"@en .

aat:300001324 a skos:Concept ;
    skos:definition "Arched structures, usually of masonry and forming a ceiling or roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaults"@en .

aat:300001331 a skos:Concept ;
    skos:definition "Vaults formed by the intersection of two or more simple vaults. Vaults formed by the intersection of two or more simple vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compound vaults"@en .

aat:300001333 a skos:Concept ;
    skos:definition "Vaults divided into three vaulting cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripartite vaults"@en .

aat:300001334 a skos:Concept ;
    skos:definition "Vaults divided into four vaulting cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadripartite vaults"@en .

aat:300001335 a skos:Concept ;
    skos:definition "Vaults divided into six vaulting cells. Vaults divided into six vaulting cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sexpartite vaults"@en .

aat:300001337 a skos:Concept ;
    skos:definition "Ribbed vaults divided into eight vaulting cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octopartite vaults"@en .

aat:300001341 a skos:Concept ;
    skos:definition "Vaults shaped like a pyramid with sides that bow outward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloister vaults"@en .

aat:300001347 a skos:Concept ;
    skos:definition "Compound vaults in which barrel vaults intersect forming ridges called groins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groined vaults"@en .

aat:300001351 a skos:Concept ;
    skos:definition "Compound vaults in which intersecting barrel vaults are of differing widths, the ridges of the same height but the springing lines of different height, producing a groin line of double curvature. Compound vaults in which intersecting barrel vaults are of differing widths, the ridges of the same height but the springing lines of different height, producing a groin line of double curvature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilted vaults"@en .

aat:300001352 a skos:Concept ;
    skos:definition "Vaults in which the surface between the stilted wall rib and the diagonal rib is warped like a plowshare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plowshare vaults"@en .

aat:300001355 a skos:Concept ;
    skos:definition "Groined vaults formed by the penetration of two vaults of unequal size springing from the same level. Groined vaults formed by the penetration of two vaults of unequal size springing from the same level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underpitch vaults"@en .

aat:300001362 a skos:Concept ;
    skos:definition "Vaults that have a smooth intrados without ribs or cross arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simple vaults"@en .

aat:300001363 a skos:Concept ;
    skos:definition "Vaults of plain, semicircular cross section supported by parallel walls or arcades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel vaults"@en .

aat:300001370 a skos:Concept ;
    skos:definition "Barrel vaults covering a space the plan of which is formed by the area between two concentric circles, or any portion of such a space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annular vaults"@en .

aat:300001371 a skos:Concept ;
    skos:definition "Barrel vaults having their two springing points at different levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rampant barrel vaults"@en .

aat:300001374 a skos:Concept ;
    skos:definition "Annular vaults with a spiral axis used to support, for example, the steps of a spiral stair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral vaults"@en .

aat:300001383 a skos:Concept ;
    skos:definition "Vaults that are larger at one end than at the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expanding vaults"@en .

aat:300001385 a skos:Concept ;
    skos:definition "Expanding vaults in which the smaller base is semicircular, the larger base semielliptical. Expanding vaults in which the smaller base is semicircular, the larger base semielliptical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conoidal vaults"@en .

aat:300001389 a skos:Concept ;
    skos:definition "Segments of vaults used externally as the supports of projecting features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trompes"@en .

aat:300001393 a skos:Concept ;
    skos:definition "Vaults that include ribs either as supporting or decorative elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbed vaults"@en .

aat:300001396 a skos:Concept ;
    skos:definition "Vaults consisting or solid concave-sided semicones, meeting or nearly meeting at the apex of the vault, the areas between cones being flat, and the whole being given a highly decorative treatment with ribs that fan out from the vault's springing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan vaults"@en .

aat:300001399 a skos:Concept ;
    skos:definition "Vaults in which liernes are used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lierne vaults"@en .

aat:300001400 a skos:Concept ;
    skos:definition "Denotes ribbed barrel vaults covered by squares set on the diagonal so that the diagonal ribs cross adjacent bays and so that by the resulting network of ribs the autonomy of individual bays is lost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "net vaults"@en .

aat:300001401 a skos:Concept ;
    skos:definition "Vaults whose rib patterns suggest a star."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stellar vaults"@en .

aat:300001405 a skos:Concept ;
    skos:definition "Vaults constructed by corbeling, or cantilevering, successive courses inward beyond the preceding one, until they meet and are capped at the vault's midpoint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corbel vaults"@en .

aat:300001408 a skos:Concept ;
    skos:definition "Tile timbrel vaults erected by the Guastavino family between about 1800 and 1950, especially in the United States since 1881."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guastavino vaults"@en .

aat:300001412 a skos:Concept ;
    skos:definition "Parts or components of vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vault components"@en .

aat:300001425 a skos:Concept ;
    skos:definition "The ridges or edges formed by the intersection of the surfaces of two or more intersecting vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groins"@en .

aat:300001426 a skos:Concept ;
    skos:definition "The middle part between the crown and the springing of arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haunches"@en .

aat:300001456 a skos:Concept ;
    skos:definition "Capitals of piers or shafts that appear to support vaults or ribs of vaults. Capitals of piers or shafts that appear to support vaults or ribs of vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaulting capitals"@en .

aat:300001457 a skos:Concept ;
    skos:definition "Compartments between the groins or ribs of a vault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaulting cells"@en .

aat:300001464 a skos:Concept ;
    skos:definition "Horizontal courses made up of the abutments or springers of a vault; generally made of stones set in projection or corbeled out, with horizontal beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaulting courses"@en .

aat:300001465 a skos:Concept ;
    skos:definition "The courses of vault ribs at the point where the ribs begin to spring and separate from the wall bonding; the point of the vault's maximum outward thrust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tas-de-charges"@en .

aat:300001479 a skos:Concept ;
    skos:definition "All the members of buildings or structures required to transmit loads to the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural frames"@en .

aat:300001484 a skos:Concept ;
    skos:definition "Structures based on upright posts or columns supporting horizontal beams or lintels; these exclude balloon frames and platform frames, in which support is by stud walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post-and-beam structures"@en .

aat:300001489 a skos:Concept ;
    skos:definition "Wooden building frames that use diagonal bracing between full-height corner posts and the plates; generally found in construction with timbers heavy enough to be mortised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braced frames"@en .

aat:300001497 a skos:Concept ;
    skos:definition "Structural members whose primary function is to carry transverse loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beams"@en .

aat:300001502 a skos:Concept ;
    skos:definition "Beams with an H-shaped section, with wider flanges in relation to the depth of the web than in I-beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "H-beams"@en .

aat:300001503 a skos:Concept ;
    skos:definition "Rolled or extruded structural metal beams having a cross section resembling the letter I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "I-beams"@en .

aat:300001505 a skos:Concept ;
    skos:definition "Beams composed of a stem and a flange so that their section resembles a T, usually of rolled metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "T-beams"@en .

aat:300001511 a skos:Concept ;
    skos:definition "Large, roughly squared timber material used for beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balk"@en .

aat:300001515 a skos:Concept ;
    skos:definition "Built-up hollow beams of rectangular section, whether metal or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box beams"@en .

aat:300001516 a skos:Concept ;
    skos:definition "Beams, whether of metal, wood, or concrete, which are made up of separate parts fastened together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "built-up beams"@en .

aat:300001518 a skos:Concept ;
    skos:definition "Beams built up of structural timbers which are bolted together with a steel plate sandwiched between them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flitch beams"@en .

aat:300001523 a skos:Concept ;
    skos:definition "Beams enclosed in finished millwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cased beams"@en .

aat:300001530 a skos:Concept ;
    skos:definition "Short horizontal timbers bisecting the angle of a corner of a structure, at the level of the roof plate, reaching to an angle brace, and serving to support the foot of a hip rafter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragon beams"@en .

aat:300001534 a skos:Concept ;
    skos:definition "Large or principal beams used to support concentrated loads at isolated points along their length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girders"@en .

aat:300001537 a skos:Concept ;
    skos:definition "Girders with more than two supports. Girders with more than two supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous girders"@en .

aat:300001538 a skos:Concept ;
    skos:definition "Steel girders built up of plates and angles or other structural shapes, welded or riveted together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate girders"@en .

aat:300001539 a skos:Concept ;
    skos:definition "Horizontal structural members at an intermediate level, spanning between studs or columns, and serving as stiffeners or as supports for joists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girts"@en .

aat:300001543 a skos:Concept ;
    skos:definition "Nonstructural beams, introduced for appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jesting beams"@en .

aat:300001544 a skos:Concept ;
    skos:definition "Parallel beams used to support floor and ceiling loads and supported in turn by larger beams, girders, bearing walls, or other members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joists"@en .

aat:300001547 a skos:Concept ;
    skos:definition "Joists which carry a ceiling; also small beams to which the ceiling of a room is attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling joists"@en .

aat:300001551 a skos:Concept ;
    skos:definition "Trusslike joists having an open web whose component parts are either hot-rolled structural shapes or cold-formed light-gauge steel shapes. Trusslike joists having an open web whose component parts are either hot-rolled structural shapes or cold-formed light-gauge steel shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open web joists"@en .

aat:300001565 a skos:Concept ;
    skos:definition "Horizontal beams supporting the ends of floor joists or resting on posts and supporting the wall above. Horizontal beams supporting the ends of floor joists or resting on posts and supporting the wall above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summerbeams"@en .

aat:300001568 a skos:Concept ;
    skos:definition "Beams with three or more supports. Beams with three or more supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous beams"@en .

aat:300001569 a skos:Concept ;
    skos:definition "Beams supported at each end so their ends are free to rotate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simple beams"@en .

aat:300001570 a skos:Concept ;
    skos:definition "Structural beams usually of rolled steel whose cross sections resemble the letter H."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wide-flange beams"@en .

aat:300001571 a skos:Concept ;
    skos:definition "In the discipline of architecture, refers to cylindrical or slightly tapering, vertical members made to either give support or to appear to give support. They usually comprise three sections: base, capital, and shaft. The term also refers to all uprights in steel frame or concrete frame structures. Columns may occasionally stand alone as a monument, for example in Trajan's Column in Rome or Nelson's Column in London. Columns may be used as decorative elements on furniture. For square or rectangular members, either in masonry construction or classically treated, and for massive uprights in Medieval architecture, see \"piers (supporting elements)\"; for wooden square uprights, see \"posts.\" In the discipline of architecture, refers to cylindrical or slightly tapering, vertical members made to either give support or to appear to give support. They usually comprise three sections: base, capital, and shaft. The term also refers to all uprights in steel frame or concrete frame structures. Columns may occasionally stand alone as a monument, for example in Trajan's Column in Rome or Nelson's Column in London. Columns may be used as decorative elements on furniture. For square or rectangular members, either in masonry construction or classically treated, and for massive uprights in Medieval architecture, see \"piers (supporting elements)\"; for wooden square uprights, see \"posts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columns"@en .

aat:300001574 a skos:Concept ;
    skos:definition "Male figures, usually nude or only partly clad, used as supports or apparent supports. They are occasionally found on furniture from the 16th century onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atlantes"@en .

aat:300001577 a skos:Concept ;
    skos:definition "Columns resembling balusters, composed of a base, a potlike element, a bulbous shaft, and a capital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baluster columns"@en .

aat:300001579 a skos:Concept ;
    skos:definition "Columns with drums alternately larger and smaller, or plainer and richer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banded columns"@en .

aat:300001581 a skos:Concept ;
    skos:definition "Columns or clusters of shafts encircled by annulets or shaft rings, common in Medieval architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annulated columns"@en .

aat:300001583 a skos:Concept ;
    skos:definition "Supporting members serving the function of a pier, column, or pilaster and carved or molded into the form of a draped female human figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caryatids"@en .

aat:300001584 a skos:Concept ;
    skos:definition "Small or slender columns. For small Medieval columns, usually attached to architectural features, use \"shafts (Medieval columns).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonnettes"@en .

aat:300001592 a skos:Concept ;
    skos:definition "Pilasters with complex ornament and low-relief sculpture that taper from top to base, as commonly encountered in Spanish post-Renaissance architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estipites"@en .

aat:300001593 a skos:Concept ;
    skos:definition "Three or more closely spaced columns which form a distinct group. When two columns form a distinct group, use \"coupled columns\" or \"doubled columns.\" For supports consisting of several columns engaged around a central core, especially in Medieval contexts, use \"compound piers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grouped columns"@en .

aat:300001595 a skos:Concept ;
    skos:definition "Groups of two columns set closer together than others in a line, or otherwise forming a visual unit; for columns with interpenetrating shafts, use \"doubled columns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupled columns"@en .

aat:300001598 a skos:Concept ;
    skos:definition "Columns with shafts intertwined as if tied in a knot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knotted columns"@en .

aat:300001609 a skos:Concept ;
    skos:definition "In architecture or other construction, refers to stiff, vertical, relatively isolated members of considerable length. Posts are typically round, square, or rectangular in cross-section and are used in building as supports for a superstructure or to provide a firm point of lateral attachment. They are characteristically relatively undecorated and made of a single timber, but may be made of stone, metal, another material, or composite materials. The term is particularly used for any main vertical support in a timber frame structure. For square uprights in classical style, and for square and rectangular masonry uprights, use \"piers (supporting elements)\"; for most cylindrical uprights, and for all uprights in steel and concrete frames, use \"columns (architectural elements).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posts"@en .

aat:300001611 a skos:Concept ;
    skos:definition "Interior posts or columns encased in finished millwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cased posts"@en .

aat:300001612 a skos:Concept ;
    skos:definition "Metal pipes, sometimes filled with concrete, used to support girders or beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lally columns (TM)"@en .

aat:300001613 a skos:Concept ;
    skos:definition "Short posts and short upright pieces of timber in framing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puncheons"@en .

aat:300001619 a skos:Concept ;
    skos:definition "Upright timbers at the sides of openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jamb posts"@en .

aat:300001620 a skos:Concept ;
    skos:definition "Christian monuments in the form of a column and dedicated to or featuring the Holy Trinity, erected as a gesture of public faith, as a plague column, or for another purpose. Common in Catholic countries of Europe, especially in the 17th and 18th centuries. Some trinity columns are triangular in plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trinity columns"@en .

aat:300001626 a skos:Concept ;
    skos:definition "Columns so shaped as to present a twisted or spiral form. The form was an eastern motif, adopted in Byzantine architecture and decoration. It was believed that such columns were used in Solomon's temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral columns"@en .

aat:300001628 a skos:Concept ;
    skos:definition "Columns supporting a figure or figures of one or more people or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoophoric columns"@en .

aat:300001629 a skos:Concept ;
    skos:definition "Columns depicting serpents, features of Toltec architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpent columns"@en .

aat:300001635 a skos:Concept ;
    skos:definition "Piers produced by the thickening of walls at their termination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antae"@en .

aat:300001638 a skos:Concept ;
    skos:definition "Columns that are split longitudinally or partially built into a surface, not freestanding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engaged columns"@en .

aat:300001643 a skos:Concept ;
    skos:definition "Engaged columns which project approximately half their diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half columns"@en .

aat:300001647 a skos:Concept ;
    skos:definition "Small columns with capital and base placed against the jambs of doors or windows, especially found in Medieval architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jamb shafts"@en .

aat:300001648 a skos:Concept ;
    skos:definition "Columns supporting a wall of considerably greater thickness than itself and set more or less at the center of that thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mid-wall columns"@en .

aat:300001649 a skos:Concept ;
    skos:definition "Columns set within angles formed by the features of a building, as where the jamb of a doorway meets the external face of a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nook shafts"@en .

aat:300001650 a skos:Concept ;
    skos:definition "Parts or components of columns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "column components"@en .

aat:300001651 a skos:Concept ;
    skos:definition "In columns, concave sweep where the shaft springs from the base or terminates in the capital; also, hollows or scotias beneath the echinus of some Archaic Doric capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apophyges"@en .

aat:300001656 a skos:Concept ;
    skos:definition "Elements at the bottoms of structures or objects upon which the upper parts rest or are supported; for large objects, bases are often relatively massive. For terminal elements upon which objects rest and that are small in relation to the body of the object, use \"feet.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bases"@en .

aat:300001658 a skos:Concept ;
    skos:definition "Bases of Ionic columns following a pattern developed in Asia Minor, with an upper torus surmounting a disk generally composed of shallow scotias, both elements being usually horizontally fluted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asiatic bases"@en .

aat:300001659 a skos:Concept ;
    skos:definition "Refers to column bases consisting of a scotia between an upper and lower torus, usually found on Ionic, Corinthian, and occasionally on Doric columns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Attic bases"@en .

aat:300001662 a skos:Concept ;
    skos:definition "The uppermost members of columns, piers, or pilasters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capitals"@en .

aat:300001667 a skos:Concept ;
    skos:definition "Refers broadly to a range of capital designs found in the Mediterranean world prior to the Classical period and generally characterized by paired, vertically rising volutes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aeolic capitals"@en .

aat:300001668 a skos:Concept ;
    skos:definition "Capitals of corner columns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle capitals"@en .

aat:300001671 a skos:Concept ;
    skos:definition "Capitals having interlaced bands resembling the weave of a basket; found in Medieval and Byzantine architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basket capitals"@en .

aat:300001673 a skos:Concept ;
    skos:definition "Capitals whose upper bearing surface has been greatly extended by projecting elements placed along the planes loaded by beams or roof members, generally used to lessen the span between supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracket capitals"@en .

aat:300001677 a skos:Concept ;
    skos:definition "Capitals having a series of crockets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crocket capitals"@en .

aat:300001678 a skos:Concept ;
    skos:definition "Cubic capitals with their lower angles rounded off, to make the transition to a round column; found in Medieval architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cushion capitals"@en .

aat:300001688 a skos:Concept ;
    skos:definition "Capitals resembling a lotus bud, common in ancient Egyptian architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lotus capitals"@en .

aat:300001692 a skos:Concept ;
    skos:definition "Capitals resembling the crown of a palm tree, the edge of the spreading top being scalloped to suggest the fronds, common in ancient Egyptian architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palm capitals"@en .

aat:300001694 a skos:Concept ;
    skos:definition "Egyptian capitals in the form of a cluster of papyrus flowers, the top fanning out broadly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papyrus capitals"@en .

aat:300001695 a skos:Concept ;
    skos:definition "Capitals representing the heads and necks of animals, human heads or mythological creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protomai capitals"@en .

aat:300001696 a skos:Concept ;
    skos:definition "Capitals in which the four sides are shaped into a series of curves resembling truncated cones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scalloped capitals"@en .

aat:300001698 a skos:Concept ;
    skos:definition "Parts or components of capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capital components"@en .

aat:300001699 a skos:Concept ;
    skos:definition "Uppermost members of the capitals of columns; often plain square slabs, but sometimes molded or otherwise enriched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abaci"@en .

aat:300001702 a skos:Concept ;
    skos:definition "Refers to the rolls, faced at either end with volutes, forming the sides of an Ionic capital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulvini"@en .

aat:300001703 a skos:Concept ;
    skos:definition "Decorative bands often encircling and seeming to constrain the middle of the bolsters on Ionic capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baltei"@en .

aat:300001708 a skos:Concept ;
    skos:definition "Ornamental stalks rising between the leaves of a Corinthian capital, from which the volutes spring and upon which the fleurons are sometimes supported."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauliculi"@en .

aat:300001713 a skos:Concept ;
    skos:definition "The convex moldings supporting the abaci of Doric capitals and appearing between the volutes on Ionic capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "echini"@en .

aat:300001717 a skos:Concept ;
    skos:definition "Grooves beneath the necking of Doric capitals masking the joint between capital and shaft. For the fillets encircling the Doric capital at the bottom of the echinus, use \"annulets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypotrachelia"@en .

aat:300001720 a skos:Concept ;
    skos:definition "The part of a column between the bottom of the capital and the top of the shaft, or the molding or moldings located here."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neckings"@en .

aat:300001729 a skos:Concept ;
    skos:definition "The spiral forms in capitals of the Ionic, Corinthian, and Composite orders; sometimes used also for other three-dimensional scrolling elements in architecture and the decorative arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volutes"@en .

aat:300001732 a skos:Concept ;
    skos:definition "Structural portions of a flat slab that is thickened (by lowering the form) throughout an area surrounding a column, column capital, or bracket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop panels"@en .

aat:300001733 a skos:Concept ;
    skos:definition "Cylinders of stone that form the shaft of a column. Cylinders of stone that form the shaft of a column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drums"@en .

aat:300001744 a skos:Concept ;
    skos:definition "Solid, fixed supports found under such architectural elements as columns or balustrades, or built in to hold sculpture; may also be used for freestanding furniture supports, usually for decorative objects, sometimes incorporating cabinets or shelves; usually classically divided by tripartation into base, dado, and cap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestals"@en .

aat:300001746 a skos:Concept ;
    skos:definition "Refers to the middle portion of a pedestal, between the base and the cap. Use also for the lower zone of an interior wall, when given a distinct treatment, as this treatment often resembles a pedestal in appearance. Refers to the middle portion of a pedestal, between the base and the cap. Use also for the lower zone of an interior wall, when given a distinct treatment, as this treatment often resembles a pedestal in appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dadoes"@en .

aat:300001749 a skos:Concept ;
    skos:definition "Rectangular or square supporting elements or lower blocks, as for columns, pilasters, or door framing; also solid monumental bases, often ornamented, used to support statues or memorials. For the bases of external walls or the platformlike base courses of buildings, use \"plinth courses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plinths"@en .

aat:300001750 a skos:Concept ;
    skos:definition "Deep concave moldings, especially one at the base of a column in classical architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scotias"@en .

aat:300001754 a skos:Concept ;
    skos:definition "The portions of columns, colonettes, or pilasters between the base and the capital. The portions of columns, colonettes, or pilasters between the base and the capital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shafts"@en .

aat:300001762 a skos:Concept ;
    skos:definition "Bands or moldings found most often in Gothic architecture encircling shafts of columns or engaged columns at locations other than their ends, often to hide or to strengthen the joint between two sections of a shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaft rings"@en .

aat:300001763 a skos:Concept ;
    skos:definition "Moldings located at the top or bottom of column shafts, especially of Classical design. For molded bands on shafts in Gothic architecture, not located at the ends, use \"shaft rings.\" For angular bands around the base of the Doric echinus, use \"annulets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinctures"@en .

aat:300001764 a skos:Concept ;
    skos:definition "Bold projecting moldings, convex in shape, generally forming the lowest member of a base of a column over the plinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toruses"@en .

aat:300001770 a skos:Concept ;
    skos:definition "Refers to the elaborated superstructures carried by the columns in classical architecture, horizontally divided into architrave, frieze, and cornice. May connote similar features in other contexts, such as along the upper portions of walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entablatures"@en .

aat:300001779 a skos:Concept ;
    skos:definition "Parts or components of entablatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entablature components"@en .

aat:300001780 a skos:Concept ;
    skos:definition "Principally used in Classical architecture, the lowest of the three main parts of an entablature that rests on the abacus of a column, comprising a horizontal beam that spans the columns or piers in the manner of a lintel. The other two parts of the entablature are the cornice and the frieze. For the architrave-like molded frame that surrounds a door or window, use \"architrave trim.\" For the ornamental moldings around the exterior curve of an arch, use \"archivolts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architraves"@en .

aat:300001783 a skos:Concept ;
    skos:definition "Flat strips on Ionic and Corinthian architraves. For boards nailed across the ends of rafters in wood construction, use \"fascia boards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fascias"@en .

aat:300001788 a skos:Concept ;
    skos:definition "The projecting, uppermost features of classical entablatures; use also for similar features crowning a window or wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornices"@en .

aat:300001790 a skos:Concept ;
    skos:definition "Entablatures in which the cornice rests directly on the architrave, the frieze being omitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architrave cornices"@en .

aat:300001791 a skos:Concept ;
    skos:definition "Cornices of slight projection, with plain blocklike modillions and simple bed moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block cornices"@en .

aat:300001792 a skos:Concept ;
    skos:definition "Cornices consisting of a large cavetto molding, sometimes decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavetto cornices"@en .

aat:300001796 a skos:Concept ;
    skos:definition "Cornices following the slope of a gable, pediment, or roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raking cornices"@en .

aat:300001797 a skos:Concept ;
    skos:definition "Parts or components of cornices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornice components"@en .

aat:300001798 a skos:Concept ;
    skos:definition "Use both for small cornice moldings situated beneath the corona and above the frieze in Classical architecture and its derivatives, and for moldings located beneath an overhanging horizontal surface, as below the eaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed moldings"@en .

aat:300001800 a skos:Concept ;
    skos:definition "Overhanging vertical members of a cornice in classical architecture, supported by bed moldings and crowned by cymatia, usually with a drip to throw rainwater clear of the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronas"@en .

aat:300001806 a skos:Concept ;
    skos:definition "Bands of small, rectangular, toothlike blocks, usually along the underside of a cornice; a characteristic ornament of classical and classicizing styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dentils"@en .

aat:300001811 a skos:Concept ;
    skos:definition "Brackets, often in the form of a scroll with acanthus, supporting a cornice. Brackets, often in the form of a scroll with acanthus, supporting a cornice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modillions"@en .

aat:300001815 a skos:Concept ;
    skos:definition "Sloping flat blocks on the soffit of the Doric cornice, usually decorated with rows of six guttae each; occur over each triglyph and each metope of the frieze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutules"@en .

aat:300001816 a skos:Concept ;
    skos:definition "Middle horizontal members of a classical entablature, above the architrave and below the cornice. For horizontal decorated bands in general, found on architecture and furniture, see \"friezes (ornamental areas).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friezes"@en .

aat:300001818 a skos:Concept ;
    skos:definition "Friezes with a convex face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulvinated friezes"@en .

aat:300001823 a skos:Concept ;
    skos:definition "Parts or components of friezes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frieze components"@en .

aat:300001824 a skos:Concept ;
    skos:definition "Panels between triglyphs in the Doric frieze, often carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metopes"@en .

aat:300001825 a skos:Concept ;
    skos:definition "Half or incomplete metopes in Doric friezes, usually found at corners. Half or incomplete metopes in Doric friezes, usually found at corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demimetopes"@en .

aat:300001826 a skos:Concept ;
    skos:definition "The characteristic ornaments of the Doric frieze, consisting of a slightly raised block of three vertical bands separated by V-shaped grooves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triglyphs"@en .

aat:300001827 a skos:Concept ;
    skos:definition "Pendant ornaments in the form of truncated cones found on the underside of mutules and regulae of Doric entablatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guttae"@en .

aat:300001828 a skos:Concept ;
    skos:definition "Refers to the half channels on either side of a triglyph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemiglyphs"@en .

aat:300001829 a skos:Concept ;
    skos:definition "In a Doric entablature, series of short bands beneath the taeniae, from which the guttae hang."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regulae"@en .

aat:300001833 a skos:Concept ;
    skos:definition "Frameworks usually designed to carry both lateral and vertical loads and that are transverse to the length of a framed structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bents"@en .

aat:300001834 a skos:Concept ;
    skos:definition "Rigid stays, usually of wood or metal, and commonly in compression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braces"@en .

aat:300001837 a skos:Concept ;
    skos:definition "Angle braces which support one end of a dragon beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragon ties"@en .

aat:300001838 a skos:Concept ;
    skos:definition "Members placed across the inside of an angle in a framework to add stiffness to the framework, as between roof members and wall members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knee braces"@en .

aat:300001839 a skos:Concept ;
    skos:definition "Braces, such as struts, which strengthen a structure or framework against the wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind braces"@en .

aat:300001840 a skos:Concept ;
    skos:definition "Curved braces, usually in pairs, used to support a roof frame and give the effect of an arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch braces"@en .

aat:300001841 a skos:Concept ;
    skos:definition "Braces or systems of braces, placed between horizontal or vertical structural members, to stiffen them, hold them in place, and to help distribute the load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridging"@en .

aat:300001842 a skos:Concept ;
    skos:definition "Diagonal bracing in pairs between adjacent floor joists to prevent the joists from twisting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross bridging"@en .

aat:300001845 a skos:Concept ;
    skos:definition "Beams or other lements that project horizontally or nearly horizontally into space, and are fixed at one end and carry a load distributed along the length or at the other, such as a diving board. The upper half of the thickness of such a beam is subjected to tensile stress, tending to elongate the fibres, the lower half to compressive stress, tending to crush them. Beams or other lements that project horizontally or nearly horizontally into space, and are fixed at one end and carry a load distributed along the length or at the other, such as a diving board. The upper half of the thickness of such a beam is subjected to tensile stress, tending to elongate the fibres, the lower half to compressive stress, tending to crush them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantilevers"@en .

aat:300001846 a skos:Concept ;
    skos:definition "Pairs of naturally curved timbers that rise from the ground or outer walls of buildings to support a ridge beam; joined at the top and connected by tie beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crucks"@en .

aat:300001848 a skos:Concept ;
    skos:definition "Framing members that cross and support the ends of joists or rafters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headers"@en .

aat:300001849 a skos:Concept ;
    skos:definition "Wood strips or boards let into the studs to add support for the ends of the joists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ledger boards"@en .

aat:300001855 a skos:Concept ;
    skos:definition "In frame construction, horizontal boards or timbers in a wall, on top of the studs of a wall, or on the ground to receive other timbers or joists. In frame construction, horizontal boards or timbers in a wall, on top of the studs of a wall, or on the ground to receive other timbers or joists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plates"@en .

aat:300001856 a skos:Concept ;
    skos:definition "Horizontal timbers at the bottom of the frame of a wood structure, that rest on the foundation or subfloor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sill plates"@en .

aat:300001864 a skos:Concept ;
    skos:definition "Horizontal members laid across the bottom of an unfinished opening to act as a base during construction of window frames or door frames. For the horizontal members that rest on the foundation at the bottom of a wood structure, use \"sill plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough sills"@en .

aat:300001868 a skos:Concept ;
    skos:definition "Horizontal members placed along the tops of walls or a series of studs to support joists or rafters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall plates"@en .

aat:300001871 a skos:Concept ;
    skos:definition "Wall plates that receive the lower ends of the rafters of a roof. Wall plates that receive the lower ends of the rafters of a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roof plates"@en .

aat:300001874 a skos:Concept ;
    skos:definition "Timber formed into long, cylindrical sections, the approximate diameter at breast height being one foot or less."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole"@en .

aat:300001880 a skos:Concept ;
    skos:definition "Posts that raise a structure above ground or water level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilts"@en .

aat:300001882 a skos:Concept ;
    skos:definition "Series of vertical structural members which act as the supporting elements in a wall or partition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studs"@en .

aat:300001891 a skos:Concept ;
    skos:definition "Pieces of timber inserted in a roof, floor, or wooden partition to support a header, which in turn supports the ends of the joists, rafters, or studs. Also, small horizontal beams, as in a floor, into which the ends of one or more joists are framed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimmers"@en .

aat:300001892 a skos:Concept ;
    skos:definition "In engineering, structural members such as beams, bars, or rods, usually fabricated from straight pieces of metal or timber, that form a series of triangles lying in a single plane; based on the principle that a triangle cannot be easily distorted by stress. Trusses were probably first used in primitive lake dwellings during the early Bronze Age, about 2500 BCE. The first trusses were built of timber. The Greeks used trusses extensively in roofing; trusses were used for various construction purposes in the European Middle Ages. A major impetus to truss design came in the development of covered bridges in the United States in the early 19th century. Cast iron and wrought iron were succeeded by steel for railroad truss bridges. Trusses are also used extensively in machinery, such as cranes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trusses"@en .

aat:300001898 a skos:Concept ;
    skos:definition "Trusses having a bow-shaped top chord, often semicircular or parabolic, and a straight or cambered member that ties together the two ends of the bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowstring trusses"@en .

aat:300001901 a skos:Concept ;
    skos:definition "Trusses, patented in the early 19th century by Theodore Burr, combining a wood arch with a series of metal king-post trusses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burr arch trusses"@en .

aat:300001902 a skos:Concept ;
    skos:definition "Trusses whose upper and lower chords are both curved in the same direction but with different radii of curvature, so that they meet at the ends, giving a crescentlike appearance. Trusses whose upper and lower chords are both curved in the same direction but with different radii of curvature, so that they meet at the ends, giving a crescentlike appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crescent trusses"@en .

aat:300001903 a skos:Concept ;
    skos:definition "Refers to a variety of symmetrical trusses: those in the form of three isosceles triangles with one triangle in the center with its base along the bottom chord and each of the outer two triangles having its base along the sloping side at an upper chord, or those in the form of triangles with diagonal members forming W-shapes, or those in the form of rectangles with few verticals in proportion to numerous diagonal web members of different lengths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fink trusses"@en .

aat:300001909 a skos:Concept ;
    skos:definition "Planar trusses of various configurations in which the diagonal members are in compression and the vertical members are in tension; when the diagonals are in tension and the verticals are in compression, use \"Pratt trusses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Howe trusses"@en .

aat:300001910 a skos:Concept ;
    skos:definition "Triangular frames with a vertical central strut (the king post) extending from apex to tie beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "king-post trusses"@en .

aat:300001914 a skos:Concept ;
    skos:definition "Pratt trusses with polygonal top chords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parker trusses"@en .

aat:300001916 a skos:Concept ;
    skos:definition "Trusses having parallel chords, vertical members in compression, and diagonal members (which slant toward the center) in tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pratt trusses"@en .

aat:300001921 a skos:Concept ;
    skos:definition "Trusses having two vertical posts between the rafters and the tie beam; the upper ends of the vertical posts are connected by a straining piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queen-post trusses"@en .

aat:300001923 a skos:Concept ;
    skos:definition "Trusses used to support a pitched roof; the ties cross each other and are connected to the opposite rafters at an intermediate point along their length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scissors trusses"@en .

aat:300001927 a skos:Concept ;
    skos:definition "Trusses of closely spaced intersecting diagonal members, usually of wood, following a design patented by Ithiel Town in 1820. Trusses of closely spaced intersecting diagonal members, usually of wood, following a design patented by Ithiel Town in 1820."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Town lattice trusses"@en .

aat:300001929 a skos:Concept ;
    skos:definition "Double-intersection Pratt trusses having diagonal tension members and vertical compression members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Whipple trusses"@en .

aat:300001939 a skos:Concept ;
    skos:definition "Bridge trusses supporting loads on their lower chords and having lateral bracing between their top chords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "through trusses"@en .

aat:300001940 a skos:Concept ;
    skos:definition "Bridge trusses supporting loads on their lower chords and having no lateral bracing between their top chords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pony trusses"@en .

aat:300001945 a skos:Concept ;
    skos:definition "Parts or components of trusses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss components"@en .

aat:300001946 a skos:Concept ;
    skos:definition "Principal members of trusses that extend the length of the truss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chords"@en .

aat:300001952 a skos:Concept ;
    skos:definition "In a truss, members which join the top and bottom chords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web members"@en .

aat:300001955 a skos:Concept ;
    skos:definition "Support systems and areas of buildings or other structures located below ground level or at the lower portions of structures when distinguishing these portions from the above ground or upper levels, in which case use \"superstructures.\" Use \"foundations (structural elements)\" specifically for those parts of structures, usually below ground, that transmit loads to the supporting earth or rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "substructures"@en .

aat:300001957 a skos:Concept ;
    skos:definition "Refers to the upper portions of buildings or other structures located above the foundation and usually above ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superstructures"@en .

aat:300001966 a skos:Concept ;
    skos:definition "Structures based on a skewed grid of archlike forms, usually wood or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamella roofs"@en .

aat:300001968 a skos:Concept ;
    skos:definition "Structures in which both a thin outer surface and the framework carry loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stressed-skin structures"@en .

aat:300001972 a skos:Concept ;
    skos:definition "Rigid frame structures with closely spaced exterior columns rigidly connected to spandrel beams to form a tubelike exterior framework that carries all lateral loads, as in the World Trade Center towers, New York City."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tube structures"@en .

aat:300001978 a skos:Concept ;
    skos:definition "Structures having no more than three unknown reactions, so that the reactions can be found through simple application of the basic equations of statics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statically determinate structures"@en .

aat:300001980 a skos:Concept ;
    skos:definition "Structures that cannot be analyzed using principles of equilibrium or equations of statics because there are more than three unknown reactions on the given structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statically indeterminate structures"@en .

aat:300001986 a skos:Concept ;
    skos:definition "Structures that do not undergo appreciable changes in shape under the actions of loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigid structures"@en .

aat:300001987 a skos:Concept ;
    skos:definition "Architectural elements or components located on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface elements"@en .

aat:300001988 a skos:Concept ;
    skos:definition "Architectural elements used to form a barrier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrier elements"@en .

aat:300001989 a skos:Concept ;
    skos:definition "Parapets or low screens composed of balusters and carrying a rail or other horizontal member that is usually heavy in proportion to the balusters themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balustrades"@en .

aat:300001993 a skos:Concept ;
    skos:definition "Refers to wooden or metal posts on a ship, whale-boat, quay, or pier, used for securing ropes. Bollards made of concrete may be used to prevent passage by automobiles into pedestrian spaces. For indicators sited in roadways that may indicate wayfinding or obstructions, use \"traffic bollards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bollards"@en .

aat:300001997 a skos:Concept ;
    skos:definition "Frames or curbs, around an opening in a roof or floor, raised above the surrounding level to prevent the flow of water into the opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaming"@en .

aat:300002002 a skos:Concept ;
    skos:definition "Fences made of heavy steel wire which is interwoven in such a way as to provide a continuous mesh without ties or knots, except at the ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain link fences"@en .

aat:300002012 a skos:Concept ;
    skos:definition "In building construction, fire-resisting walls, enclosed stairways, and other similar obstructions for preventing the spread of fires in buildings. In building construction, fire-resisting walls, enclosed stairways, and other similar obstructions for preventing the spread of fires in buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire walls"@en .

aat:300002015 a skos:Concept ;
    skos:definition "Grating or openwork barriers, often of metal, used to cover, conceal, decorate, or protect an opening; common also on furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grilles"@en .

aat:300002018 a skos:Concept ;
    skos:definition "Parapets or balustrades of a lightweight, partly open, metal or wood construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railings"@en .

aat:300002019 a skos:Concept ;
    skos:definition "Protective elements placed at dangerous points, as along the edges of roads or on stair landings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guardrails"@en .

aat:300002022 a skos:Concept ;
    skos:definition "Railings that are intended to be grasped by the hand in order to serve as a support; may also refer to the top members of balustrades or railings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handrails"@en .

aat:300002029 a skos:Concept ;
    skos:definition "Barriers which rotate on an axis and are usually so arranged as to allow the passage of a person through an opening only in one direction, one person at a time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turnstiles"@en .

aat:300002031 a skos:Concept ;
    skos:definition "Overhead surfaces of interior spaces, sometimes constructed to mask building systems or structural elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceilings"@en .

aat:300002035 a skos:Concept ;
    skos:definition "Ceilings having beams, either structural or decorative, that are visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beam ceilings"@en .

aat:300002037 a skos:Concept ;
    skos:definition "Ceilings, usually within the roof of a building, characterized by sloping sides and a flat center. Ceilings, usually within the roof of a building, characterized by sloping sides and a flat center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camp ceilings"@en .

aat:300002039 a skos:Concept ;
    skos:definition "Ceilings with deepened decorated panels between intersecting beams of a ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffered ceilings"@en .

aat:300002041 a skos:Concept ;
    skos:definition "Recessed panels, usually square or octagonal, set into ceilings, roofs, vaults, or soffits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffers"@en .

aat:300002046 a skos:Concept ;
    skos:definition "Designates ceilings having a large concave curve at the wall-to-ceiling transition instead of a sharp angle intersection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cove ceilings"@en .

aat:300002049 a skos:Concept ;
    skos:definition "Ceiling-area lighting systems comprising a continuous surface of transmitting material with light sources mounted above it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luminous ceilings"@en .

aat:300002050 a skos:Concept ;
    skos:definition "Nonstructural ceilings suspended below the overhead structural slab or from the structural elements of a building, and not bearing on the walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspended ceilings"@en .

aat:300002058 a skos:Concept ;
    skos:definition "Ceilings of semicylindrical shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel ceilings"@en .

aat:300002060 a skos:Concept ;
    skos:definition "The surfaces of rooms or spaces on which one walks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floors"@en .

aat:300002068 a skos:Concept ;
    skos:definition "Floor slabs or floor assemblies which are completely separated from (and mechanically isolated from) the structural floor by a resilient underlayment or resilient mounting devices; used to isolate the vibration of machinery from the building structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating floors"@en .

aat:300002070 a skos:Concept ;
    skos:definition "Flooring systems consisting of completely removable and interchangeable floor panels that are supported on adjustable pedestals or stringers to allow free access to the area underneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "access floors"@en .

aat:300002077 a skos:Concept ;
    skos:definition "Parts or components of floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor components"@en .

aat:300002083 a skos:Concept ;
    skos:definition "Layers of boards or plywood sheets laid directly on joists and surmounted by the finish flooring, sometimes with a layer of underlayment in between."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subfloors"@en .

aat:300002086 a skos:Concept ;
    skos:definition "Plywood, hardboard, or other material placed on a subfloor to provide a smooth, even surface for applying the finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underlayment"@en .

aat:300002088 a skos:Concept ;
    skos:definition "Durable coverings laid down to form the surface of a road or other outdoor area; by extension, hard floor coverings in large interiors, such as public halls or churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavements"@en .

aat:300002095 a skos:Concept ;
    skos:definition "Pavements that maintain intimate contact with and distribute loads to the subgrade and depend for stability on aggregate interlock, particle friction, and cohesion; for pavements that are more rigidly bonded, use \"rigid pavements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flexible pavements"@en .

aat:300002097 a skos:Concept ;
    skos:definition "Pavements that provide high bending resistance and that distribute loads to the foundation over a relatively large area; for pavements that depend for stability on aggregate interlock, friction, and cohesion, use \"flexible pavements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigid pavements"@en .

aat:300002098 a skos:Concept ;
    skos:definition "Outside, overhead enclosures of buildings or other structures, including the roofing and its structural framing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofs"@en .

aat:300002108 a skos:Concept ;
    skos:definition "Roofs that are semicircular in section or, sometimes, roofs that incorporate a semicircular ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel roofs"@en .

aat:300002113 a skos:Concept ;
    skos:definition "Roofs sloping downward from eaves on either side to a central valley. Roofs sloping downward from eaves on either side to a central valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butterfly roofs"@en .

aat:300002117 a skos:Concept ;
    skos:definition "Includes roofs with no slope and roofs with only sufficient slope to effect drainage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat roofs"@en .

aat:300002125 a skos:Concept ;
    skos:definition "Designates roofs with one or more surfaces that have a pitch greater than 10 degrees from the horizontal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitched roofs"@en .

aat:300002126 a skos:Concept ;
    skos:definition "Roofs with two sloping sides meeting at a ridge, and gables at one or both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable roofs"@en .

aat:300002132 a skos:Concept ;
    skos:definition "Roofs formed by the junction of two gable roofs with a valley between them, resembling the letter M in section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-gable roofs"@en .

aat:300002138 a skos:Concept ;
    skos:definition "Pitched roofs in which the gables are truncated, being surmounted by hips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jerkinhead roofs"@en .

aat:300002142 a skos:Concept ;
    skos:definition "Curb roofs with only the two opposite sides sloping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gambrel roofs"@en .

aat:300002146 a skos:Concept ;
    skos:definition "Roofs of four steeply pitched faces, forming a spire; the four ridges rise from the peaks of four gables, the roof faces being set diagonally in relation to the gable faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helm roofs"@en .

aat:300002147 a skos:Concept ;
    skos:definition "Roofs which rise to a peak or ridge by inclined planes on all, usually four, sides, therefore requiring hip rafters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hip roofs"@en .

aat:300002150 a skos:Concept ;
    skos:definition "Roofs pyramidal in form, or with a very short ridge so as to be nearly pyramidal. Roofs pyramidal in form, or with a very short ridge so as to be nearly pyramidal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramidal roofs"@en .

aat:300002155 a skos:Concept ;
    skos:definition "Curb roofs with all four sides sloping, usually enclosing habitable spaces, and therefore having dormers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mansard roofs"@en .

aat:300002156 a skos:Concept ;
    skos:definition "Mansard roofs in which the lower slope is nearly vertical, the upper slope nearly horizontal. Mansard roofs in which the lower slope is nearly vertical, the upper slope nearly horizontal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French roofs"@en .

aat:300002157 a skos:Concept ;
    skos:definition "Gable roofs in the form of a pointed arch, with a gently sloping convex surface. Gable roofs in the form of a pointed arch, with a gently sloping convex surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rainbow roofs"@en .

aat:300002162 a skos:Concept ;
    skos:definition "Pitched roofs with only one slope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shed roofs"@en .

aat:300002163 a skos:Concept ;
    skos:definition "Small, usually false portions of roofing between the stories of a building. Small, usually false portions of roofing between the stories of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skirt-roofs"@en .

aat:300002167 a skos:Concept ;
    skos:definition "Roof systems that have a number of parallel roof surfaces of triangular section with a profile similar to the teeth in a saw; usually the steeper side is glazed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawtooth roofs"@en .

aat:300002181 a skos:Concept ;
    skos:definition "Roofs without tie or collar beams, and depending on walls to resist thrust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couple roofs"@en .

aat:300002188 a skos:Concept ;
    skos:definition "Roofs supported by hammer beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer-beam roofs"@en .

aat:300002189 a skos:Concept ;
    skos:definition "Roofs supported by a king-post truss. Roofs supported by a king-post truss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "king-post roofs"@en .

aat:300002190 a skos:Concept ;
    skos:definition "Roofs supported by pairs of queen posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queen-post roofs"@en .

aat:300002194 a skos:Concept ;
    skos:definition "Timber roofs in which rafters, collar beams, and braces combine to suggest an arch; most common in Medieval architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass roofs"@en .

aat:300002202 a skos:Concept ;
    skos:definition "Roofs in which the wooden structure is exposed to the rooms below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open-timbered roofs"@en .

aat:300002206 a skos:Concept ;
    skos:definition "Roofs in which the loads are carried by cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspension roofs"@en .

aat:300002212 a skos:Concept ;
    skos:definition "Parts or components of roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roof components"@en .

aat:300002213 a skos:Concept ;
    skos:definition "Exterior parts or components of roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior roof components"@en .

aat:300002214 a skos:Concept ;
    skos:definition "The figures or ornaments at the lower angles or apex of a pediment, generally supported on plinths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acroteria"@en .

aat:300002216 a skos:Concept ;
    skos:definition "Half gables, such as those that close the end of a penthouse roof or the roof over a side aisle of a church; may be scrolled, curved, or otherwise ornamented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ailerons"@en .

aat:300002217 a skos:Concept ;
    skos:definition "Ornaments at the ridge or eaves of a roof, in classical architecture and derivatives, that close or conceal the open end of a row of cover tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antefixes"@en .

aat:300002222 a skos:Concept ;
    skos:definition "Apertures in the center of roofs of atriums in Roman houses, sloping inward to discharge rainwater into a cistern or tank, called an impluvium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compluvia"@en .

aat:300002224 a skos:Concept ;
    skos:definition "Ornamental finish, usually rhythmic and highly decorative, consisting of a regular series of motifs applied to the top of walls, roof ridges, and the like; may also be used for similar decoration on furniture or glass objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cresting"@en .

aat:300002226 a skos:Concept ;
    skos:definition "A decorative feature in Gothic architecture, carved in a variety of leaf shapes and projecting at regular intervals from the angles of spires, gables, or capitals. A decorative feature in Gothic architecture, carved in a variety of leaf shapes and projecting at regular intervals from the angles of spires, gables, or capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crocket"@en .

aat:300002230 a skos:Concept ;
    skos:definition "Generally refers to small domes, often resembling overturned cups or bulbs, placed on a circular, polygonal, or square base or on small pillars or a glassed-in lantern or skylight. A cupola is typically used to crown a turret, roof, or larger dome. The term may also refer specifically to the inner vault of a dome. When these structures are intended to be used as lookouts, prefer \"belvederes\"; for windowed superstructures on roofs or domes used to admit light or air to the space below, use \"lanterns (roof appendages).\" To refer specifically to onion-shaped domes of any size, use \"onion domes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupolas"@en .

aat:300002232 a skos:Concept ;
    skos:definition "Structures projecting from a sloping roof usually housing a window or ventilating louver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dormers"@en .

aat:300002240 a skos:Concept ;
    skos:definition "Small, unglazed dormer windows used to provide light and ventilation in an attic or space below a sloping roof; especially used in Medieval buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiens-assis"@en .

aat:300002244 a skos:Concept ;
    skos:definition "Low dormers in a roof over which the roof is carried in a continuous curve. Low dormers in a roof over which the roof is carried in a continuous curve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyebrow dormers"@en .

aat:300002247 a skos:Concept ;
    skos:definition "Dormers with a roof terminating in a gable. Dormers with a roof terminating in a gable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable dormers"@en .

aat:300002248 a skos:Concept ;
    skos:definition "Gabled dormers in which the gable is treated as a pediment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedimented dormers"@en .

aat:300002249 a skos:Concept ;
    skos:definition "Dormers with hip roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hipped dormers"@en .

aat:300002252 a skos:Concept ;
    skos:definition "Dormers whose eaves lines are parallel to the eaves lines of the main roof instead of being gabled; provide more attic space than gabled dormers. Dormers whose eaves lines are parallel to the eaves lines of the main roof instead of being gabled; provide more attic space than gabled dormers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shed dormers"@en .

aat:300002266 a skos:Concept ;
    skos:definition "Enlargements at the top of downspouts to receive large volumes of rainwater from gutters or roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leader heads"@en .

aat:300002268 a skos:Concept ;
    skos:definition "Refers to the horizontal portions of a sloping roof that project beyond the walls. For portions of the roof projecting beyond the gable, use \"verges.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eaves"@en .

aat:300002271 a skos:Concept ;
    skos:definition "Eaves in which the supporting members are enclosed and therefore not visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed eaves"@en .

aat:300002273 a skos:Concept ;
    skos:definition "Eaves with visible supporting members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open eaves"@en .

aat:300002275 a skos:Concept ;
    skos:definition "Parts or components of eaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eave components"@en .

aat:300002276 a skos:Concept ;
    skos:definition "Wedge-shaped boards placed at the lower edges of sloping roofs to raise slightly the lowest course of tiles or slate in order to give that course the same pitch as the courses above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eaves boards"@en .

aat:300002278 a skos:Concept ;
    skos:definition "Boards that are nailed across the ends of roof rafters, sometimes supporting a gutter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fascia boards"@en .

aat:300002280 a skos:Concept ;
    skos:definition "Ornaments which terminate the point of a spire, pinnacle, or other vertical member; found on furniture as well as architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finials"@en .

aat:300002287 a skos:Concept ;
    skos:definition "Rounded finials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pommels"@en .

aat:300002290 a skos:Concept ;
    skos:definition "Thin, impervious material placed in construction to prevent water penetration and/or provide water drainage; generally located between a roof and a wall and over exterior door openings and windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flashing"@en .

aat:300002291 a skos:Concept ;
    skos:definition "Watertight membranes, along roofs or other flat surfaces, that turn up against and cover the intersection with vertical surfaces, such as chimneys or parapets; the exposed upper edge is normally covered by counterflashing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base flashing"@en .

aat:300002292 a skos:Concept ;
    skos:definition "Strips of sheet metal, often built into masonry and turned down over other flashing; used to prevent water from entering the joints and exposed upturned edges of base flashing on a roof. Strips of sheet metal, often built into masonry and turned down over other flashing; used to prevent water from entering the joints and exposed upturned edges of base flashing on a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterflashing"@en .

aat:300002295 a skos:Concept ;
    skos:definition "Metal flashing used at the intersection of a wall and a sloping roof; the upper edge steps up to follow the general inclination of the roof. Metal flashing used at the intersection of a wall and a sloping roof; the upper edge steps up to follow the general inclination of the roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepped flashing"@en .

aat:300002296 a skos:Concept ;
    skos:definition "Vertical triangular portions of the ends of buildings having double-sloping roofs. Includes similar ends which are not triangular in shape, as of a gambrel roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gables"@en .

aat:300002298 a skos:Concept ;
    skos:definition "Gables set parallel to the roof ridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross gables"@en .

aat:300002299 a skos:Concept ;
    skos:definition "Small ornamental gables, usually not roof gables but rather a decoration over a buttress or opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gablets"@en .

aat:300002300 a skos:Concept ;
    skos:definition "Gables each side of which is multicurved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaped gables"@en .

aat:300002309 a skos:Concept ;
    skos:definition "Parts or components of gables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable components"@en .

aat:300002310 a skos:Concept ;
    skos:definition "Stones which form the sloping edge of a gable built of masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barge stones"@en .

aat:300002311 a skos:Concept ;
    skos:definition "Boards that hang from the projecting end of a roof, covering the gables; often elaborately carved and ornamented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bargeboards"@en .

aat:300002314 a skos:Concept ;
    skos:definition "End walls having a gable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable ends"@en .

aat:300002319 a skos:Concept ;
    skos:definition "The component projections of corbie gables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corbiesteps"@en .

aat:300002321 a skos:Concept ;
    skos:definition "Short posts located at the peak of a gable into which the bargeboards are fixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable posts"@en .

aat:300002323 a skos:Concept ;
    skos:definition "Shaped building stones, with a flat bottom and sloping top, cut to conform to and support the copings of gables; for the more general meaning of blocks of stone placed in masonry walls to distribute the loads of beams, use \"padstones.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kneelers"@en .

aat:300002330 a skos:Concept ;
    skos:definition "Waterspouts carved into grotesque figures and projecting from the roof gutters of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gargoyles"@en .

aat:300002332 a skos:Concept ;
    skos:definition "V-shaped gutters usually of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arris gutters"@en .

aat:300002334 a skos:Concept ;
    skos:definition "Cresting occurring above the eaves or cornices of buildings, or for ornamental gutters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheneaux"@en .

aat:300002339 a skos:Concept ;
    skos:definition "Exposed, open gutters in the valleys of roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valley gutters"@en .

aat:300002345 a skos:Concept ;
    skos:definition "Rounded strips of wood, tile, metal, or composition material used to cover and finish the hip of a roof. Rounded strips of wood, tile, metal, or composition material used to cover and finish the hip of a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hip rolls"@en .

aat:300002348 a skos:Concept ;
    skos:definition "Windowed superstructures crowning a roof or dome, and serving to give light or air to the space below; the term is also used to refer to such structures, whether or not they provide light. For small structures built on the ridges of roofs, common in American architecture, use \"cupolas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanterns"@en .

aat:300002351 a skos:Concept ;
    skos:definition "Subordinate vertical structures, generally more or less tapering, rising above the neighboring parts of a building, and that may support a spire. Usually in Gothic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinnacles"@en .

aat:300002352 a skos:Concept ;
    skos:definition "Intersections of the sloping sides of roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ridges"@en .

aat:300002357 a skos:Concept ;
    skos:definition "Devices used to prevent snow from sliding off a roof. Devices used to prevent snow from sliding off a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow guards"@en .

aat:300002360 a skos:Concept ;
    skos:definition "Tall structures that are at least roughly pyramidal, polygonal, or conical and that rise from towers or roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spires"@en .

aat:300002362 a skos:Concept ;
    skos:definition "Octagonal spires rising from a square tower without an intervening parapet, the four angles of the tower being covered by corner segments of a pyramid seeming to penetrate the tower."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broach spires"@en .

aat:300002363 a skos:Concept ;
    skos:definition "Slender spires rising from the ridge of a roof, most commonly from the roof intersection over the crossing of a church; use \"crossing towers\" for more substantial structures such as a lantern between spire and roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flèches"@en .

aat:300002364 a skos:Concept ;
    skos:definition "Thin spires rising from the center of a tower roof, well inside a parapet, protecting a pathway upon which scaffolding could be erected for repairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle spires"@en .

aat:300002368 a skos:Concept ;
    skos:definition "Small spires as those found on pinnacles or turrets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirelets"@en .

aat:300002370 a skos:Concept ;
    skos:definition "Internal angles in a roof formed by the meeting of two slopes. Internal angles in a roof formed by the meeting of two slopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valleys"@en .

aat:300002372 a skos:Concept ;
    skos:definition "Devices designed to replace stagnant air with pure air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ventilators"@en .

aat:300002376 a skos:Concept ;
    skos:definition "Refers to those portions of a roof that project beyond the gable, in effect the raking equivalent of eaves; see \"eaves\" for portions projecting beyond the walls, at the lower horizontal edges of roofs. Refers to those portions of a roof that project beyond the gable, in effect the raking equivalent of eaves; see \"eaves\" for portions projecting beyond the walls, at the lower horizontal edges of roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verges"@en .

aat:300002379 a skos:Concept ;
    skos:definition "Railed, unroofed platforms surmounting the roofs of American houses offering a view, especially of the sea; for rooftop outlooks that are enclosed, use \"belvederes\"; for rooftop structures that are usually ornamental, use \"cupolas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "widows' walks"@en .

aat:300002382 a skos:Concept ;
    skos:definition "Parts or components of roof frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roof frame components"@en .

aat:300002398 a skos:Concept ;
    skos:definition "Horizontal slabs or timbers resting on the tie beams of a roof, supporting the lower ends of common rafters directly above the wall; used in cantilevered hips to support loose timbers. Horizontal slabs or timbers resting on the tie beams of a roof, supporting the lower ends of common rafters directly above the wall; used in cantilevered hips to support loose timbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole plates"@en .

aat:300002399 a skos:Concept ;
    skos:definition "The horizontal timbers laid across the principal rafters and supporting the common rafters in a roof. Purlins differ from beams in roof construction in that purlins usually do not support any other members, instead supporting loads from the roof deck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purlins"@en .

aat:300002403 a skos:Concept ;
    skos:definition "Longitudinal members at the apexes of roofs that support the upper ends of the rafters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ridgeboards"@en .

aat:300002413 a skos:Concept ;
    skos:definition "Strips of wood or metal covering the ridge of a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle boards"@en .

aat:300002415 a skos:Concept ;
    skos:definition "In a truss, horizontal struts above the tie beam or above a line joining the feet of the rafters, commonly between the joists at mid-span. In a truss, horizontal struts above the tie beam or above a line joining the feet of the rafters, commonly between the joists at mid-span."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straining beams"@en .

aat:300002419 a skos:Concept ;
    skos:definition "Refers to the members that form the base of the roof truss and prevent the rafters from spreading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie beams"@en .

aat:300002424 a skos:Concept ;
    skos:definition "Parallel sloping members that support the roof covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rafters"@en .

aat:300002425 a skos:Concept ;
    skos:definition "Rafters which are at right angles to the eaves of a roof and extend from the plate to the ridgeboard. Rafters which are at right angles to the eaves of a roof and extend from the plate to the ridgeboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common rafters"@en .

aat:300002431 a skos:Concept ;
    skos:definition "Rafters placed at the juncture of the inclined planes forming hip roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hip rafters"@en .

aat:300002434 a skos:Concept ;
    skos:definition "Rafters that do not extend from the roof plates to the ridgeboards; employed in hip roofs to reach from roof plates to hip rafters. For rafters spanning between valley rafters and ridgeboards, use \"valley jacks.\" Rafters that do not extend from the roof plates to the ridgeboards; employed in hip roofs to reach from roof plates to hip rafters. For rafters spanning between valley rafters and ridgeboards, use \"valley jacks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jack rafters"@en .

aat:300002437 a skos:Concept ;
    skos:definition "Jack rafters that extend from a valley rafter to a ridgeboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valley jacks"@en .

aat:300002439 a skos:Concept ;
    skos:definition "Rafters, often ornamental, visible beneath a cornice. Rafters, often ornamental, visible beneath a cornice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "show rafters"@en .

aat:300002440 a skos:Concept ;
    skos:definition "Diagonal members of a roof truss which support the purlins on which rafters are laid. Diagonal members of a roof truss which support the purlins on which rafters are laid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "principal rafters"@en .

aat:300002446 a skos:Concept ;
    skos:definition "Rafters directly along the valley, at the intersection of two sloping planes of a roof. Rafters directly along the valley, at the intersection of two sloping planes of a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valley rafters"@en .

aat:300002450 a skos:Concept ;
    skos:definition "Vertical parts or components of roof frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical roof frame components"@en .

aat:300002451 a skos:Concept ;
    skos:definition "Any vertical members in a roof truss, especially a king post or a queen post. Any vertical members in a roof truss, especially a king post or a queen post."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown posts"@en .

aat:300002452 a skos:Concept ;
    skos:definition "Vertical members connecting the apex of a triangular truss, as in a roof, with the base. Vertical members connecting the apex of a triangular truss, as in a roof, with the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "king posts"@en .

aat:300002454 a skos:Concept ;
    skos:definition "In a truss, vertical posts between the queen post and the wall to supplement the support of the queen post."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "princess posts"@en .

aat:300002456 a skos:Concept ;
    skos:definition "Refers to pairs of vertical, or near vertical, symmetrically placed tie beams in a truss. Refers to pairs of vertical, or near vertical, symmetrically placed tie beams in a truss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queen posts"@en .

aat:300002459 a skos:Concept ;
    skos:definition "In decorative, open-timber roof trusses, short posts set against the wall, bearing at bottom on a stone corbel or capital and supporting, generally with the aid of a curved brace, the wall end of the tie beam, or hammer beam of the truss. In decorative, open-timber roof trusses, short posts set against the wall, bearing at bottom on a stone corbel or capital and supporting, generally with the aid of a curved brace, the wall end of the tie beam, or hammer beam of the truss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendant posts"@en .

aat:300002469 a skos:Concept ;
    skos:definition "Vertical architectural members used to define and divide spaces. In English, there is no distinctive term for an external wall and the internal sides of a room, but this is not universal. Many languages distinguish between the two. In German, some of this distinction can be seen between Wand and Mauer, in Spanish between 'pared' and 'muro' and Dutch 'wand' and 'muur.' These terms are all contained here, select among them according to the local context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walls"@en .

aat:300002472 a skos:Concept ;
    skos:definition "Walls that incline as they rise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battered walls"@en .

aat:300002474 a skos:Concept ;
    skos:definition "Walls whose whole surfaces are unbroken by windows, doors, or other openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blank walls"@en .

aat:300002485 a skos:Concept ;
    skos:definition "Use broadly for all sorts of walls constructed to resist attack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defensive walls"@en .

aat:300002487 a skos:Concept ;
    skos:definition "Defensive walls about breast high."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breastworks"@en .

aat:300002489 a skos:Concept ;
    skos:definition "The primary line of walled fortification around forts, castles, or towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enceintes"@en .

aat:300002493 a skos:Concept ;
    skos:definition "Parts or components of defensive walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defensive wall components"@en .

aat:300002495 a skos:Concept ;
    skos:definition "The projecting portions of the outer wall of a fortification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastions"@en .

aat:300002497 a skos:Concept ;
    skos:definition "Chambers, often vaulted, in ramparts, bastions, or other outer fortification elements with openings for the firing of artillery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casemates"@en .

aat:300002498 a skos:Concept ;
    skos:definition "Entrances into bastions or other outworks of fortifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorges"@en .

aat:300002501 a skos:Concept ;
    skos:definition "Fixed platforms on which artillery is mounted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batteries"@en .

aat:300002504 a skos:Concept ;
    skos:definition "Enclosing walls connecting bastions or towers in fortifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain walls"@en .

aat:300002505 a skos:Concept ;
    skos:definition "Earthen or masonry defensive walls of a fortified site, usually the circuit of inner walls and platforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramparts"@en .

aat:300002507 a skos:Concept ;
    skos:definition "Steps made on the ramparts of works near the parapets, for the troops to stand upon, in order to fire over the parapet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquettes"@en .

aat:300002508 a skos:Concept ;
    skos:definition "Refers to the top platforms or horizontal surfaces behind the parapets of ramparts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrepleins"@en .

aat:300002514 a skos:Concept ;
    skos:definition "Walls partly or entirely below grade that support the exterior parts of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundation walls"@en .

aat:300002515 a skos:Concept ;
    skos:definition "Refers to any short wall that supports floor joists. Refers to any short wall that supports floor joists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeper walls"@en .

aat:300002516 a skos:Concept ;
    skos:definition "Walls used jointly by two parties under easement agreement, erected upon a line dividing two parcels of land or between two dwelling units. Walls used jointly by two parties under easement agreement, erected upon a line dividing two parcels of land or between two dwelling units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "party walls"@en .

aat:300002521 a skos:Concept ;
    skos:definition "Walls used to resist pressure caused by rock or water, such as to separate land and water areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulkheads"@en .

aat:300002523 a skos:Concept ;
    skos:definition "Walls which are part of the building envelope, thereby having one face exposed to the weather or to earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior walls"@en .

aat:300002526 a skos:Concept ;
    skos:definition "Exterior surfaces or faces of a building that are substantially in one plane, particularly those perceived to be the principal or most architecturally ambitious ones, designed with special regard to their conspicuousness or association with an entrance and looks onto a street or open space. For the external areas of buildings, potentially including the facade and other features, but not necessarily restricted to surface features, use \"fronts (architectural).\" For the vertical arrangements of exterior or interior features, use \"elevations (building divisions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "façades"@en .

aat:300002528 a skos:Concept ;
    skos:definition "Refers to façades extending beyond, especially above, the dimensions of a building with the specific purpose of giving a more imposing appearance; for façades which exceed the height or width of buildings but not with that intention, use \"screen façades.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false fronts"@en .

aat:300002533 a skos:Concept ;
    skos:definition "Facades of stores or store buildings fronting a street and usually containing window display spaces. Facades of stores or store buildings fronting a street and usually containing window display spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storefronts"@en .

aat:300002535 a skos:Concept ;
    skos:definition "Walls having two interior faces and existing entirely within the exterior walls. Walls having two interior faces and existing entirely within the exterior walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior walls"@en .

aat:300002538 a skos:Concept ;
    skos:definition "Interior walls separating one portion of a space from another; sometimes permanent inside walls that divide buildings into various rooms, sometimes designed to move aside and open up a space. For entities other than walls that divide interior spaces, often incorporating bookshelves, cabinets, or drawers, use \"room dividers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partitions"@en .

aat:300002544 a skos:Concept ;
    skos:definition "Any partitions that can be withdrawn into a relatively compact position by folding, coiling, or stacking its component parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding partitions"@en .

aat:300002547 a skos:Concept ;
    skos:definition "Objects that serve to divide interior spaces, often incorporating bookshelves, cabinets, or drawers. For interior, sometimes permanent, walls that separate one portion of a building from another, use \"partitions.\" Objects that serve to divide interior spaces, often incorporating bookshelves, cabinets, or drawers. For interior, sometimes permanent, walls that separate one portion of a building from another, use \"partitions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "room dividers"@en .

aat:300002551 a skos:Concept ;
    skos:definition "Walls to which battens have been affixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battened walls"@en .

aat:300002556 a skos:Concept ;
    skos:definition "Combination walls in which the masonry facing and the backing are so bonded as to exert a common reaction under load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faced walls"@en .

aat:300002557 a skos:Concept ;
    skos:definition "Walls that support a vertical load in addition to their own weight. Walls that support a vertical load in addition to their own weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bearing walls"@en .

aat:300002559 a skos:Concept ;
    skos:definition "Walls, usually of masonry, and usually exterior, consisting of two wythes separated by a continuous air space, the wythes held together by metal stays or wires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavity walls"@en .

aat:300002562 a skos:Concept ;
    skos:definition "Walls which support no vertical load except that of their own weight. Walls which support no vertical load except that of their own weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonbearing walls"@en .

aat:300002563 a skos:Concept ;
    skos:definition "Nonbearing walls supported by the members of a rigid frame structure, such as a reinforced concrete or steel frame, and therefore serving to enclose but not to support. Nonbearing walls supported by the members of a rigid frame structure, such as a reinforced concrete or steel frame, and therefore serving to enclose but not to support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain walls"@en .

aat:300002566 a skos:Concept ;
    skos:definition "Masonry walls in which material has been removed without jeopardizing structural integrity, either for decorative or structural reasons. Masonry walls in which material has been removed without jeopardizing structural integrity, either for decorative or structural reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pierced walls"@en .

aat:300002570 a skos:Concept ;
    skos:definition "Rigid planar surfaces that inherently resist lateral thrusts of shear. Rigid planar surfaces that inherently resist lateral thrusts of shear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shear walls"@en .

aat:300002571 a skos:Concept ;
    skos:definition "Walls with a masonry face or revetment that is attached, but not bonded, to the body of the wall and does not exert a common reaction under load. Walls with a masonry face or revetment that is attached, but not bonded, to the body of the wall and does not exert a common reaction under load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneered walls"@en .

aat:300002572 a skos:Concept ;
    skos:definition "Curtain walls assembled from highly similar components, each combining two or more of the traditionally separate elements of windows, external finish wall, internal finish wall, and insulation. Curtain walls assembled from highly similar components, each combining two or more of the traditionally separate elements of windows, external finish wall, internal finish wall, and insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall systems"@en .

aat:300002573 a skos:Concept ;
    skos:definition "Parts or components of walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall components"@en .

aat:300002574 a skos:Concept ;
    skos:definition "Niches or small shrines, often intended for sculpture, or for frameworks around doors or windows formed of columns, corbeling, or pilasters, supporting a pediment or canopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aedicules"@en .

aat:300002580 a skos:Concept ;
    skos:definition "Series of arches on the same plane and carried on piers, columns, or pilasters; either free-standing or attached to a wall (a \"blind arcade\"). The term is also used to denote a covered avenue with shops on one or both sides, which originally was set within an architectural arcade. Series of arches on the same plane and carried on piers, columns, or pilasters; either free-standing or attached to a wall (a \"blind arcade\"). The term is also used to denote a covered avenue with shops on one or both sides, which originally was set within an architectural arcade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcades"@en .

aat:300002582 a skos:Concept ;
    skos:definition "Arcades closed at the back and serving only as decorative features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind arcades"@en .

aat:300002586 a skos:Concept ;
    skos:definition "Arcades in which arches overlap and cross one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interlacing arcades"@en .

aat:300002588 a skos:Concept ;
    skos:definition "Railed platforms projecting from the exterior walls of buildings. Use also for similar interior features, when small. For larger platforms which extend the length of one side of a room or are recessed behind an arcade, use \"galleries (upper level spaces).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balconies"@en .

aat:300002589 a skos:Concept ;
    skos:definition "Very small balconies, usually not large enough to stand on and consisting of little more than a protective railing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balconets"@en .

aat:300002595 a skos:Concept ;
    skos:definition "Fortified parapets with alternate solid parts and openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battlements"@en .

aat:300002597 a skos:Concept ;
    skos:definition "The open spaces between two merlons or solid portions of battlements or castellated parapets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embrasures"@en .

aat:300002601 a skos:Concept ;
    skos:definition "The solid portions in a battlement, which alternate with the embrasures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merlons"@en .

aat:300002602 a skos:Concept ;
    skos:definition "Projecting courses of masonry at the foot of an interior wall, or around a column; generally wide enough to form a seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench tables"@en .

aat:300002605 a skos:Concept ;
    skos:definition "Bondstone which extends completely through the entire thickness of a masonry wall and is exposed on both wall faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perpend"@en .

aat:300002611 a skos:Concept ;
    skos:definition "Corners of a building decorated with a projecting masonry course, a pilaster, or similar feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantons"@en .

aat:300002612 a skos:Concept ;
    skos:definition "Type of wall decorations consisting of vertical bands of rusticated masonry which divide the surface into panels or bays; common in 17th-century French domestic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaînes"@en .

aat:300002613 a skos:Concept ;
    skos:definition "Rows of columns supporting an entablature and often one side of a roof. Includes spaces behind such a feature when they are long and used for circulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonnades"@en .

aat:300002615 a skos:Concept ;
    skos:definition "Boards which are used as trim on the external corner of a wood frame structure and against which the ends of the siding are fitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner boards"@en .

aat:300002616 a skos:Concept ;
    skos:definition "Stones forming part of corners or angles in walls, especially when lying at the foundation of a principal angle. These may also incorporate the date of or inscription about the structure's construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornerstones"@en .

aat:300002620 a skos:Concept ;
    skos:definition "Layers of masonry units running horizontally in a wall or, much less commonly, curved over an arch. Layers of masonry units running horizontally in a wall or, much less commonly, curved over an arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courses"@en .

aat:300002621 a skos:Concept ;
    skos:definition "Courses of bondstones that affix the facing masonry to the backing masonry. Courses of bondstones that affix the facing masonry to the backing masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bond courses"@en .

aat:300002626 a skos:Concept ;
    skos:definition "May designate projecting masonry courses supported by a range of corbels, or ranges of corbels supporting cornices or other projecting courses, or ensembles of corbels and projecting courses; found especially in Medieval architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corbel tables"@en .

aat:300002632 a skos:Concept ;
    skos:definition "Material used in masonry walls, comprising an impervious horizontal layer used to prevent upward capillary movement or downward seepage of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damp course"@en .

aat:300002633 a skos:Concept ;
    skos:definition "Courses of stone projecting beyond the face of a wall to guide water away from the face of the wall. Courses of stone projecting beyond the face of a wall to guide water away from the face of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water tables"@en .

aat:300002635 a skos:Concept ;
    skos:definition "In stone masonry, courses set at the level of a lintel, commonly differentiated from the wall by their greater projection, finish, or thickness which often match that of the lintel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lintel courses"@en .

aat:300002636 a skos:Concept ;
    skos:definition "Masonry courses which form a continuous plinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plinth courses"@en .

aat:300002637 a skos:Concept ;
    skos:definition "Horizontal bands of masonry, generally narrower than other courses, extending across the face of a wall and in some instances continuing across piers or engaged columns; may be flush or projecting and may be flat surfaced, molded, or otherwise shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stringcourses"@en .

aat:300002641 a skos:Concept ;
    skos:definition "Stringcourses of bricks laid diagonally so that one corner projects from the face of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogtooth courses"@en .

aat:300002644 a skos:Concept ;
    skos:definition "Stringcourses, usually molded; especially those carried along the lower portion of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ledgement tables"@en .

aat:300002646 a skos:Concept ;
    skos:definition "In stone masonry, stringcourses set at window sill level; commonly differentiated from the wall by their greater projection, their finish, or their thickness. In stone masonry, stringcourses set at window sill level; commonly differentiated from the wall by their greater projection, their finish, or their thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sill courses"@en .

aat:300002651 a skos:Concept ;
    skos:definition "Use to designate the exterior walled portions of buildings, above the uppermost cornice, whether fenestrated or not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attics"@en .

aat:300002654 a skos:Concept ;
    skos:definition "Refers to repeated, similar divisions or compartments of a building or part of a building, as defined by recurring architectural features, such as arches, vaults, openings, or pilasters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bays"@en .

aat:300002655 a skos:Concept ;
    skos:definition "Upper zones of walls rising above adjacent roofs and pierced by windows so as to admit light to a high central room or space flanked by lower rooms or spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clerestories"@en .

aat:300002658 a skos:Concept ;
    skos:definition "Central portions of a building as opposed to the terminal or end pavilions or other outlying portions, especially found in French architecture or in buildings closely derived from French architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corps de logis"@en .

aat:300002659 a skos:Concept ;
    skos:definition "Refers to the central portions or features of entrance facades, given emphasis by a more elaborate architectural treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontispieces"@en .

aat:300002660 a skos:Concept ;
    skos:definition "Projecting subdivisions of a building, especially as corner, central, or terminal features, and given emphasis in comparison with the rest of the façade, such as through additional height or more elaborate decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavilions"@en .

aat:300002665 a skos:Concept ;
    skos:definition "Surfaces adjacent to an arch above its springing; also by extension the walls above or below window openings in modern curtain wall construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spandrels"@en .

aat:300002674 a skos:Concept ;
    skos:definition "Low-ceilinged spaces between two stories with higher ceilings, or for balconylike stories over a part of the story below, the lower story usually, but not necessarily, being the first story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezzanines"@en .

aat:300002675 a skos:Concept ;
    skos:definition "Use to designate second or sometimes third stories given greater apparent height or prominence on the exterior and a higher ceiling within, and containing the principal rooms of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piani nobili"@en .

aat:300002678 a skos:Concept ;
    skos:definition "Stories in basilican church interiors that correspond to the level between the vaulting and the aisle roof, or the vaulting of the tribune and the tribune roof; may or may not contain a small passage. Distinct from \"tribunes (stories),\" which always have substantial passages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triforiums"@en .

aat:300002680 a skos:Concept ;
    skos:definition "Parts or components of interior walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior wall components"@en .

aat:300002681 a skos:Concept ;
    skos:definition "Flat or molded projections from interior walls or partitions at the floor, covering the joint between the floor and the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baseboards"@en .

aat:300002684 a skos:Concept ;
    skos:definition "Horizontal strips, usually of wood, affixed to walls at a height which prevents the backs of chairs from damaging the wall surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair rails"@en .

aat:300002685 a skos:Concept ;
    skos:definition "Concave surfaces located at the junction of a wall and ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coving"@en .

aat:300002687 a skos:Concept ;
    skos:definition "Horizontal strips affixed to walls at or near the ceiling for supporting picture hooks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture rails"@en .

aat:300002689 a skos:Concept ;
    skos:definition "Narrow shelves or rails located along the upper part of the walls of a room and constucted with a groove to hold plates or decorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate rails"@en .

aat:300002691 a skos:Concept ;
    skos:definition "Refers to panels of oak or other wood that is used to line the walls of a room. It often refers specifically to the decorative or protective facings applied to the lower portion of an interior partition or wall, whether of wood or another material. The term originally referred to a superior quality of oak from Russia, Germany, and Holland, that was used primarily for fine panel-work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wainscoting"@en .

aat:300002695 a skos:Concept ;
    skos:definition "Projecting series of corbels often surmounting the walls of later Medieval fortifications and carrying an overhanging portion of the stone floor of the rampart; also, the openings in the floor between the corbels for the delivery of missiles on the enemy below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machicolations"@en .

aat:300002696 a skos:Concept ;
    skos:definition "In Islamic architecture, windows filled with screens or grilles of turned wood. For lattices or screens of perforated stone, in Islamic architecture, especially of Mughal India, use \"jali.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meshrebeeyehs"@en .

aat:300002703 a skos:Concept ;
    skos:definition "In Islamic architecture, windows projecting from an upper story and, when opening onto public spaces, enclosed by privacy screens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rawashin"@en .

aat:300002704 a skos:Concept ;
    skos:definition "Use generally for recesses in walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niches"@en .

aat:300002712 a skos:Concept ;
    skos:definition "Large stone slabs set vertically as revetments at the lower part of walls. Large stone slabs set vertically as revetments at the lower part of walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthostats"@en .

aat:300002713 a skos:Concept ;
    skos:definition "Projections of roofs or upper stories beyond a story immediately below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overhangs"@en .

aat:300002716 a skos:Concept ;
    skos:definition "Refers to blocks of stone placed in masonry walls under girders or other beams or trusses in order to distribute the load; for shaped stones placed on sloping walls to support the copings of gables, use \"kneelers (gable components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padstones"@en .

aat:300002717 a skos:Concept ;
    skos:definition "Low walls, placed at the edge of platforms, balconies, terraces, bridges, quays, or roofs, or surmounting the cornices of a building; examples include the low walls forming the uppermost part of defensive walls or ramparts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parapets"@en .

aat:300002724 a skos:Concept ;
    skos:definition "Those parts of the flanking walls of the cella of a temple that project beyond its front or rear, often terminating in antae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parastades"@en .

aat:300002726 a skos:Concept ;
    skos:definition "Triangular gable walls above the horizontal cornice of a classically treated building; also, triangular or roughly triangular elements, sometimes curved, or broken at the center, surmounting porticoes or openings. Common also on furniture, including as bonnet tops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pediments"@en .

aat:300002732 a skos:Concept ;
    skos:definition "Pediments whose lines are interrupted either at the apex or the base, or in both locations; found especially on Late Antique, Baroque, and Mannerist architecture, and on Chippendale furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broken pediments"@en .

aat:300002736 a skos:Concept ;
    skos:definition "Semi-circular or triangular recessed spaces within a pediment comprising stone or masonry enclosed by an arch, usually supported by a lintel. Tympana are normally set above doors, but also occur in windows and wall arcades. They may be ornamented with sculptural or painted decoration. The term more commonly refers to the Medieval-era arch areas over a doorway decorated with Christian iconography, rather than the ancient Roman or Greek examples from which they evolved, which are most often triangular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tympana"@en .

aat:300002737 a skos:Concept ;
    skos:definition "Shallow piers or rectangular columns projecting only slightly from a wall and, in classical architecture, conforming with one of the orders. Common also on furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilasters"@en .

aat:300002744 a skos:Concept ;
    skos:definition "Engaged piers, of only slight projection, without a capital and base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilaster strips"@en .

aat:300002747 a skos:Concept ;
    skos:definition "Lines of pilasters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilastrades"@en .

aat:300002748 a skos:Concept ;
    skos:definition "Stones used to form the corner of a wall of masonry, especially when accentuated by a difference in the surface treatment from that of the rest of the wall mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quoins"@en .

aat:300002757 a skos:Concept ;
    skos:definition "Setbacks in the face of a wall or in an earthen embankment; also, footings or ledges formed by the setting back of a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarcements"@en .

aat:300002765 a skos:Concept ;
    skos:definition "Generally denotes apertures or breaks in the surface of a wall or other architectural element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "openings"@en .

aat:300002767 a skos:Concept ;
    skos:definition "Denotes openings, which contain or could contain a door, that provide access into or out of building spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorways"@en .

aat:300002771 a skos:Concept ;
    skos:definition "Refers to openings under arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archways"@en .

aat:300002776 a skos:Concept ;
    skos:definition "Refers to points or places of entering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrances"@en .

aat:300002779 a skos:Concept ;
    skos:definition "Openings used solely to leave a building, room, or other enclosed area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exits"@en .

aat:300002781 a skos:Concept ;
    skos:definition "Doors, windows, hatches, or other openings leading to the outside, usually kept closed and locked, and used chiefly for emergencies when conventional exits fail or become inaccessible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency exits"@en .

aat:300002784 a skos:Concept ;
    skos:definition "Parts or components of doorways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorway components"@en .

aat:300002785 a skos:Concept ;
    skos:definition "Assemblies built into a wall, consisting of two upright members (doorjambs) and a horizontal member (doorhead) and providing support on which to hang the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorframes"@en .

aat:300002791 a skos:Concept ;
    skos:definition "Parts or components of doorframes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorframe components"@en .

aat:300002792 a skos:Concept ;
    skos:definition "Uppermost, horizontal members of a doorframe; also horizontal projections above a door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door heads"@en .

aat:300002798 a skos:Concept ;
    skos:definition "Designates the lower sides and bottom of doorways; for strips fastened to the floor beneath doors to cover joints or provide weather protection, use \"thresholds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorsills"@en .

aat:300002799 a skos:Concept ;
    skos:definition "Stepstones at the threshold of a door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorstones"@en .

aat:300002800 a skos:Concept ;
    skos:definition "Strips fastened to the floor beneath a door, usually required to cover the joint when two types of floor material meet; may provide weather protection on external doors; for the lower sides and bottom of doorways, use \"doorsills.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thresholds"@en .

aat:300002803 a skos:Concept ;
    skos:definition "Barriers that swing, slide, tilt, or fold to close a doorway, usually of solid and finished construction and usually leading to or separating interior spaces. Use also for similar features that close a container or a piece of case furniture. For barriers of less solid or finished construction, and usually separating two exterior spaces, use \"gates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doors"@en .

aat:300002806 a skos:Concept ;
    skos:definition "Two single doors or door leaves hung in the same frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double doors"@en .

aat:300002811 a skos:Concept ;
    skos:definition "Doors consisting of two separate leaves, one above the other; the leaves may operate independently or together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch doors"@en .

aat:300002813 a skos:Concept ;
    skos:definition "Floor-length wall openings consisting entirely or mostly of glass panels and hinged on one side so they may function as either doors or windows. For pairs of tall casement windows, use \"French windows.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French doors"@en .

aat:300002819 a skos:Concept ;
    skos:definition "Doors, usually small, opening through a finished construction, as into a duct or wall, and used to provide a means of inspection of equipment or services housed behind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "access doors"@en .

aat:300002820 a skos:Concept ;
    skos:definition "Elements imitating doors, but not meant to pass through, inserted to complete a series of doors or to deceive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false doors"@en .

aat:300002823 a skos:Concept ;
    skos:definition "Fire-resistant door assemblies, which are capable of providing a specified degree of fire protection when closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire doors"@en .

aat:300002825 a skos:Concept ;
    skos:definition "Relatively small openings in a wall or floor. Examples include openings in horizontal positions on decks of a ship and openings in a half-door or wall in a kitchen, thorugh which articles may be passed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatches"@en .

aat:300002833 a skos:Concept ;
    skos:definition "Doors fitted to the outside of the frame of an exterior door to provide additional protection against cold and wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm doors"@en .

aat:300002835 a skos:Concept ;
    skos:definition "Doors fitted to an opening in a horizontal or nearly horizontal surface, as a floor or roof, through which a person ascends head first and descends feet first."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trap doors"@en .

aat:300002838 a skos:Concept ;
    skos:definition "Streams of high-velocity, temperature-controlled air which are directed downward across an opening to prevent transfer of heat across it, thus making it possible to air condition a space having an open entrance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air curtains"@en .

aat:300002840 a skos:Concept ;
    skos:definition "Doors of two or more hinged leaves which open by bringing the leaves into parallel positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding doors"@en .

aat:300002844 a skos:Concept ;
    skos:definition "Doors that are attached, usually on one side or the top, by metal hinges, allowing the door to pivot open. The hinges typically allow the door to open away from the doorway in one direction but not in the other on a vertical or horizontal axis of rotation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinged doors"@en .

aat:300002845 a skos:Concept ;
    skos:definition "Doors that are flush with and treated in the same manner as the surrounding wall so as to be concealed and have no visible hardware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jib doors"@en .

aat:300002848 a skos:Concept ;
    skos:definition "Power-operated doors that open and close at the approach of a person or vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automatic doors"@en .

aat:300002851 a skos:Concept ;
    skos:definition "Doors hung on pivots, either center pivots or offset, as distinguished from one hung on hinges or having a sliding mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pivoted doors"@en .

aat:300002853 a skos:Concept ;
    skos:definition "Manual or automatic doors made up of small horizontal interlocking metal slats which are guided in a track."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll-up doors"@en .

aat:300002855 a skos:Concept ;
    skos:definition "Doors that open by sliding sideways along a track rather than outward using with hinges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding doors"@en .

aat:300002857 a skos:Concept ;
    skos:definition "Doors equipped with hardware which enable them to swing 90 degrees in either direction from the plane of their frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swinging doors"@en .

aat:300002861 a skos:Concept ;
    skos:definition "Doors that are designed to allow the entry of vehicles into garages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garage doors"@en .

aat:300002873 a skos:Concept ;
    skos:definition "Smooth surfaced doors having faces which are plane and which conceal their rails and stiles or other structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush doors"@en .

aat:300002875 a skos:Concept ;
    skos:definition "Flush doors with a space between the facings that is occupied by a structure of air- or insulation-filled cells, made of wood, plastic, or other suitable material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow-core doors"@en .

aat:300002876 a skos:Concept ;
    skos:definition "Doors containing a louver or louvers, usually with horizontal blades providing for the passage of air while the door is closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louver doors"@en .

aat:300002880 a skos:Concept ;
    skos:definition "Doors having stiles, rails, and sometimes muntins that form one or more frames around thinner, recessed or carved panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel doors"@en .

aat:300002889 a skos:Concept ;
    skos:definition "Lightweight exterior doors with small mesh screening in place of the panels, which permits ventilation, but bars insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen doors"@en .

aat:300002891 a skos:Concept ;
    skos:definition "Flush doors having cores of solid wood or mineral composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid-core doors"@en .

aat:300002892 a skos:Concept ;
    skos:definition "Parts or components of doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door components"@en .

aat:300002904 a skos:Concept ;
    skos:definition "Stiles on doors to which the door hinges are attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging stiles"@en .

aat:300002907 a skos:Concept ;
    skos:definition "The vertical pieces of a door to which the lock is fastened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lock stiles"@en .

aat:300002911 a skos:Concept ;
    skos:definition "Decorative members over a doorway or doorframe, such as pictures or carved panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overdoors"@en .

aat:300002914 a skos:Concept ;
    skos:definition "Refers to the central uprights placed in the center of large doorways to support the lintel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trumeaux"@en .

aat:300002916 a skos:Concept ;
    skos:definition "Barriers, often swinging or sliding, used to fill or close a gateway between two spaces or placed within a wall or fencing, often exterior and often made of a grating or open framework or forming a heavy or rough structure. For barriers of more solid and finished construction and usually leading to interior spaces, use \"doors.\" For more substantial structures, whether or not they include an actual barrier, see various types of \"gate structures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gates"@en .

aat:300002919 a skos:Concept ;
    skos:definition "Roofed gateways at the entrances to churches or cemeteries where a coffin may be placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lich gates"@en .

aat:300002921 a skos:Concept ;
    skos:definition "Defensive gratings, of massive iron or timber, movable vertically in retaining grooves cut in the jambs of fortified gateways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portcullises"@en .

aat:300002924 a skos:Concept ;
    skos:definition "Large gates or passages generally linking the inner and outer works of fortresses and suitable for the use of troops making a sortie."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sally ports"@en .

aat:300002932 a skos:Concept ;
    skos:definition "Secondary, and often inconspicuous back doors or gates, especially to fortified or walled enclosures; may also be used for minor, private or side entrances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posterns"@en .

aat:300002935 a skos:Concept ;
    skos:definition "Parts or components of gates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gate components"@en .

aat:300002936 a skos:Concept ;
    skos:definition "Posts on which gates are hung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging posts"@en .

aat:300002942 a skos:Concept ;
    skos:definition "Posts at the side of a gate against which the gate shuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutting posts"@en .

aat:300002943 a skos:Concept ;
    skos:definition "Openings serving as outlets for air, smoke, or fumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vents"@en .

aat:300002944 a skos:Concept ;
    skos:definition "Openings in the wall of a building, serving to admit light, usually to permit vision, and often to admit air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "windows"@en .

aat:300002947 a skos:Concept ;
    skos:definition "Beveled openings in a wall or in a roof that admit light from above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abat-jours"@en .

aat:300002951 a skos:Concept ;
    skos:definition "Windows that have one or more top-hinged, out-swinging sashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awning windows"@en .

aat:300002952 a skos:Concept ;
    skos:definition "Windows, either single or in a series, forming a bay or recess in a room and projecting outward from the wall in a rectangular, curved, or polygonal form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bay windows"@en .

aat:300002954 a skos:Concept ;
    skos:definition "Bay windows projecting from an upper floor and not extending to the ground; usually supported by brackets or corbels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oriel windows"@en .

aat:300002959 a skos:Concept ;
    skos:definition "Windows occupying the full width of a bay and divided into a large fixed sash flanked by a narrow movable sash on each side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chicago windows"@en .

aat:300002961 a skos:Concept ;
    skos:definition "Bay windows that are curved in plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow windows"@en .

aat:300002967 a skos:Concept ;
    skos:definition "Windows equipped with removable or interchangeable screen and glass sections that make them suitable for either summer or winter use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination windows"@en .

aat:300002970 a skos:Concept ;
    skos:definition "Any windows used or designed for the display of goods or advertising material, whether fully or partly enclosed or entirely open at the rear; may have a platform raised above street level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "show-windows"@en .

aat:300002971 a skos:Concept ;
    skos:definition "Show-windows that project outward from the principal plane of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet windows"@en .

aat:300002972 a skos:Concept ;
    skos:definition "Two windows, one outside the other, as storm windows, used to provide improved thermal and noise insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double windows"@en .

aat:300002976 a skos:Concept ;
    skos:definition "Representations of windows inserted to complete a series of windows, or to give the appearance of symmetry to a facade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind windows"@en .

aat:300002983 a skos:Concept ;
    skos:definition "Semicircular windows over doors or other openings with radiating bars giving the appearance of an open fan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanlights"@en .

aat:300002990 a skos:Concept ;
    skos:definition "Window openings closed with cloth or translucent paper instead of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fenestrals"@en .

aat:300002991 a skos:Concept ;
    skos:definition "Windows or portions of window units that are designed not to open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed windows"@en .

aat:300002995 a skos:Concept ;
    skos:definition "Windows externally located in a wide band of trim just beneath cornices; found on Greek Revival houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frieze-band windows"@en .

aat:300002997 a skos:Concept ;
    skos:definition "Windows that swing on hinges, fixed to the sides, top, or bottom of the frame; the sash can open inward or outward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinged windows"@en .

aat:300002998 a skos:Concept ;
    skos:definition "Windows having a sash that opens on hinges attached to the upright side of the frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casement windows"@en .

aat:300003002 a skos:Concept ;
    skos:definition "Windows with sashes that open inward on hinges placed at the bottom of each sash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hopper windows"@en .

aat:300003006 a skos:Concept ;
    skos:definition "Windows consisting of a series of horizontal glass louvers that pivot simultaneously in a common frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jalousie windows"@en .

aat:300003009 a skos:Concept ;
    skos:definition "Window casements, fixed or hinged, with mullions set diagonally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lattice windows"@en .

aat:300003014 a skos:Concept ;
    skos:definition "Glazed panels, usually set flush with the ceiling, serving to admit light to the room below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laylights"@en .

aat:300003018 a skos:Concept ;
    skos:definition "Small openings (as in walls or parapets), often with deeply splayed jambs, through which small arms may be discharged; for similar openings to admit light and air or to permit observation, use \"loop windows.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loopholes"@en .

aat:300003025 a skos:Concept ;
    skos:definition "Vertical slitlike windows; often found in Medieval structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loop windows"@en .

aat:300003026 a skos:Concept ;
    skos:definition "Windows having a louver or louvers which fill all or part of the opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louver windows"@en .

aat:300003028 a skos:Concept ;
    skos:definition "Exterior window shutters having horizontal slats or louvers fixed at an angle so as to admit light but exclude sun and rain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "persiennes"@en .

aat:300003029 a skos:Concept ;
    skos:definition "Windows, usually very small, set much below the level of the larger windows, especially in English churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lowside windows"@en .

aat:300003034 a skos:Concept ;
    skos:definition "Crescent-shaped or semicircular areas on a wall or vaulted ceiling, framed by an arch or vault; includes openings or windows in such areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunettes"@en .

aat:300003036 a skos:Concept ;
    skos:definition "Holes or crevices (as in a furnace, oven, or door) through which one may look."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peepholes"@en .

aat:300003039 a skos:Concept ;
    skos:definition "Outsize windows placed to frame or as if to frame a desirable exterior view; it may be placed between two narrower windows, typically in a living room or other such room in a home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture windows"@en .

aat:300003040 a skos:Concept ;
    skos:definition "Windows whose sash rotates about fixed vertical or horizontal pivots, located at or toward the center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pivoted windows"@en .

aat:300003054 a skos:Concept ;
    skos:definition "Circular windows containing patterned tracery, particularly stained glass windows that are divided into compartments by mullions radiating from a center, or filled with tracery suggestive of the form of a rose or wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose windows"@en .

aat:300003062 a skos:Concept ;
    skos:definition "Openings in a roof, glazed or filled with other transparent or translucent material, serving to admit light to a space below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skylights"@en .

aat:300003064 a skos:Concept ;
    skos:definition "Raised skylights or small lanterns with the sides mostly glazed, erected on a roof to admit light to the space below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lantern lights"@en .

aat:300003066 a skos:Concept ;
    skos:definition "Raised central portions of roofs, along the ridge, having louvers or windows on the sides for ventilation or light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monitors"@en .

aat:300003067 a skos:Concept ;
    skos:definition "Windows that open by means of sashes sliding horizontally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding windows"@en .

aat:300003071 a skos:Concept ;
    skos:definition "Windows having two vertically sliding sashes, each closing a different part of the window; the weight of each sash is counter-balanced for ease of opening and closing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-hung windows"@en .

aat:300003072 a skos:Concept ;
    skos:definition "Windows having three vertically sliding sashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triple-hung windows"@en .

aat:300003074 a skos:Concept ;
    skos:definition "Small openings, often obliquely cut, in the wall of a church, generally so placed as to afford a view of the high altar from the transept or aisles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squints"@en .

aat:300003077 a skos:Concept ;
    skos:definition "Exterior windows placed over existing windows to provide additional protection against the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm windows"@en .

aat:300003080 a skos:Concept ;
    skos:definition "The openings above transoms when fitted as windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transom windows"@en .

aat:300003081 a skos:Concept ;
    skos:definition "Windows having primary divisions into three parts, usually reserved for windows divided vertically. Group of three small windows next to each other, separated from one another by small columns or posts. Also 'triplet windows'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripartite windows"@en .

aat:300003082 a skos:Concept ;
    skos:definition "Semicircular windows divided by two upright mullions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diocletian windows"@en .

aat:300003084 a skos:Concept ;
    skos:definition "Windows of large size, characteristic of Renaissance and later classicizing styles, divided by columns or piers resembling pilasters into three lights, the middle one of which is usually wider than the others and is often arched. Named for Veneto architect Andrea Palladio, or in reference to Sebastiano Serlio, who wrote an architectural treatise describing arches of ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palladian windows"@en .

aat:300003087 a skos:Concept ;
    skos:definition "Parts or components of windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window components"@en .

aat:300003088 a skos:Concept ;
    skos:definition "Narrow boards placed at an angle in louvers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louver boards"@en .

aat:300003092 a skos:Concept ;
    skos:definition "Slender, vertical, usually nonstructural bars or piers forming a division between doors, screens, or lights of windows; for the small members that divide glazing areas and support the panes or the verticals that separate the panels in panel doors, use \"muntins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mullions"@en .

aat:300003103 a skos:Concept ;
    skos:definition "Use both for the horizontal or vertical members dividing glazing areas into lights and supporting the panes, and for the vertical members separating panels in panel doors; for the uprights that divide openings set in a series, use \"mullions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muntins"@en .

aat:300003106 a skos:Concept ;
    skos:definition "Slender bars of cast lead, with or without grooves, used in casement and stained glass windows to hold the pieces of glass in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cames"@en .

aat:300003108 a skos:Concept ;
    skos:definition "In double-hung windows, the horizontal rails that meet in the middle when the window is closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meeting rails"@en .

aat:300003109 a skos:Concept ;
    skos:definition "Frames, usually of wood, rebated and fitted with one or more panes of glass to form a window or part of a window; particularly a sliding frame or each of the two sliding frames of a sash window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sashes"@en .

aat:300003113 a skos:Concept ;
    skos:definition "General term for architectural features that reduce heat gain or light, through designs that block the direct entrance of sun rays into buildings; may be either fixed or movable devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brise-soleils"@en .

aat:300003115 a skos:Concept ;
    skos:definition "Horizontal cloth hangings fixed across the top of an opening; generally used as decorative headings to conceal the tops of curtains and their hardware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valances"@en .

aat:300003118 a skos:Concept ;
    skos:definition "Frames that are set in walls to receive and hold windows, either being boxed for sliding sashes, or solid and rebated for casements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window frames"@en .

aat:300003120 a skos:Concept ;
    skos:definition "Parts or components of window frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window frame components"@en .

aat:300003121 a skos:Concept ;
    skos:definition "The upper horizontal cross members or decorative elements of window frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window heads"@en .

aat:300003122 a skos:Concept ;
    skos:definition "The horizontal bottom member of a window frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window sills"@en .

aat:300003126 a skos:Concept ;
    skos:definition "Window sills in a brick or stone wall, where the sill extends beyond the width of the window opening and with the ends of the sill set in the wall. Distinguished from \"slip sills\" which are just as long as the window is wide and fit into the walls between the jambs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lug sills"@en .

aat:300003127 a skos:Concept ;
    skos:definition "Window sills that consist of a stone slab as long as the window is wide and that fit into the walls between the jambs; distinguished from \"lug sills\" which are longer than the width of the window opening and are let into the wall on each side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip sills"@en .

aat:300003132 a skos:Concept ;
    skos:definition "Small triangular lights between subordinate arches of the tracery of a window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angel lights"@en .

aat:300003133 a skos:Concept ;
    skos:definition "Windows or tracery lights having a curved or inclined bottom caused by, for example, the arched heads of other lights below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batement lights"@en .

aat:300003134 a skos:Concept ;
    skos:definition "Square or lozenge-shaped pieces of glass, typically used in windows; examples are those set in lattice windows. For other square or lozenge-shaped pieces of material, such as stone, brick, or tile, use \"quadrels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarries"@en .

aat:300003138 a skos:Concept ;
    skos:definition "Parts or components of openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opening components"@en .

aat:300003140 a skos:Concept ;
    skos:definition "Awnings drawn over outdoor theaters or amphitheaters as protection from the rain or sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velaria"@en .

aat:300003146 a skos:Concept ;
    skos:definition "Vertical members at either side of doorframes, window frames, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jambs"@en .

aat:300003155 a skos:Concept ;
    skos:definition "Those portions of jambs of an opening or recess which are visible from the face of the wall back to the frame or other structure which may be placed between the jambs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reveals"@en .

aat:300003161 a skos:Concept ;
    skos:definition "Horizontal structural members that span an opening in a wall and that carry the superimposed weight of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lintels"@en .

aat:300003170 a skos:Concept ;
    skos:definition "Cantilevered or suspended roofs over the entrances to buildings, of metal or metal and glass; in the 19th and 20th centuries, common over the entrances to theaters, casinos, and hotels to advertise entertainment. For smaller, often ornamental, rooflike structures at entrances, use \"canopies (structural elements).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marquees"@en .

aat:300003172 a skos:Concept ;
    skos:definition "Supports, usually pilasters or colonettes, engaged to a wall, that carry one end of an arch, a groin, or a vault rib."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "responds"@en .

aat:300003173 a skos:Concept ;
    skos:definition "Movable screens, covers, or similar contrivances to close an opening, especially a window or door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutters"@en .

aat:300003176 a skos:Concept ;
    skos:definition "Shutters having fixed slats that slope upwards from without, so as to exclude sun and rain, and admit air and some light. For similar shutters having movable slats, use \"louvered shutters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jalousies"@en .

aat:300003179 a skos:Concept ;
    skos:definition "Members forming the lower sides of openings. For the horizontal timbers at the bottom of the frame of a wooden structure, use \"sill plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sills"@en .

aat:300003182 a skos:Concept ;
    skos:definition "The visible bordering elements around a central piece, such as a door, window, or other opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surrounds"@en .

aat:300003184 a skos:Concept ;
    skos:definition "Ornamental openwork of masonry found in the upper parts of Gothic style windows; also, similar motifs and forms in various materials applied decoratively, as on walls, furniture, and other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracery"@en .

aat:300003187 a skos:Concept ;
    skos:definition "Openwork of molded mullions that divide a window into lights in decorative patterns; common in the Gothic style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar tracery"@en .

aat:300003188 a skos:Concept ;
    skos:definition "Tracery applied to a surface without being pierced through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind tracery"@en .

aat:300003190 a skos:Concept ;
    skos:definition "Tracery hanging from the intrados of an arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop tracery"@en .

aat:300003192 a skos:Concept ;
    skos:definition "Tracery in which continuous compound or ogee curves predominate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curvilinear tracery"@en .

aat:300003202 a skos:Concept ;
    skos:definition "Tracery whose openings are or seem to be pierced through slabs of stone; used especially in Early Gothic windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate tracery"@en .

aat:300003205 a skos:Concept ;
    skos:definition "Tracery in which the central mullion splits in half to form a Y shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Y-tracery"@en .

aat:300003207 a skos:Concept ;
    skos:definition "Parts or components of tracery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracery components"@en .

aat:300003208 a skos:Concept ;
    skos:definition "The intersection of two arcs or foils, as in Gothic tracery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cusps"@en .

aat:300003209 a skos:Concept ;
    skos:definition "Circular or nearly circular lobes tangent to the inner side of a larger arc, as of an arch, or meeting each other in projecting cusps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foils"@en .

aat:300003211 a skos:Concept ;
    skos:definition "In 14th-century Gothic tracery and derivatives, pointed, elongated openings bounded by elliptical and ogee curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouchettes"@en .

aat:300003215 a skos:Concept ;
    skos:definition "Strips fixed to the sill of an external door or window to resist the penetration of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water bars"@en .

aat:300003217 a skos:Concept ;
    skos:definition "Architectural elements used to move people through spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circulation elements"@en .

aat:300003219 a skos:Concept ;
    skos:definition "Inclined planes or slopes that are constructed of earth, stone, cement, metal, wood, or another material and used to connect two different levels, or to connect one level to the air or water. Examples include sloping floors or walks in architecture, sloping construction used in highway engineering, movable sets of stairs used when boarding or leaving an airplane, and movable slopes to allow access to a bus or other type of vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramps"@en .

aat:300003221 a skos:Concept ;
    skos:definition "Inclined planes that are constructed instead of or in addition to stairways in order to allow wheelchair users and people pushing carts or other small wheeled devices to access buildings, parts of buildings, curbs, or other locations where it is necessary to go from one level to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheelchair ramps"@en .

aat:300003228 a skos:Concept ;
    skos:definition "General term for ascending series or flights of steps; utility constructions using steps and designed to bridge a vertical distance. A stairs is a construction or contrivance comprising a change of elevation consisting of one or more risers, as defined by the International Code Council."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stairs"@en .

aat:300003232 a skos:Concept ;
    skos:definition "Stairs which turn 180 degrees as they progress from bottom to top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-turn stairs"@en .

aat:300003233 a skos:Concept ;
    skos:definition "Stairs with landings at which the stair turns 180 degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halfpace stairs"@en .

aat:300003235 a skos:Concept ;
    skos:definition "Halfpace stairs which have no well hole between successive flights; the rail and balusters of the upper and under flights fall in the same vertical plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogleg stairs"@en .

aat:300003238 a skos:Concept ;
    skos:definition "Stairs which pass through four right-angle turns as they progress from the bottom to top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-turn stairs"@en .

aat:300003240 a skos:Concept ;
    skos:definition "Stairs that, as they progress from bottom to top, turn 90 degrees; for stairs with landings at which the stair turns 90 degrees, use \"quarterpace stairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter-turn stairs"@en .

aat:300003242 a skos:Concept ;
    skos:definition "Stairs with landings at which the stair turns 90 degrees; for stairs that turn 90 degrees as they progress from bottom to top, use \"quarter-turn stairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarterpace stairs"@en .

aat:300003243 a skos:Concept ;
    skos:definition "Staircases that are circular in plan, consisting entirely of winders or wedge-shaped steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral stairs"@en .

aat:300003256 a skos:Concept ;
    skos:definition "Stairs which rise in one direction only, without turns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight stairs"@en .

aat:300003259 a skos:Concept ;
    skos:definition "Stairs which turn 270 degrees as they progress from bottom to top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-quarter-turn stairs"@en .

aat:300003262 a skos:Concept ;
    skos:definition "Stairs, usually of steel, attached to the outside of buildings to provide means of escape in case of fire. Use \"fire stairs\" for fire-secure stairs within buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire escapes"@en .

aat:300003264 a skos:Concept ;
    skos:definition "Stairs within buildings so designed that they are relatively secure from the effects of fire in a building and thus are designated as an emergency escape. Use \"fire escapes\" for stairs located on the outside of buildings to provide a means of escape in case of fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire stairs"@en .

aat:300003265 a skos:Concept ;
    skos:definition "In a fortification, the steps leading from walls down to water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pas-de-souris"@en .

aat:300003266 a skos:Concept ;
    skos:definition "Arrangements of steps, rungs, or frameworks of bars and steps, contrived to allow passage of a person over or through a fence, while maintaining a barrier to the passage of sheep or cattle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stiles"@en .

aat:300003267 a skos:Concept ;
    skos:definition "Stairs or steps communicating between any water level, as of a river, lake, or harbor, and the land, for convenience of embarkation or debarkation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water stairs"@en .

aat:300003270 a skos:Concept ;
    skos:definition "Specially constructed stairs which can be folded and swung upward into a space in the ceiling when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disappearing stairs"@en .

aat:300003271 a skos:Concept ;
    skos:definition "Stairs constructed without the use of newels at the angles or turning points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometrical stairs"@en .

aat:300003273 a skos:Concept ;
    skos:definition "Stairs constructed with newels at the angles to receive the ends of the strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newel stairs"@en .

aat:300003279 a skos:Concept ;
    skos:definition "Stairs whose tapered treads wind around, and engage in, a solid, central newel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid newel stairs"@en .

aat:300003284 a skos:Concept ;
    skos:definition "Parts or components of stairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stair components"@en .

aat:300003285 a skos:Concept ;
    skos:definition "Pieces of lumber protruding from a wall to support carriage pieces or strings of a wooden stair at their upper ends or at landings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apron pieces"@en .

aat:300003287 a skos:Concept ;
    skos:definition "Short vertical members used to support a stair handrail or coping, often circular in section with a vase-shaped outline. Used also in furniture, as on the backs of chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balusters"@en .

aat:300003290 a skos:Concept ;
    skos:definition "Inclined beams which support the steps or add support between the strings of a wooden staircase, usually between the wall and outer string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage pieces"@en .

aat:300003291 a skos:Concept ;
    skos:definition "Continuous series of steps with no intermediate landings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flights"@en .

aat:300003293 a skos:Concept ;
    skos:definition "Terminal features of newels often molded, turned, or carved in a decorative shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newel caps"@en .

aat:300003294 a skos:Concept ;
    skos:definition "Turned wood collars used to lengthen the base of a newel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newel collars"@en .

aat:300003295 a skos:Concept ;
    skos:definition "Ornamental projections at the bottom ends of newels of stairs of two or more flights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newel drops"@en .

aat:300003296 a skos:Concept ;
    skos:definition "In architecture, upright posts supporting the handrail at the top and bottom of a stairway or at the turn on a landing; also, the main posts about which circular staircases wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newels"@en .

aat:300003299 a skos:Concept ;
    skos:definition "Posts located at the landing points of stairs and supporting handrails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landing newels"@en .

aat:300003312 a skos:Concept ;
    skos:definition "Staircase units that consist of one tread and one riser, or any similar element providing a horizontal surface on which to support the foot of a person descending or ascending."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steps"@en .

aat:300003315 a skos:Concept ;
    skos:definition "Steps at the foot of a flight of stairs which have curved ends projecting beyond the string and surrounding the newel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commode steps"@en .

aat:300003316 a skos:Concept ;
    skos:definition "Steps, usually the lowest in a flight, having one or both ends rounded to a semicircle and projecting beyond the face of the stair string and the newel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullnose steps"@en .

aat:300003320 a skos:Concept ;
    skos:definition "Flights of steps, usually of stone, that are built into a wall at one end and have no other support except what they may derive by slightly overlapping the stone step next below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging steps"@en .

aat:300003321 a skos:Concept ;
    skos:definition "Solid steps, as those worked from one piece of stone, having more or less the section of a right-angled triangle, the hypotenuse forming part of the sloping soffit of the flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spandrel steps"@en .

aat:300003323 a skos:Concept ;
    skos:definition "Parts or components of steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step components"@en .

aat:300003324 a skos:Concept ;
    skos:definition "The overhanging, usually half-round, edges of the treads of steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nosings"@en .

aat:300003325 a skos:Concept ;
    skos:definition "The vertical faces of steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "risers"@en .

aat:300003326 a skos:Concept ;
    skos:definition "The horizontal parts of steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treads"@en .

aat:300003328 a skos:Concept ;
    skos:definition "Steps in a straight flight of stairs, each tread of which is of uniform width."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fliers"@en .

aat:300003330 a skos:Concept ;
    skos:definition "Steps, more or less wedge-shaped, whose tread is wider at one end than the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winders"@en .

aat:300003336 a skos:Concept ;
    skos:definition "Series of winders arranged so that the small ends of the steps are not much narrower than the parallel steps of the same stair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balanced steps"@en .

aat:300003339 a skos:Concept ;
    skos:definition "Stone steps, triangular in section, forming spiral or solid newel stairs; they are tapered and have shaped ends which, laid upon each other, constitute the central column or solid newel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turret steps"@en .

aat:300003340 a skos:Concept ;
    skos:definition "Inclined boards that support the treads and risers of a stair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strings"@en .

aat:300003343 a skos:Concept ;
    skos:definition "Outer strings on stairs, usually of better material or finish than the carriage pieces which they cover; may be part of the actual construction or applied to the face of the supporting member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face strings"@en .

aat:300003349 a skos:Concept ;
    skos:definition "Strings which have the upper edge notched, or otherwise worked to the shape of the steps, so that treads and risers are supported by and overlap the step-shaped edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open strings"@en .

aat:300003355 a skos:Concept ;
    skos:definition "Stair strings set against a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall strings"@en .

aat:300003359 a skos:Concept ;
    skos:definition "On a staircase, members which are fixed to the upper edge of a closed string to receive the balusters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subrails"@en .

aat:300003365 a skos:Concept ;
    skos:definition "Platforms or boardwalks erected over unfinished building sections to provide access for workers and material carriers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gangways"@en .

aat:300003376 a skos:Concept ;
    skos:definition "Interfaces or meeting surfaces between two successive pours of concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction joints"@en .

aat:300003377 a skos:Concept ;
    skos:definition "Shallow grooves in masonry or concrete designed to control and guide stresses and resultant cracking or separation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "control joints"@en .

aat:300003378 a skos:Concept ;
    skos:definition "Joints that allow for contraction of two adjacent parts of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contraction joints"@en .

aat:300003379 a skos:Concept ;
    skos:definition "Joints that allow for expansion of two adjacent parts of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expansion joints"@en .

aat:300003380 a skos:Concept ;
    skos:definition "Joints between two adjacent structures which are not in physical contact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isolation joints"@en .

aat:300003385 a skos:Concept ;
    skos:definition "Joints made by beveling the ends of two pieces of lumber or plywood to be joined. The cut on each piece is angled so that the surfaces of the two pieces being joined are flush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarf joints"@en .

aat:300003391 a skos:Concept ;
    skos:definition "In sheet metal, the joints between two parts whose preformed edges engage to form a continuous locked splice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interlocking joints"@en .

aat:300003395 a skos:Concept ;
    skos:definition "Joints generally used in woodworking to either hold two or more wooden boards together or to stabilize a splitting board or knothole. A butterfly joint is typically cut from a single piece of wood in a shape resembling two dovetails connected at the narrow part; it is fitted into a hole of the same shape that has been cut in the board or boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butterfly joints"@en .

aat:300003396 a skos:Concept ;
    skos:definition "Joints between masonry units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry joints"@en .

aat:300003398 a skos:Concept ;
    skos:definition "Joints between different courses or layers of bricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed joints"@en .

aat:300003399 a skos:Concept ;
    skos:definition "Arrangements of modular structural units, such as masonry or plywood sheathing, so that the vertical joints of adjacent units do not line up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "break joints"@en .

aat:300003402 a skos:Concept ;
    skos:definition "Concealed joints in masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind joints"@en .

aat:300003403 a skos:Concept ;
    skos:definition "Recessed masonry joints formed in mortar by the use of a curved steel jointing tool; effective in resisting rain penetration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concave joints"@en .

aat:300003405 a skos:Concept ;
    skos:definition "Mortar joints that are flush with the faces of the blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough-cut joints"@en .

aat:300003415 a skos:Concept ;
    skos:definition "Joints in a masonry wall which have the mortar raked out to a specified depth while it is still soft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raked joints"@en .

aat:300003416 a skos:Concept ;
    skos:definition "Vertical joints in brickwork made by laying the brick in a bed of mortar and shoving the brick toward the last brick laid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoved joints"@en .

aat:300003417 a skos:Concept ;
    skos:definition "In brickwork, raked joints used with bricks of rough texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stripped joints"@en .

aat:300003418 a skos:Concept ;
    skos:definition "Masonry joints in which excess mortar is removed by a stroke of a trowel, so the joint is angled in cross-section, rather than flush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "struck joints"@en .

aat:300003421 a skos:Concept ;
    skos:definition "Joints made of metal, used to connect elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal joints"@en .

aat:300003424 a skos:Concept ;
    skos:definition "Joints used in construction and woodworking comprising intermediate construction pieces that join two or more pieces of wood or another material. Rigid joints, typically made of metal or wood, are usually overlapping or placed between, and attached to, the pieces to be joined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigid joints"@en .

aat:300003426 a skos:Concept ;
    skos:definition "Joints which allow rotations to occur freely except in the direction perpendicular to the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller joints"@en .

aat:300003429 a skos:Concept ;
    skos:definition "Long, regular channels or projections used for finishing and decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moldings"@en .

aat:300003438 a skos:Concept ;
    skos:definition "Slanted moldings, as in a pediment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raking moldings"@en .

aat:300003444 a skos:Concept ;
    skos:definition "Round convex moldings with disks alternating singly or in pairs with oblong beads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead and reel moldings"@en .

aat:300003446 a skos:Concept ;
    skos:definition "Fillet moldings with the front portion pendant; for moldings with a beaked head ornamental motif, use \"beakhead moldings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beak moldings"@en .

aat:300003447 a skos:Concept ;
    skos:definition "Used to designate moldings formed by a series of regularly spaced cubical or short cylindrical projections; found in Romanesque architecture and usually appearing in multiple rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billet moldings"@en .

aat:300003449 a skos:Concept ;
    skos:definition "Common Norman moldings consisting of a series of billets which are cylindrical in cross section, usually staggered in alternate rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll billet moldings"@en .

aat:300003454 a skos:Concept ;
    skos:definition "Moldings carved with a motif resembling a chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain moldings"@en .

aat:300003469 a skos:Concept ;
    skos:definition "Moldings enriched with egg-shaped ornaments alternating with dartlike ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg and dart moldings"@en .

aat:300003487 a skos:Concept ;
    skos:definition "Rows of bead-like architectural ornaments, named for the resemblance, when seen in cross section, to prayer beads (\"paternoster\" referring to the \"Our Father\" prayer)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paternosters"@en .

aat:300003506 a skos:Concept ;
    skos:definition "Small moldings having a rounded, convex section. The term can also loosely refer to the glazing bars of case furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astragals"@en .

aat:300003513 a skos:Concept ;
    skos:definition "Moldings with a rounded concave surface, usually a quarter circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavetto moldings"@en .

aat:300003517 a skos:Concept ;
    skos:definition "Moldings having a profile of double curvature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cymas"@en .

aat:300003522 a skos:Concept ;
    skos:definition "Moldings of double curvature where the uppermost surface is concave and the lowermost is convex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyma rectas"@en .

aat:300003524 a skos:Concept ;
    skos:definition "Moldings of double curvature where the uppermost surface is convex and the lowermost is concave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyma reversas"@en .

aat:300003526 a skos:Concept ;
    skos:definition "Moldings consisting of a narrow flat band, often square in section, used to separate or terminate a series of moldings; use also for the flat surfaces between flutes on column shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillets"@en .

aat:300003528 a skos:Concept ;
    skos:definition "Use generally for small decorative moldings, usually angular bands or fillets, encircling column shafts; specifically designates the fillets around the bottom of the echinus of a Doric capital. For the grooves encircling the bottom of a Doric capital and masking the joint between capital and shaft, use \"hypotrachelia.\" For molded bands around Gothic column shafts, often masking the joint between two sections of shaft, prefer \"shaft rings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annulets"@en .

aat:300003531 a skos:Concept ;
    skos:definition "Fillets or small flat-faced projections, as used in a fret molding or to cover a joint between two boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reglet moldings"@en .

aat:300003532 a skos:Concept ;
    skos:definition "Fillet moldings that are produced by cutting a groove in a plane surface. Distinguished from \"fillets (motifs)\" which are an impressed line, either gilt or blind, created by the finishing tool, the fillet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunk fillets"@en .

aat:300003533 a skos:Concept ;
    skos:definition "The flat bands above the uppermost moldings or cymas of cornices, or the small bands above and below the scotia of an Attic base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supercilia"@en .

aat:300003534 a skos:Concept ;
    skos:definition "Narrow raised bands, particularly the topmost members of the Doric architrave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taeniae"@en .

aat:300003537 a skos:Concept ;
    skos:definition "Rounded usually beaded convex moldings placed under the echini of capitals in the Doric, Ionic, and Corinthian orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fusaroles"@en .

aat:300003539 a skos:Concept ;
    skos:definition "Convex strips or moldings of semicircular profile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-round moldings"@en .

aat:300003545 a skos:Concept ;
    skos:definition "Flat, rectangular, horizontal moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platbands"@en .

aat:300003546 a skos:Concept ;
    skos:definition "Moldings that present profiles of a quarter of a circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter rounds"@en .

aat:300003547 a skos:Concept ;
    skos:definition "Any convex, rounded molding which has a partly cylindrical form; commonly used to refer to Gothic or Romanesque rather than classical forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll moldings"@en .

aat:300003557 a skos:Concept ;
    skos:definition "Moldings of nearly circular cross section with narrow bands or fillets on the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll-and-fillet moldings"@en .

aat:300003559 a skos:Concept ;
    skos:definition "In Mayan architecture, tripartite facade moldings consisting of a central vertical band framed on top and bottom by flaring members; characteristic of Puuc architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ataduras"@en .

aat:300003562 a skos:Concept ;
    skos:definition "Moldings which embellish the top of a piece of simple trim or casing, such as the top of a dado, baseboard, or window casing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap moldings"@en .

aat:300003564 a skos:Concept ;
    skos:definition "The uppermost moldings, as on an interior wall, the top of a cornice, or a piece of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown moldings"@en .

aat:300003565 a skos:Concept ;
    skos:definition "Projecting moldings carried over door and window openings, sometimes to deflect rainwater from the openings; common in Medieval architecture. For rectangular hood moldings, use \"labels (moldings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hood moldings"@en .

aat:300003567 a skos:Concept ;
    skos:definition "Ornamental treatments used over openings such as doors or windows, and composed of ogee arches the apex of which extends upward to form an ornamental finial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accolades"@en .

aat:300003568 a skos:Concept ;
    skos:definition "Moldings or dripstones that extend horizontally across the top of openings and frequently vertically part way down the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labels"@en .

aat:300003572 a skos:Concept ;
    skos:definition "Wooden strips, plain or molded, that cover joints, as in paneling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cover moldings"@en .

aat:300003574 a skos:Concept ;
    skos:definition "Moldings or groups of moldings used to cover the joint between two surfaces on different levels and projecting beyond the surface of both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolection moldings"@en .

aat:300003584 a skos:Concept ;
    skos:definition "Moldings which are nailed, laid on, or otherwise fastened to the work rather than cut into the solid material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "applied moldings"@en .

aat:300003586 a skos:Concept ;
    skos:definition "Moldings cut into, rather than added to or applied to, a member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "struck moldings"@en .

aat:300003591 a skos:Concept ;
    skos:definition "Struck moldings which are terminated short of the end of the member into which they are cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stop moldings"@en .

aat:300003592 a skos:Concept ;
    skos:definition "Parts or components of moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molding components"@en .

aat:300003593 a skos:Concept ;
    skos:definition "Short, straight billets or portions of molding usually of rounded section forming the zigzag molding in Romanesque architecture; for the complete molding, use 'zigzag moldings.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bâtons rompus"@en .

aat:300003596 a skos:Concept ;
    skos:definition "Bead moldings separated from an adjoining surface by quirks, along one or both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quirk beads"@en .

aat:300003602 a skos:Concept ;
    skos:definition "Sharp, V-shaped channels or grooves separating one element from another, as between moldings or between the abacus and echinus of a Doric capital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quirks"@en .

aat:300003604 a skos:Concept ;
    skos:definition "Refers to architectural elements, usually of generally triangular shape, that project from a wall, pier, or other structure and which serve to support vertical loads or strengthen an angle by transferring the load against the face of the structure from which they project; sometimes more decorative than functional. For support hardware, use \"brackets (support hardware).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brackets"@en .

aat:300003605 a skos:Concept ;
    skos:definition "Brackets projecting from the intersection of two walls; when on the exterior, often to support a cornice; when on the interior, often to support a rafter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle brackets"@en .

aat:300003610 a skos:Concept ;
    skos:definition "Cantilevered masonry blocks used singly or in ranges to support architectural or ornamental features or used in successive courses to form arches, domes, or vaults; when referring generally to the projecting courses of masonry, prefer \"oversailing courses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corbels"@en .

aat:300003614 a skos:Concept ;
    skos:definition "The underside of a part or member of a building (as of an overhang, ceiling, staircase, cornice, or entablature)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soffits"@en .

aat:300003615 a skos:Concept ;
    skos:definition "Parts of buildings with walls rising considerably above the rest, usually with vertical proportions, and to some extent architecturally distinct. For usually detached or isolated buildings or other structures high in proportion to their lateral dimensions, use \"towers (single built works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towers"@en .

aat:300003625 a skos:Concept ;
    skos:definition "Towers attached to churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church towers"@en .

aat:300003628 a skos:Concept ;
    skos:definition "Outworks in Medieval fortifications, such as gate towers, but more frequently an advance work used to flank the approach to a gateway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbicans"@en .

aat:300003632 a skos:Concept ;
    skos:definition "Small towers, especially when corbelled out from a corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turrets"@en .

aat:300003636 a skos:Concept ;
    skos:definition "Small turrets projecting from angles on top of towers or parapets, usually as part of a fortification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bartizans"@en .

aat:300003639 a skos:Concept ;
    skos:definition "Towers incorporated into a protective wall, such as the wall around a city or castle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall towers"@en .

aat:300003650 a skos:Concept ;
    skos:definition "General term for chambers used for baking, heating, or drying; for heating equipment used to harden or char various specific materials, use \"kilns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ovens"@en .

aat:300003668 a skos:Concept ;
    skos:definition "Infrastructural elements of bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridge elements"@en .

aat:300003670 a skos:Concept ;
    skos:definition "Embankments, trestles, or other structures that provide access at either end of a bridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridge approaches"@en .

aat:300003671 a skos:Concept ;
    skos:definition "Structures built around or upstream from a bridge pier with an angle or edge to resist better the action of water, ice, or flotsam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutwaters"@en .

aat:300003676 a skos:Concept ;
    skos:definition "Infrastructural elements of dams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dam elements"@en .

aat:300003685 a skos:Concept ;
    skos:definition "Passages, as a paved apron or channel, for surplus water over or around a dam or similar obstruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spillways"@en .

aat:300003686 a skos:Concept ;
    skos:definition "Depressions in a channel or reservoir deep enough to reduce the turbulence or velocity of the flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilling basins"@en .

aat:300003687 a skos:Concept ;
    skos:definition "Architectural elements used to fortify structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortification elements"@en .

aat:300003688 a skos:Concept ;
    skos:definition "The enclosed open spaces within castles; especially applied to Medieval fortifications; sometimes also used to refer to the outer walls of such spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baileys"@en .

aat:300003694 a skos:Concept ;
    skos:definition "The strongest and securest parts of a castle, usually a great tower used as the residence and situated in the innermost court or bailey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keeps"@en .

aat:300003701 a skos:Concept ;
    skos:definition "Minor defensive features established outside the principal fortification limits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outworks"@en .

aat:300003703 a skos:Concept ;
    skos:definition "Raised, defensible works erected within a fortified place or by besiegers to command enemy positions within firing range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavaliers"@en .

aat:300003708 a skos:Concept ;
    skos:definition "Refers to the outer slopes of encircling defensive ditches; for the inner slopes, use \"scarps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterscarps"@en .

aat:300003713 a skos:Concept ;
    skos:definition "Steep slopes immediately in front of and below a fortification; for the outer slopes of encircling ditches of fortifications, use \"counterscarps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarps"@en .

aat:300003714 a skos:Concept ;
    skos:definition "Slopes used for defense against attack; may be natural or artificial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glacis"@en .

aat:300003715 a skos:Concept ;
    skos:definition "In military architecture, outworks of two half bastions connected by a curtain and joined to the main work by two parallel wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornworks"@en .

aat:300003716 a skos:Concept ;
    skos:definition "Refers to deep, wide defensive ditches surrounding towns, castles, or houses and usually filled with water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moats"@en .

aat:300003717 a skos:Concept ;
    skos:definition "Barriers composed of long stakes, usually with pointed tops, driven into the earth close together, sometimes connected by horizontal beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palisades"@en .

aat:300003718 a skos:Concept ;
    skos:definition "In military architecture, projecting outworks forming a salient angle beyond the main ditch and in front of the curtain wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ravelins"@en .

aat:300003720 a skos:Concept ;
    skos:definition "Small ravelins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redans"@en .

aat:300003723 a skos:Concept ;
    skos:definition "Furniture, ornament, windows, and other objects that are fastened in position and form part of a religious building, usually the interior, but are not an integral part of the architecture itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious building fixtures"@en .

aat:300003724 a skos:Concept ;
    skos:definition "Architectural elements found on Christian religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian religious building fixtures"@en .

aat:300003725 a skos:Concept ;
    skos:definition "Elevated platforms or constructions upon which religious sacrifice is offered or other religious or spiritual activities carried out. In a Christian church altars are platforms where Eucharistic elements are consecrated, in the ancient tradition of a sacrifice. Includes both indoor small, tablelike fixtures and larger, free-standing, outdoor structures. It consists of a horizontal part, the mensa, placed on various types of supports. For the surface at which communion is celebrated in Protestant churches, use \"communion tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altars"@en .

aat:300003728 a skos:Concept ;
    skos:definition "Chief altars in churches, typically raised on an elevated plane in the sanctuary where it may be seen simultaneously by all in the body of the church. In the early days of the Church the altar was usually placed in a chapel at the head of the edifice, the back of which looked directly towards the East and in such a way that it could be seen from any part by those in the church. When it was impossible to erect a church in such a manner, the altar was located opposite the chief doorway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high altars"@en .

aat:300003729 a skos:Concept ;
    skos:definition "Parts or components of altars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar components"@en .

aat:300003736 a skos:Concept ;
    skos:definition "Low rails or barriers in front of the altar of a church, intended to separate the sanctuary of the church from the body of the church, also separating the officiating clergy from the other worshippers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar rails"@en .

aat:300003737 a skos:Concept ;
    skos:definition "Altar rails at which communicants receive the sacrament of Holy Communion in Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion rails"@en .

aat:300003745 a skos:Concept ;
    skos:definition "Bases of large altarpieces decorated with images related to the main panels above. Formerly used to describe the platform on which the priest stood and an altar was placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "predellas"@en .

aat:300003762 a skos:Concept ;
    skos:definition "Canopies over such features as thrones, altars, tombs, or doorways; may be suspended, projecting, or free-standing. For roofed structures with columns built over altars, use \"ciboria (structures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baldachins"@en .

aat:300003777 a skos:Concept ;
    skos:definition "Small booths used for the sacrament of Confession, furnished with a seat for a priest and with a screen or latticed window through which the penitent may talk to the priest, who is hidden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confessionals"@en .

aat:300003779 a skos:Concept ;
    skos:definition "Recesses with tomb chests, usually placed in the north wall of a chancel, to hold the reserved consecrated wafers and sometimes a cross or effigy of Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Easter sepulchers"@en .

aat:300003781 a skos:Concept ;
    skos:definition "Refers to shrines, often in the form of small chapels, situated behind the altar, where saints' relics are kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feretories"@en .

aat:300003784 a skos:Concept ;
    skos:definition "Screens in Eastern Orthodox and Catholic churches that separate the sanctuary from the nave, usually pierced by three doors and, since the 14th or 15th century, covered with icons. The function of the iconostasis is modeled on the Temple in Jerusalem, where people other than the priests were separated from the holiest area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iconostases"@en .

aat:300003788 a skos:Concept ;
    skos:definition "Platforms above rood screens or rood beams, from which choirs sing or readings are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rood lofts"@en .

aat:300003790 a skos:Concept ;
    skos:definition "Elevated stands enclosed by a guardrail and a platform on which to rest a book, intended for clergy to preach to the congregation; usually situated within a church and may be fixed or movable (movable pulpit). It often has a staircase, a backboard, and a sounding-board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulpits"@en .

aat:300003792 a skos:Concept ;
    skos:definition "A fixed stand with a guardrail situated at the entrance to the chancel. Often found in pairs: the one at the North side is used to read the Gospel, the one at the South side is for the Epistle. It may have one or several bookrests, and may be used as a pulpit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambos"@en .

aat:300003796 a skos:Concept ;
    skos:definition "Church pulpits with a clerk's desk at the bottom, reader's desk above, and pulpit on top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-deckers"@en .

aat:300003798 a skos:Concept ;
    skos:definition "Structures placed behind or over pulpits, rostrums, or platforms to reflect sound toward the audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sounding boards"@en .

aat:300003818 a skos:Concept ;
    skos:definition "Architectural elements found on Islamic religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic religious building fixtures"@en .

aat:300003821 a skos:Concept ;
    skos:definition "Pulpits in mosques, having a small stand for the speaker, parapet, canopy, narrow stairs, and usually a gate at the foot of the stairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minbars"@en .

aat:300003826 a skos:Concept ;
    skos:definition "Walls of a mosque or idgah oriented toward Mecca and usually containing a minbar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qibla walls"@en .

aat:300003835 a skos:Concept ;
    skos:definition "Banks of earth piled against exterior walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berms"@en .

aat:300003837 a skos:Concept ;
    skos:definition "Places at which a bus makes a regular halt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bus stops"@en .

aat:300003841 a skos:Concept ;
    skos:definition "Raised edgings, as of stone or concrete, built along driveways, roads, or roofs, usually forming part of a gutter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curbs"@en .

aat:300003846 a skos:Concept ;
    skos:definition "Highway or railway bridge crossings over some barrier, as another highway or railroad tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overpasses"@en .

aat:300003847 a skos:Concept ;
    skos:definition "Grade separations where clearance to traffic on the upper level is obtained by depressing partially or completely the grade of the lower level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underpasses"@en .

aat:300003849 a skos:Concept ;
    skos:definition "Channels at the side or in the middle of a road or street, for leading off surface water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gutters"@en .

aat:300003853 a skos:Concept ;
    skos:definition "Public or private containers for pickup or delivery of mail. For rented compartments in officially designated post offices, use \"post-office boxes.\" The term formerly referred to boxes in which the mailbags were placed on a mail coach or steamer. In British usage, \"mailboxes\" typically refers specifically to such containers placed on a pole or post on a person's property, while \"letter-boxes\" typically refers to the larger boxes located in public places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mailboxes"@en .

aat:300003854 a skos:Concept ;
    skos:definition "Removable cast iron covers for manholes, which are holes through which a person may enter sewers, steam drains, or similar underground passages from a city street."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manhole covers"@en .

aat:300003855 a skos:Concept ;
    skos:definition "Paved or planted strips of ground dividing highways into lanes according to direction of travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "median strips"@en .

aat:300003857 a skos:Concept ;
    skos:definition "Coin-operated timing devices for regulating the parking of motor vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parking meters"@en .

aat:300003867 a skos:Concept ;
    skos:definition "Road junctions that permit vehicles to pass from one road to another by a system of separate levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interchanges"@en .

aat:300003871 a skos:Concept ;
    skos:definition "Places where two or more roads, streets, or highways join or cross."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intersections"@en .

aat:300003880 a skos:Concept ;
    skos:definition "Circular arrangements constructed at the intersection of two or more roads in order to facilitate the passage from one road to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic circles"@en .

aat:300003887 a skos:Concept ;
    skos:definition "Turn-outs along roadways used as public rest stops; often having shade trees or shelters, toilets, picnic tables, and trash cans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roadside rest areas"@en .

aat:300003890 a skos:Concept ;
    skos:definition "Those portions of thoroughfares over which vehicular traffic passes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roadways"@en .

aat:300003892 a skos:Concept ;
    skos:definition "Series of rough or slightly raised strips of pavement on a highway, intended to slow down the speed of vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speed bumps"@en .

aat:300003900 a skos:Concept ;
    skos:definition "Benches, signs, light fixtures, and receptacles provided as part of the design of a road."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street furniture"@en .

aat:300003909 a skos:Concept ;
    skos:definition "Posts, usually mounted on the roadside or at intersections, bearing a sign or signs for the guidance of travelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guideposts"@en .

aat:300003911 a skos:Concept ;
    skos:definition "Places where taxis may park awaiting hire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxi stands"@en .

aat:300003912 a skos:Concept ;
    skos:definition "Paved or planted islands in roadways designed to guide the flow of traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic islands"@en .

aat:300003913 a skos:Concept ;
    skos:definition "Strips of roadways adequate to accommodate a single line of vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanes"@en .

aat:300003915 a skos:Concept ;
    skos:definition "Usually electrically operated signals (as a system of colored lights) for warning and controlling traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic signals"@en .

aat:300003928 a skos:Concept ;
    skos:definition "Networks of equipment that provide nonstructural services, such as HVAC or electricity throughout a building or complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building systems"@en .

aat:300003933 a skos:Concept ;
    skos:definition "Vertical noncombustible structures containing flues for drawing off into the outside air products of combustion from, for example, stoves, fireplaces, and furnaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimneys"@en .

aat:300003944 a skos:Concept ;
    skos:definition "Parts or components of chimneys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney components"@en .

aat:300003945 a skos:Concept ;
    skos:definition "Gutters installed on the uphill side of a chimney on a sloping roof; used to divert water around the chimney."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back gutters"@en .

aat:300003946 a skos:Concept ;
    skos:definition "Small false roofs built over the main roof behind a chimney; used to provide protection against water leakage where the chimney penetrates the roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney crickets"@en .

aat:300003953 a skos:Concept ;
    skos:definition "The narrowest portions of a chimney flue, between the gathering, or upward contraction above the fireplace, and the flue proper; often where the damper is located."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney throats"@en .

aat:300003960 a skos:Concept ;
    skos:definition "Coverings that protect chimney openings from rain entering the flue, sometimes combined with or constructed as a single device with a \"chimney cap,\" which is a cornice-like or other decorative termination to chimneys; for extensions placed on top of chimneys to improve draft or appearance, and which generally extend the flue, use \"chimney pots.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney hoods"@en .

aat:300003961 a skos:Concept ;
    skos:definition "Metal, masonry, or ceramic extensions which continue the flue on top of chimneys to improve draft or appearance; for extensions that protect chimney openings and may serve to block rain, use \"chimney hoods.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney pots"@en .

aat:300003965 a skos:Concept ;
    skos:definition "Chimney pots of long and slender form, intended to improve the draft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tallboys"@en .

aat:300003969 a skos:Concept ;
    skos:definition "The sides of chimneys above the fireplace opening that close in toward the chimney throat or damper opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney wings"@en .

aat:300003972 a skos:Concept ;
    skos:definition "Chambers located below fireplaces or fireboxes for the collection and removal of ashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ashpits"@en .

aat:300003975 a skos:Concept ;
    skos:definition "Metal lintels that support the masonry above fireplace openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney bars"@en .

aat:300003977 a skos:Concept ;
    skos:definition "Refers to masonry on either side of a fireplace opening that supports the mantel and upper chimney construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney cheeks"@en .

aat:300003985 a skos:Concept ;
    skos:definition "Designates the back walls or linings of fireplaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firebacks"@en .

aat:300003987 a skos:Concept ;
    skos:definition "Designates the splayed sides of fireplaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace cheeks"@en .

aat:300003988 a skos:Concept ;
    skos:definition "Frameworks of parallel or crossed bars or laths used as barriers in an opening or passage, or as a support or separating element, as in fire-making equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grates"@en .

aat:300003990 a skos:Concept ;
    skos:definition "Refers to floors of fireplaces and the immediately adjacent floor areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearths"@en .

aat:300003996 a skos:Concept ;
    skos:definition "Flat projecting shelves at the side of fireplaces where pots or pans may be placed to keep warm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hobs"@en .

aat:300003997 a skos:Concept ;
    skos:definition "Passageways constructed to control drafts in and carry away products of combustion from fireplaces and furnaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flues"@en .

aat:300004001 a skos:Concept ;
    skos:definition "Linings of chimneys constructed of special heat-resistant materials to prevent fire, smoke, and gases from spreading to surrounding spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flue linings"@en .

aat:300004003 a skos:Concept ;
    skos:definition "Doors that provide access for cleaning or repairing flues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soot doors"@en .

aat:300004013 a skos:Concept ;
    skos:definition "Rooms or divisions of rooms that are semicircular in plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemicycles"@en .

aat:300004014 a skos:Concept ;
    skos:definition "Niches, recesses, or other sheltered spaces, often semicircular and lined with seats; primarily in Roman architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exedrae"@en .

aat:300004026 a skos:Concept ;
    skos:definition "Single rooms usually housing only one person within a building having numerous similar rooms, as in a convent or in a prison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cells"@en .

aat:300004029 a skos:Concept ;
    skos:definition "Includes colonnades surrounding a building, such as a Greek temple, and Roman courtyards surrounded by a colonnade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peristyles"@en .

aat:300004031 a skos:Concept ;
    skos:definition "Substantial interior spaces at the level of an upper story that overlook the level below and usually extend the full length or width of a room. For railed platforms projecting from the exterior walls of buildings or small, similar interior features, use \"balconies.\" For floor levels in a church above the aisles and open to the nave, use \"tribunes (stories)\" or \"triforiums.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleries"@en .

aat:300004034 a skos:Concept ;
    skos:definition "Galleries or balconies for players of musical instruments, whether in secular or religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minstrel galleries"@en .

aat:300004035 a skos:Concept ;
    skos:definition "Galleries appropriated to a choir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choir lofts"@en .

aat:300004039 a skos:Concept ;
    skos:definition "Galleries or lofts in which an organ is located, often in a church and intended mainly for use by the organist and choir. It is often connected to the organ, with which it may form a single architectural-decorative structure. In some regions, the organ loft is very large, often consisting of several superimposed levels, and is reserved for men attending Mass. It is usually made of wood or stone, supported by ledges with a parapet and sometimes grilles that conceal the members of the choir. It is usually located in the western portion of the nave, above the main entrance to the church, sometimes supported by the inner door. It may also be located in other parts of the nave, in the arms of the transept, or along the walls of the choir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ lofts"@en .

aat:300004042 a skos:Concept ;
    skos:definition "Upper-story storage spaces for hay in stables or barns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haylofts"@en .

aat:300004044 a skos:Concept ;
    skos:definition "Refers to the interior portions of buildings or other structures fully separated and divided off from the other portions by a floor, ceiling, and walls or partitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rooms"@en .

aat:300004048 a skos:Concept ;
    skos:definition "Generally refers to large round rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotundas"@en .

aat:300004050 a skos:Concept ;
    skos:definition "Successions of connected rooms, generally on one floor, that are occupied as one unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suites"@en .

aat:300004054 a skos:Concept ;
    skos:definition "Use to designate small recessed spaces off of larger rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcoves"@en .

aat:300004055 a skos:Concept ;
    skos:definition "Alcoves or small room openings off the atrium of an ancient Roman house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alae"@en .

aat:300004058 a skos:Concept ;
    skos:definition "Recessed seating areas by a fire or hearth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inglenooks"@en .

aat:300004062 a skos:Concept ;
    skos:definition "Subsidiary supplementary built work, whether additions to a main built work or separate from it, but usually visibly distinct and often with a separate entrance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annexes"@en .

aat:300004063 a skos:Concept ;
    skos:definition "General term for rooms or sets of rooms used as dwellings or private living quarters and located in larger buildings, such as apartment houses, private houses, or hotels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apartments"@en .

aat:300004064 a skos:Concept ;
    skos:definition "One-floor apartments, usually modest, each having an outside entrance; may also be used for buildings having a small number of such units and usually dating from the late 19th or early 20th century. Generally American usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flats"@en .

aat:300004071 a skos:Concept ;
    skos:definition "Apartments containing one spacious room, often with large windows, which is or resembles an artist's studio, and serves as both a sitting area and a sleeping area, and with access to a separate bathroom and small kitchen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studio apartments"@en .

aat:300004072 a skos:Concept ;
    skos:definition "Minor structures with roofs of single slope built against the sides of buildings. For freestanding structures of this type, use \"lean-tos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appentices"@en .

aat:300004086 a skos:Concept ;
    skos:definition "Small enclosures or stands, permanent or temporary, and freestanding or not, used for selling goods or to afford privacy to their occupants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booths"@en .

aat:300004087 a skos:Concept ;
    skos:definition "Booths where art works or goods are exhibited or sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition booths"@en .

aat:300004088 a skos:Concept ;
    skos:definition "Rooms or other areas, above or below ground, that are reserved for burial, generally intended to accomodate one or a small number of bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial chambers"@en .

aat:300004090 a skos:Concept ;
    skos:definition "Roofed shelters for automobiles, often without walls; usually associated with or projecting from a separate building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carports"@en .

aat:300004095 a skos:Concept ;
    skos:definition "Uncovered areas, surrounded or partially surrounded by the walls of a building. A clear space enclosed by walls or surrounded by buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtyards"@en .

aat:300004097 a skos:Concept ;
    skos:definition "The main inner halls of Roman houses having a compluvium (opening in the roof) for rainwater and an impluvium (rectangular basin) to collect the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atriums"@en .

aat:300004101 a skos:Concept ;
    skos:definition "Enclosed Roman courtyards with porticoes on all four sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadriportici"@en .

aat:300004108 a skos:Concept ;
    skos:definition "Courts or recesses serving primarily to provide light or ventilation to windows along the walls; for very small courts used primarily for ventilation, use \"air shafts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light courts"@en .

aat:300004113 a skos:Concept ;
    skos:definition "Uncovered wood or metal platforms, usually attached to structures and often raised off the ground or on rooftops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decks"@en .

aat:300004114 a skos:Concept ;
    skos:definition "Decks or flat roofs intended for sunbathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun decks"@en .

aat:300004115 a skos:Concept ;
    skos:definition "Extensions that are at right angles to the length of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ells"@en .

aat:300004118 a skos:Concept ;
    skos:definition "Use to designate the elements connecting the central block with the outlying wings of a building of five-part Palladian form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyphens"@en .

aat:300004120 a skos:Concept ;
    skos:definition "Rooms equipped with lockers, often having showers and toilets and sometimes used as dressing rooms, as in clubhouses and gymnasiums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locker rooms"@en .

aat:300004136 a skos:Concept ;
    skos:definition "Living spaces open in part to the outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanais"@en .

aat:300004137 a skos:Concept ;
    skos:definition "Covered, roomlike spaces, open to the outdoors usually through arcades or colonnades; may be contained within or adjacent to buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loggias"@en .

aat:300004143 a skos:Concept ;
    skos:definition "Projecting roofs or porchlike structures that shelter vehicles and passengers at the entrances to buildings; also for short vehicular tunnels through buildings, sheltering an entrance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porte-cochères"@en .

aat:300004152 a skos:Concept ;
    skos:definition "Circular, projecting porticoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyrtostyles"@en .

aat:300004160 a skos:Concept ;
    skos:definition "Porches, platforms, entrance stairways, or small verandas at house doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoops"@en .

aat:300004161 a skos:Concept ;
    skos:definition "High stoops making a quarter turn, reached by a flight of stairs along a building front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box stoops"@en .

aat:300004172 a skos:Concept ;
    skos:definition "Divisions of stables or barns, each accommodating one animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stalls"@en .

aat:300004173 a skos:Concept ;
    skos:definition "Small rooms, cubicles, alcoves, or enclosed study desks, such as in libraries, used for individual or semiprivate study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrels"@en .

aat:300004179 a skos:Concept ;
    skos:definition "Sunny rooms or balconies designed for exposure to the rays of the sun. In ancient Greek and Roman houses, solariums were open sunporches or apartments on the roofs of buildings. In modern usage, may also refer to rooms having large windows, particularly rooms provided for patients in hospitals or clinics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solariums"@en .

aat:300004180 a skos:Concept ;
    skos:definition "Rooms located at the far end of the atriums in ancient Roman houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablina"@en .

aat:300004182 a skos:Concept ;
    skos:definition "Level paved or planted areas, usually elevated above surrounding terrain and adjacent to buildings or parts of garden complexes, or if in a building, in the upper stories or on the roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terraces"@en .

aat:300004184 a skos:Concept ;
    skos:definition "Paved roofless areas of relatively small or medium size associated with architecture, such as a roofless recreation area adjoining a house or a roofless inner courtyard open to the sky of Spanish or Spanish-style buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patios"@en .

aat:300004188 a skos:Concept ;
    skos:definition "Subsidiary parts of buildings extending out from the main portion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wings"@en .

aat:300004197 a skos:Concept ;
    skos:definition "Rooms containing a bathtub or shower, and usually a toilet and lavatory; for rooms containing only a toilet and lavatory, use \"lavatories (rooms);\" for public facilities containing toilets and lavatories, use \"rest rooms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathrooms"@en .

aat:300004203 a skos:Concept ;
    skos:definition "The vapor baths or hot plunges in Roman baths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caldaria"@en .

aat:300004219 a skos:Concept ;
    skos:definition "Hot air baths for inducing sweating; also such rooms in Roman baths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sudatoria"@en .

aat:300004223 a skos:Concept ;
    skos:definition "Dressing rooms in ancient Greek and Roman baths and palaestrae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apodyteria"@en .

aat:300004231 a skos:Concept ;
    skos:definition "In ancient Roman baths, spaces containing water of intermediate temperatures between the caldarium and the frigidarium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tepidaria"@en .

aat:300004233 a skos:Concept ;
    skos:definition "The cold rooms of Roman baths, sometimes including a cold plunge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frigidaria"@en .

aat:300004240 a skos:Concept ;
    skos:definition "Rooms designed for or used to induce sweating by the occupants through the introduction of hot steam into the space, which is often located in a bath, spa, or gym."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam rooms"@en .

aat:300004241 a skos:Concept ;
    skos:definition "Open spaces in rooms that allow for unencumbered movement within them. Circulation spaces can occupy a percentage of a room, or be constructed for the singular purpose of allowing free circulation. For outdoor pedestrian circulation pathways see terms collocated under \"walkways\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circulation spaces"@en .

aat:300004245 a skos:Concept ;
    skos:definition "Airtight spaces permitting passage between spaces of different air pressures or qualities, or between underwater and air-filled spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air locks"@en .

aat:300004246 a skos:Concept ;
    skos:definition "Continuous recesses or grooves built into walls to receive pipes, ducts, and other elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chases"@en .

aat:300004249 a skos:Concept ;
    skos:definition "Inclined or vertical troughs or shafts, for conveying materials of any kind to a lower level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chutes"@en .

aat:300004250 a skos:Concept ;
    skos:definition "Sloping channels through which coal can descend, either on a small scale into the basement of a home or on a large scale in an industrial facility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal chutes"@en .

aat:300004251 a skos:Concept ;
    skos:definition "Sloping channels for the transfer of clothes and linens requiring laundering from upper floors to laundry rooms located on lower floors, either in a home or commercial hotel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundry chutes"@en .

aat:300004253 a skos:Concept ;
    skos:definition "Sloping channels used for transporting trash from upper floors to a lower floor of a building, where it is stored or removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refuse chutes"@en .

aat:300004254 a skos:Concept ;
    skos:definition "Open spaces or halls where crowds may gather, especially by chance coming together, as in a large railroad station."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concourses"@en .

aat:300004257 a skos:Concept ;
    skos:definition "Small spaces provided in a building in order to be able to gain access to plumbing, wiring, and other equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crawl spaces"@en .

aat:300004259 a skos:Concept ;
    skos:definition "Components of structures used for entering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrance spaces"@en .

aat:300004263 a skos:Concept ;
    skos:definition "Passages or rooms just inside the entrance of a residence, but sometimes with a vestibule between it and the outdoors. Prefer \"lobbies\" for such spaces in larger public buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrance halls"@en .

aat:300004264 a skos:Concept ;
    skos:definition "Large halls serving as entrance spaces in public buildings or as anterooms, especially to legislative chambers. For entrance spaces in private houses, use \"entrance halls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lobbies"@en .

aat:300004277 a skos:Concept ;
    skos:definition "Ancient Roman heating systems that circulate hot air from furnaces through subfloor spaces and through flues in walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypocausts"@en .

aat:300004279 a skos:Concept ;
    skos:definition "Areas specially equipped for loading and receiving items onto and from motor vehicles or railroad cars parked adjacent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loading docks"@en .

aat:300004281 a skos:Concept ;
    skos:definition "Vestibules or other peripheral spaces of houses in which wet and muddy clothes or footwear can be removed prior to entering the house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mud rooms"@en .

aat:300004283 a skos:Concept ;
    skos:definition "Relatively narrow spaces designed to provide access; usually interior spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passages"@en .

aat:300004284 a skos:Concept ;
    skos:definition "Includes both passages between sections of seats and the side divisions of buildings where the interior is divided into parts by columns or piers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aisles"@en .

aat:300004294 a skos:Concept ;
    skos:definition "Passages affording access and entrance to the rooms of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corridors"@en .

aat:300004295 a skos:Concept ;
    skos:definition "Corridors or galleries in Roman architecture with windowlike openings, whether subterranean or above ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryptoportici"@en .

aat:300004296 a skos:Concept ;
    skos:definition "Passageways through the exterior walls of buildings and open to the outside through small-scale or slender arcades; found in Italian and German Romanesque architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarf galleries"@en .

aat:300004298 a skos:Concept ;
    skos:definition "Ancient Roman entrance passages leading from the street into buildings, usually houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauces"@en .

aat:300004307 a skos:Concept ;
    skos:definition "Passageways between the walls of the cella of a classical temple and the columns of the peristyle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pteromata"@en .

aat:300004314 a skos:Concept ;
    skos:definition "In Medieval halls, the spaces between the screens (which act as visual barriers) and the doors to the service rooms (buttery, kitchen, pantry)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screens passages"@en .

aat:300004315 a skos:Concept ;
    skos:definition "Areas rising through the centers of buildings, devoted to such service functions as pipe chases, air ducts, elevators, fire stairs, and rest rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service cores"@en .

aat:300004316 a skos:Concept ;
    skos:definition "Well-like passages or enclosed vertical spaces in a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shafts"@en .

aat:300004317 a skos:Concept ;
    skos:definition "Very small courts that are enclosed within the walls of a building and supply ventilation to windows. Prefer \"light courts\" for somewhat larger courts supplying significant light as well as ventilation, or courts supplying only light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air shafts"@en .

aat:300004321 a skos:Concept ;
    skos:definition "Shafts designed to admit light to the interior rooms of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light wells"@en .

aat:300004323 a skos:Concept ;
    skos:definition "Open spaces in a structure intended to allow placement and operation of an escalator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escalator wells"@en .

aat:300004324 a skos:Concept ;
    skos:definition "Spacial openings, often a vertical shaft, containing an indoor stairway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stairwells"@en .

aat:300004326 a skos:Concept ;
    skos:definition "Stairwells equipped with a system that prevents stairwells in highrise buildings from becoming smoke-filled in case of fire. Stairwells are pressurized by using fans or otherwise forcing fresh outside air through air ducts in the building's exterior walls and down the stairwell shafts. As the system pumps increasingly more air into the stairwells, the air pressure rises until it is greater than the air pressure on the building's floors. Given that stairwell doors must open into stairwells in the direction of egress from the building interior, standards are typically in place to regulate the pressure so that it is not too great to prevent ease of opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressurized stairwells"@en .

aat:300004330 a skos:Concept ;
    skos:definition "Rooms in museums in which furnishings are displayed within a historically accurate architectural setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "period rooms"@en .

aat:300004331 a skos:Concept ;
    skos:definition "Rooms or buildings devoted to the display of merchandise for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "showrooms"@en .

aat:300004333 a skos:Concept ;
    skos:definition "Large rooms, halls, or apartments designed or used for festive or state functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquet halls"@en .

aat:300004339 a skos:Concept ;
    skos:definition "Alcoves where light meals are taken; usually containing a built-in table and seating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breakfast nooks"@en .

aat:300004340 a skos:Concept ;
    skos:definition "Small rooms for the morning meal; usually, but not always, adjoining the chief dining room; in northern climates often specially arranged with an eastern exposure to catch the morning sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breakfast rooms"@en .

aat:300004342 a skos:Concept ;
    skos:definition "Self-service establishments providing prepared food and drinks from long counters for on-premise or immediate consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cafeterias"@en .

aat:300004344 a skos:Concept ;
    skos:definition "Small dining areas when they are extensions of living rooms. Use \"dinettes\" when referring to similar spaces that are extensions of kitchens or pantries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dining alcoves"@en .

aat:300004346 a skos:Concept ;
    skos:definition "Use both for large dining rooms, as in a college, and for buildings containing a dining hall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dining halls"@en .

aat:300004347 a skos:Concept ;
    skos:definition "Dining halls of monasteries or other religious institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refectories"@en .

aat:300004348 a skos:Concept ;
    skos:definition "Areas on military bases that serve chiefly as dining halls, rooms or separate buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mess halls"@en .

aat:300004349 a skos:Concept ;
    skos:definition "Rooms in private houses or public establishments in which dinner and other principal meals are taken and which are furnished for this purpose. For particularly large rooms or separate structures for dining, prefer \"dining halls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dining rooms"@en .

aat:300004359 a skos:Concept ;
    skos:definition "Dining rooms in Roman houses; were usually furnished with a low table and surrounded on three sides by couches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triclinia"@en .

aat:300004361 a skos:Concept ;
    skos:definition "Restaurants, usually located below street level, patterned after basements or cellars in German city halls where wine and beer are sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rathskellers"@en .

aat:300004362 a skos:Concept ;
    skos:definition "Rooms or spaces in buildings that are used for sleeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeping spaces"@en .

aat:300004364 a skos:Concept ;
    skos:definition "Rooms designed for or used to contain a bed or beds for sleeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedrooms"@en .

aat:300004367 a skos:Concept ;
    skos:definition "Ancient Roman domestic spaces often considered sleeping chambers, but that may also have functioned as social spaces for more private activities such as polytheistic worship, study, or other personal or intimate uses of the householder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cubicula"@en .

aat:300004369 a skos:Concept ;
    skos:definition "Rooms for dressing and the toilet, usually opening from a bedroom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing rooms"@en .

aat:300004373 a skos:Concept ;
    skos:definition "Women's apartments in ancient Greek or Roman houses. For the sections of Greek houses set aside for men, use \"andra.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gynaecea"@en .

aat:300004376 a skos:Concept ;
    skos:definition "Women's quarters of Islamic houses. For the portions of Islamic houses reserved for men, use \"selamliks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harems"@en .

aat:300004380 a skos:Concept ;
    skos:definition "Rooms or areas set aside and furnished for babies and young children, especially those located in a house and serving as a bedroom or playroom. A nursery differs from a nursery school or day care in that the latter house private or public institutions for the instruction of young children, while a nursery is typically in a private home or an orphanage and facilitates the care of babies in addition to young children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nurseries"@en .

aat:300004382 a skos:Concept ;
    skos:definition "Certain upper floor rooms in Medieval houses that are smaller than halls and reserved for private family use. The form grew out of the Greek and Roman \"solariums (building spaces).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solars"@en .

aat:300004391 a skos:Concept ;
    skos:definition "Parts of ancient Greek houses used only by men. For those sections set aside for women, use \"gynaecea.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "andra"@en .

aat:300004393 a skos:Concept ;
    skos:definition "Rooms, primarily of the 18th century, in which social gatherings and balls (commonly referred to as assemblies) were held."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assembly rooms"@en .

aat:300004394 a skos:Concept ;
    skos:definition "Rooms or entire buildings designed for a variety of activities such as would occur on a stage before a seated audience; for rooms or buildings used only for theatrical performances, use \"theaters;\" for rooms with fixed seating designed for lectures, use \"lecture halls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auditoriums"@en .

aat:300004398 a skos:Concept ;
    skos:definition "Rooms designed or adapted for the holding of conferences, with the room usually focused around a large table and chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conference rooms"@en .

aat:300004413 a skos:Concept ;
    skos:definition "Large rooms designed for formal dancing or any room in which balls are routinely held."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballrooms"@en .

aat:300004414 a skos:Concept ;
    skos:definition "Public lounges or similar rooms in such places as hotels and colleges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common rooms"@en .

aat:300004415 a skos:Concept ;
    skos:definition "In current usage, attached rooms in dwellings or other buildings, having glass wall panels and roofs, often constructed on the back or side of the building and used as a sun room or for growing indoor plants. Usage overlaps with “solariums,” which are typically rooms with large windows. In historical usage, meaning overlaps with \"greenhouses,\" which are typically larger glazed structures devoted to growing and displaying plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservatories"@en .

aat:300004416 a skos:Concept ;
    skos:definition "Small, private, informal rooms in houses or apartments used for work, reading, or relaxation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dens"@en .

aat:300004417 a skos:Concept ;
    skos:definition "Formal reception rooms, as in a home or hotel, or rooms to which one may retire for privacy or rest. Popular in the 18th and 19th century residences of wealthier families, often decorated with the finest furnishings as a symbol of social status. Originally from “withdrawing room,” a private room to withdraw to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing rooms"@en .

aat:300004419 a skos:Concept ;
    skos:definition "Informal living rooms, often adjacent to the kitchen, where a family may gather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "family rooms"@en .

aat:300004420 a skos:Concept ;
    skos:definition "General term for large, open rooms in a residence or public building. In homes, the halls surpass in size and importance the private rooms or bowers, circulation spaces, or storage spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halls"@en .

aat:300004425 a skos:Concept ;
    skos:definition "Halls whose roof is supported by rows of columns giving a forestlike appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypostyle halls"@en .

aat:300004433 a skos:Concept ;
    skos:definition "Rooms located in homes or other buildings and containing books for reading, study, or reference, typically with shelves for the books and a desk or table for users of the library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libraries"@en .

aat:300004434 a skos:Concept ;
    skos:definition "Rooms in clubs, libraries, hotels, or public institutions especially adapted and appropriate to reading and study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading rooms"@en .

aat:300004435 a skos:Concept ;
    skos:definition "Rooms in contemporary residences used for entertaining guests, reading, watching television, or other activities, generally more formal than a den but serving a wider range of activities than a 19th-century parlor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living rooms"@en .

aat:300004436 a skos:Concept ;
    skos:definition "Informal sitting rooms, as in hotels, theaters, airports, and institutional buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lounges"@en .

aat:300004440 a skos:Concept ;
    skos:definition "Sitting rooms, sometimes reserved for women, used during the early part of the day; popular from the early 19th century to the early 20th century, especially in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morning rooms"@en .

aat:300004445 a skos:Concept ;
    skos:definition "Rooms or structures where monarchs or other great personages formally receive visitors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presence chambers"@en .

aat:300004449 a skos:Concept ;
    skos:definition "Chief rooms of state containing the throne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throne rooms"@en .

aat:300004450 a skos:Concept ;
    skos:definition "Rooms furnished for the use of persons waiting, as in railroad stations or medical offices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waiting rooms"@en .

aat:300004451 a skos:Concept ;
    skos:definition "Rooms in homes or public buildings furnished and reserved for recreation and informal entertaining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreation rooms"@en .

aat:300004452 a skos:Concept ;
    skos:definition "Recreation rooms devoted entirely to table games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "game rooms"@en .

aat:300004459 a skos:Concept ;
    skos:definition "Spacious, usually formal and elegantly furnished rooms, used primarily for entertaining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salons"@en .

aat:300004465 a skos:Concept ;
    skos:definition "Rooms or areas in a structure that are allocated for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage spaces"@en .

aat:300004467 a skos:Concept ;
    skos:definition "Small side-rooms or recesses in a structure, usually having a door, built or used for storing clothing, utensils, or provisions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closets"@en .

aat:300004473 a skos:Concept ;
    skos:definition "Rooms devoted to the storage, and sometimes the care, of clothes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wardrobes"@en .

aat:300004479 a skos:Concept ;
    skos:definition "Rooms set apart for the storing of goods or supplies in a home, public building, or ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storerooms"@en .

aat:300004482 a skos:Concept ;
    skos:definition "Rooms or sets of rooms for the systematic maintenance and storage of records and documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archives"@en .

aat:300004483 a skos:Concept ;
    skos:definition "Rooms for receiving, checking, and handling luggage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baggage rooms"@en .

aat:300004487 a skos:Concept ;
    skos:definition "Openings in half-doors, giving entrance to a pantry and over which are served out the contents of the pantry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttery hatches"@en .

aat:300004488 a skos:Concept ;
    skos:definition "Storage places for candles and other lighting devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chandleries"@en .

aat:300004490 a skos:Concept ;
    skos:definition "Rooms kept at low temperatures for the storage of perishable items, such as food, or other items prone to deterioration or pests, such as film or archival materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold storage rooms"@en .

aat:300004498 a skos:Concept ;
    skos:definition "Rooms or closets where food is stored; originally storage spaces primarily used for meat, particularly bacon, from which the term is probably derived (\"lard room\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larders"@en .

aat:300004499 a skos:Concept ;
    skos:definition "Rooms or closets in which food, groceries, and other provisions, or silverware, dishes, and other items are kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantries"@en .

aat:300004506 a skos:Concept ;
    skos:definition "Specially constructed rooms with walls desgined with such sound-absorbency that the interior is as close to total silence as possible. They are generally used for scientific experiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anechoic rooms"@en .

aat:300004507 a skos:Concept ;
    skos:definition "Rooms devoted to formal instruction in schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classrooms"@en .

aat:300004509 a skos:Concept ;
    skos:definition "Rooms in which efforts are made to keep contamination out, including atmospheric pollutants, by the use of air filters, mats, or other devices, as in assembly rooms for precision products or computer rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clean rooms"@en .

aat:300004510 a skos:Concept ;
    skos:definition "In current usage, usually refers to rooms, located in offices or other public or commercial buildings, that are reserved for computer servers and have regulated temperature and humidity suited for the optimum operation and storage of computer equipment. In the recent past, before the advent of networked environments, the term often referred to rooms reserved for a number of stand-alone computers, often in a school or other facility offering training in the use of computers or computer applications; the term may occasionally have this meaning in the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer rooms"@en .

aat:300004511 a skos:Concept ;
    skos:definition "Rooms containing control equipment, common examples being in broadcasting stations, auditoriums, and theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "control rooms"@en .

aat:300004514 a skos:Concept ;
    skos:definition "Rooms intended for the preparation and cooking of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchens"@en .

aat:300004517 a skos:Concept ;
    skos:definition "Small rooms or alcoves fitted with the essential conveniences of a kitchen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchenettes"@en .

aat:300004519 a skos:Concept ;
    skos:definition "Special rooms with sound recording and reproducing equipment for use by students studying languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "language laboratories"@en .

aat:300004520 a skos:Concept ;
    skos:definition "Rooms devoted primarily to the playing of musical instruments or the giving of recitals, as in houses and hotels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music rooms"@en .

aat:300004521 a skos:Concept ;
    skos:definition "Rooms where business, administrative, or professional activities are conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offices"@en .

aat:300004523 a skos:Concept ;
    skos:definition "Rooms off the kitchen for storing and washing dishes and food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculleries"@en .

aat:300004526 a skos:Concept ;
    skos:definition "Rooms designed or used to house heating, laundry, or general maintenance equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility rooms"@en .

aat:300004527 a skos:Concept ;
    skos:definition "Spaces provided for the boilers used for heating, ventilation, or power generation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boiler rooms"@en .

aat:300004530 a skos:Concept ;
    skos:definition "Rooms or groups of rooms equipped for washing, drying, and ironing clothes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundry rooms"@en .

aat:300004531 a skos:Concept ;
    skos:definition "Refers to public or private spaces set aside for manual or light industrial work. It may be used to refer to spaces in which fine art was created, particularly regarding art dating prior to the 16th century. It may also refer to spaces in which woodworkers, furniture makers, pottery makers, glass makers, and other craftspeople work. In the most general sense, it refers to spaces where goods of any type are made, prepared for sale, or sold. In modern usage, the term \"studios\" is generally used to refer to spaces for creating fine art dating from the 16th century to the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workshops"@en .

aat:300004536 a skos:Concept ;
    skos:definition "Rooms or spaces in buildings that are used for health facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health facility spaces"@en .

aat:300004540 a skos:Concept ;
    skos:definition "Hospital areas equipped and staffed for the prompt treatment of acute illness, trauma, or other medical emergencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency rooms"@en .

aat:300004543 a skos:Concept ;
    skos:definition "Divisions, floors, or rooms of hospitals for a particular type or group of patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospital wards"@en .

aat:300004552 a skos:Concept ;
    skos:definition "Areas in hospitals for critically ill patients requiring especially close surveillance and special life-support equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intensive care units"@en .

aat:300004554 a skos:Concept ;
    skos:definition "Intensive care units devoted to the treatment of burn victims."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burn units"@en .

aat:300004555 a skos:Concept ;
    skos:definition "Areas located in a hospital or other health care facility and containing beds and specialized equipment for the care of patients with coronary disease or recovering from heart surgery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronary care units"@en .

aat:300004556 a skos:Concept ;
    skos:definition "Hospital rooms which are equipped with apparatus for meeting post-operative emergencies and in which surgical patients are kept during the immediate post-operative period for care and recovery from anesthesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recovery rooms"@en .

aat:300004559 a skos:Concept ;
    skos:definition "Rooms and other spaces within churches, temples, synagogues, mosques, and other religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious building spaces"@en .

aat:300004560 a skos:Concept ;
    skos:definition "Spaces or rooms located in Christian religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian religious building spaces"@en .

aat:300004565 a skos:Concept ;
    skos:definition "Spaces in Christian churches containing the high altar and reserved for the use of the clergy. Includes the choir when present. Use \"choirs\" for the spaces in Christian churches, generally between the altar area and the nave, reserved for choristers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chancels"@en .

aat:300004573 a skos:Concept ;
    skos:definition "Refers to those areas of a church situated behind the high altar; often found in English Medieval architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retrochoirs"@en .

aat:300004575 a skos:Concept ;
    skos:definition "Refers to the most sacred spaces of religious buildings; in a Christian church, the area containing the main altar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanctuaries"@en .

aat:300004590 a skos:Concept ;
    skos:definition "Rooms or small buildings that serve as sanctuaries or places of Christian worship; often having an altar. A chapel may be used for private worship in or attached to a church, palace, house, prison, monastery, or school. The concept includes both freestanding chapels and rooms or recesses serving as chapels in churches or other buildings. The Latin \"cappella\" or the French-derived \"chappelle\" or \"chapelle\" are occasionally used for \"chapel\" in English texts. In its original meaning, the term referred specifically to the shrine in which the kings of France preserved the cape (cloak) of St. Martin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapels"@en .

aat:300004591 a skos:Concept ;
    skos:definition "Chapels at the west end of Byzantine churches, especially of the Armenian type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiparabemata"@en .

aat:300004593 a skos:Concept ;
    skos:definition "Small apses, especially those which project from a larger apse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apsidioles"@en .

aat:300004599 a skos:Concept ;
    skos:definition "Major chapels dedicated to the Virgin Mary, usually located in the axis of a church at its east end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lady chapels"@en .

aat:300004606 a skos:Concept ;
    skos:definition "Combination of apse, ambulatory, and usually radial chapels of a church, especially French Gothic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevets"@en .

aat:300004607 a skos:Concept ;
    skos:definition "Semicircular or polygonal extensions off of a larger space, such as the termination to the choir or sanctuary in a basilica. May be vaulted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apses"@en .

aat:300004608 a skos:Concept ;
    skos:definition "Refers to apses situated opposite other apses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter apses"@en .

aat:300004614 a skos:Concept ;
    skos:definition "Rooms or buildings used for secret or nonconformist worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conventicles"@en .

aat:300004615 a skos:Concept ;
    skos:definition "Places in churches where a transept crosses the nave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crossings"@en .

aat:300004618 a skos:Concept ;
    skos:definition "Subterranean rooms or entire stories in churches, often serving as places of burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crypts"@en .

aat:300004624 a skos:Concept ;
    skos:definition "Entrance porches in early basilican churches, and for interior vestibules across the western end of later churches. For narthexlike spaces at the west end of some English and French Romanesque and Gothic churches, often used as chapels, prefer \"galilees.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narthexes"@en .

aat:300004625 a skos:Concept ;
    skos:definition "Inner narthexes where there is also an outer narthex (the exonarthex)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "esonarthexes"@en .

aat:300004626 a skos:Concept ;
    skos:definition "The outer narthexes where there is also an inner narthex (the esonarthex)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exonarthexes"@en .

aat:300004627 a skos:Concept ;
    skos:definition "Refers to the main central part of an interior divided into a high center with lower side portions divided by columns or piers, usually but not always in a church. Use also for the main part of a church without aisles but with a distinct chancel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naves"@en .

aat:300004631 a skos:Concept ;
    skos:definition "Rooms in or attached to churches where the sacred vessels and other treasures are kept. Vestments may also be stored here and the space used by the celebrants to dress for the services. For rooms used primarily for dressing for the services, use \"vestries (dressing rooms),\" although in modern usage, particularly for newer and smaller churches, the vestry and the sacristy are often the same room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacristies"@en .

aat:300004635 a skos:Concept ;
    skos:definition "Rooms for keeping the valuables of a church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cimeliarchs"@en .

aat:300004636 a skos:Concept ;
    skos:definition "Sacristies in Orthodox Eastern and Byzantine churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaconica"@en .

aat:300004645 a skos:Concept ;
    skos:definition "Transverse arms of cruciform buildings, usually churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transepts"@en .

aat:300004648 a skos:Concept ;
    skos:definition "The western ends of certain Carolingian and Ottonian churches, having an entrance hall, upper-level chapel, and towers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "westworks"@en .

aat:300004651 a skos:Concept ;
    skos:definition "Spaces or rooms located in temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temple spaces"@en .

aat:300004652 a skos:Concept ;
    skos:definition "Small inner rooms adjacent to or within the naos, found in some ancient temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adyta"@en .

aat:300004658 a skos:Concept ;
    skos:definition "Principal interior chambers or architectural cores of certain religious buildings or sanctuaries. Among examples are ancient Greek architecture, where the naos was the main sanctuary of a temple; in Byzantine architecture, where the naos was typically the area of a centrally planned church reserved for the liturgy; and in Egyptian architecture and art, where the naos was a shrine housing the god or carried in miniature by the god."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naoi"@en .

aat:300004662 a skos:Concept ;
    skos:definition "The recessed porch in the rear of a Greek temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opisthodomoi"@en .

aat:300004670 a skos:Concept ;
    skos:definition "The open vestibule in front of the naos or cella of a temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pronaoi"@en .

aat:300004677 a skos:Concept ;
    skos:definition "Spaces and rooms located in theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theater spaces"@en .

aat:300004678 a skos:Concept ;
    skos:definition "In modern theaters, the entire main-floor space for spectators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchestras"@en .

aat:300004681 a skos:Concept ;
    skos:definition "In ancient Greek and Roman theaters, the structures facing the audience, forming the background before which performances were given and providing space for the players behind the acting area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaenae"@en .

aat:300004688 a skos:Concept ;
    skos:definition "The upper stories of the scene buildings in ancient Greek or Roman theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "episcenia"@en .

aat:300004698 a skos:Concept ;
    skos:definition "In ancient theaters, projecting structures or wings flanking the stage on either side, and with the scaena, or background, enclosing the stage on three sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parascenia"@en .

aat:300004708 a skos:Concept ;
    skos:definition "Stages of ancient Greek and Roman theaters. For the stage podiums of ancient Roman theaters, use \"pulpita.\" For the areas of modern theaters nearest the audience, use \"forestages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proscenia"@en .

aat:300004717 a skos:Concept ;
    skos:definition "Stage podiums of ancient Roman theaters, especially the areas rising above the orchestra. For the stages of ancient Roman theaters, use \"proscenia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulpita"@en .

aat:300004734 a skos:Concept ;
    skos:definition "Tiered, semicircular seating areas in ancient, especially Roman, theaters and amphitheaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caveae"@en .

aat:300004736 a skos:Concept ;
    skos:definition "Refers to the wedgeshaped sections of seats in ancient theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cunei"@en .

aat:300004740 a skos:Concept ;
    skos:definition "Side entrances in ancient Greek theaters between the audience and scaena affording access for spectators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parodoi"@en .

aat:300004744 a skos:Concept ;
    skos:definition "Walkways, concentric with the rows of seats, between the upper and lower seating tiers in a Roman theater. For similar features in Greek theaters, use \"diazomata.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "praecinctiones"@en .

aat:300004751 a skos:Concept ;
    skos:definition "Theatrical platforms, visible to an audience and commonly framed by a proscenium arch, on which performances are carried out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stages"@en .

aat:300004757 a skos:Concept ;
    skos:definition "Use to designate stories wholly or partly underground. For similar spaces used solely for storage, particularly food, prefer \"cellars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basements"@en .

aat:300004759 a skos:Concept ;
    skos:definition "Rooms, often wholly or mostly below ground level, used for storage of food and often other items; for similar areas serving utility purposes or as living spaces, use \"basements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellars"@en .

aat:300004760 a skos:Concept ;
    skos:definition "Cellars in which beer is stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer cellars"@en .

aat:300004761 a skos:Concept ;
    skos:definition "Cellars, partially or wholly underground and usually covered with dirt, where root crops and other crops are stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "root cellars"@en .

aat:300004762 a skos:Concept ;
    skos:definition "Rooms in which wine is stored, in bottles or barrels, usually fully or partially below ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine cellars"@en .

aat:300004772 a skos:Concept ;
    skos:definition "Long, narrow passages leading into chamber tombs and tholoi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dromoi"@en .

aat:300004777 a skos:Concept ;
    skos:definition "Prison cells generally in the form of shafts with openings only at the top; often concealed pits below the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oubliettes"@en .

aat:300004779 a skos:Concept ;
    skos:definition "Underground passages or chambers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "souterrains"@en .

aat:300004790 a skos:Concept ;
    skos:definition "Single structures in the built environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single built works"@en .

aat:300004792 a skos:Concept ;
    skos:definition "Structures, generally enclosed, that are used or intended to be used for sheltering an activity or occupancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buildings"@en .

aat:300004794 a skos:Concept ;
    skos:definition "Refers to constructions of any kind artificially fabricated of parts joined together in some definite manner and which may or may not provide enclosure or shelter. Includes not just buildings, but other structures, for example oil wells, bridges, docks, and railroads. The term normally applies to structures built by humans, but may also apply to those built by other species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structures"@en .

aat:300004803 a skos:Concept ;
    skos:definition "Buildings of five stories or fewer accessible by stairs only; commonly applied to apartment houses and some commercial buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-rise buildings"@en .

aat:300004805 a skos:Concept ;
    skos:definition "Buildings of several floors with large areas of unobstructed space, originally rented for light industrial purposes and now frequently converted to residential occupancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loft buildings"@en .

aat:300004806 a skos:Concept ;
    skos:definition "Buildings having between four or five and nine or ten stories and equipped with elevators; generally applied to commercial buildings and apartment houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mid-rise buildings"@en .

aat:300004809 a skos:Concept ;
    skos:definition "Exceptionally tall buildings of skeletal frame construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skyscrapers"@en .

aat:300004810 a skos:Concept ;
    skos:definition "Buildings over nine or ten stories and served by elevators, especially when such buildings stand out in a skyline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-rise buildings"@en .

aat:300004811 a skos:Concept ;
    skos:definition "Modern high-rise buildings whose main mass rises, with the tall slender proportions of a tower, from a larger low base. For usually detached or isolated buildings or other structures high in proportion to their lateral dimensions, use \"towers (single built works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower buildings"@en .

aat:300004821 a skos:Concept ;
    skos:definition "Three-apsed buildings, usually having a cross plan in which one arm of the cross is a flat-ended narthex and the remaining three arms terminate in apses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triconchs"@en .

aat:300004822 a skos:Concept ;
    skos:definition "Buildings, usually churches, mausoleums, or baptistries, having a cross plan with four apses. Usually the arms of the cross form a Greek cross plan, with arms of equal length. The design was common in Byzantine architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetraconchs"@en .

aat:300004824 a skos:Concept ;
    skos:definition "Simply constructed or small and humble dwellings, generally of natural materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huts"@en .

aat:300004825 a skos:Concept ;
    skos:definition "Vernacular British structures of uncertain construction and purpose, possibly temporary and made of wood with an earthen floor and used for storage of produce, equipment, or animals, popular from the 16th to the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helms"@en .

aat:300004826 a skos:Concept ;
    skos:definition "Small, freestanding structures either open or partially enclosed, where merchandise is displayed, advertised, or sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiosks"@en .

aat:300004828 a skos:Concept ;
    skos:definition "Very large, multipurpose, adaptable structures housing all or most of the functions of a city. For less comprehensive and dominating structures, use \"multipurpose buildings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megastructures"@en .

aat:300004829 a skos:Concept ;
    skos:definition "Multistoried shrine-like towers of stone, brick, or wood, usually associated with a Buddhist temple complex and often crowned by hemispherical or bulbous stupa. A pagoda may comprise open stories of balconies or enclosed floors, generally of diminishing size from bottom to top, often capped with corbeled cornices and pent roofs; this form is seen particularly in Japan. The pagoda derives from the stupa of ancient India, which was a dome-shaped commemorative monument, usually erected over the remains or relics of a holy man or king."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pagodas"@en .

aat:300004836 a skos:Concept ;
    skos:definition "Buildings, as prisons, hospitals, or libraries, so arranged that all parts of the interior are visible from a single point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panopticons"@en .

aat:300004838 a skos:Concept ;
    skos:definition "Monumental structures with a square or triangular base and inclined triangular sides, usually meeting at a point. The most famous pyramids are those used as mausolea in ancient Egypt; they were focal points of much larger funerary complexes. However, pyramids, usually with flat tops, are also found in Central America, where they were used as platforms for altars or temples, occasionally also covering the burial chamber of a ruler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramids"@en .

aat:300004842 a skos:Concept ;
    skos:definition "Round buildings, especially those that are round both outside and inside and covered by domes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotundas"@en .

aat:300004843 a skos:Concept ;
    skos:definition "Medium- or high-rise buildings having smaller depth compared to their length and usually to their height; use to distinguish from \"point blocks\" which are usually towerlike in form and built around a central circulation core."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slab blocks"@en .

aat:300004847 a skos:Concept ;
    skos:definition "Detached or isolated buildings or other structures high in proportion to their lateral dimensions. For parts of buildings with walls rising with vertical proportions considerably above the rest, use \"towers (building divisions).\" For modern high-rise buildings with a towerlike main mass rising from a larger low base, use \"tower buildings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towers"@en .

aat:300004848 a skos:Concept ;
    skos:definition "Towers fitted and prepared for containing bells, can be either freestanding or attached to buildings or other structures. Their footprint can be either round or rectangular (typically square). For the spaces in which bells are hung, use \"belfries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell towers"@en .

aat:300004856 a skos:Concept ;
    skos:definition "Towerlike structures holding bells in Buddhist monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoro"@en .

aat:300004857 a skos:Concept ;
    skos:definition "Towers having the primary function to contain and prominently display a clock or clocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock towers"@en .

aat:300004862 a skos:Concept ;
    skos:definition "Towers used specifically for defense purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defensive towers"@en .

aat:300004863 a skos:Concept ;
    skos:definition "Circular stone towers having a double wall, found in Scotland and neighboring islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brochs"@en .

aat:300004867 a skos:Concept ;
    skos:definition "Towers, often temporary structures, that are constructed for or used to provide support and upright stability on the ground or a launch pad for a rocket, missile, space craft, or other object or vehicle, which is intended to be launched into the air or space; particularly applied to towers constructed for unguided rockets in order to guide the rocket until it reaches speeds fast enough for aerodynamic stabilization to take effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "launch towers"@en .

aat:300004878 a skos:Concept ;
    skos:definition "In the temple architecture of India, towers or spires, usually tapering in a convex curve in a crowning cupola-like roof of superstructure. Includes towers, spires (North India); crowning domes (South India); crowning cupolas (in case of Drāviḍa vimānas); Types: Brahmacchandra (Caturasra), Viṣṇucchandra (Aṣṭāsra), Rudracchanda (Vṛtta), Gajapṛṣṭha (apsidai), Sabhākāra, Śālākāra (wagon-Vault); also north Indian Nāgara/Bhūmija temple’s superstructure"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śikharas"@en .

aat:300004885 a skos:Concept ;
    skos:definition "Buildings the plans of which feature at least one apse, the most common arrangement being one apse at the end of the longitudinal axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apsidal buildings"@en .

aat:300004895 a skos:Concept ;
    skos:definition "Built structures that are used in agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural structures"@en .

aat:300004898 a skos:Concept ;
    skos:definition "Buildings used for the science or art of cultivating the soil, harvesting crops, or raising livestock, not used for human habitation, employment, or processing, and not used by the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural buildings"@en .

aat:300004900 a skos:Concept ;
    skos:definition "Agricultural buildings with large, usually sliding doors, prominent roofs, and predominantly open spaces on the interior, primarily used as storage buildings for hay, grains, and farm equipment and shelters for livestock; does not include those structures, often termed barns, used for the processing of food and other agricultural produce, such as hop barns and tobacco barns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barns"@en .

aat:300004902 a skos:Concept ;
    skos:definition "Two-story barns, usually dug into a hillside thus providing ground-level entrances to both stories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bank barns"@en .

aat:300004903 a skos:Concept ;
    skos:definition "Barns connected, often via intermediate outbuildings, to the main farmhouse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "connected barns"@en .

aat:300004905 a skos:Concept ;
    skos:definition "Relatively large structures used to shelter beef cattle; for relatively large structures for dairy cow housing, use \"dairy barns\"; for relatively small structures used to house dairy or beef cows or bulls, use \"cow houses;\" for relatively small shelters having at least one open wall, use \"cowsheds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle barns"@en .

aat:300004907 a skos:Concept ;
    skos:definition "Relatively large structures for sheltering and milking dairy cows, typically with at least a few dozen stalls and milking equipment; for smaller structures to house only a few cows, use \"cow house\"; for large structures used to provide beef cattle housing, use \"cattle barns\"; for shelters with one or more open sides, use \"cowsheds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dairy barns"@en .

aat:300004908 a skos:Concept ;
    skos:definition "Distinguished from \"stables\" by their barnlike appearance and their use as housing primarily for farm stock, feed, and associated maintenance equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse barns"@en .

aat:300004909 a skos:Concept ;
    skos:definition "Barns constructed or used for the housing of sheep, usually having a pen or pens large enough to contain several sheep or a flock, smaller pens for lambing (giving birth), and areas for shearing, feeding, and watering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheep barns"@en .

aat:300004910 a skos:Concept ;
    skos:definition "Barns built for storing agricultural produce, taxes, or other contributions paid in support of religious establishments or parishes; common in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tithe barns"@en .

aat:300004911 a skos:Concept ;
    skos:definition "Agricultural structures in which tobacco is dried and cured, with or without supplemental heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco barns"@en .

aat:300004918 a skos:Concept ;
    skos:definition "Refers to open-sided structures, set against a barn or other large farm building, for sheltering bovines and for protecting manure piles from the weather to preserve their nutrients. May also refer to any open-fronted shed that provides shelter for cattle kept in yards, whether it has one to three walls and stands alone or is a lean-to set against a barn. Originally such sheds typically formed part of a farmyard group, with barns and other sheds around a central yard. For four-walled buildings designed for the housing of bovines, use either \"cattle barns\" or \"dairy barns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowsheds"@en .

aat:300004920 a skos:Concept ;
    skos:definition "Small, poorly constructed, or very humble dwellings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hovels"@en .

aat:300004922 a skos:Concept ;
    skos:definition "Structures of relatively simple design, erected to aid in the drying by flowing air of, for example, food, textiles, hops, or bricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drying sheds"@en .

aat:300004923 a skos:Concept ;
    skos:definition "Subsidiary agricultural buildings where sheep are sheared and wool is prepared for market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woolsheds"@en .

aat:300004928 a skos:Concept ;
    skos:definition "Buildings comprising large, deep, and narrow storage bins and mechanical conveying systems for the receiving, weighing, storing, and discharging of large quantities of grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain elevators"@en .

aat:300004929 a skos:Concept ;
    skos:definition "Storehouses or other repositories for grain, especially after it has been threshed or husked; sometimes also used to store corn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granaries"@en .

aat:300004938 a skos:Concept ;
    skos:definition "Structures enclosed by glass or other transparent material, and devoted to the cultivation and protection of plants. These are usually free-standing but may be attached to another building. Greenhouses may vary in size, from small sheds to very large buildings, depending on their intended use. For rooms attached to houses and used as sun lounges or for growing indoor plants, prefer \"conservatories.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenhouses"@en .

aat:300004944 a skos:Concept ;
    skos:definition "Greenhouses in which plants are brought to maturity out of season, especially in quantities for market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forcing houses"@en .

aat:300004946 a skos:Concept ;
    skos:definition "Greenhouses designed to store and use solar radiation as an energy source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar greenhouses"@en .

aat:300004949 a skos:Concept ;
    skos:definition "Horticultural facilities where trees, shrubs, and plants are grown for sale and transplanting elsewhere or for use as stocks for budding or grafting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nurseries"@en .

aat:300004950 a skos:Concept ;
    skos:definition "Agricultural buildings in which malt is prepared and stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malthouses"@en .

aat:300004955 a skos:Concept ;
    skos:definition "Subsidiary agricultural buildings for cooling, handling, and processing milk. For agricultural buildings for the making and storing of dairy products in general, use \"dairies (non-mechanized)\" or \"dairy plants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk houses"@en .

aat:300004957 a skos:Concept ;
    skos:definition "Buildings or rooms built or used for the containment of smoke, usually such buildings or rooms where meat or fish is dried or cured by means of dense smoke. Also, rooms or structures in a tannery that are heated by smoldering bark and used to unhair hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smokehouses"@en .

aat:300004958 a skos:Concept ;
    skos:definition "Subsidiary agricultural buildings where sugar is refined, especially those where maple sugar and maple syrup are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar houses"@en .

aat:300004963 a skos:Concept ;
    skos:definition "Refers broadly to the class of agricultural structures that provide shelter for livestock. Two general types of animal shelters may be distinguished: the multipurpose type, a single-story building with clear-span roof construction, useful for feed storage and machinery, as well as for livestock; and the specific type, designed for a particular type of animal. For structures built by animals, such as nests, see \"animal architecture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal housing"@en .

aat:300004966 a skos:Concept ;
    skos:definition "Structures where bees are kept; especially collections of hives or colonies of bees kept for their honey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apiaries"@en .

aat:300004970 a skos:Concept ;
    skos:definition "Receptacles for the habitation of swarms of bees. Natural beehives are made in caves, rock cavities, and hollow trees; some subgenera of bees have exposed aerial combs. The beehive's internal structure is a densely-packed matrix of hexagonal cells made of beeswax, a honeycomb. The bees use the cells to store honey and pollen, and to house eggs, larvae, and pupae. Artificial structures for beehives have been made since ancient times. Early artificial structures were made in a conical or dome-like form using straw or the like, but now artificial beehive structures are often square boxes constructed with movable compartments for the removal of the honey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beehives"@en .

aat:300004971 a skos:Concept ;
    skos:definition "Enclosures, often resembling houses, built as resting, nesting, or feeding places for birds; distinguished from \"aviaries\" by the lack of emphasis on confinement and by their relatively small size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birdhouses"@en .

aat:300004973 a skos:Concept ;
    skos:definition "Relatively large enclosures or cages for confining live birds; distinguished from \"birdhouses\" which are smaller structures that house birds but do not confine them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aviaries"@en .

aat:300004983 a skos:Concept ;
    skos:definition "Enclosures or pens for large livestock such as horses, or cattle or for wild animals such as elephants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrals"@en .

aat:300004984 a skos:Concept ;
    skos:definition "Small houses or dwellings for a dog or a small number of dogs. For larger structures intended to house many dogs, use \"kennels (animal housing).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doghouses"@en .

aat:300004993 a skos:Concept ;
    skos:definition "Establishments where dogs or cats are bred, raised, trained, or boarded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kennels"@en .

aat:300004997 a skos:Concept ;
    skos:definition "Enclosures for pigs that include a low shed and covered fore-court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigsties"@en .

aat:300004999 a skos:Concept ;
    skos:definition "Structures constructed for or used to shelter poultry, which are usually domestic chickens, ducks, geese, turkeys, etc., but excluding game birds. An example of a humane poultry house could have either a large open space provided with food, water, and roosting areas, often with an accessible opening to the outdoors; in large commercial facilities, there may be a series of small pens where two or more animals are confined and raised for meat or to produce eggs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poultry houses"@en .

aat:300005003 a skos:Concept ;
    skos:definition "Broad term for structures housing poultry, whether raised for meat or to lay eggs, and whether a small house or a large commercial structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicken houses"@en .

aat:300005006 a skos:Concept ;
    skos:definition "Buildings or rooms equipped with heated lamps and other equipment used to facilitate the incubation and hatching of chickens' eggs outside the environment of their mothers' nests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicken hatcheries"@en .

aat:300005011 a skos:Concept ;
    skos:definition "Box-like pens built or used for rabbits to inhabit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbit hutches"@en .

aat:300005015 a skos:Concept ;
    skos:definition "Buildings or portions of buildings for the housing and feeding of horses, cattle, and other such domestic animals, and often also for storing riding equipment and vehicles, and which occasionally have living quarters for associated personnel. For barnlike structures used primarily for housing farmstock and feed, see, for example, \"horse barns\" or \"cattle barns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stables"@en .

aat:300005018 a skos:Concept ;
    skos:definition "Agricultural structures built for storing food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage structures"@en .

aat:300005020 a skos:Concept ;
    skos:definition "Structures for storing corn, usually with slotted boards for ventilation, slanted walls for weather protection, and set on stilts to deter rodents. For similar structures made of small-diameter, rough-hewn logs and used variously for food or equipment storage or animal shelter, use \"crib barns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corncribs"@en .

aat:300005021 a skos:Concept ;
    skos:definition "Structures built or used for storage of dry grain, typically rectangular or cylindrical structures erected within a building or under a separate roof and standing alone as a separate structure; the latter are watertight and often constructed of corrugated metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain bins"@en .

aat:300005022 a skos:Concept ;
    skos:definition "Top-loading, bottom-discharging funnels or storage bins, as for crushed stone, sand, or food stuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoppers"@en .

aat:300005024 a skos:Concept ;
    skos:definition "Tall, usually cylindrical, structures in which animal feed is stored and which are normally sealed to exclude air and promote fermentation of green fodder (silage) without spoilage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silos"@en .

aat:300005038 a skos:Concept ;
    skos:definition "In Medieval ecclesiastical contexts, places for the safekeeping of records and other valuable documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chartophylacia"@en .

aat:300005041 a skos:Concept ;
    skos:definition "Ancient Roman archive buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabularia"@en .

aat:300005043 a skos:Concept ;
    skos:definition "Objects or sets of objects that separate, keep apart, demarcate, or serve as deterrents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barriers"@en .

aat:300005044 a skos:Concept ;
    skos:definition "Roofless enclosures, barriers, defenses, or bulwarks, such as a railings, walls, hedges, or palisades constructed along the boundary of a field, park, yard, or another place for the purpose of defending from intruders, marking boudnaries, or keeping livestock or people within."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fences"@en .

aat:300005051 a skos:Concept ;
    skos:definition "Fences formed of a series of vertical posts, stakes, or rods, sometimes sharpened at the upper end, which are joined together by horizontal rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picket fences"@en .

aat:300005052 a skos:Concept ;
    skos:definition "Fences of posts and usually two or three split rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rail fences"@en .

aat:300005054 a skos:Concept ;
    skos:definition "Temporary board fences erected around construction sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoardings"@en .

aat:300005063 a skos:Concept ;
    skos:definition "Designates walls erected around a site to hold back wet earth to permit the construction of, for example, basements, in areas of high groundwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaphragm walls"@en .

aat:300005069 a skos:Concept ;
    skos:definition "Enclosing walls or colonnades surrounding a temenos or sacred enclosure, and hence sometimes applied to the enclosure itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periboloi"@en .

aat:300005072 a skos:Concept ;
    skos:definition "Fortification walls of cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city walls"@en .

aat:300005073 a skos:Concept ;
    skos:definition "Walls that are constructed to resist lateral loads, such as walls that hold back banks of earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retaining walls"@en .

aat:300005080 a skos:Concept ;
    skos:definition "Structures marking entry points into cities, often through defensive walls, fortified, and architecturally distinctive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city gates"@en .

aat:300005090 a skos:Concept ;
    skos:definition "Monumental entrances to sacred enclosures in ancient Greece and Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propylaea"@en .

aat:300005091 a skos:Concept ;
    skos:definition "Monumental gateways to Egyptian temples, consisting of a pair of towerlike structures with slanting walls flanking the entrance portal; may also be used more loosely for any large isolated structures used to mark a boundary, as at approaches to bridges or avenues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pylons"@en .

aat:300005095 a skos:Concept ;
    skos:definition "Four-square structures with two intersecting passageways and four façades. The axes are each symmetrically framed by columnar or arcuated architecture. The term is usually used in the context of monumental ancient Roman architecture. Quadrifrons were often built at right-angled crossroads and typically stood free. Quadrifrons could be triumphal or honorific in nature. Quadrifrons were particularly popular in North Africa. Notable examples are the Arch of Marcus Aurelius at Tripoli and the Janus Quadrifrons in Rome. The term can also refer to a sculptural form most often used as architectural ornamentation consisting of four faces or fronts looking out in four directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrifrons"@en .

aat:300005100 a skos:Concept ;
    skos:definition "Gateways to Shinto shrines, generally composed of two columns and two horizontal spanning members often with slight upward curvature at their ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torii"@en .

aat:300005101 a skos:Concept ;
    skos:definition "Gates of a town giving access to the water, or through which supplies of water are brought or water traffic passes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water gates"@en .

aat:300005103 a skos:Concept ;
    skos:definition "Buildings designed or intended for people to gather. Examples are in auditoriums or similar seating arrangements, for social or civic functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assembly halls"@en .

aat:300005108 a skos:Concept ;
    skos:definition "Ancient Roman places of political assembly for a variety of legal and administrative functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comitia"@en .

aat:300005116 a skos:Concept ;
    skos:definition "Pueblo Indian buildings used as men's clubhouses and for ceremonial and social activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kivas"@en .

aat:300005123 a skos:Concept ;
    skos:definition "Drop-in centers for elderly, ambulatory adults that provide classes and unsupervised activities and programs, but no medical services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senior centers"@en .

aat:300005140 a skos:Concept ;
    skos:definition "Buildings housing the meeting places of the ekklesia or sovereign assembly of an ancient Greek city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ekklesiasteria"@en .

aat:300005144 a skos:Concept ;
    skos:definition "Structures that originated in Greek architecture, comprising freestanding colonnades or covered walkways, or long open buildings with the roof supported by one or more rows of columns parallel to the rear wall. Stoas surrounded marketplaces and sanctuaries, forming places of business and public promenade. Rooms could back onto the colonnade, and a second story was sometimes added. A famous example of a stoa was the great hall at Athens, which was adorned with frescoes of the battle of Marathon, and in which Zeno lectured, giving the name to his disciples, \"Stoics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoas"@en .

aat:300005147 a skos:Concept ;
    skos:definition "Use broadly to refer to buildings associated with any aspect of the various activities and business relationships of industry and trade; when referring to structures associated with the purchase, sale, or exchange of goods in business, use \"mercantile buildings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial buildings"@en .

aat:300005153 a skos:Concept ;
    skos:definition "Commercial establishments where laundering of clothing, linens, and other personal or household textiles is done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundries"@en .

aat:300005158 a skos:Concept ;
    skos:definition "Structures with barriers or counters over which drink or food is served. These may be located in inns, hotels, taverns, railway-stations, or other structures and may refer not only to the counter space itself, but the entire space containing it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bars"@en .

aat:300005166 a skos:Concept ;
    skos:definition "Public refreshment facilities with more emphasis on drinking, normally alcoholic beverages, than on eating or entertainment, which if provided usually occurs in separate, often back rooms, and offering no accommodations; originally a shortening of “public house\". Use \"saloons\" for pubs or bars in the style of the 18th to early 20th century US; use \"taverns\" for establishments offering public accommodations as well as general refreshments, but no entertainment other than social gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pubs"@en .

aat:300005171 a skos:Concept ;
    skos:definition "Public refreshment places with more emphasis on drinking, normally alcoholic beverages, than on eating, especially in the style of the 18th to early 20th century US; use \"pubs\" for similar facilities in other times and places; use \"taverns\" for such establishments offering overnight accommodations as well as food and drink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saloons"@en .

aat:300005172 a skos:Concept ;
    skos:definition "Eating facilities where quick, light meals, refreshments, or snacks are served, usually at a counter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snack bars"@en .

aat:300005173 a skos:Concept ;
    skos:definition "Designated outdoor areas where beer and food are served at communal tables. Often distinguished from other drinking establishments (e.g., bars, saloons) by being family-oriented, and by having chairs and tables rather than a bar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer gardens"@en .

aat:300005174 a skos:Concept ;
    skos:definition "Structures containing establishments that chiefly serve beer and simple food, exemplified by large open rooms with communal seating, after the original Bavarian style. These may be temporary structures erected for events or festivals, chiefly Oktoberfest, and usually include facilities for musical entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer halls"@en .

aat:300005175 a skos:Concept ;
    skos:definition "Refers to informal restaurants in France, or those elsewhere following this French type, that serve simply prepared foods, beers, and ales. First used in English in 1864 to mean a restaurant with an attached brewery, derived from the French \"brasserie\" (lit. \"brewery\"). The emphasis shifted to the restaurant side of the establishment by the 20th century ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brasseries"@en .

aat:300005176 a skos:Concept ;
    skos:definition "Designates informal eating facilities with plated table service, a limited food-oriented menu generally of simply prepared items and coffee, and a social atmosphere emphasizing bustle and noise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cafés"@en .

aat:300005179 a skos:Concept ;
    skos:definition "Public places serving coffee and other refreshments and inexpensive foods; often meeting places for lively political discussions, especially popular in Europe from the 17th to the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffeehouses"@en .

aat:300005182 a skos:Concept ;
    skos:definition "Buildings housing businesses where meals or refreshments are sold and eaten."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restaurants"@en .

aat:300005187 a skos:Concept ;
    skos:definition "Small, usually inexpensive, restaurants with a limited menu of light meals served at counters or tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee shops"@en .

aat:300005188 a skos:Concept ;
    skos:definition "Buildings housing businesses that sell foods already prepared or requiring little preparation for serving, such as cooked meats, cheeses, and salads, to be taken out or to be eaten on the premises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "delicatessens"@en .

aat:300005190 a skos:Concept ;
    skos:definition "Restaurants originally built to resemble a railway dining car. They are sometimes prefabricated and often have a long, narrow floor plan; they are further distinguished by serving short-order menu items, and usually having a counter and booths at which customers may eat. They were originally often located along roadways, although today they may also be found in urban environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diners"@en .

aat:300005191 a skos:Concept ;
    skos:definition "Restaurants optimized for the fast filling of orders, typically focusing on take-away food and offering minimal or no table service. There is usually a limited menu; food is often cooked in bulk in advance and kept hot; and the restaurant usually belongs to a franchise operation that dictates both the menu and design of the restaurant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fast food restaurants"@en .

aat:300005192 a skos:Concept ;
    skos:definition "Restaurants optimized for customers to park and remain in their automobile for service rather than entering the building. They are usually characterized by having rows of sheltered parking areas to which restaurant staff bring food to customers seated in their cars. They usually have a limited menu of fast food, such as burgers and fries. There may be a microphone at each parking slot to allow the placing of orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drive-in restaurants"@en .

aat:300005203 a skos:Concept ;
    skos:definition "Restaurants designed or utilized for dining outdoors at tables surrounding the building, often with tables placed in a patio or on a sidewalk in an urban area, sometimes with a protective roof or umbrellas sheltering the tables. Outdoor seating may be offered only seasonally as weather permits, with additional seating available indoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outdoor cafés"@en .

aat:300005204 a skos:Concept ;
    skos:definition "Establishments where tea and other nonalcoholic refreshments and pastries or light meals are served. For establishments that sell tea leaves, use \"tea stores.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea rooms"@en .

aat:300005206 a skos:Concept ;
    skos:definition "Roadside buildings that may house a combination of facilities such as a restaurant, bar, nightclub, lodging, or gaming. These are often in rural areas or on the outskirts of a town or city, and most typically provide entertainment such as music and dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roadhouses"@en .

aat:300005207 a skos:Concept ;
    skos:definition "Primarily 17th- to early 19th-century English and American places of eating, drinking, and public accommodations, which often became local centers of social gatherings; distinguished from \"inns\" which emphasize their overnight accommodations and also provide food and drinking facilities; for establishments that emphasize drinking, especially liquors, use \"pubs\" or \"saloons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taverns"@en .

aat:300005208 a skos:Concept ;
    skos:definition "Ancient Roman inns that served cooked delicacies and full meals, usually having a narrow, long floor plan with serving boys attending and the proprieter sitting at one end. Cauponae were relatively low-class establishments, distinguished from the better class \"tabernae meritoriae.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauponae"@en .

aat:300005210 a skos:Concept ;
    skos:definition "Early American taverns; also those in England serving meals at a fixed price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordinaries"@en .

aat:300005211 a skos:Concept ;
    skos:definition "Ancient Roman eating places offering predominantly hot meals, usually simple, cheap, and often unsanitary establishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popinae"@en .

aat:300005213 a skos:Concept ;
    skos:definition "Buildings that house institutions that provide financial services for clients or members, usually able to both accept deposits and make loans. Examples include banks, credit unions, savings associations, trust companies, and industrial loan and thrift companies. The interior space is typically optimized for a reception area and general office space, varying greatly depending upon the functions of the specific institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "financial institutions"@en .

aat:300005214 a skos:Concept ;
    skos:definition "Buildings that house establishments for the custody of money received from, or on behalf of, customers, with the essential duty of payment of the orders given on it by the customers. Banks' profits arise mainly from the investment of the money left unused by the customers. Bank buildings typically have indoor counters and windows where customers may make transactions, often with bars or other security devices securing the window, offices where bank officials may meet with customers, vaults for the secure storage of money and other valuables, and other security devices and measures. Exterior bank architecture traditionally imitates a Greek temple, although many other styles are employed as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banks"@en .

aat:300005217 a skos:Concept ;
    skos:definition "Buildings that house banks in a system other than the main or central bank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "branch banks"@en .

aat:300005218 a skos:Concept ;
    skos:definition "Buildings that house banks designed to allow customers to transact business, primarily to make withdrawals and deposits, from their automobiles. Customers typically pull up to a window on the bank building to access automated or human tellers without leaving their cars. Such banks typically also have interior spaces where customers may transact business during designated hours."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drive-in banks"@en .

aat:300005219 a skos:Concept ;
    skos:definition "Buildings that house banks that belong to the Federal Reserve System, which is the central banking system of the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Federal Reserve banks"@en .

aat:300005220 a skos:Concept ;
    skos:definition "Originally referred to buildings that house banks with offices or branches located in vehicles that may be set up in changing locations. The term more recently refers to buildings that house banks that allow financial transactions to be made over mobile devices, such as a cell phone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobile banks"@en .

aat:300005221 a skos:Concept ;
    skos:definition "Buildings that house banks having the primary purpose of taking charge of relatively small sums of money that comprise the savings of members of the population, in contrast to money belonging to corporations or wealthy individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "savings banks"@en .

aat:300005222 a skos:Concept ;
    skos:definition "In modern usage, buildings that house banks that specialize in the exchange of stocks and securities. The term historically refers to buildings in which the merchants of a town assemble for the transaction of business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exchanges"@en .

aat:300005225 a skos:Concept ;
    skos:definition "Structures designed for or containing organized markets where future delivery contracts for graded commodities (as grains, cotton, sugar, coffee, wool) are bought and sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodity exchanges"@en .

aat:300005229 a skos:Concept ;
    skos:definition "Buildings that house a market for the buying and selling of public securities and where an association of brokers and jobbers transact business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock exchanges"@en .

aat:300005230 a skos:Concept ;
    skos:definition "Buildings designed or used by those who are engaged in trade or commerce, specifically professionals involved in the exchange of goods for profit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercantile buildings"@en .

aat:300005232 a skos:Concept ;
    skos:definition "Buildings that house establishments in which works of art are displayed for sale. For buildings where works of art are housed and displayed for public benefit, see \"art museums (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art galleries"@en .

aat:300005234 a skos:Concept ;
    skos:definition "Buildings designed or used for public sales in which each bidder offers an increase upon the price offered by the preceding, the article put up being sold to the highest bidder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auction houses"@en .

aat:300005238 a skos:Concept ;
    skos:definition "Buildings or outdoor areas where trade is conducted, often optimized for a gathering together of people for the purchase and sale produce and livestock. Markets typically have booths or stalls for individual merchants, either in open air or under a single large roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "markets"@en .

aat:300005241 a skos:Concept ;
    skos:definition "Designates ancient Roman meat markets; may also be used more generally for ancient Roman food markets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macella"@en .

aat:300005243 a skos:Concept ;
    skos:definition "Relatively large structures designed or built to house a market, often either under a single large roof or positioned between and around a colonnade in open air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market halls"@en .

aat:300005246 a skos:Concept ;
    skos:definition "Buildings housing large, self-service, retail markets which sell food, household goods, and household merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supermarkets"@en .

aat:300005250 a skos:Concept ;
    skos:definition "Buildings in which the primary activity is shaving and the cutting and grooming mens' beards; also includes the cutting, dressing, or styling the hair of customers, usually men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbershops"@en .

aat:300005253 a skos:Concept ;
    skos:definition "Buildings or parts of buildings designed or used for hairdressing, manicures, facials, and make-up application, typically having stalls or areas for individual hairdressers to do their work, large mirrors, and facilities for hairdryers and other equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beauty shops"@en .

aat:300005257 a skos:Concept ;
    skos:definition "Factories or machine shops in which bodies of vehicles are manufactured or repaired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body shops"@en .

aat:300005258 a skos:Concept ;
    skos:definition "Buildings or parts of buildings housing firms that specialize in making arrangements for the transport and accommodation of travellers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel agencies"@en .

aat:300005261 a skos:Concept ;
    skos:definition "Covered pedestrian passageways lined with shops or booths; usually found in urban settings and often linking two or more thoroughfares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shopping arcades"@en .

aat:300005270 a skos:Concept ;
    skos:definition "Structure or series of structures, either under a single roof or in open air, designed to house multiple retail outlets and to allow free passage of pedestrians on one or more levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shopping malls"@en .

aat:300005279 a skos:Concept ;
    skos:definition "A small shop or a table with enclosed sides for displaying books, magazines, and newspapers for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookstalls"@en .

aat:300005281 a skos:Concept ;
    skos:definition "Open or enclosed stands or tables at which fruit and vegetables are displayed for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "produce stands"@en .

aat:300005282 a skos:Concept ;
    skos:definition "Stands or stalls for the sale of newspapers, magazines, and other printed material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newsstands"@en .

aat:300005283 a skos:Concept ;
    skos:definition "Buildings, either small or large, offering merchandise for retail sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stores"@en .

aat:300005288 a skos:Concept ;
    skos:definition "Plots of land used for the sale or hire of used cars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "used car lots"@en .

aat:300005291 a skos:Concept ;
    skos:definition "Buildings or parts of buildings where bread and other baked goods are prepared; it may include a space for the retail sale of baked goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bakeries"@en .

aat:300005297 a skos:Concept ;
    skos:definition "Buildings housing a business where books are the primary items sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookstores"@en .

aat:300005303 a skos:Concept ;
    skos:definition "Buildings housing businesses where the primary retail trade is the sale of ready-to-wear clothing and accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing stores"@en .

aat:300005305 a skos:Concept ;
    skos:definition "Buildings housing businesses where sweet food items such as candy, cakes, light pastries, icing, and ice cream are produced or sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confectioneries"@en .

aat:300005307 a skos:Concept ;
    skos:definition "Buildings housing retail businesses that include a pharmacy and often sell other articles, such as toilet requisites, stationery, magazines, newspapers, and light refreshments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drugstores"@en .

aat:300005314 a skos:Concept ;
    skos:definition "Buildings housing businesses where flowers and other plants are sold and arranged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "florist shops"@en .

aat:300005321 a skos:Concept ;
    skos:definition "Buildings housing businesses that sell food and some nonedible household goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grocery stores"@en .

aat:300005326 a skos:Concept ;
    skos:definition "Built works housing businesses that sell tools and other items and products needed for home maintenance and repair, such as hammers, saws, nails, plumbing supplies, paint, insecticides, etc. Originally referred to ironmongery shops, where tools made of iron were sold and often also made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardware stores"@en .

aat:300005330 a skos:Concept ;
    skos:definition "Lots or buildings used for storage, cutting, and sale of lumber and wood-related products, particularly lumber used in construction and home improvement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumberyards"@en .

aat:300005336 a skos:Concept ;
    skos:definition "Buildings housing businesses specializing in the retail sale of sporting equipment, such as rackets, balls, clubs, etc., and specialized clothing designed to be worn while playing sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sporting goods stores"@en .

aat:300005337 a skos:Concept ;
    skos:definition "Buildings housing businesses where tea leaves are sold and where brewed tea is sometimes also served. For establishments that do not sell tea leaves, but instead contain tables and specialize in serving brewed tea, coffee, and other light refreshments, use \"tea rooms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea stores"@en .

aat:300005339 a skos:Concept ;
    skos:definition "Buildings housing sales enterprises associated with and usually owned and operated by a company for the convenience of employees, who are often required to shop there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "company stores"@en .

aat:300005341 a skos:Concept ;
    skos:definition "Built works housing relatively small retail outlets located primarily near residential areas, maitaining long hours, and typically carrying a limited line of high-turnover packaged food and other products at high prices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convenience stores"@en .

aat:300005342 a skos:Concept ;
    skos:definition "Built works housing retail outlets that are owned and operated by consumers for their mutual benefit based on open consumer membership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooperative stores"@en .

aat:300005344 a skos:Concept ;
    skos:definition "Large stores selling many different kinds of articles arranged in different departments or areas of the store."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "department stores"@en .

aat:300005346 a skos:Concept ;
    skos:definition "Buildings housing businesses by which small, inexpensive goods of various kinds are sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variety stores"@en .

aat:300005354 a skos:Concept ;
    skos:definition "Buildings housing retail businesses, usually in small or rural communities, that sell a wide variety of merchandise, including food, but are not divided into departments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general stores"@en .

aat:300005356 a skos:Concept ;
    skos:definition "Buildings housing retail businesses where manufacturers sell their stock directly to the public through their own branded stores, typically at prices lower than in other stores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outlet stores"@en .

aat:300005361 a skos:Concept ;
    skos:definition "Buildings housing businesses where goods are sold directly to the ultimate consumers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retail stores"@en .

aat:300005362 a skos:Concept ;
    skos:definition "Buildings housing businesses by which personal movable property is deposited in exchange for money at interest and where unredeemed property is displayed and sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pawnshops"@en .

aat:300005363 a skos:Concept ;
    skos:definition "Buildings housing businesses where customers serve themselves instead of being attended to or waited on by the staff, usually paying for all purchases in one place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-service stores"@en .

aat:300005364 a skos:Concept ;
    skos:definition "Buildings housing businesses that carry a deep assortment within a narrow line of goods, such as furniture stores, florists, sporting goods stores, and bookstores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specialty stores"@en .

aat:300005365 a skos:Concept ;
    skos:definition "Built works housing small, upscale specialty businesses generally specializing in fashionable clothing or accessories or a special collection of other merchandise; may also be used for individual departments within larger stores if featuring a similar line of goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boutiques"@en .

aat:300005366 a skos:Concept ;
    skos:definition "Roman one-room, rectangular chambers opening directly off the street and used primarily as shops or booths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabernae"@en .

aat:300005367 a skos:Concept ;
    skos:definition "Buildings housing retail businesses that sell secondhand goods at reduced prices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thrift shops"@en .

aat:300005368 a skos:Concept ;
    skos:definition "Buildings or outdoor sites set up for purposes of trade, especially in frontier or other a region not fully developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trading posts"@en .

aat:300005371 a skos:Concept ;
    skos:definition "Buildings designed or used for the equipment and personnel necessary for communications, such as telephone service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communications buildings"@en .

aat:300005391 a skos:Concept ;
    skos:definition "Rooms and spaces designed for the origination or recording of radio or television programs; for telecommunications buildings containing facilities for sending and receiving microwave transmissions, use \"broadcasting stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadcasting studios"@en .

aat:300005392 a skos:Concept ;
    skos:definition "Broadcasting studios designed for radio programs; for larger facilities, including offices and equipment, from which the transmissions are sent and received, use \"radio stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio studios"@en .

aat:300005394 a skos:Concept ;
    skos:definition "A series of rooms specifically designed for the origination of live or taped television programs;(MHDSTT) for the larger facilities, including offices and equipment, from where the transmissions are sent and received, use \"television stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television studios"@en .

aat:300005396 a skos:Concept ;
    skos:definition "Buildings or spaces designed or used for audio recording, typically conforming to special acoustical requirements and having specialized equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound studios"@en .

aat:300005397 a skos:Concept ;
    skos:definition "Studios designed or used for creating audio recordings, such as tape and electronic recordings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recording studios"@en .

aat:300005398 a skos:Concept ;
    skos:definition "Rooms or studios made acoustically suitable (as by soundproofing) for producing sound motion pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound stages"@en .

aat:300005399 a skos:Concept ;
    skos:definition "Buildings used for telecommunications business or activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telecommunications buildings"@en .

aat:300005402 a skos:Concept ;
    skos:definition "Broadcasting stations for sending and receiving radio programming transmissions; for rooms and spaces designed for the origination or recording of radio programs, use \"radio studios.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio stations"@en .

aat:300005403 a skos:Concept ;
    skos:definition "Broadcasting stations for sending and receiving television programming transmissions; for rooms and spaces designed for the origination or recording of television programs, use \"television studios.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television stations"@en .

aat:300005404 a skos:Concept ;
    skos:definition "Microwave communications stations set up to send and receive transmissions between other installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relay stations"@en .

aat:300005410 a skos:Concept ;
    skos:definition "Buildings and other structures used for tracking satellites in orbit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite tracking stations"@en .

aat:300005413 a skos:Concept ;
    skos:definition "Buildings or parts of buildings housing equipment and personnel for the transmission and receipt of telegraphs, which comprise information relayed by coded signals over a distance, which was at its height from the mid-19th through early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telegraph offices"@en .

aat:300005414 a skos:Concept ;
    skos:definition "Buildings or other structures housing or supporting telegraph switching or repeater equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telegraph stations"@en .

aat:300005416 a skos:Concept ;
    skos:definition "Buildings housing the central switching point for telephone communications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephone exchanges"@en .

aat:300005421 a skos:Concept ;
    skos:definition "Structures, often tower-like, from which signals are sent to control the movements of railway trains. They typically house the control equipment for signal apparatuses and switches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad signal towers"@en .

aat:300005425 a skos:Concept ;
    skos:definition "General term for structures or other accommodations designed or adapted for residential occupancy, as contrasted to business occupancy. For hotels or other buildings intended for use by transients see \"public accommodations\" and its narrower concepts. For the locale which constitutes the center of an individual's domestic life, personal relationships, and interests, together with the feeling of comfort and satisfaction that it conveys, use \"home (concept).\" For the collective concept referring to types of living arrangements of a particular group, use \"housing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwellings"@en .

aat:300005433 a skos:Concept ;
    skos:definition "Individual dwellings designed to be occupied by a single tenant or family. May also refer to a building for human occupation, for some purpose other than that of an ordinary dwelling; with this usage, \"house\" is generally prefaced (e.g., \"cowhouse,\" \"almshouse\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "houses"@en .

aat:300005440 a skos:Concept ;
    skos:definition "Multiple dwellings comprised of three housing units set one above the other; for dwellings having three housing units set side by side on one level, use \"triplexes (multiple dwellings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-deckers"@en .

aat:300005445 a skos:Concept ;
    skos:definition "Houses with steep gable roofs that extend to ground level on two sides; constructed mostly for vacation and second homes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "A-frame houses"@en .

aat:300005447 a skos:Concept ;
    skos:definition "Designates a class of simple dwellings, circular in plan and with beehive domes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beehive houses"@en .

aat:300005448 a skos:Concept ;
    skos:definition "Masonry, corbel-domed huts found from the Medieval period in Ireland and possibly built to house hermit monks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clochans"@en .

aat:300005451 a skos:Concept ;
    skos:definition "Ancient Roman houses or similarly styled houses containing internal courtyards with impluvia but without colonnades; for houses with internal courtyards having colonnades, use \"peristyle houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atrium houses"@en .

aat:300005452 a skos:Concept ;
    skos:definition "Houses that have internal courtyards with colonnades; for ancient Roman or similarly styled courtyard houses without colonnades but with impluvia, use \"atrium houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peristyle houses"@en .

aat:300005453 a skos:Concept ;
    skos:definition "Houses whose second story projects beyond the first story, usually on the facade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garrison houses"@en .

aat:300005454 a skos:Concept ;
    skos:definition "Houses constructed on stilts above the ground, typically built in hot, moist regions, on water, or on uneven terrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilt houses"@en .

aat:300005455 a skos:Concept ;
    skos:definition "Denotes houses with two stories in front and one in back and with an asymmetrical gable roof where the rear slope is longer than the front slope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saltbox houses"@en .

aat:300005458 a skos:Concept ;
    skos:definition "Houses in which the floor levels of adjacent living areas differ by less than a full story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split-level houses"@en .

aat:300005461 a skos:Concept ;
    skos:definition "Urban dwellings attached in a series of three or more. For individual freestanding urban dwellings use \"town houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "row houses"@en .

aat:300005475 a skos:Concept ;
    skos:definition "Houses having two rows of rooms in each story of the floor plan, often with a corridor between the two rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-pile houses"@en .

aat:300005476 a skos:Concept ;
    skos:definition "Houses having two rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-pen houses"@en .

aat:300005480 a skos:Concept ;
    skos:definition "Refers to central-chimney double-pen houses or for one-and-a-half-story dogtrot houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddlebag houses"@en .

aat:300005481 a skos:Concept ;
    skos:definition "Houses consisting of only a single room, or pen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-pen houses"@en .

aat:300005484 a skos:Concept ;
    skos:definition "Narrow houses of a particular type, in which all the rooms are in line with one another, usually front to back, and directly connected without hallways; often gable-fronted with ample front porches. They were common in the 19th century in southern United States cities, such as in African American communities in New Orleans. The term “shotgun house” is popularly believed to refer to the alignment of front and back doors, as if a bullet shot from the front door would pass through the house without hitting anything and exit through the back door. However, the term may have derived from the word “togun,” a Yoruba word meaning “house” or “gathering place.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shotgun houses"@en .

aat:300005495 a skos:Concept ;
    skos:definition "Small houses or cottages of one story or with a small second story built into a sloping roof, and having a wide porch or veranda. In America, the distinctive form is typified by one- to one-and-a-half-story houses having a low-pitched gable or hipped roof, with widely projecting, often bracketed eaves, dormers, and conspicuous front porches; popular in the United States from the late 19th to the early 20th century. The form is taken from modest one-story English houses, originally with thatched roofs, that themselves are derived from examples in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bungalows"@en .

aat:300005496 a skos:Concept ;
    skos:definition "Small dwellings characteristic of the frontier or other rustic area, especially when built by non-professionals from available logs or stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabins"@en .

aat:300005497 a skos:Concept ;
    skos:definition "Use both for Swiss herdsmen's houses, usually of wood with exposed structural members and overhanging upper floors, and for any house built in the Swiss style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalets"@en .

aat:300005500 a skos:Concept ;
    skos:definition "A small house, usually of only one story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottages"@en .

aat:300005505 a skos:Concept ;
    skos:definition "Side-gabled vernacular buildings of simple massing, normally having their front walls moved inward to make an integral porch under a single steep roofline; the form was originally brought to Louisiana by French Canadian (Acadian) immigrants with a knowledge of long-span roof framing techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Creole cottages"@en .

aat:300005506 a skos:Concept ;
    skos:definition "Ancient Roman single-family dwellings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domus"@en .

aat:300005512 a skos:Concept ;
    skos:definition "Large and imposing Italian urban dwellings or palatial mansions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palazzi"@en .

aat:300005513 a skos:Concept ;
    skos:definition "Designates asymmetrically massed, one-story houses with low-pitched roofs and rambling shapes; may also be used for the main dwelling on ranches. During the late 1940s and 1950s, the ranch house became associated with the work of architect Cliff May (1908-1989), who often used open plan buildings with large areas of glass. The designs became popular and were assimilated by other architects after the publication of two architectural pattern books by \"Sunset\" magazine, \"'Sunset' Western Ranch Houses (San Francisco, 1946) and \"Western Ranch Houses by Cliff May\" (Menlo Park, 1958)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranch houses"@en .

aat:300005515 a skos:Concept ;
    skos:definition "Roughly and often crudely built dwellings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shacks"@en .

aat:300005517 a skos:Concept ;
    skos:definition "Used since the Roman period to designate country houses, generally of some pretension, and often including their outbuildings and gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villas"@en .

aat:300005518 a skos:Concept ;
    skos:definition "Designates Roman villas serving agricultural purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villae rusticae"@en .

aat:300005519 a skos:Concept ;
    skos:definition "Designates often palatial buildings of the Italian Renaissance located just outside of town, suitable for spending the day but usually without bedrooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villae suburbanae"@en .

aat:300005520 a skos:Concept ;
    skos:definition "Designates Roman country houses located near the city and serving recreational, not agricultural purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villae urbanae"@en .

aat:300005522 a skos:Concept ;
    skos:definition "Houses in which the principle gable end faces the street or front of the lot and usually contains the front door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable-front houses"@en .

aat:300005527 a skos:Concept ;
    skos:definition "Dwellings occupied seasonally or for only a few months of the year, as by seminomads, tourists, or migrant workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seasonal dwellings"@en .

aat:300005529 a skos:Concept ;
    skos:definition "Homes in the country used as summer residences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer houses"@en .

aat:300005533 a skos:Concept ;
    skos:definition "Turkish summer mansions, especially when located at waterside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yalis"@en .

aat:300005534 a skos:Concept ;
    skos:definition "Palaces that provide summer, generally rural, retreats for rulers and their courts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer palaces"@en .

aat:300005535 a skos:Concept ;
    skos:definition "Houses that are not the primary residence of the occupants, but are owned, rented, or otherwise occupied primarily seasonally, such as during vacations or otherwise for recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacation houses"@en .

aat:300005542 a skos:Concept ;
    skos:definition "Houses designed by the owner/builder, rather than by a professional architect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "builder-designed houses"@en .

aat:300005546 a skos:Concept ;
    skos:definition "Partly fortified houses often having a vaulted ground floor, usually for livestock, and housing domestic spaces on upper levels; generally found along the English-Scottish border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastle houses"@en .

aat:300005551 a skos:Concept ;
    skos:definition "Houses built to demonstrate to the consumer the layout and features that will or could be included in manufactured houses, often in a subdivision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model houses"@en .

aat:300005555 a skos:Concept ;
    skos:definition "Houses that have been constructed by the owners rather than by a professional building company or architect, whether or not the plan was designed by a professional architect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "owner-built houses"@en .

aat:300005559 a skos:Concept ;
    skos:definition "Houses designed to store and use solar radiation for heat or electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar houses"@en .

aat:300005567 a skos:Concept ;
    skos:definition "Houses in the country as opposed to an urban area, especially houses that are large, have substantial property, and are used seasonally. For the entire residential estate, including the house, outbuildings, and properties, use \"estates (residential complexes).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "country houses"@en .

aat:300005573 a skos:Concept ;
    skos:definition "Country houses, summer houses, or villas in Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dachas"@en .

aat:300005574 a skos:Concept ;
    skos:definition "Chief dwellings attached to farms, particularly a dwelling for the family of a family-owned and -operated farm. Modern farmhouses characteristically comprise two stories with spacious, if modest, rooms and furnishings. Earlier farmhouses were characteristically one-story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farmhouses"@en .

aat:300005579 a skos:Concept ;
    skos:definition "Mansions belonging to, or used by, the lord of a manor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manor houses"@en .

aat:300005582 a skos:Concept ;
    skos:definition "Refers to the primary, and usually largest, residences on plantations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plantation houses"@en .

aat:300005584 a skos:Concept ;
    skos:definition "Houses located away from the urban center in the suburbs, typically segregated from the work place, and often near only limited shopping and entertainment sources. They are typically part of a group of houses having similar floorplans and styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suburban houses"@en .

aat:300005586 a skos:Concept ;
    skos:definition "Multistory, Islamic towerlike dwellings often seasonally occupied and located on the fringes of urban areas, especially in North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borjs"@en .

aat:300005588 a skos:Concept ;
    skos:definition "Houses located on or adjacent to a beach, whether the structure is the primary or seasonal residence of the occupants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach houses"@en .

aat:300005589 a skos:Concept ;
    skos:definition "Houses having the primary living accomodations built around or through the branches of a living tree, whether constructed as an actual dwelling or for the recreation of a child."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tree houses"@en .

aat:300005600 a skos:Concept ;
    skos:definition "Navajo single-family dwellings, generally low and roughly conical, usually constructed of logs and sticks covered with mud, sod, or adobe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hogans"@en .

aat:300005601 a skos:Concept ;
    skos:definition "Eskimo houses usually made of sod, wood, or stone when permanent or of snow blocks in the shape of a dome when built for temporary purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "igloos"@en .

aat:300005605 a skos:Concept ;
    skos:definition "Distinguished from \"log houses\" by being generally more crudely built of timbers left round and joined at the corners by overlapping saddle-shaped notches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log cabins"@en .

aat:300005610 a skos:Concept ;
    skos:definition "Buildings or complexes of buildings in which each unit is individually owned and ownership of common areas and facilities is shared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condominiums"@en .

aat:300005613 a skos:Concept ;
    skos:definition "Groups of similarly designed houses located in subdivisions; used to distinguish from those houses that are custom designed and built."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tract houses"@en .

aat:300005621 a skos:Concept ;
    skos:definition "Structures at, near, over, or surrounding gateways to residences, other buildings, colleges, castles, other fortifications, walls, monasteries, towns, etc.; usually containing a gatekeeper's dwelling. For subordinate buildings on the grounds of estates or parks, that may be used as the dwellings of employees, prefer \"lodges (caretakers' houses)\" or \"entrance lodges.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gatehouses"@en .

aat:300005626 a skos:Concept ;
    skos:definition "Separate residences for guests, particularly when on a private estate or monastery and maintained specifically for receiving visitors. Houses used to provide lodging for paying guests; sometimes used for houses that are used specifically for the entertainment of guests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guesthouses"@en .

aat:300005630 a skos:Concept ;
    skos:definition "Residences of heads of state or other public officials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "official residences"@en .

aat:300005636 a skos:Concept ;
    skos:definition "In the ancient Roman Empire, the official residences of provincial governors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "praetoriums"@en .

aat:300005639 a skos:Concept ;
    skos:definition "Residential structures built to house members of the clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clergy houses"@en .

aat:300005644 a skos:Concept ;
    skos:definition "The offices or residences of a dean, who is a senior clergymen (after the bishop) in cathedral chapters or dioceses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deaneries"@en .

aat:300005646 a skos:Concept ;
    skos:definition "Residences provided for clergymen, chiefly in Scotland; formerly also included the land and outbuildings surrounding the residence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manses"@en .

aat:300005648 a skos:Concept ;
    skos:definition "That part in the eastern arm of a church between the choir and the sanctuary, usually reserved for the clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presbyteries"@en .

aat:300005649 a skos:Concept ;
    skos:definition "Residences provided for parish priests, rectors, or other clergymen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectories"@en .

aat:300005650 a skos:Concept ;
    skos:definition "Residences provided for clergymen, usually vicars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vicarages"@en .

aat:300005656 a skos:Concept ;
    skos:definition "Castles surrounded or partially surrounded by a moat, which is a wide defensive ditch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moated castles"@en .

aat:300005660 a skos:Concept ;
    skos:definition "Designates partially or mostly underground structures or series of rooms and passages, of unclear function, found associated with English Iron Age settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fogous"@en .

aat:300005662 a skos:Concept ;
    skos:definition "Homes built on ledges or dug into the rock in the vertical sides of mesas, bluffs, or cliffs. Examples are those of the ancient American Southwest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cliff dwellings"@en .

aat:300005665 a skos:Concept ;
    skos:definition "Buildings or sets of buildings erected as common living quarters for groups of soldiers or workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barracks"@en .

aat:300005666 a skos:Concept ;
    skos:definition "Rough buildings often with bunk beds, used for sleeping quarters, as for ranch hands, migratory workers, and campers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bunkhouses"@en .

aat:300005668 a skos:Concept ;
    skos:definition "Buildings containing a number of rooms or suites that provide shelter in a communal environment, particularly those at a school, monastery, orphanage, or other such facility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dormitories"@en .

aat:300005671 a skos:Concept ;
    skos:definition "Buildings or parts of buildings housing interns, usually the interns of a hospital or other health facility, interns being the assistant resident physicians, usually students or recent graduates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interns' residences"@en .

aat:300005672 a skos:Concept ;
    skos:definition "Large, rectangular, multifamily dwellings housing related families in separate compartments entered off long corridors; equipped with individual or communal hearths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longhouses"@en .

aat:300005673 a skos:Concept ;
    skos:definition "Group dwellings on or near hospital grounds providing dormitorylike housing for nurses or nursing students."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nurses' residences"@en .

aat:300005674 a skos:Concept ;
    skos:definition "Multi-unit dwellings for seniors, often providing some common facilities for residents, as for social activities and meals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retirement homes"@en .

aat:300005675 a skos:Concept ;
    skos:definition "Houses or parts of houses occupied by enslaved people, who are people treated as the property of another person, whether by capture, purchase, or birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enslaved people's quarters"@en .

aat:300005677 a skos:Concept ;
    skos:definition "Denotes certain Scottish huts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bothies"@en .

aat:300005679 a skos:Concept ;
    skos:definition "Ancient dwellings built on artificial islands in lakes, common in Ireland, Scotland, and Britain; may also be used for the islands themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crannogs"@en .

aat:300005681 a skos:Concept ;
    skos:definition "Watercraft, often wide flat-bottomed boats, outfitted as floating dwellings and not normally designed for rough-water use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "houseboats"@en .

aat:300005686 a skos:Concept ;
    skos:definition "Portable residential units that possess their own chassis with wheels, are designed for year-round living, are infrequently moved, and are larger than travel trailers; use \"travel trailers\" for portable vehicles designed for travel and recreational purposes and for frequent towing. For motorized trucklike vehicles equipped as traveling living quarters, use \"motor homes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobile homes"@en .

aat:300005692 a skos:Concept ;
    skos:definition "Automobile-drawn, wheeled recreational vehicles providing a temporary dwelling or shelter while camping outdoors, often incorporating a folding shelter of canvas or other fabric. Distinguished from \"motor homes,\" which are larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camping trailers"@en .

aat:300005694 a skos:Concept ;
    skos:definition "Collapsible shelters of canvas, skins, plastic, or other flexible and water-repellent material stretched and sustained by poles, usually secured by ropes to pegs in the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tents"@en .

aat:300005697 a skos:Concept ;
    skos:definition "Conical tent dwellings of poles gathered together at the top, spread into a circle on the ground, and covered with skins or canvas; common to Native American tribes of the Great Plains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tipis"@en .

aat:300005700 a skos:Concept ;
    skos:definition "Houses of the Native Americans of the region of the Great Lakes and eastward having typically an arched top and consisting of a framework of poles overlaid with bark, rush mats, or hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wigwams"@en .

aat:300005701 a skos:Concept ;
    skos:definition "Circular tentlike structures consisting of skins or felt stretched over a collapsible lattice framework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yurts"@en .

aat:300005703 a skos:Concept ;
    skos:definition "Dwellings containing two or more complete residential units, each usually occupied by separate households."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiple dwellings"@en .

aat:300005705 a skos:Concept ;
    skos:definition "Hotels providing apartments, usually furnished, to long-term tenants and including some services not available to the general public. For similar housing but providing smaller accommodations for short- or long-term rental at very low rates, often with shared facilities, and fewer services, use \"single room occupancy hotels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apartment hotels"@en .

aat:300005707 a skos:Concept ;
    skos:definition "Buildings, often multiple-story, containing more than one dwelling unit, most of which are designed for domestic use but sometimes including shops and other nonresidential features. Apartment houses have been in use since ancient times, notable examples having been known in ancient Rome and among ancient Native Americans. The apartment house as known today first appeared in Paris and other large European cities in the 18th century, when tall blocks of apartments for middle-class tenants became common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apartment houses"@en .

aat:300005710 a skos:Concept ;
    skos:definition "Apartment houses owned and managed by a corporation in which shares are sold entitling shareholders to occupy individual units in the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooperative apartment houses"@en .

aat:300005712 a skos:Concept ;
    skos:definition "Ground-floor apartments with access to gardens, or the two- or three-story apartment buildings with communal gardens generally located in the suburbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden apartments"@en .

aat:300005727 a skos:Concept ;
    skos:definition "Ancient Sardinian towerlike structures, dating from the Bronze and Iron Ages; generally associated with villages, built on hilltops, and having tapering sides and corbel-vaulted interior spaces. Many are large, but others are small. The purpose and function of the structures are not entirely understood; among the possible uses are location markers, religious temples, rulers' residences, military strongholds, or meeting halls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuraghi"@en .

aat:300005730 a skos:Concept ;
    skos:definition "Buildings containing rental apartments that are in large cities, occupied by poorer people, generally built to minimum standards of sanitation, safety, and comfort, and often in run-down condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenement houses"@en .

aat:300005733 a skos:Concept ;
    skos:definition "Apartment houses offering an improvement over standard long, narrow tenements by including air and light shafts between adjacent buildings resulting in characteristic dumbbell-shaped plans; common in New York City between 1879 and 1901, after which their construction was banned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumbbell tenements"@en .

aat:300005734 a skos:Concept ;
    skos:definition "Official residences, frequently large and impressively appointed, of sovereigns or other high dignitaries; for other large stately dwellings but not official residences, use \"mansions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palaces"@en .

aat:300005736 a skos:Concept ;
    skos:definition "Designates ancient Near Eastern and Anatolian palaces having two long rooms fronted by a portico, often flanked by projecting ells; may also refer to some ancient entrance buildings or gatehouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bît hilani"@en .

aat:300005738 a skos:Concept ;
    skos:definition "Large country houses in France, which prior to the 16th century were usually fortified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "châteaux"@en .

aat:300005740 a skos:Concept ;
    skos:definition "Arabic castles or fortified palaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qasrs"@en .

aat:300005742 a skos:Concept ;
    skos:definition "Palaces in India, especially those of the Islamic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahals"@en .

aat:300005743 a skos:Concept ;
    skos:definition "Palaces for royalty, especially a monarch, usually grander in scale than other palaces and including accommodations for the royal court and its officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal palaces"@en .

aat:300005744 a skos:Concept ;
    skos:definition "Palaces housing an emperor, and often his family, members of the court, and servants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial palaces"@en .

aat:300005748 a skos:Concept ;
    skos:definition "Single buildings or complexes built or used exclusively or primarily for exhibitions, which are organized displays of works of art or other objects of human making. Exhibition buildings may be permanent facilities or temporary structures, as at a world's fair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition buildings"@en .

aat:300005755 a skos:Concept ;
    skos:definition "Exhibition buildings used specifically for exhibiting animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal exhibition buildings"@en .

aat:300005756 a skos:Concept ;
    skos:definition "Buildings containing large tanks with transparent, usually glass, sides in which aquatic animals and plants are kept alive for purposes of observation, study, and display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquariums"@en .

aat:300005759 a skos:Concept ;
    skos:definition "Aquariums focusing on life in saltwater, especially ocean environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine aquariums"@en .

aat:300005766 a skos:Concept ;
    skos:definition "Buildings, including associated outdoor areas, in which elephants are kept for show, especially in zoos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elephant houses"@en .

aat:300005767 a skos:Concept ;
    skos:definition "Structures used for seasonal exhibitions having to do with the harvest, often decorated annually with corn, grain, grasses, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn palaces"@en .

aat:300005768 a skos:Concept ;
    skos:definition "Refers to buildings, groups of buildings, or spaces within buildings where objects of value such as works of art, antiquities, scientific specimens, or other artifacts are housed and displayed for public benefit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museums"@en .

aat:300005775 a skos:Concept ;
    skos:definition "Buildings or spaces for museums that are administered by the county, an administrative subdivision in the U.S., the U.K., and other nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "county museums"@en .

aat:300005777 a skos:Concept ;
    skos:definition "Buildings or spaces for museums that are owned or administered by representatives of multiple nations, or that specializes in exhibitions from multiple nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international museums"@en .

aat:300005809 a skos:Concept ;
    skos:definition "Buildings housing museums with exhibits aimed at an audience of children and their education, for example, with texts written at a child's level of understanding and hands-on exhibits intended to maintain a child's interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's museums"@en .

aat:300005811 a skos:Concept ;
    skos:definition "Buildings or spaces for museums that are administered by a company, often highlighting the history or products of the company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "company museums"@en .

aat:300005813 a skos:Concept ;
    skos:definition "Buildings set aside to honor outstanding individuals as in a profession, locality, or nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halls of fame"@en .

aat:300005814 a skos:Concept ;
    skos:definition "Rooms or buildings containing a systematically ordered collection of preserved plants; for gardens of herbs, use \"herb gardens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbaria"@en .

aat:300005815 a skos:Concept ;
    skos:definition "Houses with historical importance locally, regionally, or internationally that have been restored and opened to the public as museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic house museums"@en .

aat:300005818 a skos:Concept ;
    skos:definition "Buildings housing museums administered by a historical society, which is a group formed to study and disseminate information about the history of a place, usually a town, city, county, or state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical society museums"@en .

aat:300005819 a skos:Concept ;
    skos:definition "Industrial buildings or complexes converted into museums or as part of museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial museums"@en .

aat:300005821 a skos:Concept ;
    skos:definition "Buildings housing museums dealing with the sea in general, navigation, or shipping, as distinct from \"naval museums,\" which deal with navies, warships, or ships in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maritime museums"@en .

aat:300005826 a skos:Concept ;
    skos:definition "Buildings housing museums that primarily house weapons, armor, uniforms, ammunition, documents, maps, photographs, and other records and artifacts of military forces, leaders, wars, and battles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military museums"@en .

aat:300005827 a skos:Concept ;
    skos:definition "Buildings housing museums dealing with navies, warships, or ships in general; distinct from \"maritime museums,\" which deal with the sea in general, navigation, or shipping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval museums"@en .

aat:300005830 a skos:Concept ;
    skos:definition "Buildings housing museums specializing in the history of postage stamps, revenue stamps, stamped envelopes, postmarks, post cards, covers, and similar materials relating to postal or fiscal history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philatelic museums"@en .

aat:300005832 a skos:Concept ;
    skos:definition "Buildings housing museums focusing on the history, tenets, writings, music, architecture, or objects associated with religion, either of one particular religion or on the general topic of religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious museums"@en .

aat:300005841 a skos:Concept ;
    skos:definition "Buildings housing museums specializing in the history of and objects associated with fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishery museums"@en .

aat:300005849 a skos:Concept ;
    skos:definition "Buildings housing museums that specialize in the history, objects, vehicles, and other materials associated with flight and space travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical museums"@en .

aat:300005851 a skos:Concept ;
    skos:definition "Buildings housing museums that focus specifically on the history of space travel and astronauts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronautical museums"@en .

aat:300005856 a skos:Concept ;
    skos:definition "Buildings housing museums that specialize in works made from wax, often realistic duplications of actual objects or sculptural portraits of people, especially historical characters. Human figures in wax museums are often dressed in real clothing and posed as if carrying out representative activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wax museums"@en .

aat:300005866 a skos:Concept ;
    skos:definition "Buildings associated with pre-burial ceremonies or buildings for the dead erected at burial sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary buildings"@en .

aat:300005868 a skos:Concept ;
    skos:definition "Buildings housing facilities for the preparation of human remains for burial or cremation and for formal viewing of and services for the deceased. Although meaning overlaps in common usage, they are often distinguished from \"mortuaries,\" which do not typically have rooms or areas for formal viewings and services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral homes"@en .

aat:300005870 a skos:Concept ;
    skos:definition "Funerary buildings used for the preparation or storage of human remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary preparatory buildings"@en .

aat:300005871 a skos:Concept ;
    skos:definition "Places that reduce human corpses to ashes for the purpose of disposing of them; may also refer to places that cremate animal corpses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crematories"@en .

aat:300005874 a skos:Concept ;
    skos:definition "Ancient Roman enclosures for cremation and for deposition of cremation urns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "busta"@en .

aat:300005876 a skos:Concept ;
    skos:definition "Designates ancient Roman places for burning corpses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ustrina"@en .

aat:300005878 a skos:Concept ;
    skos:definition "Buildings or parts of buildings designed or used for the hygienic temporary storage of corpses prior to disposal. A morgue typically contains large refrigerated drawers or other areas for storage of individual bodies, and tables and equipment for the identification and examination of the corpses. The term derives from the proper name of a particular building in Paris in which the bodies of the dead were kept until identified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morgues"@en .

aat:300005879 a skos:Concept ;
    skos:definition "Buildings housing facilities for the care, planning and preparation of human remains for burial or cremation. While the meaning may overlap in common usage with \"funeral homes,\" generally mortuaries have more extensive facilities for preparing the body and funeral homes have a parlor or other area for formal viewing of and services for the deceased. In modern usage, the term \"mortuaries\" may also refer to facilities that prepare the bodies of pets for burial or cremation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortuaries"@en .

aat:300005880 a skos:Concept ;
    skos:definition "Circular stone platforms or towers erected on hills on which Parsees of India dispose of their dead according to the Zoroastrian rite. Such towers, built of stone or brick, are about 25 feet high and have gratings on which the dead are left. After the corpses have been devoured by vultures, the bones fall into a pit below, thereby satisfying the Zoroastrian injunction that corpses, which are seen as extremely polluting, should not defile the earth or have contact with fire. The actual towers are seen as threats to purity and therefore can only be entered by professional corpse-bearers who take ritual precautions before entering and undergo rites of purification after leaving the profession. Some members of the Zoroastrian community want to abandon this ancient way of disposing of the dead but others staunchly adhere to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towers of silence"@en .

aat:300005881 a skos:Concept ;
    skos:definition "Funerary buildings used for rites related to burials and funerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepulchral buildings"@en .

aat:300005884 a skos:Concept ;
    skos:definition "Tombs built as round or rectangular towerlike structures of stone or adobe found predominantly in pre-Inca Peru and Bolivia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chullpas"@en .

aat:300005888 a skos:Concept ;
    skos:definition "Shrines or small chapels dedicated to a hero, demigod, or person of great dignity; may or may not be located over a grave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heroa"@en .

aat:300005891 a skos:Concept ;
    skos:definition "Edifices erected as commemorative burial places, often but not exclusively limited to large, stately, or imposing edifices for or by a person of distinction. The word is derived from the burial place of Mausolus, ruler of Caria, in whose memory his widow Artemisia raised a splendid tomb at Halicarnassus (ca. 350 BCE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mausoleums"@en .

aat:300005894 a skos:Concept ;
    skos:definition "Mausoleums in tower form, particularly in Indian, Persian, and Turkish regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gumbads"@en .

aat:300005896 a skos:Concept ;
    skos:definition "In Islamic India, mausoleums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rauzas"@en .

aat:300005897 a skos:Concept ;
    skos:definition "Places where the bones of the dead are deposited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ossuaries"@en .

aat:300005903 a skos:Concept ;
    skos:definition "Piles of earth erected over grave sites; for piles of stones built over grave sites, use \"cairns\"; for piles of earth used generally and not over burials, use \"mounds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial mounds"@en .

aat:300005904 a skos:Concept ;
    skos:definition "Refers to flights of steps, found in India, that lead down to the banks of rivers or other bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghats"@en .

aat:300005906 a skos:Concept ;
    skos:definition "Raised structures, often canopied, on which the coffin or effigy of a deceased person lies or is carried in state. It is distinguished from a \"bier,\" which is much smaller and simpler, and from a \"castrum doloris,\" which is a structure that shelters the bier or catafalque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catafalques"@en .

aat:300005907 a skos:Concept ;
    skos:definition "Excavations in the earth used for burial of a deceased human, sometimes of animals; for constructions raised over or around burial sites, use \"tombs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graves"@en .

aat:300005908 a skos:Concept ;
    skos:definition "Combustible heaps for burning the dead as a funeral rite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyres"@en .

aat:300005909 a skos:Concept ;
    skos:definition "Structures marking or denoting burial sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepulchral monuments"@en .

aat:300005912 a skos:Concept ;
    skos:definition "Slender, towerlike structures erected in cemeteries to contain a light and often an altar; common in Medieval France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanterns of the dead"@en .

aat:300005916 a skos:Concept ;
    skos:definition "Large stones on which to rest a coffin momentarily at the entrance of a cemetery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lich stones"@en .

aat:300005923 a skos:Concept ;
    skos:definition "Refers to stones or metal plates designating graves or tombs, almost always located outdoors, usually vertically-placed freestanding slabs or slabs placed horizontally on the ground, over graves or at the entrances of tombs. In early use, referred to the covers of stone coffins or the stone coffins themselves. For stones placed flush with the floor over a tomb in an interior space, use \"tomb slabs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tombstones"@en .

aat:300005926 a skos:Concept ;
    skos:definition "Elaborations constructed over or around burial sites; for simple interments in the earth, use \"graves.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tombs"@en .

aat:300005928 a skos:Concept ;
    skos:definition "Tombs or tomb monuments whose location or decoration resembles that of altars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar tombs"@en .

aat:300005930 a skos:Concept ;
    skos:definition "Circular masonry tombs, primarily of Mycenaean Greece, constructed with a corbeled dome, entered via a long walled passageway, and covered by a mound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tholos tombs"@en .

aat:300005931 a skos:Concept ;
    skos:definition "Includes underground tomb chambers or groups of such chambers and the vaults of those and similar underground structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypogea"@en .

aat:300005933 a skos:Concept ;
    skos:definition "Used to designate ancient Egyptian rectangular brick tombs with sloping sides and a flat top built over a burial chamber cut down into the rock below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mastabas"@en .

aat:300005934 a skos:Concept ;
    skos:definition "Communal burial places with chambers of large upright stone slabs supporting large capstones, with or without an entry passage, and set in a mound of earth or stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megalithic chamber tombs"@en .

aat:300005935 a skos:Concept ;
    skos:definition "Communal burial places, cut into rock or hillslopes or constructed of masonry, whose chamber may or may not have an entry passage, usually covered by a mound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber tombs"@en .

aat:300005939 a skos:Concept ;
    skos:definition "Distinguished from \"passage graves\" by the lack of internal distinction between burial chamber and access passage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallery graves"@en .

aat:300005941 a skos:Concept ;
    skos:definition "Boxlike graves, normally rectangular and meant for single burial, dug into the ground and often lined with stone slabs and covered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cist graves"@en .

aat:300005946 a skos:Concept ;
    skos:definition "General term for tombs constructed for royal deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal tombs"@en .

aat:300005947 a skos:Concept ;
    skos:definition "Coffins made of stone or terracotta, generally ornamented with sculpture or carving and of a size large enough to contain the entire body. Antique examples were often extensively decorated with relief sculpture, which were highly influential on Renaissance artists. Many sarcophagi were also produced in the Baroque and Neoclassical eras. Pliny explains that the derivation of the word (\"flesh eating\" in Greek) refers specifically to coffins of limestone from the Troad (the region around Troy), which was believed to cause rapid dissolving of the body; more probably, the term refers to various religious and folkloristic ideas that resulted in calling any coffin a body eater. The word came into general use as the name for any large stone coffin in imperial Rome, and is now generally used to refer to large, ornate stone coffins from any period or place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarcophagi"@en .

aat:300005951 a skos:Concept ;
    skos:definition "Graves consisting of deep, rectangular or round vertical or angled tunnels or shafts, or such shafts located above larger burial chambers. Examples are found at ancient Greek, Mycenaen, Egyptian, other Middle Eastern, Pre-Columbian, and Asian sites. The custom particularly flourished in the late Bronze Age (ca. 1600-1450 BCE), when the Greek mainland came under the cultural influence of Crete. To refer exclusively to the graves at Mycenae and other Bronze Age Greek sites, use \"Shaft Grave period.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaft graves"@en .

aat:300005968 a skos:Concept ;
    skos:definition "Public buildings used for judicial function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judicial buildings"@en .

aat:300005979 a skos:Concept ;
    skos:definition "Public buildings in the United States that house county-level judicial and administrative facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "county courthouses"@en .

aat:300005993 a skos:Concept ;
    skos:definition "Designates buildings with office space for various departments or branches of government as well as space for public access to government officials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government office buildings"@en .

aat:300006004 a skos:Concept ;
    skos:definition "Buildings housing the body of government officers known as \"ministers,\" typically ministers of state or secretaries of state, who are high level officials responsible for the administration of a country or state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ministries"@en .

aat:300006010 a skos:Concept ;
    skos:definition "Offices used to provide job listings to those seeking employment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "employment agencies"@en .

aat:300006013 a skos:Concept ;
    skos:definition "Government offices or office buildings used for examining claims to patents and for granting patents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patent offices"@en .

aat:300006014 a skos:Concept ;
    skos:definition "Buildings housing the legislative bodies of a government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legislative buildings"@en .

aat:300006015 a skos:Concept ;
    skos:definition "Council chambers of ancient Greek cities, the place where the Boulé, a senate, met."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouleuteria"@en .

aat:300006019 a skos:Concept ;
    skos:definition "Buildings in the United States that are occupied by a legislature; may also house one or more of the other branches of government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capitols"@en .

aat:300006027 a skos:Concept ;
    skos:definition "Council houses in Roman municipalities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curiae"@en .

aat:300006029 a skos:Concept ;
    skos:definition "Legislative buildings in countries with parliamentary forms of government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parliament buildings"@en .

aat:300006031 a skos:Concept ;
    skos:definition "Buildings where currency and special medals are produced under government authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mints"@en .

aat:300006036 a skos:Concept ;
    skos:definition "Public buildings within a government postal system at which mail is received and sorted, from which it is distributed, and at which stamps are sold and other services rendered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post offices"@en .

aat:300006043 a skos:Concept ;
    skos:definition "Buildings housing offices concerned with health matters, disaster management, and other issues surrounding the public safety of a community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public safety buildings"@en .

aat:300006044 a skos:Concept ;
    skos:definition "Buildings housing firefighting apparatus and, usually, firefighters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire stations"@en .

aat:300006049 a skos:Concept ;
    skos:definition "Headquarters for the police of a particular district, from which police officers are dispatched and to which persons under arrest are brought."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police stations"@en .

aat:300006050 a skos:Concept ;
    skos:definition "Rooms or spaces that serve as storage places for valuable objects. For buildings designed for this purpose use 'treasuries (buildings).'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treasuries"@en .

aat:300006051 a skos:Concept ;
    skos:definition "Ancient Roman public treasury buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeraria"@en .

aat:300006054 a skos:Concept ;
    skos:definition "Buildings occupied by the principal offices and departments of city or town governments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal buildings"@en .

aat:300006057 a skos:Concept ;
    skos:definition "Town hall buildings in smaller Italian communities, especially in Lombardy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broletti"@en .

aat:300006061 a skos:Concept ;
    skos:definition "Public buildings in the United Kingdom that house various county functions, often comprising a large hall for public meetings and rooms for county courts and administration; for structures housing similar judicial functions in the United States, use \"county courthouses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "county halls"@en .

aat:300006062 a skos:Concept ;
    skos:definition "Municipal buildings in France and other French-speaking countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hôtels de ville"@en .

aat:300006063 a skos:Concept ;
    skos:definition "Principal public administration buildings of towns and villages housing offices for transaction of government business and places for public assembly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "town halls"@en .

aat:300006073 a skos:Concept ;
    skos:definition "Facilities designed to convey or control the flow of water, including channels, bridges, dams, and other such constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic structures"@en .

aat:300006075 a skos:Concept ;
    skos:definition "Artificial navigable waterways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canals"@en .

aat:300006077 a skos:Concept ;
    skos:definition "Artificial channels or troughs for conducting water, as for transporting logs or providing water power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flumes"@en .

aat:300006079 a skos:Concept ;
    skos:definition "Canals that join two oceans, or an ocean and another body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interoceanic canals"@en .

aat:300006082 a skos:Concept ;
    skos:definition "Artificial passages of wood or masonry, a dam or embankment, used for impounding the water of river, stream, or canal, and fitted with a valve or gate for stopping or regulating the flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sluices"@en .

aat:300006084 a skos:Concept ;
    skos:definition "Barriers to confine, control, or obstruct the flow of water. One typical use of a dam is to raise the level of water significantly for water storage in a reservoir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dams"@en .

aat:300006086 a skos:Concept ;
    skos:definition "Dams that resist water pressure by use of the arch principle and having, in plan, the form of a single arch abutted by natural rock formation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch dams"@en .

aat:300006087 a skos:Concept ;
    skos:definition "Refers to dams, usually concrete, constructed as a series of buttresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttress dams"@en .

aat:300006088 a skos:Concept ;
    skos:definition "Watertight enclosures from which water is pumped to expose an area in order to permit construction or repairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cofferdams"@en .

aat:300006090 a skos:Concept ;
    skos:definition "Dams that resist water pressure by their own weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravity dams"@en .

aat:300006092 a skos:Concept ;
    skos:definition "Artificial dams of a type placed in a watercourse to divert water, as into a channel for navigation or irrigation; barrages raise the water level by only a few feet and are not used for the purpose of water storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrages"@en .

aat:300006093 a skos:Concept ;
    skos:definition "Low walls that protect property or for other purposes slow the runoff from heavy rains or other occasional waterfall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "check dams"@en .

aat:300006094 a skos:Concept ;
    skos:definition "Barriers built across waterways to turn aside all or some of the flow from its usual course into a pipe, trench, or channel, as to bypass construction work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diversion dams"@en .

aat:300006095 a skos:Concept ;
    skos:definition "Dams constructed to store floodwaters temporarily or to supply a surge of water, as for clearing a channel of logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flood dams"@en .

aat:300006101 a skos:Concept ;
    skos:definition "Barriers or dams across waterways to regulate water level or divert or measure water flow, for example, to drive a mill wheel or as constructed on a canal or navigable river to retain the water and prevent overflow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weirs"@en .

aat:300006102 a skos:Concept ;
    skos:definition "Walls or dams to divert the flow of runoff or other superfluous water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wasteweirs"@en .

aat:300006107 a skos:Concept ;
    skos:definition "Dams using earth or rock as fill, utilizing natually available materials with minimum processing to construct embankments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth dams"@en .

aat:300006108 a skos:Concept ;
    skos:definition "Dams built mainly of rocks of various sizes with a waterproof case or covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-fill dams"@en .

aat:300006109 a skos:Concept ;
    skos:definition "Dams in which the embankment is constructed in successive mechanically compacted layers, using sheepsfoot rollers or heavy pneumatic-tired rollers to compact the fill. Rolled-fill is the most commonly used method of earth dam construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolled-fill dams"@en .

aat:300006111 a skos:Concept ;
    skos:definition "Dam constructed of multiple types of soil material, such as clay, fine sand, rocks, and silt. The fill is zoned by systematic distribution of materials according to their strength and permeability characteristics, generally built over an impervious core. In cross section, the dam is divided into zones, with the central zone made of relatively impervious clay, and transition zones used to cover both faces and prevent piping through cracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoned earth dams"@en .

aat:300006116 a skos:Concept ;
    skos:definition "Drainage structures that extend across and beneath roadways, canals, embankments, or traveled ways other than bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culverts"@en .

aat:300006122 a skos:Concept ;
    skos:definition "Underground conduits for carrying away waste and storm water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewers"@en .

aat:300006124 a skos:Concept ;
    skos:definition "Underground conduits for drainage of sewage, most commonly used to refer to those in ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloacae"@en .

aat:300006125 a skos:Concept ;
    skos:definition "Sewers that receive both storm water and sewage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combined sewers"@en .

aat:300006127 a skos:Concept ;
    skos:definition "Sewers that carry industrial or residential liquid and solid wastes but not ground, surface, or storm waters. For parts of building plumbing systems designed to dispose of similar wastes, use \"sanitary drainage systems.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanitary sewers"@en .

aat:300006128 a skos:Concept ;
    skos:definition "Underground conduits for carrying away overflow water from rain or a storm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm sewers"@en .

aat:300006130 a skos:Concept ;
    skos:definition "Sewers that receive sewage from a relatively small area and are connected to main sewers or manholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "branch sewers"@en .

aat:300006131 a skos:Concept ;
    skos:definition "Sewers into which empty the dry-weather flows from several branch sewers or outlets and which also may receive a certain amount of storm water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intercepting sewers"@en .

aat:300006132 a skos:Concept ;
    skos:definition "Sewers that discharge into branch or other sewers and have no other common sewer tributary to them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lateral sewers"@en .

aat:300006135 a skos:Concept ;
    skos:definition "Sewers that receive the sewage from the collecting system and conduct it to a point of final discharge or to a disposal plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outfall sewers"@en .

aat:300006136 a skos:Concept ;
    skos:definition "Protective walls, pipes, or other structures designed to allow water to flow away from an area in order to avoid erosion of the soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erosion protection works"@en .

aat:300006137 a skos:Concept ;
    skos:definition "Raised structures, usually located offshore, built to protect an area from waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breakwaters"@en .

aat:300006139 a skos:Concept ;
    skos:definition "Breakwaters constructed of dry-stacked masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blockwork breakwaters"@en .

aat:300006142 a skos:Concept ;
    skos:definition "Breakwaters comprising a mound of rubble, having a core of small rocks or rubble to provide the basic stability, with an outer covering of larger boulders, or armoring, to protect it from removal by the sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mound breakwaters"@en .

aat:300006148 a skos:Concept ;
    skos:definition "Baskets or cages filled with earth or rocks and used generally for support or abutment, especially for erosion protection; may also be used for military works, flood control, harbor works, dams, and foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gabions"@en .

aat:300006151 a skos:Concept ;
    skos:definition "Impermeable, rigid barriers built out from a bank of a river or stream diverting the current to prevent or encourage scour. For similar structures located at the seashore, use \"groins (erosion protection works)\"; when such structures are built to control shoaling, use \"jetties (erosion protection works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wing dams"@en .

aat:300006154 a skos:Concept ;
    skos:definition "Structures in riverways that regulate flow and play key roles in flood control and water utilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic gates"@en .

aat:300006155 a skos:Concept ;
    skos:definition "Structures extending from the shore into a body of water and built to influence current or protect the entrance to a harbor or river from shoaling. For similar structures built to control or direct seashore erosions, use \"groins (erosion protection works)\"; use \"wing dams\" when such erosion control structures occur along banks of rivers or streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jetties"@en .

aat:300006156 a skos:Concept ;
    skos:definition "Embankments built to prevent flooding of low-lying land. For embankments built to control or retain flood waters of rivers or seas, use the more \"dikes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "levees"@en .

aat:300006158 a skos:Concept ;
    skos:definition "Layers, facings, or protective embankments comprised of large irregular and randomly placed stones to prevent erosion, scour, or sloughing; also the stone so used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riprap"@en .

aat:300006159 a skos:Concept ;
    skos:definition "Walls built as breakwaters specifically to protect land from erosion or other damage due to wave action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seawalls"@en .

aat:300006161 a skos:Concept ;
    skos:definition "Dams, canals, and other structures designed to protect an area from flooding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flood protection works"@en .

aat:300006162 a skos:Concept ;
    skos:definition "Dikes, canals, pumps, and other structures and equipment used to create dry land in an area that otherwise would be flooded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land reclamation works"@en .

aat:300006163 a skos:Concept ;
    skos:definition "Areas of low-lying land reclaimed from the sea, a river, or other body of water, and enclosed by dikes. For a piece of marshy or boggy land, use \"marshes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polders"@en .

aat:300006164 a skos:Concept ;
    skos:definition "Irrigation canals, pipes, pumps, and other structures and equipment for distributing water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water distribution structures"@en .

aat:300006165 a skos:Concept ;
    skos:definition "Man-made conduits for carrying water over long distances, usually by means of gravity, particularly structures that include channels and elevated sections on bridgelike structures, optimized by the Romans and based on inventions of earlier cultures. The term derives from Latin aqua, meaning \"water,\" and ducere, meaning \"to lead.\" In modern engineering, the term refers to any system of pipes, ditches, canals, tunnels, and supporting structures used to convey water from its source to its main distribution point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aqueducts"@en .

aat:300006167 a skos:Concept ;
    skos:definition "Underground irrigation systems consisting of tunnels that are inclined from a water source and connected to the surface by a series of regularly spaced vertical shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qanats"@en .

aat:300006169 a skos:Concept ;
    skos:definition "Structures or areas forming a central collection point where silt- or debris-laden water flows or is pumped to allow the particulates to settle at the bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settling basins"@en .

aat:300006173 a skos:Concept ;
    skos:definition "Areas or structures where storm water runoff is captured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm water retention basins"@en .

aat:300006175 a skos:Concept ;
    skos:definition "Buildings for water storage and distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conduits"@en .

aat:300006178 a skos:Concept ;
    skos:definition "Long narrow excavations, usually with sloping sides, dug in the earth for defense, drainage, or irrigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ditches"@en .

aat:300006179 a skos:Concept ;
    skos:definition "Structures with apertures designed to allow water to spout or flow periodically or continuously, as for amenity or public access."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fountains"@en .

aat:300006181 a skos:Concept ;
    skos:definition "Plumbing fixtures consisting of a water jet and often a shallow basin designed to provide potable water for human consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking fountains"@en .

aat:300006182 a skos:Concept ;
    skos:definition "Large usually circular sinks, as in industrial plants, in which a spray of water activated by a foot pedal allows several workers to wash simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washfountains"@en .

aat:300006184 a skos:Concept ;
    skos:definition "Fountains for ritual cleansing, usually associated with religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablution fountains"@en .

aat:300006185 a skos:Concept ;
    skos:definition "Openings through which air or a fluid enters a plenum, pipe, or system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intakes"@en .

aat:300006187 a skos:Concept ;
    skos:definition "Installations with equipment for raising water in water distribution systems to a higher elevation; may be used for similar structures in sewage systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumping stations"@en .

aat:300006191 a skos:Concept ;
    skos:definition "Artificial ponds or lakes where water is accumulated and retained until needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reservoirs"@en .

aat:300006192 a skos:Concept ;
    skos:definition "Roman water distribution structures, usually reservoirs, constructed at locations where water delivered by an aqueduct is diverted to various points in town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castelli aquae"@en .

aat:300006201 a skos:Concept ;
    skos:definition "Reservoirs, typically but not exculsively of water, located below the surface of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground reservoirs"@en .

aat:300006202 a skos:Concept ;
    skos:definition "Tanks or vertical pipes connected to water-supply systems and used to insure uniform pressure or to store water for emergency use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standpipes"@en .

aat:300006203 a skos:Concept ;
    skos:definition "Hydraulic structures designed to store water for various purposes, including drinking, bathing, irrigation, fire suppression, and industrial processes. Water tanks may be of various sizes and materials, but the term is generally used for structures or containers of relatively larger size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water tanks"@en .

aat:300006204 a skos:Concept ;
    skos:definition "Elevated reservoirs, usually in the shape of towers, into which water is pumped to maintain desired pressure throughout a distribution system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water towers"@en .

aat:300006207 a skos:Concept ;
    skos:definition "Holes, pits, or other generally vertical excavations cored, bored, drilled, or otherwise constructed in the earth for purposes of drawing out various liquids, such as water, brine, or petroleum, or natural gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wells"@en .

aat:300006209 a skos:Concept ;
    skos:definition "Wells bored into a confined aquifer which overflow the wellhead, because the water level of the aquifer lies above the level of the wellhead; the water rises under its own pressure through the borehole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artesian wells"@en .

aat:300006210 a skos:Concept ;
    skos:definition "Constructions of India, often architecturally embellished, with steps deeply cut down to a water-drawing area; used also as shelters from the heat. Below ground water reservoirs having stairways down to the water level. Most common in India and Pakistan, the structures may be decorative, elaborate, and multistoried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepwells"@en .

aat:300006213 a skos:Concept ;
    skos:definition "Wells constructed by driving lengths of pipe or other conduits into the ground with percussion equipment or by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driven wells"@en .

aat:300006215 a skos:Concept ;
    skos:definition "The system of buildings, hydraulic structures, machinery, and other equipment by which a water supply is obtained, conveyed, and distributed to consumers in cities, towns, or neighborhoods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterworks"@en .

aat:300006218 a skos:Concept ;
    skos:definition "Facilities for receiving waste, usually raw sewage, from surrounding homes and businesses for the purpose of removing contaminants and other materials that could damage water quality and the environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewage treatment plants"@en .

aat:300006225 a skos:Concept ;
    skos:definition "Facilities of the public water system designed to purify by altering the physical, chemical, biological, or radiological quality of the water or to remove any contaminants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water treatment plants"@en .

aat:300006226 a skos:Concept ;
    skos:definition "Facilities for extracting the salt from seawater in order to produce fresh water, which is water with a very low content of dissolved salt, as opposed to brackish water or salt water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desalination plants"@en .

aat:300006227 a skos:Concept ;
    skos:definition "Facilities that specialize in filtration of water, which is a method of purification that typically passes water through various filtering agents. Water filtration was developed for large scale implementation in 19th-century Germany. In slow-filtration methods, the water is allowed to pass through a deep layer of fine sand. In rapid-filtration plants, the water is treated with a coagulant, such as aluminum sulfate, ferric chloride, or ferric sulfate, which flocculates particles; suspended matter to the bottom in sedimentation tanks and the water is passed at a relatively rapid rate through small beds of coarse sand. Heavily polluted waters may be chlorinated both before and after filtration. Aeration, involving the mixing of air with the water, is carried out if undesirable amounts of iron and manganese are present, since they are held in solution in water only in the absence of oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filtration plants"@en .

aat:300006231 a skos:Concept ;
    skos:definition "Refers to buildings or groups of buildings intended to house the machinery and activities associated with modern industry and machine manufacture that arose after the Industrial Revolution, beginning in the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial buildings"@en .

aat:300006232 a skos:Concept ;
    skos:definition "Refers to a building or group of buildings with the function of housing the action or process of making goods or producing anything, whether before or after the Industrial Revolution of the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factories"@en .

aat:300006239 a skos:Concept ;
    skos:definition "Factories where parts for a complete unit are put together, as in automobile manufacturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assembly plants"@en .

aat:300006245 a skos:Concept ;
    skos:definition "Designates experimental facilities, usually small scaled-down versions of a planned plant, built to test manufacturing processes and generally gain experience prior to operating the final facility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilot plants"@en .

aat:300006247 a skos:Concept ;
    skos:definition "Facilities of relatively large size where the printing of books or other materials takes place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing plants"@en .

aat:300006252 a skos:Concept ;
    skos:definition "Buildings containing facilities for the recovery and reuse of materials and energy from waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resource recovery facilities"@en .

aat:300006254 a skos:Concept ;
    skos:definition "Buildings or other industrial installations where a material, such as sugar, oil, metal, etc., is refined, meaning it is purified, clarified, distilled, or otherwise treated, typically by a series of industrial processes, to make the material purer or of a finer quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refineries"@en .

aat:300006262 a skos:Concept ;
    skos:definition "Large rooms where sails are cut out, fabricated, and maintained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sail lofts"@en .

aat:300006263 a skos:Concept ;
    skos:definition "High towers, usually round, in which shot is made by dropping molten lead from an upper story into a cistern of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shot towers"@en .

aat:300006270 a skos:Concept ;
    skos:definition "Refers to a device utilizing a water wheel or otherwise operated by water with the purpose of running a mill to grind grain or to produce or process a product. It may also typically refers to the building or structure housing or supporting the device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water mills"@en .

aat:300006272 a skos:Concept ;
    skos:definition "Mills operated by the tidal currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tide mills"@en .

aat:300006273 a skos:Concept ;
    skos:definition "Buildings or devices with sails or vanes that turn in the wind and generate power. The devices operate by means of a rotating shaft on which sails are mounted or placed at an angle so that the force of wind against them causes rotation, which in turn produced energy. Windmills were historically used chiefly in flat districts for operating a mill to grind grain or pump water; the older and most characteristic European form consists of a conical mill-house with a dome or cap supporting four sails. Modern devices tap the wind to produce electricity by using a disk of sails mounted on a framework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "windmills"@en .

aat:300006274 a skos:Concept ;
    skos:definition "Windmills having a polygonal tower with sloping sides, with sails mounted on a rotating cap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smock mills"@en .

aat:300006278 a skos:Concept ;
    skos:definition "Factories where bricks are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brickworks"@en .

aat:300006286 a skos:Concept ;
    skos:definition "Buildings equipped with machinery for grinding grain into flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour mills"@en .

aat:300006296 a skos:Concept ;
    skos:definition "Mills or other buildings where iron or steel is smelted or otherwise processed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironworks"@en .

aat:300006302 a skos:Concept ;
    skos:definition "Buildings or parts of buildings where tanning occurs, which is the treating of hides or skins with tannins to produce leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanneries"@en .

aat:300006304 a skos:Concept ;
    skos:definition "Establishments primarily engaged in producing surfaced lumber, by cutting, smoothing, and matching wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planing mills"@en .

aat:300006306 a skos:Concept ;
    skos:definition "Factories in which logs are converted to lumber by running them through a series of saws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawmills"@en .

aat:300006308 a skos:Concept ;
    skos:definition "Facilities that are primarily engaged in the manufacture of paper or paper products, usually from wood, recycled paper, or other fiber pulp. Originally water-driven, modern paper mills are typically powered electrically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper mills"@en .

aat:300006309 a skos:Concept ;
    skos:definition "Mills or factories where wood is reduced to paper pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulp mills"@en .

aat:300006310 a skos:Concept ;
    skos:definition "Establishments that specialize in making clay pottery, such as earthen pots or vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potteries"@en .

aat:300006311 a skos:Concept ;
    skos:definition "Facilities where steel is processed and rolled into sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel mills"@en .

aat:300006316 a skos:Concept ;
    skos:definition "Steel mills where, usually hot, metal is passed between rollers to produce steel of a prescribed thickness or cross-sectional form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling mills"@en .

aat:300006318 a skos:Concept ;
    skos:definition "Facilities or equipment that pulverize or finely grind crushed ore or another material by placing it in a revolving cylinder containing steel rods, balls, loose flints, or pebbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tube mills"@en .

aat:300006319 a skos:Concept ;
    skos:definition "Facilities for crushing stone, minerals, or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crushing plants"@en .

aat:300006321 a skos:Concept ;
    skos:definition "Facilities where textiles and textile products are created, often including the weaving and sewing processes, as well as the preparation of the fibers or other materials from which textiles are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile mills"@en .

aat:300006323 a skos:Concept ;
    skos:definition "Facilities for processing cotton and creating cotton fabrics, including spinning and weaving machinery. Such mills particularly flourished 1775-1930."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotton mills"@en .

aat:300006327 a skos:Concept ;
    skos:definition "Facilities that spin and weave wool into fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woolen mills"@en .

aat:300006329 a skos:Concept ;
    skos:definition "Textile mill structures where the bleaching of cloth is done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleacheries"@en .

aat:300006330 a skos:Concept ;
    skos:definition "Facilities for the dyeing and cleaning of cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dyeworks"@en .

aat:300006332 a skos:Concept ;
    skos:definition "Buildings housing the looms for weaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaving sheds"@en .

aat:300006335 a skos:Concept ;
    skos:definition "Facilities housing operations by which raw foodstuffs are made suitable for consumption, cooking, or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food processing plants"@en .

aat:300006340 a skos:Concept ;
    skos:definition "Facilities where drinking water is treated and sealed in bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottling plants"@en .

aat:300006341 a skos:Concept ;
    skos:definition "Buildings or complexes of buildings where beer, and often other malt beverages, are brewed, generally involving mechanized processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breweries"@en .

aat:300006343 a skos:Concept ;
    skos:definition "Buildings built after the early 19th century, not found only on farms, for the mechanized processing, storing, or selling of milk and milk products. Distinguished from \"dairies (non-mechanized)\" by the use of mechanization. For subsidiary agricultural buildings devoted primarily to the care of milk, often with little or no mechanization, prefer \"milk houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dairy plants"@en .

aat:300006346 a skos:Concept ;
    skos:definition "Facilities where the distilling and blending of spirits is carried on, including processes by which evaporation of water and subsequent condensation of the alcoholic beverage is achieved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distilleries"@en .

aat:300006348 a skos:Concept ;
    skos:definition "Facilities or location where the harvesting of fish, shellfish, and sea mammals is carried out as a commercial enterprise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fisheries"@en .

aat:300006353 a skos:Concept ;
    skos:definition "Facility where livestock are slaughtered, processed, and packed as meat products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packing plants"@en .

aat:300006354 a skos:Concept ;
    skos:definition "Places where animals are killed for food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slaughterhouses"@en .

aat:300006356 a skos:Concept ;
    skos:definition "Enclosed spaces with pens, stables, and sheds, where beef cattle are confined for fattening prior to market; usually associated with a railroad line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stockyards"@en .

aat:300006358 a skos:Concept ;
    skos:definition "Refers to a facility devoted to the production of high-quality sugars from remelted raw cane sugar or from remelted and recrystallized lower-grade beet syrups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar refineries"@en .

aat:300006359 a skos:Concept ;
    skos:definition "Establishments for making wine, which is the fermented juice of the grape used as a beverage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wineries"@en .

aat:300006361 a skos:Concept ;
    skos:definition "Buildings associated with a mine, which is series of pits or tunnels made underground for the extraction of metals or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mine buildings"@en .

aat:300006366 a skos:Concept ;
    skos:definition "Buildings in which electricity or other forms of power are generated for the operation of machinery or vehicles, or supplying power to other buildings in a complex. Dstinguished from \"power plants\" which are larger complexes producing power on a much larger scale for a community, and which can include a \"power plant building\" on the premises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powerhouses"@en .

aat:300006367 a skos:Concept ;
    skos:definition "Structures, often made of steel or reinforced concrete, enclosing a nuclear reactor and designed to contain the escape of radiation to the environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reactor containment buildings"@en .

aat:300006389 a skos:Concept ;
    skos:definition "Buildings that are subordinate to other industrial structures, though used by the occupants of the primary structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessory industrial buildings"@en .

aat:300006392 a skos:Concept ;
    skos:definition "Buildings or parts of buildings housing facilities for use by the employees for activities not strictly required for the job, such as a break room, meeting rooms, lockers, human resources offices, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "employees' buildings"@en .

aat:300006396 a skos:Concept ;
    skos:definition "Kilns used to convert coal into coke, characterized by a dome-shaped roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beehive ovens"@en .

aat:300006399 a skos:Concept ;
    skos:definition "Long cylindrical kilns lined with refractory, inclined at a slight angle, and rotated at slow speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotary kilns"@en .

aat:300006401 a skos:Concept ;
    skos:definition "Kilns, often used for mass-produced ceramics, consisting of a continuous conveyor belt or railcar operation with the ware traversing the kiln and gradually being heated from room temperature, through a hot zone, and back down to room temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tunnel kilns"@en .

aat:300006403 a skos:Concept ;
    skos:definition "Kilns used to fire cement to a stage less than complete melting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cement kilns"@en .

aat:300006404 a skos:Concept ;
    skos:definition "Furnace-type apparatus, usually long, tilted cylinders, that are slowly rotated; used to heat calcium carbonate above 900 degrees centigrade to produce lime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime kilns"@en .

aat:300006408 a skos:Concept ;
    skos:definition "Places where metal and other substances are cut and shaped by machine tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine shops"@en .

aat:300006410 a skos:Concept ;
    skos:definition "Establishments specializing in repairs, for example, of automobiles, railway cars, shoes, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repair shops"@en .

aat:300006411 a skos:Concept ;
    skos:definition "Refers to modest outbuildings used for shelter or storage. A shed is usually one story, typically has one or more open sides, and may be covered by a lean-to roof with one high pitched plane covering the entire structure. It may be leaning against a permanent structure or standing alone. The special purpose of the shed is typically indicated by a defining word prefixing (e.g., \"cowshed,\" \"woodshed,\" \"train shed\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheds"@en .

aat:300006417 a skos:Concept ;
    skos:definition "Closed refractory chambers in which coal is converted to coke by carbonization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coke ovens"@en .

aat:300006423 a skos:Concept ;
    skos:definition "Industrial structures built to support mining activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mine structures"@en .

aat:300006425 a skos:Concept ;
    skos:definition "Vertical or near-vertical tunnels accessing underground mines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mine shafts"@en .

aat:300006426 a skos:Concept ;
    skos:definition "Structures that supports the drill and other machinery used in drilling for oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil rigs"@en .

aat:300006429 a skos:Concept ;
    skos:definition "Platforms used to support machinery for drilling oil or gas wells in water-covered locations, usually on submergered continental shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offshore drilling platforms"@en .

aat:300006433 a skos:Concept ;
    skos:definition "The structures inclined toward the water on which a ship may be built or lowered into the water; may also be used for the guides that support the ship's hull."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipways"@en .

aat:300006438 a skos:Concept ;
    skos:definition "Large, vertical structures for smelting iron from ore, using a solid fuel, designed so as to direct a continuous blast of air through the fuel to assure a high rate of combustion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blast furnaces"@en .

aat:300006443 a skos:Concept ;
    skos:definition "Bulk delivery points for electrical power, from which it is distributed to consumers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric substations"@en .

aat:300006446 a skos:Concept ;
    skos:definition "Outdoor poles installed by utility companies to support telephone, electric, or other cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility poles"@en .

aat:300006448 a skos:Concept ;
    skos:definition "General term for buildings or groups of buildings in which people accused or convicted of breaking the law may be confined and which may or may not attempt some form of reform or rehabilitative correction of offenders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "correctional institutions"@en .

aat:300006457 a skos:Concept ;
    skos:definition "Buildings that house places of confinement operated by a local government both for temporary detention of sentenced and unsentenced individuals and for persons serving sentences of less than one year; for longer periods of confinement and more secure than lockups, but less confining and for shorter confinements than prisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jails"@en .

aat:300006460 a skos:Concept ;
    skos:definition "Buildings or other facilities to which people are legally committed as punishment for a crime or while awaiting trial. In North America, the term specifically denotes a facility run by the state or federal government for those who have been convicted of serious crimes, in contrast to a locally run facility for those awaiting trial or convicted of minor offences. As developed since the late 18th century, prisons are generally characterized by cell and corridor plans with separation by offense and sex, and programs of rehabilitation provided as means toward prisoner reform. Use \"jails (buildings)\" for places for offenders sentenced either for lesser crimes or relatively short terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prisons"@en .

aat:300006463 a skos:Concept ;
    skos:definition "Ancient Roman domestic buildings used for the confinement of enslaved workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ergastula"@en .

aat:300006466 a skos:Concept ;
    skos:definition "Buildings that house prisons populated by prisoners who can be reasonably trusted to not to try to escape; the term is often used in British prison systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open prisons"@en .

aat:300006477 a skos:Concept ;
    skos:definition "Buildings that house places of detention primarily for debtors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "debtors' prisons"@en .

aat:300006479 a skos:Concept ;
    skos:definition "Buildings housing prisons administered by a federal government, in the U.S., those managed by the U.S. Federal Bureau of Prisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federal prisons"@en .

aat:300006481 a skos:Concept ;
    skos:definition "Buildings that house prisons administered by the state, particularly a state in the U.S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state prisons"@en .

aat:300006483 a skos:Concept ;
    skos:definition "Buildings housing penal institutions that provide educational and vocational training among other methods for reforming behavior of youthful offenders or first offenders of minor crimes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reformatories"@en .

aat:300006490 a skos:Concept ;
    skos:definition "Buildings that housed places of confinement and labor for those unable to pay debts, common particularly during 17th-19th century in Europe and America. For buildings housing similar institutions intended to provide punishment and reformation of the criminal, use \"houses of correction (buildings).\" For welfare buildings providing charitable care for low income individuals, use \"almshouses (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workhouses"@en .

aat:300006495 a skos:Concept ;
    skos:definition "General term for individual buildings or groups of buildings designed or used as places of instruction, typically having one or more classrooms where students may sit at desks and listen to an instructor, often including a library and other areas having books, computers, or other items necessary for the lessons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schools"@en .

aat:300006503 a skos:Concept ;
    skos:definition "Buildings that house privately run schools with programs organized as an alternative to traditional public or private schools, usually with a highly flexible or voluntaristic framework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free schools"@en .

aat:300006505 a skos:Concept ;
    skos:definition "Buildings that house boarding schools, which are educational institutions at the elementary-secondary level in which students are in residence while enrolled in an instructional program."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boarding schools"@en .

aat:300006509 a skos:Concept ;
    skos:definition "Buildings housing educational institutions, usually elementary or secondary schools, where classes are held only on weekdays and that do not provide any boarding facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day schools"@en .

aat:300006511 a skos:Concept ;
    skos:definition "Buildings that house schools that train people for careers in the armed forces and for private schools organized following the discipline and dress codes of military life; both offer courses in military training and both are generally at university level with degree-granting programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military academies"@en .

aat:300006515 a skos:Concept ;
    skos:definition "Buildings that house schools or educational facilities admnistered by the navy, particularly those that provide undergraduate level education for prospective naval officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval schools"@en .

aat:300006535 a skos:Concept ;
    skos:definition "Buildings that house schools devoted to the professional study of the organization and management of commercial enterprises, usually at the baccalaureate level and above. For buildings that house schools devoted to training students in the clerical aspects of business and commerce, use \"business colleges (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business schools"@en .

aat:300006537 a skos:Concept ;
    skos:definition "Buildings that house schools for training students in the clerical aspects of business and commerce, such as typing and bookkeeping; for buildings containing schools devoted to the professional study of the aspects of commercial enterprise, use \"business schools (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business colleges"@en .

aat:300006539 a skos:Concept ;
    skos:definition "Buildings that house schools devoted to training dentists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental schools"@en .

aat:300006548 a skos:Concept ;
    skos:definition "Buildings that house schools, generally associated with universities, sponsoring degree-granting programs in a broad range of subjects pertaining to the field of music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music schools"@en .

aat:300006550 a skos:Concept ;
    skos:definition "Generally designates buildings that house independent professional schools of music emphasizing advanced instruction in performance for singers, conductors, and musicians; usually granting certificates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music conservatories"@en .

aat:300006558 a skos:Concept ;
    skos:definition "Buildings that house four-year colleges offering courses for the training of primary and secondary school teachers and granting bachelor's degrees and often advanced degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teachers colleges"@en .

aat:300006562 a skos:Concept ;
    skos:definition "Buildings that house children's day schools teaching Jewish subject matter or the Hebrew language or both, usually synagogue-based and operated under Conservative or Reform Jewish auspices. For buildings that house Orthodox Jewish day schools, use \"yeshivas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hebrew schools"@en .

aat:300006563 a skos:Concept ;
    skos:definition "Buildings that house Islamic theological or law schools, especially when associated with a mosque, or generally for places of study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madrasas"@en .

aat:300006566 a skos:Concept ;
    skos:definition "Buildings that house educational facilities with higher education curricula specifically designed to train rabbis; for schools providing training in Talmudic law generally, but not necessarily specifically for the rabbinate, use \"yeshivas.\" For schools providing education for the priesthood, use \"theological seminaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbinical seminaries"@en .

aat:300006568 a skos:Concept ;
    skos:definition "Buildings that house schools providing education in, for example, theology and religious history, primarily, but not exclusively, to prepare students for jobs as priests, ministers, or church workers; usually sponsored or controlled by a church or other religious organization. For buildings that house schools devoted especially to the training of rabbis, use \"rabbinical seminaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theological seminaries"@en .

aat:300006572 a skos:Concept ;
    skos:definition "Buildings that house colleges devoted to teaching veterinary medicine and to training veterinarians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterinary colleges"@en .

aat:300006574 a skos:Concept ;
    skos:definition "Buildings that house schools offering instruction in one or more skilled or semiskilled trades or occupations. For educational facilities traditionally training technicians in business, industry, and commerce, usually for an immediate local area, use \"polytechnics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocational schools"@en .

aat:300006578 a skos:Concept ;
    skos:definition "Buildings that house schools that are established, conducted, and primarily supported by a nongovernmental agency and available to a limited set of students."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private schools"@en .

aat:300006580 a skos:Concept ;
    skos:definition "Buildings that house elementary or secondary schools operated, controlled, or supported by a church or other religious body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parochial schools"@en .

aat:300006581 a skos:Concept ;
    skos:definition "Buildings that house private schools intended to prepare students for more advanced formal education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preparatory schools"@en .

aat:300006584 a skos:Concept ;
    skos:definition "Buildings that house schools maintained at public expense for the education of children of a community or district as part of a free education system; generally includes elementary and high schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public schools"@en .

aat:300006586 a skos:Concept ;
    skos:definition "Buildings housing schools attended by children before they are eligible for elementary or primary school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pre-primary schools"@en .

aat:300006592 a skos:Concept ;
    skos:definition "Buildings that house schools serving pupils in the year prior to their entering the first grade, typically at age five."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kindergartens"@en .

aat:300006593 a skos:Concept ;
    skos:definition "Buildings that house schools for children too young for kindergarten and compulsory education, but old enough to take part in certain educational and social activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursery schools"@en .

aat:300006596 a skos:Concept ;
    skos:definition "Buildings that house children's schools with facilities and structured program activities devoted to play, often convening only in the summer; established as an emergency measure during World War I; used both as places for children of working parents and as places for parents and teachers to study the playing habits of children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play schools"@en .

aat:300006597 a skos:Concept ;
    skos:definition "Buildings that house schools providing the first stage of compulsory education, generally extending from grade 1 through grades 6 or 8 and teaching the rudiments of learning; may house a kindergarten."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elementary schools"@en .

aat:300006601 a skos:Concept ;
    skos:definition "Buildings that house schools representing the second stage of a three-tier educational system, falling intermediate between an elementary school and an upper, senior, or high school, differing by school district in grades included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle schools"@en .

aat:300006602 a skos:Concept ;
    skos:definition "Buildings that house schools intermediate between elementary school and high school, differing by school district in grades included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junior high schools"@en .

aat:300006603 a skos:Concept ;
    skos:definition "Buildings housing schools forming the third level of (usually compulsory) education for children, entered after elementary school and middle or junior high school; differing by school district in grades covered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high schools"@en .

aat:300006610 a skos:Concept ;
    skos:definition "Complexes or groups of buildings that house institutions of higher learning that provide general or liberal arts education leading to bachelor's degrees; may be independent or parts of universities. May comprise a single building rather than multiple buildings; to distinguish a single building in the context of being part of a complex, prefer \"college building.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colleges"@en .

aat:300006612 a skos:Concept ;
    skos:definition "Buildings that house publicly funded higher education colleges, typically without residential facilities, serving the educational needs of a specific community. The term may also refer to buildings housing secondary schools or sixth-form colleges that make the spaces available to the local community out of school hours for educational and recreational purposes; typically British usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community colleges"@en .

aat:300006613 a skos:Concept ;
    skos:definition "Buildings that house post-high school institutions which offer a two-year program of study of a terminal nature or in preparation for continued college studies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junior colleges"@en .

aat:300006616 a skos:Concept ;
    skos:definition "Built works or groups of built works housing entities providing higher education that include space for training technicians in business, industry, and commerce for an immediate local area, having fewer residence facilities, and offering more part-time classes than \"universities (building complexes).\" For buildings housing educational institutions emphasizing training in agriculture or specific trades, use \"vocational schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polytechnics"@en .

aat:300006617 a skos:Concept ;
    skos:definition "Complexes or groups of buildings that house degree-granting institutions which may typically include liberal arts undergraduate colleges, graduate schools, and undergraduate or graduate professional schools. To distinguish a single buildings in the context of being part of a complex, prefer \"college building.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "universities"@en .

aat:300006620 a skos:Concept ;
    skos:definition "Buildings that house universities located in and serving urban communities, although not necessarily maintained by municipalities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban universities"@en .

aat:300006623 a skos:Concept ;
    skos:definition "Buildings that house universities that are financially supported by a state government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state universities"@en .

aat:300006626 a skos:Concept ;
    skos:definition "Buildings designed to meet the needs of continuing education programs, which focus on postsecondary instruction designed for adults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuing education centers"@en .

aat:300006627 a skos:Concept ;
    skos:definition "Buildings, usually having lecture rooms, class rooms, and a library, and housing specialized institutions typically devoted to the instruction of adults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyceums"@en .

aat:300006636 a skos:Concept ;
    skos:definition "Facilities for meetings, study, or recreation, reserved for the faculty of an educational institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faculty clubs"@en .

aat:300006640 a skos:Concept ;
    skos:definition "Housing, typically dormitory-style facilities, provided for students at a college or university."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student housing"@en .

aat:300006645 a skos:Concept ;
    skos:definition "Dwellings in the United States owned and operated by societies for men for the benefit of their constituents and not open to the general public. They generally serve as a dormitory for fraternity members in a college or university setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternity houses"@en .

aat:300006646 a skos:Concept ;
    skos:definition "Dwellings in the United States owned and operated by societies for women for the benefit of their constituents and not open to the general public. They generally serve as a dormitory for sorority members in a college or university setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sorority houses"@en .

aat:300006647 a skos:Concept ;
    skos:definition "Buildings on a college campus dedicated to social and organizational activities of the student body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student unions"@en .

aat:300006653 a skos:Concept ;
    skos:definition "Buildings, other structures, and complexes of structures whose primary function is health care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health facilities"@en .

aat:300006658 a skos:Concept ;
    skos:definition "Ancillary buildings used in support of health care facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary health care facilities"@en .

aat:300006659 a skos:Concept ;
    skos:definition "Building or location serving as the hub for ambulances of a given area, from which they are dispatched as needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambulance stations"@en .

aat:300006662 a skos:Concept ;
    skos:definition "Facilities, either permanent or temporary, where vaccinations are distributed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaccination centers"@en .

aat:300006664 a skos:Concept ;
    skos:definition "Facilities that maintain statistics and provide information about poisoning, overdoses, and exposure to toxic substances, typically including where to find treatment for poisoning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poison control centers"@en .

aat:300006665 a skos:Concept ;
    skos:definition "Buildings that house healthcare facilities for outpatient care, often where patients receive treatment at reduced fees. The term also refers to facilities or hospital departments devoted to a particular group of diseases, such as a psychiatric clinic, neurology clinic, or surgery clinic, whether or not fees are reduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinics"@en .

aat:300006666 a skos:Concept ;
    skos:definition "Buildings that house clinics specializing in the examination and treatment of issues having to do with teeth and gums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental clinics"@en .

aat:300006667 a skos:Concept ;
    skos:definition "Buildings that house establishments or rooms in establishments where medicine is dispensed or medical or dental treatment is provided; they are often charitable institutions that dispense medicines and advice for a small fee or free of charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dispensaries"@en .

aat:300006672 a skos:Concept ;
    skos:definition "Buildings that house clinics specializing in outpatient treatment, including counseling and the dispensing of medication, for relatively mild or controllable mental illness that does not require overnight admittance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychiatric clinics"@en .

aat:300006673 a skos:Concept ;
    skos:definition "Facilities for clinics, either free-standing buildings or part of hospitals, where minor surgery is performed on an outpatient basis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surgicenters"@en .

aat:300006676 a skos:Concept ;
    skos:definition "Buildings housing institutions that are built, staffed, and equipped for the diagnosis of disease, for medical and surgical treatment of the sick and the injured, and for their housing during this process. The modern hospital also often serves as a center for investigation and for teaching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospitals"@en .

aat:300006678 a skos:Concept ;
    skos:definition "Health care facilities which, by their design, layout, or plan, are made to resemble cottages or a group of cottages rather than elaborate public buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottage hospitals"@en .

aat:300006679 a skos:Concept ;
    skos:definition "Temporary hospital facilities that can be packed up and transported from one place to another, most often used in military combat areas or at the scene of a disaster. Examples of mobile hospitals are the U.S. Mobile Army Surgical Hospitals (M.A.S.H.)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobile hospitals"@en .

aat:300006681 a skos:Concept ;
    skos:definition "Hospitals specializing in treatment of hearing problems and deafness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aural hospitals"@en .

aat:300006682 a skos:Concept ;
    skos:definition "Hospitals specializing in the treatment of diseases and injuries of children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's hospitals"@en .

aat:300006687 a skos:Concept ;
    skos:definition "Hospitals specializing in the care of people recovering health and strength after illness or injury, typically including provision for full medical care as needed, including professional doctor and nursing staff and diagnostic facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convalescent hospitals"@en .

aat:300006688 a skos:Concept ;
    skos:definition "Hospitals specializing in the treatment of the eye and the structures around the eye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye hospitals"@en .

aat:300006698 a skos:Concept ;
    skos:definition "Hospitals designed or used for the care of women immediately before, during, and after childbirth and for the care of newborn babies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maternity hospitals"@en .

aat:300006700 a skos:Concept ;
    skos:definition "Hospitals reserved for the treatment of active military personnel, including soldiers and their dependents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military hospitals"@en .

aat:300006701 a skos:Concept ;
    skos:definition "Hospitals where formal medical training takes place, usually affiliated with nursing or medical schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teaching hospitals"@en .

aat:300006702 a skos:Concept ;
    skos:definition "Hospitals specializing in the treatment of men and women who have served in military service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterans hospitals"@en .

aat:300006704 a skos:Concept ;
    skos:definition "Hospitals intended for the care and tretment of animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterinary hospitals"@en .

aat:300006706 a skos:Concept ;
    skos:definition "Health care facilities providing uncomplicated medical and nursing care for residents or members of an institution or other facility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infirmaries"@en .

aat:300006707 a skos:Concept ;
    skos:definition "Health facilities specializing in the treatment of and rehabilitation from illnesses and injuries that require prolonged care over an extended period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extended care facilities"@en .

aat:300006709 a skos:Concept ;
    skos:definition "Long-term residential care facilities providing as their primary and predominant function round-the-clock skilled nursing care for the elderly or chronically ill. Distinguished from \"rest homes\" which have less emphasis on comprehensive nursing care and are residential, rather than institutional, environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing homes"@en .

aat:300006711 a skos:Concept ;
    skos:definition "Long-term care facilities, originally for the older segment of the population and now generally restricted to those over 80 years old, in which some medical care is offered, but is not a major component of the care available to residents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homes for the aged"@en .

aat:300006716 a skos:Concept ;
    skos:definition "Extended care facilities in a residential environment for the elderly, ill, or convalescing who need special, often medical, attention. Distinguished from \"nursing homes\" which emphasize round-the-clock skilled nursing care in primarily institutional environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rest homes"@en .

aat:300006719 a skos:Concept ;
    skos:definition "Facilities providing basic living assistance and health care for disabled or elderly retired persons, especially such facilities in socialist and communist countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labor rest homes"@en .

aat:300006720 a skos:Concept ;
    skos:definition "Health care facilities for the chronically ill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanatoriums"@en .

aat:300006725 a skos:Concept ;
    skos:definition "Facilities specializing in the care of the dying or the incurably ill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terminal care facilities"@en .

aat:300006730 a skos:Concept ;
    skos:definition "Buildings, groups of buildings, or relatively large areas within a building specializing in the prompt treatment of acute illness, trauma, or other medical emergencies, often having treatments for a broad range of illnesses and injuries. The term is distinguished from \"emergency rooms,\" which tend to be smaller facilities or rooms attached to a general hospital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency medical centers"@en .

aat:300006733 a skos:Concept ;
    skos:definition "Hospital facilities where those with mental disorders are confined for observation and treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychiatric hospitals"@en .

aat:300006737 a skos:Concept ;
    skos:definition "Resorts or other facilities possessing or located near natural mineral springs or pools that are valued because of the believed restorative or curative powers of the water; also, artificial pools or other aquatic facilities containing waters believed to have restorative powers. The term is derived from the proper name of Spa, Liège province, Belgium, celebrated for the believed curative properties of its mineral springs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spas"@en .

aat:300006742 a skos:Concept ;
    skos:definition "Buildings containing facilities for record keeping or distribution of care, advice, or publications having to do with the general health and welfare of humans or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "welfare buildings"@en .

aat:300006745 a skos:Concept ;
    skos:definition "Buildings housing locally administered public or private institutions for care of the homeless, disabled, and elderly without means; often operated in conjunction with a farm. For earlier buildings where the disabled, elderly poor, or vagrants were confined for reform and work, use \"workhouses (buildings).\" For places established solely for the distribution of alms, use \"almonries (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almshouses"@en .

aat:300006748 a skos:Concept ;
    skos:definition "Urban buildings for the housing and care of homeless, lost, or abandoned animals, primarily dogs, cats, and other pets. Typically the animal is kept at the shelter until it is reclaimed by its owner, adopted by a new owner, placed with another organization, or euthanized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal shelters"@en .

aat:300006752 a skos:Concept ;
    skos:definition "Buildings used as refuges for the sick or destitute who need care rather than medical treatment; for institutional facilities treating the mentally ill, use \"psychiatric hospitals\" or \"psychiatric clinics,\" and for those treating the chronically ill, use \"sanatoriums.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asylums"@en .

aat:300006763 a skos:Concept ;
    skos:definition "Residential dwellings that are single housekeeping units, provide care for small groups of unrelated residents requiring supervision, and are intended to reproduce the circumstances of family life; for temporary residences of former convicts, drug users, or mental patients awaiting a return to society, use \"halfway houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "group homes"@en .

aat:300006768 a skos:Concept ;
    skos:definition "Temporary residences of former convicts, drug users, or mental patients that serve as a transition environment between confinement and a return to society; for long-term residential environments, which reproduce the circumstances of family life for persons requiring continuing supervision due to special needs, use \"group homes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halfway houses"@en .

aat:300006769 a skos:Concept ;
    skos:definition "Buildings that house facilities for the housing and care of orphans, who are children whose parents are either dead or otherwise unable to care for their child."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orphanages"@en .

aat:300006777 a skos:Concept ;
    skos:definition "Places providing job training and vocational rehabilitation for the disadvantaged, whether due to physical handicap or lack of experience or education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheltered workshops"@en .

aat:300006778 a skos:Concept ;
    skos:definition "Premises that house facilities for the spare-time activities of young people, often those belonging to a given social club for youths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "youth centers"@en .

aat:300006783 a skos:Concept ;
    skos:definition "Garden structures with open wood-framed roofs, often latticed, supported by regularly spaced posts or columns; often covered by climbing plants such as vines or roses, shading a walk or passageway. Distinguished from \"arbors,\" which are less extensive in extent and structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pergolas"@en .

aat:300006785 a skos:Concept ;
    skos:definition "Small arbors, often only two-dimensional, generally used to support climbing plants or as sunshades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trellises"@en .

aat:300006791 a skos:Concept ;
    skos:definition "Structures with raised platforms on which a band or orchestra plays; often roofed when sited outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandstands"@en .

aat:300006792 a skos:Concept ;
    skos:definition "Man-made stepped waterfalls, whether naturalistic or architectural in form. For similar natural or highly naturalistic features, use \"waterfalls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cascades"@en .

aat:300006795 a skos:Concept ;
    skos:definition "Structures characterized by a certain excess in terms of eccentricity, cost, or conspicuous inutility; often found in gardens or parks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "follies"@en .

aat:300006798 a skos:Concept ;
    skos:definition "Small structures, usually roofed and open-sided, located in gardens or parks from which one may gaze out over the surrounding grounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gazebos"@en .

aat:300006804 a skos:Concept ;
    skos:definition "Greenhouses designed to shelter through the winter tropical, and often ornamental, trees such as orange trees, and usually with southern exposure and heating systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orangeries"@en .

aat:300006806 a skos:Concept ;
    skos:definition "Use primarily for large greenhouses with plants and facilities for public entertainment, popular in the 19th century; may also be used for areas planted for winter display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter gardens"@en .

aat:300006807 a skos:Concept ;
    skos:definition "Refers to artificially constructed garden features, common since the 16th century in French and English landscapes. A grotto is characterized by being an excavation or structure made to imitate a rocky cave, often adorned with shell-work, colorful stones, etc., and serving as a place of recreation or a cool retreat. For natural features, use \"caves\" or \"caverns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grottoes"@en .

aat:300006809 a skos:Concept ;
    skos:definition "Spaces or structures with fountains embellished with statues, pools, or plants and used for relaxation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nymphaea"@en .

aat:300006811 a skos:Concept ;
    skos:definition "Grottolike enclosures, with a water supply, thought to be the dwelling places of or dedicated to the Muses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musaea"@en .

aat:300006814 a skos:Concept ;
    skos:definition "Structures built of ice, often elaborately decorated, furnished, and lit, erected for festivals, exhibitions, and sporting events; popular in 18th-century Russia and then throughout the northern latitudes during the mid-20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice palaces"@en .

aat:300006817 a skos:Concept ;
    skos:definition "Systems of intricate passageways and blind alleys that are defined by high, trimmed hedges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hedge mazes"@en .

aat:300006818 a skos:Concept ;
    skos:definition "Labyrinthine garden features created by cutting shallow pathways into deep lawns; common during the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turf mazes"@en .

aat:300006819 a skos:Concept ;
    skos:definition "Light, sometimes ornamental, structures in gardens, parks, or places of recreation that are used for entertainment or shelter. Examples are pavlions in Chinese gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden pavilions"@en .

aat:300006822 a skos:Concept ;
    skos:definition "Structures usually associated with or located in gardens or similarly landscaped grounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden structures"@en .

aat:300006824 a skos:Concept ;
    skos:definition "Buildings set apart to contain books for reading, study, or reference, typically with shelves containing books and tables and seating for users of the library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libraries"@en .

aat:300006833 a skos:Concept ;
    skos:definition "Buildings designated to receive all or selected government publications, with the provision that public access to the collections be provided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depository libraries"@en .

aat:300006841 a skos:Concept ;
    skos:definition "Buildings housing libraries that are maintained out of federal government funds and serving the nation as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national libraries"@en .

aat:300006844 a skos:Concept ;
    skos:definition "Buildings housing collections of books, furniture, and other facilities that are specifically geared towards the needs of children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's libraries"@en .

aat:300006845 a skos:Concept ;
    skos:definition "Buildings housing libraries maintained by state funds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state libraries"@en .

aat:300006872 a skos:Concept ;
    skos:definition "Buildings housing institutions that are typically more like museums or archives than libraries, containing the papers and sometimes exhibits about a given U.S. president and his administration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presidential libraries"@en .

aat:300006876 a skos:Concept ;
    skos:definition "Buildings or spaces housing lbraries that are formed by the collections of individuals rather than as a public institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private libraries"@en .

aat:300006877 a skos:Concept ;
    skos:definition "Buildings or spaces housing collections of books that are available to the public and typically maintained by public funds, as distinguished from libraries available only to a certain group or individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public libraries"@en .

aat:300006878 a skos:Concept ;
    skos:definition "Buildings or spaces housing book collections in a system other than the main or central library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "branch libraries"@en .

aat:300006879 a skos:Concept ;
    skos:definition "Libraries originally funded by Andrew Carnegie; found in the United States, Canada, Ireland, and Great Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carnegie libraries"@en .

aat:300006880 a skos:Concept ;
    skos:definition "Buildings housing privately owned libraries established to meet the needs of the members or staff of the owning institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special libraries"@en .

aat:300006881 a skos:Concept ;
    skos:definition "Buildings or spaces housing libraries intended for the employees of and maintained by a corporation or other business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate libraries"@en .

aat:300006882 a skos:Concept ;
    skos:definition "Buildings or spaces housing libraries consisting of specialized documents, and providing facilities for undertaking exhaustive investigation and research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research libraries"@en .

aat:300006887 a skos:Concept ;
    skos:definition "Structures built and used by military forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military buildings"@en .

aat:300006888 a skos:Concept ;
    skos:definition "General term for any works made to oppose a small number of troops against a greater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortifications"@en .

aat:300006890 a skos:Concept ;
    skos:definition "Enclosure walls, usually fortified, around Irish castles and some Irish houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bawns"@en .

aat:300006891 a skos:Concept ;
    skos:definition "Buildings or groups of buildings intended primarily to serve as a fortified residence of a prince or nobleman."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castles"@en .

aat:300006893 a skos:Concept ;
    skos:definition "Generally refers to French castles of small scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "châtelets"@en .

aat:300006894 a skos:Concept ;
    skos:definition "Large, permanent, heavily fortified, defensive military positions, sometimes including a town. Larger and stronger than \"forts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortresses"@en .

aat:300006897 a skos:Concept ;
    skos:definition "Refers to Spanish or Moorish castles, fortresses, or fortified palaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcazars"@en .

aat:300006902 a skos:Concept ;
    skos:definition "Fortresses commanding cities or towns, serving to protect and control the inhabitants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citadels"@en .

aat:300006904 a skos:Concept ;
    skos:definition "Generally small ancient Near Eastern fortresses used from Syria to Egypt especially along borders and near oases or important road junctions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "migdols"@en .

aat:300006909 a skos:Concept ;
    skos:definition "Permanent fortifications for troops, often surrounded by such elements as ditches, parapets, and ramparts and often used as advance posts in or near hostile territory. Smaller and less heavily fortified than \"fortresses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forts"@en .

aat:300006910 a skos:Concept ;
    skos:definition "Small or rudimentary forts, especially in the Roman period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortlets"@en .

aat:300006911 a skos:Concept ;
    skos:definition "Defensive enclosures comprised of ramparts and ditches encircling a fortified structure on a central prominence; common in Bronze Age and Iron Age Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hillforts"@en .

aat:300006913 a skos:Concept ;
    skos:definition "Small, usually isolated, fortification works of any form, commonly square or polygonal in plan, used to defend a prominent point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redoubts"@en .

aat:300006914 a skos:Concept ;
    skos:definition "Defensive barriers of stakes, piles, or other timber and often including loopholes for gun fire, placed across entrenchments and redoubts, a harbor or river, or around a building, village, or another area in need of fortification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stockades"@en .

aat:300006920 a skos:Concept ;
    skos:definition "Designates storage buildings for explosives and ammunition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magazines"@en .

aat:300006921 a skos:Concept ;
    skos:definition "Military storage buildings for priming powder and similar explosives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder magazines"@en .

aat:300006923 a skos:Concept ;
    skos:definition "Shops at military posts where goods and services are available to military personnel and authorized civilians, whether the goods are provided by the military or by a sutler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post exchanges"@en .

aat:300006930 a skos:Concept ;
    skos:definition "Military buildings used for social functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military social buildings"@en .

aat:300006934 a skos:Concept ;
    skos:definition "Housing designed or used by military personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military housing"@en .

aat:300006936 a skos:Concept ;
    skos:definition "Spaces set aside for military officers to engage in social interaction and consuming refreshments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "officers' clubs"@en .

aat:300006937 a skos:Concept ;
    skos:definition "Military buildings that are used for security purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military security buildings"@en .

aat:300006938 a skos:Concept ;
    skos:definition "Fortified log structures with loopholes or ports in their sides which permit gunfire in all directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blockhouses"@en .

aat:300006940 a skos:Concept ;
    skos:definition "Fortification chambers mostly below ground level built of reinforced concrete or similar material and usually provided with embrasures; also, dugouts that are reinforced (as with logs or bags of sand) and usually have firing slits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bunkers"@en .

aat:300006941 a skos:Concept ;
    skos:definition "Buildings for the shelter or accommodation of military guards, sometimes in which prisoners are temporarily detained under guard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guardhouses"@en .

aat:300006946 a skos:Concept ;
    skos:definition "Low, circular defensive towers used, especially since the Napoleanic wars, for coastal protection; derived in name and form from the traditional Mediterranean watchtowers found on Cape Martella, Corsica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martello towers"@en .

aat:300006947 a skos:Concept ;
    skos:definition "Military structures used for the purposes of training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military training buildings"@en .

aat:300006948 a skos:Concept ;
    skos:definition "Spaces set aside for the planning and practice of military drills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drill halls"@en .

aat:300006953 a skos:Concept ;
    skos:definition "Underground structures hardened against attack and designed for the storage and firing of missiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missile silos"@en .

aat:300006954 a skos:Concept ;
    skos:definition "Designates ancient Roman fortified frontier boundaries or defense zones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limites"@en .

aat:300006956 a skos:Concept ;
    skos:definition "Monuments or structures built to preserve the memory of beings or events. For other objects created, issued, or worn to commemorate persons or events, use \"commemoratives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorials"@en .

aat:300006957 a skos:Concept ;
    skos:definition "Buildings or monuments commemorating those killed in war, often specifically for those from the local area and from one particular war, and frequently inscribed with the names of the fallen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "war memorials"@en .

aat:300006958 a skos:Concept ;
    skos:definition "Structures or edifices of importance or historical interest, typically erected in memory of the dead or of an important event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monuments"@en .

aat:300006960 a skos:Concept ;
    skos:definition "Landmarks, monuments, or memorials composed of stacks of stones, or burial places covered with stones or a large mound of earth. Usually reserved for ancient structures located in Scotland, Ireland, and Wales. For burial mounds specific to England, use \"barrows.\" For piles of earth, generally, use \"mounds\"; for piles of earth used specifically over tombs, use \"burial mounds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cairns"@en .

aat:300006961 a skos:Concept ;
    skos:definition "Monuments that serve as guides to direction, position, or route, or that mark a boundary or limit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "markers"@en .

aat:300006963 a skos:Concept ;
    skos:definition "Small Roman, Etruscan, or Greek stelae or stone pillars, usually inscribed, marking, for example, events, boundaries, or gravesites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cippi"@en .

aat:300006966 a skos:Concept ;
    skos:definition "Structures with raised platforms and terminating in or shaped like crosses, set up in town marketplaces and used for public addresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market crosses"@en .

aat:300006967 a skos:Concept ;
    skos:definition "Crosses sometimes surmounting a pulpit erected outdoors at a preaching place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preaching crosses"@en .

aat:300006969 a skos:Concept ;
    skos:definition "Crosses erected by the side of the road in Christian areas as stations for prayer, in commemoration of local events, or mile markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wayside crosses"@en .

aat:300006971 a skos:Concept ;
    skos:definition "Conspicuous monuments, fixed objects, or markers that serve as guides in the direction of one's course, characterize a neighborhood, or establish the location of land boundaries or property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landmarks"@en .

aat:300006972 a skos:Concept ;
    skos:definition "Designates the posts or columns placed at the turning points in Roman circuses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metae"@en .

aat:300006973 a skos:Concept ;
    skos:definition "Stones, slabs, or pillars of any material, set by the side of a road to mark distances between one point and another; most often distances between cities. The term \"milestones\" does not necessarily refer only to the unit of measurement called a \"mile\"; it may be used to describe objects that denote measures of the kilometer or other units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milestones"@en .

aat:300006983 a skos:Concept ;
    skos:definition "Refers to prehistoric or very ancient monuments built of unusually large stones have been only very roughly worked or left as found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megalithic monuments"@en .

aat:300006985 a skos:Concept ;
    skos:definition "Tall, upright megalithic stone monuments found in Europe, Africa, or Asia, and dating to prehistoric or very ancient times. The term typically refers to stones that occur singly, though it is may be used to refer to individual stones within a row, circle, or other configuration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menhirs"@en .

aat:300006998 a skos:Concept ;
    skos:definition "Refers to prehistoric circular enclosures of well-spaced large upright stones; if the ring of stones is bordered by a circular ditch and bank of earth, use \"henges.\" Use \"megalithic chamber tombs\" if the stone enclosure is capped by stones and covered by a mound of earth or stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cromlechs"@en .

aat:300007002 a skos:Concept ;
    skos:definition "Large structures having a prominent central arch and built to commemorate events or persons; if erected to honor military victories, use \"triumphal arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorial arches"@en .

aat:300007003 a skos:Concept ;
    skos:definition "Monumental structures containing at least one arched passageway and erected to honor an important person or to commemorate a significant event, particularly a victory in war. The basic form consisted of two piers connected by an arch, over which was placed a superstructure that served as a base for statues and bore commemorative inscriptions. Triumphal arches generally spanned a roadway used for triumphal processions. They are associated with ancient Roman architecture, however, they possibly developed elsewhere or from the Porta Triumphalis, which was a gate in Rome through which the victorious Roman army had to pass before entering the sacred city territory of Rome. \"Arco onorario destinato a commemorare una vittoria militare. Nelle basiliche cristiane indica l'arco che divide la navata dal transetto o dal presbiterio.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triumphal arches"@en .

aat:300007008 a skos:Concept ;
    skos:definition "Refers to freestanding structures having approximately the form of columns, with capital, shaft, and base, but without a full superstructure and erected as memorials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorial columns"@en .

aat:300007009 a skos:Concept ;
    skos:definition "Columns erected in honor of a naval triumph and ornamented with the rostra or prows of ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rostral columns"@en .

aat:300007016 a skos:Concept ;
    skos:definition "Freestanding Indian pillars, bearing inscriptions or surmounted by animal sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lats"@en .

aat:300007021 a skos:Concept ;
    skos:definition "Tall, slender, four-sided, usually monolithic stone shafts which taper upward and end in a pyramidal tip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obelisks"@en .

aat:300007023 a skos:Concept ;
    skos:definition "Upright stone slabs, plain or decorated, used as commemorative markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stelae"@en .

aat:300007027 a skos:Concept ;
    skos:definition "Sepulchral monuments erected to a person or persons buried elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cenotaphs"@en .

aat:300007028 a skos:Concept ;
    skos:definition "In ancient Greece, monuments erected by leaders or winners of certain choral or musical competitions; often quite elaborate. The best known was erected in 335/334 BCE near the Acropolis of Athens, by the choregos Lysicrates who was a patron of musical performances in the Theater of Dionysus. The form was a circular stone structure encircled by columns of the Corinthian order, on a square base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choragic monuments"@en .

aat:300007033 a skos:Concept ;
    skos:definition "Monuments honoring soldiers, often of a particular military branch, regiment or other group, or battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soldiers' monuments"@en .

aat:300007037 a skos:Concept ;
    skos:definition "Places of historic, scenic, or scientific interest set aside for preservation, usually by presidential proclamation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national monuments"@en .

aat:300007038 a skos:Concept ;
    skos:definition "Monuments erected as permanent reminders of military victories, usually containing images of the spoils of battle and often set up in the land of the vanquished. The design of these monuments was derived from the piles of arms and armor collected and displayed after Greek and Roman military victories. For the actual objects taken as spoils in war or hunting, or awarded as prizes for victory in contests, use \"trophies (objects).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trophies"@en .

aat:300007043 a skos:Concept ;
    skos:definition "Buildings constructed or used primarily for offices, which are spaces where business, administrative, or professional activities are conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office buildings"@en .

aat:300007046 a skos:Concept ;
    skos:definition "Skyscrapers or other tall buildings primarily containing offices, which are spaces where business, administrative, or professional activities are conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office towers"@en .

aat:300007049 a skos:Concept ;
    skos:definition "Buildings constructed or used for offices from which the management and other administrative duties of an organization or institution are conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administration buildings"@en .

aat:300007053 a skos:Concept ;
    skos:definition "Spaces where teeth are examined, X-rayed, cleaned, extracted, cavities filled, and other minor surgeries are performed on teeth by or under the supervision of a dentist; they typically include a waiting room and a room or rooms with a chair and other equipment for the examination of patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental offices"@en .

aat:300007063 a skos:Concept ;
    skos:definition "Buildings belonging to or used by members of professional, fraternal, or trades organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "societies' buildings"@en .

aat:300007071 a skos:Concept ;
    skos:definition "Meeting places of branches of fraternal organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal lodges"@en .

aat:300007075 a skos:Concept ;
    skos:definition "Buildings in which (prior to the 17th century) skilled stone masons or (since the early 17th century) members of the societies of Freemasons gathered, whether socially or professionally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonic buildings"@en .

aat:300007089 a skos:Concept ;
    skos:definition "Organizations or societies of learned individuals united for the advancement of art, science, or literature, intended to provide instruction, to engage in intellectual life or the practice of an art, to set standards, disseminate information, and to confer prestige on its members. Generally refers to an educational level above elementary school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academies"@en .

aat:300007091 a skos:Concept ;
    skos:definition "Buildings housing the reading room and library for a given association of people interested in scientific and literary pursuits, who meet for the purpose of mutual improvement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "athenaeums"@en .

aat:300007099 a skos:Concept ;
    skos:definition "Cafélike facilities often with a dance floor or small stage and featuring entertainment generally of an improvisational, satirical, or topical nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabarets"@en .

aat:300007102 a skos:Concept ;
    skos:definition "Buildings designed for musical performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concert halls"@en .

aat:300007103 a skos:Concept ;
    skos:definition "Public buildings, with seating for an audience, emphasizing musical and variety entertainment but also serving drinks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music halls"@en .

aat:300007104 a skos:Concept ;
    skos:definition "Concert halls designed specifically to accommodate the production needs of opera performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opera houses"@en .

aat:300007107 a skos:Concept ;
    skos:definition "Establishments offering evening entertainment, such as floor shows or comedy acts, providing space and music for dancing, and usually serving liquor and meals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nightclubs"@en .

aat:300007110 a skos:Concept ;
    skos:definition "Concave, acoustically resonant structures at the back of outdoor bandstands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "band shells"@en .

aat:300007140 a skos:Concept ;
    skos:definition "Designates outdoor movie theaters designed to accommodate patrons viewing from their automobiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drive-in theaters"@en .

aat:300007141 a skos:Concept ;
    skos:definition "Refers to early movie theaters, usually small and simple, where motion pictures, and sometimes variety shows, could be seen at inexpensive prices, usually a nickel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickelodeons"@en .

aat:300007148 a skos:Concept ;
    skos:definition "Stations along caravan routes providing overnight accommodations and facilities for caravans and individuals and their animals; generally characterized by large central courtyards, a single entrance and, often, shops. For Islamic structures of similar function, but in urban contexts and having more mercantile facilities, use \"khans.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caravanserais"@en .

aat:300007158 a skos:Concept ;
    skos:definition "Inns, hotels, or private homes offering a room for the night and breakfast the next morning for one inclusive price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed-and-breakfasts"@en .

aat:300007160 a skos:Concept ;
    skos:definition "Lodging places providing a variety of amenities for travelers and often maintained by a religious order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospices"@en .

aat:300007162 a skos:Concept ;
    skos:definition "Public houses of lodging for strangers and travellers, typically distinguished from an inn or hotel by being inexpensive and providing communal accommodations, with several beds in a single room and shared bath facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hostels"@en .

aat:300007164 a skos:Concept ;
    skos:definition "Facilities providing inexpensive, minimally supervised, communal lodging for young people traveling without their parents. Youth hostels originated in early 20th-century Germany, then spread internationally.The activities of youth hostel associations are coordinated by the International Youth Hostel Federation (founded 1932) which facilitates international travel by members. Facilities providing inexpensive, minimally supervised, communal lodging for young people traveling without their parents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "youth hostels"@en .

aat:300007166 a skos:Concept ;
    skos:definition "Buildings where travellers or tourists are provided with overnight accommodation, meals, and other services; often distinguished from inns and other forms of temporary lodging for travellers by their larger size and range of facilities, in modern times often equipped with a restaurant, bar, conference rooms, and leisure facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hotels"@en .

aat:300007168 a skos:Concept ;
    skos:definition "Hotels constructed on a river, lake, or off the coast. For large ships with hotel accommodations and the primary activity of taking tourists on extended excursions, use \"cruise ships.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating hotels"@en .

aat:300007169 a skos:Concept ;
    skos:definition "Boarding houses, guest houses, or small hotels that are usually family-owned and operated, and have limited services beyond lodging and breakfasts. The term is typically reserved for such establishments in continental Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pensions"@en .

aat:300007170 a skos:Concept ;
    skos:definition "Relatively small public buildings that offer for a fee rooms for sleeping and a tavern for food and beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inns"@en .

aat:300007173 a skos:Concept ;
    skos:definition "Main buildings of some resorts or public parks containing accommodations and other public facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodges"@en .

aat:300007174 a skos:Concept ;
    skos:definition "Main buildings, typically located in a resort or park, and primarily serving tourists or sportsmen specializing in fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing lodges"@en .

aat:300007178 a skos:Concept ;
    skos:definition "Main buildings, typically located in a resort or park, and primarily serving tourists or sportsmen who are skiing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski lodges"@en .

aat:300007179 a skos:Concept ;
    skos:definition "A house, other than an inn or hotel, in which rooms are rented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodging houses"@en .

aat:300007190 a skos:Concept ;
    skos:definition "Establishments providing for the care and accommodation of pilgrims and strangers, especially in Classical through Medieval contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xenodochia"@en .

aat:300007193 a skos:Concept ;
    skos:definition "Distinguished from \"entertainment buildings\" by more broadly designating buildings designed for or containing equipment for amusement, exercise, sports, or some pastime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreation buildings"@en .

aat:300007196 a skos:Concept ;
    skos:definition "Denotes buildings, commonly found in amusement parks, containing various devices designed to startle or amuse and arranged along a passage through which patrons walk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fun houses"@en .

aat:300007197 a skos:Concept ;
    skos:definition "Indoor ranges or covered structures equipped with targets for practice or competition with firearms. For built structures that include other forms of mechanical attraction, use \"penny arcades.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shooting galleries"@en .

aat:300007204 a skos:Concept ;
    skos:definition "Buildings or rooms occupied by associations formed to combine the operations of persons interested in the promotion or playing of tennis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tennis clubs"@en .

aat:300007205 a skos:Concept ;
    skos:definition "Water recreation complexes including clubhouse, marina, and associated boating facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boat clubs"@en .

aat:300007206 a skos:Concept ;
    skos:definition "Distinguished from \"recreation buildings\" by more narrowly designating buildings with devices or equipment for amusement or diversion and not active sports, nor for which membership is required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entertainment buildings"@en .

aat:300007207 a skos:Concept ;
    skos:definition "Entertainment buildings containing a variety of games and other amusements that can be played for a nominal fee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amusement arcades"@en .

aat:300007208 a skos:Concept ;
    skos:definition "Buildings, generally having large open interior spaces, that accommodate a series of tables on which bingo, and derivative games, can be played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bingo halls"@en .

aat:300007209 a skos:Concept ;
    skos:definition "Denotes amusement facilities that contain mechanical entertainment devices originally operated for a penny per play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penny arcades"@en .

aat:300007213 a skos:Concept ;
    skos:definition "Refers to public establishments equipped with pool and/or billiard tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pool halls"@en .

aat:300007216 a skos:Concept ;
    skos:definition "Amusement arcades that contain predominantly video games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video arcades"@en .

aat:300007227 a skos:Concept ;
    skos:definition "Entertainment buildings, often public, for meeting, dancing, and general recreation, often with eating and drinking facilities, music, and game rooms; pleasure houses or summer houses. For similar buildings equipped with gambling devices, use \"gambling casinos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casinos"@en .

aat:300007236 a skos:Concept ;
    skos:definition "Small houselike structures, large enough for children to enter and designed for children's play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's playhouses"@en .

aat:300007250 a skos:Concept ;
    skos:definition "Designates buildings providing facilities for athletic events or training and, usually, support facilities for participants and spectators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports buildings"@en .

aat:300007255 a skos:Concept ;
    skos:definition "Oblong ancient Roman enclosures that are curved at one end, with tiered seating on three sides, and built for chariot and horse racing. Meaning overlaps with similar structures in Greek cities of the Hellenistic, Roman, and Byzantine eras, \"hippodromes (Greek sports buildings).\" For sports structures used for horse racing in more modern contexts, use \"horse racetracks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circuses"@en .

aat:300007259 a skos:Concept ;
    skos:definition "Use both for buildings providing enclosed and unobstructed space adaptable for various physical education and recreation activities, such as track events and basketball, and for buildings housing equipment and dressing facilities for athletes; often located at or near athletic fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field houses"@en .

aat:300007260 a skos:Concept ;
    skos:definition "Structures containing large, bounded, smoothly surfaced areas for skating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skating rinks"@en .

aat:300007264 a skos:Concept ;
    skos:definition "Ice skating rinks specially marked and equipped for playing ice hockey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice hockey rinks"@en .

aat:300007266 a skos:Concept ;
    skos:definition "Buildings with large unobstructed spaces specially surfaced usually with hardwood or another smooth durable material for roller skating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller-skating rinks"@en .

aat:300007268 a skos:Concept ;
    skos:definition "Use both for buildings housing central stages, rings, or areas used for sports or other entertainment events and for the central open spaces of ancient amphitheaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arenas"@en .

aat:300007271 a skos:Concept ;
    skos:definition "Large usually unroofed buildings with tiers of seats for spectators built in various shapes and enclosing a field used for sports events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stadiums"@en .

aat:300007278 a skos:Concept ;
    skos:definition "Ancient Roman spectacles representing naval battles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naumachias"@en .

aat:300007285 a skos:Concept ;
    skos:definition "Designates buildings housing wooden lanes, equipped with facilities for setting bowling pins and returning balls to the user, for the indoor sport of bowling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowling alleys"@en .

aat:300007287 a skos:Concept ;
    skos:definition "Buildings containing equipment and bowling lanes for the pin game of skittles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skittle alleys"@en .

aat:300007297 a skos:Concept ;
    skos:definition "Modern buildings designed and equipped for indoor sports, exercise, or physical education and training; may include a court for ball games or other excercise, bleachers for observers, changing rooms, and bath or shower facilites. For ancient buildings where competitors in games were trained, and where men engaged in social and intellectual pursuits, use \"gymnasia (ancient buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gymnasiums"@en .

aat:300007301 a skos:Concept ;
    skos:definition "Ancient Greek or Roman buildings for training in wrestling or other athletic endeavors. Palaestrae were often part of public gymnasia, although some functioned independently. The floorplan of palaestrae was standardized, usually comprising a rectangular court surrounded by colonnades with adjoining rooms devoted to activities such as undressing, bathing, socializing, observation, instruction, and storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palaestrae"@en .

aat:300007306 a skos:Concept ;
    skos:definition "Indoor spaces, usually oval in plan and having special floor surfacing, designed for running or jogging; for similar recreation spaces outdoors, use \"running tracks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor tracks"@en .

aat:300007308 a skos:Concept ;
    skos:definition "Public exhibitions of skill and competition that may include the riding of unbroken horses or bulls, roping of calves, wrestling with steers, and a round-up, which is the driving together of cattle in order to separate, count, inspect, or mark them. Public exhibitions of skill and competition that may include the riding of unbroken horses or bulls, roping of calves, wrestling with steers, and a round-up, which is the driving together of cattle in order to separate, count, inspect, or mark them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rodeos"@en .

aat:300007309 a skos:Concept ;
    skos:definition "Ancient Roman structures adapted to ball playing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sphaeristeria"@en .

aat:300007313 a skos:Concept ;
    skos:definition "Recreation structures containing vehicles or other devices in or on which people may ride for amusement for a nominal fee and for a limited time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amusement rides"@en .

aat:300007315 a skos:Concept ;
    skos:definition "Amusement devices consisting of a large power-driven wheel made in two parallel sections having seats suspended between them, the seats maintaining a horizontal position while the wheel rotates in a vertical plane. The first wheel was created by Pittsburgh, Pennsylvania bridge builder George W. Ferris for the 1893 Chicago World's Fair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ferris wheels"@en .

aat:300007316 a skos:Concept ;
    skos:definition "Structures consisting of a relatively large revolving circular platform with seats, often in the form of horses or other animals, on which people may ride, usually to the accompaniment of mechanical or recorded music. Often found in an amusement park or other public area; intended for children or adults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carousels"@en .

aat:300007319 a skos:Concept ;
    skos:definition "Amusement park rides having a gravity train that moves along a closed loop on a sharply winding trestle built with steep inclines that produce sudden speedy plunges for thrill-seeking passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller coasters"@en .

aat:300007320 a skos:Concept ;
    skos:definition "Descending troughs partially filled with constantly moving water through which people may ride or slide, usually terminating in a pool of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water slides"@en .

aat:300007322 a skos:Concept ;
    skos:definition "Quadrangular spaces either walled or otherwise marked off for playing one of various games usually with a ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courts"@en .

aat:300007324 a skos:Concept ;
    skos:definition "Playing areas and associated viewing platforms of the ancient Mesoamerican ritual ball game. The court was shaped like a capital I with serifs and oriented north–south or east–west; it represented the heavens. Players, wearing heavy padding, used elbows, knees, and hips to knock a solid rubber ball into the opponent’s end of the court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball courts"@en .

aat:300007332 a skos:Concept ;
    skos:definition "Courts marked for playing American handball and that include at least one smooth wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handball courts"@en .

aat:300007334 a skos:Concept ;
    skos:definition "Denotes three-walled courts marked for playing jai alai."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canchas"@en .

aat:300007339 a skos:Concept ;
    skos:definition "Four-walled, enclosed courts marked for the racket and ball game of squash racquets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squash courts"@en .

aat:300007343 a skos:Concept ;
    skos:definition "Tennis courts enclosed within buildings or other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor tennis courts"@en .

aat:300007346 a skos:Concept ;
    skos:definition "Structures built and used for the purpose of swimming or other water recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water recreation structures"@en .

aat:300007347 a skos:Concept ;
    skos:definition "Structures containing dressing rooms or lockers for bathers, as at the seashore. For buildings housing public swimming and bathing facilities, use \"public baths.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathhouses"@en .

aat:300007351 a skos:Concept ;
    skos:definition "Small cabins, simple enclosures, or tentlike structures erected at beaches or swimming pools as bathhouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabañas"@en .

aat:300007353 a skos:Concept ;
    skos:definition "Buildings equipped with swimming pools and other facilities for bathing and swimming, traditionally the primary hygienic facility in a city or town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public baths"@en .

aat:300007355 a skos:Concept ;
    skos:definition "Establishments containing special enclosures for cleansing or refreshing oneself in a bath of steam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam baths"@en .

aat:300007364 a skos:Concept ;
    skos:definition "Monumental ancient Roman bath buildings. For public or private ancient Roman baths or bath buildings of ordinary size, use \"balnea.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermae"@en .

aat:300007369 a skos:Concept ;
    skos:definition "Structures heated by steam produced by pouring water on hot stones and used by Native Americans for ritual and therapeutic sweating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweathouses"@en .

aat:300007371 a skos:Concept ;
    skos:definition "Buildings in which bathers pass through a succession of steam rooms of increasing temperature followed by spaces for rubdowns and massages. For Islamic public baths, use \"hammams.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkish baths"@en .

aat:300007376 a skos:Concept ;
    skos:definition "Artificial bodies of water designed for swimming, either sunken into the ground or created by the construction of walls, whether or not the pool is housed within a structure or open to the sky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swimming pools"@en .

aat:300007381 a skos:Concept ;
    skos:definition "Stone basins with a drain, generally set near the sacristy, often in a niche. The piscina was used for the celebrant's ablutions and for washing the sacred vessels during the Mass. Piscinae drain into the ground, and some have a small upper shelf that serves as a credence. For pools in Roman or Medieval homes or public sites, use \"piscinae (pools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piscinae"@en .

aat:300007383 a skos:Concept ;
    skos:definition "Recreation structures built to be used for activities surrounding winter sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter sports structures"@en .

aat:300007386 a skos:Concept ;
    skos:definition "Steeply inclined, snow-covered courses with a horizontal take-off at the end from which skiers glide off into the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski jumps"@en .

aat:300007387 a skos:Concept ;
    skos:definition "Conveyances that transport skiers up slopes or mountainsides, consisting typically of a series of seats suspended from an endless cable driven by motors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski lifts"@en .

aat:300007389 a skos:Concept ;
    skos:definition "Usually small structures with artificial surfaces, often plastic, upon which to practice skiing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial ski slopes"@en .

aat:300007391 a skos:Concept ;
    skos:definition "Buildings built or used for religious ceremonies or other functions having to do with a particular religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious buildings"@en .

aat:300007397 a skos:Concept ;
    skos:definition "Houses owned by a parish, especially the house used to accommodate the minister or clergy or for the parish poor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parish houses"@en .

aat:300007417 a skos:Concept ;
    skos:definition "Buildings that house almshouses in which the residents were required to pray for the founder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beadhouses"@en .

aat:300007418 a skos:Concept ;
    skos:definition "Designates assembly halls for the business meetings of religious or fraternal organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapter houses"@en .

aat:300007423 a skos:Concept ;
    skos:definition "Enclosed spaces composed of a garth and surrounding walkways, which are generally arcaded on the courtyard side and walled on the other. Cloisters are often found in Christian monastic building complexes, but may be found on university campuses or elsewhere. The term is used for such features in secular buildings only when closely resembling the monastic prototype."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloisters"@en .

aat:300007424 a skos:Concept ;
    skos:definition "Open courtyards surrounded by walkways, especially in a group of buildings of a monastery or college."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloister garths"@en .

aat:300007427 a skos:Concept ;
    skos:definition "Heated parlors or sitting rooms in monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calefactories"@en .

aat:300007431 a skos:Concept ;
    skos:definition "In monastic architecture, rooms, groups of rooms, or separate buildings where monastic rule was relaxed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misericords"@en .

aat:300007432 a skos:Concept ;
    skos:definition "Rooms in monasteries or convents where visitors may be received."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parlatories"@en .

aat:300007441 a skos:Concept ;
    skos:definition "Latrines situated at the rear of Medieval convents or monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reredorters"@en .

aat:300007444 a skos:Concept ;
    skos:definition "Refers to separate buildings or parts of buildings containing a font for the baptismal rite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptisteries"@en .

aat:300007450 a skos:Concept ;
    skos:definition "Chapels of a church endowed for chanting of masses and other services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chantries"@en .

aat:300007452 a skos:Concept ;
    skos:definition "Church buildings constructed within the bounds of a parish for the attendance of those who cannot reach the parish church conveniently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapels of ease"@en .

aat:300007454 a skos:Concept ;
    skos:definition "Rooms or relatively small freesanding structures containing tombs or sarcophagi, usually for individuals, families, or members of a particular community. For rooms or structures adjacent to a tomb, used by the mourners or for offerings to the dead, prefer \"tomb chapels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepulchral chapels"@en .

aat:300007459 a skos:Concept ;
    skos:definition "Places for prayer comprising a room or building for private worship; typically located in a church, madrasa, house, monastery, guild hall, or other locations associated with various religions or rites. In the Roman Catholic church, the usage and number of services allowed in an oratory are defined by canon law. In Christian architecture, oratories seem to have originated from the chapels erected over the tombs of the early martyrs where the faithful gathered to pray, combined with the necessity of having a place of worship for the people in rural districts at a time when churches proper were restricted to cathedral cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oratories"@en .

aat:300007461 a skos:Concept ;
    skos:definition "Rooms or other relatively small places set aside for worship by an individual, family, or small group, where no public services are provided. A private chapel may be within the confines of a larger church, home, or other larger building; it may also be a free standing structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private chapels"@en .

aat:300007462 a skos:Concept ;
    skos:definition "Private chapels for a royal court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal chapels"@en .

aat:300007466 a skos:Concept ;
    skos:definition "Buildings for public Christian worship that are distinguished historically from chapels and oratories, which are buildings that are in some respect private, or not public in the widest sense. Church architecture generally somewhat follows standard models, which vary depending upon the date, location, and characteristics of the congregation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "churches"@en .

aat:300007487 a skos:Concept ;
    skos:definition "Churches comprised of two complete sanctuaries, either placed one above the other or attached side by side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double churches"@en .

aat:300007493 a skos:Concept ;
    skos:definition "In a general sense, refers to any large church built to receive large numbers of pilgrims. In specific use, refers to churches built or remodeled in the 11th century, and designed for crowds of pilgrims along the main routes to the shrine at Campostela, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrimage churches"@en .

aat:300007495 a skos:Concept ;
    skos:definition "Churches that form the center of an abbey. They typically adjoin the cloister, are linked to the dormitory by a stairway called the \"night-stair,\" and have an assembly room or chapter house, which is often attached to the chancel at the eastern side of the cloister."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbey churches"@en .

aat:300007501 a skos:Concept ;
    skos:definition "Churches that are the principal church of a diocese, serving as the seat of the bishop, or of the archbishop, primate, patriarch, or pope of the diocese. They are generally grandiose structures and house the \"cathedra,\" which is the throne of the bishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedrals"@en .

aat:300007507 a skos:Concept ;
    skos:definition "Churches used temporarily as cathedrals, as, for instance, during repairs or during creation of a new diocese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "procathedrals"@en .

aat:300007508 a skos:Concept ;
    skos:definition "Churches that are constructed inside caves or otherwise utilize natural cavities in the earth's surface. They are distinguished from rock-cut churches, which are cut from the living rock outside the context of a cave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cave churches"@en .

aat:300007513 a skos:Concept ;
    skos:definition "Churches comprising spaces that have been cut into the living rock. They are distinguished from \"cave churches,\" which utilize natural cavities in the earth's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-cut churches"@en .

aat:300007515 a skos:Concept ;
    skos:definition "Churches, other than cathedrals, endowed for a chapter of canons, or, as in the United States and Scotland, churches joined together and served by a joint pastorate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collegiate churches"@en .

aat:300007516 a skos:Concept ;
    skos:definition "Large or important churches, such as a collegiate church or cathedral church, or those having their origin in a monastic establishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minsters"@en .

aat:300007517 a skos:Concept ;
    skos:definition "Buildings housing churches located within a mission, which is a self-sustaining frontier or outpost settlements created by a religious organization to evangelize abroad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mission churches"@en .

aat:300007519 a skos:Concept ;
    skos:definition "Churches belonging to a monastery or having their origin in a monastery, which is a place of religious retirement or seclusion from the world for monks, who are people living a celibate life according to the rule of a particular religious order and adhering to vows, especially of poverty, chastity, and obedience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monastic churches"@en .

aat:300007524 a skos:Concept ;
    skos:definition "Wood churches with walls of vertical planks, used from at least the 9th century, especially in Scandinavia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stave churches"@en .

aat:300007528 a skos:Concept ;
    skos:definition "Buildings of assembly for Christian religious worship, typically not of ecclesiastical architecture, and especially in reference of meetings of Nonconformists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meeting houses"@en .

aat:300007529 a skos:Concept ;
    skos:definition "Houses or other buildings where meetings for worship are held by the the Religious Society of Friends (Quakers)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quaker meeting houses"@en .

aat:300007535 a skos:Concept ;
    skos:definition "Tall, slender towers of a mosque, from which the faithful are called to prayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minarets"@en .

aat:300007544 a skos:Concept ;
    skos:definition "Muslim places of worship. Public mosques consist of an area reserved for communal prayers, frequently in a domed building with a minaret, and with a niche (mihrab) or other structure indicating the direction of Mecca. There may also be a platform for preaching (minbar), and an adjacent courtyard in which water is provided for the obligatory ablutions before prayer. Since representations of the human form are forbidden, decoration is geometric or based on Arabic calligraphy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosques"@en .

aat:300007547 a skos:Concept ;
    skos:definition "Mosques having a plan that incorporates four iwans, which are large vaulted halls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "four-iwan mosques"@en .

aat:300007548 a skos:Concept ;
    skos:definition "Mosques having a vast rectangular hall, generally a flat roof, and whose interior is divided by many rows of columns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypostyle mosques"@en .

aat:300007551 a skos:Concept ;
    skos:definition "Places of prayer, usually mosques, for congregations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jamis"@en .

aat:300007555 a skos:Concept ;
    skos:definition "Designates large, open Islamic prayer areas built to accommodate the entire population of a town; often with the mihrab as the only architectural feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musallas"@en .

aat:300007558 a skos:Concept ;
    skos:definition "Structures or large furnishings in which devotion is paid to a statue, picture, saint, deity or other holy objects. For containers for safeguarding the relics of a saint, use \"reliquaries\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrines"@en .

aat:300007560 a skos:Concept ;
    skos:definition "Use only in ancient Roman contexts when distinguishing a sacred precinct (called a temple) from the building within the precinct housing a cult image or the treasure of a deity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aedes"@en .

aat:300007562 a skos:Concept ;
    skos:definition "Buddhist rock-cut shrines or sanctuaries. a barrel-vaulted hall with stūpa as focus of worship; the term is sometimes used by itself for the hall housing the caitya (caityagṛha) or for a barrel-vaulted-window motif based on that hall-type (caitya-gavākṣa)"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaityas"@en .

aat:300007563 a skos:Concept ;
    skos:definition "Shinto shrines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jinjas"@en .

aat:300007567 a skos:Concept ;
    skos:definition "Sanctuaries particularly designed or used to honor the god Mithras, often comprising an underground chapel or a series of artificial caves illuminated from above by light shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mithraea"@en .

aat:300007570 a skos:Concept ;
    skos:definition "Small ancient Roman shrines, usually built as enclosures open to the sky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacella"@en .

aat:300007572 a skos:Concept ;
    skos:definition "May be used broadly for any consecrated place in ancient Roman or Christian architecture, but more specific terms are preferred, such as \"chapels,\" \"shrines,\" \"sacristies,\" or \"sanctuaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacraria"@en .

aat:300007575 a skos:Concept ;
    skos:definition "Chinese great ancestral shrines, usually associated with palace buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "t'ai miao"@en .

aat:300007576 a skos:Concept ;
    skos:definition "Buddhist relic mounds of earth, brick, or stone, dominated by a hemispherical or bulbous dome set on a square or circular base and topped by a small pavilionlike structure and a spire. Stupas often serve as pilgrimage sites and symbols of the Buddha or his teachings. solid hemispherical tumulus symbolizing Buddha’s or Jina’s nirvāṇa"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stupas"@en .

aat:300007590 a skos:Concept ;
    skos:definition "Community places for the regular assembly or congregation of Jews for liturgical services, assembly, and study apart from the service of the temple; since the destruction of the temple in Jerusalem, worship at the synagogue is the sole place of public worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synagogues"@en .

aat:300007595 a skos:Concept ;
    skos:definition "Buildings housing places devoted to the worship of a deity or deities. In the strictest sense, it refers to the dwelling place of a deity, and thus often houses a cult image. In modern usage a temple is generally a structure, but it was originally derived from the Latin \"templum\" and historically has referred to an uncovered place affording a view of the surrounding region. For Christian or Islamic religious buildings the terms \"churches\" or \"mosques\" are generally used, but an exception is that \"temples\" is used for Protestant, as opposed to Roman Catholic, places of worship in France and some French-speaking regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temples"@en .

aat:300007600 a skos:Concept ;
    skos:definition "Circular columnar buildings that are roofed but have no cella."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monoptera"@en .

aat:300007613 a skos:Concept ;
    skos:definition "Temples for ministering and offering to deified monarchs; common in ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortuary temples"@en .

aat:300007616 a skos:Concept ;
    skos:definition "Natural caves used as temples or other places of worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cave temples"@en .

aat:300007617 a skos:Concept ;
    skos:definition "Use especially with reference to ancient Egyptian temples, shrines, or tombs cut into the living rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speoses"@en .

aat:300007623 a skos:Concept ;
    skos:definition "Temples cut out of the living rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-cut temples"@en .

aat:300007624 a skos:Concept ;
    skos:definition "Temples whose sanctuary spaces are wholly or partly open to the sky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypaethral temples"@en .

aat:300007626 a skos:Concept ;
    skos:definition "Ancient Mesopotamian temple towers in the form of stepped pyramids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ziggurats"@en .

aat:300007633 a skos:Concept ;
    skos:definition "Ancient Roman altars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arae"@en .

aat:300007637 a skos:Concept ;
    skos:definition "Altars standing in the center of a Greek theater orchestra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thymeles"@en .

aat:300007638 a skos:Concept ;
    skos:definition "Wells or springs reputed to possess miraculous healing properties, as being a channel of divine influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy wells"@en .

aat:300007643 a skos:Concept ;
    skos:definition "Temporary structures roofed with branches and adorned with fruits or vegetables, built near a house or synagogue, and used as dining or living areas during the Jewish festival of Sukkot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sukkahs"@en .

aat:300007654 a skos:Concept ;
    skos:definition "Apparatuses in which a chain reaction of fissionable material is initiated and controlled as for generation of heat for power or for the production of plutonium from uranium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear reactors"@en .

aat:300007659 a skos:Concept ;
    skos:definition "Buildings built or used primarily to house space and facilities for scientific or other research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research buildings"@en .

aat:300007660 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings equipped with apparatus for scientific experiments or other research, testing, and investigations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratories"@en .

aat:300007664 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings where the aerodynamic properties of something are studied, as how the shape of an object may affect the flow of air and other gases in motion around and through it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerodynamics laboratories"@en .

aat:300007670 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings where people examine and test evidence related to crimes for the purpose of identifying the perpetrators and the means of the crime, typically to present in a court of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crime laboratories"@en .

aat:300007671 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings where people conduct studies and tests on the behavior and control of electrons and the design and application of devices and systems whose operation depends upon the behavior of electrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronics laboratories"@en .

aat:300007672 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings where issues regarding the natural environment are studied and tested, including issues surrounding effective resource use, resource conservation, and environmental protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental laboratories"@en .

aat:300007673 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings where tests and studies are done in the area of veterinary medicine or on specimens from animal patients at veterinary facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterinary laboratories"@en .

aat:300007675 a skos:Concept ;
    skos:definition "Buildings designed as separate, independent, and generally self-sufficient places to facilitate basic or applied research under contract or as nonprofit organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research institutes"@en .

aat:300007676 a skos:Concept ;
    skos:definition "Refers to relatively isolated places with facilities for personnel habitation on site and for conducting on-site observations of natural phenomena in specific fields. Distinct from \"experiment stations\" which are primarily for research and experimenting and generally are not physically isolated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research stations"@en .

aat:300007677 a skos:Concept ;
    skos:definition "Facilities having instruments and equipment used to make observations of atmospheric conditions in order to study and predict weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorological stations"@en .

aat:300007680 a skos:Concept ;
    skos:definition "Buildings or parts of buildings set apart for, and equipped with instruments for making, observations of natural phenomena, typically astronomical, meteorological, or geophysical phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "observatories"@en .

aat:300007683 a skos:Concept ;
    skos:definition "Facilities having equipment to measure earthquakes and other seismic phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismological stations"@en .

aat:300007688 a skos:Concept ;
    skos:definition "General term for structures providing some degree of protection, refuge, or defense; if possible, use a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelters"@en .

aat:300007689 a skos:Concept ;
    skos:definition "Reinforced underground shelters, either specifically designed or improvised, to give the civil population or military personnel protection against enemy bombing attacks by aircraft, particularly shelters dating from World War II or the inter-war years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air raid shelters"@en .

aat:300007691 a skos:Concept ;
    skos:definition "Shelters, typically underground or in caves, intended to provide reasonable protection against the radiation and fallout of atomic bombs, typically having thicker walls and other features beyond those required in shelters for protection against conventional bombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear bomb shelters"@en .

aat:300007697 a skos:Concept ;
    skos:definition "Minimal structures providing weather protection for patrons at bus stops; for more substantial buildings along bus routes, usually with sales and service facilities, use \"bus stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bus shelters"@en .

aat:300007699 a skos:Concept ;
    skos:definition "Caves, sheltering overhangs, or other naturally occurring protected areas in the living rock that are or were used as shelters or dwellings by humans, other hominids, or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock shelters"@en .

aat:300007700 a skos:Concept ;
    skos:definition "Buildings or other structures designed or utilized primarily for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage facilities"@en .

aat:300007703 a skos:Concept ;
    skos:definition "Structures used to give partial or total protection from the weather to any sort of machinery, typically characterized by having a roof and as much space as possible between the interior posts or walls, without being too deep so that each machine can be taken out easily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machinery sheds"@en .

aat:300007705 a skos:Concept ;
    skos:definition "Structures or other shelters designed or used for the storage, drying, or curing of lumber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumber sheds"@en .

aat:300007706 a skos:Concept ;
    skos:definition "Structures or parts of structures designed or used for the storage of tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toolsheds"@en .

aat:300007711 a skos:Concept ;
    skos:definition "Structures designed or used to partially or completely shelter bicycles from the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicycle sheds"@en .

aat:300007714 a skos:Concept ;
    skos:definition "Tanks used temporarily for containing fuel or another substance, usually liquid or gas rather than solid. The tanks are not intended to be linked to the equipment for which that fuel or other substance is intended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage tanks"@en .

aat:300007716 a skos:Concept ;
    skos:definition "Tanks used to store oil, but not used to supply the oil to the equipment for which it is intended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil storage tanks"@en .

aat:300007719 a skos:Concept ;
    skos:definition "Denotes South and East Asian warehouses or other storage areas, especially those in India, China, and Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "godowns"@en .

aat:300007720 a skos:Concept ;
    skos:definition "Specialized Japanese buildings devoted to storage of personal family possessions and agricultural products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kura"@en .

aat:300007722 a skos:Concept ;
    skos:definition "Structures designed or used for the storage of commodities or merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warehouses"@en .

aat:300007725 a skos:Concept ;
    skos:definition "Working places set aside for artists to work. The term is generally applied to workspaces used by artists creating fine art, particularly art dating from the 16th century to the present. The characteristics of a studio may be dictated by the practical requirements of adequate light, ample space in which to create the work of art, and storage of materials. Display of the finished art works and training may also be accommodated in a studio. Creation of an art work may require a range of artistic processes; therefore, separate areas of work may be delegated in the studio. The term may also refer to spaces used by dancers, singers, musicians, and other performing artists to create or practice. The term \"workshops\" is generally refers to spaces used by craftspeople, artists working prior to the 16th century, and industrial workers. For studios that are larger spaces or complexes, and are used to create films, television or radio programs, or other large scale productions, use \"motion picture studios,\" \"broadcasting studios,\" \"sound studios,\" \"recording studios,\" \"radio studios,\" or \"television studios.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studios"@en .

aat:300007733 a skos:Concept ;
    skos:definition "Buildings that act as workshops for specific crafts or industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workshop buildings"@en .

aat:300007734 a skos:Concept ;
    skos:definition "Workshops of a blacksmith, who is an ironsmith who makes iron into tools or other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smithies"@en .

aat:300007736 a skos:Concept ;
    skos:definition "Buildings designed or utilized for the needs of boarding and unloading passengers and the transportaion vehicles transporting them, such as a train station, bus station, or airport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation buildings"@en .

aat:300007739 a skos:Concept ;
    skos:definition "Lights, electronic apparatus, or other devices that emit identifying signals related to their position to guide or warn navigators or pilots of aircraft or ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beacons"@en .

aat:300007741 a skos:Concept ;
    skos:definition "Towers or other structures equipped with a powerful light or lights (originally a signal fire) at the top, erected at important or dangerous points on or near the coast for the guidance of mariners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighthouses"@en .

aat:300007746 a skos:Concept ;
    skos:definition "Intermediate stopping places along transportation routes; for the end points of such routes, use \"terminals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stations"@en .

aat:300007748 a skos:Concept ;
    skos:definition "Transportation buildings, or stations, which are usually built to act as a terminal point for airlines, a railway, a bus service, or another type of transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terminals"@en .

aat:300007751 a skos:Concept ;
    skos:definition "A building or group of structures, generally a railroad facility, where freight is handled either using a physical track connection to a trunk line railroad or in an isolated location removed from the trunk line. There may be carfloat service, in which flat-topped barges are used, and freight storage facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freight terminals"@en .

aat:300007752 a skos:Concept ;
    skos:definition "Complexes providing facilities to accommodate the movement of cargo or passengers among ships or between ships and shore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine terminals"@en .

aat:300007754 a skos:Concept ;
    skos:definition "Transportation buildings with facilities for handling passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passenger terminals"@en .

aat:300007757 a skos:Concept ;
    skos:definition "Building or other facilities serving as a checkpoint along a roadway for the inspection of vehicular weights, usually limited to checking trucks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weigh stations"@en .

aat:300007759 a skos:Concept ;
    skos:definition "Buildings used for functions related to water transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water transportation buildings"@en .

aat:300007765 a skos:Concept ;
    skos:definition "Towers or other elevated buildings located at large and medium-sized airports and from which the movement of aircraft and other surrounding traffic is controlled by radio or other means. The control tower structures generally rise high above other buildings at an airport and have windows, tilted outward to avoid glare, circling the entire top floor to allow a clear view for air traffic controllers. They contain necessary equipment, such as radios, radar displays, computer systems for meteorological information and flight data, controllers' headsets, telephone systems, light guns for communication with aircraft via aviation light signals, and wind and pressure gauges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "control towers"@en .

aat:300007768 a skos:Concept ;
    skos:definition "Structures for the shelter, service, and repair of aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangars"@en .

aat:300007776 a skos:Concept ;
    skos:definition "Facilities owned and operated by a railroad for receiving, delivering, or dispatching freight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freight houses"@en .

aat:300007783 a skos:Concept ;
    skos:definition "Stations along a rail line where trains load or unload passengers or goods, usually comprising a platform next to the tracks and a building providing related services such as ticket sales and waiting areas. For the stations at the beginning or end of the line, use \"railroad terminals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad stations"@en .

aat:300007789 a skos:Concept ;
    skos:definition "Facilities at the beginning or end of rail lines where trains load or unload passengers and freight, generally including a platform next to the tracks and various buildings to provide related services. For facilities for loading or unloading passengers or goods along the course of the rail line rather than at the beginning or end of the line, use \"railroad stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad terminals"@en .

aat:300007790 a skos:Concept ;
    skos:definition "Railroad stations or terminals at which tracks and facilities are shared by two or more railway companies, allowing passengers and freight to connect conveniently between them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "union stations"@en .

aat:300007795 a skos:Concept ;
    skos:definition "The parts of railroad stations that cover the tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "train sheds"@en .

aat:300007797 a skos:Concept ;
    skos:definition "Circular buildings for housing and repairing locomotives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roundhouses"@en .

aat:300007799 a skos:Concept ;
    skos:definition "Stations along or at the terminals of a tram line where trams load or unload passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tram depots"@en .

aat:300007800 a skos:Concept ;
    skos:definition "Buildings and structures used for functions related to road transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "road transportation structures"@en .

aat:300007801 a skos:Concept ;
    skos:definition "Buildings or outbuildings separate from the living quarters designed or used for the storage of coaches, carriages, other vehicles, and often horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage houses"@en .

aat:300007805 a skos:Concept ;
    skos:definition "Use only for intermediate stops along bus routes, usually containing sales and service facilities; use \"bus shelters\" for structures at bus stops affording weather protection but having no sales or service facilities; use \"bus terminals\" only to refer to buildings or other structures located at bus route endpoints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bus stations"@en .

aat:300007806 a skos:Concept ;
    skos:definition "Buildings or parts of buildings where motor vehicles are parked or housed, usually temporarily; for buildings that sell gasoline, lubricating oils, and other merchandise for motor vehicles, use \"service stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garages"@en .

aat:300007807 a skos:Concept ;
    skos:definition "Stacked parking structures comprising a building or part of a building having several stories and designed or used specifically for parking automobiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parking garages"@en .

aat:300007815 a skos:Concept ;
    skos:definition "Establishments that primarily sell gasoline, lubricating oils, and other merchandise, such as tires and batteries, for motor vehicles and that often also perform minor repair work. For buildings or parts of buildings where motor vehicles are parked or housed, usually temporarily, use \"garages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service stations"@en .

aat:300007818 a skos:Concept ;
    skos:definition "Buildings, lots, or other facilities where where goods are transferred between trucks, or between trucks and railroad cars or ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truck terminals"@en .

aat:300007820 a skos:Concept ;
    skos:definition "Structures or buildings used specifically for the collection of transportation tolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toll-collection structures"@en .

aat:300007821 a skos:Concept ;
    skos:definition "Booth, stalls, or offices at which tolls, duties, or customs are collected, particularly booths at which the toll for the right of passage across a bridge or along a road are collected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tollbooths"@en .

aat:300007823 a skos:Concept ;
    skos:definition "Gates across a road at which toll is payable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tollgates"@en .

aat:300007824 a skos:Concept ;
    skos:definition "Houses or other buildings designed or used primarily for the collection of tolls or dues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tollhouses"@en .

aat:300007825 a skos:Concept ;
    skos:definition "Rows of toll booths on a toll road, where traffic is stopped or slowed to collect tolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toll plazas"@en .

aat:300007826 a skos:Concept ;
    skos:definition "Plots of ground used for the parking of vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parking lots"@en .

aat:300007827 a skos:Concept ;
    skos:definition "Stations or inns along a route that is a thoroughfare for coaches or riders in a postal service, especially stations where fresh post horses are kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post stations"@en .

aat:300007831 a skos:Concept ;
    skos:definition "Buildings and other facilities located beside or near the water for the use of the coastguard, a military service responsible for the safety of maritime traffic in coastal waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastguard stations"@en .

aat:300007836 a skos:Concept ;
    skos:definition "Structures spanning and providing passage over waterways, topographic depressions, transportation routes, or similar circulation barriers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridges"@en .

aat:300007838 a skos:Concept ;
    skos:definition "Bridges in which the main supporting elements are arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch bridges"@en .

aat:300007841 a skos:Concept ;
    skos:definition "Temporary bridges designed for rapid construction of prefabricated, interchangeable, steel-truss panels bolted together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bailey bridges"@en .

aat:300007842 a skos:Concept ;
    skos:definition "Bridges having a deck that is directly supported from towers or pylons by straight cables without vertical suspenders. Construction of cable-stayed bridges usually follows the cantilever method. After the tower is built, one cable and a section of the deck are constructed in each direction. Each section of the deck is pre-stressed before continuing. The process is repeated until the deck sections meet in the middle, where they are connected. The ends are anchored at the abutments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable-stayed bridges"@en .

aat:300007845 a skos:Concept ;
    skos:definition "Bridges built using cantilevers, which are structures that project horizontally into space and are supported on only one end. In a typical cantilever bridge, two cantilever arms are joined in the center by a light suspended span. The balancing of forces of tension, or pulling, and the forces of compression, or squeezing, create a strong bridge; thus cantilever construction is employed for large spans in certain sites, especially for heavy loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantilever bridges"@en .

aat:300007847 a skos:Concept ;
    skos:definition "Fixed bridges that extend without hinges or joints across three or more supports, making them capable of resisting bending and shearing forces at all sections throughout their length; continuous bridges are firmly supported in the perpendicular direction by piers and abutments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous bridges"@en .

aat:300007849 a skos:Concept ;
    skos:definition "Bridges, generally temporary, with decks supported on low flat-bottomed or hollow floats, often used by the military for river crossings. Permanent pontoon bridges may be used for crossings where it is not feasible to suspend a bridge from anchored piers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pontoon bridges"@en .

aat:300007857 a skos:Concept ;
    skos:definition "Bridges with one or more spans that are lifted, raised, turned, or slid from their normal position to allow passage of navigation. Examples are vertical-lift bridges, drawbridges, transporter bridges, and swing or pivot bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movable bridges"@en .

aat:300007859 a skos:Concept ;
    skos:definition "Bridges in which sections of the span are pivoted upward by use of counterweights. For bridges whose sections are pivoted upward by chains, cables, or other ropelike devices, use \"drawbridges.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bascule bridges"@en .

aat:300007860 a skos:Concept ;
    skos:definition "Bridges with a section or sections lifted vertically between towers by counterweights or cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lift bridges"@en .

aat:300007861 a skos:Concept ;
    skos:definition "Drawbridges that open and close to river craft by rotating around a central pier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swing bridges"@en .

aat:300007867 a skos:Concept ;
    skos:definition "Bridges built obliquely from bank to bank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skew bridges"@en .

aat:300007868 a skos:Concept ;
    skos:definition "Bridges in which the roadway is suspended from cables, ropes, or chains attached to natural or constructed supports. The term applies both to primitive and massively engineered structures that share this basic principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspension bridges"@en .

aat:300007869 a skos:Concept ;
    skos:definition "Bridges having supports comprising a braced framework of timbers, piles, or steelwork usually of considerable height; used for carrying a road or railroad over a depression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trestle bridges"@en .

aat:300007872 a skos:Concept ;
    skos:definition "Timber-truss structures carrying a roadway or railroad track over a river or other obstacle, characterized by the roof and siding forming an almost complete enclosure to protect the wooden structural members from the weather. There is no evidence of timber-truss bridges, with or without covering, in the ancient world; however, drawings survive of covered bridges dating from the 14th century and later in Europe. In North America covered timber bridges were common in the 18th through early 20th centuries, although they were gradually being replaced by metal truss bridges, which required no covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered bridges"@en .

aat:300007873 a skos:Concept ;
    skos:definition "Truss bridges having the roadway or track on top of the trusses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deck truss bridges"@en .

aat:300007883 a skos:Concept ;
    skos:definition "Generally narrow bridges for people and animals to cross on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footbridges"@en .

aat:300007886 a skos:Concept ;
    skos:definition "Bridges used by the military; particularly those used in wartime, such as portable pontoon bridges used to cross rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military bridges"@en .

aat:300007890 a skos:Concept ;
    skos:definition "Bridges, usually resting on a series of arches, carrying roadways or railways over low-lying areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viaducts"@en .

aat:300007891 a skos:Concept ;
    skos:definition "Bridges that carry a road."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "road bridges"@en .

aat:300007892 a skos:Concept ;
    skos:definition "Bridges at which toll is charged for passage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toll bridges"@en .

aat:300007893 a skos:Concept ;
    skos:definition "Bridges that support a railroad track."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad bridges"@en .

aat:300007897 a skos:Concept ;
    skos:definition "Bridges containing more than one span, typically with a superstructure comprising a row of elongated single-span girders arranged end-to-end and supported at their ends on vertical support columns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multispan bridges"@en .

aat:300007898 a skos:Concept ;
    skos:definition "Bridges having only one span, being anchored only at each end with no supports in the middle; the longest single span bridges are suspension bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-span bridges"@en .

aat:300007899 a skos:Concept ;
    skos:definition "Subterranean passages, particularly roadways excavated under ground, under a hill or mountain, or beneath the bed of a river to allow passage of vehicles, trains, pedestrians, or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tunnels"@en .

aat:300007907 a skos:Concept ;
    skos:definition "Tunnels used to transport water in water supply systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water tunnels"@en .

aat:300007915 a skos:Concept ;
    skos:definition "Usually paved strips for taxiing at an airport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxiways"@en .

aat:300007918 a skos:Concept ;
    skos:definition "Specially prepared surfaces on an airfield for the taking off and landing of aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runways"@en .

aat:300007919 a skos:Concept ;
    skos:definition "Cleared but unpaved areas at the end of runways offering extra landing roll to an airplane in an emergency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overruns"@en .

aat:300007924 a skos:Concept ;
    skos:definition "Short railroad tracks connected by switches or points at one or more places with the main track and used especially to enable trains to pass each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sidings"@en .

aat:300007925 a skos:Concept ;
    skos:definition "In the context of railroads, revolving platforms that turn on a central pivot laid with rails connected to adjacent tracks; used for turning railway vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turntables"@en .

aat:300007926 a skos:Concept ;
    skos:definition "Structures used for functions related to water transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water transportation structures"@en .

aat:300007927 a skos:Concept ;
    skos:definition "Unoccupied, open water spaces allotted to vessels when alongside a landing place; when such spaces are set between adjacent piers or perpendicular to landing places, use \"slips (waterfront spaces).\" Use \"docks\" for open water spaces when occupied by vessels made fast to landing places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berths"@en .

aat:300007934 a skos:Concept ;
    skos:definition "Ramps extending from the shore or bank to the water, for the purpose of allowing boats to be put in a body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boat launching ramps"@en .

aat:300007936 a skos:Concept ;
    skos:definition "Semi-permanent anchorages consisting of a heavy anchor, chain, mooring buoy, and pennant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moorings"@en .

aat:300007937 a skos:Concept ;
    skos:definition "Multipurpose boating structures consisting of a group of piles driven close together and bound firmly into a single cluster, placed at the entrance of a dock or along a quay, wharf, or beach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolphins"@en .

aat:300007945 a skos:Concept ;
    skos:definition "Buildings with toilets and lavatory facilities for public use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comfort stations"@en .

aat:300007951 a skos:Concept ;
    skos:definition "Detached structures in public contexts containing one or more seats and a pit serving as toilets; distinguished from \"outhouses\" which are similar structures in domestic contexts. For rooms that are within buildings and have such simple facilities, use \"privies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latrines"@en .

aat:300007953 a skos:Concept ;
    skos:definition "Periods of withdrawal to a place of seclusion for the purpose of spiritual rest and restoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retreats"@en .

aat:300007956 a skos:Concept ;
    skos:definition "Designates small buildings for the Japanese tea ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teahouses"@en .

aat:300007960 a skos:Concept ;
    skos:definition "Prefabricated buildings with a semicircular cross section, generally built of corrugated metal and provided with thermal insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quonset huts"@en .

aat:300007961 a skos:Concept ;
    skos:definition "Refers a type of traditional limestone house of southern Italy, particularly southern Apulia. Trulli are circular in plan and are constructed with roughly worked limestone boulders and feature distinctive conical, domed, or pyramidal roofs of corbeled, dry-walled masonry. This mortarless technique is prehistoric but still in use in this region. Several trulli can be joined together to form complex dwellings that combine flat and conical roofs. The exteriors are often whitewashed and the roofs tile-covered; the main door is typically arched and the windows are generally few and small."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trulli"@en .

aat:300007963 a skos:Concept ;
    skos:definition "Protection measures intended to eliminate and reduce the hazard and damage that could result from avalanches, including issuing bulletins to the public, planting and maintaining stands of trees, building defensive structures, and preventatively clearing areas of loose snow by using controlled avalanches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avalanche protection"@en .

aat:300007964 a skos:Concept ;
    skos:definition "Structures that are surrounded by earth on all sides or on all sides except overhead, typically creating an almost invisible profile on the landscape and a green ideal in the savings of fuel and insulating materials. Structures that are surrounded by earth on all sides or on all sides except overhead, typically creating an almost invisible profile on the landscape and a green ideal in the savings of fuel and insulating materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth sheltered buildings"@en .

aat:300007965 a skos:Concept ;
    skos:definition "Buildings that employ methods and systems aimed at making optimal use of electricity and other resources, including using the largest possible proportion of regional resources and materials, in contrast to the conventional, inefficient practice of providing for only minimal efficiency in use of energy and drawing materials and energy from distant, centralized sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "energy efficient buildings"@en .

aat:300007967 a skos:Concept ;
    skos:definition "Buildings designed with foundations floating in water or on platforms floating in water, rather than on foundations dug into the earth on dry land. Examples include houses with foundations on a river bottom constructed so that -- if the water level rises to flood stage -- the house and the foundation will float up with the water level; and various types of buildings constructed on floating platforms or islands in a body of water, such as a lake or sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating buildings"@en .

aat:300007969 a skos:Concept ;
    skos:definition "Buildings that incorporate computerized building management systems which automatically control HVAC, security, and other systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intelligent buildings"@en .

aat:300007971 a skos:Concept ;
    skos:definition "Protection measures intended to eliminate and reduce the hazard and damage that could result from landslides, including implementing drainage systems, moving and terracing earth on hillsides, constructing retaining walls, maintaining plants and trees, and issuing bulletins to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landslide protection"@en .

aat:300007975 a skos:Concept ;
    skos:definition "Buildings designed to be movable rather than permanently located."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable buildings"@en .

aat:300007980 a skos:Concept ;
    skos:definition "Buildings designed so they can be dismantled relatively easily, typically so that they can be moved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demountable buildings"@en .

aat:300007982 a skos:Concept ;
    skos:definition "Buildings designed or used to test, for example, nontraditional construction methods, new materials, or new building system technologies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experimental buildings"@en .

aat:300007984 a skos:Concept ;
    skos:definition "Buildings designed to store and use solar radiation for heat or electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar buildings"@en .

aat:300007997 a skos:Concept ;
    skos:definition "Buildings, monuments, and other structures that are intended to be non-permanent, sometimes transportable. Erected for festive or sporting events or to provide access to or protection or support of facilities under construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temporary structures"@en .

aat:300007998 a skos:Concept ;
    skos:definition "Buildings having no windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "windowless buildings"@en .

aat:300008001 a skos:Concept ;
    skos:definition "Detached buildings separate from a main building. Detached buildings separate from a main building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outbuildings"@en .

aat:300008004 a skos:Concept ;
    skos:definition "Buildings, often partly or wholly underground, in which ice, often ice collected in winter, is stored for use throughout the year. Examples were specially insulated and ventilated agricultural buildings, increasingly popular after the mid-19th-century rise in dairy production, for the storing of ice blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icehouses"@en .

aat:300008006 a skos:Concept ;
    skos:definition "Rooms or spaces that are within buildings and have one or more seats and a pit used as toilets which lack plumbing facilities, distinguished from \"outhouses\" which are separate structures in domestic contexts containing similar arrangements of toilet facilities. For rooms or spaces with toilets having plumbing, use \"bathrooms\" or \"lavatories (rooms).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "privies"@en .

aat:300008013 a skos:Concept ;
    skos:definition "Buildings enclosing a natural spring; sufficiently cool for use as a storehouse of milk and other dairy products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springhouses"@en .

aat:300008014 a skos:Concept ;
    skos:definition "Wholly or partially underground refuges from tornadoes or other violent storms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm cellars"@en .

aat:300008016 a skos:Concept ;
    skos:definition "Outbuilding where washing is done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washhouses"@en .

aat:300008017 a skos:Concept ;
    skos:definition "Structures attached to the opening of a well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "well houses"@en .

aat:300008019 a skos:Concept ;
    skos:definition "Refers to caves that are utilized, generally having been excavated or otherwise altered, for sheltering humans or animals, or for use as storage, worship, or another use. This term may overlap in meaning with \"rock-cut architecture,\" but cave architecture is not necessarily rock-cut, and rock-cut architecture is not necessarily designed around a cave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cave architecture"@en .

aat:300008020 a skos:Concept ;
    skos:definition "Formations made of earth, resulting from the grading, trenching, or embanking of earth for utilitarian or cermonial purposes. Examples include Medieval fortifications and ancient ceremonial sites in Britain and Europe. For earth constructions having more of an artistic, rather than functional, purpose, use \"earthworks (sculpture).\" For works considered architecture rather than engineering works, prefer \"earthen architecture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthworks"@en .

aat:300008022 a skos:Concept ;
    skos:definition "Long, narrow, usually steep-sided cuts into the earth, as to receive pipes, wires, or footings; may also be used for defensive cuts, especially when the excavated earth is heaped in front as a barrier. For defensive cuts in which the earth is not used as added protection, use \"fosses\" or \"moats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trenches"@en .

aat:300008023 a skos:Concept ;
    skos:definition "Long ridges of earth, rocks, or gravel primarily constructed to carry a roadway; if built to retain water, use \"levees\" or \"dikes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embankments"@en .

aat:300008024 a skos:Concept ;
    skos:definition "Piles of earth heaped up for landmarks, monuments, or as bases for other structures; for piles of earth and other debris resulting from successive superimposed occupation sites, use \"tells.\" For piles of earth built over grave sites, use \"burial mounds.\" Use \"cairns\" for purposely erected piles of stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounds"@en .

aat:300008026 a skos:Concept ;
    skos:definition "Large earthworks formed in the likeness of birds and animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "effigy mounds"@en .

aat:300008027 a skos:Concept ;
    skos:definition "Cavities in the earth, usually not below ground water level, that are shallow in proportion to their width and generally created for materials extraction or burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pits"@en .

aat:300008028 a skos:Concept ;
    skos:definition "Structures designed to be built on a moon or a planet other than Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extraterrestrial structures"@en .

aat:300008029 a skos:Concept ;
    skos:definition "Use only for manned installations established on natural extraterrestrial bodies for specific functions. For larger communities established in space or on natural extraterrestrial bodies, use \"space colonies.\" For manned artificial satellites set to revolve in a fixed orbit and serving as a base for specific functions, use \"space stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extraterrestrial bases"@en .

aat:300008030 a skos:Concept ;
    skos:definition "Manned artificial satellites designed to revolve in a fixed orbit and to serve as a base for specific functions (e.g., scientific observations or the refueling of spaceships). For manned installations established on natural extraterrestrial bodies for specific functions, use \"extraterrestrial bases.\" For larger communities established in space or on natural extraterrestrial bodies, use \"space colonies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space stations"@en .

aat:300008031 a skos:Concept ;
    skos:definition "Refers to structures excavated into living rock. This term may overlap in meaning with \"cave architecture,\" but cave architecture is not necessarily rock-cut, and rock-cut architecture is not necessarily designed around a cave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-cut architecture"@en .

aat:300008033 a skos:Concept ;
    skos:definition "Structures built on sloping sites, as on the sides of hills or mountains. For architecture built of earth or primarily into the earth, prefer \"earthen architecture.\" For architecture created from caves, prefer \"cave architecture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hillside architecture"@en .

aat:300008038 a skos:Concept ;
    skos:definition "Structures built in relation to water in general, especially seaward of the high-water line of the major water bodies (oceans, seas, bays); use \"offshore structures\" for construction built on continental shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine structures"@en .

aat:300008039 a skos:Concept ;
    skos:definition "Use only for structures built adjacent to the continental land masses and on the continental shelves, often located within the navigable areas of coastal waterways; use \"marine structures\" for construction built seaward of high-water lines of oceans, seas, or bays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offshore structures"@en .

aat:300008042 a skos:Concept ;
    skos:definition "Structures designed to be built or to be located largely or totally under water in an ocean or sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submarine structures"@en .

aat:300008046 a skos:Concept ;
    skos:definition "Buildings constructed wholly or mostly beneath the surface of the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground buildings"@en .

aat:300008047 a skos:Concept ;
    skos:definition "Structures constructed wholly or mostly beneath the surface of the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground structures"@en .

aat:300008048 a skos:Concept ;
    skos:definition "Buildings designed to be built or located mostly or totally under the surface of a lake, river, sea, or ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater buildings"@en .

aat:300008055 a skos:Concept ;
    skos:definition "Designates buildings or groups of buildings that are abandoned by their owners, often constituting potential public hazards. In a legal connotations, the term does not include buildings that are temporarily vacant or unoccupied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned buildings"@en .

aat:300008057 a skos:Concept ;
    skos:definition "The remains of buildings or groups of buildings that have been destroyed or are in a state of great disrepair or decay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruins"@en .

aat:300008059 a skos:Concept ;
    skos:definition "Buildings or groups of buildings owned and operated by a governing body, carrying out official duties, and often occupied by a governmental agency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public buildings"@en .

aat:300008063 a skos:Concept ;
    skos:definition "Buildings that are significant in the history of architecture, that incorporate significant architectural features, or that played significant historic roles in local cultural or social development; may or may not be officially designated. For buildings that are abandoned but not considered necessarily historic, use \"abandoned buildings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic buildings"@en .

aat:300008064 a skos:Concept ;
    skos:definition "Houses with architectural, social, or cultural significance; may or may not be officially designated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic houses"@en .

aat:300008065 a skos:Concept ;
    skos:definition "Buildings that serve as points of reference because their height, siting, distinctive design, use, historic significance, or other feature sets them apart from surrounding buildings. Examples may include churches and town halls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landmark buildings"@en .

aat:300008067 a skos:Concept ;
    skos:definition "Use only for buildings designed to be flexible enough to serve different purposes at different times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multipurpose buildings"@en .

aat:300008072 a skos:Concept ;
    skos:definition "Spaces in urban environments designed as passages for pedestrians, and as social spaces, not as clearly delimited as parks, but sharing some of the same characteristics. Often these function as utilitarian connecting spaces between buildings, or simply as an open area designated by a municipal authority, but without the amenities or formality of a park."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open spaces"@en .

aat:300008074 a skos:Concept ;
    skos:definition "In ancient Greek settlements, open spaces used as marketplaces or general public meeting places. For similar spaces in ancient Roman settlements, use \"forums.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agoras"@en .

aat:300008077 a skos:Concept ;
    skos:definition "Pieces of land within urban areas usually bounded on all sides by streets or other transportation routes, natural physical barriers, or public open space and not traversed by through streets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city blocks"@en .

aat:300008081 a skos:Concept ;
    skos:definition "Expanses of land, paved or green, owned by the community as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commons"@en .

aat:300008083 a skos:Concept ;
    skos:definition "Multiple dwellings composed of row houses whose facades in plan follow the concave arc of a circle or ellipse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crescents"@en .

aat:300008085 a skos:Concept ;
    skos:definition "In ancient Roman settlements, open spaces used as marketplaces or general public meeting places and places for judicial and public business. For similar spaces in ancient Greek settlements, use \"agoras.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forums"@en .

aat:300008090 a skos:Concept ;
    skos:definition "Area of ground or open space; usually, but not always, where flowers, shrubs, trees, vegetables, or fruits are grown and cultivated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gardens"@en .

aat:300008092 a skos:Concept ;
    skos:definition "Gardens whose plantings, walks, pools, fountains, and other features follow a definite, recognizable plan, frequently symmetrical, emphasizing geometrical forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formal gardens"@en .

aat:300008093 a skos:Concept ;
    skos:definition "Islamic formal gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bagh"@en .

aat:300008094 a skos:Concept ;
    skos:definition "Formal gardens that employ a geometric design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometric gardens"@en .

aat:300008097 a skos:Concept ;
    skos:definition "Gardens focused on a labyrinthine design having many intricate turnings and windings that are defined by flowers, hedges, or other plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maze gardens"@en .

aat:300008100 a skos:Concept ;
    skos:definition "Gardens or plantings that are on a steep slope, on a stepped pyramid or ziggurat, on the top of a wall, on a roof, or otherwise situated so as to hang over the ground below or to appear to float. The most famous example was the hanging gardens of Babylon, one of the seven wonders of the ancient world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging gardens"@en .

aat:300008101 a skos:Concept ;
    skos:definition "Gardens decorated with rocks, usually a wide variety of multicolored and differently shaped rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock gardens"@en .

aat:300008106 a skos:Concept ;
    skos:definition "Botanical gardens devoted to the cultivation and exhibition of trees and other woody plants, rare or otherwise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arboretums"@en .

aat:300008110 a skos:Concept ;
    skos:definition "Private gardens established primarily for growing vegetables and herbs for domestic consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen gardens"@en .

aat:300008112 a skos:Concept ;
    skos:definition "Gardens often provided with shade, flowing water, pavilions, and elaborate plantings for private enjoyment; common in Islamic countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paradise gardens"@en .

aat:300008115 a skos:Concept ;
    skos:definition "Gardens, whether public or private, intended for enjoyment and amusement. Pleasure gardens may focus on flowers, shrubs, vegetables, and fruit trees, together with pedestrian paths, water features, mazes, vistas, etc.; typically enclosed by a wall or hedge. For larger areas having a similar purpose but without an enclosing wall and including woods, use \"pleasure parks.\" Later pleasure gardens were sometimes open to the public and charged a fee for admittance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleasure gardens"@en .

aat:300008116 a skos:Concept ;
    skos:definition "Landscaped areas designed to display sculpture, publicly or privately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture gardens"@en .

aat:300008124 a skos:Concept ;
    skos:definition "Use chiefly for Medieval gardens, generally found in monasteries, often formally arranged with planters and boxed sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloister gardens"@en .

aat:300008129 a skos:Concept ;
    skos:definition "Gardens, contained within walls, typically attached to a residence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walled gardens"@en .

aat:300008131 a skos:Concept ;
    skos:definition "Gardens, situated on rooftops, typically in urban areas above private houses or commercial buildings. The depth of soil is limited to keep the weight low and the plants are usually set in tubs or similar containers, but elaborate roof gardens have been constructed with small pools and beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roof gardens"@en .

aat:300008132 a skos:Concept ;
    skos:definition "Small private gardens, primarily, but not restricted to, those found accompanying Italian Renaissance villas, discreetly hidden, but not secret, set near the house and designed as intimate places for entertaining and pensive reflection away from the public gaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giardini segreti"@en .

aat:300008135 a skos:Concept ;
    skos:definition "Gardens devoted to the cultivation of flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower gardens"@en .

aat:300008138 a skos:Concept ;
    skos:definition "Gardens in which primarily herbs are grown, often for flavoring food or making perfumes and medicines. For buildings or areas within buildings containing a systematically ordered collection of preserved plants, use \"herbaria.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herb gardens"@en .

aat:300008140 a skos:Concept ;
    skos:definition "Denotes generally hilly gardens buttressed by or built up of cut blocks of peat with terraces for plantings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peat gardens"@en .

aat:300008142 a skos:Concept ;
    skos:definition "Gardens in which primarily vegetables are grown; normally of modest size, although may be extensive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable gardens"@en .

aat:300008144 a skos:Concept ;
    skos:definition "Areas of green space within communities or neighborhoods available for cultivation, usually by residents, and managed by local committees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community gardens"@en .

aat:300008151 a skos:Concept ;
    skos:definition "Originally, gardens designed to reflect the power and largesse of the aristocracy. Contemporary usage extends to gardens maintained by individuals that are somehow enclosed or secluded, regardless of size, and that may evoke the fanciful or fantastic. Variations of the private garden may be designed to house a collection of artworks, or to highlight a particular plant genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private gardens"@en .

aat:300008152 a skos:Concept ;
    skos:definition "Mediterranean fruit tree gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bustanim"@en .

aat:300008155 a skos:Concept ;
    skos:definition "Planned spaces that are open to the public, usually located outdoors, and focused on plants and other natural or landscaped features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public gardens"@en .

aat:300008158 a skos:Concept ;
    skos:definition "Gardens designed to reflect a period in history, either in form or through the use of heirloom plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic gardens"@en .

aat:300008162 a skos:Concept ;
    skos:definition "Tiny landscapes laid out in planters, window boxes, terrariums, or similar containers, consisting of dwarf plants and often tiny replicas of land forms, bodies of water, and models of buildings, bridges, temples, and other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature gardens"@en .

aat:300008163 a skos:Concept ;
    skos:definition "Designates miniature Chinese plants and landscapes formed from them, often including stones, water, and miniature figures and buildings; also, the art of creating such gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penjing"@en .

aat:300008164 a skos:Concept ;
    skos:definition "Grassy, public open spaces near the center of a town and used for a variety of community functions, found especially in New England and Mid-Atlantic states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greens"@en .

aat:300008166 a skos:Concept ;
    skos:definition "Delimited portions of land, usually as lawn, plantings, or left natural surrounding and belonging to a house or other building. Grounds serve chiefly for ornament or recreation. Grounds may be enclosed; they may include gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grounds"@en .

aat:300008170 a skos:Concept ;
    skos:definition "Yards which belong to churches and are used as places for burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "churchyards"@en .

aat:300008171 a skos:Concept ;
    skos:definition "Spaces where fairs, horse races, and other events are held, typically set aside by a city, county, or state for an annual fair. Fairgrounds often include exhibition buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fairgrounds"@en .

aat:300008173 a skos:Concept ;
    skos:definition "Areas in parks or other municipally maintained spaces designated for open-air food preparation and dining. They are commonly furnished with tables, seats, and waste receptacles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picnic areas"@en .

aat:300008176 a skos:Concept ;
    skos:definition "Open public areas, walks, or plazas, often lined with trees, shrubs, or shops, reserved for use by pedestrians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestrian malls"@en .

aat:300008178 a skos:Concept ;
    skos:definition "Areas established for the purpose of preserving distinctive natural communities of plants and animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nature reserves"@en .

aat:300008180 a skos:Concept ;
    skos:definition "Areas of land whose natural growth is protected by legislation and where recreation and industrial use are restricted; for wild and uncultivated regions left untouched in a natural state with no human control or interference, use \"wilderness.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wilderness areas"@en .

aat:300008181 a skos:Concept ;
    skos:definition "Areas set aside for feeding, roosting, nesting, breeding, and habitat protection for species of animals and plants native to the region; also offering protection from hunting, and sometimes protection from predation and competition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wildlife refuges"@en .

aat:300008184 a skos:Concept ;
    skos:definition "Areas of land where birds are protected and encouraged to build and breed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird sanctuaries"@en .

aat:300008186 a skos:Concept ;
    skos:definition "Open spaces, such as a cliff, that affords a scenic view or vista."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overlooks"@en .

aat:300008187 a skos:Concept ;
    skos:definition "Permanently dedicated recreation areas, often open to the public and generally characterized by their natural, historic, or landscape features; often administered by governmental agencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parks"@en .

aat:300008189 a skos:Concept ;
    skos:definition "Areas of special scenic, historical, or scientific importance set aside and maintained by a national government especially for recreation or study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national parks"@en .

aat:300008192 a skos:Concept ;
    skos:definition "Parks owned or maintained by the state, particularly a U.S. state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state parks"@en .

aat:300008195 a skos:Concept ;
    skos:definition "Public parks in Canada administered by the provincial government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provincial parks"@en .

aat:300008196 a skos:Concept ;
    skos:definition "Generally refers to parks that are smaller than national parks and providing a wide range of recreation facilities with less emphasis on the landscape value of the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional parks"@en .

aat:300008197 a skos:Concept ;
    skos:definition "Small parks serving central business districts, highly urban areas (including new towns), or commercial districts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban parks"@en .

aat:300008203 a skos:Concept ;
    skos:definition "Areas used play and recreation, especially by children, and often containing such equipment as swings, slides, seesaws, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playgrounds"@en .

aat:300008214 a skos:Concept ;
    skos:definition "Small public squares in towns or landscaped pedestrian spaces adjacent to office buildings or parking areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plazas"@en .

aat:300008216 a skos:Concept ;
    skos:definition "Rectangular grassy or paved areas surrounded by buildings, generally of an academic or civic nature. Distinguished from \"courtyards\" which generally fall within the bounds of a single building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrangles"@en .

aat:300008217 a skos:Concept ;
    skos:definition "General term referring to all long outdoor passages used by and generally created by humans, intended to allow people to pass between different places, usually one wide enough to admit of the passage of wheeled vehicles, horses, or travellers on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roads"@en .

aat:300008220 a skos:Concept ;
    skos:definition "Refers to major, high-speed, high-capacity roads between urban areas. The original meaning of \"highways\" referred to Roman roads that were raised above the ground level; for this meaning, use \"elevated roads.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "highways"@en .

aat:300008222 a skos:Concept ;
    skos:definition "Intercity roads, usually with entrances at restricted locations and channelized intersections, designed to move large volumes of traffic; use only with reference to the flow of traffic within a transportation system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arterials"@en .

aat:300008224 a skos:Concept ;
    skos:definition "Highways built around the perimeters of urban areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beltways"@en .

aat:300008227 a skos:Concept ;
    skos:definition "Highways with a broad median strip extending down the center, designed to prevent collisions and headlight glare from oncoming traffic. Highways with a broad median strip extending down the center, designed to prevent collisions and headlight glare from oncoming traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divided highways"@en .

aat:300008228 a skos:Concept ;
    skos:definition "Roadways raised about ground level by being supported on banks of earth, arches, pillars, or other structural elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elevated roads"@en .

aat:300008231 a skos:Concept ;
    skos:definition "Roads or pathways raised above surrounding low, wet, or uneven ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "causeways"@en .

aat:300008237 a skos:Concept ;
    skos:definition "Roads for which points of entrance and exit for traffic are controlled by limiting the number of access roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limited access highways"@en .

aat:300008239 a skos:Concept ;
    skos:definition "Divided multilane highways with a minimum of traffic signals where grades are separated at important intersections, although there may be some grade crossings; can be freeways or turnpikes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expressways"@en .

aat:300008245 a skos:Concept ;
    skos:definition "Refers either to high-speed multilane highways or 18th- and 19th-century thoroughfares along which tolls are collected from users; can be expressways or throughways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turnpikes"@en .

aat:300008247 a skos:Concept ;
    skos:definition "A road in a city, town, or village, characterized by usually being paved and comparatively wide (as opposed to a lane or alley), and generally running between two rows of houses or other buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "streets"@en .

aat:300008248 a skos:Concept ;
    skos:definition "Narrow streets, usually wide enough for only one vehicle or for pedestrians, passing between buildings or giving access off of main streets to back entrances or garages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alleys"@en .

aat:300008249 a skos:Concept ;
    skos:definition "Narrow, ancient Roman alleys, often leading to a dead end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angiportūs"@en .

aat:300008250 a skos:Concept ;
    skos:definition "Wide, straight, usually tree-lined roads or approaches; for walkways in gardens or parks bordered by formally planted trees, use \"allées.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avenues"@en .

aat:300008251 a skos:Concept ;
    skos:definition "Wide city streets characterized by rows of trees or other plantings decoratively laid out along the sides or in a median strip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boulevards"@en .

aat:300008253 a skos:Concept ;
    skos:definition "Streets open only at one end. For alleys open only at one end, use \"blind alleys.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dead-end streets"@en .

aat:300008254 a skos:Concept ;
    skos:definition "Dead-end streets that have circular turn-around areas at their ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culs-de-sac"@en .

aat:300008258 a skos:Concept ;
    skos:definition "Narrow ways generally wide enough for only a single line of moving persons or vehicles and often set between defined borders, as of hedges, fences, or buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanes"@en .

aat:300008262 a skos:Concept ;
    skos:definition "Use only for principal thoroughfares, usually those along which are found the primary mercantile establishments, of small to mid-size settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "main streets"@en .

aat:300008264 a skos:Concept ;
    skos:definition "Designates the east-west streets used in laying out ancient Roman countryside tracts and associated towns and thus, by extension, the main east-west streets, distinguished by greater width and scale of appointments, of planned Roman towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decumani"@en .

aat:300008265 a skos:Concept ;
    skos:definition "Urban stables with living accommodations above grouped around a courtyard or small street for use by carriage horses; may also be used by extension in modern contexts for the alleyways such stables front upon when the stables have been converted into apartments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mews"@en .

aat:300008266 a skos:Concept ;
    skos:definition "Streets valid for travel in one direction only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-way streets"@en .

aat:300008268 a skos:Concept ;
    skos:definition "Urban streets lined with storefronts and closed off to most automobile traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestrian streets"@en .

aat:300008271 a skos:Concept ;
    skos:definition "Streets designed for processions or other such ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional ways"@en .

aat:300008273 a skos:Concept ;
    skos:definition "Streets along which traffic has the right of way over vehicles entering or crossing at intersections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "through streets"@en .

aat:300008274 a skos:Concept ;
    skos:definition "Protected residential areas in which most vehicular traffic has its destination within the designated area, curb distinctions between street and sidewalk have been eliminated, and streets are shared by pedestrians and vehicles; originated in Holland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woonerven"@en .

aat:300008281 a skos:Concept ;
    skos:definition "Roads constructed by or reserved primarily for the transport of military personnel, equipment, and vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military roads"@en .

aat:300008282 a skos:Concept ;
    skos:definition "More recently, refers to roads over which mail is carried. Historically, roads with stations providing for horses for postriders, mailcoaches, or travelers. More recently, refers to roads over which mail is carried. Historically, roads with stations providing for horses for postriders, mailcoaches, or travelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post roads"@en .

aat:300008283 a skos:Concept ;
    skos:definition "Roads that comprise the principal arteries through an area; originally indicated specially surfaced routes intended for vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary roads"@en .

aat:300008285 a skos:Concept ;
    skos:definition "Roads that are privately owned and maintained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private roads"@en .

aat:300008287 a skos:Concept ;
    skos:definition "Minor roads of a class and condition lower than that of main roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary roads"@en .

aat:300008289 a skos:Concept ;
    skos:definition "Roads that run parallel to an express or highway, providing access to local stores and businesses. Roads that run parallel to an express or highway, providing access to local stores and businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service roads"@en .

aat:300008290 a skos:Concept ;
    skos:definition "Roads or systems of roads reserved for trucks and other large vehicles; intended to avoid interference to and from local traffic and to improve road safety."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truck routes"@en .

aat:300008293 a skos:Concept ;
    skos:definition "Roads having double- or triple-decked passages for traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multi-level roads"@en .

aat:300008294 a skos:Concept ;
    skos:definition "Limited access highways located within a park or parklike setting and intended for only passenger cars and noncommercial traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parkways"@en .

aat:300008295 a skos:Concept ;
    skos:definition "Roads that are dug out of the surrounding landscape, having a path lower than ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunken roads"@en .

aat:300008301 a skos:Concept ;
    skos:definition "Roads surfaced with macadam, a type of broken stone named after J. L. MacAdam (1756-1836), the Scottish engineer who invented it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macadamized roads"@en .

aat:300008304 a skos:Concept ;
    skos:definition "Open public spaces in cities or towns, usually rectilinear, surrounded by buildings, and located at the junction of two or more thoroughfares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squares"@en .

aat:300008307 a skos:Concept ;
    skos:definition "Enclosed open spaces in front of and preceding the entry to European churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parvises"@en .

aat:300008319 a skos:Concept ;
    skos:definition "Walkways through gardens, typically narrow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden walks"@en .

aat:300008321 a skos:Concept ;
    skos:definition "Narrow walks or ways, typically not constructed like a road, and intended to be traveled by foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paths"@en .

aat:300008324 a skos:Concept ;
    skos:definition "Paths, paved or unpaved, specifically designed or designated for use by bicyclists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicycle paths"@en .

aat:300008329 a skos:Concept ;
    skos:definition "Open places for walking or strolling; examples are paved or wooden public walk along the seafront at a resort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promenades"@en .

aat:300008331 a skos:Concept ;
    skos:definition "Use both for shaded promenades, often with plantings and seating areas, in Spanish-speaking countries and for public gardens or parks with similar characteristics in the southwest United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alamedas"@en .

aat:300008333 a skos:Concept ;
    skos:definition "Denotes generally enclosed and climate-controlled pedestrian walkways or networks of them consisting of bridgelike structures over streets, second-story corridors within buildings, and various activity hubs connecting retail and service establishments, usually in a downtown area; for the individual bridgelike structures over streets, use \"skybridges.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skywalks"@en .

aat:300008338 a skos:Concept ;
    skos:definition "Permanently reserved zones of land around and between cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenbelts"@en .

aat:300008340 a skos:Concept ;
    skos:definition "Spaces, land, or part of a city or town on the edge of body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterfronts"@en .

aat:300008342 a skos:Concept ;
    skos:definition "Spaces, land, or part of a city or town on the edge of a lake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lakefronts"@en .

aat:300008343 a skos:Concept ;
    skos:definition "Spaces, land, or part of a city or town on the edge of a river."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riverfronts"@en .

aat:300008347 a skos:Concept ;
    skos:definition "General term for places or areas occupied, modified, or planned to be inhabited by communities of human populations and that contain enough societal functions to be relatively self-sufficient. They are characterized by inhabitants living in neighboring sets of living quarters and by the place having a proper name or a locally recognized status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inhabited places"@en .

aat:300008356 a skos:Concept ;
    skos:definition "Cities designed on an urban plan having a series of functionally specialized parallel sectors, such as a zone for railways, a zone for educational and cultural institutions, a residential zone, a park zone, an agricultural zone, and a green zone buffering the city from the highway. Such cities were ideally placed parallel to a river and so that winds would blow industrial air away from residential areas. The idea was developed by Arturo Soria for Madrid, Spain in the 19th century; other experiments took place primarily in Russia and Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear cities"@en .

aat:300008369 a skos:Concept ;
    skos:definition "Small rural centers which contain basic community, education, and religious facilities and which generally do not exceed 250 residents; may also refer to the smallest incorporated units of a municipal government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hamlets"@en .

aat:300008372 a skos:Concept ;
    skos:definition "Distinctions among villages, towns, and cities are relative and vary according to their individual regional contexts. Villages generally designate units of compact settlement, varying in size but usually larger than hamlets and smaller than towns and distinguished from the surrounding rural territory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villages"@en .

aat:300008375 a skos:Concept ;
    skos:definition "Distinctions among villages, towns, and cities are relative and vary according to their individual regional contexts. Towns generally are units of compact settlement larger than villages and less important and internally complex than cities in the region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towns"@en .

aat:300008377 a skos:Concept ;
    skos:definition "New, essentially self-sufficient settlements, usually modest in size, which are built in a previously undeveloped area. Their purpose is typically to provide residential, commercial, industrial, educational, recreational, and public facilities for larger urban areas. The term is often reserved for such settlements sponsored or approved by a government and created in a rural or undeveloped area to absorb overspill population from a nearby large city. Examples of new towns are the planned communities of the New Towns Movement in the United Kingdom after World War II, for which communities were purposefully planned, developed, and built to alleviate overcrowding in large cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "new towns"@en .

aat:300008381 a skos:Concept ;
    skos:definition "Cities or sections of cities newly planned to incorporate large tracts of green spaces, to control internal growth and development, and to separate industrial and nonindustrial activities. Distinguished from \"garden suburbs\" by their larger size and urban location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden cities"@en .

aat:300008384 a skos:Concept ;
    skos:definition "Smaller cities on the outskirts of larger metropolitan areas that are independent of the larger city's jurisdiction but dependent on its economic and social orbit. Satellite cities may be planned as such or they may result from ad hoc growth. For planned communities designed to be socially or economically independent of larger metropolitan areas use \"new town.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite cities"@en .

aat:300008389 a skos:Concept ;
    skos:definition "Distinctions among villages, towns, and cities are relative and vary according to their individual regional contexts. Generally, cities designate large or important communities with population, status, and internal complexity greater than most towns in the region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cities"@en .

aat:300008394 a skos:Concept ;
    skos:definition "Refers to certain cities, towns, or colonies in the Roman Empire and Republic, or later on the Italian peninsula, originally where citizens assumed communal obligation in exchange for the privileges and protections of citizenship. Eventually two orders of municipia developed, one where citizens had the right to vote and other rights if Roman, the other with lesser rights if they were tribal centers under Roman control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipia"@en .

aat:300008396 a skos:Concept ;
    skos:definition "Late Iron Age and Roman period native settlements in Europe, often hillforts or otherwise lightly fortified, located as centers within the territory of local tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oppida"@en .

aat:300008397 a skos:Concept ;
    skos:definition "Ancient Greek cities or city-states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poleis"@en .

aat:300008400 a skos:Concept ;
    skos:definition "Large, unplanned clusterings of urban populations, that, as a result of urban sprawl, have outgrown local governmental boundaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agglomerations"@en .

aat:300008401 a skos:Concept ;
    skos:definition "Chief cities, often capital cities, of a region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metropolises"@en .

aat:300008402 a skos:Concept ;
    skos:definition "Great urbanized areas or clusters of urbanized areas produced by the expansion and merging of several neighboring metropolises or conurbations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megalopolises"@en .

aat:300008404 a skos:Concept ;
    skos:definition "Extensive built-up urban areas that contain some isolated rural areas and are formed by the merging together of cities or towns that formerly were separate. For more extensive or comprehensive clusters of urban areas, use \"megalopolises.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conurbations"@en .

aat:300008410 a skos:Concept ;
    skos:definition "Cities that are the official seat of government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capital cities"@en .

aat:300008415 a skos:Concept ;
    skos:definition "Settlements that are governed locally, subject to local jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local administrative centers"@en .

aat:300008416 a skos:Concept ;
    skos:definition "The seat of government of a county."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "county seats"@en .

aat:300008419 a skos:Concept ;
    skos:definition "County seats in Louisiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parish seats"@en .

aat:300008420 a skos:Concept ;
    skos:definition "Relatively small settlements that grow up around farming activities; usually refers to early farming settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural settlements"@en .

aat:300008423 a skos:Concept ;
    skos:definition "Communities of relatively small size that hold a market, typically agricultural centers in a rural area. Market towns typically developed as a location to trade farm products, sometimes near fortified places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market towns"@en .

aat:300008429 a skos:Concept ;
    skos:definition "Communities, relatively large in size, that are the location of a university, which is a type of degree-granting institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "university cities"@en .

aat:300008430 a skos:Concept ;
    skos:definition "Communities, typically small or medium-sized towns or cities, that have economies centered on a college and the college population."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "college towns"@en .

aat:300008432 a skos:Concept ;
    skos:definition "Communities of modest size, built mostly since the Industrial Revolution, in which the primary employment is in factories. When the primary employment is in factories for the manufacture of paper, steel, or textiles, use \"mill towns.\" When settlements are purposely built by factory owners to attract workers to isolated locations, use \"factory villages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial towns"@en .

aat:300008436 a skos:Concept ;
    skos:definition "Designates industrial settlements in which the primary employment is in factories for the manufacture of, for example, paper, steel, or textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mill towns"@en .

aat:300008439 a skos:Concept ;
    skos:definition "Encampments formed by troops for long stays while on a campaign, especially during winter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantonments"@en .

aat:300008440 a skos:Concept ;
    skos:definition "Permanent ancient Roman military encampments laid out on a grid; may also designate later castles, forts, or fortified towers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castra"@en .

aat:300008449 a skos:Concept ;
    skos:definition "Medieval settlements built for defense and often laid out on an orthogonal grid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastides"@en .

aat:300008450 a skos:Concept ;
    skos:definition "Small, ancient Roman fortified towns or outposts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castelli"@en .

aat:300008454 a skos:Concept ;
    skos:definition "Settlements whose primary concern is military; may also be used for settlements upon which military considerations have had a considerable formal or economic influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military towns"@en .

aat:300008455 a skos:Concept ;
    skos:definition "Military settlements established by the Spanish in America often as garrisoned forts or outposts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presidios"@en .

aat:300008458 a skos:Concept ;
    skos:definition "Communities, relatively large in size, that are the location of a cathedral, which is the principal church of a Christian diocese and seat of the bishop, archbishop, primate, or patriarch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedral cities"@en .

aat:300008461 a skos:Concept ;
    skos:definition "Communities of relativelly small size that are located near a body of water and have economies centered on fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing villages"@en .

aat:300008464 a skos:Concept ;
    skos:definition "Communities, relatively modest in size, that grew up around or have economies centered on the activities of mining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mining towns"@en .

aat:300008479 a skos:Concept ;
    skos:definition "Settlements situated on a hill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hill towns"@en .

aat:300008482 a skos:Concept ;
    skos:definition "Towns situated near or on a river."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river towns"@en .

aat:300008483 a skos:Concept ;
    skos:definition "Towns located along a coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal towns"@en .

aat:300008485 a skos:Concept ;
    skos:definition "Designates cities built in territories where no urban settlements existed before, generally created following an overall plan, and often established by an urban culture for purposes of local administration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonial cities"@en .

aat:300008486 a skos:Concept ;
    skos:definition "Self-sustaining frontier or outpost settlements created by a body of persons sent out by a religious organization to evangelize abroad, and often to aid in the administering of colonial wilderness enterprises. They are sometimes established under the protection of a government, as with the Spanish settlements of America. Missions typically include buildings for housing the people and activities of the group, including a church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missions"@en .

aat:300008487 a skos:Concept ;
    skos:definition "Villages or communities, often federally recognized, of Indigenous peoples of the southwestern United States (specifically Pueblo peoples). May also refer more broadly to villages in Spain or Colonial Spanish America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pueblos"@en .

aat:300008492 a skos:Concept ;
    skos:definition "Urban areas or communities within them whose design incorporates innovative attempts at solving specific social and physical problems; often applied to the redesign of existing settlements in the 19th and 20th centuries. For 19th-century cities built with prescribed forms to fulfill specific military or economic ideals, use \"ideal cities.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model cities"@en .

aat:300008496 a skos:Concept ;
    skos:definition "Use especially with reference to the urban designs of the Futurists of the early 20th century; may also be used in general for projected forms or lifestyles of settlements in the future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "future cities"@en .

aat:300008498 a skos:Concept ;
    skos:definition "Cities and towns designed and built to fulfill a specific political, military, economic, or pedagogic function and having a prescribed form imposed on them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ideal cities"@en .

aat:300008503 a skos:Concept ;
    skos:definition "Rural settlements occupied primarily by artists in environments perceived to be sympathetic to creative endeavors; historically, formed especially to escape urban life or to be near nature or simple country life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' colonies"@en .

aat:300008505 a skos:Concept ;
    skos:definition "Residential treatment centers, often in a rural setting, which provide medical and counseling services for children with emotional problems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's villages"@en .

aat:300008506 a skos:Concept ;
    skos:definition "Tracts of land set aside, usually by the United States government or a single US state's government, for the use of one or more native North American peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian reservations"@en .

aat:300008507 a skos:Concept ;
    skos:definition "Hospitals treating those afflicted with leprosy. For hospitals treating very dangerous contagious diseases, common during the Middle Ages, use \"lazarettos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leprosaria"@en .

aat:300008509 a skos:Concept ;
    skos:definition "Self-contained residential communities for retired people which provide for most of the daily needs of the residents. For similar facilities offering more comprehensive services, use \"life care communities.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retirement communities"@en .

aat:300008511 a skos:Concept ;
    skos:definition "Settlements whose inhabitants are squatters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squatter settlements"@en .

aat:300008513 a skos:Concept ;
    skos:definition "Self-built shantytowns located on the outskirts of large cities in Latin America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barriadas"@en .

aat:300008516 a skos:Concept ;
    skos:definition "Impoverished shantytowns, jerry-built of cut and flattened metal drums, located in France or North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidonvilles"@en .

aat:300008518 a skos:Concept ;
    skos:definition "Shantytowns in or near cities in Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "favelas"@en .

aat:300008523 a skos:Concept ;
    skos:definition "Communities occupied and run by a group of people working in cooperation, often employed in farming, making crafts, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collective settlements"@en .

aat:300008526 a skos:Concept ;
    skos:definition "Self-supporting and self-governing communities comprised of small groups of people living together with minimal interference from outsiders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communes"@en .

aat:300008527 a skos:Concept ;
    skos:definition "Israeli collective settlements, typically agricultural and often industrial in nature, in which all wealth is shared among its members. Profits are reinvested in the settlement after everyone has been provided with food, clothing, shelter, educational, and medical services. Adults have private quarters, but children are generally housed collectively. Kibbutzim are generally established on land leased from the Jewish National Fund and convene weekly for general meetings to determine policy and elect their administrative officials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kibbutzim"@en .

aat:300008528 a skos:Concept ;
    skos:definition "Russian collective farms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kolkhoz"@en .

aat:300008537 a skos:Concept ;
    skos:definition "Settlements of any size for which precise locations are no longer known or, if the general location is known, factual information about the settlement is scarce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost settlements"@en .

aat:300008539 a skos:Concept ;
    skos:definition "Older, often historic, sections of cities or towns, generally distinguished from newer parts by clear boundaries and distinctive architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "old towns"@en .

aat:300008542 a skos:Concept ;
    skos:definition "Refers to any abandoned settlements above ground with buildings that are partially destroyed or in ruins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruined settlements"@en .

aat:300008544 a skos:Concept ;
    skos:definition "Communities of relatively large size that have been buried due to volcanic eruption, landslide, accumulation of sediment, etc.; often refers to an archaeological site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buried cities"@en .

aat:300008545 a skos:Concept ;
    skos:definition "Artificial mounds consisting of the accumulation of debris from successive settlement levels; common in regions where mud brick is used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tells"@en .

aat:300008547 a skos:Concept ;
    skos:definition "Designates once-flourishing settlements recently abandoned primarily due to dramatic economic decline or exhaustion of local natural resources; generally the buildings remain standing but in a state of deterioration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghost towns"@en .

aat:300008549 a skos:Concept ;
    skos:definition "Regions of land and settlements that are not governed as their own local municipality, but rather are administered as part of larger administrative divisions, such as a township, parish, borough, county, city, canton, state, province, or country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unincorporated areas"@en .

aat:300008550 a skos:Concept ;
    skos:definition "Designates complex assemblies of equipment and activities, arranged according to some scheme or plan, and intended to perform specific functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "systems"@en .

aat:300008553 a skos:Concept ;
    skos:definition "Refers to the underlying foundation or basic framework of a system or organization, especially the services and facilities which are an integral part of the life in an urban community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrastructure"@en .

aat:300008554 a skos:Concept ;
    skos:definition "Government-sponsored provision of buildings and other facilities, such as post offices, roads, playgrounds, and docks, for public use and paid for by public funds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public works"@en .

aat:300008556 a skos:Concept ;
    skos:definition "Transportation systems of attached vehicles, such as trains, that make is possible to move large numbers of people in the same travel corridor with greater efficiency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transit systems"@en .

aat:300008569 a skos:Concept ;
    skos:definition "Includes rail transit systems serving primarily urban areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban rail systems"@en .

aat:300008573 a skos:Concept ;
    skos:definition "Rail transit systems of any form that run above surface traffic, primarily for local transit in urban or interurban areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elevated railroads"@en .

aat:300008601 a skos:Concept ;
    skos:definition "Basic service systems required for developed areas; for the government-regulated enterprises providing such services, use \"public utilities.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utilities"@en .

aat:300008602 a skos:Concept ;
    skos:definition "Public service organizations that provide electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric utilities"@en .

aat:300008603 a skos:Concept ;
    skos:definition "Wires used for transmitting a supply of electrical energy to buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power lines"@en .

aat:300008609 a skos:Concept ;
    skos:definition "Designates public or private enterprises under strict government regulation to provide without discrimination essential public services, such as gas, electricity, and sewers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public utilities"@en .

aat:300008610 a skos:Concept ;
    skos:definition "Systems for communicating at a distance, often a collection of individual communications networks, transmission systems, relay stations, subsidiary stations, data terminal equipment, and other facilities for disseminating information. Examples include telephone, telegraph, radio, television, optical communications, internet, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telecommunication systems"@en .

aat:300008613 a skos:Concept ;
    skos:definition "Communications built or used to provide communications to law enforcement personnel and systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police communication systems"@en .

aat:300008615 a skos:Concept ;
    skos:definition "Communication system that transmits sound between distant points"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephone systems"@en .

aat:300008618 a skos:Concept ;
    skos:definition "Systems that supply water to and between buildings and other structures or to or from locations within communities or agricultural landscapes; use \"plumbing systems\" for water distribution systems within buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water supply systems"@en .

aat:300008620 a skos:Concept ;
    skos:definition "Irrigation or piping network within a structure that conveys sewage, rainwater, or other material from point of entry to point of disposal, such as a public sewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drainage systems"@en .

aat:300008626 a skos:Concept ;
    skos:definition "Broadly used to describe portions of the earth's surface that share common repeating characteristics that can be comprehended at a glance. Landscapes are more than scenery or political units; they are systems of natural and cultural contexts. If possible use a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscapes"@en .

aat:300008631 a skos:Concept ;
    skos:definition "Land suitable for agricultural production, both crops and livestock, including planted and harvested crops such as field crops, greenhouse crops, fruit and berry plantations, nurseries, orchards, vegetable gardens, fallow land, meadows, and natural pastures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural land"@en .

aat:300008632 a skos:Concept ;
    skos:definition "Land under cultivation or capable of being cultivated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farmland"@en .

aat:300008633 a skos:Concept ;
    skos:definition "Farms, which are complexes where plants or animals are raised for livelihood or commerce, that have been deserted and are no longer functioning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned farms"@en .

aat:300008635 a skos:Concept ;
    skos:definition "Land covered with grass or similar plants and used for grazing livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastures"@en .

aat:300008649 a skos:Concept ;
    skos:definition "Ground or soil that is plowed or fit for tillage, as opposed to pasture land or woodlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arable land"@en .

aat:300008654 a skos:Concept ;
    skos:definition "Land that is uncultivated, free of buildings, or barren, especially if it has been devistated by flood, storm, or war, or for other reasons not usable. For lands specifically established for the purpose of preserving distinctive natural communities of plants and animals, use \"nature reserves.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wasteland"@en .

aat:300008657 a skos:Concept ;
    skos:definition "Land which has been provided with water systems, sewers, sidewalks, and other basic facilities in preparation for residential or industrial development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "improved land"@en .

aat:300008658 a skos:Concept ;
    skos:definition "Mexican artificial fields made arable by piling onto the planting areas silt dredged from a criss-crossing series of irrigation canals plus organic wastes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinampas"@en .

aat:300008662 a skos:Concept ;
    skos:definition "Land available for building but not currently developed and lacking any improvements or utilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw land"@en .

aat:300008666 a skos:Concept ;
    skos:definition "Land that is owned collectively, by a government, or by one person, but over which certain traditional rights are in place for certain other people or the general public, for example grazing rights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common land"@en .

aat:300008667 a skos:Concept ;
    skos:definition "Land owned by the government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public land"@en .

aat:300008669 a skos:Concept ;
    skos:definition "Land in some countries and regions belonging to the British Commonwealth and held in the name of the sovereign."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown land"@en .

aat:300008674 a skos:Concept ;
    skos:definition "Denotes marshy creeks or other sluggish swampy watercourses, generally found along the lower Mississippi River and other alluvial lowlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bayous"@en .

aat:300008676 a skos:Concept ;
    skos:definition "Designates inlets of the sea that are long, deep, and narrow and have steep walls; usually formed by glacial erosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiords"@en .

aat:300008679 a skos:Concept ;
    skos:definition "Bodies of shallow water separated from the sea by a barrier, such as a sandbar or coral reef."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lagoons"@en .

aat:300008680 a skos:Concept ;
    skos:definition "Bodies of fresh or salt water surrounded by land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lakes"@en .

aat:300008686 a skos:Concept ;
    skos:definition "Tracts of fertile land in a desert afforded with a supply of fresh water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oases"@en .

aat:300008687 a skos:Concept ;
    skos:definition "Category of marine body of water comprising the main water areas of the earth, lying in basins; for shallow salt water areas lying on the margins of continents, use \"seas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oceans"@en .

aat:300008688 a skos:Concept ;
    skos:definition "Relatively small bodies of water, usually surrounded on all sides by land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ponds"@en .

aat:300008689 a skos:Concept ;
    skos:definition "Ponds containing small fish, often ones in which edible fish are raised for commercial purposes, or for stocking lakes and streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishponds"@en .

aat:300008692 a skos:Concept ;
    skos:definition "Still bodies of water smaller than ponds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pools"@en .

aat:300008694 a skos:Concept ;
    skos:definition "The shallower salt water areas of the earth lying on the margins of continents; loosely applied as a proper name to any specific bodies of water. For the main water areas of the earth, lying in basins, use \"oceans.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seas"@en .

aat:300008697 a skos:Concept ;
    skos:definition "Water issuing naturally from the rock or soil upon the land or into a body of surface water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springs"@en .

aat:300008699 a skos:Concept ;
    skos:definition "General term for natural courses of water flowing continuously along a defined bed on the surface of the earth, forming a river, rivulet, brook, etc. The term is not used for canals or other artificial watercourses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "streams"@en .

aat:300008701 a skos:Concept ;
    skos:definition "Flat-bottomed and often steep-walled dry watercourses occupied by streams only after heavy rains; common in the southwest United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arroyos"@en .

aat:300008703 a skos:Concept ;
    skos:definition "Small streams, generally smaller than creeks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brooks"@en .

aat:300008706 a skos:Concept ;
    skos:definition "Bodies of water, smaller than a stream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creeks"@en .

aat:300008707 a skos:Concept ;
    skos:definition "Bodies of water flowing in direct course or a series of divergents or converging channels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rivers"@en .

aat:300008713 a skos:Concept ;
    skos:definition "Feature that is relatively long and narrow and axially located in relation to the waterway, such as used to designate the deepest part of streambeds where the main current runs, or stretches of sea between two land areas and linking two seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "channels"@en .

aat:300008727 a skos:Concept ;
    skos:definition "Broad, curving, generally looplike bends in rivers or streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meanders"@en .

aat:300008728 a skos:Concept ;
    skos:definition "River meanders with extreme curvature such that only a neck of land is left between two parts of the stream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxbows"@en .

aat:300008730 a skos:Concept ;
    skos:definition "Areas comprising the bottom of the channel in which a river flows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river beds"@en .

aat:300008733 a skos:Concept ;
    skos:definition "Strips of land bordering large bodies of water; an example is area of land between the lowest low-water spring tide and the highest point of storm waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shores"@en .

aat:300008736 a skos:Concept ;
    skos:definition "Perpendicular or very steep descents of the water of a stream. May be used for artificial waterfalls only if highly naturalistic in form and context; otherwise prefer \"cascades\" or \"fountains.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterfalls"@en .

aat:300008738 a skos:Concept ;
    skos:definition "Large, often high, thundering waterfalls; may also be used to designate a series of rapids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cataracts"@en .

aat:300008739 a skos:Concept ;
    skos:definition "Irregular, partially obstructed, fast-flowing areas in rivers or streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rapids"@en .

aat:300008744 a skos:Concept ;
    skos:definition "Erosional landforms that are carved from flat-lying sediment or rocks having resistant top layers and characterized as conspicuous, isolated flat-topped hills with relatively steep sides; smaller in extent than mesas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttes"@en .

aat:300008746 a skos:Concept ;
    skos:definition "Natural openings in the earth large enough for human exploration, the largest and most common being those formed by a chemical reaction between circulating groundwater and limestone or dolomite bedrock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caves"@en .

aat:300008749 a skos:Concept ;
    skos:definition "High, steep ledges of rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cliffs"@en .

aat:300008750 a skos:Concept ;
    skos:definition "Hills or ridges of sand, typically in deserts, formed by shifting winds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dunes"@en .

aat:300008759 a skos:Concept ;
    skos:definition "Designates sloping, fan-shaped masses of sediment deposited by a watercourse at the place where it leaves a constricted course or upland and emerges into a broad valley or a plain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alluvial fans"@en .

aat:300008760 a skos:Concept ;
    skos:definition "Alluvial deposits at the mouths of rivers commonly forming nearly flat, fan-shaped plains of considerable area traversed by many separate branches of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deltas"@en .

aat:300008761 a skos:Concept ;
    skos:definition "Land depressions having a more flattish landscape, with less precipitous slopes, than canyons or gorges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valleys"@en .

aat:300008763 a skos:Concept ;
    skos:definition "Deep, steep-sided land depressions, often having a river at the bottom; common to arid and semi-arid areas. Distinct from \"valleys (landforms),\" which tend to have a flattish landscape rather than high, precipitous slopes. Distinct from \"gorges (landforms),\" which tend to be smaller, narrower, and more rocky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canyons"@en .

aat:300008767 a skos:Concept ;
    skos:definition "Deep, rocky land depressions with steep sides, larger than ravines, with a river or stream at the bottom; distinct from \"canyons,\" which tend to be larger and less rocky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorges"@en .

aat:300008769 a skos:Concept ;
    skos:definition "Small, commonly V-shaped channels carved in the land by fluvial action and through which water flows only occasionally or seasonally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gullies"@en .

aat:300008772 a skos:Concept ;
    skos:definition "Small valleys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollows"@en .

aat:300008773 a skos:Concept ;
    skos:definition "Narrow, steep-sided land depressions, larger than gullies and smaller than gorges and canyons, usually created by the flow of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ravines"@en .

aat:300008777 a skos:Concept ;
    skos:definition "Elevation of earth's surface, smaller than a mountain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hills"@en .

aat:300008780 a skos:Concept ;
    skos:definition "Hills or hilly regions at the base of a mountain or mountain range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foothills"@en .

aat:300008781 a skos:Concept ;
    skos:definition "Small hills, small elevations in the earth's surface, or small mounds or heaps of earth or stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hillocks"@en .

aat:300008791 a skos:Concept ;
    skos:definition "Landforms smaller than a continent, completely surrounded by water at high water. Islands appear in oceans, seas, lakes, or rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "islands"@en .

aat:300008793 a skos:Concept ;
    skos:definition "Designates circular, elliptical, or horseshoe-shaped islands or a ring of such islands, usually formed by coral reefs and enclosing a lagoon. In most cases, the lagoon occupies the place of a submerged island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atolls"@en .

aat:300008794 a skos:Concept ;
    skos:definition "Narrow strips of land connecting two larger land masses separated by the sea, such as the Isthmus of Panama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isthmuses"@en .

aat:300008795 a skos:Concept ;
    skos:definition "Prominent landforms rising considerably above the surrounding area, typically having steep slopes, a sharp summit area, and large mass. Mountains rarely occur individually, and in most cases, are found in ranges, chains, or systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountains"@en .

aat:300008798 a skos:Concept ;
    skos:definition "The pointed tops of mountains, ridges, or large prominent hills; may also be used, by extension, to refer to prominent pointed mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peaks"@en .

aat:300008804 a skos:Concept ;
    skos:definition "Landforms surrounded by water on three sides, not completey independent from the mainland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peninsulas"@en .

aat:300008805 a skos:Concept ;
    skos:definition "Extensive areas of land having few inequalities of surface, being usually fairly flat and at low elevation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plains"@en .

aat:300008808 a skos:Concept ;
    skos:definition "Ranges of rock, coral, or sand with their surface at or just above the low tide mark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reefs"@en .

aat:300008811 a skos:Concept ;
    skos:definition "Relatively small, usually isolated, masses of land with level or nearly level tops, standing distinctly above the surrounding countryside, and having steep erosion scarps on all sides; smaller than plateaus, and larger than buttes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mesas"@en .

aat:300008813 a skos:Concept ;
    skos:definition "Underground layers of rock and sand that contain water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquifers"@en .

aat:300008816 a skos:Concept ;
    skos:definition "Shores comprised of an accumulation of sediment, such as sand or pebbles, along the edge of a sea or lake, and formed by coastal processes such as waves and tides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaches"@en .

aat:300008819 a skos:Concept ;
    skos:definition "Beaches set aside for or used by people immersing themselves in the water and exposing themselves to the sun and air for recreational purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathing beaches"@en .

aat:300008832 a skos:Concept ;
    skos:definition "Landforms resulting from glaciers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glacial landforms"@en .

aat:300008833 a skos:Concept ;
    skos:definition "Long, smooth, cigar-shaped hills of glacial origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drumlins"@en .

aat:300008835 a skos:Concept ;
    skos:definition "Very large bodies of ice moving slowly down a slope or valley or spreading outward on a land surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glaciers"@en .

aat:300008836 a skos:Concept ;
    skos:definition "Rock debris deposited by a glacier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moraines"@en .

aat:300008850 a skos:Concept ;
    skos:definition "Land areas, more prominent than a point, projecting into the sea and marking a notable change in coastal direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capes"@en .

aat:300008853 a skos:Concept ;
    skos:definition "Bluffs or prominent hills overlooking or projecting into a lowland. For high features projecting into a sea, use \"headlands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promontories"@en .

aat:300008857 a skos:Concept ;
    skos:definition "Garden areas composed of ornamental groupings of trees pierced by walkways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boskets"@en .

aat:300008861 a skos:Concept ;
    skos:definition "Large, uncleared areas of plant growth or thick vegetation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bush"@en .

aat:300008863 a skos:Concept ;
    skos:definition "Historically, refers to wilderness areas outside the scope of common law but within the legislation of kings and reserved for royal activities; more recently, used to designate extensive wooded areas, whether maintained for the production of timber or unmanaged and preserving a wilderness of dense growth and wild animal habitats. For forests in the context of a plant community rather than as a cultural landscape, use \"forests (plant communities).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forests"@en .

aat:300008865 a skos:Concept ;
    skos:definition "Areas of forest set aside and preserved by the government as a national park or preserve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest reserves"@en .

aat:300008869 a skos:Concept ;
    skos:definition "Common term referring to impenetrable tropical forests with dense tangled undergrowth of grasses, vines, shrubs, and trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jungles"@en .

aat:300008871 a skos:Concept ;
    skos:definition "Forests with varied vegetation, depending upon whether they are tropical or temperate, but having in common a high annual rainfall of between 98-180 inches. Tropical rainforests are found closer to the equator and temperate rainforests are found farther north near coastal areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rainforests"@en .

aat:300008874 a skos:Concept ;
    skos:definition "Areas dominated by grasses rather than large shrubs or trees. One of the earth's six major biomes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grasslands"@en .

aat:300008875 a skos:Concept ;
    skos:definition "Extensive grassy plains, with few trees, found in the southwest United States and Spanish America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "llanos"@en .

aat:300008876 a skos:Concept ;
    skos:definition "Large open tracts of grassland, sometimes used for pasture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meadows"@en .

aat:300008879 a skos:Concept ;
    skos:definition "Extensive, generally grass-covered plains of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pampas"@en .

aat:300008880 a skos:Concept ;
    skos:definition "Extensive unwooded grasslands, usually flat or gently rolling; found in the central portions of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prairies"@en .

aat:300008881 a skos:Concept ;
    skos:definition "Category of grasslands having scattered individual trees, found in warm or hot climates where the annual rainfall is 51 to 127 cm. Rainfall is concentrated in six or eight months of the year, followed by a long period of drought when fires can occur; if the rain were well distributed throughout the year, many such areas would become tropical forest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "savannas"@en .

aat:300008884 a skos:Concept ;
    skos:definition "Groups of trees, often of a single species, smaller than forests in extent, growing naturally or planted in formation, and generally with little or no undergrowth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groves"@en .

aat:300008889 a skos:Concept ;
    skos:definition "Areas of cultivated grass or other ground cover maintained for aesthetic quality or recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lawns"@en .

aat:300008890 a skos:Concept ;
    skos:definition "Farms devoted to the cultivation of fruit or nut trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchards"@en .

aat:300008899 a skos:Concept ;
    skos:definition "Large category including areas of land characterized by poor drainage, standing or slowly moving water, and as a result, an almost constant state of water-saturated soil. Wetlands include swamps, marshes, and bogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wetlands"@en .

aat:300008900 a skos:Concept ;
    skos:definition "Areas of virtually stagnant water that are joined to a stream but relatively unaffected by its current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backwaters"@en .

aat:300008901 a skos:Concept ;
    skos:definition "Designates waterlogged spongy ground with a characteristic plantlife, such as sphagnum mosses, and in which vegetation is decaying, ultimately producing highly acidic peat. Distinct from \"fens,\" in which the water remains alkaline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bogs"@en .

aat:300008902 a skos:Concept ;
    skos:definition "Bogs of accumulated peat, which is an unconsolidated deposit of semicarbonized plant remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peat bogs"@en .

aat:300008903 a skos:Concept ;
    skos:definition "Low lying, treeless wetlands, typically overgrown with grasses, cattails, and rushes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marshes"@en .

aat:300008905 a skos:Concept ;
    skos:definition "Tracts of lowlying ground in which water collects, particularly wetlands partially or intermittently covered with water, often dominated by woody vegetation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swamps"@en .

aat:300008916 a skos:Concept ;
    skos:definition "Broad category of dry regions occurring where rainfall is less than 50 cm per year; usually barren and treeless."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deserts"@en .

aat:300008921 a skos:Concept ;
    skos:definition "Areas of treeless, rolling terrain found in polar or alpine regions, typically covered with bare ground, rock, or such vegetation as mosses, lichens, and small shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tundras"@en .

aat:300008923 a skos:Concept ;
    skos:definition "The built forms of towns, cities, or other built-up areas, in combination, as perceived visually and aesthetically. For representations of towns or cities, as in drawings or photographs, use \"townscapes (representations).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "townscapes"@en .

aat:300008932 a skos:Concept ;
    skos:definition "Designates land and water areas significantly altered or modified by human actions; used in contrast to \"natural landscapes,\" that designate areas where human effects, if present, are not ecologically significant to the regions as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural landscapes"@en .

aat:300009699 a skos:Concept ;
    skos:definition "Fundamental ideas and components or parts that are observable in a visual design or work of art, such as lines, points, movement, forms, spaces, colors, textures, and patterns, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design elements"@en .

aat:300009700 a skos:Concept ;
    skos:definition "Distinct or separable design elements, usually decorative, whether occurring singly as individual shapes. Distinguished from \"patterns (design elements),\" which are ornamental designs composed of repeated or combined motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motifs"@en .

aat:300009724 a skos:Concept ;
    skos:definition "Ornamental motifs resembling cords which are interlaced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knots"@en .

aat:300009764 a skos:Concept ;
    skos:definition "Design elements with geometrical themes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometric motifs"@en .

aat:300009766 a skos:Concept ;
    skos:definition "Simple geometric forms composed of Vs used singly, in a vertical series, or in a string to form a zigzag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevrons"@en .

aat:300009780 a skos:Concept ;
    skos:definition "Figures of five equal arcs or lobes, separated by cusps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinquefoils"@en .

aat:300009784 a skos:Concept ;
    skos:definition "Figures composed of four equal lobes separated by cusps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quatrefoils"@en .

aat:300009786 a skos:Concept ;
    skos:definition "Figures of three equal arcs or lobes, separated by cusps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trefoils"@en .

aat:300009791 a skos:Concept ;
    skos:definition "Figures that are squares or rhombuses rotated to have their corners on the horizontal and vertical axes. Common as an isolated motif, in a diaper pattern, or in a running series."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lozenges"@en .

aat:300009797 a skos:Concept ;
    skos:definition "Geometric plane figures having ten sides and ten angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decagons"@en .

aat:300009798 a skos:Concept ;
    skos:definition "Polygons having twelve sides and twelve angles. In regular dodecagons, all sides and all angles are equal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dodecagons"@en .

aat:300009802 a skos:Concept ;
    skos:definition "Geometric figures having four equal sides and equal opposite angles, particularly where there are no right angles, as contrasted with a square; an oblique equilateral parallelogram."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhombuses"@en .

aat:300009806 a skos:Concept ;
    skos:definition "Polygons having three sides and three angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triangles"@en .

aat:300009809 a skos:Concept ;
    skos:definition "Refers to the diverging spiral motif within a circle common in Celtic and Insular art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trumpet spirals"@en .

aat:300009811 a skos:Concept ;
    skos:definition "Conventionalized figures derived from astronomical stars, having radiating points of any number."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stars"@en .

aat:300009813 a skos:Concept ;
    skos:definition "Six-pointed stars composed of two equilateral triangles, one superimposed upside down on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stars of David"@en .

aat:300009815 a skos:Concept ;
    skos:definition "Any emblem or device occupying the field of a shield, such as a geometric design or the image of a person, animal, plant, or other object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heraldic motifs"@en .

aat:300009874 a skos:Concept ;
    skos:definition "Refers to the highly conventionalized figure based on the shape of the human heart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearts"@en .

aat:300009875 a skos:Concept ;
    skos:definition "Motifs depicting a heart with flames erupting from it or surrounding it. It occurs in Western and Christian art symbolizing charity, divine love, or religious fervor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flaming hearts"@en .

aat:300009907 a skos:Concept ;
    skos:definition "Decorative design motifs that contain elements from nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural element motifs"@en .

aat:300009910 a skos:Concept ;
    skos:definition "Motifs of a conventionalized depiction of flames, usually wavy, peaked forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flames"@en .

aat:300009934 a skos:Concept ;
    skos:definition "Decorative motifs based on the hexagonal crystal formation of snowflakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snowflakes"@en .

aat:300009936 a skos:Concept ;
    skos:definition "Decorative pattern consisting of wavy lines or other series of generally wavelike forms. For the specific running patterns of successive, connected spirals, use \"wave scrolls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wave pattern"@en .

aat:300009937 a skos:Concept ;
    skos:definition "Images of animals and objects that symbolize the twelve signs of the zodiac."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zodiac symbols"@en .

aat:300009961 a skos:Concept ;
    skos:definition "Decorative motif in the form of a carved or painted floral pattern, square in shape, employed in Gothic architecture. The fleuron was also used for decorative borders and to embellish frames, and as a decorative element at the center of each face of the Corinthian abacus. It is also employed on furniture. For printers' type ornaments, use \"printer's flower.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fleuron"@en .

aat:300009966 a skos:Concept ;
    skos:definition "A decorative motif in the form of a stylized iris or lily, usually with three curled petals, but occasionally with five, one of which forms the central axis to the symmetrical design. The design is based on an iris, which was equated with the lily and had the same symbolic references as the lily; it probably developed from the honeysuckle design motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fleur-de-lis"@en .

aat:300009972 a skos:Concept ;
    skos:definition "Motif in the form of a stylized rose with petals radiating from the center, or for similar circular ornaments having a design radiating from the center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosette"@en .

aat:300009973 a skos:Concept ;
    skos:definition "Motif comprising a trefoil flower resembling an upright stylized ivy leaf, a common ornament in English Late Gothic and Tudor architecture, especially for brattishing. For the circular red and white double rose motif implemented by Henry VII, use \"Tudor rose.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tudor flower"@en .

aat:300009982 a skos:Concept ;
    skos:definition "Motif found in bands of architectural decoration, comprising alternating palmette and lotus motifs, which in Classical ornament emerge from an acanthine calyx and are joined to one another by curving S-shaped scrolls. The motif is found in Greek and later classicizing styles, including Byzantine, medieval, and Neo-Classical art. The term comes from the Greek term for \"flower.\" The similarities observed between the Classical palmette and the flower of the honeysuckle prompted many 18th century architects and craftsmen to use the term \"anthemion\" as a synonym for \"honeysuckle\" or \"palmette.\" To refer to either of these motifs alone, use the appropriate term rather than \"anthemion.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthemion"@en .

aat:300009995 a skos:Concept ;
    skos:definition "Motif resembling a stylized erect leaf divided into lobes, in the form of a fan or palm leaf, often supported by spirals. Its origins are obscure, but similar motifs are first recorded in Syria and Mesopotamia and in the islands of the eastern Mediterranean by the 2nd millennium BCE. As the name suggests, it may have been derived from representations of palm-trees, especially in view of the belief that a tree cult may have existed in western Asia in association with the introduction of the cultivated date-palm; however, it has much in common with other early floral and spiral motifs. The motif is common in classical and classicizing styles, used either individually or along with other conventionalized flower or foliage forms, for example, in an anthemion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palmette"@en .

aat:300010038 a skos:Concept ;
    skos:definition "Ornamental arrangements of the initials or letters of a name, often used to indicate ownership or patronage. In numismatics, it typically refers to the mint mark, the assayer, or the individual responsible for the issuance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monograms"@en .

aat:300010044 a skos:Concept ;
    skos:definition "Motifs consisting of two intersecting lines or bars, with many variations in the shapes of the arms. For structures or objects of cross shape, especially those used as Christian symbols, use \"crosses (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses"@en .

aat:300010045 a skos:Concept ;
    skos:definition "Figures like a cross having a loop instead of an upper vertical, used especially in ancient Egypt as a symbol of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ankhs"@en .

aat:300010047 a skos:Concept ;
    skos:definition "In Christian art, two or three dimensional Latin crosses set upon three steps or upon a mount."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calvary crosses"@en .

aat:300010048 a skos:Concept ;
    skos:definition "Refers to Latin crosses, the center of which is surrounded by a ring or circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic crosses"@en .

aat:300010058 a skos:Concept ;
    skos:definition "Crosses having two crossbars, either of the same size or with a lower one of longer length. In the version with a shorter one crossing above the center and a longer one below the center, the cross often signifies the Free French during WW II. In the version where both crossbars are of the same length, the cross denotes the rank of cardinal in the Roman Catholic church, or the Duke of Lorraine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses of Lorraine"@en .

aat:300010071 a skos:Concept ;
    skos:definition "Crosses with vertical and horizontal arms of equal length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek crosses"@en .

aat:300010072 a skos:Concept ;
    skos:definition "Crosses comprising a longer vertical bar crossed by a shorter horizontal one at a point near the upper third of the long bar, resulting in a cross having three short arms, at the top and sides, and a long arm at the bottom. It is used as a Christian symbol of Christ's crucifixion, although the symbol existed in pre-Christian societies as well. These may be attended with symbols of Christ such as lances, crowns of thorns, or hammer and nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin crosses"@en .

aat:300010076 a skos:Concept ;
    skos:definition "Crosses having three crossbars, with the longest near the middle and the two others above successively shorter (having a conifer-tree-like silhouette). The three bars represent the papal realms of authority: the church, the world, and heaven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal crosses"@en .

aat:300010079 a skos:Concept ;
    skos:definition "Crosses in the form of the letter X, used as a heraldic symbol in the form of a diagonal cross or letter X and as a symbol for Saint Andrew, who is said to have been martyred on such a cross."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Andrew's crosses"@en .

aat:300010082 a skos:Concept ;
    skos:definition "Equilateral cross with arms bent at right angles, all in the same rotary direction, usually clockwise. It is an ancient symbol of prosperity and good fortune, widely distributed throughout the world; it is found on ancient Mesopotamian coinage, the Scandinavian god Thor's hammer (left-hand swastika), early Christian and Byzantine art, in medieval heraldry, in South and Central America among the Maya, and in North America, principally among the Navajo. The symbol was appropriated by German Nazis, and became their national symbol during this period; it is still used by some anti-Semitic organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swastikas"@en .

aat:300010086 a skos:Concept ;
    skos:definition "Figures in which four arms radiate out from a center and curve or bend in the same direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetraskelions"@en .

aat:300010088 a skos:Concept ;
    skos:definition "Figures composed of three curved or bent branches radiating from a center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triskelions"@en .

aat:300010091 a skos:Concept ;
    skos:definition "Cross in the shape of the Greek letter tau, that is, T-shaped. In Christianity and other ancient societies, the tau cross symbolized life, resurrection, reincarnation, and blood sacrifice. Used in the crux ansata or ankh of ancient Egyptian symbolism, in heraldry, on a St. Anthony's cross as a sacred symbol, and by St. Francis of Assisi as the symbol of his order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tau crosses"@en .

aat:300010094 a skos:Concept ;
    skos:definition "General term for motifs consisting of a spirally wound band. For simple motifs of coiled lines, use \"spirals\"; for scroll-shaped architectural elements use other terms, such as \"consoles\" and \"volutes\"; for a series of scrolls, in running or allover patterns, use \"scrollwork.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrolls"@en .

aat:300010096 a skos:Concept ;
    skos:definition "Ornamental scrolls that coil in only one direction, i.e., not reversing direction, as do S-scrolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "C-scrolls"@en .

aat:300010097 a skos:Concept ;
    skos:definition "Characteristic Chinese motifs of the Han Dynasty consisting of long, convoluted, ribbonlike forms with deep curls and curves constantly changing direction, and at such points widening into grotesque shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloud scrolls"@en .

aat:300010104 a skos:Concept ;
    skos:definition "Decorative motifs consisting of isolated or fairly discrete scrolls with foliate forms. For continuing patterns employing these, use \"scrolling foliage.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaf scrolls"@en .

aat:300010105 a skos:Concept ;
    skos:definition "Scrolling foliage consisting of grapevines with bunches of grapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vine scrolls"@en .

aat:300010106 a skos:Concept ;
    skos:definition "Ornamental scrolls that uncoil in one direction and then reverse to coil in the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "S-scrolls"@en .

aat:300010108 a skos:Concept ;
    skos:definition "Ornamental designs, usually on a flat surface or in relief and composed of repeated or combined motifs. Distinguish from \"motifs\" which are distinct or separable design elements occurring singly as individual shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patterns"@en .

aat:300010128 a skos:Concept ;
    skos:definition "Refers to shell-like motifs, especially of the Rococo period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coquillage"@en .

aat:300010135 a skos:Concept ;
    skos:definition "Patterns of or pertaining to flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floral patterns"@en .

aat:300010142 a skos:Concept ;
    skos:definition "Pattern in which rows of curved or faceted elements successively overlap one another, resembling fish scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scale pattern"@en .

aat:300010145 a skos:Concept ;
    skos:definition "Small marks or spots, used singly or in patterns. They have been used as decorative motifs in on ritual objects in early China to denote fertility, in early Celtic and Anglo-Saxon manuscripts where they were commonly used to embellish initials letters, in heraldry, and in the decoration of glass and pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dots"@en .

aat:300010146 a skos:Concept ;
    skos:definition "The arrangement of forms, whether tiles, shingles, or a decorative pattern, in which rows of repeating elements successively overlap one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imbrication"@en .

aat:300010150 a skos:Concept ;
    skos:definition "A pattern of short, irregular wriggling channels imitating worm tracks, used as a surface decoration on stone, wood, or another material, to create a rusticated effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vermiculation"@en .

aat:300010154 a skos:Concept ;
    skos:definition "A running ornament consisting of a sinuous stylization of a cloud, common in Chinese art and in Oriental rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloud bands"@en .

aat:300010155 a skos:Concept ;
    skos:definition "Patterns consisting of repeated, linear, geometrical shapes, usually angular, in a continuous band. For similar patterns not confined to a band, especially openwork, use \"fretwork.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frets"@en .

aat:300010162 a skos:Concept ;
    skos:definition "Frets characterized by elongated, right-angled meanderlike elements, originating in Chinese art and adapted to Chinoiserie in Europe in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese frets"@en .

aat:300010163 a skos:Concept ;
    skos:definition "Frets consisting of a relatively continuous series of rectilinear hook shapes, sometimes crossing each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key pattern"@en .

aat:300010167 a skos:Concept ;
    skos:definition "Motifs depicting on a flat surface a path that twists around itself but never crosses itself, usually leading from an outer edge to the center. Common in Roman mosaics and inlaid in Medieval church pavements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labyrinths"@en .

aat:300010171 a skos:Concept ;
    skos:definition "Decorative motif comprised of diagonally rising steps and ending in an angular curved hook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepped frets"@en .

aat:300010175 a skos:Concept ;
    skos:definition "A decorative pattern formed of a series of convex ridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gadrooning"@en .

aat:300010182 a skos:Concept ;
    skos:definition "A running pattern of overlapping discs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "money pattern"@en .

aat:300010185 a skos:Concept ;
    skos:definition "Running ornament in which the main element curves back and forth from one side of the band to the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undulate bands"@en .

aat:300010186 a skos:Concept ;
    skos:definition "Running ornament in which forms are attached to a central feature that runs down the center of the band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertebrate bands"@en .

aat:300010197 a skos:Concept ;
    skos:definition "Celtic and Viking interlace incorporating two- or four-legged creatures with ears, biting snout, and tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacertine ornament"@en .

aat:300010199 a skos:Concept ;
    skos:definition "Motif consisting of two or more circles engaged with each other by partial overlapping or interpenetration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interlocking circles"@en .

aat:300010200 a skos:Concept ;
    skos:definition "Ornament consisting of twisted and intertwined bands, originally based on leather strips or ribbons; examples are those popular in Northern Europe during the 16th and 17th centuries and in 19th-century revivals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strapwork"@en .

aat:300010206 a skos:Concept ;
    skos:definition "Decorative patterns of stylized foliage characterized by a continuous stem which splits regularly, producing a series of counterpoised, leafy, secondary stems. Used also generally for allover patterns of fanciful foliate scrollwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arabesques"@en .

aat:300010209 a skos:Concept ;
    skos:definition "Scrolling patterns developed in 16th-century Europe as fanciful variations on Islamic arabesques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moresques"@en .

aat:300010211 a skos:Concept ;
    skos:definition "Ornamental motifs including fanciful human and animal forms and floral ornament, based on the decoration of Nero's Domus Aurea in Rome, discovered in 1488."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grotesques"@en .

aat:300010212 a skos:Concept ;
    skos:definition "Scrollwork involving human and animal figures intertwined with the curving lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inhabited scrolls"@en .

aat:300010217 a skos:Concept ;
    skos:definition "Running patterns consisting of a series of simple scrolls, each spiralling out from the center of the preceding one. For patterns consisting of wavy lines or other series of generally wavelike forms, use \"wave pattern.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wave scrolls"@en .

aat:300010229 a skos:Concept ;
    skos:definition "A pattern in which a series of small right angles produces a steplike edge, usually proceeding a few steps up and then down again."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step pattern"@en .

aat:300010230 a skos:Concept ;
    skos:definition "Long, narrow bands, typically of a different color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stripes"@en .

aat:300010232 a skos:Concept ;
    skos:definition "Interlocking patterns of similar shapes with alternating colors or tones; both figures and ground may be read as coherent patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterchange"@en .

aat:300010233 a skos:Concept ;
    skos:definition "Closely spaced parallel grooves used to ornament columns and pilasters and in the decorative arts in woodwork, metalwork, glass, and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluting"@en .

aat:300010241 a skos:Concept ;
    skos:definition "Patterns having a watered or rippled look. To refer to the optical illusion of movement caused by intersecting lines, use \"moiré effect.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moiré"@en .

aat:300010246 a skos:Concept ;
    skos:definition "Ornamentation composed of parallel convex moldings, particularly popular in the late 18th and early 19th centuries for furniture and silverwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reeding"@en .

aat:300010247 a skos:Concept ;
    skos:definition "Crossing or interlacing lines or series of lozenges, forming a net- or weblike pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reticulation"@en .

aat:300010252 a skos:Concept ;
    skos:definition "Ornamental areas of distinct pattern, material, color, or shape around the edge or boundary of something. With regard specifically to tapestries, refers to the areas around the central field outside the inner guard and within the guard that edges the outer sides of the tapestry. For the narrow surfaces showing the 'thickness' or smallest dimension of thin, flat objects, as distinguished from the broad surfaces, see \"edges (object components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borders"@en .

aat:300010254 a skos:Concept ;
    skos:definition "Objects or motifs formed in a smooth, convex circular, or oval shape that is flat on the bottom. Refers specifically to the shape of unfaceted gems, architectural ornament, and details of furniture, particularly during the 16th and 17th centuries and revived in kidney shape on the cabriole knees of chairs and tables in the mid-18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabochons"@en .

aat:300010256 a skos:Concept ;
    skos:definition "Ornamental enframements, such as for an inscription, monogram, or coat of arms, or ornately framed tablets, often bearing inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartouches"@en .

aat:300010261 a skos:Concept ;
    skos:definition "Areas within an ornamental scheme, usually rectangular and enframed. In bookbinding, also includes spaces on the sides of a book or between the bands on the spine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panels"@en .

aat:300010262 a skos:Concept ;
    skos:definition "Flat, thin, usually small objects, made of metal, clay, ivory, glass, or basketry, sometimes set into a surface for decoration or to bear an inscription."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaques"@en .

aat:300010264 a skos:Concept ;
    skos:definition "Round or oval disks bearing an ornamental design in bas-relief or intaglio and used in decoration of buildings or furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paterae"@en .

aat:300010267 a skos:Concept ;
    skos:definition "Refers to circular panels, usually sculptured or otherwise decorated, set as decorative elements in an architectural context. For similarly shaped and decorated motifs in two-dimensional media, use \"medallions (ornament areas).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roundels"@en .

aat:300010269 a skos:Concept ;
    skos:definition "Attributes relating to position, which include context, orientation, portions of a whole, or relative to other properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "positional attributes"@en .

aat:300010271 a skos:Concept ;
    skos:definition "Joined, connected, or bound together in some way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attached"@en .

aat:300010273 a skos:Concept ;
    skos:definition "Positioned at or near the middle of something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "central"@en .

aat:300010274 a skos:Concept ;
    skos:definition "Describes two circular or spherical figures, spaces, or objects that have a common center or axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concentric"@en .

aat:300010275 a skos:Concept ;
    skos:definition "Use to describe something situated at or near a corner. To refer to those parts of things where converging lines or surfaces meet, use \"corners\" from the Components hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner"@en .

aat:300010276 a skos:Concept ;
    skos:definition "Inclined obliquely from a reference line, like a straight line joining the two opposite corners of a rectangle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagonal"@en .

aat:300010277 a skos:Concept ;
    skos:definition "Connected with or situated at the outside or outer part of something. An example is the parts of buildings in contact with the outdoors, as opposed to the parts within the walls and under the roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior"@en .

aat:300010279 a skos:Concept ;
    skos:definition "Existing or situated within the limiting surface or boundary of something. An example is the portion of a building within the walls and under the roof, as opposed to those parts in contact with the outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior"@en .

aat:300010281 a skos:Concept ;
    skos:definition "Describes things situated on, directed toward, or coming from the side of some other thing or the viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lateral"@en .

aat:300010282 a skos:Concept ;
    skos:definition "Placed or running lengthwise relative to something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longitudinal"@en .

aat:300010283 a skos:Concept ;
    skos:definition "Situated or passing below the level, surface, or base of measurement of something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lower"@en .

aat:300010284 a skos:Concept ;
    skos:definition "Extending in the same direction and everywhere equidistant; usually said of lines and linear objects and structures. For the corresponding noun, use \"parallelism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel"@en .

aat:300010285 a skos:Concept ;
    skos:definition "Being at right angles to a given line or plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perpendicular"@en .

aat:300010286 a skos:Concept ;
    skos:definition "Jutting or sticking out beyond the general surface or adjacent parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projecting"@en .

aat:300010287 a skos:Concept ;
    skos:definition "Use to describe something situated at the part of an object that is opposite to its front or to its most important or useful surface. To refer to these parts themselves, use \"backs (portions)\" from the Components hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rear"@en .

aat:300010289 a skos:Concept ;
    skos:definition "Use to describe something situated at or near a surface of something that is not a front, back, top, or bottom. To refer to those surfaces that are not fronts, backs, tops, or bottoms, use \"sides\" from the Components hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side"@en .

aat:300010290 a skos:Concept ;
    skos:definition "Connected to a support located above, often reserved for describing the position of an object hanging with empty space beneath it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspended"@en .

aat:300010291 a skos:Concept ;
    skos:definition "Situated or passing above the level, surface, or base of measurement of something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper"@en .

aat:300010292 a skos:Concept ;
    skos:definition "The reverse or subordinate sides of leaves or sheets of paper, including the left-hand page of an open book. For the front side of a leaf, use \"rectos.\" Use \"reverses\" for the back, underside, or subordinate surface of coins, medals, seals, or currency notes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "versos"@en .

aat:300010295 a skos:Concept ;
    skos:definition "Having an angle or angles, sharp-cornered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angular"@en .

aat:300010296 a skos:Concept ;
    skos:definition "The shape, in full or in outline, of a cross section of an inverted cup or bell with flaring rim and convex crown; an example is in mathematics, the bell curve of a Gaussian function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell-shaped"@en .

aat:300010301 a skos:Concept ;
    skos:definition "Having the shape of a row of architectural columns, that is in units with straight sides, often but not always cylindrical, that are taller than they are wide. As in mathematics, having coordinates that include the distance from an axis, angle from a plane of reference through this axis to a plane through the axis and the specified point, and distance from a plane of reference perpendicular to the axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columnar"@en .

aat:300010302 a skos:Concept ;
    skos:definition "Of a plane figure, a solid or a set of points that is not convex, for example, hollowed out like the inner curve of a circle or sphere. An arc of a curve is concave toward a point or line if every segment of the arc cut off by a secant lies on the opposite side of the secant from the point or line. A concave polygon always has an interior angle greater than 180 degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concave"@en .

aat:300010303 a skos:Concept ;
    skos:definition "Of a plane figure or a solid, a set of points containing all points in a line joining any two constituent points, for example, the rounded outward exterior curve of a circle or sphere. In a convex polygon, every internal angle is less than or equal to 180 degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convex"@en .

aat:300010305 a skos:Concept ;
    skos:definition "Shapes that are bent or formed into a curve, which is a line deviating from the straight or plane form continuously, without angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curved"@en .

aat:300010307 a skos:Concept ;
    skos:definition "Having a form or outline forming a series of wave-like curves, a succession of gently rounded heights and hollows. Used, for example, with reference to architectural features such as arches, moldings, and tracery. For furniture pieces, the fronts of which have alternating concave and convex surfaces, use \"serpentine (shape).\" For features consisting of or bounded by curved lines in general, use \"curvilinear.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undulating"@en .

aat:300010310 a skos:Concept ;
    skos:definition "Having a semi-circular form like a stylized fan, typically distinguished from \"semicircular\" shapes by being less regular than a semicircle or by having radiating elements, as the folds of a fan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan-shaped"@en .

aat:300010329 a skos:Concept ;
    skos:definition "Having an outline or form of a stylized star; typically having arms or forms radiating from a center, like the rays of a star. Examples include ornament and ground plans or footprints of certain Hindu temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stellate"@en .

aat:300010331 a skos:Concept ;
    skos:definition "Having, or appearing to have, the three dimensions of length, width, and height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-dimensional"@en .

aat:300010332 a skos:Concept ;
    skos:definition "Having the two dimensions of length and width, but not height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-dimensional"@en .

aat:300010334 a skos:Concept ;
    skos:definition "Having the outline or form created by two intersecting regular curves, namely the shape of an oval with pointed ends, like the kernel of the drupe (fruit) of an almond tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almond-shaped"@en .

aat:300010335 a skos:Concept ;
    skos:definition "Resembling a human form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropomorphic"@en .

aat:300010337 a skos:Concept ;
    skos:definition "Having a form composed of a continuous curve, roughly oval but wider below the mid-section than in the upper; may be two- or three-dimensional. Form may be inverted, with larger dimension at the top. So-named because the form resembles the fruit of the European pear tree (Pyrus communis) and certain other species of the Pyrus genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pear-shaped"@en .

aat:300010338 a skos:Concept ;
    skos:definition "Representing or imitating animal forms, as in decorative art or symbolism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoomorphic"@en .

aat:300010341 a skos:Concept ;
    skos:definition "Forms or outlines having the shape of space between two concentric circles or cylinders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annular"@en .

aat:300010342 a skos:Concept ;
    skos:definition "Use in the sense of interrupted by design. For the sense of damaged, see 'broken' (ALT of \"breaking\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broken"@en .

aat:300010345 a skos:Concept ;
    skos:definition "Having a continuous surface without significant curvature, inclination, elevations, or depressions. Refers also to two-dimensional images lacking spatial qualities, and to areas of color without variations. To refer to a surface finish without gloss or luster, use \"matte.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat"@en .

aat:300010347 a skos:Concept ;
    skos:definition "Not of regular or symmetrical form, being unevenly shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irregular"@en .

aat:300010353 a skos:Concept ;
    skos:definition "Arranged or having parts arranged like rays around a central axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radial"@en .

aat:300010354 a skos:Concept ;
    skos:definition "Having a pattern or design in relief; or protruding above a surface to which it is attached or is a part. For the relative positional attribute describing individually discrete things raised in relative position to other things or places, especially above the ground or other surface, use \"elevated\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raised"@en .

aat:300010355 a skos:Concept ;
    skos:definition "With reference to physical objects, having the lines intact and whole, not broken or fractured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unbroken"@en .

aat:300010358 a skos:Concept ;
    skos:definition "The matter or substance from which a thing is or may be made; the tangible substance that goes into the makeup of an art work or other physical object. Physical substances, either naturally or synthetically derived, range from specific materials to types of material. Materials may be designated by their properties, or by function or form. Included are raw materials and processed materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "materials"@en .

aat:300010360 a skos:Concept ;
    skos:definition "Material that contains neither hydrocarbons nor any of their derivatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic material"@en .

aat:300010362 a skos:Concept ;
    skos:definition "Any of several finely powdered inorganic materials that can be mixed with water then dried to form a solid, durable mass, such as plaster, lime, pozzolan cement, and portland cement. It is used in construction as an ingredient of mortar and concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cement"@en .

aat:300010364 a skos:Concept ;
    skos:definition "Cement made with bauxite and containing a high percentage of alumina; valued for its fast setting and high strength properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminous cement"@en .

aat:300010367 a skos:Concept ;
    skos:definition "Fire-resistant, waterproofing material made by combining portland cement with asbestos fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asbestos-cement"@en .

aat:300010368 a skos:Concept ;
    skos:definition "Adhesive and binding material that is a preparation of refined asphalt and heavy petroleum oil, made by refining petroleum until there is no water or foreign matter in it, except for the minerals naturally found in the asphalt. Asphalt cement contains less than one percent ash. Usually used for paving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphalt cement"@en .

aat:300010369 a skos:Concept ;
    skos:definition "Cement produced by taking finely pulverizing calcined argillaceous limestone and heating it to complete decarbonation, which is the process of removing carbon dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural cement"@en .

aat:300010377 a skos:Concept ;
    skos:definition "binding material in the form of a finely ground powder, usually gray, that is manufactured by burning and grinding a mixture of limestone and clay or limestone and shale. The cementitious binder for most structural concrete; obtained by pulverizing clinker consisting essentially of hydraulic calcium silicates; contains calcium sulfate as an interground addition. When mixed with water, the anhydrous calcium silicates and other constituents in the portland cement react chemically with the water, combining with it (hydration) and decomposing in it (hydrolysis) and hardening and developing strength. Joseph Aspdin, of England, patented the basic process in 1824, naming it for the resemblance of the cement when set to portland stone, a limestone from the Isle of Portland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portland cement"@en .

aat:300010378 a skos:Concept ;
    skos:definition "A kind of portland cement that is often used when the temperature is below freezing because it completely hardens in a shorter amount of time than other kinds of portland cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-early-strength cement"@en .

aat:300010383 a skos:Concept ;
    skos:definition "A type of portland cement that is generally more workable than normal portland cement. They usually contain a portland cement base with hydrated lime, crushed limestone, diatomaceous earth or granulated slag to aid in spreading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry cement"@en .

aat:300010384 a skos:Concept ;
    skos:definition "A cement used in general construction where moderate heat of hydration is required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modified portland cement"@en .

aat:300010386 a skos:Concept ;
    skos:definition "A type of cement composed of an even mixture of portland cement and fine granulated blast-furnace slag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portland slag cement"@en .

aat:300010388 a skos:Concept ;
    skos:definition "Portland cement blended with pozzolana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portland-pozzolan cement"@en .

aat:300010389 a skos:Concept ;
    skos:definition "A cement, without any of the distinguishing characteristics of the other types of portland cement, that is used for general construction purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordinary portland cement"@en .

aat:300010393 a skos:Concept ;
    skos:definition "A portland cement low in tricalcium aluminate; has a reduced susceptibility to attack by dissolved sulfates in water or soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfate-resistant cement"@en .

aat:300010398 a skos:Concept ;
    skos:definition "Cement reinforced with alkali-resistant glass fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass reinforced cement"@en .

aat:300010399 a skos:Concept ;
    skos:definition "Cement used in making floors of huts in Southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granite-powder cement"@en .

aat:300010400 a skos:Concept ;
    skos:definition "Cement containing gypsum, which is used as a retarder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsum cement"@en .

aat:300010403 a skos:Concept ;
    skos:definition "A hard, white, high-strength, quick-setting finishing plaster that takes a high polish; it is made by heating gypsum at a high temperature, grinding it to a powder, and then adding alum to accelerate the set. It is often used as an interior plaster in areas that are treated roughly and in areas with a high level of moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Keene's cement"@en .

aat:300010406 a skos:Concept ;
    skos:definition "Hard, quick-setting cement made of dehydrated gypsum to which is added a small percentage of calcined sodium sulfate and potassium sulfate; used for walls, and for floors, when mixed with sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mack's cement"@en .

aat:300010407 a skos:Concept ;
    skos:definition "Cement made with potassium carbonate instead of alum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Martin's cement"@en .

aat:300010408 a skos:Concept ;
    skos:definition "Similar to Keene's cement with borax instead of alum as a setting accelerator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parian cement"@en .

aat:300010410 a skos:Concept ;
    skos:definition "Magnesium oxide mixed with water, often with the addition of asbestos fiber; used to cover such things as steam pipes and furnaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesia cement"@en .

aat:300010413 a skos:Concept ;
    skos:definition "In masonry, a pure cement uncut by a sand mixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neat cement"@en .

aat:300010414 a skos:Concept ;
    skos:definition "A strong, hard cement made of calcined magnesia and magnesium chloride. With various fillers, it is often used for stucco and floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxychloric cement"@en .

aat:300010417 a skos:Concept ;
    skos:definition "Mixture of water, hydraulic cement, aggregate, and a monomer or polymer; polymerized in place when a monomer is used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymer-impregnated cement"@en .

aat:300010418 a skos:Concept ;
    skos:definition "An artificial cement with hydraulic properties that is made by grinding together granulated blast-furnace slag and hydrated lime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slag cement"@en .

aat:300010423 a skos:Concept ;
    skos:definition "A mixture of lime and water with shell, gravel, or stone which, when dry, is as hard as rock; used as a building material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabby"@en .

aat:300010425 a skos:Concept ;
    skos:definition "Cement that will set hard in three days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accelerated cement"@en .

aat:300010427 a skos:Concept ;
    skos:definition "Waterproof cement used in masonry work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick cement"@en .

aat:300010428 a skos:Concept ;
    skos:definition "Cement which when mixed with water forms a paste that tends to increase in volume after setting to a significantly greater degree than portland cement paste does; used to compensate for volume decrease due to shrinkage or to induce tensile stress in reinforcement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expanding cement"@en .

aat:300010434 a skos:Concept ;
    skos:definition "Brick, usually pearl-gray in color, made of a sand and lime mixture, molded under pressure and cured with steam. It possesses good frost, acid, and fire resistance and is easily washed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand-lime brick"@en .

aat:300010439 a skos:Concept ;
    skos:definition "Naturally occurring sediments that are produced by chemical actions resulting during the weathering of rocks. Clays are composed of hydrated aluminum silicates, such as Kaolinite, Illite, Palygorskite, Attapulgite, Bentonite, and Montmorillonite. Small amounts of other minerals can change the color (white, yellow, brown or red) and texture of the clays. Clays may include all earths that form a paste with water and harden when heated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay"@en .

aat:300010441 a skos:Concept ;
    skos:definition "A kind of ceramic clay of exceptionally small particle size and, consequently, very good plasticity. Used to impart plasticity to other clay bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball clay"@en .

aat:300010442 a skos:Concept ;
    skos:definition "Shaped, beaten clay used for making granaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banco"@en .

aat:300010443 a skos:Concept ;
    skos:definition "A red indurated clay from the upper Missouri region historically used by Native Americans for tobacco pipes and other carvings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catlinite"@en .

aat:300010445 a skos:Concept ;
    skos:definition "Hydrated aluminum silicate clay. It is used for making porcelain for china and chemical porcelain for valves, tubes, and fittings, as a pigment and filler in paint and plastic, an abrasive powder, and in paper to yield a glossy surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaolin"@en .

aat:300010449 a skos:Concept ;
    skos:definition "A light clayey soil containing chalk or an artificial mixture of clay and chalk used in the manufacture of bricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malm"@en .

aat:300010451 a skos:Concept ;
    skos:definition "Calcareous clay containing up to 40% calcium carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marl"@en .

aat:300010453 a skos:Concept ;
    skos:definition "Native clay selected for its fineness, plasticity, absorbency, and other qualities that suit it to various ceramic uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potter's clay"@en .

aat:300010459 a skos:Concept ;
    skos:definition "Fine clay which, when mixed with water, results in a fluid with a creamlike consistency, used in casting, glazing, decorating, and repairing ceramic wares; in its natural state, it contains sufficient flux to be used for glazing and decorating without the need of additives. For ceramic glaze with a high content of slip, use \"slip glaze.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip"@en .

aat:300010460 a skos:Concept ;
    skos:definition "Clay used by potters to produce a natural black or brown glaze on stoneware. It is found near Albany, New York, and is frequently used on salt-glazed stoneware from the early 19th century onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albany slip clay"@en .

aat:300010461 a skos:Concept ;
    skos:definition "A soft plastic light-colored clay formed by the chemical alteration of volcanic ash; it can swell to several times its original volume when placed in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bentonite"@en .

aat:300010463 a skos:Concept ;
    skos:definition "Clay or clay products formed into a rectangular block and hardened by drying in the sun or firing in a kiln."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick"@en .

aat:300010465 a skos:Concept ;
    skos:definition "Any brick having an oblique shape to fit an oblique salient corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle brick"@en .

aat:300010466 a skos:Concept ;
    skos:definition "A solid tile used to simulate brickwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick slip"@en .

aat:300010467 a skos:Concept ;
    skos:definition "Pieces of broken brick, especially those with one end of the brick left whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brickbat"@en .

aat:300010471 a skos:Concept ;
    skos:definition "The last brick, block, stone, or tile laid in a horizontal course; may be either a complete unit or one trimmed at the site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closer"@en .

aat:300010473 a skos:Concept ;
    skos:definition "A rectangular brick, one end of which has been cut off diagonally to half the width of the brick; used as a closer in masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "king closer"@en .

aat:300010477 a skos:Concept ;
    skos:definition "A brick which has been cut to one-fourth of its normal length but is of normal thickness and width; used to space normal-sized brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter closer"@en .

aat:300010479 a skos:Concept ;
    skos:definition "A brick which has been cut in half along its length; it is of normal thickness but one-half normal width; used to complete a course or to space normal-sized brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queen closer"@en .

aat:300010481 a skos:Concept ;
    skos:definition "A wedge-shaped brick used in arch or circular construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass brick"@en .

aat:300010489 a skos:Concept ;
    skos:definition "In masonry, a soft brick sometimes used for facing because of the ease with which it can be cut or rubbed smooth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutter"@en .

aat:300010493 a skos:Concept ;
    skos:definition "A term used to describe large thin bricks used in medieval England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great brick"@en .

aat:300010494 a skos:Concept ;
    skos:definition "Bricks of larger than normal dimensions made to evade the early brick tax in England, which was levied simply on the number of bricks manufactured. Subsequent legislation eliminated the advantage of using such bricks (which were more difficult and expensive to use anyway); thicker than usual bricks remained in use, however, particularly in the North and Midlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tax brick"@en .

aat:300010496 a skos:Concept ;
    skos:definition "Brick fired at the nominal dimensions of 4 by 4 by 8 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jumbo brick"@en .

aat:300010497 a skos:Concept ;
    skos:definition "Bricks which can be laid to modular dimensions; bricks sized so that the brick plus the mortar joint will form a 4, 8 or 12 inch increment, or module."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modular brick"@en .

aat:300010499 a skos:Concept ;
    skos:definition "Brick wider and longer than most other brick; used chiefly for garden walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "SCR brick"@en .

aat:300010503 a skos:Concept ;
    skos:definition "A brick beveled on its face or end to provide for the reduction in thickness between the plinth and the main part of a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plinth brick"@en .

aat:300010505 a skos:Concept ;
    skos:definition "Brick whose nominal dimensions are 2 2/3 x 4 x 12 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman brick"@en .

aat:300010513 a skos:Concept ;
    skos:definition "A brick or tile of normal face dimensions, having a nominal 2 in (5 cm) thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soap"@en .

aat:300010514 a skos:Concept ;
    skos:definition "A brick, one side of which is beveled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splay brick"@en .

aat:300010517 a skos:Concept ;
    skos:definition "Bricks cut in half lengthwise, parallel to the wide face of the brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split"@en .

aat:300010518 a skos:Concept ;
    skos:definition "A building stone or brick of special shape to be used at an oblique corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squint brick"@en .

aat:300010523 a skos:Concept ;
    skos:definition "A hollow clay masonry unit whose net cross-sectional area in every plane parallel to the bearing surface is not less than 60% of its gross cross-sectional area measured in the same plane. In British usage it refers to a brick with holes in it that total at least 25% of its volume, the holes being not less than 3/4 in. (1.91 cm) wide or 3/4 sq. in. (4.84 sq. cm) in area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow brick"@en .

aat:300010524 a skos:Concept ;
    skos:definition "Brick with vertical perforations or holes; the addition of holes decreases the weight of the brick without significantly reducing its strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perforated brick"@en .

aat:300010525 a skos:Concept ;
    skos:definition "A brick which meets the specifications for a solid masonry unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid brick"@en .

aat:300010527 a skos:Concept ;
    skos:definition "A perforated brick or perforated metal unit of brick size which is built into a wall for ventilation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air brick"@en .

aat:300010529 a skos:Concept ;
    skos:definition "A relatively low-quality brick used behind face brick or other masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backing brick"@en .

aat:300010531 a skos:Concept ;
    skos:definition "Brick having special shapes for use in capping the exposed top of a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capping brick"@en .

aat:300010533 a skos:Concept ;
    skos:definition "A coping brick with a sloped top surface; its high point is along the center ridge so that rainwater spills on either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle-back coping brick"@en .

aat:300010534 a skos:Concept ;
    skos:definition "Brick made from natural clay and having no special surface treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building brick"@en .

aat:300010536 a skos:Concept ;
    skos:definition "Brick having the nominal dimensions 3 1/5 in. by 4 in. by 8 in. (8.13 cm by 10.16 cm by 20.36 cm)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineering brick"@en .

aat:300010539 a skos:Concept ;
    skos:definition "A brick of high strength whose blue color results from firing in a kiln with a flame of low oxygen content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue brick"@en .

aat:300010540 a skos:Concept ;
    skos:definition "The better quality of brick such as is used on exposed parts of a building, especially those parts which are prominent in view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face brick"@en .

aat:300010547 a skos:Concept ;
    skos:definition "A brick whose face has been hacked to resemble roughly hacked stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ashlar brick"@en .

aat:300010549 a skos:Concept ;
    skos:definition "A fired-clay brick that is typically used for facing work and is rough-textured and often multicolored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rustic brick"@en .

aat:300010551 a skos:Concept ;
    skos:definition "Bricks made of refractory ceramic material which will resist high temperatures; used to line furnaces, fireplaces, and chimneys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire brick"@en .

aat:300010555 a skos:Concept ;
    skos:definition "Smooth, dense brick which is highly resistant to abrasion; used for finished floor surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor brick"@en .

aat:300010556 a skos:Concept ;
    skos:definition "A hollow brick used for furring or lining the inside face of a wall; usually the size of an ordinary brick and grooved or scored on the face to afford a key for plastering; it carries no superimposed load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furring brick"@en .

aat:300010557 a skos:Concept ;
    skos:definition "A vitrified brick, especially suitable for use in pavements where resistance to abrasion is important."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paving brick"@en .

aat:300010561 a skos:Concept ;
    skos:definition "Hard, yellowish paving brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flemish brick"@en .

aat:300010562 a skos:Concept ;
    skos:definition "Tile or brick used for paving a malthouse floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pamment"@en .

aat:300010564 a skos:Concept ;
    skos:definition "A brick for constructing pilasters or slightly projecting piers, the end of which is so notched or rebated that it bonds more readily with the backing, thus increasing the stiffening of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilaster brick"@en .

aat:300010569 a skos:Concept ;
    skos:definition "A masonry unit, laid so that its ends are exposed, overlapping two or more adjacent wythes of masonry and tying them together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "header"@en .

aat:300010570 a skos:Concept ;
    skos:definition "In masonry, a brick having one rounded corner, usually laid with the short face exposed to form the brick sill under and beyond a window frame; also used as a quoin or around doorways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bull header"@en .

aat:300010571 a skos:Concept ;
    skos:definition "In masonry, a header of darker color than the field of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazed header"@en .

aat:300010583 a skos:Concept ;
    skos:definition "Masonry unit laid horizontally with its length parallel to the face of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretcher"@en .

aat:300010586 a skos:Concept ;
    skos:definition "A frequently used building brick, composed of clays or shales (and sometimes other materials), which has been fired to hardness in a kiln."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fired brick"@en .

aat:300010599 a skos:Concept ;
    skos:definition "Very hard-burnt brick whose shape is distorted, owing to nearly complete vitrification; used for paving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinker brick"@en .

aat:300010610 a skos:Concept ;
    skos:definition "Weak, non-weather-resistant brick fired at low temperature ranges or remote from the fire in the kiln; suitable for use as backing brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft brick"@en .

aat:300010615 a skos:Concept ;
    skos:definition "Gray brick either made of special clay and used as facing or soft brick intended to be hidden or used in an unobtrusive location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grizzle"@en .

aat:300010616 a skos:Concept ;
    skos:definition "Inexpensive, red soft brick used as building brick rather than as face brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place brick"@en .

aat:300010618 a skos:Concept ;
    skos:definition "Under-fired brick with a rough texture and pink hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sammel brick"@en .

aat:300010628 a skos:Concept ;
    skos:definition "A modern adaptation of sun-dried brick that contains a binder of emulsified asphalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitudobe"@en .

aat:300010630 a skos:Concept ;
    skos:definition "Clay amalgamated with straw or pebbles to make an impasto that is used in building, particularly primitive domestic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torchis"@en .

aat:300010636 a skos:Concept ;
    skos:definition "Brick formed in a mold that has been sprinkled with sand to facilitate removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand-struck brick"@en .

aat:300010638 a skos:Concept ;
    skos:definition "Brick formed in molds that have been watered in order to prevent the brick from sticking; brick formed in the slop molding method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-struck brick"@en .

aat:300010642 a skos:Concept ;
    skos:definition "A brick that has been shaped with an ax and not trimmed when laid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axed brick"@en .

aat:300010644 a skos:Concept ;
    skos:definition "Brick that has been ground or otherwise produced to accurate dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauged brick"@en .

aat:300010648 a skos:Concept ;
    skos:definition "A term applied to any brick handmade with the aid of a brick stock, a wooden board on which a frame was placed to contain the clay; it is also used to describe the ordinary brick of a locality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock brick"@en .

aat:300010650 a skos:Concept ;
    skos:definition "A stiff mud brick made under high pressure; it is homogeneous, and has increased density and strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressed brick"@en .

aat:300010654 a skos:Concept ;
    skos:definition "Brick cut to size by a wire before firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire-cut brick"@en .

aat:300010655 a skos:Concept ;
    skos:definition "Brick having the end surfaces wire-cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end-cut brick"@en .

aat:300010657 a skos:Concept ;
    skos:definition "Brick having the side surfaces wire-cut before firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side-cut brick"@en .

aat:300010659 a skos:Concept ;
    skos:definition "Type of brick made by a semi-dry process; originally named for the Oxford clay found near Fletton, England, which was often used in the London area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fletton"@en .

aat:300010662 a skos:Concept ;
    skos:definition "A material comprising white clay, or \"kaolin,\" and a feldspathic rock, that react when fired so the clay serves to hold the shape of the object and the rock fuses into a natural glass. In China, it includes any such ware that is highly fired enough to produce a ringing sound when struck. In Europe, it is limited to hard-fired ceramic that is translucent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain"@en .

aat:300010663 a skos:Concept ;
    skos:definition "Type of porcelain material comprising white china clay, or \"kaolin,\" and \"petuntse,\" which is a naturally fusible feldspathic rock. It is \"hard fired\" at the relatively high temperature of around 1450 degrees centigrade. It was developed first in China and produced in Europe after 1700."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard paste porcelain"@en .

aat:300010665 a skos:Concept ;
    skos:definition "Type of porcelain material comprising white china clay and powdered glass, which is substituted for the feldspathic rock used in hard paste porcelain. It is \"soft fired\" at the relatively low temperature of around 1200 degrees centigrade. After firing, it is characterized by being able to be cut with a file in unglazed areas, and having a translucency that is variable in intensity and color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft paste porcelain"@en .

aat:300010666 a skos:Concept ;
    skos:definition "Generally, all ware made of ceramic, which is any of various hard, brittle, heat-resistant and corrosion-resistant materials made by shaping and then firing a nonmetallic mineral, such as clay, at a high temperature. In specialized usage, it typically does not include porcelain, which is a type of ceramic ware made of a refractory white clay, or \"kaolin,\" and a feldspathic rock, that react when fired so the clay serves to hold the shape of the object and the rock fuses into a natural glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery"@en .

aat:300010668 a skos:Concept ;
    skos:definition "Refers to tin-glazed European earthenware, particularly ware made in France, Germany, Spain, and Scandinavia. It developed in France in the early 16th century, was influenced by the technique and the designs of Italian maiolica, and is named for Faenza, Italy, which was famous for maiolica. It is distinguished from tin-glazed earthenware made in Italy, which is called \"maiolica,\" and that made in the Netherlands and England, which is called \"delftware.\" It has no connection to the ancient objects or material also named faience, which was developed in the Near East ca. 4500 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faience"@en .

aat:300010669 a skos:Concept ;
    skos:definition "A baked or semi-fired material that is usually a mixture of clay, grog, and water; it has been used for pottery, statuettes, lamps, roof tiles, and cornices since ancient times. It may be glazed prior to firing. To produce an item, terracotta is molded or shaped, dried for several days then fired to at least 600 C. It is fireproof, lighter in weight than stone, and usually brownish red in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terracotta"@en .

aat:300010670 a skos:Concept ;
    skos:definition "A hard-burnt, glazed or unglazed clay unit used in building construction, machine extruded or handmade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural terracotta"@en .

aat:300010672 a skos:Concept ;
    skos:definition "A type of pottery midway between earthenware and porcelain being made of clay and a fusible stone. It is fired to a point where partial vitrification renders it impervious to liquids, but, unlike porcelain, it is very seldom more than faintly translucent. The vitrification makes it unnecessary to add a glaze, but for reasons of utility and appearance decorative glazes are sometimes used, such as salt glaze and lead glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoneware"@en .

aat:300010675 a skos:Concept ;
    skos:definition "Building material, composed of ceramic similar to stoneware, developed in England around 1769, used primarily for architectural decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coade stone"@en .

aat:300010676 a skos:Concept ;
    skos:definition "Flat, solid, and relatively thin durable items of various materials, generally used for roofing, flooring, or wall and ceiling covering; often rectangular or squarish in shape. For fired clay materials of varying shapes and thicknesses and with various uses in addition to covering, prefer \"ceramic tile.\" For visual works, such as painting or sculpture, on a tile support, use \"tiles (visual works)\"; for visual work compositions comprising multiple tiles, use \"tile work (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile"@en .

aat:300010678 a skos:Concept ;
    skos:definition "Fired clay in various shapes and thicknesses and with a variety of uses, as for surface covering, drainage, or construction. For general flat, solid, and relatively thin durable material used primarily for surface covering and of various materials, use \"tile.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramic tile"@en .

aat:300010680 a skos:Concept ;
    skos:definition "Flat, cellular roofing tile having two parallel edges, one of which is convex and the other concave, so that a number may be fit together edge-to-edge between rafters, joists, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book tile"@en .

aat:300010681 a skos:Concept ;
    skos:definition "Glazing quarries, often square or diamond-shaped, having a pattern or design impressed, painted, or fired upon them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carreaux"@en .

aat:300010682 a skos:Concept ;
    skos:definition "Tiles, semicircular in shape, which fit over the joints in a tile roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imbrex"@en .

aat:300010684 a skos:Concept ;
    skos:definition "Unglazed ceramic tile, machine-made by the extrusion process from natural clay or shales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarry tile"@en .

aat:300010686 a skos:Concept ;
    skos:definition "Tile with one face molded to look like the face or end of a brick; it was particularly popular between 1784 (the year the brick tax was passed in England) and 1850 (when the tax was repealed). It would be nailed to battens on a timber frame or other wall, or, occasionally, bedded into plaster rendering over cobble stones or pebbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathematical tile"@en .

aat:300010688 a skos:Concept ;
    skos:definition "Ceramic tile, usually in short-length sections, used for constructing water drains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drain tile"@en .

aat:300010694 a skos:Concept ;
    skos:definition "Extruded clay shapes with substantial depth that allows them to be laid in the same manner as other clay or concrete masonry. May be composed of burnt clay, shale, fireclay, or composites. Used to construct roofing, walls, and flooring for structural and non-structural purposes, especially in fireproofing applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural clay tile"@en .

aat:300010697 a skos:Concept ;
    skos:definition "Tile for use in building interior partitions, subdividing areas into rooms, or similar construction, carrying no superimposed loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partition tile"@en .

aat:300010698 a skos:Concept ;
    skos:definition "Any of a series of tiles covering a wall and overlapped like shingles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weather tile"@en .

aat:300010699 a skos:Concept ;
    skos:definition "Type of tile used for roofing, usually of fired clay, slate, metal, concrete, asbestos cement, or plastic; available in many configurations and types such as plain tiles, single-lap tiles, and interlocking tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing tile"@en .

aat:300010700 a skos:Concept ;
    skos:definition "Tile which fits like a saddle on the ridge of a roof, forming a crest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crest tile"@en .

aat:300010703 a skos:Concept ;
    skos:definition "Type of interlocking roof tile, heavily corrugated and formed with interlocking side joints and a rounded bull nose butt edge to engage the corrugations of the course immediately below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French tile"@en .

aat:300010704 a skos:Concept ;
    skos:definition "A saddle-shaped tile used to cover the external angles of a roof where two sloping sides meet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hip tile"@en .

aat:300010705 a skos:Concept ;
    skos:definition "A tile that resembles a bonnet; used to cover the hip on a hip roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonnet hip tile"@en .

aat:300010712 a skos:Concept ;
    skos:definition "Single-lap roofing tile of two types used in combination: a flat, tapered undertile having flanges, and a half-rounded, tapered overtile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pan-and-roll roofing tile"@en .

aat:300010713 a skos:Concept ;
    skos:definition "In ancient architecture, a term used to describe a flat tile or tegula. In modern usage, an S-curved roofing tile, laid so the down curve of one tile overlaps the up curve of the next one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantile"@en .

aat:300010715 a skos:Concept ;
    skos:definition "A tile which is curved in section, used to cover the ridge of a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ridge tile"@en .

aat:300010717 a skos:Concept ;
    skos:definition "A channel-shaped, tapered, single lap, roofing tile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman tile"@en .

aat:300010718 a skos:Concept ;
    skos:definition "A flat clay tile used for roofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shingle tile"@en .

aat:300010719 a skos:Concept ;
    skos:definition "Clay roofing tile, approximately semicylindrical in shape; laid in cornices with the units having their convex sides alternately up and down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish tile"@en .

aat:300010721 a skos:Concept ;
    skos:definition "Tile used for roofing, distinguished by being shaped and laid to form a valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valley tile"@en .

aat:300010723 a skos:Concept ;
    skos:definition "Earthenware tile of Spanish or Portuguese manufacture, painted and enameled in rich colors. They are typically large and used to decorate the exterior walls of buildings. The term is probably of Arabic origin but its derivation is debated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azulejo"@en .

aat:300010724 a skos:Concept ;
    skos:definition "Glazed or unglazed ceramic tile which shows characteristic variations in the face, edges, and glaze that give a handcrafted, non-mechanical, decorative effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faience tile"@en .

aat:300010726 a skos:Concept ;
    skos:definition "Any tile composed of materials having the property of absorbing sound waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustical tile"@en .

aat:300010728 a skos:Concept ;
    skos:definition "Tile designed to be used for areas of pavement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paving tile"@en .

aat:300010730 a skos:Concept ;
    skos:definition "Small, squarish pieces of colored marble, glass, stone, or tile used in making mosaics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tesserae"@en .

aat:300010731 a skos:Concept ;
    skos:definition "Tile, often glazed, designed to be used as a facing on a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall tile"@en .

aat:300010735 a skos:Concept ;
    skos:definition "Building material comprising a mixture of straw, gravel, and unburnt clay, especially used in the construction of walls, known as cob walls. Cob construction is distinguished by placing soft adobe in layers, rather than by making individual dried bricks or using a form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cob"@en .

aat:300010737 a skos:Concept ;
    skos:definition "A hard, strong construction material comprising a mixture of sand, gravel, crushed rock, or other aggregate, held together, typically by a hardened paste of cement and/or lime. Several types of aggregate are used such as crushed stone, slag, cinders or gravel. Ancient Romans developed pozzolan cement about the 3rd century BCE. Modern concretes use various cements such as portland or hydraulic. Concrete is durable and relatively inexpensive, used for foundations, bridges, dams, walls, and highways. Concrete is strong in compression but weak in tension so it is often reinforced with steel bars or wire netting. Once a concrete mixture is stirred with water and poured into a mold, it is allowed to cure slowly over about a week. Stresses, such as vibration, freezing, and rapid drying, will diminish the strength and durability of the concrete. As it ages, concrete is subject to erosion, spalling, and pollution. Poor mixing can cause erosion. Spalling can be due to freeze-thaw cycles of moisture and ice, salt crystallization, or corrosion of steel reinforcements. Acid rain can deplete the natural alkaline reserve of fresh concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete"@en .

aat:300010739 a skos:Concept ;
    skos:definition "A composite material consisting of gravel, sand, and stone that is bound together with asphalt; it is laid down in layers and compacted. It is commonly used in construction projects such as road surfaces, airports, and parking lots. The ingredients are mixed under high temperatures and kept heated until applied to a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphalt concrete"@en .

aat:300010741 a skos:Concept ;
    skos:definition "Concrete consisting of lime, sand, and gravel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "béton"@en .

aat:300010742 a skos:Concept ;
    skos:definition "A lightweight concrete made with cinder as the coarse aggregate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinder concrete"@en .

aat:300010743 a skos:Concept ;
    skos:definition "Concrete in which the aggregate is bound by a grout that has the ability to retain dispersed solid particles in suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colloidal concrete"@en .

aat:300010744 a skos:Concept ;
    skos:definition "Mass concrete in which large stones, each weighing 100 lb. (45.4 kg) or more, are embedded when the concrete is laid. The stones, called pudding stones or plums, are typically less than 6 in. (15 cm) apart and farther than 8 in. (20 cm) away from any exposed surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclopean concrete"@en .

aat:300010745 a skos:Concept ;
    skos:definition "Concrete containing fibers of such materials as glass, asbestos, wood, steel and plastic in order to reduce weight and increase tensile strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fibro-concrete"@en .

aat:300010748 a skos:Concept ;
    skos:definition "A concrete made from a mixture of lime, sand, and gravel, widely used before the lime matrix was replaced by portland cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime concrete"@en .

aat:300010749 a skos:Concept ;
    skos:definition "Concrete in which an organic polymer serves as the binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymer-impregnated concrete"@en .

aat:300010753 a skos:Concept ;
    skos:definition "Form of concrete reinforced by broken stones or brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubble concrete"@en .

aat:300010754 a skos:Concept ;
    skos:definition "Relatively lightweight concrete made with blast-furnace slag as the coarse aggregate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slag concrete"@en .

aat:300010756 a skos:Concept ;
    skos:definition "Concrete having low thermal conductivity and used as thermal insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insulating concrete"@en .

aat:300010757 a skos:Concept ;
    skos:definition "A form of concrete which acts as an insulator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zonolite concrete (TM)"@en .

aat:300010760 a skos:Concept ;
    skos:definition "Concrete containing minute air bubbles that improve its workability and frost resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-entrained concrete"@en .

aat:300010764 a skos:Concept ;
    skos:definition "Slag concrete to which a chemical foaming agent has been added, resulting in a lightweight slag concrete full of air holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foamed slag concrete"@en .

aat:300010767 a skos:Concept ;
    skos:definition "A construction material composed of cement, sand, or crushed slag and water forced through a pneumatic gun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunite"@en .

aat:300010774 a skos:Concept ;
    skos:definition "Concrete for delivery to a site in an unhardened state for immediate use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ready-mixed concrete"@en .

aat:300010775 a skos:Concept ;
    skos:definition "Concrete that contains embedded reinforcements, typically steel bars, in order to increase strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reinforced concrete"@en .

aat:300010777 a skos:Concept ;
    skos:definition "Concrete made with expansive cement in order to reduce or control changes in volume during the curing stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expansive concrete"@en .

aat:300010780 a skos:Concept ;
    skos:definition "Any concrete that does not disintegrate upon exposure to constant or cyclic heating at a temperature below the level needed to form a ceramic bond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-resistant concrete"@en .

aat:300010783 a skos:Concept ;
    skos:definition "A lightweight concrete mixture containing little or no fine aggregate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "no-fines concrete"@en .

aat:300010784 a skos:Concept ;
    skos:definition "Concrete having a unit weight of approximately 150 pounds per cubic foot, made with aggregate of normal weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "normal-weight concrete"@en .

aat:300010788 a skos:Concept ;
    skos:definition "Any combination or mixture of materials made to imitate stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial stone"@en .

aat:300010790 a skos:Concept ;
    skos:definition "Artificial marble used in casting statues and small ornamental articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbelite"@en .

aat:300010791 a skos:Concept ;
    skos:definition "A cast imitation marble produced with Keene's cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marezzo marble"@en .

aat:300010794 a skos:Concept ;
    skos:definition "Masonry units comprising lightweight cinder concrete, often used for interior partitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinder blocks"@en .

aat:300010797 a skos:Concept ;
    skos:definition "An amorphous, inorganic substance made by fusing silica (silicon dioxide) with a basic oxide; generally transparent but often translucent or opaque. Its characteristic properties are its hardness and rigidity at ordinary temperatures, its capacity for plastic working at elevated temperatures, and its resistance to weathering and to most chemicals except hydrofluoric acid. Used for both utilitarian and decorative purposes, it can be formed into various shapes, colored or decorated. Glass originated as a glaze in Mesopotamia in about 3500 BCE and the first objects made wholly of glass date to about 2500 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass"@en .

aat:300010800 a skos:Concept ;
    skos:definition "Silicate glass containing at least five percent boric oxide and used in heat-resistant glassware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borosilicate glass"@en .

aat:300010801 a skos:Concept ;
    skos:definition "A low-expansion type of bora-silicate glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pyrex (TM)"@en .

aat:300010802 a skos:Concept ;
    skos:definition "A brilliant lustrous glass made from a composition of lead oxide, sand, and alkali. It is often used in lenses and prisms because of its high index of refraction. This term is sometimes used to refer more generally to \"crystal (lead glass).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flint glass"@en .

aat:300010803 a skos:Concept ;
    skos:definition "A brilliant glass of high lead content used for the manufacture of artificial gems; also an imitation gem made of this material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste"@en .

aat:300010806 a skos:Concept ;
    skos:definition "A colorless artificial gem of paste or glass, often with facets that sparkle in imitation of a diamond. Also refers to foil-backed or silvered cut glass used to imitate diamonds. Rhinestones were originally quartz pebbles found in the Rhine River, thus the name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhinestone"@en .

aat:300010811 a skos:Concept ;
    skos:definition "Glass containing a high proportion of lead oxide and having a relatively high refractive index, with poor acid resistance and low rigidity; used in many optical components, neon-sign tubing, and light bulbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead glass"@en .

aat:300010814 a skos:Concept ;
    skos:definition "Fine, high quality, heavy, decorative glass made with fine white sand, at least 24% lead oxide, and small amounts of potash and niter. It is clear, colorless, highly refractive glass that is heavy and has greater than twice the density of standard borate glass. It was developed in England in 1676; often used for high quality chandelier prisms and fine stemware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystal"@en .

aat:300010818 a skos:Concept ;
    skos:definition "A lime glass in which soda is used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soda lime glass"@en .

aat:300010821 a skos:Concept ;
    skos:definition "A glass fiber, .001 inches in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass wool"@en .

aat:300010822 a skos:Concept ;
    skos:definition "Any glass that has been rolled or cast into a sheet and then ground and polished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate glass"@en .

aat:300010824 a skos:Concept ;
    skos:definition "Refers to a type of glass that is made by pressing molten glass through rollers. It is generally characterized by an even texture and uniform thickness. It may also be used more generally to refer to any glass produced in large flat sheets made by blowing, drawing, rolling, or floating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet glass"@en .

aat:300010828 a skos:Concept ;
    skos:definition "Sheet glass with a thickness of 3/32 in. used for windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single strength window glass"@en .

aat:300010829 a skos:Concept ;
    skos:definition "Sheet glass having a thickness of between 0.118 inches (3.00 mm) and 0.113 inches (3.38 mm)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double strength window glass"@en .

aat:300010832 a skos:Concept ;
    skos:definition "Glassware shaped by blowing air through a blowpipe into a glob of molten glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blown glass"@en .

aat:300010833 a skos:Concept ;
    skos:definition "Glass formed of two or more fused layers of different colored glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cased glass"@en .

aat:300010838 a skos:Concept ;
    skos:definition "Flat pane glass made by blowing a bubble of glass, transferring it from a blow-pipe to a rod, cutting it open, then rapidly rotating it until, by centrifugal force, it is spread into a flat disk. Can be either small individual panes with so-called bulls-eyes in the centers or large disks that are annealed and cut into pieces. Crown glass is thin and brilliant with a slight convexity and concentric wavy lines. Known to the ancient Romans throughout the Empire; found in windows of medieval cathedrals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown glass"@en .

aat:300010840 a skos:Concept ;
    skos:definition "Flat pane glass characterized by straight ripples. Is made by an an ancient technique of blowing a large glass bubble and swinging it on a blow-pipe to form a long bottle, then cutting off both hemispherical ends. The resulting cylinder is then cut lengthwise and reheated after which it is flattened by a wooden plane or by being allowed to sink to a flat state. Traditionally, it was characterized by a great variability of texture, color, and thickness, though it is more regular when produced by modern methods. Cylinder glass largely replaced crown glass when the process of making it was mechanized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder glass"@en .

aat:300010844 a skos:Concept ;
    skos:definition "Glass that is made by continuous drawing of the molten glass by a series of rolls on automatic machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawn glass"@en .

aat:300010846 a skos:Concept ;
    skos:definition "Sheet glass made by floating a ribbon of hot glass on a bath of heated liquid, usually molten tin. The process was developed in 1959 by Pilkington Brothers and is now the world's principal method of manufacturing good quality sheet glass which is clear, flat, with parallel and fire polished sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "float glass"@en .

aat:300010847 a skos:Concept ;
    skos:definition "Double-strength glass that has one side ground to a frosted finish, thus transforming the clear glass to an obscure glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground glass"@en .

aat:300010851 a skos:Concept ;
    skos:definition "A flat glass of considerable thickness made by passing a roller over molten glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolled glass"@en .

aat:300010853 a skos:Concept ;
    skos:definition "Refers to glass of various colors created by adding metallic oxides to the molten glass; different oxides create various colors. Stained glass may be conbined with painted glass, which involves fusing pigment onto the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stained glass"@en .

aat:300010855 a skos:Concept ;
    skos:definition "Flat glass used for utilitarian purposes, although the term is sometimes used to describe what is known as stained glass. In modern times some is made in solid or hollow blocks to be used for building walls. Can be decorated by etching, sandblasting or other techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural glass"@en .

aat:300010856 a skos:Concept ;
    skos:definition "A type of structural plate glass that is ground to true plane surfaces; used for storefronts, countertops, tiling, and paneling. It is made in many colors in thicknesses from 11/32 to 1 1/2 inches (0.86 to 3.81 cm) or laminated to give different color effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carrara structural glass (TM)"@en .

aat:300010857 a skos:Concept ;
    skos:definition "Generally, glass used in architecture that is cut, embossed, sandblasted, or otherwise embellished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figured glass"@en .

aat:300010861 a skos:Concept ;
    skos:definition "Clear glass with colored ceramic enamel fired on one side, used for spandrels and similar applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spandrel glass"@en .

aat:300010863 a skos:Concept ;
    skos:definition "Refers to thick homogeneous opaque structural glass used especially for ornamental finish on surfaces exposed to the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitrolite (TM)"@en .

aat:300010864 a skos:Concept ;
    skos:definition "Glass whose chemical composition has been altered to produce a glass capable of absorbing a portion of the solar energy that reaches it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glare-reducing glass"@en .

aat:300010866 a skos:Concept ;
    skos:definition "Glass that absorbs heat because it is opaque to infrared radiation; it nevertheless retains a reasonable degree of transparency to most other radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-absorbing glass"@en .

aat:300010867 a skos:Concept ;
    skos:definition "Glass, usually borosilicate, with a low coefficient of expansion making it resistant to thermal shock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-resisting glass"@en .

aat:300010871 a skos:Concept ;
    skos:definition "Glass that has been heat treated to induce surface compression in order to add strength. On breaking, it breaks into sharp pieces, but smaller than pieces of broken annealed glass. It does not dice, as does tempered glass on breaking. It is intermediate in strength between annealed glass and toughened glass. It is used in the curtain wall design as spandrel glazing of multistoried buildings. It is usually polished plate glass or patterned glass on one surface of which is fused a colored enamel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-strengthened glass"@en .

aat:300010872 a skos:Concept ;
    skos:definition "Window glass made of two sheets of glass separated by metal bonded to the edges of the glass, leaving an insulating layer of dehydrated air between the two panes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insulating glass"@en .

aat:300010876 a skos:Concept ;
    skos:definition "Glass for which reflectivity has been reduced by the application of coatings; the coatings disperse reflections and increase the light transmission to almost 99 percent. The standard nonreflective coating is magnesium fluoride, which gives glass a bluish tint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonreflective glass"@en .

aat:300010877 a skos:Concept ;
    skos:definition "A highly refined glass, usually a flint glass of special composition, or made from rock crystal, used for lenses and prisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical glass"@en .

aat:300010878 a skos:Concept ;
    skos:definition "Clear silicate glass that will form permanent three-dimensional color photographic images when subjected to x-rays or ultraviolet light through a negative. Photosensitive glass contains submicroscopic metallic particles; the high energy causes the particles to precipitate out of solution. The image is fixed by heating the glass to 540 C."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photosensitive glass"@en .

aat:300010881 a skos:Concept ;
    skos:definition "Glass coated on one side with a transparent metallic coating that reflects light and radiant heat, particularly when used as window glass. Reflective glass is rated by the solar heat gain coefficient, ranging from 0.10 to 0.40."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflective glass"@en .

aat:300010884 a skos:Concept ;
    skos:definition "A material composed of two sheets of plate glass with a sheet of transparent resinoid between, the whole molded together under heat and pressure. It will crack without shattering when subjected to a severe blow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety glass"@en .

aat:300010886 a skos:Concept ;
    skos:definition "Glass, generally about 4 cm thick, made of several layers of laminated glass separated by layers of vinyl or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullet-resistant glass"@en .

aat:300010889 a skos:Concept ;
    skos:definition "Sheet glass in which wire mesh is enclosed as a safety measure: when the glass is fractured the pieces are held together by the wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wired glass"@en .

aat:300010891 a skos:Concept ;
    skos:definition "Glass that contains a high percentage of lead oxide and sometimes barium oxide, which offers sufficient protection from x-rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray protective glass"@en .

aat:300010898 a skos:Concept ;
    skos:definition "Visual works made of glass. Examples are tableware of glass used in serving food and drink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassware"@en .

aat:300010900 a skos:Concept ;
    skos:definition "Any of a large group of substances that typically show a characteristic luster, are good conductors of electricity and heat, are opaque, can be fused, and are usually malleable or ductile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal"@en .

aat:300010902 a skos:Concept ;
    skos:definition "Substance having metallic properties, consisting of two or more metallic elements or of metallic and nonmetallic elements, which are miscible with each other when molten, and do not separate into distinct layers when solid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alloy"@en .

aat:300010904 a skos:Concept ;
    skos:definition "Alloy in which iron is the principle element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron alloy"@en .

aat:300010907 a skos:Concept ;
    skos:definition "Steel that does not have specified minimum content levels of alloying elements. The term can also refer to steel that does not have more than 0.40% copper or to steel that has maximum content levels of the following: manganese 1.65%, silicon 0.60%, and copper 0.60%."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon steel"@en .

aat:300010911 a skos:Concept ;
    skos:definition "Steel having a carbon content under 0.2%."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-carbon steel"@en .

aat:300010915 a skos:Concept ;
    skos:definition "Steel having a carbon content ranging from 0.2 to 0.5%."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium-carbon steel"@en .

aat:300010916 a skos:Concept ;
    skos:definition "Steel having a carbon content in excess of 0.5%."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-carbon steel"@en .

aat:300010917 a skos:Concept ;
    skos:definition "A general name for steel that owes its distinctive properties to elements other than carbon; types of alloy steel typically take the name of the element or elements that are most influential on their character. Usually used for toolmaking and building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alloy steel"@en .

aat:300010918 a skos:Concept ;
    skos:definition "Any steel with chromium as the predominating element, the chromium making the steel hard and wear-resistant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome steel"@en .

aat:300010919 a skos:Concept ;
    skos:definition "Any chromium steel containing a small amount of vanadium; valued for its combination of strength and ductility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome-vanadium steel"@en .

aat:300010920 a skos:Concept ;
    skos:definition "Any of a large number of iron-chromium alloys, widely used for their corrosion resistance and nonrusting quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stainless steel"@en .

aat:300010921 a skos:Concept ;
    skos:definition "Stainless steel containing up to 30% chromium and 20% nickel; used chiefly in aircraft and other transport equipment because of its high strength and corrosion resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "austenitic stainless steel"@en .

aat:300010922 a skos:Concept ;
    skos:definition "Stainless steel having a relatively high proportion of chromium, ranging between 12 and 17%, and a relatively high proportion of carbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martensitic stainless steel"@en .

aat:300010923 a skos:Concept ;
    skos:definition "Steel, containing carbon, manganese, and small amounts of other elements, characterized by high strength and corrosion resistance. Exposure to air creates a pebbly, rusty-looking surface that works to reduce corrosion; this surface film turns a deep purple-brown after a number of years which is why high-strength low-alloy steel is sometimes used for exposed structural members of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-strength low-alloy steel"@en .

aat:300010927 a skos:Concept ;
    skos:definition "Steel with nickel as the dominant alloying element; the addition of nickel can result in steel that is less likely to warp or crack, more resistant to corrosion, and generally stronger and harder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickel steel"@en .

aat:300010928 a skos:Concept ;
    skos:definition "Material derived by bonding stainless steel and aluminum alloy, for example, through diffusion bonding, friction welding, explode bonding, or using semisolid aluminum alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel-aluminum alloy"@en .

aat:300010929 a skos:Concept ;
    skos:definition "Material made by the bonding of metallurgically incompatible titanium and steel, by explosive bonding or another method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanium steel"@en .

aat:300010931 a skos:Concept ;
    skos:definition "Steel, rolled in a variety of shapes, such as beams, bars, or sheets, and used as load-bearing structural members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural steel"@en .

aat:300010932 a skos:Concept ;
    skos:definition "Alloys in which lead is the principle element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead alloys"@en .

aat:300010933 a skos:Concept ;
    skos:definition "Any alloy containing nickel as the base metal, or as the chief alloying element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickel alloy"@en .

aat:300010937 a skos:Concept ;
    skos:definition "Refers to alloys with from 5 to 22% silicon characterized by ease of casting, corrosion resistance, lightness, and ease of welding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum-silicon alloy"@en .

aat:300010939 a skos:Concept ;
    skos:definition "An alloy consisting of 95.5 parts of aluminum to 3 parts of copper, 1 of manganese, and 0.5 of magnesium that after age-hardening is comparable in strength and hardness to soft steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duralumin"@en .

aat:300010940 a skos:Concept ;
    skos:definition "Alloy in which chromium is the principle element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromium alloy"@en .

aat:300010942 a skos:Concept ;
    skos:definition "Alloy in which copper is the principle element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper alloy"@en .

aat:300010943 a skos:Concept ;
    skos:definition "A copper-aluminum alloy with aluminum as the chief alloying element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum bronze"@en .

aat:300010946 a skos:Concept ;
    skos:definition "Alloy of copper and zinc, usually with copper as the major alloying element and zinc up to 40% by weight. For an alloy consisting mainly of copper, combined most often with tin, but at times also with other metals, use \"bronze (metal).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brass"@en .

aat:300010947 a skos:Concept ;
    skos:definition "One of the standard alloys of brass, containing 70% copper and 30% zinc. It has high ductility and an attractive yellow color, and is used for deep-drawn or spun articles such as lamp bases, horns, and cornets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartridge brass"@en .

aat:300010950 a skos:Concept ;
    skos:definition "Brass containing 60% copper and 40% zinc, commonly produced in sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muntz metal"@en .

aat:300010951 a skos:Concept ;
    skos:definition "The term used for the 75-25 and 50-50 cupronickel slabs, ingots, and shot used for adding nickel to brasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper-nickel alloy"@en .

aat:300010953 a skos:Concept ;
    skos:definition "Copper alloy containing silicon, either in small or larger amounts depending on the class, used for electrical wires due to its strength and resistance to corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper-silicon alloy"@en .

aat:300010955 a skos:Concept ;
    skos:definition "Alloy consisting of about 70% copper, 1% tin, and the remainder zinc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "admiralty metal"@en .

aat:300010957 a skos:Concept ;
    skos:definition "Refers to a broad range of alloys of copper, specifically any non-ferrous alloy of copper, tin, and zinc or other trace metals. Bronze was made before 3,000 BCE - possibly as early as 10,000 BCE, although its common use in tools and decorative items is dated only in later artifacts. The proportions of copper and tin vary widely, from 70 to 95 percent copper in surviving ancient artifacts. Because of the copper base, bronze may be very malleable and easy to work. By the Middle Ages in Europe, it was recognized that using the metals in certain proportions could yield specific properties. Some modern bronzes contain no tin at all, substituting other metals such as aluminum, manganese, and even zinc. Historically, the term was used interchangeably with \"latten.\" U.S. standard bronze is composed of 90% copper, 7% tin and 3% zinc. Ancient bronze alloys sometimes contained up to 14% tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze"@en .

aat:300010958 a skos:Concept ;
    skos:definition "Bronze used chiefly for casting large bells. Its standard composition is 78% copper and 22% tin but is varied to give varying tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell metal"@en .

aat:300010959 a skos:Concept ;
    skos:definition "A bronze alloy with a high lead content, the 80:10:10 mixture, making it a soft matrix metal ideal for use in bearings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead bronze"@en .

aat:300010961 a skos:Concept ;
    skos:definition "Bronze containing phosphorus, or which has been deoxidized by the addition of phosphorus in its final processing stage, little or no phosphorus remaining in the final alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphor bronze"@en .

aat:300010962 a skos:Concept ;
    skos:definition "Copper-silicon alloy, either nearly pure copper fluxed with silicon, of which only a trace remains in the final metal, or brass or aluminum bronze containing some silicon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicon bronze"@en .

aat:300010963 a skos:Concept ;
    skos:definition "Alloy in which gold is the principle element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold alloy"@en .

aat:300010965 a skos:Concept ;
    skos:definition "The natural alloy of silver and gold. Under the Egyptian name of Asem, it was believed to be an elementary metal until the Romans made it as an alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrum"@en .

aat:300010966 a skos:Concept ;
    skos:definition "An alloy of gold, silver, and copper that is used to make jewelry; it is graded from 14 to 18 karats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green gold"@en .

aat:300010967 a skos:Concept ;
    skos:definition "Gold with a ruddy mat surface finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose gold"@en .

aat:300010968 a skos:Concept ;
    skos:definition "The term for a class of white alloys used by jewelers as substitutes for platinum; it is easily manipulated into intricate shapes. The name does not convey the relative value of the different grades, which vary a great deal. Typical white gold alloys consist of 20 to 50% nickel with the rest being gold; zinc, silver, copper, platinum, and palladium may also be used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white gold"@en .

aat:300010972 a skos:Concept ;
    skos:definition "Gold alloy containing 14 parts gold to 10 parts alloying metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourteen-carat gold"@en .

aat:300010973 a skos:Concept ;
    skos:definition "Gold which has 18 parts of gold to six parts of alloying metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighteen-carat gold"@en .

aat:300010975 a skos:Concept ;
    skos:definition "Alloy in which silver is the principle element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver alloy"@en .

aat:300010977 a skos:Concept ;
    skos:definition "A standard high-grade silver alloy with a minimum of 925 parts silver, the rest being copper for hardening purposes; used for the highest quality silver jewelry, tableware, and electric contacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sterling silver"@en .

aat:300010978 a skos:Concept ;
    skos:definition "Alloy in which tin is the principle component."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin alloy"@en .

aat:300010979 a skos:Concept ;
    skos:definition "Alloy of tin and various proportions and combinations of lead and antimony, and sometimes also copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pewter"@en .

aat:300010982 a skos:Concept ;
    skos:definition "A type of pewter that is a very hard alloy of tin with antimony and zinc, sometimes with copper or other materials. Often used for such items as spoons and snuffboxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ashbury metal"@en .

aat:300010983 a skos:Concept ;
    skos:definition "A type of pewter that usually contains copper. Its color is silvery white with a bluish tinge, or with a yellowish tinge if the copper content is high."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "britannia metal"@en .

aat:300010984 a skos:Concept ;
    skos:definition "A type of britannia metal that contains 94% tin, 5% antimony, and 1% copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English britannia metal"@en .

aat:300010985 a skos:Concept ;
    skos:definition "A britannia metal with a small amount of zinc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queen's metal"@en .

aat:300010986 a skos:Concept ;
    skos:definition "A type of britannia metal that contains 81.5% tin, 7.5% antimony, and 9.5% copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch white metal"@en .

aat:300010987 a skos:Concept ;
    skos:definition "Pewter of the 16th century containing 91% tin and 9% antimony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English pewter"@en .

aat:300010988 a skos:Concept ;
    skos:definition "A type of britannia metal that contains 87% tin, 7.5% antimony, and 5.5% copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanover white metal"@en .

aat:300010989 a skos:Concept ;
    skos:definition "Pewter containing bismuth, used in making utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koeller's alloy"@en .

aat:300010990 a skos:Concept ;
    skos:definition "Grade of britannia metal containing up to 9% zinc and up to 1% iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minofor"@en .

aat:300010991 a skos:Concept ;
    skos:definition "Ancient pewter containing 70% tin and 30% lead, with other elements such as iron present as impurities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman pewter"@en .

aat:300010992 a skos:Concept ;
    skos:definition "German utensil alloy, contains 88% to 92% tin, up to 3% copper, and 6% to 7.5% lead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tutanic metal"@en .

aat:300010993 a skos:Concept ;
    skos:definition "Any of various types of alloy, commonly of lead and tin, used in soldering; the primary requirement is that it have a lower melting point than the metal surfaces to be joined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solder"@en .

aat:300010994 a skos:Concept ;
    skos:definition "Soft solder of eutectic composition, possessing the lowest melting point of any type of solder; constituted in proportions of 60% tin and 40% lead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine solder"@en .

aat:300010998 a skos:Concept ;
    skos:definition "Alloy predominantly of tin, usually of 92% tin and 8% antimony, having a white or silvery appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white metal"@en .

aat:300011000 a skos:Concept ;
    skos:definition "Alloy in which zinc is the principle element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc alloy"@en .

aat:300011002 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Fe and atomic number 26; metallic iron is silvery in color, lustrous, soft, ductile, malleable, and slightly magnetic; it rusts when exposed to moist air. It is rarely found as a native metal (telluric iron) except in meteorites (meteoric iron). Iron is most often found throughout the world as iron oxides (hematite, magnetite, limonite, and siderite) mixed with other ores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron"@en .

aat:300011004 a skos:Concept ;
    skos:definition "An iron alloy containing about 2 to 4% carbon and 1 to 3% silicon, having a high compressive strength but low tensile strength. Cast iron is manufactured by melting scrap iron or pig iron in a cupola that is in contact with the coal fuel, then casting the molten iron into a mold. A large range of building and decorative items are made of cast iron by pouring the molten metal into sand molds and then machining. It is inexpensive and easy to make. It was made in China by at least the 3rd century BCE; the technique for its production did not reach Europe until medieval times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cast iron"@en .

aat:300011005 a skos:Concept ;
    skos:definition "A type of cast iron that is similar to steel in both structure and some properties; it is often used for machine parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ductile iron"@en .

aat:300011009 a skos:Concept ;
    skos:definition "A hard silvery-white cast iron or pig iron that has its carbon content almost completely in combined form; can also refer to thin sheets of iron coated with tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white iron"@en .

aat:300011010 a skos:Concept ;
    skos:definition "Iron that has been cast or worked in structural shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural iron"@en .

aat:300011012 a skos:Concept ;
    skos:definition "Iron alloy of fibrous nature made by melting white cast iron, passing an oxidizing flame over it, and rolling it into a mass; valued for its corrosion resistance and ductility. When describing objects produced or shaped by beating with a hammer, use \"wrought.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrought iron"@en .

aat:300011017 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Sb and atomic number 51; a bright, hard, silvery to bluish white metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials, particularly alloys and pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimony"@en .

aat:300011018 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Cd and atomic number 48; a silver white crystalline metal, very ductile, and which can be rolled or beaten into thin sheets; resembles tin but is harder. Use also for this metal as processed and formed, usually in combination with other substances, to make objects and materials, including pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium"@en .

aat:300011019 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Cr and atomic number 24; an extremely hard, silvery white metal with a bluish tinge. Use also for the metal as processed and formed, usually in combination with other substances, to make various objects and materials, notably stainless steel, heat-resistant alloy, high-strength alloy steel, and for wear-resistant electroplating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromium"@en .

aat:300011020 a skos:Concept ;
    skos:definition "Pure metallic element having the symbol Cu and atomic number 29; a reddish brown, ductile metal that is present in the earth's crust, occurring as a native metal and as ores of sulfide, sulfate and carbonate (azurite, malachite, etc.). It was the first metal used by humans, probably from about 8000 BCE, in the regions of Mesopotamia and India. By about 3800 BCE copper was made into bronze for weapons and knives. Today, copper is one of the most widely used metals because it has high electrical and thermal conductivity, can be easily fabricated, is ductile and polishes well. In moist air, copper forms a protective green film of basic carbonate. Metallic copper combines well with other metals to form alloys, most commonly brass and bronze. Copper and its alloys are used for wire, electrical devices, pipes, cooking vessels, ammunition, ornamental trim, roofing, grillwork, coins, musical instruments, jewelry, and sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper"@en .

aat:300011021 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Au and atomic number 79; a soft, inert, shiny reddish yellow metal that is very malleable and ductile. Gold has been highly valued and found in artifacts dating to before 5000 BCE. Native gold, found in quartz veins (vein gold) and alluvial deposits (placer gold), generally contains some silver and copper. Gold is purified by dissolution in mercury or cyanide solutions, by melting, or by electrodeposition. The purity of commercial gold is expressed in karats which is the number of parts of gold in 24 parts of the alloy. Today gold is primarily used for monetary systems and for jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold"@en .

aat:300011022 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Pb and atomic number 82; soft, dense ductile metal of a dull gray color, shiny when freshly cut, occuring naturally most often as a sulfide in the mineral galena. Other lead minerals include anglesite (lead sulfate) and cerussite (lead carbonate). Native metallic lead was found and used from about 3600-2600 BCE when the technique for obtaining lead from roasting the sulfide ore (galena) was discovered. Lead was used to make small cast items such as coins and statuettes, plumbing pipes, spires, statues, cisterns, gargoyles, pigments (lead white, litharge, orange mineral, etc.), as a component in pottery glazes, for roofing, flashing, stained glass windows, as a soft solder, and as radiation shielding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead"@en .

aat:300011024 a skos:Concept ;
    skos:definition "Pure metallic element having the symbol Mg and atomic number 12; the lightest metal that is stable under ordinary conditions, silvery white in color. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium"@en .

aat:300011025 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Mn and atomic number 25; hard, brittle, silvery metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese"@en .

aat:300011026 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Hg and atomic number 80; a lustrous silvery metal that is liquid at ordinary temperatures. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercury"@en .

aat:300011028 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Ni and atomic number 28; a silvery white metal with a yellowish cast, resistant to corrosion and to most acids except nitric. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickel"@en .

aat:300011029 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Ag and atomic number 47; a malleable, ductile, white metal with characteristic sheen, considered a precious metal. Silver is widely distributed throughout the world, occurring rarely as metallic silver (in Peru, Norway) but more often as silver-gold alloys and silver ore. Today silver is obtained as a byproduct in the refinement of gold, lead, copper, or zinc ores. Silver was smelted from the ore galena as early as 3800 BCE. As a pure metal, silver is second to gold in malleability and ductility, can be polished to a highly reflective surface, and used -- typically in an alloy -- in jewelry, coinage, photography, mirrors, electrical contacts, and tableware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver"@en .

aat:300011030 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Pd and atomic number 46; a rare, lustrous silvery white metal found in platinum ore. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palladium"@en .

aat:300011031 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Pt and atomic number 78; a lustrous, malleable, ductile, silvery white metal, considered a precious metal. Use also for this metal as processed and formed, usually in combination with other substances, to make objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platinum"@en .

aat:300011033 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Ti and atomic number 22; a hard, lustrous, silvery metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanium"@en .

aat:300011034 a skos:Concept ;
    skos:definition "Pure metallic element having symbol W and atomic number 74; a heavy white metal with a specific gravity of 19.6 and the highest melting point of any metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials, particularly alloy steel and magnets, and in electronic applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tungsten"@en .

aat:300011035 a skos:Concept ;
    skos:definition "Pure metallic element having symbol U and atomic number 92; a radioactive, silvery metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uranium"@en .

aat:300011036 a skos:Concept ;
    skos:definition "Pure metallic element having symbol V and atomic number 23; a pale gray metal with a silvery luster. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials, particularly steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vanadium"@en .

aat:300011037 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Zn and atomic number 30; a bluish white crystalline metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc"@en .

aat:300011039 a skos:Concept ;
    skos:definition "Metal beaten or rolled out to extreme thinness for use in gilding or other decorative processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaf"@en .

aat:300011041 a skos:Concept ;
    skos:definition "Generally, a layer of metal deposited upon a metal base, for purposes of decoration or to impart desirable physical or chemical properties. Distinct from \"plate (object genre)\" which refers to objects made of high quality solid silver or gold. The term is used more correctly for silverwork alone, but sometimes used loosely for goldwork as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate"@en .

aat:300011044 a skos:Concept ;
    skos:definition "A base metal, usually silver, copper, or bronze, that has been coated with a transparent orange-red lacquer to produce a rich gold-colored finish that appears to be gilt. Vermeil was common in the 19th century but rarely used today. For gold-plated silver, use \"silver gilding.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vermeil"@en .

aat:300011048 a skos:Concept ;
    skos:definition "Brass or bronze which is gilded or is gold in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ormolu"@en .

aat:300011051 a skos:Concept ;
    skos:definition "Broad, thin film of highly diluted pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wash"@en .

aat:300011053 a skos:Concept ;
    skos:definition "Discarded metal, often fragmented, that is suitable for reprocessing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrap metal"@en .

aat:300011054 a skos:Concept ;
    skos:definition "Metal considered to have high intrinsic value, such as gold, silver, and platinum; traditionally used to make such objects as jewelry and coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precious metal"@en .

aat:300011056 a skos:Concept ;
    skos:definition "A composite material consisting of ceramic particles or grains bonded with metal; used in high-strength and high-temperature applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cermet"@en .

aat:300011057 a skos:Concept ;
    skos:definition "Use generally for any metal pieces worked to a predetermined shape by one or more of such processes as hammering, pressing, rolling, or upset forging. Examples of forgings are machine parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forgings"@en .

aat:300011061 a skos:Concept ;
    skos:definition "Sheet metal that has been slit and expanded to form a mesh, which is used for reinforced-concrete work or plaster wall construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expanded metal"@en .

aat:300011062 a skos:Concept ;
    skos:definition "A matted mass of long, fine steel fiber, especially used for cleaning and polishing surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel wool"@en .

aat:300011063 a skos:Concept ;
    skos:definition "Filament or slender rod of drawn metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire"@en .

aat:300011064 a skos:Concept ;
    skos:definition "Wire furnished with barbs or sharp hook or points spaced at regular intervals; typically used for fencing or other barriers, it may be of single or multiple intertwined strands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbed wire"@en .

aat:300011065 a skos:Concept ;
    skos:definition "A light-gauge galvanized wire fencing, usually made with hexagonal mesh. So-called because it was originally used for enclosures for chickens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicken wire"@en .

aat:300011066 a skos:Concept ;
    skos:definition "Wire used for the strings of pianos, typically of high tensile strength and even thickness, containing 0.75 to 0.85 precent carbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano wire"@en .

aat:300011068 a skos:Concept ;
    skos:definition "Naturally occurring inorganic element or compound having an orderly internal structure and characteristic chemical composition, crystal form, and physical properties; use also for synthetically derived equivalents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral"@en .

aat:300011070 a skos:Concept ;
    skos:definition "Naturally occurring mineral of calcium fluor-phosphate; numerous deposits are found in Germany, Spain and North America. It is colorless when pure, but impurities can give it a white, green (asparagus stone), blue (moroxite), yellow, or violet color. Bones are composed of hydroxyapatite, mixed with protein (ossein) and small amounts of other minerals, such as calcium carbonate. Apatite is commercially used as a fertilizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apatite"@en .

aat:300011071 a skos:Concept ;
    skos:definition "A commercial term for any of several fibrous magnesium silicate minerals readily separable into thin, strong fiber that is flexible, noncombustible, heat resistant, and chemically inert; used in a wide variety of industrial products. It was used by the ancient Greeks, Egyptians, and Chinese as a fireproof material. In the 19th and early 20th centuries, asbestos was used for fireproofing and insulating houses: small asbestos fibers were mixed with binders and compressed into boards, paper, pipe covering, ironing board covers, shingles, tiles, and sprayed onto ceilings. Long asbestos fibers were woven into fabrics for used in brake linings, heat-resistant shields, gloves, and fireproof garments and blankets. Health concerns have limited the use of asbestos since the early 1960s. In the U.S., it was declared a hazardous material in 1986."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asbestos"@en .

aat:300011072 a skos:Concept ;
    skos:definition "A hexagonal mineral, which includes several varieties of gemstone such as emerald and aquamarine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beryl"@en .

aat:300011073 a skos:Concept ;
    skos:definition "A transparent, light bluish green gem variety of beryl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquamarine"@en .

aat:300011074 a skos:Concept ;
    skos:definition "A brilliant grass-green variety of beryl, highly prized as a gemstone. The name comes indirectly from the Greek \"smaragdos,\" referring to a number of stones having little in common except a green color. The emerald in the the Bible was probably a garnet. However, ancient societies did also value the genuine emerald, which came from Upper Egypt as early as 2000 BCE. Greek emerald miners worked for Alexander the Great and Cleopatra. The physical properties of emerald are essentially the same as those of beryl, with only moderate light refractive and dispersive powers, meaning that cut stones display little brilliancy or fire. The gems are instead valued for their magnificent color, which is probably caused by small amounts of chromium. The stone loses colour when strongly heated. Synthetic emerald was successfully produced in the 1930s, and today is produced by a either a molten-flux process or a hydrothermal method crystal growing process. Synthetic crystals appear very similar to natural emerald crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emerald"@en .

aat:300011075 a skos:Concept ;
    skos:definition "A variety of heliodor beryl that is golden in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golden beryl"@en .

aat:300011076 a skos:Concept ;
    skos:definition "A variety of beryl that is rose pink owing to the presence of lithium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morganite"@en .

aat:300011077 a skos:Concept ;
    skos:definition "A white or colorless crystalline mineral composed of hydrated sodium borate, used as a flux, cleansing agent, tanning agent, water softener, preservative, fungicide, as an alkaline ingredient in glass, ceramics, and glazes, in soldering, and as a source of boron. Borax is produced by the evaporation of water in shallow lakes. Borax was used by the Egyptians for mummification, by the Romans for glassmaking, as a flux for soldering gold in 9th-century Arabia, in ceramic glazes in northern China in the 10th century, and in Venetian glass from the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borax"@en .

aat:300011078 a skos:Concept ;
    skos:definition "A common rock-forming mineral, usually white or gray, it is the chief constituent of limestone and most marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcite"@en .

aat:300011079 a skos:Concept ;
    skos:definition "Widely occurring monoclinic mineral, usually green in color, associated with and resembling mica but chemically consisting of hydrous silicate of aluminum, ferrous iron, or magnesium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chlorite"@en .

aat:300011080 a skos:Concept ;
    skos:definition "A very hard crystalline mineral made of aluminum oxide, used chiefly as an abrasive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corundum"@en .

aat:300011081 a skos:Concept ;
    skos:definition "A gray-to-black impure variety of corundum which contains magnetite and hematite and is used as an abrasive. The stone is crushed and graded and used to make emery paper, emery cloth, and emery wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emery"@en .

aat:300011082 a skos:Concept ;
    skos:definition "A red variety of the mineral corundum that ranks with the best grades of precious stones as a gemstone; off-color rubies are used for watch and instrument bearings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruby"@en .

aat:300011083 a skos:Concept ;
    skos:definition "Any pure gem variety of corundum other than ruby."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sapphire"@en .

aat:300011084 a skos:Concept ;
    skos:definition "A highly transparent and exceedingly hard mineral of carbon; it is the hardest known substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond"@en .

aat:300011085 a skos:Concept ;
    skos:definition "A mineral of the pyroxene group consisting of magnesium silicate varying in color from grayish white to olive green and brown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enstatite"@en .

aat:300011086 a skos:Concept ;
    skos:definition "A yellowish green mineral consisting of a silicate of calcium, aluminum, and iron and occurring massive or in grains, columns, and monoclinic crystal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epidote"@en .

aat:300011087 a skos:Concept ;
    skos:definition "General name for a large group of aluminum silicate minerals, usually white or flesh-red in color, occurring in crystals or in crystalline masses. Feldspars are divided into three primary groups: potassium aluminum silicates (orthoclase, microcline), sodium aluminum silicates (albite, anorthoclase), and calcium aluminum silicates (anorthite). A few of the feldspars are found as gemstones such as moonstone, sunstone, and Amazon stone, but most are found in mineral structures, such as granite and diorite. They are used in the production of clays, ceramics, glass, concrete, abrasives, for cleaning, as a flux in ceramics, glazes, and glass, in fertilizer, and in granular roofing material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feldspar"@en .

aat:300011089 a skos:Concept ;
    skos:definition "A white, gray, brick-red, or green mineral of the alkali feldspar group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microcline"@en .

aat:300011090 a skos:Concept ;
    skos:definition "An opalescent variety of orthoclase, valued for gems and symbolic meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moonstone"@en .

aat:300011091 a skos:Concept ;
    skos:definition "A white, pink, or gray mineral of the alkali feldspar group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthoclase"@en .

aat:300011092 a skos:Concept ;
    skos:definition "A group of triclinic feldspar distinguished from alkali feldspars which are sodium- or potassium-rich."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plagioclase"@en .

aat:300011095 a skos:Concept ;
    skos:definition "Multi-colored transparent or translucent material containing calcium fluoride, commonly occurring in massive crystalline cube form with perfect octahedral cleavage, used as flux, as a source of fluoride compound, and in the preparation of opalescent and opaque glass, vitreous enamel, and a purple pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorite"@en .

aat:300011097 a skos:Concept ;
    skos:definition "A general name for a type of mineral varying in color and hardness, including trisilicates of aluminum, magnesium, calcium, iron, manganese, vanadium, chromium, and sometimes sodium and titanium. Used for coating abrasive paper and cloth, for bearing pivots in watches, for electronics, and the finer specimens as gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garnet"@en .

aat:300011098 a skos:Concept ;
    skos:definition "Naturally occurring crystalline form of carbon dimorphous with diamond. Graphite has a layered structure that consists of rings of six carbon atoms arranged in widely spaced horizontal sheets, and thus crystallizes in the hexagonal system, in contrast to the same element crystallizing in the octahedral or tetrahedral system as diamond, resulting in very different characteristics in each. Graphite is opaque, soft, greasy to the touch, and iron black to steel gray in color; it occurs as crystals, flakes, scales, veins, bedded masses, or disseminations in metamorphic rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphite"@en .

aat:300011099 a skos:Concept ;
    skos:definition "Naturally occurring soft white mineral that is commonly used as a retarding agent in portland cement, as a core in sheets of wallboard, as a white pigment, in grounds for paintings, and is the main component of alabaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsum"@en .

aat:300011101 a skos:Concept ;
    skos:definition "Fine-grained marblelike variety of gypsum that is easy to carve but is rather fragile; it has been used as a sculpture material, ornamental building work, vases, small decorative carvings, and powdered for use as a paper filler and paint pigment called mineral white or terra alba. Alabaster is usually a translucent white or pink but may also be a muted red, yellow or gray. It is soft and can be scratched slightly with a fingernail. It also dissolves slowly in wet environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alabaster"@en .

aat:300011110 a skos:Concept ;
    skos:definition "Black opaque mineral composed of ferro-ferric oxide that is strongly magnetic; a common mineral in large deposits in Sweden, Norway, the Urals, Italy, Switzerland, Australia, Brazil, United States, and Canada. Magnetite is brittle and fractures unevenly. When it possess a polarity, magnetite is called lodestone. Magnetite was used in antiquity for jewelry, amulet beads, seals and as a substitute for black pearls. It is also used as a black pigment in paints, linoleum, ceramic glazes, and glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetite"@en .

aat:300011111 a skos:Concept ;
    skos:definition "A mineral with the same composition as pyrite (fool's gold) but differing in crystal structure. It can be faceted like a gemstone; it was popular in the 1920s to 1930s, usually set in sterling silver. It is commonly found as nodules and concretions in sedimentary rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marcasite"@en .

aat:300011112 a skos:Concept ;
    skos:definition "A common yellowish isometric mineral made of iron disulfide. It is reflective and its sparkling nuggets have been mistaken for gold. Pyrite may be incorporated into fossil deposits. Under conditions of high humidity the mineral may oxidize and form iron sulfate. This oxidation product expands and causes fossil specimens to fracture and crumble in a condition known as \"pyrite disease,\" or \"pyrite decay.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrite"@en .

aat:300011115 a skos:Concept ;
    skos:definition "A brownish mineral of the calcite group; common in bed nodules of clay and ironstone, and is an iron ore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siderite"@en .

aat:300011119 a skos:Concept ;
    skos:definition "General term for several varieties of hard and soft, fine-grained rock composed of jadeite, nephrite, serpentine, or other mineralogically related materials; usually having a color ranging from dark green to green-white. Jade takes a high polish and has been used since prehistoric times for jewelry, small utensils, carvings, vases, and other ornamental objects. Some processing techniques have been used to enhance the color of inferior stones: B-jade has been bleached to remove brown stains, while C-jade has been impregnated with resins to increase its translucency; A-jade is untreated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jade"@en .

aat:300011120 a skos:Concept ;
    skos:definition "An exceptionally tough, compact, fine-grained greenish or bluish mixture of actinolite and tremolite; it is a calcium magnesium silicate with traces of chromium and nickel, which produce its color. With jadeite, it is one of two minerals commonly called \"jade.\" Nephrite has an oily, lustrous appearance when polished and is sometimes variegated in color that can incorporate white, yellow, brown, gray, and black. Nephrite has been used since Neolithic times for small utensils, decorative carvings and jewelry. If heated to about 1025 C, nephrite changes mineral forms to diopside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nephrite"@en .

aat:300011121 a skos:Concept ;
    skos:definition "Mineral consisting of sodium aluminum silicate, usually containing small amounts of iron, calcium, and magnesium. It constitutes the more valuable variety of jade, ranging in color from pale to dark green that is commonly called jade; neprhite is the other mineral called \"jade.\" Jadeite is highly valued for its translucent glassy appearance; it is found chiefly in China, Myanmar (formerly Burma), and Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jadeite"@en .

aat:300011122 a skos:Concept ;
    skos:definition "A granular crystalline rock composed essentially of lazurite and calcite. This is an old name for gem-variety lazurite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapis lazuli"@en .

aat:300011123 a skos:Concept ;
    skos:definition "A green mineral composed of basic copper carbonate occurring naturally with the blue copper carbonate mineral called azurite, with malachite being the more abundant of the two.The compact green variety has alternate irregular bands of light and dark green, and is used mainly for table tops, vases, veneer, and some jewelry. Both malachite and azurite have been used as gemstones and paint pigments since before 3000 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malachite"@en .

aat:300011124 a skos:Concept ;
    skos:definition "Group of monoclinic minerals with perfect basal cleavage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mica"@en .

aat:300011125 a skos:Concept ;
    skos:definition "A colorless or pale brown mica; it has superior dielectric properties and is valued for radio capacitators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muscovite"@en .

aat:300011126 a skos:Concept ;
    skos:definition "A magnesium-rich mineral of the mica group; it is usually yellowish brown to brownish red and usually occurs in crystalline limestone as a result of dedolomitization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phlogopite"@en .

aat:300011128 a skos:Concept ;
    skos:definition "A group of micaceous clay minerals closely related to chlorite and montmorillonite; vermiculite is derived from the alteration of biotite and phlogopite in the zone of weathering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vermiculite"@en .

aat:300011129 a skos:Concept ;
    skos:definition "A mineral or mineral gel consisting of packed spheres of silica. Used as a gemstone, it is characterized by a flashing mixture of colors when light falls on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opal"@en .

aat:300011131 a skos:Concept ;
    skos:definition "The dioxide form of silicon, SiO2, occurring in quartz sand, flint, and agate. It is used chiefly in its prepared white powder form in the manufacture of glass, ceramics, and abrasives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silica"@en .

aat:300011132 a skos:Concept ;
    skos:definition "The most common variety of silica; commonly occurs as crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz"@en .

aat:300011133 a skos:Concept ;
    skos:definition "Purple or bluish-violet varieties of quartz, that have gathered or mined since Neolithic times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amethyst"@en .

aat:300011134 a skos:Concept ;
    skos:definition "A translucent, quartz usually with a waxy luster, having tiny microscopic crystals that are sometimes arranged in slender fibrous bands; occurring in various colors, usually red, blue, or green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalcedony"@en .

aat:300011135 a skos:Concept ;
    skos:definition "Cryptocrystalline chalcedony, showing a variegated banded structure and waxy luster. Agate bands are caused by the deposition of successive mineral layers from solution and may be either straight, wavy, or concentric. Agate is slightly harder than quartz. It has been gathered or mined since Neolithic times. It may distinguished from onyx by the parallel structure of the bars in onyx."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agate"@en .

aat:300011136 a skos:Concept ;
    skos:definition "A variety of chacedony having parallel, alternating bands of chalcedony and opal. The bands are usually colored black and white or reddish and white. In ancient times, the stones were available in Egypt, Arabia, and India. Onyx was often used as a gemstone in the production of cameos and intaglios. Onyx is also used as an ornamental building stone and for decorative items such as table tops, lamp bases, and small boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onyx"@en .

aat:300011137 a skos:Concept ;
    skos:definition "A gem variety of chalcedony with parallel layers of sard and a mineral of another color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sardonyx"@en .

aat:300011138 a skos:Concept ;
    skos:definition "Semiprecious stone composed of dark green chalcedony with flecks of red jasper that were thought to resemble drops of blood. Bloodstones, when submerged in water, give a reddish reflection. They were occasionally used in ancient times as cylinder seals, during the Middle Ages for sculptures representing the flagellation of Christ, and currently as gemstones in jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bloodstone"@en .

aat:300011141 a skos:Concept ;
    skos:definition "Fine-grained, dense sedimentary rock consisting of interlocking crystals of quartz approximately 30 microns in diameter. Chert and its varieties, such as flint, are non-gem varieties of cryptocrystalline-granular quartz. These stones chip very easily and thus may be fashioned into tools with a sharp edge; they are also used for building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chert"@en .

aat:300011142 a skos:Concept ;
    skos:definition "An apple-green variety of chalcedony valued as a gem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrysoprase"@en .

aat:300011143 a skos:Concept ;
    skos:definition "The dark gray or black variety of chert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flint"@en .

aat:300011147 a skos:Concept ;
    skos:definition "Small sharp pieces of flint for use in a flintlock of a firearm, to produce sparks to ignite the priming powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunflints"@en .

aat:300011149 a skos:Concept ;
    skos:definition "A velvety-black variety of cryptocrystalline quartz, siliceous shale, or similar substance used by jewelers for testing the purity of precious metal, especially gold, by the streak left on the stone when rubbed with the metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "touchstone"@en .

aat:300011151 a skos:Concept ;
    skos:definition "Any red chert or chalcedony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jasper"@en .

aat:300011152 a skos:Concept ;
    skos:definition "A transparent variety of the silica mineral quartz that is valued for its clarity and total lack of color or flaws. Vessels and spheres have been carved from large crystals since ancient times, and the application of the word \"crystal\" to fine glassware derives from this practice. Quartz crystal formerly was used extensively as a gemstone, usually brilliant-cut, although it has now been largely replaced by glass; rhinestones originally were quartz pebbles found in the Rhine River. The optical properties of quartz crystal led to its use in lenses and prisms; its piezoelectric properties are used to control the oscillation of electrical circuits. Its physical properties are those of quartz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz crystal"@en .

aat:300011154 a skos:Concept ;
    skos:definition "A quartz mineral that contains shiny flecks of mica. Aventurine is usually green but can also be orange or reddish-brown. It is sometimes used as an inexpensive alternative to jade. Most aventurine comes from Russia, India, and Brazil. A synthetic imitation, \"aventurine glass,\" is used for costume jewelry under the name \"goldstone.\" Aventurine is also sometimes incorrectly called \"Chinese jade\" or \"Indian jade.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aventurine"@en .

aat:300011155 a skos:Concept ;
    skos:definition "A pink variety of quartz used as a gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose quartz"@en .

aat:300011159 a skos:Concept ;
    skos:definition "Soft light green or gray mineral. It is used for cosmetics, paper coating, and as a filler for paints and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talc"@en .

aat:300011160 a skos:Concept ;
    skos:definition "Finely fibrous variety of talc used especially as a filler for rubber and paper and as an extender and white pigment in paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asbestine"@en .

aat:300011161 a skos:Concept ;
    skos:definition "A high grade of massive talc occurring in the Appalachian region in the United States that can be cut to shape and used for marking purposes; it is usually white in color but may be colored gray or yellow by impurities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French chalk"@en .

aat:300011162 a skos:Concept ;
    skos:definition "An aluminum silicate containing fluorine that is formed by fluorine-bearing vapours given off during the last stages of the crystallization of igneous rocks. The topaz that is valued as a gemstone occurs in prismatic crystals that are transparent and lustrous, of white (colorless), yellow, brown, pale blue, pink, red, or pale green color, found in Brazil, Mexico, Saxony, Scotland, Japan, the Ural Mountains, and elsewhere. Colorless topaz may be mistaken for diamond when brilliant cut. Colored topaz may be unstable and bleached by sunlight. It is believed that the topaz identified by modern mineralogists was unknown to ancient Greece and Rome and the writers of the Old Testament; the stone called \"topazos\" by the ancients was probably the minerals chrysolite, peridot, or yellow sapphire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topaz"@en .

aat:300011163 a skos:Concept ;
    skos:definition "A mineral that occurs usually in 3-, 6-, or 9-sided prisms vertically striated but sometimes in compact or columnar masses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourmaline"@en .

aat:300011164 a skos:Concept ;
    skos:definition "A triclinic mineral of blue, blue green, or yellowish green color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turquoise"@en .

aat:300011165 a skos:Concept ;
    skos:definition "Mineral which has various colors and is a common accessory mineral in siliceous igneous rocks, crystalline limestone, schists, and gneisses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zircon"@en .

aat:300011166 a skos:Concept ;
    skos:definition "A transparent red or brown variety of zircon, sometimes used as a gem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyacinth"@en .

aat:300011170 a skos:Concept ;
    skos:definition "A precious stone associated with the specific month of a person's birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birthstone"@en .

aat:300011171 a skos:Concept ;
    skos:definition "Hard stone, usually ruby and sapphire, used chiefly for bearings and impulse pins in instruments and for recording needles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial jewel"@en .

aat:300011172 a skos:Concept ;
    skos:definition "Works comprising precious or semiprecious stones or other materials such as amber or pearl, cut, polished, or otherwise dressed for ornamental purposes to be used in jewelry, seals, or amulets; distinguished from \"gemstone\" which is precious or semiprecious stone that has not been worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gems"@en .

aat:300011176 a skos:Concept ;
    skos:definition "General term for rock that has been cut, shaped, crushed, or otherwise formed for use in construction or other purposes. Includes the specific archaeological and anthropological sense of individual stones which may be decorated or ornamented and which may be used in ritual contexts. These are usually not carved or dressed, and so differ from sculptures made from stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone"@en .

aat:300011178 a skos:Concept ;
    skos:definition "Any of various crystalline or glassy rocks formed by the cooling and solidification of magma or other molten earth material. Igneous rocks comprise one of the three principal classes of rocks, the others being metamorphic and sedimentary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "igneous rock"@en .

aat:300011180 a skos:Concept ;
    skos:definition "Igneous rock containing a high percentage of silica; examples are granite and rhyolite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid igneous rock"@en .

aat:300011181 a skos:Concept ;
    skos:definition "An extrusive acid igneous rock that is sometimes partly glassy and is composed of plagioclase and quartz with biotite, hornblende, or pyroxene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dacite"@en .

aat:300011182 a skos:Concept ;
    skos:definition "A general term applied to light-colored, aphanitic acid igneous rock, composed mainly of feldspar and quartz and which may or may not contain phenocrysts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felsite"@en .

aat:300011183 a skos:Concept ;
    skos:definition "A coarse-grained igneous rock that has been subjected to metamorphic processes, formed by cooling of silica-rich magma below the surface of the earth at great depths and pressures. It is the most common intrusive acid igneous rock of the Earth's crust. Granite is commonly found on continents, but is virtually absent from the ocean basins. The term \"granite\" refers to its visible granular composition. It has a visibly crystalline texture, is usually red, whitish, or gray in color depending upon its composition, is very hard and durable, and takes a fine polish. Granite is primarily composed of feldspar, quartz, and mica along with various other minerals in varying percentages. Granite is frequently used for buildings and monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granite"@en .

aat:300011186 a skos:Concept ;
    skos:definition "An igneous rock composed of minute crystals of quartz and alkalic feldspar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microgranite"@en .

aat:300011187 a skos:Concept ;
    skos:definition "A coarse-grained igneous rock, largely granite, sometimes rich in rare elements such as uranium, tungsten, and tantalum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pegmatite"@en .

aat:300011188 a skos:Concept ;
    skos:definition "A granite which, when polished, displays markings that give the effect of being inscribed with Hebrew or cuneiform writings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic granite"@en .

aat:300011192 a skos:Concept ;
    skos:definition "A partially decomposed feldspathic granite found in China and used with clay to make oriental porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "China stone"@en .

aat:300011199 a skos:Concept ;
    skos:definition "A type of gray granite quarried in Barre, Vermont, a center of granite quarrying in the U.S. since just after the War of 1812."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barre granite"@en .

aat:300011200 a skos:Concept ;
    skos:definition "Light silver-gray granite usually from one of four areas between Bodmin Moor and Land's End in Cornwall, England, the most important quarries being between Falmouth, Camborne, and Helston."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cornish granite"@en .

aat:300011201 a skos:Concept ;
    skos:definition "A gray granite native to Wicklow, Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wicklow granite"@en .

aat:300011202 a skos:Concept ;
    skos:definition "Granite with a mineral composition that results in a pink color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pink granite"@en .

aat:300011203 a skos:Concept ;
    skos:definition "A coarse biotite granite, quarried in Milford, Massachusetts, composed mostly of light pink feldspar with additions of gray quartz and dark, greenish-black flecks of a chloritic black mica. It is very strong, takes a high polish, and has a fine and close texture, making it one of the most desirable granites quarried in the U.S. for general building as well as decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Milford granite"@en .

aat:300011204 a skos:Concept ;
    skos:definition "A pinkish-red and gray English granite that is distinguished by embedded crystals of red felspar, sometimes as long as 2 inches. There are 2 distinct shades, Light Shap and Dark Shap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shap granite"@en .

aat:300011205 a skos:Concept ;
    skos:definition "Granite with a mineral composition that results in a red color and usually a relatively coarse texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red granite"@en .

aat:300011206 a skos:Concept ;
    skos:definition "A coarse red and black stone composed of red orthoclase, gray quartz, and black tourmaline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luxullianite"@en .

aat:300011207 a skos:Concept ;
    skos:definition "A flesh red granite that is found in abundance in Minnesota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minnesota red granite"@en .

aat:300011208 a skos:Concept ;
    skos:definition "A coarse red granite quarried in Finland, characterized by unusual ovoid ringed feldspars; often used for building in northern Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rapakivi"@en .

aat:300011210 a skos:Concept ;
    skos:definition "A type of granular acid igneous rock intermediate in composition between quartz diorite and quartz monzonite, containing quartz, oligoclase or andesine, and potassium feldspar, with biotite, hornblende, or, less frequently, pyroxene, as the mafic components. Granodiorite is the intrusive equivalent of rhyodacite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granodiorite"@en .

aat:300011211 a skos:Concept ;
    skos:definition "Any of a number of extrusive acid igneous rocks, usually porphyritic and exhibiting flow lines, with phenocrysts of quartz and alkali feldspar in a glassy to cryptocrystalline groundmass; the extrusive equivalent of granite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhyolite"@en .

aat:300011212 a skos:Concept ;
    skos:definition "Igneous rocks classified according to chemical or mineralogical parameters, containing between 52 and 63% SiO2; examples are andesite and dacite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermediate igneous rock"@en .

aat:300011213 a skos:Concept ;
    skos:definition "An extrusive, usually dark grayish igneous rock consisting essentially of oligoclase or andesine feldspar with augite, hornblende, hypersthene, or biotite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "andesite"@en .

aat:300011214 a skos:Concept ;
    skos:definition "A hard, coarse-grain, black-and-white speckled, granite-like rock composed of plagioclase feldspar mixed with hornblende, biotite, and augite, sometimes with small amounts of orthoclase or quartz. Diorite was valued by the Egyptians and Sumerians for statuary and is presently used in building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diorite"@en .

aat:300011216 a skos:Concept ;
    skos:definition "Diorite containing appreciable amounts of mica. It can be used for building purposes; many Gothic churches in Brittany have been built of this rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mica diorite"@en .

aat:300011219 a skos:Concept ;
    skos:definition "Diorite containing appreciable amounts of quartz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz diorite"@en .

aat:300011220 a skos:Concept ;
    skos:definition "A phanoerocrystalline intrusive igneous rock composed mostly of alkaline feldspar with or without a smaller amount of plagioclase and without notable quartz or nepheline content. The term can also refer to a granite varietal, quarried in antiquity at Syrene in Upper Egypt, in which biotite is substituted for or accompanied by hornblende."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syenite"@en .

aat:300011221 a skos:Concept ;
    skos:definition "Igneous rocks as classified according to chemical or mineralogical parameters, having low silica and typically high iron - magnesium content; examples are gabbro and basalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basic igneous rock"@en .

aat:300011222 a skos:Concept ;
    skos:definition "A dense, hard, dark brown-to-black volcanic igneous rock, consisting of feldspar and mafic minerals such as augite or olivine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basalt"@en .

aat:300011224 a skos:Concept ;
    skos:definition "An extremely hard variety of basalt that is jet black in color with a faint steak of mottled white; was often used as a touchstone for metallurgists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di paragone"@en .

aat:300011226 a skos:Concept ;
    skos:definition "A fine-grained, compact, crystalline granular rock, consisting essentially of augite and a triclinic feldspar, with chloritic matter in varying amount, being an altered form of basalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diabase"@en .

aat:300011230 a skos:Concept ;
    skos:definition "Igneous rock similar to diorite, predominantly composed of ferromagnetic minerals with crystals visible to the eye; has the same mineral composition as basalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gabbro"@en .

aat:300011232 a skos:Concept ;
    skos:definition "A dark purplish-red rock, first quarried in ancient Egypt, containing relatively large crystals in a fine-grained igneous matrix. One of the hardest rocks, it takes a high polish and is valued as a durable sculptor's material and as a decorative architectural material. It is considered the best material for the muller and slab used for grinding artists' colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porphyry"@en .

aat:300011238 a skos:Concept ;
    skos:definition "A porphyritic rhyolite containing phenocrysts of quartz and alkali feldspar in a microcrystalline or cryptocrystalline groundmass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz porphyry"@en .

aat:300011239 a skos:Concept ;
    skos:definition "A type of quartz porphyry, local to Cornwall, England, which is usually light gray in color with a hint of buff; often used for ashlar because of its fine texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elvan"@en .

aat:300011240 a skos:Concept ;
    skos:definition "A rock, similar to diorite, composed of a compact felsitic base in which hornblende or feldspar is porphyritically developed. The celebrated red Egyptian porphyry or 'Rosso Antico' is a red antique porphyry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red antique porphyry"@en .

aat:300011244 a skos:Concept ;
    skos:definition "Igneous rock formed at great depth by crystallization of magma and/or by chemical alteration, as contrasted with volcanic rock. Typically of granitoid texture and medium- or coarse-grained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intrusive rock"@en .

aat:300011246 a skos:Concept ;
    skos:definition "Igneous rock solidified on or near the surface after being ejected explosively or extruded as lava, as contrasted with intrusive rock; characteristically finely crystalline or glassy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extrusive rock"@en .

aat:300011249 a skos:Concept ;
    skos:definition "Molten volcanic rock that issues from a volcano or fissure in the earth's surface; also, the same material after being cooled and solidified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lava"@en .

aat:300011250 a skos:Concept ;
    skos:definition "A pale gray, porous variety of the volcanic stone rhyolite; it is composed of potassium aluminum silicate with small amounts of iron and alkalis. Pumice is used as an abrasive for polishing jewelry, cleaning metals, and smoothing vellum and parchment. In its solid form it is used as an abrasive and aggregate and in its powdered form it is used as a polish and abrasive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumice"@en .

aat:300011253 a skos:Concept ;
    skos:definition "Rock formed when dislocated and rupturing solid material is explosively or aerially ejected from a volcanic vent or rock formed when solid fragments are incorporated into moving lava."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyroclastic rock"@en .

aat:300011254 a skos:Concept ;
    skos:definition "A dark, shiny glass formed in nature by the rapid cooling of lava. Obsidian is widely distributed and has been used since Paleolithic (before 3500 BCE) times for mirrors, weapons, tools, and jewelry. Obsidian is often black in color but may also be red, brown or green. It produces conchoidal fractures when cleaved. Sources of obsidian include Anatolia, Armenia, Ethiopia, Greece (Milos), Italy (Lipari, Eolie), Iceland, the U.S. (Wyoming), Mexico (Teotihuacan), Guatemala (Tikal), and Peru. Obsidian changes into pumice when it is melted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obsidian"@en .

aat:300011256 a skos:Concept ;
    skos:definition "Semitransparent, smoky-colored obsidian nodules of Arizona ore; used in Indian silver jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marekanite"@en .

aat:300011257 a skos:Concept ;
    skos:definition "A volcanic glass that contains about 75% silica and usually has a higher water content than obsidian; found in Oregon and California. Commercially, the term refers to volcanic glass that will expand or \"pop\" when heated to form a lightweight aggregate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perlite"@en .

aat:300011259 a skos:Concept ;
    skos:definition "Volcanic glass of basaltic composition from Oahu, Hawaii; it is used for making various ornamental objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tachylite"@en .

aat:300011262 a skos:Concept ;
    skos:definition "Volcanic material found in the Rhine district of Germany that is similar to pozzolan cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trass"@en .

aat:300011264 a skos:Concept ;
    skos:definition "Rock composed of the finer kinds of volcanic detritus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuff"@en .

aat:300011265 a skos:Concept ;
    skos:definition "Ash, gravel, and volcanic material that have been closely welded together to form a rock that is characteristically dark greenish gray and studded with black fragments that resemble peppercorns, hence its name. It is used for stairs and fountain bases because it becomes more consistent when wet. Susceptible to heat and frost, it is only found in great condition underground. Quarries for this rock are found near Albano and the Castle of Marino in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peperino"@en .

aat:300011267 a skos:Concept ;
    skos:definition "A type of peperino that is particularly hard and durable; quarried near Castiglione, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sperone"@en .

aat:300011269 a skos:Concept ;
    skos:definition "A lightweight, gray, volcanic tuff, used as pozzolana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "santorin"@en .

aat:300011273 a skos:Concept ;
    skos:definition "Rock, such as sandstone or limestone, formed from materials deposited as sediments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sedimentary rock"@en .

aat:300011275 a skos:Concept ;
    skos:definition "Rock, especially limestone and sandstone, containing clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argillaceous rock"@en .

aat:300011276 a skos:Concept ;
    skos:definition "Compact argillaceous sedimentary rock that is cemented by silica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argillite"@en .

aat:300011279 a skos:Concept ;
    skos:definition "Shale that is calcareous or dolomitic and is used with limestone in making portland cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marlstone"@en .

aat:300011280 a skos:Concept ;
    skos:definition "A clayey mud that has been hardened by pressure of cementation or heat with the composition and texture of shale but is much less fissile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mudstone"@en .

aat:300011281 a skos:Concept ;
    skos:definition "Argillaceous sedimentary rock formed by the compaction of clay, silt, or mud; it may be gray, red, brown, or black. It is finely laminated and weak along planes allowing the rock to split easily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shale"@en .

aat:300011282 a skos:Concept ;
    skos:definition "A shale composed wholly or chiefly of material that becomes clay after weathering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay shale"@en .

aat:300011283 a skos:Concept ;
    skos:definition "Any rock consisting chiefly of carbonate minerals such as calcite, dolomite, or siderite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbonate rock"@en .

aat:300011285 a skos:Concept ;
    skos:definition "Cemented deposits of calcium carbonate materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caliche"@en .

aat:300011286 a skos:Concept ;
    skos:definition "General name for a sedimentary rock existing in many varieties, consisting primarily of calcite or dolomite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limestone"@en .

aat:300011288 a skos:Concept ;
    skos:definition "Limestone that contains fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fossiliferous limestone"@en .

aat:300011289 a skos:Concept ;
    skos:definition "Limestone composed largely of the remains of calcium-carbonate-producing algae, or one in which such algae serve to bind together the fragments of other calcium-carbonate producers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "algal limestone"@en .

aat:300011290 a skos:Concept ;
    skos:definition "Fossiliferous limestone containing fossils of invertebrates of the phylum Bryozoa which are characterized by a branching, twiglike skeleton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bryozoa limestone"@en .

aat:300011291 a skos:Concept ;
    skos:definition "Fossiliferous limestone composed of fragments of corals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coral limestone"@en .

aat:300011298 a skos:Concept ;
    skos:definition "Fossiliferous limestone composed almost entirely of the fossil skeletal parts of crinoids, marine invertebrates of the phylum Echinodermata; crinoidal limestone is particularly plentiful in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crinoidal limestone"@en .

aat:300011300 a skos:Concept ;
    skos:definition "Fossiliferous limestone composed of shells or shell fragments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelly limestone"@en .

aat:300011302 a skos:Concept ;
    skos:definition "Fine textured white limestone quarried in the vicinity of Beer, Devon, England; used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beer stone"@en .

aat:300011304 a skos:Concept ;
    skos:definition "Oolitic limestone, quarried in the vicinity of Clipsham, Leicestershire, England; used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clipsham stone"@en .

aat:300011305 a skos:Concept ;
    skos:definition "A fossiliferous limestone composed of coarse shells or shell fragments which is loosely cemented by an infiltration of carbonate of lime; its name derives from the Spanish word for 'cockleshell.' Coquina is a detrital rock because it is formed from debris and is distinguished from coquinoid limestone which is formed in situ and is composed of shell material in a fine-grained matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coquina"@en .

aat:300011308 a skos:Concept ;
    skos:definition "Stone quarried in the vicinity of the Isle of Purbeck peninsula, Dorset, England; used primarily as a building stone. It is actually a hard semi-metamorphosed limestone formed from the shells of snails. Given that the stone is hard enough to take a fine polish it is called \"Purbeck marble,\" even though it is not fully metamophosed marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Purbeck marble"@en .

aat:300011310 a skos:Concept ;
    skos:definition "Rock consisting of small round grains that are cemented together and consist usually of calcium carbonate, but are sometimes of silica or iron oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oolite"@en .

aat:300011313 a skos:Concept ;
    skos:definition "A light tan-gray or nearly white oolitic limestone quarried in Colbert County, Alabama that contains large isolated shells and other fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alabama limestone"@en .

aat:300011314 a skos:Concept ;
    skos:definition "An oolitic limestone, quarried in Alabama, that is highly valued as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bangor limestone"@en .

aat:300011315 a skos:Concept ;
    skos:definition "Limestone from Arkansas, gray or cream colored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Batesville marble"@en .

aat:300011316 a skos:Concept ;
    skos:definition "The general name for oolitic limestone found extensively in southwestern England, particularly near Bath, hence its name. It is medium or fine-grained and its color ranges from gray to cream. Bath stone has been widely used since the Roman occupation of Britain and was especially popular for English ecclesiastical architecture of the thirteenth, fourteenth, and fifteenth centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bath stone"@en .

aat:300011318 a skos:Concept ;
    skos:definition "A fine-grained French oolitic limestone that is cream in color and easily carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caen stone"@en .

aat:300011321 a skos:Concept ;
    skos:definition "A noncrystalline massive rock with aggregate filler and a matrix of 98% calcium carbonate in gray and buff colors; it is an oolitic limestone with small round grains resembling fish roe. Almost half of all the limestone used in the United States in block form is Indiana limestone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indiana limestone"@en .

aat:300011323 a skos:Concept ;
    skos:definition "Oolitic limestone quarried in the vicinity of Ketton, Leicestershire, England; used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ketton stone"@en .

aat:300011324 a skos:Concept ;
    skos:definition "An oolitic limestone widely used for building in England, particularly in London; it is quarried on the Isle of Portland, off the coast of England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portland stone"@en .

aat:300011326 a skos:Concept ;
    skos:definition "Oolitic limestone quarried in the vicinity of Weldon, Northhamptonshire, England; used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Weldon stone"@en .

aat:300011327 a skos:Concept ;
    skos:definition "A coarse-grained limestone composed mainly of cemented pisoliths, which are pea-sized accretionary bodies, often formed of calcium carbonate, that may have been produced by a biochemical algal-encrustation process; pisoliths are larger and less regular in form than oöliths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pisolitic limestone"@en .

aat:300011329 a skos:Concept ;
    skos:definition "A dense, crystalline or microcrystalline limestone that was formed by the evaporation of river or spring waters. It is named after Tivoli, Italy (\"Tibur\" in Latin), where large deposits occur, and it is characterized by a light color and the ability to take a good polish. It is typically banded, due to the presence of iron compounds or other organic impurities. It is often used for walls and interior decorations in public buildings. It is distinguished from \"tufa\" by being harder and stronger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travertine"@en .

aat:300011337 a skos:Concept ;
    skos:definition "A compact variety of calcite that has dark layers of impurities and polishes to a high gloss, resembling onyx in appearance. It is typically used as a decorative or architectural material or for small ornamental objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onyx marble"@en .

aat:300011339 a skos:Concept ;
    skos:definition "Onyx marble quarried in the vicinity of Tabriz, North Western Iran. It is used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tabriz marble"@en .

aat:300011341 a skos:Concept ;
    skos:definition "Limestone containing 10 to 50 percent clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argillaceous limestone"@en .

aat:300011342 a skos:Concept ;
    skos:definition "Limestone containing silica and alumina and yielding a lime that will harden under water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic limestone"@en .

aat:300011344 a skos:Concept ;
    skos:definition "Limestone that is rich in carbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbonaceous limestone"@en .

aat:300011346 a skos:Concept ;
    skos:definition "Limestone containing the combined carbonate of lime and magnesium, and frequently used for building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesian limestone"@en .

aat:300011348 a skos:Concept ;
    skos:definition "A type of limestone having calcium carbonate content approaching 45%; employed as a flux in melting iron, as a lining for basic steel furnaces, for the production of magnesium metal, for filtering, and as a construction stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolostone"@en .

aat:300011349 a skos:Concept ;
    skos:definition "An exceedingly fine and even-bedded magnesian limestone, thinly stratified, quarried in the vicinity of Solnhofen, Bavaria, Germany; widely used in lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solnhofen stone"@en .

aat:300011353 a skos:Concept ;
    skos:definition "Argillaceous limestone that is red or rusty in color due to the presence of ferric oxide, the quantity of which may be quite small."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferruginous limestone"@en .

aat:300011354 a skos:Concept ;
    skos:definition "Limestone that is rich in silica, particularly as free silica as opposed to silicates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siliceous limestone"@en .

aat:300011359 a skos:Concept ;
    skos:definition "A hard, coarse, rubbly or shelly sedimentary rock that weathers with a rough irregular surface, such as a flaggy sandstone or limestone; used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rag"@en .

aat:300011361 a skos:Concept ;
    skos:definition "Oolitic limestone quarried in the vicinity of Barnack, Cambridgeshire, England; used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barnack stone"@en .

aat:300011363 a skos:Concept ;
    skos:definition "A soft, friable, earthy stone of light gray to olive color, used as an abrasive for metal and wood finishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rottenstone"@en .

aat:300011365 a skos:Concept ;
    skos:definition "A brecciated limestone that, when cut and polished, gives a mosaic affect suggesting the appearance of ruins or ruined buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruin marble"@en .

aat:300011372 a skos:Concept ;
    skos:definition "Limestone that is streaked or marked with a different color or colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variegated limestone"@en .

aat:300011374 a skos:Concept ;
    skos:definition "Variously defined limestones, occurring in Egypt and the Peloponnesus and extensively used as building materials by the ancient Greeks; apparently included several materials, such as tufa, travertine, fossiliferous limestone, and onyx marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poros"@en .

aat:300011376 a skos:Concept ;
    skos:definition "A consolidated sedimentary rock, consisting of sand grains united with a natural cementing material; the most common sand in sandstone contains quartz, with considerable feldspar, lime, mica, and clayey matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandstone"@en .

aat:300011380 a skos:Concept ;
    skos:definition "A tough, gritty sandstone used for building, found in Yorkshire and other areas of England; it is the principal stone of the Southern Pennines, the heart of the gritstone region. It is characterized by the angularity and large size of its quartz grains. There are many varieties of gritstone, some of which are quite strong. It was quarried by the Romans, was in use again before the Norman Conquest, and continues to be used in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gritstone"@en .

aat:300011382 a skos:Concept ;
    skos:definition "A block of close-grained sandstone usually used for rubbing down furniture and concrete work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holystone"@en .

aat:300011383 a skos:Concept ;
    skos:definition "An indurated silt with the texture and composition of shale but without its fine lamination or fissility; it is a massive mudstone in which silt predominates over clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siltstone"@en .

aat:300011385 a skos:Concept ;
    skos:definition "Sandstone composed of clay minerals, especially sedimentary materials such as marl and shale; it emits a peculiar earthy odor when breathed upon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argillaceous sandstone"@en .

aat:300011389 a skos:Concept ;
    skos:definition "A dark bluish gray sandstone quarried on the west side of the Catskill Mountains near the Delaware River (formerly North River) in New York. In the 19th century, North River bluestone was used for sidewalks and curbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North River bluestone"@en .

aat:300011390 a skos:Concept ;
    skos:definition "A bluestone that is similar to Hudson bluestone and other bluestones from New York; it is characterized by a fine, compact texture and a dark blue-gray color. It is considered one of the most valuable stones found in Wyoming for building and flagging purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wyoming Valley stone"@en .

aat:300011392 a skos:Concept ;
    skos:definition "Homogenous sandstone with a cement or matrix of calcium carbonate which binds together the quartz particles of which sandstone is mainly composed. It splits almost equally well in both directions and is easily worked but disintegrates upon exposure. Pure calcareous sandstone is white or cream in color; colors are due to impurities: yellow and red colors are due to the presence of iron oxides; green from glauconite; and black from manganese dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcareous sandstone"@en .

aat:300011395 a skos:Concept ;
    skos:definition "Calcareous sandstone quarried in the vicinity of Reigate, Surrey, England; used primarily as a building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reigate stone"@en .

aat:300011396 a skos:Concept ;
    skos:definition "A sandstone containing 10 to 25% feldspar that is intermediate between a quartz sandstone and an arkosic sandstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feldspathic sandstone"@en .

aat:300011398 a skos:Concept ;
    skos:definition "A soft sandstone containing red iron oxide, having a reddish-brown color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferruginous sandstone"@en .

aat:300011402 a skos:Concept ;
    skos:definition "A fine grained ferruginous sandstone quarried in Arizona that can be buff, brown, or pink in color; it is one of the most common and inexpensive sedimentary stones used as flagstone. It is strong, abrasion resistant, and has a natural non-slip surface, making it an exceptional flooring material. It is colorfast and can be used indoors or outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arizona flagstone"@en .

aat:300011404 a skos:Concept ;
    skos:definition "Stone of English origin consisting of fossils cemented together with lime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portland sandstone"@en .

aat:300011405 a skos:Concept ;
    skos:definition "A fine-grained red, reddish-brown, and gray sandstone from Seneca Creek, Maryland; it contains coarse- to fine-grained angular quartz as well as some feldspar and mica fragments. It is fairly easy to carve but darkens and hardens when exposed to air, making it one of the most durable building stones. Seneca sandstone was extremely popular in Washington, D.C. during the 'brownstone era' of about 1840 to 1880; the original Smithsonian Institution building, for example, is made of Seneca sandstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seneca sandstone"@en .

aat:300011406 a skos:Concept ;
    skos:definition "Sandstone containing mica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micaceous sandstone"@en .

aat:300011407 a skos:Concept ;
    skos:definition "Sandstone that is rich in silica, particularly as free silica as opposed to silicates; the silica characterizes the cement or matrix which binds together the quartz particles of which sandstone is mainly composed. Pure siliceous sandstone is chemically inert, making it able to withstand a smokey environment; it is therefore a popular building stone in industrial areas. It is also hard and durable but difficult to work. Pure siliceous sandstone is white or cream in color; colors are due to impurities: yellow and red colors are due to the presence of iron oxides; green from glauconite; and black from manganese dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siliceous sandstone"@en .

aat:300011410 a skos:Concept ;
    skos:definition "A stone from Ohio, containing up to 95% silica with 4% aluminum oxide, and colored gray and buff with iron oxides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amherst sandstone"@en .

aat:300011411 a skos:Concept ;
    skos:definition "A brown to light-gray siliceous sandstone from Aquia Creek in Stafford County, Virginia. It contains rounded, coarse to fine grains of quartz as well as scattered pebbles and clay pellets as big as 1 inch in diameter; it splits easily in any desired direction. Aquia Creek sandstone was one of the important building stones in early Washington, D.C."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aquia Creek sandstone"@en .

aat:300011413 a skos:Concept ;
    skos:definition "An easily worked, fine-grained siliceous sandstone from Wisconsin that is buff or cream in color. Like many varieties of sandstone, it is soft when first quarried but gradually hardens as its moisture evaporates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dunville sandstone"@en .

aat:300011417 a skos:Concept ;
    skos:definition "A siliceous sandstone, from Saint Lawrence County in New York, containing a small amount of iron oxide, giving it its red or reddish-brown color. Although soft enough to work economically when first quarried, it becomes incredibly hard upon exposure, making it an incredibly durable building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Potsdam sandstone"@en .

aat:300011418 a skos:Concept ;
    skos:definition "A siliceous sandstone from Derbyshire, England; it is also considered a gritstone, specifically a Darley Dale gritstone. It is even-grained and exceedingly hard, making it an excellent choice for ashlar and paving work. Its silica content is so high, however, that trade unions have been known to ban its use owing to the danger of silicosis; whenever possible, Stancliffe sandstone is now only worked by wet methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stancliffe sandstone"@en .

aat:300011420 a skos:Concept ;
    skos:definition "Rock characterized by, consisting of, or producing concretions; concretions are hard, compact aggregates of mineral matter, subspherical or irregular in shape, formed by precipitation from water solution around a nucleus, such as a shell or bone, in a sedimentary or pyroclastic rock. Concretions are generally different from the rock in which they occur, and represent a concentration of some minor constituent of that rock. Concretionary stones include flint, chert, and nodules of impure limestone which sometimes occur in clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concretionary stone"@en .

aat:300011422 a skos:Concept ;
    skos:definition "A large, generally spheroidal concretion, usually made of impure limestone or clay ironstone, having polyhedral blocks that are internally cemented together by crystalline minerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "septarium"@en .

aat:300011423 a skos:Concept ;
    skos:definition "Sedimentary rock composed of a significant amount of rounded or angular fragments coarser than sand grains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rudaceous rock"@en .

aat:300011425 a skos:Concept ;
    skos:definition "A coarse-grained dastic rock, composed of angular broken rock fragments held together by a mineral cement or a fine-grained matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breccia"@en .

aat:300011426 a skos:Concept ;
    skos:definition "A striking breccia quarried in the Blue Ridge Mountains in Maryland and Virginia; it consists mostly of limestone, quartz pebbles, and multicolored fragments ranging from sand grains to cobbles, all cemented together in a calcareous matrix. It can be extremely difficult to work as the hard pebbles tend to break away from the softer matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Potomac breccia"@en .

aat:300011430 a skos:Concept ;
    skos:definition "Elastic sedimentary rock composed of rounded fragments varying from small pebbles to large boulders in a cement of calcareous material, iron oxide, silica, or hardened clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conglomerate"@en .

aat:300011434 a skos:Concept ;
    skos:definition "A coarse, pebbly, or gritty rock found in certain areas of southern and eastern England; it contains a great deal of iron oxide and is therefore always some shade of brown. It hardens upon exposure but it does not weather well and is not considered a good building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carstone"@en .

aat:300011437 a skos:Concept ;
    skos:definition "Rocks that result from the alteration of pre-existing rocks in response to changing environmental conditions, such as variations in temperature, pressure, and mechanical stress, and the addition or subtraction of chemical components. The pre-existing rocks may be igneous, sedimentary, or other metamorphic rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metamorphic rock"@en .

aat:300011438 a skos:Concept ;
    skos:definition "Metamorphic rock, commonly rich in quartz and feldspar with a banded and foliated texture comprising bands of light colored minerals that alternate with bands of dark colored minerals. It is composed of mica, quartz, and schist, with additional iron, magnesium and silicates. It is formed at temperatures above 550 degrees Centigrade. Gneiss is similar to granite in composition and may be classified as a type of granite, but it is produced by the alteration of igneous and sedimentary deposits, whereas granite is formed of igneous deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gneiss"@en .

aat:300011442 a skos:Concept ;
    skos:definition "Fine-grain silicate rock produced by contact metamorphism, where the rock has been baked and indurated by the heat of intrusive granitic masses and have been rendered massive, hard, splintery, and in some cases exceedingly tough and durable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornfels"@en .

aat:300011443 a skos:Concept ;
    skos:definition "A metamorphic, hard, dense, crystalline stone primarily composed of calcium carbonate; it is limestone or dolomite that has been metamorphosed with heat and pressure. Pure calcite marble is white, but impurities produce a wide variety of coloring and patterns. It is finely grained and polishes to a smooth, high gloss. It is used primarily for statuary and buildings. Marble has been quarried from sites around the world since at least the 7th century BCE. The term can also refer more broadly to any crystallized carbonate rock, including true marble and certain types of limestone, that will take a polish and can be used for architectural and ornamental purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marble"@en .

aat:300011451 a skos:Concept ;
    skos:definition "Marble composed of angular fragments imbedded in a finer ground or paste; among the best known are the Egyptian breccia, many Numidian marbles, and the breccias of Gragnano and Seravezza, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breccia marble"@en .

aat:300011453 a skos:Concept ;
    skos:definition "A breccia marble containing red, pink, white, or yellow fragments in a coral-colored matrix; it was notably used for the interior columns of the Temple of Mars Ultor in Rome although few other specific examples are known and its ancient quarry has not been located."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breccia corallina"@en .

aat:300011454 a skos:Concept ;
    skos:definition "A type of breccia marble, recognizable for the many chips of chalky white which go against the grain of the marble and look like wet paint. Its name may derive from its resemblance to a paste of sugar plums or it may derive from 'Semo Sancus,' a Sabine divinity, to whom statues may have been carved out of this material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breccia a semesanto"@en .

aat:300011455 a skos:Concept ;
    skos:definition "A breccia marble that is typically grayish violet with striking bright red or golden yellow streaks as well as oblong white, yellow, or red fragments. It originates from the island of Scyrus and is named for Septimius Bassus, who in antiquity had a villa sumptuously decorated with it on the Via Tusculana in Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breccia di Settebasi"@en .

aat:300011456 a skos:Concept ;
    skos:definition "A pink and brown breccia marble, the name of which derives from an old Italian name for a harlequin costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breccia traccagnina"@en .

aat:300011457 a skos:Concept ;
    skos:definition "A coarse breccia marble of sharply angular red, pink, and white fragments in a dull red-brown matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breche violette marble"@en .

aat:300011458 a skos:Concept ;
    skos:definition "A breccia marble consisting of cream-colored pebbles on a lilac ground tinged with yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broccatellone"@en .

aat:300011459 a skos:Concept ;
    skos:definition "A coarse breccia marble containing fragments of pophyry, basalt, quartz, and granite in a greenish or purplish ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian breccia marble"@en .

aat:300011460 a skos:Concept ;
    skos:definition "A coarse breccia marble consisting of white and pink fragments in a darker matrix; it comes from Serravezza, Italy and closely resembles Egyptian breccia marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mischio marble"@en .

aat:300011461 a skos:Concept ;
    skos:definition "A breccia marble that consists of large pebbles of black, green, pink, red, gray, purple and bronze; it is noted for its strongly pronounced colors. It is from the Greek island of Chios and so has nothing to do with Africa; its name is due to its dusky coloration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Affricano"@en .

aat:300011462 a skos:Concept ;
    skos:definition "A breccia marble from Lydia in present-day Turkey; its color ranges from bright or brownish red to various hues of purple and it typically contains white pebbles or spots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosso brecciato"@en .

aat:300011464 a skos:Concept ;
    skos:definition "A variegated French breccia marble, usually with gray, red, or yellow predominating, quarried near Sarrancolin in the Pyrenees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarrancolin marble"@en .

aat:300011468 a skos:Concept ;
    skos:definition "Tradename of a coarsely mottled marble from Malletts Bay on Lake Champlain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lyonaise marble"@en .

aat:300011469 a skos:Concept ;
    skos:definition "A marble containing fossil madreporian corals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madrepore marble"@en .

aat:300011470 a skos:Concept ;
    skos:definition "A Chinese marble with markings created by fossil content; when the stone is cut sectionally, the markings resemble the shape of a pagoda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pagoda stone"@en .

aat:300011472 a skos:Concept ;
    skos:definition "A dark, gray brown marble, closely packed with fossil shells, which when polished gives a brilliant gleam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell marble"@en .

aat:300011475 a skos:Concept ;
    skos:definition "A handsome shell marble from Tortosa, Spain, where it is still quarried. Its predominant color ranges from a reddish lilac to yellow, the color being dependent on the quantity of embedded snails: the yellow represents the mollusk and the lilac represents the seabed in which it sank. Broccatello was used extensively as surface ornamentation in churches in Rome and Naples, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broccatello"@en .

aat:300011477 a skos:Concept ;
    skos:definition "A shell marble quarried near Plattsburg, New York."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lepanto marble"@en .

aat:300011478 a skos:Concept ;
    skos:definition "A group of shell marbles, the name deriving from 'lumaca,' the Italian word for snail. There are both ancient and modern varieties; the best known modern lumachella comes from Tirol in Austria and is dark gray-brown with shells retaining their pearly lining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumachella"@en .

aat:300011480 a skos:Concept ;
    skos:definition "A shell marble which is usually either light purple or reddish brown in color. Its name means 'peacock's eye' in Italian, the eye referring to the presence of petrified oyster shells. There are two columns made of this marble in the Vatican Library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occhio di pavone"@en .

aat:300011481 a skos:Concept ;
    skos:definition "A shell marble from Sussex, England that is predominantly gray with occasional green or blue tinges. Its old local name, 'winklestone,' refers to the abundance of small snail shells (winkles) embedded in the marble. Used to ornament churches in the Middle Ages, it remained popular for centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sussex marble"@en .

aat:300011482 a skos:Concept ;
    skos:definition "Marble of the purest white and of finely crystalline form used in architecture and sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statuary marble"@en .

aat:300011484 a skos:Concept ;
    skos:definition "Marble that is predominantly black in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black marble"@en .

aat:300011485 a skos:Concept ;
    skos:definition "A dense, hard marble from Belgium, considered the best black marble for carving due to its deep color and lack of veins and streaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgian black marble"@en .

aat:300011487 a skos:Concept ;
    skos:definition "A fine, black marble from Attica, prized in ancient Greece, especially for friezes and interior decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eleusinian marble"@en .

aat:300011488 a skos:Concept ;
    skos:definition "A compact marble found in counties Galway and Kilkenny in Ireland that is considered one of the best black marbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irish black marble"@en .

aat:300011490 a skos:Concept ;
    skos:definition "Egyptian marble colored black by carbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lucullite"@en .

aat:300011492 a skos:Concept ;
    skos:definition "An ornamental black marble found in fragments among Roman ruins and believed to have come from Laconia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nero antico"@en .

aat:300011494 a skos:Concept ;
    skos:definition "A jet black marble with irregular white veins, occurring in Virginia, that is considered the best American black marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rockingham royal black marble"@en .

aat:300011495 a skos:Concept ;
    skos:definition "A deep blue-black marble with short white veins that is found in Saint Anne, Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Anne marble"@en .

aat:300011498 a skos:Concept ;
    skos:definition "An Italian marble commonly having a dark gray or bluish ground traversed by veins and occurring in its principal varieties in the neighborhood of Carrara and Corsica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bardiglio"@en .

aat:300011499 a skos:Concept ;
    skos:definition "A type of bardiglio marble in which the veining bears a resemblance to flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bardiglio fiorito"@en .

aat:300011500 a skos:Concept ;
    skos:definition "A type of bardiglio marble that is saccharoidal and gray or bluish in color; it is considered inferior to bardiglio fiorito."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bardiglio 'scuro"@en .

aat:300011501 a skos:Concept ;
    skos:definition "Marble, generally from North Africa, that is light and dark gray in large patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigio antico"@en .

aat:300011503 a skos:Concept ;
    skos:definition "A dusty gray variety of marble from the island of Marmara Adasi, Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigio e nero antico"@en .

aat:300011505 a skos:Concept ;
    skos:definition "Marble, generally from southern France, that is characterized by yellowish brown streaks and impure black and white waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigio e nero di francia"@en .

aat:300011507 a skos:Concept ;
    skos:definition "Marble, from the island of Melos on the Nile, that is dusty black in color with faint streaks and spots of gray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigio morato"@en .

aat:300011509 a skos:Concept ;
    skos:definition "A gray and white marble that is similar in appearance to Formosa marble and is from the same region in Germany; it is, however, generally somewhat lighter in color than Formosa marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bougard marble"@en .

aat:300011510 a skos:Concept ;
    skos:definition "A gray and white mottled marble, sometimes also with red blotches, from Nassau, Germany. It often contains a large quantity of fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Formosa marble"@en .

aat:300011511 a skos:Concept ;
    skos:definition "A marble of Northern Italy having a coarse network of dark veins on a white or grayish ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parmazo marble"@en .

aat:300011512 a skos:Concept ;
    skos:definition "Marble with a mineral composition resulting in a predominantly green color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green marble"@en .

aat:300011513 a skos:Concept ;
    skos:definition "A predominantly pale green marble with white markings that is quarried near Clifden in County Galway, Ireland. A metamorphosed dolomitic limestone, it is considered to be one of two true marbles native to the British Isles, the other being Iona marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Connemara marble"@en .

aat:300011514 a skos:Concept ;
    skos:definition "A predominantly pale green marble with white markings that is quarried on the island of Iona. A metamorphosed dolomitic limestone, it is considered to be one of two true marbles native to the British Isles, the other being Connemara marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iona marble"@en .

aat:300011520 a skos:Concept ;
    skos:definition "Marble with a mineral composition resulting in a predominantly pink color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pink marble"@en .

aat:300011522 a skos:Concept ;
    skos:definition "A fine pink marble, suitable for sculpture, of which a number of varieties exist. Tennessee marbles are generally harder and more compact than other American marbles, making them more suitable for outdoor use but also making them more difficult to carve and polish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tennessee Pink marble"@en .

aat:300011523 a skos:Concept ;
    skos:definition "Marble with a mineral composition resulting in a predominantly red color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red marble"@en .

aat:300011524 a skos:Concept ;
    skos:definition "A purplish red marble, sometimes with white spots, found in the valley of Barouse and other areas in the French Pyrenees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Griotte marble"@en .

aat:300011526 a skos:Concept ;
    skos:definition "A compact marble of brilliant red color blotched with white and found in Montagne Noir and other regions in the Pyrenees. Resembles griotte marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Languedoc marble"@en .

aat:300011528 a skos:Concept ;
    skos:definition "Reddish-brown to cherry red limestone with gray, blue and red streaks and veins or spots, derived primarily from the province of Hainaut, and used extensively as material for furniture and architecture in Paris in the 16th-18th centuries, and notably at Versailles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rouge de Rance"@en .

aat:300011531 a skos:Concept ;
    skos:definition "A red marble often used in antiquity; it is found in Cynopolis and Damarestica in Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rouge antique marble"@en .

aat:300011533 a skos:Concept ;
    skos:definition "Marble that is streaked or marked with a different color or colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variegated marble"@en .

aat:300011535 a skos:Concept ;
    skos:definition "A white marble from Cappadocia, Turkey that has light yellow veins over which there are hair lines of a darker shade of yellow. It can be so highly polished that it can create a reflection like a mirror; for this reason the emperor Domitian supposedly had a corridor lined with it. Little or none remains from antiquity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bianco e giallo"@en .

aat:300011539 a skos:Concept ;
    skos:definition "A marble from Portovenere and the island of Palmaria in Liguria, Italy. The best grades are dark black with evenly distributed dull golden veins while the inferior grades are brownish gray with irregular veins and spots of dull yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portor marble"@en .

aat:300011542 a skos:Concept ;
    skos:definition "A dull yellow compact marble with irregular veins and blotches of dull terracotta red; it also sometimes contains patches of white crystalline calcite. Found in Catalonia in northern Spain and in Siena, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brocatelle marble"@en .

aat:300011545 a skos:Concept ;
    skos:definition "A white marble variegated with green and gray due to layers of mica and mica-like minerals. It originates from the island of Euboea in the Aegean Sea and bears a resemblance to the cross section of an onion, hence its name, which derives from the Italian word for onion (cipolla). The term is now often applied to any crystalline white marble with greenish mica, particularly the schistose varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cipollino"@en .

aat:300011548 a skos:Concept ;
    skos:definition "The name applied to a number of Italian marbles, generally containing various hues and patterns of red and brown although other colors such as white and purple are often present. The modern species are coarse and often considered unattractive; the ancient Romans quarried cottanello of superior quality about forty miles from Rome in the Sabine hills, near the town after which the stone is named."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottanello"@en .

aat:300011549 a skos:Concept ;
    skos:definition "Variegated marble, of various shades of red, pink, and purple on a white ground-mass, quarried in ancient times principally at Epirus in Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiore di Persico"@en .

aat:300011551 a skos:Concept ;
    skos:definition "Variegated marble of light chocolate brown and white, from Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiorto marble"@en .

aat:300011555 a skos:Concept ;
    skos:definition "A marble characterized by its cloudy mixture of pure white, pale brown, lilac gray, and pink on a yellow ground; it originates from Corinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giallo tigrato"@en .

aat:300011557 a skos:Concept ;
    skos:definition "The color of this marble ranges from yellow, light brown, and pink to deep red. It originates not from Numidia proper, but from the mountains of Algeria and Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Numidian marble"@en .

aat:300011561 a skos:Concept ;
    skos:definition "A type of Numidian marble that is white or yellow with purplish veins; it resembles pavonazetto marble which has led scholars to believe the name is a corruption of 'pavonazetta.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paonazzo marble"@en .

aat:300011562 a skos:Concept ;
    skos:definition "A white or drab yellow marble with purplish veins, it was supposedly favored by the emperor Hadrian. The word pavonazzo means peacock blue, violet, or purple in Italian. The ancient marble is also known as Phrygian marble because it is believed to have come from Phrygia in Asia Minor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavonazzetto"@en .

aat:300011567 a skos:Concept ;
    skos:definition "A purplish red and white clouded stone which may come from either the island of Iasus or the island of Chios. It was supposedly favored by the emperor Claudius in antiquity and was later used in the door jambs of the Porta Santa of St. Peter's in Rome, hence its name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Porta Santa marble"@en .

aat:300011570 a skos:Concept ;
    skos:definition "A red marble with large irregular stains of flinty blue that originates from the southeast of France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosso di francia"@en .

aat:300011571 a skos:Concept ;
    skos:definition "Marble with a mineral composition resulting in a predominantly white color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white marble"@en .

aat:300011573 a skos:Concept ;
    skos:definition "An American white marble suitable for sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alabama Cream"@en .

aat:300011574 a skos:Concept ;
    skos:definition "A type of Alabama cream marble that is hard, fine-grained, and creamy white in color; similar to Madre Cream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cream Blanc"@en .

aat:300011575 a skos:Concept ;
    skos:definition "A type of Alabama cream marble that is hard, fine-grained, and creamy white in color; similar to Cream Blanc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Madre Cream"@en .

aat:300011576 a skos:Concept ;
    skos:definition "Refers to a type of marble quarried in the area around Carrara, in Tuscany, Italy. It is characterized by a fine, compact grain and varies in color from pure white to creamy white, sometimes with a bluish tinge; it is a saccharoidal rock that can appear translucent in the finer grades. It has been a favorite stone of sculptors from antiquity to the present, including Michelangelo Buonarotti. Luna marble was the name used in ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carrara marble"@en .

aat:300011577 a skos:Concept ;
    skos:definition "A fine grained, magnesium-rich white marble from Cockeysville, Maryland; it has a few pale streaks or bands which give an effect of pale gray. One of the most popular types of marble used in nineteenth-century buildings in Washington, D.C., it comprised the top two thirds of the Washington Monument as well as the monolithic columns of the Capitol building extensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cockeysville marble"@en .

aat:300011578 a skos:Concept ;
    skos:definition "A fine-grain marble quarried near Marble in Gunnison County, Colorado. Colorado Yule marble is usually pure white but can have pale gray clouds and/or creamy veins. Some regions of the marble belt have a pale blue-gray color. Colorado Yule has been used for statuary and was used for the exterior of the Lincoln Memorial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colorado Yule marble"@en .

aat:300011580 a skos:Concept ;
    skos:definition "A bluish white marble with bands of parallel gray lines that originates from Mount Hymettus, near Athens, Greece. It can sometimes be slightly green in color, due to the presence of tiny veins of talc and it gives off a fetid odor when sawn or rubbed which is why it is sometimes called onion marble or marmor cipolla. Hymettian marble was often used for both pagan and Christian sarcophagi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hymettian marble"@en .

aat:300011584 a skos:Concept ;
    skos:definition "A large-grained, buff marble quarried in Istria on the Adriatic Sea and on some of the Dalmatian islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Istrian marble"@en .

aat:300011585 a skos:Concept ;
    skos:definition "A type of white marble with a medium fine texture from Lee, Massachusetts. It can sometimes be light gray in appearance. A small band of Lee marble was used in the Washington Monument in Washington, D.C. but it proved too costly; it was, however, used to build parts of the Capitol in the 1850s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lee marble"@en .

aat:300011586 a skos:Concept ;
    skos:definition "A yellowish white marble with ashy black stains and large conspicuous crystals; it originates from the island of Lesbos in Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lesbio"@en .

aat:300011591 a skos:Concept ;
    skos:definition "A white to light gray marble with a blue or gray tint; it is coarse-grained and contains some stylolites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Missouri marble"@en .

aat:300011592 a skos:Concept ;
    skos:definition "A white marble from ancient Phrygia (present-day Turkey); it is usually ivory or milky white and sometimes contains shell fragments or faint gray or chocolate brown spots. It is rarely found in large blocks but was often used as tiny square chips in ancient mosaics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palombino"@en .

aat:300011594 a skos:Concept ;
    skos:definition "A pure white marble with transparent and flaky crystals; quarried on the island of Paros in the Cyclades, it was used by the ancient Greeks for sculpture as well as architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parian marble"@en .

aat:300011599 a skos:Concept ;
    skos:definition "A famous Greek marble quarried at Mount Pentelikon near Athens. It is pure white but may turn yellow after long exposure to air; a few miniscule veins of talc sometimes cause a faint greenish tint. It was used in antiquity as early as the 6th century BCE and continued to be popular for both sculpture and architecture; both the sculptural decoration and the architectural members of the Parthenon are made of Pentelic marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pentelic marble"@en .

aat:300011604 a skos:Concept ;
    skos:definition "A bright white and sparkling marble, sometimes with orange stains, that is quarried near Olympia in the Peloponnesus in Greece. Similar to Parian marble but with more compact texture and smaller grain, it is the only white marble that does not effervesce upon contact with nitric acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porino"@en .

aat:300011607 a skos:Concept ;
    skos:definition "A white marble with a bluish tinge from the island of Thasos in the Aegean Sea; it has a compact texture and sparkling crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tasio"@en .

aat:300011610 a skos:Concept ;
    skos:definition "A coarse-textured white marble that is nearly pure calcium carbonate; it was used to build the first 152 feet of the Washington Monument in Washington, DC. It is quarried in Texas, Maryland, not in the state of Texas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Texas marble"@en .

aat:300011611 a skos:Concept ;
    skos:definition "A coarse, variegated marble from Hawkins County, Tennessee. It is dark chocolate brown or red in color with white streaks and masses throughout and it usually contains some fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tennessee marble"@en .

aat:300011612 a skos:Concept ;
    skos:definition "A bluish white marble that is slightly peppered brown and mottled; it is from Mount Lebanon, near Tyre (modern day Sur in Lebanon)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tirio"@en .

aat:300011615 a skos:Concept ;
    skos:definition "A fine-grained white marble from Vermont that is highly valued by sculptors; it may contain bluish-gray veins or clouds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vermont white statuary marble"@en .

aat:300011616 a skos:Concept ;
    skos:definition "A white marble with black and gray blotches from Pickens County, Georgia; it is coarser than white marble from Vermont."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "White Cherokee marble"@en .

aat:300011617 a skos:Concept ;
    skos:definition "A red and brown marble variegated with white dolomitic, quarried near Winooski, Vermont."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Winooski marble"@en .

aat:300011618 a skos:Concept ;
    skos:definition "Marble that is predominantly yellow in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow marble"@en .

aat:300011619 a skos:Concept ;
    skos:definition "A compact yellow marble from Estremoz, Portugal; it somewhat resembles Siena marble but is inferior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lisbon yellow marble"@en .

aat:300011620 a skos:Concept ;
    skos:definition "Yellow and light brown marble quarried near Siena, Italy that is sought after for interior architectural use, both in the past and in the present; it is compact and often brecciated, with a waxy lustre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siena marble"@en .

aat:300011622 a skos:Concept ;
    skos:definition "Refers to a type of rock consisting of clayey, or argillaceous, slate or schist containing scales or flakes of mica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phyllite"@en .

aat:300011623 a skos:Concept ;
    skos:definition "A metamorphic rock composed largely of granular quartz which is cemented by silica forming a homogeneous mass of very high tensile and crushing strengths; especially used as a building stone, as gravel in road construction, and as aggregate in concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartzite"@en .

aat:300011624 a skos:Concept ;
    skos:definition "A natural refractory mineral used for furnace lining; in compact form it was used for furnace hearths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ganister"@en .

aat:300011626 a skos:Concept ;
    skos:definition "General term for a group rocks, the constituent minerals of which have assumed a position in more or less closely parallel layers due to metamorphic action. They comprise layers of lamellar minerals, such as mica, chlorite, talc, hornblende, and graphite. Quartz is often present as a secondary mineral. Schists are formed at high temperatures from shale, clay, or mud. They cleave easily along the foliated planes. Schists are usually named for their predominant mineral constituent, such as mica schist, hornblende schist, chlorite schist, and talc schist. The exception occurs when a schist is named for an unusual mineral constituent such as garnet schist, tourmaline schist, and glaucophane schist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schist"@en .

aat:300011627 a skos:Concept ;
    skos:definition "An ornamental mineral composed of hydrated magnesium silicate, having a greasy or silky luster, a slightly soapy feel, and a tough, conchoidal fracture. It ranges in color from yellow, green, gray, brown, or black, with crystals of green olivine and black veins or patches. Serpentine has been gathered or mined since Paleolithic times, used for decorative vessels, jewelry, building stones, and as a source of abestos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentine"@en .

aat:300011629 a skos:Concept ;
    skos:definition "A serpentinite that may be white, yellow or gray but is rarely green or red. It is so flexible that the ancient Romans were said to have used it to make shrouds so that the ashes of the dead did not mix with those of the fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amianto"@en .

aat:300011631 a skos:Concept ;
    skos:definition "A thin, laminated serpentine marble, usually pale green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marmolite"@en .

aat:300011632 a skos:Concept ;
    skos:definition "An extremely heavy sepentinite having the form of a flattened sphere, its name deriving from the Greek word for kidney. The rocks were used by the ancient Romans as standard weights and were also supposedly tied around the necks of condemned Christians before they were drowned, explaining why it is sometimes referred to as martyr's stone. It is most commonly jet black with small specks of gray and a metallic texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra nefritica"@en .

aat:300011634 a skos:Concept ;
    skos:definition "A serpentinite whose predominant color is usually a shade of green although there are a few purple varieties. It often bears a strong resemblance to granite; the best serpentina comune comes from Liguria, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentina comune"@en .

aat:300011636 a skos:Concept ;
    skos:definition "An Italian verd antique from Pegli, Italy that was first used by the ancient Greeks and Romans and continues to be used in modern times. It is a breccia marble consisting of deep green fragments of serpentine cemented by light green calcite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verde di Pegli"@en .

aat:300011637 a skos:Concept ;
    skos:definition "A verd antique from Genoa, Italy that was first used by the ancient Greeks and Romans and continues to be used in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verde di Genoa"@en .

aat:300011639 a skos:Concept ;
    skos:definition "A serpentinite from Ponsevera, Italy, near Genoa. It is usually green with white veins, the green ranging from light green to metallic green to bluish green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verde di Ponsevera"@en .

aat:300011640 a skos:Concept ;
    skos:definition "A soft Italian verd antique from Prato, Italy that is deep olive green with dark green spots and veins of clear green and white. It was first used by the ancient Greeks and Romans and continues to be used in modern times; it was notably used for much of the exterior decoration of the cathedral in Florence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verde di Prato"@en .

aat:300011641 a skos:Concept ;
    skos:definition "A serpentinite of varying yellowish green hues, often with fine markings of black or gray; it is named for its frog-like markings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verde ranocchia"@en .

aat:300011646 a skos:Concept ;
    skos:definition "A very fine-grained, foliated, non-layered metamorphic rock, generally produced by metamorphism of shale under relatively low pressure and temperature. It occurs in many varieties, including clay, hornblende, mica, talc slate, and others, all of which have the common property of splitting readily into thin plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slate"@en .

aat:300011649 a skos:Concept ;
    skos:definition "Select, unfading, black slate of uniform color and thickness with all edges ground and accurately squared so that joints can be made tight, smooth, and on the same plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackboard slate"@en .

aat:300011650 a skos:Concept ;
    skos:definition "A thin, usually rectangular, piece of certain varieties of slate or other stones which split readily into sheets and are used to cover the roofs of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing slate"@en .

aat:300011652 a skos:Concept ;
    skos:definition "Roofing slate developed in the Lake District of England that is so called because the pieces interlock at the ridge thus eliminating the need for special ridge pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrestler slate"@en .

aat:300011653 a skos:Concept ;
    skos:definition "Slate primarily used for general building purposes; such slate should be free from pits, cracks, or others defects that could affect its durability or strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural slate"@en .

aat:300011657 a skos:Concept ;
    skos:definition "Slate that is predominantly black in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black slate"@en .

aat:300011658 a skos:Concept ;
    skos:definition "Slate that has components of speculite and graphite in proportions that cause a bluish black color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue slate"@en .

aat:300011659 a skos:Concept ;
    skos:definition "Slate that has a component of chlorite, causing a greenish color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green slate"@en .

aat:300011660 a skos:Concept ;
    skos:definition "Slate that has a component of hematite, causing a reddish color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red slate"@en .

aat:300011661 a skos:Concept ;
    skos:definition "Slate that has components of hematite and chlorite, causing a purplish color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purple slate"@en .

aat:300011664 a skos:Concept ;
    skos:definition "Slate that is distinguished by the light colored stripes or ribbons running through it. It was prized as a material in bannerstones and other ancient American ceremonial objects. When used in construction, it is known for being less durable than other slates because the ribbons are weaker than the surrounding dark areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banded slate"@en .

aat:300011665 a skos:Concept ;
    skos:definition "A very soft rock composed primarily of hydrated magnesium silicate. It is easily cut and has been used for carvings since ancient times. It is usually a white, grayish green, brown or in rare cases, red or black. The stones were carved for bowls, boxes, and small objects such as figurines, beads, seals, amulets, and scarabs. In modern construction, it is used for laboratory sinks, bench tops, and electrical panels. Native soapstone is so soft it can be scratched with a fingernail, but baking results in dehydration and hardening of the stone. Some ancient soapstone carvings were glazed then fired, which produced the mineral enstatite, hard enough to scratch glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soapstone"@en .

aat:300011666 a skos:Concept ;
    skos:definition "A bluish gray stone quarried in Virginia; commonly used for building trim and for chemical laboratory tables and sinks; hard varieties employed for stair treads and flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alberene stone"@en .

aat:300011667 a skos:Concept ;
    skos:definition "A soft, easily carved soapstone, used since prehistoric times for making pots and other household utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potstone"@en .

aat:300011671 a skos:Concept ;
    skos:definition "The largest rock fragment recognized by sedimentologists, a boulder is a detached rock mass larger than a cobble, having a diameter greater than 256 mm (10 in.)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boulder"@en .

aat:300011672 a skos:Concept ;
    skos:definition "A large, loose residual mass of stone left after the erosion of a once continuous bed or layer; often used to specifically refer to one of the large sandstone blocks scattered over the English chalk downs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarsen"@en .

aat:300011677 a skos:Concept ;
    skos:definition "A rock fragment, rounded or otherwise abraded, with a diameter between 64 and 256 mm, being larger than a pebble and smaller than a boulder. The term can also refer more specifically to a rounded stone suitable for use in paving or other construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobble"@en .

aat:300011679 a skos:Concept ;
    skos:definition "A cobble found on beaches that can be used for inexpensive paving or building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach cobble"@en .

aat:300011681 a skos:Concept ;
    skos:definition "Rock, often granite, limestone, or trap rock, that is quarried, crushed, and graded and then used for making concrete, railway ballast, and road making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crushed stone"@en .

aat:300011684 a skos:Concept ;
    skos:definition "Loose stone found on the ground or in the soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fieldstone"@en .

aat:300011687 a skos:Concept ;
    skos:definition "Refers to large flat sections of slate used for paving and also bluestone cut for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flagstone"@en .

aat:300011688 a skos:Concept ;
    skos:definition "Stone, as sandstone, that may be cut freely in any direction without fracture or splitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freestone"@en .

aat:300011689 a skos:Concept ;
    skos:definition "A coarse granular aggregate, larger than sand, formed either naturally or by crushing rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravel"@en .

aat:300011690 a skos:Concept ;
    skos:definition "Small-diameter (6.4 to 9.5 mm or 1/4 to 3/8 in.) natural gravel, screened to specification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pea gravel"@en .

aat:300011691 a skos:Concept ;
    skos:definition "A rock fragment, generally rounded by abrasion, larger than a granule and smaller than a cobble; it has a diameter in the range of 4 to 66 mm, or a size between that of a pea and that of a tennis ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pebble"@en .

aat:300011692 a skos:Concept ;
    skos:definition "Naturally formed aggregate of one or more minerals. For processed or dressed rock use \"stone.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock"@en .

aat:300011693 a skos:Concept ;
    skos:definition "Rough, broken stones or bricks. For use in masonry, use \"rubblework.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubble"@en .

aat:300011694 a skos:Concept ;
    skos:definition "Pulverized stone used to fill the spaces between irregular stones and produce a stable surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone dust"@en .

aat:300011696 a skos:Concept ;
    skos:definition "Marble aggregate set in concrete or resin that is cast in place or precast and ground smooth; used especially as a decorative surfacing on floors and walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrazzo"@en .

aat:300011700 a skos:Concept ;
    skos:definition "Any stone used for building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building stone"@en .

aat:300011701 a skos:Concept ;
    skos:definition "Small dimension stone with a flat faced surface, usually square or rectangular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ashlar"@en .

aat:300011707 a skos:Concept ;
    skos:definition "Crushed rock, slate, slag, porcelain, or tile, crushed into particles and graded, used as surfacing on asphalt roofing and shingles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing granules"@en .

aat:300011712 a skos:Concept ;
    skos:definition "Calcareous, porous limestone formed by the precipitation of calcium carbonate at the vents of springs and geysers, along streams, or on the bottoms or shores of lakes. It is distinguished from travertine by generally being soft and easily crumbled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tufa"@en .

aat:300011713 a skos:Concept ;
    skos:definition "Blocks or slabs of stone or concrete set on edge, creating an upward projection that is used as a curb; may be straight or curved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curbing"@en .

aat:300011717 a skos:Concept ;
    skos:definition "Stone, generally of impressive bulk or size, used for erecting any variety of monument, but particularly for tombs or tombstones. The term can also refer to stone used to carve monumental statuary or for constructing monumental architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumental stone"@en .

aat:300011718 a skos:Concept ;
    skos:definition "A block or chunk of stone that is shaped or selected by shape for a paved surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paving stone"@en .

aat:300011719 a skos:Concept ;
    skos:definition "A type of paving stone generally cut in a slightly pyramidal shape, laid with the base of the pyramid down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgian block"@en .

aat:300011723 a skos:Concept ;
    skos:definition "Compounds having highly basic properties, specifically any of the soluble hydroxides of the alkali metals; a general term now used for any basic material (pH greater than 7). In general, alkali compounds will react with fatty acids to form soaps; turn litmus paper blue; dissolve in water to form alkaline solutions; taste bitter and are irritating to the skin. Alkaline solutions are used in deacidifying and buffering paper. Alkalis also act as fluxes in ceramics and glass production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkali"@en .

aat:300011725 a skos:Concept ;
    skos:definition "A caustic deliquescent solid of the composition KOH, used as a bleach and in the production of liquid soaps and detergents, oxalic acid, matches, and many potassium compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium hydroxide"@en .

aat:300011726 a skos:Concept ;
    skos:definition "A white, deliquescent, water-soluble solid, NaOH, usually in the form of lumps, sticks, chips, or pellets, that upon solution in water generate heat. It is used for the manufacture of other chemicals, rayon, film, and in medicine as a caustic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium hydroxide"@en .

aat:300011727 a skos:Concept ;
    skos:definition "A fine-grained limestone, or soft, earthy form of calcium carbonate; used chiefly in putty, crayons, paint, rubber products, linoleum, and as a pigment and abrasive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalk"@en .

aat:300011728 a skos:Concept ;
    skos:definition "Crayons made from powdered pigments, combined with non-oily binders and pressed into finger-length sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabricated chalk"@en .

aat:300011729 a skos:Concept ;
    skos:definition "Fabricated chalk used by artists in the form of hard crayons made from a mixture of graphite and clay in white, sepia, sanguine, and three grades of black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Conté crayon (TM)"@en .

aat:300011731 a skos:Concept ;
    skos:definition "Pure, artificial calcium carbonate; frequently a by-product of drug and chemical manufacturing. Used industrially as an inert pigment, as well as in gesso grounds and pastel crayons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precipitated chalk"@en .

aat:300011734 a skos:Concept ;
    skos:definition "Refers to soil in the context of building materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth"@en .

aat:300011736 a skos:Concept ;
    skos:definition "Any of several forms of calcium oxide obtained from heating calcium carbonate (limestone, marble, chalk, and shells); when calcium carbonate is heated to about 500 C, carbon dioxide is driven off leaving anhydrous calcium oxide or quicklime. When quicklime is soaked in water, it is changed to calcium hydroxide or slaked lime. Slaked lime that is dried and ground to a fine powder is called hydrated lime or lime hydrate. Lime will eventually harden and react with carbon dioxide to reform calcium carbonate. Lime is used in mortar, cement, stucco, glass, whitewash, putty, leather tanning, papermaking, and as a water-softening agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium oxide"@en .

aat:300011737 a skos:Concept ;
    skos:definition "Colorless crystal or soft, white, alkaline powder prepared by reacting calcium oxide (lime) with water in a process called slaking. It is used in paints, dehairing hide, medicines, and in conservation for superficial protective treatments thanks to its conversion into calcium carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium hydroxide"@en .

aat:300011739 a skos:Concept ;
    skos:definition "A fine mortar or cement made of lime and water, slaked with water and aged, often mixed with sand or marble dust to make the several types of lime plasters, grouts, mortars, and limewash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime putty"@en .

aat:300011740 a skos:Concept ;
    skos:definition "Lime prepared by calcining limestone in a kiln at about 500 C to form a white amorphous powder that may contain small amounts of silica, iron, magnesium, and/or aluminum oxides. Oyster shells have been used to make a very pure quicklime. Once water is added, quicklime becomes slaked lime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quicklime"@en .

aat:300011747 a skos:Concept ;
    skos:definition "Quicklime having a good spread, used to fill voids as it is applied in a finish coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fat lime"@en .

aat:300011752 a skos:Concept ;
    skos:definition "Large class of electrolytic chemical substances that are capable of donating a hydrogen atom. Acids are classified as strong or weak depending on the concentration of hydrogen ion produced on ionization. Acids exhibit one or more of the following characteristics: has a sour or sharp taste; forms an aqueous solution with a pH of less than 7.0; turns litmus dye red; reacts with bases and some metals to form salts; or reacts with a metal carbonate to release carbon dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid"@en .

aat:300011753 a skos:Concept ;
    skos:definition "A colorless, corrosive liquid of pungent odor, CH3 COOH, having a wide variety of uses, such as for etching and soldering, stain removal and bleaching, and as a preservative in photographic chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetic acid"@en .

aat:300011755 a skos:Concept ;
    skos:definition "A sour liquid consisting of dilute and impure acetic acid, obtained by acetous fermentation from wine, beer, cider or ale, and used as a condiment or preservative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinegar"@en .

aat:300011756 a skos:Concept ;
    skos:definition "A colorless to white crystalline material of sweet odor, C6H5OH, obtained from the distillation of coal tar, as a by product of coke ovens, and by alkylating bezene with propylene. It is a raw chemical material used in the production of plastics, dyes, pharmaceuticals, and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbolic acid"@en .

aat:300011758 a skos:Concept ;
    skos:definition "Any of a class of aliphatic acids, especially palmitric, stearic, or oleic acid, consisting of a long hydrocarbon chain ending in a carboxyl group that bonds to glycerol to form a fat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fatty acid"@en .

aat:300011759 a skos:Concept ;
    skos:definition "A colorless or faintly yellow corrosive, fuming liquid, Hcl, used in chemical and industrial procesess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrochloric acid"@en .

aat:300011762 a skos:Concept ;
    skos:definition "Acid used for dissolving or testing gold and platinum; consisting of three parts hydrochloric acid and one part nitric acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aqua regia"@en .

aat:300011763 a skos:Concept ;
    skos:definition "A highly corrosive, caustic, and toxic water solution of hydrogen fluoride that dissolves most metals, except gold, platinum, glass, ceramics, and organic material; used for etching glass and cleaning metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrofluoric acid"@en .

aat:300011764 a skos:Concept ;
    skos:definition "A colorless or yellowish, fuming, caustic, corrosive, water-soluble liquid, HNO3, having powerful oxidizing properties, usually obtained from ammonia or from Chile saltpeter. It is used cheifly in the manufacture of explosives and fertilizers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitric acid"@en .

aat:300011767 a skos:Concept ;
    skos:definition "Colorless, pungent gas composed of nitrogen and hydrogen (NH3) in the simplest stable compound of these elements. It was the first complex molecule to be identified in interstellar space. Gaseous ammonia was first isolated by Joseph Priestly in 1774. It is used in the following ways: as a starting material for the production of many commercially important nitrogen compounds, such as in the manufacture of explosives and fertilizers; and as a vapor phase neutralizing/alkalizing agent where it neutralizes effectively but provides no residual alkaline reserve. Ammonia is most often sold as an aqueous solution of ammonium hydroxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonia"@en .

aat:300011768 a skos:Concept ;
    skos:definition "A colorless, sweet-smelling, sweet-tasting, non-flammable, slightly water-soluble gas, N2O. It is used chiefly as an anesthetic in dentistry and surgery, and in the manufacture of chemicals, such as aerosols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrous oxide"@en .

aat:300011769 a skos:Concept ;
    skos:definition "Semi-metallic element, having symbol Si and atomic number 14, in amorphous and crystalline forms, occurring in a combined state in minerals and rocks and constituting more than one fourth of the earth's crust. The chemical industry uses the term \"silicon metal\" and \"silicon\" interchangeably, and anything but pure silicon is generally referred to in this context as \"semiconductor-grade silicon.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicon"@en .

aat:300011770 a skos:Concept ;
    skos:definition "A colorless gas used chiefly as a refrigerant, as a preservative, in bleach, and for making other chemicals; it is also a component of acid rain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfur dioxide"@en .

aat:300011772 a skos:Concept ;
    skos:definition "A liquid made up of molecules of hydrogen and oxygen (HO2). When pure, it is colorless, tasteless, and odorless. It exists in gaseous, liquid, and solid forms; it is liquid at room temperature. It is the liquid of which seas, lakes, and rivers are composed, and which falls as rain. Water is one of the most plentiful and essential of compounds. It is vital to life, participating in virtually every process that occurs in plants and animals. One of its most important properties is its ability to dissolve many other substances. The versatility of water as a solvent is essential to living organisms. The term \"water\" is typically used to refer to the liquid form of this compound; for the solid or gaseous forms, use \"ice\" or \"water vapor.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water"@en .

aat:300011774 a skos:Concept ;
    skos:definition "Water that contains magnesium, calcium or iron salts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard water"@en .

aat:300011775 a skos:Concept ;
    skos:definition "Water that is free from dissolved salts and such metals as calcium, iron, or magnesium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft water"@en .

aat:300011777 a skos:Concept ;
    skos:definition "Waters from which impurities, such as dissolved salts and collodial particles have been removed by one or more chemical processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distilled water"@en .

aat:300011778 a skos:Concept ;
    skos:definition "Water that is safe or suitable to drink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking water"@en .

aat:300011781 a skos:Concept ;
    skos:definition "The solid form of water, resulting from liquid water being cooled to a low temperature, either naturally (by weather or climate) or artificially (as by refrigeration)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice"@en .

aat:300011784 a skos:Concept ;
    skos:definition "Water in the form of an invisible gas or vapor, changed to this form by boiling and used extensively for the generation of mechanical power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam"@en .

aat:300011786 a skos:Concept ;
    skos:definition "Earthy or mineral residue that remains after combustible substances have been thoroughly burned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ash"@en .

aat:300011788 a skos:Concept ;
    skos:definition "The incombustible residue of something burnt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinder"@en .

aat:300011789 a skos:Concept ;
    skos:definition "Partially fused product from a kiln, which is ground and used for cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinker"@en .

aat:300011790 a skos:Concept ;
    skos:definition "Vitreous substance composed of earthy or refuse matter that is separated from metals in the process of smelting. Slag is formed from the combination of silica with flux materials such as soda and potash, along with metal oxides and other impurities that float to the surface. In ceramic kilns, slag is formed by the reaction of the fluxing materials with the refractory lining. Objects made from ancient iron and copper alloys often contain small pieces of slag that were incompletely separated from the metal. Slag is a useful residue incorporated in the manufacture of concrete, mineral wool, slag brick, slag glass, portland cement, and cinder block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slag"@en .

aat:300011792 a skos:Concept ;
    skos:definition "Material containing carbon, including those derived from living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic material"@en .

aat:300011793 a skos:Concept ;
    skos:definition "Material of animal origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal material"@en .

aat:300011794 a skos:Concept ;
    skos:definition "Water-soluble and alcohol-soluble protein obtained from egg, blood, or milk; used in adhesives, finishes, coatings, varnish, as a clarifying agent for tannin, and in oil emulsion. The spelling with \"i\" is typically reserved fro this broader meaning. Use \"albumen (egg white)\" (spelled with an \"e\") for egg-white protein in the context of food preparation or photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albumin"@en .

aat:300011796 a skos:Concept ;
    skos:definition "Material made from antlers, which are paired deciduous outgrowths of bone projecting from the frontal bones of ungulates of the deer family. Distinguished from \"horn,\" which is modified skin tissue or compacted hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antler"@en .

aat:300011797 a skos:Concept ;
    skos:definition "Fluid that circulates in the principal vascular system of vertebrate animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blood"@en .

aat:300011798 a skos:Concept ;
    skos:definition "The rigid, calcareous material that is white in color and forms the skeleton of vertebrates; primarily composed of calcium hydroxyapatite with smaller amounts of calcium carbonate, calcium fluoride, magnesium phosphate, and ossein, a high molecular weight protein. Bones have a concentric structure with central lymphatic canals surrounded by a spongy lamellar region protected by a dense outer cortex. Bone has been carved and used since ancient times for many purposes, including fish-hooks, spear heads, needles, handles, and art objects. Bones were also burnt to produce bone black and boiled to produce bone glue. Bone can be distinguished from ivory by being generally whiter, more porous, and less dense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone"@en .

aat:300011799 a skos:Concept ;
    skos:definition "A natural phosphorus-containing protein found in milk, composed of amino acids Casein curds form naturally as milk sours, but it is also precipitated by adding dilute hydrochloric acid to hot skim milk. The curds are collected, washed and dried to form a white to yellowish powder. The dried casein is insoluble in water and alcohol but is soluble in carbonates and other alkaline solutions. For use, casein is soaked overnight in a solution with a weak alkali (ammonium carbonate, borax, or lime) to form a clear, viscous solution. Casein has been used as a glue and binder since earliest recorded periods. In the late 19th century, casein was made into a plastic by treatment with formaldehyde, used for small items such as buttons, beads, buckles, combs, cutlery handles, and knitting needles. They were often pigmented to simulate ivory, horn, or tortoiseshell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casein"@en .

aat:300011800 a skos:Concept ;
    skos:definition "Hard material consisting of calcium carbonate derived from the skeletal deposits of certain marine animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coral"@en .

aat:300011801 a skos:Concept ;
    skos:definition "Material derived from eggs, which in the context of art materials are usually the ellipsoidal shell and embryonic contents produced by birds. For paintings, the egg contents are used as a tempera medium. The whole egg, yolk, or white may be used sometimes mixed with oil and/or resin. The egg yolk is a stable emulsion of an aqueous liquid with an oily, proteinaceous medium which dries quickly into a hard, insoluble film. Egg white has been used as a medium for illuminated manuscripts. It is also used as a size for attaching gold leaf. Albumen is the adhesive substance of egg white. As a pure film, albumen is clear, brittle, and water soluble. Water solubility can be decreased by heating or adding tannin. For the exterior of a bird egg comprising the brittle shell composed of keratin and calcite, use \"eggshell (animal material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg"@en .

aat:300011802 a skos:Concept ;
    skos:definition "Egg white protein used in the food industry and in photographic emulsions, particularly those dating to the 19th century. For the more general meaning of the naturally occurring, water-soluble protein found in egg white, milk, and blood, use \"albumin (general protein).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albumen"@en .

aat:300011803 a skos:Concept ;
    skos:definition "Material comprising the yellow spheroidal mass of stored food that forms the inner portion of the egg, usually a bird's egg. The whole egg, yolk, or white may be used sometimes mixed with oil and/or resin. The egg yolk is a stable emulsion of an aqueous liquid with an oily, proteinaceous medium which dries quickly into a hard, insoluble film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg yolk"@en .

aat:300011804 a skos:Concept ;
    skos:definition "Excrement of animals, rarely of humans, particularly when used to fertilize the soil or, when dried, as a building material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dung"@en .

aat:300011808 a skos:Concept ;
    skos:definition "A substance that is found on some coasts or islands frequented by sea fowl, composed chiefly of their partially decomposed excrement, rich in phosphate and nitrogenous matter, used extensively as fertilizer. Also refers to excrement of bats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guano"@en .

aat:300011809 a skos:Concept ;
    skos:definition "Material comprising stiff, lightweight, often colorful, keratin structures that are the principal covering of birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather"@en .

aat:300011810 a skos:Concept ;
    skos:definition "Material comprising the fine, small, fluffy, undergrowth feathers that lie next to the body of many adult birds. Commercial down, usually obtained from ducks and waterfowl, is lightweight and resilient. When used as a filling, down provides insulation and loft. It is used in winter coats, sleeping bags, bedding, and pillows. Trade regulation rules allow a garment to be labeled 100% down when it contains a minimum of 80% down. Today, most down is imported from China, Taiwan, Poland, and eastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "down"@en .

aat:300011811 a skos:Concept ;
    skos:definition "Fine, soft, thick, hairy coat of a mammal, usually consisting of a double coat of hair that includes a layer of comparatively short, soft, curly barbed hair next to the skin, protected by longer, smoother, stiffer hair growing up through it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fur"@en .

aat:300011812 a skos:Concept ;
    skos:definition "A water-soluble, tasteless colloidal form of processed collagen obtained from bones, hooves or skins and used as a dispersing agent, sizing medium, adhesive, or coating for photographic films, and stabilizer for foodstuffs and pharmaceutical preparations. Is high in molecular weight after processing, as opposed to more vigorously processed collagen which results in animal glue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin"@en .

aat:300011814 a skos:Concept ;
    skos:definition "Material comprising the cylindrical filaments that grow from follicles embedded in the skin of mammals. Hair is a column of overlapping, fused cells that are composed of the protein keratin; hair is composed of three parts: the innermost column is the medula, the surrounding live cells (the cortex) contain pigment, and the outermost dead transparent cells are the cuticular scales. The portion of the hair outside of the skin is called the shaft. Fine, closely spaced hair that covers most of an animal's body is called fur. Dense, soft, curled hair is called wool. Coarse, stiff hairs are called bristles, spines, or quills. Horsehair and cattle hair have been used for brushes, plaster binders, haircloth, and upholstery stuffing. Rabbit hair, often called rabbit fur, has been used to make felt hats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair"@en .

aat:300011816 a skos:Concept ;
    skos:definition "Fine body hair, or camel wool, used as a textile fiber; derived from camels. For artists' brushes usually made from the hair of squirrels, use \"camel hair brushes.\" For material made from hair of llama and other camelids, use \"camelid fiber.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camel hair"@en .

aat:300011818 a skos:Concept ;
    skos:definition "The hair or hair plus skin of the goat, which is a ruminant quadruped of the genus Capra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goat hair"@en .

aat:300011819 a skos:Concept ;
    skos:definition "Hair from the manes and tails of horses, used chiefly as a brush fiber, for musical instrument bows, and for making haircloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horsehair"@en .

aat:300011820 a skos:Concept ;
    skos:definition "Any hair of humans (Homo sapiens), particularly the hair grown from the scalp of humans. Human hair is a cylindrical tube composed mostly of keratin. The shaft is covered with thin, flat scales and the central core often contains pigments of red, black, or brown. Commercially, human hair has often been used for wigmaking and brushmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human hair"@en .

aat:300011822 a skos:Concept ;
    skos:definition "Short, stiff, coarse hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bristle"@en .

aat:300011823 a skos:Concept ;
    skos:definition "One of the long projecting hairs or bristles growing near the mouth of an animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whisker"@en .

aat:300011825 a skos:Concept ;
    skos:definition "Textile woven of synthetic fiber, plant fiber, or animal hair, used for awnings, tents, or other coverings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velum"@en .

aat:300011826 a skos:Concept ;
    skos:definition "Material comprising horns, the hard, semitranslucent, proteinaceous structures that grow from the head of some mammals, such as cattle, sheep, goats, and antelope. Horn, like nails, claws, and hooves, is composed of epidermal cells known as keratin. Rhinoceros horns are formed from matted hair. The colours of horn range from a light cream to black. Horn can be cut, engraved, or carved, and has been used since ancient times for tools and ornamentation. The thermoplastic material is softened with steam or boiling water then pressed into numerous shapes. In the 18th century, London was the center of the horn molding industry, primarily making snuff boxes and decorative containers. Distinguished from \"antler (material),\" which is the fast-growing bone of deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horn"@en .

aat:300011827 a skos:Concept ;
    skos:definition "A smooth round bead formed primarily within the shells of two distantly related groups of molluscan bivalves or clams, including the ocean-dwelling pearl oysters and the freshwater river mussels. Pearls are used in jewelry and for other ornamental puposes; they are considered a gem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearl"@en .

aat:300011828 a skos:Concept ;
    skos:definition "Material derived from the hard, hollow shaft of a feather that attaches into the skin of the bird. The quill portion of the bird feather does not have any lateral branches; quills from ducks, geese, eagles, swans, and other large birds have been used as tips for pens and as ferrules for artists' brushes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quill"@en .

aat:300011829 a skos:Concept ;
    skos:definition "Hard outer covering of invertebrate creatures, composed of calcareous or chitinous material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell"@en .

aat:300011833 a skos:Concept ;
    skos:definition "Bowl-like shells of the abalone mollusk, a source of mother of pearl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abalone shell"@en .

aat:300011834 a skos:Concept ;
    skos:definition "Shell of any of numerous marine gastropod mollusks of a family widely distributed in warm seas; beautifully polished, often brightly colored, and much used for ornament or as money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowrie shell"@en .

aat:300011835 a skos:Concept ;
    skos:definition "Hard, pearly, iridescent internal layer of various kinds of mollusk shell, extensively used for making small articles and inlays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mother of pearl"@en .

aat:300011836 a skos:Concept ;
    skos:definition "Shell of an oyster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster shell"@en .

aat:300011837 a skos:Concept ;
    skos:definition "Material made from the thinly-sliced horny plates covering the shells of some turtles and tortoises; the finished material is finely colored gold and brown, translucent, and glossy. It was popular in the 19th-century for inlays, jewelry, hair combs, and other ornaments, but its use is banned today. It differs from \"turtle shell\" in how it is worked and in the finished appearance; tortoise shell is worked upon like horn, and is usually softened or rendered plastic by placing in boiling water. The most common sources of tortoiseshell are Hawksbill turtle (Eretmochelys imbricata), which provides the finest scales, the Loggerhead (Thalassochelys caretta ) and the Green turtle (Chelone mydas)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tortoise shell"@en .

aat:300011840 a skos:Concept ;
    skos:definition "Integument of animals such as sheep, calves, or goats, separated from the body, with or without hair, whether green, dry, tanned, or dressed. For the integument of large animals use \"hide.\" For tanned skin, use \"leather.\" For dried and stretched skin, use \"parchment\" or \"vellum.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin"@en .

aat:300011841 a skos:Concept ;
    skos:definition "Material made of the scales of fish, which are hard or rigid structures produced from the mesoderm skin layer of most bony and cartilaginous fishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish scale"@en .

aat:300011843 a skos:Concept ;
    skos:definition "Use generally for the skin of fish of the shark species. Use specifically for durable, nonscuffing leather made from such skin, covered with minute scales bearing short spines and typically used as an abrasive material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sharkskin"@en .

aat:300011844 a skos:Concept ;
    skos:definition "Integument of a large animal such as a cow or buffalo separated from the body with or without hair, whether green, dry, tanned, or dressed. For the integument of a small animal, use \"skin.\" For tanned hide, use \"leather.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hide"@en .

aat:300011845 a skos:Concept ;
    skos:definition "The skin or hide of an animal that has been tanned to render it resistant to putrefication and relatively soft and flexible when dry. For composite material made from scrap leather pieces, use \"maril.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leather"@en .

aat:300011846 a skos:Concept ;
    skos:definition "Leather made from skin from deer or deer family animals from which the grain has been removed. Generally treated with animal oils, formaldehyde, or a combination of both. For unprocessed skin, use \"deerskin.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckskin"@en .

aat:300011848 a skos:Concept ;
    skos:definition "Leather derived from lizards, which in common usage refers to reptiles of the genus Lacerta as well as any other reptiles resembling these in shape and general appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lizard leather"@en .

aat:300011849 a skos:Concept ;
    skos:definition "Use generally for the skin of the domestic pig. Use specifically for leather made from such skin, usually vegetable-tanned and having a characteristic grain pattern produced by the hair follicles which form roughly triangular groups of three."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigskin"@en .

aat:300011851 a skos:Concept ;
    skos:definition "Translucent or opaque material made from calf, sheep, or goat skin which has been limed, dehaired, scraped, and dried under tension to produce a thin, strong material for writing, bookbinding, or other uses. For finer quality calf parchment, use \"vellum.\" The terms parchment and vellum sometimes have been and still are both confused and used interchangeably."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parchment"@en .

aat:300011852 a skos:Concept ;
    skos:definition "Fine-quality calf or lamb parchment used for writing, illuminations, or binding books. The terms \"vellum\" and \"parchment\" are sometimes confused and used interchangeably."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vellum"@en .

aat:300011854 a skos:Concept ;
    skos:definition "Material comprising a porous structure composed of siliceous cells bound in a spongin (fibrous protein) matrix of certain animals or the absorbent cellulose fibers from several types of fruits or gourds. The term may also be applied to similar artificial materials. Natural sponges have been used for their absorbent characteristics since ancient times, for example, for applying paint, cleaning, and for drinking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponge"@en .

aat:300011855 a skos:Concept ;
    skos:definition "Material made from hard, bone-like structures grown in the mouth of vertebrates; distinguishable from other bone by its structure. Animal teeth, such as from hippopotami, whales, lions, dogs, boars, bears, and humans have been used to make jewelry, gaming pieces, buttons, and and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tooth"@en .

aat:300011856 a skos:Concept ;
    skos:definition "General term for material made from tusks, which are large protruding teeth found in elephants, walruses, narwhals, and boars. Tusks, like other teeth, have a soft center surrounded by hard dentin primarily composed of calcium hydroxyapatite with smaller amounts of calcium carbonate, calcium fluoride, magnesium phosphate, and ossein. A hard durable enamel forms a smooth outer surface. Tusk has been used to make sculptures, handles, and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tusk"@en .

aat:300011857 a skos:Concept ;
    skos:definition "The modified form of dentin derived from animal teeth. The most common example is from the tusks of mature elephants; similar material is obtained from any tusked or large-toothed mammal such as a walrus or narwhal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivory"@en .

aat:300011860 a skos:Concept ;
    skos:definition "The external material that covers the woody parts of trees, as distinct and separate from the wood itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bark"@en .

aat:300011861 a skos:Concept ;
    skos:definition "Material comprising strips of tree bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bark strip"@en .

aat:300011862 a skos:Concept ;
    skos:definition "The lightweight, elastic outer bark the cork oak, species Quercus suber native to the Mediterranean region. Cork is elastic, buoyant, and resilient, used to seal wine bottles, for insulation, floats, acoustical wall covering, flooring, shoe soles, gaskets, and handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cork"@en .

aat:300011863 a skos:Concept ;
    skos:definition "General term for any edible seed of various species in several genera of the family Fabaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bean"@en .

aat:300011864 a skos:Concept ;
    skos:definition "Material comprising the long, hollow, pithy, jointed stem of certain plants, such as bamboo, rattan, sugarcane, or certain palms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cane"@en .

aat:300011865 a skos:Concept ;
    skos:definition "The tough stems of various climbing palms of the genus Calamus or allied genera, used for wickerwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rattan"@en .

aat:300011868 a skos:Concept ;
    skos:definition "Portions of a plant consisting of the seed and its envelope, especially the latter when it is of a juicy, pulpy nature. In its strict botanical sense, the fleshy or dry ripened ovary of a plant, enclosing the seed or seeds, such as apricots, bananas, and grapes, as well as bean pods, corn grains, tomatoes, cucumbers, and (in their shells) acorns and almonds, are all technically fruits. Popularly, however, the term is restricted to the ripened ovaries that are sweet and either succulent or pulpy. The cultivation and processing of fruits are major industries worldwide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit"@en .

aat:300011869 a skos:Concept ;
    skos:definition "According to the botanical definition, fleshy fruits produced from a single ovary; a berry is the most common type of fleshy fruit in which the entire ovary wall ripens into an edible pericarp. Berries may have one or more carpels with a thin covering and fleshy interiors. Many fruits commonly referred to as berries are not actual berries by the scientific definition: in common usage, the term is used for any simple, fleshy fruit, often one that has many seeds and usually reserved for small fruits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berries"@en .

aat:300011870 a skos:Concept ;
    skos:definition "The hard-shelled fruits of any of various plants of the Cucurbitaceae family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gourds"@en .

aat:300011871 a skos:Concept ;
    skos:definition "General term for the small, hard seeds of various species in different genera of the grass family Poaceae, used as cereal plants, such as wheat, rice, corn, rye, or oats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain"@en .

aat:300011872 a skos:Concept ;
    skos:definition "Material comprising the stalks or leaves of plants of the family Poaceae, and plants resembling these in general appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grass"@en .

aat:300011873 a skos:Concept ;
    skos:definition "Material derived from the stem or stalk of the bamboo plant, which is any of 480 species of woody or treelike tropical and semitropical grass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bamboo"@en .

aat:300011874 a skos:Concept ;
    skos:definition "Material made from bamboo stalks split into strips, often tied or glued to form a stiff but flexible material; used as a material for making structures, scaffolding, containers, rafts, fishing rods, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split bamboo"@en .

aat:300011875 a skos:Concept ;
    skos:definition "Material derived from the flat, somewhat hairy leaves of the grass species Elymus repens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couch grass"@en .

aat:300011877 a skos:Concept ;
    skos:definition "Material comprising or derived from the long narrow leaves of species of seagrass in the genus Zostera, usually dried and used for packing material, stuffing cushions, as well as for weaving and in the manufacture of wall boards and in wall insulation. Not to be confused with plants of the freshwater genus Vallisneria, also called eelgrass (or tape grass)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eelgrass"@en .

aat:300011878 a skos:Concept ;
    skos:definition "General term for material comprising the leaves and stems of various tall, stiff, wetland grasses of various genera in the order Poales. Used for construction and thatching roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed"@en .

aat:300011879 a skos:Concept ;
    skos:definition "Material derived from stems of various species of the genera Scirpus, used for making strong mats, chair seats, hats, and basketry. For material from species in the genus Typha, use \"cattail.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulrush"@en .

aat:300011881 a skos:Concept ;
    skos:definition "Material comprising the stem and leaves of plants in the genus Sparganium, distinguished by elongated linear leaves and globose fruits resembling burs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bur reed"@en .

aat:300011883 a skos:Concept ;
    skos:definition "Material comprising the stem and leaves of the grass species Cortaderia selloana, used for making ropes and baskets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pampas grass"@en .

aat:300011886 a skos:Concept ;
    skos:definition "Material comprising the leaves of any of the reedy grasses in the genus Ammophila, which grow along the coasts of North America, Europe, and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach grass"@en .

aat:300011888 a skos:Concept ;
    skos:definition "A framework of interwoven rods, poles, or branches; used with daub as a building material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wattle"@en .

aat:300011889 a skos:Concept ;
    skos:definition "Material comprising the leaves and pithy or hollow stems of grasslike plants of the genus Juncus, found in wet or marshy places and used since ancient times to make baskets, mats, and chair seats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rush"@en .

aat:300011890 a skos:Concept ;
    skos:definition "Matrial comprising the outer covering of a kernel or seed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "husk"@en .

aat:300011892 a skos:Concept ;
    skos:definition "Material comprising leaves, which are the expanded, usually green organs borne by the stem of a plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaf"@en .

aat:300011894 a skos:Concept ;
    skos:definition "Material comprising the leaf of any variety of palm tree, used for thatching, weaving, as a writing surface, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palm leaf"@en .

aat:300011896 a skos:Concept ;
    skos:definition "Material comprising the leaf of any of several plants of the genus Nicotiana, of the nightshade family, dried and variously prepared, yielding a sedative and narcotic substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco"@en .

aat:300011897 a skos:Concept ;
    skos:definition "Any fruits or seeds having a hard or leathery shell enclosing a relatively hard, edible or oil-yielding kernel, or the kernel itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuts"@en .

aat:300011898 a skos:Concept ;
    skos:definition "Material comprising a seed vessel of long form, usually dry and dehiscent; strictly used only of leguminous and cruciferous plants, but often extended to other long fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pod"@en .

aat:300011900 a skos:Concept ;
    skos:definition "Long pods of the species Ceratonia siliqua, native to Southern Europe, Northern Africa, Mediterranean islands, the Middle East, and the Canary Islands. The pods contain small beans called \"locust beans\" and sweetish edible pulp. The pods are used as animal feed; ground pods are used as a source of chocolate substitute, a source of sugar, and to make makuba, a liquid binder used in traditional northern Nigerian mud buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locust bean pod"@en .

aat:300011902 a skos:Concept ;
    skos:definition "Material comprising the seed of a plant, which is the nutrient material for development after germination that is enclosed in a protective coat. Seeds may be processed in various ways for use as materials, or they may be used whole as elements in a design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seed"@en .

aat:300011903 a skos:Concept ;
    skos:definition "Cereal grain belonging to the Maydeae tribe of the Poaceae grass family, originating in the Americas and cultivated for a wide variety of uses, including human and animal food and as raw material in industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn"@en .

aat:300011904 a skos:Concept ;
    skos:definition "Material comprising the stem or main axis of a plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stalk"@en .

aat:300011905 a skos:Concept ;
    skos:definition "The stalk or stem of the corn plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornstalk"@en .

aat:300011906 a skos:Concept ;
    skos:definition "Material comprising the stems of the grass species Sorghum bicolor. Not actually the stalk of a corn species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guinea corn stalk"@en .

aat:300011908 a skos:Concept ;
    skos:definition "Dried stalks of cereals or other grasses, used for many purposes, including weaving, plaiting, and braiding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straw"@en .

aat:300011909 a skos:Concept ;
    skos:definition "Straw from the barley plant, traditionally used in Europe and Asia as braided plaits for hats. In the Americas, it was used as a packing material, particularly for shipping glass. It is also used as an animal feed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barley straw"@en .

aat:300011910 a skos:Concept ;
    skos:definition "Straw from the rice plant, used for papermaking, packing, and during World War II it was also used for coarse rope because of the shortage of other bast fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice straw"@en .

aat:300011911 a skos:Concept ;
    skos:definition "The stalks of wheat plants, used as bedding for animals, fodder, insulation, a source of pulp for paper and corrugated board, and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheat straw"@en .

aat:300011912 a skos:Concept ;
    skos:definition "Material made of thorns, which are the sharp excrescences on certain plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thorn"@en .

aat:300011914 a skos:Concept ;
    skos:definition "The principal tissue of trees and other plants that provides both strength and a means of conducting nutrients. Wood is one of the most versatile materials known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood"@en .

aat:300011916 a skos:Concept ;
    skos:definition "Wood produced from broad-leaved deciduous trees, varying widely in color and grain pattern; usually but not always harder than softwood. Examples of hardwood trees are ash, beech, birch, cherry, mahogany, maple, oak, poplar, and walnut. Hardwood trees are found in temperate and tropical climate zones. Most of the wood used for cabinetry, furniture and flooring is obtained from hardwood trees; only a small amount of hardwood is used for paper pulp. The term hardwood is somewhat confusing since some deciduous trees, such as basswood, have timber that is softer than some coniferous trees, such as yellow pine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardwood"@en .

aat:300011918 a skos:Concept ;
    skos:definition "Wood of the shrub or tree belonging to the genus Alnus, of the birch family, ranging in color from pale yellow to reddish brown, and used for making furniture, cabinetry, turnery, and in charcoal manufacture and millwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alder"@en .

aat:300011920 a skos:Concept ;
    skos:definition "A species of alder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus cremastogyne"@en .

aat:300011921 a skos:Concept ;
    skos:definition "Species of alder native to Japan and Korea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus pendula"@en .

aat:300011922 a skos:Concept ;
    skos:definition "Wood of any of several green alder species that grow in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American green alder"@en .

aat:300011924 a skos:Concept ;
    skos:definition "Wood of the tree belonging to the species Alnus glutinosa, native to Europe, the British Isles and Africa. It is dull, light reddish-brown in color and is used for making broom and brush backs, hat blocks, toys, and wooden shoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common alder"@en .

aat:300011927 a skos:Concept ;
    skos:definition "Wood of the Alnus viridis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European green alder"@en .

aat:300011929 a skos:Concept ;
    skos:definition "Wood of the Alnus rubra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red alder"@en .

aat:300011932 a skos:Concept ;
    skos:definition "Wood of Alnus maritima."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seaside alder"@en .

aat:300011937 a skos:Concept ;
    skos:definition "Wood of any of several varieties of the species Fraxinus excelsior. The wood is whitish to pale brown in color with a pink cast. It is a dense wood that is tough and elastic with a straight grain and slightly coarse texture. It is moderately durable but susceptible to insect attack. The timber is used for ladders, tool handles, oars, poles, wheels, boats, weapons, furniture, gymnasium equipment, tennis racquets, and hockey sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European ash"@en .

aat:300011940 a skos:Concept ;
    skos:definition "Wood of Fraxinus americana, native to Canada and the United States. It is a lightweight wood that is stiff, strong, and resilient. The sapwood is white and the heartwood ranges in color from light brown to reddish-brown. It is used for boat frames, church pews, sports equipment (baseball bats, hockey sticks, skis, paddles and oars, and tennis racket frames), and tools (handles of shovels, hammers, spades, hoes, and rakes as well as ladder rungs), and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white ash"@en .

aat:300011944 a skos:Concept ;
    skos:definition "Wood of the Centrolobium genus, ranging in color from yellowish brown to purplish pink, with streaks of red or black. It usually has a straight grain, fine texture, and polishes to a high luster. Balaustre has been used in shipbuilding and as a veneer for cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balaustre"@en .

aat:300011948 a skos:Concept ;
    skos:definition "Pale reddish-brown, close-grain wood from any of several trees of the genus Fagus; it is hard and heavy, bends well, is durable under water, and gives a smooth shiny finish. Beech wood is commonly used for flooring, cabinetry, furniture (especially bentwood chairs), veneer, plywood, tool handles, and turnery. It was used in panel paintings in western Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beech"@en .

aat:300011950 a skos:Concept ;
    skos:definition "Pale reddish-brown timber from the species Fagus grandifolia; it is hard, tough, fine-grained wood used for furniture, flooring, plywood, veneer, cooperage, shoe lasts, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American beech"@en .

aat:300011952 a skos:Concept ;
    skos:definition "Wood of the species Fagus engleriana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese beech"@en .

aat:300011954 a skos:Concept ;
    skos:definition "Wood of the tree species Fagus sylvatica, native to Eurasia and Great Britain. It is a reddish-brown, close-grained wood that bends well and gives a smooth shiny finish. It is a commonly used timber for flooring, cabinetry, furniture, veneer, tool handles, turnery, and was occasionally used in panel paintings in western Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European beech"@en .

aat:300011957 a skos:Concept ;
    skos:definition "Wood of the species Fagus japaonica, native to Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese blue beech"@en .

aat:300011959 a skos:Concept ;
    skos:definition "Wood of the species Nothofagus solandri, native to New Zealand. It is brown in color and known for its high strength and durability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Zealand beech"@en .

aat:300011962 a skos:Concept ;
    skos:definition "Wood of the species Fagus orientalis, native to Eurasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oriental beech"@en .

aat:300011964 a skos:Concept ;
    skos:definition "Wood of the species Nothofagus fusca, native to cooler regions of the southern hemisphere. It is used in the making of flooring, toys, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red beech"@en .

aat:300011966 a skos:Concept ;
    skos:definition "Wood of the species Fagus crenata, similar to European beech with cream-colored sapwood and brown heartwood. It is used for tool handles, flooring, joinery, plywood, and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siebold's beech"@en .

aat:300011968 a skos:Concept ;
    skos:definition "Wood of the species Gmelina leichhardti, which is not actually a beech. It is used in the making of cabinets, cooperage, paneling, musical instruments, and veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white beech"@en .

aat:300011973 a skos:Concept ;
    skos:definition "Strong, pale yellow-brown wood from trees of the genus Betula, having a close, straight grain and uniform texture that finishes to a smooth surface. It is sometimes dyed to imitate mahogany. Birch is used for tools handles, plywood, hoops, shoe heels, flooring, furniture, cabinetry, turnery, and firewood. The bark is also used for various purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birch"@en .

aat:300011977 a skos:Concept ;
    skos:definition "Wood of the species Betula nana, a shrub or small tree native to arctic and cool temperate regions of northern Europe, northern Asia, and northern North America, in Greenland and mountains above 300 m in Scotland and at 2,200 m in the Alps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarf birch"@en .

aat:300011983 a skos:Concept ;
    skos:definition "Wood from the species Betula utilis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Himalayan birch"@en .

aat:300011985 a skos:Concept ;
    skos:definition "Wood of the species Betula papyrifera, native to northern and central North America. Almost white in color, it is used for flooring, furniture, canoes, and objects such as spools, bobbins, dowels, and crates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper birch"@en .

aat:300011988 a skos:Concept ;
    skos:definition "Wood of the species Betula nigra, often used in the making of small turned articles, such as clothes pins and toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river birch"@en .

aat:300011991 a skos:Concept ;
    skos:definition "Wood of the species Betula pendula found throughout Europe, including the British Isles and Scandinavia. It is characterized by having no distinct heartwood, with whitish to pale brown, fairly straight-grained wood. It is used for plywood, furniture, dowels, fittings, brooms, and turnings"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver birch"@en .

aat:300011995 a skos:Concept ;
    skos:definition "Wood of the species Betula lenta, native to the southern Appalachians. It is similar to yellow birch and is not separated from it commercially, but it is denser and deeper in color. It is used in the making of veneer, flooring, furniture, doors, plywood, and vehicle parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweet birch"@en .

aat:300012000 a skos:Concept ;
    skos:definition "Wood of the species Betula alleghaniensis, native to the northeastern part of North America, with light yellow sapwood and reddish-brown heartwood. It is similar to sweet birch and is not separated from it commercially. It is used in the making of fine furniture, joinery, spools, bobbins, and plywood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow birch"@en .

aat:300012002 a skos:Concept ;
    skos:definition "Dense, pale yellow wood from trees of the genus Buxus. Although difficult to carve, the wood has excellent dimensional stability and is very wear resistant. The hard, fine-grain wood is often used for printing blocks, rulers, mallets, architects scales, slide rules, modeling tools, musical instruments, engravings, inlays, small decorative items, and game pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxwood"@en .

aat:300012010 a skos:Concept ;
    skos:definition "Wood of the species Casearia praecox, native to the West Indies, Venezuela, and Colombia. The wood ranges in color from lemon-yellow to almost white, with little or no distinction between sapwood and heartwood. It is used in the making of shuttles, spindles, piano keys, and mathematical instruments. It is often died black to resemble ebony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maracaibo boxwood"@en .

aat:300012013 a skos:Concept ;
    skos:definition "General term used to refer to dense, compact dyewood from several (but not all) species of the Caesalpinia genus used in violins, bows, veneer, cabinetwork, and high quality furniture. It accepts a high polish. The wood contains the colorant brasilin, a hydroxyanthraquinone, that gives a deep red to brownish color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brazilwood"@en .

aat:300012016 a skos:Concept ;
    skos:definition "Wood of the species Caesalpinia sappan, native to Sri Lanka, India, and Malaya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sappanwood"@en .

aat:300012018 a skos:Concept ;
    skos:definition "General term for wood of any species of horse chestnut native to North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckeye"@en .

aat:300012021 a skos:Concept ;
    skos:definition "Wood from the species Aesculus californica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "California buckeye"@en .

aat:300012025 a skos:Concept ;
    skos:definition "Wood of the species Aesculus pavia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red buckeye"@en .

aat:300012027 a skos:Concept ;
    skos:definition "Wood of the tree belonging to the genus Aesculus glabra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ohio buckeye"@en .

aat:300012029 a skos:Concept ;
    skos:definition "Wood of the species Aesculus octandra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow buckeye"@en .

aat:300012032 a skos:Concept ;
    skos:definition "Wood of the species Cinnamomum camphora, native to southeastern Asia. Camphorwood has a pungent smell, reddish-brown streaks, and irregular grain, and has been used for small carvings and decorative items, clothes chests, trunks, wardrobes, and coffins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camphorwood"@en .

aat:300012036 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Catalpa, native to eastern Asia, eastern North America, and the West Indies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalpa"@en .

aat:300012039 a skos:Concept ;
    skos:definition "Wood of the genus Castanea; several species produce a light reddish brown wood that is relatively weak with a coarse grain. It is a soft light wood that splits easily but does not turn well. It is used for general construction, framing, fencing, poles, barrels, and veneer. Chestnut wood was commonly used for painted panels, especially in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chestnut"@en .

aat:300012041 a skos:Concept ;
    skos:definition "Wood of the species Castanea dentata; it is similar to oak with a light brown, coarse grain. The durable wood was widely used prior to World War II for paneling, framing, fence posts, rails, shingles, office desks, and coffins. Trees are have a limited range today; while formerly found throughout North America, they were largely killed off by a fungus in the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American chestnut"@en .

aat:300012044 a skos:Concept ;
    skos:definition "Wood of the species Castanea mollissima, native to China. The tree has a strong resistance to the blight that killed off most of the American Chestnut specimens in the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese chestnut"@en .

aat:300012046 a skos:Concept ;
    skos:definition "Wood of the species Castanea sativa, native to southwestern Europe, North Africa, and Asia Minor. The heartwood is yellowish-brown in color, closely resembling oak but lacking its silver grain characteristics. It is used in the making of furniture, coffin boards, turnery, and fence poles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European chestnut"@en .

aat:300012051 a skos:Concept ;
    skos:definition "Wood of the species Aesculus hippocastanum, white to pale yellowish-brown in color with a grain that is straight or spiral in pattern. It is used for furniture, turnery, and carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common horse chestnut"@en .

aat:300012052 a skos:Concept ;
    skos:definition "Wood from the chestnut tree native to Japan and other areas of Asia, Castanea crenata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese chestnut"@en .

aat:300012055 a skos:Concept ;
    skos:definition "A hard, heavy, durable heartwood wood yielded by various trees of the genus Diospyros in tropical Asia and Africa, valued for its dense, smooth-grain from the earliest times; was imported to Egypt from Nubia and the Sudan. It is extremely durable, resistant to rotting, fungi and powder post beetles, but difficult to work and carve. It has been used for decorative items, inlay work, black piano keys, musical instruments, and tool handles. Several other dark, heavy woods from unrelated species are also called ebony because of their color, including cocuswood, coffeewood, blue ebony, and African blackwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ebony"@en .

aat:300012056 a skos:Concept ;
    skos:definition "A valuable, black, hard, dense, and extremely durable wood obtained from the species Diospyros dendo of west Africa. It is used for ornamental inlays, piano keys, and turnery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black ebony"@en .

aat:300012058 a skos:Concept ;
    skos:definition "Wood of the species Diospyros ebenum. The wood beneath the trunk is pure white until the heart is reached. The heartwood excels in fineness and in the intensity of its dark color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceylon ebony"@en .

aat:300012059 a skos:Concept ;
    skos:definition "Extremely hard wood of the species Diospyros melanoxylos, native to India, having a black heartwood and a fine, even grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coromandel ebony"@en .

aat:300012060 a skos:Concept ;
    skos:definition "Wood from the species Diospyros kaki, native to China and Japan but cultivated elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaki"@en .

aat:300012061 a skos:Concept ;
    skos:definition "Wood of the species Diospyros kurzii native to India and the Andaman Islands. The heavy, durable, fine grained wood is black with yellowish stripes, forming a marble-like grain pattern. Like other ebonies, it is highly valued for furniture, inlay and decorative items; it is resistant to insects and takes a high polish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andaman marblewood"@en .

aat:300012065 a skos:Concept ;
    skos:definition "Dense, close-grain wood of several trees of the genus Diospyrus, similar in texture and straight grain to the darker ebony (from trees of the same genus), but having an off-white color. It is used for shuttles, bobbins, golf club heads, and billiard cues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "persimmon"@en .

aat:300012067 a skos:Concept ;
    skos:definition "Wood of the species Diospyros virginiana, native to North America, with wide, straw-colored commercial sapwood and a small core of black heartwood. It is heavy, strong, close-grained, and used in woodturning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common persimmon"@en .

aat:300012069 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Cornus. Although dogwoods are primarily grown as an ornamental trees, their fine-grained wood is hard and heavy, ranging in color from yellow to pinkish-brown, and has been used for small ornamental items and utilitarian objects such as skate rollers, golf club heads, pulleys, hammer handles, and in the textile industry for shuttles and spindles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogwood"@en .

aat:300012070 a skos:Concept ;
    skos:definition "Tough, durable, brown-color wood of the genus Ulmus that is used for ax handles, yokes, wheels, weapons, coffins, ships' structure, and gymnasium equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elm"@en .

aat:300012072 a skos:Concept ;
    skos:definition "Fine-grain, durable wood of the species Ulmus americana, used chiefly for ship building, ax handles, or other uses requiring a combination of strength, bending qualities, and ability to withstand rough usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American elm"@en .

aat:300012076 a skos:Concept ;
    skos:definition "Wood of the species Ulmus parvifolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese elm"@en .

aat:300012078 a skos:Concept ;
    skos:definition "Wood of the species Ulmus procera, found mainly in England and Wales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English elm"@en .

aat:300012080 a skos:Concept ;
    skos:definition "Wood of the species Ulmus thomasii, having hard wood and twigs that often develop corky ridges. The wood is the hardest and heaviest of all elms, relatively knot-free, is strong and takes a high polish. It has been used in North America and Europe for shipbuilding, furniture, agricultural tools, and musical instruments. Much of the timber's strength is derived from the tight grain arising from the tree's very slow rate of growth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock elm"@en .

aat:300012082 a skos:Concept ;
    skos:definition "Wood of the species Ulmus rubra of the northeastern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slippery elm"@en .

aat:300012085 a skos:Concept ;
    skos:definition "Wood of the species Ulmus glabra, having good strength properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wych elm"@en .

aat:300012087 a skos:Concept ;
    skos:definition "Wood yielded by the trees and shrubs of the genus Ficus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fig"@en .

aat:300012091 a skos:Concept ;
    skos:definition "General term for wood of any of several species of trees of the genera Eucalyptus, Corymbia, and Angophora that exude copious sap or gum from any break in the bark. It is tough, has an interlocking grain, and is used for mallets, furniture, and bottle cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gumwood"@en .

aat:300012093 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Eucalyptus, native to Australia, New Zealand, Tasmania, and nearby islands, used for fencing, construction, papermaking pulp, inexpensive furniture, and small turned items such as paintbrush handles. Most eucalyptus wood is durable but not dimensionally stable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eucalyptus"@en .

aat:300012094 a skos:Concept ;
    skos:definition "Wood of the species Eucalyptus pilularis of Australia. It is similar in appearance to oak, light-brown to brown in color, with the heartwood often having a pinkish tinge. It is used in bridge decking, flooring, joists, posts, rails, tool handles, and small turned articles. The wood can have a greasy feel and tends to warp and crack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackbutt"@en .

aat:300012096 a skos:Concept ;
    skos:definition "Wood of the species Eucalyptus globulus, native to Tasmania and Victoria in Australia, It has a pale-colored sapwood and a light brown heartwood, and is used in the manufacture of wharf decking, boat building, shafts, and posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue gum"@en .

aat:300012100 a skos:Concept ;
    skos:definition "Wood of the species Eucalyptus regnans, native to Tasmania and Victoria in Australia. It varies in color from almost white to pale brown, and is used in the manufacture of furniture, joinery, paneling, and flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain ash"@en .

aat:300012102 a skos:Concept ;
    skos:definition "Wood of the species Corymbia calophylla, native to Australia. It is yellowish-red in color, and is used in the manufacture of flooring, paving, and stair treads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red gum"@en .

aat:300012105 a skos:Concept ;
    skos:definition "Stiff, tough wood of the species Nyssa sylvatica, found from New Hampshire to Texas in the United States. It is hard to split. White to yellowish in color, it is used for mallets, furniture, bottle cases, pallets, baskets, boxes, veneer, barrels, and firewood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black gum"@en .

aat:300012108 a skos:Concept ;
    skos:definition "Wood of the species Nyssa ogeche, a generally uncommon North American tree. It is fine textured with large pores, and is used in the manufacture of mallets, furniture, and bottle cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ogeche tupelo"@en .

aat:300012111 a skos:Concept ;
    skos:definition "Wood of the species Nyssa biflora, found in swamps along the East coast and in the deep south of the U.S.; used for crates, furniture, and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swamp tupelo"@en .

aat:300012114 a skos:Concept ;
    skos:definition "Wood of any tree belonging to the genus Nyssa, found in North America and Asia. It is soft, light, and tough and is used in the manufacture of bridge and pier decking and construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tupelo"@en .

aat:300012123 a skos:Concept ;
    skos:definition "Wood of trees of the genus Celtis, used for lumber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hackberry"@en .

aat:300012125 a skos:Concept ;
    skos:definition "Wood of the species Celtis sinensis. It is used for furniture, cooperage, vehicle bodies, and wood ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese hackberry"@en .

aat:300012127 a skos:Concept ;
    skos:definition "Wood of the species Celtis australis. It is used for furniture, cooperage, vehicle bodies, and wood ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European hackberry"@en .

aat:300012129 a skos:Concept ;
    skos:definition "Wood of the species Celtis laevigata. It is used for furniture, cooperage, vehicle bodies, and wood ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mississippi hackberry"@en .

aat:300012132 a skos:Concept ;
    skos:definition "Wood of the small tree or shrub belonging to the genus Crataegus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hawthorn"@en .

aat:300012134 a skos:Concept ;
    skos:definition "Wood of the tree belonging to the genus Carya, valued because it is strong, elastic, and shock resistant. The reddish brown wood has a straight grain and a fine texture that polishes well; used for flooring, tool handles, farm implements, chairs, wheel spokes, golf clubs, baseball bats, and for flavoring smoked food. It is also split into thin canes for weaving. The heartwood is white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hickory"@en .

aat:300012136 a skos:Concept ;
    skos:definition "Wood of the Carya laciniosa, native from Ontario to Minnesota, Florida and Mexico. It has a white sapwood, and brown heartwood, and is used for tool handles, sporting goods, turnery, vehicle bodies, veneer, fuelwood, charcoal, and bent wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shellbark hickory"@en .

aat:300012139 a skos:Concept ;
    skos:definition "Wood from the species Carya cordiformis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitternut hickory"@en .

aat:300012141 a skos:Concept ;
    skos:definition "Wood of the species Carya texana, native to the Unites States. It is used in the manufacture of tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black hickory"@en .

aat:300012143 a skos:Concept ;
    skos:definition "Wood of the species Carya tomentosa, native to the United States. It is used for tool handles, sporting goods, turnery, and vehicle bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mockernut hickory"@en .

aat:300012148 a skos:Concept ;
    skos:definition "Wood of the species Carya illioensis, native to the southeastern United States and Mexico having reddish brown heartwood with dark brown stripes. It is used for interior millwork, handles, and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pecan"@en .

aat:300012150 a skos:Concept ;
    skos:definition "Wood of the species Carya glabra. It is used in the manufacture of tool handles and as fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pignut hickory"@en .

aat:300012153 a skos:Concept ;
    skos:definition "Wood of the species Carya ovata. It has a thick, white sapwood and reddish-brown heartwood. It is prized for ax, pick, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shagbark hickory"@en .

aat:300012156 a skos:Concept ;
    skos:definition "Wood from the genus Ilex, white or grayish-white in color and having a fine uniform texture with an irregular grain pattern. It has been used for sculpture, carvings, veneer, marquetry, engraving, and burning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holly"@en .

aat:300012158 a skos:Concept ;
    skos:definition "Wood of the genus Carpinus, used for turned and machined parts in windmills, pool cues, drumsticks, and piano actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornbeam"@en .

aat:300012159 a skos:Concept ;
    skos:definition "Wood of the species Carpinus betulus, native to Europe, Asia, and Iran. It is used for piano actions, turnery, billiard cues, and violin bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European hornbeam"@en .

aat:300012163 a skos:Concept ;
    skos:definition "Wood of the genus Ostrya, native to Eurasia and North America. It is a hard, resilient, heavy wood, used in the manufacture of fence posts and small articles such as tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hop hornbeam"@en .

aat:300012165 a skos:Concept ;
    skos:definition "Wood of the species Ostrya virginiana, native to Canada and the Untied States; used for handles, fence posts, vehicle parts, and agricultural implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American hop hornbeam"@en .

aat:300012168 a skos:Concept ;
    skos:definition "Wood of the species Ostrya carpinofolia, native to Europe. It is used locally for fence posts and small articles such as tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European hop hornbeam"@en .

aat:300012170 a skos:Concept ;
    skos:definition "Wood of any of several trees in the genus Chlorophora, native to the west coast of Africa. It is tough, dense, and very durable, often used in cabinetmaking and paneling as a substitute for teak. Iroko is a medium weight wood with an open-grain texture. The color is a brown with yellow streaks; used in structures, ship building, joinery, benches, and flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iroko"@en .

aat:300012172 a skos:Concept ;
    skos:definition "General term for exceptionally tough or hard wood from any of numerous species of trees and shrubs, such as ebony, hornbeam, or acacia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironwood"@en .

aat:300012173 a skos:Concept ;
    skos:definition "Wood of the species Mesua ferrea, native to Burma. It is a tough, hard wood, typically used for making furniture, cabinetwork, and inlay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gangaw"@en .

aat:300012176 a skos:Concept ;
    skos:definition "Wood of the species Ixora ferrea, native to the West Indies and tropical South America. It is brown in color, very hard and tough, and is used in the manufacture of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hackia"@en .

aat:300012178 a skos:Concept ;
    skos:definition "Close-grained, strong wood of the species Parrotia persica, a small tree native to Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian ironwood"@en .

aat:300012180 a skos:Concept ;
    skos:definition "Hard, heavy wood from the Brazilian species Mezilaurus itauba, having uniform texture and color, greenish olive in color when cut but becoming dark chestnut color over time. It has been used in construction, for shipbuilding, bridges, posts, beams, door and window sills, floorboards, and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "itaúba"@en .

aat:300012181 a skos:Concept ;
    skos:definition "Tough, elastic, heavy wood obtained from various species of different genera of the Annonaceae family, native to the West Indies, Jamaica, Cuba, Hispainola, and Guiana, used for wheel spokes, carriage shafts, fishing rods, and archery bows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lancewood"@en .

aat:300012184 a skos:Concept ;
    skos:definition "Wood obtained from any of several species of the genus Shorea; sold as Philippine mahogany on the American market. It is a reddish- brown wood resembling mahogany in texture, weight, and strength, but it is not dimensionally stable with changes in relative humidity. Lauan wood is used for furniture, cabinetry, veneers, and boat building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lauan"@en .

aat:300012188 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Laurus, native to India, West Pakistan and Burma. It is used extensively for making furniture, cabinet-making, interior joinery, and staircases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laurel"@en .

aat:300012193 a skos:Concept ;
    skos:definition "Wood derived from trees of the genus Guaiacum; it is generally the heaviest, hardest, and most dense type of commercially available wood, black to brownish green in color. It is tough and difficult to carve, but valued for its fine grain that polishes to a high gloss. It is naturally resistant to fungi. It is used to make pulleys, shafts, axles, and bowling balls. The wood is relatively waterproof because of its high fat content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lignum vitae"@en .

aat:300012197 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Robinia, ranging in color from yellow with a greenish tint to medium golden-brown, and used for making wheel spokes, ladder rungs, and occasionally furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locust"@en .

aat:300012201 a skos:Concept ;
    skos:definition "Wood from the species Acacia melanoxylon, reddish brown to black in color and prized for attractive grain, appearing similar to rosewood. The strong, elastic, hardwood is used for furniture, walking sticks, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australian blackwood"@en .

aat:300012206 a skos:Concept ;
    skos:definition "Heavy, dark wood of the species Robinia pseudoacacia, native to the Appalachian mountain region of the United States, and introduced into Europe, Asia, North Africa, and New Zealand as an ornamental and shade tree. It is used for making wheels, posts, gates, outdoor trim, and formerly for shipbuilding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black locust"@en .

aat:300012211 a skos:Concept ;
    skos:definition "Wood of the species Gleditsia triacanthos, native to regions in North and South America, Africa, and Asia. It produces a high quality wood that polishes well, but is lighter and weaker than most locust wood. It is used for specialty furniture, wheel spokes, and posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honey locust"@en .

aat:300012213 a skos:Concept ;
    skos:definition "Wood of the species Acacia dealbata, native to Australia and New Zealand. It is used for furniture, indoor trim, ax handles, and fruit cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver wattle"@en .

aat:300012215 a skos:Concept ;
    skos:definition "Wood of the species Heritiera javanica, native to West Africa, Thailand, and most notably the Philippines. The sapwood is pale yellowish-red with a light red to reddish-brown heartwood. It is used in the construction of cabinets, flooring, doors, boat ribs, and planking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumbayo"@en .

aat:300012217 a skos:Concept ;
    skos:definition "Heavy, durable wood from trees of the genus Magnolia, ranging in color from pale yellow to brown, used for making framing and lining of furniture, pallets, interior joinery, and boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnolia"@en .

aat:300012218 a skos:Concept ;
    skos:definition "Wood of the species Magnolia grandiflora, native to the Atlantic Coastal plain forests from Virginia to Texas. It has a creamy white sapwood, with a greenish or sometimes purplish tinge, and is used for joinery, doors, furniture, veneer, and paneling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnolia grandiflora"@en .

aat:300012221 a skos:Concept ;
    skos:definition "Refers to the wood of trees of the genus Swietenia, found in tropical climates, primarily in Mexico, Cuba, Central America, and the West Indies. It varies in color from yellow to a rich red brown, and is valued in furniture-making and sculpture-carving because it is hard, fine-grained, and takes a high polish. Mahogany has a fine, straight grain that takes a high polish. It is dimensionally stable and does not shrink, warp, or swell. The durable, dark reddish-brown wood was imported to Europe in the 18th century where it became popular for furniture, paneling and veneer. Ammonia brings out a rich, red color in mahogany wood. Mahogany is frequently attacked by pinhole borer beetles. Many woods of similar colors have also been called mahoganies, but usually do not have rich color or fine cutting characteristics of the true mahogany wood. However, the related African genus Khaya produces a similar wood. Mahogany was used by Chippendale, Hepplewhite, and the Adam brothers for high quality furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahogany"@en .

aat:300012222 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Khaya, native to Africa. It has a pink heartwood when freshly sawn, which darkens to a pinkish-brown to a deep red. It closely resembles true mahogany. It is used for making cabinets, musical instruments, veneer, furniture, boat planking and cabins, banisters, and handrails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African mahogany"@en .

aat:300012225 a skos:Concept ;
    skos:definition "Wood of the species Swietenia macrophylla, native to areas in southern North America, Central and South America. It has been introduced for cultivation in Asia. The wood is used for cabinet-making and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South American mahogany"@en .

aat:300012230 a skos:Concept ;
    skos:definition "Certain cuts of mahogany displaying a butterfly pattern in the grain, having been cut from the crotch of the tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crotch mahogany"@en .

aat:300012232 a skos:Concept ;
    skos:definition "Hard, fine-grained wood of the species Swietenia mahagoni, native to southern Florida, the Bahamas, Cuba, Jamaica, and Hispaniola. It turns reddish brown at maturity and takes a good polish. This is the species for which the term \"mahogany\" was first coined, derived from a Native American term. The wood is used for cabinet-making and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Indies mahogany"@en .

aat:300012234 a skos:Concept ;
    skos:definition "Specifically, tropical hardwood from trees of the genus Rhizophora. The wood from mangrove trees is primarily used for making charcoal or for poles in frame construction in houses. The term is also used in a general sense for wood from any tree having adaptations for living in water similar to those of genus Rhizophora."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mangrove"@en .

aat:300012236 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Acer, light reddish brown in color, with small pores, distinct rings, and rays that show as fine dashes in quarter sawed wood. Maple wood is used for fine furniture, cabinetry, flooring, shoe lasts, and musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maple"@en .

aat:300012238 a skos:Concept ;
    skos:definition "Wood of the species Acer macrophyllum, the only species native to the western United States. This commercially valuable wood is darker than that of other maples; used in the manufacture of furniture, piano actions, turnery, and musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigleaf maple"@en .

aat:300012242 a skos:Concept ;
    skos:definition "Maple wood with grain having a wavy, circular pattern with a central spot that resembles the eye of a bird. Used for veneers and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird's-eye maple"@en .

aat:300012243 a skos:Concept ;
    skos:definition "Wood of the species Acer nigrum, similar to sugar maple wood and marketed with it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black maple"@en .

aat:300012245 a skos:Concept ;
    skos:definition "Wood of the species Acer negundo, native to the northeastern North America east of the Rocky Mountains. It is used for crates, furniture, paper pulp, and charcoal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box elder"@en .

aat:300012248 a skos:Concept ;
    skos:definition "Wood of the species Acer palmatum, native to Japan. It has a creamy white sapwood that is not sharply defined from the heartwood, but it can however, have a reddish tinge. It is used in the manufacture of furniture, paneling, flooring for bowling alleys, dance halls, and warehouses, and for decorative veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese maple"@en .

aat:300012249 a skos:Concept ;
    skos:definition "Hard, strong, fine-grain wood of the species Acer rebrum, soft red in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red maple"@en .

aat:300012252 a skos:Concept ;
    skos:definition "Wood of the species Acer saccharinum, native to eastern North America and widely cultivated elsewhere. It is a soft wood, used for crating and inexpensive furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver maple"@en .

aat:300012257 a skos:Concept ;
    skos:definition "Hard, fine-grained wood of the species Acer saccharum, native to the United States and Canada. It is light reddish-brown in color and tends to have bird's eye patterns. It is used for furniture, cabinetry, flooring (dance floors, bowling alleys), musical instruments, and veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar maple"@en .

aat:300012261 a skos:Concept ;
    skos:definition "General term for any maple wood having distinct, strongly contrasting, irregular light and dark lines; the lines actually represent distorted growth, and run across the grain. Much used for musical instruments, such as violins and guitars, and fine furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiger maple"@en .

aat:300012262 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Hopea, native to Burma, Thailand, Indonesia, the Philippines, and mush of continental Southeast Asia. The sapwood is a pale yellowish-brown with a yellowish-brown to olive brown heartwood. It is used in manufacturing flooring, ceiling boards, paneling, and in ship and boat building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merawan"@en .

aat:300012264 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Quercus, of the beech family. It is a durable wood that has a distinctive coarse grain, used in cabinetry, flooring, paneling, musical instruments, ship interiors and moldings, panel painting, and sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oak"@en .

aat:300012266 a skos:Concept ;
    skos:definition "Wood of the species Quercus infectoria, native to the Near East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aleppo oak"@en .

aat:300012269 a skos:Concept ;
    skos:definition "Wood of the species Quercus velutina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black oak"@en .

aat:300012271 a skos:Concept ;
    skos:definition "Wood of the tree belonging to the genus Quercus kelloggii, the bark of which is a source of tannin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "California black oak"@en .

aat:300012273 a skos:Concept ;
    skos:definition "Wood of the species Quercus macrocarpa, native to northern and central United States. It is valued for ornamental work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bur oak"@en .

aat:300012280 a skos:Concept ;
    skos:definition "Refers specifically to the wood of the species Quercus prinus (also called Q. montana), used in making furniture. The term \"chestnut oak\" is also used informally as a general term referring to any of several species of oaks having leaves similar to chestnut trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chestnut oak"@en .

aat:300012283 a skos:Concept ;
    skos:definition "Wood of the species Quercus muehlenbergii, native to the eastern half of the United States and was early valued for railroad ties and heavy construction timbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinquapin oak"@en .

aat:300012287 a skos:Concept ;
    skos:definition "Wood of the species Quercus petraea, native to Europe and the British Isles, Asia Minor and North Africa. Used for tight cooperage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "durmast oak"@en .

aat:300012289 a skos:Concept ;
    skos:definition "Wood of the species Quercus robur, having a coarse but straight grain that is usually a rich brown color. Flat sawn timber has a distinctive figuring while radial cut lumber has silver grain lines. The wood has a high gallic acid content that will corrode iron and other contacting metals. English oak is widely used in furniture, paneling, railway sleepers, cabinet, musical instruments, and ship building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English oak"@en .

aat:300012293 a skos:Concept ;
    skos:definition "Wood of the species Quercus cerris, native to Europe and Asia Minor. It is a hard, strong wood, used for furniture, construction, coffins, wagons, boats, tools, roofing, statuary, and veneer. It is beautifully mottled due to the abundance of its silver grain; however, the wood is susceptible to cracking and splitting when drying, which sometimes restricts its use to rough work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European Turkey oak"@en .

aat:300012297 a skos:Concept ;
    skos:definition "Wood from the species Quercus laurifolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laurel oak"@en .

aat:300012299 a skos:Concept ;
    skos:definition "General term for wood of any species of evergreen oak native to the U.S., often either Quercus virginiana or Q. agrifolia. The light brown wood of live oak trees is strong and hard, once highly valued by shipbuilders. Now the trees are mainly grown as shade trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "live oak"@en .

aat:300012301 a skos:Concept ;
    skos:definition "Wood of the species Quercus agrifolia, native to the Pacific coastal regions of North America from California to the Baja peninsula. The hard wood has been used for shipbuilding and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coast live oak"@en .

aat:300012304 a skos:Concept ;
    skos:definition "Wood of the species Quercus lyrata, native to lowland wetlands in the southeastern United States, from Delaware and southern Illinois south to northern Florida and southeast Texas. It is used for flooring, furniture, and heavy construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overcup oak"@en .

aat:300012306 a skos:Concept ;
    skos:definition "Wood from the species Quercus palustris, native primarily to bottomlands and moist uplands of eastern North America, but found as far west as Oklahoma and Ontario, Canada. It is a reddish brown hard wood that shrinks and cracks with drying; sometimes sold as red oak for flooring and lumber, but it is weaker and contains more knots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pin oak"@en .

aat:300012309 a skos:Concept ;
    skos:definition "Hard, close-grained, durable wood of the species Quercus stellata, native to sandy soils of the central and southern United States. It is tough and rot-resistant, used for fence posts, rough construction, and as a fuel for barbequing meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post oak"@en .

aat:300012311 a skos:Concept ;
    skos:definition "In the lumber trade, a general term for wood of many species of oak, including Q. rubra, belonging to a subgroup of oak trees native to North and South America, characterized by having bristle-tipped leaves, acorns with hairy shell linings, and bitter seeds that mature in two seasons. Red oak wood is typically hard, coarse-grained and used commercially for flooring, furniture, cabinets, paneling, and millwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red oak"@en .

aat:300012314 a skos:Concept ;
    skos:definition "Wood of the species Quercus coccinea, native to the central and eastern parts of North America. It is a strong, reddish brown wood with a coarse grain, used for interior millwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarlet oak"@en .

aat:300012318 a skos:Concept ;
    skos:definition "Wood of the species Quercus shumardii, native to the Atlantic Coastal Plain of the U.S., and the Mississippi and Ohio river valleys. It is used for flooring, furniture, interior trim, decorative molding, paneling, and cabinetmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shumard oak"@en .

aat:300012320 a skos:Concept ;
    skos:definition "Light red wood with a coarse grain, of the species Quercus falcata native to the southeastern United States, but found from New York to Florida, Missouri, and Texas. The strong wood is used for lumber, furniture, cabinetwork, and flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southern red oak"@en .

aat:300012324 a skos:Concept ;
    skos:definition "Wood of the species Quercus bicolor, native to eastern North America. It is a strong, hard, heavy wood used in shipbuilding and furniture. Wood of the species Quercus bicolor, native to eastern North America. It is a strong, hard, heavy wood used in shipbuilding and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swamp white oak"@en .

aat:300012326 a skos:Concept ;
    skos:definition "Wood of the species Quercus macrolepis, native to the southern Mediterranean, Morocco, and Asia Minor, although the tree is primarily used for tannins from its acorns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valonia oak"@en .

aat:300012327 a skos:Concept ;
    skos:definition "Wood of the species Quercus garryana, native to the western coast of North America, particularly common in the Willamette Valley. It has a compact texture and a straight grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oregon white oak"@en .

aat:300012331 a skos:Concept ;
    skos:definition "In the lumber trade, a general term for wood of many species of oak belonging to a subgroup of oak trees, including Q. alba and others, all characterized by having acorns that mature in six months, are sweet or slightly bitter, and have a hairless inside shell. Trees are native to Europe, Asia, north Africa, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white oak"@en .

aat:300012333 a skos:Concept ;
    skos:definition "Wood of the species Olea europaea, native to the Mediterranean, the Middle East, and Africa. The dense, durable wood is yellowish to light brown with a greenish tinge and a straight, close grain. Some older trees produce wood with decorative figuring. Olive wood polishes to a smooth glossy surface. It is used for furniture, inlay, carving, turnery, and small decorative items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive"@en .

aat:300012335 a skos:Concept ;
    skos:definition "Wood of the genus Pterocarpus, native to Africa and Asia. It is typically used for cabinetwork, shipbuilding, flooring, and joinery. The hard and heavy wood is noted for its ability to take a high polish. Varieties used for cabinetwork are usually red or rose color, often variegated with yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padouk"@en .

aat:300012336 a skos:Concept ;
    skos:definition "Decorative wood from the species Andira inermis found in the West Indies. It is a reddish brown to black figured wood that is highly resistant to fungi and insects, used for making walking sticks and cabinetwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partridgewood"@en .

aat:300012338 a skos:Concept ;
    skos:definition "Wood trees belonging to the genus Pyrus, pale pinkish-brown in color with a very fine texture. It is used for making bowls, brush handles, drawing instruments, and cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pear"@en .

aat:300012340 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Malus. It is a pinkish buff wood that has a straight grain with a fine, even texture that polishes well; used for turnery, inlay, veneers, carving, handles, pipes, and cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "applewood"@en .

aat:300012345 a skos:Concept ;
    skos:definition "Wood of the species Pyrus communis, native to Europe and western Asia. It has a fine uniform texture with an irregular silvery grain. The light reddish brown wood is not resistant to outdoor weathering. It has been used for small carvings, drawing instruments, veneer, inlays, umbrella handles, wooden bowls, and T-squares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common pear"@en .

aat:300012347 a skos:Concept ;
    skos:definition "Wood from the species Malus ioensis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prairie crabapple"@en .

aat:300012349 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Platanus, pale brown in color with an even texture and fine grain. It is used for making handles for brushes, pallets, paneling, and veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plane wood"@en .

aat:300012351 a skos:Concept ;
    skos:definition "Wood of the species Platanus acerifolia. It is a hard, tough, light reddish-brown wood with a fine texture that polishes well, but can be difficult to work. It is commonly used for interiors, construction, tool handles, furniture, cabinetry, flooring, and veneers. Sold commercially as \"lacewood\" because the quarter-sawed wood has a grain pattern with characteristic flake-shaped markings, with reddish-brown rays contrasting with the lighter colored background resembling lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "London plane wood"@en .

aat:300012357 a skos:Concept ;
    skos:definition "White to yellowish-white wood of the species Acer pseudoplatanus, having a straight grain and even texture. It is native to central Europe and western Asia, but was introduced into Britain in the 15th century. It is used for turnery, bobbins, brush handles, inlays, veneer, and millwork. For other woods sometimes called simply \"sycamore,\" use \"sycamore fig\" for wood from Ficus sycamorus and \"American sycamore\" for wood from the plane tree species Platanus occidentalis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sycamore"@en .

aat:300012363 a skos:Concept ;
    skos:definition "Soft, lightweight wood of trees belonging to the genus Populus, with color ranging from white to pink or brownish. It has a uniform, straight grain, fine texture, and is easy to work but it is prone to warping. It is primarily used for paneling, light construction, packing crates, joinery, flooring, kitchen utensils, veneer, cardboard, and paper pulp, but historically was used for Italian panel paintings and for sculptures in southern Germany in the late Gothic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poplar"@en .

aat:300012365 a skos:Concept ;
    skos:definition "Section of the poplar genus comprising three to six species, depending upon the classification system. Named for for Aigeiros, Thrace, the species are native to North America, Europe, and western Asia. They are fast-growing trees with triangular, toothed leaves and cottony seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus sect. Aegiros"@en .

aat:300012366 a skos:Concept ;
    skos:definition "Wood of the species Populus nigra, so named for its blackish bark; native to Europe, southwest and central Asia, and northwest Africa.The wood is yellowish white in color, soft, easy to work, and used in the manufacture of paneling, inlay, carpentry, light construction, and paper pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black poplar"@en .

aat:300012371 a skos:Concept ;
    skos:definition "Wood of the species Populus deltoides, native to the lower Mississippi Valley. It has a soft, pale color, fine grain, uniform texture, works easily, and stains well; however, the wood has a tendency to warp. It is used for millwork, musical instruments, paneling, packing boxes, paper pulp, and excelsior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eastern cottonwood"@en .

aat:300012373 a skos:Concept ;
    skos:definition "Section of the poplar genus that includes the aspens and the white poplar, Populus alba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus sect. Populus"@en .

aat:300012374 a skos:Concept ;
    skos:definition "Soft, weak wood of the species Populus tremuloides, native to cooler areas of North America; used chiefly for paper pulp, match stems, shavings used as stuffing (excelsior), and inside construction work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American aspen"@en .

aat:300012379 a skos:Concept ;
    skos:definition "Soft, yellowish-white wood of the species Populus tremula, native to Europe and Asia. It is easy to work, but weak, prone to warping, and produces a disagreeable odor when wet. The lightweight, spongy wood is generally used for matches, excelsior, fruit crates, and paper pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European aspen"@en .

aat:300012381 a skos:Concept ;
    skos:definition "Wood of the species Populus grandidentata, grown in the northeastern United States. It has a greyish-white heartwood and light-colored sapwood, and is used in the manufacture of excelsior, matches, and paper pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigtooth apsen"@en .

aat:300012383 a skos:Concept ;
    skos:definition "General term for wood from several species of poplar trees, all having in common that they have a soft, pale color, are fine-grained with uniform texture, may be worked easily, stain well, but have a tendency to warp. Cottonwood is used for millwork, musical instruments, paneling, packing boxes, paper pulp, and excelsior (wood shavings used for stuffing)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottonwood"@en .

aat:300012386 a skos:Concept ;
    skos:definition "Wood of the Eurasian species Populus alba, native from Spain and Morocco through central Europe and central Asia. It has been widely planted in the United States. It is a soft, fine-grained, lightweight wood that is easy to work, but it is prone to warping. It has been used for paneling, light construction, and panels for paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white poplar"@en .

aat:300012388 a skos:Concept ;
    skos:definition "Section containing around 10 species of large, deciduous that are indigenous to North America and eastern Asia. They are distinguished buds emitting a balsam scent, by leaves having a white underside, and by a leaf petiole that is round in cross-section rather than flattened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus sect. Tacamahaca"@en .

aat:300012389 a skos:Concept ;
    skos:definition "Class of turpentine used as a solvent in paints, and for medicinal and perfumery purposes; obtained from Canada balsam resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canada turpentine"@en .

aat:300012393 a skos:Concept ;
    skos:definition "Wood of the species Populus balsamifera, native to the northern North America. The wood is soft, straight-grained, and weak, used primarily for crates, excelsior, pulpwood, and painted millwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balsam poplar"@en .

aat:300012397 a skos:Concept ;
    skos:definition "Wood of the species Populus tricocarpa, native to western North America. It is a light-weight wood, relatively strong for its weight, used for pulp for high-quality book and magazine paper, also for plywood, boxes, and excelsior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black cottonwood"@en .

aat:300012400 a skos:Concept ;
    skos:definition "Wood of any species of the Prunus genus, including the plum, cherry, peach, apricot, sloe, bullace, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prunus"@en .

aat:300012401 a skos:Concept ;
    skos:definition "Wood of the species Prunus dulcis, native to the Middle East and South Asia. The wood is strong and hard with a fine straight grain; it has been used for inlays, small turned articles, tools, bowls and fine cabinet work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almond"@en .

aat:300012402 a skos:Concept ;
    skos:definition "Wood of the species Prunus armeniaca, native to China, but cultivated throughout the temperate regions of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apricot"@en .

aat:300012403 a skos:Concept ;
    skos:definition "General term referring to wood of several species of the genus Prunus native to Asia, Europe, and North America. The close, even-grain wood is strong and smells like roses when freshly cut. It is brownish to light red in color but darkens on exposure. Cherry wood takes a high polish and is valued for instrument cases, furniture, veneers, cabinetry, turnery, and decorative items. It was formerly used for airplane propellers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherry"@en .

aat:300012409 a skos:Concept ;
    skos:definition "General term for wood of cherry trees found in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English cherry"@en .

aat:300012410 a skos:Concept ;
    skos:definition "Wood of the species Prunus cerasus, used for furniture and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sour cherry"@en .

aat:300012412 a skos:Concept ;
    skos:definition "Wood of the species Prunus avium, used to make high-quality furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweet cherry"@en .

aat:300012417 a skos:Concept ;
    skos:definition "Wood of the species Prunus persica, believed to have originated in China and cultivated in warmer climates throughout the world. The wood has a fine uniform texture and is reddish in color. It is occasionally used for small items such as inlay and marquetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peach"@en .

aat:300012418 a skos:Concept ;
    skos:definition "General term for wood of several trees of the genus Prunus, probably native to the region around the Caucasus and the Caspian Sea, and cultivated across the United States and Europe. The dark brownish-red wood from plum trees has been used for small decorative articles, inlays, and furniture. Plum wood is hard and strong with a straight grain and fine, uniform texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plum"@en .

aat:300012419 a skos:Concept ;
    skos:definition "Strong, elastic purplish wood derived from several species of the genus Peltogyne. The heartwood is brown when freshly cut becoming deep purple upon exposure to air, eventually turning to a dark brown with sharply demarcated off-white sapwood. Has a fine, uniform texture and grain that is straight or slightly roey. The durable, shock-resistant wood is sometimes used for carving and for vehicle construction. Also used widely in furniture-making, marquetry, veneers, flooring, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purpleheart"@en .

aat:300012422 a skos:Concept ;
    skos:definition "General term for wood of several South American trees of 10 or more different genera, all having in common that they are extremely hard. The name derives from \"axe breaker\" in Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quebracho"@en .

aat:300012424 a skos:Concept ;
    skos:definition "Wood from several tropical trees of the genus Dalbergia, all having a dark red or purplish color streaked and variegated with black. Rosewood timber produces a rose-like smell when cut. The wood has a fine grain, smooth texture, and polishes to a high gloss, but because of its resinous nature is difficult to work. It is used for cabinets, musical instruments, piano cases, and veneer. It was popular during the late 18th and early 19th centuries. It is still used to fashion xylophone bars, but waning supplies restrict its use. Only around 15 of the species in the large genus Dalbergia yield rosewood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosewood"@en .

aat:300012427 a skos:Concept ;
    skos:definition "General term for wood of several species belonging to the genus Melanorrhoea, native to Borneo. It is not a true rosewood. It is deep-red in color with light and dark streaks and has a close texture suitable for carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Borneo rosewood"@en .

aat:300012429 a skos:Concept ;
    skos:definition "Dense, reddish-brown wood with black streaks obtained from the species Dalbergia nigra, native to Brazil. Brazilian rosewood is extremely rare because the trees were overharvested in the early 20th century. It is prized as a decorative wood, formerly used in the manufacture of furniture, cabinetry, and knife-handles. It is not a true Jacaranda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brazilian rosewood"@en .

aat:300012432 a skos:Concept ;
    skos:definition "Wood of the species Albizia odoratissima, having a brown to dark brown heartwood with lighter and darker streaking. It is used for paneling, furniture, carts, wheels, farm implements, and construction timbers. Not a true rosewood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceylon rosewood"@en .

aat:300012435 a skos:Concept ;
    skos:definition "Hardwood from the species Dalbergia elanoxylon, native to the dry savanna woodlands of Africa and western India. It is lustrous dark purple or plum-colored, dense, hard, even-grained with a fine texture, and possessing good carving properties. It was used in ancient Egypt for furniture, arrowheads, tablets, chests, toys, inlays, and small figurines. It is currently used for clarinets and other woodwind instruments because due to its good resonance qualities. Not a true ebony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African blackwood"@en .

aat:300012439 a skos:Concept ;
    skos:definition "Wood from the species Dalbergia latifolia, native from the Himalayas to the southern tip of India and on the island of Java in Indonesia. The wood is fragrant and decorative, used to make premium-quality furniture, panelling, veneers and musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Indian rosewood"@en .

aat:300012443 a skos:Concept ;
    skos:definition "Wood of the species Brosimum paraense, native to tropical America. It is bright red or reddish-brown in color, has a medium texture, takes a lustrous polish, and is used in the manufacture of cabinetwork and veneer. Not a true rosewood. The term is now found primarily in older literature, and the intended source species is often unclear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satinee"@en .

aat:300012446 a skos:Concept ;
    skos:definition "Wood various trees of the genus Sassafras, native to northern temperate regions. It is a soft, lightweight, moderately coarse wood, with straight grain and uneven texture. The lumber has been used for fence posts, cabinetry, and furniture, but it cracks and splits easily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sassafras"@en .

aat:300012447 a skos:Concept ;
    skos:definition "Wood of the species Sassafras albidum, native to eastern North America. It is soft, lightweight, and moderately coarse, used for fence posts and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American sassafras"@en .

aat:300012449 a skos:Concept ;
    skos:definition "Wood of the species Sassafras radaiense, native to Taiwan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taiwan sassafras"@en .

aat:300012451 a skos:Concept ;
    skos:definition "General term for wood from several species of trees, characterized by being very hard, yellowish brown in color, and having a satiny luster; used especially for fine woodworking and tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satinwood"@en .

aat:300012453 a skos:Concept ;
    skos:definition "Wood of the species Tectona grandis, native to south and southeast Asia, including India, Indonesia, Malaysia, and Myanmar; it is cultivated in many additional areas, including Africa and the Caribbean. Teak is a golden brown wood with a straight grain and coarse texture, very resistant to insects and decay. It is used for high quality furniture, boxes, chests, doors, shipbuilding, railway carriages, veneer, and in India also for building houses. Teak wood retains an aromatic leathery smell for over a hundred years or more."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teak"@en .

aat:300012456 a skos:Concept ;
    skos:definition "Light-brown wood from of any of several trees of the genus Tilia, having a straight grain and easily worked. Linden wood is used for furniture and cabinets. Its particular structural character lends itself well to carving, allowing tools to be used both along the grain and to some extent axially. Because linden wood is soft and workable, it has been used since the 1500s for decorative items with intricate carvings, such as picture frames and sculptures. Despite its relative cost, it was the most common wood used for sculpture in Germany. During the late 15th and early 16th centuries limewood was the preferred material for the genre of the winged altarpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linden"@en .

aat:300012457 a skos:Concept ;
    skos:definition "Wood of the Tilia europaea hybrid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common lime"@en .

aat:300012461 a skos:Concept ;
    skos:definition "Wood of the species Tilia americana of the eastern United States and Canada. It varies in color from creamy-white to almost brown, and is used in the manufacture of constructional veneer, plywood, piano actions, and turnery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American linden"@en .

aat:300012467 a skos:Concept ;
    skos:definition "Wood of the species Tilia cordata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small-leafed lime"@en .

aat:300012469 a skos:Concept ;
    skos:definition "High quality, dense, figured wood from the Brazilian tulipwood tree, Dalbergia decipularis. It is creamy yellow with pink to reddish-purple stripes, and is used in the making of inlay, marquetry, and notably ornate furniture of 18th century France. It was formerly thought to come from Physocalymma scaberrima or from Dalbergia frutescens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tulipwood"@en .

aat:300012476 a skos:Concept ;
    skos:definition "Wood of several trees belonging to the genus Juglans, ranging in color from grey-brown to purple brown, used in making cabinetwork, veneer, butts and rifle stocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walnut"@en .

aat:300012478 a skos:Concept ;
    skos:definition "Wood of the species Juglans nigra native to the eastern and mid-western sections of North America, having a strong, durable, dark brown heartwood that finishes to a high polish. The sapwood is a pale yellow. The texture is coarse, but uniform and the grain is usually straight. Variations in color and waviness in grain are usually valued for decorative work. Black walnut is used for paneling, interior trim, furniture, cabinetry, clocks, propellers, gunstocks, sewing machines, piano cases, plywood, veneer, and decorative items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black walnut"@en .

aat:300012481 a skos:Concept ;
    skos:definition "Soft, yellowish-gray wood with a coarse grain from the species Juglans cinerea, ranging in color from light chestnut brown with darker zones in the heartwood to pale yellow or white in the sapwood. It polishes well and has been used for carving, furniture, and interior millwork"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butternut"@en .

aat:300012482 a skos:Concept ;
    skos:definition "Wood of the species Juglans regia, native to the Himalayas, Iran, Lebanon, Asia Minor, and Greece. It was introduced into Britain in the mid-15th century. It has a uniform, deep brown color with a medium texture and a close, straight grain. It varies considerably in color the sapwood being pale straw with grayish-brown heartwood with infiltrations of coloring producing a darker-colored streaky appearance. It is strong but easy to work and polishes to a high gloss. It is used for furniture, veneers, cabinets, paneling, gun stocks. Its burls are especially prized in the furniture trade. For the darker wood from the species Junglans nigra found in the eastern United States, use \"black walnut.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English walnut"@en .

aat:300012486 a skos:Concept ;
    skos:definition "General term for a log, piece of timber, or veneer made from areas of burls in any variety of walnut wood, that is, from areas containing overgrown knots or excrescences. Burled walnut was used as veneers on chests and high chests in the William and Mary and sometimes the Queen Anne style, made in the United States during the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burled walnut"@en .

aat:300012489 a skos:Concept ;
    skos:definition "General term applied to wood from several Brazilian species in various genera of the laurel family or of the borage family, all producing moderately heavy wood resembling walnut, the heartwood ranging in color from olive to chocolate brown and with a medium luster; valued for joinery, flooring, and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imbuia"@en .

aat:300012493 a skos:Concept ;
    skos:definition "Wood of the species Hibiscus elatus, native to Jamaica and Cuba, but widely naturalized from Florida to Trinidad and Tobago, Mexico to Peru and Brazil. The attractive, durable wood is widely used for furniture, cabinet making, inlay, picture frames, bowls, carvings, and lutes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahoe"@en .

aat:300012498 a skos:Concept ;
    skos:definition "Wood of trees of the genus Salix. The wood is tough and bends easily without splitting. In ancient Egypt, willow was used for handles, poles, bowls, boats, and domestic items. Willow has been used for Italian panel paintings and Gothic sculptures in southern Germany. Since willow wood has a low mineral content, it was favored for the production of charcoal. Other uses have included basketry, wickerwork, small turned pieces, hoops, crates, excelsior, cricket bats, artificial limbs, and agricultural implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "willow"@en .

aat:300012500 a skos:Concept ;
    skos:definition "Wood of the species Salix nigra, native to eastern North America. It varies in color from almost white to brownish-yellow, and is important in the manufacture of artificial limbs. The young, long, pliable shoots are used for wicker baskets and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black willow"@en .

aat:300012502 a skos:Concept ;
    skos:definition "General term referring to wood of several species of willow found in Japan, including Salix gilgiana, Salix cardiophylla, and Salix bakko, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese willow"@en .

aat:300012504 a skos:Concept ;
    skos:definition "Wood of the subspecies Salix lucida ssp lasandra. It is used in the manufacture of artificial limbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "western black willow"@en .

aat:300012508 a skos:Concept ;
    skos:definition "Wood of the species Salix alba, native to the British Isles, Europe, and North Asia but naturalized in the U.S. and elsewhere. It is tough, strong, and lightweight, but prone to decay. The wood is used for charcoal; the stems (withies) are used for basketmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white willow"@en .

aat:300012510 a skos:Concept ;
    skos:definition "Wood that is soft or easily cut, generally restricted to the timber of coniferous trees. Contrasted to \"hardwood,\" which is usually, but not always, harder than softwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "softwood"@en .

aat:300012512 a skos:Concept ;
    skos:definition "The wood of a fast-growing tropical bombaceous tree that is the lightest and softest wood used commercially. The white to tan-color, soft wood has a straight grain, coarse texture and is relatively strong. Balsa wood is easily carved and often used for model airplanes and toys. Balsa is also used as a substitute for cork in insulation, flats, life preservers, and buoys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balsa"@en .

aat:300012514 a skos:Concept ;
    skos:definition "Wood of any of the four species of ornamental and timber evergreen conifers of the genus Cedrus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cedar"@en .

aat:300012516 a skos:Concept ;
    skos:definition "Wood from trees of the Thuja occidentalis species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American arborvitae"@en .

aat:300012519 a skos:Concept ;
    skos:definition "Wood of the Cedrus atlantica species, having a light brown heartwood and a pungent cedar odor. It is typically used for joinery, garden furniture, gates, and fences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Atlas cedar"@en .

aat:300012522 a skos:Concept ;
    skos:definition "Wood of the Cedrus deodara species of northern India and elsewhere in the western Himalayas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deodar"@en .

aat:300012525 a skos:Concept ;
    skos:definition "Wood of the genus Calocedrus, having timber that varies in color from salmon-red to dark brown, and is used for shingles, interior trim, pencils, and posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense cedar"@en .

aat:300012528 a skos:Concept ;
    skos:definition "Wood of Cedrus libani, having a light brown heartwood and a pungent cedar odor and fairly knotty grain. It is typically used for joinery, garden furniture, gates, fences, and doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lebanon cedar"@en .

aat:300012530 a skos:Concept ;
    skos:definition "General term referring to any of several species of mahogany from South and Central America. Was mistakenly called \"cedar\" by Jesuit missionaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paraguayan cedar"@en .

aat:300012532 a skos:Concept ;
    skos:definition "Wood of Cedrela odorata (a mahogany, not true cedar) used in the United States for cigar boxes, furniture, carving, and interior trim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish cedar"@en .

aat:300012536 a skos:Concept ;
    skos:definition "Wood of Toona ciliata, a mahogany (not really cedar) of India, southeast Asia, and Australia. It is similar to Spanish cedar but is redder in color, harder, and heavier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toon"@en .

aat:300012540 a skos:Concept ;
    skos:definition "Wood of trees of the Cupressus genus, native to Asia, Africa, Europe, and the Americas, and known for its durability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cypress"@en .

aat:300012542 a skos:Concept ;
    skos:definition "Wood of the Cupressus sempervirens tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classic cypress"@en .

aat:300012545 a skos:Concept ;
    skos:definition "Wood of the Cupressus lawsoniana from the West coast of the United States. Timber is white in color with streaks of yellow and traces of red, and is used for doors, boats, matches, and patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Port Orford cedar"@en .

aat:300012551 a skos:Concept ;
    skos:definition "Wood of the Chamaecyparis thyoides tree, found along the Atlantic coastal plain from Virginia to Texas. Wood is reddish-brown, fragrant and used for shingles, mine timbers, fence posts, and other supporting structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white cypress"@en .

aat:300012555 a skos:Concept ;
    skos:definition "Wood of the Chamaecyparis nootkatensis tree, ranging from Alaska to Oregon. Timber is pale yellow in color and is prized for joinery, doors, window frames, greenhouses, shingles, and cabinet work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow cypress"@en .

aat:300012558 a skos:Concept ;
    skos:definition "Wood of the tree from the genus Abies, although other coniferous evergreen trees are commonly called firs. Timber is typically inferior to that of spruce or pine, but it is used for lumber and pulpwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fir"@en .

aat:300012560 a skos:Concept ;
    skos:definition "Wood of the tree Abies balsamea, popularly used as an ornamental and Christmas tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balsam fir"@en .

aat:300012562 a skos:Concept ;
    skos:definition "Wood from the tree, Abies fraseri, which has in the past been classified as a subspecies of balsam fir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fraser fir"@en .

aat:300012565 a skos:Concept ;
    skos:definition "Wood from trees of the genus Pseudotsuga."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Douglas fir"@en .

aat:300012576 a skos:Concept ;
    skos:definition "Wood of the tree from the genus Tsuga. The bark contains tannin, used in the tanning industry, and the timber is mostly light in color with a pinkish tinge, and the soft, and coarse-grained, used in construction of boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemlock"@en .

aat:300012578 a skos:Concept ;
    skos:definition "Wood of the Tsuga canadensis, formerly ranging from eastern Canada to northern Alabama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eastern hemlock"@en .

aat:300012585 a skos:Concept ;
    skos:definition "Wood of the Tsuga mertensiana of the northeastern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain hemlock"@en .

aat:300012588 a skos:Concept ;
    skos:definition "Wood of the Tsuga heterophylla, commonly found from Alaska to northern California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "western hemlock"@en .

aat:300012594 a skos:Concept ;
    skos:definition "Wood of the genus Juniperus, evergreen shrubs or trees, of which numerous species are found variously in the northern hemisphere; used in joinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juniper"@en .

aat:300012597 a skos:Concept ;
    skos:definition "Wood of the Juniperus procera tree of Kenya, Uganda, Tanzania, and Ethiopia. The timber is commonly used to make pencils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African juniper"@en .

aat:300012599 a skos:Concept ;
    skos:definition "Wood from the Juniperus scopulorum tree, native to western North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain juniper"@en .

aat:300012601 a skos:Concept ;
    skos:definition "General term referring to wood of many evergreen trees of the cypress family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red cedar"@en .

aat:300012604 a skos:Concept ;
    skos:definition "Wood of the genus Larix, native to cool and sub-Arctic parts of the Northern Hemisphere. Most larch timber is coarse-grained, hard, and heavy, and is used for the construction of telephone poles, mine timbers, and railroad ties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larch"@en .

aat:300012606 a skos:Concept ;
    skos:definition "Wood of Larix decidua, found from Bavaria to the Swiss Alps. Heartwood ranges in color from reddish brown to brick-red in color, and the timber is used for posts, poles, and boat planks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European larch"@en .

aat:300012609 a skos:Concept ;
    skos:definition "Wood of Larix kaempferi, native to Japan, but planted in Europe and the United Kingdom. The reddish brown timber in similar to that of the European larch, and it also used in the construction of poles and boat planks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese larch"@en .

aat:300012610 a skos:Concept ;
    skos:definition "Wood of species Larix sibirica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siberian larch"@en .

aat:300012613 a skos:Concept ;
    skos:definition "Wood from the Larix occidentalis, native to western North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "western larch"@en .

aat:300012620 a skos:Concept ;
    skos:definition "Wood from numerous trees of the genus Pinus. Pine is used largely in the construction and paper industries, although it is also a source of turpentine, resins, and oils, among other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pine"@en .

aat:300012622 a skos:Concept ;
    skos:definition "Wood of Pinus nigra, which is native to Europe and western Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austrian pine"@en .

aat:300012625 a skos:Concept ;
    skos:definition "Wood made from a Corsican variety of Austrian pine, which is found throughout Europe and western Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corsican pine"@en .

aat:300012626 a skos:Concept ;
    skos:definition "Wood made from the Pinus cubensis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cuban pine"@en .

aat:300012634 a skos:Concept ;
    skos:definition "Wood from the Pinus banksiana, found in Canada and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jack pine"@en .

aat:300012636 a skos:Concept ;
    skos:definition "Wood from the Pinus pumila, native to northeastern Asia, including Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese stone pine"@en .

aat:300012637 a skos:Concept ;
    skos:definition "Wood of the Pinus parviflora, native to Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese white pine"@en .

aat:300012638 a skos:Concept ;
    skos:definition "Wood from the Pinus jeffreyi, native to the area from southwest Oregon to northern Baja California in Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jeffrey pine"@en .

aat:300012641 a skos:Concept ;
    skos:definition "Wood from the Pinus taeda, found in the southern United States. The wood industry classifies the species as a southern yellow pine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loblolly pine"@en .

aat:300012650 a skos:Concept ;
    skos:definition "Wood from the Pinus contorta, found in western North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodgepole pine"@en .

aat:300012654 a skos:Concept ;
    skos:definition "Wood from the Pinus palustris, found in the southern United States and valued as timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longleaf pine"@en .

aat:300012662 a skos:Concept ;
    skos:definition "Wood from the Pinus strobus, native to eastern North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eastern white pine"@en .

aat:300012667 a skos:Concept ;
    skos:definition "Wood from the Pinus resinosa, found in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norway pine"@en .

aat:300012670 a skos:Concept ;
    skos:definition "Wood of the Pinus serotina, found in the wetlands of the southern United States, and is a valuable as a heavy, resinous wood used for lumber or pulpwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pond pine"@en .

aat:300012673 a skos:Concept ;
    skos:definition "Wood from the Pinus ponderosa, found in western North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ponderosa pine"@en .

aat:300012680 a skos:Concept ;
    skos:definition "Wood from the Pinus sylvestris, native to Eurasia and imported to North America. The Scotch pine has tough, light brown wood. Its lumber is used for millwork and it is an important conifer for timber in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scotch pine"@en .

aat:300012694 a skos:Concept ;
    skos:definition "Wood from Pinus virginiana, a dwarf pine of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jersey pine"@en .

aat:300012699 a skos:Concept ;
    skos:definition "Wood from the Pinus echinata, a timber tree of the southern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shortleaf pine"@en .

aat:300012707 a skos:Concept ;
    skos:definition "General term for the wood any of several species of yellow pine tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southern yellow pine"@en .

aat:300012711 a skos:Concept ;
    skos:definition "Wood from Pinus lambertiana, the largest living pine tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar pine"@en .

aat:300012713 a skos:Concept ;
    skos:definition "Wood from any of several species of cypress, pine, or cedar having reddish wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redwood"@en .

aat:300012716 a skos:Concept ;
    skos:definition "Wood of the Metasequoia glyptostroboides, native to the Sichuan-Hubei region of China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dawn redwood"@en .

aat:300012718 a skos:Concept ;
    skos:definition "Wood from the Sequoiadendron giganteum, found in California and Oregon, United States. The thick, reddish brown bark is fire resistant. Its wood is light weight, soft and brittle. It is not used as timber and is currently a protected species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giant sequoia"@en .

aat:300012721 a skos:Concept ;
    skos:definition "Wood from the Sequoia sempervirens, found along the California coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coast redwood"@en .

aat:300012724 a skos:Concept ;
    skos:definition "A compact close-grained fragrant yellowish wood that is yielded by trees in the genus Santalum, typically used for its essential oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandalwood"@en .

aat:300012726 a skos:Concept ;
    skos:definition "Wood from any of the species of evergreen spruce trees, forming the genus Picea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spruce"@en .

aat:300012728 a skos:Concept ;
    skos:definition "Wood from Picea mariana, found in North America. It is a yellow, lightweight wood with a straight grain logged primarily as pulp wood, but also used for piles, posts, and ship construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black spruce"@en .

aat:300012731 a skos:Concept ;
    skos:definition "Wood from Picea pungens, found in western North America. The wood is weak and brittle, used locally for log cabins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue spruce"@en .

aat:300012746 a skos:Concept ;
    skos:definition "Wood of the Picea abies, native to northern Europe and used as a timber and ornamental tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norway spruce"@en .

aat:300012753 a skos:Concept ;
    skos:definition "Wood from Picea rubens, native to North America. It was a major source of lumber for building construction in the 18th and 19th centuries. It was also used for piano sounding boards and for pulpwood. This tree was almost lost to overharvesting, but was protected by a government act in 1911 which purchased considerable land for national forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red spruce"@en .

aat:300012760 a skos:Concept ;
    skos:definition "Wood from Picea sitchensis, found along the coast of western North America. It is soft, pale reddish brown color wood with a straight grain. The stiff wood is used for millwork, boxes, musical instruments, boats, airplanes, ladders, and paper pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sitka spruce"@en .

aat:300012764 a skos:Concept ;
    skos:definition "Wood of Picea engelmannii, found in western North America. soft, It is a light wood, yellowish to reddish, and fine-grained; used for lumber, millwork, construction, and the manufacture of paper and boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Engelmann spruce"@en .

aat:300012765 a skos:Concept ;
    skos:definition "Wood from the Picea smithiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Himalayan spruce"@en .

aat:300012768 a skos:Concept ;
    skos:definition "Wood of Picea glauca, native to North America. It is a soft, pale-yellow wood that has a straight grain used for lumber, millwork, and pulp wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white spruce"@en .

aat:300012774 a skos:Concept ;
    skos:definition "Wood of trees of the genus Taxus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yew"@en .

aat:300012777 a skos:Concept ;
    skos:definition "Wood derived directly from forest trees, such as lumber, posts, poles, pulp, plywood, particleboard, fiberboard, excelsior, and others, including items such as furniture and woven wood baskets that made directly from tree saplings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary wood"@en .

aat:300012778 a skos:Concept ;
    skos:definition "Wood processed and used as a raw material for manufactured items, including paper products, wooden furniture, doors, decorative paneling, siding, moldings, knobs, toys, musical instruments, laminated beams, tool handles, and others. Distinguished from \"primary wood,\" which is wood derived directly from forest trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary wood"@en .

aat:300012781 a skos:Concept ;
    skos:definition "Continuous, curly, fine wood shavings employed as stuffing for furniture, packing material for breakable articles, and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excelsior"@en .

aat:300012782 a skos:Concept ;
    skos:definition "Material comprising long, thin lengths of wood or metal used in roofing and other construction work, used to make backing supports for the application of the finished surfaces in a room, roof, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furring strip"@en .

aat:300012784 a skos:Concept ;
    skos:definition "The unhewn portion of a felled tree, including a length cut off for use as firewood, construction, or another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log"@en .

aat:300012785 a skos:Concept ;
    skos:definition "Material cut from timber to sizes and forms suitable for structural use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumber"@en .

aat:300012787 a skos:Concept ;
    skos:definition "Wood used in the construction of the foundation of a building or other structure, particularly as used for the temporary or permanent molds into which concrete or similar materials are poured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "form lumber"@en .

aat:300012791 a skos:Concept ;
    skos:definition "Lumber machined and surfaced at a mill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressed lumber"@en .

aat:300012793 a skos:Concept ;
    skos:definition "Lumber that is shaped to a pattern or molded form, along with being dressed, matched, shiplapped, or any combination of these workings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patterned lumber"@en .

aat:300012794 a skos:Concept ;
    skos:definition "Lumber whose edge is dressed and shaped for a tongue-and-groove joint when pieces are laid edge to edge or end to end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matched lumber"@en .

aat:300012798 a skos:Concept ;
    skos:definition "Lumber that has not been dressed since it was sawed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough lumber"@en .

aat:300012801 a skos:Concept ;
    skos:definition "Lumber that in addition to being dressed has been matched, shiplapped, or patterned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worked lumber"@en .

aat:300012803 a skos:Concept ;
    skos:definition "Wood cut at a tangent to the annual growth rings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain sawed lumber"@en .

aat:300012805 a skos:Concept ;
    skos:definition "Lumber that has been sawed so that the wide surfaces extend approximately at right angles to the annual growth rings. Lumber is considered edge grained when the rings form an angle of 45 degrees to 90 degrees with the wide surface of the piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter-sawed lumber"@en .

aat:300012807 a skos:Concept ;
    skos:definition "Lumber that has been dried by exposure to air in a yard or shed, without artificial heat"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-dried lumber"@en .

aat:300012811 a skos:Concept ;
    skos:definition "Freshly sawed or undried lumber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green lumber"@en .

aat:300012812 a skos:Concept ;
    skos:definition "Lumber that has been dried with the use of artificial heat in a kiln (oven)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiln-dried lumber"@en .

aat:300012814 a skos:Concept ;
    skos:definition "Lumber that does not contain blemishes or knots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clear lumber"@en .

aat:300012815 a skos:Concept ;
    skos:definition "A term commonly applied to wide boards (12 inches to 16 inches in width) of lightweight clear wood, such as cedar, redwood, or white pine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boat lumber"@en .

aat:300012816 a skos:Concept ;
    skos:definition "Lumber cut to a particular size and stocked for the building industry; usually 2 to 5 inches thick and 5 to 12 inches wide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimension lumber"@en .

aat:300012819 a skos:Concept ;
    skos:definition "Lumber intended to be cut up for use in further manufacture. It is graded on the percentage of the area that will produce a limited number of cuttings of a specified minimum size and quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory lumber"@en .

aat:300012821 a skos:Concept ;
    skos:definition "In carpentry, boards with few defects and suitable for fine finished work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "select lumber"@en .

aat:300012822 a skos:Concept ;
    skos:definition "Lumber that is intended for use in building where allowable properties are required. The grading of structural lumber is based on the strength or stiffness of the piece as related to anticipated uses, such as lumber that is 5 inches or more in both thickness and width."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural lumber"@en .

aat:300012825 a skos:Concept ;
    skos:definition "Wood in the form of long, wide, square-sawn, smooth, flat pieces. A plank is typically characterized by being a length of timber sawn for building or other purposes to a thickness of from two to six inches, a width of nine inches or more, and eight feet or upwards in length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plank"@en .

aat:300012827 a skos:Concept ;
    skos:definition "Wood of standing trees of a type or quality suitable for use by humans in construction, furniture making, or for other purposes. For dressed wood, use \"timber (wood by form).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timber"@en .

aat:300012828 a skos:Concept ;
    skos:definition "Lumber up to 5 inches thick intended for general building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yard lumber"@en .

aat:300012829 a skos:Concept ;
    skos:definition "Lumber used for the fine work required to complete a building, especially the interior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finish lumber"@en .

aat:300012831 a skos:Concept ;
    skos:definition "Stock comprising pieces of material that are small or otherwise of non-standard dimensions. As applied to timber, usually denotes the sectional dimensions (thickness and breadth) in contradistinction to the length, of a square-edged piece of nonstandard dimensions. For a block of stone, a piece measured in all three dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scantling"@en .

aat:300012832 a skos:Concept ;
    skos:definition "Planed and patterned lumber for finish work in buildings, including items such as sash, doors, cornices, panelwork, and other items of interior or exterior trim. Does not include flooring, ceiling, or siding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millwork"@en .

aat:300012833 a skos:Concept ;
    skos:definition "Wood suitable for making paper pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulpwood"@en .

aat:300012834 a skos:Concept ;
    skos:definition "Wood in the state of small particles, detached from a tree, plank, etc. in the process of sawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawdust"@en .

aat:300012835 a skos:Concept ;
    skos:definition "Shingle or clapboard formed by splitting a short log into tapered radial sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shake"@en .

aat:300012837 a skos:Concept ;
    skos:definition "Medium-sized solid material made by cutting, chipping, or chopping larger pieces of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodchips"@en .

aat:300012841 a skos:Concept ;
    skos:definition "Wood which has been impregnated with resin and subjected to a high pressure to increase its density and strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compressed wood"@en .

aat:300012844 a skos:Concept ;
    skos:definition "Wood impregnated with thermosetting resin then subjected to heat and pressure to provide both resin curing and compression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impregnated wood"@en .

aat:300012848 a skos:Concept ;
    skos:definition "A plywood board in which veneer layers used in the core are replaced by blocks of wood, the direction of grain of the blocks running at right angles to that of the adjacent veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blockboard"@en .

aat:300012849 a skos:Concept ;
    skos:definition "Wood board consisting of a number of thin layers of rotary-cut veneers glued together so that the grain of each layer is at right angles to the grain of the adjacent layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plywood"@en .

aat:300012855 a skos:Concept ;
    skos:definition "Material in the form of thin facing sheets intended to be used for a decorative purpose or to cover a cheaper material, glued to the surface of an inferior base material. Materials may include wood, brick, stone, plaster, ivory, tortoiseshell, brass, or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneer"@en .

aat:300012860 a skos:Concept ;
    skos:definition "Plant material that has been altered in composition or structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modified plant material"@en .

aat:300012861 a skos:Concept ;
    skos:definition "A complex natural carbohydrate, or polysaccharide, composed of long, connected chains of glucose molecules, forming the primary component in the cell walls of plants. Pure cellulose is an odorless, tasteless white powder. Cellulose exists in three forms: alpha, beta and gamma. Cellulose is used to manufacture paper and textiles, and as a raw material in rayon, cellophane, cellulose acetate, and celluloid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulose"@en .

aat:300012862 a skos:Concept ;
    skos:definition "A black, porous carbonaceous material comprising the carbon-containing residue from burned wood (e.g., willow, maple, beech, linden or plum) or other organic containing materials such as bone, plants or animals. It is used as a drawing material, for filtering liquids or air, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal"@en .

aat:300012864 a skos:Concept ;
    skos:definition "Refers to partially consumed pieces of wood, which, in the context of art, are generally used as a material for drawing. Charcoal produced from wood that is as homogeneous as possible gives a porous and not very adhesive stroke. It is also fashioned into pointed charcoal pencils to create thin lines, used broadside to produce evenly toned areas, and applied with rubbing and pulverizing to create dimmed intermediate shades and delicate transitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood charcoal"@en .

aat:300012865 a skos:Concept ;
    skos:definition "Fiber-like charcoal that occurs in thin layers adjacent to bituminous coal, commonly found in thin silvery-black layers. It is extremely soft and crumbles readily into a fine, sootlike powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fusain"@en .

aat:300012866 a skos:Concept ;
    skos:definition "Carbohydrate containing exudates obtained from some trees or shrubs belonging to the family Fabaceae of the pea order Fabales. Gum is insoluble in alcohol and either soluble or swellable in water. Some plant gums are used in the form of water solutions in the manufacture of cosmetics, pharmaceuticals, and foods; when the water evaporates, a film having a considerable adhesive character is formed. Some gums, such as gum arabic, dissolve in water to give clear solutions. Other gums, such as gum tragacanth, form mucilages by the absorption of large amounts of water. May be distinguished from \"resin\" in that gum hardens in drying, but is usually soluble in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum"@en .

aat:300012867 a skos:Concept ;
    skos:definition "A clear, pale gum that exudes from apricot trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apricot gum"@en .

aat:300012868 a skos:Concept ;
    skos:definition "Gum from a cherry tree that is used as a binder for pigments, often as a substitute for gum arabic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherry gum"@en .

aat:300012869 a skos:Concept ;
    skos:definition "Water-soluble gum that is exuded by two species, Senegalia senegal and Vachellia seyal, which were formerly classified under genus Acacia. Gum arabic is used in inks, paints, adhesives, pharmaceuticals, confections, and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum arabic"@en .

aat:300012873 a skos:Concept ;
    skos:definition "Gummy exudate from various species of the genus Sterculia, notably from S. urens, a tree native to central and northern India. It occurs as tears of variable size and of a somewhat crystalline appearance, translucent, pale yellow, with a slightly acetic odor and a mucilaginous, slightly acetic taste. The gum is insoluble in alcohol, but swells in water to form a gel; it forms an extremely strong adhesive with small amounts of water. It is used as a dye thickener, textile coating, emulsifier, paper fiber binder, a base in marbling paper, medical adhesive, a denture adhesive, a thickener and emulsifier in foods, and as a laxative. It is also used to adulterate gum tragacanth due to their similar physical characteristics. Gum karaya has been available commercially only since 1920."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum karaya"@en .

aat:300012875 a skos:Concept ;
    skos:definition "The balsam exudate obtained from several North American trees, including the longleaf pine, Pinus palustris, the Cuban pine, Pinus caribaea, and the loblolly pine, Pinus taeda. Gum thus is a thick, yellowish, sticky mass with a characteristic piney odor. It is used as an additive in oil paints, an insecticide, a polish, and as an antiseptic agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum thus"@en .

aat:300012876 a skos:Concept ;
    skos:definition "An exudate from several species of shrubs of the genus Astragalus, especially Astragalus gummifer, found in the dry regions of Iran, Iraq, Syria, and Turkey. The use of gum tragacanth dates from pre-Christian times. It used for textile sizing, printing, pastel crayon production, leather curing, furniture polishes, as an emulsifying, suspending, and thickening agent, pharmaceutically as a demulcent (coating) and as a binding agent in pill manufacture, and in processed foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum tragacanth"@en .

aat:300012878 a skos:Concept ;
    skos:definition "Gum from some species of Astragalus or Penaea, mentioned in ancient writings and also in English 18th- and early 19th-century painting recipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarcocolla"@en .

aat:300012879 a skos:Concept ;
    skos:definition "The soft, fleshy internal part of a fruit or vegetable, or the soft pith in the interior of a stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulp"@en .

aat:300012880 a skos:Concept ;
    skos:definition "Wood pulp made by boiling wood with caustic soda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soda pulp"@en .

aat:300012881 a skos:Concept ;
    skos:definition "An aqueous mass of wood fibers, primarily used for making paper. Wood pulp is produced by either physical grinding (mechanical wood pulp) or by chemical digestion (chemical pulp)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood pulp"@en .

aat:300012882 a skos:Concept ;
    skos:definition "General term for solid or semisolid organic substance usually obtained from plant secretions, but sometimes obtained from insects or synthetically produced. It is soluble in organic solvent but not in water, and is commonly used in varnish, printing ink, and size. It is distinguished from \"gum\" by not being dissoluble in water. To distinguish between natural and synthetic resins, use the narrower terms \"natural resin\" or \"synthetic resin.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resin"@en .

aat:300012883 a skos:Concept ;
    skos:definition "A red or yellow resin obtained from the base of Tasmanian and Australian grass trees of the Xanthorrhoea family; different species produce different colors of resin. The resins are chemically similar to balsams and contain some cinnamic acid; they produce hard, insoluble films. They are used for varnishes, metal lacquers, surface finishes for leather and paper, substitutes for rosin, sealing waxes, and inks. Treatment with sulfuric acid produces a lightfast brown-black dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acaroid resin"@en .

aat:300012891 a skos:Concept ;
    skos:definition "An oleoresinous exudate from coniferous trees, especially of the Pinus genus. Balsams have been used since antiquity for medicinal purposes and as sealers. The exudate is a soft, semi-liquid consisting of terpenes of resinous character and a large amount of essential oils. Upon distillation, a liquid portion, called turpentine, and a solid residue, called rosin, are produced. Balsams have been used in varnishes and paint mediums; however, they deteriorate easily unless a harder resin is mixed with them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balsam"@en .

aat:300012895 a skos:Concept ;
    skos:definition "A turpentine produced from the steam distillation of the balsam from the French Maritime pine tree, Pinus maritinus. It has a fine, light odor, long having had a reputation as the best material for paintings. The raw balsam, called Bordeaux turpentine, also produces the non-distilled residue called \"Burgundy pitch,\" which is used as a cement. A turpentine produced from the steam distillation of the balsam from the French Maritime pine tree, Pinus maritinus. It has a fine, light odor, long having had a reputation as the best material for paintings. The raw balsam, called Bordeaux turpentine, also produces the non-distilled residue called \"Burgundy pitch,\" which is used as a cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burgundy turpentine"@en .

aat:300012896 a skos:Concept ;
    skos:definition "The non-distilled residue created from the creation of Burgundy turpentine, which is the steam distillation of the balsam from the French Maritime pine tree, Pinus maritinus. Used as a cement and as a coating for bronzes during the Italian Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burgundy pitch"@en .

aat:300012897 a skos:Concept ;
    skos:definition "A crystal clear, resinous exudate from the Canadian balsam fir, Abies balsamea, native to northeastern North America. Canada balsam was introduced in Europe in the 18th century. It was used for as varnish, but was found to bloom in moist conditions and darken with age. It is currently used to permanently mount microscopy specimens and as an adhesive for optical lenses. Its softening point is slightly above room temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canada balsam"@en .

aat:300012898 a skos:Concept ;
    skos:definition "A viscous, oleoresin obtained from South American deciduous trees of the genus Copaifera, native to the Amazon valley and banks of the Orinoco river. The volatile oil and resin contain one or more of the followings acids: illuric, metacopaivic, copaivic, and oxycopaivic. Copaiba balsam was brought to Europe in the 17th century for medicinal use; in the mid-19th century it was used with ethanol vapor as a varnish cleaner for oil paintings with blanched and cracked surfaces, and in the early 20th century as a glossy additive in paint media, although use has been discontinued because it produced damaging long-term effects. Copaiba balsam is currently used to make tracing and photographic papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copaiba balsam"@en .

aat:300012901 a skos:Concept ;
    skos:definition "A viscous, oleoresin obtained from South American deciduous trees of the genus Copaifera native to Venezuela, containing 40% copaiba oil. A viscous, oleoresin obtained from South American deciduous trees of the genus Copaifera native to Venezuela, containing 40% copaiba oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maracaibo balsam"@en .

aat:300012902 a skos:Concept ;
    skos:definition "A viscous, oleoresin obtained from South American deciduous trees of the genus Copaifera native to Brazil, containing 60-90% copaiba oil. A viscous, oleoresin obtained from South American deciduous trees of the genus Copaifera native to Brazil, containing 60-90% copaiba oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "para balsam"@en .

aat:300012903 a skos:Concept ;
    skos:definition "An aromatic oleoresin obtained from the red pine, Pinus resinosa, from trees in the Vosges mountains in France. An aromatic oleoresin obtained from the red pine, Pinus resinosa, from trees in the Vosges mountains in France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jura turpentine"@en .

aat:300012904 a skos:Concept ;
    skos:definition "A dark brown oleoresin obtained from Myroxylon balsamum var. pereirae trees that are native to the coastlines of Central America. Peru balsam contains high amounts of cinnamic acid, benzoic acid, and vanillin. It is used for perfumes and flavorings. Peru balsam has also been used as a dark brown glaze for paintings. Peru balsam is very similar to Tolu balsam, dervied from a variety of the same species. A dark brown oleoresin obtained from Myroxylon balsamum var. pereirae trees that are native to the coastlines of Central America. Peru balsam contains high amounts of cinnamic acid, benzoic acid, and vanillin. It is used for perfumes and flavorings. Peru balsam has also been used as a dark brown glaze for paintings. Peru balsam is very similar to Tolu balsam, dervied from a variety of the same species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peru balsam"@en .

aat:300012906 a skos:Concept ;
    skos:definition "An aromatic, thick, viscous exudation obtained from several Central European fir trees, including Abies alba. Strasbourg turpentine contains about 57% resinous acids, 28% terpenes, and 13% resins. It is similar to Venice turpentine and has been used since the 16th century as an additive to oil paints, mastic, and other varnishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strasbourg turpentine"@en .

aat:300012907 a skos:Concept ;
    skos:definition "A thick, brown oleoresin obtained from Myroxylon balsamum var. balsamum trees that are native to the high plains of Venezuela, Columbia and Peru. Tolu balsam is used for perfumes, chewing gums, as a dark brown transparent glaze for paintings. It is similar to Peru balsam and derived from a variety of the same species. A thick, brown oleoresin obtained from Myroxylon balsamum var. balsamum trees that are native to the high plains of Venezuela, Columbia and Peru. Tolu balsam is used for perfumes, chewing gums, as a dark brown transparent glaze for paintings. It is similar to Peru balsam and derived from a variety of the same species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tolu balsam"@en .

aat:300012908 a skos:Concept ;
    skos:definition "A thick, viscous exudation from the Austrian larch tree, Larix decidua, containing 63% resinous acids, 20% terpenes, and 14% resins. It has been used since the 16th century in small amounts to produce an enamel-like surface that is non-yellowing. However, it is not used as a varnish because it quickly becomes dark and brittle when exposed to oxygen and light. It is also used as a mounting medium for light microscopy and as a plasticizer in glue paste linings. A thick, viscous exudation from the Austrian larch tree, Larix decidua, containing 63% resinous acids, 20% terpenes, and 14% resins. It has been used since the 16th century in small amounts to produce an enamel-like surface that is non-yellowing. However, it is not used as a varnish because it quickly becomes dark and brittle when exposed to oxygen and light. It is also used as a mounting medium for light microscopy and as a plasticizer in glue paste linings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venice turpentine"@en .

aat:300012909 a skos:Concept ;
    skos:definition "A dark, pleasant smelling oleoresin obtained from trees of the genus Styrax, including S. benzoin and S. officinalis, growing in Thailand, Malaysia, and Indonesia. Benzoin resin was used by the 16th century as a spirit varnish for paintings. It is also used as a plasticizer for varnishes and lacquers, a perfume, an antiseptic, and a deodorizer. Benzoin resin is not the same as the chemical called \"benzoin,\" which is a powder obtained from benzaldehyde. For a brown, sticky, aromatic resin obtained from trees of the genus Liquidambar, use \"storax.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benzoin"@en .

aat:300012910 a skos:Concept ;
    skos:definition "General term for a variety of hard, natural resins obtained directly from various tropical trees of the genera Hymenaea and Agathis. Copal is a characterized as a hard, translucent odoriferous resinous substance in an intermediate stage of polymerization and hardening between gummy resins and amber. Copals contain communic acids, communol, resene, and volatile oil. They range in color from colorless to a bright yellow-brown. The term was first applied to the substance obtained from Mexico; but copal is now procured also from Brazil, the West Indies, West Africa, Mozambique and Zanzibar, Madagascar, India, Manila, New Caledonia, and New Zealand. Copal from East Africa is most highly valued, particularly the partially fossilized varieties. Copal is used as incense, flavoring, medicines, and in making varnish, lacquer, adhesive, and coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copal"@en .

aat:300012912 a skos:Concept ;
    skos:definition "A medium hard variety of copal resin obtained from both living trees and as fossil resin from the genus Copaifera in western Africa. Congo copal is insoluble in most organic solvents until it has been thermally treated. It forms transparent gels with some alcohols, hot oils and and hot solvents. Congo copal is used in varnishes and paints for metal surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Congo copal"@en .

aat:300012917 a skos:Concept ;
    skos:definition "A medium-hard variety of copal resin obtained from the kauri pine, Agathis australis, native to New Zealand. It is a pale yellow to reddish brown resin with a piney odor. Kauri can be collected as a resin or found in fossilized deposits; today it is scarce. It was widely used in the early 20th century for floor and furniture varnishes, in adhesives, enamels, and linoleum. A medium-hard variety of copal resin obtained from the kauri pine, Agathis australis, native to New Zealand. It is a pale yellow to reddish brown resin with a piney odor. Kauri can be collected as a resin or found in fossilized deposits; today it is scarce. It was widely used in the early 20th century for floor and furniture varnishes, in adhesives, enamels, and linoleum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kauri"@en .

aat:300012918 a skos:Concept ;
    skos:definition "A soft variety of copal resin obtained from species Agathis dammara native to the Philippines and Indonesia. It is used for varnishes and resin/oil media, and in many fixative recipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manila copal"@en .

aat:300012920 a skos:Concept ;
    skos:definition "A medium-hard, pale yellow variety of copal resin obtained from trees of the genus Copaifera native to Sierra Leone, Guinea, and Ghana. It has been used in varnishes. A medium-hard, pale yellow variety of copal resin obtained from trees of the genus Copaifera native to Sierra Leone, Guinea, and Ghana. It has been used in varnishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sierra Leone copal"@en .

aat:300012921 a skos:Concept ;
    skos:definition "A variety of copal resin that is hard and found on the island of Zanzibar and areas of nearby African mainland. It is derived from either semi-fossilized specimens or as exudations on species Hymenaea verrucosa. The most valued pieces are fossilized specimens found embedded in the earth over a wide belt of East Africa on the western coast of Zanzibar, on tracts where not a tree is now visible. Zanzibar copal is a very hard, smooth, and shiny resin that is used to make a dark oil varnish, for fumigation, and in perfumery. Some specimens of Zanzibar copal are misrepresented as amber. A variety of copal resin that is hard and found on the island of Zanzibar and areas of nearby African mainland. It is derived from either semi-fossilized specimens or as exudations on species Hymenaea verrucosa. The most valued pieces are fossilized specimens found embedded in the earth over a wide belt of East Africa on the western coast of Zanzibar, on tracts where not a tree is now visible. Zanzibar copal is a very hard, smooth, and shiny resin that is used to make a dark oil varnish, for fumigation, and in perfumery. Some specimens of Zanzibar copal are misrepresented as amber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zanzibar copal"@en .

aat:300012922 a skos:Concept ;
    skos:definition "Any of various resins obtained from various trees of the genera Shorea, Agathis, or Hopea, growing in the East Indies, New Guinea, and New Zealand. It is obtained by tapping trees or, more rarely, from fossilized specimens from the ground. The gum varies in color from clear to pale yellow, while the fossilized form is grey-brown. Dammar is used as a glazing or clouding agent in cooking, as incense, for caulking ships, and as varnish, especially as a picture varnish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dammar"@en .

aat:300012925 a skos:Concept ;
    skos:definition "General term referring to various dammar resins that were formerly shipped under the tradename \"Batavia\" from Jakarta (formerly Batavia), Indonesia. General term referring to various dammar resins that were formerly shipped under the tradename \"Batavia\" from Jakarta (formerly Batavia), Indonesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Batavia dammar"@en .

aat:300012926 a skos:Concept ;
    skos:definition "Dammars shipped under the tradename \"Singapore\" from the island of Singapore. Singapore dammar is paler than Batavian dammar and has less tendency to bloom. Dammars shipped under the tradename \"Singapore\" from the island of Singapore. Singapore dammar is paler than Batavian dammar and has less tendency to bloom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Singapore dammar"@en .

aat:300012927 a skos:Concept ;
    skos:definition "General term for a very pale yellow or straw-colored dammar from trees of the genus Hopea, considered one of the highest grades of dammar. It is no longer sold commercially. Yellow in color and often sold in round balls, thus the name \"cat's eye.\" General term for a very pale yellow or straw-colored dammar from trees of the genus Hopea, considered one of the highest grades of dammar. It is no longer sold commercially. Yellow in color and often sold in round balls, thus the name \"cat's eye.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cat's eye dammar"@en .

aat:300012929 a skos:Concept ;
    skos:definition "A transparent, resinous exudation, red in color, derived from several plants in 4 genera, having in common the primary red coloring component dracorubin. Dragon's blood is available as red sticks, cakes, or as a powder, and was traded as early as Roman times. It is used medicinally as an astringent, as a red colorant in medieval manuscript illuminations, to stain varnishes for violins, as a colorant for plaster, marble, and paints, and as a resist in photoengraving to protect zinc plates from acid. The red color is fugitive when exposed to light and air, but may be partially protected by a resin film layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragon's blood"@en .

aat:300012930 a skos:Concept ;
    skos:definition "A soft, sticky, fragrant resin derived from trees of the family Burseraceae. Elemi is used in lacquer, lithographic inks, textile coatings, paper coatings, perfume bases, and waterproofing. It has been used as a plasticizer in varnishes, but the components responsible for its initial malleability (mono- and sesquiterpenoids) evaporate and it eventually hardens to a brittle film. The term was imprecisely used in the 17th and 18th centuries to describe many oleoresin mixtures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elemi"@en .

aat:300012931 a skos:Concept ;
    skos:definition "Malleable resin with a pungent odor obtained from the Pili tree, Canarium indicum of Indo-Malaysia. Malleable resin with a pungent odor obtained from the Pili tree, Canarium indicum of Indo-Malaysia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manila elemi"@en .

aat:300012933 a skos:Concept ;
    skos:definition "A natural resin, such as amber and some copals, that originated from prehistoric coniferous trees that are now extinct. Fossil resins are generally dug from the ground or stream beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fossil resin"@en .

aat:300012934 a skos:Concept ;
    skos:definition "A yellowish, hard, glassy, translucent fossil tree resin found in largest deposits on the Baltic coast and dating 40-60 million years old. Types of amber are classified by location. Amber is composed of complex mixtures of oxidized and polymerized resin acids and resin alcohols. It has been gathered or mined since Paleolithic times. It is easy to carve and was often used in its natural state for jewelry, beads, amulets, and small vessels. It was also used as an ingredient in paint; dark color oil and amber varnishes are made by dissolving melted amber in amber oil, turpentine oil, or a drying oil. It develops an electrical charge when rubbed with a cloth. It is also valued because very ancient insects and plants may be preserved in the amber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amber"@en .

aat:300012935 a skos:Concept ;
    skos:definition "A fossil resin ranging in age from early Eocene to early Oligocene, originating in areas along the Baltic Sea and containing succinic acid (usually 3-8%). Around 40 varieties of amber are recognized, divided into two main groups: those containing succinic acid make up the succinite group and those having little or no succinic acid belong to the retinite group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "succinite"@en .

aat:300012938 a skos:Concept ;
    skos:definition "The thick, resinous exudation from the species Pinus pinaster of southern Europe, especially France. Galipot is similar to Venice turpentine (a balsam) and can be distilled to produce oil of turpentine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galipot"@en .

aat:300012939 a skos:Concept ;
    skos:definition "Translucent golden-colored resin composed of a yellow resinous component and a clear water-soluble gum, produced by several trees of the genus Garcinia native to India, Thailand, Cambodia, Vietnam, and Sri Lanka. Gamboge was used as a yellow pigment as early as the 8th century in Asia and Japan. It was regularly imported to Europe in the 17th century. It is marketed in the form of dull, brownish-yellow cakes or lumps that, when powdered, have a rich golden color. The carbohydrate gum acts as a natural binder. Gamboge is used as a transparent colorant in glazes, varnishes, and watercolors. The yellow color fades when exposed to light or ozone. In some cases it has recovered its color when placed in the dark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gamboge"@en .

aat:300012940 a skos:Concept ;
    skos:definition "A vegetable secretion of shrubs and trees, consisting of a resin mixed with gum mucilage. Gum resin is generally insoluble in water, but dissolvable in alcohol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum resin"@en .

aat:300012941 a skos:Concept ;
    skos:definition "A natural hydrocarbon polymer formed from the resinous latex of trees of the Hevea and Parthenium genera. To prepare natural rubber, the latex is collected from a cut in the bark, precipitated with acid, then washed and dried. Rubber is very elastic and was used for bowls, shoe soles, adhesives, and bouncy balls. However, when cooled, rubber becomes brittle and when warmed it becomes sweaty and tacky. Prior to the development of synthetic resins, unvulcanized rubber was used for adhesive tapes and crepe shoe soles. In 1839, Charles Goodyear discovered that rubber can be hardened with the vulcanization process in which sulfur is used to initiate crosslinking of the hydrocarbon strands. Higher sulfur content produces a harder, denser material. Vulcanized rubber is used to make rubber bands, foams, fabric coatings, small objects, combs, pens, and musical instruments. Vulcanized rubber, however, will emit sulfur when exposed to light or heat causing the rubber to degrade and become brittle. Since the 19th century, small amounts of wax have been added to the rubber during vulcanization. The wax slowly migrates to the surface and provides a thin layer of protection from oxidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubber"@en .

aat:300012943 a skos:Concept ;
    skos:definition "Resin from true juniper trees, of the genus Juniperus. For the resin of the genera Callitris and Tetraclinis, which is sometimes called \"gum juniper,\" use \"sandarac.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juniper resin"@en .

aat:300012946 a skos:Concept ;
    skos:definition "A resinous substance excreted by the lac insect, especially those who live on the twigs and soft new branches of several varieties of soapberry and acacia trees. Lac is used in the manufacture of varnishes (shellac), sealing wax (lac wax), and red colorants (lac dye) as early as ca. 1200 BCE in India. The word \"lac\" is the English version of Persian and Hindi words meaning \"hundred thousand,\" indicating the large number of the tiny insects required to produce lac."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lac"@en .

aat:300012949 a skos:Concept ;
    skos:definition "A sticky, black residue obtained from the distillation of coal tar, petroleum, or pine tar. Pitch is used as a sealant and wood preservative as well as a component in roofing, paving, and water proofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitch"@en .

aat:300012950 a skos:Concept ;
    skos:definition "The solid, brittle, clear resinous residue left after the distillation of turpentine from balsam, having a color ranging from yellow or reddish-brown. It becomes sticky when warm and has a faint pine-like odor. Primarily composed of abietic acid (about 80%), rosin reacts in hot alkaline solutions to form rosin soaps. Rosin weathers poorly, becoming oxidized and brittle with age. It also has poor moisture resistance. Although many of its aging properties are undesirable, rosin is or was used as an ingredient in paints, varnishes, inks, adhesives, sealing wax, soldering fluxes, sizing paper, and linoleum. Because it increases sliding friction, it is commonly used for coating bows of some stringed instruments, and as a slip preventative on the floors of stages and shoes of dancers. The inexpensive resin is also used for sizing paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosin"@en .

aat:300012953 a skos:Concept ;
    skos:definition "A modified natural resin made from rosin that has been esterified by heating with a polyhydric alcohol, such as glycerol. Ester gum contains the glyceryl, methyl, and ethyl esters of rosin acids. Ester gum is lighter in color than rosin and have a higher softening point but lower acid number. It is not used in artist paints or varnishes although they have been tried for wax-resin linings. It is used instead of copal, dammar, or kauri in making enamels, paints, nitrocellulose lacquers, and tung oil mixtures. A modified natural resin made from rosin that has been esterified by heating with a polyhydric alcohol, such as glycerol. Ester gum contains the glyceryl, methyl, and ethyl esters of rosin acids. Ester gum is lighter in color than rosin and have a higher softening point but lower acid number. It is not used in artist paints or varnishes although they have been tried for wax-resin linings. It is used instead of copal, dammar, or kauri in making enamels, paints, nitrocellulose lacquers, and tung oil mixtures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ester gum"@en .

aat:300012954 a skos:Concept ;
    skos:definition "A pale yellow natural resin from the Callitris genus that is native to Australia and from the species Tetraclinis articulata that native to northern Africa. Although sometimes called \"gum juniper,\" sandarac is not derived from true junipers of genus Juniperus (see \"juniper resin\"). Drops of resin, \"sandarac tears,\" are hard and brittle with a white powdery surface due to oxidation, the substance forms a clear, hard film that becomes darker and redder with age. Sandarac spirit varnishes dry quickly and have been used for retouching, making protective and decorative coatings, and as an artists' paint vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandarac"@en .

aat:300012957 a skos:Concept ;
    skos:definition "Material comprising the juice or circulating fluid of a plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sap"@en .

aat:300012958 a skos:Concept ;
    skos:definition "Any of a group of glycosides obtained from plants that gives a soapy lather with water. Saponin is obtained from several unrelated species, including the bark of the soap bark tree, the roots of the soap plant, the fruit of the soapberry tree, and the leaves of the soapwort plant. Saponins have been used since ancient times as a natural cleaner. Uses include in solution as a mild detergent for cleaning dirt and smoke from paintings. It is poisonous to fish or if injected into the bloodstream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saponin"@en .

aat:300012959 a skos:Concept ;
    skos:definition "Substance made of carbohydrate granules of varying sizes obtained from roots, bulbs, and seeds of most plants. Starch is primarily obtained from rice, wheat, corn, potatoes, cassava (tapioca), sago, and arrowroot. It is a mixture of the soluble straight-chain amylose molecules and the insoluble, branched-chain amylopectin molecules. When starch is heated, the granules swell and form a thick, tacky jelly upon cooling. Starchy adhesives have been used since at least 3500 BCE in Egypt. More recently starch has been used for sizing fabric, canvas, and paper, as an adhesive for paper cartons, bottle labels, gummed tape, and envelopes. Soluble starch has been used for priming canvas and as a binder in watercolor paints. Starch is sensitive to moisture and biodegradation. Starchy paste films become brittle with age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starch"@en .

aat:300012960 a skos:Concept ;
    skos:definition "A beady starch obtained from the tuberous roots of the cassava plant, Manihot esculenta, native to tropical America. The roots are leached then dried and ground. The starch has irregularly shaped kernels; when heated with water it forms a thick stringy solution that gets thinner with heating time. It thickens only slightly on cooling to form a translucent gel. It is used for food, a thickening agent in cooking, laundry starch, and as adhesive for stamps, envelopes, labels, and plywood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassava"@en .

aat:300012964 a skos:Concept ;
    skos:definition "General term for certain mineral inflammable substances that are native hydrocarbons, more or less oxygenated, whether liquid, semi-solid, or solid. Examples include naphtha, petroleum, asphalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bituminous material"@en .

aat:300012966 a skos:Concept ;
    skos:definition "The dark, brownish-black bituminous resin that is found in natural deposits or is produced as a byproduct of oil refineries. It has consistencies varying from viscous liquid to glassy solid. It is composed of aliphatic, alicyclic, and polycyclic aromatic hydrocarbons. It is soluble in oils and waxes and can act as a plasticizer or a strengthener, depending on the hardness of the variety. Natural asphalt, which is believed to have been formed during an early stage in the breakdown of organic marine deposits into petroleum, characteristically contains minerals, while residual petroleum asphalt does not. Asphalt has been used since the 3rd millennium BCE for waterproofing; it is also used for road paving, roof coating, joint sealing, and a waterproof barrier in sandy soils. Ancient sources for asphalt were Egypt, the north end of the Dead Sea, the Is river northwest of Babylon, and the Greek island of Zante."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphalt"@en .

aat:300012969 a skos:Concept ;
    skos:definition "Asphalt mixture of 13-60 percent bitumens with finely pulverized mineral fillers, usually limestone. It differs from natural asphalt by the presence of paraffin and a greater content of petroleum oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial asphalt"@en .

aat:300012970 a skos:Concept ;
    skos:definition "Asphalt obtained from the refining of petroleum; the heavier or more viscous portions of certain crude oils are asphalts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petroleum asphalt"@en .

aat:300012976 a skos:Concept ;
    skos:definition "Any of various solid or semisolid mixtures of hydrocarbons that occur in nature or that are obtained as residues from the distillation of petroleum or coal. For the blackish hydrocarbon portion of asphalt, use \"asphaltic bitumen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitumen"@en .

aat:300012979 a skos:Concept ;
    skos:definition "A variety of natural asphalt having a black color, brilliant luster, brittle consistency, and conchoidal fractures. It is found only in the Uinta Mountains of Utah. The term \"gilsonite\" was originally a registered trademark in the late 19th century. It is used in black varnishes, lacquers, baking enamels, japans, linoleum, floor tile, and paving where it increases resistance to acids, alkalis, and water. In the early 19th century, gilsonite was often mixed with mica, asbestos, gums, or resins to produce electrical components. It is also the first solid hydrocarbon to be converted to gasoline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilsonite"@en .

aat:300012980 a skos:Concept ;
    skos:definition "Natural asphalt that is collected in pits or lakes, often a rather elastic variety of asphalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lake asphalt"@en .

aat:300012981 a skos:Concept ;
    skos:definition "Porous rock such as sandstone or limestone that has become impregnated with natural asphalt through a geological process, so that the asphalt has more than 10% minerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock asphalt"@en .

aat:300012985 a skos:Concept ;
    skos:definition "An emulsion of asphalt cement and water, that contains a small amount of emulsifying agent. The amount of asphalt in emulsion will depend upon the grade and type, but is typically 55-65% by volume. Uses include surfacing floors, painting pipes, and waterproofing concrete walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emulsified asphalt"@en .

aat:300012987 a skos:Concept ;
    skos:definition "Natural or modified asphalt or an asphalt aggregate intended for use as a binder in asphalt concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paving asphalt"@en .

aat:300012989 a skos:Concept ;
    skos:definition "Cutback asphalt composed of asphalt cement and a naptha or gasoline-type diluent of high volatility, which evaporated rapidly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rapid-curing asphalt"@en .

aat:300012990 a skos:Concept ;
    skos:definition "Cutback asphalt composed of asphalt cement and oils of low volatility and slow evaporation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slow-curing asphalt"@en .

aat:300012991 a skos:Concept ;
    skos:definition "Thick, viscous, brown or black, inflammable liquid residue resulting from the partial evaporation or distillation of wood (such as pine, fir, or larch), sugar, tobacco, peat, coal, or other organic substance. It contains hydrocarbons, resins, alcohols, and other compounds; it has a heavy resinous or bituminous odor. It is used as an antiseptic, for coating asphalt roads, preserving timber, caulk on wooden sailing ships, waterproofing for roofing papers, insecticide, in disinfectant soaps. Some tars, such as those obtained from pine or beech wood, have been mixed with linseed oil to form a dark brown glaze and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tar"@en .

aat:300012992 a skos:Concept ;
    skos:definition "Black viscous liquid with a naphthalene odor obtained by the distillation of bituminous coal. It can be separated into several fractions: gasoline, oil, creosote, and pitch. Coal tar is used in the manufacture of plastics, aniline dyes, for waterproofing, paints, roofing, roads, and as a pesticide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal tar"@en .

aat:300012996 a skos:Concept ;
    skos:definition "Wood tar produced by distilling pine wood, used in wood preservatives and medicinal products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pine tar"@en .

aat:300012998 a skos:Concept ;
    skos:definition "Substance obtained by melting rosin with pine tar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navy pitch"@en .

aat:300013001 a skos:Concept ;
    skos:definition "Complex mixture of hydrocarbons that occurs naturally beneath the earth's surface, viscous yellow to black in color. Petroleum is refined (i.e.,separated by distillation) into useable fractions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petroleum"@en .

aat:300013003 a skos:Concept ;
    skos:definition "A colorless, liquid hydrocarbon obtained in the fractional distillation of petroleum which is used chiefly as a motor fuel but also as a solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasoline"@en .

aat:300013006 a skos:Concept ;
    skos:definition "Compressed gas that consists of flammable hydrocarbons such as propane and butane, and is used especially as fuel or as raw material for chemical synthesis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquefied petroleum gas"@en .

aat:300013008 a skos:Concept ;
    skos:definition "A four carbon saturated alkane hydrocarbon that occurs naturally in petroleum. It is used in high performance liquid fuels for household and industrial purposes, as a propellant in aerosols, and as a raw material for synthetic polymers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butane"@en .

aat:300013009 a skos:Concept ;
    skos:definition "Any of three types of isometric paraffin hydrocarbon found in petroleum and natural gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pentane"@en .

aat:300013010 a skos:Concept ;
    skos:definition "Liquefied petroleum gas, marketed under pressure in steel cylinders as bottled gas; used especially in cook stoves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propane"@en .

aat:300013011 a skos:Concept ;
    skos:definition "A chemical compound obtained or derived industrially from petroleum or natural gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petrochemical"@en .

aat:300013013 a skos:Concept ;
    skos:definition "A soft, greasy, translucent, semi-solid mixture of hydrocarbons, obtained from petroleum and used as an ointment and lubricant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petroleum jelly"@en .

aat:300013017 a skos:Concept ;
    skos:definition "The white resin of the species Cinnamomum camphora, used for hardening nitrocellulose plastic. Camphor is also in pharmaceuticals, disinfectants, and explosives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camphor"@en .

aat:300013018 a skos:Concept ;
    skos:definition "Colorless gas (CO2) with a sharp odor; it is a minor component in the earth's atmosphere, does not support combustion, dissolves in water to form carbonic acid, is formed in animal respiration and in the decay or combustion of animal and vegetable matter, and is absorbed from the air by plants in photosynthesis. Carbon dioxide is used as a refrigerant and is found in carbonated beverages and fire extinguishers, among other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon dioxide"@en .

aat:300013019 a skos:Concept ;
    skos:definition "An odorless, colorless, tasteless, and highly poisonous gas produced by the incomplete combustion of carbon-containing materials. It is used in organic synthesis and metallurgy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon monoxide"@en .

aat:300013020 a skos:Concept ;
    skos:definition "A flammable, colorless gas with a strong, suffocating odor; first synthesized in 1859, but it occurs naturally in coal and wood smoke, as an outdoor air pollutant in large cities, and found in indoor environments from items such as new particle board, freshly laid carpet, foam, adhesives, insulation, and new fabrics. Formaldehyde is a powerful reducing agent reacts with many materials on contact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formaldehyde"@en .

aat:300013021 a skos:Concept ;
    skos:definition "Viscous, milk-like fluid composed of resin or wax in the form of tiny globules in aqueous suspension, obtained especially from rubber trees; used for many rubber applications, such as adhesive. Use also for a water dispersion of synthetic rubber and of rubberlike plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latex"@en .

aat:300013022 a skos:Concept ;
    skos:definition "Any of the large group of fats, oils, waxes, sterols, and triglycerides that occur in living organisms and are characteristically soluble in certain organic solvents but only partially soluble in water; they are oily to the touch. With carbohydrates and proteins, lipids are one of three types of materials that compose living cells. The structure of lipids range from simple straight chain hydrocarbon to complex ring structures. They can be subdivided as 1) fatty acids, 2) neutral fats, 3) phospholipids, 4) glycolipids, 5) aliphatic alcohols and waxes, 6) terpenes, and 7) steroids. Any of the large group of fats, oils, waxes, sterols, and triglycerides that occur in living organisms and are characteristically soluble in certain organic solvents but only partially soluble in water; they are oily to the touch. With carbohydrates and proteins, lipids are one of three types of materials that compose living cells. The structure of lipids range from simple straight chain hydrocarbon to complex ring structures. They can be subdivided as 1) fatty acids, 2) neutral fats, 3) phospholipids, 4) glycolipids, 5) aliphatic alcohols and waxes, 6) terpenes, and 7) steroids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lipid"@en .

aat:300013023 a skos:Concept ;
    skos:definition "An ester of a long-chain fatty acid (such as stearic acid or palmitic acid), of plant or animal origin, that is that is nonvolatile, insoluble in water, oily or greasy to the touch, and solid at room temperature. Chemically, fats are identical to animal and vegetable oils, consisting primarily of glycerides, which are esters formed by the reaction of three molecules of fatty acids with one molecule of glycerol. Pure fats are colorless, odorless, tasteless and will float on water. Examples of natural fats are butter, lard and tallow. Fats may be hydrolyzed with an alkali to form soap in a process called saponification. Fats are also used in leather tannage, paints, and protective coatings. An ester of a long-chain fatty acid (such as stearic acid or palmitic acid), of plant or animal origin, that is that is nonvolatile, insoluble in water, oily or greasy to the touch, and solid at room temperature. Chemically, fats are identical to animal and vegetable oils, consisting primarily of glycerides, which are esters formed by the reaction of three molecules of fatty acids with one molecule of glycerol. Pure fats are colorless, odorless, tasteless and will float on water. Examples of natural fats are butter, lard and tallow. Fats may be hydrolyzed with an alkali to form soap in a process called saponification. Fats are also used in leather tannage, paints, and protective coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fat"@en .

aat:300013024 a skos:Concept ;
    skos:definition "A viscous oily liquid that is found in certain animal and vegetable matter. Lecithins are composed of a mixture of diglycerides of fatty acids (stearic, palmitic, oleic, linolenic and linoleic) linked to the choline ester of phosphoric acid. Commercially, lecithin is obtained from soybean, corn, and egg yolk. It is used for emulsifying, dispersing, and wetting, added to food products, paints, printing inks, plastic molding as a release agent, textiles as a lubricant, and leather as a dressing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lecithin"@en .

aat:300013029 a skos:Concept ;
    skos:definition "Compounds generally made up of complex organic materials that dissolve or are suspended in a liquid that absorbs into and colors another material. Distinguished from pigments, which are insoluble in the vehicle, but instead are held in a suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dye"@en .

aat:300013032 a skos:Concept ;
    skos:definition "A class of dyes extracted from plant and animal sources. Natural dyes can be derived from leaves, branches, fruits, flowers, or roots of some plants, as distinguished from dyes manufactured from artificial chemical processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural dye"@en .

aat:300013034 a skos:Concept ;
    skos:definition "A colorant that is obtained from a vegetable source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable dye"@en .

aat:300013042 a skos:Concept ;
    skos:definition "Yellow dye obtained from the berry of several species of buckthorn shrubs. The water-soluble dye was used in textiles, wood stains, and lake pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckthorn dye"@en .

aat:300013055 a skos:Concept ;
    skos:definition "A natural dark blue colorant obtained from the tropical Indigofera tinctoria plants. The use of indigo was first mentioned in Indian manuscripts in the 4th century BCE; it was first exported to Europe in Roman times. The natural material is collected as a precipitate from a fermented solution of the plant, where the coloring component, indigotin, is extracted as a colorless glycoside that turns blue with oxidation. Indigo is a fine, intense powder which may be used directly as a pigment in oil, tempera, or watercolor media. Since the exposed pigment can fade rapidly in strong sunlight, it is rarely used in art or fine textiles today. However, it is still used to dye jeans, where its fading and uneven coloring have become favorable characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigo"@en .

aat:300013056 a skos:Concept ;
    skos:definition "Natural dyestuff used to test the acidity of chemical solutions; also used as a textile dye, wood stain, and food colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litmus"@en .

aat:300013060 a skos:Concept ;
    skos:definition "A green natural dyestuff of Chinese origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lokao"@en .

aat:300013062 a skos:Concept ;
    skos:definition "A natural organic colorant extracted from the roots of any of several species of the genus Rubia, having a reddish color. Madder has been used as a colorant for dyeing textiles since ancient times in India, Persia, and Egypt. It has been largely replaced as a dye and a pigment by synthetic alizarin. Used for dye and lake pigment preparation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madder"@en .

aat:300013065 a skos:Concept ;
    skos:definition "A yellow natural dyestuff obtained from several East Indian mulberry trees and shrubs of the genus Morinda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morinda"@en .

aat:300013066 a skos:Concept ;
    skos:definition "A natural dye that is bright red to rich purple color, obtained from any of several lichens; used as a pigment, textile dye, wood stain, food colorant, and an indicator dye that turns blue in alkaline solutions. It was by the ancient Egyptians; the preparation was rediscovered by the Italians and used to make the brilliant red and purple Florentine cloth. In the18th century a Scottish chemist C. Gordon patented the process, which he called \"cudbear.\" The dark red color in archil is formed when lecanoric acid is converted to orcein by fermentation then oxidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archil"@en .

aat:300013072 a skos:Concept ;
    skos:definition "A red or yellow natural colorant prepared from the dried petals of the safflower plant, Carthamus tinctorius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safflower"@en .

aat:300013073 a skos:Concept ;
    skos:definition "A fugitive yellow natural dyestuff prepared from the dried flowers of Crocus sativus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saffron"@en .

aat:300013075 a skos:Concept ;
    skos:definition "A natural purple colorant and dye obtained from the seeds of Chrozophora tinctoria. It is not lightfast. Turnsole is an acid-base indicator dye that is red in acid and blue to violet in alkalis. It was used as a violet watercolor pigment in 14th century Italian manuscripts and as a purple textile dye from medieval times to the 17th century. It is used as a food colorant, as in Dutch cheese and certain liquors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turnsole"@en .

aat:300013076 a skos:Concept ;
    skos:definition "A natural red dye obtained from the plant Ventilago maderaspatana native to the East Indies, having poor lightfastness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ventilago"@en .

aat:300013077 a skos:Concept ;
    skos:definition "Bright yellow natural dyestuff extracted from the flowers, leaves and stems of the dyer's rocket plant, Reseda luteola. Weld has been used since Roman times and was widely cultivated in Europe during the Middle Ages. It was the most popular yellow dye until it was replaced by quercitron, made from oak bark, in the 18th century, and then by synthetic dyes in the 19th century. The primary coloring matter in weld is luteolin, which is extracted in a hot alkaline solution made with boiling water and potash. Depending on the mordant, weld produces colors ranging from bright yellow (using tin) to gold (using aluminum) to green (using iron). Although weld has the best lightfastness of any natural yellow, it still is not permanent. Weld was used to dye wool and silk, stain wood, and make lake pigments used in miniature paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weld"@en .

aat:300013080 a skos:Concept ;
    skos:definition "A natural dark blue colorant obtained from the leaves of the biennial Isatis tinctoria plant. It was used as a painting pigment in the Middle Ages. It is chemically and in color similar to indigo. To produce the colorant, the plant leaves were cut, dried, and rolled into balls (woad balls) to age for about one month. Then the balls were crushed to a fine powder, sprinkled with water, and piled in heaps for fermentation. The blue color deepened with the age of the plant, ranging from a light blue in young leaves to a dark bluish black in fully ripe leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woad"@en .

aat:300013081 a skos:Concept ;
    skos:definition "A natural yellow dyestuff obtained from the wood of Cotinus coggygria, having poor lightfastness. The primary coloring compounds are fisetin and myricetin. It was used for textiles and shading during the Middle Ages, but was rarely used after the 16th century. This is not the same dye stuff as \"fustic\" (\"old fustic\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "young fustic"@en .

aat:300013085 a skos:Concept ;
    skos:definition "Colorant made from kermesic acid that is extracted from the dried bodies of female kermes insects. Kermes dye was used since ancient times. It contains 18-32% tannins and is used for making a dark color leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kermes"@en .

aat:300013086 a skos:Concept ;
    skos:definition "Semi-transparent liquid obtained from the gall bladders of cattle. Used in cleaning, painting, and formerly for medicinal purposes. Contains sodium choleate salts (taurochloate and glycochloate) with some cholesterol, lecithin, and other substances. Examples of use include as a wetting agent in watercolor, in marbling, engraving, lithography, textile dyeing, and as a plasticizer in glue-paste mixtures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxgall"@en .

aat:300013087 a skos:Concept ;
    skos:definition "Purple or reddish dye historically made by the ancient Phoenicians using mucus from the hypobranchial gland of either of two species of sea snails.This dye is a rare animal-produced organobromine compound, which the snails make using a specific bromoperoxidase enzyme that operates on dissolved bromide in sea water. Used in Greek and Roman times for dyeing togas and in the Middle Ages for decorating manuscripts. The mollusks secrete a yellowish liquid that oxidizes to a purplish red in bright sunlight; each mollusk only produces one drop of colorant so large numbers were needed to produce enough dye for an entire cloth, making the dye was very expensive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tyrian purple"@en .

aat:300013088 a skos:Concept ;
    skos:definition "A colorant made from a synthetic base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic dye"@en .

aat:300013093 a skos:Concept ;
    skos:definition "A red colorant extracted along with purpurin from the roots of the madder plant; it is one of ten distinct isomers of dihydroxy anthraquinone. It has been used as a dye and pigment since ancient times. The colorant was first isolated in 1862 by Colin and Robiquet in France; For the synthetic colorant first produced in 1869, use \"synthetic alizarin.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alizarin"@en .

aat:300013094 a skos:Concept ;
    skos:definition "Dye produced from aniline, a poisonous, oily liquid. Used to make the earliest synthetic dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aniline dye"@en .

aat:300013098 a skos:Concept ;
    skos:definition "A synthetic aniline dyestuff that was only the second synthetic dye material to be produced from coal tar derivatives. Magenta is a dark green water soluble powder that oxidizes to forms a deep purplish red fugitive dye used to color textiles, leather, and to stain bacteria. It was formerly used in watercolor paints but has since been replaced by colors with better lightfastness properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magenta"@en .

aat:300013101 a skos:Concept ;
    skos:definition "A delicate purple aniline dye; one of the earliest synthetic dyes. When chemist William Henry Perkin was working to create artificial quinine, he noticed a residue that became the first aniline dye (mauveine), sometimes called aniline purple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mauve"@en .

aat:300013104 a skos:Concept ;
    skos:definition "A reddish variety of mauve, which is an aniline dye that typically is light purple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pink mauve"@en .

aat:300013105 a skos:Concept ;
    skos:definition "A group of blue, green and violet dyes with a molecular structure having a central carbon atom connecting three aromatic rings, used as basic dyes for wool and silk, with mordants for cotton, and in some artist paints labeled brilliant. They only have fair lightfastness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl dye"@en .

aat:300013107 a skos:Concept ;
    skos:definition "Dye that is dissolved in oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil soluble dye"@en .

aat:300013109 a skos:Concept ;
    skos:definition "Any relatively insoluble organic, inorganic, natural or artificial substance that imparts a color to another substance or mixture and always appears as the same specific color when viewed in white light. It is the constituent of paint or ink that provides the color. Distinguished from a dye, which is soluble in the vehicle, a pigment is insoluble in the vehicle, but instead is held in a suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigments"@en .

aat:300013111 a skos:Concept ;
    skos:definition "Refers to pigment not containing carbon, ultimately not derived from vegetable or animal sources. Examples of sources of inorganic pigments include clay earth and malachite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic pigment"@en .

aat:300013113 a skos:Concept ;
    skos:definition "Pigment created through chemical manufacturing rather than by grinding and washing natural materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic pigment"@en .

aat:300013115 a skos:Concept ;
    skos:definition "Pigments derived from natural mineral sources. They are among the oldest pigments used by humans, used in the funeral preparation of human remains from as early as 60,000 years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural inorganic pigment"@en .

aat:300013118 a skos:Concept ;
    skos:definition "A general classification of white or colorless pigments that are used as fillers and diluents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inert pigment"@en .

aat:300013120 a skos:Concept ;
    skos:definition "Refers to pigment containing carbon, ultimately derived from vegetable or animal sources. Examples of sources of organic pigments include cow urine, leaves of plants, and calcined bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic pigment"@en .

aat:300013121 a skos:Concept ;
    skos:definition "Pigment derived from animal or plant sources, used for art, bodily ornamentation, cosmetics, and other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural organic pigment"@en .

aat:300013122 a skos:Concept ;
    skos:definition "Pigment occurring in animals, particularly those extracted and used for dyes or colorants by humans, such as dyes from marine animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal pigment"@en .

aat:300013123 a skos:Concept ;
    skos:definition "Pigment comprising colored molecules synthesized by photosynthetic organisms. Natural organic dyes and colorants may be obtained from the stems, roots, and flowers of plants. Colored materials from plants have been used by humans since ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant pigment"@en .

aat:300013125 a skos:Concept ;
    skos:definition "Water-soluble glycosides comprising pigments occurring in all tissues of higher plants, including leaves, stems, roots, flowers, and fruits. They appear red, purple, or blue depending on the pH. They are used as pH indicators and pigment for art. As lake pigments, they are unstable and insoluble. Examples include pelargonidin, cyanidin, peonidin, delphinidin, petunidin, and malvidin, derived from myrtle berries, blackberries, peonies, delphinium, petunia, elderberry, and other sources. They are odorless, nearly flavorless, but moderately astringent to taste. For the plant, they are used to attract pollinators or seed-dispersing animals; they may perform a function complementary to that of green chlorophyll in photosynthetically active tissues. Natural organic coloring compounds, notably the red coloring of buds and young shoots and the purple and purple-red colors of autumn leaves, which only becomes apparent when the green chlorophyll decomposes with the approach of winter. Anthocyanin pigment for art and other uses is derived from seeds and flowers, for example myrtle berries, blackberries, peonies, delphinium, petunia, and elderberry. These compounds do not form stable insoluble lake pigments. They are water soluble glycosides, red, blue, or violet in color. Examples include pelargonidin, cyanidin, peonidin, delphinidin, petunidin, and malvidin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthocyanin"@en .

aat:300013126 a skos:Concept ;
    skos:definition "A natural orange-yellow colorant widely distributed as pigments in plants and animals and converted in the livers of many animals into vitamin A. In plants, carotene imparts yellow, orange, or red colors to flowers (e.g., dandelion, marigold), fruits (e.g., pumpkin, apricot), and roots (e.g., carrot, sweet potato). In animals they are visible in fats (e.g., butter), egg yolks, feathers (e.g., canary), and shells (e.g., lobster). These pigments are unsaturated hydrocarbons (having many double bonds), belonging to the isoprenoid series. Carotene occurs naturally in three isomeric forms, the most common being beta-carotene. As a colorant, it is sensitive to light and air; soluble in fats, oils and other substances, insoluble in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carotene"@en .

aat:300013127 a skos:Concept ;
    skos:definition "Green pigment found in found in virtually all photosynthetic organisms, including plants and various green water-animalcules. It is involved in photosynthesis, which is the process by which light energy is converted to chemical energy through the synthesis of organic compounds: it absorbs energy from light; this energy is then used to convert carbon dioxide to carbohydrates. Pure chlorophyll appears as waxy dark green to black crystals. Chlorophyll has been used as a green colorant in clothing, soaps, leathers, waxes, foods, liquors, and perfumes. It is also used as a sensitizer for color film and as a deodorizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chlorophyll"@en .

aat:300013128 a skos:Concept ;
    skos:definition "Dark biological pigment (biochrome) that produces buff, red-brown, brown, and black colors. Melanin occur widely in the feathers of birds; in hair, eyes, and skin of mammals, including humans; in skin or scales of many fishes, amphibians, and reptiles; in the ink of cephalopods (octopus, squid); and in various tissues of many invertebrates. Melanin protects the skin from ultraviolet radiation, and an increase in melanin is responsible for the so-called tanning of human skin exposed to sunlight. It is used as a colorant, particularly as it occurs in cuttlefish ink. Dark biological pigment (biochrome) that produces buff, red-brown, brown, and black colors. Melanin occur widely in the feathers of birds; in hair, eyes, and skin of mammals, including humans; in skin or scales of many fishes, amphibians, and reptiles; in the ink of cephalopods (octopus, squid); and in various tissues of many invertebrates. Melanin protects the skin from ultraviolet radiation, and an increase in melanin is responsible for the so-called tanning of human skin exposed to sunlight. It is used as a colorant, particularly as it occurs in cuttlefish ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melanin"@en .

aat:300013129 a skos:Concept ;
    skos:definition "Pigments comprising carbon-based molecules manufactured from petroleum compounds, acids, and other chemicals, usually under intense heat or pressure. Many are not sufficient for permanent painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic organic pigment"@en .

aat:300013135 a skos:Concept ;
    skos:definition "Includes Lampblack, Ivory black, Mars black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black pigment"@en .

aat:300013136 a skos:Concept ;
    skos:definition "Pigment that is dark or black in color and derived from plants, such as carbon black, or sometimes from animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic black pigment"@en .

aat:300013138 a skos:Concept ;
    skos:definition "Material made of intensely black, finely divided forms of amorphous carbon, usually obtained as soot from partial combustion of hydrocarbons. It is used to produce extremely black pigments of high hiding power in printing ink, paint, and carbon paper, as reinforcing agents in rubber products, and to create protective coatings, plastics, and resistors for electronic circuits. Carbon black particles are usually spherical in shape and less regularly crystalline than graphite. Carbon black changes into graphite if heated at 3,000 degrees Celsius for a prolonged period. Among the most finely divided materials known, carbon blacks vary widely in particle size and color intensity depending upon the process by which they are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon black"@en .

aat:300013147 a skos:Concept ;
    skos:definition "Material created by charring animal bones, black in color. Bone black is composed of about 10% carbon and 84% calcium hydroxyapatite along with smaller amounts of magnesium phosphate and calcium carbonate. It is used primarily as a pigment and as a decolorizing and deodorizing agent. As a stable blue-black pigment, it is dense and has a good working quality for oil paints and watercolors. It is also used in engraving inks and as a decolorizing agent for refining sugars and syrups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone black"@en .

aat:300013152 a skos:Concept ;
    skos:definition "High-grade, fine-grain, dense black pigment originally made by burning pure ivory. It is perhaps the most widely used black pigment in the artist's palette. Current formulations of ivory black usually contain a fine grade of bone black with some Prussian blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivory black"@en .

aat:300013155 a skos:Concept ;
    skos:definition "An inferior grade of ivory black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paris black"@en .

aat:300013156 a skos:Concept ;
    skos:definition "A grayish-black powder made from charcoal. It is sometimes used in pigments, but is considered to be of inferior quality for that purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal black"@en .

aat:300013158 a skos:Concept ;
    skos:definition "Material prepared by charring woody fruit stones, including the stones of cherries, peaches, or dates. Material prepared by charring woody fruit stones, including the stones of cherries, peaches, or dates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit stone black"@en .

aat:300013159 a skos:Concept ;
    skos:definition "Black obtained from calcined peach-stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peach black"@en .

aat:300013161 a skos:Concept ;
    skos:definition "Pigment comprising a mixture of natural black oxides and carbon black, traditionally produced by charring desiccated grape vines and stems. Possesses a good tinting strength with a bluish black hue. Vine black did not have the intensity or tinting strength of lampblack or ivory black, but it had excellent lightfastness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vine black"@en .

aat:300013175 a skos:Concept ;
    skos:definition "Black pigment created artificially from iron oxide or another inorganic substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic black pigment"@en .

aat:300013177 a skos:Concept ;
    skos:definition "Synthetically prepared black iron oxide pigment that is permanent, having a warm brownish black color, existing as a dense, heavy powder, and unlike most naturally produced black iron oxide pigments, it is magnetic. Mars black was developed in the early 20th century; it is used in oil paints, watercolors, and mortars and cements, because it does not effloresce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars black"@en .

aat:300013179 a skos:Concept ;
    skos:definition "Pigment created from carbon-based molecules that are manufactured under intense heat or pressure from petroleum compounds or other substances, rather than being manufactured from natural carbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic organic black pigment"@en .

aat:300013181 a skos:Concept ;
    skos:definition "Black made from synthetic organic pigment produced from coal-tar derivatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aniline black"@en .

aat:300013182 a skos:Concept ;
    skos:definition "Any of various pigments that is blue or bluish in color, having undertones ranging from purplish to greenish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue pigment"@en .

aat:300013183 a skos:Concept ;
    skos:definition "Pigment that is blue in color and does not containing carbon, ultimately not derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic blue pigment"@en .

aat:300013184 a skos:Concept ;
    skos:definition "Blue dye and pigment made from the mineral azurite, a deep blue mineral composed of basic copper carbonate that is naturally found adjacent to the green copper carbonate mineral malachite. Azurite is prepared as a pigment by careful selection, grinding, washing, and levigation, with the coarsely ground azurite giving a deeper blue color and finely ground particles giving a lighter more transparent tone. Azurite is lightfast but is sensitive to acids and sulfur fumes; it is used for paints and dying luxury fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azurite"@en .

aat:300013198 a skos:Concept ;
    skos:definition "Greenish blue pigment found on wall paintings and painted objects from several Maya sites, determined in 1967 to be composed of indigo absorbed on a clay substrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maya blue"@en .

aat:300013200 a skos:Concept ;
    skos:definition "A natural inorganic blue pigment with slight red cast made from the ground, separated blue particles (lazurite) from the gemstone lapis lazuli. It has good fade resistance, fair transparency, but poor resistance to acids. It was the most expensive pigment in Western Medieval and Renaissance painting and manuscript illumination, generally reserved for the robe of the Madonna or another prestigious figure. It darkened with age, thus the synthetic variety was developed in the 19th century; blue deposits on the walls of lime kilns had been used earlier to produce a similar pigment, \"artificial ultramarine blue.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultramarine blue"@en .

aat:300013216 a skos:Concept ;
    skos:definition "Pigment that is blue in color, contains carbon, and is ultimately derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic blue pigment"@en .

aat:300013217 a skos:Concept ;
    skos:definition "A dark bluish purple, synthetic, water soluble pigment composed of the sodium sulfonate salt of indigotin. First prepared in 1740 by Barth, it was the earliest synthetic acid dye. It was used to color wool and silk; it is not lightfast and has poor washfastness. It is still used for coloring nylon sutures, food, drugs, and as a biological stain and as a detection reagent for nitrates and chlorates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue carmine"@en .

aat:300013218 a skos:Concept ;
    skos:definition "Non-standard term used for 17th-century water soluble, nonpermanent blue dye used for dyeing textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue lake"@en .

aat:300013220 a skos:Concept ;
    skos:definition "A dark reddish-purple lake pigment made from logwood colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campeachy lake"@en .

aat:300013221 a skos:Concept ;
    skos:definition "A type of dye ranging from purple to red in color, obtained from certain lichens growing, for example, on rocks in Scotland and the north of England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cork"@en .

aat:300013222 a skos:Concept ;
    skos:definition "A fugitive organic blue colorant obtained from the petals of Centaurea cyanus, called the \"cornflower.\" Cornflower blue was used in some 18th century watercolor paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornflower blue"@en .

aat:300013238 a skos:Concept ;
    skos:definition "Blue pigment derived artificially from an inorganic source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic blue pigment"@en .

aat:300013240 a skos:Concept ;
    skos:definition "Deep blue, fine particle, synthetic ultramarine pigment having rounded particles that are finer and more regular in size and shape than the natural ultramarine pigment. It is prepared by mixing anhydrous sodium sulfate or sodium carbonate with clay, silica, sulfur, rosin and charcoal then slowly heating in a reducing atmosphere. Variations in mixture proportions produce various shades of blue, green, violet and red pigments. The synthetic pigment is inexpensive and is used as an artist pigment in oil and watercolor, as a whitener in textiles and paper, and in wallpaper, soap, textile printing, and laundry bluing agents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial ultramarine blue"@en .

aat:300013250 a skos:Concept ;
    skos:definition "Synthetically prepared azure blue pigment composed of basic copper carbonate, first made in the 17th century and more widely used in the 19th century for both distemper and oil based interior house paints. It is no longer commonly used. Blue verditer particles are more rounded and regular in size than ground azurite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue verditer"@en .

aat:300013260 a skos:Concept ;
    skos:definition "Synthetic sky blue pigment composed of cobalt stannate; it is inert, lightfast, unaffected by acids or alkalis, and expensive. It is made by a process developed in Germany in 1805; originally sold as a pigment in 1860 under the name \"Coeruleum.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cerulean blue"@en .

aat:300013266 a skos:Concept ;
    skos:definition "A bright, clear, blue pigment made by combining cobalt and aluminum oxides with phosphoric acid. It was discovered by Baron L. J. Thénard in France in 1802 and introduced to artists about 20 years later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt blue"@en .

aat:300013279 a skos:Concept ;
    skos:definition "An early variety of cobalt blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leithner's blue"@en .

aat:300013280 a skos:Concept ;
    skos:definition "A synthetic inorganic colorfast pigment having coarse, irregular particles and ranging in color from a powdery blue to a royal blue. It is composed of a double silicate of calcium and copper, prepared by heating a mixture of silica, copper salts, and calcite in a sodium carbonate flux, forming a stable blue frit. Egyptian blue is stable in all types of media and is unaffected by acids or alkali. It was used by the ancient Egyptians over 5000 years ago as a pottery glaze and watercolor pigment in wall paintings. Similar materials, later manufactured in Italy and called Pompeian blue and Pozzuoli blue, have similar chemical compositions and optical properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian blue"@en .

aat:300013290 a skos:Concept ;
    skos:definition "A synthetic green-blue pigment made by fixing barium manganate on a barium sulfate base. It is an inert pigment that can range in color from a clear azure blue to a bright emerald green. Manganese blue was first discovered in 1907 but not patented until 1935."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese blue"@en .

aat:300013293 a skos:Concept ;
    skos:definition "A coarsely ground blue potassium glass containing small amounts of cobalt oxide, which provides the source of the blue color. It is used as a blue colorant in paints, glazes, glass, bluing paper, laundry blue, starch, textiles, and rubber. Although it was intended as a substitute in painting for natural ultramarine blue, which was very expensive, it was discovered that smalt blue discolors when placed in an oil-based medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smalt"@en .

aat:300013300 a skos:Concept ;
    skos:definition "Artificial mineral pigment made by treating tungsten ore with acids and ammonia to create tungsten oxide, then chemically reducing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tungsten blue"@en .

aat:300013303 a skos:Concept ;
    skos:definition "Blue pigment created from carbon that is artifically altered under intense heat and pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic organic blue pigment"@en .

aat:300013305 a skos:Concept ;
    skos:definition "A synthetic blue anthraquinone dye, rarely used because it is similar in hue to the less expensive phthalocyanine blue. Indanthrone blue was first prepared as an anthraquinone derivative of indigo by Rene Bohn in 1901; he named the colorant indanthrene, but the name was changed to indanthrone when Indanthrene became a brand name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indanthrone blue"@en .

aat:300013306 a skos:Concept ;
    skos:definition "A type of high performance organic pigment that is blue in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irgazin blue"@en .

aat:300013307 a skos:Concept ;
    skos:definition "Synthetic organic colorant composed of copper phthalocyanine that was first synthesized in 1933; it was marketed as a paint pigment called Monastral blue. The organic colorant is usually adsorbed on an aluminum hydrate base to form a deep blue color. In industry, phthalocyanine blue has replaced all other blue pigments for use in coatings because it is lightfast as well as resistant to chemicals and clumping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phthalocyanine blue"@en .

aat:300013315 a skos:Concept ;
    skos:definition "Any of several deep blue pigments consisting chiefly of ferric ferrocyanide; first developed in Berlin in 1704 by Diesbach. It is made by adding ferric chloride to a boiling solution of hexacyano ferrate. Prussian blue has deep blue, finely divided particles that are transparent in watercolors; it has high tinting strength and is stable to light, although it turns brown in the presence of alkalis or heat. It is used as a colorant in cyanotypes, blueprint paper, laundry blue, linoleum, leather, plastics, paper, cosmetics, and formerly as a textile dye for silk, cotton, and wool, where it was mordanted with ferric oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prussian blue"@en .

aat:300013329 a skos:Concept ;
    skos:definition "Pale blue variety of blue pigment created with Prussian blue mixed with cobalt blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antwerp blue"@en .

aat:300013332 a skos:Concept ;
    skos:definition "Pigment that is brown in color, which is a low luminance color that is typically produced by adding black or their complementary colors to red, orange, or yellow paint. It is considered an earth tone and has an unlimited numbers of shades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brown pigment"@en .

aat:300013333 a skos:Concept ;
    skos:definition "Pigment that is brown in color, does not contain carbon, and is ultimately not derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic brown pigment"@en .

aat:300013334 a skos:Concept ;
    skos:definition "Transparent, dark brown pigment made by roasting green earth to produce a warmer color. Transparent brown is a permanent pigment that is used primarily for glazing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparent brown"@en .

aat:300013341 a skos:Concept ;
    skos:definition "Pigment that is brown in color, contains carbon, and is ultimately derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic brown pigment"@en .

aat:300013342 a skos:Concept ;
    skos:definition "A transparent brown, asphalt-based pigment used in watercolor, oil paints, and glazes, especially in the 17th and 18th centuries. It is an oily material that can slow the drying of linseed oil producing a soft film. With time, asphaltum in dried oil films can result in the movement or disfigurement of the film as well as allligator cracks. Asphaltum was sold commercially as a transparent brown artist pigment under the name \"bitumen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphaltum"@en .

aat:300013346 a skos:Concept ;
    skos:definition "A bituminous pigment that is dark brown in color and was prepared during the16th-17th centuries by grinding Egyptian mummies that had been embalmed with asphaltum or bitumen. The ground mummy residue was believed to produce a pigment that was more durable than fresh asphaltum. In the 19th century, mummy brown was used as a transparent brown pigment for oil painting and for oil glazes. Some substitutes, such as Vandyke brown and bituminous earth pigments, were also sold under the name of \"mummy.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummy"@en .

aat:300013355 a skos:Concept ;
    skos:definition "A blackish-brown carbon pigment made from the incomplete combustion of bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone brown"@en .

aat:300013356 a skos:Concept ;
    skos:definition "A deep brownish purple pigment made by carefully roasting or charring carmine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnt carmine"@en .

aat:300013357 a skos:Concept ;
    skos:definition "A natural catechu dyestuff and tanning agent obtained from the heartwood, leaves, pods and twigs of several trees, such as Acacia catechu or Uncaria gambier, that are native to southeast Asia and India. The primary colorant in cutch is catechin. Cutch was used in India since ancient times. It was exported to Japan and China as early as the 1500s but was not used in Europe until the 1800s. Used to produce shades of brown, black, and olive; also employed in tanning leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutch"@en .

aat:300013363 a skos:Concept ;
    skos:definition "A variety of cutch made from a species of Uncaria, a Malayan vine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gambier"@en .

aat:300013367 a skos:Concept ;
    skos:definition "Reddish-brown pigment originally prepared with sepia blended with alizarin crimson or burnt sienna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman sepia"@en .

aat:300013368 a skos:Concept ;
    skos:definition "Brown extract obtained from the roots of Glycyrrhiza glabra; it is water soluble and forms a sticky, viscous fluid. The brown liquid was used as a thin, transparent glaze for paintings; it was sometimes added to bister to improve its working properties. It is also used for other purposes, including as a flavoring agent, in fire extinguishers, and added to fiber-based insulated building boards as an insect repellent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "licorice"@en .

aat:300013369 a skos:Concept ;
    skos:definition "A naturally occurring dark brown earth pigment containing organic humus, peat, or coal material mixed with iron oxides, alumina and silica. When ignited, the pigment leaves a soft gray residue. The colorant is fugitive and fades on exposure to strong light. The pigment was first used in the 17th century; early sources were from the Cologne and Kassel regions of Germany, thus the alternate pigment names. The brown earth has since been obtained from various localities each of which may differ slightly in color and composition. To add to this confusion some pigments labeled \"Van Dyck brown\" were bituminous while others were synthetically made from from carbon black and iron oxide mixtures. For these synthetic mixtures, use \"synthetic Van Dyck brown.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Van Dyck brown"@en .

aat:300013378 a skos:Concept ;
    skos:definition "Brown pigment derived artificially from an inorganic source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic brown pigment"@en .

aat:300013380 a skos:Concept ;
    skos:definition "Synthetically prepared dark brown iron oxide pigment. Mars brown is a permanent pigment with good tinting strength and good oil-drying properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars brown"@en .

aat:300013390 a skos:Concept ;
    skos:definition "A reddish earth containing iron and manganese oxides that is used as a pigment in oil and watercolor painting. The term refers to the reddish earth found around the city of Siena, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sienna"@en .

aat:300013391 a skos:Concept ;
    skos:definition "Sienna earth that has been exposed to a red heat, causing it to turn a darker, cooler, less orange-red tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnt sienna"@en .

aat:300013396 a skos:Concept ;
    skos:definition "Sienna earth that has not been exposed to heat, having an oranger reddish tone than burnt sienna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw sienna"@en .

aat:300013402 a skos:Concept ;
    skos:definition "A natural brown clay earth pigment that contains iron and manganese oxides, silica, alumina, and lime; tending to be less orange-red than sienna. The term refers to the region of Umbria, Italy, although the pigment is found elsewhere in the world, notably on Cyprus. It has been used as a pigment since prehistoric times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umber"@en .

aat:300013408 a skos:Concept ;
    skos:definition "Umber earth that has been heated to produce a more reddish brown pigment than raw umber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnt umber"@en .

aat:300013414 a skos:Concept ;
    skos:definition "Umber, that is a natural hydrated iron oxide with some oxide of manganese, that has not been heated and tends to a yellowish-brown color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw umber"@en .

aat:300013418 a skos:Concept ;
    skos:definition "Pigment having a green color, which is produced by light having a spectrum dominated by energy with a wavelength of about 490–560 nm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green pigment"@en .

aat:300013419 a skos:Concept ;
    skos:definition "Pigment that is green in color, does not contain carbon, and is ultimately not derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic green pigment"@en .

aat:300013420 a skos:Concept ;
    skos:definition "A bluish green pigment derived from chrysocolla mineral, often containing free silica and other impurities. The translucent to opaque stone is typically sky-blue in color in its natural state, but appears green when ground into a fine powder. In the 16th and 17th centuries, it was used as a watercolor pigment called cedar green. It is stable to light but is decomposed by acids, alkalis, and heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrysocolla"@en .

aat:300013423 a skos:Concept ;
    skos:definition "Pigments of various compositions, having in common that they are all made from green colored siliceous, iron-rich clays that have been used as pigments since ancient times, ground from available minerals, including celadonite, glauconite, cronstedtite, montmorillonite, and chlorite, among others. The color of green earth pigment can range from yellow-green to sea-green to greenish-gray, is translucent in oils, having moderate tinting strength and poor hiding power. It is a permanent, stable pigment that is compatible with all media. Green earth is sometimes imitated by mixtures of Naples yellow and Prussian blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green earth"@en .

aat:300013434 a skos:Concept ;
    skos:definition "A commercial name for a shade of green earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bohemian earth"@en .

aat:300013435 a skos:Concept ;
    skos:definition "A permanent, yellowish-green earth pigment obtained from mineral deposits on Cyprus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyprian green earth"@en .

aat:300013436 a skos:Concept ;
    skos:definition "Commercial name for a permanent, bluish-green earth pigment mined near Tirol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tyrolean green"@en .

aat:300013437 a skos:Concept ;
    skos:definition "An high quality pigment composed of green earth obtained from Cyprus; it was highly valued in the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Verona green"@en .

aat:300013438 a skos:Concept ;
    skos:definition "Green crystalline copper carbonate prepared as pigment by selection, grinding, washing, and levigation of the malachite mineral. Coarsely ground malachite gives a dark green color while finely ground particles give a lighter more transparent tone. It is a lightfast, but sensitive to acids and sulfur fumes. Basic copper carbonate can also be made artificially by coloring chalk with copper sulfate, then called \"green verditer.\" Natural malachite was occasionally used in tempera-based paintings before the 16th century and later, green verditer was used for both distemper and oil based interior house paints in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malachite"@en .

aat:300013442 a skos:Concept ;
    skos:definition "Pigment that is green in color, contains carbon, and is ultimately derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic green pigment"@en .

aat:300013444 a skos:Concept ;
    skos:definition "An organic green colorant extracted from the petals of violets, precipitated on alum to form a lake. It is a fugitive pigment composed primarily of chlorophyll. It is documented as having been used in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pansy green"@en .

aat:300013445 a skos:Concept ;
    skos:definition "An obsolete lake pigment made by adding an alkali (soda or lime) to the purple red juice of ripe buckthorn berries, creating a dark, yellowish green colorant that was then mixed with alum and gum to form a thick syrup that was placed in pig bladders, hence received the name bladder green. Sap green was used in watercolor paints in the 17th and 18th centuries. The primary colorants may be kaempferol, rhamnetin, or quercetin, depending upon the variety of buckberry used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sap green"@en .

aat:300013451 a skos:Concept ;
    skos:definition "Green pigment derived artificially from an inorganic source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic green pigment"@en .

aat:300013453 a skos:Concept ;
    skos:definition "Pigment comprising an mixture of cobalt and chromium oxides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue-green oxide"@en .

aat:300013456 a skos:Concept ;
    skos:definition "Refers to a green colorant that is a mixture of cadmium yellow with chromium oxide (viridian), or a mixture of cadmium yellow and phthalocyanine green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium green"@en .

aat:300013457 a skos:Concept ;
    skos:definition "A dense, opaque pale-green pigment that occurs naturally as the mineral eskolaite; a process for synthetically producing anhydrous, opaque chromium oxide green was developed in 1809 by Vauquelin. The pigment is lightfast, durable, and has excellent resistance to chemicals and heat, but has limited use in paints because of its dull color. Given that it absorbs infrared radiation well, it is used in deck paints and camouflage coatings for military purposes. It is also used as an abrasive, as a glaze color, for tanning leather, and as polishing rouge for platinum and steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromium oxide green"@en .

aat:300013467 a skos:Concept ;
    skos:definition "A composite green pigment composed of cobalt and zinc oxides that have been calcined together. It is a fast drying, permanent, a good drier in oil paints, but has low tinctorial power. It has been available since the mid-1800s. It was invented in Sweden about 1780 by Sven Rinman and it began to be used as an artist's pigment by 1835."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt green"@en .

aat:300013475 a skos:Concept ;
    skos:definition "The name commonly given to the transparent green glazes that are colored by copper salts of resin acids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper resinate"@en .

aat:300013476 a skos:Concept ;
    skos:definition "A very poisonous copper-based bright green powder that is used as a pigment and insecticide; it is mixed acetate and arsenite of copper, discovered about 1800, and first commercially manufactured in Schweinfurt, Germany in 1814. It is lightfast but is decomposed by acids and warm alkalis and darkens in the presence of sulfur. In the 19th century, it was used for oil paints, coach paints, watercolors, pastels, wax crayons, and pencils. In the early 20th century, it was also used as a colorant in wallpapers, fabrics, linoleum, and toys. Marketed as Paris green, it was used as an insecticide, fungicide, and rat poison. Emerald green is no longer used as a pigment due to its toxicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emerald green"@en .

aat:300013488 a skos:Concept ;
    skos:definition "A hydrated form of copper arsenite, formerly used as a pigment in calico printing and wallpaper manufacture, warm yellowish-green in color with good opacity, but never widely used as a paint pigment because it is toxic and discolors in the presence of acid or sulfur fumes. Currently, copper arsenite is used as a rodenticide, insecticide, fungicide, and wood preservative. Scheele's green was discovered in Sweden in 1775 by Carl W. Scheele, a German chemist, but he did not publish the recipe until 1778."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scheele's green"@en .

aat:300013489 a skos:Concept ;
    skos:definition "An unstandardized name for pigment having a yellowish-green color; originally used for mixtures of green (viridian and later phthalocyanine green or chromic oxide) with yellow (cadmium yellow) pigments. Another recipe for permanent green is made by mixing Prussian blue with zinc yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanent green"@en .

aat:300013490 a skos:Concept ;
    skos:definition "Pale green pigment that is an intermediate product in the manufacture of synthetic ultramarine blue; sodium sulfate or carbonate, clay, silica, sulfur, and charcoal are heated in a reducing atmosphere to create a melted mass that is green in color, then ground, washed, and dried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultramarine green"@en .

aat:300013491 a skos:Concept ;
    skos:definition "Pigment composed of basic copper acetate and having a dark bluish-green color. Verdigris has been manufactured since ancient times by placing copper plates over vats of fermenting grape skins; the acetic acid quickly reacts to form basic copper acetate. When used directly as a pigment, it discolors from green to black in oil paints, fades in watercolor paints, and reacts with a paper support. It is used to make copper resinate, as a drier for linseed oil, to dye fabrics, and as a colorant and fungicide in antifouling paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verdigris"@en .

aat:300013499 a skos:Concept ;
    skos:definition "A synthetic permanent green pigment composed of hydrated chromium oxide with characteristic deep green, transparent particles that are unaffected by light and chemicals. Processes for making the pigment were developed in 1838 by Pannetier in Paris and Guignet in 1859. It has been used as a pigment in all types of binding media, and as a colorant in concrete mixtures, rubber, inks, and automotive paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viridian"@en .

aat:300013507 a skos:Concept ;
    skos:definition "A mixture of zinc yellow and a variety of Prussian blue. This composite pigment is permanent to light but not to alkali or water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc chrome green"@en .

aat:300013510 a skos:Concept ;
    skos:definition "Green pigment created from carbon that is artifically altered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic organic green pigment"@en .

aat:300013512 a skos:Concept ;
    skos:definition "Chlorinated copper phthalocyanine pigment that was commercially introduced in 1938 by DuPont. Monastral green is made from the same phthalocyanine base as Monastral blue but is modified by chlorination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phthalocyanine green"@en .

aat:300013516 a skos:Concept ;
    skos:definition "A pigment that is green in color and contains two or more basic ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite green pigment"@en .

aat:300013517 a skos:Concept ;
    skos:definition "Composite pigment made from lead chromate and Prussian blue, used in house paint and other industrial colors. It is not typically used in artists' colors. It turns blue with exposure to strong light or acids, it turns dark orange with exposure to alkalis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome green"@en .

aat:300013529 a skos:Concept ;
    skos:definition "A green pigment originally composed of basic copper chloride (atacamite), developed in 1795 by the Brunswick brothers by placing copper filings in an ammonium chloride solution, then collecting the precipitate. By the 19th century, Brunswick green was prepared by mixing Prussian blue and chrome yellow, although this mixture is more commonly called \"chrome green.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brunswick green"@en .

aat:300013531 a skos:Concept ;
    skos:definition "Composite pigment made with Bremen blue and a fustic lake; not used for permanent painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elsner green"@en .

aat:300013532 a skos:Concept ;
    skos:definition "A medium green pigment that may occur in various formulations. It was formerly composed of a mixture of Prussian blue and gamboge; however, this composition discolored in sunlight when the gamboge faded. A more recent permanent mixture of this name is composed of phthalocyanine green and Hansa yellow or cobalt yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hooker's green"@en .

aat:300013533 a skos:Concept ;
    skos:definition "Pigment having the color red, which is produced by light having a spectrum dominated by energy with a wavelength of about 630–700nm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red pigment"@en .

aat:300013535 a skos:Concept ;
    skos:definition "Pigment that is red in color, contains no carbon, and is ultimately not derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic red pigment"@en .

aat:300013537 a skos:Concept ;
    skos:definition "Refers to a variety of dense, permanent pigments that produce a wide variety of red shades ranging from light, bright red to a deep purplish red. Pigments can be natural, earth pigments (hematite, Indian red, Venetian red) or synthetically prepared pigments (light red). All iron oxide reds are stable, permanent pigments with good tinting strength and are the primary colorant in ochers and siennas. The pigment was first manufactured in the early 18th century. Today it is often a furnace product made from steel-mill waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron oxide red"@en .

aat:300013544 a skos:Concept ;
    skos:definition "A bright, clear red iron oxide earth pigment that has since been replaced by light red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gulf red"@en .

aat:300013547 a skos:Concept ;
    skos:definition "An unstandardized name used for Pozzuoli red, Tuscan red, and dragon's blood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pompeian red"@en .

aat:300013549 a skos:Concept ;
    skos:definition "A bright, natural red volcanic pigment originally mined at Pozzuoli near Naples, Italy. It was used by the Romans and others as a paint pigment, becoming popular for fresco paintings because it dried quickly to a hard impenetrable surface like cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pozzuoli red"@en .

aat:300013550 a skos:Concept ;
    skos:definition "Reddish pigment made of a fine, soft, natural red clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red bole"@en .

aat:300013556 a skos:Concept ;
    skos:definition "Refers to red iron oxide or a similar pigment, particularly when it is a component of reddish-brown chalk or mixed with lime and water and applied with a brush to create underdrawings for frescoes. These underdrawings are called \"sinopie.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sinopia"@en .

aat:300013558 a skos:Concept ;
    skos:definition "An earth pigment containing red iron oxide, originally obtained from Spain. It is a coarse grain, an inexpensive colorant, having a dull red color, and used in industrial paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish red oxide"@en .

aat:300013559 a skos:Concept ;
    skos:definition "A bright red pigment prepared by depositing an organic red dye, such as alizarin, on a red iron oxide base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuscan red"@en .

aat:300013560 a skos:Concept ;
    skos:definition "A permanent, reddish brown pigment that was originally prepared from a natural red ocher, but since the 18th century has been manufactured by calcining ferrous sulfate (copperas) with lime or calcium carbonate in a ratio of around 15-40% ferric oxide and 60-80% calcium sulfate. It is used in oil paints, house paints, and as a paper colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian red"@en .

aat:300013561 a skos:Concept ;
    skos:definition "An orange-red mineral, found as soft lumps consisting of arsenic disulfide, having a resinous luster; it is found in eastern Europe, Asia, and western North America in lead and silver ores along with orpiment (arsenic trisulfide). Realgar was once widely used as a pigment because of its bright rich color in works from China, India, Central Asia, Egypt, and Europe. However, it is extremely toxic, not stable, and can deteriorate badly in oil paint films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "realgar"@en .

aat:300013568 a skos:Concept ;
    skos:definition "Synthetic pigment composed of red mercuric sulfide, chemically the same as the natural mineral cinnabar. There are two methods for preparing vermilion, a dry-process and a wet-process. The dry-process method, adding mercury to molten sulfur, was invented by the Chinese then imported to Europe ca. 8th century, seemingly via the Islamic world. The wet-process method, placing the ground black mercuric sulfide isomorph into a solution of ammonium sulfide or potassium sulfide, was developed in the late 17th century in Germany. Vermilion is a dense pigment with excellent hiding power, used in oil, watercolor, egg tempera, and fresco paintings. When exposed to ultraviolet light and oxygen, or chloride ions, vermilion can change from its normal red crystalline form to gray or black, resulting in dark discolorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vermilion"@en .

aat:300013573 a skos:Concept ;
    skos:definition "Obsolete permanent pigment made of antimony trisulfide. Invented and patented by Murdock in Scotland in 1847, it was replaced by cadmium red in the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimony vermilion"@en .

aat:300013574 a skos:Concept ;
    skos:definition "Type of dry-process vermilion pigment originally made in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese vermilion"@en .

aat:300013576 a skos:Concept ;
    skos:definition "Type of wet-process vermilion, originally made in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English vermilion"@en .

aat:300013578 a skos:Concept ;
    skos:definition "A term sometimes applied to the more yellowish kinds of vermilion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange vermilion"@en .

aat:300013580 a skos:Concept ;
    skos:definition "The bluish, or least yellowish, variety of vermilion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarlet vermilion"@en .

aat:300013582 a skos:Concept ;
    skos:definition "Pigment that is red in color, contains carbon, and is ultimately derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic red pigment"@en .

aat:300013583 a skos:Concept ;
    skos:definition "Generic name for red-colored substances of similar composition obtained from the roots of either of two species of plants. In the near East and Europe, alkanet is extracted from Anchusa officinalis. In Asia, alkanet is extracted from Lawsonia inermis. The primary colorant is alkanninH. It was used in late Egyptian times through the Middle Ages as a red dye; use as dye was discontinued because of poor lightfastness. The compound has been used as a textile dye, wood stain, lake pigment, cosmetic, as an acid-base indicator, and for medicinal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkanet"@en .

aat:300013587 a skos:Concept ;
    skos:definition "A generic name for two closely related organic red lakes that are obtained from scale insects, cochineal and kermes. Neither pigment is permanent enough for use in fine art because they discolor in sunlight. They were replaced first by madder and alizarin, then later by synthetic organic red colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carmine"@en .

aat:300013596 a skos:Concept ;
    skos:definition "The root of an East Indian herb that yields a red dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chay"@en .

aat:300013597 a skos:Concept ;
    skos:definition "A red natural transparent lake colorant that has poor lightfastness and fades in strong sunlight. It is prepared from the bodies of the female scale insect, Dactylopius coccus, native to Mexico, the Canary Islands, and Central and South America. Cochineal dye was used by the Aztec and Maya peoples of Central and North America, adopted by Europeans. The pigments are extracted from the dried bodies of insects using water or alcohol. The substance contains about 10% carminic acid, 2% coccerin wax, and 10% fat: the crimson color of cochineal dye is attributed to cochinealin or carminic acid. Cochineal is also used in medicine as an antispasmodic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cochineal"@en .

aat:300013599 a skos:Concept ;
    skos:definition "Deep, transparent, ruby-red lake pigment with bluish undertone, made from kermes by extraction with alkali then precipitation on alumina trihydrate. It was used by ancient Egyptians, Greeks and Romans. Crimson lake was rarely used after carmine became popular in the 16th century and its use discontinued in the 19th century with the introduction of madder and alizarin lakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crimson lake"@en .

aat:300013605 a skos:Concept ;
    skos:definition "A deep red natural colorant made from secretions of the larvae of the lac insect. Lac dye is a byproduct produced during the shellac purification process; its primary colorant is laccaic acid. It was an important dyestuff used since ancient times, giving a lightfast tint to silk and wool, similar in color to dyes obtained from cochineal and kermes. Now synthetic colorants have replaced the use of lac dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lac dye"@en .

aat:300013609 a skos:Concept ;
    skos:definition "A blackish blue or blood red natural colorant extracted from the logwood tree, Haematoxylon campechianum, of Central America, Mexico, and the West Indies. It was formerly used to make black ink, and is still used to dye textiles black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logwood"@en .

aat:300013623 a skos:Concept ;
    skos:definition "Red pigment derived artificially from an inorganic substance, such as iron oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic red pigment"@en .

aat:300013625 a skos:Concept ;
    skos:definition "Obsolete permanent pigment made of antimony trisulfide, having an orange color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimony orange"@en .

aat:300013626 a skos:Concept ;
    skos:definition "A permanent, deep red pigment containing cadmium. Earliest pigments were composed of pure cadmium sulfoselenide, first patented in Germany in 1892. Variations in the proportions of the cadmium and selenide produce as range of colors from orange to dark maroon. By 1926, cadmium reds were being co-precipitated with barium sulfate to form less expensive cadmium lithopone pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium red"@en .

aat:300013630 a skos:Concept ;
    skos:definition "A permanent, red cadmium pigment co-precipitated on barium sulfate; it has poorer hiding power and lower tinting strength than pure cadmium red pigment but is cheaper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium red lithopone"@en .

aat:300013631 a skos:Concept ;
    skos:definition "Basic lead chromate pigment that ranges in shades from brown-yellow orange to a brick-red color, depending on particle size and the ratio of lead oxide to lead chromate. It was first made in 1809 by Vauquelin by heating lead chromate and sodium hydroxide solution to form basic lead chromate. It is not used as a permanent paint due to its tendency to turn brown on contact with sulfur in the atmosphere, react with other pigments, and turn green with exposure to sunlight. Most often, chrome red is used as an anticorrosive base coats for steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome red"@en .

aat:300013641 a skos:Concept ;
    skos:definition "Synthetically produced brick red color iron oxide artists' pigment. Originally, the name \"Indian red\" was used for red earth pigments imported from the Persian Gulf and India; in the early 18th century, a synthetic Indian red composed of pure ferric oxide was made from steel mill wastes. It is a dense, opaque, permanent pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian red"@en .

aat:300013645 a skos:Concept ;
    skos:definition "A pink pigment used in ceramics and as a pale pink artists color. It was first developed ca. 1790 by a potter in Staffordshire. The color is produced when chromic oxide and tin oxide fuse in the presence of lime. The color is dependent on particle size and is not always uniform. The same pink can also be formed by the combination of chromium and zircon oxides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potter's pink"@en .

aat:300013647 a skos:Concept ;
    skos:definition "Heavy, opaque, orange-red pigment composed of lead tetroxide. Although chemically equivalent to the mineral minium, red lead pigment has been synthetically prepared by roasting lead white (480 C) since before the 5th century BCE. Red lead has been found as a pigment on early objects from Egypt, China, Japan, India, Persia, and Rome; it is no longer used as an artist's color because is has poor light stability and poor working properties, although it is still used to color glass and ceramic glazes. Pliny called it \"secondarium minium.\" It was widely used in illuminated manuscripts, and with its use, the term \"miniare\" came to mean \"to color with red lead,\" giving rise to the term \"miniature.\" Red lead paint was used as an anticorrosion primer for structural iron and steel until the late 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red lead"@en .

aat:300013656 a skos:Concept ;
    skos:definition "Organic pigment of red color derived from artificial sources. One example of use was in lithographic posters in the early 20th century when certain hues were not achieved by using inorganic pigments alone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic organic red pigment"@en .

aat:300013658 a skos:Concept ;
    skos:definition "A clear, bright red, transparent lake pigment prepared by precipitating the synthetic dyestuff alizarin on a neutral base of alumina trihydrate. This produces a brilliant, ruby red color that has fair to good permanency. Other base materials are used to give varying shades of red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alizarin crimson"@en .

aat:300013670 a skos:Concept ;
    skos:definition "A bright red synthetic organic pigment made from the deposition of eosin on a alumina trihydrate base, typically used in illustrations and prints but not in paintings; the color fades in daylight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geranium red"@en .

aat:300013672 a skos:Concept ;
    skos:definition "A brilliant red compound composed of mercuric iodide; it was used as a pigment briefly in the early 19th century. Iodine scarlet fades to yellow in sunlight and is highly toxic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iodine scarlet"@en .

aat:300013676 a skos:Concept ;
    skos:definition "Synthetic organic red pigment used in printing inks and industrial paints; not commonly used by artists due to its tendency to bleed in oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithol red"@en .

aat:300013678 a skos:Concept ;
    skos:definition "Class of synthetic organic colorants that are bright, cherry-red in color with a rather bluish undertone; made by reacting beta-naphthol with paranitraniline, a coal tar derivative. Different shades are obtained by varying temperature and pH of the mixture. Para red was first synthesized in 1880 by Holliday in England. Para reds have fair lightfastness, but are not used in artists paints because of bleeding; they were previously used industrially in metal finishes and printing inks but have been replaced with more durable colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "para red"@en .

aat:300013680 a skos:Concept ;
    skos:definition "The red shades of synthetic red and violet dyes composed of linear quinacridones that are made from terephthalic acid. Quinacridone dyes can exist in four crystalline allotropes, two of which are sold as red and violet pigments. Although synthesized in 1896, quinacridone colors were first recognized as useful pigments and marketed by DuPont in the 1950s under the name Monastral. They are lightfast colorants used in paints, printing inks, and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quinacridone red"@en .

aat:300013683 a skos:Concept ;
    skos:definition "Any of several bright, transparent, synthetic azo-type organic red pigments. Toluidine reds are made using the reaction of beta-naphthol with 2-nitro-4-toluidine. Toluidine red was first synthesized in 1904 in Germany, and reached its peak of popular use in the 1970s. Toluidine reds have fair lightfastness and weather resistance: they are used in industrial coatings for air-dried and baked enamels and auto finishes, in wax crayons, pastels, and watercolors; however, they have a tendency to bleed in oil paints. It is a suspected carcinogen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toluidine red"@en .

aat:300013685 a skos:Concept ;
    skos:definition "Pigment that is violet in color, contains no carbon, and is ultimately not derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic violet pigment"@en .

aat:300013686 a skos:Concept ;
    skos:definition "A synthetic pigment composed of a double salt of phosphoric acid with manganese and ammonium, first introduced in Germany in 1868 as Nuernberg violet. It has a deep rich violet hue, is lightfast, but has poor hiding power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese violet"@en .

aat:300013694 a skos:Concept ;
    skos:definition "Synthetically prepared violet color iron oxide pigment, which is permanent, having good tinting strength and good oil-drying properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars violet"@en .

aat:300013695 a skos:Concept ;
    skos:definition "Pigment having a rosy violet color, produced in the manufacture of synthetic ultramarine blue. Ultramarine violets and reds were developed in Germany ca. 1875; they are produced by treating ultramarine blue with sal ammoniac or dry hydrochloric acid gas at high temperatures. Ultramarine violet is stable, but it has poor tinting strength and is rarely used in artists' paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultramarine violet"@en .

aat:300013699 a skos:Concept ;
    skos:definition "Pigment that is violet in color, contains carbon, and is ultimately derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic violet pigment"@en .

aat:300013703 a skos:Concept ;
    skos:definition "A violet lake pigment made from logwood; it is not colorfast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable violet"@en .

aat:300013705 a skos:Concept ;
    skos:definition "A mixed violet compound made from cobalt blue and alizarin crimson. It was not lightfast and is no longer in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violet carmine"@en .

aat:300013706 a skos:Concept ;
    skos:definition "Violet pigment that is derived artificially from an inorganic source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic violet pigment"@en .

aat:300013708 a skos:Concept ;
    skos:definition "Inorganic, semiopaque, permanent pigment made of cobalt phosphate or cobalt arsenite, the latter of which is poisonous. Nontoxic cobalt phosphate is presently used to create this pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt violet"@en .

aat:300013711 a skos:Concept ;
    skos:definition "A medium to strong violet pigment composed of cobaltous phosphate; it was first developed in 1859 by Salvetat and sold as an artists' pigment in 1890. The colorfast pigment has low tinting strength and dries quickly in oil paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep cobalt violet"@en .

aat:300013712 a skos:Concept ;
    skos:definition "A pale to medium violet pigment originally composed of cobaltous arsenate. Cobaltous arsenate occurs in nature as cobalt bloom or erythrite; it was synthetically produced in 1880 and became an important permanent, violet pigment for paints, glass, glazes, and enamels. It is now rarely used because of its toxicity, generally substituted with deep cobalt violet or cobaltous ammonium phosphate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light cobalt violet"@en .

aat:300013713 a skos:Concept ;
    skos:definition "Violet pigment created from carbon that is artifically altered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic organic violet pigment"@en .

aat:300013715 a skos:Concept ;
    skos:definition "A transparent violet pigment made from synthetic purpurin, not sufficiently permanent for artists' use, since it turns dark or blackish on long exposure to light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alizarin violet"@en .

aat:300013721 a skos:Concept ;
    skos:definition "The violet shades of synthetic red and violet dyes composed of linear quinacridones that are made from terephthalic acid. Quinacridone dyes can exist in four crystalline allotropes, two of which are sold as red and violet pigments. Although synthesized in 1896, quinacridone colors were first recognized as useful pigments and marketed by DuPont in the 1950s under the name Monastral. They are lightfast colorants used in paints, printing inks, and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quinacridone violet"@en .

aat:300013722 a skos:Concept ;
    skos:definition "A synthetic sulfur colorant with an intense violet color, having good lightfastness and washfastness. Among its uses are as textile dyes and in artist paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thioindigo violet"@en .

aat:300013723 a skos:Concept ;
    skos:definition "Pigments having white color, which is a total reflection of all frequencies of visible light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white pigment"@en .

aat:300013724 a skos:Concept ;
    skos:definition "Pigment having white color, which is a total reflection of all frequencies of visible light, and also being impervious to rays of light or having good covering quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opaque white pigment"@en .

aat:300013725 a skos:Concept ;
    skos:definition "White, toxic powder used in glass coatings, ceramics, fireproofing agents, electrical components, and as a pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimony oxide"@en .

aat:300013726 a skos:Concept ;
    skos:definition "Antimony oxide with 70% barium sulfate; not commonly used by artists as it is less inert than titanium white and turns yellow when exposed to sulfur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimony white"@en .

aat:300013728 a skos:Concept ;
    skos:definition "White pigment made of bismuth nitrate or sometimes bismuth chloride oxide. It is used in cosmetics, ceramic glazes, surface coatings, and enamels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bismuth white"@en .

aat:300013731 a skos:Concept ;
    skos:definition "Pigment used in the 19th century, composed of lead chlorosulfite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caledonian white"@en .

aat:300013732 a skos:Concept ;
    skos:definition "White pigment typically composed of nearly equal proportions of titanium white and zinc white. The mixture of the two pigments is more durable than either used alone. Composite white has been used since the 1920s as a house paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite white"@en .

aat:300013737 a skos:Concept ;
    skos:definition "Zinc sulfide coprecipitated with barium sulfate; it is used as a dense white pigment in house paint and industrial coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithopone"@en .

aat:300013745 a skos:Concept ;
    skos:definition "Stannic oxide, used to produce an opaque white in ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin white"@en .

aat:300013747 a skos:Concept ;
    skos:definition "White pigment consisting chiefly or wholly of titanium dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanium white"@en .

aat:300013752 a skos:Concept ;
    skos:definition "Pigment comprising titanium white and barium sulfate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanium barium white"@en .

aat:300013753 a skos:Concept ;
    skos:definition "White pigment comprising rutile titanium dioxide coated with precipitated calcium carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanium calcium white"@en .

aat:300013754 a skos:Concept ;
    skos:definition "Synthetically produced white pigment; the oldest and most historically important white pigment as it was the only white used in European easel painting until the nineteenth century. By the twentieth century, the use of lead white had been replaced with titanium dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead white"@en .

aat:300013769 a skos:Concept ;
    skos:definition "White lead produced by a historical method of casting metallic lead as thin buckles, which were corroded with acetic acid in the presence of carbon dioxide, using pots of vinegar, dung, and tanner’s bark. After six to fourteen weeks the blue-grey lead was corroded to white lead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch process white lead"@en .

aat:300013770 a skos:Concept ;
    skos:definition "A bright white, permanent, opaque, nontoxic pigment made of zinc oxide and other components. Zinc white exists in various grades: white seal (>99% zinc oxide, but with poor covering power), green seal (> 99% zinc oxide with good covering power), red seal (slightly less pure, generally used for grounds), gold seal (also less pure, used for grounds), and gray seal (contains some metallic zinc). Zinc white pigment is used in many media, including pastels, watercolor, and goache."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc white"@en .

aat:300013777 a skos:Concept ;
    skos:definition "A white powder produced by treating zircon and used as a pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zirconium oxide"@en .

aat:300013779 a skos:Concept ;
    skos:definition "Various types of white pigment that do not reflect light, but rather allows light to pass through. The most significant use for transparent white pigment is to extend more expensive pigments of other colors. Commonly used transparent white pigments include alumina hydrate, magnesium carbonate, calcium carbonate, blanc fixe, barytes, and clays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparent white pigment"@en .

aat:300013782 a skos:Concept ;
    skos:definition "Light, transparent pigment composed of a solution of aluminum sulphate and an alkali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum hydrate white"@en .

aat:300013783 a skos:Concept ;
    skos:definition "White pigment containing aluminum stearate, used as a stabilizer in oil paints to maintain separation of pigment and oil in the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum stearate white"@en .

aat:300013784 a skos:Concept ;
    skos:definition "White pigment obtained from anhydrous calcium sulfate that is often found in gypsum deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anhydrite white"@en .

aat:300013785 a skos:Concept ;
    skos:definition "Heavy white powder used as a pigment in the manufacture of paints, glazes and synthetic marble. When barium hydroxide is used as an alkalizing agent for paper, it can react with carbon dioxide and precipitate as barium carbonate to provide an alkaline reserve. Both barium hydroxide and barium carbonate are highly toxic. Barium carbonate is also used commercially in rat poison, bricks, cement, and mortar. It is occurs in nature as the mineral witherite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium carbonate"@en .

aat:300013786 a skos:Concept ;
    skos:definition "A fine, white pigment composed of calcium hydroxide and calcium, produced by slaking of lime in water or air to form a thick, white, alkaline paste. It was used for fresco painting where it hardens to form a cohesive film without the aid of a binder. It reacts with proteins, such as egg white or casein, to produce a tough, insoluble film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime white"@en .

aat:300013788 a skos:Concept ;
    skos:definition "The most common barium mineral, barium sulfate (BaSO4), occurring in hydrothermal ore veins containing lead and silver, in sedimentary rocks such as limestone, in clay deposits formed by the weathering of limestone, in marine deposits, and in cavities in igneous rock in Spain, Germany, and in the southern Appalachian, central states, and California in the United States. It commonly forms as large tubular crystals, as rosettelike aggregates of those crystals, or as divergent plates known as crested barite. It is abundant. Ground barite is used in oil and gas well drilling muds, in the preparation of barium compounds, as a body or filler for paper, cloth, and phonograph records, as a base for white pigment, and as an inert body in colored paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barite"@en .

aat:300013802 a skos:Concept ;
    skos:definition "White pigment made from calcium hydroxyapatite and calcium carbonate derived from bone ash. It was used in grounds for silver point drawings, in making ceramics, and as a polishing compound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone white"@en .

aat:300013808 a skos:Concept ;
    skos:definition "An soft, whitish, absorbent powder derived from the siliceous skeletons of microscopic water plants called diatoms, composed of 88% silica. It is used as a poultice, a desiccating insecticide, a decolorizer and filtration aid for purifying oils, fats, and waxes, an inert pigment, a filler in paper, paint, brick, floor tiles, ceramics, linoleum, plastic, soap, and detergent, an insulation for boilers and blast furnaces, as sound insulation, and as a very mild abrasive in metal polishes and toothpaste. It reduces gloss, acts as a suspending agent, increases viscosity, and absorbs dyes well, thus is used as a base for lake colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diatomaceous earth"@en .

aat:300013815 a skos:Concept ;
    skos:definition "Pigment made of white clay materials and used in China clay material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaolinite"@en .

aat:300013819 a skos:Concept ;
    skos:definition "White pigment that is used in industrial products, such as white casein wall paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mica"@en .

aat:300013821 a skos:Concept ;
    skos:definition "Shell white pigment derived from seashells, often oyster shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster white"@en .

aat:300013823 a skos:Concept ;
    skos:definition "Finely ground pigment made from pumice vocanic stone, used to make a clear glaze for ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumice"@en .

aat:300013825 a skos:Concept ;
    skos:definition "White pigment made of powdered quartz, found in varying degrees of fineness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silica"@en .

aat:300013829 a skos:Concept ;
    skos:definition "White pigment that is made from magnesium silicate often used as a filler in paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talc"@en .

aat:300013832 a skos:Concept ;
    skos:definition "Pigment having the color of yellow, which is produced by light having a spectrum dominated by energy with a wavelength of about 560–590nm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow pigment"@en .

aat:300013833 a skos:Concept ;
    skos:definition "Pigment that is yellow in color, contains no carbon, and is ultimately not derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic yellow pigment"@en .

aat:300013834 a skos:Concept ;
    skos:definition "A soft, yellow mineral composed of arsenic trisulfide that occurs naturally in volcanic fumaroles, hydrothermal veins, hot springs, and as a decomposition product of realgar. It changes to a red crystalline form at 170 C. Orpiment was used from ancient times as a pigment in painting, in manuscript illumination, and polychrome sculpture, having good tinting strength, but not permanent and toxic. King's yellow is the synthetic counterpart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orpiment"@en .

aat:300013841 a skos:Concept ;
    skos:definition "Pigment that is yellow in color, contains carbon, and is ultimately derived from vegetable or animal sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic yellow pigment"@en .

aat:300013842 a skos:Concept ;
    skos:definition "A natural orange dye obtained from the pod of the lipstick plant which is a small tree, Bixa orellana, native to Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annatto"@en .

aat:300013843 a skos:Concept ;
    skos:definition "A transparent yellow lake pigment used since the 16th century. It was initially extracted from unripe buckthorn berries (rhamnetin), and later from oak bark (quercitron)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch pink"@en .

aat:300013849 a skos:Concept ;
    skos:definition "A natural, yellow dyestuff produced from a boiling water extract of wood chips from the dyer's mulberry trees. It was long used in the production of khaki-colored clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fustic"@en .

aat:300013855 a skos:Concept ;
    skos:definition "A yellow organic pigment composed of magnesium euxanthate, originally made from the urine of cows fed exclusively on mango leaves, producing a washed, powdered material that is a clear, golden yellow color. Used for watercolor and tempera paints. The production of Indian yellow was prohibited in 1908 because the mango leaves were harmful to the cattle. Current counterparts are made with a synthetic coal-tar derivative. Authentic Indian yellow fluoresces a bright yellow color when lit with long wavelength ultraviolet light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian yellow"@en .

aat:300013863 a skos:Concept ;
    skos:definition "Lake pigment extracted from small berries from various a buckthorn plant, Rhamnus infectorius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian berries lake"@en .

aat:300013873 a skos:Concept ;
    skos:definition "A rich, transparent yellow, quercitron-based lake pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow carmine"@en .

aat:300013876 a skos:Concept ;
    skos:definition "Yellow pigment created artificially from iron oxide or another substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic inorganic yellow pigment"@en .

aat:300013878 a skos:Concept ;
    skos:definition "Pale yellow pigment with a greenish cast; lower in saturation than cadmium yellow, composed of barium chromate precipitated from a barium chloride solution by the addition of potassium dichromate. It has been used alone as an artists pigment, mixed with strontium yellow and zinc yellow as an artist pigment, for coloring glass, for ceramic glazes, in anticorrosion pastes, and in metal primers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium yellow"@en .

aat:300013887 a skos:Concept ;
    skos:definition "Permanent, yellow pigment containing cadmium. Earliest pigments were composed of cadmium sulfide, synthetically prepared in Germany by Friedrich Strohmeyer in 1817. Variations in particle size and chemical composition produce as range of colors from light yellow to orange. In the 1920s, the cadmium pigments were co-precipitated with barium sulfate to form the cheaper cadmium lithopone (cadmopone) pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium yellow"@en .

aat:300013891 a skos:Concept ;
    skos:definition "Cadmium sulfide and cadmium sulfoselenide colorants having a distinctive orange color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium orange"@en .

aat:300013895 a skos:Concept ;
    skos:definition "Yellow cadmium pigment co-precipitated with barium sulfate to form a cheaper cadmium lithopone (cadmopone) pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium yellow lithopone"@en .

aat:300013897 a skos:Concept ;
    skos:definition "Dark yellow versions of permanent pigment containing cadmium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep cadmium yellow"@en .

aat:300013901 a skos:Concept ;
    skos:definition "Pale, cool yellow variety of cadmium yellow pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon cadmium yellow"@en .

aat:300013904 a skos:Concept ;
    skos:definition "Cadmium yellow pigment of a medium darkness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle cadmium yellow"@en .

aat:300013907 a skos:Concept ;
    skos:definition "Cadmium yellow pigment of a light variety, but not so cool as cadmium yellow lemon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pale cadmium yellow"@en .

aat:300013910 a skos:Concept ;
    skos:definition "Pigment containing lead chromate, sometimes mixed with lead sulfate, ranging in color from lemon yellow to orange depending on its particle size, hydration state, and the percent lead chromate. It is is used in industrial paints, some artist's paints, and ceramic glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome yellow"@en .

aat:300013915 a skos:Concept ;
    skos:definition "A brilliant, transparent yellow pigment composed of potassium cobaltinitrite, used primarily in watercolor, tempera paints, oil-based glazes, and as a colorant in glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt yellow"@en .

aat:300013921 a skos:Concept ;
    skos:definition "A crystalline form of lead monoxide, the oxidized product of molten lead that has been stirred or atomized to incorporate air then cooled and ground to form the yellow powder. It is used as a drier in paint and varnish, for the fluxing of earthenware, and in the manufacture of glass. Litharge tends to be slightly more orange than massicot, another crystalline form of lead monoxide, due to the presence of small amounts of red lead oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litharge"@en .

aat:300013932 a skos:Concept ;
    skos:definition "Synthetically prepared yellow iron oxide pigment having a medium to deep yellow color with good tinting strength. It is permanent, inexpensive, has good-film forming properties, acts as a drier for oil paints, and used extensively in the paint industry to produce cream tints with titanium dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars yellow"@en .

aat:300013940 a skos:Concept ;
    skos:definition "Warm yellow pigment containing lead antimonate that has been used as a colorant for glass, ceramic tiles, and paint for at least 3500 years. It is probably named after the its resemblance to the yellow minerals found at Mount Vesuvius near Naples, Italy, although it not well documented that the pigment was first made in Naples. The specific color of the pigment depends on the method and temperature of manufacture. It came into widespread use in the 18th century, replacing lead-tin yellow as the pigment most often used by artists in Europe. The term is also used loosely to refer to other pigments imitating Naples yellow but produced by mixing together pigments such as cadmium yellow, zinc white, ochre, and Venetian red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Naples yellow"@en .

aat:300013947 a skos:Concept ;
    skos:definition "A lightfast, bright yellow pigment developed in the 1960s. It is compatible with most types of binding media, but the tinting strength is very low."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickel-titanium yellow"@en .

aat:300013976 a skos:Concept ;
    skos:definition "A pale yellow pigment used alone or mixed with other pigments, such as Prussian blue, barium yellow, and zinc yellow. It is used in oil paints, anticorrosive coatings, and pyrotechnics. It is not used often in watercolors due to its high opacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strontium chromate"@en .

aat:300013984 a skos:Concept ;
    skos:definition "A strong yellow pigment made by mixing powdered lead chloride with lead carbonate, then fusing. This yellow pigment was used for a short time in oil paints, but its sensitivity to light and sulfur fumes limited its use and it was replaced by chrome yellow pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turner's yellow"@en .

aat:300013991 a skos:Concept ;
    skos:definition "Yellow pigment made from uranium oxide. Previous to uranium being used in atomic fission, uranium compounds were sometimes used in glass and ceramics, although their expense makes their use impractical today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uranium yellow"@en .

aat:300013992 a skos:Concept ;
    skos:definition "A bright greenish yellow pigment derived by reacting zinc oxide with potassium dichromate solutions, colors varying depending on the proportions of each component. It is toxic, stable to light, unaffected by hydrogen sulfide, having less covering power than chrome yellow. It is used in oil and watercolors alone and mixed with Prussian blue, strontium yellow, or barium yellow, as a rust inhibitor, and as a plastic colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc yellow"@en .

aat:300013999 a skos:Concept ;
    skos:definition "Yellow pigment artifically derived from processed aromatic hydrocarbons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic organic yellow pigment"@en .

aat:300014001 a skos:Concept ;
    skos:definition "Dull yellow-brown, transparent pigment created when precipitated on an inert base from crystallized orange-brown needles made from a dilute glacial acetic acid solution. Developed in 1887 by R. Nietzki, it became the first azo mordant dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alizarin yellow"@en .

aat:300014002 a skos:Concept ;
    skos:definition "Refers to pigment of various varieties of bright yellow color, commonly used as inexpensive substitutes for cadmium yellows in paints, plastics, rubber and coated paper. The term was originally a brand name yellow synthetic organic pigments, but now refers to the entire class of yellow monoazo colorants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hansa yellow"@en .

aat:300014006 a skos:Concept ;
    skos:definition "Non-standardized term that was originally used for non-lightfast, transparent, yellow lake pigment formed from oak bark extract (quercitron) precipitated on alum or chalk, which was used in the 17th century, often in mixtures with blue to produce a dark green. Now the term is also used for modern synthetic organic pigments of similar color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow lake"@en .

aat:300014007 a skos:Concept ;
    skos:definition "An obsolete yellow lake pigment made from quercitron, a natural dyestuff obtained from the black or dark brown bark of the black oak, containing the colorants: quercetin, quercetagetin, and flavine. Quercetin produces a bright yellow with aluminum and tin, a tan with chrome, and an olive green with iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quercitron lake"@en .

aat:300014011 a skos:Concept ;
    skos:definition "Any pigment that contains more than one basic ingredient, as cadmium-barium yellow, which contains both cadmium sulfide and barium sulfate coprecipitated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite pigment"@en .

aat:300014012 a skos:Concept ;
    skos:definition "Pigment made available as pellets rather than powder or liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop pigment"@en .

aat:300014017 a skos:Concept ;
    skos:definition "\"Mars\" is now the common name used for synthetic iron oxide pigments. Mars colors are made from hydrated iron oxide co-precipitated with alum using lime or potash. The proportion of the mixture controls the degree of color; drying the product produces Mars yellow, other colors include orange, red, black, brown, and violet, produced by calcining the yellow. \"Mars\" was originally a brand name in the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars pigment"@en .

aat:300014029 a skos:Concept ;
    skos:definition "General term referring to the hair of either the Angora rabbit or the Angora goat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angora wool"@en .

aat:300014030 a skos:Concept ;
    skos:definition "Long, fine, soft hair of Peruvian alpacas. The term may be used to refer to a style of fabric originally made from alpaca hair but now often made from mohair, Icelandic sheep wool, or English wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alpaca"@en .

aat:300014034 a skos:Concept ;
    skos:definition "The residue left after grinding sugarcane and extracting the juice, employed in making paper and fiber building board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bagasse"@en .

aat:300014036 a skos:Concept ;
    skos:definition "The fiber of the grass species Macrochloa tenacissima, used to make cordage, shoes, and paper. It is sometimes used in combination with the poorer quality with fiber from another species of tall grass, Lygeum spartum. Esparto fibers are used extensively in England and Scotland for the production of paper, but rarely used in the U.S. because wood pulp is plentiful there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "esparto"@en .

aat:300014037 a skos:Concept ;
    skos:definition "A strong yellowish or reddish hard fiber derived from the leaves of the species Agave fourcroydes, a tropical American agave. Similar to sisal, henequen is a coarse, stiff fiber that is used for making ropes, twine, bags, hammocks, and shoe soles. Henequen has been used for coarse fabrics since prehistoric times in Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "henequen"@en .

aat:300014039 a skos:Concept ;
    skos:definition "Fiber derived from leaves of the species Agave sisalana. The fiber has been used since pre-Columbian times; the Aztecs are known to have made clothing from it. From the late 1930s sisal has been cultivated commercially in Central and South America as well as in Africa. It is a strong, stiff fiber with a pale cream color. Sisal is typically dyed bright colors with direct or acid dyes. Sisal is used for cordage, ropes, sacks, brushes, upholstery padding, rugs, matting, handbags, hats, dartboards, and in papermaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sisal"@en .

aat:300014041 a skos:Concept ;
    skos:definition "Fiber derived from the bast or skin of the stem of the species Linum usitatissimum. Soft, flexible fibers are produced by retting the stem of the flax plant, then washing and cleaning the fibers. Flax fibers of thinner and longer than cotton, but the fiber tube has thicker walls resulting in a stronger thread. Additionally, flax fibers are used for linen fabric, thread for making shoes and bookbinding, fish line, and twine. Waste flax fibers are used in banknotes, cigarette covers, and writing and drawing paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flax"@en .

aat:300014043 a skos:Concept ;
    skos:definition "Fiber derived from the stalk of the species Cannabis sativa. Fibers range from 1-2 m in length and are yellow to brown in color. They have a high cellulose content with little lignin. Hemp is lustrous, strong, and durable with good resistance to water, salts, light, and insects; used for cordage, fish lines, sailcloth, canvas, burlap, packing, and as a fiber for paper or for plastic filler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemp"@en .

aat:300014044 a skos:Concept ;
    skos:definition "Strong fiber obtained from leaf stems of the species Musa textilis, native to the Philippines. Not related to true hemp. It was exported to Europe and elsewhere in the 19th century and is now cultivated in Central America. Fibers are lustrous and range in color from cream to light purple, brown, or black, varying in texture from silky to stiff. It is used for rope, especially in marine environments since it is buoyant and does not swell in water. Coarser fibers are used for heavy cordage, twine, hats, hammocks, manila paper, and tissue paper. Fine, glossy fibers are used for carpets, tablecloths, placemats, purses, rugs, and clothing. Waste fibers are used for papers with high wet strength, such as tea bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manila hemp"@en .

aat:300014045 a skos:Concept ;
    skos:definition "Bast fiber derived from either of two East Indian plants (Corchorus olitorius and C. capsularis). The pale brown fibers are soft, lustrous, and coarse, ranging in length from 4 to 10 feet. The brittle fibers are used to produce a thread called hessian. Jute becomes so weak when wet that a thin twine can be broken by hand. It turns brown and degrades with time, sunlight, water, acids, alkalis, and bleach. Jute has been used since prehistoric times. It is used to make sackcloth, burlap cloth, gunnysacks, twine, paper, and carpet backing. It was also used to make brown paper in Europe in the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jute"@en .

aat:300014046 a skos:Concept ;
    skos:definition "Fiber from the species Hibiscus cannabinus. It is light colored, resistant to water, soft, elastic, and silky. Kenaf was unknown in the West until late in the 18th century, when cordage and sacking made from the fiber were brought to Europe. It was used as a substitute for jute fiber in WW II; also used as a substitute for hardwood fibers in papermaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kenaf"@en .

aat:300014048 a skos:Concept ;
    skos:definition "Bast fiber obtained from the bark species Edgeworthia papyrifera, native to China and cultivated in Japan. Mitsumata has been used for paper since about 1600 CE. The soft, absorbent fibers produce a paper that is weaker and less absorbent that kozo. Mitsumata paper also tends to shrink and expand with moisture content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitsumata"@en .

aat:300014051 a skos:Concept ;
    skos:definition "Strong fiber from leafstalks of palms of the genus Raphia, native to Africa and other places. Raffia fibers are used in their natural state by splitting apart thick sections and knotting the ends together. The fibers are a pale cream color and are often dyed to bright colors. Raffia is used to make skirts, woven into baskets, hats, bags, and mats. It is also used to make a fine grade of paper similar to Japanese papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raffia"@en .

aat:300014056 a skos:Concept ;
    skos:definition "Stiff, coarse, brown fibers derived from the outer bark of the fruit of the coconut palm, Cocos nucifera, used in making brushes, mats, cord, and coarse cloth. Coir is native to India and southeast Asia where it has been used since ancient times. It was introduced to Europe by Marco Polo in the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coir"@en .

aat:300014057 a skos:Concept ;
    skos:definition "Yellowish brown, lightweight seed-hair fiber obtained from the fruit of the species Ceiba pentandra. The highly inflammable, soft fibers have a smooth surface and are transparent. The fibers contain both lignin, a woody plant substance, and cellulose, a carbohydrate. Kapok is buoyant and will support up to 30 times its own weight. Although the fluffy fibers are too brittle to spin, they are used for filling mattresses, upholstery, life jackets, as insulation material, and as a substitute for absorbent cotton in surgery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kapok"@en .

aat:300014059 a skos:Concept ;
    skos:definition "Synthetic fiber made from regenerated cellulose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rayon"@en .

aat:300014063 a skos:Concept ;
    skos:definition "General term for carpets, fabrics, costume, or other works made of textile materials, which are natural or synthetic fibers created by weaving, felting, knotting, twining, or otherwise processing. For works of art or high craft that employ textile as a medium, prefer \"textile art (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textiles"@en .

aat:300014067 a skos:Concept ;
    skos:definition "Textile made from cotton fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotton"@en .

aat:300014068 a skos:Concept ;
    skos:definition "A heavy, twill-woven, warp-flush textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denim"@en .

aat:300014069 a skos:Concept ;
    skos:definition "General name for textile woven from the spun fiber of the flax plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linen"@en .

aat:300014070 a skos:Concept ;
    skos:definition "Term occasionally used to refer to hand-woven Italian linen from the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman linen"@en .

aat:300014071 a skos:Concept ;
    skos:definition "Bast fiber obtained from the stems of several varieties of the species Boehmeria nivea, native to tropical Asia but cultivated in China, Japan, Europe, South America, and the United States. The Ramie has been used in China for paper and fabric since prehistoric times. Its use spread through Europe in the Middle Ages. It is white or green in color, depending upon the variety. It is soft, fine, and durable fiber that is very lustrous and dyes well, used for twine, fishnets, sewing thread, and fabric for clothing, summer suits, dresses, canvas, tablecloths, and upholstery. Ramie has also been used to produce strong paper for linings, banknotes, and cigarettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramie"@en .

aat:300014072 a skos:Concept ;
    skos:definition "A fine, lustrous, natural fiber obtained from the catepillar cocoons of silk moths, such as the domesticated Bombyx mori. Silkworm silk is composed of a heavy and light chain of core proteins called fibroins, which are coated by sericin, a collection of sticky, glue-like proteins. Microscopically, raw silk appears as two strands that are held together with sericin protein. According to legend, silk was discovered by Chinese Empress Si-Ling-Shi when a cocoon fell in her tea. China maintained a monopoly on the production of silk fabric for almost 3,000 years.The worms were first cultivated in Japan about 195 CE and in Europe about 555 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silk"@en .

aat:300014074 a skos:Concept ;
    skos:definition "Refers especially to the fine, soft, curly hair or fleece of the sheep, but also refers to hair of the alpaca, vicuna, certain goats, and a few other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wool"@en .

aat:300014076 a skos:Concept ;
    skos:definition "Coarse canvas made of jute, used mainly for sacks and wrapping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burlap"@en .

aat:300014078 a skos:Concept ;
    skos:definition "Closely woven textile made in various weights, usually of flax, hemp, jute, or cotton, used especially for sails, tarpaulins, awnings, upholstery, bags, and as a support for oil painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canvas"@en .

aat:300014079 a skos:Concept ;
    skos:definition "Strong, heavy canvas, used chiefly for sails, tents, and upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailcloth"@en .

aat:300014080 a skos:Concept ;
    skos:definition "Weft pile weave with cut pile ribbed in the direction of the warp, usually made of cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corduroy"@en .

aat:300014083 a skos:Concept ;
    skos:definition "Woven textile in which the binding is achieved by a displacement of warp ends secured by the weft, resulting usually, though not always, in a very open weave; used particularly for surgical dressings and as backing for paper, especially maps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauze"@en .

aat:300014085 a skos:Concept ;
    skos:definition "A silk fabric of fine weave from Ghana. Long, narrow strips are hand-woven and then sewn together to form a pattern. Kente is typically found in delicate colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kente"@en .

aat:300014087 a skos:Concept ;
    skos:definition "Very fine plain weave white cotton made in a great variety of qualities; originally from India, it has been extensively produced and used in Europe and North America for costume, and sometimes as an artist's support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muslin"@en .

aat:300014089 a skos:Concept ;
    skos:definition "Asante stamped cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adinkra"@en .

aat:300014093 a skos:Concept ;
    skos:definition "Handcrafted textiles made in the city of Korhogo in the northern part of Côte d'Ivoire. The painted cloth is characterized by stylized human and animal forms. The images are hand-painted in dark brown dye on narrow strips that are sewn together to form larger sheets of cloth. Handcrafted textiles made in the city of Korhogo in the northern part of Côte d'Ivoire. The painted cloth is characterized by stylized human and animal forms. The images are hand-painted in dark brown dye on narrow strips that are sewn together to form larger sheets of cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "korhogo cloth"@en .

aat:300014094 a skos:Concept ;
    skos:definition "Cloth dyed or marked with a mud solution, as made by the Bamana people of Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mud cloth"@en .

aat:300014098 a skos:Concept ;
    skos:definition "Yoruba indigo dyed cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adire"@en .

aat:300014107 a skos:Concept ;
    skos:definition "Textile constructed usually of wool and fur fiber often mixed with natural or synthetic fiber by the interlocking of the loose fiber through the action of heat, moisture, chemicals, and pressure without spinning, weaving, or knitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felt"@en .

aat:300014108 a skos:Concept ;
    skos:definition "A type of heavy paper composed of rags impregnated with asphalt; used in the manufacture of waterproofing membranes, and for making asphalt shingles and other types of composition roofing, such as asphalt roofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rag felt"@en .

aat:300014109 a skos:Concept ;
    skos:definition "Refers generally to all types of thin matted or felted sheets or webs of fiber formed and dried on a fine screen from a pulpy water suspension. The fibers may be animal, such as hair, silk or wool, or mineral, such as asbestos, or synthetic. However most paper is made from cellulosic plant fiber, such as from wood pulp, grass, cotton, linen, and straw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper"@en .

aat:300014127 a skos:Concept ;
    skos:definition "A writing material prepared from thin strips of the pith of the papyrus plant laid together, soaked, pressed, and dried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papyrus"@en .

aat:300014129 a skos:Concept ;
    skos:definition "Paper made from thin layers of pith cut from two species of rice paper trees cultivated in China, Japan, and Thailand. Often erroneously referred to as 'rice paper,' which is misleading since it has no relationship to rice itself. The pith is cut in spirals to form long ribbons, the exposed cellular structure of the pith giving the paper a unique spongy structure. Pith paper is stretchy when wet and brittle when dry; it will crack when heated and is easily damaged by abrasion. Among other uses, pith paper was used for 19th-century Chinese watercolor paintings and artificial flowers. For handmade paper having long fibers from the paper mulberry, gampi, or mitsumata plant, use \"Japanese paper.\" For soft, fine-textured paper of bamboo fiber originating in China, use \"China paper.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pith paper"@en .

aat:300014130 a skos:Concept ;
    skos:definition "Paper made of 100% linen or cotton fiber. The general process of making rag paper involves boiling, shredding, and beating the rags to separate the fibers; the resulting smooth pulp is run over a fine screen in a thin layer and then dried and pressed. Rag paper is considered the finest paper support for paintings and similar works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rag paper"@en .

aat:300014131 a skos:Concept ;
    skos:definition "Paper made of the pulp of wood. In 1854, a process was patented for the mass production of paper pulp from wood, which was inferior in quality and durability to earlier papers. Paper manufactured before the 1850s was made primarily from bast fibers obtained from linen, flax, rags, or cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood pulp paper"@en .

aat:300014133 a skos:Concept ;
    skos:definition "A very strong paper, usually a light brown in color, which was originally made from rope but now is produced from unbleached sulfate wood pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kraft paper"@en .

aat:300014136 a skos:Concept ;
    skos:definition "Fifty- to eighty-pound Manila paper, waxed on one side, originally used for muzzle-loading cartridges, but now employed where a stiff, waterproof material is needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartridge paper"@en .

aat:300014137 a skos:Concept ;
    skos:definition "Inexpensive, low quality paper made from wood pulp, of the type used chiefly for printing newspapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newsprint"@en .

aat:300014140 a skos:Concept ;
    skos:definition "A glazed, highly beaten, semi-transparent paper used to make envelopes or envelope windows, sleeves for storing photographs and other paper materials, food packaging, and sanitary wrapping. Glassine is made from bleached sulfite wood pulp that has been excessively beaten, hydrated then supercalendered. It is resistant to oils and greases and, when waxed or laminated, nearly impermeable to air and water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassine"@en .

aat:300014141 a skos:Concept ;
    skos:definition "A very thin, opaque Asian paper that was made in China and imported to Europe by the Dutch East India Company from about 1768 to 1875. India paper is thin with a basis weight of 20 pounds with approximately 1000 pages to an inch, used for printing thin paper editions such as bibles and reference books. In the late 19th century, it was replaced for this use by an imitation called \"Bible paper,\" which is a rag paper originally manufactured by Oxford University Press."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "India paper"@en .

aat:300014143 a skos:Concept ;
    skos:definition "Refers to various types of handmade paper, particularly strong, handmade paper composed of long bast fibers derived from the paper mulberry (Broussonetia papyrifera), the gampi (Wikstroemia canascens) and the mitsumata (Edgeworthia papyrifera). Thin, translucent sheets of Japanese paper are often used as a reinforcing paper and hinges because of their strength, flexibility, and permanence. Specifically for paperlike material made from the pith of the rice paper tree, use \"rice paper.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese paper"@en .

aat:300014144 a skos:Concept ;
    skos:definition "Lightweight, highly finished transparent writing paper made transparent by hydration of the pulp in beaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onionskin paper"@en .

aat:300014145 a skos:Concept ;
    skos:definition "A thin, translucent paper that may be loosely felted to make it absorbent or it may have a hard, smooth surface making it an excellent wrapping paper. It is primarily used for packing, wrapping, or protecting delicate items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tissue paper"@en .

aat:300014148 a skos:Concept ;
    skos:definition "An absorbent paper made from spongy, bulky fibers or loosely felted fibers which is used to soak up excess ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blotting paper"@en .

aat:300014149 a skos:Concept ;
    skos:definition "An absorbent, porous paper suitable for use as a filter. It is made from spongy, bulky fibers, such as poplar, or loosely felted fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filter paper"@en .

aat:300014150 a skos:Concept ;
    skos:definition "Paper used for insulation, as in walls, roofs, and between floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building paper"@en .

aat:300014151 a skos:Concept ;
    skos:definition "Sheathing paper used on roofs and side walls of buildings as protection against dampness; also used as insulation. Felt paper applied to roofs is usually infused with tar, asphalt, or chemical compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felt paper"@en .

aat:300014152 a skos:Concept ;
    skos:definition "Heavy paper coated or impregnated with tar for use especially in building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tar paper"@en .

aat:300014156 a skos:Concept ;
    skos:definition "A type of lightweight transfer paper used for duplicating typewriting, pencil, or pen writing. The paper is coated on one side with dark pigment and a medium, typically a mix of waxes and oils, that is transferred to a copying surface such as paper by the impact of writing pressure or typewriter keys. Smudgeproof carbon paper has an additional coating of plastic lacquer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon paper"@en .

aat:300014157 a skos:Concept ;
    skos:definition "Heavy paper, typically white or buff in color, used for making drawings; it can be either smooth or rough, the smooth being hot-pressed. Good grades of drawing paper should allow considerable erasure without destroying its appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing paper"@en .

aat:300014158 a skos:Concept ;
    skos:definition "A soft paper of moderately rough grain that takes and holds charcoal well and is also adaptable to other drawing and painting mediums. It is available in pure white and a variety of tints. The best grades have a high rag content and usually a laid or watermark finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal paper"@en .

aat:300014159 a skos:Concept ;
    skos:definition "Paper ruled into small squares of equal size for use in drawing charts, graphs, or diagrams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graph paper"@en .

aat:300014161 a skos:Concept ;
    skos:definition "Any translucent paper which, when laid over an existing image, permits the image to be seen and traced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracing paper"@en .

aat:300014164 a skos:Concept ;
    skos:definition "Translucent vellum paper often used for architectural drawings and tracings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracing vellum"@en .

aat:300014171 a skos:Concept ;
    skos:definition "An unsized, absorbent white paper saturated with litmus and used to test for acidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litmus paper"@en .

aat:300014172 a skos:Concept ;
    skos:definition "A comprehensive term used by printers for the innumerable varieties of paper suitable for the many processes of reproduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing paper"@en .

aat:300014173 a skos:Concept ;
    skos:definition "A paper suitable for printing books, magazines, and advertising matter including many grades of plain and coated papers but excluding newsprint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book paper"@en .

aat:300014177 a skos:Concept ;
    skos:definition "Typically refers to strong paper usually made from mixed pulps that is used for packing or wrapping parcels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrapping paper"@en .

aat:300014178 a skos:Concept ;
    skos:definition "Heavy paper usually used for wrapping meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butcher paper"@en .

aat:300014179 a skos:Concept ;
    skos:definition "Paper intended for writing upon with ink; usually finished with a smooth surface and sized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing paper"@en .

aat:300014180 a skos:Concept ;
    skos:definition "A hard-finished writing paper made from the long fibers of spruce. The term also refers to superior-grade, strong white paper made wholly or in part from rag pulp. Many artists like bond paper's smooth finish for sketching and pen drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bond paper"@en .

aat:300014183 a skos:Concept ;
    skos:definition "Handmade paper that is produced in a centuries-old traditional manner in Japan from the fiber of gampi tree bark, kozo (mulberry), the mitsumata shrub, bamboo, hemp, rice, or wheat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washi"@en .

aat:300014184 a skos:Concept ;
    skos:definition "Paper, typically hand-made, produced by laying the pulp on a wire screen that leaves parallel and perpendicular translucent lines in the finished product. The parallel lines in one direction are heavier and more widely spaced than those in the orthogonal direction. There is often a watermark pattern incorporated into the screen. The look of handmade laid paper may be simulated by using a dandy roll to transfer a similar pattern. Laid paper is distinguished from \"wove paper,\" which has a crosshatched or even appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laid paper"@en .

aat:300014187 a skos:Concept ;
    skos:definition "Paper, typically handmade, manufactured by casting the pulp onto a woven screen made from wire mesh or fabric. When examined in transmitted light, wove paper shows a characteristic weave impression from the screen pattern. It is distinguished from \"laid paper,\" which shows a pattern of thick and thin transucent lines that have been transmitted from a wire screen used in manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wove paper"@en .

aat:300014190 a skos:Concept ;
    skos:definition "Paper used for making photographic prints that consists of a base material with a white or near-white surface that is coated with one or more emulsion layers. It is typically a high grade of paper traditionally made from 100% cotton or linen rags, because lignin and other residues in other paper would react with the photosensitive salts and destroy the image. Photographic paper is strong, uniform, and dimensionally stable when wet and dry. For increased wet-strength, the papers are sized with animal glue, starch, stearic acid, or synthetic resins, such as melamine (used since 1948). One or more fillers, such as barium sulfate, titanium dioxide, clay, starch, or polyacrylamide, are also added for opacity, color, and strength. The papers were calendered to produce a smooth, nonporous surface. Since the late 1960s, most color photographic papers have been made from cellulose fibers coated on both sides with polyethylene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic paper"@en .

aat:300014193 a skos:Concept ;
    skos:definition "Paper coated with a substance that may be imprinted on a surface by the application of pressure, moisture, or heat and pressure; it often has a backing of glassine paper. In general, it is any type of paper used to transfer an image to another surface. Examples include decal paper, carbon paper, transfer lithography paper, and transferotype (a special bromide paper with soluble gelatin first made by Kodak in 1888 for transfering photographic emulsions). The term also refers to special papers used in the process of transfer lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transfer paper"@en .

aat:300014196 a skos:Concept ;
    skos:definition "Multipurpose board used in construction, such as for insulation or structural purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building board"@en .

aat:300014203 a skos:Concept ;
    skos:definition "A material, typically used for building, composed of 100% wood fibers. Fibers are usually obtained from wood chips, sawdust, and board trimmings; they are broken into fine particles by grinding (dry process) or by steam (wet process). The interfelted fibers are consolidated with heat and pressure (at least 31 pounds per cubic foot) to form a dense, rigid sheet that is held together by naturally occurring lignin with no additional adhesive. Hardboards range from a dark brown to a light tan in color and have one very smooth surface; the reverse side has a wire screen impression. Some hardboards contain a small amount of oil on the surface either as a residual lubricant or as an additive to increase weather resistance; these oils may hinder the adherence of paint or gesso and may be removed with acetone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardboard"@en .

aat:300014205 a skos:Concept ;
    skos:definition "A registered trademark for a type of hardboard building material first made in 1924 by William H. Mason. Masonite is a wet process fiberboard composed of fine wood fibers compressed into a dense, rigid sheet with heat. The fibers are held together by the natural binders from the pulp with no additional adhesive. Masonite boards do not bend or warp easily but the sheets are brittle and break under pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Masonite (TM)"@en .

aat:300014206 a skos:Concept ;
    skos:definition "A composite wood board made from small wood chips mixed with a water-insoluble adhesive, then compressed into a dense solid panel. Particle boards were originally made in 1915 as wallboards. The most common adhesive in particle boards is urea formaldehyde glues are used which release volatile formaldehyde. Some particles boards are made with polyurea or phenolic resins. Particle boards are water-resistant, insect resistant, and dimensionally stable during humidity and temperature fluctuations. Particle boards are commonly used in the construction of inexpensive furniture, cabinetry and mobile homes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particle board"@en .

aat:300014208 a skos:Concept ;
    skos:definition "Cheap paperboard product made from waste paper or wood refuse. Used for boxes, book covers, or any application where appearance is inessential."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chipboard"@en .

aat:300014224 a skos:Concept ;
    skos:definition "A type of stiff pasteboard that is thicker than 0.006 inches, typically consisting of good-quality chemical pulp or rag pasteboard, and varying greatly in type and stability. High quality archival cardboard is made from rag pulp and has a low acid content, used for mounting prints, drawings and watercolors. Other grades of cardboard is used for cards, signs, printed materials, and high-quality boxes. Inferior grades of cardboard, such as corrugated board, are made from coarsely ground sulfite treated wood pulp; for this board, use \"corrugated board.\" The first carboard box was produced in England in 1817. Corrugated cardboard was patented in 1871."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardboard"@en .

aat:300014228 a skos:Concept ;
    skos:definition "A high-grade white cardboard, supercalendered with China clay; also made by pasting together sheets of heavy ledger paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bristol board"@en .

aat:300014229 a skos:Concept ;
    skos:definition "Laminated paper board that has paper layers glued to its surface; used commonly as temporary artists' supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illustration board"@en .

aat:300014230 a skos:Concept ;
    skos:definition "An artist's white drawing board with stippled texture that produces a dotted drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coquille board"@en .

aat:300014231 a skos:Concept ;
    skos:definition "Highly finished cardboard that is clay-coated on both sides; used chiefly for menus and printed material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivory board"@en .

aat:300014232 a skos:Concept ;
    skos:definition "Stiff cardboard faced with decorative paper, foil, or cloth, sometimes also having a textured surface; used for matting two-dimensional art work or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mat board"@en .

aat:300014233 a skos:Concept ;
    skos:definition "A stiff, heavy cardboard primarily used for book covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millboard"@en .

aat:300014235 a skos:Concept ;
    skos:definition "Heavy, smooth cardboard coated with a ground that has sufficient roughness for the application of oil paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academy board"@en .

aat:300014236 a skos:Concept ;
    skos:definition "Common gray cardboard or pasteboard to which a white cotton textile, prepared for oil painting, has been glued or pasted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canvas board"@en .

aat:300014237 a skos:Concept ;
    skos:definition "Laminated type of mat board made from linen or cotton rags, or from deacidified and buffered paper pulp; often used to remount pictures backed with lower-quality supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museum board"@en .

aat:300014239 a skos:Concept ;
    skos:definition "Trade name for a large and varied line of textured boards that are similar to coquille boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ross board (TM)"@en .

aat:300014240 a skos:Concept ;
    skos:definition "Cardboard coated with a smooth layer, usually of gesso, and then with drawing ink. An image is made by scraping away areas of ink and exposing the white layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratchboard"@en .

aat:300014244 a skos:Concept ;
    skos:definition "A strong paper board containing no jute fiber but made typically from sulfate and wastepaper pulp, used especially for shipping containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jute board"@en .

aat:300014245 a skos:Concept ;
    skos:definition "Composite material used for molding objects; made of repulped or pulverized paper and a liquid adhesive binder. May also comprise strips of paper, sometimes reinforced with textiles, stuck together with a wet adhesive, and used to form an object. The object becomes solid when the paste dries; the object may then be sanded, lacquered, and painted. Such objects are very durable; they first developed in Asia and were common in Europe and elsewhere since the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papier mâché"@en .

aat:300014247 a skos:Concept ;
    skos:definition "Long, slender, flexible, roughly cylindrical construction of fibrous material, usually made of several strands twisted together. Cord is typically made from a type of bast fiber such as cotton, jute, flax, ramie, hemp, sisal, olona, gravata, agel, widuri, caraguata, or others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cord"@en .

aat:300014248 a skos:Concept ;
    skos:definition "Heavy cord, at least 1/4 inch in diameter, formed by twisting or braiding two or more yarns of natural or artificial fiber. In ancient Egypt, rope was made from reeds or date palm fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rope"@en .

aat:300014249 a skos:Concept ;
    skos:definition "Cord thicker than thread and thinner than rope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "string"@en .

aat:300014250 a skos:Concept ;
    skos:definition "Single filaments of fiber, groups of such filaments twisted tightly together, or filamentous lengths formed by spinning and twisting short fibers into a continuous strand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread"@en .

aat:300014251 a skos:Concept ;
    skos:definition "Strong string composed of two or more strands twisted together, especially that which measures less than 3/16 of an inch in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twine"@en .

aat:300014252 a skos:Concept ;
    skos:definition "Continuous strands, either single or compound, made from filaments of fiber by reeling, spinning, twisting, or throwing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yarn"@en .

aat:300014253 a skos:Concept ;
    skos:definition "Soft, slightly twisted strands of fiber that have been attenuated and cleaned of foreign matter preparatory to final conversion into yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roving"@en .

aat:300014254 a skos:Concept ;
    skos:definition "Any greasy substance that is liquid at room temperature and insoluble in water. Fixed (nonvolatile) oils have the same chemical composition as fats: they consist chiefly of glycerides, resulting from a reaction between glycerol and fatty acids. Oils may be divided by function and type: mineral (e.g., paraffin), vegetable (e.g., linseed), animal (e.g., fish), essential (e.g., turpentine), or edible (e.g., olive)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil"@en .

aat:300014256 a skos:Concept ;
    skos:definition "Oil obtained from animal substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal oil"@en .

aat:300014257 a skos:Concept ;
    skos:definition "A colorless, aliphatic hydrocarbon oil obtained from petroleum distilled at 330-360 degrees C."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral oil"@en .

aat:300014258 a skos:Concept ;
    skos:definition "Oil extracted from plant parts, such as seeds, fruits, or nuts. They contain a mixture of glycerides and may be considered drying, sem-drying, or nondrying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable oil"@en .

aat:300014259 a skos:Concept ;
    skos:definition "Aromatic oil found in uncombined form in various parts of plants and employed for flavoring, perfume, disenfectant, and medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "essential oil"@en .

aat:300014261 a skos:Concept ;
    skos:definition "An essential oil obtained from the dried flower buds of clove tree (Eugenia caryophyllata or Syzygium aromaticum), containing eugenol along with carophyllin, tannin, gum, and resin. Used as an additive used to retard the drying of paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil of cloves"@en .

aat:300014262 a skos:Concept ;
    skos:definition "A colorless to yellowish aromatic essential oil obtained from the flowers of several species of lavender; used as a retardant in oil paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavender oil"@en .

aat:300014264 a skos:Concept ;
    skos:definition "Oil distilled from an inferior grade of lavender. Oil of spike is used in painting on porcelain, in soap, scent, and food flavorings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spike oil"@en .

aat:300014266 a skos:Concept ;
    skos:definition "A pungent essential oil obtained from the flowering tops of rosemary and used chiefly in soap, cologne, hair lotion, pharmaceutical preparations, and as a retardant in oil paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosemary oil"@en .

aat:300014268 a skos:Concept ;
    skos:definition "Oily fat-based lubricant often derived from rendered animal parts, or a synthetic petroleum-derived product resembling this. Oily fat-based lubricant often derived from rendered animal parts, or a synthetic petroleum-derived product resembling this."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grease"@en .

aat:300014270 a skos:Concept ;
    skos:definition "An oil or oily preparation used on cutting tools or on work being machined to aid in the cutting action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting oil"@en .

aat:300014271 a skos:Concept ;
    skos:definition "Petroleum products, usually heavy distillates after kerosene, that are classified based on their viscosity for various purposes, ranging from very thin oils for high speed textile machinery, to heavier, tackier, or stickier oils for bearings or open gears. Automobile oil is the most common in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lubricating oil"@en .

aat:300014273 a skos:Concept ;
    skos:definition "A thickened oil obtained by blowing a fatty acid, such as linseed oil or fish oil; used in paint and varnish as a drying oil and in lubricant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blown oil"@en .

aat:300014275 a skos:Concept ;
    skos:definition "Any vegetable oil that has been extracted from seeds or nuts by pressing them without the aid of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold-pressed oil"@en .

aat:300014276 a skos:Concept ;
    skos:definition "A commercial grade of linseed oil that is the slowest-drying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw oil"@en .

aat:300014277 a skos:Concept ;
    skos:definition "Oil converted into a soap or crystalline form through combination with an alkali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saponified oil"@en .

aat:300014278 a skos:Concept ;
    skos:definition "Heavy viscous material resulting from the polymerization of an oil, such as linseed oil; used chiefly in painting and glazing mediums; unlike raw oil, tends not to yellow with age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stand oil"@en .

aat:300014280 a skos:Concept ;
    skos:definition "Polymerized stand oil of increased viscosity, created by heat in the absence of oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle oil"@en .

aat:300014284 a skos:Concept ;
    skos:definition "Oils prepared by natural thickening in sunlight. This is most often a linseed oil. Sun-thickened oil is similar to stand oil, but is prized for is fast-drying properties as a painting medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun-thickened oil"@en .

aat:300014286 a skos:Concept ;
    skos:definition "Any oil that will solidify to a tough, leathery film when spread out in thin layers, either alone or with the assistance of a drier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drying oil"@en .

aat:300014287 a skos:Concept ;
    skos:definition "A drying oil whose drying properties have been increased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodied oil"@en .

aat:300014290 a skos:Concept ;
    skos:definition "Oil obtained from fish and marine animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish oil"@en .

aat:300014291 a skos:Concept ;
    skos:definition "Oil obtained from the seeds of the hemp plant. Used as a substitute for linseed oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hempseed oil"@en .

aat:300014292 a skos:Concept ;
    skos:definition "Popular drying oil used as a paint medium; hardens over several weeks as components of the oil polymerize to form an insoluble matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linseed oil"@en .

aat:300014294 a skos:Concept ;
    skos:definition "Linseed oil prepared by heating to less than 600 F in a closed container to eliminate oxygenation. It dries quickly and creates a hard film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boiled oil"@en .

aat:300014295 a skos:Concept ;
    skos:definition "Linseed oil cooked at a high temperature with as much white lead or litharge as will combine with it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black oil"@en .

aat:300014297 a skos:Concept ;
    skos:definition "A drying oil obtained from the kernel of the fruit of the oiticica tree that is similar to tung oil; used chiefly in varnish, paint, and printing ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oiticica oil"@en .

aat:300014298 a skos:Concept ;
    skos:definition "Drying oil used in house and industrial paint, linoleum, and printing ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perilla oil"@en .

aat:300014299 a skos:Concept ;
    skos:definition "Oil obtained from the seeds of the opium poppy, Papaver somniferum. When cold pressed, it is a naturally, colorless, transparent oil used as a drying oil, sometimes used as an additive to linseed-oil colors. Hot pressed oil is reddish. It produces a soft, rubbery paint film with a long wet-in-wet work time that was popular with Impressionist painters. Thick layers of poppy oil paint films tend to wrinkle and crack on aging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poppy-seed oil"@en .

aat:300014301 a skos:Concept ;
    skos:definition "A pale, non-yellowing drying oil of good film-forming properties and excellent color retention."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safflower oil"@en .

aat:300014302 a skos:Concept ;
    skos:definition "A pale yellow drying oil obtained from soya beans. It is frequently used in paint and varnish, and sometimes mixed with linseed oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soybean oil"@en .

aat:300014304 a skos:Concept ;
    skos:definition "A pale yellow drying oil with a pleasant odor and taste obtained from the large seeds of the common sunflower plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunflower oil"@en .

aat:300014305 a skos:Concept ;
    skos:definition "Vegetable oil made from tobacco seeds and used as a drying oil. It has an iodine value of 140 to 146."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco seed oil"@en .

aat:300014307 a skos:Concept ;
    skos:definition "A semidrying oil used in hardwearing varnish and enamel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tung oil"@en .

aat:300014309 a skos:Concept ;
    skos:definition "Oil derived from the nuts of the tree Aleurites cordata. It does not gelatinize when heated and is used for varnishes, waterproofing, paper and soaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese tung oil"@en .

aat:300014310 a skos:Concept ;
    skos:definition "A yellowish drying oil used especially for artist's paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walnut oil"@en .

aat:300014312 a skos:Concept ;
    skos:definition "Vegetable oil made from the cotton plant, and popular as a food oil, such as in salad oils and margarine. Cottonseed oil also has a wide range of industrial uses, such as an ingredient in soaps and paint oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottonseed oil"@en .

aat:300014313 a skos:Concept ;
    skos:definition "Yellow-brown poisonous oil derived from the seeds of the tree Croton tiglium native to India and Sri Lanka. Originally used as a purgative and as a substitute for castor oil, it is now thought too dangerous for medicinal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "croton oil"@en .

aat:300014314 a skos:Concept ;
    skos:definition "Yellow oil derived from the kernels of seeds of Jatropha curcas, native to Central America. This oil is used in cooking, soap, and as a strong purgative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curcas oil"@en .

aat:300014315 a skos:Concept ;
    skos:definition "A semidrying oil obtained from the seeds of the kapok tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kapok oil"@en .

aat:300014316 a skos:Concept ;
    skos:definition "Edible oil obtained from corn kernels, valued for its transparent flavor and light colour. It is used in a variety of edible and inedible products including cosmetics. Edible oil obtained from corn kernels, valued for its transparent flavor and light colour. It is used in a variety of edible and inedible products including cosmetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn oil"@en .

aat:300014317 a skos:Concept ;
    skos:definition "Oil characterized by lower iodine values. These oils will remain viscous within a range of moderate temperature indefinitely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nondrying oil"@en .

aat:300014318 a skos:Concept ;
    skos:definition "A colorless or pale yellow bland and nearly odorless nondrying fatty oil used as an emollient."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almond oil"@en .

aat:300014319 a skos:Concept ;
    skos:definition "Viscous, clear to pale yellow non-volatile fatty oil obtained from the seeds of Ricinus communis or Palma Christi of the spurge family, having a nauseating taste. Used in medicine as a purgative, and also in the production of synthetic resins, plastics, fibres, paints, varnishes, drying oils, and plasticizers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castor oil"@en .

aat:300014321 a skos:Concept ;
    skos:definition "Generally, an oil that is extracted from the kernel or pit of a fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kernel oil"@en .

aat:300014322 a skos:Concept ;
    skos:definition "Vegetable oil obtained from mustard seeds, characterized as a nondrying oil primarily used in food products, medicines, and a plasticizer with drying oils and with natural and synthetic resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustard oil"@en .

aat:300014323 a skos:Concept ;
    skos:definition "Vegetable oil extracted from the ripe fruit of olive trees, and used mainly for food and cooking oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive oil"@en .

aat:300014324 a skos:Concept ;
    skos:definition "Vegetable oil extracted from the seed kernel of the peanut. The oil is edible and used for cooking, but is also used in soaps and fuels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peanut oil"@en .

aat:300014326 a skos:Concept ;
    skos:definition "An oil obtained from seeds of the mustard family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rape oil"@en .

aat:300014328 a skos:Concept ;
    skos:definition "Vegetable oil obtained from rice bran and used in cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice oil"@en .

aat:300014329 a skos:Concept ;
    skos:definition "A water-dispersible cleansing and emulsifying agent produced by the saponification reaction of long chain fatty acids, such as found in oils and fats, with an alkali, such as sodium hydroxide or lye. Soaps made from animal fat and wood ashes have been used since antiquity. Although soap was made at home for laundry purposes from the European Middle Ages to early modern times, cake soap was a luxury product that came into common use only in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soap"@en .

aat:300014330 a skos:Concept ;
    skos:definition "Unconsolidated material on the earth's surface formed by the weathering of rock and that portion of the earth's surface that can support plant life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil"@en .

aat:300014332 a skos:Concept ;
    skos:definition "Any kind of earth, especially clay, that is mixed with water to make mortar in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chika"@en .

aat:300014333 a skos:Concept ;
    skos:definition "Dark brown or black non-living organic substance derived from microbial decomposition of plant and animal substances on the surface of the earth. Living plants derive nutrients from the forms created by this decomposition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humus"@en .

aat:300014334 a skos:Concept ;
    skos:definition "A residual product of rock decay that is red in color and has a high content in the oxides of iron and hydroxide of aluminum and a low proportion of silica. Used in African and Asian building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laterite"@en .

aat:300014335 a skos:Concept ;
    skos:definition "Soft, easily worked soil containing sand, silt, and clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loam"@en .

aat:300014336 a skos:Concept ;
    skos:definition "Wind-laid deposits of silt and dust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loess"@en .

aat:300014337 a skos:Concept ;
    skos:definition "Soil containing so much water that it is soft and at least semi-fluid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mud"@en .

aat:300014340 a skos:Concept ;
    skos:definition "An unconsolidated deposit of semicarbonized plant remains formed in a water-saturated environment such as a bog."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peat"@en .

aat:300014341 a skos:Concept ;
    skos:definition "Material consisting of fragmented particles of mostly siliceous rock, specifically as it appears on the surface of a beach or a desert. Individual particles may range in diameter from approximately 0.0008-0.08 inch. Most rock-forming minerals at the Earth's surface may be constituents of sand, but a limited number are common. Quartz is most common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand"@en .

aat:300014345 a skos:Concept ;
    skos:definition "Selected sand used for concrete, for mortar, for laying bricks, and for plastering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building sand"@en .

aat:300014346 a skos:Concept ;
    skos:definition "Floor covering comprising loose sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flooring sand"@en .

aat:300014347 a skos:Concept ;
    skos:definition "A building sand graded for three separate purposes: concrete pavement, asphalt pavement, and grouting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paving sand"@en .

aat:300014348 a skos:Concept ;
    skos:definition "A fine white silica sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing sand"@en .

aat:300014349 a skos:Concept ;
    skos:definition "Any sand employed for making molds for casting metal, but especially refers to refractory sand that has binding qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundry sand"@en .

aat:300014351 a skos:Concept ;
    skos:definition "Sand employed in glassmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass sand"@en .

aat:300014352 a skos:Concept ;
    skos:definition "Sand comprised of silica, which is 98% pure, and used in glassmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silica sand"@en .

aat:300014354 a skos:Concept ;
    skos:definition "Fine white clay mixed with lime; used chiefly as building and plastering material, and for sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zaccab"@en .

aat:300014356 a skos:Concept ;
    skos:definition "Coarse, granular, sandlike substance that consists chiefly of clay, made into a mortar used in African building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daga"@en .

aat:300014357 a skos:Concept ;
    skos:definition "Construction material consisting of daga, which is a coarse, granular, sandlike substance, that has been burnt to increase its durability and impermeability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnt daga"@en .

aat:300014358 a skos:Concept ;
    skos:definition "Sections of earth together with the grass growing on them, held together with matted roots, usually square or oblong in shape and of moderate thickness, cut out or pared off from the surface of grass land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sod"@en .

aat:300014361 a skos:Concept ;
    skos:definition "Soil borrowed from another location to be used in construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borrow soil"@en .

aat:300014362 a skos:Concept ;
    skos:definition "A building material consisting of stiff earth or clay forced in between forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pisé"@en .

aat:300014365 a skos:Concept ;
    skos:definition "A material usually consisting of clay, sand, or other aggregate, such as sea shell, and water, which has been compressed and dried; used in building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rammed earth"@en .

aat:300014368 a skos:Concept ;
    skos:definition "Clay with a component of fine gravel used to make bricks or otherwise puddled, rammed, and dried. Primarily used for wall construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapia"@en .

aat:300014374 a skos:Concept ;
    skos:definition "Portland cement mixed with the existing soil to serve as a paving or surfacing material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil cement"@en .

aat:300014379 a skos:Concept ;
    skos:definition "A synthetic polymer with elastic properties similar to natural rubber that can recover its original size after repeated extensions to more than twice its initial length. Examples of elastomers are polybutadiene, styrene-butadiene rubber, nitrile rubber, and butyl rubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elastomer"@en .

aat:300014380 a skos:Concept ;
    skos:definition "An ethylene-propylene elastomer noted for resistance to oils, ozone, weathering and heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epichlorohydrin elastomer"@en .

aat:300014381 a skos:Concept ;
    skos:definition "A commercially produced rubber with high chemical resistance and tear strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethylene-propylene elastomer"@en .

aat:300014384 a skos:Concept ;
    skos:definition "Elastomer which is highest in resistance to oxidation, chemicals, oil, solvent, and heat; typical applications are brake seals, O rings, diaphragms, and hose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorocarbon elastomer"@en .

aat:300014385 a skos:Concept ;
    skos:definition "A synthetic rubber which is a copolymer of isobyutylene, and 1 to 3% isoprene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butyl rubber"@en .

aat:300014387 a skos:Concept ;
    skos:definition "Synthetic rubber made by polymerization of chloroprene and characterized by superior resistance to oil, gasoline, sunlight, ozone, and heat, and by lower permeability to gas than rubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neoprene"@en .

aat:300014389 a skos:Concept ;
    skos:definition "An oil-resistant synthetic rubber or copolymer of acrylonitrile and butadiene used in such applications as oil well parts, gaskets, rollers, or fuel hoses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrile elastomer"@en .

aat:300014395 a skos:Concept ;
    skos:definition "A class of elastomers that is notable for performance at low temperatures, resilience, and abrasion resistance. Used for shoe heels and soles, gaskets, and belting. Combined with other rubbers to improve their resilience and flexibility at low temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polybutadiene elastomer"@en .

aat:300014396 a skos:Concept ;
    skos:definition "Polymeric substance prepared from derivatives of ethylene that are capable of recovering their original shape after being stretched to great extents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyethylene elastomer"@en .

aat:300014397 a skos:Concept ;
    skos:definition "Isoprene polymer which includes the main constituent in natural rubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyisoprene"@en .

aat:300014404 a skos:Concept ;
    skos:definition "Synthetic rubber formed from a salt or other compound which contains two or more sulfur atoms bonded together as an anion or group that are capable of recovering their original shape after being stretched to great extents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polysulfide elastomer"@en .

aat:300014406 a skos:Concept ;
    skos:definition "Semi-inorganic polymers based on siloxanes that will return to approximate original length after stretching, and that demonstrate heat, chemical, and water resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicone elastomer"@en .

aat:300014407 a skos:Concept ;
    skos:definition "Elastomer with a high degree of solvent resistance and excellent low-temperature capabilities created by the addition of fluorine into a polyalkylsilsiloxane system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorosilicone elastomer"@en .

aat:300014408 a skos:Concept ;
    skos:definition "Synthetic rubber made by the copolymerization of two compounds (one being butadiene) and a catalyst (sodium)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "styrene-butadiene rubber"@en .

aat:300014414 a skos:Concept ;
    skos:definition "Copolymers of diisocyanate with polyester or polyether. Urethane is the strongest available elastomer, and has good abrasion resistance. Applications include parts requiring high wear resistance, such as wheels, heels, and bumpers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urethane elastomer"@en .

aat:300014415 a skos:Concept ;
    skos:definition "Plastic that becomes soft when heated and hard when cooled, no matter how often these processes are repeated, because of little or no cross-bonding between molecules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoplastic"@en .

aat:300014418 a skos:Concept ;
    skos:definition "Thermoplastic with applications in appliance, automotive, and business machine manufacture, among others. Available in varied grades, ABS consists of discrete , crosslinked rubber particles that are grafted with polystyrene-co-acrylonitrile and embedded in a SAN matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylonitrile-butadiene-styrene copolymer"@en .

aat:300014421 a skos:Concept ;
    skos:definition "Highly crystalline resin that is among the strongest and stiffest types of thermoplastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetal"@en .

aat:300014426 a skos:Concept ;
    skos:definition "Colorless, transparent, thermoplastic synthetic resin made by the polymerization of acrylic acid derivatives; used for adhesives, fibers, consolidants, protective coatings, finishes, and as a paint medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic"@en .

aat:300014431 a skos:Concept ;
    skos:definition "A polymer of acrylic acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyacrylate"@en .

aat:300014434 a skos:Concept ;
    skos:definition "Methyl methacrylate made by E. I. du Pont de Nemours and Company, Inc., marketed in rolling powder and in rolls, tubes, and cast and molded sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lucite (TM)"@en .

aat:300014435 a skos:Concept ;
    skos:definition "Commercially produced, British acrylic plastic consisting essentially of polymerized methyl methacrylate. Polymethyl methacrylate was discovered in the early 1930s by British chemists at Imperial Chemical Industries in England and trademarked the name Perspex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Perspex (TM)"@en .

aat:300014436 a skos:Concept ;
    skos:definition "Proprietary name for polymerized methyl methacrylate, used as a substitute for glass in products such as windows, skylights, illuminated signs, and aircraft. Plexiglas was trademarked by Rohm and Haas AG in Germany ca. 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plexiglas (TM)"@en .

aat:300014437 a skos:Concept ;
    skos:definition "Thermoplastic made from cellulose or a cellulose compound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulosic"@en .

aat:300014439 a skos:Concept ;
    skos:definition "A tough, flammable, easily fabricated thermoplastic polymer composed of acetic acid ester of cellulose. Forms include white flakes or powder; it is used in a variety of products such as acetate fiber, lacquers, photographic film, magnetic tapes, lacquers, and transparent sheeting. The substance was first developed in 1865; in 1908 it was introduced as safety film by Eastman Kodak, replacing flammable cellulose nitrate film. As the cellulose acetate ages, the added plasticizers can migrate to the surface producing an oily film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulose acetate"@en .

aat:300014441 a skos:Concept ;
    skos:definition "A class of water-soluble polymers with a cellulose backbone and ether-containing substituents. Cellulose ethers are white bulky solids that form clear, hygroscopic films. They are made by treating cellulose with concentrated sodium hydroxide followed by etherification with one or more reagents such as methyl chloride, ethyl chloride, ethylene oxide or propylene oxide. They are used as adhesives, poultices, consolidants, and coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulose ether"@en .

aat:300014442 a skos:Concept ;
    skos:definition "A colorless, odorless ester of cellulose resulting from the reaction of ethyl chloride and cellulose; forms a durable alkali-resistant coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethyl cellulose"@en .

aat:300014444 a skos:Concept ;
    skos:definition "Substance comprising a mixture of nitric esters of cellulose and a highly flammable compound containing more than approximately 12.5 percent nitrogen. Nitrocellulose is a fluffy white substance that retains some of the fibrous structure of untreated cellulose. It is not stable to heat and will ignite easily. It was first introduced in the 19th century as an explosive. It was used to produce animation cels for 80 years until acetate was introduced as a safer medium in the 1950s. Cellulose nitrate was often used for clear lacquers, fabric dopes, adhesives, high-gloss paints, and mixed with natural resins (dammar, shellac, copal, etc) to create a waterproof varnish. Cellulose nitrate is inherently unstable and slowly decomposes at room temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrocellulose"@en .

aat:300014447 a skos:Concept ;
    skos:definition "A tough, highly flammable but not usually explosive, synthetic thermoplastic composed essentially of cellulose nitrate and camphor or another plasticizer. It was originally a trademark of Hoechst Celanese. It was marketed as a substitute for ivory, horn, amber, tortoiseshell for use in piano keys, dolls, buttons, combs, brushes, mirrors, collars, dental plates, and other small items. Tough, transparent sheets and strips of celluloid were also used for photographic and motion picture films as well as animation cels. Celluloid film was cast from a solution of cellulose nitrate with wood alcohol (methanol), amyl nitrate, camphor and fusel oil (amyl alcohol). The first celluloid product was patented in 1856 by Alexander Parkes, and called Parkesine. John Wesley Hyatt created an improvement in 1868 by adding camphor to make it thinner and more malleable. Celluloid has appeared commercially under a variety of names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celluloid"@en .

aat:300014448 a skos:Concept ;
    skos:definition "A flammable mixture of cellulose nitrates usually with less than 12.5% nitrogen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyroxylin"@en .

aat:300014449 a skos:Concept ;
    skos:definition "Type of plastic characterized by resistance to aggressive environments, including extremes of weather, and temperatures ranging from near 0 to 260 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluoroplastic"@en .

aat:300014454 a skos:Concept ;
    skos:definition "Thermoplastic or resin used for bonding brick and tile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furan"@en .

aat:300014461 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules in which a small but significant proportion of the constitutional units has ionic or inonizable groups, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ionomer polymer"@en .

aat:300014462 a skos:Concept ;
    skos:definition "Any of a variety of thermoplastic polymers originally developed as textile fibers and used in fabrics. They have a straight-chain polyamide structure and are largely heat-resistant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nylon"@en .

aat:300014467 a skos:Concept ;
    skos:definition "Trademark for a type of commercially produced aramid, a synthetic textile material which is lightweight, nonflammable, and has a high impact resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kevlar (TM)"@en .

aat:300014469 a skos:Concept ;
    skos:definition "Thermoplastic polymer group which includes nylon and other synthetic resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyamide"@en .

aat:300014471 a skos:Concept ;
    skos:definition "Thermoplastic polymer of butylene, formerly used for water pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polybutylene"@en .

aat:300014473 a skos:Concept ;
    skos:definition "Thermoplastic polyester used in glazing, including bullet- and explosion-resistant laminates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polycarbonate"@en .

aat:300014480 a skos:Concept ;
    skos:definition "Registered trademark for a series of optically clear, colorless, thermoplastic polyester films. First introduced in the early 1950s, Mylar is composed of polyethylene terephthalate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mylar (TM)"@en .

aat:300014481 a skos:Concept ;
    skos:definition "Amorphous, high-temperature, yellowish or transparent thermoplastic developed in 1982 with a molecular weight of Tg = 215C. Characteristics include resistance to ultraviolet and gamma radiation. May be used as reinforcing fiber or as fire-resistant material in electrical components, jets, and automobiles. Resistant to aliphatic hydrocarbons, alcohols, and dilute bases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyetherimide"@en .

aat:300014489 a skos:Concept ;
    skos:definition "Tough, lightweight, rigid plastic made by the polymerization of high-purity propylene gas in the presence of an organometallic catalyst at relatively low pressure and temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polypropylene"@en .

aat:300014492 a skos:Concept ;
    skos:definition "A clear plastic or stiff foam, a polymer of styrene, used chiefly as an insulator in refrigerators, air conditioners, and for packaging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polystyrene"@en .

aat:300014495 a skos:Concept ;
    skos:definition "Plastic based on polyether or polyester resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyurethane"@en .

aat:300014498 a skos:Concept ;
    skos:definition "Copolymer plastic composed of styrene and acrylonitrile that has high thermal resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "styrene-acrylonitrile"@en .

aat:300014502 a skos:Concept ;
    skos:definition "Generic term for materials derived from vinyl chloride, vinyl acetate, or vinylidene chloride. Commonly used with reference to all polymers and copolymers of which vinyl chloride is a constituent. Use more precise terminology for known materials such as \"polyvinyl chloride\" or \"polyvinyl acetate.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl"@en .

aat:300014506 a skos:Concept ;
    skos:definition "Any of a group of thermoplastic resins made by condensing polyvinyl alcohol with an aldehyde and used chiefly in the form of sheets and films, molded products, coatings, adhesives; especially, the resin made from acetaldehyde."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinyl acetal"@en .

aat:300014507 a skos:Concept ;
    skos:definition "Synthetic resin derived from the polymerization of vinyl acetate. Used primarily as the filming agent in water-based paints, and also as an ingredient in adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinyl acetate"@en .

aat:300014509 a skos:Concept ;
    skos:definition "A thermoplastic resin that is soluble or swells in water and can become insoluble in time through crosslinking; used chiefly for emulsifier, adhesive, and film resistant to solvent and abrasion, and in making molded and extruded products, and polyvinyl acetal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinyl alcohol"@en .

aat:300014511 a skos:Concept ;
    skos:definition "A tough, flexible, transparent, moistureproof polyvinyl acetal resin made from polyvinyl alcohol and butyraldehyde; used, among other things, as the interlayer in safety glass and other laminated products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinyl butyral"@en .

aat:300014513 a skos:Concept ;
    skos:definition "A thermoplastic resin derived by the polymerization of vinyl chloride, used for thin coatings, insulation, and pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinyl chloride"@en .

aat:300014515 a skos:Concept ;
    skos:definition "A polymer with strong intermolecular bonding that becomes rigid by chemical reaction and that is not remeltable. Thermoset polymers are usually insoluble in most solvents. Examples of thermoset polymers are epoxies, silicones, and phenolics along with some polyesters and polyurethanes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoset"@en .

aat:300014518 a skos:Concept ;
    skos:definition "Any of a variety of synthetic resins, produced by the esterification of a polybasic acid with a polyhydric alcohol. Often used for coatings, finishes, adhesives, and molding compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkyd resin"@en .

aat:300014520 a skos:Concept ;
    skos:definition "Resin made by polymerization of chemical compunds containg the allyl group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allyl resin"@en .

aat:300014523 a skos:Concept ;
    skos:definition "Any thermosetting plastic made by polycondensation of a compound containing amino groups such as urea or melamine, with an aldehyde, such as formaldehyde or another aldehyde-yeilding substance. Amino resins were first made in 1929. Examples of amino resins are melamine formaldehyde and urea formaldehyde. Amino resins are used for molded plastics, coatings, adhesives, laminating, textile finishes, and paper manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amino resin"@en .

aat:300014525 a skos:Concept ;
    skos:definition "A white, crystalline, slightly water-soluble solid used chiefly in organic synthesis and in the manufacture of resin, especially melamine resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melamine"@en .

aat:300014529 a skos:Concept ;
    skos:definition "Resin made by condensing urea or thiourea with formaldehyde."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urea-formaldehyde resin"@en .

aat:300014531 a skos:Concept ;
    skos:definition "Resin made by the interaction of an amine and an aldehyde."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aminoaldehyde resin"@en .

aat:300014533 a skos:Concept ;
    skos:definition "Type of synthetic resin used to produce adhesive that sets by chemical reaction, rather than through loss of solvent and coalescence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epoxy resin"@en .

aat:300014535 a skos:Concept ;
    skos:definition "A commercially important liquid epoxy resin, diglycidyl ether of bisphenol-A, prepared by reaction of epichlorohydrin with bisphenol-A."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basic liquid epoxy"@en .

aat:300014537 a skos:Concept ;
    skos:definition "Epoxy resins that exhibit a degree of crosslinking higher than that of standard difunctional resins and that possess adhesive characteristics. Multifunctionality arises as a result of N-glycidyl, O-glycidyl and N- and O-glycidyl groups in the resin structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multifunctional epoxy"@en .

aat:300014539 a skos:Concept ;
    skos:definition "A hybrid binder resin used in various applications such as protective coating or primer on corrosion-prone surfaces of metals and concrete, and in other applications including high-brightness LED packaging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicone epoxy"@en .

aat:300014540 a skos:Concept ;
    skos:definition "Refers to any of a large class of synthetic resins made by reacting phenol with formaldehyde. Phenolic resins were the first totally synthetic polymers to be commercialized. Bakelite is a phenolic plastic. Current industrial applications include adhesives in plywood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phenolic"@en .

aat:300014544 a skos:Concept ;
    skos:definition "The original trademarked name for phenol-formaldehyde resin, but now used to refer to a range of different types of plastic. The method for manufacturing the original resin was devised in 1909 by L. H. Baekeland in the United States, and the name Bakelite is a registered trademark of the Union Carbide Corporation. It is a hard, infusible, and chemically resistant plastic, nonconductor of electricity, and used in electrical appliances, industrial applications, in molding and casting operations, as an adhesive, in paints, and in baked-enamel coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bakelite (TM)"@en .

aat:300014545 a skos:Concept ;
    skos:definition "Molding powder first introduced by Bakelite Ltd. in the early 1960s. Characteristics of this material include a range of intense bright colors. They have a good molding latitude and dry heat dimensional stability. Applications include handles for appliances where heat-resistant colored material is called for."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melamine phenolic"@en .

aat:300014546 a skos:Concept ;
    skos:definition "Resin formed by the reaction between dibasic acid and dihydroxy alcohol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyester"@en .

aat:300014551 a skos:Concept ;
    skos:definition "Synthetic resin that is produced by the polymerization of vinylidene chloride. Discovered in 1933, and developed as a flexible film primarily used as a food wrap, initially marketed as \"Saran Wrap.\" It is used as a barrier against water, oxygen and vapor. Chemically resistant to alkalies and acids, it is insoluble in oil and organic solvents, and is impervious to mold, bacteria, and insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinylidene chloride"@en .

aat:300014553 a skos:Concept ;
    skos:definition "A superpolymer that maintains mechanical and chemical integrity above 400 degrees Fahrenheit for extended periods and has high strength and modulus of elasticity and excellent resistance to solvent, oil, and corrosive environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyimide"@en .

aat:300014558 a skos:Concept ;
    skos:definition "Any solid semi-inorganic polymers based on siloxanes, obtained by the action of concentrated hydrochloric acid on calcium silicide. Silicones were first discovered by F.S. Kipping in England in 1904, but were not commercially produced as polymers until 1943 by Dow Corning and 1946 by General Electric. They were called silicones because their empirical formula (R2SiO) is similar to that for ketones (R2CO). Silicones can be liquids, gels, and elastomers as well as solid thermoplastic or thermosetting resins. In general, they have excellent heat and chemical resistance and are water repellent. Silicones are used as adhesives, lubricants, protective coatings, release agents, paints, rubbers, coolants, implants, and insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicone"@en .

aat:300014562 a skos:Concept ;
    skos:definition "Light spongy rubber made by mechanically whipping air into the rubber latex prior to curing. It is used for mattresses, cushions, and insulation. Foam rubber turns yellow and becomes powdery when exposed to sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foam rubber"@en .

aat:300014565 a skos:Concept ;
    skos:definition "Lightweight and buoyant polymers containing uniformly dispersed air pockets, like a sponge. They are made from most types of polymers (rubber, polyethylene, polystyrene, epoxy, polyurethane, vinyl resins, silicone resins, and others). Steam, air or an inert gas is mechanically added or chemically produced in the plastic resins during manufacture to form a cured open cellular structure. They may be soft and spongy (foam rubber, polyethylene, etc.) or rigid and strong (polystyrene, epoxy). Closed-cell foams have individual non-connected bubbles while open-cell foams have an interconnected tunnels formed when the incorporated gas or steam escapes during cure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic foam"@en .

aat:300014568 a skos:Concept ;
    skos:definition "Registered trademark for foamed polystyrene that was developed in the 1940s. Polystyrene expanded into a multicellular mass that has one-sixth the weight of cork and will withstand temperatures above 170 degrees Fahrenheit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Styrofoam (TM)"@en .

aat:300014570 a skos:Concept ;
    skos:definition "A general term for any of a large and varied class of natural or synthetic organic materials that can be molded, extruded, or cast when soft or liquid, and then set into a rigid or slightly elastic form. Natural plastics include tree resins, beeswax, gutta-percha, horn, and clay. Synthetic plastics were first made in the 19th century. Plastics are used widely in manufacturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic"@en .

aat:300014572 a skos:Concept ;
    skos:definition "Alloys created between two or more thermoplastic resins to allow resin polymers to be blended that cannot be polymerized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic alloy"@en .

aat:300014574 a skos:Concept ;
    skos:definition "Plastics with additives applied to their formulation, usually adhesion promoters combined with particulate filler for reinforcing molding compounds, or fibers for reinforcing composite materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filled plastic"@en .

aat:300014575 a skos:Concept ;
    skos:definition "Plastic formulations that are not adulterated with fillers such as particles or fibers to increase stiffness or strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unfilled plastic"@en .

aat:300014578 a skos:Concept ;
    skos:definition "Plastics formed in an extrusion process, in which a molten polymer is passed from an extruder head and blown into a bubble of uniform film that is then molded, often into food packaging such as bottles for liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extrusion blown plastic"@en .

aat:300014579 a skos:Concept ;
    skos:definition "Resin-impregnated materials, such as paper or fabric, produced under heat and high pressure to form an insoluble homogeneous piece. Laminates were first made in 1907 by Leo Baekeland when he coated canvas with phenol formaldehyde. Distinguished from \"laminated plastic\" which is a thin sheet of superimposed layers of plastic bonded or impregnated with resin and compressed under heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic laminate"@en .

aat:300014581 a skos:Concept ;
    skos:definition "Plastic laminate made by bonding layers of materials such as canvas, glass, paper, or linen with thermosetting resins. May be used to refer to the trademarked product and to similar materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Formica (TM)"@en .

aat:300014582 a skos:Concept ;
    skos:definition "Plastic laminate made by bonding layers of cloth or paper with a resin under heat and pressure; made in sheet, rod, and tube form, and in other molded shapes. May be used to refer to the trademarked product and to similar materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Micarta (TM)"@en .

aat:300014583 a skos:Concept ;
    skos:definition "Any composite plastic imbedded with high-strength fillers, resulting in mechanical properties superior to base resins. Reinforcement may be derived from fibers, filaments, mats, fabrics made of glass, metal, carbon, boron, or aluminum silicate. The types of plastics used for base resins include polyester, epoxy, phenolic, polypropylene, polystyrene, nylon, polycarbonate, and polyphenylene oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reinforced plastic"@en .

aat:300014585 a skos:Concept ;
    skos:definition "Any solid or semi-solid substance that is slightly greasy to touch, usually solid, translucent, and has a low melting point; waxes are not a chemically homogeneous group. Waxes are composed of long chain hydrocarbon compounds, and may contain esters of fatty acids and alcohols, are thermoplastic and melt at low temperatures of between 40 and 100 C. In general, waxes are water-repellent, smooth, soluble in organic solvents, and classified as animal (e.g., beeswax), vegetable (e.g., bayberry), mineral (e.g., paraffin), or synthetic (e.g., polyethylene). Waxes are used for polishes, candles, crayons, sealants, coatings, adhesives, waterproofing, carbon paper, media in encaustic and wax emulsion paintings, and as repellents in wax-resist watercolor paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wax"@en .

aat:300014586 a skos:Concept ;
    skos:definition "Any of several waxes obtained from animal sources, found in small deposits in many parts of the animal. Animal waxes, such as from a mammal, typically contain no glycerides; they contain sterols (cholesterol) and other long-chain alcohols. Also included are the waxes from insects such as the lac insect which produces shellac. Any of several waxes obtained from animal sources, found in small deposits in many parts of the animal. Animal waxes, such as from a mammal, typically contain no glycerides; they contain sterols (cholesterol) and other long-chain alcohols. Also included are the waxes from insects such as the lac insect which produces shellac."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal wax"@en .

aat:300014587 a skos:Concept ;
    skos:definition "Any of various waxes that are produced by insects, such as beeswax, lac wax, creosote lac wax, and Chinese insect wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insect wax"@en .

aat:300014588 a skos:Concept ;
    skos:definition "Wax produced by many species of bees, containing around 10% hydrocarbons in addition to alcohols, fatty acids, and esters, with the primary component myricyl palmitate. The wax most commonly used by humans is from Apis mellifera. Beeswax is secreted by the worker bees to form honeycomb cells. The wax is prepared by melting the combs in hot water, then filtering out the resins, sugars, plant materials, and other impurities. The age, diet, location, and species of bee affects the color and texture of the wax. Beeswaxes can be soft or brittle with colors ranging from light yellow to dark brown. The darker varieties are often bleached by exposure to light and air or with chemicals. Beeswax has been used as a protective coating, in etching, for candles, adhesives, paint binder, polish, in encaustic, leather dressing, cosmetics, and to modify paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beeswax"@en .

aat:300014589 a skos:Concept ;
    skos:definition "Beeswax, usually dark in color, that is treated by exposure to light and air or with chemicals to remove the color. For beeswax not treated for color uniformity, use \"unbleached beeswax.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleached beeswax"@en .

aat:300014591 a skos:Concept ;
    skos:definition "A particular type of processed beeswax that was used in encaustic paintings. Punic wax was probably made by combining beeswax with soda lime to produce a waxy soap. Repeated washings in hot water removed any excess caustic. Experiments conducted in Berlin to recreate an ancient recipe yielded flakes of a hard brittle wax that melted between 73-75C (163-167 F)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punic wax"@en .

aat:300014594 a skos:Concept ;
    skos:definition "Fairly hard, yellowish-white wax composed primarily of ceryl cerotate and other esters, excreted by the louse-like scale insects of the genus Ceroplastes found in China, Japan, and India. The insects deposit their wax onto the leaves and twigs of Chinese ash trees; it is scraped off, cleaned with hot water, and cast into molds. It is similar to spermaceti and has been used as a substitute for beeswax, for candles, wax paint, polishing leather, and sizing paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese insect wax"@en .

aat:300014595 a skos:Concept ;
    skos:definition "A semisolid, waxy material extracted from sebaceous glands of wool-bearing animals, particularly sheep, genus Ovis. It is a complex mixture of 33 high molecular weight alcohols and 36 fatty acids, including cholesterol. One of the unique properties of lanolin is that it can incorporate up to 25-30% water without separation. Since it is readily absorbed by skin, lanolin is used as an emollient in cosmetics, ointments, leather, and as a rust preventative. Lanolin's role in nature is to protect wool and skin of the animal against the environment, also having a role in hygiene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanolin"@en .

aat:300014597 a skos:Concept ;
    skos:definition "A white, translucent wax composed of a mixture of fatty acid esters (cetyl palmitate) and long-chain alcohols, obtained from the the oil in the head cavity of the sperm whale, Physeter macrocephalus, other whales, or dolphins. It is created by the spermaceti organ inside the whale's head and connected to its nasal passage The substance was named in the mistaken belief that it was the coagulated semen of the whale. Spermaceti is collected from the cooled sperm oil, then washed with hot water and pressed to remove residual oil. The solid mass is then mixed with a slightly alkali solution and cast into molds. Spermaceti forms brilliant white crystals that are hard but oily to the touch, and are devoid of taste or smell. Spermaceti has been used since at least the 15th century for ointments, castings, soaps, cosmetic creams, fine candles, pomades, and textile finishing; later it was used for leather dressing and industrial lubricants. Space agencies in Europe and the United States still use spermaceti for roving vehicles on the moon and Mars and as lubricant on the Hubble space telescope. The biological function of the oil for the whale is uncertain, but among possibilities are that is used as a means of altering the whale's buoyancy, to focus sound waves to stun its prey, or as a cushion to protect the sperm whale's delicate snout while diving. Most spermaceti wax currently on the market is made synthetically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spermaceti"@en .

aat:300014598 a skos:Concept ;
    skos:definition "White, translucent waxy material composed of a series of high molecular weight hydrocarbons, generally obtained from the fractional distillation of petroleum, shale oil, lignite, or coal. Mineral waxes are relatively pure materials that have little to none of the alcohols or esters found in plant waxes and beeswax. Examples of purified mineral waxes are paraffin, ceresin, microcrystalline, and petrolatum, which are stable and unreactive. They are used as a substitute for or extender of beeswax, and in polishes, candles, printing inks, crayons, phonographic records, and insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral wax"@en .

aat:300014599 a skos:Concept ;
    skos:definition "Mineral wax that is technically a fossilized plant wax, obtained from lignite and peat found in a few deposits worldwide: Amsdorf, Germany, Ione, California, and in the brown coals of Oklahoma and Texas. Its color ranges from dark brown to light yellow when crude, or white when refined. Its composition is non-glyceride long-chain carboxylic acid esters, free long-chain organic acids, long-chain alcohols, ketones, hydrocarbons, and resins. It is used as an alternative to carnauba or beeswax in applications such as wood polish, phonograph records, paint, waterproof coatings, adhesives, paper sizing, candles, carbon papers, and insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "montan wax"@en .

aat:300014600 a skos:Concept ;
    skos:definition "Light yellow to dark brown waxy mixture of paraffinic hydrocarbons found in rocks in Utah, Galicia, Australia, and Romania near the Caspian Sea. It is used as a substitute for beeswax and carnauba wax in polishes, candles, printing inks, crayons, sealing waxes, phonograph records, and insulation. It is also used for leather polish, lithographic and printing inks, carbon paper, floor polishes, waxed paper, and textile sizing. For ozorite that has been purified by boiling and alkali treatments, use \"ceresin.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ozokerite"@en .

aat:300014602 a skos:Concept ;
    skos:definition "Ozorite that has been purified by boiling and alkali treatments. It is a white or slightly yellowish mineral wax that is similar to paraffin, but is harder and has a higher melting point. Ceresin is composed of a wide range of long chain saturated hydrocarbons. It is used for candles, textile and paper sizing, floor polish, waterproofing, shoe polishes, leather coating, and as a substitute for beeswax in polishes and protective coatings of sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceresin"@en .

aat:300014603 a skos:Concept ;
    skos:definition "Colorless to white, translucent, flammable, hard wax of straight-chain hydrocarbon residue distilled from petroleum and shale, ranging in melting point from about 48-66 degrees C (120-150 F). Paraffin wax is obtained from petroleum by dewaxing light lubricating oil stocks; it was first produced commercially in 1867. It is used in candles, wax paper, polishes, cosmetics, sealing, and electrical insulators. It assists in extracting perfumes from flowers, forms a base for medical ointments, and supplies a waterproof coating for wood. In wood and paper matches, it helps to ignite the matchstick by supplying an easily vaporized hydrocarbon fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paraffin"@en .

aat:300014605 a skos:Concept ;
    skos:definition "Wax having a fine crystalline structure, comprising the remaining fraction of paraffin wax after the lower molecular weight waxes are removed; it has a higher melting point and viscosity than paraffin, is chemically inert, and a stronger adhesive than paraffin. It can be softened by adding mineral oil or petroleum jelly. Microcrystalline wax does not emulsify easily but can be modified with a catalyst to produce an oxidized, emulsifiable form that is used in hard, self-polishing floor wax. Microcrystalline wax is also used in laminating paper and foils, polishes, waxed paper, adhesives, coatings, linings, and sealants. Microcrystalline waxes were first made in the late 1930s by Baker Petrolite in Barnsdall, Oklahoma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microcrystalline wax"@en .

aat:300014607 a skos:Concept ;
    skos:definition "Low melting mixtures of long chain hydrocarbon compounds found in or on plants. Vegetable waxes contain fatty acids or alcohols along with the hydrocarbon series. Vegetable wax properties range widely from the soft, white Japan wax to the hard, yellow of carnauba wax to the brownish black bitumen wax. They are used for cosmetics, leather dressing, and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable wax"@en .

aat:300014608 a skos:Concept ;
    skos:definition "Yellowish-brown wax exuded from the leaves and stems of Euphorbia antisyphilitica, native to Mexico and the southwestern United States. It is hard, brittle, aromatic, opaque to translucent, and has little tack. Candelilla wax is obtained by boiling the leaves and stems in water and sulfuric acid. It is composed of hydrocarbons, with smaller amounts of esters and triterpenoids. It is an all-purpose wax used for leather dressing, polishes, cements, Ebonite varnishes, candles, sealing wax, paper sizing, waterproofing, metal casting, and insect-proofing. Candelilla wax resembles carnauba wax but is less hard. Because it blends with other waxes and is less costly, candelilla wax is often used as an extender."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candelilla wax"@en .

aat:300014609 a skos:Concept ;
    skos:definition "Very hard, yellowish vegetable wax exuded from the leaves of the Brazilian palm Copernicia prunifera, native to the arid regions of northeastern Brazil. The leaves are collected, dried, then beaten to remove the waxy surface coating. The yellowish wax is purified and bleached prior to marketing; it is available in several grades. Carnauba wax is harder than beeswax and melts at a higher temperature; it is used in compounds of wax and other material to impart hardness, a glossy finish, and durability. Uses include floor waxes, car waxes, shoe polishes, leather finishes, carbon paper, other paper coatings, lubricants, metal casting, printing inks, varnishes, rubber coating, dental floss, coatings for food products such as candy, musical instrument polishes, and surfboard wax. Because of its hypoallergenic and emollient properties as well as its shine, carnauba wax is used in cosmetics and pharmaceuticals to coat tablets, thicken lipstick and mascara, deodorant, and various skin care preparations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnauba wax"@en .

aat:300014610 a skos:Concept ;
    skos:definition "Pale yellow, soft, waxy substance obtained from the berries of Toxicodendron vernicifluum, the sumac tree native to Japan, and Toxicodendron succedaneum. It is not a true wax, but a fat. Japan wax is a byproduct of lacquer manufacture; it contains palmitic acid, stearic acid, and oleic acid with japanic acid. Japan wax is sold in flat squares or disks and has a rancid odor. It is used in the manufacture of candles, pharmaceuticals, cosmetics, floor waxes, furniture polishes, pastels, crayons, buffing compounds, metal lubricants, adhesives, and as a substitute for beeswax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japan wax"@en .

aat:300014612 a skos:Concept ;
    skos:definition "A colloidal system such as a mist or fog, in which the dispersion medium is a gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerosol"@en .

aat:300014613 a skos:Concept ;
    skos:definition "In the context of wood products for carpentry and building, battens are pieces of squared timber of certain dimensions: not more than 7 inches broad and 2 1/2 inches thick, and over 6 feet long. Examples of use of battens includes for flooring, furring, supports for laths, or as cross pieces to secure the joint between two parallel boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batten"@en .

aat:300014614 a skos:Concept ;
    skos:definition "Solid masses or hollow units having approximately flat faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blocks"@en .

aat:300014615 a skos:Concept ;
    skos:definition "Masonry units whose net corss-sectioned area in any plane parallel to the bearing surface is less than 75% of its gross cross-sectional area measured in the same plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow masonry units"@en .

aat:300014616 a skos:Concept ;
    skos:definition "Thin, flat, rigid objects, of considerable length or breadth compared to thickness, most often of wood, paperboard, or composite fiber materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boards"@en .

aat:300014618 a skos:Concept ;
    skos:definition "Strong, thick, linear material made of several strands of iron wire that are twisted or braided. Distinguished from \"rope,\" which is usually made from synthetic or organic fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable"@en .

aat:300014622 a skos:Concept ;
    skos:definition "Use in industrial and building trade contexts for objects made by casting. For sculptural works made by casting, use \"casts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castings"@en .

aat:300014625 a skos:Concept ;
    skos:definition "Series of objects connected one after the other, usually rings passing through one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chains"@en .

aat:300014626 a skos:Concept ;
    skos:definition "Objects in the form of a long, thin material wound as a series of concentric circles or rings, having symmetrical curves or windings. Common examples are rope, pipes, and curls in certain hair styles. For curves that wind around a point while moving ever farther from the point, use \"spirals (geometric figures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coils"@en .

aat:300014627 a skos:Concept ;
    skos:definition "Material formed, either intentionally or through natural processes, from more than one constituent material, each with separate physical or chemical makeup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite material"@en .

aat:300014634 a skos:Concept ;
    skos:definition "Pins of wood or metal used to hold or strengthen two pieces of wood where they join; also, thin round rods of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dowels"@en .

aat:300014635 a skos:Concept ;
    skos:definition "Tenuous flexible thread-like material of long or indefinable length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filament"@en .

aat:300014636 a skos:Concept ;
    skos:definition "Man-made fiber, usually of nylon extruded in a single strand, used particularly for fishing lines and nets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monofilament"@en .

aat:300014637 a skos:Concept ;
    skos:definition "Material in the form of a thin, continuous layer. Films may be made from paints, lacquers, metal oxides, and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film"@en .

aat:300014638 a skos:Concept ;
    skos:definition "Transparent, flexible plastic material, usually of cellulose acetate or polyester, on which a light-sensitive emulsion is coated, or on which an image can be formed by various transfer processes, used for still photography and cinematography. Also, a thin coating of collodion or gelatin spread on photographic paper or plates, or used by itself instead of a plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic film"@en .

aat:300014639 a skos:Concept ;
    skos:definition "A gas-liquid continuum in which bubbles of gas are contained in a much smaller volume of liquid which is expanded to form bubble walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foam"@en .

aat:300014642 a skos:Concept ;
    skos:definition "Semirigid colloidal system of a liquid in a solid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gel"@en .

aat:300014645 a skos:Concept ;
    skos:definition "Refers to material that contains a greater length of grain boundaries than a coarse-grained material. Grain boundaries restrict slip transmission to neighboring grains. A fine-grain material has a higher tensile strength and is thus harder than a coarse-grained material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine-grain material"@en .

aat:300014646 a skos:Concept ;
    skos:definition "Fine, dry particles of matter regarded as the result of disintegration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust"@en .

aat:300014647 a skos:Concept ;
    skos:definition "Generally refers to a substance consisting of ground, pulverized, or otherwise finely dispersed solid particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder"@en .

aat:300014648 a skos:Concept ;
    skos:definition "Refers to alloys that contain intermediate grain boundaries between fine-grained material and coarse-grain material. Grain boundaries restrict slip transmission to neighboring grains. A medium-grain material has a higher tensile strength and is harder than a coarse-grained material, and offers a practical balance between hardness and toughness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium-grain material"@en .

aat:300014649 a skos:Concept ;
    skos:definition "A small, thin piece or layer of material, typically flat and loose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flake"@en .

aat:300014650 a skos:Concept ;
    skos:definition "Material that contains shorter length grain boundaries than a fine-grained material. Grain boundaries restrict slip transmission to neighboring grains. A coarse-grain material has a lower tensile strength and is softer than a fine-grain material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coarse-grain material"@en .

aat:300014651 a skos:Concept ;
    skos:definition "A small solid or densely packed rounded, spherical, or cylindrical mass, typically of food or medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pellet"@en .

aat:300014652 a skos:Concept ;
    skos:definition "Use generally for solid or nearly solid projectiles of stone or metal, containing no explosive charge themselves, fired from artillery or firearms. Use specifically for the small solid lead or steel pellets of various sizes, usually housed in a cartridge, fired from shotguns in multiples with each firing. For the small metal projectiles designed to be fired from small arms singly with each firing, use \"bullets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shot"@en .

aat:300014653 a skos:Concept ;
    skos:definition "Roof covering composed of woven material such as coir, bast, hemp, or grass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matting"@en .

aat:300014654 a skos:Concept ;
    skos:definition "Material in the form of threads or cords that surround the interstices of a net, netting, screen, or sieve, including any woven, knitted, or knotted material with an open texture and evenly spaced holes, including textiles and interlocking metal links. The size of a net or screen may refer to the spaces rather than to the threads that bound the spaces, for example, indicated by the number of openings per inch or another linear unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mesh"@en .

aat:300014655 a skos:Concept ;
    skos:definition "Trimming consisting of small shiny objects, such as spangles, beads, or jewels, applied in loosely designed clusters on clothing or accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paillette"@en .

aat:300014657 a skos:Concept ;
    skos:definition "Wood in the form of broad, thin, flat or sometimes curved pieces that serve as a support for media in visual works; examples are paintings on wood. In architecture and other constructive arts, use \"panels (surface components\" to refer to a panel, whether of wood or another material, that is typically a compartment of a surface either sunken below or raised above the general level, and set in a molding or other border, as in a frame, sometimes of different color or material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel"@en .

aat:300014658 a skos:Concept ;
    skos:definition "Wall coverings consisting of panels of wood or other material joined in a continuous surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paneling"@en .

aat:300014660 a skos:Concept ;
    skos:definition "Wood paneling on interior walls, usually floor to ceiling; as a rule enriched by carving, gilding, painting, or sometimes inlaying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boiserie"@en .

aat:300014662 a skos:Concept ;
    skos:definition "Tubular conduits, generally leakproof, for the transport of liquids or gases. For assemblies of pipes, tubes, and fittings in plumbing systems, use \"piping (plumbing system components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipes"@en .

aat:300014666 a skos:Concept ;
    skos:definition "Square or lozenge-shaped pieces of material, especially with reference to stone, brick, or tile. For square or lozenge-shaped pieces of glass in windows, use \"quarrels (lights).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrels"@en .

aat:300014668 a skos:Concept ;
    skos:definition "Strips of fine textile, such as silk, satin, or velvet, often with a cord finish along both edges instead of selvage, forming a narrow strip or band, used for decorative trimming of a garment or for fastening or attaching something. May also refer to anything that resembles such objects, that is, any long, thin, flat, flexible strips of any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon"@en .

aat:300014669 a skos:Concept ;
    skos:definition "Straight, slender, usually cylindrical stick staff or wand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rods"@en .

aat:300014670 a skos:Concept ;
    skos:definition "Material consisting of thin layers or shreds that have been cut or sliced off the surface of anything with a sharp tool, such as a thin slice of wood cut off with a plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shavings"@en .

aat:300014671 a skos:Concept ;
    skos:definition "Broad, thin objects or layers, rigid or flexible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheets"@en .

aat:300014677 a skos:Concept ;
    skos:definition "Strips of stiff material, such as wood or metal, for example used as louver boards or in chair backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slats"@en .

aat:300014680 a skos:Concept ;
    skos:definition "Wood in the form of relatively narrow strips that are used to build up a surface, often a curved suface, such as for a structure, cask, or barrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stave"@en .

aat:300014681 a skos:Concept ;
    skos:definition "Short pieces of wood, especially pieces cut or shaped for a particular purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sticks"@en .

aat:300014683 a skos:Concept ;
    skos:definition "Long, narrow pieces of rigid or flexible material, of generally uniform width."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strips"@en .

aat:300014684 a skos:Concept ;
    skos:definition "A thick, sticky liquid, usually one consisting of a concentrated solution of sugar in water or other medium such as the juices of fruits. Used as food, in cookery, or as a medium for medication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syrup"@en .

aat:300014685 a skos:Concept ;
    skos:definition "Material taking the form of long, narrow pieces of one or more substances, such as fabric, plastic, metal, or paper. Examples of tape as material include as a matrix for adhesive or other fastener."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape"@en .

aat:300014687 a skos:Concept ;
    skos:definition "Hollow, usually cylindrical objects, long in proportion to their diameter, sometimes flexible; in varied forms these may be used for conveying or containing fluids or vapor, or for containing other materials such as paper or textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubes"@en .

aat:300014690 a skos:Concept ;
    skos:definition "Woven reed, rattan, twigs, or other material, especially used to construct furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wicker"@en .

aat:300014693 a skos:Concept ;
    skos:definition "Any hard, sharp material that wears away a softer, less resistant surface when the two are rubbed together. They are used to used to polish metals, stone, wood, glass, and other materials. They are sold as powders, slurries, and as abrasive cloths, papers, and wheels. They are characterized by hardness and particle size. Their hardness can be measured on the Mohs' scale in which the diamond is rated as a 10."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrasive"@en .

aat:300014694 a skos:Concept ;
    skos:definition "Fabric coated with red iron oxide marketed in sheets and used for polishing metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crocus cloth"@en .

aat:300014695 a skos:Concept ;
    skos:definition "Finely abrasive cloth manufactured by sprinkling powdered emery or aluminum oxide onto a thin cloth coated with glue and used either wet or dry for polishing metallic surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emery cloth"@en .

aat:300014696 a skos:Concept ;
    skos:definition "Paper to which any abrasive substance has been adhered, typically used for finishing surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrasive paper"@en .

aat:300014698 a skos:Concept ;
    skos:definition "Finishing and polishing paper whose abrasive is powdered garnet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garnet paper"@en .

aat:300014699 a skos:Concept ;
    skos:definition "Tough paper coated on one side with an abrasive material, such as sand, silica, garnet, silicon carbide, or aluminum oxide; used for smoothing and polishing. Sandpaper is sold in several grades of coarseness usually specified by the size sieve that the particles can pass through, e.g., 400 grit is finer than 100 grit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandpaper"@en .

aat:300014701 a skos:Concept ;
    skos:definition "A substance that is added to another to impart certain qualities to the resulting product. Types of additives include chemical substances added to foods to produce given effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "additive"@en .

aat:300014703 a skos:Concept ;
    skos:definition "Any substance which hastens a reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accelerator"@en .

aat:300014704 a skos:Concept ;
    skos:definition "Inert granular material such as natural sand, manufactured sand, or gravel that, when bound into a conglomerate mass, forms concrete or mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aggregate"@en .

aat:300014706 a skos:Concept ;
    skos:definition "Heavy material, such as water, sand, or iron, used to increase weight, as in a machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballast"@en .

aat:300014707 a skos:Concept ;
    skos:definition "Aggregate that consists of gravel, fragments of broken stone, slag, and other coarse substances added to mortar, stucco, or concrete to add strength and stability as well as minimize shrinkage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coarse aggregate"@en .

aat:300014708 a skos:Concept ;
    skos:definition "Aggregate consisting of fine sand, crushed stone, or crushed slag screenings added to mortar, stucco, or concrete for strength and stability as well as to minimize shrinkage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine aggregate"@en .

aat:300014711 a skos:Concept ;
    skos:definition "Lightweight aggregate made from the residue from the making of coke or charcoal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breeze"@en .

aat:300014714 a skos:Concept ;
    skos:definition "Additive to natural cement, concrete, or mortar that causes entrained air to be incorporated into it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-entraining agent"@en .

aat:300014720 a skos:Concept ;
    skos:definition "Any substance that produces or promotes cohesion among loosely assembled materials; also includes the substance in a photograph or photographic film that holds the final image material. For the combined material of photographic binder and image material, use \"emulsion.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binder"@en .

aat:300014724 a skos:Concept ;
    skos:definition "A Medieval term for an emulsion of glue solution and molten beeswax; called for in old recipes as an ingredient of aqueous paint binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cera colla"@en .

aat:300014727 a skos:Concept ;
    skos:definition "A catalyst or other kind of substance that reacts with another to activate or hasten the process of curing, as in two-part resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curing agent"@en .

aat:300014729 a skos:Concept ;
    skos:definition "Any volatile liquid used for thinning or diluting paint and varnish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thinner"@en .

aat:300014731 a skos:Concept ;
    skos:definition "Plasticizers that are either non-surface active polymers or surface-active substances added to a suspension, usually a colloid, to improve the separation of particles and to prevent settling or clumping. They usually comprise surfactants, but they may also be gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dispersing agent"@en .

aat:300014732 a skos:Concept ;
    skos:definition "Material, often a compound of lead, iron, manganese, or cobalt, used for increasing the rapidity of the drying of paint and varnish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drier"@en .

aat:300014735 a skos:Concept ;
    skos:definition "Substance that promotes the formation and stabilization of an emulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emulsifier"@en .

aat:300014738 a skos:Concept ;
    skos:definition "Stiff paste often composed of plaster and powdered stone used to fill holes or cover defects in statuary, stone, or wood, usually made from plaster and chalk or from sawdust and strong glue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badigeon"@en .

aat:300014740 a skos:Concept ;
    skos:definition "Generally any substance added to another to to increase its quantity, bulk, or dilution, as in paint, ink, or adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extender"@en .

aat:300014741 a skos:Concept ;
    skos:definition "A pasty building material that sets to form a hard, infusible solid. Most mortars are mixtures of lime, plaster of Paris, or cement with sand and water. It is used to fill the joints of brick and stone masonry and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortar"@en .

aat:300014743 a skos:Concept ;
    skos:definition "Mortar made with portland cement, sand, and water, and sometimes with lime to aid spreading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cement mortar"@en .

aat:300014744 a skos:Concept ;
    skos:definition "Finely ground clay used as a plasticizer for masonry mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay mortar"@en .

aat:300014745 a skos:Concept ;
    skos:definition "A plastic material comprised of clay and water with animal hair added to increase the mechanical strength of the mortar mixture when dry. Commonly used as a construction material in colonial America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay-and-hair mortar"@en .

aat:300014746 a skos:Concept ;
    skos:definition "Mortar usually composed by weight of one part gypsum and no more than three parts mortar aggregate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsum mortar"@en .

aat:300014747 a skos:Concept ;
    skos:definition "A pasty building material consisting of lime and coarse sand that sets to form a hard, infusible solid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime-sand mortar"@en .

aat:300014748 a skos:Concept ;
    skos:definition "A mixture of hydrated lime, sand, and water, which has a compressive strength up to 400 psi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime mortar"@en .

aat:300014749 a skos:Concept ;
    skos:definition "Mortar having a high percentage of cement; it has a sticky consistency and adheres well to a trowel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fat mortar"@en .

aat:300014751 a skos:Concept ;
    skos:definition "In masonry, a mortar that lacks cementious materials and may be weak, harsh, or difficult to spread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lean mortar"@en .

aat:300014753 a skos:Concept ;
    skos:definition "Building material used for joining elements that is composed of an earth and water mixture. Mud mortar is prone to erosion, and is most effective in warm, dry climates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mud mortar"@en .

aat:300014755 a skos:Concept ;
    skos:definition "Mortar whose watery consistency allows it to be placed or pumped into small joints or cavities, as between pieces of ceramic clay, slate, or floor tile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grout"@en .

aat:300014756 a skos:Concept ;
    skos:definition "Mortar that is capable of setting and hardening under water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic mortar"@en .

aat:300014758 a skos:Concept ;
    skos:definition "In masonry, mortar which contains enough moisture to cause it to set properly but is not wet enough to cause it to be sticky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry mortar"@en .

aat:300014759 a skos:Concept ;
    skos:definition "Mortar made by impregnating the hardened cement mortar with monomeric impregnants, which are subsequently polymerized. Vinyl monomers are typically used for this."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymer-impregnated mortar"@en .

aat:300014761 a skos:Concept ;
    skos:definition "A paste used to fill holes and cracks in plaster, wallboard, wood, or other surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spackle (TM)"@en .

aat:300014766 a skos:Concept ;
    skos:definition "Chemical additive that releases a gas to expand the material by forming closed bubbles; also used to cause a froth, as in detergent or fire-fighting foam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foaming agent"@en .

aat:300014768 a skos:Concept ;
    skos:definition "Material added to paint or varnish to increase gum or resin content or to increase rate of oxidation, so as to cause an increase in hardness of the drying film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardener"@en .

aat:300014769 a skos:Concept ;
    skos:definition "Any substance which slows or prevents a particular chemical or biochemical process, reactant or catalyst."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inhibitor"@en .

aat:300014772 a skos:Concept ;
    skos:definition "Any substance or agent that ceases chemical or electrical reactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutralizer"@en .

aat:300014773 a skos:Concept ;
    skos:definition "Any substance added to another to mask unpleasant odors, such as essential oil to paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odorant"@en .

aat:300014774 a skos:Concept ;
    skos:definition "Any liquid or substance in which pigment is dispersed, the whole forming a pigmented coating, such as paint or ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vehicle"@en .

aat:300014777 a skos:Concept ;
    skos:definition "An additive used to make hardened concrete more water-resistant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permeability agent"@en .

aat:300014778 a skos:Concept ;
    skos:definition "Liquid or solid that dissolves in or is compatible with a resin, gum, or other material, and renders it plastic, flexible, or easy to work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasticizer"@en .

aat:300014779 a skos:Concept ;
    skos:definition "A mixture of honey and water, sometimes used as a plasticizer in watercolor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydromel"@en .

aat:300014780 a skos:Concept ;
    skos:definition "A rosy red volcanic clay that has been used as a pigment and a component in cement; pozzolana itself possesses little or no cementitious value, but in finely divided form and in the presence of moisture, it will chemically react with calcium hydroxide at ordinary temperatures to form compounds possessing cementitious properties. Pozzolana is mined at Pozzuoli near Naples, Italy. It has been used since ancient times by the Romans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pozzolana"@en .

aat:300014784 a skos:Concept ;
    skos:definition "A crystalline phenol, obtained naturally from various types of resin or artificially; used especially in making dye, pharmaceuticals, and resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resorcinol"@en .

aat:300014785 a skos:Concept ;
    skos:definition "Fluid that is used with a solvent when cleaning or stripping oil paintings to reduce the strength and slow down the activity of the solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restrainer"@en .

aat:300014790 a skos:Concept ;
    skos:definition "Substance added to, for example, food, paint, or a chemical compound, to prevent deterioration, the breaking down of an emulsion, or the loss of desirable properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stabilizer"@en .

aat:300014791 a skos:Concept ;
    skos:definition "Stabilizer added during the production of plastic. For the production of PVC, heat stabilizers are added in order to reduce the loss of hydrogren chloride during temperatures attained in the process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat stabilizer"@en .

aat:300014792 a skos:Concept ;
    skos:definition "An additive that protects against decomposition or degradation caused by ultraviolet light. Most often added to materials that are to be used outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet stabilizer"@en .

aat:300014794 a skos:Concept ;
    skos:definition "Insoluble particles that increase the viscosity of a liquid and thus reduce the sedimentation rate of particles in suspension. Frequently used as an additive in food and pharmaceutical products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspending agent"@en .

aat:300014795 a skos:Concept ;
    skos:definition "Any substance that increases the consistence of another through its addition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thickener"@en .

aat:300014796 a skos:Concept ;
    skos:definition "Any of various inorganic compounds composed of titanium oxides, or the salts of titanic acid, made by heating a mixture of an oxide of carbonate of metal and titanium dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanate"@en .

aat:300014797 a skos:Concept ;
    skos:definition "Additive used in concrete admixtures to alter the amount of water required to produce flowing concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water reducer"@en .

aat:300014799 a skos:Concept ;
    skos:definition "Chemical compound used for converting soluble scale-forming solids in water into insoluble form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water softener"@en .

aat:300014801 a skos:Concept ;
    skos:definition "A substance, in the form of a liquid, paste, powder, or dry film; used for sticking or adhering one surface to another. A substance capable of holding materials together by a surface attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesive"@en .

aat:300014805 a skos:Concept ;
    skos:definition "Adhesive that contains material that is outside the animal and vegetable kingdoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic adhesive"@en .

aat:300014806 a skos:Concept ;
    skos:definition "A water-soluble salt noted for powerful detergent and emulsifying properties, and for its suspending power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water glass"@en .

aat:300014809 a skos:Concept ;
    skos:definition "Prepared organic material that cures or sets by evaporation, that is ready to use without further additives, and which forms a bond between two surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic adhesive"@en .

aat:300014814 a skos:Concept ;
    skos:definition "Grade of dextrine used as a paper adhesive and in the manufacture of gouache, watercolor, and other aqueous paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British gum"@en .

aat:300014815 a skos:Concept ;
    skos:definition "Adhesive comprising an impure protein obtained by hydrolysis of collagenous material such as skin, bone, and connective tissue by various methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glue"@en .

aat:300014817 a skos:Concept ;
    skos:definition "Glue obtained from rapidly drying the serum from blood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albumin glue"@en .

aat:300014819 a skos:Concept ;
    skos:definition "Glue made from degraded or denatured collagen obtained from bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone glue"@en .

aat:300014820 a skos:Concept ;
    skos:definition "A cold-work, water-resistant paste made from casein by dispersion with a mild base such as ammonia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casein glue"@en .

aat:300014821 a skos:Concept ;
    skos:definition "Glue made from the degraded collagen from fish skins and wastes. Also glue made from the swim bladders of fish, a tissue composed entirely of collagen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish glue"@en .

aat:300014822 a skos:Concept ;
    skos:definition "A gelatin made from the dried swim bladders, or fish sounds, of sturgeon and other fishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isinglass"@en .

aat:300014823 a skos:Concept ;
    skos:definition "Animal glue made from degraded collagen obtained from skin and hide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hide glue"@en .

aat:300014827 a skos:Concept ;
    skos:definition "Prepared organic material derived from plants that cures or sets by evaporation, that is ready to use without further additives, and which forms a bond between two surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable adhesive"@en .

aat:300014829 a skos:Concept ;
    skos:definition "Cement reinforced with cellulose fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulose cement"@en .

aat:300014830 a skos:Concept ;
    skos:definition "A thick, white, smooth adhesive made from starch and used especially on paper and paperboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library paste"@en .

aat:300014831 a skos:Concept ;
    skos:definition "Liquid adhesive made with gum arabic solution, preservative, and odorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mucilage"@en .

aat:300014832 a skos:Concept ;
    skos:definition "Vegetable protein glue made from extracted soya bean meal; has greater adhesive power and water resistance than most other vegetable glues; marketed dry and used chiefly for interior plywood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soybean glue"@en .

aat:300014834 a skos:Concept ;
    skos:definition "A tape coated on one side with an adhesive mixture that adheres to a surface through the use of light pressure, as distinguished from tape used with adhesive that requires the addition of moisture or another solvent to adhere. The substrate may be cloth, paper, cellophane, cellulose acetate, or other synthetic polymer. Pressure sensitive tapes were first developed in 1845 by Dr. Horace Day using a natural rubber adhesive on strips of cloth for use in medicine). Automobile manufacturers began using masking tapes in 1925. Cellophane tapes were introduced by 3M in 1930."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure-sensitive tape"@en .

aat:300014835 a skos:Concept ;
    skos:definition "Adhesive tape used to increase grip or friction, made from cloth impregnated with rubber-based adhesive. Because the cloth is impregnated with adhesive it is tacky on both sides. Common uses include a wrap for the blade of a hockey stick, around the handle of a softball or baseball bat, or as a base when wrapping a bicycle handlebar with handlebar tape. In the past, friction tape was widely used by electricians because secondary properties include electrical insulation and protection from liquids and corrosion (today PVC electrical tape has replaced it). For tape intended for electrical insulation, use \"electric tape.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction tape"@en .

aat:300014836 a skos:Concept ;
    skos:definition "A tape, usually brown or tan colored, intended to block areas or surfaces from the application of materials, such as paint, or processes, such as sanding. It may be made of a strong paper or of a thin and easy-to-tear paper with an easily released pressure sensitive adhesive. It was originally developed in 1925 by 3M employee Richard Drew, who had observed that auto body painters had difficulty with the butcher paper then used to mask areas from paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masking tape"@en .

aat:300014837 a skos:Concept ;
    skos:definition "Gum exudation of small evergreens native to the Mediterranean countries, soluble in both alcohol and turpentine; used for artists' paint and coating lacquer. Mastic varnish becomes yellow and brittle with age. Mastic was used in 16th and 17th century recipes for oil-resin varnishes; in the 19th century, mastic was a popular clear, glossy spirit varnish for oil paintings and was also used as an additive in oil medium. By the 20th century, its use was superseded by dammar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mastic"@en .

aat:300014838 a skos:Concept ;
    skos:definition "A soft, tenacious, pliable adhesive usually with a starch base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste"@en .

aat:300014840 a skos:Concept ;
    skos:definition "Glue insoluble in water, made from rubber or resin solution, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine glue"@en .

aat:300014842 a skos:Concept ;
    skos:definition "Use generally for materials used by artists. Most descriptors for the specific materials will be found in the \"<materials by composition>\" section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' materials"@en .

aat:300014844 a skos:Concept ;
    skos:definition "Materials to which media are applied to create an image or design, or materials to which a work is mounted. For example, with paintings, drawings, prints, or photographs, the media would be applied to the surface of a support such as paper, wood panel, canvas, or glass in order to create the image. Used typically for two-dimensional works, although the concept may apply to any work. To distinguish between \"primary supports\" and \"secondary supports,\" use the appropriate more specific terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supports"@en .

aat:300014846 a skos:Concept ;
    skos:definition "Agents used to protect plants and crops from natural enemies, such as insects or fungus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological control agents"@en .

aat:300014847 a skos:Concept ;
    skos:definition "Any chemical such as copper sulfate used as a preparation to destroy algae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "algicide"@en .

aat:300014848 a skos:Concept ;
    skos:definition "Material used for killing germs, bacteria, or spores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disinfectant"@en .

aat:300014849 a skos:Concept ;
    skos:definition "Substances that destroy microorganisms that cause sepsis or septic diseases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiseptic"@en .

aat:300014851 a skos:Concept ;
    skos:definition "Toxic substances used to eradicate fungi that damage crops or ornamental plants or endanger the health of animals or humans. Most fungicide is applied topically but systemic fungicides may be applied that are distributed throughout living tissues to eradicate or protect against disease. Fungicides may also be impregnated in textiles, paper, leather, or wood as well as painted on masonry and plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fungicide"@en .

aat:300014852 a skos:Concept ;
    skos:definition "Any chemical agent that is toxic to some or all plants, particularly those categorized as weeds. Historically a variety of substances have been used including salts, carbon disulfide, borax, pyridine, mercurials, and arsenic trioxide. After 1945 synthetic varieties emerged including: amitrole, picloram, 2,4-D, DDT, atrazine, glyphosate, diquat, and paraquat. Herbicides do not always decompose and have created environmental hazards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbicide"@en .

aat:300014854 a skos:Concept ;
    skos:definition "Toxic or lethal substances used to kill insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insecticide"@en .

aat:300014855 a skos:Concept ;
    skos:definition "Solid or liquid material used to whiten or remove color from other materials; created with various mixtures of chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleach"@en .

aat:300014856 a skos:Concept ;
    skos:definition "Bleach and oxidizing agent used especially in conservation of art work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superoxol"@en .

aat:300014857 a skos:Concept ;
    skos:definition "Structural products, manufactured as standard units, intended for use in building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building materials"@en .

aat:300014860 a skos:Concept ;
    skos:definition "Coating one metal with another by means of bonding, as to protect the inner metal from corrosion or for minting coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cladding"@en .

aat:300014861 a skos:Concept ;
    skos:definition "Nonstructural, outer, exterior wall covering of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siding"@en .

aat:300014862 a skos:Concept ;
    skos:definition "Building siding constructed from a type of board bevelled toward one edge. Clapboards are attached overlapping each other horizontally, they are thinner at one edge, each board being made to overlap that below it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clapboard siding"@en .

aat:300014865 a skos:Concept ;
    skos:definition "Siding formed from boards interlocked by rebates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shiplap siding"@en .

aat:300014866 a skos:Concept ;
    skos:definition "Any material used in laying a floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flooring"@en .

aat:300014867 a skos:Concept ;
    skos:definition "Floor finishing materials that are composed of multiple pieces that are assembled and adhered to the floor as a unified surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile flooring"@en .

aat:300014871 a skos:Concept ;
    skos:definition "A substance that is a nonconductor, so as to prevent the passage of heat, electricity, or sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insulation"@en .

aat:300014878 a skos:Concept ;
    skos:definition "A material providing high resistance to heat flow; usually made of mineral wool, cork, asbestos, foam glass, foamed plastic, or diatomaceous earth, fabricated in the form of batts, blankets, blocks, boards, granular fill and loose fill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal insulation"@en .

aat:300014882 a skos:Concept ;
    skos:definition "Consists of loose, granulated materials such as rock wool, cork, or other material poured or packed between framing members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fill insulation"@en .

aat:300014887 a skos:Concept ;
    skos:definition "A flexible insulating material composed of loosely felted fiberglass fibers, used for thermal or acoustical insulation and available in precut, standard lengths, usually one inch thick and 17-36 inches wide. A long, continuous roll of batt insulation is also called blanket \"insulation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batt insulation"@en .

aat:300014889 a skos:Concept ;
    skos:definition "Building material usually comprised of two or more layers of reflective material containing a dead air space between them and which acts as a unit to block conducted, convected, and radiated heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflective insulation"@en .

aat:300014892 a skos:Concept ;
    skos:definition "The surface, other than masonry, to which plaster is applied; made from various materials, including expanded metal mesh, gypsum board, or other material that will sufficiently bond the plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lath"@en .

aat:300014894 a skos:Concept ;
    skos:definition "An expanded metal mesh material used in construction as a base for plaster on vertical surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond mesh lath"@en .

aat:300014896 a skos:Concept ;
    skos:definition "Expanded-metal lath having V-shaped ribs to provide greater stiffness and to permit wider spacing of framing members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rib lath"@en .

aat:300014897 a skos:Concept ;
    skos:definition "Any material used as a roof covering (such as shingles, slate, sheet metal, or tile) to make it wind- and waterproof, and often to provide thermal insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing"@en .

aat:300014898 a skos:Concept ;
    skos:definition "Material cut to stock dimensions, such as wood, slate, tile, concrete, or asbestos cement; used chiefly for roofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shingle"@en .

aat:300014900 a skos:Concept ;
    skos:definition "The covering, usually wood boards, plywood, or wallboard, placed over the exterior studding or rafters of a building; provides a base for the application of wall or roof siding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheathing"@en .

aat:300014901 a skos:Concept ;
    skos:definition "A building material consisiting of an overlap siding split from several species of deciduous trees and nailed directly to the roof-bearing walls' studs; perhaps uniquely Cameroonian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caraboard"@en .

aat:300014902 a skos:Concept ;
    skos:definition "Any substance that in small amounts increases the rate of a chemical reaction without being consumed itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalyst"@en .

aat:300014903 a skos:Concept ;
    skos:definition "Substance that in very small amounts is able to increase the activity of a catalyst."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promoter"@en .

aat:300014904 a skos:Concept ;
    skos:definition "Compounds that lower the surface tension of water so that soils may be dislodged, and that suspend soil particles to be flushed away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleaning compound"@en .

aat:300014906 a skos:Concept ;
    skos:definition "Any cleaning agent used to remove foreign matter from soiled surfaces. Typically made from synthetic materials, distinguishing it from soap, which is created from fats and oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detergent"@en .

aat:300014907 a skos:Concept ;
    skos:definition "Use generally for any substance spread over a surface, usually for protection or decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coating"@en .

aat:300014909 a skos:Concept ;
    skos:definition "Any coating of native oxygenated hydrocarbons, including naphtha, petroleum, or asphalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bituminous coating"@en .

aat:300014910 a skos:Concept ;
    skos:definition "A semi-transparent or opaque vitreous, porcelain-like coating applied by fusion to metal, glass, or ceramic, having a glossy appearance after hardening. Enamel is typically made from powdered fusible glasses (e.g., quartz, feldspar, clay, soda, and borax) and opaque colorants (e.g., cobalt blue, tin oxide) mixed with oil or water, then painted or sprayed on the object and fired up to 800 C. Enamel is used to protect a surface, to decorate objects in various colors and patterns, to form a surface for encaustic painting, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enamel"@en .

aat:300014911 a skos:Concept ;
    skos:definition "Smooth, glossy, wear-resistant paint, black in color, that is made with an oil, oil-alkyd, oil-resin, or synthetic resin and either baked or air-dried. It is called 'japan' because of its resemblance to oriental black lacquer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "japan"@en .

aat:300014915 a skos:Concept ;
    skos:definition "A surface created by fusing a thin layer of glass to a metal object in order to prevent corrosion or enhance its beauty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain enamel"@en .

aat:300014916 a skos:Concept ;
    skos:definition "Paint, varnish, or another material applied by coating, made of the resinous exudation of certain trees or from insects, and that dries with a high gloss or matte finish. In most lacquers resin is dissolved in a volatile solvent or a drying oil and hardens by evaporation. Lacquer may be applied in many layers, so the thick surface may be set with inlays or carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacquer"@en .

aat:300014918 a skos:Concept ;
    skos:definition "The spirit varnish produced from lac, a resinous substance excreted by the female of the lac insect. The lac resin is placed in alcohol to produce a product that creates a smooth finish and a high polish that is tough but not completely water-repellent. Shellac is a natural thermoplastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shellac"@en .

aat:300014920 a skos:Concept ;
    skos:definition "Manufactured product of stick lac, the secretion of Laccifer lacca kerr."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange shellac"@en .

aat:300014921 a skos:Concept ;
    skos:definition "Made by bleaching orange shellac with alkali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white shellac"@en .

aat:300014922 a skos:Concept ;
    skos:definition "Refers to a soft, plastic material that can be spread or daubed on a wall, ceiling, or other surface, where it afterwards hardens. In the context of art and architecture, it generally refers specifically to a mixture of water, lime, and sand, often combined with other materials, such as animal hair, to give the resulting material strength, texture, and if the surface is to be painted, porosity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaster"@en .

aat:300014924 a skos:Concept ;
    skos:definition "Plaster reinforced with fiber (as manila hemp or sisal) or provided with a cloth backing and used chiefly as sheeting, cornice molding, and cover strips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fibrous plaster"@en .

aat:300014925 a skos:Concept ;
    skos:definition "Any of the common types of wall plaster in general use, all of which contain various amounts of gypsum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsum plaster"@en .

aat:300014926 a skos:Concept ;
    skos:definition "Special gypsum plaster mixed with lime putty for use in finishing plastered surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauging plaster"@en .

aat:300014927 a skos:Concept ;
    skos:definition "Calcium sulfate hemihydrate, a white powder, which sets rapidly upon the addition of water; used for molds, sculpture, casts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaster of Paris"@en .

aat:300014932 a skos:Concept ;
    skos:definition "Type of plaster of Paris especially prepared to have the properties most desirable for casting and carving; it is very fine-grained, absorbent, brilliantly white, slow setting, and capable of taking fine detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casting plaster"@en .

aat:300014933 a skos:Concept ;
    skos:definition "Produced by soaking plaster of Paris overnight so that it loses its setting power; used to make gesso in the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slaked plaster of Paris"@en .

aat:300014934 a skos:Concept ;
    skos:definition "Hemihydrate plaster with slower setting action created by the addition of retarders such as keratin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retarded hemihydrate plaster"@en .

aat:300014936 a skos:Concept ;
    skos:definition "Completely de-hydrated gypsum that is combined with an accelerator to abbreviate setting time. Due to it's hard surface, it is used as a final coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anhydrous gypsum plaster"@en .

aat:300014938 a skos:Concept ;
    skos:definition "A plastering material consisting of lime, sand, and fibers used for scratch and brown coats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coarse stuff"@en .

aat:300014939 a skos:Concept ;
    skos:definition "Material, such as plasterer's putty or a mixture of fine sand with plasterer's putty, used for the final coat of a plastered wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine stuff"@en .

aat:300014942 a skos:Concept ;
    skos:definition "A mixture of various formulations used in vernacular architecture as a wall finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mud-plaster"@en .

aat:300014943 a skos:Concept ;
    skos:definition "Plaster having crushed blast-furnace slag as the aggregate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slag plaster"@en .

aat:300014944 a skos:Concept ;
    skos:definition "A hard, quick-drying plaster processed from river silt used in Saharan building for making building blocks, as mortar, and for rendering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timchent"@en .

aat:300014946 a skos:Concept ;
    skos:definition "Finishing plaster designed to correct sound reverberations or reduce noise intensity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustical plaster"@en .

aat:300014948 a skos:Concept ;
    skos:definition "Utility gypsum cement used in a variety of art applications such as casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydrocal (TM)"@en .

aat:300014951 a skos:Concept ;
    skos:definition "Plaster as used in Persia for decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gatch"@en .

aat:300014952 a skos:Concept ;
    skos:definition "A white priming or ground made of chalk, gypsum, burnt gypsum, zinc oxide, or whiting mixed with glue or occasionally casein. Used to prepare wooden panels or other supports for painting, gilding, or other decorative processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gesso"@en .

aat:300014956 a skos:Concept ;
    skos:definition "Coarse gesso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gesso grosso"@en .

aat:300014957 a skos:Concept ;
    skos:definition "Fine gesso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gesso sottile"@en .

aat:300014958 a skos:Concept ;
    skos:definition "Textured surfaces made from mortar with small stones embedded in it, used as a coating for walls or floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pebble dash"@en .

aat:300014963 a skos:Concept ;
    skos:definition "Refers to wall or furniture surfaces made by mixing fine plaster of powdered selenite (gypsum) with alum, glue, water, and pigment to create an effect that imitates marble or pietra dura. It was either applied like paint to a wet gesso ground, fixed under heat and polished, or formed into colored pieces and inlaid like a mosaic. The technique was known in ancient Rome and revived in 16th-century Italy, later spreading to other places in Europe. Although it is cheaper than marble or other stone surfaces, scagliola is susceptible to damage and has survived in only a few examples. It is distinguished from \"faux marbre,\" which creates the effect of marble by painting the surface of a wall or other surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scagliola"@en .

aat:300014966 a skos:Concept ;
    skos:definition "A type of light, malleable plaster made from dehydrated lime (calcium carbonate) mixed with powdered marble and glue and sometimes reinforced with hair. It sets more slowly than regular plaster and so is suitable for crafting sculpture and architectural decoration, external and internal. Differs from most other plasters which are made with calcium sulfate, rather than the calcium carbonate used in stucco, and set much more quickly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stucco"@en .

aat:300014967 a skos:Concept ;
    skos:definition "In architecture, a hard coat stucco with crushed finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kellastone"@en .

aat:300014968 a skos:Concept ;
    skos:definition "A solution or dispersion of a colorant in a vehicle that renders it capable of penetrating a material such as wood or fabric, but not capable of forming a protective surface. Also, a reagent used in microscopy to make visible minute structures. Typically, the transparency and fluidity of a stain will allow the base texture of the object to remain visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stain"@en .

aat:300014969 a skos:Concept ;
    skos:definition "Stain with an oil base, used to finish wood. Also, the term for a stain produced by the incomplete burning of lubricants on the surface of an aluminum sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil stain"@en .

aat:300014970 a skos:Concept ;
    skos:definition "Solution of silver salts used to alter the color of local areas of stained glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver stain"@en .

aat:300014971 a skos:Concept ;
    skos:definition "A penetrating, alcohol-soluble dye used to stain wood, producing deep color and little fiber swelling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit stain"@en .

aat:300014972 a skos:Concept ;
    skos:definition "A varnish which is colored with a transparent material, leaving a colored coating on the surface; has less penetrating power than a true stain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "varnish stain"@en .

aat:300014973 a skos:Concept ;
    skos:definition "Water-soluble dye used as a stain for wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water stain"@en .

aat:300014974 a skos:Concept ;
    skos:definition "A solution of a resin in a volatile solvent or a drying oil, which when spread out in a thin film, dries and hardens by evaporation of the volatile solvent, or by the oxidation of the oil, or both; applied as a protective coating or to enhance the appearance of the surface underneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "varnish"@en .

aat:300014977 a skos:Concept ;
    skos:definition "A method to obtain the appearance of gilding using a liquid coating on wooden frames, coaches, and other articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold varnish"@en .

aat:300014978 a skos:Concept ;
    skos:definition "Varnish used as a final coating over a thoroughly dried oil painting to protect and preserve it and to create a uniform gloss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture varnish"@en .

aat:300014979 a skos:Concept ;
    skos:definition "Any varnish or sizing applied between layers of paint. Variously used to describe retouch varnish, isolating varnish, and thin sizing varnishes used between tempera or casein underpainting and an oil glaze or overpainting to prevent the glaze from being absorbed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermediate varnish"@en .

aat:300014980 a skos:Concept ;
    skos:definition "A dilute varnish for spray application in a very thin layer over dry oil paintings in order to prevent the paint from being disturbed or picked up by the solvent action of another coat of paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isolating varnish"@en .

aat:300014981 a skos:Concept ;
    skos:definition "A very thin solution of damar or other non-yellowing resin that the artist sprays or brushes over a dry, unfinished oil painting before the resumption of painting with fresh colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retouch varnish"@en .

aat:300014982 a skos:Concept ;
    skos:definition "Any varnish that may be mixed with oil paint and other coating material, such as damar varnish, when used as an ingredient in an artist's paint vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixing varnish"@en .

aat:300014983 a skos:Concept ;
    skos:definition "Varnish that is applied, dried, then rubbed down to a smooth foundation for the application of a second coat of varnish, called the finishing varnish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbing varnish"@en .

aat:300014984 a skos:Concept ;
    skos:definition "Coatings for wood floors as a final protective and decorative finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finishing varnish"@en .

aat:300014986 a skos:Concept ;
    skos:definition "A varnish made with durable oil and resin, used on exterior wood surfaces because of its superior weather-resistant qualities. Suitable for use on the spars of ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spar varnish"@en .

aat:300014988 a skos:Concept ;
    skos:definition "A varnish made by dissolving a resin directly in a volatile solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simple solution varnish"@en .

aat:300014989 a skos:Concept ;
    skos:definition "Resin dissolved in a drying oil to which a thinner is generally added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil varnish"@en .

aat:300014990 a skos:Concept ;
    skos:definition "Glossy, enamel-like varnish popular from the 18th century until the 1920s, for use on coaches and early automobiles. Several formulations have been used for coach varnishes, including light-colored copal resins dissolved in linseed oil. Coach varnishes were eventually replaced by spray lacquer finishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coach varnish"@en .

aat:300014993 a skos:Concept ;
    skos:definition "A solution of resin in a volatile solvent; usually made of a soft resin such as mastic or sandarac, dissolved in turpentine or alcohol; characteristically brittle when dry and not very durable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit varnish"@en .

aat:300014994 a skos:Concept ;
    skos:definition "A fine transparent, amber, red, or brown varnish made from a hard translucent resin of various tropical trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copal varnish"@en .

aat:300014996 a skos:Concept ;
    skos:definition "Varnish that dries with a dull lustre on the surface it is applied to. These are made from many formulas, many of which include wax or tung oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat varnish"@en .

aat:300014998 a skos:Concept ;
    skos:definition "A heat-bodied linseed oil that is the vehicle in lithographic ink and usually in other printing ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litho varnish"@en .

aat:300015001 a skos:Concept ;
    skos:definition "Refers to a finish applied to bronze by using heat and a combination of copper nitrate, ammonium chloride, iron nitrate, or other chemicals. Depending upon the combination of chemicals used, the effects are dark brown, blackish, greenish, bluish, or reddish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vert antique"@en .

aat:300015003 a skos:Concept ;
    skos:definition "The suspension of droplets of one liquid in another liquid in which the first liquid is not soluble. Also, an intimate mixture of a solid or semi-solid substance with a liquid, sometimes with the aid of an emulsifier. In photography, the mixture of binder and final image material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emulsion"@en .

aat:300015004 a skos:Concept ;
    skos:definition "A suspension of a resinous, oily, fatty, or waxy material in a watery material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil-in-water emulsion"@en .

aat:300015008 a skos:Concept ;
    skos:definition "A megilp or gel medium for oil painting, introduced in the United States in the 1940s by Jacques Maroger, a painter and conservator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maroger medium"@en .

aat:300015009 a skos:Concept ;
    skos:definition "Paint medium made by mixing mastic varnish with linseed oil and driers in the form of lead compounds; used to give a paint body. On aging, it becomes brittle and yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megilp"@en .

aat:300015012 a skos:Concept ;
    skos:definition "A fluid medium used for drawings or tracings. An opaque, usually black, pigment is mixed with a vehicle such as water to produce a fluid which can be applied with a pen or brush. Through the end of the 19th century, ink was supplied dried in stick or block form which was ground and mixed with water as needed. At the beginning of this century prepared ink became popular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink"@en .

aat:300015017 a skos:Concept ;
    skos:definition "A carbon ink made from burning tung oil with a low oxygen component. Originally in the form of a solid, imported to Europe as compressed sticks. Also, fluid consisting of the pigment suspended in a medium such as water combined with a glutinous binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese ink"@en .

aat:300015018 a skos:Concept ;
    skos:definition "Inks made of carbon black pigment ground in water with water-dispersed resin used as a liquid drawing medium. Distinguished from \"black carbon ink,\" which is made from powdered carbon pigment, usually lampblack, in a dilute aqueous solution of gum or glue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "India ink"@en .

aat:300015024 a skos:Concept ;
    skos:definition "Ink that is invisible on paper until heat or other substance is applied to make it visible, or when the paper is held up to a light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invisible ink"@en .

aat:300015025 a skos:Concept ;
    skos:definition "Artist's ink made from the brown pigment derived from the ink of cuttlefish, an invertebrate related to the octopus and squid. The cuttlefish uses the natural ink defensively. To make artist's ink, the animal's ink sac is extracted, dried, then dissolved in dilute alkali, and further processed. The resulting pigment is chemically inert and fairly permanent; it is used primarily as a drawing ink and to apply washes. Sepia ink has been used at least since ancient Roman times. It was particularly popular as a drawing medium from the Renaissance onwards, and in the late 18th and 19th centuries generally replaced bistre as a medium for making wash drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepia"@en .

aat:300015029 a skos:Concept ;
    skos:definition "Any dispersion of pigment in a liquid binder. Paint is applied with a brush, roller, sprayer, or by dipping and dries to form a decorative or protective film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint"@en .

aat:300015031 a skos:Concept ;
    skos:definition "Paint containing aluminum alloy, effective in preventing discoloration of painted surfaces from mildew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum paint"@en .

aat:300015035 a skos:Concept ;
    skos:definition "Aqueous paint composed of pigments held together by animal glue or casein. Distemper has been used since ancient Egyptian times for wall painting, house decoration, and the painting of theatrical scenery. It has only occasionally been employed for easel painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distemper"@en .

aat:300015037 a skos:Concept ;
    skos:definition "White or colored wall paint consisting of whiting, glue, linseed oil, or water colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcimine"@en .

aat:300015039 a skos:Concept ;
    skos:definition "Flat, matte, opaque, water soluble paint with a water-soluble binder, such as gum or glue-size, used frequently in art activities involving children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poster paint"@en .

aat:300015042 a skos:Concept ;
    skos:definition "Paint having the principal ingredients water and lime paste; one of the oldest types of paint, used for both exterior and interior surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whitewash"@en .

aat:300015044 a skos:Concept ;
    skos:definition "Paint having water usually as the volatile phase with the various nonvolatile substances (as a linseed-oil varnish) in emulsion as the binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emulsion paint"@en .

aat:300015050 a skos:Concept ;
    skos:definition "A paint made by grinding pigments with a drying oil such as linseed oil. After 1940 alkyd binders were often added to oil paint to provide faster drying times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil paint"@en .

aat:300015052 a skos:Concept ;
    skos:definition "Paint that contains a high concentration of lead, which is poisonous if inhaled or ingested."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead-based paint"@en .

aat:300015053 a skos:Concept ;
    skos:definition "Paints incorporating synthetic resin, such as acrylic, which is a synthetic polymer used in latex or water based paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic resin paint"@en .

aat:300015054 a skos:Concept ;
    skos:definition "Low sheen acrylic emulsion paint, has excellent resistance to weathering and good impact resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latex paint"@en .

aat:300015058 a skos:Concept ;
    skos:definition "Paint consisting of pigments or dyes bound in an emulsion of acrylic, which is a colorless, transparent, thermoplastic synthetic resin made by the polymerization of acrylic acid derivatives. Acrylic paint is water soluble while wet and fast drying, but once the paint has dried, it is flexible and resistant to water. Acrylic paint was first made commercially available in the 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic paint"@en .

aat:300015061 a skos:Concept ;
    skos:definition "An extremely durable paint having pigment in a water-soluble silicon-containing binder such as sodium silicate and silicon ester. Silicate paints have been used in murals and stereochrome paintings, in appearance similar to fresco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicate paint"@en .

aat:300015062 a skos:Concept ;
    skos:definition "Paint formed of an emulsion of fatty and watery constituents. The standard emulsion is usually created with egg yolk and water, with variants of man-made emulsions created with whole egg, linseed oil, casein glue, gum, or wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tempera"@en .

aat:300015064 a skos:Concept ;
    skos:definition "Tempera paint using egg as its vehicle, traditionally the yolk only, in other cases, the whole egg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg tempera"@en .

aat:300015065 a skos:Concept ;
    skos:definition "Artist's material consisting of pigments ground in an emulsion medium in which the oily ingredient is linseed oil, stand oil, or most often, a mixture of stand oil and damar varnish; emulsified with gum arabic solution and glycerin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum tempera"@en .

aat:300015066 a skos:Concept ;
    skos:definition "Tempera in which the vehicle is made with a water-in-oil emulsion, instead of the more usual oil-in-water emulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil tempera"@en .

aat:300015070 a skos:Concept ;
    skos:definition "Mixture of cement and water, applied to the surface of concrete for a uniform finish and protection from inclement weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete paint"@en .

aat:300015071 a skos:Concept ;
    skos:definition "Enamel with a high degree of resistance to mechanical wear, for use on such surfaces as porch floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deck paint"@en .

aat:300015072 a skos:Concept ;
    skos:definition "Paint designed for outdoors, having high-grade pigment in linseed oil with a small amount of thinner and drier, or in a synthetic resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house paint"@en .

aat:300015074 a skos:Concept ;
    skos:definition "Materials often applied as a coating or buffer to surfaces to prevent friction or other mechanical trauma through rubbing or scraping action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrasion-resistant material"@en .

aat:300015076 a skos:Concept ;
    skos:definition "Paint coating with the ability to maintain integrity when exposed to acids, alkalis, solvents, or other chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical-resistant paint"@en .

aat:300015079 a skos:Concept ;
    skos:definition "Paint coatings that have a characteristic intumescence when exposed to high heat. A foaming or bubbling layer forms in the paint layer that insulates the material beneath, protecting it from reaching a flash point. This type of paint may be based on silicone, casein, borax, polyvinyl chloride, urea formaldehyde or other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire-retardant paint"@en .

aat:300015084 a skos:Concept ;
    skos:definition "Paint that resists breakdown due to extreme temperatures, particularly frigid temperatures. Often used to insulate pipes or refrigeration equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frost-proof paint"@en .

aat:300015086 a skos:Concept ;
    skos:definition "Specialty paint that combines iron dust with a primer. Typically this base layer is covered with a finish paint coat in color. Magnetic paint allows for objects (usually paper) to be adhered to a surface using magnets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic paint"@en .

aat:300015087 a skos:Concept ;
    skos:definition "Coating designed to prevent the corrosion of metals, particularly the rusting of iron and steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rust-inhibiting paint"@en .

aat:300015090 a skos:Concept ;
    skos:definition "Refers to a coating of concrete on metal surfaces to either protect the metal from corrosion or to add weight as negative buoyancy to structures submerged in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete coating"@en .

aat:300015091 a skos:Concept ;
    skos:definition "Thin, usually glossy surface coating in various contexts. In paintings, glaze is a thin film of transparent to semitransparent color added to change tonality.For textiles and paper, glaze is a highly polished finish obtained by treating the fabric or paper with starch, glue, wax, or synthetic resins, then heat-pressing. In ceramics, glaze is a thin, vitreous, opaque coating fired on the surface of a ceramic body to add color, texture, and water resistance; prefer a narrower concept \"ceramics glaze,\" or one of its narrower terms. For thin applications of paint in watercolor, use \"wash (material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glaze"@en .

aat:300015092 a skos:Concept ;
    skos:definition "Thin, opaque, vitreous coating that is applied to the surface of a ceramic body by painting, spraying, or dipping, in order to add color, texture, or water resistance to the object. The glaze is applied to the surface of a fired ceramic piece, and then the piece is refired at a temperature that vitrifies the glaze, but is lower than the original firing temperature. Ceramic glazes are usually mixtures of silicates, colorants, and flux."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramic glaze"@en .

aat:300015095 a skos:Concept ;
    skos:definition "A ceramic glaze whose flux is an alkali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkaline glaze"@en .

aat:300015096 a skos:Concept ;
    skos:definition "Ceramic glaze, utilizing wood or vegetable ash as the fluxing ingredient."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ash glaze"@en .

aat:300015097 a skos:Concept ;
    skos:definition "Copper-based glaze that shows as blushes of red, occasionally dotted with fine green spots on a pinkish-red ground. It can give the effect of blushing skin or ripening fruit. It was an innovation if the Qing dynasty at Jingdezhen, and appears most often on small ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peach bloom"@en .

aat:300015099 a skos:Concept ;
    skos:definition "A low-fire glaze usually containing zinc oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bristol glaze"@en .

aat:300015100 a skos:Concept ;
    skos:definition "Refers to the various gray-green colored, iron-containing ceramic glazes that are applied to Asian stoneware. They were developed in the third century BCE and its use flourished during the Sung Dynasty, valued for its resemblance to jade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celadon"@en .

aat:300015102 a skos:Concept ;
    skos:definition "Colorless or colored transparent glaze that is applied specifically to ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clear glaze"@en .

aat:300015104 a skos:Concept ;
    skos:definition "Ceramic glaze that produces a broken blister effect. Made by combining an ordinary glaze with grains of a material that will become gaseous under firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blister glaze"@en .

aat:300015105 a skos:Concept ;
    skos:definition "Ceramic glaze in which microscopic crystals are formed upon firing. It is made by cooling the fired object very slowly allowing crystals to form in the otherwise amorphous glass film. Under the right conditions, zinc silicate and calcium silicate form large crystals in the glaze surface. The technique was first developed at Sevrès in France in about 1850; the method is complex and difficult to produce. These glazes are different than aventurine or devitrified glazes, which may also appear to contain crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystalline glaze"@en .

aat:300015108 a skos:Concept ;
    skos:definition "An opaque claret red to brownish red reduced copper glaze developed in China during the Kanxi period and used chiefly in porcelain ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sang de boeuf"@en .

aat:300015111 a skos:Concept ;
    skos:definition "Slip glaze applied over a clay body to provide a smooth surface for further glazing or decoration, usually by dipping or brushing; contains color oxides as well as clay, feldspar, and silica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engobe"@en .

aat:300015113 a skos:Concept ;
    skos:definition "Substance spread over the surface of paper, usually for protection or decoration, including pigments, or clay coating for gloss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper coating"@en .

aat:300015114 a skos:Concept ;
    skos:definition "Any substance having the property of conducting or permitting the passage of heat, electricity, or other form of energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conductor"@en .

aat:300015116 a skos:Concept ;
    skos:definition "Material that is capable of conducting electric current from a generative source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric conductor"@en .

aat:300015118 a skos:Concept ;
    skos:definition "Material having a complete lack of measurable electrical resistance at very low temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superconductor"@en .

aat:300015119 a skos:Concept ;
    skos:definition "Liquids or gases used to cool and lubricate a tool, engine, or nuclear reactor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coolant"@en .

aat:300015121 a skos:Concept ;
    skos:definition "Material, usually a chemical compound or a mixture of compounds, produced for the purpose of causing an explosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "explosive"@en .

aat:300015124 a skos:Concept ;
    skos:definition "Blasting explosive made with a mixture of nitroglycerin and other inert absorptive substance. Detonated by heat or percussion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamite"@en .

aat:300015125 a skos:Concept ;
    skos:definition "Intimate mixture of saltpeter, sulfur, and charcoal, used as a blasting, priming, and propellant explosive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunpowder"@en .

aat:300015126 a skos:Concept ;
    skos:definition "An explosive chemical used in munitions and demolition. Initially used in the dye industry, it was not used as an explosive until 1904. It can be melted and cast due to the large difference between its melting point and decomposition temperature, and insensitivity to shock. It will not explode without a detonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "TNT"@en .

aat:300015131 a skos:Concept ;
    skos:definition "Material that is added to soil or other growing media to supply chemical elements needed primarily for plant nutrition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fertilizer"@en .

aat:300015132 a skos:Concept ;
    skos:definition "Materials or preparation used for filling gaps, cracks, pores, holes, voids, or other losses or differences in grade in paintings, frames, sculpture, architectural elements, surfaces, volumes, and other objects of many kinds. Examples are dental plaster, mastic adhesive, plastic wood, gesso, steel stick, brummer stopper, spackle, wax, asphalt, concrete, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fill"@en .

aat:300015133 a skos:Concept ;
    skos:definition "Any porous material, such as paper or sand, through which a gas or liquid is passed to separate out matter in suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filter"@en .

aat:300015134 a skos:Concept ;
    skos:definition "A substance used to increase the durability or stability of another substance, such as pigment on paper or dye in textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixative"@en .

aat:300015137 a skos:Concept ;
    skos:definition "A substance added to a solid to increase its fusibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flux"@en .

aat:300015139 a skos:Concept ;
    skos:definition "Material used to produce heat or power by burning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuel"@en .

aat:300015140 a skos:Concept ;
    skos:definition "Non-bituminous and most highly metamorphosed form of coal containing more fixed carbon and least amount of volatile matter than any other form. Anthracite is the least plentiful form of coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthracite"@en .

aat:300015143 a skos:Concept ;
    skos:definition "A relatively soft coal containing the tarlike substance asphaltic bitumen. Its carbon content is 60-80%, the rest composed of water, air, hydrogen, and sulfur. It is of higher quality than lignite coal but of poorer quality than anthracite. It was usually formed as a result of high pressure on lignite. It dark brown to black in color, commonly banded or layered. The major problem with burning of bituminous coal is air pollution. A relatively soft coal containing the tarlike substance asphaltic bitumen. Its carbon content is 60-80%, the rest composed of water, air, hydrogen, and sulfur. It is of higher quality than lignite coal but of poorer quality than anthracite. It was usually formed as a result of high pressure on lignite. It dark brown to black in color, commonly banded or layered. The major problem with burning of bituminous coal is air pollution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bituminous coal"@en .

aat:300015145 a skos:Concept ;
    skos:definition "A type of hydrogen-rich, sapropelic coal characterized by a dull black, sometimes waxy luster that lights easily and burns with a bright, smoky flame. Cannel coal consists of micrinites, macerals of the exinite group, and certain inorganic materials. Cannel coal usually occurs at the top or bottom of other coals, though it sometimes can be found as individual . It was probably formed in lakes and pools where floating spores, transported by wind and water, accumulated in mud mixed with plant debris. During the 19th century cannel coal was used in the manufacture of illuminating gas and as fireplace coal. A type of hydrogen-rich, sapropelic coal characterized by a dull black, sometimes waxy luster that lights easily and burns with a bright, smoky flame. Cannel coal consists of micrinites, macerals of the exinite group, and certain inorganic materials. Cannel coal usually occurs at the top or bottom of other coals, though it sometimes can be found as individual . It was probably formed in lakes and pools where floating spores, transported by wind and water, accumulated in mud mixed with plant debris. During the 19th century cannel coal was used in the manufacture of illuminating gas and as fireplace coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cannel coal"@en .

aat:300015146 a skos:Concept ;
    skos:definition "Logs, boards, or twigs of trees intended for burning as fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firewood"@en .

aat:300015148 a skos:Concept ;
    skos:definition "Combustible, carbonaceous material such as coal, petroleum, natural gas, and oil shales that are formed through the decay of remains of organisms during the geological past."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fossil fuel"@en .

aat:300015149 a skos:Concept ;
    skos:definition "Carbon-rich material that most often occurs in stratified sedimentary deposits. It is one of the most important of the primary fossil fuels. It is characterized by being solid, hard, opaque, black, or blackish, found in seams or strata in the earth, and largely used as fuel; it consists of carbonized vegetable matter deposited in former epochs of the world's history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal"@en .

aat:300015150 a skos:Concept ;
    skos:definition "Colorless highly flammable hydrocarbon gas, consisting chiefly of methane and other simple alkanes, occurring naturally in association with crude oil and used as a fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural gas"@en .

aat:300015152 a skos:Concept ;
    skos:definition "Fluid that smoothes motion or reduces friction between surfaces. Lubricant occurs in nature as synovial fluid in the joints of vertebrate animals. Various artificial lubricants have been used since prehistory, including mud and animal fat. Since the 19th century, crude oil has become the chief source of lubricants for most applications in industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lubricant"@en .

aat:300015155 a skos:Concept ;
    skos:definition "Fluid or paste compound used for removing old and dried paint from a variety of surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint remover"@en .

aat:300015156 a skos:Concept ;
    skos:definition "Colorless liquid solution of ammonium hydroxide in water, used as a solvent and for other purposes including the following: in cleansers and detergents to remove vegetable stains, grease, dirt, proteins, and other accretions from clothing, glass, and ceramics; in paint strippers to soften casein paints; to stain for wood, producing a deep red color in mahogany; and to extract color from grass and lichens to produce a green dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonia water"@en .

aat:300015158 a skos:Concept ;
    skos:definition "Paste or liquid material used in casting to coat the interior of a mold in order to prevent the plaster cast from adhering to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "release agent"@en .

aat:300015161 a skos:Concept ;
    skos:definition "A material, such as form oil, used to prevent adhesion of newly placed concrete to the forms, wall, or other support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bond breaker"@en .

aat:300015162 a skos:Concept ;
    skos:definition "Oil with which concrete forms, especially those of metal, are sometimes treated to prevent sticking of the concrete upon removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "form oil"@en .

aat:300015164 a skos:Concept ;
    skos:definition "A class of soft or semifluid soaps made by the saponification of oils, such as candlenut oil or olive oil, with potassium hydroxide. Soft soaps tend to dissolve more readily in water than hard soaps. Apart from typical cleaning applications, it has been used as a parting compound to separate plaster casts from their molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft soap"@en .

aat:300015166 a skos:Concept ;
    skos:definition "Current usage refers generally to liquid containing aromatic ingredients in an alcohol base; used as a personal toiletry item. Originally any substance that emits a pleasant smell when burned, primarily incense, from the Latin term referring to smoke or burning, \"per fumum.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfume"@en .

aat:300015167 a skos:Concept ;
    skos:definition "Any substance applied to a surface that is intended to smooth or produce a glossy coating or appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polish"@en .

aat:300015168 a skos:Concept ;
    skos:definition "Material used for buffing or polishing metal, originally of dolomitic lime with from 18 to 25% saponifiable grease as a bond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffing composition"@en .

aat:300015169 a skos:Concept ;
    skos:definition "A hydrated iron oxide used for polishing metal and in break-in lubricant for aluminum bronze bearings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rouge"@en .

aat:300015171 a skos:Concept ;
    skos:definition "Chromium oxide employed in polishing hard materials such as chrome plate or stainless steel, used combined with stearine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green rouge"@en .

aat:300015172 a skos:Concept ;
    skos:definition "Substance added to materials, natural science specimens, or foodstuffs to preserve them against deterioration, discoloration, or spoilage. In paint or adhesive, prevervatives are nonvolative chemicals added to prevent fermentation and mold growth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preservative"@en .

aat:300015174 a skos:Concept ;
    skos:definition "Wood preservative that is toxic to fungi and insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid copper chromate"@en .

aat:300015175 a skos:Concept ;
    skos:definition "Solution for use in the preservative treatment of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammoniacal copper arsenate"@en .

aat:300015176 a skos:Concept ;
    skos:definition "A heavy, oily substance distilled from an anthracene-oil or creosote-oil fraction of coal tar, sometimes chlorinated or otherwise treated, and used as a wood preservative, disinfectant, or insecticide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbolineum"@en .

aat:300015177 a skos:Concept ;
    skos:definition "Solid, paste, or solution used to preserve wood from microbial and insect deterioration. Commonly used on outdoor residential wood structures such as decks, picnic tables, and playsets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromated copper arsenate"@en .

aat:300015178 a skos:Concept ;
    skos:definition "Preservative and fire retardant for wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromated zinc chloride"@en .

aat:300015179 a skos:Concept ;
    skos:definition "A coal-tar distillate that is a mixture of organic compounds, largely hydrocarbons, commonly used as a wood preservative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creosote"@en .

aat:300015182 a skos:Concept ;
    skos:definition "Oleaginous liquid derived from coal tar that is widely used as a wood preservative because it is toxic to wood-destroying organisms. It is commonly applied to utility poles or pilings. It is dark in color and has a characteristic odor. Wood treated with coal tar creosote cannot be painted, and is not used in interior applications or on finished lumber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal tar creosote"@en .

aat:300015183 a skos:Concept ;
    skos:definition "A white, crystalline, noncombustible solid that is slightly soluble in water. Used as a fungicide and as a wood preservative and is toxic by inhalation, ingestion, and skin absorption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pentachlorophenol"@en .

aat:300015185 a skos:Concept ;
    skos:definition "Any of various chemical treatments added to cut wood products in order to minimize insect and fungal infestations. Wood preservatives are typically applied by spraying, brushing, immersion or pressure treatments. Some of these biocide materials may be toxic to humans. Examples are tar oils (creosote, anthracene oil, chlorinated naphthalenes), copper naphthenate, zinc naphthenate, borates, sodium fluoride, and copper chromated arsenate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood preservative"@en .

aat:300015187 a skos:Concept ;
    skos:definition "Materials that strengthen secondary materials when attached or combined with them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reinforcing materials"@en .

aat:300015189 a skos:Concept ;
    skos:definition "Steel bars, usually with manufactured deformations or threading, used in concrete and masonry construction to provide additional strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reinforcing bars"@en .

aat:300015190 a skos:Concept ;
    skos:definition "Reinforcing bars made with lugs or ridges to produce a better bond between with the concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deformed bars"@en .

aat:300015192 a skos:Concept ;
    skos:definition "General term for any compound, made of various materials, having a thick or paste-like consistency and used to fill up cracks or for similar purposes; particularly as used in construction or similar applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealing compound"@en .

aat:300015199 a skos:Concept ;
    skos:definition "A soft, waterproof filler and sealer, made of various materials, used in construction and repairs to seal joints or fill crevices where leakage or structural movement may occur. For the thick, paste-like mixture of powdered calcium carbonate and linseed oil, use \"putty (sealing compound).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caulking compound"@en .

aat:300015203 a skos:Concept ;
    skos:definition "Loosely twisted hemp or jute fiber impregnated with tar or a tar derivative and used in caulking seams, as of wooden ships, and packing joints, as of pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oakum"@en .

aat:300015205 a skos:Concept ;
    skos:definition "A soft, waterproof filler and sealer composed of acrylic polymers, water, latex, and fillers, used in construction and repairs to seal joints or fill crevices where leakage or structural movement may occur. It adheres well to wood, masonry and drywall and is water-soluble before setting. It may be painted over, but degrades quickly in sunlight and in places where there are extreme temperature shifts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latex caulk"@en .

aat:300015206 a skos:Concept ;
    skos:definition "A wool-like material of fine strands of lead; sometimes used as caulking in pipe joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead wool"@en .

aat:300015207 a skos:Concept ;
    skos:definition "A thick, paste-like mixture of powdered calcium carbonate and linseed oil, used to fill holes and cracks in wood or metal, to secure and seal panes of glass in window frames, and other applications to create an air and water tight seal. Some putties also contain lead white or red lead, which accelerate the drying of the linseed oil. In the second half of the 20th century, many new types of sealants and glazing compounds became available and oil based putty is generally no longer in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "putty"@en .

aat:300015208 a skos:Concept ;
    skos:definition "Any caulking compound used to hold window glass in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazier's putty"@en .

aat:300015214 a skos:Concept ;
    skos:definition "Cement used by conservators for stopping or filling holes in paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture putty"@en .

aat:300015215 a skos:Concept ;
    skos:definition "A powder that forms a pliable paste when mixed with water. It dries hard, can be tinted, and is used to fill small holes or cracks in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water putty"@en .

aat:300015217 a skos:Concept ;
    skos:definition "Any material, usually liquid, having the power of dissolving another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solvent"@en .

aat:300015224 a skos:Concept ;
    skos:definition "In chemistry, an organic compound in which one or more hydroxyl functional groups (-OH) are bound to a carbon atom; the carbon center should be saturated, having single bonds to three other atoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcohol"@en .

aat:300015226 a skos:Concept ;
    skos:definition "Refers to any of eight organic compounds with the same formula but differing structures. Common to industry, amyl alcohols have an oily consistency. The term is often used to describe mixtures of these compounds, which are used as solvents for resins and the manufacture of chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amyl alcohol"@en .

aat:300015227 a skos:Concept ;
    skos:definition "Colorless liquid solvent with an oily odor comprising any of four types of flammable liquid alcohol containing four carbons and used chiefly in organic synthesis and as a solvent. Of the four isomeric forms (n-butanol, isobutanol, t-butanol, sec-butanol), normal butanol is the most common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butyl alcohol"@en .

aat:300015231 a skos:Concept ;
    skos:definition "A colorless, volatile, flammable, water miscible liquid which is the intoxicating principle of fermented and distilled liquors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethyl alcohol"@en .

aat:300015234 a skos:Concept ;
    skos:definition "A form of ethyl alcohol that through direct distillation creates a constant-boiling-point mixture that is subsequently dehydrated to create absolute alcohol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absolute alcohol"@en .

aat:300015236 a skos:Concept ;
    skos:definition "Ethyl alcohol which has been rendered unfit for drinking; used as a diluent and cleaner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denatured alcohol"@en .

aat:300015237 a skos:Concept ;
    skos:definition "Common liquid secondary alcohol, and the first commercial synthetic alcohol. Synthesized by the hydration of propylene. Frequently used as an antiseptic, and in cosmetics. In industry it is used as a solvent and to produce acetone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isopropyl alcohol"@en .

aat:300015238 a skos:Concept ;
    skos:definition "Clear, colorless, slightly volatile solvent with a slight alcoholic smell; made by the destructive distillation of wood, peat, and lignite as well as by the partial oxidation of natural gas hydrocarbons. It is used as a fuel, a solvent, and in the manufacture of several organic compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl alcohol"@en .

aat:300015243 a skos:Concept ;
    skos:definition "One of four main types of hydrocarbon found in crude oil belonging to the class of organic compounds that has an unsaturated ring of carbon atoms, considered generally more volatile and active than an aliphatic hydrocarbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aromatic hydrocarbon"@en .

aat:300015244 a skos:Concept ;
    skos:definition "A clear, colorless, volatile aromatic solvent obtained from the destructive distillation of coal and oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benzene"@en .

aat:300015247 a skos:Concept ;
    skos:definition "Colorless aromatic liquid discovered by Pelletier and Walter, 1837. It is the basis of many chemical compounds in industry. Used in the synthesis of TNT, benzoic acid, saccharin, dyes, photographic chemicals, and pharmaceuticals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toluene"@en .

aat:300015249 a skos:Concept ;
    skos:definition "A mixture of three isomeric hydrocarbons form commercial xylene; a colorless, flammable, toxic liquid insoluble in water but that may be combined with many organic liquids and is commonly used as a solvent for lacquers and rubber cements. Other forms of xylene are used as solvents, components of aviation fuel, and for dyes, fibers, and films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xylene"@en .

aat:300015250 a skos:Concept ;
    skos:definition "A colorless, stable, low volatility liquid used as a solvent for paints, lacquers, varnishes, oils, dyes, inks, and synthetic resins. It is usually blended with other solvents to slow evaporation and delay setting or drying. Butyl lactate has also been used as a solvent for polyvinyl acetate based paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butyl lactate"@en .

aat:300015251 a skos:Concept ;
    skos:definition "A commercially prepared high-boiling ether alcohol used especially as an organic solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbitol"@en .

aat:300015255 a skos:Concept ;
    skos:definition "Volatile, noninflammable compound of carbon and chlorine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon tetrachloride"@en .

aat:300015256 a skos:Concept ;
    skos:definition "Volatile solvent obtained by the distillation of coal tar; industrial grades are widely used as solvent for rubber and many resinous materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal tar solvent"@en .

aat:300015257 a skos:Concept ;
    skos:definition "Any of a class of often fragrant compounds formed by the reaction between an acid and an alcohol usually with the elimination of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ester"@en .

aat:300015258 a skos:Concept ;
    skos:definition "A colorless liquid solvent compound of five isomers in the form of a volatile liquid with the smell and taste of bananas. Introduced in 1888 as a solvent for cellulose nitrate and later used for cellulose acetate. Applications include dyeing and finishing textiles, floor coverings, as flavoring, in polishes, varnishes, and metallic paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amyl acetate"@en .

aat:300015260 a skos:Concept ;
    skos:definition "A colorless liquid ester of acetic acid that has a fruity odor. It is used as a solvent for cellulose nitrate and in the manufacture of products such as celluloid, pyroxylin lacquers, airplane wing dope, photographic film, artificial leather, and safety glass. Because butyl acetate is not hygroscopic and evaporates slowly, it produces smooth shiny, transparent films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butyl acetate"@en .

aat:300015261 a skos:Concept ;
    skos:definition "An organic compound, the ester of ethanol and acetic acid in the form of a colorless liquid with a characteristic sweet odor. It is used as a solvent and diluent, as an additive in glues, perfumes, and cigarettes, and to decaffeinate coffee and tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethyl acetate"@en .

aat:300015262 a skos:Concept ;
    skos:definition "Colorless, clear, aromatic liquid used as a solvent, and as an additive in pharmaceuticals, cosmetics, lacquers, and printing inks, among other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isopropyl acetate"@en .

aat:300015263 a skos:Concept ;
    skos:definition "Solvent used for formulations of water- and solvent-based coatings, cleaning agents, inks and dyes, pesticides, cosmetics and adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethylene glycol monoethyl ether"@en .

aat:300015267 a skos:Concept ;
    skos:definition "Mixture of liquid hydrocarbons obtained from petroleum in the form of a flammable pale yellow to colorless oily liquid used as fuel for lamps, heaters, and jet engines, and as a solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerosene"@en .

aat:300015268 a skos:Concept ;
    skos:definition "Type of organic solvent used in paint and varnish remover, and as solvent for lacquer and plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ketone"@en .

aat:300015269 a skos:Concept ;
    skos:definition "A colorless, volatile, extremely flammable liquid, miscible with water; obtained as a byproduct of wood distillation or the fermentation of corn mash. Used as a solvent, cleaning fluid, fuel additive, and for dyeing cotton, among other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetone"@en .

aat:300015271 a skos:Concept ;
    skos:definition "Common name for an impure mixture of 50 percent acetone, 30 percent methyl acetate, and 20 percent methanol. It is used in lacquers, resins, paint and varnish removers, and for coagulating latex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl acetone"@en .

aat:300015272 a skos:Concept ;
    skos:definition "A flammable, toxic, ketone solvent with a flashpoint around 111 degrees Fahrenheit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl isobutyl ketone"@en .

aat:300015273 a skos:Concept ;
    skos:definition "A colorless, toxic, flammable, vinyl resin liquid solvent with a flash point of 24-30 degrees Fahrenheit. It is used as a solvent for cellulose nitrate lacquers, vinyl films, acrylic coatings, inks, and alkyd (Glyptal) resins. It is also used as a component in paint removers and cleaning fluids. It does not dissolve cellulose acetate or most waxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl ethyl ketone"@en .

aat:300015274 a skos:Concept ;
    skos:definition "Volatile liquid used as a dilutent in the making of butyl rubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methylene chloride"@en .

aat:300015275 a skos:Concept ;
    skos:definition "A hydrocarbon petroleum distillate, used as a dry-cleaning fluid and as a solvent for varnishes and paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral spirit"@en .

aat:300015282 a skos:Concept ;
    skos:definition "Refers to a variety of volatile flammable liquids obtained from the distillation of petroleum, used for making gasoline, kerosene, and solvents. Alchemists used the word to describe liquids of low boiling point including ethers and esters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naphtha"@en .

aat:300015283 a skos:Concept ;
    skos:definition "A fragrant, liquid, unsaturated hydrocarbon used chiefly in making synthetic rubber, resin, and plastic and in improving drying oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "styrene"@en .

aat:300015285 a skos:Concept ;
    skos:definition "Generally, a class of hydrocarbons found in the volatile oils of plants, especially the coniferous and aurantiaceous orders. Most common is the chief constituent of turpentine, pinene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terpene"@en .

aat:300015286 a skos:Concept ;
    skos:definition "Liquid terpene hydrocarbon found in many essential oils, usually obtained along with other types of terpenoid from certain kinds of terpentine and used chiefly as a solvent and dispersing agent, such as for resin and varnish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dipentene"@en .

aat:300015287 a skos:Concept ;
    skos:definition "A colorless or light amber colored, pleasant smelling oil obtained from the steam distillation of wood from the pine species Pinus palustris. It is valued for its low rate of evaporation and used as a retardant for oil paints that dry too rapidly. Pine oil is also used as a preservative, as a solvent for gums, resins, and other substances, for its germicidal properties as a principal constituent of general disinfectants, in odorants, insecticides, detergents, wetting and emulsifying agents, wax preparations, antifoaming agents, in textile scouring, and the flotation process for refining lead and zinc ores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pine oil"@en .

aat:300015288 a skos:Concept ;
    skos:definition "A volatile, flammable liquid obtained as the steam distillate from the thick resinous extract from coniferous trees; the crude resin contains about 65 percent rosin (solid residue) and 18 percent oil of turpentine. The volatile distillate, or oil of turpentine, is a mixture of cyclic monoterpene hydrocarbons, with the major component being pinene. Turpentine has been known since classical times. It is primarily used as a solvent for artist paints and varnishes, a cleaner for paint brushes, and a solvent for many natural resins, waxes, oils, plastics, and rubber. Three major grades of turpentine exist. The best quality turpentine is fresh, clear and thin. Turpentine thickens and yellows with age; moisture can cause cloudiness in varnishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turpentine"@en .

aat:300015290 a skos:Concept ;
    skos:definition "The volatile fraction collected from distilling gum thus, which is a balsam exudate obtained from several North American trees. Rosin is the solid, resinous residue left after the distillation of turpentine. Gum turpentine is used chiefly as a solvent and thinner, as a raw material of certain chemicals, such as synthetic camphor, and in medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum turpentine"@en .

aat:300015291 a skos:Concept ;
    skos:definition "Turpentine obtained from waste wood, chips, or sawdust by steam extraction or destructive distillation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood turpentine"@en .

aat:300015292 a skos:Concept ;
    skos:definition "Either of two isomeric halogenated hydrocarbons used as a solvent for cleaning and degreasing metals, as a coolant, or in the manufacture of other chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tricloroethane"@en .

aat:300015295 a skos:Concept ;
    skos:definition "Materials used to prime or prepare a surface (such as canvas)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface preparation materials"@en .

aat:300015297 a skos:Concept ;
    skos:definition "Substance used to prepare the surface on which or from which an image is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground"@en .

aat:300015298 a skos:Concept ;
    skos:definition "A ground made by combining or emulsifying gesso and oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emulsion ground"@en .

aat:300015299 a skos:Concept ;
    skos:definition "Chemical substance that fixes a dye in or on a substance by combining with the dye to form an insoluble compound. In etching, refers to a corrosive substance, such as a nitric acid solution, used to corrode or bite the exposed areas of a metal plate. In gilding, refers to a viscous substance used to adhere the gold leaf to a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mordant"@en .

aat:300015300 a skos:Concept ;
    skos:definition "Latin for nitric acid, a dilution of which is the principal mordant used in etching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aqua fortis"@en .

aat:300015301 a skos:Concept ;
    skos:definition "A compound solution of potassium chlorate and hydrochloric acid used as a mordant in etching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch mordant"@en .

aat:300015302 a skos:Concept ;
    skos:definition "Solution of hydrochloric acid and potassium chlorate used as a mordant in aquatint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Smillie's bath"@en .

aat:300015303 a skos:Concept ;
    skos:definition "Fluid added to coating material to increase penetration into a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penetrant"@en .

aat:300015304 a skos:Concept ;
    skos:definition "A white ground or other coating applied to a surface before painting to give uniform texture and absorbency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primer"@en .

aat:300015306 a skos:Concept ;
    skos:definition "A white paste composed of titanium white and other white or inert pigment in a polymer vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymer primer"@en .

aat:300015308 a skos:Concept ;
    skos:definition "Any substance used to block out or mask temporarily a surface area in order to prevent or impede an action (as of a chemical) on the masked area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resist"@en .

aat:300015310 a skos:Concept ;
    skos:definition "Any substance or solution applied to a metal surface that eradicates rust layers. Gasoline, kerosene, sodium citrate, aluminum sulfate, ferrous sulfate, and boric acid have all been used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rust removing agent"@en .

aat:300015312 a skos:Concept ;
    skos:definition "Any of various glutinous materials used for filling the pores in surfaces, as of paper, textile, leather, or plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "size"@en .

aat:300015315 a skos:Concept ;
    skos:definition "An animal glue or gelatin used for surface-sizing paper or textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal size"@en .

aat:300015317 a skos:Concept ;
    skos:definition "In gilding, the adhesive that holds the metal leaf to the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold size"@en .

aat:300015319 a skos:Concept ;
    skos:definition "Material used as a paper or fabric sizing, manufactured by treating wood pulp with caustic soda and with carbon bisulphide, resulting in a brown-yellow mass containing about 25 percent cellulose, which may be dissolved in water to a solution of variable concentration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viscose size"@en .

aat:300015321 a skos:Concept ;
    skos:definition "Compound able to reduce the surface tension of liquid to which it is added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface active agent"@en .

aat:300015322 a skos:Concept ;
    skos:definition "Any material that deflocculates or disperses finely ground materials by satisfying the surface energy requirements of the particles; used as slurry thinner or a grinding agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dispersant"@en .

aat:300015323 a skos:Concept ;
    skos:definition "Liquid or chemical added to a solution to reduce the surface tension and give greater ease of mixing and stability, such as liquid added to watercolor so that the paint will flow freely and take evenly on the paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wetting agent"@en .

aat:300015324 a skos:Concept ;
    skos:definition "Chalk that has been ground and washed for use in paint, ink, and putty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiting"@en .

aat:300015332 a skos:Concept ;
    skos:definition "Building materials comprising cut, carved, shaped, or molded units of stone, ceramic brick or tile, concrete, glass, adobe, or other similar material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry"@en .

aat:300015333 a skos:Concept ;
    skos:definition "Designs or arrangements comprising fired brick, sometimes glazed or otherwise decorated, arranged using bricklaying, especially arrangements in patterns or images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brickwork"@en .

aat:300015334 a skos:Concept ;
    skos:definition "Building material comprising masonry made of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stonework"@en .

aat:300015336 a skos:Concept ;
    skos:definition "Visual works that are the products of working any kind of metal, particularly metal objects of artistic merit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalwork"@en .

aat:300015338 a skos:Concept ;
    skos:definition "Visual works or parts of works made of iron, generally reserved for decorative forms fashioned in wrought or cast iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironwork"@en .

aat:300015339 a skos:Concept ;
    skos:definition "Visual works or parts of works made from lead, particularly sculptural, ornamental, or architectural objects. Usage may include plumbing or glazier's work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leadwork"@en .

aat:300015341 a skos:Concept ;
    skos:definition "Refers to a building technique used primarily in bridges and buildings, in which a skeleton frame of vertical steel columns and horizontal I-beams are constructed in a rectangular grid. The grid is used to support the floors, roof, and walls of the building. The development of this technique made the construction of the skyscraper possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel frame construction"@en .

aat:300015342 a skos:Concept ;
    skos:definition "Images or patterns composed of small, regularly shaped pieces of durable material, usually stone or colored glass. Distinguished from \"opus sectile,\" which is composed of individually shaped pieces of durable material, usually stone or glass, which conform to the design or pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosaics"@en .

aat:300015343 a skos:Concept ;
    skos:definition "Visual works made of plaster, which is a soft, plastic material, in this context usually a mixture of water, lime, and sand, often combined with other materials, such as animal hair. Plasterworks are either applied smoothly to a surface or as a combination of high-relief, sculptural, and surface decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasterwork"@en .

aat:300015344 a skos:Concept ;
    skos:definition "Ornamental relief plasterwork stamped or carved between the studwork on the outside of half-timber houses, or sometimes covering the whole wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pargeting"@en .

aat:300015348 a skos:Concept ;
    skos:definition "General term for visual works, parts of works, interior fittings of architecture, or other works made of wood. Examples include moldings and staircases, cabinets and furniture, and wooden sculptures or toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodwork"@en .

aat:300015351 a skos:Concept ;
    skos:definition "Used to refer to crude or processed material that can be converted by manufacture, processing, or combination into a new and useful product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw material"@en .

aat:300015356 a skos:Concept ;
    skos:definition "Materials that resist the effects of caustic chemicals, as protective coatings, membranes, fabrics, or integral structural materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical-resistant material"@en .

aat:300015358 a skos:Concept ;
    skos:definition "Materials that are reactive when combined with secondary materials, causing breakdown, oxidation, decay, or other structural changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrosive material"@en .

aat:300015366 a skos:Concept ;
    skos:definition "Materials that create a barrier against heat sources, to protect against damage or to insulate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat resistant material"@en .

aat:300015367 a skos:Concept ;
    skos:definition "Material, usually nonmetallic and often ceramic, able to withstand very high temperatures and with a melting point above 1580 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refractory"@en .

aat:300015369 a skos:Concept ;
    skos:definition "Material, such as the aggregate in a concrete mixture, that does not enter into a chemical reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inert material"@en .

aat:300015372 a skos:Concept ;
    skos:definition "Substances, such as certain chemicals or waste products, that render the air, soil, water, or other natural resource harmful or unsuitable for a specific use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pollutants"@en .

aat:300015374 a skos:Concept ;
    skos:definition "Any material composed chiefly of fragments of volcanic origin, as agglomerate, tuff, and certain other rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyroclastic material"@en .

aat:300015377 a skos:Concept ;
    skos:definition "Used to refer to a substance that is neither in the liquid or gaseous state but instead in the solid state. The solid state is the state of matter in which a substance does not flow perceptibly under moderate stress; has a capacity for resisting forces (as compression or tension) which tend to deform it; and under ordinary conditions retains a definite size and shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid"@en .

aat:300015378 a skos:Concept ;
    skos:definition "Used to refer to a substance in the liquid state. The liquid state is the state of matter in which a substance exhibits a characteristic readiness to flow; little or no tendency to disperse; and relatively high incompressibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquid"@en .

aat:300015379 a skos:Concept ;
    skos:definition "Substance in the gaseous state, the state of matter distinguished from the liquid and solid states by very low density and viscosity; relatively great expansion and contraction with changes in pressure and temperature; the ability to diffuse readily; and the spontaneous tendency to become distributed uniformly throughout any container."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas"@en .

aat:300015387 a skos:Concept ;
    skos:definition "Graphic designs intended to explain rather than simply represent. For example, in geometry, a diagram may be a figure composed of lines, serving to illustrate a definition or statement, or to aid in the proof of a proposition. In other contexts, a diagram may be any illustrative figure which, without necessarily representing the exact appearance of an object, gives an outline or general scheme of it, so as to explain or exhibit the shape and relations of its various parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagrams"@en .

aat:300015393 a skos:Concept ;
    skos:definition "Diagrams using labeled blocks connected by straight lines to represent the relationship of parts or phases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block diagrams"@en .

aat:300015423 a skos:Concept ;
    skos:definition "Portraits cut from paper and mounted on a contrasting background; also, by extension, images showing no interior detail set against a contrasting background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silhouettes"@en .

aat:300015424 a skos:Concept ;
    skos:definition "Depictions of places or things seen from a distance, with a range of sight distinct from other information forms such as diagrams, working drawings, or verbal descriptions. Generally reserved for two-dimensional media such as prints, drawings, paintings, photographs, or bas-reliefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "views"@en .

aat:300015441 a skos:Concept ;
    skos:definition "Compositions focusing on fanciful characters involved in pranks, capers, or other imaginary activities, or on buildings or architectural features grouped in arbitrary, imaginary arrangements or in a fantasy setting. Use especially with reference to 18th-century Italian paintings and prints. For views that are realistically conceived but the topography or architectural elements are unrealistic and imaginary, use \"vedute ideate.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capricci"@en .

aat:300015503 a skos:Concept ;
    skos:definition "Refers to depictions from a vantage point at an angle to the perpendiculars of the subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblique views"@en .

aat:300015518 a skos:Concept ;
    skos:definition "Refers to depictions that include the entire subject, as contrasted to views of a detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general views"@en .

aat:300015527 a skos:Concept ;
    skos:definition "Refers to views achieved by photographing from an aircraft or other high location, or in any medium imagined as if seen from such a high location. When emphasizing a photograph itself, use \"aerial photographs.\" For nonphotographic depictions having high viewpoints, typically prefer \"bird's-eye views\" or \"bird's-eye perspectives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial views"@en .

aat:300015529 a skos:Concept ;
    skos:definition "Refers to nonphotographic depictions having a viewpoint well above normal eye level. They are typically prints, drawings or paintings that incorporate a point of view as if the viewer were looking at the ground from the level of the clouds. The advantage of the high angle is that more detail can be displayed, as the foreground does not obscure the background. This view has been used since the time of ancient Rome, when it was used to portray battlefields; it is also commonly used to portray urban developments, for landscape garden plans, and for palaces and towns. Bird's-eye views depict a vantage point higher than one taken from just above roof-level, but lower than a map-view. For architectural drawings in precise perspective, use \"bird's-eye perspectives.\" For photographs, use \"aerial views\" or \"aerial photographs.\" For pictorial maps, use \"map views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird's-eye views"@en .

aat:300015537 a skos:Concept ;
    skos:definition "Refers generally to pictorial representations with very broad horizontal ranges of view. The term is also used specifically for photographs that show a wide view produced by a panoramic camera or by joining photographs together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panoramas"@en .

aat:300015540 a skos:Concept ;
    skos:definition "Refers to depictions with a point of view at or around the level of a human standing on the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye-level views"@en .

aat:300015544 a skos:Concept ;
    skos:definition "Refers to views having a viewpoint well below normal eye level, typically depicted as if seen from the surface of the earth or the floor, as if the viewer is lying down and looking straight up. The horizon for a worm's-eye view is usually placed very low or outside the picture. For architectural drawings in precise perspective, use \"worm's-eye perspectives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worm's-eye views"@en .

aat:300015551 a skos:Concept ;
    skos:definition "Refers to depictions that include only a part of the entire person, place, or thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partial views"@en .

aat:300015556 a skos:Concept ;
    skos:definition "Refers to detailed, largely factual topographical views, especially 18th-century Italian paintings, drawings, or prints of cities. Examples of early vedute were painted by northern European artists who worked in Italy in the 16th century. For imaginary views, use \"vedute ideate.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vedute"@en .

aat:300015558 a skos:Concept ;
    skos:definition "Views that are realistically conceived but having elements that are completely imaginary. For scenes of accurately rendered buildings grouped in an arbitrary, imaginary arrangement, use \"capricci (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vedute ideate"@en .

aat:300015566 a skos:Concept ;
    skos:definition "Refers to pictorial or photographic representations that faithfully (though not necessarily with total accuracy) depict actual locations. May be \"landscapes (representations),\" \"cityscapes (visual works),\" or \"townscapes (representations),\" though those terms tend to imply invention whereas \"topographical views\" implies recording of appearances. For faithful drawings of individual buildings, use \"measured drawings,\" \"record drawings,\" or \"as-built drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topographical views"@en .

aat:300015571 a skos:Concept ;
    skos:definition "Refers to creative works that depict settlements that may be considered cities, which are large or important communities with population, status, and internal complexity greater than most towns in the region. For creative works depicting towns, use \"townscapes (representations).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cityscapes"@en .

aat:300015578 a skos:Concept ;
    skos:definition "Pictures or diagrams that clarify or provide an example or visualization. They usually accompany a text; the term is most often used to refer to pictures in books or published journal. For works that explore a subject or are preliminary to a separate, more finalized work, use \"studies (visual works).\" For paintings in manuscripts, use \"illuminations\" or \"miniatures (paintings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illustrations"@en .

aat:300015589 a skos:Concept ;
    skos:definition "The works of artists who illustrate trials in courtrooms where video and photography aren’t permitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtroom illustrations"@en .

aat:300015593 a skos:Concept ;
    skos:definition "Images other than photographs provided to show fashionable apparel and accessories, especially for advertisement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion illustrations"@en .

aat:300015595 a skos:Concept ;
    skos:definition "Illustrations created specifically to illuminate some aspect of scientific inquiry, often in the field of biology. These may include unrealistic renderings, such as transparency, layering, etc.of subject matter that serve to illustrate functions or chronological events more clearly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific illustrations"@en .

aat:300015611 a skos:Concept ;
    skos:definition "Generally, any thing laid over something else, more specifically a transparent sheet placed over an image, text, map, diagram, or artwork, to form a composite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overlays"@en .

aat:300015613 a skos:Concept ;
    skos:definition "Casual scribbles or informal drawings on walls or other surfaces. Examples include the following: The casual scribbles or pictographs on walls, stones, or other surfaces in ancient and medieval times, the marks incised or cut into the underside of ancient Greek vases and other ceramics, and modern humorous, satiric, obscene, or gang-related writings or drawings executed anonymously in public places. For more finished, elaborate works on modern walls and other surfaces, prefer \"graffiti art.\" Graffiti is not the works created by \"sgraffito,\" in that sgraffito is not casual, but is instead a formal decorative mark-making technique used on pottery, glass, or other surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graffiti"@en .

aat:300015614 a skos:Concept ;
    skos:definition "Marks or designs on the skin made by puncturing and inserting pigments. Practiced in ancient times until the present day worldwide and popularized in European and non-indigenous American culture since the 18th century by seamen returning from Polynesia. Motives for tattooing vary by culture. Tattoos may be purely decorative, may indicate rank in social structures, or be applied for spiritual reasons. In a contemporary context, temporary decals can mimic the appearance of true tattoos, whereas traditional tattoos are created by injecting pigment permanently under the skin's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tattoos"@en .

aat:300015617 a skos:Concept ;
    skos:definition "Rough or summary art works; less finished than studies. Though sketches are often in the drawing medium, the term \"drawings\" in general implies more finished works than does \"sketches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sketches"@en .

aat:300015618 a skos:Concept ;
    skos:definition "Aids to the initial visualization of a design, especially, but not limited to, drawings. Less finished than \"preliminary drawings\" or \"preparatory drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preliminary sketches"@en .

aat:300015634 a skos:Concept ;
    skos:definition "Exaggerated, distorted representations of a subject in art or literature; in art, refers particularly to representations, often portraits, that exaggerate certain features or characteristics to humorous or ludicrous effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caricatures"@en .

aat:300015635 a skos:Concept ;
    skos:definition "Use broadly for sequential graphic narratives, often serialized, and typically having dialogue written in balloons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comics"@en .

aat:300015636 a skos:Concept ;
    skos:definition "Creative works, usually two-dimensional, depicting an outdoor scene dominated by the land, hills, fields, sky, trees, fields, rivers or other bodies of water, and other natural elements. Landscapes may include a near point of view in the foreground, but also usually depict a view into the distance. Landscapes may contain architecture or figures, but the primary focus remains the land. When an ocean, sea, or other large body of water dominates the picture, use \"seascapes.\" For actual areas of land rather than depictions, use \"landscapes (environments).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscapes"@en .

aat:300015637 a skos:Concept ;
    skos:definition "Representations of real individuals that are intended to capture a known or supposed likeness, usually including the face of the person. For representations intended to be anonymous, or of fictional or mythological characters, see \"figures (representations).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portraits"@en .

aat:300015638 a skos:Concept ;
    skos:definition "Images, often paintings, in which the focus is a depiction of inanimate objects, as distinguished from art in which such objects are subsidiary elements in a composition. Common examples of still lifes are depictions of fruit, flowers, meat or dead game, vessels, eating utensils, and other objects, including skulls, candles, and hourglasses, typically arranged on a table. Such images were known since the time of ancient Greece and Rome; however, the subject was exploited by some 16th-century Italian painters, and was highly developed in 17th-century Dutch painting, where the qualities of form, color, texture, and composition were valued, and the images were intended to relay allegorical messages. The subject is generally seen in oil paintings, though it can also be found in mosaics, watercolors, prints, collages, and photographs. The term originally included paintings in which the focus was on living animals at rest, although such depictions would now be called \"animal paintings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "still lifes"@en .

aat:300015640 a skos:Concept ;
    skos:definition "Works that strongly resemble or reproduce the appearance or content of original existing objects. Implies less precise and faithful imitation than does the term \"reproductions.\" When copies are presented with intent to deceive, use \"forgeries\" or \"counterfeits.\" When more than one similar work is produced by the same maker, use \"replicas\" or the narrower concept, \"versions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copies"@en .

aat:300015641 a skos:Concept ;
    skos:definition "Valued objects or documents that are made or altered with intent to deceive; may range in falsehood from counterfeiting of whole works to altering of signatures or other deliberate misrepresentations. Distinguished from \"copies (derivative objects)\" by the intention of deception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forgeries"@en .

aat:300015642 a skos:Concept ;
    skos:definition "Precise reproductions of valued objects, usually in the same dimensions as the original, or at scale. For reproductions of an image alone, use \"reproductions\" or \"facsimiles.\" Use also when more than one similar object is produced by the same artist, craftsman, or studio, with little or no variation between them; if variation is apparent, use \"versions.\" Distinct from \"forgeries\" and \"counterfeits,\" which are produced with the intent to deceive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "replicas"@en .

aat:300015643 a skos:Concept ;
    skos:definition "Copies of art images, art objects, decorative arts, or other valued images or objects, made without intent to deceive; with regard to art images, it includes photographic reproductions. The term implies more precise and faithful imitation than does the term \"copies (derivative objects).\" Where the intent is to deceive, see \"forgeries\" or \"counterfeits.\" For prints copying other two-dimensional works, typically dating from before the widespread use of photography, use \"reproductive prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductions"@en .

aat:300015644 a skos:Concept ;
    skos:definition "Source works of art or documents from which copies may be made, or works otherwise distinguished in general from reproductions or other types of copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "originals"@en .

aat:300015647 a skos:Concept ;
    skos:definition "Refers to the cultures of the continent of Africa, which is bounded by the Atlantic Ocean, the Indian Ocean, and the Mediterranean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African"@en .

aat:300015649 a skos:Concept ;
    skos:definition "Cultures and styles from the prehistoric era in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric African"@en .

aat:300015650 a skos:Concept ;
    skos:definition "Periods related to prehistoric North African cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric North African periods"@en .

aat:300015651 a skos:Concept ;
    skos:definition "Periods related to African Paleolithic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African Paleolithic periods"@en .

aat:300015656 a skos:Concept ;
    skos:definition "Refers to a highly developed Middle and Late Paleolithic tool-making culture that was widespread in northern Africa during the late Pleistocene Epoch from around 30,000 Before Present. It apparently developed as an advanced African form of the European Levalloisian tradition, and is named for the site at Bir al-Atir, Tunisia. It is characterized by the use of the bow and arrow, the formation of stems or tangs on arrowheads, spearheads, and scrapers to facilitate hafting, and a very fine pressure chipping technique. Some scholars believe there is a relationship between Aterian leaf-shaped blades and Solutrean blades, and that the Aterians entered the Iberian Peninsula during Solutrean times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aterian"@en .

aat:300015657 a skos:Concept ;
    skos:definition "Refers to an Upper Paleolithic North African tool-making culture dating from around 40,000 to around 33,000 Before Present and named for the site at Hagfet et Dabba, or Cave of the Hyena, on the coast of Libya. It is characterized by backed blades, end scrapers, and transverse burins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dabban"@en .

aat:300015658 a skos:Concept ;
    skos:definition "Periods related to African Epipaleolithic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African Epipaleolithic periods"@en .

aat:300015659 a skos:Concept ;
    skos:definition "Refers to a Mesolithic tool-making culture generally located in inland areas of North Africa, and named after the site at Jabal al-Maqta near Qafsah, or Capsa, Tunisia. It is believed to be partially contemporary with the slightly earlier Oranian culture, which was more often located in coastal areas. It is apparently related to the older Gravettian culture in Europe and its tools are typical of the late Würm Glacial Period, though it seems to have flourished in postglacial times. It is distinguished from the Oranian culture in the variety of its tool kit, including large backed blades and burins. Some North African rock paintings are attributed to people from this culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capsian"@en .

aat:300015660 a skos:Concept ;
    skos:definition "Archaelogical period limited to Western Algeria. Has not yet been dated, probably belonging to the Holocene or a contemporary of the Capsian. It is known only from a few surface or unstratified midden sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Keremian"@en .

aat:300015661 a skos:Concept ;
    skos:definition "Archaeological industry dated to about 8000 BCE, characterized by a sudden technological change evinced by grinding stones, more bone tools, polished bone artifacts, decorated ostrich eggshell, and shell beads. This change is believed to coincide with climactic shift toward higher temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Libyco-Capsian"@en .

aat:300015662 a skos:Concept ;
    skos:definition "Refers to a tool-making culture generally located in coastal areas and some inland areas of North Africa, and dating from around 16,000 Before Present during the late Würm Glacial Period. It followed the Aterian culture and was probably partially contemporary with the slightly later Capsian culture, which was prominent in inland areas. Although it was formerly thought to have developed from the late Magdalenian culture in Spain, Oranian culture is now usually held to have been derived from the Nile River valley Halfan culture. It is characterized by small-backed blades and is distinguished from Capsian particularly by the absence of burins. It is possibly associated with a North African branch of Cro-Magnon people, the Mechta-el-Arbi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oranian"@en .

aat:300015667 a skos:Concept ;
    skos:definition "Periods related to prehistoric Sub-Saharan African cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric Sub-Saharan African periods"@en .

aat:300015668 a skos:Concept ;
    skos:definition "Periods related to Sub-Saharan African Earlier Stone Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-Saharan African Earlier Stone Age periods"@en .

aat:300015669 a skos:Concept ;
    skos:definition "Refers to a Lower Pleistocene cultural period preceding the Abbevillian. It is characterized by crudely flaked stone axes and beaked and keeled flint or stone objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Chellean"@en .

aat:300015670 a skos:Concept ;
    skos:definition "Refers to a purported Lower Pleistocene cultural period in sub-Saharan Africa and Uganda typified by crudely chipped pebble tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kafuan"@en .

aat:300015671 a skos:Concept ;
    skos:definition "Period of toolmaking tradition characterized by crude bi-directionally chipped tools of quartz, quartzite, or basalt, used for chopping, scraping, or cutting. These date from the early Paleolithic. It is thought that these implements were manufactured by early hominids or robust australopithecines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oldowan"@en .

aat:300015673 a skos:Concept ;
    skos:definition "Transitional sub-Saharan African Stone Age cultural period thought to be characterized by five stages of hand-axe industry occurring near the Olduvai Gorge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chelles-Acheul"@en .

aat:300015675 a skos:Concept ;
    skos:definition "Periods related to Sub-Saharan African First Intermediate Stone Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-Saharan African First Intermediate Stone Age periods"@en .

aat:300015676 a skos:Concept ;
    skos:definition "Refers to a sub-Saharan tool-making culture dating from the early Pleistocene, from about 100,000 to about 75,000 before present, and named after the site at Fauresmith, Free State province, South Africa. It is largely contemporaneous with the Sangoan industry developed by forest-dwelling people, and is distinguished from Sangoan by having existed in open steppe areas. Fauresmith culture is characterized by numerous flake tools, including projectile points of classic Levalloisian technique, small hand axes, and cleavers. It is associated with Saldanha man, who is attributed to Homo sapiens rodesiensis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fauresmith"@en .

aat:300015677 a skos:Concept ;
    skos:definition "Refers to a sub-Saharan tool-making culture dating from the upper Pleistocene and nearly contemporaneous with the Fauresmith industry of southern Africa. It is named after the site at Sango Bay, Uganda, and has also been found in Angola, Zaire, Kenya, Zambia, and elsewhere. It is characterized by hand axes, flake knives, scrapers, large planes for woodworking, and a peculiar pick. Sangoan culture was apparently developed by a forest-dwelling people, while the Fauresmith was developed by a plains-dwelling people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sangoan"@en .

aat:300015678 a skos:Concept ;
    skos:definition "Periods related to Sub-Saharan African Middle Stone Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-Saharan African Middle Stone Age periods"@en .

aat:300015679 a skos:Concept ;
    skos:definition "Refers to a Late Paleolithic stone tool culture that flourished from Ethiopia southward to the eastern coast of South Africa from about 50,000 to 30,000 Before Present. It is often compared to the Mousterian industry of North Africa and Europe, and is characterized by leaf-shaped bifacial points and lance heads or skinning knives made by the Levallois stone-flaking technique of shaping a prepared core in order to produce pointed flakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stillbay"@en .

aat:300015682 a skos:Concept ;
    skos:definition "Periods related to Sub-Saharan African Second Intermediate Stone Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-Saharan African Second Intermediate Stone Age periods"@en .

aat:300015683 a skos:Concept ;
    skos:definition "Refers to an African stone tool-making culture dating from the Pleistocene Epoch and named for a site at Magosi, northern Uganda. It is characterized by an advanced Levallois technique that is employed to produce flakes that were used to manufacture other tools, pressure flaking to produce projectile points, and a punch technique to produce microlithic artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magosian"@en .

aat:300015685 a skos:Concept ;
    skos:definition "Periods related to Sub-Saharan African Later Stone Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-Saharan African Later Stone Age periods"@en .

aat:300015690 a skos:Concept ;
    skos:definition "Cultures and styles of Africa in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient African"@en .

aat:300015692 a skos:Concept ;
    skos:definition "Cultures and styles of Central Africa in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Central African"@en .

aat:300015702 a skos:Concept ;
    skos:definition "Cultures and styles of East Africa in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient East African"@en .

aat:300015703 a skos:Concept ;
    skos:definition "Use both for the Ethiopian period and to describe its material cultural remains having traits that developed around 700 BCE, but more specifically attributed to the era between the first century BCE and around 1000 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aksumite"@en .

aat:300015715 a skos:Concept ;
    skos:definition "Culture and styles of the ancient African kingdom of Kush, located at the confluence of the Blue Nile, White Nile, and Atbara rivers in present-day Sudan. The Kushite kings ruled as pharaohs of the Twenty-fifth Dynasty of Egypt. Kushite art and architecture, though inspired by the canons of New Kingdom and Ptolemaic Egypt, showed increasing independence in the first millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kushite"@en .

aat:300015723 a skos:Concept ;
    skos:definition "Styles and cultures of North Africa in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient North African"@en .

aat:300015726 a skos:Concept ;
    skos:definition "The style and culture of the people of ancient Numidia, a kingdom and later a Roman province located in North Africa in the area corresponding roughly to present-day Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Numidian"@en .

aat:300015727 a skos:Concept ;
    skos:definition "Cultures and styles of southern Africa in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Southern African"@en .

aat:300015753 a skos:Concept ;
    skos:definition "Styles of pottery belonging to ancient Southern African cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient Southern African pottery styles"@en .

aat:300015759 a skos:Concept ;
    skos:definition "Cultures and styles of West Africa in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient West African"@en .

aat:300015768 a skos:Concept ;
    skos:definition "Styles belonging to ancient Inland Niger Delta cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient Inland Niger Delta styles"@en .

aat:300015774 a skos:Concept ;
    skos:definition "Name given to the people who inhabited the Bandiagara Escarpment in present-day southern Mali, beginning during the eleventh century CE. Additional information about the people is not yet known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tellem"@en .

aat:300015777 a skos:Concept ;
    skos:definition "Style and culture of the people of southern Nigeria noted for their production of fine bronzes and carved ivories, particularly of the inhabitants who predated the modern nation of Bénin. For the style and culture of the modern nation, use \"Beninese.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Benin"@en .

aat:300015815 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting primarily Borno state in northeastern Nigeria and in adjacent areas of Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kanuri"@en .

aat:300015821 a skos:Concept ;
    skos:definition "Describes works created by the African peoples living in the region of the Lower Niger River, including the Delta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Niger"@en .

aat:300015822 a skos:Concept ;
    skos:definition "Culture and style of the Nok people of northern Nigeria that appeared ca. 1000 BCE and vanished due to unknown reasons around 300 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nok"@en .

aat:300015845 a skos:Concept ;
    skos:definition "Styles and cultures from the region comprising the westernmost area of the African continent, defined by the United Nations as including the modern nations of Benin, Burkina Faso, Côte d'Ivoire, Cape Verde, Gambia, Ghana, Guinea, Guinea-Bissau, Liberia, Mali, Mauritania, Niger, Nigeria, Senegal, Sierra Leone, and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West African"@en .

aat:300015846 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the historic Western Sudan region in the northern part of west Africa, from the Atlantic to the basin of Lake Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Sudanese"@en .

aat:300015852 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marka"@en .

aat:300015859 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kurumba"@en .

aat:300015863 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Burkino Fasa, related to the Nuna but living in an area north of them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nunuma"@en .

aat:300015865 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Ghana and Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nafana"@en .

aat:300015867 a skos:Concept ;
    skos:definition "Refers to the styles and culture of a group of closely related peoples of northern Ctte d'Ivoire and southeastern Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Senufo"@en .

aat:300015872 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Bénin and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bargu"@en .

aat:300015878 a skos:Concept ;
    skos:definition "Term used to describe works produced by the African people of the same name living in Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bwa"@en .

aat:300015881 a skos:Concept ;
    skos:definition "Style and culture of the group of African peoples referred to by that collective name living in Burkina Faso between the Black Volta and the Red Volta rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gurunsi"@en .

aat:300015885 a skos:Concept ;
    skos:definition "Used to describe works produced by the African ethnic group of the same name inhabiting Togo and Bénin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tamberma"@en .

aat:300015888 a skos:Concept ;
    skos:definition "Peoples dwelling on the fringe of the Western Sudan region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Sudanese fringe-dwelling peoples"@en .

aat:300015890 a skos:Concept ;
    skos:definition "Style and culture of an African people living in many different nations across West Africa, including Senegal, Mali, Niger, Nigeria, Cameroon, Benin, Burkina Faso, Chad, Central African Republic, Côte d'Ivoire, Gambia, Ghana, Guinea-Bissau, Mauritania, Sierra Leone, Sudan, and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fulbe"@en .

aat:300015895 a skos:Concept ;
    skos:definition "Describes works created by the Fulbe people living in Gambia and Senegal. The name is a Mande term that has been adopted into Gambian English, and also appears sometimes in the French of Senegal Oriental and upper Casamance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fula"@en .

aat:300015901 a skos:Concept ;
    skos:definition "Styles and cultures belonging to the Lake Chad region in Chad and northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lake Chad"@en .

aat:300015910 a skos:Concept ;
    skos:definition "Styles belonging to Guinea Coast cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guinea Coast styles"@en .

aat:300015911 a skos:Concept ;
    skos:definition "Styles belonging to West Atlantic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Atlantic styles"@en .

aat:300015917 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Kolda region of Sénégal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jola"@en .

aat:300015926 a skos:Concept ;
    skos:definition "Nationality, styles, and cultures within the secret Simo society of West Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Simo"@en .

aat:300015960 a skos:Concept ;
    skos:definition "Styles belonging to Kwa-speaking peoples cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwa-speaking peoples styles"@en .

aat:300015964 a skos:Concept ;
    skos:definition "Styles belonging to Kru-speaking peoples cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kru-speaking peoples styles"@en .

aat:300015998 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kyaman"@en .

aat:300016004 a skos:Concept ;
    skos:definition "The culture and style of people of south-central Ghana and adjacent areas of Togo and Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asante"@en .

aat:300016009 a skos:Concept ;
    skos:definition "The style and culture of the Akan-speaking peoples traditionally living in the savanna region between the Bandama and N’zi rivers in central Côte d’Ivoire, West Africa. Since 1940, there has been significant migration of the Baule to the southern, forested part of the country in search of land more productive for coffee and cocoa planting. Baule art is considered a separate and distinct style, although specific categories of Baule art are historically and stylistically close to the art forms of their neighbors. The style and culture of the Akan-speaking peoples traditionally living in the savanna region between the Bandama and N’zi rivers in central Côte d’Ivoire, West Africa. Since 1940, there has been significant migration of the Baule to the southern, forested part of the country in search of land more productive for coffee and cocoa planting. Baule art is considered a separate and distinct style, although specific categories of Baule art are historically and stylistically close to the art forms of their neighbors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baule"@en .

aat:300016011 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yohure"@en .

aat:300016012 a skos:Concept ;
    skos:definition "Culture and style of the Fante peoples, who speak Fante dialects, located in Central and Western regions of Ghana and other regions in middle and southern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fante"@en .

aat:300016014 a skos:Concept ;
    skos:definition "Cultures that speak the Ewe language and members of the Ewe culture, primarily located in Ghana and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ewe cultures"@en .

aat:300016015 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adangme"@en .

aat:300016026 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northern Togo and Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lamba"@en .

aat:300016029 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shai"@en .

aat:300016030 a skos:Concept ;
    skos:definition "Styles belonging to Southern Nigerian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern Nigerian styles"@en .

aat:300016032 a skos:Concept ;
    skos:definition "Architectural styles belonging to Yoruba cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yoruba architectural styles"@en .

aat:300016034 a skos:Concept ;
    skos:definition "Fine arts styles belonging to Yoruba cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yoruba fine arts styles"@en .

aat:300016040 a skos:Concept ;
    skos:definition "Sytle and culture of the westernmost of the seven historical Yoruba kingdoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ketu"@en .

aat:300016045 a skos:Concept ;
    skos:definition "Cultures that speak the Edo language, primarily located in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edo-speaking cultures"@en .

aat:300016047 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southwestern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ishan"@en .

aat:300016060 a skos:Concept ;
    skos:definition "Refers to a style region found in cultures in Igbo-speaking regions of southeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Igbo region"@en .

aat:300016071 a skos:Concept ;
    skos:definition "Refers to a style region in southeastern Nigeria and southwestern Cameroon, centered on the Lower and Upper Cross River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cross River"@en .

aat:300016077 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Cross River region of Cameroon and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boki"@en .

aat:300016088 a skos:Concept ;
    skos:definition "Styles belonging to Northeastern Nigerian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northeastern Nigerian styles"@en .

aat:300016089 a skos:Concept ;
    skos:definition "Styles belonging to Niger-Congo language groups cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Niger-Congo language groups styles"@en .

aat:300016090 a skos:Concept ;
    skos:definition "Styles and cultures belonging to the Benue River region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Benue-Congo"@en .

aat:300016091 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afo"@en .

aat:300016111 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting mainly northern Nigeria with some population in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kutep"@en .

aat:300016113 a skos:Concept ;
    skos:definition "Styles belonging to Adamawa-Eastern branch cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adamawa-Eastern branch styles"@en .

aat:300016117 a skos:Concept ;
    skos:definition "Groups in the Chad subfamily of Afroasiatic languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chad subfamily Afroasiatic language groups"@en .

aat:300016121 a skos:Concept ;
    skos:definition "Describes the works produced by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Goemai"@en .

aat:300016129 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the Cameroon Grassfields, relatives of the Babanki-Tungo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Babanki"@en .

aat:300016131 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bafut"@en .

aat:300016134 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kom"@en .

aat:300016136 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bali"@en .

aat:300016150 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bangwa"@en .

aat:300016154 a skos:Concept ;
    skos:definition "Styles belonging to southern coastal Cameroon cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southern coastal Cameroon styles"@en .

aat:300016157 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bafia"@en .

aat:300016163 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kpe"@en .

aat:300016168 a skos:Concept ;
    skos:definition "Styles and cultures from a wide region of Africa that straddles the Equator and is drained largely by the Congo River system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central African"@en .

aat:300016170 a skos:Concept ;
    skos:definition "Styles belonging to Upper Sangha River area cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upper Sangha River area styles"@en .

aat:300016172 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Gabon and Congo Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwele"@en .

aat:300016183 a skos:Concept ;
    skos:definition "Styles belonging to Kota-Mbete region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kota-Mbete region styles"@en .

aat:300016205 a skos:Concept ;
    skos:definition "Styles belonging to Ogowe River area cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ogowe River area styles"@en .

aat:300016210 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Gabon and the Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lumbo"@en .

aat:300016220 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Gabon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Massango"@en .

aat:300016229 a skos:Concept ;
    skos:definition "Style and culture of the group of more or less closely related Bantu-speaking peoples occupying the adjoining areas of Zaïre, Angola (including the enclave of Cabinda) and the Republic of the Congo. The Kongo area stretches from both sides of the mouth of the Zaïre River on the Atlantic coast, north to Pool Malebo (formerly Stanleypool) and south into Angola. The main peoples of the group include the Kakongo, Vili, Yombe, Nkanu, Woyo and Boma. Especially famous for their power figures (often referred to as ‘fetishes’), the Kongo peoples have produced a wide range of arts, including stone and ceramic funerary sculptures, masks, regalia in wood, metal and ivory, and figurative pot-lids. Examples of Kongo art are held by most museums with African collections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kongo"@en .

aat:300016236 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solongo"@en .

aat:300016242 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Cabinda province in Angola, Kinshasa region in Democratic Republic of Congo, and Brazzaville commune in Congo Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Woyo"@en .

aat:300016248 a skos:Concept ;
    skos:definition "Ethnicity, styles, or cultures of the Kwango-Kwilu region of Central Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwango-Kwilu"@en .

aat:300016266 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of Congo, on the land between the Wamba and Bakali Rivers in the northwest, and the Kwilu and Lutshima Rivers in the east."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbala"@en .

aat:300016268 a skos:Concept ;
    skos:definition "Refers to works created by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pende"@en .

aat:300016274 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in independent groups in the Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsaayi"@en .

aat:300016281 a skos:Concept ;
    skos:definition "The style, culture, and ethnicity of a people of Angola who comprise two subsets with different origins, but related languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chokwe-Lunda"@en .

aat:300016282 a skos:Concept ;
    skos:definition "Refers to the culture of the Bantu-speaking people inhabiting the southern Congo and northeastern Angola. They comprise many aboriginal peoples and conquering groups of Lunda origin, and they speak a language of the Benue-Congo branch of the Niger-Congo languages. They are hunters or agriculturalists, depending upon which region they inhabit. They live primarily in woodland savanna and strips of rainforest along rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chokwe"@en .

aat:300016297 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lunda"@en .

aat:300016303 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting northern Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbundu"@en .

aat:300016309 a skos:Concept ;
    skos:definition "Styles belonging to Central Democratic Republic of Congo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Democratic Republic of Congo styles"@en .

aat:300016310 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the central Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuba"@en .

aat:300016322 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting the Democratic Republic of the Congo at the confluence of the Lulua and Kasai Rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Biombo"@en .

aat:300016323 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo near the confluence of the Sankuru and Kasai Rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lele"@en .

aat:300016325 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Democratic Republic of Congo. The Northern Kete are geographically and culturally distinct from the Southern Kete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Kete"@en .

aat:300016328 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of Congo, where the Kasai River marks the border between Angola and the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lwalu"@en .

aat:300016331 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo north of the Lukenie river."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndengese"@en .

aat:300016347 a skos:Concept ;
    skos:definition "Styles belonging to Luba region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luba region styles"@en .

aat:300016351 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in southeastern Democratic Republic of Congo near the Luba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kanyok"@en .

aat:300016356 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luba"@en .

aat:300016367 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Luba region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nsapo"@en .

aat:300016371 a skos:Concept ;
    skos:definition "Styles belonging to Northern Democratic Republic of Congo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Democratic Republic of Congo styles"@en .

aat:300016372 a skos:Concept ;
    skos:definition "Styles belonging to Northwest Democratic Republic of Congo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northwest Democratic Republic of Congo styles"@en .

aat:300016395 a skos:Concept ;
    skos:definition "Styles belonging to Northeast Democratic Republic of Congo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northeast Democratic Republic of Congo styles"@en .

aat:300016396 a skos:Concept ;
    skos:definition "Ethnicity, culture, and styles of the Maniema region, Central Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maniema"@en .

aat:300016408 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Maniema region of eastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lengola"@en .

aat:300016414 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, a subgroup of the Mongo living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yela"@en .

aat:300016416 a skos:Concept ;
    skos:definition "Styles and cultures of the Zande-Mangbetu region, Central Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zande-Mangbetu"@en .

aat:300016430 a skos:Concept ;
    skos:definition "The collective style and culture of various African peoples whose adult males grow to less than 59 inches (150 cm) in average height, and who live in Cameroon, Equatorial Guinea, Gabon, Democratic Republic of Congo, Congo Republic, Central African Republic, Rwanda, and Burundi. Use of \"Pygmy\" for a culture is considered pejorative; where possible use instead the most specific name for the subgroup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pygmy"@en .

aat:300016434 a skos:Concept ;
    skos:definition "Styles and cultures of the eastern area of Africa, traditionally divided into two parts: East Africa (Kenya, Tanzania, and Uganda) and the Horn of Africa (Somalia, Djibouti, Eritrea, and Ethiopia)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern African"@en .

aat:300016435 a skos:Concept ;
    skos:definition "Styles belonging to Ethiopian ethnic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ethiopian ethnic styles"@en .

aat:300016443 a skos:Concept ;
    skos:definition "Style and culture of the Afar ethnic group, who speak the Afar Cushitic Afro-Asiatic language and live in the Horn of Africa, primarily the Afar region of Ethiopia, northern Djibouti, and southern Eritrea"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afar"@en .

aat:300016445 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bari"@en .

aat:300016459 a skos:Concept ;
    skos:definition "Culture and styles of a Hamitic people, adherents of Islam, living in the Horn of Africa; for the nationality of the nation of Somalia, use \"Somalian.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Somali"@en .

aat:300016462 a skos:Concept ;
    skos:definition "The style and culture of an East African tribe living between Lake Rudolph and the Nile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkana"@en .

aat:300016463 a skos:Concept ;
    skos:definition "Styles and cultures belonging to Upper Great Lakes Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upper Great Lakes African"@en .

aat:300016464 a skos:Concept ;
    skos:definition "The style and culture of a farming and pastoral people of northern Uganda and southern Sudan who speak a Nilotic language of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acholi"@en .

aat:300016465 a skos:Concept ;
    skos:definition "Style and culture of an East African tribe of this name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dumbo"@en .

aat:300016467 a skos:Concept ;
    skos:definition "Style and culture of a Ganda (Luganda)-speaking people inhabiting the region of Buganda on the northwest shore of Lake Victoria, now part of Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ganda"@en .

aat:300016469 a skos:Concept ;
    skos:definition "Style and culture of a Bantu-speaking people, traditionally cultivators of coffee, bananas, millet, and corn, who occupy the western slopes Mount Elgon, an extinct volcano on the Kenya-Uganda boundary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gisu"@en .

aat:300016471 a skos:Concept ;
    skos:definition "Style and culture of an East African people who speak a Bantu language, also called Haya, inhabiting the northwestern corner of Tanzania between the Kagera River and Lake Victoria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haya"@en .

aat:300016489 a skos:Concept ;
    skos:definition "Styles and cultures belonging to Coastal East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coastal East African"@en .

aat:300016499 a skos:Concept ;
    skos:definition "Nationality, style, or culture of the Zaramo people, also referred to as Dzalamo or Saramo, are an East African ethnic group found along the coast of Tanzania, particularly in its Pwani Region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zaramo"@en .

aat:300016505 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living on the slopes of Mount Kilimanjaro in northeast Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chagga"@en .

aat:300016508 a skos:Concept ;
    skos:definition "Style and culture of the Kamba Bantu ethnic group of the Eastern Province of Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamba"@en .

aat:300016519 a skos:Concept ;
    skos:definition "Styles belonging to Central Tanzanian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Tanzanian styles"@en .

aat:300016538 a skos:Concept ;
    skos:definition "Styles and cultures originating in the southernmost region of the African continent, comprising the modern countries of Angola, Botswana, Lesotho, Malawi, Mozambique, Namibia, South Africa, Swaziland, Zambia, and Zimbabwe. The island nation of Madagascar is excluded because of its distinct language and cultural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern African"@en .

aat:300016544 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name currently inhabiting South Africa and Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsonga"@en .

aat:300016560 a skos:Concept ;
    skos:definition "Styles belonging to Sotho cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sotho styles"@en .

aat:300016563 a skos:Concept ;
    skos:definition "Style and culture of the Sotho ethnic group, located primarily in Lesotho. They were originally united by a common loyalty to the royal house of Moshoeshoe I, who founded the Sotho nation in the 19th century. For the cultures of the African people living in southern Africa who speak or who are descendants of those who traditionally spoke the Sesotho or Southern Sotho language, use the more specific \"Southern Sotho.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sotho"@en .

aat:300016566 a skos:Concept ;
    skos:definition "The style and culture of a Bantu people who live chiefly in Botswana and western South Africa, and who speak or are descendants of those who traditionally spoke the Tswana language (formerly considered a dialect of the Sotho language). The Tswana states of the Ngwaketse, Kwena, Ngwato, and Tawana were reconstituted in the 1840s after the wars ended. To refer in general to the style and culture of the inhabitants of the modern nation of Botswana, use \"Botswana (national).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tswana"@en .

aat:300016570 a skos:Concept ;
    skos:definition "Style and culture of an African ethnic group inhabiting the dry grassland country of northern Namibia and southern Angola. They are usually called Ovambo in Namibia and Ambo in Angola and speak Kwanyama, a Bantu language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ambo"@en .

aat:300016574 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Namibia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dama"@en .

aat:300016575 a skos:Concept ;
    skos:definition "Refers to the people and culture of southern Africa whom the first European explorers found in areas of the hinterland and who now live either in European settlements or on official reserves in South Africa or Namibia. Most Khoikhoi are either Nama or Oorlams, the latter term denoting remnants of the \"Cape Hottentots\" together with many of hybrid descent. The main Nama concentrations are the Bondelswarts, Rooinasie, Swartboois, and Topnaars; the main Orlams groups are the Witbooi, Amraal, Berseba, and Bethanie. The Khoikhoi are not easily distinguishable physically from the San, the Khoikhoi's slightly taller stature and decidedly longer and narrower head being the only marked differences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khoekhoe"@en .

aat:300016586 a skos:Concept ;
    skos:definition "Styles and cultures of the African peoples living in Morocco, Algeria, Tunisia, Libya, and Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North African"@en .

aat:300016589 a skos:Concept ;
    skos:definition "Culture of the region of Cyrenaica, along the eastern coastal region of modern Libya, whether in ancient or modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyrenaican"@en .

aat:300016593 a skos:Concept ;
    skos:definition "Refers to various peoples living across several countries in Northern Africa. It dates back to antiquity and appears in Arabic manuscripts by 900 AD. Some consider the term to be a European invention related to the term ‘barbarian’. While the term is still used by many people who self-identify as Berber, it is rapidly falling out of favour and more and more people now refer to themselves as ‘Amazigh.’"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berber"@en .

aat:300016594 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a subgroup of the Berber living in Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kabyle"@en .

aat:300016595 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name, living in the Sahara and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuareg"@en .

aat:300016598 a skos:Concept ;
    skos:definition "Style of African sculpture, typically elongated, severe, and abstract-looking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pole Style"@en .

aat:300016600 a skos:Concept ;
    skos:definition "Style of African sculpture, characteristically naturalistic, gentle, and organic, featuring rounded shapes, and giving the impression of flesh over the bone structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Round Style"@en .

aat:300016617 a skos:Concept ;
    skos:definition "Refers to a style region encompassing North and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Americas, The"@en .

aat:300016619 a skos:Concept ;
    skos:definition "Refers to the aboriginal Native American cultures that developed in North, South and Central America before the arrival of Europeans beginning in the late 15th century CE. The term is sometimes used more narrowly to only refer to early cultures from Mexico and Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian"@en .

aat:300016629 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian North American periods"@en .

aat:300016636 a skos:Concept ;
    skos:definition "Periods, styles, and cultures related to Western North American Paleo-Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western North American Paleo-Indian"@en .

aat:300016652 a skos:Concept ;
    skos:definition "Periods, styles, and cultures related to Eastern North American Paleo-Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern North American Paleo-Indian"@en .

aat:300016660 a skos:Concept ;
    skos:definition "Culture in North America from around 8000 BCE to 2000 BCE, ending with the adoption of sedentary farming, which varies from place to place in the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaic"@en .

aat:300016669 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Eastern North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Eastern North American periods"@en .

aat:300016670 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Midwestern Woodland cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Midwestern Woodland periods"@en .

aat:300016671 a skos:Concept ;
    skos:definition "General term for the cultures and styles represented in prehistoric sites falling in time between approximately 1000 BCE and 1000 CE, between the Archaic hunter-gatherers and the agriculturalist Mississippian cultures; including geographic regions from what is now eastern Canada south of the Subarctic region, the eastern United States, and along to the Gulf of Mexico. Characterized by agriculture, hunting, burial mounds, and a distinctive style of pottery. Over most of this area these cultures were replaced by the Mississippian culture in the 1st millennium CE, but in some regions they survived until historic times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Woodland Tradition"@en .

aat:300016677 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Southeastern Woodland cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Southeastern Woodland periods"@en .

aat:300016684 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Western North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Western North American periods"@en .

aat:300016685 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Californian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Californian periods"@en .

aat:300016693 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Plains North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Plains North American periods"@en .

aat:300016697 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Plateau North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Plateau North American periods"@en .

aat:300016727 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian North American styles"@en .

aat:300016731 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Eastern Eskimo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Eastern Eskimo styles"@en .

aat:300016736 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Western Eskimo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Western Eskimo styles"@en .

aat:300016737 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Choris area cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Choris area styles"@en .

aat:300016744 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Maritime area cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Maritime area styles"@en .

aat:300016757 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Aleutian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Aleutian styles"@en .

aat:300016760 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Alutiiq people, an indigenous people of Kodiak Island and surrounding areas. The Alutiiq are sometimes called called 'Aleut'; however, although related, this is distinguished from the general term 'Aleut,' which can be used to refer to a broader group of indigenous people whose territory is the Aleutian Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alutiiq"@en .

aat:300016773 a skos:Concept ;
    skos:definition "Refers to North American Indians culture of a language group that encompasses many linguistic sub-groups and cultural groups. It is an arbitrary term derived from Lake Athabaska by Albert Gallatin in 1836 to refer to a culture that he believed were centered around this area. People belonging to the Athapaskan language group occupy vast areas of the subarctic region as well as areas in New Mexico and Arizona. Spelling of the term varies widely, and often appears in multiple forms in a single source. 'Athapaskan' has been in general use since 1930. 'Dene' or 'Na-Dené' is the self-determined descriptive term used by this group, and is sometimes used synonymously with Athapaska, though is also used to describe a larger category that includes Tlingit and Haida language groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Athapaskan"@en .

aat:300016774 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Eastern North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Eastern North American styles"@en .

aat:300016775 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Great Lakes cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Great Lakes styles"@en .

aat:300016788 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Middle Atlantic North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Middle Atlantic North American styles"@en .

aat:300016794 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Mississippi Valley cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Mississippi Valley styles"@en .

aat:300016795 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Central Mississippi Valley cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Central Mississippi Valley styles"@en .

aat:300016803 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Lower Mississippi Valley cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Lower Mississippi Valley styles"@en .

aat:300016804 a skos:Concept ;
    skos:definition "Refers to the culture of the confederacy of tribes of North American Indians that composed the Caddoan linguistic family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caddo"@en .

aat:300016811 a skos:Concept ;
    skos:definition "Refers to a Native American culture and style evident in North America from around 800 CE to the mid-18th century, when its last representatives, the Natchez, declined and were dispersed. It was prevalent in the southeast and mid-continent in the river valleys of what are now the states of Mississippi, Alabama, Georgia, Arkansas, Missouri, Kentucky, Illinois, Indiana, Ohio, and parts of Wisconsin, Minnesota and the Great Plains. The culture was based on agricultural development of the bottomlands and government by theocratic village-states. Village architecture is characterized by dwellings arranged around oval or pyramidal earth mounds and a central ceremonial plaza. The style of decorated utilitarian and ceremonial objects is characterized by work in copper, shell, stone, clay, and feathers, often with elaborate designs including human figures, animal motifs, and geometric shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mississippian"@en .

aat:300016818 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Northeastern North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Northeastern North American styles"@en .

aat:300016832 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Ohio Valley cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Ohio Valley styles"@en .

aat:300016849 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Ozark Plateau cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Ozark Plateau styles"@en .

aat:300016854 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Southeastern North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Southeastern North American styles"@en .

aat:300016874 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Upper Mississippi Valley cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Upper Mississippi Valley styles"@en .

aat:300016888 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Western North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Western North American styles"@en .

aat:300016889 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Californian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Californian styles"@en .

aat:300016895 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Great Basin cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Great Basin styles"@en .

aat:300016902 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Northwest Coast North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Northwest Coast North American styles"@en .

aat:300016903 a skos:Concept ;
    skos:definition "Refers to the culture of Salish-speaking Indians of the Northwest Pacific Coast of North America, living around the Strait of Georgia, Puget Sound, southern Vancouver Island, much of the Olympic Peninsula, and most of western Washington state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coast Salish"@en .

aat:300016910 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Plains North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Plains North American styles"@en .

aat:300016917 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Plateau North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Plateau North American styles"@en .

aat:300016920 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Southwestern North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Southwestern North American styles"@en .

aat:300016923 a skos:Concept ;
    skos:definition "Refers to an ancient North American Indian style and culture that existed from around 7,000 BCE to around the beginning of the Current Era. It was found in the area of modern Arizona and New Mexico, and is named for artifacts found near the ancient Lake Cochise, which is now a dry desert basin. It is characterized by adaptations made for life in the desert, contrasting with contemporary cultures that subsisted largely by big-game hunting. It is generally considered to have strongly influenced subsequent cultural development in the Southwest United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cochise"@en .

aat:300016924 a skos:Concept ;
    skos:definition "Refers to the earliest phase of Cochise culture, dating from around 7,000 BCE to around 4,000 BCE. It is characterized by the creation of various scrapers and milling stones for grinding wild seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sulphur Spring Cochise"@en .

aat:300016925 a skos:Concept ;
    skos:definition "Refers to the second of three phases in the development of Cochise culture, dating from around 4,000 BCE to around 500 BCE. It is characterized by the creation of projectile points, presumably for hunting, and probably also by the development of farming, suggested by the remains of a primitive form of maize."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiricahua Cochise"@en .

aat:300016926 a skos:Concept ;
    skos:definition "Refers to the third and final phase of Cochise culture, dating from around 500 BCE to the beginning of the Current Era. It is characterized by the development of mortars and pestles, which replaced earlier grinding stones, by distinctive pit houses, which were made of poles and earth built over pits, and by the creation of pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "San Pedro Cochise"@en .

aat:300016928 a skos:Concept ;
    skos:definition "Refers to an early culture and style that existed mainly in the Sonoran Desert of what is now central and southern Arizona. The culture is noted for the first use of irrigation by the southwestern farmers, for the establishment of permanent settlements of pit houses and above-ground apartment-like structures, and for distinctive tools and art works, including ornaments and mosaics fashioned of shells imported from the Gulf of California, clay figurines, and pottery, which is gray ware or buff with decoration in iron red. Some experts believe that the Hohokam arrived in the area around 300 BCE, while others place their arrival around 500 CE. Disagreement also exists regarding their origins, which may be either from Mexico or as descendents of the Cochise people. Further disagreement exists regarding whether their descendants are Papago, Pima, and other Southwestern groups, or if the Hohokam moved out of the area in the fifteenth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hohokam"@en .

aat:300016929 a skos:Concept ;
    skos:definition "Refers to a culture and style that existed in the mainly mountainous areas of what is now southeastern Arizona and southwestern New Mexico, including the Mogollon Mountains, for which the culture is named. It probably developed from the earlier Cochise culture, and it flourished from around 200 BCE until around 1200. It was a hunting and gathering culture, with some cultivation of crops. It is particularly known for the first production of pottery in the Southwest, the technology for which may have been imported from Mexico. Pottery styles include several distinct phases, starting with a plain brown ware, a later polished red ware, then red-on-brown ware, red-on-white ware, and finally the famous black-on-white ware, which was probably inspired by the Ancestral Puebloan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mogollon"@en .

aat:300016934 a skos:Concept ;
    skos:definition "Styles of pottery belonging to Pine Lawn Mogollon cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pine Lawn Mogollon pottery styles"@en .

aat:300016943 a skos:Concept ;
    skos:definition "Refers to a culture and style that was a branch of the classic Mogollon culture and existed along the Mimbres River in the Gila Mountains in what is now southwestern New Mexico, and on nearby stretches of the Mimbres River and the Rio Grande. They flourished from around 1000 CE to around 1150 CE, hunting, using irrigation for agriculture, and living in compact pueblo-like villages of adobe and masonry. They were probably eventually absorbed by the Pueblo peoples to the north or migrated to Mexico. They are noted for distinctive pottery, which was decorated with imaginative black-on-white designs of insects, animals, birds, and geometric lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mimbres"@en .

aat:300016944 a skos:Concept ;
    skos:definition "Styles of pottery belonging to Mimbres culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mimbres pottery styles"@en .

aat:300016952 a skos:Concept ;
    skos:definition "Styles of pottery belonging to Pre-Columbian Pueblo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Pueblo styles"@en .

aat:300016954 a skos:Concept ;
    skos:definition "Refers to the style and culture of a North American civilization that existed in the \"Four Corners\" area, where the boundaries of the states of Arizona, New Mexico, Colorado, and Utah intersect. The culture flourished from the first century CE to around 1300 CE, and descendants of this cultural group probably include the modern Pueblo Indians now living in New Mexico and Arizona. The style is noted for fine baskets, pottery, cloth, ornaments, tools, and great architectural achievements, including cliff dwellings and apartment-house-like villages, or pueblos. In some classification schemes, the modern Pueblo cultures are considered later phases of this people, though most schemes end this culture with the abandonment of the cliff dwellings around 1300 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancestral Puebloan"@en .

aat:300016956 a skos:Concept ;
    skos:definition "Refers to an ancient North American culture and style that existed in the area of the current southwest United States from before 1000 BCE to around 750 CE, overlapping with the Ancestral Puebloan culture. It is distinct from earlier cultures in the area by the introduction of basket-weaving technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basketmaker"@en .

aat:300016959 a skos:Concept ;
    skos:definition "Designates the styles of the Pre-Columbian region comprising present-day central and central-southern Mexico, the Yucatán Peninsula, Guatemala, Belize and El Salvador, and parts of Honduras, Nicaragua and Costa Rica. Culturally, it refers to a set of technological, social, economic, religious and political traits shared by several different cultures, including the Aztec, Huastec, Maya, Mixtec, Olmec, Tarascan, Teotihuacßsn, Toltec, Totonac, West Mexican and Zapotec."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesoamerican"@en .

aat:300016964 a skos:Concept ;
    skos:definition "Periods related to Mesoamerican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesoamerican periods"@en .

aat:300016965 a skos:Concept ;
    skos:definition "Refers to a broad period and culture in Mesoamerica that existed approximately 40,000 BCE to 15,000 BCE. The period is usually subdivided into two chronological subperiods. The first period, from around 30,000 BCE to 15,000 BCE, involves archeological and paleontological sites in Nicaragua and in Mexico such as El Cedral and Valsequillo. The following period, from around 15,000 BCE to 9000 BCE, revolves around the emergence of hunter-gatherer cultures and is rich in rock paintings depicting negative or positive hands, geometric motifs, and man and animal silhouettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paleo-Indian"@en .

aat:300016967 a skos:Concept ;
    skos:definition "Refers generally to the period in Mesoamerica from about 2000 BCE to 250 CE characterized by major achievements in iconography and architecture by many distinct societies. It often refers specifically to early prehistoric Mesoamerican Olmec culture featuring monumental and intricate art in stone, jewels, and feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Preclassic"@en .

aat:300016970 a skos:Concept ;
    skos:definition "Refers generally to the period from approximately 2000 BCE to 1000 BCE in ancient Olmec and Maya cultures in Mesoamerica. In pottery and ceramics, the period features ground stone vessels, ranging from roughly made manos and metates (rubbing and grinding stones) to delicately styled flat-bottomed bowls, small pyrite and ilmenite mirrors, and small drilled blocks. The lapidary styles include beads, pendants, ear ornaments, clam shell-shaped objects, petaloid celts and celt-shaped tablets. Jewelry primarily featured pure bluish or translucent jadeite with dark emerald tinges. In architecture, the period is associated with simple huts that served domestic, communal, or religious purposes; however, simple pyramidal structures begin to develop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Preclassic"@en .

aat:300016973 a skos:Concept ;
    skos:definition "Refers to the period in Mesoamerica from around 1000 BCE to 300 BCE characterized by burgeoning politico-religious structures and nuclei that extended into the Zapotec civilization in the Valley of Oaxaca, Southern Highlands. Sculptural styles of the period feature ceremonial and monumental stone sculpture such as large stone heads, altars, stelae, and other full round and bas-relief forms. The juxtaposition of the human figure with animal features such as jaguar mouths and nostrils appears extensively in sculpture and painting. The lapidary styles of the period feature varied jade figurines and other small, intricate objects. Pyramidal architecture demonstrates more complex and varied forms such as the pyramidal fluted cone structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Preclassic"@en .

aat:300016976 a skos:Concept ;
    skos:definition "Refers to the period in Mesoamerica from around 300 BCE to 250 CE. Featherwork in Mesoamerica originated in this period as symbols of power and class and featured elaborate ceremonial head dresses comprised of quetzal tail feathers. Sculptural pieces of the period include pottery and effigy vessels, zoomorphic and anthropomorphic burial figures, fluted vases with distinctive parallel red lines drawn over orange slip, and bowls painted with serpentine forms on exterior rim bands. The style of architecture in the period evolved to palatial scales, featuring solid, flat or vaulted roof coverings, elaborate stairways bordered by flat ramps at each side, moldings, tableros, and masks. Pyramidal structures in the period display complex terraced, circular, and conic sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Preclassic"@en .

aat:300016983 a skos:Concept ;
    skos:definition "A period in Mesoamerica, from around 250 BCE to 900 CE, marked by widespread development of numerous cities and ceremonial centers, and by the rise of large-scale states in three regions: the Basin of Mexico in the Central Highlands, the Valley of Oaxaca in the Southern Highlands and the Maya lowlands. Each region developed unique patterns and styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Classic"@en .

aat:300016984 a skos:Concept ;
    skos:definition "Refers to the period of art in Mesoamerica from approximately 250 BCE to 600 CE characterized in ceramics by high-relief figures adorning cylindrical jars and the use of chapopote (black asphalt) to paint the faces and bodies of tan or brown clay figures. Lapidary art of the period witnessed a movement away from celts to refined figurines with inlaid eyes and teeth. Hardstones predominate with tecali often used for larger carvings. Decorative pieces of the period include large ear flares and bead necklaces. In architecture, the period features complex altar structures, stelae carved to represent a standing ruler and decorated with inscriptions and Long Count dates, carved stucco roof-combs, carved wooden lintels, and decorated shrines on the tops of pyramids. Painting styles of the period feature murals of red and black lines on white stucco and hieroglyphs framed by figures or signs of deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Classic"@en .

aat:300016986 a skos:Concept ;
    skos:definition "Refers to the period of art in Mesoamerica from around 600 CE to 900 CE. Sculptural styles of the period varied according to region. In Tierra Blanca, pottery and ceramic bowls featured mold-made ritual scenes in high relief. Figures from Nopiloa are commonly mold-made but coated with a cream-colored slip. In most regions, pottery and clay sculpture prominently feature standing and seated female figures with ornate headdresses, beaded necklaces, and knotted snake belts and include cream-slipped bowls finely painted with realistic and imaginary animals and costumed figures organized in pairs or trios. Lapidary art of the period features three forms associated with a sacred ball-game: the yuog, palma, and hacha. In architecture, the style exhibits stelae and altar structures that feature large, zoomorphic frontal figures in high relief, decorated with dense costume designs. Painting styles of the period represent humans in urban contexts among pyramids, thrones, staircases, and market places and feature rich colors as symbols. Murals of the period depict expressive historical, military, and ritual scenes and decorate temples and vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Classic"@en .

aat:300016987 a skos:Concept ;
    skos:definition "Encompasses the period in Mesoamerica from around CE 900 to CE 1521 characterized by the political unification of Mesoamerica, through the promotion of the Toltec state and later the Aztec empire, and the decline of the large Maya states of the Early Postclassic period. The period is subdivided into two subperiods: Early Postclassic and Late Postclassic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Postclassic"@en .

aat:300016989 a skos:Concept ;
    skos:definition "Refers to the Mesoamerican period from around CE 900 to CE 1200 most associated with the reintroduction of sculpture in the round as a dominant form, featuring large deity idols and pictorial motifs such as the sun disk with triangular rays, and with the decline of carved inscriptions. Pottery in the period predominantly features braziers, long-handled censers, tobacco pipes, Coyotlatelco potteryware with stylized red designs on cream backgrounds, and Mazapán potteryware with parallel straight or wavy red lines. It is also typified by the metallic gray glaze known as Plumbate. Ceramic figurines in the period are mold-made and painted after firing and feature female images, male warriors, and deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Postclassic"@en .

aat:300017001 a skos:Concept ;
    skos:definition "Periods related to Central Plateau Mesoamerican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Plateau Mesoamerican periods"@en .

aat:300017030 a skos:Concept ;
    skos:definition "Styles belonging to Central Plateau Mesoamerican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Plateau Mesoamerican styles"@en .

aat:300017033 a skos:Concept ;
    skos:definition "The style and culture of the Nahuatl-speaking peoples of the Aztec Empire or Triple Alliance, of late Pre-Columbian central Mexico; flourished ca.1400-1520 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aztec"@en .

aat:300017051 a skos:Concept ;
    skos:definition "Early prehistoric Mesoamerican culture known from archaeological excavations in the Gulf Coast of Mexico and from various artefacts and an art style distinguished by certain motifs. The Olmec coincided with the transition in Mesoamerican culture from simple agricultural villages to complex proto-state societies in several regions during the Early Pre-Classic (ca. 2000-ca. 1000 BCE) and Middle Pre-Classic (ca. 1000-ca. 300 BCE) periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Olmec"@en .

aat:300017056 a skos:Concept ;
    skos:definition "Classic Veracruz style and culture shows influences from Teotihuacan and the Maya, but neither of these cultures are its direct antecedents"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Classic Veracruz"@en .

aat:300017081 a skos:Concept ;
    skos:definition "Styles of architecture belonging to the Maya area culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maya area architecture styles"@en .

aat:300017099 a skos:Concept ;
    skos:definition "Periods related to Lowland Maya area cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lowland Maya area periods"@en .

aat:300017120 a skos:Concept ;
    skos:definition "Periods related to Highland Maya area cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Highland Maya area periods"@en .

aat:300017141 a skos:Concept ;
    skos:definition "Periods related to Pacific Coast Maya cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pacific Coast Maya area periods"@en .

aat:300017149 a skos:Concept ;
    skos:definition "Style and culture of the Izapa Pre-Columbian Pacific Coast Maya culture in the Mexican state of Chiapas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Izapa"@en .

aat:300017160 a skos:Concept ;
    skos:definition "Styles of pottery belonging to the Maya area culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maya area pottery styles"@en .

aat:300017167 a skos:Concept ;
    skos:definition "Periods related to Oaxacan cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oaxacan periods"@en .

aat:300017178 a skos:Concept ;
    skos:definition "Styles belonging to Oaxacan culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oaxacan styles"@en .

aat:300017179 a skos:Concept ;
    skos:definition "The style and culture of the Zapotec indigenous pre-Columbian civilization that flourished in the Valley of Oaxaca in Mesoamerica; the culture dates back at least 500 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zapotec"@en .

aat:300017180 a skos:Concept ;
    skos:definition "Style and culture of the indigenous Mixtec Mesoamerican peoples, who inhabited the La Mixteca region comprising parts of the Mexican states of Oaxaca, Guerrero, and Puebla. Pre-Columbian Mixtec peoples were one of the major civilizations of Mesoamerica, having an ancient capital at Tilantongo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mixtec"@en .

aat:300017196 a skos:Concept ;
    skos:definition "Styles belonging to West Coast Mesocamerican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Coast Mesoamerican styles"@en .

aat:300017200 a skos:Concept ;
    skos:definition "Style and culture of the Mexican state of Jalisco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jalisco"@en .

aat:300017214 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Northern Central American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Northern Central American styles"@en .

aat:300017228 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Panamanian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Panamanian periods"@en .

aat:300017240 a skos:Concept ;
    skos:definition "The Pre-Columbian style and culture from the central region of what is now province of Veraguás in Panama. The area extends from the Pacific to the Caribbean coast and includes a number of islands. The climate here is mainly humid and tropical, and the landscape includes wooded areas and valleys suitable for agriculture, as well as high mountains, hilly areas, and coastal lowlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Veraguas"@en .

aat:300017241 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Panamanian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Panamanian styles"@en .

aat:300017246 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Caribbean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Caribbean styles"@en .

aat:300017260 a skos:Concept ;
    skos:definition "First of the periods in Andean prehistory dating from before the introduction of ceramic artifacts into the archaeological record, generally dating before 9500 BCE to 1800 BCE. Pre-Ceramic may be broken into six smaller periods, labeled I through VI."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Ceramic"@en .

aat:300017264 a skos:Concept ;
    skos:definition "The second of the seven main chronological phases recognized in Andean archaeology, generally dating 1800/1500 to 900 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Initial Period"@en .

aat:300017265 a skos:Concept ;
    skos:definition "Culture at Chiripa dating from 1500-1000 BCE, based on calibrated radiocarbon dates from 1992 and 1996 excavations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Chiripa"@en .

aat:300017267 a skos:Concept ;
    skos:definition "The third of the seven main chronological phases recognized in Andean archaeology, generally dating 900 BCE- 200 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Horizon"@en .

aat:300017270 a skos:Concept ;
    skos:definition "Culture that was centered in the current Peruvian province of Trujillo, having well-defined characteristics by 1500 to 200 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cupisnique"@en .

aat:300017274 a skos:Concept ;
    skos:definition "Chiripa style and period dating 800-100 BCE, marked by more elaborate common structures, domestic architecture, and more sophisticated gardening practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Chiripa"@en .

aat:300017280 a skos:Concept ;
    skos:definition "The fourth of the seven main chronological phases recognized in Andean archaeology, generally dating 200-600 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Intermediate Period"@en .

aat:300017283 a skos:Concept ;
    skos:definition "Andean style and culture of the central and northern highlands of the Middle Horizon (ca. 600-1000 CE); named after an archaeological site located in the central highland region of present-day Peru. The style is related to that of monuments at the great site of Tiwanaku, located on Lake Titicaca in northwestern Bolivia. Wari was probably the centre of a militaristic empire that dominated much of the Peruvian highlands and coast during the earlier part of the Middle Horizon. Its influences are seen especially in the Late Nazca (Ica) culture of the southern coast and at Pachacamac on the central coast. The most distinctive decorative motif on Huari pottery is the Doorway God, a stylized, anthropomorphic figure often represented in front view with a rectangular face and rayed headdress. This motif is also found at Tiwanaku. Wari architecture features large enclosures constructed of stone masonry. Monumental temple sculpture is naturalistic and depicts both male and female figures with elaborate hairstyles. \"Wari\" and \"Huari\" are often used interchangeably but usage of \"Wari\" has become more common in museum collections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huari"@en .

aat:300017287 a skos:Concept ;
    skos:definition "Style and culture that flourished in northern Peru ca. 100-800 CE, having a capital near present-day Moche and Trujillo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mochica"@en .

aat:300017290 a skos:Concept ;
    skos:definition "\"Nazca\" and \"Nasca\" are commonly used interchangeably, but generally prefer the use of Nazca to describe the region, town, and river; and Nasca to refer to the period and culture that inhabited this area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nazca"@en .

aat:300017300 a skos:Concept ;
    skos:definition "The fifth of the seven main chronological phases recognized in Andean archaeology, generally dating 600-1000 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Horizon"@en .

aat:300017302 a skos:Concept ;
    skos:definition "Style or culture associated with a large pre-Columbian ruin located in the Lurin Valley on the central coast of present-day Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pachacamac"@en .

aat:300017305 a skos:Concept ;
    skos:definition "Describes the culture of a Pre-Columbian people associated with an archaeological site in western Bolivia. It was the capital of an empire that flourished from CE 300 to CE 1000."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tiahuanaco"@en .

aat:300017313 a skos:Concept ;
    skos:definition "The sixth of the seven main chronological phases recognized in Andean archaeology, generally dating ca. 1000-1450 CE, following the collapse of Middle Horizon empires, including Tiahuanaco and Huari. During this time distinctive regional cultures emerged along the coast and in highland areas, including the Chimú empire. The political entities that developed during the late Intermediate Period were subsequently conquered by the Inca empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Intermediate Period"@en .

aat:300017316 a skos:Concept ;
    skos:definition "South American style or culture of the South American people who maintained the largest political system in Peru prior to the Inca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chimú"@en .

aat:300017326 a skos:Concept ;
    skos:definition "Pre-Columbian culture of the Central Andean area of South America; the early Inca people are recognizable in the archaeological record of the Late Intermediate Period (ca. 1000-1476 CE), from the 12th century onwards. The Inca established their capital at Cuzco (Peru) in the 12th century. They began their conquests in the early 15th century and within 100 years had gained control of an Andean population of about 12,000,000 people. The The Inca empire flourished in the 15th century and early 16th century. At the time of the Spanish conquest in 1532, the Inca ruled an empire that extended along the Pacific coast and Andean highlands from the northern border of modern Ecuador to the Maule River in central Chile. Inca ceramics are readily recognizable from their forms and decoration; bronze metal tools and weapons were widespread, and there was a distinctive Inca architecture at various locations throughout the empire. For the culture and artifacts dating to the empire during the period 1476-1534 CE, use \"Late Horizon.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Inca"@en .

aat:300017331 a skos:Concept ;
    skos:definition "Culture and style of the pre-Inca civilization of the Lambayeque region, also called Sican culture, which flourished ca. CE 750 to CE 1375."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lambayeque"@en .

aat:300017332 a skos:Concept ;
    skos:definition "The seventh of the seven main chronological phases recognized in Andean archaeology, generally dating 1476-1534 CE, during which the Inca established an empire controlled from Cuzco, which eventually reached from central Chile to southern Colombia. The period ends in 1534, the year marking the fall of the Inca empire after the Spanish conquest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Horizon"@en .

aat:300017370 a skos:Concept ;
    skos:definition "The Aguada culture developed in the border region between the Argentine provinces of Catamarca and La Rioja, between 600 and 900 CE; its influence is seen in northwestern Argentina and northern parts of Chile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aguada"@en .

aat:300017376 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Chilean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Chilean styles"@en .

aat:300017396 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Ecuadorian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Ecuadorian periods"@en .

aat:300017411 a skos:Concept ;
    skos:definition "Refers to the Pre-Columbian culture and style that flourished in the Guayas River basin of coastal Ecuador ca. 700-1500 CE. Noted for large chiefdoms in a lowland landscape, the use of sophisticated cultivation of the seasonally flooded river wetlands, and the construction of large elevated earthen platforms called \"tolas,\" which were used for both habitation and burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Milagro"@en .

aat:300017422 a skos:Concept ;
    skos:definition "Styles belonging to Pre-Columbian Columbian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Colombian styles"@en .

aat:300017437 a skos:Concept ;
    skos:definition "Whenever possible, use the specific tribal name. The collective term \"Native American\" is currently widely used in the United States for indigenous peoples. However, many groups increasingly prefer \"American Indian\" or \"Indigenous American.\" For the indigenous peoples of Canada use the term \"Indigenous peoples.\" which refers to the First Nations, Inuit and Métis. For the broader concept of the cultures of any native peoples of Central America, South America, North America, or the West Indies, use \"Indigenous people (culture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native American"@en .

aat:300017442 a skos:Concept ;
    skos:definition "Cultures and styles belonging to Indigenous North Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native North American"@en .

aat:300017444 a skos:Concept ;
    skos:definition "Styles belonging to Arctic Native American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arctic Native American styles"@en .

aat:300017447 a skos:Concept ;
    skos:definition "Refers to artwork produced by native Arctic culture, prior to European contact. For names of specific native peoples of the present, use descriptors such as \"Chugach,\" \"Inuit,\" or \"Katladlit.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eskimo"@en .

aat:300017455 a skos:Concept ;
    skos:definition "Group of culturally and linguistically unique Indigenous peoples of the Arctic and subarctic regions whose homelands encompass Kalaallit Nunaat (Greenland), Arctic Canada, northern and southwestern Alaska in the United States, and part of Chukotka in the Far East region of Russia. The culturally related Unangan (Aleuts) live in the Aleutian Islands. Canadian Inuit are not considered \"Native American\" or \"First Nations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Inuit"@en .

aat:300017458 a skos:Concept ;
    skos:definition "One of several groups of Inuit who live on the Arctic coast of Canada west of Hudson Bay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Netsilik Inuit"@en .

aat:300017461 a skos:Concept ;
    skos:definition "Styles belonging to Eastern Subarctic Native American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Subarctic Native American styles"@en .

aat:300017462 a skos:Concept ;
    skos:definition "Describes works produced by the Native Canadian people of the same name inhabiting northern Ontario and Quebec along the Ottawa River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Algonkin"@en .

aat:300017465 a skos:Concept ;
    skos:definition "Refers to the culture and style of the Cree, a major Algonquian-speaking First Nations tribe, whose domain included a large area from east of the Hudson and James bays to as far west as Alberta and the Great Slave Lake in what is now Canada. Originally inhabiting a smaller area, they expanded rapidly in the 17th and 18th centuries acquiring firearms through the fur trade, although wars with the Dakota Sioux and Blackfoot, and a severe smallpox epidemic, greatly reduced their numbers. The name Cree is a truncated form of Kristineaux, a French adaptation of the self-name of the James Bay band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cree"@en .

aat:300017468 a skos:Concept ;
    skos:definition "Indigenous American ethnic group from the Eastern Woodlands region of the northern United States and southern Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odawa"@en .

aat:300017471 a skos:Concept ;
    skos:definition "Styles belonging to Western Subarctic Native American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Subarctic Native American styles"@en .

aat:300017473 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Dane-zaa, an indigenous people from the Peace River area of the present-day British Columbia and Alberta provinces in Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dane-zaa"@en .

aat:300017476 a skos:Concept ;
    skos:definition "Refers to the culture of the Chipewyan, the most numerous Athabascan-speaking First Nations people in northern Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chipewyan"@en .

aat:300017491 a skos:Concept ;
    skos:definition "The culture and style of an Athabascan-speaking tribe of Canada's north country. The name \"Slave\" is the translation of a Cree term, since these traditional enemies sometimes raided and enslaved them. Another name for them \"Etchao-tine,\" is Chipewyan for \"people dwelling in the shelter, or by willows.\" The Slavey historically occupy territory west of the Great Slave Lake and Mackenzie River in Canada's present-day Northwest Territories, Alberta, and British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Slavey"@en .

aat:300017498 a skos:Concept ;
    skos:definition "Cultures and styles belonging to Indigenous California Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Californian Native American"@en .

aat:300017500 a skos:Concept ;
    skos:definition "Formerly included in the Shasta group of Native American peoples but now classified separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Achomawi"@en .

aat:300017506 a skos:Concept ;
    skos:definition "Style and culture of dialectally and culturally related North American Indian groups who spoke a language of Uto-Aztecan stock and lived in the lowlands, along the seacoast, and on islands in southern California at the time of Spanish colonization. Many experts believe they may be descended from the Shoshoni-speaking peoples from Nevada who moved into coastal Southern California ca. 1500 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gabrieliño"@en .

aat:300017509 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Karuk Tribe, an indigenous people of California, whose ancestral land is located around the Klamath River in Northern California. The Karuk is the second largest tribe in California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karuk"@en .

aat:300017510 a skos:Concept ;
    skos:definition "Style and culture of the Payómkawichum (also Luiseño), the indigenous people of California, whose ancestral land spans the coastal areas of what is now Los Angeles and San Diego counties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Payómkawichum"@en .

aat:300017512 a skos:Concept ;
    skos:definition "Refers to the culture of the Western Mono, a Native American group from central California who speak a language belonging to the Numic group of the Uto-Aztecan family and are related to Northern Paiute. The Western Mono inhabit the pine belt of the Sierra Nevada and have a culture similar to that of the nearby Yokuts. Historically the Eastern and Western Mono traded with one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Mono"@en .

aat:300017516 a skos:Concept ;
    skos:definition "Refers to the culture of the Shasta Native Americans. The Shasta have historically inhabited the highlands of interior northern California, in the basins of the Upper Klamath and the Scott and Shasta rivers. The main subdivisions are the Shasta, New River Shasta, Konomihu, and Okwanuchu. The Achomawi and Atsugewi were formerly included with the Shasta but are now usually classified separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shasta"@en .

aat:300017528 a skos:Concept ;
    skos:definition "Styles belonging to Baja Californian Native American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baja Californian Native American styles"@en .

aat:300017530 a skos:Concept ;
    skos:definition "Refers to the culture of the Kumeyaay (also known by their Spanish name, Diegueño), a group of Yuman-speaking Native Americans who historically inhabit large areas extending on both sides of what is now the United States-Mexican border in California and Baja California. They were named after the mission of San Diego; the Kumeyaay were one of the major groups of so-called Mission Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kumeyaay"@en .

aat:300017531 a skos:Concept ;
    skos:definition "Refers to the culture of the Kamia, a Yuman-speaking people who lived in southern California and northern Baja California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamia"@en .

aat:300017543 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Abenaki, an indigenous people whose traditional lands include areas in southern Québec, as well as areas in western Maine and northern New England, in separately recognized bands. The Abenaki united with other tribes in the 17th century to furnish mutual protection against the Iroquois Confederacy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abenaki"@en .

aat:300017544 a skos:Concept ;
    skos:definition "Describes works created by the Native American people of the same name formerly inhabiting parts of Pennsylvania and Maryland in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Conestoga"@en .

aat:300017545 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Lenape people and their three federally recognized tribes (the Delaware Tribe of Indians, the Delaware Nation, and the Stockbridge-Munsee Community of Wisconsin), whose ancestral lands are located from Cape Henlopen, Delaware, to eastern Long Island. While they are commonly known by their English-given name, \"Delaware,\" members of the tribe call themselves \"Lenape\" or \"Lenni Lenape.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lenape"@en .

aat:300017547 a skos:Concept ;
    skos:definition "Refers to the style and culture of North American Indian tribes speaking a language of the Iroquoian family, notably the Cayuga, Cherokee, Huron, Mohawk, Oneida, Onondaga, Seneca, and Tuscarora, in addition to the Iroquois proper. The name Iroquois is a French derivation of Irinakhoiw, meaning \"rattlesnakes.\" They call themselves Haudenosaunee, meaning \"people of the longhouse.\" The Iroquoian linguistic groups occupied a continuous territory around Lakes Ontario, Huron, and Erie, in present-day New York state and Pennsylvania and southern Ontario and Quebec."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iroquois"@en .

aat:300017550 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Mohawk, or Kanien'kehà:ka, an indigenous people of North America whose ancestral lands surrounded the Mohawk river in what is now upstate New York. Many relocated to Canada after the American Revolution, allying themselves with Great Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mohawk"@en .

aat:300017554 a skos:Concept ;
    skos:definition "General reference for the culture and styles of the Iroquois-speaking Native North American tribe called Tuscarora. Their name derives from an Iroquoian term for “hemp gatherers”; they were noted for their use of indigenous hemp for fiber and medicine. They coalesced as a people around the Great Lakes at about the time of the rise of the historic Iroquois tribes' five nations that was based in the area of present New York state. At the time of European settlement in the 16th century, the Tuscarora primarily occupied what is now North Carolina. Today, the Tuscarora are federally recognized and hold lands in New York state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuscarora"@en .

aat:300017555 a skos:Concept ;
    skos:definition "Culture and style of an Eastern Algonquian Native American tribe that inhabited in the Hudson River Valley and New England prior to the 17th century. Due to the American Revolutionary War, many Mahican migrated westward to join the Iroquois Oneida in central New York. Many Mahican descendants were later moved to Wisconsin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahican"@en .

aat:300017557 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Wolastoqiyik, also known as Maliseet or Malecite, a First Nations indigenous people belonging to the Wabanaki Confederacy, together with the Passamaquoddy, Penobscot, Mi'kmaq, and Abenaki Indians. The Wolastoqiyik mainly live in Canada, especially New Brunswick, with one group across the border in nearby Maine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wolastoqiyik"@en .

aat:300017558 a skos:Concept ;
    skos:definition "Style and culture of the Algonquian-speaking, Native American people who inhabited the seacoast from Niantic Bay to Connecticut River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Massachuset"@en .

aat:300017559 a skos:Concept ;
    skos:definition "Refers to the culture of the Mi'kmaq (formerly Micmac), an indigenous American people belonging to the Wabanaki Confederacy together with the Pasamaquoddy, Penobscot, Maliseet, and Abenaki Indians. The Mi'kmaq inhabit eastern Canada and Maine in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mi'kmaq"@en .

aat:300017564 a skos:Concept ;
    skos:definition "Indigenous belonging to Great Basin Indigenous Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Great Basin Native American"@en .

aat:300017566 a skos:Concept ;
    skos:definition "Style and culture of Southern Paiute Native Americans who occupy southeastern California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chemehuevi"@en .

aat:300017571 a skos:Concept ;
    skos:definition "Style and culture of North American Indians who historically inhabited east-central California, western Nevada, and eastern Oregon. After 1840 a rush of prospectors and farmers despoiled the arid environment's meager supply of food plants, after which the Northern Paiute acquired guns and horses and fought at intervals with the trespassers until 1874, when the last Paiute lands were appropriated by the U.S. government. Today, the Northern Paiute are organized as several different federally and state-recognized tribes across California, Oregon, and Nevada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Paiute"@en .

aat:300017578 a skos:Concept ;
    skos:definition "Style and culture of a North American Indian group who speak Ute, and who at one time occupied what are now southern Utah, northwestern Arizona, southern Nevada, and southeastern California, the latter group being known as the Chemehuevi. Although encroached upon and directed into reservations by the U.S. government in the 19th century, the Southern Paiute had comparatively little friction with settlers and the U.S. military; many found ways to stay on their traditional lands, usually by working on ranches or living on the fringes of the new towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern Paiute"@en .

aat:300017580 a skos:Concept ;
    skos:definition "Style and culture of the Native North American people of the Great Basin region who made their home around Lake Tahoe in what is now California and Nevada. The culture has existed for an estimated 9,000 years in the Lake Tahoe Basin and adjacent east and west slopes and valleys of the Sierra Nevada Mountain Range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Washoe"@en .

aat:300017582 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Meskwaki (also known by the European exonym \"Fox\"), indigenous people of Algonquian origin, historically located in the St. Lawrence River Valley, the Great Lakes Region, as well as the states of Iowa and Missouri."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Meskwaki"@en .

aat:300017583 a skos:Concept ;
    skos:definition "The style and culture of the Iroquoian-speaking peoples of North America who emerged as a tribe around the north shore of Lake Ontario; believed to have been the most populous confederacy of Iroquoian-culture indigenous peoples of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wyandotte"@en .

aat:300017586 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Menominee, an indigenous people whose native land is in the present-day state of Wisconsin. The name \"Menominee\" derives from the Algonkian word for \"manomin,\" a word for rice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Menominee"@en .

aat:300017589 a skos:Concept ;
    skos:definition "Refers to the culture of the Ojibwa, Algonquian-speaking Indians who historically lived along the northern shore of Lake Huron and both shores of Lake Superior from what is now Minnesota to the Turtle Mountains of North Dakota, as well as from southern Saskatchewan to Quebec in Canada. Today, Ojibwa communities exist in several different tribes across the Great Lakes region in the United States and Canada, thus they are considered Native American in the United States, and First Nations in Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ojibwa"@en .

aat:300017593 a skos:Concept ;
    skos:definition "Culture of a Siouan-speaking tribe of Native Americans, native to the present-day states of Wisconsin, Minnesota, and parts of Iowa and Illinois. The two remaining federally recognized are the Ho-Chunk Nation of Wisconsin and the Winnebago Tribe of Nebraska."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ho-Chunk"@en .

aat:300017594 a skos:Concept ;
    skos:definition "Cultures and styles of Northwest Coast Indigenous Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northwest Coast Native American"@en .

aat:300017596 a skos:Concept ;
    skos:definition "Used to refer specifically to the material works of the Heiltsuk people that inhabit the village of Bella Bella, British Columbia. Often used erroneously to refer to the Heiltsuk people themselves. To describe material culture common to the Heiltsuk language speaking people in general, \"Heiltsuk\" is preferred. Note that scholarship as recent as 1998 uses \"Bella Bella\" to refer to the Heiltsuk people, or a sub-group therein. \"Bella Bella Indians\" is a term dating from ca. 1834 and is not based on aboriginal self-determination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bella Bella"@en .

aat:300017598 a skos:Concept ;
    skos:definition "Style and culture of the Nuxalk (once known as Bella Coola), an indigenous people of the Bella Coola valley in what is now British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuxalk"@en .

aat:300017605 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Gitxsan, a First Nations indigenous people living in northwest British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gitxsan"@en .

aat:300017606 a skos:Concept ;
    skos:definition "Refers to the artwork of the Haida-speaking North American Indians of what is now the Queen Charlotte Islands, British Columbia, Can., and the southern part of Prince of Wales Island, Alaska, U.S. The Alaskan Haida are called Kaigani."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haida"@en .

aat:300017608 a skos:Concept ;
    skos:definition "Refers to the Hailhzaqvla, or Heiltsuk language-speaking people that inhabit the area around Bella Bella, British Columbia. Historically, the people that inhabit Bella Bella have been referred to as \"Bella Bella Indians.\" The correct term to refer to the larger culture, and to describe the art and artifacts of this people, is \"Heiltsuk.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heiltsuk"@en .

aat:300017615 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Nisga'a, an indigenous people who have traditionally lived in the Nass River Valley of Northwestern British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nisga'a"@en .

aat:300017616 a skos:Concept ;
    skos:definition "Refers to the artwork of the North American Indians who live on what are now the southwest coast of Vancouver Island, Canada and on Cape Flattery, the northwest tip of the state of Washington. The groups on the southeast end of the island were the Ditidaht, those on Cape Flattery are the Makah. The Nuu-chah-nulth are culturally related to the Kwakiutl. Their name means \"along the mountains.\" They speak a Wakashan language. The term \"Nootka\" was often used to refer to the Nuu-chah-nulth, but today is considered a European misapplication of a place name in the culture's language, and which acted as an erroneous anglicization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuu-chah-nulth"@en .

aat:300017631 a skos:Concept ;
    skos:definition "Refers to the artwork of the North American Indians of the Northwest Coast who traditionally lived on the mainland and islands around the Skeen and Ness rivers and Milbank Sound in what are now British Columbia, Canada and Alaska. They speak any of three Tsimshian dialects: Niska, coastal Tsimshian, and Kitksan (or Gitksan). Tsimshian is classified as a Penutian language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsimshian"@en .

aat:300017634 a skos:Concept ;
    skos:definition "Culture or style of a North American Indian tribe of Algonquian linguistic stock who lived during the 19th century along the Platte and Arkansas rivers of what are now the U.S. states of Wyoming, Colorado, Nebraska, and Kansas. Their oral traditions suggest that they once had permanent villages in the Eastern Woodlands, where they engaged in agriculture. Because of pressure from tribes to the east, the Arapaho gradually moved westward, abandoning farming and settled life during the process. They split into northern (Platte River) and southern (Arkansas River) groups after 1830."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arapaho"@en .

aat:300017635 a skos:Concept ;
    skos:definition "Refers to the culture of the Arikara, an American Plains Indian people who lived along the Missouri River between the Cheyenne River in South Dakota and Fort Berthold in North Dakota. The Arikara, a Caddoan-speaking people, were culturally related to the Pawnee, from whom they broke away and moved gradually northward, becoming the northernmost Caddoan tribe. Wars and smallpox epidemics severely reduced their numbers by the 19th century. To escape further violence, the Arikara joined with the Hidatsa and Mandan tribes, known today as the \"Three Affiliated Tribes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arikara"@en .

aat:300017641 a skos:Concept ;
    skos:definition "Refers to the culture of a group of three closely related Algonkian-speaking Indian tribes in Alberta and Montana, comprising the Pikuni, or Piegan, the Kainah, or Blood, and the Siksika, or Blackfoot proper (often referred to as the Northern Blackfoot). Not to be confused with the Sihasapa, another Plains Indian tribe that is also referred to as Blackfoot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blackfoot"@en .

aat:300017642 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Blood, or Kainai people, of the Blackfoot Confederacy, located in southern Alberta, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blood"@en .

aat:300017649 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Crow or Apsáalooke, an indigenous people of North America who reside primarily in the present-day state of Montana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crow"@en .

aat:300017650 a skos:Concept ;
    skos:definition "Refers to the culture of the Sioux, a North American Plains Indian people, or confederation of peoples, of Siouan linguistic stock. Sioux is an abbreviation of Nadouessioux, a name originally used to refer to them by the Ojibwa; the word Dakota means \"allies.\" There are three main divisions of the Sioux: Santee, Yankton, and Teton, calling themselves, respectively, Dakota, Nakota, and Lakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sioux"@en .

aat:300017653 a skos:Concept ;
    skos:definition "Refers to the culture of one of the three main divisions of the Sioux. The Santee is comprised of the Mdewkanton, Wahpeton, Wahpekute, and Sisseton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santee"@en .

aat:300017656 a skos:Concept ;
    skos:definition "Refers to the culture of one of the three main divisions of the Sioux. The Lakota has seven main autonomous divisions: Blackfoot; Brulé (Upper and Lower); Hunkpapa; Miniconjou; Oglala; Sans Arcs; and Oohenonpa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lakota"@en .

aat:300017657 a skos:Concept ;
    skos:definition "Refers to the culture of one of the three main divisions of the Sioux. The Yankton is comprised of the Yankton and Yanktonai."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yankton"@en .

aat:300017660 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Kaw (also known as Kansa), an indigenous people of the mid-west United States. The Kaw migrated from their ancestral lands in the lower Iowa valley in 1750, to northeastern Kansas. They were forcibly removed to a reservation in present-day Kay county, Oklahoma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kaw"@en .

aat:300017668 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Otoe (also Oto), a Siouan people. Historically a Great Lakes culture, migrations occurred in the 16th century toward the Minnesota and Iowa border. The Missouria Tribe, nearing extinction in the late 18th century, settled among the Otoe. Today the tribe is known as the Otoe-Missouria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otoe"@en .

aat:300017676 a skos:Concept ;
    skos:definition "Cultures and styles of Plateau Indigenous Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plateau Native American"@en .

aat:300017686 a skos:Concept ;
    skos:definition "Refers to the style and culture of the St'át'imc, an Interior Salish people indigenous to the southern interior of British Columbia, with many located in the town of Lillooet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "St'át'imc"@en .

aat:300017691 a skos:Concept ;
    skos:definition "Culture and style of the Nez Perce, an indigenous people that currently live in the Pacific Northwest region of the United States. It is believed they descended from the Old Cordilleran Culture, which moved from the Rocky Mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nez Perce"@en .

aat:300017692 a skos:Concept ;
    skos:definition "Refers to the style and culture of the indigenous, First Nations, Interior Salish people residing in the Okanagan Valley of British Columbia and northeast Washington state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syilx"@en .

aat:300017695 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Secwépemc (also Shuswap), an indigenous, Interior Salish people of present day British Columbia, though their ancestral land stretched from the Rocky Mountains in the east to Fraser River in the west."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Secwépemc"@en .

aat:300017698 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Ntlaka'pamux (formerly Thompson), an indigenous, First Nations, Interior Salish people largely residing in present-day British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ntlaka'pamux"@en .

aat:300017702 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Yakama Nation (formerly spelled 'Yakima'), an indigenous people whose ancestral land primarily spans areas of eastern Washington State."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yakama"@en .

aat:300017703 a skos:Concept ;
    skos:definition "Cultures and styles of Southeastern Indigenous Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southeastern Native American"@en .

aat:300017706 a skos:Concept ;
    skos:definition "North American Indians of Iroquoian lineage who constituted one of the largest politically integrated tribes at the time of European colonization of the Americas. Their name is derived from a Creek word meaning 'people of different speech'; many prefer to be known as Keetoowah or Tsalagi. They formerly controlled approximately 40,000 square miles (100,000 square km) of the Appalachian Mountains in parts of present-day Georgia, eastern Tennessee, and the western parts of what are now North Carolina and South Carolina. Most members were forcibly removed from the Southeast by the U.S. government in the 1830s. Today the Cherokee Nation is a sovereign tribal government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cherokee"@en .

aat:300017710 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Muscogee (also known as Creek), an indigenous people of the southeastern United States, and whose ancestral lands spans parts of present-day states Tennesee, Alabama, Georgia, and Florida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muscogee"@en .

aat:300017720 a skos:Concept ;
    skos:definition "Refers to the branch of Tuscarora people in the Southeastern United States. The Tuscarora occupied what is now North Carolina when Europeans arrived in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuscarora"@en .

aat:300017723 a skos:Concept ;
    skos:definition "Styles and cultures Southwestern Native America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southwestern Native American"@en .

aat:300017724 a skos:Concept ;
    skos:definition "Style and culture of the descendents of the Athabascan family who migrated to the Southwest in the 10th century. Over time, many bands of Apache were relocated to reservations from their traditional homelands, which once extended through Arizona and New Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apache"@en .

aat:300017739 a skos:Concept ;
    skos:definition "The style and culture of the Yuman-speaking North American Indian farmers of the Mojave Desert who traditionally resided along the lower Colorado River in what are now the U.S. states of Arizona and California and in Mexico. Today, the Mojave are organized into the Fort Mojave Indian Tribe, located in southern California and Nevada and western Arizona; its headquarters are in Needles, California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mojave"@en .

aat:300017740 a skos:Concept ;
    skos:definition "The style and culture of a populous North American Indian group who live primarily in New Mexico, Arizona, and Utah, speaking an Apachean language which is classified in the Athabaskan language family. At some point in prehistory, the Navajo and Apache migrated to the Southwest from Canada, where most other Athabaskan-speaking peoples still live; although the exact timing of the relocation is unknown, it is thought to have been between 1100 and 1500 CE. These early Navajo were mobile hunters and gatherers; after moving to the Southwest, however, they adopted many of the practices of the sedentary, farming Pueblo Indians near whom they settled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Navajo"@en .

aat:300017742 a skos:Concept ;
    skos:definition "Style and culture of a North American Indian group native to the northern Mexican border state of Sonora."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Opata"@en .

aat:300017743 a skos:Concept ;
    skos:definition "Style and culture of either of two distinct North American Indian groups that speak languages of the Numic group of the Uto-Aztecan family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paiute"@en .

aat:300017744 a skos:Concept ;
    skos:definition "The culture of a Native American people of the desert regions of Arizona and Sonora in the southwestern U.S. and northern Mexico. Name was changed in 1985 from Papago to Tohono O'odham tribe. The homelands of the Papago Indians include the desert regions of the northern Sonora and Arizona. The Papago tribe is a descendant of a larger tribe called the Hohokam. They were traditionally semi-sedentary and speak the Uto-Aztecan language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tohono O’odham"@en .

aat:300017745 a skos:Concept ;
    skos:definition "Refers to the style and culture of the North American Indians who traditionally lived along the Gila and Salt rivers in Arizona, in what was the core area of the prehistoric Hohokam culture. The Akimel O'odham (also known as Pima) speak a Uto-Aztecan language and are usually considered to be the descendants of the Hohokam. Like their presumed ancestors, Akimel O'odham were traditionally sedentary farmers living in one-room houses and utilizing the rivers for irrigation. Some hunting and gathering were done to supplement the diet, and in drought years, which occurred on the average of one year in five, crop failure made hunting and gathering the sole mode of subsistence. During these dry years jackrabbits and mesquite beans became the group's dietary staples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akimel O'odham"@en .

aat:300017748 a skos:Concept ;
    skos:definition "Styles and culture belonging to Rio Grande Pueblo peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rio Grande Pueblo"@en .

aat:300017749 a skos:Concept ;
    skos:definition "Refers to the culture and style of the Acoma, a Native American people living in western New Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acoma"@en .

aat:300017760 a skos:Concept ;
    skos:definition "Style and culture of a group of Tewa-speaking Pueblo Indians, currently centered north of Santa Fe, New Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tesuque"@en .

aat:300017761 a skos:Concept ;
    skos:definition "Style and culture of the Zia-speaking tribe of Pueblo people, today centered at Zia Pueblo Indian reservation in New Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zia"@en .

aat:300017762 a skos:Concept ;
    skos:definition "Cultures and styles of the more western Pueblo Native American people in the southwestern United States, particularly the Zuñi Desert Puebloans and the Hopi dry-farmers. The distinction between Eastern and Western Pueblo is based on the publications of certain scholars of the 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Pueblo"@en .

aat:300017763 a skos:Concept ;
    skos:definition "Style and culture of the westernmost group of Pueblo Indians, situated in what is now northeastern Arizona, on the edge of the Painted Desert. They speak a Shoshonean language of Uto-Aztecan stock. The precise origin of the Hopi is unknown, although it is thought that they and other Pueblo peoples descended from the Ancestral Pueblo (Anasazi)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hopi"@en .

aat:300017764 a skos:Concept ;
    skos:definition "Refers to the style and culture of the A:shiwi people, also known as Zuni, the indigenous Pueblo people of what is now west-central New Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "A:shiwi"@en .

aat:300017769 a skos:Concept ;
    skos:definition "Cultures and styles belonging to Indigenous Native Middle Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Middle American"@en .

aat:300017772 a skos:Concept ;
    skos:definition "Styles belonging to Native Northwestern Mexican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Northwestern Mexican styles"@en .

aat:300017782 a skos:Concept ;
    skos:definition "Styles belonging to Native Western Mexican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Western Mexican styles"@en .

aat:300017784 a skos:Concept ;
    skos:definition "Styles belonging to Native Central Mexican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Central Mexican styles"@en .

aat:300017787 a skos:Concept ;
    skos:definition "Style and culture of a group of indigenous people of Mexico, traditionally concentrated along the Pánuco River and along the coast of the Gulf of Mexico, in the states of Hidalgo, Veracruz, San Luis Potosí, and Tamaulipas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huastec"@en .

aat:300017792 a skos:Concept ;
    skos:definition "Although scholarship refers to cultural products associated with this group as Otomi, the term is an exonym and the people refer to themselves as Hñahñu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otomi"@en .

aat:300017793 a skos:Concept ;
    skos:definition "Native Central Mexican style or culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nahua"@en .

aat:300017795 a skos:Concept ;
    skos:definition "Culture or style of inhabitants of Tlaxcala."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tlaxcalan"@en .

aat:300017798 a skos:Concept ;
    skos:definition "Styles belonging to Native Southern Mexican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Southern Mexican styles"@en .

aat:300017805 a skos:Concept ;
    skos:definition "An indigenous people of Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huave"@en .

aat:300017820 a skos:Concept ;
    skos:definition "Styles belonging to Native Yucatan cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Yucatan styles"@en .

aat:300017826 a skos:Concept ;
    skos:definition "Refers to the style and culture of a group of Mesoamerican Indians occupying a nearly continuous territory in southern Mexico, Guatemala, and northern Belize. The ancient Maya settled in villages by ca. 1500 BCE. They used advanced irrigation technology to become successful agriculturalists. Their art included ceramics, sculpture, architecture, murals, and books. Modern Maya people produce art that combines traditional patterns with Spanish forms and stye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maya"@en .

aat:300017836 a skos:Concept ;
    skos:definition "Culture or style of the Ixil people, a Mayan people indigenous to Guatemala."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ixil"@en .

aat:300017839 a skos:Concept ;
    skos:definition "Style and culture of the Kekchi Maya Native Middle American people of Guatemala and Belize."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kekchi"@en .

aat:300017859 a skos:Concept ;
    skos:definition "Styles belonging to Native Central American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Central American styles"@en .

aat:300017860 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Chibchan-speaking Indian people of Central America who formerly occupied the area of modern Panama and the neighboring San Blas Islands, and now survive in isolated areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuna"@en .

aat:300017873 a skos:Concept ;
    skos:definition "Styles belonging to Native Caribbean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Caribbean styles"@en .

aat:300017878 a skos:Concept ;
    skos:definition "Style and culture of the Taino Arawak people, who were one of the major indigenous peoples of the Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taino"@en .

aat:300017879 a skos:Concept ;
    skos:definition "Cultures and styles of the indigenous people of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native South American"@en .

aat:300017881 a skos:Concept ;
    skos:definition "Cultures, nationalities, and styles of the people indigenous to the area of the river Amazon, South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Amazonian"@en .

aat:300017918 a skos:Concept ;
    skos:definition "Cultures and styles of the indigenous people of the Andes continental mountain range of South American."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Andean"@en .

aat:300017919 a skos:Concept ;
    skos:definition "Styles belonging to Native Central Andean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Central Andean styles"@en .

aat:300017928 a skos:Concept ;
    skos:definition "An indigenous peoples of South America, primarily in Peru, Ecuador, Bolivia, Argentina, Chile, and Colombia. They are bound by shared customs and language, although their ancient origins may vary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quechua"@en .

aat:300017933 a skos:Concept ;
    skos:definition "Styles belonging to Native South Andean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native South Andean styles"@en .

aat:300017934 a skos:Concept ;
    skos:definition "Culture and style of the South American Indians that are now concentrated in the fertile valleys and basins of south-central Chile, from the Biobío River in the north to the Toltén River in the south. Although the pre-Columbian Araucanians did not themselves recognize political or cultural unity above the village level, the Spanish distinguished three Araucanian populations geographically: the Picunche living in the north between the Choapa and Biobío rivers, the Mapuche inhabiting the middle valleys, and the Huilliche dwelling in the south between the Toltén River and Chiloé Island. At the time of the Spanish arrival in Chile, most of central Chile was settled by scattered populations of Mapuche farmers who grew corn (maize), beans, squash, potatoes, and other vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Araucanian"@en .

aat:300017943 a skos:Concept ;
    skos:definition "The culture or style of the southern partiality of the Mapuche macroethnic group in Chile and Argentina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huilliche"@en .

aat:300017948 a skos:Concept ;
    skos:definition "Style or culture associated with the Picunche, Mapudungun-speaking people living to the north of the Mapuches or Araucanians in what is now Chile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picunche"@en .

aat:300017951 a skos:Concept ;
    skos:definition "Styles belonging to Native South American Caribbean Coast cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native South American Caribbean Coast styles"@en .

aat:300017961 a skos:Concept ;
    skos:definition "Styles belonging to Native Chaco cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Chaco styles"@en .

aat:300017991 a skos:Concept ;
    skos:definition "Culture or style of the Páez Native South American peoples of the southern highlands, Colombia. They speak a Chibchan language very closely related to that of the now-extinct Pijao and Coconuco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Páez"@en .

aat:300018001 a skos:Concept ;
    skos:definition "Styles belonging to Native Eastern Brazilian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Eastern Brazilian styles"@en .

aat:300018026 a skos:Concept ;
    skos:definition "Culture of indigenous Ona South Americans, who once inhabited southern Argentina and Chile, including the island of Tierra del Fuego. They were hunters and gatherers who subsisted chiefly on guanaco, various small animals, shellfish, cormorants, and berries. They were historically divided into two major subdivisions: Selk'nam and Haush. They spoke different dialects and had slightly different cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ona"@en .

aat:300018032 a skos:Concept ;
    skos:definition "Styles, cultures, periods, and movements of Colonial America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial American"@en .

aat:300018071 a skos:Concept ;
    skos:definition "Refers to the style and culture of seventeenth- and eighteenth-century German settlers in Pennsylvania and their descendants. Their culture is characterized by a retention of traditional German styles of cookery and craftsmanship, often recognized by distinctive decorative motifs, including geometric hex signs painted on barns and floral and other patterns stenciled on furniture and housewares. Some descendents drive horse-drawn buggies, wear simple, traditional clothing, and live according to strict religious principles. The large flow of immigrants from the Rhine area of Germany was encouraged by the religious tolerance of William Penn's colonial government. Immigrants were members of several groups, including Mennonites, Quakers, Amish, Moravians, Schwenckfelders, and Dunkers (or German Baptists); later immigrants included Lutherans and members of the Reformed churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pennsylvania German"@en .

aat:300018082 a skos:Concept ;
    skos:definition "Styles belonging to Colonial Latin American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial Latin American styles"@en .

aat:300018086 a skos:Concept ;
    skos:definition "Refers to the style of painting that emerged from Peruvian painters of various ethnic origins active in Cuzco from the 16th to the 19th centuries. It is characterized by the use of indigenous traditions influenced by Netherlandish Late Gothic Art. Dramatic chiaroscuro painters in the Cuzco style were often Indians taught by Spanish masters. Later, Indian painters began to work in styles independent from Spanish and Creole traditions under the patronage of local leaders, abandoning European perspective and favoring flat compositions filled with gilded nature and Incan motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cuzco"@en .

aat:300018102 a skos:Concept ;
    skos:definition "Culture and regional style of architecture in Mexico, especially around Puebla, featuring rustic and folkloristic qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poblano"@en .

aat:300018103 a skos:Concept ;
    skos:definition "Refers to the culture, and the style of architecture prevalent in southern Chiapas, Mexico, southern Guatemala and Honduras, and western El Salvador. The style reflects Classic Mesoamerican monumentality and Teotichuacan ceramic detailing, and utilizes decorative Mesoamerican green volcanic glass. It is distinguished from more elaborate Lowland Maya styles in the lack of stele-altars and colonnaded areas, the reticent use of corbel arches for substructural tombs, and the scarcity of polychrome ceramics, lofty corbel-vaulted temple designs, and structures measuring celestial cycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Provincial Highland"@en .

aat:300018110 a skos:Concept ;
    skos:definition "Architectural styles belonging to Colonial Latin American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial Latin American architecture styles"@en .

aat:300018115 a skos:Concept ;
    skos:definition "Styles, periods, cultures, and movements of America in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern American"@en .

aat:300018124 a skos:Concept ;
    skos:definition "Refers to a British and American movement influencing fine and decorative art and architecture in the 1870s and 1880s. Following the philosophy of \"art for art's sake\", the Aesthetic Movement stressed beauty and the autonomous value of art over didactic purpose, narrative content, or significant subject matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesthetic Movement"@en .

aat:300018125 a skos:Concept ;
    skos:definition "Designates the styles, culture, and heritage of Americans of African descent in North America. The styles capture the essence of the African American experience and how personal and political rebellion and triumphs over prejudice and social adversity have enriched and contributed to the music, art, and literature of American culture as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African American"@en .

aat:300018146 a skos:Concept ;
    skos:definition "Refers to the movement in architecture and interior design prevalent in the late 19th and early 20th centuries in countries formerly colonized by Great Britain. The style, mostly seen in domestic architecture and promoted as a picturesque 'national' style, is a direct resurrection of building styles of the early colonial periods and of the Neo-Georgian period. In United States west coast, the movement features a revival of Spanish colonial styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial Revival"@en .

aat:300018159 a skos:Concept ;
    skos:definition "Refers to the movement in Colonial Revival architecture during the 1920s evident in the building programs of the American West and Southwest and generally features Spanish-style balconies, verandas and arcades, towers, pan-tiled roofs, and plazas and courtyards. Most notably, the style features a lack of architectural moldings and the heavy use of carved or cast ornament, classically-derived columns, window grilles, and wrought iron or turned spindles reminiscent of Spanish colonial architecture in Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Colonial Revival"@en .

aat:300018185 a skos:Concept ;
    skos:definition "Late 19th-century and early 20th-century American decorative arts style, principally with reference to furniture. Use \"Mission Style\" for a subtype of the Spanish Colonial Revival architecture style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mission"@en .

aat:300018194 a skos:Concept ;
    skos:definition "Refers to the style of architecture, interior design, and decorative arts that prevailed in the United States, ca. 1870 to ca. 1925. As a result of the ever widening influence of the Arts and Crafts Movement in England, the Craftsman style was also based on the rejection of historical styles in favor of a traditional simplicity. Many of the same types of people were involved, such as social reformers, teachers and women's organizations, architects, and designers, as well as the prophets of the movement, John Ruskin and William Morris. In architecture, the style is characterized by modest homes, such as the bungalow, and simple treatment of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Craftsman"@en .

aat:300018196 a skos:Concept ;
    skos:definition "Styles, periods, cultures, and movements of North America in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern North American"@en .

aat:300018205 a skos:Concept ;
    skos:definition "A version of the Italianate style, usually restricted to domestic architecture and including a tall tower."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian Villa Style"@en .

aat:300018207 a skos:Concept ;
    skos:definition "Nineteenth-century architectural style that referenced Italian 16th-century Renaissance style The style first developed in Britain in about 1802 by John Nash, and it was taken up in other nations. For example, it was common in mid-19th-century North American residential architecture, which featured a low-pitched hipped roof topped by a belvedere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italianate"@en .

aat:300018208 a skos:Concept ;
    skos:definition "Refers to the movement, centered mostly in the American Midwest among architects, notably Louis Sullivan and Frank Lloyd Wright, united by the rejection of revivalist styles and by the development of a new architectural vision based on the faithful expression of the natural qualities of a region or nation. The style generally favored elongated horizontal arrangements that blended naturally with the open American landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prairie School"@en .

aat:300018210 a skos:Concept ;
    skos:definition "Refers mainly to the style of architecture found in the Southwestern United States which draws its inspiration from the Pueblos and the Spanish missions in New Mexico. The style developed at the turn of the 20th century and reached its greatest popularity in the 1920s and 1930s, although it is still commonly used for new buildings. Pueblo Revival imitates the appearance of traditional adobe construction, however through the use of modern materials such as concrete and brick. Typical attributes include rounded corners, irregular parapets, and thick, battered walls used to simulate adobe. Roofs are always flat, and a common feature is the use of wooden roof beams that are often decorative rather than supportive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pueblo Revival"@en .

aat:300018214 a skos:Concept ;
    skos:definition "Refers to the movement in America between 1879 and 1890 headed by John C. Stevens (1855-1940), characterized by the use of wood shingles to cover entire buildings and a predilection for functionalism rather than for historical, learned styles. This movement, which grew out of the Stick and Queen Anne movements, prevailed more among private homes and hotels rather than among industrial or commercial sites and featured free-flowing, open plans with interlocking interior and exterior spaces, irregular elevation, open porches, and irregular roof lines that contributed to an overall pastoral effect. Late 19th-century American architectural style that incorporates plain, shingled surfaces and massing of forms inspired by English and American Colonial buildings. It flourished in the New England school of architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shingle Style"@en .

aat:300018215 a skos:Concept ;
    skos:definition "Refers to the theory coined by Vincent J. Scully in 1949 to address the style of mid-19th century American timber-framed domestic architecture and to correlate the desire to express structure with an externally conspicuous and organic wooden frame. The style reflects European traditions based on half-timbered Late Gothic domestic architecture of England, France, and Germany, on Swiss chalet styles, and on Scandinavian and Slavic vernacular building designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stick Style"@en .

aat:300018221 a skos:Concept ;
    skos:definition "Mid-19th-century furniture style, characterized by simplicity of design with natural woods, unpolished or painted in pale colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cottage Style"@en .

aat:300018222 a skos:Concept ;
    skos:definition "Refers to the decorative and architectural style in 19th century America associated with the furniture designs of Charles Locke Eastlake. In architecture, the style derives forms from furniture design featuring columns resembling table legs, curved brackets, spindles, and knobs of various shapes consisting of circular perforations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastlake"@en .

aat:300018223 a skos:Concept ;
    skos:definition "Use to describe a type of mass-produced American furniture produced in Grand Rapids, Michigan, particularly between the 1850s and 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grand Rapids"@en .

aat:300018229 a skos:Concept ;
    skos:definition "Refers to the style of 18th and 19th century European and American architecture and furniture that mimics rough hewn logs or parts of a tree in its construction or decoration. It is especially identified with 18th century English garden furniture and with fanciful outdoor structures such as hermitages and grottoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rustic"@en .

aat:300018236 a skos:Concept ;
    skos:definition "Style and movement that grew out of Constructivism; it emphasizes underlying structural forms and processes; it views the world as being internally created through constructs, or internal models, often uses naturally occurring proportional systems and rhythms to underpin geometrical art. Refers especially to certain work in Britain in the 1950s; can also refer to certain American and European works of the 1930s and 1940s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Constructionist"@en .

aat:300018251 a skos:Concept ;
    skos:definition "Art movement lead by American painters Morgan Russell and Stanton Macdonald-Wright in the early 20th century. The style is distinguished for its focus on abstract, rhythmic color arrangements and submerged forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Synchromist"@en .

aat:300018279 a skos:Concept ;
    skos:definition "Refers to the cultures of the continent of Asia, which is in the eastern hemisphere, and is bounded by the Pacific Ocean, the Indian Ocean, the Arctic Ocean, and is generally considered to be delimited on the west by the Ural Mountains. It also refers to the numerous islands off the coast of Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asian"@en .

aat:300018311 a skos:Concept ;
    skos:definition "A culture and style of pre-Muslim Central Asia, named after, but not restricted to the area of Sogdiana. Noted visual arts were created 5th/ 9th centuries. Many cultural streams united in the area of Sogdiana, including Sāsānian culture, post-Gupta India, and Sui and T’ang Chinese. Style is characterized in painting and carved wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sogdian"@en .

aat:300018322 a skos:Concept ;
    skos:definition "The cultures, styles, and periods characteristic of China. To specifically refer to the cultures of ancient Chine, use \"Ancient Chinese.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese"@en .

aat:300018324 a skos:Concept ;
    skos:definition "Periods related to Chinese prehistory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese prehistoric cultures and periods"@en .

aat:300018332 a skos:Concept ;
    skos:definition "Periods related to Chinese Mesolithic culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese Mesolithic periods"@en .

aat:300018333 a skos:Concept ;
    skos:definition "Culture defined by the use of microlithic assemblages during the Mesolithic period in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Microlithic"@en .

aat:300018337 a skos:Concept ;
    skos:definition "Refers to a Neolithic Chinese culture and period named after an archaeological site in Huai'an County, Jiangsu Province, China that was discovered in 1951. Broadly defined, Qingliangang spanned the period of ca. 4500 to ca. 2300 BCE and encompassed the entire coastal area from Shandong Province in the north to the border of Fujian Province in the south. It has also been more narrowly defined as spanning the period of ca. 4500 to ca. 3200 BCE and including only Shandong Province and the northern part of Jiangsu Province. The few Neolithic remains excavated at Qingliangang consist primarily of sophisticated stone tools, pottery vessels, and potsherds. Qingliangang pottery is predominantly redware although grey and black wares have also been found. Vessels include dishes or basins of the pan and pen types, bowls of the bo types, tripods of the ding and li types, cups of the bei and dou types, and zeng steamers. Ornamental designs consist exclusively of simple geometric patterns, mostly made up of curved or straight parallel lines. The decoration is usually stamped and painted; incision and appliqué are also used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qingliangang"@en .

aat:300018340 a skos:Concept ;
    skos:definition "Periods related to Chinese Neolithic culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese Neolithic periods"@en .

aat:300018345 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating to ca. 6000 to 3000 BCE. Chungwan refers to the Central Plain of China which is commonly regarded as the cradle of Chinese civilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chungwan"@en .

aat:300018346 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating to ca. 3300 BCE to the beginning of the Bronze Age. It geographically covered western Shaanxi province, Gansu and Qinghai provinces, but since the most striking pottery comes from sites in Gansu, the culture takes this name. Gansu culture falls into three major phases: Majiayao (ca. 3300-ca. 2100 BCE), Banshan (ca. 2800-ca. 2300 BCE) and Machang (ca. 2000-ca. 1800 BCE). These were followed by the Qijia (ca. 2000-ca. 1600 BCE), Xindian, and Shajing phases. The finest Gansu ceramic vessels are thin-bodied and light, with a variety of boldly painted decoration. Clay was carefully selected and prepared and painted decoration was done in earth pigments probably applied with a soft brush. The most notable vessel type made during this period was the funerary urn with a wide shoulder and narrow base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gansu"@en .

aat:300018347 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture and period spanning ca. 2500 to ca. 2000 BCE. It is named after a site at Chengziyai, Zhangqiu county, in Shandong province; the site was excavated by Johan Gunnar Andersson in 1930 to 1931. Longshan is chiefly known through its pottery; the pottery style has been found in the region reaching from southern Manchuria through Hopei, eastern Honan and Shatung, and as far south as Chekeing. The style is characterized by black, burnished, often incised wares in a wide variety of shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Longshan"@en .

aat:300018354 a skos:Concept ;
    skos:definition "Traditionally refers to the culture, style, and period of the unverified first Chinese dynasty, dating from the early second millennium BCE and preceding the Shang dynasty. Scholars debate the validity of the claim in Zhou period texts that the Xia controlled an area in the middle Yellow River valley. No archaeologically defined culture has been discovered. The supposed date range of the Xia dynasty covers the early part of the bronze-producing Erlitou culture of Henan province and the site of Erlitou in Yanshi county, Henan province, may be Xia. Erlitou ceramics appear to have come out of Longshan pottery and include grey, black, red, white, and brownish earthenware. Perhaps most noteworthy are Erlitou bronze ritual vessels cast in pottery molds. These bronze ritual vessels as well as ornaments and jades, have been uncovered in Erlitou tombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xia"@en .

aat:300018356 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of the first Chinese dynasty of which we have certain knowledge, both archaeological and historical. The Shang ruled from ca. 1600 BCE to ca. 1050 BCE and their culture was centered on the Yellow River plain although their power extended at times over modern northern Henan province and parts of modern Shandong, Shanxi, and Shaanxi provinces. This period is notable for its advances in bronzeworking and other technologies, all of which led to a higher level of civilization. The Shang had large armies with a wide variety of weapons and armor. Bronze was also used for ritual objects such as bells and stands. Decoration on Shang bronzes was highly schematic with the 'taotie' animal mask a preferred motif. Shang religion and ancestor worship featured the use of so-called oracle bones (jiagu), inscribed animal bones and tortoise shells. Nearly 100,000 oracle bones have been uncovered since scholars recognized their significance. Oracle bones are the oldest form of Chinese historiography, establishing a list of kings in agreement with later written histories. The Shang writing system was quite sophisticated; some Shang characters are still in use today. Shang pottery came in a variety of colors and was wheelmade or coiled, often featuring impressed patterns. The earliest known Chinese glazes were made in the Shang period. Marble and limestone sculptures of both real and mythical creatures have been found. Shang urban settlements have shown that the basic forms of Chinese architecture already existed; noteworthy settlements include those at Erlitou, Zhengzhou, and Yin (at modern Anyang), all of which served as the capital at different times. The late Shang rulers were hedonistic builders of luxurious palaces. The Zhou, a more warlike people who effectively used the chariot, succeeded the Shang."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shang"@en .

aat:300018372 a skos:Concept ;
    skos:definition "Refers to the the culture, style, and period of the Zhou dynasty, a period spanning ca. 1050 to 256 BCE. The Zhou dynasty succeeded the Shang dynasty. The area ruled by the Zhous was very large but their rule was not direct and so was often challenged. The Zhou period is divided into the Western Zhou (ca. 1050-771 BCE) and the Eastern Zhou (771-256 BCE). There was a great deal of regional diversity in the Zhou period, but overall it was a time of noteworthy political, philosophical, religious, and social changes. Many basic Chinese traditions were established and the earliest Chinese literature dates from the Zhou period, including the writing of Confucius. The population increased at this time and iron tools became more widespread, leading to agricultural advances. The rise of a merchant class and the development of coinage created a bigger market for artistic wares, of which bronzes remained the most important, becoming more secular and serving as symbols of status, wealth, and authority. Longer inscriptions are found on Zhou bronzes and are now valuable records of early Chinese history. The decoration of bronzes became more abstract, geometric, and colorful with an increased use of relief and precious inlay. The many small states of the Zhou dynasty became virtually independent of central authority and it was the Qin who eventually defeated the other states to establish the first unified Chinese rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zhou"@en .

aat:300018374 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of the Zhou dynasty from 771 to 256 BCE. The Eastern Zhou period is said to have begun when the Zhou, fleeing attacking tribes, moved their capital from Xi'an to Luoyang. This geographical break with the preceding Shang dynasty was reflected in the art of the Eastern Zhou period. Late Eastern Zhou art, in particular, displays a remarkable diversity and skill. Low-fired burial figurines (mingqi) were used more, possibly influenced by Confucian dictum against human sacrifice. Low-fired green lead-glazed wares, soft, polished black wares, and some high-fired glazed wares were made in the Eastern Zhou period. Brightly painted ceramics were made to imitate newly popular lacquerware while other ceramics were made to imitate bronzes. Molded and decorated ceramic tiles and bricks were produced. Jade carving, which had decreased in the Western Zhou period, became important again as burial objects and objects of personal adornment. Bronzes became more secular and were often given as wedding presents for household decoration. Bronze bells and mirrors became popular. Totemic animals and monsters were replaced by colorful, formalized decorative schemes. The earliest examples of paintings on silk have been discovered in Eastern Zhou tombs. Precursors of the burial pottery of the Han and Tang dynasties have also been found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Zhou"@en .

aat:300018376 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of early part of the Eastern Zhou, from 722 to 481 BCE although some scholars date the period to 770 to 475 BCE. It is named after the chronicle for the state of Lu, the 'Chunqiu.' Woodcarving of this period is associated with the southern state of Chu. Bronze ritual vessels were made in large numbers and sizes and featured elaborate decoration that developed during the 6th and 5th centuries BCE. Such vessels were more important during this period than in the later Warring States period when vessels were often undecorated. The earliest archaeological evidence for Chinese seals comes from the Spring and Autumn Annals period although there is literary evidence that they existed prior to this. Goldworking was not widely adopted in central China until this time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spring and Autumn Annals"@en .

aat:300018378 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of later part of the Eastern Zhou, from 403 to 221 BCE, although some scholars date the period to 475 to 221 BCE. Its name comes from chronicles of the time. A time of severe fragmentation with a subsequent economic and political decline, it was nevertheless a time of imaginative craftsmanship. This creativity was perhaps spurred on by an increase in artistic patrons as well as competition between the different states of the Zhou dynasty. The tomb of the Marquis of Zeng at Suizhou in Hubei province is a notable early Warring States site; it contained over 15,000 artifacts such as bronze ritual vessels, bells, weapons, lacquerware, and wooden and bamboo objects. Birds with curved wings and dragons were dominant decorative motifs for bronzes and ceramics, revealing contact with the cultures of the Asiatic steppes, the Huns and Tartars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Warring States"@en .

aat:300018381 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of the Zhou dynasty from ca. 1050 to 771 BCE. Bronzes and jades of this period resemble those of the preceding Shang dynasty; ceramics and glazes improved during this time although vessels were often grey. Tradition holds that imperial capitals were established during this period at Feng and Hao on the Feng River in central Shaanxi province. The exact sites of these centers are unknown although palace ruins in Fengxi have been excavated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Zhou"@en .

aat:300018383 a skos:Concept ;
    skos:definition "Refers to the the culture, style, and period associated with the Qin dynasty, the first imperial Chinese dynasty, dating from 221-206 BCE. It was during this time that the Great Wall was constructed. Few art objects can be definitely attributed to this period, the best known being life-size pottery soldiers and horses found at the tomb of King Zheng in Lintong."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qin"@en .

aat:300018385 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the Han dynasty in China from 206 BCE-200 CE. Following the fall of the Qin dyansty in 221 BCE, civil war raged until Liu Bang, posthumously known as Gaodi, became the first Han emperor. Han was one of the golden ages in Chinese cultural history. The major art produced during this period includes glazed earthenware and bronze vessels, funerary objects such as house models, figurines of people and animals, and painted brick tomb markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Han"@en .

aat:300018386 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the rule of Wang Man in China, who usurped the Western Han throne in 9 CE, and ruled as sole emperor of the Xin dynasty until its capture in 23 CE. When the Liu family reasserted itself, Guangwudi ruled from 25-57 CE, making Luoyang the capital, about 100 kilometers east of Chang'an, about 15 kilometers from modern Luoyang in Henan Province. During this period, brown-and-green-glazed pottery production spread through the Yellow River Valley and into the Yangzi Valley. Pictoral bricks and engraved tomb slabs were mass-produced, typically with scenes of wine-making, harvesting, and banquets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Han"@en .

aat:300018391 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the rule of Han emperors in Chang'an, China from 206 BCE to 9 CE. Under the reign of Gaodi from 206-195 BCE, Qin laws and institutions were strengthened creating a strong, unified empire. Tomb models and textual evidence suggest the appearance of several palaces built by Goadi and later emperors, rich in objects such as pottery and with chambers decorated with impressed motifs and painted bricks. Bronze production during this period typically consisted of utilitarian items such as household vessels, which were light in structure, and usually undecorated or decorated with simple incised patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Han"@en .

aat:300018393 a skos:Concept ;
    skos:definition "Refers to the culture, styles, and period dating 220 to 280 CE, corresponding to Chinese history after the fall of the Han dynasty; marked by a tripartite division of China between the states of Wei, Shu, and Wu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Three Kingdoms"@en .

aat:300018398 a skos:Concept ;
    skos:definition "Refers to culture, style, and period of the Chinese dynasty that succeeded the Wei. The Western Jin flourished from 265 to 316 CE and the Eastern Jin from 317 to 420 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jin"@en .

aat:300018399 a skos:Concept ;
    skos:definition "Refers to the period, style, and culture of the Chinese dynasty of the period 265 to 316 CE, the first dynasty of the so-called Six Dynasties to succeed one another in southern China. The Western Jin capital was at Luoyang in Henan province. The dynasty was founded by Sima Yan, later known as the emperor Wudi (reigned 265-289 CE). Sima Yan deposed the last Wei ruler and defeated the state of Wu, thus briefly uniting China. The Western Jin period is noted for the high-fired, green-glazed stoneware that was to imitate bronzes. Such ceramics, as well as grave models and bronze mirrors, were found in Western Jin tombs. Fighting between powerful families prevented an effective government from forming and provoked civil war; drought and famine made the situation worse. In 311 the Xiongnu, a northern nomadic people, invaded, bringing an end to the Western Jin dynasty. China would be divided into northern and southern dynasties until the Sui dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Jin"@en .

aat:300018400 a skos:Concept ;
    skos:definition "Refers to culture, style, and period of the Chinese dynasty dating 317 to 420 CE, the second of the so-called Six Dynasties that succeeded each other in southern China. When Luoyang and Chang-an were destroyed in 317, the Chinese fled south to establish a new southern state. Emperors of the Sima family were not able to reconquer the north which remained under the rule of various groups known collectively as the Sixteen Kingdoms; an exception was the area of modern Sichuan province which was annexed in 347, opening up a route to central Asia. Although not a politically strong period in Chinese history, it was a brilliant time for literature and the arts. The capital of Jiankang flourished as a cultural center visited by Buddhist missionaries and merchants from Southeast Asia and India. One of the earliest known Buddhist gilt-bronze images was cast in 338 in imitation of a Gandharan model. Wang Xizhi, the most influential calligrapher in Chinese history, was active during the this period. Eastern Jin ceramic forms are more innovative than those of the Western Jin. Some tombs of the period have been excavated at Mt. Fugui in Nanjing which was, according to literary sources, the imperial burial ground of Eastern Jin imperial families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Jin"@en .

aat:300018404 a skos:Concept ;
    skos:definition "Refers to the Chinese dynastic culture, style, and period dating to 534 to 550 CE that was established by a former Northern Wei garrison commander, Gao Huan (496-547), and his sons. They controlled an area east of Luoyang, with their capital at Ye in southern Hebei province. Buddhism continued to be the main inspiration for the arts. The oldest stone pagoda chapel extant in China, at Shentong si at Mt. Tai, is probably Eastern Wei. Sculpture of this period has a greater rotundity than Northern Wei sculpture. The dynasty ended in 550 when Gao Huan's son Gao Yang became emperor and established the Northern Qi dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Wei"@en .

aat:300018405 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of a northern Chinese dynasty dating 550-577 CE. It was established when Gao Yang, son of the founder of the Eastern Wei dynasty, became ruler in 550 and changed the dynasty's name. The capital remained at Ye. Buddhism continued to have a large impact on the arts, with Indian, Central Asian, and West Asian influences. Northern Qi cave temples are home to some of the finest Chinese Buddhist sculpture. This sculpture illustrates the productivity of the period as well as the fast evolution of style that occurred since the Northern Wei. Some massive, sculptural ceramic forms date from the Northern Qi. Two or more colored glazes were applied to Northern Qi ceramics and white-bodied wares were developed. The wall paintings in the tomb of the aristocrat Lou Rui at Taiyuan are examples of the high-quality painting produced during this time. The rule of Gao Yang was followed by the rule of tyrants who conscripted almost two million men to build the Great Wall. As the ruling elite lost control, Emperor Wudi of the Northern Zhou conquered the Northern Qi in 577, effectively reuniting northern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Qi"@en .

aat:300018407 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of a northern Chinese dynasty 557-581 CE. The Yuwen family of the Xianbei tribe created the Northern Zhou dynasty out of the puppet state of Western Wei. The dynasty was based in the Wei River valley and had its capital at Chang'an in Shaanxi province. Buddhists were persecuted during the reign of Emperor Wudi (reigned 561-577) because the monasteries were considered a drain on the state. Wudi's conquer of the Northern Qi dynasty, which temporarily reunited northern China, was largely financed by the confiscation of monastery property and supported by the forced labor of the million monks and nuns forcibly laicized. Nevertheless, Buddhist art was still created during this period, most notably at Chang'an. Indian Gupta sculptures were the models for several massive Buddha sculptures and there are a few Northern Zhou style wall paintings in the Thousand Buddha Caves in Dunhuang. In such paintings the landscape is important yet subordinate to figural elements. The Northern Zhou dynasty was succeeded by the Sui dynasty, founded by a royal maternal relative named Yang Jian in 581."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Zhou"@en .

aat:300018409 a skos:Concept ;
    skos:definition "Refers to the Chinese dynastic culture, style, and period dating 386 to 534 CE. Its capital was initially at Pingcheng but was moved south to Luoyang in 493-494 by Emperor Xiaowendi (reigned 471-499) where a new magnificent city was built on the ruins of the old Chinese capital; by 534 the population was more than half a million. Buddhist art flourished under state and private patronage during most of this period. Cave temples at Yungang were begun in ca. 460; thousands of craftsmen worked for about 35 years to make the temples and adorn them with sculpture and painting. Other cave temples were later made at Longmen at the instigation of Xiaowendi. While Yungang features static icons in a Gandharan style, the sculpture at Longmen is more linear, demonstrating the emerging Chinese style. Northern Wei burial pottery, also influenced by Buddhism, emphasizes frontality and symmetry. The nomadic Touba people began to rely on Chinese institutions to organize and run their state and they also became accustomed to Chinese culture and luxuries; under Xiaowendi Chinese became the official language and the use of Tuoba language was forbidden. The distinction between the 'barbarian' north and 'civilized' south became less marked; nevertheless, northern frontiersmen began to feel neglected and so they revolted, leading to the collapse of the Northern Wei dynasty. Northern China was divided into the Eastern and Western Wei dynasties in 534."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Wei"@en .

aat:300018410 a skos:Concept ;
    skos:definition "Refers to the Chinese dynastic period, styles, and culture dating to 535 to 556 CE that was established by Yuwen Tai (reigned 535-551). The dynasty had its capital at Chang'an in Shaanxi province and ruled the land west of Luoyang; the area of modern Sichuan province was annexed in 553. While smaller than the Eastern Wei dynasty it was well organized and efficient. The Dunhuang caves in Gansu province feature Buddhist wall paintings and stuccos of the Western Wei period. Mortuary figures began to have more facial expression than earlier examples; the many ethnic types found in these figures reflects the cross-cultural influences of the period. Yuwen Tai's son inaugurated the Northern Zhou dynasty in 557."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Wei"@en .

aat:300018412 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of the southern Chinese dynasty of the period 557 to 589 CE that was the last of the Six Dynasties. The dynasty was founded in 557 when Chen Baxian deposed the Liang emperor but the territory controlled by the Chen was smaller than that of its dynastic predecessors. Jiankang, the capital of the Six Dynasties, was a great cultural, political, and religious center to which merchants and Buddhist missionaries travelled from Southeast Asia and India. Painting, calligraphy, music, and poetry flourished with the help of Chen imperial and aristocratic patrons. The development of literary and art criticism is seen in the works of Yao Zui and Xie He. After consolidating power in the north, General Yang Jian, Duke of Sui, took Jiankang in 589, establishing the Sui dynasty and reuniting all of China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chen"@en .

aat:300018414 a skos:Concept ;
    skos:definition "Refers to the Chinese dynastic culture, style, and period dating to 502 to 557. Liang was the 3rd of the Southern Dynasties; located in central China, north of Lake Dongting. The ephemeral dynasty, one of the successors of the Jin dynasty, was not able to maintain its position for long. The city of Nanjing came under strong Buddhist influence during this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liang"@en .

aat:300018415 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating 420 to 479. The Liu Song, which succeeded the Eastern Jin dynasty, continued the cultural development begun by the Jin. The dynasty was founded by Liu Yu (363-422), whose surname forms part of the name in order to distinguish it from a later dynasty of the same name, the Song dynasty (960-1279, ruled by the Zhao family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liu Song"@en .

aat:300018417 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating 479 to 502. The ephemeral dynasty, one of the successors of the Jin dynasty, was not able to maintain its position for long. Emperor Gaodi (reigned 479-483) amassed a large collection of works of art. A notable artist of the period was Xie He, a portrait painter at the court in Nanjing; he was the influential author of the earliest extant Chinese text on the theory of painting. The caves around the Qixia Temple on Mount She, 20 kilometers east of Nanjing, house Buddhist sculptures from the Southern Qi period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern Qi"@en .

aat:300018419 a skos:Concept ;
    skos:definition "Refers to the culture, style, period of the Chinese dynasty of the period 589 to 618 CE. During this time northern and southern China were reunited after centuries of separation. Although a relatively brief dynastic period, it was a time of noteworthy economic, political, and educational innovation. A prosperous trade with Central Asia and the West developed during this period. Innovation also occured in the fields of engineering and architecture, as seen in the works of the engineer Li Chun and the architect Kai Yuwen, who both worked under the emperor Wendi (reigned 581-604). Li Chun was responsible for the world's oldest open-spandrel stone arch bridge, the Anji bridge, and Kai Yuwen laid out the city of Daxing, which became the world's largest and most populous city of its day. The Sui were ardent Buddhists and much of their stone sculpture, unlike their bronze, wood, and lacquer work, survives; they also repaired many older Buddhist images. Sui sculpture is considered technically fine but lacking in some of the elegance found in the best Northern Qi sculpture. Sui ceramics are well modelled and relatively plain. Sui celadons, some decorated with stamped patterns, have been unearthed in both northern and southern China. Many stoneware and earthenware figurines of warriors, officials, and guardian creatures were created, especially for use as funerary objects. Earthenware models of such everyday objects as stoves and shoes were included in tombs for use in the afterlife. Costly military failures, natural disasters, and an autocratic and extravagant rule led to the decline of the Sui dynasty, which was succeeded by the Tang dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sui"@en .

aat:300018420 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of a Chinese dynasty of the period 618 to 907 CE, a time considered one of the most brilliant in Chinese history. China flourished as a stable, consolidated empire and the resulting prosperity and patronage created a Golden Age of Chinese painting, metalwork, ceramics, music, and poetry. Chang'an, with its masterful urban planning, remained the main Tang capital and a world center. Taizong (reigned 626-649) and Xuanzong (reigned 712-756) were important Tang rulers and patrons. Buddhism remained influential although it suffered periods of persecution during the Tang dynasty. Paintings from the caves at Dunhuang and stone pagodas such as the Great Wild Goose Pagoda (ca. 652) and the Small Wild Goose Pagoda (ca. 707) in Chang'an have survived. Monumental stone sculpture of the northern provinces displays the new tendency toward fuller, more sensual figures. This tendency also found in secular Tang sculpture, both stone and ceramic. The merging of Indian and Chinese sculpture styles is seen at the cave at Mt. Tianlong, created under the patronage of Empress Wu Zetian (reigned 690-705). Painting, which flourished during the Tang, was dominated by the secular landscape tradition. Li Sixum and Li Zhaodao, father and son, and Wang Wei are three painters' names known to us; probable copies of their work exist. Wang Wei's work, influential for later artists, was intimate and melancholy while the work of Li Sixum and Li Zhaodao features the bright greens and blues of many Tang landscapes. Chinese portrait painting, begun in the Han dynasty, was refined in the Tang by such artists as Wu Daozi. Tang ceramics include sancai earthenware figurines and vessels, typically used as tomb objects, white porcellanous wares such as the well-known Xing ware of Henan province, and the jadelike Yue celadons of Zhejiang province. The use of metal oxides in underglaze decoration was developed in Hunan and Sichuanh provinces and porcelain, although not fully exploited until later, has its origins in the Tang period. Tang decorative arts were influenced by Middle Eastern and other foreign trends during the Tang dynasty, leading to new styles in ceramics and metalwork. For instance, colorful glazed earthenware objects such as ewers and rhytons were made to resemble Persian silverwork and Persian weft patterning were introduced to Chinese textiles. China, in turn, exported its pottery, silk, and printing and paper technology. The Tang dynasty was succeeded by the Later Liang dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tang"@en .

aat:300018422 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period in Chinese history between the fall of the Tang dynasty (907 CE) and the founding of the Sung dynasty (960 CE), when five dynasties followed one another in quick succession in northern China. They all had their capital at Kaifeng in Henan province. The southern regions experienced more prosperity and peace than the north and subsequently literature, painting, metalwork, relief sculpture, textiles, and ceramics all flourished in the south. It was also an important transitional period for ceramics in the northern areas; prosperous ding kilns were located in Hebei."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Five Dynasties"@en .

aat:300018425 a skos:Concept ;
    skos:definition "Refers to a Northern Chinese dynastic culture, style, and period dating to 907 to 1125; it was founded by the proto-Mongolian Khitan people. It was contemporary to the Five Dynasties and Northern Song dynasty in the south. Based on the Buddhist idea of the five-fold structure of the universe, there were five capitals. The Khitan were a nomadic people that had little artistic tradition of its own. The artwork produced in this period was influenced by Tang forms and techniques. Liao architecture displays Tang influence and an adherence to Buddhism. Extant buildings include the Bai ta (White Pagoda) at Balin in Inner Mongolia, the Mu ta (Timber Pagoda) in Ying xian in Shanxi province, the oldest surviving timber pagoda, and the library for the Bhagavad sūtras (ca. 1038) of Huayan Lower Temple, Datong, also in Shanxi province. The last structure also contains 32 original Liao statues and wooden scripture cabinets in pavilion form. Liao ceramics were likewise influenced by those of the Tang period, although tomb excavations show that Song and other wares were imported as well. Gold and silver objects were also made using Tang and Song metalworking and gilding techniques. The Khitan were defeated by the invading Jin who went on to overthrow the Northern Song. Remnants of the Liao dynasty survived as the Western Liao in an area around the Tian shan range; it was later defeated by Genghis Khan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liao"@en .

aat:300018427 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating to 960 to 1279 CE. It was a time of social, economic, and artistic invention and transition; in particular, an unsurpassed refinement was achieved in many of the arts. As society shifted away from being one of aristocrats towards one of meritorious commoners, the ruling class sought to shore up their power. For instance, emperors promoted the painting of themes associated with dynastic legitimacy and stability. The Song emperors were among China's most culturally enlightened rulers and many were even accomplished artists in their own right. Since the Song emperors were less powerful than their Han and Tang predecessors and because they maintained a tenuous peace with their hostile neighbors, the art of this period is introspective. The Song period is best known for landscape painting, although ceramics, sculpture, and architecture also flourished. Clay and wood often replaced stone for sculpture, allowing for softer, more lifelike figures. Song architecture is notably elongated and thin with curved roofs and a distinctive Song spire. Pagodas were first constructed of masonry during this period. There are two divisions within this style and period: Northern Song, dating to 960 to 1127, and Southern Song, dating to 1127 to 1279."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Song"@en .

aat:300018432 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating to 960 to 1127 CE. During the Northern Song period there was a new interest in antiquity and the beginnings of Chinese archaeology. Printing became more widespread and with it the publication of reference works. Imperial patronage was very noteworthy and influential at this time. For instance, the emperor Taizong (reigned 976-997) had an impressive painting and calligraphy collection and Huizong (reigned 1101-1125) commissioned catalogues of his own enormous collection. Huizong also established a school of painting as a branch of the Hanlin Painting Academy. Landscapes became more important with such notable artists as Fan Kuan, Juran, Guo Xi, Dong Yuan, and Li Cheng. The distinction between court painting and that of the Daoist literati became more pronounced. Northern Song ceramics are characterized by simple shapes, pure color, refined decoration, and technical perfection. Ding, Ru, Jun, and northern celadons made at Linru and Yaozhou were Northern Song wares patronized by the court. Sculpture became less symbolic and figures became more lifelike. Expensive defense and imperial extravagance led to a weakened dynasty; after incursions by the Jin, Huizong's successor moved south of the Huai River to establish the Southern Song dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Song"@en .

aat:300018436 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic the culture, style, and period dating to 1279 to 1368. The dynasty was founded by the Mongol Kublai Khan (reigned 1260-1294), reuniting all of China into a empire that extended west as far as modern Poland and Hungary. While not great patrons of the arts, by reuniting China, expanding trade, and by not imposing stylistic demands, different traditions and influences were brought together and freely used. Innovations occurred particularly in the applied arts of porcelain and lacquer. During this time the Silk Route was reopened and Europe's interest in China began to develop. In response to foreign domination, educated Chinese withdrew into tradtions of their native past, with many scholars rejecting government service. The school of literati painting became dominant in the realm of painting, with artists emphasizing individual and calligraphic expression in contrast to the decorativeness of official painting. The most important Yuan masters were Huang Gongwang, Wu Zhen, Ni Zan, and Wang Meng, all of whom were literati objectors to Mongol rule. A noteworthy exception was Zhao Mengu, the most important Yüan calligrapher, who served the Mongols and was president of the Hanlin Academy. In the realm of ceramics, Middle Eastern influence stimulated exuberant blue-and-white decoration; Middle Eastern merchants also commissioned enormous Longquan celadons. Much Buddhist sculpture was commissioned during the Yüan period, with Tantric, multi-limbed figures revealing the Mongol preference for the lamaist art of Nepal and Tibet. The chiselling technique in silverwork, associated with the silversmith Zhu Bishan, developed at this time; Yüan carved lacquer was also produced. The Mongols made contributions to architecture, with the buildings of Beijing, the Mongol capital, built on a grand and massive scale; the city plan was adapted by the later Ming and Qing dynasties. The Yüan dynasty declined after the death of Kublai Khan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yüan"@en .

aat:300018438 a skos:Concept ;
    skos:definition "Refers to the culture, period, and styles associated with the Chinese dynasty dating from 1368 to 1644. It is characterized by being a period of stability, prosperity, and by a renewal of Chinese culture and national consciousness. Styles in this period developed largely from a system of court patronage of the arts that generally encouraged a high level of workmanship, but conservatism in design and technique. The major art produced during this period includes cloisonné, enamelware, bronzework, lacquerwork, furniture, and small ornamental carvings of jade, ivory, wood, and porcelain. In ceramics, earlier styles, including, blue-and-white wares, were refined in technique and decoration. In architecture, the earlier experiments of the Sung period were abandoned, in favor of more traditional designs, including the construction of the Forbidden City in Peking. In painting, schools of professional academics/artists and \"literati\" encouraged independent, personal styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ming"@en .

aat:300018439 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the rule of emperor Hongwu, founder of the Ming Dynasty in China. The re-establishment of a powerful native dynasty brought about the political and economic support for the arts in all fields. Painting, pottery, lacquer and textiles were more elaborately developed than ever before."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hongwu"@en .

aat:300018443 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of emperor Yung-lo, 1403-1424. The style is characterized by blue and white wares of fine quality and craftsmanship. It was during this period that the practice of adding reign marks to wares began."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yongle"@en .

aat:300018447 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of emperor Hsuan-te, 1426-1435. The style is characterized by blue and white wares with great attention to strong lines and a balance of design in proportion to the entire surface. There is a depth and intensity to the thickly applied blue paint, and an undulating appearance to the glazed surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xuande"@en .

aat:300018455 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the later reigns of the Ming Dynasty from 1465-1487, in probably the Ch'eng Hua region of China. The style is typically characterized by the use of the so-called three color type: underglaze blue with an overglaze of green and red. Later wares used five-color decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chenghua"@en .

aat:300018457 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the middle part of Ming dynasty, 1488-1505. The style is characterized by typically floral designs in white against a deep blue ground, in blue against a yellow ground, and in coffee brown against a white ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hongzhi"@en .

aat:300018459 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of emperor Cheng-te, 1506-1521. The style is characterized by blue and white wares with Arabic or Persian inscriptions, a result of the Muslim-influenced government. They are typically marked with a six-character mark in underglaze blue, with others bearing only a four-character mark. These wares ceased to be made after Cheng-te's death, with similar pieces of lesser quality made during succeeding reigns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zhengde"@en .

aat:300018461 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the late Ming Dynasty, 1522-1566. The style is characterized by both blue and white and enamelled ploychrome ware, with the introduction of ewers and gour-shaped vessels. On larger vessels, there was a tendency to break up the surface into a series of formal and informal bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jiajing"@en .

aat:300018463 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the late Ming Dynasty, 1567-1572. The period is so short that no specific decorative style can accurately be associated with it. The blue and white and enamelled polychrome wares of the preceeding period continued without interruption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Longqing"@en .

aat:300018465 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the emperor Wasn-li, 1573-1619. The style is characterized by a departure from prescribed patterns and motifs, such as the imperial dragon or phoenix, resulting in free form decorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wanli"@en .

aat:300018469 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the emperor T'ie-chi, 1621-1627. The style is characterized by polychrome and blue and white wares with Japanese motifs designed to please Japanese tastes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tianqi"@en .

aat:300018471 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the last emperor of the Ming Dynasty, 1628-1643."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chongzhen"@en .

aat:300018478 a skos:Concept ;
    skos:definition "Refers to the the culture, style, and period associated with the reign of the Quing dynasty, dating from 1644 to 1911. Beijing remained the Chinese capital and was embellished with large scale, brightly colored buildings in brick and stone. In ceramics, contrasting styles of elaborate, opaque overglaze wares and monochrome wares were developed. In painting, an official academy was established, continuing the traditional landscape style of the Four Wangs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qing"@en .

aat:300018480 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the Shunzhi Emperor, 1638-1661), third emperor of the Qing dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shunzhi"@en .

aat:300018482 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of emperor K'ang-hsi (1662-1722). The style is characterized by refined wares, most notably a series of plates that are extremely white, thin and translucent. Images include birds on branches and beautiful women, and the flattened rim is decorated with a diaper pattern in red with cartouches bearing inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kangxi"@en .

aat:300018484 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of th eYongzheng Emperor, 1678-1735."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yongzheng"@en .

aat:300018486 a skos:Concept ;
    skos:definition "Refers to the style of art collected and produced by the emperor, artist Ch'ien-lung (reigned 1736-1795). His collection focused on porcelain, bronzes, jades, calligraphy and rare books. In ceramics, the style is characterized by the production of fine famille rose porcelain. In painting the style is characterized by detailed bird and flower painting that were the products of both the emperor and court painters. The emperor's fascination with Europe led to the development of a Rococo-Chinese style in architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qianlong"@en .

aat:300018488 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the emperor Chia Ch'ing, 1796-1820. The style is characterized by wares such as snuff bottles, figures, and bottles in varying styles featuring painted blue and copper-red designs, enameling of all kinds, and monochrome glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jiaqing"@en .

aat:300018490 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with Tao-kuang in China during the Qing period (1644-1911). The style is characterized by rose-colored enamel ware, typically bearing the six character mark of emperor K'ang-hsi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daoguang"@en .

aat:300018492 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the Xianfeng Emperor, 1831-1861, Emperor of the Manchu-led Qing Dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xianfeng"@en .

aat:300018494 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of T'ung Chih, 1862-1874. The style is characterized by the revival of Kangzhi wares for export, and varying styles for court use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tongzhi"@en .

aat:300018496 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the Guangxu Emperor, 1871-1908), eleventh emperor of the Qing dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guangxu"@en .

aat:300018498 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the reign of the Xuantong Emperor, 1908-1912."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xuantong"@en .

aat:300018501 a skos:Concept ;
    skos:definition "Painting styles belonging to Chinese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese painting styles"@en .

aat:300018502 a skos:Concept ;
    skos:definition "Refers to the work of a group of artists working in the European style for European patrons in 18th to early 19th century. The style is characterized by its subject matter such as pictures of occupations, such as porcelain-making and tea-growing, views of Canton, and botanical drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canton"@en .

aat:300018503 a skos:Concept ;
    skos:definition "Refers to the work of a group of Chinese artists who withdrew from the official schools and painted on their own in protest against the Muchu rule after the fall of the Ming dynasty in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Individualist"@en .

aat:300018504 a skos:Concept ;
    skos:definition "Ceramics styles belonging to Chinese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese ceramics styles"@en .

aat:300018505 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in the Kiangsi province of China during the Yuan dynasty characterized by a pale or sky blue color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qingbai"@en .

aat:300018506 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China during the Sung dynasty, charactrized by a heavy body and a thick deep lavender glaze to which random purple splashes were often added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jun"@en .

aat:300018508 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China at the Imperial factory at Ju Chou, Honan province, during the Sung dynasty from 1107 to 1127. The style is characterized by a buff-colored body covered with a fine glaze of pale lavender which is closely crackled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ru"@en .

aat:300018509 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China which formed part of the cargo of Portuguese carracks captured on the high seas by the Dutch in 1600 and taken to Holland for sale. The style is characterized by a blue underglaze. Kraak was made during the reign of Wan-li (1573-1619), and was later copied in tin-enamelware in Delft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kraak"@en .

aat:300018511 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China during the T'ang dynasty (618-906 BCE), characterized by streaks and spots of three colors, typically dark blue, turquoise and aubergine. The term also refers to pottery made during the Ming and Ching dynasties (1368-1912), made with the same three colors, but separated by clay ridges outlining the pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sancai"@en .

aat:300018514 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China during the Ming dynasty (1368-1644) in the provinces of Fukien and Kwangtung, and supposedly shipped from the port of Swatow. The style is characterized by both blue-and-white and multicolored wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swatow"@en .

aat:300018515 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China characterized by its translucent ivory white color, and carved designs, produced at Ding Zhou in the Hebai province of China from the 10th to the 14th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ding"@en .

aat:300018517 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China dating from the Ming period (1368-1642), especially during the reign of Wan li (1573-1619). Originally, the style was characterized by the use of white porcelain decorated with five colors; apple green, iron red, yellow, aubergine, and violet blue, but the name came to be applied to all types of enamel decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wucai"@en .

aat:300018519 a skos:Concept ;
    skos:definition "Nationality, periods, cultures, and styles found in Japan, either in historical times or in the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese"@en .

aat:300018521 a skos:Concept ;
    skos:definition "Cultures, styles, and periods of Japan that date to prehistoric times, roughly from 8000 or earlier to 800 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese Prehistoric"@en .

aat:300018523 a skos:Concept ;
    skos:definition "Refers to the period and style that developed around 10,000 to 300 BCE, named for the cord-marked Jōmon pottery discovered at most sites. Lasting more than 8, 000 years, the period witnessed early developments in Japanese culture, such as shamanistic practices, fishing and gathering techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jōmon"@en .

aat:300018524 a skos:Concept ;
    skos:definition "The earliest stage of the Jōmon period. It represents a transitional stage from the Mesolithic to Neolithic age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Jōmon"@en .

aat:300018525 a skos:Concept ;
    skos:definition "Refers to the phase of the Jōmon period from around 5000 to around 3500 BCE that saw the development of small villages, cord-marked pottery, wicker baskets, and the use of stone tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Jōmon"@en .

aat:300018526 a skos:Concept ;
    skos:definition "Refers to the phase of the Jōmon period from around 3500 to 2500 BCE. The period witnessed the development of large semi-sedentary villages, pottery with elaborated raised line decoration, and the increased production of figurines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Jōmon"@en .

aat:300018527 a skos:Concept ;
    skos:definition "Refers to the phase of the Jōmon period from around 2500 to around 1000 BCE, also dated from around 2000 to around 1000 BCE. The period witnessed the development of a vigorous marine economy, pottery with geometric, grooved-line decoration, and the increased production of more three-dimentional figurines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Jōmon"@en .

aat:300018528 a skos:Concept ;
    skos:definition "Refers to the phase of the Jōmon period from around 1000 to 300 BCE, that saw the development of elaborate pottery, notably the Kamegaoka-typer style along the Pacific Coast, that strongly suggest contact with western Japan and the Korean penninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Final Jōmon"@en .

aat:300018529 a skos:Concept ;
    skos:definition "Refers to the culture and period from around 300 BCE to around 300 CE in Japan, so-named for the discovery of a characterisitc pottery found in the Yayoi section of Tokyo. This period saw the development of wet-rice agriculture, the use of bronze and iron, and the production of unglazed earthenware in a variety of shapes and decoratives styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yayoi"@en .

aat:300018533 a skos:Concept ;
    skos:definition "Refers to the period and culture in Japan, evident from around 250 CE and characterized by a highly organized aristocratic society, advances in armor and iron weapon technology, prominence of horse-riding warriors, and distinctive large, earthen, keyhole-shaped tumuli or burial mounds that were surrounded by moats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kofun"@en .

aat:300018543 a skos:Concept ;
    skos:definition "Japanese culture, period, and style that developed from 552 to 645 CE, coinciding with the rise of Buddhism. In sculpture, figures of mostly deities appear in styles that range from an early use of flat planes, elongated proportions, and sharply contoured lines to later shift toward smaller, gentler, figures which emphasize verticality. In painting, the style is characterized by the use of red and black colors created by mixing lacquer with pigment, and yellow and green colors resulting from a mixture of lead oxide and vegetable oil. Painting from this period features light and graceful figures and landscape. In architecture, the style is characterized by the emphasis on symmetry and axial balance with the use of post and lintel construction, tile roofs, and elaborate bracketing to transmit weight and thrust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asuka"@en .

aat:300018545 a skos:Concept ;
    skos:definition "Refers to the period and style that developed from 710-794 CE, when the first permanent capital was in Nara, marking the height of concentrated efforts to emulate Chinese culture. The period is characterized by the production of small hollow core laquer figures and by the construction of large mountain temples consisting of halls and pagodas arranged in harmony with nature, marking a shift from the rigid plans of the Asuka period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nara"@en .

aat:300018546 a skos:Concept ;
    skos:definition "Refers to the phase of the Nara period that developed from approximately 645 to 710. The style is represented by sculpture, primarily life-size bronze and smaller clay figures with slender lines, complicated drapery folds, and serene expressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Nara"@en .

aat:300018548 a skos:Concept ;
    skos:definition "Refers to the phase of the Nara period that developed from approximately 756 to 784. In sculpture, the style is characterized by a more weighty and dignified type of figure, with an over-simplified articulation of form and less defined drapery. In bronze, the greatest achievement during this period was the Great Buddha of Tōdaiji, which does not exist today. Small bronzes associated with Tōdaiji, such as lanterns, are fine examples of low relief casting and feature flying drapery and fine lines. Paintings from this period are few, however records from the Shōsōin tell of a high degree of sophistication in screen painting. Scroll paintings from this period were done in a style already antiquated in the eighth century, with the narrative picture placed directly over text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Nara"@en .

aat:300018550 a skos:Concept ;
    skos:definition "Refers to the Japanese period and style that developed from 794 CE to 1185 CE, coinciding with the move of the capital to Heian (now Kyoto) and the rise of Tantric Buddhism imported from China. The style is characterized by the prominence of mandalas in imagery and the introduction of new types of figures, such as buddhas wearing a crown and jewels, and multiple-limbed deities with fierce expressions to indicate supernatural powers. The architecture of the period is characterized by large mansions built on a rectangular plot of land, consisting of pavilions and halls connected by roofed corridors and surrounded by earthen walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heian"@en .

aat:300018551 a skos:Concept ;
    skos:definition "Refers to the phase of the Heian period that developed from approximately 794 to 898. In painting and sculpture, the style is characterized by powerfully built figures with forbidding expressions and strong, dynamic lines. In architecture, the style is characterized by small, irregular-plan temple complexes set in remote mountain settings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Heian"@en .

aat:300018558 a skos:Concept ;
    skos:definition "Refers to the period and style of art that developed during the rise of the Kamakura shogunate from 1185-1333. This period saw the rise of the provincial warrior class to a position political power, the establishment of a military government, the emergence of new sects of Buddhism and the spread of that religion from the aristocracy to the common people. In the arts, the style is characterized by dramatic, energetic wood figure sculptures, scrolls showing battles, and the rise of the Zenshuyo and Tenjinkuyo styles of architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamakura"@en .

aat:300018559 a skos:Concept ;
    skos:definition "Period and culture in Japan, dating approximately 1334-1392, during the formative years of the Muromachi era, when two imperial seats existed: in the North of Kyoto and the South of Yoshino. Two rival courts clamied the legitimate right to rule. The schism symbolized a transition in which the civil aristocracy of Kyoto lost their political and economic power to the provincial military class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nambokucho"@en .

aat:300018561 a skos:Concept ;
    skos:definition "Refers to the Japanese period and style of art that developed during the rise of the Asikaga shogunate (1338-1573). Although political unrest resulted from the Onin War (1467-1477), the period saw the development of the tea ceremony, flower arranging, the rise of Chinese influenced monochrome painting, and intricate laquer carvings. In architecture, the style is characterized by simple and austere structures, and the use of large landscape gardens designed after famous paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muromachi"@en .

aat:300018563 a skos:Concept ;
    skos:definition "Refers to the Japanese period and style that developed during the military dictatorship of Nobunaga and his successors, from 1573 to 1615. The most significant architectural expression of the period was the military castle in which the previously separate fortress and palace were combined into one architectural unit, characterized by massive masonry exteriors that contrast with opulently decorated interiors. Painting of the period is characterized by a decorative style that emphasizes rich textures and curving lines, gold backgrounds, and uncrowded compositions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Momoyama"@en .

aat:300018564 a skos:Concept ;
    skos:definition "Refers to the style and culture of Edo-speaking peoples living in Nigeria's Bendel state outside Benin City. While their languages are related, they are not all mutually intelligible. The Edo, however, all trace their origins to the Kingdom of Benin. Their ancestors migrated from Benin in a series of waves between the 9th and 18th centuries. These migrants intermixed with indigenous peoples and other settlers from neighboring areas, thus the arts of these peoples reflect a complex history of migration and cultural borrowing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edo"@en .

aat:300018567 a skos:Concept ;
    skos:definition "Period and style that coincides with the rule of emperor Mutsuhito, called Meiji, from 1868 to 1912. The period is characterized by a transformation from feudalism to a modern industrial state, taking western nations as a model. After the Vienna Exposition of 1873, artists were encouraged to produce traditional arts and crafts for export, such as carvings in wood and ivory and laquer. The art of the period also saw the influence of western art and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Meiji"@en .

aat:300018568 a skos:Concept ;
    skos:definition "Refers to the period and style that coincided with the rule of emperor Hirohito, called Showa, from 1926 to 1989. The period is one of complex and contradictory changes from parliamentary democracy into militarism and global war and finally to economic recovery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Showa"@en .

aat:300018569 a skos:Concept ;
    skos:definition "Refers to the period and style that coincided with the reign of Emperor Taisho, from 1912 to 1926. The period saw a rise in prosperity and industry during World War I and the beginings of democratic reform in the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taisho"@en .

aat:300018571 a skos:Concept ;
    skos:definition "Architecture styles belonging to Japanese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese architecture styles"@en .

aat:300018574 a skos:Concept ;
    skos:definition "Refers to the southern Chinese style of architecture introduced in Japan in the early Kamakura period (1185-1333) at the time of the reconstruction of the city of Todai-ji. The style is characterized by bold and simple forms and powerfully curving rooflines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daibutsuyo"@en .

aat:300018576 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that developed during the late 12th century. The style is characterized by a continuation of the Heian period practices of simple exteriors and richly polychromed interiors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wayo"@en .

aat:300018577 a skos:Concept ;
    skos:definition "Decorative arts styles belonging to Japanese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese decorative arts styles"@en .

aat:300018579 a skos:Concept ;
    skos:definition "Painting styles belonging to Japanese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese painting styles"@en .

aat:300018580 a skos:Concept ;
    skos:definition "Refers to a style of Japanese painting that flourished from the middle of the Edo period (1600-1868) to the Taisho period (1912-1926). It was inspired by the Chinese literati, or \"Wen ren,\" scholar-painting tradition, intended for a small, intellectual audience. Unlike other styles that developed in major Japanese studios, Nanga style includes varying techniques, styles, and subject-matter, linked by a loose tradition rather than by standardized rules. It is generally characterized by the combination of painting, poetry, and calligraphy, with a preference for subtle brushwork, monochromatic or subdued coloring, and abstraction of natural forms to convey highly personal views of nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nanga"@en .

aat:300018585 a skos:Concept ;
    skos:definition "Refers to the style of art connected with European missionaries and merchants in Japan during the 16th and 17th century, including Japanese artists painting in a Western style, European imported art, and traditonal Japanese art depicting Europeans. Taught by Jesuit priest Giovanni Niccolo in 1583, artists produced works in a traditional Western style, often religious in theme. Namban motifs include Western peoples, ships and rosaries and crosses, found on folding screens, flasks, and lacquer ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Namban"@en .

aat:300018589 a skos:Concept ;
    skos:definition "Refers to the term denoting Japanese style painting, first used in the mid-9th century to describe the works produced by Japanese artists that differed at first in subject matter, and latter in style, from paintings produced under Chinese influence. The present day usage of the term has taken on a much broader meaning, encompassing not only Japanese themes, but also formats and styles considered to be uniquely Japanese. Typical Yamato-e themes include the four seasons and pictures of famous places. There was also a strong link between Yamato-e and Japanese style poetry, the content often translated into images on folding screens and sliding doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yamato-e"@en .

aat:300018591 a skos:Concept ;
    skos:definition "Ceramics styles belonging to Japanese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese ceramics styles"@en .

aat:300018593 a skos:Concept ;
    skos:definition "Style of ceramics, first manufactured in the early 17th century, and so named for the distinctive type of clay found in the Arita region. Styles vary from early unglazed blue and white porcelain to colorful enamel ware perfected in the 1640s. Arita ware was produced in large quantities in the 17th century and mass-produced by the Meiji period (1868-1912)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arita"@en .

aat:300018594 a skos:Concept ;
    skos:definition "Style of blue-and-white porcelain manufactured at the Mikawachi kilns for the Prince of Hirado."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hirado"@en .

aat:300018595 a skos:Concept ;
    skos:definition "Style of Arita porcelain made from the beginning of the 18th century onwards, characterized by dense, crowded decorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Imari"@en .

aat:300018597 a skos:Concept ;
    skos:definition "Style of Japanese porcelain produced in the Arita district of Hizen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kakiemon"@en .

aat:300018598 a skos:Concept ;
    skos:definition "Style of porcelain manufactured in Kaga Province, now part of Ishikawa Prefecture from 1655."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kutani"@en .

aat:300018600 a skos:Concept ;
    skos:definition "Refers to the style of Kutani porcelain manufactured in the 17th century and painted in fine greens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ao Kutani"@en .

aat:300018601 a skos:Concept ;
    skos:definition "Refers generally to the ceramics produced in and around the city of Kyoto, with the exception of raku ware, made from the 8th century to the present. Productions from the 8th century are typically three-colored, lead-glazed ware and monochrome green wares from the 9th to the 11th century. By the mid-17th century, productions have polychrome glazes with decorative motifs often comprised of built up layers of enamel, giving a three-dimensional effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kyoto"@en .

aat:300018602 a skos:Concept ;
    skos:definition "Style of pottery produced at the Nabeshima clan’s kiln at Ōkawauchiyama (Hizen Provence, now Saga Prefect.) from ca. 1677 to 1871."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nabeshima"@en .

aat:300018607 a skos:Concept ;
    skos:definition "Pottery styles characteristic of Fukuchiyama in northern Kyushu from the early 17th century, and so named for Korean potter Chon'gye, known as Agano Kizo. Styles range from the use of a thick, creamy, white ash glaze and dark brown iron glazes in the early 17th century, to raku ware and the introduction of a bluish-green copper glaze in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agano"@en .

aat:300018608 a skos:Concept ;
    skos:definition "Style named for a Japanese center of ceramics production, from the end of the 12th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bizen"@en .

aat:300018610 a skos:Concept ;
    skos:definition "Style of stoneware manufactured from the early 17th century in Nagato Province, now Yamaguchi Prefecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hagi"@en .

aat:300018611 a skos:Concept ;
    skos:definition "Refers to the style of unglazed pottery manufactured at kilns in the Mie Prefecture 16th-17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iga"@en .

aat:300018614 a skos:Concept ;
    skos:definition "Style of glazed pottery manufactured at Karatsu, Hizen Province, in the late 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karatsu"@en .

aat:300018624 a skos:Concept ;
    skos:definition "Refers to the style of stoneware produced during the Momoyama and early Tokugawa periods. The style is characterized mainly by tea ceremony ware produced in the Seto region with rough surfaces and warm colored, simple glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oribe"@en .

aat:300018626 a skos:Concept ;
    skos:definition "Refers generally to a variety of styles of ceramics used for tea ceremonies and every-day use, made at kiln sites in Kagoshima Prefecture (formerly the Satsuma domain) in southern Kyushu, from the early 17th century to the present. Styles range from \"sharkskin\" ware with a grayish, light sepia or yellowish glaze and fine granular surface to fine iron-glazed teawares in the first half of the 17th century, copies of Sawankhalok ware, a Thai ware decorated with underglazed iron-oxide painting, from ca. 1700, and overglaze enamels from the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Satsuma"@en .

aat:300018627 a skos:Concept ;
    skos:definition "Refers generally to the style of glazed ceramic ware produced from the 12th century to the end of the 15th century. Early productions include ash-glazed bottles, bowls, dishes and jars with four small handles, similar to those produced in Sanage. In the 13th and 14th centuries, new kilns were built producing new shapes, patterns, iron glazed-wares and utensils for Buddhist rituals. Seto ware produced during the 15th and 16th century was mostly for household use, typically tea ceremony ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seto"@en .

aat:300018630 a skos:Concept ;
    skos:definition "Refers to the style of stoneware found in several villages in the Shigaraki valley in Southern Shiga prefecture, manufactured from the Kamakura period (1185-1333) to the present. Early productions were mainly vessels for domestic use such as narrow-mouthed jars and mortar bowls. In 1632, Shigaraki ware became the official ware for tea storage vessels for the Tokugawa Shogunate. Since the 19th century, production has shifted to various wares such as planters, braziers and sake jugs. Typically, the style is characterized by reddish brown and coarse grained wares, with white specks of feldspar or quartz that melt during firing and protrude from the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shigaraki"@en .

aat:300018631 a skos:Concept ;
    skos:definition "Refers to a variety of styles of ceramics produced in the Mino Province from the 7th century to the present. Early wares can be traced from Sue ware, but in the 12th century under the influence of the Sanage kilns, productions included large-mouth jars, small-mouth jars, and mortars. From the 15th to the mid-16th century, ash-glazed and iron-glazed utensils were produced. By the end of the 16th century, production was revolutionized by the introduction of multi-chambered kilns, resulting in tea ceremony wares that included green glaze and feldspathic glaze, with a wide variety of painted shapes and decorations. By the 19th century, underglazed blue decorated wares were produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shino"@en .

aat:300018635 a skos:Concept ;
    skos:definition "Refers to the style of ceramics produced at sites in or near present-day Nogata and Fukuoka, Fukuoka Prefecture, from 1601 to almost the end of the Edo period (1600-1868). The style is characterized by the production of everyday utensils and tea ceremony ware. Early wares are characterized by thick-walled everyday ware with sea slug glazes or opaque white-straw or wood-ash glazes. During the Enshu period (1630-1665), productions focused on elegant, thin-walled tea ceremony ware with a characteristic toffee-brown glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Takatori"@en .

aat:300018636 a skos:Concept ;
    skos:definition "Refers to the style of ceramic produced in the southwestern part of the ancient province of Tamba (present-day town of Konda, Hyogo Prefecture). Archeological data is limited but productions appear to have begun as early as the Kamakura period (1185-1333), continuing to the present. Early productions are characterized by thick, asymmetrical storage vessels produced by the coil method, with an accidental greenish glaze, resulting from falling wood ash. During the 17th century, improved technology increased speed of production and resulted in more variety and finer shapes. Wares from this period are characterized by reddish brown, black or amber glazes and simple designs. During the Edo period (1600-1868), productions included elegant tea ceremony wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tamba"@en .

aat:300018637 a skos:Concept ;
    skos:definition "Refers to the style of ceramics produced from the early half of the 12th century to the first half of the 16th century, with some production continuing to the present. The style is characterized by strong, heavy wares, such as wide-mouth jars, bowls, and vases of dark reddish brown with a dark olive, natural ash glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tokoname"@en .

aat:300018645 a skos:Concept ;
    skos:definition "Refers to a style of gray stoneware manufactured from the 5th to the 10th centuries. Originating in the southern part of the Korean peninsula, the style immigrated to Japan in the 5th and 6th centuries, where it was called iwaibe doki or Chosen doki, until the 1950s. The style is characterized by the production of coil-made vessels fired at temperatures exceeding 1,000 degrees centigrade (1,832 degrees Fahrenheit) resulting in a gray color. Sue wares are typically unglazed except for the natural ash glaze occurring during the firing process and decorated with simple combed or punctate designs. In the Hein period (794-1185), productions included new glazed versions using native ash glaze and green or three-color glazing techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sue"@en .

aat:300018649 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters working in Akita in northern Honsu in the mid-18th century. Developed by Satake Shozan (1748-1785) and Odano Naotake (1749-1780), the style is characterized by a mix of naturalistic detail and Western illusionistic methods using traditional Japanese pigments on silk or paper and an overall surface covering of oil and resin. Finished paintings were typically based on sketchbook drawings of precise observations of flowers, trees and birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akita Ranga School"@en .

aat:300018651 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters founded by Hasegawa Tohaku (1539-1610), probably located in Kyoto in or near Hompoji, a Nichiren temple affiliated with Tohaku's family. The style is characterized by typically large-scale works involving many rooms, with Chinese themes and motifs. It appears that Tohaku had four artist sons, but the school disappeared by the end of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hasegawa School"@en .

aat:300018652 a skos:Concept ;
    skos:definition "Refers to the work of a family of painters, started by Kaiho Yusho, that lasted for seven generations until the end of the Edo period (1600-1868). Yusho's style was highly individualized and dramatic, typically wall screens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kaiho School"@en .

aat:300018653 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters patronized from the late Muromachi period (1333-1568) through the Edo period (1600-1868) by successive military governments. Founded by Kano Masanobu (1434-1530) in the mid-15th century, the school emphasized the conservative Chinese Southern Song and Yuan academic styles, and grew into a large network of artists who held control over public and private commissions from the shogunate, monasteries and merchant classes for over 200 years. Kano artists produced a wide variety of works from fans to screen painting to hanging scrolls and votive plates. The Kano school was also well known for its bold style of ink painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kano School"@en .

aat:300018654 a skos:Concept ;
    skos:definition "Refers to the work of a school of Buddhist painters who worked for the Kasuga shrine at Nara during the mid-13th century. The style is characterized thin wire-like lines, flat surfaces, and bright colors such as orange-red, deep blue and green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kasuga School"@en .

aat:300018655 a skos:Concept ;
    skos:definition "A school or style of ukiyo-e founded by Miyagawa Shunsui that is known for reviving portrait paintings and prints of actors, wrestlers, and women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Katsukawa School"@en .

aat:300018656 a skos:Concept ;
    skos:definition "School or style founded by Kitao Shigemasa, and is known for book illustration, particularly with erotic subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kitao School"@en .

aat:300018658 a skos:Concept ;
    skos:definition "Referes to the style of painting that flourished in the Kyoto area in the late 18th and 19th centuries. Founded by Maruyam Okyo and further developed by his pupils, the style emphasized naturalistic depiction of nature and urban scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maruyama School"@en .

aat:300018660 a skos:Concept ;
    skos:definition "Refers to the work of a school of painting that specialized in the native Yamoto-e style from the early 15th to the later 19th century. Tosa School painters worked primarily for the imperial court and specialized in courtly themes and scenes from classical literature. The style is characterized by fine, delicate lines, attention to detail, lavish color, and flat, decorative compositions. The Tosa style exerted a wide influence on other schools of painting, especially during the Edo period (1600-1868)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tosa School"@en .

aat:300018661 a skos:Concept ;
    skos:definition "Refers to the work of a line of painters descended from the famous artist Sesshu Toyo (1420-1506). Founded in Kyoto in Unkoku Togan (1547-1618), the school first focused on Kano school painting methods, but later left Kyoto to follow the brush style of Sesshu. The school survived until the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unkoku School"@en .

aat:300018662 a skos:Concept ;
    skos:definition "School or style associated with a group of artists surrounding Utagawa Toyoharu, including Hiroshige. The Utagawa School was influential and was the most popular print house in 19th century Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Utagawa School"@en .

aat:300018663 a skos:Concept ;
    skos:definition "Sculpture styles belonging to Japanese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese sculpture styles"@en .

aat:300018664 a skos:Concept ;
    skos:definition "Refers to the style of sculpture developed by the artist Jocho (d. 1057). The style is characterized by the introduction of the joined-wood technique which allowed for greater freedom and delicacy of expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jocho"@en .

aat:300018667 a skos:Concept ;
    skos:definition "Refers to style named after the sculptor Kuratsukuri-no-tori (active around 600-630 BCE). The style is characterized by conventionalized, symbolical, symmetrical forms with a strong influence of the Chinese northern Wei style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tori"@en .

aat:300018668 a skos:Concept ;
    skos:definition "Culture and style of peoples from the East Asian peninsula of Korea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Korean"@en .

aat:300018669 a skos:Concept ;
    skos:definition "Periods related to Korean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Korean periods"@en .

aat:300018680 a skos:Concept ;
    skos:definition "Refers to the period that coincided by the rule of three families in Korea, from 37 BCE - 668 CE. The ruling families consolidated their authority by abolishing the council of clans and passing on the title of ruler first from brother to brother and then from father to son. Notable artifacts remaining from the period include richly decorated tombs that show Chinese influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Three Kingdoms"@en .

aat:300018682 a skos:Concept ;
    skos:definition "Refers to the period that coincided with the rule of the Ko family in Korea, from 37 BCE - 668 CE. During this period, kings and noblemen built thousands of tombs from P'yong-yang to Manchuria, containing vast quantities of funerary objects and frescoes illustrating everyday life. In the last quarter of the 4th century, Buddhism replaced Shamanism, and effigies of the Buddha of both metal and pottery became more widespread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koguryo"@en .

aat:300018686 a skos:Concept ;
    skos:definition "Refers to the period that coincided with the rule of the Kim family who set up the kingdom of Silla in Korea, from 57 BCE - 668 CE. Although political and artistic development was slower than of that its neighbors, famous tombs such at those of the Golden Crown and the Golden Bell contained precious objects such a gold crowns, jewels, metal vases and fine pottery. Architecture of the period is known from pagodas, lanterns, and steles and the oldest surviving astronomical observatory in the Far East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Silla"@en .

aat:300018693 a skos:Concept ;
    skos:definition "Period and culture of the Korean dynasty that ruled the Korean peninsula from 1392 to 1910, founded by Yi Sŏng-gye, posthumously known as King T’aejo (reiged 1392-1398). It is characterized by the establishment of Neo-Confucianism as the official ideology, encouragement of a modest and practical lifestyle, and abandonment of patronage for more extravagant art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yi"@en .

aat:300018695 a skos:Concept ;
    skos:definition "Styles belonging to Korean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Korean styles"@en .

aat:300018696 a skos:Concept ;
    skos:definition "Pottery styles belonging to Korean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Korean pottery styles"@en .

aat:300018699 a skos:Concept ;
    skos:definition "Historical Korean stoneware style that emerged soon after the establishment of the Choson dynasty in 1392. Buncheong, also transliterated as Punch’ong, evolved from the celadon tradition it replaced, using the same raw materials and essentially the same decorative vocabulary while favoring a coarser, less processed technique and a relatively bold and dynamic style. Gray bodied ceramics are coated with a white slip, and covered in a green, semi-translucent glaze. Buncheong ware is noted for its innovative surface decoration, which includes inlaying, stamping, incising, and sgraffiti. It was replaced in popularity by white porcelain, disappearing by the end of the sixteenth century; but has enjoyed a revival in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Punch'ong"@en .

aat:300018701 a skos:Concept ;
    skos:definition "Refers to the cultures that flourished in the region of the modern nation of Malaysia composed of the Malay Peninsula and the eastern region of the island of Borneo. The style of art in this region is a synthesis of indigenous and external cultural influences from China, India, the Arabic world, and the West facilitated through colonization and trade. Painting and sculpture in this region rarely depict the human figure because of Islamic religious restrictions. Production in decorative arts is more extensive, featuring batik cloths and other elaborate textiles, silverware, handmade kris, wood carvings, basketwork, and other various handicrafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malaysian"@en .

aat:300018704 a skos:Concept ;
    skos:definition "Refers to the cultures and styles of Indonesia, reflecting the blend of various regional cultures from the Southeast Asian mainland and Oceania. The style is generally driven by the philosophies of Buddhism, Hinduism, and Islam. Sculptural production in the region generally features megalithic monuments such as menhirs, dolmens, stone sarcophagi, terraced burial mounds, large stones carved into the shape of animals and humans, and stone skull troughs. Early styles of sculpture in the region feature smooth planes, convexity, impassive expressions, and lack of movement. Ornamental works from this region imitate Chinese Chou and pre-Han works and feature bronze drums with molded flanges and relief ornamentation consisting of stylized masks with ear piercings. Indian-influenced works feature intricate bronze Buddhas and bodhisattvas. In architecture, the style features temple complexes known as tjandis and candis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indonesian"@en .

aat:300018705 a skos:Concept ;
    skos:definition "Periods related to Indonesian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indonesian periods"@en .

aat:300018706 a skos:Concept ;
    skos:definition "Designates the prehistoric culture and period (4th to 1st centuries BCE) and culture of the Indochina region of Southeast Asia. Stylistic developments of this period are generally viewed as the basis of the civilization of the region and are later modified by Indian and Chinese influences. The period is most noted for the development of large stone monuments as religious shrines. Bronze works flourished in this period and feature ritual kettle drums, household wares, masks cast by the cire perdue method, ceremonial axes made as emblems of power, and elaborate drum designs of varied sizes. Bronze productions were often adorned with human and animal relief patterns that mimicked designs woven into textiles. The spiral was a popular motif in this period, appearing as decorative touches on textiles and bronzes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dông-Son"@en .

aat:300018711 a skos:Concept ;
    skos:definition "Refers to the period and style surrounding the culture of the island of Bali. The style reflects rich religious and political history based on Hindu Saivism, Buddhism, Islam, ancestor worship, tantric rites, and animism. Beliefs in reincarnation and the thematic idea of humanity's insignificance in the face of nature drive the style. In painting and in drawing, the style features rock wall works, and later under European influences, naturalistic and romantic paintings of stylized animal and human figures set against double or triple horizons made in crayon, oil or gouache media. Sculptural works feature stone constructions of deified representations of Bali rulers, animal and demon figures, and Hindu and Buddhist statues. Bone and tortoiseshell are also used in carvings. Ceramic arts in this style feature utilitarian earthenware and abstract figurines, both human and mythical. In jewelry production, rubies, baroque pearls, ivory, red coral, chasing, and repoussé were used in designing bracelets, necklaces, signet rings, heirloom keris, headdresses, and hair pins. Court jewelry in this style exhibits complex iconography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balinese"@en .

aat:300018715 a skos:Concept ;
    skos:definition "Culture and style of art and literature in Bali, from the 9th to the 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Javanese period"@en .

aat:300018717 a skos:Concept ;
    skos:definition "Refers to the style and period named for the culture of the island of Borneo. The style is noted for its decorative arts, featuring detailed, elaborate body tattoo designs, gilded bangles and medallions showing intricate iconography, beadwork, and armbands adorned with locks of hair or animal tusks and claws, and for its stoneware, featuring brown-glaze jars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bornean"@en .

aat:300018719 a skos:Concept ;
    skos:definition "Refers to the style named for the Indonesian island of Sulawesi. Sculptural productions in this style include bronzes constructed in the Indian Amaravati style, Buddha statues dressed in robes with one shoulder exposed, terracotta figures, monoliths featuring outlines of male figures, tau-tau wooden images of ancestors, life-size figures in cliff caves dressed in ceremonial garments, and carved images of the sacrificial buffalo and the Tree of Life symbolizing fertility. In crafts, the style features baskets made from bamboo and lontar palm leaves and covered in layers of red and black lacquer and gold leaf. Lapidary styles feature bracelets, earrings in the shape of an open oval with reflexed ends, and hair pieces made from pearl, gold, silver, and embellished metal plates. Domestic architectural styles feature compact houses with roofs in the shape of arcs and a support system based on two vertical posts erected around the exterior of the house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sulawesi"@en .

aat:300018721 a skos:Concept ;
    skos:definition "Refers to the period and style generally associated with the island of Java. In sculpture, the style is characterized by bronze works heavily influenced by the Dông-son and Indian cultures. Bone and tortoiseshell are heavily used in carvings. As Islam spread throughout Java in the 15th century, sculptural styles featured deeply carved reliefs of dynamic but less refined movement and exhibited religious themes of deliverance and redemption. The architectural style of this period features the candi, a temple complex generally featuring a roof structure constructed from layered stone adorned with turrets, circular moldings around the base, cellas, and sculptures of banaspati heads. In lapidary production, garnets, crystals, pearls, ivory, and amethysts are used in bracelets and neck pendants; court jewelry features carved iconography. Manuscript illumination also appears in Java depicting Islamic subject-matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Javanese"@en .

aat:300018723 a skos:Concept ;
    skos:definition "Refers to the regional style of Central Java. Decorative arts and costumes of this region feature the use of teritik to outline motifs, textiles worn as headcloths, large ceremonial wraps and sashes, and kain kembangan floral and plaid motifs. The textile method of production known as ikat is used as a form of patterning in which portions or patterns of yarn are tied off to resist the dye. Court dress styles featured appliqué on imported silk textiles positioned over the plain central lozenge area of a breast-cloth and ceremonial wraps. In sculpture, the style features the earliest examples of stone monuments and candis, rare figures of Hindu deities, relief panels that depict rigid, clockwise narrative sequences, and Buddha statues seated on lion thrones. Religious sculptural programs were driven by the elitism of Buddhism, resulting in a preponderance of Buddhist iconography and art. Unlike styles in other regions of Java, this style has little tradition of inscribed stone images. In architecture, the style features stepped sanctuaries, truncated pyramid structures, and makara ornaments that adorn staircases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Javanese"@en .

aat:300018734 a skos:Concept ;
    skos:definition "Refers to the regional style of East Java. Sculptural works predominantly follow the Wayang style reflecting the Balinese folk tradition of shadow puppet theatre and is evidenced in relief panels in East Javanese temples from the 13th and 14th centuries. In textiles, especially in batiks, the style is distinguished by the predominance of a red dye known as Turkey red. With the influx of Islam into Java, the architectural style represented a synthesis between East Javanese and ancient pre-Hindu Balinese traditions, featuring iconography, tiered roofs, and the candi blntar entrance way to an outer courtyard of a temple. Decorative arts in this style feature fresh and dried flowers as garment decoration, gilded combs, and elaborate jewelry designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Javanese"@en .

aat:300018739 a skos:Concept ;
    skos:definition "Refers to the period of the Javanese Majapahit empire (1292- c.1500 CE). The period is characterized by the re-emergence of pre-Hindu elements. The sculptural style in this period is most noted for the relief panels depicting the punakawan, clownish characters from Javanese poems. Prominent examples of architectural styles in the period are Candi Brahu, featuring brick construction, Candi Tikus, featuring bathing pools, Candi Wringin Lawang, featuring a gate type known as candi blntar (\"split gate\"), and Candi Sukuh, featuring a truncated pyramidal structure. Late in the period, temple styles evolved to include cylindrical bodies, square foundational bases, complex stepped sanctuaries, and horned banaspati head sculptures that supported the cornices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Majapahit"@en .

aat:300018742 a skos:Concept ;
    skos:definition "Refers to the period of the Mataram kingdom from the seventh to the tenth century. The styles of this period are driven by religious ideological struggles between the Shaivite Sanjaya dynasty and the Mahayana Buddhist dynasty of the Shailendras, which resulted in sweeping building programs of Hindu candis and Buddhist temples throughout the Javanese region. Later, the resurgence of indigenous ancestor and spirit cults that flourished alongside Shaivism resulted in synthesized styles that incorporated Buddhist, Hindu, and indigenous elements into textile production, weapon design, manuscript panting, and calligraphy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mataram"@en .

aat:300018744 a skos:Concept ;
    skos:definition "Refers to the period of the Singhasari empire (1222-1292 CE) in Java. In general, the art of the period is characterized by the blend of Hindu, Buddhist, and indigenous iconographic styles. Artistic production from this period is distinguished by the prevalence of demonic sculpture and masks and skull designs based on religious concepts in Tantric texts. Examples of artistic production from this period include the Bhairava figure, a demonic rendition of Shiva adorned with skulls and accompanied by buffalo in twisted positons, and Ganesha statues decorated with skulls. Temples in this period reflect the styles of Tantric magic temples in Nepal and feature tiered, slender constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Singhasari"@en .

aat:300018751 a skos:Concept ;
    skos:definition "Refers to the style found on the island of Sumba. Textile production in this region reflects Sumatran and Indian influences, featuring large mantles known as hinggi patterned in warp ikat, Indian patola design elements, and ceremonial sarongs displaying warp patterning. Popular regional motifs in textiles include human figures, horses, deer, snakes, and lions. Colors signify class distinction with Turkey red dye being the most luxurious and rare. In lapidary design, the style features the use of garnets, crystals, pearls, amethysts, rubies, red coral, ivory. Decorative arts in this style feature elaborate bead necklaces and headbands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumba"@en .

aat:300018752 a skos:Concept ;
    skos:definition "Refers to the indigenous style associated with the region in Borneo known as Sarawak. The style reflects the region's history of foreign occupation by numerous empires from the Majapahit empire of Java, to the British protectorate of Brunei, and finally to the modern Malaysian nation. The style is characterized by ironworks, wood carvings featuring Islamic motifs, and ceramics taught by Chinese traders. Indigenous art by the Iban people of Sarawak features animist religious motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarawak"@en .

aat:300018753 a skos:Concept ;
    skos:definition "Refers to the style and period corresponding to the region of Sumatra from the 11th to the 14th century. The style is noted for its rich, varied textile traditions used in various ritual contexts and featuring woven silk and cotton designs, tapestries, embroidery, gold cloth works, and mantle cloths of blue and earth red colors with warp ikat designs of interlocking lozenges. Lapidary production in this style features gold medallions, armbands and necklaces adorned with jewels as well as locks of hair and animal tusks and claws, and bejeweled, crescent-shaped headdresses with tiny models of traditional houses hung from hairpins. Sculptural production in this style features bronze and stone images of Buddha reminiscent of work from the Srivijaya and Majapahit periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumatran"@en .

aat:300018761 a skos:Concept ;
    skos:definition "Refers to the style associated with Srivijaya in peninsular Thailand during the eighth through the 13th centuries. This style influenced Indonesian art through maritime trade and exchange. The style reflects a blending of Malaysian, Chinese, Indian, and Arabic religious and intellectual currents. In sculpture, the style features small bronze Buddhist figures, bodhisattvas, and clay votive tablets with inscribed Buddhist creeds. Figures of deities reflect Indian Gupta styles and are clad in long garments without diadems, their upper torsos exposed and their hair in a crown of mixed tresses. In architecture, the style features small temple complexes in cruciform plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Srivijaya"@en .

aat:300018764 a skos:Concept ;
    skos:definition "Style and culture of a dynasty that flourished in Java from about 750 to 850 CE, dating after the fall of the Funan kingdom of mainland Southeast Asia. The dynasty was marked by a great cultural renaissance associated with the introduction of Mahayana Buddhism; it attained a high level of artistic expression particularly in temples and monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sailendra"@en .

aat:300018766 a skos:Concept ;
    skos:definition "Refers to the style named for the island of Sumbawa. Lapidary styles feature designs similar to those in other regions of Indonesia with one distinguishing element evidenced by the popular use of talismanic square black patches in necklaces. In textiles, the style features sarongs, headcloths, and fabrics embellished with silk and precious-metal wefts. In painting, the style features illuminated manuscripts of the Koran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumbawa"@en .

aat:300018772 a skos:Concept ;
    skos:definition "Refers to the hybrid style and culture of the Philippines reflecting the region's influx of trade and exchange with Chinese, Islamic, and Hindu cultures. Domestic folk arts of the archipelago nation reflect Indianized geometric motifs in textiles, weapons, and containers. Pre-colonial architecture featured megalithic monuments similar to late Tantric east Javanese tjandis. Painting and sculpture in the region reflect Indian erotic imagery, Buddhist images, and ornamental, curvilinear designs. Ceramic styles were often imitations of Chinese Sung Dynasty designs. As a result of Spanish colonialism from the 16th to 19th centuries, art later predominantly reflected Spanish Christian iconography in painting and colonial churches and cathedrals in Neo-Byzantine and elaborate, flamboyant designs. Secular art gained prominence in the later 19th century and followed European or international business aesthetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Philippine"@en .

aat:300018773 a skos:Concept ;
    skos:definition "Style and culture of Siberia, particularly to that of any of the large number of small ethnic groups living in Siberia. Most engage either in reindeer herding or fishing, while some also hunt furbearing animals or farm and raise horses or cattle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siberian"@en .

aat:300018775 a skos:Concept ;
    skos:definition "Refers to the Neolithic culture established in the slopes of the Afanasyevskaya Mountains from the 2nd millennium BCE. Sites have revealed tombs marked with stone circles symbolizing the Sun God, later ones took the form of barrows or large mounds. Pottery in earlier graves consisted of elongated, spherical vessels with herringbone patterns, while later pottery was flat-bottomed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afanasievo"@en .

aat:300018777 a skos:Concept ;
    skos:definition "Refers to the Eneolithic culture established in the steppes of the Minusinsk basin by Mongoloid peoples probably of Northern Siberian descent, from the beginning of the 2nd millennium BCE. Tombs have revealed a variety of stone sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Okunev"@en .

aat:300018778 a skos:Concept ;
    skos:definition "Refers to the Neolithic culture established in the steppes of the Minusinsk basin during the 2nd and 1st millennia BCE. Sites have revealed earth houses designed for permanent habitation, with hearths for heating purposes and cooking. Bronze objects were also numerous, and workshops existed for working copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andronovo"@en .

aat:300018779 a skos:Concept ;
    skos:definition "Refers to the Iron Age culture established in the Minusinsk basin on the Yenisey River from about 1200 BCE to about 70 BCE. Sites have revealed elbow-shaped knifes related to those used between the 14th and 11th centuries BCE in China during the Shang Period. Also notable are pillars with stylized ram heads or human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karasuk"@en .

aat:300018780 a skos:Concept ;
    skos:definition "Refers to the phase of the Karasuk culture which is marked by the production of bronze objects, such as knives and bracelets with a series of straight or oblique lines cut across them, with rows of triangles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamenny Log phase"@en .

aat:300018781 a skos:Concept ;
    skos:definition "Culture and styles of the Iron Age nomads of the Eurasian steppes, when Siberia was inhabited by a large number of small ethnic groups whose members subsisted either as hunter-gatherers or as pastoral nomads relying on domestic reindeer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Nomads"@en .

aat:300018782 a skos:Concept ;
    skos:definition "Refers to the Early Nomads culture established in the Ob valley from the 7th century to the 6th century BCE. Sites have revealed earthen houses with a large amount of undamaged pottery and a variety of other objects, which suggests abandonment of the village due to enemy raids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bol'shaia Rechka"@en .

aat:300018784 a skos:Concept ;
    skos:definition "Refers to the period of the Bol'shaia Rechka phase where iron knives, daggers and battle axes were coming into use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Biysk phase"@en .

aat:300018786 a skos:Concept ;
    skos:definition "Refers to the period of the Bol'shaia Rechka phase where iron was used to produce a wide variety of objects including weapons, horses bits and belt clasps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berëzovsk phase"@en .

aat:300018788 a skos:Concept ;
    skos:definition "Scythian-Siberian style and culture dating to the 7th and 6th centuries BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maiemir"@en .

aat:300018791 a skos:Concept ;
    skos:definition "Refers to the Early Nomads culture named after the burial site found in the Bolshoy Ulagan River valley, dating from about the 3rd century to the 5th century BCE. Excavations from 1929 and 1947-49 have revealed an embalmed man with animal tattoos, various vessels, and some of the oldest extant textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pazyryk"@en .

aat:300018793 a skos:Concept ;
    skos:definition "Refers to the Early Nomads culture established in the Altay Mountains from the 2nd to the 1st centuries BCE. The most significant development during this phase was the transition from bronze to iron in the manufacture of implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shibe"@en .

aat:300018795 a skos:Concept ;
    skos:definition "Refers to the Early Nomads culture established in the steppes of the Minusinsk basin. The culture is characterized by a distinctive type of kurgan, often with a small mound and a low rectangular stone enclosure with tall pillar like slabs of stones at the four corners. There are also the type with no mound and a cemetery area marked with stone pillars in groups of several dozen or several hundred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tagar"@en .

aat:300018796 a skos:Concept ;
    skos:definition "Refers to the period of the Tagar phase where the burial enclosure of the kurgan was quite small, with walls only 1 1/2 to 2 meters high, and constructed of stone slabs. Each enclosure contains only one tomb containing only one skeleton, typically with one or two jars placed at the deceased's head, along with offerings of meat and simple bronze implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bainov phase"@en .

aat:300018797 a skos:Concept ;
    skos:definition "Refers to the period of the Tagar phase where the burial enclosure of the kurgan was quite small, with four tall stones at the corners and a low wall. Containing only a single grave, the burial chamber of the tomb itself is made of timber rather than stone. Grave items typically include pottery and bronze weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Podgornoe phase"@en .

aat:300018798 a skos:Concept ;
    skos:definition "Refers to the period of the Tagar phase where the kurgans are larger, with 8 or 10 tall stones in the walls of the enclosure and sides 2 1/2 to 3 meters long. The tombs consist of a log-built burial chamber and log roof. These collective tombs belonging to particular clans contain bodies of both sexes and all ages. The pottery of this period is usually undecorated and the bronze implements are typically battle-axes of no practical utility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saragash phase"@en .

aat:300018799 a skos:Concept ;
    skos:definition "Refers to the period of the Tagar phase where the kurgans vary considerably. There are large structures with monumental enclosures built of stone with walls a meter thick and 1 1/2 meters high. In the center is a large tomb consisting of an elaborate timber structure of two stories with a log roof, containing the remains of a several dozen bodies. All of the tombs have been set on fire, the structures charred and reduced to ash in most places. Other tombs have smaller enclosures of slabs set upright in the ground, either built up against one another or separated by a narrow gap and containing only a single tomb. Some tombs may be squeezed into the spaces between enclosures or between the main tomb and the enclosure wall. In both cases, the skulls of the deceased have been trepanned and covered with a coating of clay and painted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tes phase"@en .

aat:300018803 a skos:Concept ;
    skos:definition "Style and culture of the mountain range running along border shared by China and Mongolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Altai"@en .

aat:300018806 a skos:Concept ;
    skos:definition "Style and culture known particularly in the burial mounds at Bashadar dating back to the end of the 6th and beginning of the 5th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bashadar"@en .

aat:300018817 a skos:Concept ;
    skos:definition "Style and culture of Kashmir, the northwestern region of the Indian subcontinent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kashmiri"@en .

aat:300018824 a skos:Concept ;
    skos:definition "Dynastic periods related to Nepalese culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nepalese dynastic periods"@en .

aat:300018825 a skos:Concept ;
    skos:definition "Nepalese styles preceding the Licchavi era, that is, prior to ca. 450-ca. 750 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Licchavi"@en .

aat:300018826 a skos:Concept ;
    skos:definition "Sytle and culture of the Licchavi era, ca. 450-ca. 750 CE in Nepal, defined by the rule by the Licchavi dynasty. The dynasty originated in India, used Sanskrit as a court language, issued Indian-style coins, maintained close ties to India, and also had economic and political relations with Tibet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Licchavi"@en .

aat:300018827 a skos:Concept ;
    skos:definition "Style and culture of the Rajput Dynasty of Thakuri kings, ruling from mid-12th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thakuri"@en .

aat:300018828 a skos:Concept ;
    skos:definition "Style and culture during the time when the Kathmandu Valley was ruled by the Malla dynasty (10th-18th century)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malla"@en .

aat:300018832 a skos:Concept ;
    skos:definition "Style and culture of the dynasty located at Gurkha after it was seized in 1559 by Drabya Shah, the younger son of the king of Lamjung, who established his own kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gurkha"@en .

aat:300018834 a skos:Concept ;
    skos:definition "Regional styles belonging to Nepalese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nepalese regional styles"@en .

aat:300018835 a skos:Concept ;
    skos:definition "Style and culture of the area surrounding Bhaktapur, Nepal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bhatgaon"@en .

aat:300018838 a skos:Concept ;
    skos:definition "Style and culture of the area surrounding Katmandu, Nepal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kathmandu"@en .

aat:300018839 a skos:Concept ;
    skos:definition "Style and culture of the area around Kushinagara, Uttar Pradesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kusinagara"@en .

aat:300018840 a skos:Concept ;
    skos:definition "Style and culture of the Patan region of Nepal, around the city of Patan southwest of Kathmandu. The culture represents one of the Kathmandu Valley’s earliest settlements, described as the cradle of art and architecture in the valley. The style manifests itself particularly in crafts such as metalworking and woodcarving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Patan"@en .

aat:300018849 a skos:Concept ;
    skos:definition "The style and culture of the area of Tibet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tibetan"@en .

aat:300018850 a skos:Concept ;
    skos:definition "Western Tibetan school of painting named after the Buddhist order of the same name that began and fostered it. Tradition has it that the style was introduced by the Indian sage Atîsha in the 11th century; it is characterized by simple compositions, a sense of spaciousness, and an overall basic richness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kadam School"@en .

aat:300018854 a skos:Concept ;
    skos:definition "Style of painting that flourished in western Tibet beginning in the 15th century; Guge is the name of a kingdom in this region. Color is subdued and of muted tonality, akin to contemporary Nepalese painting. Figures typically have round, bloated faces and, in the case of the principal bodhisattvas, there is a preoccupation with scarves and accessories. Guge paintings are characterized by crowded compositions, a preponderance of red, and an overall style of mannered elegance. There is little trace of Central Asian features in this style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guge"@en .

aat:300018855 a skos:Concept ;
    skos:definition "School of Tibetan painting that originated in the early 15th century with an artist known as Menla Töndrup. It maintained the simplicity and spaciousness of the Kadam school while placing greater emphasis on rich detail, a result of Persian influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Menri School"@en .

aat:300018857 a skos:Concept ;
    skos:definition "Tibetan school of painting associated with the Buddhist order of the same name, one of the 4 main orders. The school, which flourished from the 13th to the 16th centuries in central Tibet, developed in Sakya monasteries, particularly in the monastery of Ngor. Sakya paintings are often composed of multiple mandalas characterized by even, flat colors, an icon-like quality, and an overall directness that complements their religious and visual complexity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sakya School"@en .

aat:300018860 a skos:Concept ;
    skos:definition "School of painting that flourished in central Tibet from the late 17th to the 19th centuries; it is noted for its naturalistic figures; rich colors, especially orange and green; and elegant, meticulous detail, particularly in the garments and lotus petals. New Menri painting is also known for its emphasis on curves at the expense of straight lines. More emphasis is placed on architectural details and architectural settings replace the niche-shrine device of earlier paintings. New Menri paintings often combine architectural scenes with narrative, adopting a more distant viewpoint. Little open space is typical. Some New Menri paintings are valuable sources of information about Tibetan temple architecture, much of which no longer exists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Menri School"@en .

aat:300018861 a skos:Concept ;
    skos:definition "One of the main schools of Tibetan painting, flourishing during the 16th and 17th centuries, mainly in eastern Tibet; it was developed by the Karmapa branch of the Kagyu Order and supposedly inspired by the artist Karmapa Mikyo Dorje (1507-1554). The style, which is influenced by Chinese landscape tradition, is often described as evocative, delicate and lyrical. The characteristically Karma Gardri colors of green, blue and red are relatively subtle and restrained. Open spaces with clusters of small figures are typical; landscape elements are also reduced in scale and often stylized. The harmony and serenity of nature are often emphasized. Karma Gardri paintings often consist of multiple small vignettes set in landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karma Gardri School"@en .

aat:300018863 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of the modern nation of India, or more broadly to cultures that developed on the subcontinent of India, which is bounded by the Arabian Sea, the Indian Ocean, the Bay of Bengal, and the Himalayn Mountains. It may also refer even more broadly to cultures of India, the East Indies, and the former British Indian Empire. It was formerly used less specifically to refer to any Oriental or Asian culture. Do not use this term to refer to the indigenous populations of North or South America; see \"Native American\" or other appropriate terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian"@en .

aat:300018870 a skos:Concept ;
    skos:definition "Bronze Age culture that thrived ca. 3300-ca. 1300 BCE in the northwestern region of the Indian subcontinent, primarily in the areas that are now Pakistan, and parts of India, Afghanistan and Iran. Among the notable characteristics that distinguish the culture include their achievement of uniform and accurate measurement of mass, length, and time, new techniques in metallurgy using copper, bronze, lead, and tin, and new techniques in engineering docks and other structures. Indus Valley Civilization that thrived along Indus River (ca. 3300-1300 BCE)"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Harappan"@en .

aat:300018874 a skos:Concept ;
    skos:definition "Period and culture that flourished in India ca. 1500 BCE-ca. 500 BCE, developing due to an influx of nomadic and pastoral peoples who spoke Indo-European languages and followed the early religion of Vedism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vedic"@en .

aat:300018877 a skos:Concept ;
    skos:definition "Style and culture under the Mauryan emperors, the first imperial dynasty of India, flourished ca. 321 BCE - ca. 232 BCE. Particularly noted for sculpture and stone-cut architecture. Earlier sculpture had generally been made of wood but during the Maurya period stone became the preferred medium. The oldest surviving Indian architecture is from the Maurya period, rock-cut cave chambers for monks. The most notable Mauryan works are from the Ashoka period; to specifically designate the style and culture particular to the reign of Ashoka, use \"Ashoka.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maurya"@en .

aat:300018878 a skos:Concept ;
    skos:definition "Style and culture of architecture and art created during the forty-year reign of Ashoka, the third Maurya emperor (died 232 BCE) who ruled over all of India; noted as an enlightened ruler who advanced a new, sophisticated style, strongly influenced by Achaemenid sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asoka"@en .

aat:300018880 a skos:Concept ;
    skos:definition "Refers to the culture created during the Sunga dynasty of the 2nd and 1st centuries BCE in India. The Sungas overthrew the Maurya empire in 185 BCE. The Sunga empire was not as extensive as that of the Mauryas, so while works of art created during this time may be said to belong to the Sunga period, this term does not always imply patronage or Sunga control over a certain area. With the Sunga period began an unbroken continuum of Indian art and architecture. The earliest surviving stupa railing, along with part of a gateway, was found in Bharhut in eastern Madhya Pradesh and dates from this period. As was the case with other early stupa railings, figures and reliefs were donated by individuals whose names were inscribed. Labels often identify the scenes depicted since Buddhist iconography was still in its infancy. Overall, emphasis in Sunga art was placed on the communication of a religious message at the expense of naturalism; this becomes a dominant feature of later Indian art as well. Carved yakshi and yaksha figures and other pre-Buddhist dieties that were incorporated into the fold of Buddhism are commonly found. An important difference between these figures and earlier ones is that many have a more relaxed left leg. The figures are still stiff and heavy like Maurya figures, but the thick garments and high polish are gone. Other important sites include the rock-cut caves in the western Ghats, particularly those of Bhaja and Pitalkhora. These Buddhist cave settlements consisted of a caitya hall and living quarters for the monks (viharas). The facades were usually decorated with horseshoe-shaped arches while the interior sculptural decoration was generally simple; painting and wooden additions were probably once part of the iconographic and decorative schemes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sunga"@en .

aat:300018882 a skos:Concept ;
    skos:definition "Refers to the culture of the Andhra region of central India. The Andras were a Dravidian tribal people who became extremely powerful in the Deccan region, reaching their zenith in the 2nd century CE, controlling most of India's trade routes and seaports. The term generally refers to the ancient culture of the Andhras, particularly to the culture of the Satavahanas (or Satakarni), one of the most renowned of the Andhra dynasties, who came to power in the 1st century CE and under whom Buddhism flourished. Stupas and rock-cut caves continued to be built, but they were larger and more elaborate in this period. The term can also be used to refer to the culture of this region of later centuries, not necessarily of Andhra tribes or dynasties, particularly from the tenth century, when art activity became more pervasive and the style assumed distinct Andhra characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andhra"@en .

aat:300018886 a skos:Concept ;
    skos:definition "Refers to the period of culture of the Kushan dynasty in ancient India, approximately from the 1st century BCE to the 3rd century CE. The Kushan dynasty was very wealthy due to its control of trade route gateways to the Roman Middle East and China; it reached the pinnacle of its grandeur under King Kanishka of the late 1st century to early 2nd century. Kanishka's coins, with their depictions of gods from different religions, reflect his desire to live harmoniously with the various peoples within his domain as well as with the peoples of regions he had trade links with. There were two important artistic centers: Gandhara and Mathura; although there was contact and exchange between the two, they developed unique styles. The image of Buddha as a god emerges for the first time during this period; it is first seen on a coin and was soon found in complete stone images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kushan"@en .

aat:300018889 a skos:Concept ;
    skos:definition "Refers to the culture of the Ghandara region of India, the area between the Upper Indus River and Kabul, under the Kushan dynasty; it particularly refers to the Buddhist architecture and sculpture of the 2nd through the 6th centuries CE. Its style reflected the cosmopolitan connections of its patrons: it was heavily influenced by 2nd-century Hellenistic art of Egypt and Syria. In turn, it gave rise to styles of art in central Asia, Wei China, and Japan. Gandhara monasteries and stupas were very ornate, with Western decorative elements such as acanthus capitals, Hellenistic comedy masks, and putti. The stupa form itself changed in Gandhara: the dome became taller, the railings larger and more elaborate, and the tiered umbrella unit was enlarged until it towered over the entire structure. Sculptural figures were usually heavily draped in toga-like attire and their musculature was typically emphasized; sculptures were usually stuccoed and vividly painted as well. Simultaneously with sculptors in Mathura, Gandhara sculptors supplied a Buddha icon for the emerging Buddhist faith; they also contributed to the development of the Bodhisattva image. A great deal of Gandhara sculpture survives, all of it quite homogenous in style. Important sites were at Shahji-ki Dheri, Takht-i-Bahai, the Taxila region, Sar Dheri, and Sahr-i-Bahlol. The extreme north-west part of Gandhara extended into what is now Afghanistan; Gandharan-style religion and art continued in that area until at least the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gandhara"@en .

aat:300018904 a skos:Concept ;
    skos:definition "Refers to the culture of the Gupta period in North Central India from the early 4th century to the late 5th century, considered to be the 'classical' period of Indian art. The Gupta period saw an outpouring of science, visual art, music, and literature, and had its zenith during the reign of Chandra Gupta II (375-415 CE). Some of India's earliest surviving paintings were created during this period at the Buddhist caves at Ajanta in the Deccan; the paintings are characterized by lively calligraphic line and life-like, contemporary details. The renowned Gupta sculptural style probably grew out of the Kushan style; by the end of the 4th century a distinctive Buddha icon had developed, characterized by monumental simplicity and refined realism. The tension of earlier Mathuran sculpture has been replaced by a calm and tranquil mood connoting a spiritual other worldliness that is a hallmark of the Gupta Buddhist style. The many sculptural finds at Sarnath include a group of sculptures known as the 'wet Buddhas' in which clinging drapery and webbed fingers are distinguishing Gupta features. During this period, Hindu art emerged into prominence; the earliest and most dramatic example of Gupta Hindu art is the rock-cut shrine at Udayagiri of 401. The sculptor of the reliefs of the ruined Dashavatara Temple at Deogarh took the Buddhist style of Sarnath and applied it to a Hindu motif with striking results. Very little Gupta art, however, remains as much of the art, both Buddhist and Hindu, was destroyed during the invasions of the Huns and the advent of Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gupta"@en .

aat:300018909 a skos:Concept ;
    skos:definition "The style and culture of an Indian dynasty known in several branches, including the Chalukyas of Badami, the later Chalukyas of Kalyana, the branch in western India known as the Chalukyas of Gujarat, and the branch known as the Eastern Chalukyas, or Chalukyas of Vengi, who ruled in Andhra in the 7th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chalukyan"@en .

aat:300018930 a skos:Concept ;
    skos:definition "Styles and Islamic culture on the Indian subcontinent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic Indian"@en .

aat:300018939 a skos:Concept ;
    skos:definition "Describes the culture, periods and styles of northern and central India under the Mughal emperors from the mid-16th to the late 17th century. Hallmarks of the period are a revival of Islamic architecture, and the mingling of Persian and indigenous Indian influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mughal"@en .

aat:300018942 a skos:Concept ;
    skos:definition "Periods related to Mughal cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mughal periods"@en .

aat:300018953 a skos:Concept ;
    skos:definition "Styles belonging to Mughal cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mughal styles"@en .

aat:300018957 a skos:Concept ;
    skos:definition "Styles, culture, nationality, and period belonging to European colonies in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial Indian"@en .

aat:300018958 a skos:Concept ;
    skos:definition "Styles and culture belonging to British colonies in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Colonial Indian"@en .

aat:300018959 a skos:Concept ;
    skos:definition "A style of painting in India created by descendants of Mughal artists for the British in the late eighteenth and early nineteenth centuries. The artistic centers of this style were Delhi in the north, Lucknow, Calcuta and Patna in the east, and Madras and Thanjavar in the south. The subject matter of these 'Company paintings' consisted of flowers, animals, caste groups, festivals, and scenic spots; the techniques were adapted from European watercolors. The names derives from the East India Company, with which the patrons of the Company style were often associated. The patrons tended to have a genuine scientific interest in the Indian culture and environment rather than a passing curiosity about the exotic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Company"@en .

aat:300018962 a skos:Concept ;
    skos:definition "Styles and culture belonging to Portuguese colonies in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portuguese Colonial Indian"@en .

aat:300018963 a skos:Concept ;
    skos:definition "A style of art and architecture produced in Goa, a state on the western coast of India, under Portuguese rule of the sixteenth and seventeenth centuries. The churches of Old Goa, considered to be one of the most splendid cities in the sixteenth century, are indicative of this style that mixes native and European elements; for example, the church of Our Lady of the Rosary (1543), one of the best preserved monuments in Goa, combines Manueline-style and Renaissance forms with Hindu and Muslim-derived decorative elements. Other important examples include the church of St. Francis of Assisi (begun ca. 1527), Goa Cathedral (1562-1652), and the celebrated basilica of Bom Jesus (1594-1605). The style began to decline by the early eighteenth century due to repeated epidemics and the economic decline of Portuguese India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Goan"@en .

aat:300018966 a skos:Concept ;
    skos:definition "Architecture styles belonging to Indian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian architecture styles"@en .

aat:300018967 a skos:Concept ;
    skos:definition "A style of temple architecture found in southern India characterized by terraced towers, sometimes pyramidal in shape, with a domed structure at the top; each terraced storey is enclosed by a balustrade and ringed by small architectural aediculae. The aediculae can be square-domed structures on the corners (kutas) and intermediate barrel-vaulted halls (salas) connected by segments of a miniature vaulted cloister (hara). This style of stone temple architecture began in the seventh century and continued to develop over the centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dravida"@en .

aat:300018969 a skos:Concept ;
    skos:definition "A style of temple of northern India. Characterized in the early version by offsets (bhadra) projecting as cardinal niches from the cubic cella; the niches usually contained images of the sanctum's divinity. A curvilinear tower carried the offsets upward to a topmost altar (uttaravedi) with a crowning amalaka; during consecration a finial carved as a lustration pot, sometimes with foliage, was placed on top of the amalaka. Niches with guardian dieties (dikpalas) were placed at the corners and more offsets were added. The style developed in the 6th century; the word literally means \"pertaining to the city,\" possibly revealing the origins of the form. Various regional forms developed out of this basic style, also called \"latina\" because of the vertical creepers or latas. Multi-spired forms were increasingly popular from the 11th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nagara"@en .

aat:300018972 a skos:Concept ;
    skos:definition "A style of architecture associated with the Deccan region of India, begun in the eleventh century. The word literally means \"mule\" or \"hybrid\" and is therefore an apt description of the mixed architectural forms found in the Deccan. The style incorporated the vertical divisions and projecting offsets of the nagara style while retaining the general structure of the dravida style. The term may sometimes refer specifically to a style of apsidal temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vesara"@en .

aat:300018976 a skos:Concept ;
    skos:definition "Painting styles belonging to Indian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian painting styles"@en .

aat:300018987 a skos:Concept ;
    skos:definition "Generally, this term refers to a variety of painting styles found in Eastern India during a broad time span. It often specifically refers to a style of painting in India that was mainly confined to the Buddhist monasteries of Bihar, Bengal, and Orissa in the 11th and 12th centuries. Many palm-leaf manuscripts survive with miniature paintings; the text most often decorated is 'Astasahasrika Prajnaparamita' ('Perfection of wisdom in 8000 sections'). The viewpoint is usually frontal and besides a few trees the background is usually empty. Because of their small size, never more than 80mm square, they are not iconographically complex; they generally consist of conventional icons of Buddhist gods and goddesses with little narrative representation. Most surviving manuscripts are stylistically linked to those in the Pala style. The monasteries themselves were probably frescoed and decorated with banner paintings which have not survived. The style declined with the destruction of the eastern Buddhist centers by Islamic invaders in the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Indian"@en .

aat:300018988 a skos:Concept ;
    skos:definition "A style of watercolor painting used by artists working in Calcutta, India in the nineteenth century; the works produced were sold inexpensively to pilgrims to the nearby Kalighat temple. This style demonstrates the European influence on Indian folk art; not only was the English technique of transparent watercolor adopted, but European subjects and events were sometimes depicted. Overall, these rapidly produced paintings are characterized by bold colors, broad sweeping brush lines, simplified forms, and little or no backgrounds. Popular Hindu deities are most commonly depicted although scenes of contemporary life are found as well. The style, which arose to compete with inexpensive colored lithographs, soon lost the contest. Although it quickly disappeared, the Kalighat style was influential for a number of modern Indian painters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalighat"@en .

aat:300018989 a skos:Concept ;
    skos:definition "Refers generally to paintings in the former Mughal style created in the eighteenth and nineteenth centuries in Lucknow in the Oudh region of India. After the Mughal empire collapsed in the late seventeenth and early eighteenth centuries, a shadow of the imperial painting style was kept going by copying older paintings, usually by refugee artists who fled the sacks of Dehli. The paintings produced here show a fusion of Mughal and Rajput themes and styles. Other sites where refugee painters worked were Patna, Fyzabad, and Murshidabad; in all of these places, a Western influence crept into some of the paintings as the British became patrons. Company style painting flourished here as well in the eighteenth and nineteenth centuries; Lucknow artists produced paintings of a wide range of subject matter, including panoramas which reflected the contemporary vogue for such works in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oudh"@en .

aat:300018997 a skos:Concept ;
    skos:definition "One of the two main schools of the Rajput style of Indian miniature painting, the other being Rajasthani, with which it is closely allied in terms of technique and subject matter. This one is geographically based in the Himalayan foothills, stretching from Jammu to Garhwal. The area it covered was smaller than that of Rajasthan so it is more likely that artists traveled in search of work. While two main schools, Basohli and Kangra, are often identified by scholars, there are numerous other regional idioms. In many cases, a classification based upon ateliers and families may be more appropriate since regional schools are difficult to distinguish. The sack of Dehli in 1739 and subsequent collapse of Mughal power forced artists to seek patronage elsewhere; these artists brought about the further refinement of Pahari painting, particularly in regards to realism. Pahari painting is considered the last vital Hindu art form before the neutralizing effect of the West was felt in the nineteenth century. Pahari painting, like some other Rajput painting, shows a preference for depicting the legends of the cowherd god Krishna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pahari"@en .

aat:300018999 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting that flourished in the Indian hill states during the late 17th and the 18th centuries. Paintings in the Basohli style are the earliest known Pahari paintings. Although the school takes its name from the small independent state of Basohli, the main center of the style, examples are found throughout the region. Characteristic features include: bold line and color, oblong format, red borders, monochromatic backgrounds, and arbitrary but striking use of architectural and decorative design. Faces are usually exaggerated and stylized, often shown in profile with large, intense eyes. A distinctive technique is the use of thick, raised drops of white paint to represent jewelry, with actual parts of green beetles' wings representing emeralds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basohli"@en .

aat:300019001 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting associated with Bilaspur in the Sutlej River valley of the Punjab Hills. Bilaspur was a noteworthy painting center from about 1650 to 1870. The 17th-century ruler Dip Chand served the Mughals and had marital ties that may have motivated him to establish a painting workshop. Unlike the local sculpture of the 17th century, most early Bilaspur paintings are not religious. Instead, most are portraits, and they are indebted to Mughal painting for their naturalism. Later Bilaspur painting retains the refinement of the Mughal influence but the subject matter is more commonly traditional subjects such as 'Ragamala' illustrations and devotional works. By the end of the 18th century, outside influences from Guler and Kangra dominated Bilaspur painting and in the first few decades of the next century, the style showed little connection to its origins and declined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bilaspur"@en .

aat:300019003 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting associated with the large Chamba state of the Punjab Hills. Chamba's cultural heritage is well-preserved due to the state's sheltered location. The presence of outside artists is felt throughout the history of Chamba painting. Paintings of the second half of the 17th century are naturalistic with a preference for pale colors, a distinctive rendering of hands, and characteristic slim wrists. In the 17th century, elements of Basohli painting are incorporated into Chamba painting with richer, warmer colors and more stylized and decorative depictions of trees. While some Chamba painting became increasingly influenced by the Basohli school in the early 18th century, other contemporary paintings are done in much more indigenous style. The presence of artists from Jammu is also felt in the early 18th century, most noticeably in the rectangular and squarish facial types. Other influences came from Mughal and Guler painting. The especially influential Guler artists arrived in Chamba circa 1770, bringing with them their poetic and expressive style as well as a preference for romantic subject matter. Painting continued in later centuries, but was more fractured in style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chamba"@en .

aat:300019005 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting associated with Garhwal in the extreme southeast of the Punjab Hills; the Garhwal school flourished from the second half of the 18th to the late 19th century, particularly in its capital city of Srinagar. While the school was not prolific, it made a large contribution to Pahari painting. Characteristic elements include vigorous line, precise drawing, brilliant color, expressive figures, strong compositions, and luxuriant and atmospheric landscapes. The influence of Guler painting is heavily debated as there are a number of stylistic similarities between the two schools. Painters from Guler probably settled in Garhwal and artists from Garhwal may have traveled to other painting centers for apprenticeship as well. Garhwal retained its individuality, however. The Shaivite crescent-shaped marks on foreheads are commonly and consistently found on figures in Garhwal paintings while they are not usually seen in other Pahari painting. Other distinguishing features include pairs of tigers, leopards and birds; lotus ponds; and flowers with pointed ends. Painting activity gradually declined in the 19th century as Garhwal was affected by foreign invasion and earthquake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Garhwal"@en .

aat:300019007 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting associated with the small principality of Guler in the eastern Pahari hills. Guler was home to some of the most gifted artist families of the area during the 18th and 19th centuries. The ruling house of Guler served the Mughal empire which certainly affected the development of painting in Guler, since paintings were often exchanged and given as gifts. The family of Pandit Seu (early 18th century) was a celebrated artistic family originating from Guler as were the Dhumun and Purkhu families. Pandi Seu himself may have been responsible for the integration of Pahari intensity with Mughal naturalism and atmospheric effects that became the norm in Guler painting. Later artist families continued to be influenced by Pandit Seu and may have been distantly related to him. Guler artists may have migrated to Chamba and Kangra when their families expanded and there was increased outside patronage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guler"@en .

aat:300019010 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting associated with the Rajput hill state of Jammu, which was once the most powerful of the group of states west of the Ravi River in the Pahari hills. How it is regarded as a center of painting has changed over the years. Some painting that was originally considered early Jammu is currently described as Basohli. Painting in Jammu in the mid-18th century is associated with Nainsukh, an important Pahari painter. The 'Bahu Shangri Ramayana' (ca. 1710) is one of the major painting series produced in the Pahari hills. This illustrated epic is characterized by vivid color, flamboyant design, and inventive composition. This style was short-lived, however, as more naturalistic styles were taking hold throughout the Pahari hills. With the establishment of the powerful Dogra dynasty under Gulab Singh in the mid-19th century, Jammu became a noteworthy center of painting, attracting many outside artists. Painters from Guler, Kangra, and the Punjab plains also worked for the Dogra rulers in older painting styles. Traditional Jammu painting came to an end in the mid-20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jammu"@en .

aat:300019012 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting that flourished in the hill state of Kangra. This prolific school flourished from about 1770 to almost the end of the 19th century, with the finest work painted around 1775-1820. Paintings as early as 1690 are known, however, and regional painting traditions continued into the twentieth century. The work produced in Kangra is greatly varied and so it is difficult to discuss a general Kangra style. However, the influence of late Mughal art is evident in Kangra painting and it is often considered as a rejection of the Basohli school. Landscape and perspective are more naturalistic, colors are more subdued, line is more delicate and curvilinear, and the overall style is more lyrical than Basohli painting. Kangra painting reached its zenith during the reign of Raja Sansar Chand (reigned 1775-1823), an important patron. The school was not limited to the Kangra state but spread throughout the Himalayan foothill area, where many distinctive idioms developed. It is difficult to assign a definitive provenance to most of the painting since the hill states were small and often close to one another. Scenes of Krishna from the poetical works, the 'Bhagavata-Purana' and the 'Gitagovinda,' are the most common subject matter of Kangra painting, along with illustrations of other Hindu myths, ragamala series, and portraits of hill chiefs and their families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kangra"@en .

aat:300019013 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting centered around the Hill State of Kulu, one of the most remote states of the Punjab Hills. It developed out of the Basohli school when Basohli artists migrated to Kulu in the late 17th century. Emphasis is placed on decorative patterns instead of naturalistic landscapes and colors are less bold than in Basohli painting. The \"Shangri Ramayana', a series of 270 paintings, is a central Kulu work dating from about 1690 to 1710."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kulu"@en .

aat:300019015 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting centered around the state of Mandi in the Beas Valley of the Punjab Hills. While earlier painting was influenced by the Mughals, Mandi painting became distinctive under Raja Sidh Sen (reigned 1684-1727), who was personally influential over the new style. Mandi painting of this period is often characterized by bold, sweeping lines, a muted palette, and simple compositions consisting of three horizontal registers. The vital and bold sculpture of the time is considered to be an important influence on the rendering of figures in painting. Strong facial features, oversize heads and hands, and generally statuesque figures are typical. Shiva is a popular subject since Sidh Sen was a devotee of the god. Shiva, Devi and Tantric themes were more popular than the literary themes seen in a great deal of other Pahari painting. A later phase of Mandi painting started around 1805 and is associated with the artist Sajnu from Guler. Works painted by him for Raja Ishwari Sen are characterized by curved and heavily ornamented borders, crowded and detailed compositions, and buildings and figures placed at angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mandi"@en .

aat:300019016 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting associated with the Ramkot state, the smallest Punjab Hill state. Mughal-inspired portraiture was introduced to Mankot in the mid-17th century under the emperor Shah Jahan and portraiture remained a primary concern of Mankot painters. While earlier paintings are more decorative, the emphasis changed in the early 18th century to focus on the drama of the scene. Some of the distortion of Basohli painting is found in Mankot painting. Painting trends of Nurpur, Jammu and Chamba, particularly in the depiction of faces, were also assimilated by Mankot artists. When Mankot and other principalities lost their independence in the 19th century, painting in Mankot declined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mankot"@en .

aat:300019017 a skos:Concept ;
    skos:definition "Refers to a regional school of Pahari miniature painting associated with the Nurpur state of the Punjab Hills. It was a less isolated state then other Punjab Hill states and its rulers were generals and governors of the Mughal empire during the early 17th century. While stylistically distinct, the Nurpur school was indebted to Mughal painting, particularly in regards to portraiture. A bolder style was used for other genres. These two styles coalesced in the early 18th century: facial features are less exaggerated, color is more controlled, and landscapes are stylized. 18th-century Nurpur painting was influenced by the painting styles of Guler and Jammu, with more naturalistic and delicate results. A vertical format is favored and tall, graceful female figures with small heads are common. Court life in Nurpur diminished in the second half of the 18th century as did its painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nurpur"@en .

aat:300019020 a skos:Concept ;
    skos:definition "Culture and styles of the Hindu Rajput princes, who came to power after the collapse of the Gupta empire. Their courts were often Hindu centers of learning and they were patrons of poets, scholars and artists. In the area of Rajput painting, there were markedly Indian characteristics that contrasted with style of Muslim Mughals. Mughal artistic developments affected traditional manuscript illumination of the Rajput courts in the late 16th-early 17th centuries. Important developments included portrait painting in Rajput artistic centers, favoring the symbolic and poetic rather than realistic.The two main groups were Rajasthani and Pahari."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rajput"@en .

aat:300019021 a skos:Concept ;
    skos:definition "Refers to a 17th-century Indian school of Rajasthani miniature painting centered largely in Malwa and Bundelkhand (in the modern state of Madhya Pradesh). It is also sometimes referred to as Central Indian painting because of its geographical distribution. Malwa painting is generally described as conservative and simple: compositions are flat, dark backgrounds are favored, space is divided into registers, figures are painted against solid patches of color, and architecture is brightly painted. While the style is often considered archaistic, it was nevertheless a well-established tradition. Two stylistic types have been designated by scholars: Style A and Style B, with the latter showing Mughal influence. The school declined in the 1690s but was influential for the painting schools of neighboring regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malwa"@en .

aat:300019026 a skos:Concept ;
    skos:definition "One of the two main schools of the Rajput style of Indian miniature painting, the other being Pahari, with which it is closely allied in terms of technique and subject matter. This one is geographically based in the Central Plains region. The evolution of Rajasthani painting out of early Western Indian painting is not completely understood. It seems to have begun in the 16th century, and in its first phase retained a hieratic and abstract quality. The subject matter is essentially Hindu, with particular attention to the life of Krishna. The literature and painting of the time were products of the contemporary religious development that emphasized devotion to Krishna as the way to salvation. Popular themes were pictorial representations of the musical modes (ragamala) and of love poetry. The style was not much influenced by Mughal painting styles until the eighteenth century when the sharp distinction between the two styles became more obscured. The style developed various distinct schools, some of which are outside of the geographical borders of Rajasthan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rajasthani"@en .

aat:300019027 a skos:Concept ;
    skos:definition "Refers to miniature painting created in Ajmer in Rajasthan; Ajmer painting is an example of the extension of the Mughal style of painting in Rajasthan. The Mughal emperor Jahangir (reigned 1605-1627), who temporarily moved his court to Ajmer between 1613 and 1616, was an important patron of the arts. Tinted paintings with unfinished backgrounds and brick-red borders are common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ajmer"@en .

aat:300019029 a skos:Concept ;
    skos:definition "Refers to a school of Indian painting associated with the princely state of Bikaner in northwest Rajasthan. Of all Rajasthani schools, the Bikaner, from its beginning in the mid-17th century, shows the most indebtedness to the Mughal style. This is due to the alliance between the two from the late 16th century and the subsequent presence of artists who had worked in Mughal Dehli in Bikaner workshops. Consistent characteristics include delicate line, soft color, and a sympathy for the religious and literary themes favored by the royal Hindu patrons. Toward the end of the 18th century, it became more typically Rajasthani in style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bikaner"@en .

aat:300019031 a skos:Concept ;
    skos:definition "Refers to a prolific school of Indian painting associated with the princely state of Bundi in southeastern Rajasthan, India. The other main center for Bundi school painting was in the neighboring principality of Kotah with which Bundi also had familial ties. Other idioms of the Bundi style such as Indargarh, Khatoli, Toda Rai Singh, Raghugarh, Uniara, and Kapren likewise developed out of the school that was originally supported solely by Bundi's rulers. Mughal influence was particularly strong in this Rajasthani school which lasted from the 17th to the end of the 19th century. Bundi painting also shows a likeness to painting of the Deccan in the south, a region with which the rulers of Bundi and Kotah were often in contact. Painting usually took the form of palace wall painting or miniature painting. Moving figures, rounded head forms, symmetrical, fan-shaped plantain trees, lush vegetation, dramatic night skies, and a distinctive way of depicting water (light-colored swirls on a dark background) are all hallmarks of the Bundi school. The painting produced under Rao Bhao Singh (reigned 1658-81) and Rao Anurad Singh (reigned 1681-95) was particularly distinctive, mature, and delicate; it also had a broader repertoire. Painting in Kotah saw important patrons in Rao Jagan Singh (reigned 1658-84), Maharao Umed Singh (reigned 1770-1819), Maharao Ram Singh (reigned 1827-66), and Maharao Shatru Sal (reigned 1866-89); particularly popular were lush paintings of hunting scenes involving the ruler, both in wall and miniature formats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bundi"@en .

aat:300019033 a skos:Concept ;
    skos:definition "Refers to a regional school of Rajasthani miniature painting centered around Deogarh that was an offshoot of Mewar painting; it flourished in the late eighteenth century when the quality of work at the parent Mewar court had declined. A deliberate return to pre-Muslim conventions is evident, particularly in the strong use of color and distorting treatment of figures (e.g. fish-shaped eyes, oversized heads). Other noteworthy characteristics of Deogarh painting include dreamy eyes, inflated bodies, very particular types of dress, brusquely painted forms, and a fondness for muddy colors, especially greens. Deogarh artists often created a sense of perspective in their miniature paintings by reducing the size of distant objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Deogarh"@en .

aat:300019035 a skos:Concept ;
    skos:definition "Refers to a regional school of Rajasthani painting centered around Jodhpur in Marwar. Noteworthy characteristics of late 18th-century painting include large eyes with arched eyebrows, hair curled into coils, and a row of trees across the width of the picture plane. Raja Man Singh (1804-1843) of Jodhpur was an important patron of Marwar painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jodhpur"@en .

aat:300019036 a skos:Concept ;
    skos:definition "Refers to an 18th-century Indian school of painting associated with the princely state of Kishangarh in central Rajasthan. Like other Rajput painting styles, it is somewhat indebted to contemporary Mughal painting. It is distinguished by its religious intensity and individualistic facial type consisting of pointed chins and noses, deeply curved eyes, and serpentine hair locks. Panoramic landscapes are often the background for the illustrated scene. An important patron during its formative phase was Raja Savant Singh (reigned 1748-57), who was himself a poet and devout member of the Vallabhacarya sect. The series of paintings of Radha and Krishna are particularly noteworthy. It is speculated that Savant Singh's lover may have been the model for the Kishangarh facial type. Nihal Chand is the master artist credited with transmitting his patron's romantic and religious into fresh visual images. The Kishangarh school continued at a lower level of achievement until the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kishangarh"@en .

aat:300019039 a skos:Concept ;
    skos:definition "Refers to a number of schools of Rajasthani painting found in the territory of Marwar in western Rajasthan, with its capital at Jodhpur. Painting in the far west of this region was geographically remote enough to be affected little by Mughal courtly styles; its compositions remained simple and have a distinctive angularity akin to folk art. Characteristic Marwar facial features include pointed noses, almond eyes, sloping foreheads, and pouting lips; a subdued palette of yellow, green and grey is generally used. Painting in the east of this region was more influenced by Mughal art. Marwar painting in the 18th century is more formal and courtly, with strong Mughal influence; it is epitomized by the artist Dalchand who was a gifted Mughal-trained artist working in Jodhpur. Later Marwar painting is known for its bold and exuberant coloration, swirling garments, and spiraling clouds. Marwar painting was at its most prolific in the early 19th century, particularly under Maharaja Man Singh (reigned 1803-43)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marwar"@en .

aat:300019040 a skos:Concept ;
    skos:definition "A school of miniature painting associated with the Rajasthani State of Mewar, which was an important site for Rajput culture. The people of this region were rigorous upholders of Hindu tradition and were the last Rajput power to succumb to the Mughals. Mewar is one of the most important and prolific schools of Rajasthani painting from the 17th century or earlier. The style is characterized by bold outlines, vibrant coloration, and somewhat archaic conventions such as showing consecutive episodes of action in one image. Mewar's artistic traditionalism generally stood up to Mughal, Deccani, and European influences due to the conservatism of this particular Rajput court as well as to the traditional artist family structure. Artists consistently included Mewar-specific details such as local architecture and flora and fauna. The indigenous tradition of mythological and poetical manuscript illustration underwent a renaissance here in the 17th century. The 18th century saw more Mughal-inspired court portraiture and reportage. The style faded after 1947 when the princely states were dissolved and royal patronage came to an end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mewar"@en .

aat:300019046 a skos:Concept ;
    skos:definition "Refers in a general sense to a school of painting from the Kerala region of Southern India. A diverse tradition of wall painting flourished in Kerala from at least the 15th to the 19th centuries; the most extensive and best-preserved can be found at the Mattancheri Palace at Cochin. Important examples from the 18th century include paintings from the palaces of Padmanabhapuram and Krishnapuram. Miniature painting was also practiced in Kerala. 18th-century miniature painters adopted post-Vijayanagara traditions current in south India at the time; their style is characterized by plain backgrounds and expressive line and composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kerala"@en .

aat:300019050 a skos:Concept ;
    skos:definition "Refers to paintings from Odisha (formerly called Orissa) in eastern India from the mid-16th century through the 19th century. The style includes miniature paintings, painted cloth hangings and palm-leaf manuscripts. The style is inspired by medieval art but also has Mughal, Deccani and Vijayanagara influences. The vigourous line, sumptuous color, and fine linear design that characterize Orissan miniature painting are unique in contemporary Indian painting. The cloth hangings are likewise eclectic in style and characteristically depict symbolic plans of sacral complexes in delicate earth tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orissa"@en .

aat:300019088 a skos:Concept ;
    skos:definition "Refers generally to the ethnic cultures of the region corresponding to modern Myanmar located in the western region of mainland Southeast Asia. Refers specifically to the style and period of the British colonial occupation from 1885 to 1948. Art in the region reveals bas-relief and monumental stone sculptures of Buddhist iconography and some British colonial influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burmese"@en .

aat:300019089 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the Mon people of Indo-Chinese origin, now inhabiting eastern Burma (Myanmar) and western Thailand but having their ancient capital at Pegu in southern Burma. They represent a former empire that flourished from the 9th to the 11th and from the 13th to the 16th centuries. The culture has dominated the region for the last 1,200 years, replacing Sanskrit with Pali writing and introducing Theravada Buddhism to the ancient Burmese culture. Art of this region has shared historical ties with the ancient Cambodian kingdom of Funan, and with China, and was heavily influenced by the Angkor civilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mon"@en .

aat:300019092 a skos:Concept ;
    skos:definition "Refers to a style named after the town in the southern region of modern Myanmar, situated on the Tenasserim plains, an early Mon capital designated as the epicenter of Indian culture until the 11th century. The style features prominent Mon sculpture, Brahmanic stone stelae, and stone bas-reliefs of the deities Vishnu, Ananta, Brahma, and Shiva in various meditative positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thatôn"@en .

aat:300019094 a skos:Concept ;
    skos:definition "Refers to the culture associated with a city-kingdom in ancient Burma that flourished from about 1 CE to 9 CE and encompasses the southern regions Binnaka, Mongamo, Sri Ksetra, and Halingyi. Architecture in the region features vaulted temples, houses, palaces, and monasteries built of timber, roofed with tiles of lead and tin, and containing walls comprised of glazed brick. Decorative arts and crafts within households included kitchen utensils made from gold and household figurines made from gold, green glass, jade, and crystal. Cylindrical stupas or large burial urns of various dimensions adorned the periphery of the kingdom's city walls and temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pyu"@en .

aat:300019104 a skos:Concept ;
    skos:definition "Nationality, culture, or style of Cambodia, located in the southern portion of the Indochina Peninsula in Southeast Asia. Arts and crafts of the region reveal Indian and other regional influences through various sculptures of wood and stone, lapidary pieces comprised of silver, gold, and ivory, and silk sheath pieces in various luxurious hues of red, blue, and gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cambodian"@en .

aat:300019107 a skos:Concept ;
    skos:definition "Refers to the pre-Angkor style and period surrounding the Cambodian kingdoms of Funan (1st to 9th centuries) heavily influenced by Indian ideas. The style is mainly evident in the lower valleys of the Mekong River. Sculptural production in this style consists of large, freestanding sandstone figures of deities from Hindu, Siva, and Vishnu texts. Religious sculptures often consist of several deities combined into a single figure and is characterized by smooth, continuous surfaces enhanced by broad frontal planes and by side recessions connected to the foursquare block. The period also witnessed the rudimentary development of non-Indian elements such as the sandstone lintels made for doorways of brick shrines, the concept of the lintel as a special attribute of the spirit shrine, and relief carvings based on pairs of monster creatures and foliate designs. Buddhist icons in this style are constructed in sandstone and are less sensuous and delicate than Hindu figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Funan"@en .

aat:300019109 a skos:Concept ;
    skos:definition "Refers to the pre-Angkor style and period surrounding the Cambodian kingdoms of Chen-la (1st to 9th centuries) heavily influenced by Indian ideas. The style is mainly evident in the lower valleys of the Mekong River. Sculptural production in this style consists of large, freestanding sandstone figures of deities from Hindu, Siva, and Vishnu texts. Religious sculptures often consist of several deities combined into a single figure and is characterized by smooth, continuous surfaces enhanced by broad frontal planes and by side recessions connected to the foursquare block. The period also witnessed the rudimentary development of non-Indian elements such as the sandstone lintels made for doorways of brick shrines, the concept of the lintel as a special attribute of the spirit shrine, and relief carvings based on pairs of monster creatures and foliate designs. Buddhist icons in this style are constructed in sandstone and are less sensuous and delicate than Hindu figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chen-la"@en .

aat:300019120 a skos:Concept ;
    skos:definition "Refers to the pre-Angkor style named for a monument founded in the late seventh to eighth centuries. Architectural design in this style primarily features brick construction, Indian Gupta plans evidenced by small rectangular cella housing sacred images, towers with corbelled vault systems, and repeating patterns of leaf and foliate relief bands adorning colonnettes. The style emphasizes the worship of Hindu deities, particularly Shiva. The style of sculpture exhibits similarities to Hindu and Buddhist sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kompong Preah"@en .

aat:300019126 a skos:Concept ;
    skos:definition "Refers to the pre-Angkor style of the mid-ninth century generally evidenced by the temple complex of Sambor Prei Kuk. Temples in this style follow the Indian Gupta and post-Gupta plans and feature primarily brick construction, central sanctuaries, molded bases, walls divided into vertical panels by pilasters and ornamented with false doorways, niches, relief panels, and pyramidal towers that imitate in smaller scale the design of the main temple façade. The style is often distinguished by carved lintels that are supported by circular colonnettes and arched bands with floral patterns interspersed between circular medallions enclosing an image of a deity or sacred creature. The sculptural style also reveals strong early Hindu influences featuring multi-armed deities in the round, a strong sense of weight shift in large sculpture, scarcity of high relief sculpture, subtle stylized realism, austere garments and bodily adornments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kulên"@en .

aat:300019134 a skos:Concept ;
    skos:definition "Refers to the style named for the site of the last of the royal capitals of the Angkor kingdom. Artistic productions in this style include the Royal Square of Angkor, a plaza space featuring the temple of Phimeanakas (late tenth century), the two Khleangs (early 11th century), the Baphuon (mid-11th century), and the Bayon. Style of sculpture features large scale monuments of guardian figures such as Indra riding his three-headed elephant. In the site, telamones in the form of royal beasts and human-animal hybrids support and brace the Royal Terraces. Other supporting walls feature sculptures of deity figures arranged in various registers corresponding to different levels of metaphysical existence. Frieze reliefs on temples exhibit elephants in war and hunting scenes. Sanctuary structures in the site feature towers adorned with large-scale sculptures of guardian faces that are situated at various levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angkor Thom"@en .

aat:300019135 a skos:Concept ;
    skos:definition "Refers to the style developed during the late 10th to the 11th centuries in Angkor. The style is characterized by foliage motifs, scarcity of sculpture in the round, and youthful-looking sculptural figures wearing thin, clinging garments lacking diadems and adorned with crisp, carved jewels and finely incised pleats. The style is evident in monumental sculptures, such as the Khleangs, the Phimeanakas, and Ta Keo, and in relief sculptures on lintels and tympana. Tympana in this style contain rectangular relief panels that illustrate scenes from the lives of Rama and Krishna through vivid portrayals of movement rather than through accurate representation of anatomical details. Hindu-influenced Buddhist sculptures also flourished under this style, featuring hairstyles set in fine braids rather than in snail-shell curls. Bronze productions in this style feature figures with inlaid eyes and eyebrows and a varied subject matter ranging from decorative to sacred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baphuon"@en .

aat:300019136 a skos:Concept ;
    skos:definition "Refers to a style named for the Buddhist Temple of Bayon, a central temple built by Jayavarman VII (1181-1220 CE) in the capital Angkor Thom. The style is characterized by wide gallery spaces, central sanctuaries in a circular ground-plan surrounded by an array of chapels, and towers positioned atop sanctuaries adorned with carved, large-scale faces. The style is driven by fervent religious sentiment and spiritual obligations to provide a central rendezvous and respite for the gods to conduct celestial ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bayon"@en .

aat:300019138 a skos:Concept ;
    skos:definition "Refers to the style named for the temple-mountain built by King Yashovarman I (889-900 CE) at the center of the capital city for the veneration of the god Shiva. The architectural style of the temple marks the first establishment of the stepped pyramid form and served as the model for later temple-mountain complexes. The temple complex features a five-tiered construction cut directly from rock, tower-sanctuaries in quincunx formation, axially-oriented staircases at specific angles leading to shrines, secondary brick shrines, terraces, four images of the sacred bull Nandi guarding the base of the pyramid, and staircases flanked by seated lion monuments. Sculpture of this style exhibits a movement away from the more fleshy, polished styles toward more angular, bony, almost inhuman bodily depictions of deities in frontal stances. Sculptural figures are characterized by their broadness in scale, square jaws, abstract placid facial expressions, linearity in facial details, and lack of graceful movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bakheng"@en .

aat:300019143 a skos:Concept ;
    skos:definition "Refers to the early Angkor style that developed during the second quarter of the tenth century following the rise of the Bakheng style. In sculpture, the style reflects similarities to the Bakheng style in the handling of garments, hairstyles, and jewelry and in the predominance of frontality and linear abstraction of features. Sculptural productions in this style, unlike in other early Angkor styles, feature earrings and amulets and figures depicted in dynamic, action-filled poses with legs and arms extended. In decorative arts, the style is distinguished by the munificent foliate motifs that surround figures of deities and attendants in the tympana above the lintels. Guardian figures inhabit niches in temple doorways and exude an aura of inflexible formality in their postures and facial expressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koh Ker"@en .

aat:300019151 a skos:Concept ;
    skos:definition "Refers to the period of the reign of Mahendravaman I of the Pallava dynasty (late seventh to late eighth centuries) characterized by an inconographic scheme showing the legitimatization of royal power through religion. Monumental sculpture of the period features family tableaus composed as allegorical references to deities. The period also features sculptural art in caves featuring doorkeepers or guardian figures carved in relief at entrances, cylindrical phallic symbols carved into square or octagonal pedestals that signified godhead, and relief panels of Hindu deities. In this period, advances in perspective and foreshortening were achieved in sculpture, resulting in freedom from strict alignment with ground planes and more realistic proportions. The period is also characterized by the prevalence of cave dedications such as wall inscriptions and rock carvings featuring Sanskrit holy and literary texts. Rock architecture from this period incorporates Hindu texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahendravarman"@en .

aat:300019154 a skos:Concept ;
    skos:definition "Designates the period of the rule of King Jayavarman I (657-681CE) over the pre-Angkor kingdom of Chen-la. Artistic production in this period emulates Hindu models and is motivated by the Indian epics of Mahbhrata and Rmyaa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jayavarman I"@en .

aat:300019155 a skos:Concept ;
    skos:definition "Designates the period and style during the reign of King Jayavarman II (802-850 CE). Artistic production of this period was motivated by Khmer independence, the centralization and deification of the Khmer monarchy, the establishment of the devaraja cult as the official state religion, and the reunification of the old kingdom of Chen-la, which later incited the formation and expansion of the Angkor empire. The style and Angkorean culture under the 9th century king of Cambodia, Jayavarman II"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jayavarman II"@en .

aat:300019157 a skos:Concept ;
    skos:definition "Refers to the period of the expansionary reign of King Indravarman I (877-890 CE) during the foundational Angkor period. The style of this period is characterized by grandiosity in building campaigns, city planning featuring elaborate irrigation systems, and monuments and tombs honoring the legacies of patrons. Architectural production features the first Cambodian temples to be built primarily of stone rather than brick with stucco adornments. The period also witnessed the development of the temple-mountain prototype, an ancestor of future larger, royal temples in Angkor. Sculptural developments of the period include sculpture in the round of multi-armed Hindu deities maintained by horseshoe-shaped supports, featuring subtle stylized realism evidenced by the carved anatomical details such as tear-ducts, elaborate chignons, planes of the torso, and garment drapery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indravarman I"@en .

aat:300019158 a skos:Concept ;
    skos:definition "Refers to the style and period of the early Angkor empire associated with the rule of King Yashovarman I (889-900 CE). The style of this period is characterized by the prominence of religious temples as city centers and the embryonic development of the temple into five-tiered pyramid structures built of sandstone, surmounted by sandstone tower-sanctuaries in quincuncial arrangements, and featuring subsidiary shrines, libraries, galleries, and gopuras. Temples of this period also developed into complex structures whose design featured Indian-influenced chronological symbolism and seasonal cycles. Decorative arts and sculpture in the period exhibited the endeavors of Yashovarman I to represent his kingdom as a model of the cosmos and symbolic center of the world. Sanctioned artistic productions featured high relief sculptures of guardian figures and celestial beings and bas relief carvings of foliage swirls and jewel bands that surround figures of deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yasovarman I"@en .

aat:300019161 a skos:Concept ;
    skos:definition "Refers to the period of the reign of King Jayavarman IV (921-944 CE) and the move of the capital from Angkor to Koh Ker. The style of this period is characterized by the continuing development and enlargement of the temple-mountain structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jayavarman IV"@en .

aat:300019164 a skos:Concept ;
    skos:definition "Refers to the period of the reign of King Jayavarman V (968-1001 CE). The architectural style of the period is exemplified by the state palace temple, Ta Keo, located at the center of the capital Jayendranagari, and the Banteay Srei, a decorated temple that features colonettes and lintels in the archaic style and depicts scenes from Indian mythology on the tympana. The period is generally characterized by the continuing use of sandstone and the further development of tiered, pyramidal temple constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jayavarman V"@en .

aat:300019166 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the reign of King Suryavarman I (1002-1050 CE), generally considered the first Buddhist ruler of Angkor. The period is characterized by prolific building programs that included sandstone constructions of minor temples and of the Royal Palace that featured the first fortified wall encompassing a palace in Angkor, storehouses and treasuries known as Khleang, and a single central tower-sanctuary rather than the more commonplace five towers in quincunx configuration. Examples of other architectural and sculptural innovations of this period exist on the site of Preah Vihear where series of courts and gopuras are set on a longitudinal axis rather than in concentric enclosures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suryavarman I"@en .

aat:300019168 a skos:Concept ;
    skos:definition "Refers to the period named for the reign of King Harshavarman III (1066-1080 CE) in the early Angkor empire, characterized by rapid expansion and city planning. Monuments of the period evolved into distinct functional or symbolic types. The first of these types was the temple-mountain, a structure built on the summit of a hill or mountain as a terraced pyramid that housed a central sanctuary in which an image symbolizing the king's power was placed. The other type was a temple built on level ground and based in design on Indian and Cambodian temples. Both temple types generally featured brick, laterite, or sandstone construction, groups of interior sanctuaries, and corbelled arches. Sculpture of this period typically included examples of the Koh Ker style (second quarter of the tenth century) and the Banteay Srei style (second half of the tenth century), featuring relief sculpture depicting a series of Indian legends and architecture associated with the coordination of space between enclosures and terraces, and the style of the Khleangs (late 10th to the early 11th century), featuring a range of foliage motifs on temple tympana and figures of youthful and often dimpled deities dressed in thin, clinging fabric and adorned with jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Harshavarman III"@en .

aat:300019171 a skos:Concept ;
    skos:definition "Refers to the style and period of Middle Angkor surrounding the reign of King Suryavarman II (1113-1150 CE). The style of this period is driven by the expansion of the Angkor empire and the foundation of the exemplar state temple Angkor Wat. Style of sculpture during this period features narrative low relief in continuous narrative sequences that represent passages from Hindu religious and mythical texts, and exhibits the predominant color red as a symbol of veneration. This use of shallow relief ensured the harmonious juxtaposition of the whirling, frenetic figures carved into the frieze and the distinct clean linearity of the architecture. Among the minor relief figures of deities decorating the walls of shrines, the element of sensuality dominates. Sculptural themes reflect narrative finesse, royal ambitions, kingly heroic deeds, and detailed characterization of just and wicked figures achieved through exaggerated proportions and intricate costume attributes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suryavarman II"@en .

aat:300019175 a skos:Concept ;
    skos:definition "Refers to the period of the reign of King Jayavarman VII (1181-1220 CE) over the Angkor empire. It is marked by the triumphant expulsion of the Chams invaders from Angkor. The period witnessed exceptional building activity and city fortification honoring the omnipotence and centralized authority of the king and the institution of Mahayana Buddhism as the state religion. Style of architecture of the period is associated with colossal temple-mountains situated in the center of the capital Angkor Thom. Temples built in this period increasingly demonstrated sheer size rather than the subtle proportions of previous temple styles. The period also saw the first occurrence of \"face-towers\" in temple architecture, large stelae superstructures turned in the cardinal directions and decorated with large faces on each side that symbolize the supremacy of the bodhisattva Lokeshvara and of the king. Sculptural styles of the period reflecte religious unity, grandeur, and exuberance through the emphasis on exaggerated symbolism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jayavarman VII"@en .

aat:300019177 a skos:Concept ;
    skos:definition "Refers to period of the reign of King Jayavarman VIII (1243-1295 CE). The style of the period reflects the massive scale building projects of the preceding reign. One significant example of architectural and sculptural achievements of this period exists in the Mangalartha temple located in the north-east of Angkor Thom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jayavarman VIII"@en .

aat:300019181 a skos:Concept ;
    skos:definition "Refers to the style originating in former kingdom of Champa which later integrated with styles of the Vietnamese region and other parts of Southeast Asia. The Cham influence in the Vietnamese region is driven by the spread of animist beliefs, Javanese models and motifs, and Indian-influenced styles and beliefs featuring brahmanes temples adorned with female images, ceremonial rites performed in honor of deified heroes, and religious themes adopted from Shaivism, Vaishnavism, and Mahayana Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cham"@en .

aat:300019183 a skos:Concept ;
    skos:definition "Refers to the period associated with the Shaivite area known as Mi-son in central region of modern Vietnam. Architecture and monumental sculpture in this period is sub-classified A through H according to location. In general, the period features artistic properties from pre-Angkor, Angkor, and Indonesian works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mi-son"@en .

aat:300019184 a skos:Concept ;
    skos:definition "Refers to the subperiod of Mi-son art prevalent during the tenth century. The style of the period is considered representative of Cham art at its most developed and articulate stage, marking the evolution of architectural and sculptural features in the gradual replacement of the Buddhist Dong-duong style with the Shaivist, classical style. Artistic production from this period includes the tympanum depicting Vishnu's incarnation, the Khuong My group featuring free-standing statues, and a cornucopia of animal sculptures featuring bulls, elephants, lions, mythical beasts such as garuas, makaras, and others derived from Indonesian and Thai models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mi-son A 1"@en .

aat:300019185 a skos:Concept ;
    skos:definition "Refers to the subperiod of Mi-son art prevalent during the mid-seventh century in the northeast sector of the Mi-son site. The style of this period is characterized by strong Indian influences and includes the oldest monuments in Champa. A prominent example from this period is a sanctuary dated to the reign of King Prakashadharma-Vikrantavarman I (c. 657 CE), featuring carved pedestals, projecting socketed doors opening to a terrace with a framed porch and narrow stairway, a raised base adorned with short pilasters similar to Mon Dvaravati architectural details, and wide brick jambs. In sculpture, the period reflects influences from the Dông Son, Chen-la, and Indian cultures and adopts iconography from Hindu Shaivite and Buddhist cults. Examples from this period in sculpture include a fronton depicting the birth of Brahma and Vishnu lying on the mythical serpent Shesha reminiscent of pre-Angkor lintels, a pedestal structure from the temple featuring historiated surfaces, panels, and niches that depict the daily life of monks in the Himalayas, and a free-standing statue of Ganesha with tiger-skin drapery and four arms holding up tokens such as a rosary, an axe, and a turnip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mi-son E 1"@en .

aat:300019186 a skos:Concept ;
    skos:definition "Refers to the period associated with the Hoa Lai in the northern end of the plain of Phan Rang from the mid-eighth to the mid-ninth century. Prominent examples of architecture from this period include the temples of Hoa Lai, featuring a kalan, decorated pilasters, numerous arches, prominent overhangs, a brick enclosure, bases decorated with appliqués depicting the buildings in miniature, and Indonesian-Javanese elements, and a temple structure at Mi Son, characterized by octagonal stone colonnettes decorated with three central rings and vertical bands, pilasters with alternating plain and decorated bands, carved foliage, and arches decorated with unvermiculated lines. In sculpture, the period is limited and less innovative, featuring dv'rap'las statues with disc-shaped ear pendants and long hair, carved into the brick frames of doors and false doors, and Javanese-inspired images of Buddha, bodhisattvas, and deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hoa Lai"@en .

aat:300019188 a skos:Concept ;
    skos:definition "Refers to the period in Champa associated with the royal monastery complex Dong-Duong founded by King Indravarman II (875-889 CE) and prevailing in the region from the ninth to the early tenth century. Architectural features from this period are based on the Dong-Duong complex and include brick construction, sanctuaries grouped within inner enclosures, pillared halls, interior and exterior piers supporting the stupa, multi-story brick kalan, columnar structures known as stambahs similar in shape to Buddhist tower-stupas, a long hall known as a vih'ra containing Buddha images, and altars restrictively placed against walls. In sculpture, the period is driven by the religious trend of Mahayana Buddhism and features Buddha figures draped in the Chinese manner, dv'rap'las figures with fierce expressions, thick lips, stylized ears, and close-cropped short side whiskers, bronze sculptures of Buddha cast by the lost-wax process, bas-reliefs decorating tympana and altars, exhibiting various royal personages in stylized actions, and elephant statues with the hind legs bent and with the head turned forwards or trunk raised. Shaivite heads and female images of Tara produced in this period feature strong frontality and exaggerated features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dong-duong"@en .

aat:300019189 a skos:Concept ;
    skos:definition "Refers to the period before the eighth century associated with the site Tra-Kieu. Artistic production in this period features elements of sensuality and intricacy of detail with an emphasis on feminine images and motifs, such as the female breast and smiling female dancers, and on images of movement such as a high relief sculpture depicting Hindu gods on their galloping mounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tra-kieu"@en .

aat:300019190 a skos:Concept ;
    skos:definition "Designates the period that began with the pacifying rules of Harivarman IV (1074-1081 CE) and Jaya Indravarman II (1113-1145 CE) and flourished from the 11th to the mid-12th century. In architecture, the period features distinct kalan groups known as the Silver Towers, the Gold Tower, the Ivory Towers, and the Copper Tower, constructed along hill terraces and exhibiting redented plans and silhouettes much like the Khmer prasat. Other architectural features in this period include projecting spearhead arches often tripled above doors or false doors, plain pilasters, moldings, colonnettes engaged vertically against rows of foliate ornamentation, and friezes decorated in carved stone with the 'woman's breast' motif. Later in the period, prevailing stylistic simplification yields the clarification of kalan structures and structural masses. In sculpture, the period features images of mythical animals such as the makara used as corner pieces, serpents, elephants, and garuas and lion figures used as atlantids with fangs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Binh Dinh"@en .

aat:300019195 a skos:Concept ;
    skos:definition "Refers to the style associated with Laos located in the valley of the Upper Mekong. The hybrid style reflects Myanmar, Thai, and Khmer influences. The basis of the artistic style of this region is religion and tradition, characterized by Buddhist and Hindu iconography and narrative relief panels rooted in Theravada Buddhist and Hindu principles. Folk arts in this style feature basket making, wood and ivory carvings, and silver and gold works. In architecture, the style features temples patterned after Khmer temple mountains with sloping, stepped roofs comprised of small flat tiles, and the wihan, a rectangular building containing an altar with Buddhist images. In sculpture, the style is mostly devoted to the representation of Buddha in royal attire. Sculpture is constructed in bronze, lacquered wood, and sometimes stone and is adorned with inlaid glass or mother-of-pearl. Bas-relief sculpture is rare and is mostly found as wood murals, though mural scenes in lime mortar, stucco, or cement exist. Textile arts in the style feature silk cloth with ikat and weft designs that include dot patterns, geometric and zoomorphic motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laotian"@en .

aat:300019196 a skos:Concept ;
    skos:definition "Refers to the style and period surrounding the culture that flourished in the Cambodian kingdom of Lan Xang (1353-1707 CE). The style of this period is based on indigenous innovations and Khmer and Thai influences. In religious architecture, the style is evidenced in the Vat Visum (1503 CE) and in the Vat Xieng Thong (1561 CE), featuring grandiose stupas or reliquary monuments, tiled, sloping, overlapped roofs, eaves supported by corbels or by gilded or lacquered consoles, and wood construction. Secular buildings are constructed in wood also and feature gilded low reliefs. In this period, the sanctuary and meeting house structure housing holy images developed and expanded. Sculpture in this style is overwhelmingly Buddhist in theme and iconography, though some Hindu sculptures exist, and features figures in bronze, stone, precious metals, dry lacquer, and terracotta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lan Xang"@en .

aat:300019197 a skos:Concept ;
    skos:definition "Refers to the style named for the artistic culture that flourished in the city of Luang Prabang in northern Laos. In sculpture, the style is renowned for statuary productions of Buddha that reflect indigenous and Khmer influences. In architecture, the style marks a period of temple construction and restorations that included the Vat Visum (1503) and Vat Mai (1796 CE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luang Prabang"@en .

aat:300019198 a skos:Concept ;
    skos:definition "Refers to the style named for the capital city of Laos established by King Setthathirath (1548-1571 CE). The style is centered around the region's cultural mingling with the civilizations of the Chao Phraya Basin, the Mon Dvaravati, Thailand, and Angkor. In sculpture, Buddhism provides thematic and iconographic programs and features monuments such as the Stele of Hospitals, directly reflecting the Angkor style prevalent in the reign of King Jayavarman, and the Phra Bang Buddha image. In architecture, the style is evidenced by prominent temple structures such as the Royal Palace, the Vat Ho Phra Kaeo, and the That Luang, a stupa housing the relic of the Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vientiane"@en .

aat:300019199 a skos:Concept ;
    skos:definition "Refers to the style and culture of the region known as modern Thailand. Artistic production primarily focuses on the crafting of porcelain and pottery, painting, sculpture, and architecture, and exhibits stylistic influences from China, India, and other regions and cultures in Southeast Asia. Temple styles in the region specifically imitate Hindu and Buddhist models with unique variations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thai"@en .

aat:300019201 a skos:Concept ;
    skos:definition "Periods realted to Thai cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thai periods"@en .

aat:300019202 a skos:Concept ;
    skos:definition "Refers to the period of activity of a culture tied to a village and mortuary site in northeast Thailand, in the province of Udon Thani, discovered in 1966. Dating the Ban Chiang cultural tradition has been controversial. Excavations in 1974 and 1975 showed that the site was occupied for thousands of years. The first thermoluminescence dating indicated the earliest dates to be 4420-3400 BCE, but later radiocarbon dating indicated the earliest grave was about 2100 BCE, the latest about 200 CE. These dates remain inconclusive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ban Chiang"@en .

aat:300019204 a skos:Concept ;
    skos:definition "Refers to the period of the Thai kingdom of Dvaravati that flourished from the 7th to the 11th century. Artistic production of this period primarily consisted of Theravada Buddhist monumental sculpture carved from schistous limestone and painted with red pigment, gilded bronze sculptures, bas-relief sculpture with stucco decorations representing scenes from the J'takas and accompanied by guardians and mythical animals, stupa structures modeled after Indian prototypes featuring a hemispherical construction and low square base surmounted by spires composed of flat rings crowned by a bulb, and rectangular wihan built in brick with clay mortar on laterite bases. Examples of temple complexes in this period are evidenced in the precincts of Wat Kukut in Lamphun. The temples of this period feature laterite construction, receding square tiers, pointed spires composed of many concentric rings and decorated with small stupa, and niches containing standing Buddha images in stucco and terracotta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dvaravati"@en .

aat:300019210 a skos:Concept ;
    skos:definition "Refers to the period from the 8th to the 13th century in southern Thailand, named for the former maritime center known as Srivijaya. Artistic production from this period centers around a diversity of styles reflecting its cross-cultural traditions. The period also features conventions from Pala Indian art such as the focus on details of dress, jewelry, throne backs, and body haloes. In sculpture, the period features Mahayana Buddhist images and highly developed quadrangular clay votive tablets which became a widespread international style in much of Southeast Asia and depict the Mahayana pantheon. In architecture, the period features temples in cruciform plans with cellas surrounded by smaller shrines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Srivijaya"@en .

aat:300019213 a skos:Concept ;
    skos:definition "Refers to the styles associated with the peninsular region of Thailand. The styles are driven by the region's geographical location characterized by maritime trade and transpeninsular river passages that encouraged cultural exchanges. In architecture, the style reached fruition during the 8th through the 13th century and is evidenced by the Wat Kaeo featuring a cruciform structure with central cella, shrines that housed five Jina Buddhas, large stone pillars, colonnettes, and miniature decorative arches reminiscent of Cham (ninth and tenth centuries) and Srivijayan architecture. In sculpture, the style features bronze Mahayana Buddhist figures and clay votive tablets depicting Buddha and bodhisattvas in post-Gupta Indian style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peninsular"@en .

aat:300019214 a skos:Concept ;
    skos:definition "Refers to the period whose output is analagous to Khmer artistic models developed in the region of modern Cambodia. In architecture, the period can be divided into three subperiods: From the seventh to the ninth century, the period harks back to pre-Angkor Khmer styles and features brick construction, square towers, sanctuaries with redans and corner pilasters, corbelled vault roof systems, and molded bases with entrances on the east side and false doors on the remaining three sides. From the 10th to the early 13th century, the period reveals more aggressive Khmer influences and is characterized by the Prasat Wat Prang (tenth century) and Prasat Ban Chang, both featuring brick towers with sandstone doorframes on a north-south axis, pilasters, and trilobed lamp niches, and by the Prasat Phra and Prasat Phanom Wan, both featuring vestibules and mondops housing relics or Buddha images. From the late 13th to 14th century, the architecture developed regional artistic elements but retained traditional Khmer iconography. Temples in this latter style feature laterite construction, extensive sanctuaries dedicated to Buddha and bodhisattvas, the prang, a distinctively Thai structure characterized by the upward elongation of the bullet shape of the classical Khmer tower sanctuary, and further variations on the mondop and square tower with redans. In ceramic production, the period features mostly flat, brown-glazed or green-glazed works with incised geometric designs and modeling of animal-like forms on jars and pots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lopburî"@en .

aat:300019215 a skos:Concept ;
    skos:definition "Refers to the culture and period that flourished from the 7th to the mid-15th century in the region known today as Cambodia and later migrated to other regions in Southeast Asia. The style of this period is complex and developed in different sub-phases, and is driven by animistic beliefs, Theravada Buddhism, and Indian Hinduism. Artistic production in this period is diverse and reflects Indian and other regional influences in sculpture, architecture, and the decorative arts. In architecture, the period features Hindu and Mahayana Buddhist temples in laterite, sandstone, or brick constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khmer"@en .

aat:300019216 a skos:Concept ;
    skos:definition "Refers to the period designating all Khmer or Khmer-inspired art associated with the region known today as Thailand. Artistic production from this period generally follows Khmer designs and artistic and intellectual movements with some local adaptations and variations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lopburi-Khmer"@en .

aat:300019217 a skos:Concept ;
    skos:definition "Refers to the period named for the Sukhothai kingdom that flourished in the region of Thailand from the late 13th to the mid-15th century. The period is considered the golden age of Thai civilization, dramatically influencing all other subsequent periods. In sculpture, the period is driven by religious orthodoxy, featuring refined Buddhist and Hindu images in bronze and stucco. A prevalent iconographic theme in sculpture was the Buddha's Footprint, often carved into stucco or stone, decorated with Wheel of the Law inscriptions and figures of deities and Buddhas, and found in wat temples throughout the region. Buddha images in this style predominantly feature a flame-like halo, hair set in small, pointed curls, and a hooked nose and mouth. Sukhothai sculptors were the first to portray Buddha in all four physical manifestations: sitting, reclining, standing, and walking. Productions in bas-relief recount dramatic religious events and are usually constructed in stucco. Architecture of this period features brick and laterite constructions, timber roofs covered with glazed terracotta tiles, the unique lotus bud-shaped stupas, conventional structures such as the prang, mondop, and wihan, stone pillars with carved capitals, niches housing Buddha sculptures, Khmer-style towers and makara sculptures in the pediments of niches, and a stylistic tendency toward attenuation and sleekness in architectural construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sukhothai"@en .

aat:300019219 a skos:Concept ;
    skos:definition "Refers to a style associated with the northern region of Thailand. Artistic production in this style primarily deals with the wood carving arts and features teak figures of Brahmanical and Hindu gods and of Buddhist images. Sculptures and carvings were often inlaid with mother-of-pearl or glass mosaics. The style is driven by the desire to intermingle animal, plant, and human life, evincing a detailed, exuberant blend of myth and realism. From this distinctive art, stylistic contradictions emerged, evidenced by sculptural figures of menacing demon entities doubling as guardian beings and by rigid geometric patterns set amidst designs of fanciful creatures on wooden relief panels. The most dramatic example in this style are the grandiose wooden royal barges and royal funeral chariots, both completely gilded constructions with mythical serpents and ornamental floral designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Thai"@en .

aat:300019221 a skos:Concept ;
    skos:definition "Refers to the period named for the city and ruler Û Thong based in the Suphanburi Province of western Thailand. The style of the period came into fruition with the Khmer withdrawal from central Thailand in the second quarter of the 14th century. The period is generally classified under sub-sculptural styles known as groups A, B, and C, that combine Mon, Dvaravati, Haripunjaya, and Khmer elements in various ways. Group A features Buddha images with prominent foreheads, almond eyes, straight noses, and tiny conical curls. Images in Group B exhibit stronger Khmer influences as revealed in the square face and austere, impersonable facial expression. Group C features Buddha images reflecting Ayutthaya and Sukhothai influences as shown in the oval face, elongated body, smiling expression, and notched design on the robe flap over the left shoulder. Most Buddha images in all three groups are seated in the hero position on a pedestal with hands in the gesture of subduing Mara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Û Tong"@en .

aat:300019226 a skos:Concept ;
    skos:definition "Refers to the period surrounding the ancient city of Ayudhya that existed from the mid-14th to the 18th century. In sculpture, the period mostly features images of Buddha cast in bronze, stone, or stucco. In the early 14th century, a refinement of sculptural styles culminated in the eThong style characterized by several sub-types of Buddha images. One type features the Buddha figure with a prominent forehead, almond eyes, straight lowered eyelids, and conical curls on the head. A second type displays stronger Khmer influences apparent in the square face and austere expression. The third type of Buddha sculptural style manifests an elongated body and a smiling expression. In architecture, the period features temple-sanctuary complexes known as wat, the more prominent ones being Wat Thanmikarat, featuring a staircase decorated with stucco lions and a bai sema or boundary stone made of slate; Wat Phutthaisawan, featuring Khmer-influenced galleries, stupas with redans, and wall paintings; Wat Yai Chaimongkhol, featuring elaborate stupas and wihans and rectangular galleries; and Wat Phra Ram, featuring a square plan, brick construction, and artificial pools. Ceramic styles also mature in this period, featuring brilliant colors of jade green, light grass green, blue-green, brown, pale honey, and white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayudhya"@en .

aat:300019229 a skos:Concept ;
    skos:definition "Refers to the period named for the capital city of Thailand founded by Rama I (1782-1809 CE) in 1782. In architecture, the period is best represented by the various constructions and subsequent renovations in the Grand Palace (Phra Borom Maha Ratchawang) which includes the Amarin Winichai Hall, featuring a T-shaped plan, and the Dusit Maha Prasat Throne Hall (1789), featuring a Latin Cross plan, lacquered and gilded doors and windows, and gilded nine-tiered spires. Temples in this period feature main sanctuaries that house the Palladium of the kingdom and other revered Buddha images, altars depicting the Traiphum or realms of existence, friezes of gilded garuas, ubosots or elongated ordination halls, mother-of-pearl inlaid works, bronze lions, wihans or assembly halls, and multi-tiered roofs. Later in the 19th century, architectural styles reflected European colonial aesthetics. In sculpture and painting, works of this period display scenes from the Ramakien and from Hindu texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bangkok"@en .

aat:300019233 a skos:Concept ;
    skos:definition "Pottery styles belonging to Thai cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thai pottery styles"@en .

aat:300019234 a skos:Concept ;
    skos:definition "Refers to the style of pottery developed in the 18th century based on Chinese enamelware and potteryware styles. The style, once a royal monopoly, expanded and spread throughout the region after the establishment of Bangkok as the new dynasty capital in 1782. Wares in this style usually express the famille verte or famille rose palette. The style features multicolored glazes, enamel work that tends to encompass the entire piece in bright and repetitive patterns, Thai angel figures, and royal lions. Tablewares and household utensils usually exhibited this style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bencharong"@en .

aat:300019237 a skos:Concept ;
    skos:definition "Refers to the style of pottery developed from the compulsion to produce vast quantities of ceramics for export during the Ayutthaya period. These export wares included large dishes, bowls, vases, oil lamps, miniature elephants, spinning pulleys, plumb-weights, and roof tiles. Ceramics in this style can be divided into five types: celadon which describes high-fired stoneware covered with a natural feldspathic, wood-ash glaze, underglaze black, brown and pearl, brown, and white. Colors of these ceramics ranged from light green to olive green or blue green and from brown to pale honey or near-white. Pottery and ceramics in this style were predominantly plain and utilitarian but some pieces exhibited combed or incised patterns under the glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sawankhalok"@en .

aat:300019239 a skos:Concept ;
    skos:definition "Refers to the cultures that developed in the region situated along the eastern coast of the Indochinese Peninsula known as modern North and South Vietnam. Artistic production in this region features a broad scope and an intermingling of styles, featuring dynastic temple construction that included variations of tower shrines, sanctuaries, porticoes, molded capitals, and recesses, and grandiose and refined sculptural programs featuring monster figures that decorated corners of architraves, figures of lions, solid snake-like ornamentation reminiscent of Indo-Khmer foliage motifs and Dong Song styles, and large icons and relief panels carved in sensual styles suggestive of Chen-la works. From the 15th through 18th centuries, architectural planning incorporated Confucian and Taoist elements and sculptural styles of this period feature elaborately-colored woodwork based upon the dragon-and-cloud decoration of the Ming and Ch'ing Dynasties of China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vietnamese"@en .

aat:300019246 a skos:Concept ;
    skos:definition "Refers to the period of the eighth and ninth centuries named after the capital of the Chinese province of Annam at Dai-Lai. The style of the period is driven by the flowering of Buddhism that influenced the development of sculpture and architecture and by an infusion of Chinese and Cham styles. In sculpture, the period features images from the Buddhist pantheon and of Buddhist monks constructed in wood or stone, stone pillars, kinnara mythical figures, lokapala guardian figures displaying Indian and Chinese decorative influences, and bas-relief carvings depicting plants and figures reminiscent of cave sculptures of Yungang and Longmen in China. In architecture, the period features terracotta moldings on temples, stupas built in brick, and motifs on structures featuring stylized dragons, clouds, and plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dai-La"@en .

aat:300019247 a skos:Concept ;
    skos:definition "Refers to styles and methods of ceramic production used in Vietnam since the first century. The style generally reflects strong Chinese influences; however by the 11th century, the technology, shapes, and designs of ceramics evolved into more distinct Vietnamese styles. The style can be divided into pre-export wares, featuring brown-and-white incised urns, basins, and squat jars with floral, leaf, lotus and chrysanthemum blossom motifs; early export wares, featuring an identifiable whitish or grayish body, hard and fine texture, and a dark chocolate-colored or lighter brown-colored base; and blue-and-white wares, featuring a special underglaze used in the 14th century, designs of flowers, lotus scrolls, and swimming fish, and an overglaze enamel in red, green, and yellow. Blue-and-white wares continued to evolve until the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Annamese"@en .

aat:300019254 a skos:Concept ;
    skos:definition "Ceramic style, originally a folk style produced in South China, but spread to elsewhere in China, Japan, Vietnam, and many other areas of Asia; distinguished by colored glazes and low relief decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cochin Chinese"@en .

aat:300019255 a skos:Concept ;
    skos:definition "Refers to a style region encompassing the Mediterranean and the Occident."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Western World"@en .

aat:300019257 a skos:Concept ;
    skos:definition "Refers to the period antecedent to the first contemporary written accounts of a people. The time span for this period varies according to specific local habitation patterns and in different scholarly disciplines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric"@en .

aat:300019258 a skos:Concept ;
    skos:definition "Refers to the period and culture associated with the first use of chipped stone tools in a given area. The time frame of this period may differ greatly in different parts of the world, but is first evident in hominids by 2,500,000 Before Present. The earliest surviving artistic output by a culture usually dates from the Paleolithic period, and may include small carved stone and bone figures, as well as large-scale paintings and incised designs in caves. Paleolithic artistic output in western art is evident from roughly 30,000 BCE to 10,000 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paleolithic"@en .

aat:300019260 a skos:Concept ;
    skos:definition "Refers to the earliest part of the Paleolithic Period, including most of the Pleistocene Epoch, from about 2,000,000 to about 250,000 Before Present. The earliest phase of the Lower Paleolithic period is characterized by the production of simple pebble tools by early hominids. Later Lower Paleolithic tradition includes the \"Chopper chopping-tool industry,\" which is named for surviving stone tools, and which is widely distributed in the Eastern Hemisphere and is believed to have been the work of Homo erectus, who also probably made wood and bone tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Paleolithic"@en .

aat:300019261 a skos:Concept ;
    skos:definition "Generally refers to the period between the Lower and Upper Paleolithic, beginning in the third interglacial stage and lasting during the first major oscillation of the Fourth Glacial or Würm stage, comprising the Mousterian, a portion of the Levalloisian, and the Tayacian cultures, all of which are known by the production of flake tools, although survivals of older hand-axe tradition is sometimes still retained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Paleolithic"@en .

aat:300019262 a skos:Concept ;
    skos:definition "Refers to the last phase of the Paleolithic Period, particularly in Europe, where the phase is marked by dramatic changes in culture brought about by changes in climate, flora, and fauna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upper Paleolithic"@en .

aat:300019264 a skos:Concept ;
    skos:definition "Usually refers specifically to a period of cultural development in Europe that began as early as 10,000 BCE, after the end of the Pleistocene Epoch when glaciation began to retreat, and lasted until about 2,700 BCE. The term is also sometimes used generally for a period associated with the transitional phase between Paleolithic and Neolithic cultures in any given area. Mesolithic culture overlaps with Paleolithic and Neolithic cultures, and is characterized by great environmental and cultural change and diverse local adaptations to special environments. The period is typically marked by the production of microliths that were mounted on shafts, bone, antler, wooden tools, and an occasional polished stone tool. Surviving artistic output includes carvings and cave paintings with relatively sophisticated depictions of human and animal forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesolithic"@en .

aat:300019267 a skos:Concept ;
    skos:definition "Refers to the final stage of Stone Age development of a human culture, characterized by sophisticated stone tools created by polishing or grinding, wide-spread domestication of animals and plants, settlement in permanent villages, and the appearance of pottery and weaving. Neolithic cultures first appeared during the Holocene Epoch, around 9,000 BCE, and survived in certain remote areas of the world into the 19th century. Artistic products include wooden and stone houses, religious monuments, fortifications, carvings, paintings, textiles, and pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neolithic"@en .

aat:300019271 a skos:Concept ;
    skos:definition "Refers to middle period of Neolithic culture, which occurred roughly 5500 to 4500 BCE in Europe, and at other times elsewhere in the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Neolithic"@en .

aat:300019272 a skos:Concept ;
    skos:definition "The later phases of Neolithic culture occurring before the Early Bronze Age, roughly the 4th millennium in Europe, and at other dates elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Neolithic"@en .

aat:300019273 a skos:Concept ;
    skos:definition "Refers to the period and culture associated with the transitional phase between the Stone Age and the Bronze Age. It is characterized by the hammering, melting, and casting of copper for ornaments and tools, and is distinguished from Bronze Age technologies in that the copper was typically not or only seldomly combined with tin or other metal in an alloy, and stone tools were used at the same time as metal ones. Chalcolithic cultures developed at different times in different parts of the world, ranging from early sporadic use of copper around 7,000 BCE in the Near East to established use by around 1,900 BCE in Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chalcolithic"@en .

aat:300019275 a skos:Concept ;
    skos:definition "Refers to the period and culture associated with the second age in the Three Age system developed by Christian Jürgensen Thomsen in 1836. It is characterized by the widespread use of bronze, which is an alloy of copper and tin, lead, antimony, or arsenic, in the manufacture of tools and weapons. It developed at different times in different parts of the world, from around 3,500 BCE in Greece and China to around 1,400 BCE in several areas of Europe. There was not a Bronze Age in the Americas, since the local Stone Age cultures were introduced directly to Iron Age technologies by European explorers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bronze Age"@en .

aat:300019276 a skos:Concept ;
    skos:definition "Refers to the earliest phase of Bronze Age cultures, which developed differently in different regions, either from Chalcolithic or Neolithic technologies. It differs from the Middle and Late Bronze Age cultures primarily in metal assemblages and burial rites. It is characterized in part by the earliest experimentation with copper alloys to produce bronze, as well as the improvement of stone tools, and various other local cultural developments. Some scholars classify the Chalcolithic as the earliest phase of the Bronze Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Bronze Age"@en .

aat:300019277 a skos:Concept ;
    skos:definition "Refers to a phase of the Bronze Age distinguished from the Early and Late Bronze Age cultures by differences in metal assemblages and burial rites. It is characterized in part by metalworking techniques and tool and weapon designs of increasing sophistication, including the utilization of valve molds, cire perdue, sheet work, structural ribs, rivets, and pommels on the end of the hilts of swords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Bronze Age"@en .

aat:300019278 a skos:Concept ;
    skos:definition "Refers to the final stage of Bronze Age cultures, distinguished from the Early and Middle Bronze Age cultures by differences in metal assemblages and burial rites. It is characterized in part by very sophisticated and elaborate metalworking techniques and tool and weapon designs. It is characterized by the development of mass-produced objects, hollow objects, armor, and large objects, such as caldrons and shields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Bronze Age"@en .

aat:300019279 a skos:Concept ;
    skos:definition "Refers to the period and culture associated with the third age in the Three Age system developed by Christian Jürgensen Thomsen in 1836. Iron Age culture typically developed from the Bronze Age at the point when the qualities of iron were exploited, particularly through carburization, in the manufacture of tools, weapons, and implements. It developed at different times in various parts of the world, first appearing in the Middle East and southeastern Europe around 1,200 BCE, and in China around 600 BCE. In the Americas, it did not develop from the Bronze Age but was introduced to Stone Age cultures by European explorers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iron Age"@en .

aat:300019280 a skos:Concept ;
    skos:definition "Periods and cultures between prehistory and history, during which a culture or civilization has not yet developed writing, but other cultures have provided written historical records for this people in a given area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protohistoric"@en .

aat:300019285 a skos:Concept ;
    skos:definition "Refers to the period of European prehistoric stone tool development dating to just after 700,000 Before Present, and known from tools found in sediments in a suburb of Abbeville, France. The culture is characterized by distinctive stone tools, including the earliest hand axes that are bifacially flaked, with deep flake scars and jagged edges, and thick flakes. The period is usually considered closely related to the Acheulian tradition. The concept of the earliest hand-axe culture in Europe was formerly known as Chellean, but the concept is now known as Abbevillian, and the implements from Chelles, France that formerly defined the culture are now grouped with Acheulian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abbevillian"@en .

aat:300019287 a skos:Concept ;
    skos:definition "Refers to the period of the European prehistoric flake-tool tradition dating to the Great Interglacial stage of the Pleistocene Epoch (1,600,000 to 10,000 Before Present), and named after implements found at Clacton-on-Sea, Essex, England. The style is characterized by distinctive core and flake tools, particularly concave scrapers that may have been used to smooth and shape wooden spears. The tools are similar to those produced by the Soan industry of Pakistan and found at several sites in eastern and southern Africa. In addition, the Clactonian tradition seems to have some relationship to the Tayacian industry of France and Israel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clactonian"@en .

aat:300019288 a skos:Concept ;
    skos:definition "Refers to the period of European and African prehistoric stone tool development dating to the Pleistocene Epoch and distinguished from the Abbevillian tradition in its evolution from crude choppers to finer flint hand axes, cleavers, borers, scrapers, knives with heavily serrated blades having a saw-like appearance, and implements of bone, horn, and wood that was hardened by exposure to fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acheulian"@en .

aat:300019289 a skos:Concept ;
    skos:definition "Refers to the period and style of a primitive flake-tool tradition of France and Israel characterized by striking flakes from a flint core in alternating directions, the cores being saved and used as choppers. The style is believed to be related to the Clactonian industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tayacian"@en .

aat:300019290 a skos:Concept ;
    skos:definition "Refers to a period and culture associated with a distinctive type of stone toolmaking in prehistoric Europe and Africa, which gradually replaced the Acheulian tradition in Europe during the Third Interglacial period and continued into the Fourth Glacial period. The style is characterized by the use of a prepared core shaped like an inverted tortoise shell, from which large flakes were struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levalloisian"@en .

aat:300019291 a skos:Concept ;
    skos:definition "Refers to the period and long-lived culture of distinctive tool development in Europe, the Middle East, and Africa from as early as 50,000 Before Present and associated with the Neanderthals. The period is named after the rock shelters at Le Moustier in southwestern France. It is characterized by the expansion of peoples into new regions and adaptations to new environments, including diversification and specialization of flake tools, proficient and selective hunting, and intentional burial. The culture has some overlap with the Clactonian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mousterian"@en .

aat:300019292 a skos:Concept ;
    skos:definition "Refers to the toolmaking and artistic culture of Upper Paleolithic Europe that followed the Mousterian culture, was contemporary with the Perigordian, and is named after the site at Aurignac in southern France. The distinctive style may indicate an intrusion of new peoples into western Europe, and is distinguished from contemporary cultures by a preponderance of retouched flake tools rather than blades, the creation of blades and burins by the punch technique, and split-base and biconical points. The culture is credited with the invention of the burin, which made engraved art possible. The art is characterized by stylized \"Venus\" figurines, small carvings and engravings that employ foreshortening and shading through cross-hatching, and cave paintings that include human hands being used as stencils and painted polychrome animals, often with distinctive \"twisted perspective,\" which is a depiction of the animals in profile with their horns twisted to a frontal view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aurignacian"@en .

aat:300019294 a skos:Concept ;
    skos:definition "Refers to the early part of the Perigordian period, the tools of which overlap with the Châtelperronian tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Perigordian"@en .

aat:300019296 a skos:Concept ;
    skos:definition "Refers to the later stage of the Perigordian period, the tools of which overlap with the Gravettian tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upper Perigordian"@en .

aat:300019297 a skos:Concept ;
    skos:definition "Refers to a stage of Upper Paleolithic stone tool making found in France, Italy, and Russia. It was formerly thought to be a late stage of Aurignacian culture, but is now held to overlap with Upper Perigordian. It may be linked to Cro-Magnon peoples and is characterized by the hunting of horses in the west and mammoths in the east, the use of red ochre as pigment, and the creation of \"Venus\" figures, jewelry, and various tools. The Gravettian industry differs from the Aurignacian in its use of \"backed blades,\" which are tools created with a retouching technique that results in one blunt edge. Gravettian industry in Russia is often called East Gravettian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gravettian"@en .

aat:300019298 a skos:Concept ;
    skos:definition "Refers to the Upper Paleolithic Gravettian tool-making culture that was found in Russia. It is distinguished from other Gravettian culture by a preference for hunting mammoths, using the fat for fuel and the bones for building materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Gravettian"@en .

aat:300019299 a skos:Concept ;
    skos:definition "Refers to a Paleolithic period and culture named for a site at Pavlov in the modern Czech Republic. It dares to ca. 29,000-25,000 years befor present; it is characterized by distinctive flint tools made with raw materials imported from relatively long distances, rather than with various local Moravian cherts that were utilized by other groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pavlovian"@en .

aat:300019300 a skos:Concept ;
    skos:definition "Refers to a style and culture found in some areas of Europe after the Gravettian culture had generally died out. It is characterized by the continuation of many characteristics of the Gravettian culture, with some local alterations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Epi-gravettian"@en .

aat:300019302 a skos:Concept ;
    skos:definition "Refers to the relatively short-lived culture that is named after the site at Solutré, France, and flourished primarily in southwestern France and nearby areas from around 21,000 to 17,000 Before Present. The culture followed the Perigordian and Aurignacian cultures and was succeeded by the Magdalenian, but scholars disagree about whether the culture was an evolution of local traditions or an intrusion of new peoples into the area. It is characterized by the creation of the usual tools of the period, plus a new preoccupation with ornament, including bone jewelry, tools, and implements that are decorated and fashioned from stone chosen for its beauty, such as colored quartz and jasper, as well as distinctive symmetrical, bifacially flaked, laurel-leaf and shouldered flint points, some of which may have served a ritualistic rather than utilitarian function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solutrean"@en .

aat:300019305 a skos:Concept ;
    skos:definition "Refers to the period and culture of Upper Paleolithic Europe that is named after the rock shelter of La Madeleine in Dordogne, France, and existed from roughly 17,000 to 11,000 Before Present. The culture is characterized by the establishment of permanent or seasonal settlements, the exploitation of a wide variety of plant and animal food sources, including the use of snares and traps, and great ingenuity in toolmaking, decorative forms, and art. Tools were made of bone and stone and include geometrically shaped blades and other implements set into bone and antler handles, burins, needles, scrapers, borers, backed blades, harpoons, and leaf-shaped projectile points. Artistic production includes monumental cave engraving and painting, engraving of bone tools, sculpture, and jewelry. The earlier theme of animals is continued in art of this period, but the style is distinguished from earlier art in mural painting by lively realism, expressive poses, and successful rendering of volume, and in portable works by delicate carving of detail and the development of cohesive compositions through the depiction of multiple animals together as if in a scene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magdalenian"@en .

aat:300019322 a skos:Concept ;
    skos:definition "Refers to a tool-making culture that existed in Late Paleolithic and Early Mesolithic Europe, particularly in France and Spain. It followed the more complex Magdalenian culture and was contemporary with Tardenoisian, Maglemosian, Ertebølle, and Asturian cultures. It is characterized by geometric drawings made on pebbles, very small stone tools made to fit into a handle of bone or antler, projectile points with curved backs, end scrapers, bone punches, flat harpoons, and \"wands,\" the purpose of which is unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Azilian"@en .

aat:300019323 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Asturias region of northern Spain (modern Oviedo), particularly the cultures of the Mesolithic period that followed the Azilian and preceded the Neolithic cultures in the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asturian"@en .

aat:300019324 a skos:Concept ;
    skos:definition "Refers to a European stone toolmaking period and culture that dates to the fourth millennium Before Present and is named for the site at Campigny, Haute-Normandie, France. Campignian culture began in the Mesolithic period, but it developed in the Neolithic period and spread throughout most of northern and central Europe and the British Isles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Campignian"@en .

aat:300019325 a skos:Concept ;
    skos:definition "Refers to the northern European Mesolithic period and culture that existed from around 12,000 to around 10,000 Before Present. The culture probably developed from Magdalenians who left south-western Europe to follow reindeer during a period of retreating Würm glatiation, and it is characterized by a variety of tools, including bone awls, skinners, scrapers, needles, elastic strips made by soaking reindeer antlers, and some simple decoration such as V-patterns and strokes. The culture occupied an area from southern Holstein to Hannover, with winters probably spent south of the Elbe river. Some scholars believe it may have had ties to eastern Europe. It was succeeded by the Ahrensburgian culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamburgian"@en .

aat:300019326 a skos:Concept ;
    skos:definition "Refers to a Mesolithic tool culture named after the site at the \"big bog,\" \"magle mose\" in Danish, near Mullerup, Denmark, and evident in northern Europe from about 9,000 to 5,000 BCE. It was created by a forest people who settled along rivers and lakes as the glaciers retreated, and there developed new tools to deal with the changing environment, including stone microliths, axes, bows and arrows, fish hooks, wooden paddles, canoes, and fishnets. Artistic activities included the creation of designs on tools and decorative objects, including amulets and pendants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maglemosian"@en .

aat:300019327 a skos:Concept ;
    skos:definition "Refers to a Mesolithic style and culture that flourished particularly in southwestern France and northern Italy, from the ninth to the fifth millennia BCE. It is characterized by distinctive tools, including microlithic tools, such as triangles and double-backed points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sauveterrian"@en .

aat:300019328 a skos:Concept ;
    skos:definition "Refers to a Mesolithic style and culture that is named after the site at Fère-en-Tardenois in northern France, and existed in France, Belgium, the British Isles, and elsewhere in western Europe. It is characterized by distinctive arrowheads, including chisel-ended arrowheads, other microliths, and by occupation sites that are typically sandy regions and plateaus. It is related to the Azilian culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tardenoisian"@en .

aat:300019332 a skos:Concept ;
    skos:definition "Period and culture of the time when Neolithic technology was present in Europe, which varied from place to place. It may be dated from approximately 7,000 BCE-ca. 1700 BCE, from the appearance of the first farming societies in Greece to the beginning of the Bronze Age in northwest Europe. The Neolithic overlaps the Mesolithic and Bronze Age periods in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European Neolithic"@en .

aat:300019334 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture that was prevalent primarily in the area of modern France in the fourth millennium BCE. It is characterized by distinctive stone tools and pottery styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chasseen"@en .

aat:300019335 a skos:Concept ;
    skos:definition "Refers to the styles and cultures of the the Medieval principalities that developed along the Danube river in central Europe. For the prehistoric culture in this area, use \"Danubian (prehistoric)\" or \"Bandkeramik.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Danubian"@en .

aat:300019337 a skos:Concept ;
    skos:definition "Refers to the culture in northern Europe dating from late 5th millennium BCE and beyond; named for the distinctive vessels that are sometimes shaped like funnels. Although the culture is classified as early Neolithic, it has much in common with the late Mesolithic. The culture varies from region to region, but it is generally characterized by early domestication of animals and plants, polished stone and flint tools, collared flasks, buckets, bowls, funnel beakers decorated with horizontal and vertical grooves, and megalithic burial monuments in some regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Funnel Beaker"@en .

aat:300019339 a skos:Concept ;
    skos:definition "Neolithic culture and style of the Körös people, who lived in the area of modern Hungary and the Czech Republic. Their culture is related to the Cris culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Körös"@en .

aat:300019341 a skos:Concept ;
    skos:definition "Refers to a Neolithic culture and style that developed in the Rhineland and western Germany, was contemporary with the Lengyel culture, and flourished in the fifth and fourth millennia BCE. It followed the relatively homogenous Bandkeramik culture and is characterized by the development of strong local traditions and styles, including pots decorated with lattices, chequers, and curved lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rössen"@en .

aat:300019342 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture named after the site at Starcevo, Serbia, and evident in a large area including modern Slovakia, western Ukraine, Romania, eastern Hungary, Bulgaria, Serbia, northeast Bosnia, and Croatia. Scholars generally agree that it lasted from the sixth millennium until around 4,200 BCE. It is characterized by fishing and hunting activities, with some agriculture, the creation of knives and polished axes, and pottery with thick walls, pinched at the top with fingers or nails, and displaying distinctive curvilinear and spiral designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Starcevo"@en .

aat:300019343 a skos:Concept ;
    skos:definition "Refers to a Neolithic culture and style that began in the Ukraine around 3,000 BCE in the area between the Bug and Seret rivers, and extended to the Dnieper river. It is characterized by red and orange pottery decorated with distinctive grooved or painted curvilinear designs. It is also distinguished by villages made up of long, rectangular houses with a central enclosure for cattle, and often an agricultural practice involving shifting fields and frequent movement of the settlements. Some scholars classify Cucuteni and Tripolye as separate cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cucuteni-Tripolye"@en .

aat:300019344 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture that existed in eastern Europe beginning in the fifth millennium BCE and is named after a site in Serbia, along the Danube river. It is particularly characterized by the creation of free-standing animal and human figures in clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vinca"@en .

aat:300019348 a skos:Concept ;
    skos:definition "Refers to the Neolithic style and culture named after the lake settlement at Lagozza di Besnate in Lombardy, Italy. It is characterized by distinctive pottery and flint tools. Pots typically include simple open bowls with decorated cylindrical lids and closed-mouthed bowls with sinuous profiles and hollow stalk impressions. Flint tools typically include triangular transverse arrows made of very fine flint, which was imported into the area. The culture seems to be closely related to the Chasseen culture, and may represent an invasion from the west."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lagozza"@en .

aat:300019349 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture named for the round barrow near Avebury, Wiltshire, England. It is characterized by causewayed camps and distinctive pottery that is among the oldest found in Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windmill Hill"@en .

aat:300019356 a skos:Concept ;
    skos:definition "Refers to archaeological cultures that flourished north of the Black Sea from ca. 3300/2600 BC BCE. It is named for its distinctive Kurgan, or burial tumulus, and is also characterized by an emphasis on the horse and wheel technology. Many scholars believe this group is key to the expansion of Indo-Europeans across Eurasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kurgan"@en .

aat:300019358 a skos:Concept ;
    skos:definition "Styles, cultures, and periods belonging to the Bronze Age in Europe, which varies from place to place, but falls within the range 2300 BCE to 500 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European Bronze Age"@en .

aat:300019360 a skos:Concept ;
    skos:definition "Refers to a Bronze Age period and culture evident in Europe from around 1600 BCE. It is characterized by jewelry, particularly distinctive pins with decorated heads, networks of trade, including trade in amber, and characteristic barrows or tumuli, which generally covered inhumation or cremation burials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tumulus"@en .

aat:300019361 a skos:Concept ;
    skos:definition "Bronze Age period and culture that first developed at Únetice, near Prague in the modern Czech Republic, and spread to Bohemia, Germany, and Poland. It is characterized by trade in salt, amber, and gold, and by the development of increasingly elaborate graves, including some with barrows, that probably formed an impetus for the Tumulus period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unetician"@en .

aat:300019362 a skos:Concept ;
    skos:definition "Refers to a Late Bronze Age culture evident by the 12th century BCE in east-central Europe and northern Italy, and spreading to the Ukraine, Sicily, Scandinavia, France, and the Iberian peninsula. It is named for the custom of placing the creamated bones of the deceased in urns, either within flat graves or round barrows. The culture is characterized by fortified settlements, distinctive pottery and metal forms, beaten-bronze armaments, and a slashing sword with flanged grips to protect the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urnfield"@en .

aat:300019365 a skos:Concept ;
    skos:definition "Refers to the Early Bronze Age period and culture that developed in Wessex, England. It is characterized by distinctive burial mounds over inhumations or cremations, and rich, varied grave goods, notably decorated pottery, metalwork, weapons, including daggers, and personal ornaments made of non-local materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wessex"@en .

aat:300019368 a skos:Concept ;
    skos:definition "Refers to Late Bronze and Early Iron Age period and culture, dating from around 1100 BCE to around 450 BCE, and evident in central and western Europe. These Halstatt groups were independent of one another, politically, but interconnected by trade, types of tools, housing style, and farming techniques. The culture is named for the cemetery and salt mine at Halstatt, Austria. Burial practices and artistic styles varied at different times and in different areas, but in general the culture is characterized by the development of trade with surrounding areas, and by art that displays symmetrical designs, geometric decoration, bird and plant motifs, and the influence of Italian and possibly Greek art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hallstatt"@en .

aat:300019384 a skos:Concept ;
    skos:definition "Refers to a Late Iron Age phase and culture of European Celts named for the site at La Tène, or \"The Shallows,\" at Lake Neuchâtel, Switzerland. It began in the mid-fifth century BCE, and it spread throughout northern Europe and the British Iles, finally disappearing in the mid-first century BCE. It is characterized by Greek and Etruscan influences on traditional Celtic culture, and by the great geographical expansion of the Celts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "La Tène"@en .

aat:300019396 a skos:Concept ;
    skos:definition "Refers to the first of four divisions of La Tène art as defined by Paul Jacobsthal's in 1944. It flourished from the fifth to the early fourth centuries BCE, and is characterized by Oriental and classical influences. Jacobsthal La Tène style sequence has been challenged by modern scholars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Style"@en .

aat:300019397 a skos:Concept ;
    skos:definition "Refers to the third of the four divisions of La Tène art as defined by Paul Jacobsthal in 1944. It is characterized by the incorporation of faceted, chunky, bossed, and curved elements. Jacobsthal's La Tène style sequence has been challenged by modern scholars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plastic Style"@en .

aat:300019398 a skos:Concept ;
    skos:definition "Refers to the last of the four divisions of La Tène art as defined by Paul Jacobsthal in 1944. It is characterized by the influence of Hellenistic art and by geographic distribution in central-eastern Europe. Jacobsthal's La Tène style sequence has been challenged by modern scholars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sword Style"@en .

aat:300019399 a skos:Concept ;
    skos:definition "Refers to the second of the four divisions of Celtic La Tène art as defined by Paul Jacobsthal in 1944. It began around 350 BCE, following Celtic war bands having raided Italy. It is named after the site in the Hunsrück mountains, Germany, and is characterized by the depiction of human and animal faces peering through swirling vegetal forms. Jacobsthal's La Tène style sequence has been challenged by modern scholars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Waldalgesheim Style"@en .

aat:300019446 a skos:Concept ;
    skos:definition "Refers to a distinctive artistic tradition in portable objects that was first developed by the Scythian nomads north of the Caucasus during the sixth century BCE. It was spread by mounted nomads throughout Europe and northern Asia, across the steppes from Hungary to the Gobi desert and beyond, through the eighth century. The style is characterized by frequent use of precious materials, modeling techniques that imitate wood carving, including beveling, great intensity and vitality, and a common motif of stylized real or mythological animals, often in bent or contorted positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Animal Style"@en .

aat:300019455 a skos:Concept ;
    skos:definition "Designates work of Migration period peoples, characterized by inlays of multicolored stones, usually in gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polychrome Style"@en .

aat:300019461 a skos:Concept ;
    skos:definition "Refers to the Migration period style associated with the Avars, a group of undetermined origin and language who were important players in eastern Europe from the sixth century CE, and who established an empire between the Adriatic and Baltic Seas through the eighth century. The term refers particularly to the center of the Avar empire, which was in the Hungarian plain and reached its peak at the end of the sixth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Avar"@en .

aat:300019470 a skos:Concept ;
    skos:definition "Refers to the culture and styles associated with the Celts, an early Indo-European people who spread over Europe, from the British Isles and northern Spain to east of Transylvania, the Black Sea coasts, and Galatia in Anatolia, from the second millennium BCE to the first century BCE. Elements of the style persisted for centuries in southern Scandinavia and the post-Roman British Isles. It is characterized by a reference to the art of ancient Italy, Greece, and the East, combined in a new and individual style that includes a strong sense of form and structure, stylized plant, animal, and human forms, a balance of voids and ornament, vigorous vitality, and contrasts of texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic"@en .

aat:300019478 a skos:Concept ;
    skos:definition "Refers to the period and style of the Franks, a Germanic tribe living along the east bank of the lower Rhine river by at least the third century CE. The style is especially associated with the westward expansion of the Franks across the Rhine in Gaul by gradual settlement and conquest, notably by the Merovingian, Clovis, beginning in the fifth century CE and lasting for centuries. Early Frankish art continued the existing Early Christian traditions of the area, except in the field of metalwork, where the Franks had a strong tradition of their own. With time, the Frankish style was especially strong in architecture, sculpture, and manuscript illumination, and is often characterized by colorful, flat, busy compositions of ornate linear pattern, and an abundance of animals, fish, and birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Frankish"@en .

aat:300019487 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the Indo-European speakers of Germanic languages whose origins are obscure, but who inhabited southern Sweden, the Danish peninsula, and northern Germany during the late Bronze Age. In later centuries various groups of Germanic peoples migrated south and west at the expense of Celtic peoples and other inhabitants. The artistic styles of the Germanic peoples are often associated with portable objects, including weapons and personal ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Germanic"@en .

aat:300019489 a skos:Concept ;
    skos:definition "Refers to the period and artistic styles associated with the Goths, a Germanic people who probably originated in Scandinavia and migrated to the southern shore of the Baltic Sea after defeating Vandals and other Germanic people in the area, and then migrated to the Black Sea in the second century CE. The term is particularly associated with the great wave of migration in the fifth century CE by the two branches of Goths, the Ostrogoths in Italy and the Visigoths in Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic"@en .

aat:300019490 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the Ostrogoths, a division of the Germanic Goths who apparently crossed the Baltic from Scandinavia in the fourth century BCE, settled in south Russia in the first century BCE, and moved down through Hungary, Austria, Yugoslavia, and into Italy under Theoderic the Great in the fifth century CE. The styles of Ostrogothic art through the years combine decorative motifs developed on weapons and personal ornaments with elements from classical Rome and Byzantine art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostrogothic"@en .

aat:300019494 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the Visigoths, a division of the Germanic Goths who were agriculturalists in Dacia in modern Romania, were separated from the Ostrogoths and driven across the Danube by Hun invasions, and settled in the Balkan region of Moesia in the fourth century CE. The term refers particularly to the Visigoths' rule in Gaul and the Iberian peninsula, primarily from the fifth to the seventh centuries CE. The style in architecture is characterized by modest size, high quality of workmanship, use of the horseshoe arch, and an abundance of sculptural decoration. The style in sculpture is similar to that of the Lombards, and probably indicates a common source. It is characterized by flat, decorative human figures, animals, foliage, and abstract designs, which were originally brightly colored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Visigothic"@en .

aat:300019508 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the Lombards, a nomadic, Germanic people who were part of the Suebi group, lived in northwestern Germany in the first century CE, and started their southward migration in the fourth century. The term refers particularly to the Lombard conquest of much of the Italian peninsula, lasting from 568 until the 11th century in some areas. The style is first evident in portable objects, primarily personal ornaments and weapons, and later most notably in sculpture. The style is characterized by a flat, decorative effusion of symmetrically placed birds, animals, interlaces, geometric patterns, and lively, primitive figures that show Byzantine influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lombard"@en .

aat:300019512 a skos:Concept ;
    skos:definition "Refers to the culture, period, and style ushered in by the conquest of Gaul by Clovis of the Merovingian dynasty in 486 CE. In architecture the style is characterized by the employment, in modest and simplified form, of the earlier Late Antique and Early Christian styles, often emphasizing decorative effects and geometric patterns. The style in manuscript illumination is related to Lombard art and perhaps to Coptic textiles, and is characterized by small, ornamental figures, animals, birds, fish and abstract shapes, reminiscent of Germanic metalwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Merovingian"@en .

aat:300019526 a skos:Concept ;
    skos:definition "Refers to the culture and style of art produced in the vast region stretching from the northern Black Sea area to China associated with martial nomadic groups in the first millennium BCE. The style is characterized by connections with Thracian, Iranian, Hellenistic, and Central Asian art and was used particularly for chased and embossed metalwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scythian"@en .

aat:300019537 a skos:Concept ;
    skos:definition "Refers to the period and culture associated with the Slavs, a distinct linguistic and ethnic group that came from Asia in the third or second millennium BCE, spread steadily across eastern Europe, and played an important role in the Medieval world, particularly during the Slavic migrations into Greece and central Europe during the sixth and seventh centuries CE. Slavic style is characterized by bright color and pattern, and the influence of numerous other cultures, including Germanic, Roman and Greek."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Slavic"@en .

aat:300019546 a skos:Concept ;
    skos:definition "Refers to the period and culture surrounding the Alemanni, a loose confederation of Germanic people who migrated into the Black Forest area in the third century CE and expanded into Alsace and northern Switzerland in the fifth century, bringing their language and elements of their artistic traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alamannic"@en .

aat:300019549 a skos:Concept ;
    skos:definition "Refers to the Medieval period and style associated with the Marcomanni, a Germanic tribe of the Suebi group that built a powerful confederation of tribes in Bohemia. The term is particularly used to refer to the migration of the Marcomanni to the Main river valley in the first through fifth centuries CE, where they were known as \"Baiuwari\" or Bavarians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marcomannic"@en .

aat:300019557 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the Vandals, a Germanic people who established a kingdom in North Africa and settled in Spain in the fifth and sixth centuries CE, and who are infamous for sacking parts of Gaul and Rome in 455. Vandal artistic style is characterized by decorative details developed in portable objects and the influence of Arian Christianity, of which they were ardent defenders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vandal"@en .

aat:300019558 a skos:Concept ;
    skos:definition "Refers to the period, culture, and style of art produced between the later eighth century and early 12th century in Scandinavia and Scandinavian settlements overseas. The term is derived from the old Norse noun \"víkingr,\" and narrowly refers to sea pirates and raiders. However, it is usually applied to the broader realm of Scandinavian culture from this time period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Viking"@en .

aat:300019571 a skos:Concept ;
    skos:definition "Refers to the culture that developed in antiquity in the vast geographical area extending from Turkey in the west to Iran in the East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Near Eastern"@en .

aat:300019576 a skos:Concept ;
    skos:definition "Periods related to Levantine Paleolithic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levantine Paleolithic periods"@en .

aat:300019577 a skos:Concept ;
    skos:definition "Refers to a tool-making culture that followed the Acheulean in the Levant, and is named after a site at Jabrud, Syria. It is characterized by thick scrapers on flakes with plain platforms, and bifaced tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jabrudian"@en .

aat:300019579 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period from about 14,000 to 10,500 BCE in the Levant. The period is characterized by lithic industries and the use of natural materials for art objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kebaran"@en .

aat:300019580 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period from about 10,500 to 8000 BCE in the Levant. The period is characterized by skilled stone and bone work and an interest in personal adornment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Natufian"@en .

aat:300019584 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period from about 38,000 to 25,000 BCE in the Zagros Mountains in Iran. The period is characterized by technological advancements in the manufacture of tools, the use of color in stones and human bones, and the presence of ornaments made of pebbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baradostian"@en .

aat:300019586 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period from about 25,000 to 10,000 BCE in the Zagros Mountains in Iran. The period is characterized by a high quality of craftsmanship of everyday tools, the use of imported seashells for ornamentation, and bone tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zarzian"@en .

aat:300019590 a skos:Concept ;
    skos:definition "Refers to the period and culture from about 6500 to 5700 BCE that developed in northern Mesopotamia, named after the site of Hassuna. The pottery is characterized by painted, incised, painted-and incised, and undecorated types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hassuna"@en .

aat:300019594 a skos:Concept ;
    skos:definition "Refers to the period and culture from about 6200 to 5500 BCE that developed in central Mesopotamia and spread north, named after the site of Samarra. Know primarily for its painted pottery, some of which was decorated with human and animal motifs, clay figurines, and the earliest known Mesopotamian use of mud-brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samarra"@en .

aat:300019601 a skos:Concept ;
    skos:definition "Refers to a period and culture that developed in southern Mesopotamia during the 5th millennium BCE, named after the site of Tell Al-Ubaid. The period is divided into four phases based on a sequence of pottery styles, which consist generally of a black painted, greenish buff ceramic with geometric decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ubaid"@en .

aat:300019604 a skos:Concept ;
    skos:definition "Refers to the culture, period, and style in Mesopotamia from about 2340 to 2150 BCE during the rule of the dynasty founded by Sargon of Akkad. This style is characterized by a sense of realism and a high degree of artistic technical achievement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akkadian"@en .

aat:300019619 a skos:Concept ;
    skos:definition "Refers to the period roughly from the beginning of the 2nd millennium BCE, when Assyrian rulers first appeared in northern Mesopotamia and continuing until the fall of their empire in 612 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assyrian"@en .

aat:300019620 a skos:Concept ;
    skos:definition "Refers to the first two centuries, 2000-1800 BCE, of the Assyrian period in Northern Mesopotamia. Contact with Anatolia through commerce and trading colonies had a particular influence on the style of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Assyrian"@en .

aat:300019622 a skos:Concept ;
    skos:definition "Refers to the Assyrian period and style from about 1500 to 1000 BCE. The style is characterized by an introduction of new themes, a renewed vitality, and outside cultural influences, especially from Egypt and the eastern Mediterranean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Assyrian"@en .

aat:300019623 a skos:Concept ;
    skos:definition "Refers to the Assyrian period and style aboout 1000 to 612 BCE. The reigns of individuals kings produced various styles most commonly seen in palace decoration, particularly in the form of reliefs. Generally, these reliefs exhibit a high degree of attention to detail, a narrative quality, and an attempt at realism not seen before in the art of the ancient Near East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Assyrian"@en .

aat:300019648 a skos:Concept ;
    skos:definition "Refers to a pottery style found in northern Mesopotamia from about 3000 to 2500 BCE, named after pottery first identified in Level 5 at the site of Nineveh. The style is characterized by plain, incised, and painted wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ninevite 5"@en .

aat:300019649 a skos:Concept ;
    skos:definition "Refers to the Old Babylonian period from 1894 to 1595 BCE, during which one dynasty ruled parts of Mesopotamia. It included the reign of Hammurabi, considered the golden age of the Old Babylonian period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Dynasty of Babylon"@en .

aat:300019652 a skos:Concept ;
    skos:definition "Refers to the period from about 1650 BCE when Hittite rulers first came to prominence in central Anatolia until around 700 BCE when the Assyrians destroyed the remaining Hittite city-states in southeast Anatolia and north Syria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hittite"@en .

aat:300019659 a skos:Concept ;
    skos:definition "Refers to the period from about 1920 to 1740 BCE in Anatolia. The period is characterized by contacts with Mesopotamia particularly through trade with Assyrian merchants who founded colonies such as the town of Kultepe in Anatolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assyrian Colony period"@en .

aat:300019661 a skos:Concept ;
    skos:definition "Refers to the Hittite period from about 1650 to 1500 BCE during which Hittite rulers established their capital at Hattusa and ruled central Anatolia and parts of Syria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Hittite Kingdom"@en .

aat:300019663 a skos:Concept ;
    skos:definition "Refers to the Hittite period from about 1400 to 1200 BCE during which Hittite rule was re-established in Anatolia and Syria. The art of the period is characterized by monumental guardian figures, rock cut reliefs, and fine metalwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hittite Empire"@en .

aat:300019664 a skos:Concept ;
    skos:definition "Refers to the Hittite period from about 1000 to 700 BCE when independent Hittite city-states flourished in south-east Anatolia and north Syria. The art of the period is characterized by a continuity of traditions of the Hittite Empire seen particularly in the use of the Hittite hieroglyphic script for monumental stone inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Hittite"@en .

aat:300019700 a skos:Concept ;
    skos:definition "Refers to the style of art and architecture found in the region of Lycia in the southwestern corner of Anatolia in antiquity. The style is characterized particularly by monumental tombs widespread over the region from about 500 BCE to 200 CE that exhibit Greek, Persian, and Roman influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lycian"@en .

aat:300019705 a skos:Concept ;
    skos:definition "Refers to the period during the 7th century and early 6th century BCE when the independent kingdom of Lydia ruled western Aanatolia from its capital Sardis. The art of the period is characterized by East Greek influences mixed with Anatolian traditions seen particularly in objects in graves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lydian"@en .

aat:300019712 a skos:Concept ;
    skos:definition "Refers to the period at the beginning of the second millennium BCE in Mesopotamia when the rival dynasties of the cities of Isin and then Larsa ruled the south."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isin-Larsa"@en .

aat:300019715 a skos:Concept ;
    skos:definition "Refers to the period in the 8th century BCE during which the Phrygian kingdom flourished in western Anatolia particularly under the rule of king Midas. The art of the period is characterized by a mixture of local traditions and Neo-Hittite inspiration from eastern Anatolia and is known for its monumentality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phrygian"@en .

aat:300019726 a skos:Concept ;
    skos:definition "Refers to the style and culture of the area of southern Mesopotamia known as Sumer, now in modern Iraq, from at least 3500 to about 2000 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumerian"@en .

aat:300019730 a skos:Concept ;
    skos:definition "Refers to the glyptic style dominant in the Diyala region of Mesopotamia during the first phase of the Early Dynastic period, from about 2900 to 2750 BCE. The style is characterized by an overall patterning of space-filling motifs, which produced in the impression an unbroken frieze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brocade Style"@en .

aat:300019735 a skos:Concept ;
    skos:definition "Refers to a style in Mesopotamia that is characterized by a synthesis of Sumerian and Akkadian culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumero-Akkadian"@en .

aat:300019736 a skos:Concept ;
    skos:definition "Refers to culture and period from about 850 to 590 BCE during which the kingdom of Urartu ruled the part of eastern Anatolia centered around the area of Lake Van. The art and architecture of the period is characterized by distinctive bronze artifacts and fortresses of fine ashlar masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urartian"@en .

aat:300019755 a skos:Concept ;
    skos:definition "Refers to the culture and styles that developed in antiquity in the geographical area of modern Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian"@en .

aat:300019797 a skos:Concept ;
    skos:definition "Refers to the culture of the semitic race inhabiting the Arabian peninsula and neighboring areas, particularly during the pre-Islamic period from about 4,500 BCE to the early 7th century CE. Periods related to Arabian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabian"@en .

aat:300019800 a skos:Concept ;
    skos:definition "Refers to the period from about the 4th century BCE to the 4th century CE during which the kingdom of Nabatea located in northwest Arabia flourished. The style of the period is known for its eclectic character, combining Hellenistic, Roman, and Eastern motifs and is seen most prominently in the facades of rock-cut tombs at Petra, the kingdom's capital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nabatean"@en .

aat:300019802 a skos:Concept ;
    skos:definition "Refers to the period in the first millennium BCE and the first millennium CE during which the kingdom of Qataban flourished in southern Arabia in the area of modern Yemen. The art of the period is characterized by a common style shared by the kingdoms of South Arabia at the time, seen particularly in sculpture displaying a simplicity of design combined with a high standard of workmanship, often inspired by religious devotions and temple ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qatabanian"@en .

aat:300019803 a skos:Concept ;
    skos:definition "Refers to the period in the first millennium BCE and the first millennium CE during which the kingdom of Saba' flourished in southern Arabia in the area of modern Yemen. The art of the period is characterized by a common style shared by the kingdoms of South Arabia at the time, seen particularly in sculpture displaying a simplicity of design combined with a high standard of workmanship, often inspired by religious devotions and temple ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sabaean"@en .

aat:300019806 a skos:Concept ;
    skos:definition "Culture and styles of a bronze age people who existed from 2600-2000 BCE in what is now the United Arab Emirates and Northern Oman; named after the island of Umm an-Nar. The culature is known for collective, monumental, circular graves sometimes decorated with reliefs characterized by their simplicity, as well as for decorated soft stone vessels with parallels in Mesopotamia and Persia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Umm an-Nar"@en .

aat:300019811 a skos:Concept ;
    skos:definition "Refers generally to the culture and styles that developed in antiquity in the Levant, which is the Near Eastern area along the eastern coasts of the Mediterranean, corresponding primarily to modern Syria, Lebanon, Jordan, and Israel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levantine"@en .

aat:300019814 a skos:Concept ;
    skos:definition "Refers to the Neolithic period from about 8000 to 7000 BCE in the Levant. The period is characterized by lithic industries, small clay or limestone figurines, and very few known sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-pottery Neolithic A"@en .

aat:300019815 a skos:Concept ;
    skos:definition "Refers to the period from about 7000 to 5000 BCE in the Levant. The period is characterized by large standing human statues, decorated plastered skulls, and lithic industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-pottery Neolithic B"@en .

aat:300019816 a skos:Concept ;
    skos:definition "Refers to the Pottery Neolithic period in the southern Levant from about 6000 to 5500 BCE. The period is characterized by pottery decorated with incised or combed patterns, clay and stone anthropomorphic figurines, and incised pebble figurines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yarmukian"@en .

aat:300019817 a skos:Concept ;
    skos:definition "Refers to the Neolithic period around 4000 BCE in the Levant. The period is characterized by the introduction of metalworking, new stone industries, and technically superb pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ghassulian"@en .

aat:300019828 a skos:Concept ;
    skos:definition "Refers to the culture that developed in the geographic area of the Tigris and Euphrates rivers, from the mountains of Asia Minor to the Persian Gulf, includes part of modern Iraq, Iran, Syria, and Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesopotamian"@en .

aat:300019830 a skos:Concept ;
    skos:definition "Refers to the period and culture from about 5600 to 5000 BCE that developed in nothern Mesopotamia, named after the site in Tell Halaf. Known particularly for its exceptionally fine pottery, which achieved a high degree of elaboration and delicacy of design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Halaf"@en .

aat:300019833 a skos:Concept ;
    skos:definition "Refers to the period in southern Mesopotamia, roughly between 4000 and 2900 BCE, during which developments such as the invention of writing and cylinder seals, the emergence of large cities, the establishment of widespread trade, and the appearance of monumental public buildings occurred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protoliterate"@en .

aat:300019835 a skos:Concept ;
    skos:definition "Refers to the period of the rise of city-states in the south Mesopotamian region of Sumer roughly from 2900 until their conquest by the Akkadian kings around 2340 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Dynastic"@en .

aat:300019837 a skos:Concept ;
    skos:definition "Refers to a period from about 2125 to 2025 BCE in Mesopotamia associated with the rules of Gudea of Lagash and the Third Dynasty of Ur. This style is charactersized by a combination of technical achievements developed in the previous Akkadian period, a revival of Early Dynastic traditions, and the establishment of artistic conventions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Sumerian"@en .

aat:300019838 a skos:Concept ;
    skos:definition "Refers to the period in Mesopotamia roughly from the founding of the first dynasty of Babylon in 1894 BCE until the Hittite sack of Babylon in 1595 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Babylonian"@en .

aat:300019840 a skos:Concept ;
    skos:definition "Refers to the period roughly between the fall of the Assyrian Empire in 612 BCE and the rise of the Achaemenid Empire in 539 BCE, during which Mesopotamia was ruled by a new dynasty founded in Babylon by Nabopolassar in 627 BCE. This style is characterized by a revival of Babylonian traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Babylonian"@en .

aat:300019910 a skos:Concept ;
    skos:definition "Refers to the period from about 2112 to 2000 BCE during which Mesopotamia was ruled by a dynasty founded by Ur-Nammu and based in the city of Ur in southern Mesopotamia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Third Dynasty of Ur"@en .

aat:300019933 a skos:Concept ;
    skos:definition "Refers to the culture that developed in antiquity in the geographical area of modern Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian"@en .

aat:300019935 a skos:Concept ;
    skos:definition "Periods related to Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian periods"@en .

aat:300019942 a skos:Concept ;
    skos:definition "Refers to the period from about the 4th millennium to the 1st millennium BCE when the ancient state of Elam flourished in the area that is now Fars and Khuzistan in southwest Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elamite"@en .

aat:300019944 a skos:Concept ;
    skos:definition "Style and culture produced in Iran by the Medes culture from the rise of their state in the 7th century BCE to their defeat by the Achaemenid Cyrus the Great in 550 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Median"@en .

aat:300019946 a skos:Concept ;
    skos:definition "Refers to the Persian period in the Near East from the founding of the Achaemenid Persian Empire by Cyrus the Great in about 550 BCE until its defeat by Alexander the Great in 331 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Achaemenid"@en .

aat:300019947 a skos:Concept ;
    skos:definition "Refers to the period from the founding of the Seleucid empire by Seleuckos I Nikator in 311 BCE until its defeat by the Romans in 64 BCE, during which the Seleucid dynasty ruled much of the Near East. The art of the period reflected the ethnic and regional diversity of the empire characterized by a mixture of mainstream Hellenism and traditional Mesopotamian culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seleucid"@en .

aat:300019967 a skos:Concept ;
    skos:definition "Refers to the period from about the mid 3rd century BCE to 220 CE when the Parthians ruled much of central and western Asia. The art of the period is characterized by a combination of styles deriving from Greek and Near Eastern sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parthian"@en .

aat:300019970 a skos:Concept ;
    skos:definition "Refers to the period from the defeat of the Parthians by Ardashir in 224 until the fall of the Sassanian empire to the Arabs in 631, during which the Middle East was ruled by the Iranian Sassanian dynasty. The art of the period, of which rock reliefs and silverwork are most famous, was influenced by the Romano-Byzantine empire to the west and the Chinese to the east."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sassanian"@en .

aat:300020009 a skos:Concept ;
    skos:definition "Refers to the period from about 7500 to 6750 BCE in the Khuzistan region of the Zagros Mountains in Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bus Mordeh"@en .

aat:300020010 a skos:Concept ;
    skos:definition "Refers to the period from about 6750 to 6000 BCE in the Khuzistan region of the Zagros Mountains in Iran named after the site of Ali Kosh. The period is characterized by well-constructed dwellings and a developed material culture, which are representative of a fully developed Neolithic community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ali Kosh"@en .

aat:300020011 a skos:Concept ;
    skos:definition "Refers to the period from about 6000 to 5600 BCE in the Khuzistan region of the Zagros Mountains in Iran. The period is characterized by the appearance of pottery and an increase in the effectiveness of building techniques and agricultural tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muhammed Jafar"@en .

aat:300020014 a skos:Concept ;
    skos:definition "Refers to a pottery style found in the Khuzistan region of Iran and in southern Mesopotamia from about 5500 to 5000 BCE named after the site of Choga Mami. The style is characterized by pottery painted with geometric as well as animal and human forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Choga Mami Transitional"@en .

aat:300020016 a skos:Concept ;
    skos:definition "Refers to the prehistoric period from about 5200 to 5100 BCE in the Khuzistan region of the Zagros Mountains in Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khazineh"@en .

aat:300020017 a skos:Concept ;
    skos:definition "Refers to the prehistoric period from about 5100 to 5000 BCE in the Khuzistan region of the Zagros Mountains in Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmeh"@en .

aat:300020018 a skos:Concept ;
    skos:definition "Refers to the period from about 5000 to 4500 BCE in the Khuzistan area of the Zagros Mountains of Iran. During this period there are numerous parallels with Mesopotamian material culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bayat"@en .

aat:300020032 a skos:Concept ;
    skos:definition "Refers to the Elamite period from about 1450 to 1100 BCE during which the state of Elam was a military and political power in southwest Iran especially under the rules of Untash-Napirisha, Shutruk-Nahunte I, and Shilhak-Inshushinak."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Elamite"@en .

aat:300020041 a skos:Concept ;
    skos:definition "Styles belonging to Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian styles"@en .

aat:300020046 a skos:Concept ;
    skos:definition "Refers to the historical cultures of the region of Western Asia immediately east of the Mediterranean. For the nationality of the modern nation of Syria, use \"Syrian (modern).\" For a general term referring to the ancient fertile crescent, use \"Ancient Syrian.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syrian"@en .

aat:300020048 a skos:Concept ;
    skos:definition "Refers to the style of art and architecture found in southeast Anatolia and north Syria during the Neo-Hittite period from about 1000 to 750 BCE. The style is characterized by a combination of Hittite and Syrian traditions and Assyrian influences seen particularly in large-scale reliefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syro-Hittite"@en .

aat:300020055 a skos:Concept ;
    skos:definition "Refers to a style of metal bowls produced in the Levant during the early 1st millennium BCE that combines Syrian and Phoenician characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syro-Phoenician"@en .

aat:300020058 a skos:Concept ;
    skos:definition "Refers to the cultures of the areas surrounding the Mediterranean Sea, which is bordered by Europe, Asia, and Africa. It particularly refers to the island cultures and those on the mainland of Europe and Asia Minor that border the Mediterranean Sea. It includes cultures that developed in and around the Tyrrhenian, Ionian, Ligurian, Adriatic, and Aegean seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mediterranean"@en .

aat:300020059 a skos:Concept ;
    skos:definition "Refers to the cultures and styles of Greece and Asia Minor that developed on islands and on mainland areas surrounding the Aegean Sea, which lies between Greece and Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean"@en .

aat:300020060 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the Cycladic archipelago between circa 3500 or 3000 and 1100 BCE though some authors limit the period from circa 2500 to 1600 BCE. Works of art include pottery and especially marble figures possibly of religious importance, rendered in elegant yet simple, schematic, attenuated forms, depicting mainly nude females of the folded-arm type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cycladic"@en .

aat:300020063 a skos:Concept ;
    skos:definition "Refers to the style of artistic production on the Cycladic archipelago between roughly 3500 or 3000 and 2000 BCE though some authors date the period from circa 2500 to circa 1900 BCE. Artworks include stone vases, wall paintings, and most typically, pottery and marble figures. Early pottery is burnished and decorated with incised rectilinear or curvilinear designs and includes the frying-pan type, while later works are matt-painted. Marble figures are characterized by spare, elegant, and geometric forms and include most commonly the folded-arm type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Cycladic"@en .

aat:300020064 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the Cycladic archipelago between roughly 2000 and 1600 BCE represented mainly by pottery in the Dark Burnished, Cycladic White, and Black-and-red styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Cycladic"@en .

aat:300020065 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the Cycladic archipelago between roughly 1600 and 1050 BCE. Artworks include pottery decorated with abstract and figural motifs, wall paintings depicting festivals and natural scenes, and a group of large terracotta figures, all which reveal the influence of Minoan and later Mycenean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Cycladic"@en .

aat:300020069 a skos:Concept ;
    skos:definition "Refers to the style of works produced by the Grotta-Pelos culture in the Cycladic archipelago between circa 3200 and 2700 BCE, a period roughly corresponding to the Early Cycladic. Works of art are mainly represented by pottery, marble vessels, and by marble figurines including the violin, Plastiras, and Louros types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grotta-Pelos"@en .

aat:300020070 a skos:Concept ;
    skos:definition "Refers to the style of works produced by the Keros-Syros culture in the Cycladic archipelago between circa 2800 and 2200 BCE, a period roughly corresponding to the Early Cycladic. Though works of art encompass marble vessels and figures, pottery, and metalwork, significant developments include the introduction of new forms, including the fying pan type, and painted decoration in pottery, and the appearance of a variety of marble figures including the folded-arm type and representations of musicians and seated figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Keros-Syros"@en .

aat:300020071 a skos:Concept ;
    skos:definition "Refers to the style of works produced by the Phylakopi I culture in the Cycladic archipelago between circa 2200 and 1800 BCE during the Early Cycladic period and named for the site of the same name of Melos. Works of art include pottery painted with rectilinear motifs and metalwork but not the marble figures and vessels associated with previous periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phylakopi I phase"@en .

aat:300020072 a skos:Concept ;
    skos:definition "Refers to the culture and styles of ancient Greece, generally excluding modern and prehistoric periods, but including periods between around 900 BCE to around 31 BCE. For the culture of Greece in general, including modern Greece, see \"Greek.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Greek"@en .

aat:300020074 a skos:Concept ;
    skos:definition "Refers to a period and style of Greek art and culture that occurred from around 1100 BCE to around 900 BCE. It is characterized by the importation of objects and styles from the Levant and Egypt, a renewal of native Greek styles, and a general recovery from the upheavals caused when the Minoan/Mycenean world was violently overthrown in the 12th century BCE. Surviving artworks include simple fibulae, primitive clay figures, and pottery that is typically decorated with circles, arcs, triangles, and wavy lines, often executed with multiple brushes and placed in horizontal bands on various parts of the vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protogeometric"@en .

aat:300020079 a skos:Concept ;
    skos:definition "Refers to a period, culture, and style that developed first in Attica, but was eventually found throughout Greece, in Italy, and in the Levant. It is generally held to have occurred from around 900 BCE to around 700 BCE, though some classification schemes omit the Protogeometric period and begin the Geometric period at 1100 BCE. In pottery it is characterized by dark-on-light decorations arranged in regularly spaced horizontal bands, and differs from Protogeometric style in that the designs are busier and the bands cover nearly the entire vessel. Designs include zigzags, triangles, meanders, swastikas, and distinctive stylized, angular human and animal figures. Similar designs and figural types were used in sculpture and other arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Geometric"@en .

aat:300020080 a skos:Concept ;
    skos:definition "Refers to the earliest phase of Geometric style, ending in the early ninth century BCE. It is characterized by the establishment of standard vessel types, including the amphora, pelike, stamnos, hydria, oinochoe, krater, kylix, and lekythos, and by painted abstract designs, such as triangles, checkers, and concentric circles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Geometric"@en .

aat:300020081 a skos:Concept ;
    skos:definition "Refers to the phase of Geometric style that took place in the ninth and early eighth centuries BCE. It is characterized by the proliferation of new patterns in vase painting, including the introduction of stylized human and animal figures made of abstract shapes such as triangles, arcs, and lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Geometric"@en .

aat:300020083 a skos:Concept ;
    skos:definition "Refers to the most advanced phase of Geometric style, dating to the mid- and late eighth century BCE and appearing across a wide geographical area. It varied significantly in different locations, but in general it is characterized in vase painting by a sophistication in the representation of figures and animals, including the portrayal of recognizable mythological figures and narrative scenes. Sculpture from this period depicts a wide variety of animals and human figures that are stylized, but more naturalistic than in earlier art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Geometric"@en .

aat:300020084 a skos:Concept ;
    skos:definition "Refers to a phase of Greek style that followed the Geometric style chronologically, retained many elements of Geometric style, and was either transitional or an archaism, depending upon the geographic location. In some cases, it occurred after the flourishing of the Geometric period, but before the Orientalizing period was fully established, and thus provided a transition from one style to the other. In other cases, it occurred after the Orientalizing period was established, and thus was a conscious attempt to recreate the earlier Geometric style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-geometric"@en .

aat:300020085 a skos:Concept ;
    skos:definition "Refers to the ancient Greek period and style that followed the Geometric period and existed from around 725 BCE to around 650 BCE, overlapping with the early portion of the Archaic period of Greek history. It developed in Corinth and spread throughout Greece, to Etruria, and to other places with connections to Greece. It grew out of greatly expanded Greek trade and the subsequent influence of Near Eastern and Egyptian cultures. It is characterized by the abandonment of the geometric shapes and stick figures of the Geometric period to favor curvilinear forms, fleshy figures, and new themes, including exotic animals and monsters, such as sphinxes and griffins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orientalizing"@en .

aat:300020086 a skos:Concept ;
    skos:definition "Refers to the period, culture, and art of ancient Greece that begins around the mid-eighth century BCE and ends in the early fifth century BCE, with the Persian invasion. It is characterized by the introduction of the alphabet from Phoenicia, the establishment of important city states and colonies, the establishment of the open square, or agora, in city planning, and distinctive styles in painting, sculpture, and architecture. In vase painting, the stylized beasts of the Orientalizing period were replaced by more naturalistic figures in Black-figure and then Red-figure styles. In sculpture, more naturalistic forms developed from the stiff, canonical Egyptian figures of the Orientalizing period. In architecture, the Doric and Ionic orders were developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaic"@en .

aat:300020093 a skos:Concept ;
    skos:definition "Refers to an ancient Greek style and period that begins around 480 BCE, when the Greek city-states defeated the Persian invaders, and ends around 323 BCE, with the death of Alexander the Great. It is characterized by the rebuilding of cities after the Persian wars, the flourishing of philosophy, drama, architecture, sculpture, painting, and the other arts. In the visual arts, it is known for the mastery of the human form and sophistication of architectural design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Classical"@en .

aat:300020096 a skos:Concept ;
    skos:definition "Refers to the beginning of the ancient Greek Classical period and style, from around 480 BCE to around 450 BCE. In sculpture it is distinguished from the earlier Archaic style in that the human figure is portrayed with increased naturalism, including increased subtlety of facial expressions and contrapposto in standing figures. In vase painting there are regional variations, but in general there is increased mastery of the human figure and drapery. In architecture, the aesthetics of the late sixth and early fifth centuries are continued and refined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Classical"@en .

aat:300020097 a skos:Concept ;
    skos:definition "Refers to the middle phase of the Greek Classical period and style, from around 450 BCE to around 400 BCE. In sculpture it is characterized by the complete mastery of the ideal human form, represented in balanced, subtle movement and with drapery that clings to the body to reveal the form beneath. In vase painting, it is characterized by an increased refinement and variety of human forms and facial expressions. In architecture it is characterized by a lightening of proportions and a refinement of earlier established orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Classical"@en .

aat:300020100 a skos:Concept ;
    skos:definition "Refers to the last phase of the Classical period and style, from around 400 BCE to around 330 BCE. It was initiated by the end of the Pelopponesian War and ended after the Greek states lost their independence to Philip of Macedon. It is characterized by a movement away from the perfect, ideal canons of style to a greater focus on the depiction of individual human beings and the real world, and by a diversity and inventiveness among various artists. Notable innovations in sculpture include the depiction of female goddesses in the nude, figures that are less austere and more sensuous, poses and gestures that thrust out of the confined boundaries of the ideal Classical pose, and body proportions that are more slender than in High Classical art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Classical"@en .

aat:300020101 a skos:Concept ;
    skos:definition "Refers to the ancient Greek period, culture, and art of ancient Greece that lasted from about 330 BCE to 31 BCE, when Augustus defeated Cleopatra and Mark Antony. It is characterized by an international culture that was ushered in by Alexander the Great's conquest of India, Egypt, and the Near East. In architecture and art, the style is marked by greater sophistication, complexity, and diversity than was known in earlier Greek styles. Architecture diverges from strict rules of earlier periods. Sculptors emphasized more realistic figures in a greater variety of poses than in earlier Greek art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hellenistic"@en .

aat:300020103 a skos:Concept ;
    skos:definition "Refers to the style and culture that developed when Romans came into contact with and emulated characteristics of Greek culture and art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greco-Roman"@en .

aat:300020105 a skos:Concept ;
    skos:definition "Pottery styles belonging to Aegean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean pottery styles"@en .

aat:300020106 a skos:Concept ;
    skos:definition "Architecture styles belonging to Aegean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean architecture styles"@en .

aat:300020107 a skos:Concept ;
    skos:definition "Refers to an architectural style that has the same roots as the Ionic style. It developed in the northern Aegean islands and coastal region, but is seen in Etruria and elsewhere. It is seldom found after the fifth or fourth centuries BCE. It is distinguished from the Ionic by being much closer to the eastern prototypes, notably in the capitals where volutes rise from separate stems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aeolic"@en .

aat:300020109 a skos:Concept ;
    skos:definition "Refers to the architectural style associated with the fifth of the traditional five classical orders of architecture, that also include Doric, Ionic, Corinthian, and Tuscan. It is characterized by the merging of Ionic and Corinthian stylistic elements, particularly in the capital where the Ionic volute and the Corinthian acanthus leaves are combined to create a more lavish whole. The shaft of the column may be fluted or plain. The style probably originated in the Augustine period, was fully developed in the later Roman Colosseum around 80 CE, and was used through the Renaissance and beyond. For the assemblage forming associated columns, use \"Composite order.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Composite"@en .

aat:300020110 a skos:Concept ;
    skos:definition "Refers to the third of both the three Greek architectural orders and the later five traditional classical orders of architecture that, with Doric, Ionic, Tuscan, and Composite, was used by the Romans and through the Renaissance and beyond. It seems to have been influenced by Egyptian architecture, though it probably developed in Greece in interior architecture, and was used in exterior architecture by the third century BCE. In Greek architecture it is characterized by a form that is lighter and more ornate than Doric or Ionic, a bell-shaped capital with acanthus stalks emerging to support graceful volutes, and a column that is seated on a base and usually fluted. It was the most common of Greek styles in Roman architecture, and in Roman and later architecture the style was often modified. For the assemblage forming associated columns, use \"Corinthian order.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian"@en .

aat:300020111 a skos:Concept ;
    skos:definition "Refers to the architectural style associated with the first of both the three Greek architectural orders and the later five traditional classical orders of architecture that, with Ionic, Corinthian, Tuscan, and Composite, was used by the Romans and through the Renaissance and beyond. It may have origins in wooden Bronze Age structures, and stone versions of the style developed on mainland Greece, probably in Dorian Corinth and other cities such as Athens, in the eighth and seventh centuries BCE. In ancient Greek architecture, it is characterized by a simple form and imposing scale, an undecorated abacus and echinus, columns with no base or pedestal and shafts with twenty shallow flutes, and an entablature with three elements, a plain architrave, a frieze composed of alternate triglyphs and metopes, and a strongly projecting cornice. The Roman and later adaptations often display modifications of the strict Greek rules and may include some decoration and a base for the columns. For the assemblage forming associated columns, use \"Doric order.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Doric"@en .

aat:300020112 a skos:Concept ;
    skos:definition "Refers to the style associated with the second of both the three Greek architectural orders and the later five traditional classical orders of architecture that, with Doric, Corinthian, Tuscan, and Composite, was used by the Romans and through the Renaissance and beyond. It developed in the eastern Greek Aegean islands and on the coast of Asia Minor, probably influenced by Jewish and Phoenician architecture that employed \"lily capitals.\" Stone versions are found in Greece in the sixth century BCE, though wooden examples may have existed earlier. In ancient Greek architecture it is characterized by a form that is more delicate than Doric, a capital composed of two lateral volutes, a column that often has an Attic base and a shaft often with twenty-four semi-circular flutes with fillets between them, and an entablature that is more variable than Doric, including an architrave with overlapping courses, decorative moldings above, and a continuous carved frieze and/or row of dentils under the cornice. In Roman and later architecture the style was often modified and is recognized primarily by the volutes of the capital. For the assemblage forming associated columns, use \"Ionic order.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionic"@en .

aat:300020113 a skos:Concept ;
    skos:definition "Pottery styles belonging to Greek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek pottery styles"@en .

aat:300020118 a skos:Concept ;
    skos:definition "Refers to the culture and styles that developed in Athens or elsewhere in Attica, particularly to painted pottery styles that developed chronologically after the Geometric styles. Attic styles are intentionally different from Corinthian styles, and are characterized by imaginative compositions that do not necessarily comply with standards of scale or balance, by monumentality and grandeur, and eventually by a distinctive Black-figure style that became the standard for the rest of the Greek world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Attic"@en .

aat:300020119 a skos:Concept ;
    skos:definition "Refers to a style of Attic vase painting that appeared in its early form around 475 BCE and ended around 420 BCE, following the flourishing of the Attic Black-figure style. It is characterized by work in Red-figure technique, and later by painting on white ground. It was known initially by a new looseness and freedom in composition, and later by the influence of contemporary sculptural work that was taking place on the Parthenon. It typically includes ambitious compositions on large vases, and, in earlier forms, uses Archaic conventions side-by-side with innovative, free renderings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Free Style"@en .

aat:300020120 a skos:Concept ;
    skos:definition "Refers to the earliest phases of the Free Style, beginning around 475 BCE. It is distinct from later Free Style vase painting in its general sense of experimentation and a lack of the grandeur that was common later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Free Style"@en .

aat:300020127 a skos:Concept ;
    skos:definition "Refers to a style of pottery decoration that was seen in Boeotia from the seventh century BCE to the first half of the sixth century BCE. Boeotian pottery, from the region of Boeotia, northwest of Athens, was heavily influenced by Attic styles. It is characterized by the use of lively floral motifs and mythological themes, without much detail, typically in black-figure or with figures in relief. Boeotian clay tends toward a dull brown. A favored shape was the kantharos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boeotian"@en .

aat:300020131 a skos:Concept ;
    skos:definition "Refers to pottery styles that developed in Chalkis, Etruria, and other Chalcidian colonies, particularly the black-figure style that dates from around 550 BCE to around 510 BCE. It is characterized by excellence in drawing and glazing, often with vigorous battle themes and the occasional retention of rows of animals that was typical of earlier styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chalcidian"@en .

aat:300020133 a skos:Concept ;
    skos:definition "Refers to a pottery style created in the city and region of Corinth in the Peloponnese in south-central Greece, and exported extensively in other parts of Greece, Italy, and Egypt, particularly in the second half of the seventh century BCE and the first half of the sixth century BCE. It is characterized by large vessels and bold decoration arranged in friezes covering most of the surface. Designs are in black-figure on a light terra-cotta background, with red, white, and incised additions. Motifs may have been inspired by Eastern textiles and typically include animals, monsters, or human figures, with ornaments such as dots, leaves, or rosettes scattered over the background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian"@en .

aat:300020140 a skos:Concept ;
    skos:definition "Refers to the early phase of Corinthian pottery style, dating from around 625 BCE to around 600 BCE. It is characterized by a strong, incisive drawing of designs and a continuation of animal themes used in Proto-Corinthian pottery, but with the widespread addition of decorative elements between figures, usually distinctive rosettes with incised crosses in the petals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Corinthian"@en .

aat:300020141 a skos:Concept ;
    skos:definition "Refers to an intermediate phase of Corinthian pottery style, dating from around 600 BCE to around 575 BCE. It is characterized by apparent mass production of pots, using painted designs with a smaller repertory of clumsier animals than in the preceding phase, new animal poses, less crowded designs between figures, and the use of dots to echo the contours of the animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Corinthian"@en .

aat:300020142 a skos:Concept ;
    skos:definition "Refers to the late phase of Corinthian pottery style, dating from around 575 BCE to around 425 BCE, after which Corinth was no longer a major exporter of pottery. It is characterized by continued mass production and repetitive designs with little detail, as well as innovative work created with apparent care. Painting on these vessels typically includes elaborate ornaments arranged in formal patterns, a lively animation of design, and animals with attenuated proportions. During this phase animal scenes were gradually replaced by more scenes of human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Corinthian"@en .

aat:300020143 a skos:Concept ;
    skos:definition "The culture and styles of the Aegean island of Crete especially during the Minoan period between circa 3500 and 1050 BCE when Crete flourished as the political, economic, and cultural center of the Aegean. Significant artistic production includes fanciful and decorative pottery, small-scale sculptures such as the snake goddess figurines, and the construction and decoration of royal palaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cretan"@en .

aat:300020152 a skos:Concept ;
    skos:definition "Refers to a Greek pottery style that developed around 560 BCE and is named after a site on the island of Rhodes. The most common shape is a squat amphora, and the painting is characterized by dark-on-light designs that generally comprise a single human or animal figure in an empty field or closely spaced bands of ornament, including crescents and lotus flowers. In some classification schemes, it is a variation of middle or late Wild Goat Style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fikellura"@en .

aat:300020154 a skos:Concept ;
    skos:definition "Distinctive pottery painting styles produced in ancient Ionia, a region of central coastal Anatolia in present-day Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionian"@en .

aat:300020155 a skos:Concept ;
    skos:definition "Refers to a Greek pottery style that developed in the seventh century BCE on the island of Chios, and was known in other areas, including at the Greek colony in Naukratis, Egypt. It is characterized by an unusually white slip and a painting technique that differs from the contemporary Wild Goat Style in that animals and figures are not filled with pattern, but are more often left in reserve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chian"@en .

aat:300020158 a skos:Concept ;
    skos:definition "Refers to a phase of Chian pottery style that is characterized by its most common shape, a conical cup that may or may not be supported by a conical foot, thus resembling a chalice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chalice Style"@en .

aat:300020160 a skos:Concept ;
    skos:definition "Refers to a Greek pottery style that began in Eastern Greece and flourished from about 650 to 550 BCE. It grew out of Sub-Geometric and Orientalizing styles, and is characterized by a loose painting style using dark paint on a light colored slip, enlivened with purple details, and with faces and anatomical details reserved in light. The subject matter often includes animals, especially goats, deer, geese, and griffins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wild Goat Style"@en .

aat:300020165 a skos:Concept ;
    skos:definition "Refers to a style of vase painting found in Eretria. It developed in the first half of the seventh century BCE with exuberant, large-scale compositions executed in a combination of silhouette and outline. By around 500 BCE, vases were of similar form to earlier ones, but decorated in a new, bold black-figure style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eretrian"@en .

aat:300020166 a skos:Concept ;
    skos:definition "Refers to a pottery style that developed in Euboea, most notably from the seventh century BCE onward. It is characterized by distinctive Orientalizing and Black-figure designs that show the influence of Corinthian and Boeotian models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Euboean"@en .

aat:300020167 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the southern and central Greek mainland during the Bronze Age between circa 3600 and 1050 BCE. Until circa 1600 BCE, pottery including Minyan and Matt-painted wares dominates artistic production. After 1600 BCE, works of art for which the period is most recognized include, in addition to pottery, metalwork such as the Vapheio cups, wall paintings depicting scenes of warfare and hunting, and the construction of palaces and elaborate tholos tombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Helladic"@en .

aat:300020168 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the southern and central Greek mainland during the Bronze Age between circa 3600 and 2050 BCE. It is characterized by simple, often unornamented pottery in shapes including the sauceboat, and by architecture distinguished by corridor and apsidal types of houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Helladic"@en .

aat:300020169 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the southern and central Greek mainland during the Bronze Age between circa 2000 and 1600 BCE distinguished by Minyan and Matt-painted pottery and the development of tholos tombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Helladic"@en .

aat:300020171 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the southern and central Greek mainland during the Bronze Age between circa 1600 and 1050 BCE. Mycenaeans dominated the Aegean during this period and consequently works of art, though drawing on Minoan influence, demonstrate an increasing sophistication and variety. They include metalwork represented by golden Vapheio cups and gold face masks and wall paintings depicting predominantly scenes of warefare and hunting. Pottery is distinguished by the introduction of new formalized decorative motifs representing plant and animal life while architecture is characterized by the construction of palaces and elaborate tholos tombs such as the Treasury of Atreus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Helladic"@en .

aat:300020172 a skos:Concept ;
    skos:definition "Ancient pottery styles of southern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Italian"@en .

aat:300020173 a skos:Concept ;
    skos:definition "Refers to a pottery style that developed in Apulia in the fifth and fourth centuries BCE and was manifest in plain and ornate versions. The plain version is usually characterized by smaller vases with simpler decorative compositions, fewer figures depicted, and themes that are Dionysiac, genre scenes, or simple female heads. In the ornate version, the vases are larger, more colors are used, and designs are more ornate, including floral and geometric patterns, and mythological and funerary subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apulian"@en .

aat:300020174 a skos:Concept ;
    skos:definition "Refers to a style of vase decoration that is named for the site at Gnathia, Apulia, Italy, and dates from around 350 BCE through the early third century BCE. It is characterized by ornamentation painted in red and white on a black surface, and it has an apparent counterpart in the West Slope ware of Attica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gnathian"@en .

aat:300020175 a skos:Concept ;
    skos:definition "Refers to a very distinctive style of Black-figure pottery, most of which comprises hydriai dating from around 530 BCE to around 500 BCE, found in Etruria, and very probably made at Caere (modern Cerveteri, near Rome, Italy). The drawing style is of very high quality, the painting style is remarkably colorful, and the form and decoration of the hydriai differ from contemporary examples produced elsewhere in the Greek world. Decoration typically includes lotus, ivy wreaths, palmette friezes, and mythological scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caeretan"@en .

aat:300020176 a skos:Concept ;
    skos:definition "Refers to a pottery style created primarily in Capua and Cumae in the region of Campania, Italy, beginning in the second quarter of the 4th century BCE. It is generally characterized by rather small vases of various shapes, including a distinctive bail amphora, and decoration is typically painted in Red-figure style with women's flesh added in white. Themes are usually funerary or mythological scenes, with female heads added as subsidiary decoration below the handles of hydriai and on the necks of amphorae. Certain details are peculiar only to this style, including distinctive helmets and a particular type of cuirass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Campanian"@en .

aat:300020177 a skos:Concept ;
    skos:definition "Refers to a pottery style that developed in Lucania (modern Basilicata), Italy in the last third of the fifth century BCE and seems to have died out around 320 BCE, probably due to the remote locations of the workshops. It is characterized by a heavy borrowing from Attica in the early phases of the style, with mythological subjects predominating, while in later phases of the style the repertory of subjects is more limited and stock figures seem to be repeated without much variation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lucanian"@en .

aat:300020178 a skos:Concept ;
    skos:definition "Refers to a pottery style that probably developed at Paestum, near Salerno, Italy, and is characterized by a remarkable unity of painting style, subject matter, and ornamentation. Vases were made in various shapes, most notably the bell krater and the lebes gamikos with a complex lid made of multiple elements. Scenes often portray women's daily life and Dionysiac subjects, and distinctive motifs include several types of flowers, drapery with a dot-and-stripe border, unusual dipictions of rows of onlookers, and palmettes that are placed below the handle and serve as a frame for the figural scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paestan"@en .

aat:300020179 a skos:Concept ;
    skos:definition "Pottery style that developed on the island of Sicily and is found in other locations, including Campania. It dates from the early fifth century BCE through the fourth century BCE. The style varies from painter to painter, but is generally charaterized by the use of the Red-figure style, the addition of other colors, a preference for genre scenes over mythological subjects, and the inclusion of distinctive Sicilian details, for example, a wreath of ivy painted around the rim of kraters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sicilian"@en .

aat:300020181 a skos:Concept ;
    skos:definition "Refers to a pottery style that developed in the region of Laconia in the Peloponnese from around 600 BCE to around 550 BCE or later. It is characterized by the use of black-figure designs, often on a white slip, and motifs include pomegranates, lotus buds, palmettes, figures, and a net pattern. Laconian clay fires to a pale buff color in contrast to the orange-red color of Athenian clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laconian"@en .

aat:300020186 a skos:Concept ;
    skos:definition "The culture and artistic styles produced on the Aegean island of Naxos between circa 600 and 480 BCE during the period corresponding to the Greek Archaic period, or of the colony of Naxos on Sicily. The island is known mainly as a center for the production of monumental sculpture especially kouroi because of its numerous marble quarries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Naxian"@en .

aat:300020187 a skos:Concept ;
    skos:definition "The culture and style of the Aegean island of Paros, especially during the period between the 6th and 4th centuries BCE when the island was an important source of marble. Primary artistic production included korai and kouroi, grave stelae, and funerary reliefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parian"@en .

aat:300020188 a skos:Concept ;
    skos:definition "Refers to pottery styles from the island of Thera, typified by vases found at the site of Akrotiri. Through time the style varied, including early designs that are strictly geometric and linear, and later ones that combine pictorial and geometric motifs. Typical subjects include crocuses, lilies, papyrus, palm trees, goats, fish, swallows, seagulls, and dolphins. It appears that particular designs were used only on specific types of vases, perhaps serving as labels for their contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theran"@en .

aat:300020193 a skos:Concept ;
    skos:definition "Vase painting styles belonging to Greek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek vase painting styles"@en .

aat:300020195 a skos:Concept ;
    skos:definition "Refers to a style of Greek vase painting that developed from the Geometric and Orientalizing styles. It appeared in Corinth around 720 BCE, flourished in Attica by 600 BCE, and was found in Sparta, eastern Greece, and elsewhere, until the Red-figure style gradually replaced it in the late sixth century BCE. The style is characterized by a particular technique, which is characterized by the use of a refined slip, a two-stage firing process, and sintering to create black figures in silhouette on a red ground. Details were incised into the black figures or applied in purple or white pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black-figure"@en .

aat:300020200 a skos:Concept ;
    skos:definition "Refers to a style of ancient Greek vase painting that was transitional between the Black-figure style and the Red-figure style. Characteristics include that some figures were painted in Black-figure style and others, often the female figures, were outlined, using the brush rather than engraving to delineate the forms. Around 530 BC some painters eliminated the black-figure technique from their work entirely, they outlined all figures, but they then painted the background black, thus moving to the Red-figure style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Outline Style"@en .

aat:300020201 a skos:Concept ;
    skos:definition "Refers to a style of Greek vase painting that developed from the Black-figure style. It appeared in Athens around 530 BCE and spread to other areas of Greece, southern Italy, Etruria, and elsewhere in the Mediterranean area, until it disappeared in the third century BCE. The style is characterized by a particular technique, which involves the use of refined slip and a two-phase firing process to create a black ground through sintering, with figures reserved in red. The details of the figures are more fluid than in the Black-figure style, and are typically drawn with a brush, using both a defined, black relief line and a more dilute line that varies in color from dark gold to black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red-figure"@en .

aat:300020202 a skos:Concept ;
    skos:definition "Style of Attic Greek red-figure vases found at Kerch in the Ukraine and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kerch Style"@en .

aat:300020203 a skos:Concept ;
    skos:definition "Refers to a style of ancient Greek Red-figure vase painting that developed around 400 BCE. It is characterized by the use of thick lines, dark patterns on garments, and the use of white and yellow. Crowded compositions are typical, with many figures drawn in three-quarters view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ornate Style"@en .

aat:300020204 a skos:Concept ;
    skos:definition "Refers to a style of ancient Greek vase painting that employed a variation on the technique of the Red-figure style and became popular in the middle of the fifth century BCE. It is characterized by the use of a chalky white slip as a background, over which black glaze was used to outline figures, and diluted glazes of purple, brown, red, and white were used to color the figures. Additional colors that could not withstand firing were added afterwards. Scenes often depict figures situated on a common groundline at the bottom of a panel or in horizontal bands, which is unlike earlier compositions where figures were generally scattered throughout the picture plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "White-ground"@en .

aat:300020205 a skos:Concept ;
    skos:definition "Sculpture styles belonging to Greek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek sculpture styles"@en .

aat:300020206 a skos:Concept ;
    skos:definition "Refers to works created in a style imitating earlier Archaic styles, especially Hellenistic sculpture dating between 323 and 100 BCE that imitates the Archaic Greek style but was produced by new, more sophisticated carving techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaistic"@en .

aat:300020208 a skos:Concept ;
    skos:definition "Refers to the Greek style of artistic production during the 7th century BCE but mainly indicative of the characteristics of figural representation. Named for Daedalus, a legendary architect and patron of craftsmen, the style features figures with columnar bodies decorated with incised patterns denoting fabric, simplified anatomy, large heads, wide flat faces, staring expressions, and hair arranged in stylized rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daedalic"@en .

aat:300020210 a skos:Concept ;
    skos:definition "Refers to the Greek style of sculpture produced by Lysippos during the 4th century BCE and characterized by figures that convey a greater sense of height through slender bodies and small heads, and a sense of three-dimensional movement that departs from earlier more static frontal poses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lysippic"@en .

aat:300020212 a skos:Concept ;
    skos:definition "Refers to the style of sculptors of the first century BCE to the second century CE who added the epithet \"Athenaios\" to their signatures, according to the classification scheme of the nineteenth-century art historian, Heinrich Brunn. The sculpture was produced for rich patrons in Greece, Pergamon, Alexandria, and Italy. The style is characterized by the copying or adaptation of famous earlier Greek sculptures, and it was important in transmitting Classical Greek style to Romans and later western European culture. It is distinguished by its formalism and artificiality, which is unlike the realism typical of other Roman art of this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Attic"@en .

aat:300020213 a skos:Concept ;
    skos:definition "Refers to the style of Hellenistic sculpture centered in Pergamum in Asia Minor during the 2nd and 3rd centuries BCE. Identified most closely with the Great Altar at the Temple of Zeus, the style is characterized by the depiction of dramatic movement, extreme muscular tension, and intense emotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pergamene"@en .

aat:300020215 a skos:Concept ;
    skos:definition "Refers to the Greek style of sculpture produced by Phidias during the second half of the 5th century BCE. Identified with the sculptural decoration of the Parthenon, it is characterized by naturalism, monumentality, and a quiet majesty conveyed in simple poses and gestures that reveal a mastery of human anatomy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phidian"@en .

aat:300020217 a skos:Concept ;
    skos:definition "Refers to the Greek style of sculpture produced by Polykleitos between 450 and 420 BCE. His works are identified with ideal and harmonious proportion and a sense of solidity and naturalism embodied in his figures of male athletes, now known only through Roman copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polykleitan"@en .

aat:300020218 a skos:Concept ;
    skos:definition "Refers to the Greek school of sculpture centered in Argos in the 5th century BCE, Polykleitos being the most significant artist to emerge from the school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Argive School"@en .

aat:300020219 a skos:Concept ;
    skos:definition "Refers to the Greek style of sculpture produced by Praxiteles during the 4th century BCE. Identified with female figures, especially the Aphrodite of Cnidos, it is characterized by more slender proportions, sinuous curves, and smooth modeling producing shadows that cast a soft haze over the planes of the figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Praxitelean"@en .

aat:300020221 a skos:Concept ;
    skos:definition "Refers to the Greek style of sculpture produced between circa 480 and 450 BCE and considered a transitional period between the Archaic and Classical styles. It is characterized by a greater understanding of anatomy and movement but nonetheless by figures such as the Riace Bronzes which are austere, static, and simplified in form and ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Severe Style"@en .

aat:300020223 a skos:Concept ;
    skos:definition "Refers to the Greek style of sculpture produced by Athenian sculptor Skopas during the 4th century BCE and characterized by vigorous action and the depiction of emotion seen especially in the deep set eyes and upturned gaze of the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Skopasian"@en .

aat:300020224 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the Greek Bronze Age civilization on the island of Crete from around 3,500 BCE to around 1,050 BCE, as distinct from contemporary cultures on the Greek Mainland, known as \"Helladic,\" and on the other islands, known as \"Cycladic.\" Minoan art and culture spread in the Aegean region, and thus existed in locations outside Crete. It is characterized by innovations and a grand scale in city and palace design, extensive use of writing, and a distinctive sophistication in art, including elaborate seals, pottery, frescoes, and sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minoan"@en .

aat:300020226 a skos:Concept ;
    skos:definition "Refers to the earliest phase of Minoan art and culture, according to the classification system devised by the archaeologist, Arthur Evans. It is characterized by the introduction of metal from Asia Minor, distinctive sculpture, and pottery, including hand-made clay pots decorated with incised geometric patterns and others that are apparently inspired by Egyptian pieces of the First to Fourth Dynasties. It overlaps with the Prepalatial period in the alternate classification scheme of Nikolas Platon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Minoan"@en .

aat:300020229 a skos:Concept ;
    skos:definition "Refers to the intermediate phase of Minoan art and culture, according to the classification system devised by the archaeologist, Arthur Evans. It is characterized by modeled clay figures in the form of animals or humans that display emotions, pottery decoration that is polychrome and composed of increasingly complex curvilinear and foliate designs, and the construction of palaces. It overlaps with the Protopalatial period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Minoan"@en .

aat:300020230 a skos:Concept ;
    skos:definition "Refers to the latest phase of Minoan art and culture, according to the classification system devised by the archaeologist, Arthur Evans. It is characterized by fresco painting, reconstruction of palaces, and especially by pottery decoration painted in dark-firing slip on a pale ground, in contrast to earlier designs that were white on a dark slip ground. Designs are typically composed of more naturalistic plants and animals arranged in geometric zones or designs. It overlaps with the Neopalatial and the Postpalatial periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Minoan"@en .

aat:300020233 a skos:Concept ;
    skos:definition "Refers to the last phase of Minoan art and culture, according to the classification system devised by the archaeologist, Nikolas Platon. It follows the downfall of the ruling elite at Knossos, Crete, lasting from around 1375 BCE to around 1000 BCE. It is characterized by increasing political and economic fragmentation on Crete, beginning the process that would lead to the development of powerful city-states. It is also characterized by the exodus of Minoans from Crete, who with the Mycenaeans, were among the \"Sea Peoples\" who threatened Egypt, were defeated by Rameses III, and finally settled and became known as the \"Philistines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Postpalatial"@en .

aat:300020234 a skos:Concept ;
    skos:definition "Culture and style that developed on Crete from around the 15th century BCE to the 13th century BCE, after the fall of the Minoan civilization on Crete and the subsequent dominance of Mycenaean culture in the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Creto-Mycenaean"@en .

aat:300020242 a skos:Concept ;
    skos:definition "Refers to a phase of Minoan art and culture, according to the classification system devised by the archaeologist, Nikolas Platon. It began around 2,000 BCE and ended when earthquakes apparently ravaged the area around 1,700 BCE. It is characterized by economic centralization, establishment of extensive foreign contacts, the development of a more sophisticated script known as \"Linear A,\" the construction of distinctive, large palaces, the emergence of royal towns, a remarkable absence of fortifications, and a general flourishing of the arts, particularly in fresco painting, pottery decoration, carved stone vases, and jewelry. It overlaps with the Middle Minoan period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protopalatial"@en .

aat:300020243 a skos:Concept ;
    skos:definition "Refers to a phase of Minoan art and culture, according to the classification system devised by archaeologist, Nikolas Platon. It began around 1,600 BCE and ended with apparent civil unrest or warfare around 1,400 BCE. It is characterized by a renewed power and prosperity, an apparently authoritarian government, the rebuilding of palaces that had been earlier destroyed, and a flourishing of fresco painting, pottery painting, carved pottery, and sculpture. It overlaps with the Late Minoan period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neopalatial"@en .

aat:300020246 a skos:Concept ;
    skos:definition "Style of Middle Minoan pottery found mainly at Knossos, Phaistos, and the Kamáres cave sanctuary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamares"@en .

aat:300020247 a skos:Concept ;
    skos:definition "Refers to the culture and style that flourished on the Greek mainland and various islands, excluding Crete, in the Late Bronze Age, from around 1600 BCE to around 1100 BCE. The style is known from pottery, sculpture, architecture, metal work, and wall paintings, and from its influence on many contemporary cultures. It is characterized by the combination of earlier Minoan and Middle Helladic motifs with new elements that were invented or are of unknown origin, including stylized plants and elaborate compositions that incorporate lively, naturalistic animals and marine life. In a narrow sense, the term is used to refer specifically to the art and culture of the ancient city of Mycenae. It is also used in reference to places where the Mycenaean language was spoken or the Linear B script has been found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mycenaean"@en .

aat:300020250 a skos:Concept ;
    skos:definition "Refers to the period and style that followed the demise of the Mycenaean civilization in the twelfth century BCE, and preceded the emergence of a strong Greek culture. The style is particularly distinctive in vase painting, where earlier motifs were simplified to create abstract patterns and shapes, including concentric arcs and wavy lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-Mycenaean"@en .

aat:300020251 a skos:Concept ;
    skos:definition "Refers to the styles and culture that developed in antiquity in the Nile Valley in the area of modern-day Egypt and southwards. For the cultures and styles of the modern nation of Egypt, use \"Egypt (modern).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian"@en .

aat:300020252 a skos:Concept ;
    skos:definition "Periods related to Ancient Egypt, often defined in terms of dynasties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian periods"@en .

aat:300020253 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 4000 to 3000 or 2925 BCE though some authors date the period from 6000 BCE. Works of art include pottery such as the painted wares from the Amratian and Gerzian periods, stone vessels, ivory and clay figures, stone palettes, and wall paintings such as that found at Hierakonpolis depicting animals, boats, mourning women, and fighting men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Predynastic"@en .

aat:300020255 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period in Nubia from about 15,000 to 10,000 BCE. The period is characterized by grinding stones and blades possibly indicating experiments in agriculture as well as the presence of cemeteries and evidence of ritual burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qadan"@en .

aat:300020256 a skos:Concept ;
    skos:definition "Refers to the period in Upper Egypt from about 6000 to 4000 BCE associated with finds excavated at Badari. Works of art include anthropomorphic figurines, slate palettes, and black-topped pottery or pottery decorated with a ripple-burnished surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Badarian"@en .

aat:300020258 a skos:Concept ;
    skos:definition "Refers to the period in Upper Egypt from about 4000 to 3500 or 3200 BCE. Works of art include stone maceheads, slate palettes, stone vases, ivory carvings, figurines of various materials, black-topped red pottery, and a red polished pottery sometimes decorated in white slip with linear designs of human or animal figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amratian"@en .

aat:300020260 a skos:Concept ;
    skos:definition "Refers to the Predynastic period in Upper Egypt from about 3500 to 2925 BCE. Works of art include slate palettes, carved maceheads, copper artifacts, ivory and stone figurines, and buff-colored pottery decorated with geometric motifs and stylized representations of plants, animals, and people, in red paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gerzean"@en .

aat:300020262 a skos:Concept ;
    skos:definition "Refers to the first half of the Gerzean period in Upper Egypt. The period is characterized by a continuation of earlier art forms and evidence for new contact with south western Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Gerzean"@en .

aat:300020263 a skos:Concept ;
    skos:definition "Refers to the second half of the Gerzean period in Upper Egypt. The period is characterized by the appearance of artistic traits of the following First Dynasty which can be seen in decorated stone palettes and maceheads, wall paintings, and some of the earliest large scale sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Gerzean"@en .

aat:300020265 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2925 to 2650 BCE during the First and Second Dynasties; some sources also include the Third Dynasty ending about 2575 BCE. Works of art include pottery, wall paintings, sculpture and reliefs. During this period artistic conventions were formalized effecting the pose of the human figure, the arrangement of pictorial elements in register, and in sculpture, a rigid formal depiction of the figure that preserves the quality of the stone and the shape of the block. Architecture is distinguished by the development of tomb superstructures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Dynastic"@en .

aat:300020269 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2925 to 2775 BCE. Works of art include wall paintings, sculpture, reliefs and pottery and are characterized by the introduction of artistic conventions that become the standard for later Egyptian art as well as the representation of divine kingship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Dynasty"@en .

aat:300020271 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2775 to 2650 BCE. Works of art include wall paintings, reliefs, sculpture, and pottery and reflect increasingly formal artistic conventions. Architecture is distinguished by the construction of rectangular mastabas erected to protect subterranean tombs and to assert the status of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Second Dynasty"@en .

aat:300020276 a skos:Concept ;
    skos:definition "Refers to the first of three great period of Egyptian civilization from about 2650 to 2150 BCE comprising the Third Dynasty to Sixth Dynasty; some sources begin with the Fourth Dynasty about 2575 BCE and extend through the Eighth Dynasty ending about 2134 BCE. The period is characterized by royal monuments of the highest quality including the pyramid complexes of the Fourth Dynasty which symbolize the absolute sovereignty of Egypt's kings and the continued use of artistic conventions introduced in the Early Dynastic period. The end of the period is characterized by a general decline in the arts reflecting the political circumstances of the time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Kingdom"@en .

aat:300020279 a skos:Concept ;
    skos:definition "Refers to the period from about 2650 to 2575 BCE in Egypt. Works of art include sculpture, reliefs, and wall painting. The architecture is distinguished by King Djoser's Step Pyramid at Saqqara. The period can be seen as a link between the formative period of the first two dynasties and the classic period of the Old Kingdom beginning in the Fourth Dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Third Dynasty"@en .

aat:300020283 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2575 to 2465 BCE. The period is known as the classic period of the Old Kingdom particularly for the great pyramids built at Giza. Sculpture is characterized by firmly established representational conventions including a canon of proportions, and overall high technical standards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fourth Dynasty"@en .

aat:300020291 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2465 to 2325 BCE. The period is characterized by a continuation of traditions in the art and architecture of the Fourth Dynasty, but with notable changes such as the diminished size of the king's pyramids and the expansion of private tombs of the elite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fifth Dynasty"@en .

aat:300020297 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2325 to 2150 BCE. The period is characterized by internal problems in the royal family and the decentralization of power seen in the general decline of the arts and an increase in provincial tomb building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sixth Dynasty"@en .

aat:300020306 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2150 to 2018 BCE comprising the Seventh Dynasty to the Tenth Dynasty; some sources begin with the Ninth Dynasty about 2130 BCE. During the period a shift of power occurs from the city of Memphis to Heracleopolis and later to Thebes. In general the period is characterized by obscurity and anarchy resulting in the scarcity of surviving art and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Intermediate period"@en .

aat:300020308 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2150 to sometime before the start of the Ninth Dynasty about 2130 BCE; the Seventh and Eighth Dynasties are usually grouped together in sources. Little is known about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seventh Dynasty"@en .

aat:300020310 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from sometime after the end of the Sixth Dynasty about 2150 to about 2130 BCE; the Seventh and Eighth Dynasties are usually grouped together in sources. Little is known about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eighth Dynasty"@en .

aat:300020312 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2130 to 2080 BCE. The period is characterized by a shift of power from the city of Memphis to Heracleopolis but little is known about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ninth Dynasty"@en .

aat:300020314 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2080 to 1970 BCE. The period is characterized by the continuation of Ninth Dynasty power based at Heracleopolis as well as the lack of information about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tenth Dynasty"@en .

aat:300020315 a skos:Concept ;
    skos:definition "Refers to the second of three great periods in Egyptian civilization from about 2008 to 1630 BCE comprising the Eleventh Dynasty and Twelfth Dynasty; some sources include the Thirteenth Dynasty ending about 1630 BCE. The period is characterized by a revival of the arts seen particularly in the construction of royal funerary pyramids and temples, private rock-cut tombs and their decoration, an interest in portraiture in royal sculpture, and an overall high level of artistry and precision of execution particularly in relief sculpture and painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Kingdom"@en .

aat:300020317 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2081 to 1938 BCE, although it was not until 2008 that Egypt was reunified and the Middle Kingdom began. While the capital of the Dynasty was Thebes in the South, the reunification brought about a return to the artistic traditions associated with the North and an overall uniformity of style as a result of the centralized control of royal workshops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eleventh Dynasty"@en .

aat:300020322 a skos:Concept ;
    skos:definition "Refers to the period from about 1938 to 1756 BCE. The period is characterized by a revival of Old Kingdom artistic styles and a high quality of artistic production seen particularly in the construction of pyramid and mortuary temples, the introduction of portraiture in royal sculpture, and a high level of technical skill achieved in the minor arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twelfth Dynasty"@en .

aat:300020337 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1756 to 1540 BCE comprising the Thirteenth Dynasty through the Seventeenth Dynasty; some sources begin with the Fourteenth Dynasty about 1630 BCE. During this period at least four of the Dynasties ruled at the same. The period is characterized by the seizure of power by the Asiatic Hyksos of the Fifteenth Dynasty in the North during which elements of Asiatic civilization were absorbed by Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Second Intermediate period"@en .

aat:300020340 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1756 to 1630 BCE. The period is characterized by political unrest although a continuation of cultural traditions from the Twelwth Dynasty can be seen particularly in the quality and style of royal and private sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thirteenth Dynasty"@en .

aat:300020342 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1630 to 1540 BCE; some sources group this Dynasty with the Thirteenth Dynasty. The period is characterized by political unrest and perhaps the first wave of Asiatics in the North. Little is known about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fourteenth Dynasty"@en .

aat:300020344 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1630 to 1532 BCE during the rule of the Asiatic Hyksos in the North. The period is characterized by Asiatic influences and technical innovations in bronze working and pottery. Little is known about major art and architecture except that the Hyksos kings preferred to usurp older statues and engrave their names on them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fifteenth Dynasty"@en .

aat:300020346 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1630 to 1532 BCE during which a second branch of Asiatics took control of part of the Delta at the same time as the Hyksos of the Fifteenth Dynasty. Little is known about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sixteenth Dynasty"@en .

aat:300020348 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1630 to 1540 BCE during the reign of rulers at the city of Thebes in the South. The period is characterized by the anticipation of the flourishing of artistic production in the following New Kingdom and the continued production of high quality royal sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seventeenth Dynasty"@en .

aat:300020353 a skos:Concept ;
    skos:definition "Refers to the last of three great periods of Egyptian civilization from about 1540 to 1075 BCE comprising the Eighteenth Dynasty through the Twentieth Dynasty. The period is characterized by a flowering of the arts including the introduction of colossal statues, a new interest in painting, a high degree of craftsmanship in both royal and private sculpture, and elegant decorative and luxury arts. Notable architectural works include chapels, rock-cut tombs, and monumental stone temples for worship of the gods attesting to the rising power of the priesthood. A brief revolutionary episode especially in representational art occurred during the reign of Akhenaten in the Amarna period when many existing conventions were reversed and more freedom of expression was allowed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Kingdom"@en .

aat:300020355 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1540 to 1292 BCE. The period is characterized by a revival in the arts and a return to the traditions of the Middle Kingdom as well as artistic innovations including the revolutionary changes of the Amarna period, and a very high quality of craftsmanship. Works of art include many surviving royal statues, the relief decoration of a large number of tombs and temples, and finely worked decorative arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eighteenth Dynasty"@en .

aat:300020375 a skos:Concept ;
    skos:definition "Refers to the period in Egypt during the Eighteenth Dynasty from about 1353 to 1332 BCE during the reign of Amenophis IV who changed his name to Akhenaten. The name of the period is derived from the modern village of El-Amarna near the ruins of the new capital city founded by Akhenaten. The period is characterized by a profound change in the arts, as well as religion, thought, literature, and language, and many of its material remains were destroyed by later rulers. The art, predominately statuary and relief sculpture, has been described as expressionistic or mannerist as a result of a break with past artistic conventions particularly a change in the proportions of human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amarna period"@en .

aat:300020378 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1292 to 1190 BCE. The period is characterized by a return to more traditional styles and subject matter after the end of the Amarna period, but also an ecclecticism in sculptural styles and a diversity of artistic standards particularly in relief decoration which ranged from elegant and carefully carved examples to careless and incomplete works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nineteenth Dynasty"@en .

aat:300020385 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1190 to 1075 BCE. The period is characterized by a continuation of Nineteenth Dynasty artistic traditions particularly in royal sculpture and relief decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twentieth Dynasty"@en .

aat:300020399 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1075 to 664 BCE comprising the Twenty-first Dynasty through the Twenty-fifth Dynasty; some sources end with the Twenty-fourth Dynasty about 715 BCE. The period is one of political disruption resulting in the the diminished production of art and architecture during certain dynasties. A rise in the importance of metalworking, a tendency towards archaizing in sculpture, and a high level of artistic quality are notable characteristics of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Third Intermediate period"@en .

aat:300020400 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 1075 to 950 BCE also known as the Tanite Dynasty after its capital at Tanis. The period is characterized by few surviving monuments, a general decline particularly in sculpture, and the usurption of statuary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-first Dynasty"@en .

aat:300020404 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 950 to 730 BCE. The period is characterized by a revival of stone architecture and the development of fine metalwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-second Dynasty"@en .

aat:300020407 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 823 to 732 BCE. The period is characterized by a continuation of artistic traditions of the Twenty-second Dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-third Dynasty"@en .

aat:300020409 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 722 to 715 BCE. Little is known about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-fourth Dynasty"@en .

aat:300020411 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 750 to 656 BCE during which Kushite rulers held power. The period is characterized by a return to monumentality, a high quality of craftsmanship, and archaizing tendencies especially in sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-fifth Dynasty"@en .

aat:300020414 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 664 to 525 BCE also known as the Saite Dynasty after its capital of Sais. The period is characterized by a revival of the arts particularly in sculpture which developed a uniform idealized style known as the Saite style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-sixth Dynasty"@en .

aat:300020417 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 525 to 404 BCE. During this period Egypt was conquered by the Persians and little remains of the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-seventh Dynasty"@en .

aat:300020420 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 404 to 399 BCE during the rule of one king, Amyrtaios. Little is known about the art and architecture of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-eighth Dynasty"@en .

aat:300020422 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 399 to 380 BCE. The period is brief and little is known about its art and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twenty-ninth Dynasty"@en .

aat:300020424 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 380 to 343 BCE. The period is characterized by the resumption of temple building on a grand scale and an idealized style in sculpture derived from the earlier Saite style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thirtieth Dynasty"@en .

aat:300020426 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 343 to 323 BCE. During this period Egypt is reconquered by the Persians and little is known about the art and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thirty-first Dynasty"@en .

aat:300020432 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 304 to 30 BCE named after the first ruler of the Dynasty, Ptolemy I, who inherited Egypt in the division of Alexander the Great's empire. The period is characterized by the merging of strong Greek influences with traditional Egyptian modes of expression especially in architecture, and changes in pictorial conventions such as the representation of the human figure in statuary and relief sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ptolemaic"@en .

aat:300020449 a skos:Concept ;
    skos:definition "Culture or the style of artistic production produced by Christian Egyptians between mainly the 4th and 7th centuries or the 5th and 8th centuries according to some authors, but also including works produced up to the 12th century. Works of art are characterized by bright flat color, static figures, and decorative motifs derived from Syrian, Near Eastern, and ancient Egyptian sources. They include ivory and stone carvings, manuscript illumination, pottery, wall paintings, and woven textiles. Architecture is distinguished by the construction of churches, cenobitic cells, and funerary monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coptic"@en .

aat:300020471 a skos:Concept ;
    skos:definition "Culture and style of artistic production in Etruria, now modern Tuscany and part of Umbria, between the 7th and 3rd centuries BCE. Known partly from elaborate tumuli, artworks include bronze mirrors and cists, wall paintings, and terracotta and bronze sculptures that are distinct from the Greek Archaic style in their lively sense of movement and delicate decoration. Developments in architecture include the construction of mud brick and wooden temples decorated with terracotta roof tiles and statues. In some classification schemes Etruscan culture includes the Villanovan culture, which was first evident on the Italian peninsula in the ninth century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etruscan"@en .

aat:300020484 a skos:Concept ;
    skos:definition "Refers to the period and style of artistic production in the Etruscan city of Tarquinia especially between the 7th and 2nd centuries BCE when the city developed as an economic, political, and cultural center. Artworks, mostly associated with burial tombs, include wall paintings, sarcophagi, and door reliefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarquinian"@en .

aat:300020493 a skos:Concept ;
    skos:definition "Refers to the styles and cultures on the Italian peninsula, particularly in the area of ancient Etruria, that combine elements of the original Etruscan culture and the later Roman culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etrusco-Roman"@en .

aat:300020499 a skos:Concept ;
    skos:definition "General term for pottery styles of ancient Etruria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etruscan pottery styles"@en .

aat:300020500 a skos:Concept ;
    skos:definition "Style of fine Roman pottery produced primarily during the Augustine period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arretine"@en .

aat:300020501 a skos:Concept ;
    skos:definition "Style of Etruscan pottery that resembles metalware, produced between the end of the 7th and the beginning of the 5th centuries BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bucchero"@en .

aat:300020502 a skos:Concept ;
    skos:definition "Refers to the cultures and styles that existed on the ancient Italian peninsula before the development and expansion of the Roman culture. It includes cultures of numerous tribes who spoke around forty different languages or dialects, and whose cultures varied greatly. The term excludes Greeks who colonized the area, and it generally excludes the Etruscans. In the strictest sense, the term only refers to cultures that spoke Italic languages, including Latin, Faliscan, Osco-Umbrian, South Picene, and Venetic, which are generally held to be Indo-European languages that share many common features, and are distinct from Etruscan and Greek. In some contexts the term includes Etruscans along with other pre-Roman cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italic"@en .

aat:300020514 a skos:Concept ;
    skos:definition "Hellenistic pottery style known from a site at Centuripe, Sicily. It is characterized by the use of a combination of relief decoration and painted scenes, which are distinctive in depicting figures painted in various colors, imitating mural paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Centuripe"@en .

aat:300020531 a skos:Concept ;
    skos:definition "Refers to the Iron Age style, period, and culture named after the site at Villanova, near Bologna, Italy. It is evident in northern and central Italy and Campania in the ninth and eighth centuries BCE, continuing in northern Italy until the sixth century BCE. The culture varied in different areas and at different times, but it is generally characterized by distinctive cemeteries, armor, weapons, jewelry, and grave urns and other pottery, including double-coned and house-shaped urns, decorated with geometric designs produced by scratching and stamping. Many scholars believe that the Villanovan culture probably developed from a branch of the Urnfield cultures of eastern Europe that moved into Italy, and were eventually confronted with advancing Etruscans. Others classify Villanovan as the beginning of Etruscan civilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Villanovan"@en .

aat:300020533 a skos:Concept ;
    skos:definition "Refers broadly to the period, styles, and culture of the state centered on the city of Rome from the period from the founding of the city ca. 700 BCE through the events leading to the founding of the republic in 509 BCE, the establishment of the empire in 27 BCE, and the final eclipse of the Empire of the West in the 5th century CE. Ancient Rome became a powerful force and supplanted Greek and Etruscan influence on the Apennine peninsula. Its rule and influence gradually encompassed a wide area in Europe, northern Africa, the Middle East, and Asia Minor. Its influence was wide in scope, including sculpture, painting, architecture, engineering, language, the road system, law, and many other areas of culture. Roman art and architecture is characterized by early derivations from Greek art and architecture, but it gradually developed into a style of its own, absorbing characteristics of styles from the far flung regions under its control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman"@en .

aat:300020537 a skos:Concept ;
    skos:definition "Refers to the period in history and style of art that developed when Rome was ruled by the Republic, from its founding in 509 BCE through the Battle of Actium in 31 BCE or the formal establishment of the Empire in 27 BCE. Art produced during this period reflects the political power, glories, and distinguished ancestors of the ruling families, resulting in many portraits and historical reliefs. The style is characterized by the influence of Classical Greek art and an emphasis on extreme realism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Republican"@en .

aat:300020540 a skos:Concept ;
    skos:definition "Refers to the period and style of art produced during the later phase of the Republic, around 120 to 80 BCE. The architectural style is characterized by the construction of large, terraced sanctuaries and villas, typically cut into a hillside and arranged with rigid axial symmetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Republican"@en .

aat:300020541 a skos:Concept ;
    skos:definition "Refers to the period in history and the style of art that developed when the Roman Republic ceased to exist and Rome expanded its territory and was ruled by emperors. The period is generally considered to begin with Octavian's victory at the Battle of Actium in 31 BCE, and to last through the rule of the Severans. For later emperors, see \"Late Antique.\" For the period and culture of the Holy Roman Empire, use \"Holy Roman Imperial.\" Note that some classifications include the Tetrarchic, Constantinian, and the Holy Roman Empire in the \"Roman Empire.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Imperial"@en .

aat:300020543 a skos:Concept ;
    skos:definition "Refers to the period and style of art produced during the reign of Augustus Caesar, 27BC to 14CE. With the purpose of glorifying the accomplishments of the Emperor, the style is characterized by its emphasis on propoganda and grandeur, resulting in commemorative monuments and sculpture rendered in an elclectic, graceful manner influenced by Classical Greek art. The period also saw the development of the Third Style of wall painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Augustan"@en .

aat:300020545 a skos:Concept ;
    skos:definition "Refers to the period and style of art that coincided with the rule of the sucessors of Caesar Augustus, 14 to 68 CE. In sculpture the style is characterized by a return to the realism of the Republican period, appearing in both adult and child portraits. The period also saw streets widened, structures rebuilt, and the development of the Fourth Style of wall painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Julio-Claudian"@en .

aat:300020551 a skos:Concept ;
    skos:definition "Refers to the period and style of art, predominantely sculpture and architecture, reigns of the emperors Vespasian (69-79 ), Titus (79–81 CE), and Domitian (81-96 CE), that coincided with the dynasty established after the death of Nero in 69 CE. The style is charcterized by a greater emphasis on depth, pictorial illusion, the use of light and shade, and the construction of large-scale buildings such as public baths and ampitheaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flavian"@en .

aat:300020560 a skos:Concept ;
    skos:definition "Refers to the period and style that coincided with the reign of the successors of Antoninus Pius, most notably Marcus Aurelius, in the date range 138 to 192 or 193 CE. Sculpture style is typified in the friezes found on the base of the Antonine Column, and is characterized by a high degree of relief, dramatic expressions, and an irrational treatment of space and scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antonine"@en .

aat:300020566 a skos:Concept ;
    skos:definition "Refers to the period and style of art, predominantly sculpture and architecture, that coincided with the reign of Septimus Severus from 193 to 211 CE and his successors in the mid-3rd century CE. In sculpture, the style reflects changes in fashion such as close-trimmed beards and corkscrew curls. The period also witnessed extensive building projects, such as the Baths of Caracalla."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Severan"@en .

aat:300020575 a skos:Concept ;
    skos:definition "Refers to the period and style of art, predominantly sculpture, that coincided with the rule of the Tetrarchs during the second half of the 3rd centry CE. The style is characterized by work executed in poryphyry with an almost total disappearance of physical likeness and anatomical structure, and an emphasis on the expressive function of the eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tetrarchic"@en .

aat:300020576 a skos:Concept ;
    skos:definition "Refers to the period and style of art, notably of sculpture and architecture, that coincided with the reign of Constantine the Great from 311 to 337 CE. In sculpture, the style is characterized by a departure from Classical Greek illusionism and naturalism, with a greater emphasis on symbolism, expressionism, and clear narratives in order to convey the teachings of Christianity. In architecture, the style is characterized by the addition of a transept and apse to Roman basilicas to create cross-shaped structures typical of Early Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Constantinian"@en .

aat:300020580 a skos:Concept ;
    skos:definition "Refers to the styles and cultures that developed in the area of Gaul, in modern France and south and west of the Rhine river, under the influence of Roman rule and culture. The term is also used to refer narrowly to the style and culture that developed among Gallic people in Gaul, under Roman influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gallo-Roman"@en .

aat:300020599 a skos:Concept ;
    skos:definition "Refers to architectural style associated with the fourth of the traditional five classical orders of architecture, that also include Doric, Ionic, Corinthian, and Composite. It is often described as a simplification of the Doric style, and it is distinguished from other styles by fewer and bolder moldings, no triglyphs or other decoration on the frieze, no decorative details on the entablature or capitals, and generally no fluting on the column, though in Neoclassical works the shafts may have rusticated bands. For the assemblage forming associated columns, \"Tuscan order.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuscan"@en .

aat:300020600 a skos:Concept ;
    skos:definition "Sculpture styles belonging to Roman cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman sculpture styles"@en .

aat:300020601 a skos:Concept ;
    skos:definition "Refers to the style of sculpture that developed in the area of Aphrodisias, in Caria, Asia Minor, modern Turkey. The site was a major cult center of an ancient Anatolian fertility goddess, and later of the goddess Aphrodite, and thus is associated with artistic production from the second millennium BCE or earlier. However, it truly flourished as an artistic center beginning with the reign of the Julio-Claudian emperors in the first century BCE and lasting until the fifth century CE. The sculptural style is characterized by the use of exquisite marble that was quarried nearby, a bichrome marble pallette, thematic sophistication, creative originality, and a wide distribution to many parts of the Roman Empire. Some scholars believe that a workshop of this school also existed in the city of Rome itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aphrodisian"@en .

aat:300020607 a skos:Concept ;
    skos:definition "Refers to the style of wall painting common in the Late Republican period. The style is characterized by the application of a mixture of stucco and marble dust to a surface, which is then painted in panels of red, green, and tan, and enclosed by white frames of modeled stucco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Style"@en .

aat:300020609 a skos:Concept ;
    skos:definition "Refers to the style of wall painting which is roughly contemporary with the reign of Julius Caesar, about 80 to 15 BCE. The style is characterized by the expansion of the picture plane into a three-dimentional space, opening on to architectural vistas or mythological scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Second Style"@en .

aat:300020611 a skos:Concept ;
    skos:definition "Refers to the style of wall painting first developed in Rome during the reign of Augustus, and later in Pompeii. In its early phase, the style is characterized by fanciful, elegant, slender ornament, partial perspectives and unstable planes separated by solid areas of typically black, red or yellow. In the 1rst century CE, the mature Third Style featured increasingly elaborate architectural and mythological scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Third Style"@en .

aat:300020613 a skos:Concept ;
    skos:definition "Refers to the style of wall painting that developed after the earthquake in Pompeii in 62 CE, and was made fashionable by painters working for Nero in Rome. The style is charterized by elaborate architectural schemes, trompe l'oeil, genre scenes, still lifes, and juxtapositions between painted and actual moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fourth Style"@en .

aat:300020620 a skos:Concept ;
    skos:definition "Culture and style that developed in the area of coastal Syria, Lebanon, and Palestine from about 3000 to 1200 BCE. The style is characterized by an eclecticism reflecting a mixture of Aegean, Anatolian, Mesopotamian, and Egyptian influences that can be seen particularly in metalwork and ivory carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canaanite"@en .

aat:300020627 a skos:Concept ;
    skos:definition "Refers to the culture of the island of Cyprus, particularly during the Bronze Age from about 2300 to 1050 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypriote"@en .

aat:300020634 a skos:Concept ;
    skos:definition "Refers to the period between about 1600 and 1100 BCE when Mesopotamia was ruled by the Kassite dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kassite"@en .

aat:300020640 a skos:Concept ;
    skos:definition "Style and culture of the ancient area of northern Mesopotamia, particularly from about 1500 to 1300 BCE, when the Mitanni kingdom flourished. The art of the period is characterized by fine ivory carving, glass and glaze production, bronze and iron working, and cylinder seals combining Babylonian, Egyptian, and Aegean motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mitannian"@en .

aat:300020643 a skos:Concept ;
    skos:definition "Culture that first appear in the early 12th century BCE in the Middle East. Their arrival is signaled by artifacts that are unlike those of other local populations at the time. Differences include pottery with close parallels to the ancient Greek world, the use of an Aegean instead of a Semitic script, and the consumption of pork. The style of art is characterized by a combination of Aegean, Canaanite, and Egyptian elements, seen particularly in cermaics and metalwork. They may have originated in Crete. It is generally agreed by modern scholars that the Philistines were the same as the \"Peleset\" of historical records. They may also be the \"Sea Peoples,\" or at least one of the tribes so-called."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Philistine"@en .

aat:300020645 a skos:Concept ;
    skos:definition "Refers to the style developed on the Levantine coast in the 1st millennium BCE. The style is characterized by a combination of a variety of Near Eastern styles and Egyptianizing motifs seen particularly in ivory, glass, and metal works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phoenician"@en .

aat:300020646 a skos:Concept ;
    skos:definition "Style and culture that developed in Cyprus during the 9th century BCE when Phoenicians established a colony at the city of Kition in Cyprus. The style is characterized by strong Phoenician influences seen particularly on metal bowls with embossed scenes on their inside, and was an important source of iconography for Cypriote art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypro-Phoenician"@en .

aat:300020648 a skos:Concept ;
    skos:definition "Refers to a style of Greek pottery painting that occurred on the island of Rhodes around 650 BCE. It is characterized by a spontaneous, free brush stroke and themes that often include animals. In some classification schemes it is a variation on the Wild Goat Style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhodian"@en .

aat:300020656 a skos:Concept ;
    skos:definition "Styles, periods, and cultures of the continent of Europe, which is in the northern hemisphere, is bounded by the Arctic Ocean, the Atlantic Ocean, and the Mediterranean Sea, and is generally considered to be delimited on the east by the Ural Mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European"@en .

aat:300020661 a skos:Concept ;
    skos:definition "Refers to the style and period in the eastern Roman Empire surrounding the rule of Theodosius I (379-395 CE) through that of his grandson Theodosius II (408-450 CE). The style of this period is driven by the vigorous suppression of paganism and Arianism by Theodosius I, the emphasis on scholarly pursuits and the Theodosian Code of Law of Theodosius II, and the building campaigns of both emperors, including the erection of walls around Constantinople."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theodosian"@en .

aat:300020663 a skos:Concept ;
    skos:definition "Refers to the Early Byzantine period and style associated with the reign of the Byzantine Emperor Justinian I (527-565) and the reigns of the emperors who immediately preceded and followed him, Justin I (518-527) and Justin II (565-578). The style is characterized by grandiose optimism glorifying the prestige of Byzantium, and is marked by ambitious building campaigns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Justinianic"@en .

aat:300020665 a skos:Concept ;
    skos:definition "The culture, styles, and period of the first centuries of Christianity, by some reckonings through the 9th century. In art, it generally refers to art of Italy and the western Mediterranean from the third to the mid-9th century CE. It is characterized by an adaptation of the artistic language and symbolism of classical antiquity, but generally sacrifices classical ideals of physical beauty and technical perfection to emphasize spirituality and the immaterial world. For the culture, style, and period of eastern Mediterranean Christian from the 4th to the mid-15th century CE, use \"Byzantine.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Christian"@en .

aat:300020666 a skos:Concept ;
    skos:definition "Refers to the period in history and the style of art that developed after Severan rule in the Roman Empire. It includes the period when Diocletian shared his power in a Tetrarchy and the subsequent period marked by the conversion of Constantine and the Empire to Christianity. This period overlaps with the Early Christian and Early Byzantine periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Antique"@en .

aat:300020669 a skos:Concept ;
    skos:definition "Culture, style, and period of the Christian states of the eastern Mediterranean during the rule of the Byzantine Empire (330 - 1453 CE). Byzantine art and culture was carried throughout much of the Christian world, and lasted into the 16th century in eastern Europe. The style is characterized by imperial and religious subject matter, and a movement away from the original Greek naturalistic forms to favor ritualistic stylization, intended to suggest the spiritual. For the culture and style of the Italian and western Mediterranean Christian world roughly from the third to the mid-ninth century CE, use \"Early Christian.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Byzantine"@en .

aat:300020674 a skos:Concept ;
    skos:definition "Refers to the style following the Iconoclastic crisis, from the mid-ninth century through the early 13th century. The style is mainly evident in the eastern Roman empire, and spread along with the Orthodox faith to the Balkans and Russia after the loss of Asia Minor to the Seljuk Turks in 1071. The style is characterized by its evolution from earlier Byzantine art, including a reduction in the size of churches and monasteries, frequent use of the Greek cross plan, interiors encrusted with rich marble, mosaics, painting, and ivory carvings, which were typically more austere, linear, and abstract compositions in a rigid iconographic system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Byzantine"@en .

aat:300020676 a skos:Concept ;
    skos:definition "Refers to the revival of Byzantine style and western influence that evolved after the Crusades in Byzantium and eastern Europe in the late 13th century. Architecture of the period is remarkable for multi-colored materials, decorative details, and the variety of types, generally variants on old themes. In manuscript illuminations, mosaics, wall painting, panel painting, ivories, and luxury arts the style is characterized by strong color, more naturalistic depictions of light on forms, and often imaginative compositional and stylistic solutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Byzantine"@en .

aat:300020678 a skos:Concept ;
    skos:definition "Regional styles belonging to Byzantine cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Byzantine regional styles"@en .

aat:300020683 a skos:Concept ;
    skos:definition "Refers to the style of art that developed in the great Byzantine court at Constantinople. It is generally characterized by enormous scale, architectural innovation, coherence of plan, extravagant use of precious materials, and figures that are typically tall, slim, elegant, and poised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Constantinopolitan"@en .

aat:300020688 a skos:Concept ;
    skos:definition "Refers to the period and style that blossomed between the end of the Iconoclastic Controversy of 843 and the occupation of Constantinople by the Latins in 1204. The style developed around the dynasty initiated by Basil I the Macedonian (867-886) through successive rulers, including Constantine VII (913-959) and the Comnenes (1081-1185), and was given life in the intense cultural activity and renovation campaigns sponsored by these rulers and the resulting need for painting, mosaics, and ivory carvings to replace lost images. The style is characterized by a particularly strong tendency toward Classicism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macedonian Renaissance"@en .

aat:300020692 a skos:Concept ;
    skos:definition "Refers to the Middle Byzantine style and period surrounding the Comneni dynasty (1081-1204) in the eastern Roman Empire. The style is driven by a desire to restore the grandeur of the Empire after the First Crusade, and is particularly characterized by the construction of monasteries and enormous dwellings for the Comneni clan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Comnenian"@en .

aat:300020698 a skos:Concept ;
    skos:definition "Refers to the period and culture surrounding the conquest and colonization of the Byzantine Empire by the West following the Fourth Crusade, lasting from the late 12th and early 13th centuries until the Latin rulers were ousted during the 1260s. The style is characterized by an influx of western designs and motifs, making reference to contemporary western Romanesque and Gothic styles and to the glory of the western Roman Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin Empire"@en .

aat:300020700 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the penitentiary pilgrimages, the Crusades of 1096 to 1291, and subsequent settlement of European Christians in the Holy Land and eastern Mediterranean area through the 15th century. The style is characterized by the joining of European Romanesque and Gothic art and architecture with the local artistic traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crusader"@en .

aat:300020701 a skos:Concept ;
    skos:definition "Refers to the revival of the Byzantine style in Byzantium and eastern Europe under the Palaeologue dynasty (1261-1453). The style differs from earlier styles in sacrificing formality for greater freedom, and is noted for a preference for wall paintings to mosaics, more complex compositions that often cover entire walls, and a change in iconography to often prefer themes from the Apocryphal Gospels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palaeologan"@en .

aat:300020704 a skos:Concept ;
    skos:definition "Refers to the style and period that developed beginning with the return of the emperor Michael VIII Palaeologus from exile to Constantinople in 1261, when he started to clean up the devastation left by the Crusaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Palaeologan"@en .

aat:300020720 a skos:Concept ;
    skos:definition "Refers to the style and period that developed after the conquest of Constantinople by the armies of the Fourth Crusade in 1204 and lasted into the early 14th century. The style is particularly evident in southern and central Italy, and was fertilized by the import of Byzantine portable objects, by Greek artists in Italy, and by western artists returning from Byzantine territiories. Italo-Byzantine style is characterized by the merging of Byzantine themes, figural types, and decorative elements with Hellenistic-Roman illusionism, Gothic fluency of line, and local Italian traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italo-Byzantine"@en .

aat:300020732 a skos:Concept ;
    skos:definition "Styles belonging to Russian Byzantine cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian Byzantine styles"@en .

aat:300020738 a skos:Concept ;
    skos:definition "Refers to the style of architecture and art that developed beginning in the late 12th century at Vladimir in the principality of Rostov-Sizdal. The style is characterized by an amalgamation of eastern Byzantine art and elements of western Romanesque art, including decorative effects composed of Romanesque figural and ornamental motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vladimir-Suzdalian"@en .

aat:300020740 a skos:Concept ;
    skos:definition "Generally, the style and culture of Moscow or of the former principality of Muscovy. May also be used specifically to refer to the style of architecture and art that developed first in the 13th century in Moscow. The architectural style merges Byzantine elements, Italian Renaissance details, and local Russian architectural fantasy, and is often characterized by domes set upon towers, rich color, and extravagant, complex details. A distinctive style in mural and icon painting also developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muscovite"@en .

aat:300020756 a skos:Concept ;
    skos:definition "Refers to the period beginning in the Christianized Roman Empire in the fifth century and lasting until the Renaissance, which began in the 13th to the 15th century CE, depending upon which country is being discussed. The variety of styles that developed during the Medieval period are generally characterized by an evolution of the Greco-Roman tradition to incorporate Christian themes, the energetic spirit of the Celtic and Germanic peoples, and the thriving new towns populated by free men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medieval"@en .

aat:300020760 a skos:Concept ;
    skos:definition "Refers to the periods and styles in Europe from the Migration period to the Romanesque period, roughly covering the fourth to the eleventh centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Medieval"@en .

aat:300020764 a skos:Concept ;
    skos:definition "Refers to the culture, period, and style surrounding the reign of Charlemagne (768-814) and his successors through about 900 CE. The style is characterized by a renewal of the culture of the Roman Empire as it existed under Constantine and Theodosius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carolingian"@en .

aat:300020766 a skos:Concept ;
    skos:definition "Refers to the period, style, and culture associated with the rule of the Ottonian emperors (919-1024) and Salian rulers Conrad II and Henry III, through most of the 11th century. The style is an amalgam of elements including the ideals of the Carolingian art, a renewed interest in Early Christian art, and the influence of contemporary Byzantine art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ottonian"@en .

aat:300020768 a skos:Concept ;
    skos:definition "Refers to the style and period most evident during the 11th and 12th centuries in western Europe. The style flourished in architecture with the new growth of cities and the accompanying churches, and the rebuilding of monasteries. The style is noted for regional differences, but overall is characterized by the influence and interpretation of Roman and succeeding architecture, great size, round arches, masonry vaults, and innovations in structure to provide adequate illumination. The style also developed in monumental relief sculpture, stained glass, book illumination, mural painting, ivory carving, and precious metalwork, and is characterized by flat, stylized forms, and richly detailed ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romanesque"@en .

aat:300020770 a skos:Concept ;
    skos:definition "Refers to a style of architecture and art evident in Catalonia and Lombardy beginning in the tenth century. The style typically combines nascent Romanesque forms with Moorish elements, and has some overlap with the Mozarabic style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Romanesque"@en .

aat:300020775 a skos:Concept ;
    skos:definition "Refers to the style and period that began in northern France in the mid-twelfth century, and spread to the rest of western Europe during the next 100 years. It evolved into the Renaissance at different times in different parts of Europe. The style evolved in cathedral architecture and is characterized by immense interiors, towers, spires, complex and detailed images in stone, paint, and glass, and soaring height facilitated by pointed arches and flying buttresses. The style also flourished in stained glass, sculpture, elaborate altarpieces, wall painting, and manuscript illumination where it typically features bright color, elongated proportions, intricate detail, and emotional narrative content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic"@en .

aat:300020780 a skos:Concept ;
    skos:definition "Refers to the early phases of the style and period that flourished in the Île-de-France with the emergence of the strong French monarchy and resulting building campaigns in the mid-12th century, and spread to other European centers. The style is characterized by a new departure from the thick supporting walls of the earlier, massive Romanesque structures to a quest for lighter, thinner, elongated proportions and greater interior illumination, using pointed arches, ribbed vaults, more open interior spaces, and enormous stained glass windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Gothic"@en .

aat:300020782 a skos:Concept ;
    skos:definition "Refers to the period and style of Gothic art of the late 12th through the 13th centuries in France and elsewhere in Europe, marked by the achievement of Gothic ideals in architecture and other arts. The style is characterized in sculpture and painting by a return to the balance and naturalism of the sculpture of classical Greece and Rome. The style in architecture is often characterized by elegant, lofty proportions, movement toward a sense of greater void than solid, and symmetry in design, which often was not carried out in execution as designs were often altered or left unfinished. In ecclesiastical architecture, designs typically include twin towers on the western facade, shortened transepts, three- or four-story elevations, flying buttresses, central rose windows, and extensive campaigns of ever more sophisticated sculpture and stained glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Gothic"@en .

aat:300020783 a skos:Concept ;
    skos:definition "Refers to the last years of the Gothic period and style in architecture and other arts in Europe, beginning in the late 13th century. The style is marked by ever greater regional differences that often include a tendency toward extreme complexity, effects of surprise and fantasy, ambitious play of light and shade, and overwhelming richness of linear forms. For individual regional styles, see <Medieval regional styles>."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Gothic"@en .

aat:300020786 a skos:Concept ;
    skos:definition "Refers to the style that developed in the French and Burgundian courts in the mid-14th century and spread widely over western Europe by about 1425. The style is primarily manifested in non-monumental art, including panel paintings, miniatures, illuminated manuscripts, enamels, embroideries, and stained glass. The style is characterized by fluid elegance, curvilinear refinement, a supple, elongated human form, playfulness, and a new interest in secular themes. Some scholars object to use of the term, feeling it is too all-encompassing and therefore meaningless or even derogatory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "International Gothic"@en .

aat:300020787 a skos:Concept ;
    skos:definition "Refers to the style and period generally evident beginning in the mid-12th century in Italy and elsewhere in western Europe. The period overlaps with the Late Medieval period, and is heralded in Italy by the evolution of the city-state and consequent rise in status and individualism of the artist/craftsman. The style in sculpture and painting differs from earlier styles in a renewed appreciation of the art of Classical Greece and Rome, evident in more three-dimensional, naturalistic figures, and compositions influenced by those of Roman sarcophogi and other ancient art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Renaissance"@en .

aat:300020794 a skos:Concept ;
    skos:definition "Styles belonging to British Isles Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Isles Medieval styles"@en .

aat:300020795 a skos:Concept ;
    skos:definition "Architecture styles belonging to British Isles Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Isles Medieval architecture styles"@en .

aat:300020796 a skos:Concept ;
    skos:definition "Refers to the beginnings of Gothic architectural style in England, as coined by English architect and antiquarian, Thomas Rickman, in the early 19th century. It originally referred primarily to window tracery, but now is applied more generally to the broader style. The style is evident in the late 12th century, and is characterized by the use of the pointed arch, long narrow windows without mullions, a rectangular plan, and a long, low silhouette broken only by numerous gables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early English"@en .

aat:300020799 a skos:Concept ;
    skos:definition "Refers to the style that marks the traditioinal beginning of Gothic style in England around 1290, when Edward I erected a number of crosses, with distinctive ornamentation and architectural elements, to commemorate the queen, Eleanor of Castille. The term was coined in the early 19th century and then referred primarily to window tracery, but is now understood to apply to the style more broadly. The style has its roots in the royal London style and French Rayonnant Gothic, and is characterized by immense glazed surfaces, rectilinear apses, thick walls instead of the Continental buttressing system, and intricate decoration composed of lively geometric and organic forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Decorated Style"@en .

aat:300020801 a skos:Concept ;
    skos:definition "Refers to the later phase of the Decorated Style after around 1300, when window tracery moved from geometrical patterns to instead favor undulating curves and forms resembling raindrops and tongues of flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Curvilinear Decorated"@en .

aat:300020802 a skos:Concept ;
    skos:definition "Refers to the earlier phase of the decorated style in the late 13th century, when window tracery was composed of geometrical patterns such as circles, arcs of circles, and cusps, but before the patterns evolved into undulating curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Decorated"@en .

aat:300020803 a skos:Concept ;
    skos:definition "Refers to the last phase of Gothic architectural style in England, as coined by English architect and antiquarian, Thomas Rickman, in the early 19th century. The term originally referred primarily to window tracery from the late 14th century, but now is applied more generally to the broader style and to a wider time frame, roughly from 1330 to the 17th century. The style is characterized by density of pattern, the fan vault, the loss of bulky convex pier profiles to favor elements composed of a network of elegant, flat lines, the use of vertical mullions and regular horizontal divisions in window tracery, these same designs continued into the adjoining masonry, and the general effect in interior spaces of a delicate cage lodged inside a sturdy framework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Perpendicular Style"@en .

aat:300020835 a skos:Concept ;
    skos:definition "Refers to the style and culture evident in areas held by Burgundian rulers of Flanders, particularly during the 14th and 15th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Franco-Flemish"@en .

aat:300020847 a skos:Concept ;
    skos:definition "Culture and style of the Germanic Scandinavian people whose original homeland lay on the southern shores of the Baltic Sea. About the 1st century CE they moved into the lower valley of the Vistula River, but, unable to defend themselves there against the Gepidae, they migrated westward to the borders of the Roman Empire; they established a powerful kingdom extending to the Rhine river in the 4th-5th centuries CE. For the later dutchy and county of Burgundy, use \"Burgundian (medieval).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burgundian"@en .

aat:300020851 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the Normans, who were Norsemen from Denmark, Norway, and Iceland who raided the European coasts in the eighth and ninth centuries CE, settled in northern France in the early tenth century, reigned over the indigenous Frankish population, adopted their language, and eventually founded the duchy of Normandy. From Normandy, the Normans expanded to the British Isles, southern Italy, and Sicily. The style is particularly evident in designs of weapons and armor, the motte-and-bailey castle, and grand Romanesque ecclesiastical and monastic structures. The style is characterized by the brilliant adaptation and exploitation of indigenous local styles combined with some influences of the Byzantine east, which were introduced to the area by Norman adventurers and pilgrims."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norman"@en .

aat:300020854 a skos:Concept ;
    skos:definition "Styles belonging to French Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Medieval styles"@en .

aat:300020855 a skos:Concept ;
    skos:definition "Refers to a distinctive style of architecture that developed in the mid-13th century under the Plantagenet English kings' rule in the Loire Valley. The style is notable for remaining outside the mainstream of French stylistic development. It is characterized by some retention of the earlier local Romanesque idioms, evident in ecclesiastical buildings by the extremely curved, dome-shaped cross-ribbed vaults, numerous round arches, powerful, though slender, piers, and often the incorporation of three naves of approximately equal height and width."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angevin Gothic"@en .

aat:300020859 a skos:Concept ;
    skos:definition "Refers to the middle phase of French Gothic architecture that flourished during the late 13th through 14th centuries, as described by antiquarian Arcisse de Caumont (1802-1873). The style developed in Paris with the works of Pierre de Montreuil (ca. 1200-1266) and spread throughout the French royal domain and onward to Flanders, Germany, and England. It is characterized by the evolution from previous styles to emphasize a lightening of forms, greater emphasis on decoration, and a move away from the simple window lancets to tracery that expanded beyond windows and was composed of numerous mullions, combined with elaborate geometrical patterns made up of circles and arcs of circles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rayonnant"@en .

aat:300020862 a skos:Concept ;
    skos:definition "Refers to the last phase of French Gothic architecture, from about 1370 to the 16th century, as described by antiquarian Arcisse de Caumont (1802-1873). The style is characterized by an intensification and evolution of trends in advanced Rayonnant, including the use of leaner, lighter, frailer structures, the abolition of capitals, the addition of subsidiary ribs to form star-like patterns in the vaults, wider arcades with occasionally flattened curves, tracery in which reverse curves are opposed to create a flame-like shape, and pattern that is applied more extensively to the exterior of the structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flamboyant"@en .

aat:300020886 a skos:Concept ;
    skos:definition "Styles belonging to German Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German Medieval styles"@en .

aat:300020887 a skos:Concept ;
    skos:definition "Refers to the style in architecture and ornament that developed on the north German plain and Baltic coastal cities, primarily during the 13th through the 16th centuries. The style is characterized by the use of brick, exterior constructional polychromy, colorful interior finishes, and Rhenish tracery patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Backsteingotik"@en .

aat:300020889 a skos:Concept ;
    skos:definition "Refers to late Gothic German architecture and art, from the mid-14th century through the mid-16th century. The term means \"special gothic\" and is used infrequently by modern scholars, though it was formerly popular, having been first used by German art historians in the early 20th century to describe what they saw as the \"irrational\" character of German Gothic style. The style differs from the French style of Gothic in its extensive use of the hall church rather than the basilica, and in its unified interior as opposed to clearly defined spatial units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sondergotik"@en .

aat:300020929 a skos:Concept ;
    skos:definition "Refers in general to cultures that have occupied the same area as the modern nation of the Netherlands in northwestern Europe along the North Sea, as well as the territory extending through medieval Flanders, which is the area of modern Belgium and part of France. For the culture of the modern nation of the Netherlands, prefer \"Dutch (culture),\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Netherlandish"@en .

aat:300020934 a skos:Concept ;
    skos:definition "Styles belonging to Portuguese Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portuguese Medieval styles"@en .

aat:300020935 a skos:Concept ;
    skos:definition "Refers to the style of art and architecture that flourished in Portugal and her colonies, beginning in the late 14th century and lasting into the mid-16th century. The style is named afer Manuel I, King of Portugal (ruled 1495-1521), and it developed as a national style and conscious rejection of Spanish style. The style is characterized by the merging of Late Gothic style with inventive references to Portuguese voyages, particularly in symbolism and lavish ornament. New themes include lush foliate and nautical designs, and references to the exotic, including Islamic art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manueline"@en .

aat:300020936 a skos:Concept ;
    skos:definition "Styles belonging to Scandinavian Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scandinavian Medieval styles"@en .

aat:300020939 a skos:Concept ;
    skos:definition "Refers to a style that developed beginning in the second quarter of the 11th century in Scandinavia and Scandinavian settlements in Ireland and England. The style is named after carvings on the stave church at Urnes, Norway, and is characterized by the use of transformed Ringerike-style motifs and new elements. Compositions are more unified than Ringerike, and typically include extremely stylized animals, with larger animals displaying a distinctive swelling and tapering of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urnes Style"@en .

aat:300020940 a skos:Concept ;
    skos:definition "Styles belonging to Spanish Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Medieval styles"@en .

aat:300020944 a skos:Concept ;
    skos:definition "Refers to the style of architecture and decorative arts that developed in Spain and Portugal during the period when the Moors gradually lost control of the Iberian peninsula, roughly during the 12th to 15th centuries. The term is derived from the Arabic word for vassal and was originally applied to the work executed by Moslem craftsmen working for Christian masters in brick, plaster, wood, and tile work, though it is now applied to all later Medieval Spanish work in the Islamic tradition, and includes bookbinding, textiles, ceramics, ivory, furniture, and wood and metal inlay work. The style is characterized by Muslim forms and motifs such as arabesques, Kufic inscriptions, stalactite work, azulejo, and horseshoe arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mudéjar"@en .

aat:300020978 a skos:Concept ;
    skos:definition "Refers to a style of art, particularly manuscript illumination, that developed in the early ninth century in the scriptoria of the powerful archbishop, Ebbo of Reims, and was greatly influenced by his tastes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reims Style"@en .

aat:300021004 a skos:Concept ;
    skos:definition "Regional styles belonging to Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medieval regional styles"@en .

aat:300021006 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the Norman Conquest of Britain in 1066 and the spread of the Old French Anglo-Norman dialect and Norman tastes through the English, Welsh, and Irish aristocracy. The period produced a large body of Anglo-Norman literature and an artistic style characterized in sculpture, painting, illumination, and textiles by elegance and refinement, and in architecture by grand scale, ribbed vaults covering huge spaces through a double-X design, sturdiness, dramatic lighting, and ornamentation that included chevrons, diaper pattern, and billet-molding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Norman"@en .

aat:300021010 a skos:Concept ;
    skos:definition "Refers to the style of Viking art that is best known from the tenth-century royal Danish monuments and other artifacts at Jelling. It overlaps with Borre and Mammen styles. The style is seen in portable objects and pictorial stone carvings and is characterized by the use of ribbon- and S-shaped animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jellinge Style"@en .

aat:300021011 a skos:Concept ;
    skos:definition "Refers to the style of art that flourished in the second half of the tenth century in Scandinavia and at Scandinavian settlements elsewhere in Europe. The style is named after an inlaid axe head found in Mammen, Denmark. The style is characterized by the use of particular motifs based on west European prototypes, which are altered to suit Scandinavian tastes. The style continues to use the earlier Scandinavian snake motif, and introduces semi-naturalistic animals, including lions and birds, the plant scroll, wavy outlines, and compositions that typically include asymmetrical scrolls and one or two large motifs that fill a panel with abrupt twists and turns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mammen Style"@en .

aat:300021012 a skos:Concept ;
    skos:definition "Refers to a style of Scandinavian art dating from the 11th century. The term is derived from the geological name for the sandstone beds around Oslo, Norway, which were apparently the source of stone for many carvings in this style, though the stone was often carved elsewhere. The style probably developed in Danish centers and spread broadly in Scandinavia, England, and Ireland. The style continues to employ the earlier Mammen animal motifs, with innovations influenced by Anglo-Saxon and Ottonian ornament. The style is often characterized by plant motifs with stems arranged in strict axiality and intertwining tendrils, and by compositional schemes that are asymmetrical and have an additive character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ringerike Style"@en .

aat:300021013 a skos:Concept ;
    skos:definition "Refers to a distinctive style that developed in Flanders and northern France, beginning in the late tenth century and lasting through the 12th century. The style is seen in manuscript illumination, wall painting, and other art, and is formed by the merging of styles on the continent with Anglo-Saxon styles from across the Channel in England. The style is characterized by dynamic evolution and differs from surrounding regional styles in its more intimate scale, linear vitality, fluid patterns of curves, dancing buoyancy of figures, and illusionism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Channel Style"@en .

aat:300021014 a skos:Concept ;
    skos:definition "Refers to the style of architecture and decorative arts on the Iberian peninsula under Muslim rule, roughly between the eighth and the 15th centuries. The style is characterized by Islamic forms and motifs such as Kufic inscriptions, animal motifs, and scrolling acacia leaves. The term is sometimes used to refer specifically to Spanish pottery, tiles, and other ceramics produced during this period, particularly those with luster pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hispano-Moresque"@en .

aat:300021016 a skos:Concept ;
    skos:definition "Refers generally to the style of art, architecture, and material culture created by the Islamic North Africans, including the colonizers of the Iberian Peninsula and their descendants of North African and mixed North African and Iberian lineage. The style predominated approximately from the eighth to the 15th century in Spain and the region of Mauretania in North Africa (now comprised of Morocco and part of Algeria), though it persisted in a smaller way after that and elements are still used today. For the style created and used by the people of the modern West African nation, the Islamic Republic of Mauritania, see \"Maure\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moorish"@en .

aat:300021017 a skos:Concept ;
    skos:definition "Refers to the style of artistic production produced by Spanish Christians under Muslim rule from the ninth to the 11th centuries. The style migrated north and is seen in church and monastic architecture, manuscript illumniation, sculpture, and ivory carving, and is characterized by a joining of traditional Spanish folk culture and Moorish forms and motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mozarabic"@en .

aat:300021018 a skos:Concept ;
    skos:definition "Refers to the style that developed in the British Isles after the relaxation of imperial Roman authority, generally from the fifth century CE. The style is seen in sculpture, metalwork, and other arts, notably in ornamental manuscript illumination that developed in monastic centers in relatively inaccessible sites. The style continued until the 13th century, and also influenced styles on continental Europe. For the scripts developed in this period, see \"Insular scripts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Insular"@en .

aat:300021024 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the conquest of much of the British Isles by Germanic Saxons and Angles from Schleswig and the Baltic coast, beginning with the successive invasions of the fifth and sixth centuries CE and continuing after their conversion to Christianity. The style is characterized by a merging of the migrants' culture with existing Celtic traditions, and is later combined with classicizing influences from continental Europe. The elements derived from Angle and Saxon traditional metalwork and often applied to other media include symmetrical, interlaced, abstract patterns, stylized, interlocked animals, garnet incrustations, jewels, and filigree. These are combined with Celtic checkerboard patterns of millefiore enamel and other motifs developed in Celtic monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Saxon"@en .

aat:300021025 a skos:Concept ;
    skos:definition "Refers to the highly individualized style that developed in Ireland beginning in the seventh century, particularly in the monastic communities. The style is especially evident in manuscript illuminations and sculpture, and apparently developed from the melding of Germanic Anglo-Saxon, Celtic, and Early Christian art. It is characterized by brilliant colors and opulent ornamentation composed of extremely intricate, interlaced lines, abstract shapes, animals, and flat, stylized human forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hiberno-Saxon"@en .

aat:300021033 a skos:Concept ;
    skos:definition "Styles belonging to Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance-Baroque styles"@en .

aat:300021034 a skos:Concept ;
    skos:definition "Styles belonging to British Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Renaissance-Baroque styles"@en .

aat:300021035 a skos:Concept ;
    skos:definition "Period, culture, and English style in architecture and decorative arts during the reign of Tudor monarchs from 1485 to 1603. Influenced by Flemish Mannerism, architectural motifs and forms include ornamental brickwork, gables, and finials while decorative arts feature ornate silverware and richly carved woodwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tudor"@en .

aat:300021036 a skos:Concept ;
    skos:definition "Period, culture, and English style of architecture and decorative arts produced during the reign of Elizabeth I between 1551 and 1603. A combination of Gothic, Italian Renaissance, Flemish and French Mannerist, and vernacular styles, it is characterized by elaborate architectural silhouettes, elements suchs as finials, pendants, and strapwork and in decorative arts, rich surface ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elizabethan"@en .

aat:300021037 a skos:Concept ;
    skos:definition "Period, culture, and British style under the Stuarts, a Scottish and English dynasty of rulers, patrons, and collectors. It particularly refers to the elegant court styles created in the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stuart"@en .

aat:300021046 a skos:Concept ;
    skos:definition "Period, culture, and English style in architecture and decorative arts during the reign of William III and Mary II between 1688 and 1702. Viewed as a transitional period between the Restoration and reign of Queen Anne, Restoration forms and motifs continue but become light and more elegant under French influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "William and Mary"@en .

aat:300021047 a skos:Concept ;
    skos:definition "Period, culture, and English style in architecture and decorative arts during the reign of Queen Anne from 1702 to 1714 and known for its straightforward simplicity. In architecture it is characterized by red brick, sash windows, and hipped roofs, applied largely to domestic structures. Decorative arts reflect a move toward simple ornamentation with the use of plain veneers, ball and claw feet, cabriole legs, and scallop shell motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Queen Anne"@en .

aat:300021048 a skos:Concept ;
    skos:definition "Refers to the style in architecture, interior design, and decorative arts in Britain and Ireland and spread to the United States during the reigns of George I to George IV, between 1714 and 1830. Some authors omit the reign of George IV and refer to the period ca.1790 to 1830 as Regency. Though Classical forms and motifs dominate, the style encompasses Renaissance and Rococo forms as well as a range of Neoclassical styles such as Pompeiian Revival and Etruscan style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Georgian"@en .

aat:300021051 a skos:Concept ;
    skos:definition "Styles belonging to Netherlandish Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Netherlandish Renaissance-Baroque styles"@en .

aat:300021070 a skos:Concept ;
    skos:definition "Styles belonging to French Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Renaissance-Baroque styles"@en .

aat:300021072 a skos:Concept ;
    skos:definition "Refers to the French style of architecture and sculpture during the reign of François I from 1515 to 1547. A combination of the Gothic and Renaissance styles and, according to some authors, the Mannerist style, it is associated with the Loire valley chateaux of François I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "François I"@en .

aat:300021078 a skos:Concept ;
    skos:definition "Refers to the style of French architecture during the reign of Louis XIII from 1610 to 1643 characterized by Renaissance forms and motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Louis XIII"@en .

aat:300021080 a skos:Concept ;
    skos:definition "Refers to the style of architecture and decorative arts during the reign of Louis XIV from 1643 to 1715. Luxurious yet formal and reflecting Classical and Baroque forms and motifs, the style is associated with the King's patronage and with the furniture, tapestries, and decoration created for his palace at Versailles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Louis XIV"@en .

aat:300021085 a skos:Concept ;
    skos:definition "Refers to the style of French interior design and decorative arts between circa 1700 and 1750 during the regency and reign of Louis XV. Essentially Rococo in style, it is characterized by light and fanciful forms, asymmetry, and femininity identified with the Marquise de Pompadour and her circle at court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Louis XV"@en .

aat:300021089 a skos:Concept ;
    skos:definition "Refers to the French style of architecture and decorative arts between approximately 1710 and 1730 and including the period between 1715 and 1723 when Philippe II, Duc d'Orléans served as regent to Louis XV. Considered an early phase of Rococo, it is characterized by the introduction of more frivolous subject matter and ornament such as chinoiserie, grotesques, and fête galantes which gradually superceded the heavier Classical forms associated with the Baroque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Régence"@en .

aat:300021091 a skos:Concept ;
    skos:definition "Refers to the style of carpets and tapestries produced at the Aubusson factory in France. Most identified with products made beginning in the mid-18th century, the style is characterized by smooth-faced weaving, soft feminine colors, symmetrical designs, and pastoral themes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aubusson"@en .

aat:300021095 a skos:Concept ;
    skos:definition "Refers to the style of French tapestries, ceramics, pietra dura, and other decorative arts produced at Gobelins manufactory. It is best identified with works produced between the late 17th century and the late 18th century. In tapestries, the style is characterized by Classical Baroque and Rococo designs rendered with details that simulate the effects of oil painting. In ceramics and other arts, it is characterized by sumptuous materials and detail that were in favor at the French court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gobelins"@en .

aat:300021096 a skos:Concept ;
    skos:definition "Styles belonging to German Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German Renaissance-Baroque styles"@en .

aat:300021103 a skos:Concept ;
    skos:definition "Styles belonging to Italian Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian Renaissance-Baroque styles"@en .

aat:300021105 a skos:Concept ;
    skos:definition "Refers to the style of 18th-century Italian architecture and sculpture associated with the Rococo and characterized as lighthearted, imaginative, elegant and decorative. Sculpture features dramatic gestures, open poses, and sweeping drapery as with the work of Camillo Rusconi, whose sculptural compositions portray an unorthodox sense of playfulness and intimacy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barocchetto"@en .

aat:300021114 a skos:Concept ;
    skos:definition "Ceramics styles belonging to Italian Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian Renaissance-Baroque ceramics styles"@en .

aat:300021115 a skos:Concept ;
    skos:definition "Refers to a distinctive style of early Medieval glazed pottery produced in the Roman Campagna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Forum"@en .

aat:300021127 a skos:Concept ;
    skos:definition "Styles belonging to Spanish Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Renaissance-Baroque styles"@en .

aat:300021131 a skos:Concept ;
    skos:definition "Refers to a style in Spanish and Spanish Colonial architecture and ornament in the 15th and 16th centuries. The term was first used by Diego Ortiz de Zúñiga in 1677 to describe a facade. It means \"silversmith-like\" and is characterized by richly ornamented surfaces, as were common in a silversmith's intricate work. The style is derived from Late Gothic, Islamic, and Italian Renaissance art. In architecture the style is typically seen in smaller buildings and is characterized by twisted columns, heraldic escutcheons, sinuous scrolls, and florid, jewelry-like ornament that masks the structure beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plateresque"@en .

aat:300021133 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in Spain and its colonies during the reign of Isabella I, from about 1480 to about 1510. Influenced by the presence of northern European craftsmen and architects, the style reflects a combination of Gothic and Mudéjar forms and motifs. In architecture buildings are elaborately decorated and are characterized by rich carving, star vaults, coats of arms, stalactite cornices, and cimborio. The same term is used in the field of Spanish historiography to refer to the reign of Isabella II (1833-1868), though this usage is not applied to art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isabelline"@en .

aat:300021135 a skos:Concept ;
    skos:definition "Refers to a style that developed in the second half of the 16th century in Spain and its colonies, and lasted through the 17th century. The influence of the style can be seen in other visual arts, though it is primarily evident in architecture, and is named after the architect Juan de Herrera. The style is characterized by the abandonment of the exuberance and decorative detail of the Plateresque and succeeding Classicizing movements to favor instead a more majestic, austere style that reflected the melancholic and religiously intense tastes of Philip II, which are combined with elements of Italian Mannerism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Herreran"@en .

aat:300021136 a skos:Concept ;
    skos:definition "Refers to the second distinct phase of Spanish Plateresque style, evident in the first half of the 16th century. It differs from First Plateresque in its wider geographic scope and in the use of Italian Renaissance decorative motifs and constructional principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Second Plateresque"@en .

aat:300021140 a skos:Concept ;
    skos:definition "Refers to the intellectual movement, style, and culture that originated in Italy in the late 14th century, spread throughout Europe, and culminated in the 16th century. Style is characterized by a deliberate reference to the art, architecture, literature, and ideals of Classical Rome and Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance"@en .

aat:300021141 a skos:Concept ;
    skos:definition "Refers to the early period of the Renaissance, when the style developed in Central Italy in the mid- to late fourteenth century and spread throughout the peninsula and to northern Europe in the early to mid-15th century. The style moved away from the fantastic, decorative styles of the Medieval period to place new emphasis on the idealized naturalistic world portrayed in the art, architecture, and literature of Classical Greece and Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Renaissance"@en .

aat:300021142 a skos:Concept ;
    skos:definition "Refers to a period and style that developed primarily in the last decade of the fifteenth century in Florence and Rome, spreading elsewhere in Italy and to northern Europe. It is generally considered to end with the development of Mannerism in the 1520s. The style evolved from the Early Renaissance and is characterized by a new vision of human grandeur, heroic action, compositional order, symmetry, balance, and harmony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Renaissance"@en .

aat:300021143 a skos:Concept ;
    skos:definition "Refers to a period and style of the middle and later decades of the 16th century in Italy and northern Europe. The style is characterized by an evolution from the calm, serene High Renaissance to more emotional, active, asymmetrical compositions with more innovative applications of colors, materials, and techniques. Many works of this period can also be associated with Mannerism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Renaissance"@en .

aat:300021144 a skos:Concept ;
    skos:definition "Refers to a style and a period in evidence approximately from the 1520s to 1590, developing chiefly in Rome and spreading elsewhere in Europe. The style is characterized by a distancing from the Classical ideal of the Renaissance to create a sense of fantasy, experimentation with color and materials, and a new human form of elongated, pallid, exaggerated elegance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mannerist"@en .

aat:300021147 a skos:Concept ;
    skos:definition "Refers to the style and period of architecture, visual art, decorative art, music, and literature of western Europe and the Americas from about 1590 to 1750. The style is characterized by balance and wholeness, often with an emphasis on spectacle and emotional content, and a tendency toward contrasts of light against dark, mass against void, and the use of strong diagonals and curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baroque"@en .

aat:300021149 a skos:Concept ;
    skos:definition "Refers generally to the beginning of the Baroque style and period, particularly the Italian Baroque from about 1585 to 1625."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Baroque"@en .

aat:300021150 a skos:Concept ;
    skos:definition "Refers generally to the fully developed Baroque style, particularly the Italian art and architecture that emerged in Rome around 1625 and lasted for half a century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Baroque"@en .

aat:300021151 a skos:Concept ;
    skos:definition "Refers generally to the final years of the Baroque style, from approximately 1675 to 1715.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Baroque"@en .

aat:300021155 a skos:Concept ;
    skos:definition "Refers to that period primarily of decorative art that emerged in France ca. 1700 at the court of Louis XV, and dominated Europe until it was superseded by the Classical Revival in the late 18th century. The style is characterized by opulence, asymmetry, grace, gaiety, and a light palette of colors, in contrast to the heavier forms and darker colors of the Baroque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rococo"@en .

aat:300021158 a skos:Concept ;
    skos:definition "Architecture styles belonging to Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance-Baroque architecture styles"@en .

aat:300021160 a skos:Concept ;
    skos:definition "Refers to the style of architecture in the English Midlands characterized by elaborate half-timbering in which the timber is stained black and arranged in geometrical patterns and the plaster in between is painted white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black and White Style"@en .

aat:300021161 a skos:Concept ;
    skos:definition "Includes works influenced by the architectural style of Andrea Palladio; excludes works by Palladio himself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palladian"@en .

aat:300021164 a skos:Concept ;
    skos:definition "Decorative arts styles belonging to Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance-Baroque decorative arts styles"@en .

aat:300021165 a skos:Concept ;
    skos:definition "Refers to a style that employs a particular type of ornament and was popular in 17th-century Europe. It is characterized by lobate scrolls, embossed relief work, and plastic, curvilinear, rippling forms that can resemble a human ear, to which the name refers. It developed in Utrecht, the Netherlands, in the early 17th century. The style may be seen in various art forms, but was most often used in metalwork. The style is derived from 16th-century graphic works of the Italian Mannerists, although the Dutch goldsmiths Adam and Paulus van Vianen are often credited with its invention."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Auricular"@en .

aat:300021167 a skos:Concept ;
    skos:definition "European and American decorative arts and architectural style that reflects fanciful and poetic notions of China influenced by travelers' tales and exports of Asian ceramics, textiles, and art objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinoiserie"@en .

aat:300021169 a skos:Concept ;
    skos:definition "Refers to the style of pottery made by peasants in Hungary and Moravia (Czech Republic) from the late 16th through the 17th centuries. It features vigorous and stylized flowers, animals, and figures applied to characteristically globular short-neck jugs and plates with a wide flat ledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Habaner"@en .

aat:300021170 a skos:Concept ;
    skos:definition "Fine tin-glazed earthenware produced in Italy. The term originally referred to the island of Majorca (or an alternate theory has it referring to Malaga), and designated only Hispano-Moresque lusterware; but since the 16th century it has been used to refer to Italian tin-glazed ware and imitations of the Italian ware. It is characterized by painted decoration of high quality executed in several colors on the dry but unfired tin glaze, generally with a final coating of clear lead glaze. The range of colors is typically limited to cobalt blue, copper green, manganese purple, antimony yellow, and iron red, with white provided by the tin-glaze material. When white is used for painting, it is applied onto a bluish-white glaze or blue ground. The luster is typically a golden color derived from silver or a mother-of-pearl effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maiolica"@en .

aat:300021172 a skos:Concept ;
    skos:definition "Refers to the style of French pottery made by Bernard Palissy beginning in the 16th century, imitated until the 19th century, and decorated with reptiles or mollusks rendered in relief and in muted, accurate colored glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palissy"@en .

aat:300021173 a skos:Concept ;
    skos:definition "16th- and 17th-century stoneware, particularly jugs, featuring mottled brown glaze over a greyish body that was imported into England from the Rhenish potteries, particularly those of Cologne. Tiger ware jugs were often mounted with silver in the form of neckband and lid, foot, and handle mounts. The term is also applied to English imitations such as those made by John Dwight of Fulham who founded a factory for this purpose at the end of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiger ware"@en .

aat:300021177 a skos:Concept ;
    skos:definition "Austrian variation of Art Nouveau, derived from architect Joseph Olbrich's exhibition hall for the Wiener Sezession. Associated mainly with architects and designers, the style reflects less the serpentine line and organic forms of the Art Nouveau and shows a more geometric quality influenced by the work of Charles Rennie Mackintosh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sezessionstil"@en .

aat:300021193 a skos:Concept ;
    skos:definition "Modern revival styles belonging to British cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern British revival styles"@en .

aat:300021194 a skos:Concept ;
    skos:definition "Refers to the English style of architecture, interior design, and decorative arts from the 1830s to the 1860s, drawn from the Elizabethan period of the sixteenth century. Architects adopted a range of Elizabethan architectural forms including gables, octogonal turrets and lead-paned windows, while designers applied cinquefoils, strapwork, and coats of arms to furniture, silver, and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elizabethan Revival"@en .

aat:300021195 a skos:Concept ;
    skos:definition "Refers to the late nineteenth and early twentieth century English style of architecture, furniture, and decorative arts that revived the architectural forms and decorative motifs of the Georgian period from 1714 to 1830. Georgian Revival architecture, like its model, features symmetrical brick facades, pitched roofs, sashes, and fanlights, while furniture design draws from the styles of Adam, Hepplewhite, Sheraton, and Chippendale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Georgian Revival"@en .

aat:300021196 a skos:Concept ;
    skos:definition "Refers to the style of British architecture, furniture, and decorative arts during the nineteenth and early twentieth centuries that revived forms from the Jacobean period of the 17th century. Featuring curved gables, elaborate brick chimneys, and mullioned and transomed windows, Jacobean Revival architecture and decorative motifs were also mixed with Elizabethan Revival and Queen Anne styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jacobean Revival"@en .

aat:300021197 a skos:Concept ;
    skos:definition "Refers to the style of domestic architecture but also of furniture in England and the United States in the late 19th century. Drawn from the architecture of Queen Anne's reign (1702-1714) and mixed with features found in 17th century Dutch architecture, buildings are characterized by asymmetrical or irregular plans, the use of red brick and stone dressing, broken pediments, sash windows, and shaped gables while furniture features cabriole legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Queen Anne Style"@en .

aat:300021198 a skos:Concept ;
    skos:definition "Revival style found in the United States in the 1930s, that employees elements of Georgian and Regency style prototypes, usually resulting in buildings two stories high with a hipped roof, and brick walls with quoins at the corners and sometimes at the main entrance. Its also often features double-hung windows with shutters; an entrance porch, and a small octagonal window above the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Regency Revival"@en .

aat:300021199 a skos:Concept ;
    skos:definition "Refers to the style of English architecture and interior design in the first half of the 19th century and again in the early 20th. Drawn from domestic architecture of the Tudor period dating 1485-1547, architectural forms and decorative motifs include diapered brickwork, half-timbering, stained glass, and Tudor roses, which were often combined with Gothic elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tudor Revival"@en .

aat:300021201 a skos:Concept ;
    skos:definition "Refers to the style identified with Scottish-born architect Robert Adam (1728-1792), prevalent in Great Britain from 1760-1790. Inspired by archaeological discoveries in Herculaneum and Pompeii, the Adam style is characterized by austere but refined Classical forms, symmetry, detail, and geometric precision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adam Style"@en .

aat:300021211 a skos:Concept ;
    skos:definition "Refers to a Scottish architectural style in the mid-nineteenth century that revived forms associated with the traditional Scottish tower house such as machicolations, conical roofs, turrets, bartisans, and battlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scottish Baronial"@en .

aat:300021212 a skos:Concept ;
    skos:definition "Refers to the style of English domestic architecture in the second half of the nineteenth century and characterized by the use of traditional English materials and forms such as mullioned windows, half-timbered walls, pitched roofs, and tall ornamental chimneys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old English"@en .

aat:300021214 a skos:Concept ;
    skos:definition "Refers to English furniture produced in 1750s and 1760s based on the designs of cabinetmaker Thomas Chippendale (1718-1779), characterized by openwork and ornamental carving in a mainly Rococo Style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chippendale"@en .

aat:300021215 a skos:Concept ;
    skos:definition "Refers to English Chinoiserie furniture following the types of design published by cabinet maker Thomas Chippendale in \"The Gentleman and Cabinet Maker's Director\" in 1754. Applied mostly to small cabinets and chairs, the style is characterized by lattice-work and square and angular forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese Chippendale"@en .

aat:300021219 a skos:Concept ;
    skos:definition "Refers to English and American furniture following the designs of English cabinetmaker and designer George Hepplewhite published posthumously in 1788. Typical of the Neoclassical style of the last quarter of the 18th century, the style is characterized by shield-back chairs, bow-fronted chests of drawers, Marlboro legs and decorative motifs including Prince of Wales feathers, ears of wheat, urns, and rosettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hepplewhite"@en .

aat:300021220 a skos:Concept ;
    skos:definition "Describes satinwood, mahogany, and painted furniture in England and the United States from 1790 to 1805 and based on designs published by English cabinetmaker Thomas Sheraton (1751-1806). Sheraton's three influential books progress in style from Neoclassical to Empire though now his name is used to describe the general taste in furniture at the end of the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sheraton"@en .

aat:300021223 a skos:Concept ;
    skos:definition "Refers to the movement in British sculpture ca. 1870/1920 that aimed to revive the quality of British sculpture. Viewed as a departure from the conservativism and blandness of Neoclassicism, the style is characterized by greater realism, a tendency toward symbolism and fantasy, the use of non-Classical themes, and the use of materials other than marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Sculpture Movement"@en .

aat:300021225 a skos:Concept ;
    skos:definition "Refers to the style in fine arts originating from the Pre-Raphaelite Brotherhood, a group of English artists active from 1848 to 1853. Inspired by Italian art prior to Raphael, the style is characterized by Romantic and Medieval themes with moral undertones, bright colors, and close-knit, detailed compositions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Raphaelite"@en .

aat:300021226 a skos:Concept ;
    skos:definition "Modern ceramics styles belonging to British cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern British ceramics styles"@en .

aat:300021231 a skos:Concept ;
    skos:definition "Refers to the style of architecture and decorative arts produced in England during the regency of George, Prince of Wales from 1811 to 1820 and then including the period of his reign as George IV from 1820 to 1830. Varied in style, furniture and architecture reflect a combination of classical and French Empire styles with Egyptian and Orientalizing motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Regency"@en .

aat:300021232 a skos:Concept ;
    skos:definition "Refers to the style of artistic production produced in Great Britain and its colonies from 1837 to 1901 during the reign of Queen Victoria. Typically identified with heavy forms, bold patterns, elaborate ornamentation, and bright colors, the Victorian period encompasses a varied range of Classical and revival styles. However, Gothic forms and motifs that were identified as morally and aesthetically superior dominated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Victorian"@en .

aat:300021233 a skos:Concept ;
    skos:definition "Refers to the Victorian style between 1837 and about 1850. It is characterized by a progression from earlier Regency forms to revival styles, particularly the Gothic Revival, and a growing interest in ornamentation and heavy forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Victorian"@en .

aat:300021234 a skos:Concept ;
    skos:definition "Refers to the Victorian style, mainly in architecture and decorative arts, produced ca. 1850-ca. 1870. While the Gothic Revival still dominated European style, High Victorian architecture and decorative arts demonstrate a more eclectic use of Gothic forms and a greater interest in color, texture, and plastic effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Victorian"@en .

aat:300021235 a skos:Concept ;
    skos:definition "Refers to the Victorian style, mainly in architecture and decorative arts, produced from about 1870 to about 1901. While the Gothic Revival still dominated, architecture and decorative arts reflected a renewed interest in Classical, Baroque, and vernacular forms and encompassed new influences such as the Queen Anne and the Beaux Arts styles. In decorative arts, the influence of Japanese art objects, the Arts and Crafts movement, and the Aesthetic movement simplified the Victorian tendency toward heavy ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Victorian"@en .

aat:300021236 a skos:Concept ;
    skos:definition "Refers mainly to the style of architecture produced during the reign of Edward VII (1901-1910) though some authors date it from 1890, when the Gothic became less predominant and architectural style became more eclectic, to 1914 when building halted because of World War I. Often noted for its ebullience or opulent and monumental qualities, Edwardian architecture actually reflects the development of several architectural movements, namely the Baroque and Neoclassical Revivals, the Beaux-Arts Style, and the Arts and Crafts Movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edwardian"@en .

aat:300021257 a skos:Concept ;
    skos:definition "Artistic movement that flourished in Denmark beginning in the 1890s, as a self-styled reaction to what was perceived as pessimism and a world in decline. The movement was centered on the figure of Gunnar Sadolin; it was inspired by Nietzsche's writings, a cursory understanding of ancient Greek sources, and the aesthetics of the plien air school of French and Danish painting. The movement encompassed visual arts, as well as literary arts, performing arts, and music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hellenerne"@en .

aat:300021259 a skos:Concept ;
    skos:definition "Refers to the Dutch artistic movement and periodical of the same name, founded by Theo Van Doesenburg in 1917 and lasting until the early 1930s. The movement advocated the use of pure abstract form to express the universal in art. De Stijl theories formed the basis for the art style known as Neo-Plasticism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "De Stijl"@en .

aat:300021261 a skos:Concept ;
    skos:definition "Refers to the Dutch style that grew out of the theories of the De Stijl movement in the 1920s. Based on the restriction of the right angles and straight lines of Neo-Plasticism, it abandoned the horizontal-vertical relation to the picture plane and reintroduced diagonals to achieve more dynamic compositions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elementarist"@en .

aat:300021262 a skos:Concept ;
    skos:definition "Refers to the Dutch artistic style that grew out of the theories of the De Stijl movement and was named by Piet Mondrian in 1919. The style is characterized by a strict adherence to straight lines, right angles, and primary colors along with grey, black, and white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Plastic"@en .

aat:300021267 a skos:Concept ;
    skos:definition "Refers to the style of decorative arts and architecture during the Directoire period between 1795 and 1799. A severe and simplified form of Neoclassicism, the style includes Republican-inspired motifs such as clasped hands, fasces, Phrygian caps, and oak leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Directoire"@en .

aat:300021268 a skos:Concept ;
    skos:definition "Refers to the style of decorative arts from 1799 to 1805 during the First Consul of Napoleon. Though a continuation of Directoire Neoclassicism, the style is distinguished by heavier forms, the lavish use of drapery, and the introduction of Egyptian motifs inspired by Napoleon's military campaigns in Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Consulat"@en .

aat:300021269 a skos:Concept ;
    skos:definition "Refers to the style in decorative arts, interior design, architecture, and dress which spread from France to other parts of Europe and the United States during and following the period of Napoleon's French Empire from 1804 to 1814. As in the preceeding Directoire and Consulat periods, the style is characterized by heavy Neoclassical forms and the lavish use of drapery. However, it is distinguished by the use of Napoleanic motifs identified both with the Emperor's power and personal taste, such as the bee, the letter N, eagles, wreaths, and the swan of Empress Josephine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Empire"@en .

aat:300021271 a skos:Concept ;
    skos:definition "Refers to the style in decoration that emerged in the 1750s and dominated during the rule of Louis XVI from 1774 to 1792. Identified with goût grec, the style is characterized by its symmetrical and restrained application of swags, trophies, viturvian scrolls, and floral and ribbon motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Louis XVI"@en .

aat:300021276 a skos:Concept ;
    skos:definition "Refers to the style in decorative arts in France during the restoration of the Bourbons between 1815 and 1830. Mainly a continuation of the Empire style, it is distinguished by bright colors, heavier forms, the use of light-colored woods, and the growing presence of the Troubadour style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Restauration"@en .

aat:300021278 a skos:Concept ;
    skos:definition "Refers to the style of decorative arts and architecture produced in France during the reign of King Louis Philippe from 1830 to 1848 and characterized by the presence of several styles including the Empire, Troubadour, Renaissance, Gothic, and Rococo styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Louis Philippe"@en .

aat:300021279 a skos:Concept ;
    skos:definition "Refers to the architectural and decorative arts style in France between 1852 and 1870 during first the presidency and later the Empire of Napoleon III, but also affecting Europe and the United States. Noted for its eclecticism, opulence, and ostentation, the period reflects the revival of several historical styles including the Louis XVI, Gothic, Renaissance, and Baroque styles. In architecture, the style is identified more specifically with public and domestic buildings with mansard roofs, heraldic motifs, pedimented dormers, and French Renaissance detailing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Second Empire"@en .

aat:300021289 a skos:Concept ;
    skos:definition "Refers to the early phase of French Neoclassicism that dates from the mid 1750s to the late 1760s and that stood in contrast to the Rococo style. Though applied broadly to objects with vague classical motifs, it specifically refers to architecture and decorative arts characterized by rectilinear and chunky forms and the use of Viturvian scrolls, heavy festoons, urns, and the key pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goût grec"@en .

aat:300021291 a skos:Concept ;
    skos:definition "Refers to the style of architecture, decorative arts, and painting in France from the late 18th to the early 19th centuries. Similar to the Gothic Revival in England, the style reflects Gothic forms and ornamentation and a sentimental and historicizing interest in Medieval subjects, techniques, and dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troubadour"@en .

aat:300021295 a skos:Concept ;
    skos:definition "Refers to the style associated with a group of mid-nineteenth century French sculptors who produced small scale representations of domestic and wild animals. Drawing on a fascination with zoology and observations made at the Paris Jardin des Plantes, their work is know for its realism and the depiction of cruelty and power in the natural world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Animalier"@en .

aat:300021297 a skos:Concept ;
    skos:definition "Refers to a style of painting identified with a group of French artists in the 1880s and characterized by bright flat color, strong blue or black contour lines, and minimal modeling in the manner of cloisonné enamel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cloisonnist"@en .

aat:300021300 a skos:Concept ;
    skos:definition "Refers to a style in painting identified with a group of young French artists dating from around 1898 to 1906 and characterized by bold bright colors, surface texture, and spontaneous or unfinished looking compositions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fauve"@en .

aat:300021308 a skos:Concept ;
    skos:definition "Refers to the style of painting centered in Pont Aven between 1886 and 1890 whose proponents advocated the simplification of form and painting from memory in order to create meaning. Accordingly, the style is characterized by simple, strongly contoured forms, flat, unmodeled color, and the arrangement of color and forms into harmonious patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Synthetist"@en .

aat:300021313 a skos:Concept ;
    skos:definition "Refers to the German and Austrian variation of Art Nouveau, named after the magazine \"Jugend\" that had been published in Munich since 1896. The style differs from Belgian and French Art Nouveau by a more restrained use of decoration. Jugendstil replaced the exuberance and naturalism of other Art Nouveau styles with a comparatively subdued aesthetic that was often almost unrecognizably, or not at all derived from nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jugendstil"@en .

aat:300021329 a skos:Concept ;
    skos:definition "Refers to the style of architecture developed in Germany in the mid-19th century. Combining Italian, Early Christian, and Romanesque elements, the style is characterized by arcaded round arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rundbogenstil"@en .

aat:300021341 a skos:Concept ;
    skos:definition "Refers collectively to the styles respresented in an exhibition held in Munich in 1937 that were condemned by the National Socialist Party as morally and socially depraved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Entartete Kunst"@en .

aat:300021345 a skos:Concept ;
    skos:definition "Refers to the term used to describe the artistic activities of German artist Kurt Schwitters, who was influenced by the theories of Dada. Invented by chance when cutting out the word \"Commerzbank\" from a newspaper, the style is characterized by the production of collages made of discarded items such as tickets, stamps, and catalogues with the intention of freeing art from traditional materials and techniques and embracing urban civilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Merz"@en .

aat:300021362 a skos:Concept ;
    skos:definition "Refers to the style and movement that was an Italian interpretation of Art Nouveau architectural principles. It was centered in Italy and emerged in the early 20th century, promoted by The Prima Esposizione Internazionale d'Arte Decorativa. Prominent examples of the style include the Hotel Tre Croci (1912) and the Palazzo Beri-Meregalli in Milan (1911-1914). The name derives from the store \"Liberty and Co.\" in London."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stile Liberty"@en .

aat:300021368 a skos:Concept ;
    skos:definition "Refers to the style and movement in Italy associated with the stylistic principles of Cubist painter Umberto Boccioni that included a denunciation of historic precedent as a criterion for design and the emphasis on geometric forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stile Umberto"@en .

aat:300021374 a skos:Concept ;
    skos:definition "Refers to the literary and artistic movement centered in Italy that emphasized speed, dynamism, energy and a rejection of the past, which began with the writings of Filippo Tommaso Marinetti in 1909. Futurism also developed in Russia, with more revolutionary and political connotations. In painting, the style is charactersized by a reliance on divisionist techniques until 1912, when it adopted the simultaneous views and distorted planes of Cubism. Futurist ideas in architecture are represented by drawings and city plans of utopian societies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Futurist"@en .

aat:300021393 a skos:Concept ;
    skos:definition "Refers to the art and architectural style and movement concerned mainly with expression by means of constructions, noted as a particularly austere branch of abstract art. It was influenced by Cubism and Futurism and centered in Russia around 1913. The movement was announced in the publication of the Realist Manifesto in 1920, the name coming from one of its proclamations \"to construct\" art. The style is characterized by simple, precise abstract compositions typically of modern materials, such as steel, glass, and iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Constructivist"@en .

aat:300021394 a skos:Concept ;
    skos:definition "Designates the artistic and literary movement and style based on a lecture given in 1913 by art critic Korney Chukovsky (1882-1969) in reference to Russian avant-garde poets whose work was influenced by French Cubism and Italian Futurism. The movement encompasses Russian art works from 1912 through 1915 that utilized techniques developed by Cubist painters and addressed Futurist principles of movement, dynamism, and the relationship between man and machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cubo-Futurist"@en .

aat:300021397 a skos:Concept ;
    skos:definition "Refers to the style and movement, conceived by Mikhail F. Larionov in 1909, representing one of the first steps in the progression and development of abstract art in Russia. The style is reminiscent of Futurist and Cubist works and is governed by the emphasis on spatial forms obtained through the interactions of reflected rays from an object's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rayonist"@en .

aat:300021404 a skos:Concept ;
    skos:definition "Representational style sanctioned by the government in Communist countries. For works depicting realistic situations with a tone of social protest, use \"social realism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Socialist Realist"@en .

aat:300021405 a skos:Concept ;
    skos:definition "Refers to the first movement of pure geometric abstraction in painting, originated by Kasimir Malevich around 1913. The style is characterized by simple forms, such as circles, squares and triangles typically in limited colors such as black, red, green, and blue, on a white background. In the 1920s, El Lissitzky took Suprematist ideas and experimented with new techniques in printing, exhibiting and photomontage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suprematist"@en .

aat:300021414 a skos:Concept ;
    skos:definition "Refers to the style and movement organized and set in theory by Serge Diaghilev in 1898 in a publication called Mir Iskusstva and based on the ideas of Russian artists and writers active in the late 19th and early 20th centuries. The short-lived art movement (c.1898-c.1906) centers around the revival of Russian art through the rejection of foreign trends and abstention from zealous nationalism. The movement also provided precedent for the Symbolist and Aesthetic movements in Russia. The style is characterized by a combination of vigor and elegance, a sense of exoticism, and interaction and synthesis of the visual arts with and among other forms of art. Also refers to the exhibition society that began in 1910 after the disbanding of the movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mir Iskusstva"@en .

aat:300021423 a skos:Concept ;
    skos:definition "Describes works depicting informal, intimate domestic scenes of everyday life produced in the 1890s in an Impressionist style and identified with French artists Pierre Bonnard and Edouard Vuillard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Intimist"@en .

aat:300021425 a skos:Concept ;
    skos:definition "Porcelain style focused on heraldic motifs, particularly the style of the 18th century produced in China for European export."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armorial"@en .

aat:300021426 a skos:Concept ;
    skos:definition "Refers to the style predominently of architecture and the decorative arts, widely disseminated in Europe and the United States in the 1920s and 1930s, which became popular after the Exposition Internationale des Arts Décoratifs et Modernes in Paris in 1925. The style is characterized by a synthesis of industrial and fine arts materials used to create a wide variety of both man-made and mass-produced objects, often with an emphasis on rectilinear motifs, vibrant colors, and elegant, abstracted, simplified forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Art Deco"@en .

aat:300021430 a skos:Concept ;
    skos:definition "Refers generally to the style of painting, architecture, decorative arts, and applied arts that flourished in Europe and the United States from about 1890 to 1910. The style is characterized by an emphasis on fluid, undulating, or serpentine lines or contours based on organic forms and the use of modern materials such as iron and glass. The style developed as regional variations under various names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Art Nouveau"@en .

aat:300021432 a skos:Concept ;
    skos:definition "Refers to the German School of art, design, and architecture active in Weimar from 1919 to 1925, in Dessau from 1925 to 1932, and in Berlin from 1932 to 1933. Training students in both fine art and craftsmanship, it produced objects and building designs intended for mass production using simple, geometric forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bauhaus"@en .

aat:300021433 a skos:Concept ;
    skos:definition "Refers to the style of architecture and city planning originally taught at the École des Beaux-Arts in Paris and at other schools in the United States in the 19th and 20th centuries. The style is characterized by an emphasis on the harmonious composition of elements that form a Classical whole, the revival of Baroque and Neoclassical styles, and cities laid out geometrically with wide, grand streets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beaux-Arts"@en .

aat:300021434 a skos:Concept ;
    skos:definition "Satirical name used to describe a style of Central European arts prevalent from the 1820s to the 1850s, that became associated with the taste of the middle class. The style is characterized by simple, unpretentious forms, and sentimentalized representations of man and nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Biedermeier"@en .

aat:300021436 a skos:Concept ;
    skos:definition "Term coined in 1930 by Theo van Doesburg to characterize a form of non-figurative painting in which the pictorial elements, planes and colors, have no significance other than themselves. He meant to distinguish between other forms of abstraction, indebted to illusionism mimicing the visible or natural world, and paintings that are products of the human mind. The definition was elaborated upon by Max Bill in 1936 in a catalog for the exhibition Zeitprobleme in der Schweizer Malerei und Plastik. In 1960 Bill organized an exhibition of work that fit his definition, and that established Concrete art as an international movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Concrete art"@en .

aat:300021439 a skos:Concept ;
    skos:definition "Refers to the intellectual movement of the last two decades of the 19th century when both artists and writers became more concerned with form, beauty, and pleasure than content and morality. The movement is characterized by a preoccupation with themes considered morbid, disturbing, sexual, or supernatural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Decadent Movement"@en .

aat:300021442 a skos:Concept ;
    skos:definition "Modern revival styles belonging to European cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern European revival styles"@en .

aat:300021444 a skos:Concept ;
    skos:definition "Refers mainly to the architectural style in Europe especially in large public buildings, from the end of the 19th century until approximately World War I characterized by impressive classical façades, elaborate decoration and sculpture, and spacious interiors. At the time, it was called \"English Renaissance.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baroque Revival"@en .

aat:300021446 a skos:Concept ;
    skos:definition "Refers mainly to the style in architecture and decorative arts in Europe and the United States during the second half of the 19th century and the beginning of the 20th century. Influenced by publications on Byzantine architecture, it is characterized by the round arches, barrel vaults, densely carved foilage, and mosaic decoration typical of that architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Byzantine Revival"@en .

aat:300021448 a skos:Concept ;
    skos:definition "Refers to the style in American and European architecture and decorative arts dating between the late 18th and early 19th centuries and influenced by publications about Egypt and Napoleon's military campaigns. It is characterized by the use of Egyptian forms and motifs including obelisks, pyramids, hieroglyphs, winged solar discs, sphinxes, papyrus, and lotus buds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian Revival"@en .

aat:300021450 a skos:Concept ;
    skos:definition "Refers to the style in European interior design, furniture, and ceramics in the late 18th century. Derived mainly from the motifs and colors of Greek vases, at the time thought to be Etruscan, the style features griffins, palmettes, harpies, lions, and sphinxes, and the use of colors red, black, and white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etruscan Style"@en .

aat:300021452 a skos:Concept ;
    skos:definition "Style in architecture and decorative arts characterized by a return to the incorporation of rosettes, pinnacles, tracery, foils, and polychrome effects inspired by Gothic architecture and reproduced with the aim of historical accuracy. Although the Gothic revival was practiced throughout Europe, it attained its greatest importance in the United States and England from the mid-18th century to the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic Revival"@en .

aat:300021456 a skos:Concept ;
    skos:definition "Refers to the style of architecture and decorative arts in Europe and the United States from the 1750s to ca. 1840, characterized by the use of Classical Greek forms and ornament. Inspired by 18th century archaeological discoveries, it attempted to closely follow original models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek Revival"@en .

aat:300021462 a skos:Concept ;
    skos:definition "Refers to the style of European and American interior design and decorative arts inspired by the archaeological findings at Pompeii and Herculaneum in the mid-18th century. Influenced especially by the frescoes at Pompeii, the style features nymphs, grapevines, candelabra, and grotesques rendered in delicate borders and patterns in deep, clear colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pompeian Style"@en .

aat:300021464 a skos:Concept ;
    skos:definition "Refers to the style in 19th-century European and American architecture and decorative arts initially inspired by the Italian Renaissance, or related Renaissance styles in other European countries; characterized by pilasters, rustication, and classical motifs. Later, it includes Renaissance styles based on regional or national variations such as the Elizabethan and Jacobean revivals and the French Renaissance revival."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance Revival"@en .

aat:300021466 a skos:Concept ;
    skos:definition "Refers to the 19th century style originating in France and spreading to other parts of Europe, England, and the United States, that revived Rococo forms and motifs in interior design and decorative arts. Also applied to painting, it describes the work of artists who sought to recapture the lyricism, color, and vibrant surfaces of Rococo artists, particularly of Watteau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rococo Revival"@en .

aat:300021467 a skos:Concept ;
    skos:definition "Refers to the style in European and American architecture dating from the 1820s to the end of the 19th century. Based on the style of the 11th- and 12th-century Romanesque church architecture, it is characterized by semicircular arches, groin and barrel vaults, and the spare use of naturalistic ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romanesque Revival"@en .

aat:300021468 a skos:Concept ;
    skos:definition "Refers to the 19th-century English architectural style based on Norman forms and motifs such as round arches, battlements, and barrel and groin vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norman Revival"@en .

aat:300021472 a skos:Concept ;
    skos:definition "Refers to the style of architecture that emerged in Holland, France, and Germany after World War I and spread throughout the world, becoming the dominant architectural style until the 1970s. The style is characterized by an emphasis on volume over mass, the use of lightweight, mass-produced, industrial materials, rejection of all ornament and color, repetitive modular forms, and the use of flat surfaces, typically alternating with areas of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "International Style"@en .

aat:300021474 a skos:Concept ;
    skos:definition "Refers to the succession of 20th-century avant-garde art and architectural movements formed in a reaction to social modernity. Modernism was eclipsed by the Post-Modernism movement, which began in the 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modernist"@en .

aat:300021476 a skos:Concept ;
    skos:definition "Refers to the British style affecting art, literature, theater, and film and dating between the 1930s and the 1950s. Influenced by Surrealism, the style is characterized by its emotion and theatricality and works depicting the vulnerability of the human body and personal, visionary landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Romantic"@en .

aat:300021477 a skos:Concept ;
    skos:definition "Refers to the style of European and American architecture and fine and decorative arts between the mid-18th century and the mid-19th century inspired by archaeological discoveries in the Mediterranean and Near East and characterized by the imitation of Greek and Roman forms and motifs. Also considered a reaction to Rococo opulence, Neoclassical works are often linear, symmetrical, and even severe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neoclassical"@en .

aat:300021491 a skos:Concept ;
    skos:definition "Refers to a style of imitation Gothic furniture in the 1820s and 1830s. Derived from the style of Sir Walter Scott's home Abbotsford in Roxburghshire, it is characterized by twisted columns, cusps, bulbous carving, and ecclesiastical motifs and the incorporation of wood fragments dating from the 15th and 16th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abbotsford"@en .

aat:300021492 a skos:Concept ;
    skos:definition "Refers to late-19th-century Japanese-style European and American decorative arts and architecture characterized by asymmetrical compositions and Japanese motifs including bamboo, blossoms, fans, and chrysanthemums.19th century European style derived from but seldom directly imitative of Japanese works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japonaiserie"@en .

aat:300021495 a skos:Concept ;
    skos:definition "Refers to the international art movement with origins attributed to Georges Braque and Pablo Picasso ca. 1908. It developed in phases and lasted until the early 1920s. The style is characterized by an emphasis on the flat, two-dimensional surface of the picture plane, the rejection of traditional methods of representation, and the dissolution of objects by making several sides visible simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cubist"@en .

aat:300021499 a skos:Concept ;
    skos:definition "Refers to the phase of Cubism that emerged in 1912 and is characterized by the use of collage and often by the addition of materials to pigment such as sand, to interject ambiguity about the objects depicted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Synthetic Cubist"@en .

aat:300021500 a skos:Concept ;
    skos:definition "Refers to the European artistic and literary movement of violent revolt against the pretentions of Western civilization, begun in Zurich in 1916 as a reaction to World War I. The movement advocated the use of irony, nihilism, iconoclasm, the absurd, and emphasized the importance of chance in the creation of poems, performances, and artworks, which were typically commonplace objects set in an artistic setting. The name Dada was chosen by chance from the dictionary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dada"@en .

aat:300021502 a skos:Concept ;
    skos:definition "Refers to an international style of art, literature, music, dance, and theater that flourished between 1905 and 1920, especially in Germany. The style is characterized by the abandonment of traditional standards of realism and proportion in favor of expressing the artist's emotions, resulting in distortions of line, color, and form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Expressionist"@en .

aat:300021503 a skos:Concept ;
    skos:definition "Refers to the movement in 19th-century Western art that developed in France and rejected traditional academic teaching and attempted to use science regarding the physics of color to achieve exact representations of color, tone, and light. Impressionist art is characterized by the use of small touches of pure color, painting out-of-doors in order to catch the essence of a fleeting time of day, and an objective depiction of contemporary life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Impressionist"@en .

aat:300021505 a skos:Concept ;
    skos:definition "Refers to an avant-garde, European art movement and style that flourished from 1886 to 1906; term was coined by the art critic Félix Fénéon in a review, ‘Les Impressionistes’ (in La Vogue; Paris, 1886). Is identified particularly with a group of French artists including those exhibiting in the eighth and last Impressionist exhibition (1886); Camille Pissarro, Lucien Pissaro, Paul Signac, and Georges Seurat exhibited their work in one room, asserting a shared vision. Other artists who practiced the style were Charles Angrand, Louis Hayet, Henri Edmond Cross, Léo Gausson, Hippolyte Petitjean, Albert Dubois, and Maximilien Luce. Neo-Impressionism both developed out of Impressionism and was a reaction against it. Like Impressionism, Neo-Impressionism was concerned with light and color but while the former was typically spontaneous and empirical, the later was based more on scientific principles and resulted in formalized compositions. While relatively short-lived, the movement had a large impact on other artists and movements of the late 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Impressionist"@en .

aat:300021508 a skos:Concept ;
    skos:definition "Refers to a movement of Western art that existed from the late nineteenth century through the early twentieth century. The term was coined by art critics Roger Fry, Clive Bell and others to refer to art that chronologically followed the Impressionist movement but was distinct from Neo-Impressionism. It is characterized by widely differing, highly personal artistic styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post-Impressionist"@en .

aat:300021512 a skos:Concept ;
    skos:definition "Refers to the international intellectual movement centered mainly in Paris from the 1920s to the late 1940s. Adopting some of the aesthetic experiments of Symbolism and the attitudes of Dada, the movement is characterized by an emphasis on exploring the limits of experience by fusing reality with the instinctual, the subconscious, and the realm of dreams, in order to create an absolute reality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Surrealist"@en .

aat:300021514 a skos:Concept ;
    skos:definition "Refers to the international intellectual movement that was first applied to literature in the late 19th century, spreading to painting and theater, and influencing European and American literature from the 20th century to the present. Affecting later movements such as Surrealism, it is characterized by a complex synthesis of psychology, mystical and occult practices, and linguistics used to challenge traditional relationships between representation and meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Symbolist"@en .

aat:300021515 a skos:Concept ;
    skos:definition "Refers to the British literary and artistic movement founded in 1914 by Wyndham Lewis and members of the Rebel Art Centre. Inspired by Italian Futurism, works of art including paintings, prints, and photographs are characterized by strong contours and clear, angular, machine-like forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vorticist"@en .

aat:300021516 a skos:Concept ;
    skos:definition "Refers to a style region encompassing the regions where Islam is prevalent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic World, The"@en .

aat:300021521 a skos:Concept ;
    skos:definition "Refers to the art and culture associated with the Islamic dynasty of this name that was founded in 750, when it overthrew the Umayyad caliphate. The Abbasids were a Meccan family descended from Abbas, Muhammad's uncle. Their headquarters were in Mesopotamia and they founded the city of Baghdad in 762. Persian ideas prevailed during this period and the Abbasids ruled in great splendor as Oriental monarchs. Encouraging intense intellectual and artistic activity, many palaces and mosques were built and the production of luxury items became an industry. A unified style of art developed, inspired by ancient Persia rather than Christian Syria. The ruined city of Samarra, occupied by the Abbasids in the 9th century, is a prime example of this influence, especially in the Sassanian construction methods. Samarra is noted for its ornamental stucco, particularly the so-called 'bevelled' manner of decoration derived from Scythian-Siberian abstract design. Highly valued Chinese porcelain was imitated by potters of the period; the results were distinctly Islamic, however, with Arabic inscriptions and designs. Abbasid textiles also assumed an identifiable Islamic character. The vast empire became unwieldy and as its central administration weakened, rival caliphates were established. Although the Abbasids continued to rule part of the Islamic world until 1258, their dominance only lasted until the mid-10th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abbasid"@en .

aat:300021522 a skos:Concept ;
    skos:definition "A pottery style characterized as attractive sgraffito wares featuring densely incised calligraphic, figurative and geometric designs on crosshatched, cream-colored grounds. Animals designs were popular. Some of the designs found on Amol wares may be derived from metalwork prototypes. Designs are covered with transparent colorless glaze and varying amounts of green oxides. The town of Amol, in the Mazandaran province of western Persia, was the center of production for this pottery style between the 11th and early 13th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amol"@en .

aat:300021525 a skos:Concept ;
    skos:definition "A pottery style which takes its name from pottery found at Samarra, the temporary residence of the Abbasid caliphs in the 9th century. Samarra ware was unknown before excavations undertaken between 1911 and 1913. The pottery found at Samarra, however, probably came from nearby Baghdad and examples of this style have been found in Persia, Spain, Egypt and Syria, all places the style later spread to. It is characterized by thin bodies made of very finely levigated sulfur yellow clay and by carefully applied soft tin glazes. A noteworthy technical achievement of Samarra ware is the brilliant gold luster deliberately combined with other metallic tones on both tiles and vessels. Decoration usually consists of single animals or larger designs on the inside of vessels with rings of dashes almost always decorating the exterior. Early examples from the 8th century successfully mimic gold dishes, suggesting that they were the earliest substitutes for forbidden table wares of precious metal. Much Samarra ware imitates the Chinese ceramics that were imported to the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samarra"@en .

aat:300021528 a skos:Concept ;
    skos:definition "Refers to the art and culture associated with the Islamic Berber dynasty that ruled in North Africa and southern Spain (1130-1269). This period is notable because it was the first time the whole Maghrib was united under one dynasty. The Almohads rose up against the Almoravids in 1121 and conquered Marrakesh in 1147. The dynasty declined in power when it was defeated by Alfonso VIII in 1212, losing Andalusia, and in 1269 when they lost Marrakesh to the Berber Marinids. The Almohad courts at Marrakesh and Seville were centers of Islamic art and learning, especially philosophy. Almohad architecture is known for its juxtaposition of puritanically simple design with ornate decoration. Enormous congregational mosques were built in Seville, Rabat and Marrakesh. Simple interiors are relieved by voluptuous, lobed arches and other details. Repetitive use of an architectural unit such as an arcade or bay to create directed vistas and a deep sense of space is another typical feature. Austere exteriors strongly contrast with the richly decorated, gigantic square minarets (late 12th century) of the three mosques. These minarets are elaborately fenestrated and each face has different latticed designs done in raised stonework. The mosque of Tinmal, with its characteristically Maghribi T-shape, is considered to be an Almohad masterpiece. The location of the minaret behind the mihrab is an important innovation at Tinmal. Almohad mosques tend to be enlarged at the expense of their courtyards. Other arts such as bookmaking, metalwork, and luxury textiles flourished as well. Several copies of the Koran reveal that paper began to replace parchment during this period. A binding on a magnificent multi-volume Koran (1256) is the earliest dated example of gold tooling. Textiles, like bookbindings, show a taste for geometric patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Almohad"@en .

aat:300021538 a skos:Concept ;
    skos:definition "Dynasty which ruled over Egypt, what is now upper Iraq, part of Syria, and Yemen from the late 12th to early 13th centuries CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayyubid"@en .

aat:300021540 a skos:Concept ;
    skos:definition "Painting styles belonging to Ayyubid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayyubid painting styles"@en .

aat:300021546 a skos:Concept ;
    skos:definition "Pottery styles belonging to Ayyubid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayyubid pottery styles"@en .

aat:300021550 a skos:Concept ;
    skos:definition "Refers to the art and culture associated with the Islamic Berber dynasty of this name that ruled in Ifriqiya (modern Tunisia) from 909 to 972 and in Egypt from 969 to 1171. The Fatimids, of the Shi'a sect, traced their ancestry back to Fatima, the daughter of Muhammad. The Fatimids had many rivals to contend with as well as the challenge of the Crusaders. Fatimid art is noteworthy for its internationalism: it bridges the east and west of the Islamic world and it was open to the Hellenic heritage of the Mediterranean and to some ideas from Christian powers to the north. Although Fatimid artists continued to use materials and techniques developed by the Tulunids, the abstraction favored by the Tulunids was replaced by an interest in exploring the tradition of figurative representation inherited from Iraq. Painting, book illustration, wood and ivory carving, and glass, ceramic and textile design bear figurative decoration unparalleled in contemporary Islamic art. An interest in naturalism is also evident. The iconography of Fatimid art is often indebted to Abbasid court art. Just as figural traditions were being developed, so were designs based on infinite systems of linear pattern; this form of ornamentation became one of the most successful forms of abstract Islamic art. Figural art was inappropriate for religious buildings, which were instead decorated with a vigorous new style of stone carving typically featuring elegant inscriptions in a distinctive form of kufic script elaborated with foliate and floral elements. A conch shell motif known from late antiquity was popular with the Fatimids, as seen on the façade of the mosque of al-Akmar. Nothing has survived of the two Fatimid palaces that stood in the center of Cairo but accounts of them attest to their magnificence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fatimid"@en .

aat:300021551 a skos:Concept ;
    skos:definition "Refers to the art and culture associated with the Islamic Turkish dynasty of this name that ruled eastern Persia, Afghanistan, Turkestan, and northwestern India. The Ghaznavids, beginning as Turkish military slaves who assimilated Perso-Islamic ways, ruled from the 10th century until the 11th and 12th centuries when they were expelled by the Seljuks and Ghurids. Little Ghaznavid art has survived although the two monumental tomb towers or minarets still standing at Ghazni give an idea as to its magnificence. Of a tall and slender Persian type, they were built on the plan of an eight-pointed star and their surfaces are decorated with Kufic inscriptions and abstract designs in brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ghaznavid"@en .

aat:300021555 a skos:Concept ;
    skos:definition "Refers to art and architecture associated with the Islamic Hafsid rulers of Tunis who were one of four regional powers to emerge in the Maghrib after the collapse of the Almohad empire in 1212. The Hafsids ruled in the eastern area of North Africa. Important centers were the coastal cities of Tunis, Sousse, and Sfax. Hafsid culture is a meeting of east and west: the many Spanish refugees in the region brought their artistic traditions with them and the Hasfids also maintained close ties with the Mamluks of Egypt. The Hafsids were responsible for introducing the madrasa to the Maghrib and many were built as well as numerous mosques. The Hafsids, who saw themselves as champions of the Islamic faith, also commissioned many noteworthy religious manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hafsid"@en .

aat:300021556 a skos:Concept ;
    skos:definition "Style and culture associated with the Hamdanid Shi'a Muslim Arab dynasty of northern Iraq (Al-Jazirah) and Syria, dating 890-1004 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamdanid"@en .

aat:300021558 a skos:Concept ;
    skos:definition "Refers to the art and architecture associated with the Islamic dynasty of this name that ruled in Morocco from 789 to 985; it was the first Islamic dynasty to establish an independent state in Morocco and played an important role in making Morocco an Islamic country. Islamic urban culture began to make its appearance in Morocco during the Idrisid period. Idris I, a descendant of Muhammad, founded the dynasty as well as the city of Fès. Fès became the capital during the reign of his son, Idris II, and flourished as a trade, religious and intellectual center under Idris II's patronage. The Idrisids were responsible for the layout of the old city center and the division of the city into two distinct areas (the Kairouanis and the Andalusians) separated by the River Fas. Unfortunately, physical remains from the period are limited. The Idrisids built what is now the Qarawiyyin Mosque in Fès but only its core preserves Idrisid elements. The tomb of Idris I at Moulay Idris near Volubilis (made the capital of Idris I after 788) and that of Idris II in Fès are considered the holiest shrines in Morocco; both tombs were completely rebuilt in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Idrisid"@en .

aat:300021560 a skos:Concept ;
    skos:definition "Refers to the art and culture associated with the Islamic Turkish dynasty of this name that ruled Syria and Egypt from 935 to 969. From 946 to 968 most governmental power lay with the vizier rather than with the sons of the dynasty's founder, Muhammad ibn Tughj. The vizier, Abu al-Misk Kafur, was a patron of learning and the arts, briefly attracting the eminent poet al-Mutanabbi to his court. The Ikhshidid dynasty was the first to restore order to Egypt after the fall of the Tulunids, laying the groundwork for the new artistic developments that occurred under the Fatimids. In 969 the Fatimids overthrew the last of the Ikhshidid rulers, a grandson of the founder, while the Hamdanids drove the Ikhshidid governors out of northern Syria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ikhshidid"@en .

aat:300021564 a skos:Concept ;
    skos:definition "Painting styles belonging to Il-Khanid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Il-Khanid painting styles"@en .

aat:300021571 a skos:Concept ;
    skos:definition "Pottery styles belonging to Il-Khanid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Il-Khanid pottery styles"@en .

aat:300021574 a skos:Concept ;
    skos:definition "Style produced in ceramics at Sultanabad (modern Arak, Iran) that reached its peak as a style in the 13th and 14th centuries. Favorite types were minai (a method that preserved colors through firing), lustreware, faience in green and dark blue tones, often with molded ornamentation, and tiles richly decorated in lustre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sultanabad"@en .

aat:300021600 a skos:Concept ;
    skos:definition "Culture and dynasty of the last ruling family of the Delhi sultanate of India, 1451-1526. The dynasty was of Afghan origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lodi"@en .

aat:300021601 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of the Mamluks, a warrior caste who came to rule Egypt and Syria from about 1250 to the early 16th century although they were influential and powerful in the Middle East for over 700 years. Mamluk architecture was basically conservative and not particularly innovative but it is prolific and generally of very high quality. Mamluk architecture is distinguished by the use of incredibly elaborate minarets, huge facades and portals, and the tendency to build structures with different uses in a single complex. Patrons also typically built their major monuments close to one another. The Mamluks are also known for their technical virtuosity in stone construction; masons often alternated different colored stones on the surfaces of buildings. Almost 3000 major Mamluk monuments have been preserved or are known through texts; most monuments in the old quarters of Cairo, Damascus, Tripoli, and Aleppo are Mamluk and most on the Haram ash-Sharif in Jerusalem, outside the Dome of the Rock, are Mamluk as well. Like architecture, the other arts of the Mamluk period achieved a high level of technical perfection but are not known for their originality; there are noteworthy examples of inlaid metalwork, calligraphy, mosque lamps, and wooden objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mamluk"@en .

aat:300021611 a skos:Concept ;
    skos:definition "Refers to culture, art, and architecture associated with the Islamic Nasrid court at Granada, Spain; it flourished as a brilliant center of Islamic culture for almost eight centuries until 1492 when all of the Iberian peninsula was brought under Christian control. The Alhambra, the royal city of the Nasrids, is one of the most famous Islamic buildings and is the most extensively preserved medieval Islamic palace anywhere. Nasrid architecture is characterized by glittering facades concealing structurally simple buildings; trabeate construction, heavy stone walls, and light wooden roofs are typical. Decoration includes carved and painted stucco, glazed tile, carved and joined wood, and muqarnas vaults. Other noteworthy Nasrid artworks are the large lusterware wing-handled vases known as Alhambra vases (the largest lusterware pots ever made), probably produced in Málaga."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nasrid"@en .

aat:300021614 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the reign of the Islamic dynasty that began to rule in Anatolia in 1281 until the promulgation of the Constitution of the Turkish Republic in 1924. Under the support of Ottoman sultans, a distinct architectural style developed that combined the Islamic traditions of Anatolia, Iran, and Syria with those of the Classical world and Byzantium. The result was a rationalist approach that favored spatial unity and clarity, the most important structure being the kulliye, a building complex combining religious, educational and charitable buildings. The main architectural theme of this complex was the domed square unit and combinations of varying spatial and architectonic expressions. The mosque, and in some cases the mosque-convent, was the crowning achievement. Under the conquest of Constantinople and the establishment of new administrative palaces across the empire, the relationship between Ottoman patrons and the artist became centralized. A corps of court architects employed architects of different ranks, and controlled all building activity throughout the empire. A community of craftsman brought together societies of artists and craftsman, forming the imperial design studio where illuminated manuscripts, tiles, woodwork, carved stone, jade, and metal objects, along with carpets and textiles were produced. These works typically chronicled the important events of a sultan's rule. During the 18th and 19th century, Ottoman art was increasingly westernized in style, often incorporating elements of European Baroque style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ottoman"@en .

aat:300021621 a skos:Concept ;
    skos:definition "Pottery styles belonging to Ottoman cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ottoman pottery styles"@en .

aat:300021633 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the reign of Osman I, a Turkish ruler active in northwest Anatolia at the end of the 13th and beginning of the 14th centuries. His emirate took over the declining rule of the Saljuqs of Anatolia and was based on the concept of religious warfare. Under Osman I, the state expanded rapidly to the west over Byzantine territory in Thrace and the Balkans. Little is documented regarding the art of this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Osman I"@en .

aat:300021635 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the reign of Orhan, 1324 to 1362. The earliest royal mosques built during this period were of two types. The first was the single-domed chamber with or without a portico. The second type consisted of a five-part portico leading to a domed central chamber, which on axis opened through an arch to the mosque proper. Two flanking chambers, probably barrel-vaulted, opened into both the porch and the domed chamber. In 1339, Ohran began a similar mosque at Bursa, with a domed chamber preceding the central space, and double flanking rooms opening into the central chamber. Also of this period, is the \"Silver Tomb\" of Osman, so named for its gleaming lead dome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orhan"@en .

aat:300021637 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the rule of Murad I, son of Orhan, 1362 to 1389. During this period some new mosques were constructed at Bursa and the sultan is recorded as having employed Christian workmen. In 1366, Murad I began the construction of a kulliye, or charitable complex. It consisted of mosque-madras, a thermal bath of Byzantine origin, a large soup kitchen, and a school. Completed in 1385, the mosque was of the cross-axial form with four chambers, two of them having large fireplaces to shelter visiting dervishes. Under the central dome, stood a fountain for ritual ablutions before the raised mosque section. A unique feature of this building is the octagonal domed chamber over the mihrab, the niche in a mosque wall indicating the direction of Mecca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murad I"@en .

aat:300021640 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the reign of Bayazid I, named \"Thunderbolt\" beacuse of the speed with which he maneuvered his troops, 1389 to 1402. He is best known for his construction of the \"Great\" mosque of Bursa, founded in 1390, but substantially finished in 1395. It comprised a mosque, baths, and a small palace within an irregular wall enclosure. The plan and scale of the mosque is like that of Murad I, but is of cut stone masonry without with some marble. The walls of the chambers that housed the dervish pilgrims were decorated with flowers and once polychromed. The porch of stone and marble is the first major Ottoman portico. Also of mention is the Dar al Shifa, or teaching hospital of 1400."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bayazid I"@en .

aat:300021646 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the reign of Mehmed I, 1403-1421. During this period, the Yesil Cami or \"Green\" mosque was begun in 1412 to 1413, so named so its domes once covered in green tiles. The decoration on general was probably under the supervision of Ali bin Ilyas of Bursa, called Nakkas (\"Designer\"). The plan is an elaboration of that of Bayazid, although here the sanctury and the south pilgrim's rooms are domed. The north facade is decorated with rich moldings and an elaborate portal in marble. The nearby Tomb of Mehmed I, completed after his death in 1421, have an exterior of panels encased in blue tiles framed in stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmed I"@en .

aat:300021653 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the reign of Suleyman I, known in Turkey as Kanuni (lawgiver) and in the West as the Magnificent, 1520 to 1566. Suleyman's reign is seen as the height of Ottoman political, economic, and cultural development, and the artistic institutions and systems of patronage established during his reign set the standard that Suleyman's two successors, Selim II and Murad III. Under Suleyman, two major art institutions underwent significant change. The office of chief architect was held for most of his reign by Sinan, who oversaw the construction of a vast number of religious, educational, and economic buildings. Sinan restructured the unadorned external elevation of the Ottoman mosque with a battery of articulating devices such as single or double entrance porticoes, interlocking volumes of domes and semi-domes, and a new type of slender, pencil-like minaret of great height. This style is best exemplified in Sinan's Selimiye mosque at Edirne, 1569-1575. Also under Sulyeman, two branches of the royal design studio brought about the basic synthesis of the new Ottoman imperial style in decoration and book illustration. Iznik tiles of this period are considered to be unparalleled in their depth of tone and richness of color, with the introduction of bold reds, purples, blues, and olive greens. Carpets manufactured at Ushak in southern Anatolia, became more complex and controlled in pattern, with richer velvet like surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Süleyman I"@en .

aat:300021655 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the reign of Murad II, son of Mehmed I. He ruled from 1421 to 1444, when he abdicated but returned to the throne to rule from 1446 to 1451. The most significant architectural accomplishment of his reign was the construction of the huge 'Three-balconied Mosque,' begun in 1438 and was so named for its novelty of having a triple balconied minaret. The building was unprecedented in its use of patterns of chequer-work, lozenges, and twisting stripes of reddish-pink stone, grand courtyard and very tall minarets. Murad II was the last sultan to be buried in the city of Bursa, but the site he chose was more remote, and the resulting complex of buildings and royal burial grounds are low-lying and simple in nature than previous works. Also of note is the accompanying garden with it's complicated assortment of cedar and plane trees, oleander and rose bushes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murad II"@en .

aat:300021657 a skos:Concept ;
    skos:definition "Refers to the style and period associated with the reign of Mehmed II, 'the Conqueror.' He succeeds his father Murad II, reigning during his abdication from 1444 to 1446 and later from 1451 to 1481. Mehmed expanded the Ottoman Empire in all directions, ended the thousand-year Byzantine Empire, conquering Constantinople in 1453 and the Morea and Trebizond in 1461. Upon capturing Constantinople, he made the great city the capital of his new empire, changing the name to Istanbul. During his reign, he sponsored major building projects to embellish the city and lay the foundations for the imperial court organization that was to characterize the Ottoman Empire in the 16th century. Mehmed founded the Old Palace to serve as the residence for the harems of former sultans, and was responsible for the layout of the New Palace, known as Topkapi. He also ordered the construction of the Çinilli Kiosk, a building of Iranian plan and decorated by Venetian painter Gentili Bellini. He also commissioned medals from the Italian artist and amassed a huge collection of books in both European and Islamic languages. Also during his reign, communities of craftsmen in many categories were established, such as bookbinders, calligraphers, silk and carpet weavers, and metalworkers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmed II"@en .

aat:300021664 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the rule of Bayazid II, 'the Pious,' 1481 to 1512. Bayezid oversaw the construction of two riverbank complexes, the Amasya complex completed in 1486, and the Edrine complex, probably built by Hayreddin in 1488. The latter, with its contrasting golden and red sandstone ornamentation and dark-gray lead roof, presents one of the most effective examples of Ottoman classical architecture at its early stages of development. Also under his patronage, the Ottoman narrative painting style began to take form. Bayezid also brought Syh Hamdullah from Amasya to Istanbul where the tradition of this great Ottoman calligrapher lasted well into the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bayazid II"@en .

aat:300021669 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the reign of Selim I, 'the Grim,' 1512 to 1520. He enlarged the Ottoman Empire in both Syria and Egypt, and as a result little would be built during this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Selim I"@en .

aat:300021672 a skos:Concept ;
    skos:definition "Refers to the style and period that coincided with the reign of Süleyman II, 1687 to 1691."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Süleyman II"@en .

aat:300021677 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the regin of Selim II. The Selimiye Mosque was built for him by Sinan between 1570 and 1574."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Selim II"@en .

aat:300021679 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Murad III (1574-1595), son of Selim II and grandson of Suleyman II. Murad commissioned a royal mosque in Manisa and extensively rebuilt parts of the Topkapi Palace in Istanbul. His primary interest as a patron was in the arts of the book, and of all the Ottoman sultans he showed the most personal interest in the works of court painters, designers, and calligraphers. Many major illustrated histories and religious works were completed under his patronage. By the 1580s, gold and silver from the New World flooded the market and forced the court to follow a fixed system of pricing for artistic works such as tiles and carpets. Despite the economic downturn, court carpets and ceramics reached their technical and artistic zenith during Murad III's regin, along with Ottoman court prayer rugs and polychrome ceramic tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murad III"@en .

aat:300021681 a skos:Concept ;
    skos:definition "Refers to the style of art and architecture that coincided with the reign of Mehmed III, from 1574 to 1595. His tomb was designed by Ottoman architect and court artist Ahmed Dalgiç."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmed III"@en .

aat:300021682 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Ahmed I, from 1603 to 1617. During his reign, The Ahmediye Mosque was built by Mehmed Agha. It is known as the Blue Mosque from the color of its interior tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ahmed I"@en .

aat:300021683 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Mustafa I. He ruled briefly 1617 to 1618 and then was deposed and reinstated from 1622 to 1623."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustafa I"@en .

aat:300021684 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Osman II, who ruled from 1618 to 1822. During this time, Ahmed Nakşi, the foremost illustrator of historical manuscripts, completed an account of Osman II's campaign against Poland in 1621."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Osman II"@en .

aat:300021685 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the regin of Murad IV, who ruled from 1623 to 1640. The illustration of the poem \"Pashaname\" (1630), executed in vivid, cartoon-like miniature, was completed during his regin. Murad IV built two kioks at Topkapi to commemorate his capture of Erivan in 1635, and Baghdad in 1638."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murad IV"@en .

aat:300021686 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Sultan Ibrahim, who ruled from 1640 to 1648. His best-known monument is the elegant, gilded, cupola-like 'bower' on the terrace of the Topkapi Palace. Ibrahim was a violent ruler who was assassinated in 1648."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ibrahim"@en .

aat:300021687 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Mehmed IV, who ruled from 1648 to 1687. Artistic achievements during his reign include additions to the Topkapi Palace and the completion of the Yeni Valide Mosque in 1683."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmed IV"@en .

aat:300021689 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Ahmed II, who ruled from 1691 to 1695."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ahmed II"@en .

aat:300021690 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Mustafa II, who ruled from 1695 to 1703."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustafa II"@en .

aat:300021691 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Ahmed II, who ruled from 1703 to 1730. His reign forms the major part of what is known as the \"Tulip Period.\" Ahmed is best-known for his patronage of the court painter Levni, who was in charge of one of the most famous of the later Ottoman historical manuscripts, the \"Sūrnāma\" or \"Book of Festivals,\" ca. 1720. Ahmed is also known for building a number of fountains in the capital city with their characteristic Tulip Period decoration of low marble reliefs with images of vases of flowers. There was also an extensive period of development of palace architecture during this period, especially with the wooded seaside palace or yali, built along the Bosporus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ahmed III"@en .

aat:300021692 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the rule of Mahmud I, who ruled from 1730 to 1754. He built several fountains during his reign including the large Indian-inspired fountain of Tophane. Also under his supervision was the Nuruosmaniye mosque, which broke from Ottoman tradition with more Western style rectangular ground plans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahmud I"@en .

aat:300021693 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the rule of Osman III, who ruled from 1754 to 1757. He completed the construction of the Nuruosmaniye mosque after the death of his brother, Mahmud I. Also during this period, the sultan had a small wooden kiosk built for himself at Topkapi over looking the Bosphorus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Osman III"@en .

aat:300021694 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Mustafa III, who ruled from 1757 to 1774. He founded The Laleli Mosque, which recalls the design of the Nuruosmaniye Mosque with its raised platform and approaching flight of steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustafa III"@en .

aat:300021695 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Abdülhamid I, who ruled from 1774 to 1789. During his reign, he constructed the village of Beylerbey along the Bosphorus with a line of raised up royal apartments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abdülhamid I"@en .

aat:300021696 a skos:Concept ;
    skos:definition "Refers to the style of architecture that coincided with the reign of Selim III, from 1789 to 1807. His reign saw a mix of Islamic and Rococo styles with his salon at Topkapi constructed of richly gilded wood, panels of tiles, and mirrors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Selim III"@en .

aat:300021697 a skos:Concept ;
    skos:definition "Refers to the style of art and architecture that coincided with the reign of Mustafa IV. He reigned briefly from 1807 to 1808."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustafa IV"@en .

aat:300021698 a skos:Concept ;
    skos:definition "Refers to the style of architecture that coincided with the reign of Mahmud II, who ruled from 1808 to 1839. Mahmud broke the power of the janissaries, whose reactionary views were in part responsible for the Ottoman military decline. In the arts, he was a major force in Europeanizing Ottoman art and architecture, building structures in the Baroque and Rococo styles, as well as the Neo-classicism of Napoleonic France. His Nusretiye or Divine Victory mosque was built in the late Baroque style with undulating, curving walls and large open courtyards. Under Mahmud II, court artists were sent to France to learn scientific methods of painting and drawing and rules of linear perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahmud II"@en .

aat:300021699 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Abdülmecid I, who ruled from 1839 to 1861. He commissioned a portrait painted by British artist Sir David Wilkie, which shows the sultan in a relaxed intimate setting rather than as an enthroned ruler. His contributions to the Topkapi palace include a large pavilion-kiosk built in the French Beaux-Arts style. He also built several mosques designed by the Balian family that continued the trend toward Westernized buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abdülmecid I"@en .

aat:300021700 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Abdülâziz, who ruled from 1861 to 1876. His institutional influence on the arts included the further development of classes for painting within the Ottoman military schools and the continuation of the governmental practice established in 1835 of sending promising artists to Paris for study. During this period, the Pertevniyal Valide mosque was built in the Indian-Gothic style, marking a shift away from westernized trends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abdülâziz"@en .

aat:300021701 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Murad V, who ruled briefly in 1876. The sultan was deposed quickly due to signs of mental instability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murad V"@en .

aat:300021702 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Abdülhamid II, who ruled from 1876 to 1909. During his reign, he constructed a mosque at Yaldiz with miniature lakes, fountains, waterfalls, and bridges. Great attention to patterning and inlays is evident in the sultan's own tables at Yaldiz, which were set with mother-of-pearl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abdülhamid II"@en .

aat:300021703 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Mehmed V, who ruled from 1909 to 1909. During this period, Turkey fought in World War I on the side of Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmed V"@en .

aat:300021704 a skos:Concept ;
    skos:definition "Refers to the art and architecture that coincided with the reign of Mehmed VI, who ruled from 1918 to 1922."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmed VI"@en .

aat:300021713 a skos:Concept ;
    skos:definition "Painting styles belonging to Safavid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Safavid painting styles"@en .

aat:300021721 a skos:Concept ;
    skos:definition "Pottery styles belonging to Safavid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Safavid pottery styles"@en .

aat:300021723 a skos:Concept ;
    skos:definition "Style, particularly of carpets, from the area around the city, Kermān, in southern Iran. Sophisticated carpets with elaborate, organized designs have been woven in Kermān since the 16th century. The best known Kirman carpets include a wide variety of 16th- and 17th-century vase carpets, rugs with rows of shrubs, arabesque carpets, fine garden carpets, and a group of medallion carpets with animals. All have asymmetrical knotting on cotton warps, with stiff, heavy woollen wefts pulled straight, and silk or cotton wefts between left relatively slack. The result is a double-warped carpet, the warps of one level lying almost directly behind adjacent warps. The color schemes of older carpets are among the richest and most varied found in Persian carpets. Vase carpets apparently continued to be made in the 18th century; a revival of carpet weaving came about in the late 19th century, with a variety of successive styles and fashions, including copies of French carpet styles, French paintings, architectural scenes with mosques and minarets, and symbolic and personage rugs similar to those made at Kashan and Tabriz. Cream shades are often used for the ground in modern carpets; the foundation is now all cotton, but the knotting is still asymmetrical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kirman"@en .

aat:300021730 a skos:Concept ;
    skos:definition "Pottery styles belonging to Samanid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samanid pottery styles"@en .

aat:300021773 a skos:Concept ;
    skos:definition "Pottery styles belonging to Sekjuk cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seljuk pottery styles"@en .

aat:300021788 a skos:Concept ;
    skos:definition "Refers to the art and culture of the Islamic dynasty of this name that ruled the Yemen as representatives of the Fatimid caliphs of Egypt from 1047 to 1138. Al-Sayyida al-Hurra Arwa bint Ahmad, the wife of the powerful Sulayhid ruler Al-Mukarram Ahmad (reigned 1067-84), ruled after her husband's death and established a new Sulayhid capital at Dhu Jibla. There she built a palace and a mosque that notably introduced several features characteristic of Fatimid mosques in Egypt. With Arwa's death in 1138, the effective power of the Sulayhid dynasty ended although a few Sulayhid princes continued to hold fortresses until the end of the twelfth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sulayhid"@en .

aat:300021806 a skos:Concept ;
    skos:definition "Refers to the Islamic culture, art, and architecture associated with the Tulunid dynasty, a dynasty founded in 868 by Ahmad ibn Tulun, a governor of Egypt who extended his control over Syria as well. The dynasty was prosperous but short-lived, being deposed in 905 by Abbasid forces. Outside the capital at Fustat, Ahmad built a mosque known as the Mosque of Ibn Tulun, considered one of the masterpieces of medieval Islamic architecture.The art of the Tulunid dynasty also included carving of wood, rock crystal, stucco, production of ceramics and textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tulunid"@en .

aat:300021807 a skos:Concept ;
    skos:definition "Refers to the style, culture, and period of the historic West Turkestani region before the Turkmen Soviet Socialist republic was formed in 1924. For the style and culture pertaining to the area of Turkmenistan after 1924, use \"Turkmen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkoman"@en .

aat:300021832 a skos:Concept ;
    skos:definition "Textile styles belonging to Turkoman cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkoman textile styles"@en .

aat:300021841 a skos:Concept ;
    skos:definition "Refers to a period (660-730 CE) during which that the foundations of Islamic society and civilization are considered to have been established; it is named after an aristocratic family of Mecca that ruled the Islamic empire from Syria for over 90 years. The craftsmen were Syrians, Egyptians, and Persians as the Arabs did not have a developed tradition of craftsmanship at this time. For these reasons, the earliest Islamic art and architecture is noticeably eclectic and it is difficult to establish an identifiable Islamic style. Nevertheless, three separate elements are typically found in Umayyad art, often in the same work: the naturalism of Syria where the Hellenistic tradition was still strong; the more decorative Coptic style of Egypt; and the Sassanian style of Persia which combined Hellenistic elements with aspects of the earlier Achaemenid period. Surviving Umayyad art is mostly in the form of architecture and its decoration, supplemented by some textiles, metalwork, ceramics, ivory, and coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Umayyad"@en .

aat:300021848 a skos:Concept ;
    skos:definition "Refers to the culture associated with the Islamic dynasty of this name that ruled in parts of North Africa and Spain and was an active patron of art and architecture between 972 and 1152. Zirid architecture was open to outside influences: the ruins of the palace of Ziri at Ashir suggest that it was modeled on an early Fatimid palace at Mahdia and the extensive ruins of the palaces at the Qal 'at bani hammad show similarities with Fatimid architecture in Egypt and Norman architecture in Sicily. There are several Zirid buildings in Granada, including a palace (1052-6) on the site of the Alhambra erected by Yusuf ibn Naghrallah, the Zirid's Jewish vizier. The only remains of this splendid palace are 12 white marble lions, reused in the 14th century for the central fountain in the Palace of the Lions. Zirid patrons also furnished religious buildings; for example, a carved wooden minbar was given in 980 by the Zirid ruler Buluggin to the mosque of the Andalusians in Fez. The most important example of Zirid woodwork is the heavily carved maqsura ordered by al-Mu'izz ibn Badis for the congregational mosque at Kairouan; a carved inscription is outlined by a distinctively Zirid raised bead. Bookmaking also flourished during this dynasty and the ruler himself was the author of an important treatise on the art of the book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zirid"@en .

aat:300021853 a skos:Concept ;
    skos:definition "Refers to the branch of Islam generally considered the more mainstream and traditionalist Islamic sect, constituting the majority of adherents to Islam. It is founded on the recognition of a theocratic state as an earthly, temporal dominion for Allah and it is characterized by religious leadership determined by and based on contemporary political realities and by the proper exercise of religious order through election rather than through lineage. Sunni doctrine often includes customs and rituals not based in the Qur'an but that evolved through historical development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sunni"@en .

aat:300021854 a skos:Concept ;
    skos:definition "Cultures and styles of various regions in Oceania, comprising islands scattered throughout the Pacific Ocean (generally excluding Japan, Indonesia, and the Philippines), but including Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oceanic"@en .

aat:300021861 a skos:Concept ;
    skos:definition "Describes the culture and style of Aboriginal Australians and current inhabitants of Australia, such as rock art, sculpture in wood, clay and sand, body decoration and bark painting, created both before and after European colonization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australian"@en .

aat:300021862 a skos:Concept ;
    skos:definition "Describes the culture and style of the original inhabitants of Australia and their descendants. Traditional art forms are currently produced in most regions, but many contemporary Aboriginal artists, influenced by globalization, have begun to utilize a variety of media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australian Aboriginal"@en .

aat:300021863 a skos:Concept ;
    skos:definition "Describes the style and culture of the Aboriginal tribe that occupied a region in central Australia. Arunta painters tend to utilize engraved dots and flicks in their backgrounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arunta"@en .

aat:300021866 a skos:Concept ;
    skos:definition "Describes the culture and style of the Murngin Aboriginal tribe that occupied a region in northeastern Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murngin"@en .

aat:300021867 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Melanesian Islands. Melanesians are well known for creating sculptures utilizing a vast range of media, their traditional communal architecture, and body arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melanesian"@en .

aat:300021872 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of New Britain Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Britain"@en .

aat:300021874 a skos:Concept ;
    skos:definition "Describes work created by a group of inhabitants of New Britain Island. The Baining people are well known for their masks and headdresses, which continue to be used in many areas of the New Britain Islands. The masks are conical in form and made of canes, poles, and barkcloth with white, black, and red designs, and are utilized in secretive male cults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baining"@en .

aat:300021875 a skos:Concept ;
    skos:definition "Describes the culture and style of a group of inhabitants of New Britain Island. The Sulka are well known for their carved and painted shields that are made from woven rattan and are sometimes decorated with faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sulka"@en .

aat:300021876 a skos:Concept ;
    skos:definition "Describes work created by the aboriginal communities of the New Caledonian Islands. The people of New Caledonia are known for their male ceremonial houses and Kanak masks. The ceremonial house is circular in structure and is bordered with coconut palms and araucaria. The Kanak mask is made up of a black wooden face with a prominent nose that extends over a laughing mouth, which forms a space for the wearer to see. The complete costume is comprised of a large headpiece in turban form made of human hair and a cloak made of notu pigeon feathers. The mask is utilized during commemorative ceremonies in order to signal the end of the ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Caledonian"@en .

aat:300021877 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Island of New Guinea whose western portion belongs to Indonesia, while the eastern half comprises part of the independent state of Papua New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Guinean"@en .

aat:300021878 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Island of Astrolabe Bay. The inhabitants are recognized for their round shields that are 700-1000 mm in diameter, 20-30 mm thick and decorated with a relief-carved X shaped design. Astrolabe Bay masks are well known for their huge noses and pierced, elongated ear lobes, which can be life size to six meters high."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Astrolabe Bay"@en .

aat:300021881 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Huon Gulf. Huon Gulf is well known for its woodcarvers who produce oval bowls in the shape of eagles and boxfish, and square and double bowls. Certain native art forms have been in serious decline or are no longer in existence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huon Gulf"@en .

aat:300021887 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Massim area. Men of the Massim tend to focus on decorating betel-chewing equipment, wooden bowls, stirring spoons, canoe paddles, dance shields, and combs with designs. Women focus on making pottery, banana and coconut leaf skirts, and woven pandanus leaf mats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Massim Area"@en .

aat:300021892 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Papuan Gulf. The peoples of the Papuan Gulf were well known for the agiba or skull shrines, which consisted of stylized anthropomorphic forms adorned with openwork and relief carving, and decorated with red, black, and white paint. The inhabitants of the Papuan Gulf produced a variety of masks and architecture, which varied from group to group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papuan Gulf"@en .

aat:300021894 a skos:Concept ;
    skos:definition "Describes works by the New Guinea Aboriginal people located in Sepik. Sepik art works are created using a wide range of materials, techniques, and forms that are often orchestrated into a single event. Sepik people have varied architectural styles. The male cult houses are the most distinctive structures and contain carved structural elements, ornamentation, and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sepik"@en .

aat:300021896 a skos:Concept ;
    skos:definition "Regional styles belonging to Sepik cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sepik regional styles"@en .

aat:300021901 a skos:Concept ;
    skos:definition "Native styles belonging to Sepik cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sepik native styles"@en .

aat:300021913 a skos:Concept ;
    skos:definition "Describes works by the New Guinea Aboriginal Washkuk of the East Sepik Province in the Ambunti District. The Washkuk are well known for their distinctive male cult houses which contain carved structural elements, ornamentation, and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Washkuk"@en .

aat:300021914 a skos:Concept ;
    skos:definition "Describes works created by the inhabitants of the Torres Strait Islands. The most well known works of the Torres Strait are their double-outrigger sailing canoes, which are capable of carrying a dozen or more people. The canoes are ornamented with engravings and paintings. No example has survived of the decorated Torres Strait canoe, except photographs and drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torres Strait"@en .

aat:300021916 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Vanuatu and its constituent islands, located in the South Pacific Ocean; particularly refers to the Melanesian cultures rather than to the colonial cultures. The art created by the Vanuatu people is often based on male initiation rituals, men's secret societies, social ranking systems and the afterlife. Vanuatu's male sacred houses are oblong homes constructed using decorated coconut fiber binding. Personal ornamentation is an important practice for the Vanuatu people, who wear elaborate garments, practice face painting, nasal perforation, and puberty scarification of women's backs, which indicate, social status, beauty, and health and hygiene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vanuatu"@en .

aat:300021917 a skos:Concept ;
    skos:definition "Describes works created by the people of Ambrym Island. The most well known artwork of the Ambrym people are distinctive woven penis wrappers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ambrym"@en .

aat:300021918 a skos:Concept ;
    skos:definition "Describes works created by the inhabitants of Oba Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oba"@en .

aat:300021919 a skos:Concept ;
    skos:definition "Describes works created by the inhabitants of the Banks Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banks Islands"@en .

aat:300021920 a skos:Concept ;
    skos:definition "Describe works created by the inhabitants of Malekula Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malekulan"@en .

aat:300021921 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Island of New Ireland. New Ireland inhabitants are well known for their figurative wooden sculptures except in the south where masking is the dominant art form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Ireland"@en .

aat:300021922 a skos:Concept ;
    skos:definition "Describes the culture and style of the people of the Santa Cruz Islands. The inhabitants of the Santa Cruz Islands are most well known for their wooden figure sculpture, which are either free-standing statues, carved on architectural posts, or sculpted as details on utensils. Important secular art objects from the Santa Cruz Islands are based on male personal ornamentation, such as discoidal breast adornments constructed of tridacna shell with a turtle-shell cover cut in a geometric design, headdresses covered with painted bark cloth, and fiber armbands made with geometric patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santa Cruz Islands"@en .

aat:300021923 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the Solomon Islands. Eastern Solomon Islands primarily carved wooden artefacts and personal ornaments. Habitants of the Solomon Islands are known for their distictive decorative canoes. The people of the eastern Solomon Islands decorated their canoes with images of birds, fish, and other creatures, while the habitants of the western Solomon Islands utilized canoe carving, geometric pieces of seashells, and black paint as ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solomon Islands"@en .

aat:300021924 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Bougainville Islands. The people of Bougainville represent human and animal forms in naturalistic proportions and features, however human heads are also constructed in a canine-like style with the jaw protruded outward. Surfaces are often stained black and enhanced with inlaid patterns of red and white pigments. Decorative features in ceremonial structures are well known for demonstrating excellent carving techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bougainville"@en .

aat:300021925 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Buka Island. Changes in late 20th-century Buka art have their origins in the encounter between Pacific Islanders and the outside world. Whale hunters of the 1800s found the Buka paddles ideally suited to their work; as a result promoting the production of paddles by the Buka people. Lapita pottery and related materials have varied in style into the late 20th century. The people of Buka are known to represent human and animal forms in a naturalistic fashion, however human heads are also constructed in a canine-like style with the jaw protruded outward. Surfaces are often stained black and enhanced with inlaid patterns of red and white pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buka"@en .

aat:300021926 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of New Georgia Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Georgia Island"@en .

aat:300021927 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the island of San Cristobal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "San Cristobal"@en .

aat:300021928 a skos:Concept ;
    skos:definition "Describes the style and culture of inhabitants of the Pacific island group known as Micronesia. Traditional Micronesian art consisted of body painting and ornamentation, singing, dancing, and the recital of myths and poetry. Micronesians are well known for their communal architecture and canoe building. Contemporary Micronesian art forms have incorporated new materials, techniques, and subject matter in order to further develop their tourist trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Micronesian"@en .

aat:300021929 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Caroline Islands. The people of the Caroline Islands developed various art forms, such as canoe design, architecture, personal ornament, containers, tattoo, loom weaving and plait work; mostly objects of functional need and simplicity of form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caroline Islands"@en .

aat:300021930 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Republic of Palau. The people of the Republic of Palau are most known for their traditional and modern storyboards called bai. Bai are decorated inside and out, with sculpture and painting based on historical themes and symbols of fertility and sexual activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palauan"@en .

aat:300021931 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Chuuk Islands. The Chuuk people ornamented their wooden bowls, canoe bows, and stern pieces with stylized sea bird and fish designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chuuk Island"@en .

aat:300021932 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Yap Island. The people of Yap have various artistic traditions such as complex geometric tattoo patterns and single outrigger canoe designs. Contemporary artworks by the Yap people integrate new art materials, colors, methods, and subject matter in order to increase sales for the tourist trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yap"@en .

aat:300021934 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Aua Island. The Aua people are primarily known for their woodcarvings of human figures or heads, often containing crocodile and fish characteristics. These carvings are found on lime sticks, coconut shell ladles, eating utensils, spears, obsidian daggers, slit gongs, canoes, beds, and architectural features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aua"@en .

aat:300021935 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Kiribati Island. Most of the artwork created by the people of the Republic of Kiribati consists of patterns woven into the pandanus-leaf matting. The production of this work is used for sails, clothing, baskets, sitting mats, and sleeping mats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kiribati"@en .

aat:300021936 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Mariana Islands. Spanish conquerors destroyed most of the islands' native art in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marianas Islands"@en .

aat:300021940 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Republic of Marshall Islands. The Marshall Islanders are recognized for the creation of the outrigger canoe. Originally, three forms of canoes were created: the walap, a sailing canoe with the capability of carrying up to 100 passengers; the tipnol, carrying up to 20 passengers; and the korkor, a small canoe to be used within a lagoon. Other artworks produced by the Marshall Islanders include woven or plaited products for the craft market or domestic use and various tattoo designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marshallese"@en .

aat:300021942 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Wuvulu Island. The people of Wuvulu Island are primarily known for their woodcarvings of human figures or heads, often containing crocodile and fish characteristics. These carvings are found on lime sticks, coconut shell ladles, eating utensils, spears, obsidian daggers, slit gongs, canoes, beds, and architectural features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wuvulu Island"@en .

aat:300021944 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the Polynesian Islands. Art forms include traditional wood-carving, barkcloth, mat-making, tattoo, and other body arts. Polynesian art was greatly developed, but little of what existed has survived to the modern day due to the perishability of the utilized material - bark cloth, basketry, and featherwork. Although architecture was developed everywhere in Polynesia, only the ruined stone structures of the eastern Polynesian islands remain proof of the Polynesians' exceptional architectural skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polynesian"@en .

aat:300021946 a skos:Concept ;
    skos:definition "Describes the culture and nationality of the inhabitants of the Cook Islands. The people of the Cook Islands are known for their woodcarvings and sculpture, which were primarily used during traditional religious ceremonies. The sacred nature of the objects encouraged the carver to increase their durability in order to pass them on to future generations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cook Islands"@en .

aat:300021948 a skos:Concept ;
    skos:definition "Describes the style and culture of the Mangaian people of Mangaia Island. The Mangaian are well known for incising in every decorated object a K-motif, which was made up of a dense pattern of crosshatching combined with zigzags and concentric diamonds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mangaian"@en .

aat:300021949 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Easter Island. The art forms created by the people of the Easter Island include huge stone sculptures, portable paperbark figures, wood carvings, petroglyphs, and its thriving 20th-century art industry. Body decoration motifs used some of the same designs found on the petroglyphs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Easter Island"@en .

aat:300021953 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Gambier Islands. Few works of art created by the Gambier Islanders survive today due to their destruction by orders of missionaries in the 19th century. The few surviving sculptures and fragments demonstrate the sophistication of their craft, which is figuratively closer to European technique than the art of other Polynesian islands of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gambier Islands"@en .

aat:300021954 a skos:Concept ;
    skos:definition "Describes the style and culture of the Mangarevans. Few works of art created by the Mangaveran survive today due to their destruction by orders of missionaries in the 19th century. The few surviving sculptures and fragments demonstrate that the Mangareva figures are of a rectangular frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mangarevan"@en .

aat:300021955 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Hawaiian Islands. The arts of the Hawaiian people included feather work, bark cloth and ornaments; sculpture made of wood, stone, and feathers; rock carvings or petroglyphs; and wooden bowls, drums, and canoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hawaiian"@en .

aat:300021957 a skos:Concept ;
    skos:definition "Describes the style and culture of the Marquesan people of Marquesas Islands. The Marquesan people are known to highly specialize in particular art works or techniques, such as carving statues; clubs and fan handles; building houses and canoes; tattoo design; and making ornaments. The Marquesan people produced such highly exceptional tattoo design that it became common for men to tattoo their entire bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marquesan"@en .

aat:300021959 a skos:Concept ;
    skos:definition "Describes culture and works created by the inhabitants of New Zealand, particularly the modern nation of New Zealand"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Zealand"@en .

aat:300021960 a skos:Concept ;
    skos:definition "Describes the style and culture of the Maori aboriginal community, native inhabitants of modern New Zealand. Some of the more specialized forms of art for the Maori were architectural ornamentation, tattooing, dog skin and feather weaving and weaponry design. Since the islands settlement, their art has experienced much change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maori"@en .

aat:300021962 a skos:Concept ;
    skos:definition "Classic Maori describes a woodcarving style of the Maori people; the original inhabitants of New Zealand. The Classic Maori style is characterized as having a defined sculptural form whose surface is engraved with elaborate designs; this style is dated to around the beginning of the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Classic Maori"@en .

aat:300021963 a skos:Concept ;
    skos:definition "Describes the style and culture of the Samoan people of the Samoa Islands. Samoans exemplified exceptional artistic skills in the area of tattooing; canoe building and design; and bark cloth design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samoan"@en .

aat:300021966 a skos:Concept ;
    skos:definition "Describes the culture and nationality of the inhabitants of the Society Islands. The focus of most of their elaborate art forms was their cheif and the traditional religious ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Society Islands"@en .

aat:300021967 a skos:Concept ;
    skos:definition "Describes the style and culture of the Tahitian people from Tahiti Island. The Tahitian people valued elegant and simple lines in their various types of artwork. It was customary for all Tahitian people to be tattooed distinguishing designs. They were utilized to visually state age and the social ranking of individuals. The tattoo designs were simple and contained bold geometric designs. The area of the buttocks was the most frequently tattooed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tahitian"@en .

aat:300021970 a skos:Concept ;
    skos:definition "Describes the style and culture of the Tongan people from the Republic of Tonga. Tongan people exemplify their artistic skills in the area of basketry, woodcarving, figurative sculpture, and bark cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tongan"@en .

aat:300021975 a skos:Concept ;
    skos:definition "Describes the culture and nationality of the inhabitants of the Austral Islands. Body decoration was very popular with the people of the Austral Islands, specifically shell jewelry, necklaces, grass skirts, earrings, and breast ornaments made from pearl shells combined with string made of human hair. They also created highly crafted sculpture and carved artwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austral Islands"@en .

aat:300021992 a skos:Concept ;
    skos:definition "Collective term referring to the various schools of Buddhism that have flourished in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese Buddhism"@en .

aat:300021993 a skos:Concept ;
    skos:definition "A school of Chinese Buddhism probably dating to the 6th century that combines Mahayana teachings with those of Taoism to form a belief system emphasizing a meditative rather than an intellectual approach to enlightenment. It is closely related to Zen. The term can also be used to generally refer to meditation in Chinese Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ch'an"@en .

aat:300021995 a skos:Concept ;
    skos:definition "Refers to the school of Buddhism said to have been founded by the Chinese monk Hui Yuan (334-417) which became one of the most popular forms of Mahayana. Pure Land Buddhism advocates devotion to the bodhisattva Amitabha, who rules over a 'pure land.' Devotion to Amitabha can ideally lead to rebirth and enlightenment in this pure land. Pure Land Buddhism spread to Japan where it broke away from the main school and goes by the name Jōdo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pure Land Buddhism"@en .

aat:300022000 a skos:Concept ;
    skos:definition "Collective term referring to the various schools of Buddhism that have flourished in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese Buddhism"@en .

aat:300022002 a skos:Concept ;
    skos:definition "A school of Pure Land Buddhism in Japan which focuses on the mercy and power of Amida Buddha, the Buddha of infinite light and deep compassion. It is by the grace of Amida that one can be reborn into Amida's paradise or Pure Land, and from there one can eventually attain nirvana. The school was founded in 1175 by Honen, who emphasized the practice of 'nembutsu,' the repeated calling upon the name of Amida Buddha. Jodo is the second largest school of Pure Land in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jodo"@en .

aat:300022004 a skos:Concept ;
    skos:definition "A Japanese school of esoteric and mystical Buddhism which was brought to Japan from China in 806 by Kukai. A key text of Shingon is Kukai's 'Jewel Key to the Store of Mysteries (Hizoboyaku)' in which spiritual attainment through Shingon is seen as fulfilling nine other spiritual paths found in Buddhism and other religions. Shingon places importance on the Vairocana Buddha, the Buddha of infinite light, and on mandalas and other forms of sculpture and painting. There are over forty schools of Shingon in Japan today and aspects of Shingon have been adopted by other forms of Japanese Buddhism as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shingon"@en .

aat:300022005 a skos:Concept ;
    skos:definition "A Japanese school of Buddhism that includes aspects of Shingon and Shinto. it is named after the Tien Tai school of Chinese Buddhism , in 805 introduced in Japan by Saicho at his Enryakuji temple on Mount Hiei near Kyoto. The teachings focus on the 'Lotus Sutra' and the belief that all forms of life can equally attain Buddhahood. Many popular branches of Buddhism arose within Tendai, including Pure Land, Zen, and Nichiren."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tendai"@en .

aat:300022006 a skos:Concept ;
    skos:definition "A school of meditative Buddhism introduced to Japan in the 12th century by monks returning from China. Originating in India, it spread to China where elements of Taoism were added. Zen emphasizes simple meditation that avoids ritual as well the personal experience of enlightenment attained through a life lived close to nature. There are two main branches of Zen in Japan: Rinzai and Soto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zen"@en .

aat:300022010 a skos:Concept ;
    skos:definition "Name applied by followers of Mahayana Buddhism to the ancient, more orthodox schools of Buddhism predating the rise of Mahayana ideas. Although the name reflects the Mahayanists' evaluation of their own traditions as a superior model, surpassing other schools in its universal benevolence, it is not used by the conservative schools as a proper term referring to the common tradition of Buddhism. Modern upholders of the ancient Hinayana tradition are called Theravadins (followers of the Way of the Elders) and practice Theravada Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hinayana"@en .

aat:300022012 a skos:Concept ;
    skos:definition "The form of Buddhism practiced in the South Asian countries of Sri Lanka, Burma, Cambodia, Thailand, and Laos. Its doctrine, relatively unchanged since the 3rd century BCE, is based on the 'tipitaka' or Pali Canon and consists of a conservative interpretation of the Buddha's teachings. Theravada's main distinction from later Mahayana is its rejection of bodhisattvas. While the ultimate goal of Theravada is to become a 'perfected saint' or 'arhat,' lay believers cannot attain true enlightenment. True enlightenment is only reached by entering religious orders and even then it is nearly impossible for anyone to become a Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theravada"@en .

aat:300022014 a skos:Concept ;
    skos:definition "Refers to the version of Buddhism that originated in India and spread to Central Asia, China, Japan, mainland Southeast Asia, Java, Sumatra, and Sri Lanka (Abhayagiri monastery). It is often characterized as the pan-Asiatic form of Buddhism, involving widely-accepted basic shifts in the original Buddhist doctrine and approach. This form of Buddhism discredits the existence of the self and the presence of dharmas, and challenges the idea that the Buddha comes exclusively from an elite lineage (arhat), substituting in its place the idea of the bodhisattva, someone who possesses the innate tendency to become Buddha, a disposition inherent in all persons. This form of Buddhism values benevolence and service to others above all else and advocates the struggle for internal peace and supreme wisdom (prajna) through the nullification of the self and struggle toward an ultimate reality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahayana"@en .

aat:300022016 a skos:Concept ;
    skos:definition "Refers to the religious movement and doctrine that flourished from the 6th to the 11th century, embodying both the Yogacara discipline that emphasizes the ultimacy of the mind and the Madhyamika philosophy that emphasizes the rejection of any relativistic principle. This form of Buddhism also marks the transition from Mahayana speculative, abstract thought to the practical application of Buddhist ideas to everyday life. The first part of the term, 'vajra', alludes to the Sanskrit for 'diamond' or 'thunderbolt' and signifies the absolutely real and permanent in an individual; 'yana' refers to the spiritual pursuit of the valuable and impervious. This form of Buddhism emphasizes the use of the mantra as a way to purify and focus the mind, featuring symbolic language in its scripture that purports to evoke an experience similar to Gautama Buddha's Enlightenment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vajrayana"@en .

aat:300022019 a skos:Concept ;
    skos:definition "Refers to the conservative Anabaptist sect led by Jakob Amman that separated from the Mennonites in Switzerland around 1693. The development of more liberal sects occurred after many Amish migrated to the United States, particularly in the 1870s. Only the Old Order Amish (founded 1720-1740) still maintain Amman's strict dress codes, customs, and policy of non-cooperation with the state. Today, the Amish exist mainly in southeastern Pennsylvania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amish"@en .

aat:300022022 a skos:Concept ;
    skos:definition "Oriental Orthodox Christian religion of predominantly Muslim Egypt. Egyptians before the Arab conquest of the 7th century identified themselves and their language as Aigyptios in Greek (Westernized as Copt) and later when Egyptian Muslims stopped calling themselves Aigyptioi, the term became the distinctive name of the Christian minority. Since the 5th century these Christians have been Monophysites, meaning that they acknowledge only one nature in Christ. Apart from the Monophysite question, the Coptic and the Eastern Orthodox churches agree regarding doctrine. Services are almost entirely conducted in Arabic and the service books, using the liturgies attributed to St. Mark, St. Cyril of Alexandria, and St. Gregory of Nazianzus, are written in Coptic (the Bohairic dialect of Alexandria), with the Arabic text in parallel columns. After the 1890s the church devised a democratic system of government, led by the patriarch who lives in Cairo. Outside of Egypt, there are a few Coptic Orthodox churches in the Holy Land and a Coptic bishopric in Khartoum, Sudan. The Ethiopian, Armenian, and Syrian Jacobite churches are in communion with the Coptic Orthodox Church. There is an impressive body of Coptic religious art and the church is known for its vital system of schools. There are over three million Copts and, although a minority, are well represented in Egyptian professional life. Copts have suffered and continue to suffer occasional persecution. With reference specifically to the Early Medieval period in Egypt, use \"Coptic (period).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coptic"@en .

aat:300022023 a skos:Concept ;
    skos:definition "Refers to French Protestants of the 16th and 17th centuries. After the Reformation began in Germany in 1517, it quickly spread to France, where it was particularly popular in areas that were economically depressed and populated by people who had grievances against the government. Although their numbers dwindled due to persecution and emigration, Huguenots were granted religious freedom with the French Revolution and the National Assembly in 1789. The Reformed Church of France, organized in 1938, merged a number of Reformed groups that had developed in France during and after the 16th-century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huguenot"@en .

aat:300022024 a skos:Concept ;
    skos:definition "An Oriental Orthodox Christian religion based in the Eastern Mediterranean. By tradition it derives from an early Christian community established in Antioch by St. Peter the Apostle. It uses the oldest surviving liturgy in Christianity, the Liturgy of St. James the Apostle, which is celebrated in Syriac, a dialect of Aramaic spoken by Jesus and the apostles. The church is led by the Syriac Orthodox Patriarch of Antioch. The group has historically been called \"Jacobites\" after St. Jacob Baradaeus, bishop of Edessa, who organized their community in the 6th century; however, they reject that name because they trace their beginnings instead to St. Peter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syriac Orthodox"@en .

aat:300022030 a skos:Concept ;
    skos:definition "A Christian community that arose in 7th-century Syria, claiming its origins in St. Maro, a Syrian hermit of the late 4th and early 5th centuries. It is one of the largest Eastern-rite communities of the Roman Catholic Church, being particularly popular in modern Lebanon, and it is the only Eastern-rite church that has no non-Catholic or Orthodox counterpart. In 680 the Maronites were condemned for their supposed Monothelite beliefs: accepting the heretical doctrine of Sergius, patriarch of Constantinople, who stated that Christ had divine but no human will. The Maronites, however, assert that they have always been orthodox Christians. Communion with the Roman Catholic Church was begun in 1182 and was further solidified in the 16th century with aid from the Jesuit community. After the pope, the spiritual head of the Maronites is the \"patriarch of Antioch and all the East,\" residing in Bkirki, near Beirut. Over the centuries and under various ruling bodies, the Maronites have managed to preserve their freedom, religion, and folk customs. The church retains the ancient West Syrian liturgy, even though Arabic is the vernacular language of the Maronites. Fearful of persecution, Maronites in the 19th century emigrated to southern Europe and North and South America where they can still be found today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maronite"@en .

aat:300022031 a skos:Concept ;
    skos:definition "Originally used by the Syrian Monophysites and Nestorians, and later Muslims, to refer to Eastern Christians who remained faithful to the ruling of the Council of Chalcedon of 451 (affirming the two natures, divine and human, of Christ) when most Christians became Monophysite. The name was originally a pejorative one, referring to fact that they theologically agreed with the Byzantine emperor (Melchites meaning 'Royalists' or 'Emperor's Men'). In later use, the term refers to those orthodox Eastern Christians who follow an Arabic version of the Greek ritual, and particularly to those who are united to the communion of the Roman Catholic Church while retaining their separate organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melchite"@en .

aat:300022033 a skos:Concept ;
    skos:definition "Christian sect originating in Asia Minor and Syria that follows the beliefs of Nestorius, a 5th-century bishop of Constantinople whose doctrine was considered heretical by the established church. Nestorius stressed the independence of the divine and human natures of Christ and, in effect, suggested that they were two persons loosely united. Current members live in Iraq, Syria, and Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nestorian"@en .

aat:300022034 a skos:Concept ;
    skos:definition "The branch of Christianity that formed from the gradual estrangement among Church authorities in the early centuries of Christianity and from the political upheavals between the Eastern Roman, or Byzantine, Empire and the Holy Roman Empire. The schism intensified in 1054 between Rome and Constantinople, and while Western theology remained under the influence of Augustinian ideas, Eastern theology continued to be shaped by the Greek Fathers. Orthodox theology values the authority of local church centers like Rome, Alexandria, Antioch, and Constantinople that are governed by head bishops, rather than the authoritarian, apostolic centrality honored in Western theology. It also contends that the individual is not an autonomous being but rather human nature is defined by a relationship to God; thus, sin implies separation from God, and the aim of good Christians, according to Orthodox ideology, is communion with God."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orthodox Eastern"@en .

aat:300022041 a skos:Concept ;
    skos:definition "Refers to the period of the religious revolution that took place in the Christian church of central and northwestern Europe in the 16th century, having as its object the reform of the doctrines and practices of the Roman Catholic Church, and which became the basis for Protestantism. Its style is dictated by a shift in patronage from the church to the laity, and in subject matter from the lives of saints and other Catholic themes to ones relating more directly to the common man, particularly landscapes, still lifes, portraits, Hebrew Biblical and certain Christian Biblical themes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reformation"@en .

aat:300022045 a skos:Concept ;
    skos:definition "Refers to the period of the movement toward internal renewal in the Roman Catholic Church following and in opposition to the Protestant Reformation in the 16th and early 17th centuries in Europe, beginning from the pontificate of Paul III (1534-49) and the first Council of Trent (1545). Its style is dictated by an intense authoritarian religiosity, and characterized by a sense of gloom and foreboding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Counter-Reformation"@en .

aat:300022047 a skos:Concept ;
    skos:definition "Refers to a Christian millenarian sect that arose in 1747 in England out of a group of radical Quakers that had adopted the French Camisards' ritual practices of shaking, shouting, dancing, whirling, and singing in tongues; the sect was later spread to the United States by Ann Lee and her disciples. The sect advocates communal living, productive labor, and celibacy. Shaker communities in the United States flourished economically and created a distinctive and influential style of architecture, furniture, and handicraft before the sect declined in the late 19th and 20th centuries. Shaker dances and songs are also admired as folk art and the Shakers are responsible for numerous important inventions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shaker"@en .

aat:300022082 a skos:Concept ;
    skos:definition "The indigenous Japanese religious beliefs and practices as distinguished from Buddhism, which had been introduced into Japan in the sixth century. In general, it is characterized by its lack of official sacred scripture and specific formal dogma and by the veneration of small images set in particular Shinto shrines. The religious system is categorized into three interconnected sects: Shrine Shinto (Jinja Shinto), which constitutes the main currents of Shinto tradition; State Shinto (Kokka Shinto), based on the unification of religion and state and practiced by the Japanese Imperial family; and Sect Shinto (Kyoha Shinto), a movement consisting of sects that originated in Japan around the 19th century and after World War II, each organized by a founder into religious associations in which members are known as parishioners (ujiko) of a particular shrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shinto"@en .

aat:300022099 a skos:Concept ;
    skos:definition "Refers to the movement in American painting, centered mainly in New York, that flourished in the 1940s and 1950s. Incorporating theories of Surrealism, Synthetic Cubism, and Neo-Plasticism, styles ranged from spontaneous, gestural compositions that paid attention to the qualities of the painting materials and stood as records of the painting process, to contemplative, near monochromatic works featuring large areas of color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abstract Expressionist"@en .

aat:300022105 a skos:Concept ;
    skos:definition "French painting similar to American Action Painting, including that of the late 1940s sometimes called Abstraction Lyrique. Use \"Lyrical Abstraction\" for the continuation of Abstract Expressionism into the 1960s and 1970s (e.g., Guston, Frankenthaler)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tachiste"@en .

aat:300022107 a skos:Concept ;
    skos:definition "Refers to the style named by Elaine de Kooning to describe works painted with uniform brushstrokes that retain the optical qualities of Impressionism, but eliminate the representational content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abstract Impressionist"@en .

aat:300022108 a skos:Concept ;
    skos:definition "An art form popular in the 1950s consisting of layers of posters with parts torn away; for the process or art of making them, use \"d00ecollage.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "affiches lacérées"@en .

aat:300022160 a skos:Concept ;
    skos:definition "Refers to a style of Austrian painting that appeared in Vienna around 1945. The style is characterized by the influence of old masters such as Pieter Brueghel the elder and Jan Van Eyck, featuring combinations of fantastic images rendered in minute detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fantastic Realist"@en .

aat:300022168 a skos:Concept ;
    skos:definition "Refers to the international avant-garde art and literary movement begun officially in 1962, and active throughout the 1960s and 1970s. Taking its name from the Latin word for \"flowing,\" the movement advocated purging the world of bourgeois, commercial, and professional art. Their activities included public concerts or festivals and the dissemination of innovatively designed anthologies and publications, including scores for electronic music, theatrical performances, ephemeral events, gestures and actions constituted from the individual’s everyday experience. Other types of work included the distribution of object editions, correspondence art and concrete poetry. According to the directions of the artist, Fluxus works often required the participation of a spectator in order to be completed. The artifacts from Fluxus works may be collected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fluxus"@en .

aat:300022175 a skos:Concept ;
    skos:definition "Refers to the paintings of a group of West Coast artists working in the 1960s. Named by critic Jules Langsner in 1959, the style is characterized by the use of large shapes with sharp outlines that extend across the canvas from edge to edge, painted in two or three saturated hues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hard-edge"@en .

aat:300022176 a skos:Concept ;
    skos:definition "Refers to the European movement in painting, which, begining around 1945, ran parallel with Abstract Expressionism in North America. The style is characterized by a more lyrical, improvised approach to abstraction based on subconscious fantasy, in contrast to the more structured tendencies in Abstract Expressionism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Art Informel"@en .

aat:300022180 a skos:Concept ;
    skos:definition "Refers to the international avant-garde art and poetry movement based in Paris and begun by Romanian writer Isidore Isou in 1945. In the visual arts, the style is characterized by the use of letters, numbers, and signs as motifs, rather than elements of language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lettrist"@en .

aat:300022187 a skos:Concept ;
    skos:definition "Refers to the style of painting and sculpture inspired by the Dada movement, and first seen in the works of artists Jasper Johns and Robert Rauschenberg in the late 1950s. The style is characterized by the use of ready-made motifs such as flags, maps, and numbers, popular images such as comic strips, and mass media images. The style has been seen as the prototype to Pop Art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Dada"@en .

aat:300022189 a skos:Concept ;
    skos:definition "Refers to the style of art, predominantly of painting, inspired by German Expressionism that gained popularity in Italy, Germany, and America in the late 1970s and early 1980s. The style is characterized by large, figurative works, crudely and rapidly painted, often with objects imbedded in their surfaces, such as broken plates or straw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Expressionist"@en .

aat:300022191 a skos:Concept ;
    skos:definition "Refers to the style of painting popular in the early 1960's in Paris, London and New York. Reacting against Absract Expressionism, the style is characterized by a return of figurative images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Figuration"@en .

aat:300022194 a skos:Concept ;
    skos:definition "Mode of thought originating in the late 1950s, especially among French filmmakers such as Louis Malle, François Truffaut, Alain Resnais, and Jean-Luc Godard. The movement is most known for its theories based on the idea that directors that dominated their films became the film's author and creator. The style features innovations in film editing such as scene changes set in rapid sequence, or 'jump cuts', that produce disconcerting, disjunctive effects in the overall narrative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "new wave"@en .

aat:300022195 a skos:Concept ;
    skos:definition "Refers to the international art movement that flourished in Europe and America in the mid-1960s. The style is charcterized by the careful manipulation of bold, sharply contrasting shapes and colors in order to create vitural movement, vibration, or chromatic tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Op art"@en .

aat:300022198 a skos:Concept ;
    skos:definition "Movement of Matisse-influenced decorative painting in New York in the 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pattern painting"@en .

aat:300022201 a skos:Concept ;
    skos:definition "Refers to the international movement in painting and sculpture that became popular in the late 1960s and early 1970s. The style is characterized by the precise, objective rendering of subject matter, often street scenes or portraits, taken from actual photographs or direct casts from human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Photorealist"@en .

aat:300022205 a skos:Concept ;
    skos:definition "Refers to the international art and cultural movement that flourished in Britain and America in the 1950s and 1960s. Influenced by Dada, the movement advocated the use of everyday imagery, such as advertisements, signs, and comic strips, executed in the techniques and graphic styles of mass media. The movement respresented a move toward a more objective, immediate art form after the dominance of Abstract Expressionism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pop"@en .

aat:300022209 a skos:Concept ;
    skos:definition "Refers to art in which the process of creating it becomes the subject matter, first applied to the practice in Action Painting and Tachisme in the 1940s and 1950s, and later to the work of a group of artists working in the late 1960s. The style is characterized by the introduction of time, change, and chance, often resulting in documentation about the artwork's creation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Process art"@en .

aat:300022218 a skos:Concept ;
    skos:definition "Term coined by critic Achille Bonito Oliva to refer to a trend in Italian art, especially painting, of the late 1970s and early 1980s that embraced hand craftsmanship and the pleasure of execution, and that rejected processes aimed at conceptual abstraction. Hallmarks of this movement often included a pastiche of art-historical references. These trends roughly corresponded with Neo-Expressionist tendencies in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trans-avantgarde"@en .

aat:300022242 a skos:Concept ;
    skos:definition "Tools or physical resources used for the action of framing, devising, or forming, by the putting together of parts, especially for the process of erecting buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction equipment"@en .

aat:300022248 a skos:Concept ;
    skos:definition "Refers to the temporary framework used to support a structure under construction until it is self-supporting. Distinct from \"scaffolds,\" which are temporary structures for holding workers and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falsework"@en .

aat:300022249 a skos:Concept ;
    skos:definition "Frameworks or overhead structures of beam or timber; used as a working platform or as a means of support equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gantries"@en .

aat:300022250 a skos:Concept ;
    skos:definition "Rounded, heavy, metal or concrete demolition devices swung on a cable from the boom of a crane to break through concrete or masonry constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrecking balls"@en .

aat:300022254 a skos:Concept ;
    skos:definition "Hand-held pneumatically powered drills which hammer and rotate a bit or chisel; used for drilling rock or breaking up concrete, asphalt, or paving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackhammers"@en .

aat:300022257 a skos:Concept ;
    skos:definition "Machines used for driving piles, which are columns serving as subsurface supports for vertical loads, usually by repeated blows from free-falling or driven \"pile hammers.\" Pile drivers comprise a framework for holding and guiding the pile, a hammer, and a power source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile drivers"@en .

aat:300022259 a skos:Concept ;
    skos:definition "Temporary elevated platforms or structures for supporting workmen, materials, and tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaffolds"@en .

aat:300022262 a skos:Concept ;
    skos:definition "Scaffolding supported by metal brackets which are temporarily attached to a building or column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracket scaffolding"@en .

aat:300022264 a skos:Concept ;
    skos:definition "Scaffolding composed of framed wood squares which support a platform; limited to light and medium duty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bricklayers' scaffolding"@en .

aat:300022265 a skos:Concept ;
    skos:definition "Scaffolds erected so as to bridge the ridge of a roof; usually used during chimney repair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle scaffolds"@en .

aat:300022267 a skos:Concept ;
    skos:definition "Scaffolding supported by cables or metal straps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspended scaffolding"@en .

aat:300022269 a skos:Concept ;
    skos:definition "Braced framework, usually consisting of a horizontal beam supported at each end by a pair of spreading legs which serve as braces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trestle scaffolds"@en .

aat:300022273 a skos:Concept ;
    skos:definition "Equipment used for the compaction of soil on construction sites, or for compressing pavement in the construction of roadways. This equipment is most often in the form of a metallic or pneumatic roller, or an impact or vibrational device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compacting equipment"@en .

aat:300022274 a skos:Concept ;
    skos:definition "Machines that use weight, vibration, or a combination of both, to achieve compaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compactors"@en .

aat:300022275 a skos:Concept ;
    skos:definition "Compaction devices for consolidating a granular material such as soil, backfill, or unformed concrete; usually powered by a motor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tampers"@en .

aat:300022276 a skos:Concept ;
    skos:definition "Power-driven tools used to compact soil or other granular material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rammers"@en .

aat:300022277 a skos:Concept ;
    skos:definition "Heavy, self-propelled or towed devices used to compact granular fill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rollers"@en .

aat:300022278 a skos:Concept ;
    skos:definition "Self-propelled or towed drumlike rollers with projecting studs that penetrate the surface of the ground; used to obtain deep compaction of fill material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheepsfoot rollers"@en .

aat:300022279 a skos:Concept ;
    skos:definition "Steam-driven road rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steamrollers"@en .

aat:300022281 a skos:Concept ;
    skos:definition "Units of two rollers of equal diameter placed one behind the other on the same track."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tandem rollers"@en .

aat:300022282 a skos:Concept ;
    skos:definition "Various equipment used in construction, landscaping, firefighting, and many other contexts to redistribute, grade, or process large volumes of raw earth, sand, or gravel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthmoving equipment"@en .

aat:300022285 a skos:Concept ;
    skos:definition "Tractors with caterpillar treads, used to push away debris for clearing an area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulldozers"@en .

aat:300022287 a skos:Concept ;
    skos:definition "Bulldozers with blades are set on an angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angledozers"@en .

aat:300022289 a skos:Concept ;
    skos:definition "Tractors equipped with a front-mounted bucket that can be used for pushing, digging, and truck loading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shovel dozers"@en .

aat:300022290 a skos:Concept ;
    skos:definition "Bulldozers whose blades can be pivoted on a horizontal center pin to cut down on either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilting dozers"@en .

aat:300022291 a skos:Concept ;
    skos:definition "Engine-driven vehicles that travel on segmented roller-chain tracks designed to reduce ground pressure and increase traction in loose footing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crawler tractors"@en .

aat:300022294 a skos:Concept ;
    skos:definition "Equipment used in the removal of earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excavating equipment"@en .

aat:300022296 a skos:Concept ;
    skos:definition "Excavating machines used for cutting trenches with a boom-mounted bucket which is drawn through the ground toward the machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backhoes"@en .

aat:300022299 a skos:Concept ;
    skos:definition "Tools used for digging post holes, especially those operated from the power takeoff on a tractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post-hole diggers"@en .

aat:300022301 a skos:Concept ;
    skos:definition "Self-propelled machines with a side-mounted shovel or chain of buckets; used to excavate trenches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trenching machines"@en .

aat:300022307 a skos:Concept ;
    skos:definition "Multipurpose earthworking machines having a single, centrally located blade that can be lifted from either end and angles so as to cast to either side; used mostly for leveling and crowning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graders"@en .

aat:300022311 a skos:Concept ;
    skos:definition "Construction machines having a bucket, located on the front of the vehicle, which can be raised, lowered, or tilted; used to push or transport earth, crushed stone, or other construction materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loaders"@en .

aat:300022312 a skos:Concept ;
    skos:definition "Tractor-drawn devices with protruding teeth; used to penetrate and disrupt the earth's surface up to 3 feet in depth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rippers"@en .

aat:300022313 a skos:Concept ;
    skos:definition "Machines or attachments for a tractor or grader having a long tooth or series of teeth that can be lowered to tear up surface soil or pavement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarifiers"@en .

aat:300022315 a skos:Concept ;
    skos:definition "Large shovels, typically mounted on a vehicle, to be used in construction, landscaping, firefighting, and many other contexts to dig holes, redistributing large volumes of raw earth, sand, or gravel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthmoving shovels"@en .

aat:300022317 a skos:Concept ;
    skos:definition "Self-propelled, power-operated machines used to excavate or load soil or debris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power shovels"@en .

aat:300022318 a skos:Concept ;
    skos:definition "Power shovels operated by steam from an integral boiler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam shovels"@en .

aat:300022321 a skos:Concept ;
    skos:definition "Wheeled or tracked vehicles resembling tractors with a front-mounted bucket or scoop; used in construction to load or move heavy, loose materials from one place to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucket loaders"@en .

aat:300022322 a skos:Concept ;
    skos:definition "Mobile loaders that use a series of small buckets on a roller chain to elevate excavated dirt or rock to the dumping point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain bucket loaders"@en .

aat:300022323 a skos:Concept ;
    skos:definition "Attachments for a materials-handling or excavating machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckets"@en .

aat:300022324 a skos:Concept ;
    skos:definition "Buckets used on cranes or derricks for handling granular materials. Their jaw-like halves close and open by cable or hydraulic action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clamshell buckets"@en .

aat:300022326 a skos:Concept ;
    skos:definition "Type of bucket used on any of several kinds of excavating equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dippers"@en .

aat:300022327 a skos:Concept ;
    skos:definition "Bucket attachments for cranes; used for removing earth by pulling the bucket toward the crane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragline buckets"@en .

aat:300022329 a skos:Concept ;
    skos:definition "Machines for lifting men or materials on a platform at the end of an extendable boom, usually mounted on a carrier with wheels to provide mobility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherry pickers"@en .

aat:300022331 a skos:Concept ;
    skos:definition "Machines for raising, shifting, or lowering heavy weights, usually by means of a projecting swinging arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cranes"@en .

aat:300022332 a skos:Concept ;
    skos:definition "Cranes used in manufacturing or assembling heavy objects, composed of a bridge spanning two overhead rails and a hoisting device which moves laterally along the bridge. The bridge can move longitudinally along the rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridge cranes"@en .

aat:300022333 a skos:Concept ;
    skos:definition "Hoisting devices consisting of a horizontal boom, equipped with a winch and hoist line, and swung from the top of the vertical mast; used in the erection of high-rise buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climbing cranes"@en .

aat:300022334 a skos:Concept ;
    skos:definition "Cranes consisting of a rotating superstructure with power plant, operating machinery, and boom mounted on a base equipped with crawler treads for travel; used to hoist and swing loads at various radii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crawler cranes"@en .

aat:300022335 a skos:Concept ;
    skos:definition "Fixed or moveable cranes that project over the side of a ship or over a hatchway; used especially for hoisting ships' boats, anchors, or cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "davits"@en .

aat:300022341 a skos:Concept ;
    skos:definition "Revolving cranes situated atop a heavy framework which moves along the ground on tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gantry cranes"@en .

aat:300022342 a skos:Concept ;
    skos:definition "Cranes that consist of a rotating superstructure and boom mounted on a base or car equipped for travel on railroad tracks; used to hoist and swing loads at various radii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locomotive cranes"@en .

aat:300022343 a skos:Concept ;
    skos:definition "Type of crane consisting of a fixed vertical mast which is topped by a rotating boom, equipped with a winch for hoisting and lowering loads and placing them at any location within the diameter of the boom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower cranes"@en .

aat:300022344 a skos:Concept ;
    skos:definition "Tower cranes which are mounted on crawlers, rubber tires, or rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling cranes"@en .

aat:300022346 a skos:Concept ;
    skos:definition "Materials-handling machines consisting of a crane which is mounted on a truck-type vehicle to provide mobility and maneuverability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truck cranes"@en .

aat:300022348 a skos:Concept ;
    skos:definition "Cranes with a horizontal arm supported from a wall or columns of a building. The arm may also support a trolley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall cranes"@en .

aat:300022349 a skos:Concept ;
    skos:definition "Cranes that consist of a rotating superstructure with power plant, operating machinery, and boom mounted on a mobile base or platform. Their function is to hoist and swing loads at various radii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel-mounted cranes"@en .

aat:300022351 a skos:Concept ;
    skos:definition "Wood or metal containers, usually V-shaped with a long handle and having one end open, used in masonry work to carry plaster or lime putty to the mortarboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hods"@en .

aat:300022352 a skos:Concept ;
    skos:definition "Appliances or apparatuses designed to lift, transfer, or load construction materials from one location to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoisting machinery"@en .

aat:300022353 a skos:Concept ;
    skos:definition "Devices consisting of a vertical mast and a horizontal or sloping boom operated by cables to a separate engine or motor; used for hoisting and moving heavy loads or objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "derricks"@en .

aat:300022356 a skos:Concept ;
    skos:definition "A derrick whose mast is held upright by guy cables attached to the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guy derricks"@en .

aat:300022357 a skos:Concept ;
    skos:definition "Small, portable derricks guyed by ropes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole derricks"@en .

aat:300022359 a skos:Concept ;
    skos:definition "Derricks without a boom whose mast can lean in any direction. Loads are raised and lowered by ropes threaded through the top of the mast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gin poles"@en .

aat:300022360 a skos:Concept ;
    skos:definition "Any mechanical devices for lifting loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoists"@en .

aat:300022361 a skos:Concept ;
    skos:definition "Mechanisms or apparatus as ropes and pulley blocks; used for hoisting, lowering, and shifting objects or materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block and tackle"@en .

aat:300022362 a skos:Concept ;
    skos:definition "Portable ratcheting winches consisting of a fastening device on one end and a hook attached to a cable at the other end. Operating a lever turns a drum which takes up the cable and exerts a pulling force on the hook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "come-alongs"@en .

aat:300022365 a skos:Concept ;
    skos:definition "Simple lifting devices consisting of a vertical pole, tripod, or other frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gins"@en .

aat:300022367 a skos:Concept ;
    skos:definition "Stationary hoisting machines having a rotating drum around which a cable, rope, or chain is wrapped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winches"@en .

aat:300022369 a skos:Concept ;
    skos:definition "Devices used to lift heavy objects, usually consisting of a horizontal drum turned by a lever or crank. A cable runs from the object over a pulley to the drum where lengths of cable are wound or unwound to move the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "windlasses"@en .

aat:300022372 a skos:Concept ;
    skos:definition "Open-topped motor trucks having a body that can be tilted to discharge its contents, usually loose materials, through an open tailgate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dump trucks"@en .

aat:300022374 a skos:Concept ;
    skos:definition "Small trucks with two power-operated prongs at the front that can be slid under heavy loads and then raised for transporting or stacking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forklift trucks"@en .

aat:300022376 a skos:Concept ;
    skos:definition "Frames, usually of wood or metal, consisting of two side pieces called stiles which are connected by crosspieces, usually round, called rungs; used as a means of climbing up or down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladders"@en .

aat:300022377 a skos:Concept ;
    skos:definition "Extension ladders capable of reaching very high places; often mounted on a vehicle such as a fire truck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial ladders"@en .

aat:300022378 a skos:Concept ;
    skos:definition "Similar to the single-cleat ladders, but wider, with an additional center rail which allows for two-way traffic of workmen ascending and descending."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-cleat ladders"@en .

aat:300022379 a skos:Concept ;
    skos:definition "Ladders comprising more than one section, each of which slides within the other and locks on the other, thus allowing lengthening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extension ladders"@en .

aat:300022381 a skos:Concept ;
    skos:definition "Non-self-supporting portable ladders, nonadjustable in length, consisting of two or more sections so constructed that the sections may be combined to function as a single ladder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectional ladders"@en .

aat:300022382 a skos:Concept ;
    skos:definition "Self-supporting portable ladders, nonadjustable in length, consisting of two sections hinged at the top to form equal angles with the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trestle ladders"@en .

aat:300022383 a skos:Concept ;
    skos:definition "Rollers comprising tubes with a fiber surface, that are mounted on a roller and handle, and used to apply paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint rollers"@en .

aat:300022385 a skos:Concept ;
    skos:definition "Brushes designed for applying paint over large or relatively large areas as a coating. For small brushes made to be handled with precision in applying paint or ink, see \"artists' brushes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paintbrushes"@en .

aat:300022387 a skos:Concept ;
    skos:definition "Brushes with a reservoir in their handle for ink or paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fountain brushes"@en .

aat:300022390 a skos:Concept ;
    skos:definition "Devices or machines for metering granular material such as gravel or crushed stone, from a feed hopper and distributing it over a given area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spreaders"@en .

aat:300022391 a skos:Concept ;
    skos:definition "Scrapers with a wide flat blade; used primarily for cleaning walls of wallpaper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall scrapers"@en .

aat:300022393 a skos:Concept ;
    skos:definition "General term for tools and equipment used for bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinding tools"@en .

aat:300022396 a skos:Concept ;
    skos:definition "Pincers with broad flat jaws used for applying pressure to bands during the book covering process, especially for nipping up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "band nippers"@en .

aat:300022397 a skos:Concept ;
    skos:definition "Machines used to sew sheets and bands of books together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book-sewing machines"@en .

aat:300022398 a skos:Concept ;
    skos:definition "Heavy metal blocks used for ensuring that all parts of the book align correctly. The grip of the iron can be clamped into a press so that the edges of the book can be knocked firmly against the flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knocking-down irons"@en .

aat:300022399 a skos:Concept ;
    skos:definition "Presses of various designs and used for various purposes in bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinding presses"@en .

aat:300022400 a skos:Concept ;
    skos:definition "Presses used for stamping designs on a book cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blocking presses"@en .

aat:300022402 a skos:Concept ;
    skos:definition "Presses, often screw presses, having a platen and base held together under pressure; used to apply even pressure on newly bound books as they dry. For presses of similar design, but allowing a tighter pressure of platen and base to make copies from single sheets, use \"copy presses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book presses"@en .

aat:300022405 a skos:Concept ;
    skos:definition "Relatively small vertical presses used to apply quick uniform pressure; consisting of a fixed iron or steel base and a moveable platen that is raised and lowered by means of a long vertical screw. Originally designed to copy letters, but also used for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nipping presses"@en .

aat:300022406 a skos:Concept ;
    skos:definition "Heavy vertical presses used for pressing newly bound books, pressure being applied by lowering a platen by means of a long central screw, today used primarily for hand-bound books. A larger version (nearly twice the size) was formerly used to squeeze the moisture out of large sheets of newly-made paper; today most paper is pressed with hydraulic presses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing presses"@en .

aat:300022407 a skos:Concept ;
    skos:definition "Devices comprising a clamp and a cutting plane, used for cutting stacks of books, folios, or other paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimmers"@en .

aat:300022413 a skos:Concept ;
    skos:definition "Slender, compressed cylinders of material often made from calcium sulfate in its dihydrate form, gypsum. Most often used to write on blackboards or chalkboards in classroom contexts, but also for many other marking purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalk sticks"@en .

aat:300022414 a skos:Concept ;
    skos:definition "Black crayons made of charred twigs of wood, usually willow or pieces of vine, or sticks of compressed charcoal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal sticks"@en .

aat:300022415 a skos:Concept ;
    skos:definition "A generic term for any drawing material made in stick form. Common examples are pigments in a wax binder, available in stick form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crayons"@en .

aat:300022417 a skos:Concept ;
    skos:definition "Oily crayons with which the drawing is applied to the stone, plate, or transfer paper in lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic crayons"@en .

aat:300022419 a skos:Concept ;
    skos:definition "Devices which attach to a drawing table and combine the functions of a straightedge, T-square, triangle, and protractor; used by draftsmen, designers, architects, and engineers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting machines"@en .

aat:300022420 a skos:Concept ;
    skos:definition "Instruments used for drawing ellipses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ellipsographs"@en .

aat:300022422 a skos:Concept ;
    skos:definition "Instruments for measuring and graphically recording variations in fluid pressure, as of the human pulse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kymographs"@en .

aat:300022425 a skos:Concept ;
    skos:definition "Instruments for executing extremely minute writing and engraving; their general principle is that of the pantograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micrographs"@en .

aat:300022426 a skos:Concept ;
    skos:definition "Devices consisting of four strips of wood or some other material which are hinged together in a square so that they overlap and can be adjusted to the scale of the work being copied, enlarged, or reduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantographs"@en .

aat:300022432 a skos:Concept ;
    skos:definition "Styluses, rods, or wires of metal, usually held in a holder, used as a common tool for drawing. They were used for writing in ancient times. Metal points are typically used on a paper or parchment support, which has been covered by a ground. As the point moves across the ground, it leaves behind a thin layer of metal. The thin metal quickly oxidizes. For example, silver point becomes the brownish grey of tarnished silver and lead point becomes quite dark. Metal points are the predecessors of \"pencils.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal points"@en .

aat:300022434 a skos:Concept ;
    skos:definition "Points or styluses of copper used as drawing instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper points"@en .

aat:300022436 a skos:Concept ;
    skos:definition "Instruments composed of lead, often encased in wood or another support. Distinct from \"graphite pencils,\" which in the 19th century were misleadingly called lead pencils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead points"@en .

aat:300022437 a skos:Concept ;
    skos:definition "Thin rods of silver, often supported in a holder, used to produce delicate drawings, usually on specially treated paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver points"@en .

aat:300022439 a skos:Concept ;
    skos:definition "Implements comprising rods of a marking substance, enclosed in wood, plastic, or metal, and used for writing or drawing. Common examples of materials used in pencils are graphite, lead, and pigmented wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencils"@en .

aat:300022440 a skos:Concept ;
    skos:definition "Pencils with lead of finely ground, highly compacted charcoal. Less messy, but not as versatile as charcoal sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal pencils"@en .

aat:300022443 a skos:Concept ;
    skos:definition "Pencils with a drawing material made of graphite. The terms 'lead pencil' and 'graphite pencil' are often used interchangeably as earlier forms, known as graphite pencils, used pure natural graphite without clay additives. 'Graphite pencil' technically refers to pencils in which pure natural graphite is used without the addition of a clay binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphite pencils"@en .

aat:300022445 a skos:Concept ;
    skos:definition "Black or colored crayons, usually in stick form, usually with peel-off paper casing, but also made as unbound sticks as inserts for mechanical pencil mechanisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grease pencils"@en .

aat:300022449 a skos:Concept ;
    skos:definition "Pencils whose lead is projected by a screw or other device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical pencils"@en .

aat:300022452 a skos:Concept ;
    skos:definition "Hand-held instruments for writing or drawing with a colored fluid such as ink. A pen generally comprises a handle or holder and a pointed tip for distributing the fluid on the drawing surface. The term may also refer to an instrument for machine-controlled writing or drawing with ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pens"@en .

aat:300022453 a skos:Concept ;
    skos:definition "Pens with a writing tip made of a metal ball that is housed in a socket, which allows the ball to rotate freely when pressed against a writing surface, releasing a quick-drying ink. The ball is constantly bathed in ink from a reservoir, one end of which is open and attached to the writing tip. Commercial models of the pen appeared in 1895 and it became popular beginning in the 1930s. It was first patented by Lázló Bíró."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball-point pens"@en .

aat:300022455 a skos:Concept ;
    skos:definition "Pens containing a reservoir that automatically feeds the split writing point the ink, making a variable line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fountain pens"@en .

aat:300022456 a skos:Concept ;
    skos:definition "Pens, generally dip pens, consisting of a shaft or holder and a metal or glass pen point, often interchangeable with any in a set of specially shaped pen points, ranging in size and shape from broad and flat to narrow and pointed. These pens are used in calligraphy, lettering, and drawing. Similar devices with metal pen points were known in Classical times but were used much less than the reed and quill prior to the 19th century. An ancient example is a bronze pen that was found in the ruins of Pompeii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettering pens"@en .

aat:300022457 a skos:Concept ;
    skos:definition "Implements that use a reservoir of ink to make a mark or marks. A marker may have pointed or blunt tips, usually of fiber. It is distiguished from a felt-tip pen in that it typically makes a thicker mark than a pen and is more often used for labeling or marking rather than writing or drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "markers"@en .

aat:300022458 a skos:Concept ;
    skos:definition "Pens with points made of porous materials, including or resembling felt, and a reservoir of ink in the handle. They became commercially available during the 1960s. In such pens a synthetic polymer of controlled porosity transfers ink from the reservoir to the writing surface. They are used for lettering, drawing, and writing on a variety of surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felt-tip pens"@en .

aat:300022463 a skos:Concept ;
    skos:definition "Pens made from the shafts of wing feathers or quills of geese, swans, ravens, eagles, owls, hawks, turkeys, and other birds. The tubular quill holds a reservoir of ink and the end may be cut into a pen point with various types of tips. Until the perfection of the metal pen point, the quill pen had historically been the most frequently used instrument for applying liquid media to a drawing surface. The supple tip of the quill can be found in various degrees of stiffness, which permit a wide range of strokes from soft thin lines to bold broad lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quill pens"@en .

aat:300022464 a skos:Concept ;
    skos:definition "Pens made from the stalks of marsh reeds, papyrus plants, sedge, or bamboo. The pen stores a reservoir of ink in its hollow interior. The end is carved into a tip or split tip. The stroke of the reed pen is characteristically bold and hard, variation achieved with the application of weaker or stronger pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed pens"@en .

aat:300022466 a skos:Concept ;
    skos:definition "Pens made of a handle and a distinctive pen point consisting of two prongs or blades held one over the other by an adjustable screw that controls the size of the gap between them and thus the thickness of the ink line. A small reservoir of ink is held in the gap. Ruling pens are basic drafting implements used to inscribe lines of uniform thickness, usually guided by a straight edge, curve, or template."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruling pens"@en .

aat:300022474 a skos:Concept ;
    skos:definition "Finely spiked or serrated wheels mounted at the end of a handle, used to perforate paper along the lines of a drawing in order to transfer it to another surface by pouncing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perforating wheels"@en .

aat:300022478 a skos:Concept ;
    skos:definition "Instruments composed of a pen attached to a wheel with interchangeable cogs used in conjunction with a straightedge to produce a stippled line of dots, dashes, or both; used for technical and working drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dotting wheels"@en .

aat:300022479 a skos:Concept ;
    skos:definition "Pointed instruments used to mark lines in wood, metal, or brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scribers"@en .

aat:300022480 a skos:Concept ;
    skos:definition "Cigar-shaped implements often pointed at both ends, consisting of tightly rolled leather, paper, or felt; used in drawing to blend or smudge charcoal, soft pencil, pastel, chalk, or crayon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stumps"@en .

aat:300022482 a skos:Concept ;
    skos:definition "Small stumps of tightly rolled gray or white paper, usually pointed at one end only; used to blend charcoal and pastel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tortillons"@en .

aat:300022483 a skos:Concept ;
    skos:definition "Relatively small pencil-shaped instruments with a hard point, often metal or bone, used for marking, writing, or drawing. Among uses for styluses are for incising lines on a soft surface such as wax, for transferring drawings through tracing with pressure, with inked ribbon as a tracing-point in devices such as a seismograph or telegraph receiver, and as an indicator on touch-sensitive electronic devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "styluses"@en .

aat:300022486 a skos:Concept ;
    skos:definition "Instruments utilizing a prism to project an accurate image of an object onto a flat surface for the purpose of tracing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera lucidas"@en .

aat:300022487 a skos:Concept ;
    skos:definition "Rooms or boxes with a single small opening, with or without a lens, through which an inverted image is projected from outside the box onto the opposite interior wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera obscuras"@en .

aat:300022488 a skos:Concept ;
    skos:definition "Instruments for drawing circles and measuring the distance between two points; consisting of two pointed legs, movable on a joint or pivot, usually made so that one of the points can be detached for the insertion of a drawing implement or an extension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compasses"@en .

aat:300022489 a skos:Concept ;
    skos:definition "Instruments consisting of a long horizontal bar on which two movable heads slide, one of which carries a pencil, and the other a pin or tracer; used to draw large circles or arcs of circles as for full-scale working drawings, cask gauging, or carpentry work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beam compasses"@en .

aat:300022492 a skos:Concept ;
    skos:definition "Drafting tools used to maintain scale ratio when transferring proportions of plans or objects to another surface. These have two arms connected with an adjustable pivot point that determines if the scaling factor is larger, smaller, or the same size when transferring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proportional compasses"@en .

aat:300022493 a skos:Concept ;
    skos:definition "Tools which take a variety of forms; used to guide draftsmen in drawing curved lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curves"@en .

aat:300022494 a skos:Concept ;
    skos:definition "Tools used as guides for ruling curves through a series of points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brook's curves"@en .

aat:300022495 a skos:Concept ;
    skos:definition "Flexible guides that may be bent to fit the desired curve; used for drawing long curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flexible curves"@en .

aat:300022500 a skos:Concept ;
    skos:definition "Measuring devices with two legs movable on a joint or pivot, similar in form to drawing compasses but with two metal points and used, for example, to divide lines, transfer dimensions, or lay off circles or arcs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dividers"@en .

aat:300022503 a skos:Concept ;
    skos:definition "Machines for graduating or dividing a circle into a number of equal parts, or for cutting the circumference of a wheel into a number of teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dividing engines"@en .

aat:300022505 a skos:Concept ;
    skos:definition "Dividers with two legs pointed at both ends and joined near the center by a movable pivot that can adjust along a graduated scale for proportional measurements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proportional dividers"@en .

aat:300022506 a skos:Concept ;
    skos:definition "Dividers having an arc-shaped piece fixed to one leg, and often adjustable by a set screw on the other leg, so that distances between the points of the dividers can be precisely set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wing dividers"@en .

aat:300022508 a skos:Concept ;
    skos:definition "Devices, such as pieces of rubber or cloth, for removing marks made with pen, pencil, chalk, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erasers"@en .

aat:300022509 a skos:Concept ;
    skos:definition "Thin shields used when erasing to avoid erasing the surrounding work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erasing shields"@en .

aat:300022511 a skos:Concept ;
    skos:definition "Handles for holding chalk, crayons, or charcoal, consisting of a split metal tube, usually double-ended, in which the material is secured by a ring that slides over the split end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portcrayons"@en .

aat:300022515 a skos:Concept ;
    skos:definition "Cylinders into which a medium such as a rod of graphite or silver is inserted and held by various means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencil holders"@en .

aat:300022517 a skos:Concept ;
    skos:definition "Stones with hollows or depressions deeper at one end than at the other; used for preparing calligrapher's ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkstones"@en .

aat:300022520 a skos:Concept ;
    skos:definition "Sets of two parallel rulers joined by a circular joint, marked with degrees, that combine the functions of a protractor and a set square."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isographs"@en .

aat:300022521 a skos:Concept ;
    skos:definition "Equipment used to sharpen pencils against a cutting edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencil sharpeners"@en .

aat:300022522 a skos:Concept ;
    skos:definition "Tools used in perspective drawing to fix in the picture the positions of some of the outlines of objects to be represented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perspectographs"@en .

aat:300022523 a skos:Concept ;
    skos:definition "Tools similar to a flat file having a coarse side and a fine side; used for pointing pencils, charcoal, crayons, and pastels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointing plates"@en .

aat:300022524 a skos:Concept ;
    skos:definition "Bags made of a porous material filled with a fine powder of charcoal, chalk, or pipe clay; used in pouncing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounce bags"@en .

aat:300022525 a skos:Concept ;
    skos:definition "Devices used for plotting or measuring angles, often designed as graduated arcs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protractors"@en .

aat:300022528 a skos:Concept ;
    skos:definition "Flat beveled or triangular bars, usually of wood or plastic, with a variety of graduations so that scale drawings can be drawn and measured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architects' scales"@en .

aat:300022530 a skos:Concept ;
    skos:definition "Drafting tools for drawing straight parallel lines, generally consisting of ungraduated strips of wood, metal, or plastic guided along drafting boards and held parallel by wires or strings passing through the ends of the rules; may or may not slide on rollers. For a set of two attached and pivoting rulers used often as navigational aids to transfer parallel lines, prefer \"parallel rulers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel rules"@en .

aat:300022531 a skos:Concept ;
    skos:definition "Any of various tools, usually long bars or strips of wood or metal, having straight and true edges and used for drawing or cutting accurate straight lines or for testing levelness or the evenness of surfaces. For, usually shorter, instruments used primarily as guides for drawing lines, straight or curved, use \"rulers (measuring tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straightedges"@en .

aat:300022533 a skos:Concept ;
    skos:definition "Devices which hold a piece of sandpaper for sanding by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanding blocks"@en .

aat:300022536 a skos:Concept ;
    skos:definition "Drafting instruments having straight edges that may be set at any desired angle with the edge of a drawing board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "set squares"@en .

aat:300022537 a skos:Concept ;
    skos:definition "Squares in the shape of a T, used in technical and architectural drawing. The short arm slides along the edge of a drawing board keeping the long arm in a parallel state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "T-squares"@en .

aat:300022539 a skos:Concept ;
    skos:definition "Guiding tools such as stencils, patterns, or overlays used for duplicating shapes or designs in sculpting, woodcrafting, creating architectural details, graphic arts, sewing, and other activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "templates"@en .

aat:300022540 a skos:Concept ;
    skos:definition "Implements of flat plastic, wood, or other material, made in a great number of triangular shapes and sizes; used as guides for drawing lines at various angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triangles"@en .

aat:300022544 a skos:Concept ;
    skos:definition "Tools made of agate used for fine burnishing, such as for gilding and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agate burnishers"@en .

aat:300022549 a skos:Concept ;
    skos:definition "Flat, thin brushes of camel or squirrel hair, used for picking up metal leaf and applying it to a surface to be gilded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilder's tips"@en .

aat:300022552 a skos:Concept ;
    skos:definition "Brushes made for use by artists from animal hair or synthetic material in a variety of shapes and sizes, but generally small enough to be handled with precision. The term pencil was used until the 19th century to describe small pointed sable or camel hair brushes. For larger brushes made for applying paint over large areas, especially as a protective coating, see \"paintbrushes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' brushes"@en .

aat:300022554 a skos:Concept ;
    skos:definition "Artists' brushes made of squirrel hair or any other fine hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camel hair brushes"@en .

aat:300022564 a skos:Concept ;
    skos:definition "Square-ended artists' brushes with shorter bristles than flats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brights"@en .

aat:300022565 a skos:Concept ;
    skos:definition "Soft, very flat brushes of fan shape, made in either sable or bristle and set in a metal ferrule, often used for blending and to produce wispy effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan brushes"@en .

aat:300022567 a skos:Concept ;
    skos:definition "Flat artists' brushes with rounded corners, usually made of bristle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filberts"@en .

aat:300022568 a skos:Concept ;
    skos:definition "Artists' brushes that are about the same length as flats. They are round and have tapered points, useful for sketching, outlining, and for fine detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rounds"@en .

aat:300022574 a skos:Concept ;
    skos:definition "Large artists' brushes usually made of hair set into a fairly flat ferrule and round at the end; they are used for applying washes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wash brushes"@en .

aat:300022600 a skos:Concept ;
    skos:definition "Tools having very flexible blades, used by artists to mix colors or spread paint; sometimes used to apply paint or to clean the palette. Palette knives resemble knives, but do not have sharp edges and are not used for cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palette knives"@en .

aat:300022607 a skos:Concept ;
    skos:definition "Implements used for spraying paint or other substances over large areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spray guns"@en .

aat:300022611 a skos:Concept ;
    skos:definition "Devices for dispersing pigment in a vehicle, consisting of a rotating cylinder containing pigment, vehicle, and ball bearings or pebbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball mills"@en .

aat:300022612 a skos:Concept ;
    skos:definition "Implements usually of marble or glass rounded at the top and flat on the bottom, used for grinding pigments against a fixed grinding slab."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mullers"@en .

aat:300022622 a skos:Concept ;
    skos:definition "Light sticks of wood used to rest the hand upon while painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahlsticks"@en .

aat:300022625 a skos:Concept ;
    skos:definition "Broad, flat objects, usually made of lightweight wood or heavy paper over a firm support, used by painters for laying out and mixing colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palettes"@en .

aat:300022627 a skos:Concept ;
    skos:definition "Palettes designed to be supported by the painter's forearm and larger than palettes held in the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arm palettes"@en .

aat:300022630 a skos:Concept ;
    skos:definition "Devices or appliances for expanding a material making it taut, removing wrinkles, or the like; used especially with reference to frames upon which canvas or other textile is stretched for painting, having mitered corners that can be forced apart by wedges or keys. For frames that support canvas or other textile and do not have expandable corners, use \"strainers (framing and mounting equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretchers"@en .

aat:300022631 a skos:Concept ;
    skos:definition "Tools employed in stretching materials for mounting, such as canvas onto a stretcher or screen onto a printing frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretching pliers"@en .

aat:300022633 a skos:Concept ;
    skos:definition "Refers to a broad array of equipment that aids the purpose of capturing images photographically, including cameras, darkroom equipment, and any ancillary objects used specifically to capture and process these images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic equipment"@en .

aat:300022636 a skos:Concept ;
    skos:definition "Lightproof boxes fitted with a lens through the aperture of which the image of an object is recorded on light-sensitive material such as film, or transformed into electrical impulses for direct transmission or for video recording."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cameras"@en .

aat:300022638 a skos:Concept ;
    skos:definition "Cameras of varied form designed to shoot images on frames of strip film 35mm wide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "35mm cameras"@en .

aat:300022640 a skos:Concept ;
    skos:definition "Early type of camera consisting of a lightproof box, with lens, shutter, and viewfinder, and employing film rather than a plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box cameras"@en .

aat:300022641 a skos:Concept ;
    skos:definition "General term applied to any 35mm (or smaller) camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature cameras"@en .

aat:300022642 a skos:Concept ;
    skos:definition "Cameras using a film format smaller than 35mm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subminiature cameras"@en .

aat:300022644 a skos:Concept ;
    skos:definition "Cameras adapted to make rapid exposure of moving objects on a strip of film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion-picture cameras"@en .

aat:300022646 a skos:Concept ;
    skos:definition "Automatic exposure meter cameras which directly control the lens aperture, in response to light falling on the photo cell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric eye cameras"@en .

aat:300022650 a skos:Concept ;
    skos:definition "Hand-held, shoulder-mounted, or structurally-attached cameras using electronic components to record or transmit motion pictures and sound for television production. Color television cameras have typically used a beam-splitter to focus onto the faces of three red, green, and blue image tubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television cameras"@en .

aat:300022652 a skos:Concept ;
    skos:definition "Cameras whose aperture is not a lens but a tiny hole in an opaque material such as aluminum foil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinhole cameras"@en .

aat:300022654 a skos:Concept ;
    skos:definition "Cameras with a viewing and focusing system that uses a mirror between the lens and focusing screen to give an upright image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflex cameras"@en .

aat:300022655 a skos:Concept ;
    skos:definition "Cameras which allow the user to see the exact image formed by the picture-taking lens, by means of a hinged mirror between the lens and film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single lens reflex cameras"@en .

aat:300022657 a skos:Concept ;
    skos:definition "Cameras having two lenses of the same focal length. One is used for viewing and focusing, the other for exposing the film. The lenses are mounted one over the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twin-lens reflex cameras"@en .

aat:300022659 a skos:Concept ;
    skos:definition "Cameras designed to take simultaneous images of the same subject from viewpoints separated by the same distance as that between the eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereoscopic cameras"@en .

aat:300022661 a skos:Concept ;
    skos:definition "Large-format cameras that have adjustable front and rear standards mounted on rails and connected by bellows. Moving these standards independently of each other allows the photographer greater control of sharpness across the image plane, subject distance, and perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "view cameras"@en .

aat:300022662 a skos:Concept ;
    skos:definition "Items that are adjunct, attached, or otherwise subordinate to cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera accessories"@en .

aat:300022663 a skos:Concept ;
    skos:definition "Long, flexible, cablelike plungers that permit the photographer to release the shutter without touching the camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable releases"@en .

aat:300022665 a skos:Concept ;
    skos:definition "Solid shaped pieces of transparent material which gather and select light rays reflected from a subject so that they enter the camera and form an image of that subject on the film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic lenses"@en .

aat:300022667 a skos:Concept ;
    skos:definition "Lenses that have no chromatic aberrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "achromats"@en .

aat:300022668 a skos:Concept ;
    skos:definition "Lenses corrected for astigmatism, so that they bring both vertical and horizontal lines to a focus in the same plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anastigmats"@en .

aat:300022670 a skos:Concept ;
    skos:definition "Lenses corrected to bring the three primary colors of the spectrum to common focus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apochromats"@en .

aat:300022671 a skos:Concept ;
    skos:definition "Lenses designed specifically for the highest quality reproduction of flat, two-dimensional originals; used mostly in the printing industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "process lenses"@en .

aat:300022672 a skos:Concept ;
    skos:definition "Camera lenses that consist of several elements which can be used in various combinations to provide different focal lengths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convertible lenses"@en .

aat:300022674 a skos:Concept ;
    skos:definition "Extremely wide-angle lenses, covering a field of about 180 degrees and reproducing a circular image with pronounced barrel distortion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fisheye lenses"@en .

aat:300022675 a skos:Concept ;
    skos:definition "Lenses set at one fixed distance from the film and offering no method of focusing adjustment; most common on inexpensive cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed-focus lenses"@en .

aat:300022676 a skos:Concept ;
    skos:definition "Any lens whose focal length is appreciably greater than the diagonal of the negative in the format in which it is used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long-focus lenses"@en .

aat:300022677 a skos:Concept ;
    skos:definition "Long-focal-length lenses which enlarge distant subjects within their narrow angle of view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephoto lenses"@en .

aat:300022678 a skos:Concept ;
    skos:definition "Lenses whose focal lengths are approximately equal to the film format with which they are used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standard lenses"@en .

aat:300022679 a skos:Concept ;
    skos:definition "Lenses with a focal length considerably shorter than the diagonal of the format it fills. The lenses give a wide angle of view, and considerable depth of field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wide-angle lenses"@en .

aat:300022681 a skos:Concept ;
    skos:definition "Lenses which are constructed to allow continuously variable focal lengths within a specific range. The effective aperture and focus settings remain unchanged throughout such adjustments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoom lenses"@en .

aat:300022684 a skos:Concept ;
    skos:definition "Light sources which attach to the camera and coordinate with the shutter mechanism to provide a brief intense flash of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash attachments"@en .

aat:300022686 a skos:Concept ;
    skos:definition "Small disposable cubes containing a bulb and reflector on four sides that provides four flashes in rapid succession, powered by battery and a circuit in a camera through current pulses. These have become obsolete with the advent of electronic flash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash cubes"@en .

aat:300022687 a skos:Concept ;
    skos:definition "Caps used to protect the camera lens from dirt and abrasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lens caps"@en .

aat:300022688 a skos:Concept ;
    skos:definition "Detachable camera accessories designed to shield the lens from any extraneous light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lens hoods"@en .

aat:300022692 a skos:Concept ;
    skos:definition "Three-legged supports for stabilizing a camera while permitting it to be tilted, turned, raised, or lowered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripods"@en .

aat:300022693 a skos:Concept ;
    skos:definition "Tools, equipment, and supplies used in transforming a latent image, as captured by light-sensitive chemicals on film, into a visible negative or positive image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic processing equipment"@en .

aat:300022694 a skos:Concept ;
    skos:definition "Tanks of various size designed for the development of photographic film. These often allow for the exchange of liquids without opening the tank completely and exposing the undeveloped film to light. Historically made of various metals, most recently stainless steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developing tanks"@en .

aat:300022696 a skos:Concept ;
    skos:definition "Tools used for photographic dodging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dodgers"@en .

aat:300022697 a skos:Concept ;
    skos:definition "Devices of various types designed to decrease the amount of time it takes photographic film to dry after development. These often take the form of a cabinet with provision for forced filtered and heated air to circulate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film dryers"@en .

aat:300022699 a skos:Concept ;
    skos:definition "Devices used to hold two sections of film or recording tape in proper alignment while they are being spliced together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film splicers"@en .

aat:300022700 a skos:Concept ;
    skos:definition "Devices used for washing film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film washers"@en .

aat:300022702 a skos:Concept ;
    skos:definition "Darkroom lights of a color and intensity that will not noticeably affect light-sensitive photographic materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safelights"@en .

aat:300022703 a skos:Concept ;
    skos:definition "Glass or plastic rods often having a thick disc at one end for crushing tablets or crystals; used to stir solutions while dissolving chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stirring rods"@en .

aat:300022706 a skos:Concept ;
    skos:definition "Atomizers resembling fountain pens with attached reservoirs, used for applying a fine spray of paint or another coating by compressed air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airbrushes"@en .

aat:300022708 a skos:Concept ;
    skos:definition "Devices used for making contact prints, having a frame for holding printing paper and negatives together and a light source for making an exposure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contact printing frames"@en .

aat:300022710 a skos:Concept ;
    skos:definition "Vented cabinets equipped with suspending rods for drying films after processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print dryers"@en .

aat:300022711 a skos:Concept ;
    skos:definition "Apparatuses for producing prints by projecting a negative or transparency onto sensitive paper; often allowing for the production of prints both larger and smaller than the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enlargers"@en .

aat:300022712 a skos:Concept ;
    skos:definition "Electric, straight-handled irons used for dry mounting photographs by holding paper, dry-mounting tissue, and cardboard in place until they are put in a dry-mounting press, where they are thoroughly bound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tacking irons"@en .

aat:300022714 a skos:Concept ;
    skos:definition "Term of Japanese origin for smooth, flat, round, or oval pads with handles used to press a sheet of paper against the face of a relief printing block to form an impression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barens"@en .

aat:300022718 a skos:Concept ;
    skos:definition "Any of various tools for chasing or engraving, usually on metal, sometimes on wood. For the tools used in printmaking to engrave metal or end-grain wood blocks, prefer \"burins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravers"@en .

aat:300022727 a skos:Concept ;
    skos:definition "Implements with a hard smooth rounded end or surface, used for smoothing and polishing. It differs in material and shape according to the purpose and trade. In printmaking, burnishers are used to smooth rough areas of an intaglio plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnishers"@en .

aat:300022737 a skos:Concept ;
    skos:definition "Tools, such as rollers or dabbers, used for applying ink to a printed surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inking tools"@en .

aat:300022738 a skos:Concept ;
    skos:definition "Soft rubber rollers attached to wooden or metal handles; used to ink wood blocks, linoleum blocks, lithographic stones, or printing plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brayers"@en .

aat:300022739 a skos:Concept ;
    skos:definition "Tools used for inking a plate or stencil, laying an etching ground, or pressing a material into the interstices of a plate or type. Examples include a cotton pad covered with silk or leather, a piece of rolled felt, or a short-bristled brush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dabbers"@en .

aat:300022740 a skos:Concept ;
    skos:definition "Leather ball-shaped pads used by printers when applying ink to a form by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink balls"@en .

aat:300022745 a skos:Concept ;
    skos:definition "Small, tempered-steel knives with slim handles and oblique cutting edges used for precise, delicate cutting, as of friskets and stencils for printmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencil knives"@en .

aat:300022747 a skos:Concept ;
    skos:definition "Iron disks used to smooth lithographic stones with sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "levigators"@en .

aat:300022755 a skos:Concept ;
    skos:definition "Flat pieces of metal from which textual or pictorial images are printed. For blocks of other material, usually wood, cut to print an image or used to support other materials that form the printing surface, use \"printing blocks\" or a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing plates"@en .

aat:300022760 a skos:Concept ;
    skos:definition "Limestone slabs used in lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic stones"@en .

aat:300022763 a skos:Concept ;
    skos:definition "Devices used to transfer an impression from type, blocks, plates, or stones to a surface, usually paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing presses"@en .

aat:300022764 a skos:Concept ;
    skos:definition "Presses used in intaglio printing in which the plate, paper, and cushioning blankets pass between cylinders that exert pressure, forcing paper into the grooves of the plate which holds the ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling presses"@en .

aat:300022767 a skos:Concept ;
    skos:definition "Printing presses for lithography that print by means of a scraper bar under heavy pressure. The bar is used to prevent harm to the stone plates used in the lithographic process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic presses"@en .

aat:300022770 a skos:Concept ;
    skos:definition "Printing presses for offset printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset presses"@en .

aat:300022771 a skos:Concept ;
    skos:definition "Curved dentate blades used in mezzotint to roughen the surface of the plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rockers"@en .

aat:300022773 a skos:Concept ;
    skos:definition "Various tools for rolling ink onto a printing surface; may have one handle, or one at each end. Utensils consisting of a foam or rubber cylinder attached on both ends to a handle. Used to spread ink on printing surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rollers"@en .

aat:300022774 a skos:Concept ;
    skos:definition "Small wheels used to indent or perforate surfaces such as paper, pottery, or metal plates for printmaking. Use if this term encompasses tools with revolving heads of hardened steel on which a dotted, lined, or irregular pattern is incised; used in intaglio processes, especially mezzotint, and other objects such as short lengths of fiber or wood rolled into wet clay to create decorative motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roulettes"@en .

aat:300022775 a skos:Concept ;
    skos:definition "The mesh that is stretched over a frame for screen printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screens"@en .

aat:300022776 a skos:Concept ;
    skos:definition "Tools used in screen printing consisting of a firm but flexible blade set directly into a straight-edged grip, traditionally of wood, used to force paint or ink through a screen onto a support. For similar implements used as cleaning tools, usually with handles perpendicular to a thinner blade, use \"squeegees.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silkscreen squeegees"@en .

aat:300022777 a skos:Concept ;
    skos:definition "Tools comprising thin pieces of material, such as metal, paper, cardboard, or stencil film, into which is cut, inscribed, or otherwise indicated a pattern, in such a way so that paint or ink applied to the surface of the stencil tool will produce a corresponding pattern on a second surface through the cut-outs. For large drawings into which holes are pricked in order to transfer designs to a large surface, prefer \"cartoons (working drawings)\"; for smaller drawings used for transferring designs, use \"pounces (pricked drawings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencils"@en .

aat:300022784 a skos:Concept ;
    skos:definition "Machine which mixes materials of the clay body, shreds or kneads it, and disperses air bubbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pug mills"@en .

aat:300022786 a skos:Concept ;
    skos:definition "Mixing machines fitted with paddles or propellers, used to prepare clay slips and glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blungers"@en .

aat:300022794 a skos:Concept ;
    skos:definition "Rubber bottles with narrow spouts, used for trailing lines of slip or glaze in patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip-trailers"@en .

aat:300022796 a skos:Concept ;
    skos:definition "Long-handled forks used for placing glass in kilns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiln forks"@en .

aat:300022798 a skos:Concept ;
    skos:definition "Furnaces, ovens, or heated enclosures for drying, charring, hardening, baking, or burning various materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kilns"@en .

aat:300022800 a skos:Concept ;
    skos:definition "Small, three pronged supports made of hard-fired clay or metal and used to lift clay objects off kiln shelves during firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilts"@en .

aat:300022804 a skos:Concept ;
    skos:definition "Sharp tool with flexible, tapered blade; used for carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fettling knives"@en .

aat:300022820 a skos:Concept ;
    skos:definition "Devices with a rotating flat disc or turntable on which clay may be shaped to create symmetrical forms; the process of forming clay objects on a potter's wheel is throwing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potter's wheels"@en .

aat:300022823 a skos:Concept ;
    skos:definition "Potter's wheel manually operated with a foot pedal or by kicking a disc at its base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kickwheels"@en .

aat:300022830 a skos:Concept ;
    skos:definition "Two- or four-wheeled conveyances, sometimes motor-driven, for transporting mixed concrete over short distances at construction sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buggies"@en .

aat:300022832 a skos:Concept ;
    skos:definition "Refers to large power-driven machines mounted on wheels that ride on steel pavement forms, and also for portable machines with large paddles used to float and finish concrete floors and slabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete finishing machines"@en .

aat:300022833 a skos:Concept ;
    skos:definition "Machines that mix cement, aggregate, and water in a rotating drum to make concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete mixers"@en .

aat:300022835 a skos:Concept ;
    skos:definition "Concrete mixers, usually mounted on crawler tracks, that mix and place concrete pavement on the subgrade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete pavers"@en .

aat:300022836 a skos:Concept ;
    skos:definition "Pumps that force premixed concrete through a hose to a desired location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete pumps"@en .

aat:300022837 a skos:Concept ;
    skos:definition "Power-operated saws used in grooving uncured concrete, to prevent cracking, or in cutting hard concrete slabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete saws"@en .

aat:300022838 a skos:Concept ;
    skos:definition "Machines, usually carried on side forms or on rails parallel thereto, designed to spread concrete from heaps or to receive and spread concrete in a uniform layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete spreaders"@en .

aat:300022839 a skos:Concept ;
    skos:definition "Chutes used to confine or to direct the flow of a stream of concrete in construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop chutes"@en .

aat:300022840 a skos:Concept ;
    skos:definition "Finishing tools used on the edges of fresh concrete to provide a rounded corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edgers"@en .

aat:300022841 a skos:Concept ;
    skos:definition "Devices for driving a hardened steel fastener into concrete or other hard material, consisting of a hand-held driver that positions the fastener. A blow on the head of the driver forces the fastener into the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stud drivers"@en .

aat:300022842 a skos:Concept ;
    skos:definition "Powerful stud drivers for driving a hardened steel fastener into concrete or other hard material, having the impact of a blank gun cartridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stud guns"@en .

aat:300022848 a skos:Concept ;
    skos:definition "Tunnel-shaped ovens in which glass is annealed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lehrs"@en .

aat:300022854 a skos:Concept ;
    skos:definition "Devices to apply pressure to glass in a mold while in a plastic state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass-presses"@en .

aat:300022856 a skos:Concept ;
    skos:definition "Molds into which molten glass is poured or injected, in order to create vessels or other objects made of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassmaking molds"@en .

aat:300022858 a skos:Concept ;
    skos:definition "For glassmaking, multipartile molds with a decorative pattern; glass blown into this type of mold picks up the pattern on its exterior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern molds"@en .

aat:300022860 a skos:Concept ;
    skos:definition "Hard, flat surfaces of stone, wood, or metal on which a mass of molten glass gathered on the end of a blowpipe or pontil is rolled and shaped in glassmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marvers"@en .

aat:300022862 a skos:Concept ;
    skos:definition "Stands of various designs for supporting one or more pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe stands"@en .

aat:300022863 a skos:Concept ;
    skos:definition "Solid iron rods onto which a partly made molten object is transferred from the gathering iron or blowpipe for the final shaping and decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pontils"@en .

aat:300022870 a skos:Concept ;
    skos:definition "In stained glass work: hand-held implements used to open the grooves of lead cames and to smooth them over cut pieces of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lathekins"@en .

aat:300022871 a skos:Concept ;
    skos:definition "Knife-like tool used to stretch lead when joining glass pieces or for bedding glass in wooden rebates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stopping knives"@en .

aat:300022881 a skos:Concept ;
    skos:definition "Tools capable of gouging grooves of various depths, which can be altered by turning the guide ring on the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable gouges"@en .

aat:300022882 a skos:Concept ;
    skos:definition "Wrenches that are used to apply different heads to harness awls, in leatherwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awl wrenches"@en .

aat:300022883 a skos:Concept ;
    skos:definition "Devices used to cut patterns into leather or other materials, originally parts for the uppers of boots and shoes, but now typically for any material intended for garments. These now are in the form of hand or hydraulic presses fixed with dies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clicker presses"@en .

aat:300022886 a skos:Concept ;
    skos:definition "Shaped iron or steel handtools, used hot to blind tool and burn straight and curved lines into leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creasers"@en .

aat:300022887 a skos:Concept ;
    skos:definition "Leather-working tools used to produce two parallel surface lines or furrows on a piece of leather by means of two adjustable spring jaws set open with a screw to make guide-llines at any required distance apart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double creasers"@en .

aat:300022888 a skos:Concept ;
    skos:definition "Small double creasers with parallel edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkers"@en .

aat:300022889 a skos:Concept ;
    skos:definition "Leather-working tools used to produce a surface line or furrow parallel to the edge of a piece of leather, especially straps and belts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge creasers"@en .

aat:300022890 a skos:Concept ;
    skos:definition "General term for cutting tools designed for use with leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leather cutters"@en .

aat:300022891 a skos:Concept ;
    skos:definition "Hand tools having various types of blades to cut and shape the edge of a piece of leather. For tools to cut a bevel on the edges, use \"edge bevelers (leatherworking tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge cutters"@en .

aat:300022892 a skos:Concept ;
    skos:definition "Tools used for cutting a strip of leather to a uniform width. The gauge of the blade is set and fixed, and when the tool is run down the side of a straight piece of leather it makes a parallel cut further in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strap cutters"@en .

aat:300022893 a skos:Concept ;
    skos:definition "Compass-like mechanisms for cutting circles of leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washer cutters"@en .

aat:300022894 a skos:Concept ;
    skos:definition "Hand tools having a beveled blade used to round the edges of leather of varying thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge bevelers"@en .

aat:300022896 a skos:Concept ;
    skos:definition "Objects of varied design used to treat the raw edges of heavy leather. These are sometimes in the form of small wheels, with a groove in them to receive the edge. The leather is dampened and the slicker is rubbed rapidly along the edge of the leather to burnish the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge slickers"@en .

aat:300022897 a skos:Concept ;
    skos:definition "Small sharpening steels held between the fingers by a currier to sharpen the blades used in scraping hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger steels"@en .

aat:300022898 a skos:Concept ;
    skos:definition "Most commonly a set of two objects including a small wheel and a matching die or stamp that are used to set large grommets, usually into accompanying washers. These are made in varying sizes to accommodate grommets of differing sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grommet setters"@en .

aat:300022899 a skos:Concept ;
    skos:definition "Hammers used as a handtool for leathercraft. Of varied design, but often with a slightly convex face on the hammerhead that helps prevent marring leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworking hammers"@en .

aat:300022900 a skos:Concept ;
    skos:definition "Hammers with magnetic heads that hold tacks or nails on the head of the hammer as they are struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic hammers"@en .

aat:300022901 a skos:Concept ;
    skos:definition "Hammers used to smooth inner seams of shoe leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turn-shoe hammers"@en .

aat:300022902 a skos:Concept ;
    skos:definition "General term for knives used for cutting and working leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworking knives"@en .

aat:300022903 a skos:Concept ;
    skos:definition "Knives with a gauge or other contrivance on the blade to limit the depth of the cut or the amount cut off. Such knives are most often used for leatherworking, but may be used in other contexts as well, such as in paper production, in the kitchen, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauge knives"@en .

aat:300022904 a skos:Concept ;
    skos:definition "General term for knives held in the hand while used, typically having a hand grip, rather than being mounted in a device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand knives"@en .

aat:300022905 a skos:Concept ;
    skos:definition "Knives having a blade shaped like a thick claw or raptor's bill, with a concave cutting edge. These blades cut primarily by a pulling or raking motion. They have both martial and utilitarian uses, such as in leatherworking, electrician's work, pruning, and other occupations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hawkbill knives"@en .

aat:300022906 a skos:Concept ;
    skos:definition "Knives of various designs having a curved blade set transversely to the handle, used in leatherworking and other occupations. For such knives with a curved blade in the shape of a crescent moon, use \"moon knives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "head knives"@en .

aat:300022909 a skos:Concept ;
    skos:definition "Knives of various designs used to split or pare leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skiving knives"@en .

aat:300022910 a skos:Concept ;
    skos:definition "Knives having a beveled point and used to split or pare leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bevel-point skiving knives"@en .

aat:300022912 a skos:Concept ;
    skos:definition "Knives having a squared-off tip; used primarily for trimming up and cutting new leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square-point knives"@en .

aat:300022913 a skos:Concept ;
    skos:definition "Knives having a relatively broad squared-off point, used in leatherworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broad point knives"@en .

aat:300022914 a skos:Concept ;
    skos:definition "Heavy knives with a broad or square point and a straight edge; used mostly by leatherworkers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar knives"@en .

aat:300022915 a skos:Concept ;
    skos:definition "Small knives comprising a blade mounted on a pivot, often having a saddle for a finger-rest. Such knives are used most often in leatherworking, but also in other occupations, including historically in surgery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swivel knives"@en .

aat:300022916 a skos:Concept ;
    skos:definition "Knives with semicircular blades, sometimes fitted with slotted wooden or ivory handles, historically used as a multi-purpose tool by Eskimo women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ulus"@en .

aat:300022917 a skos:Concept ;
    skos:definition "Knives used in the depilation of leather; often having a handle on each end of a curved blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unhairing knives"@en .

aat:300022919 a skos:Concept ;
    skos:definition "Pliers used for leatherworking with a long thin nose used to grip lacing when it is difficult to pull or needs to be reached through layers of leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacing pliers"@en .

aat:300022920 a skos:Concept ;
    skos:definition "Implements like vises, used to hold pieces of leather together while they are being stitched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacing ponies"@en .

aat:300022921 a skos:Concept ;
    skos:definition "Stones or iron plates which are held in the lap on which a shoemaker hammers leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapstones"@en .

aat:300022924 a skos:Concept ;
    skos:definition "Tools with serrated jaws, designed for gripping leather. In shoemaking hey are used for straining leather uppers over the last."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lasting pincers"@en .

aat:300022925 a skos:Concept ;
    skos:definition "Models of the foot made of wood or metal, and in modern times plastic, of varous sizes, upon which boots and shoes are shaped during making or manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lasts"@en .

aat:300022927 a skos:Concept ;
    skos:definition "Awls having a half-moon or bent shape, often in the form of an eye-pointed needle and designed for use in sewing horses' collars or similar items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar awls"@en .

aat:300022929 a skos:Concept ;
    skos:definition "Awls used in making holes for stitching harnesses; some varieties have a needle inserted in a tubular shank, with a feed for thread and means of creating an interlocking stitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harness awls"@en .

aat:300022930 a skos:Concept ;
    skos:definition "Long, slender pointed awls used to regulate the stuffing in collars and saddles or for leveling thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seat awls"@en .

aat:300022933 a skos:Concept ;
    skos:definition "Leatherworking needles that have triangular tips with sharpened edges that reach to the point to prevent tearing of the material sewn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glover's needles"@en .

aat:300022935 a skos:Concept ;
    skos:definition "Needles of varying size, and with blunted ends, intended to sew waxed thread through pre-punched holes in leather. They are also used for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harness needles"@en .

aat:300022936 a skos:Concept ;
    skos:definition "Needles on which lacing may be fixed in place while it is drawn through slits or punched holes in leather or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacing needles"@en .

aat:300022937 a skos:Concept ;
    skos:definition "Lacing needles designed so that the lacing his held in place on the needle by a two-pronged clip formed at one end. The lacing is then drawn through slits or punched holes made for stitching together multiple pieces of leather or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split-lacing needles"@en .

aat:300022938 a skos:Concept ;
    skos:definition "A category of pliers intended to be used for leather craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworking pliers"@en .

aat:300022939 a skos:Concept ;
    skos:definition "Pliers with jaws having sharpened edges especially adapted for cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting pliers"@en .

aat:300022940 a skos:Concept ;
    skos:definition "Hand tools principally used for holding, bending, and cutting thin materials or small gage wire. These vary in size. The jaws are hollow on one side opposite the cutting edges, in addition to having a flat, serrated tip or nose that can be used as a grip or to twist wire ends into a splice. For similar tools with gripping surface at the nose, use \"wire cutters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side-cutting pliers"@en .

aat:300022941 a skos:Concept ;
    skos:definition "Pliers used to set eyelets into pliable materials such as leather or canvas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyelet pliers"@en .

aat:300022942 a skos:Concept ;
    skos:definition "A broad category of punch types used to cut holes in leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworking punches"@en .

aat:300022943 a skos:Concept ;
    skos:definition "Manual tools used for piercing or cutting pieces from any semi-soft material, often leather, designed so that the shank is split into an arch before it meets the cutting end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch punches"@en .

aat:300022944 a skos:Concept ;
    skos:definition "Hand tools used to cut long, narrow, parallel-sided oval holes. These are most often used for cutting \"crew holes\" in straps to accommodate the tongues of buckles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crew punches"@en .

aat:300022946 a skos:Concept ;
    skos:definition "Hand punches with hollow ends used to make holes in soft sheet material like shim steel, plastic, or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drive punches"@en .

aat:300022948 a skos:Concept ;
    skos:definition "Plier-shaped punches with several different-sized heads mounted on a wheel, for punching holes of different diameters. The punching is accomplished by squeezing the handles of the tool together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolving punches"@en .

aat:300022950 a skos:Concept ;
    skos:definition "Punches used for cutting round holes in leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round-hole punches"@en .

aat:300022951 a skos:Concept ;
    skos:definition "Punches used to impress decorative designs onto the surface of leather or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamp punches"@en .

aat:300022952 a skos:Concept ;
    skos:definition "Hand tools with multiple metal points imbedded into a handle used to impress dots into the surface of leather as a decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stipplers"@en .

aat:300022953 a skos:Concept ;
    skos:definition "Tools used to shape the tongues of belts or the end of straps, and save the trouble of cutting an accurate curve by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strap-end punches"@en .

aat:300022955 a skos:Concept ;
    skos:definition "Cutting tools with u-shaped ends with one sharpened edge, used to cut grooves in leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racers"@en .

aat:300022957 a skos:Concept ;
    skos:definition "A tool for grooving lines in leather where it is desired to sink stitches below the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw racers"@en .

aat:300022959 a skos:Concept ;
    skos:definition "Hand tools of varied form used to shave the sharp edges off of cut leather. These are designed so that the sharp edge of the cutting blade is prevented from contacting the user's free hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety bevellers"@en .

aat:300022961 a skos:Concept ;
    skos:definition "Long, typically curved, awls with a blunted end used primarily in saddlery to insert stuffing, or \"flock\" into cart-saddle panels or the peaks of riding saddles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seat irons"@en .

aat:300022963 a skos:Concept ;
    skos:definition "Machines used in paring or thinning leather or skins. These involve feeding the material through rollers toward a knife edge, and were first operated mechanically via a crank, though now they are often automated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skiving machines"@en .

aat:300022965 a skos:Concept ;
    skos:definition "Leatherworking hand tools used for burnishing or scraping the surface of skins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slickers"@en .

aat:300022966 a skos:Concept ;
    skos:definition "Tools for roughening the surface of leather or other materials, such as the soles of shoes before they are cemented. Farriers and woodworkers may use this tool for varied tasks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sole scrapers"@en .

aat:300022967 a skos:Concept ;
    skos:definition "Machines employed to split hides that operate by seizing the skin and forcing it around a cylinder towards a knife that can be adjusted to different thicknesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leather splitters"@en .

aat:300022970 a skos:Concept ;
    skos:definition "Forks used for stretching webbing or wet leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straining forks"@en .

aat:300022971 a skos:Concept ;
    skos:definition "Instruments used for pushing needles forcefully through leather or canvas, composed of a leather or canvas strap that is worn on the hand into which is set a metal thimble impressed with cavities that fit the heads of needles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thimble palms"@en .

aat:300022972 a skos:Concept ;
    skos:definition "Chisels, shaped like a small pitchfork, used in leatherworking to make holes specifically for sewing or lacing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thonging chisels"@en .

aat:300022974 a skos:Concept ;
    skos:definition "Hand tools used to finish a plastered surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle paddles"@en .

aat:300022975 a skos:Concept ;
    skos:definition "Plastering tools used to prepare surfaces for a finish coat by knocking down high spots, cleaning angles, and scraping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle planes"@en .

aat:300022976 a skos:Concept ;
    skos:definition "Plastering tools primarily used on inside corners to apply pressure to finish setting materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle plows"@en .

aat:300022977 a skos:Concept ;
    skos:definition "Hand axes, with heads made of stone or metal, designed to chip and shape stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone working axes"@en .

aat:300022978 a skos:Concept ;
    skos:definition "Small axes for chipping wood or stone into shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chip axes"@en .

aat:300022979 a skos:Concept ;
    skos:definition "Axes having a flat face for knocking off projecting angular points and a pointed peen for reducing a surface to a desired form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavils"@en .

aat:300022984 a skos:Concept ;
    skos:definition "Slate cutters' hammers which have a point at the back of the head; used for making nail holes in slate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zaxes"@en .

aat:300022986 a skos:Concept ;
    skos:definition "Tools used inside a pipe or culvert to remove excess mortar or deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badgers"@en .

aat:300022988 a skos:Concept ;
    skos:definition "Flat, rigid pieces of steel having either plain or toothed edges; used for applications such as smoothing plaster and clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block scrapers"@en .

aat:300022989 a skos:Concept ;
    skos:definition "Furnaces devised for burning bricks. Originally fueled by wood, more recent designs employ forced air systems, automatic temperature control, and may be fueled by coal or other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick kilns"@en .

aat:300022990 a skos:Concept ;
    skos:definition "Guides used to set out brick work or block work accurately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bricklaying profiles"@en .

aat:300022992 a skos:Concept ;
    skos:definition "Tools used to throw water on the surface of applied mortar to provide lubrication to the tools used to straighten the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "browning brushes"@en .

aat:300022994 a skos:Concept ;
    skos:definition "Chisels for chipping, smoothing, or otherwise working stone or masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone working chisels"@en .

aat:300022995 a skos:Concept ;
    skos:definition "Any rugged, broad-edged stone masons' chisels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blocking chisels"@en .

aat:300022997 a skos:Concept ;
    skos:definition "Chisels or bolsters for cutting brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick sets"@en .

aat:300022999 a skos:Concept ;
    skos:definition "Flat, broad chisels used in carving or dressing stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boasters"@en .

aat:300023004 a skos:Concept ;
    skos:definition "Chisels with a wide, thick edge for rough cutting of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitching chisels"@en .

aat:300023011 a skos:Concept ;
    skos:definition "Tools used to break up rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splitting chisels"@en .

aat:300023012 a skos:Concept ;
    skos:definition "Stonecutters' chisels having a toothed edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tooth chisels"@en .

aat:300023015 a skos:Concept ;
    skos:definition "Sharp steel bars used to split stone so that the facet angles can be measured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleaving blades"@en .

aat:300023017 a skos:Concept ;
    skos:definition "Any drills for drilling or otherwise working stone or masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone working drills"@en .

aat:300023018 a skos:Concept ;
    skos:definition "Slender drills used for boring or drilling a blasthole in rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aiguilles"@en .

aat:300023019 a skos:Concept ;
    skos:definition "Pneumatically powered mechanisms using percussion to penetrate rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer drills"@en .

aat:300023020 a skos:Concept ;
    skos:definition "High-powered pneumatic or electrically driven devices or machines used for boring holes into rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-drills"@en .

aat:300023022 a skos:Concept ;
    skos:definition "Small mallets with heads of malleable iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dummies"@en .

aat:300023023 a skos:Concept ;
    skos:definition "Straight-edged devices used to shape and define angles in plastering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "featheredge rules"@en .

aat:300023024 a skos:Concept ;
    skos:definition "Metal rods used to split rock by driving it into the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feathers"@en .

aat:300023026 a skos:Concept ;
    skos:definition "Tools for creating gunflints, in the form of hammer-like instruments with dual heads often of pyramidal shape culminating in sharp points, or other shape variations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flinting picks"@en .

aat:300023027 a skos:Concept ;
    skos:definition "Tools, usually of wood, aluminum, or magnesium, used in finishing operations to impart a relatively even but still open texture to unformed fresh surfaces of concrete, plaster, or stucco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floats"@en .

aat:300023029 a skos:Concept ;
    skos:definition "Trowels with two surfaces meeting at a right angle; used to finish plaster or concrete in a corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle floats"@en .

aat:300023030 a skos:Concept ;
    skos:definition "Wood, aluminum, or magnesium boards mounted on poles; used to spread and smooth freshly placed, horizontal concrete surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bull floats"@en .

aat:300023031 a skos:Concept ;
    skos:definition "Float tools which are about 4 feet long, usually made of wood or aluminum and having either one or two handles; used by concrete finishers and plasterers in preliminary floating and leveling operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darbies"@en .

aat:300023034 a skos:Concept ;
    skos:definition "Plastering tools such as carpet or cork floats; used for texturing plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "texture floats"@en .

aat:300023035 a skos:Concept ;
    skos:definition "Rubbing stones used in bricklaying and masonry work, for example to smooth the rough spots and ax marks from curved work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floatstones"@en .

aat:300023037 a skos:Concept ;
    skos:definition "Heavy-duty combinations of hatchet and hammer with a broad blade with a notched under part for pulling nails; used to chop off hardened plaster and to do other heavy work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half hatchets"@en .

aat:300023038 a skos:Concept ;
    skos:definition "Hammers used to chip, pound, or otherwise work stone or masonry; may include automated hammers or hand held hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone working hammers"@en .

aat:300023039 a skos:Concept ;
    skos:definition "Striking tools having two cutting edges, or one cutting edge and one hammer face, used for dressing or spalling rough stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axhammers"@en .

aat:300023042 a skos:Concept ;
    skos:definition "Chunky hammers with two striking surfaces covered with rows of pyramidal metal teeth or points; used in stone carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bushhammers"@en .

aat:300023045 a skos:Concept ;
    skos:definition "Hand tools consisting of several sharp pointed bars fixed to the end of a handle in a hammerlike configuration: used for dressing stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crandall hammers"@en .

aat:300023046 a skos:Concept ;
    skos:definition "Heavy hammers having flat faces, with one blunt end and one cutting end; used for rough dressing of blocks of quarried stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face hammers"@en .

aat:300023047 a skos:Concept ;
    skos:definition "Two-faced hammers, each of whose faces are composed of a number of parallel thin chisels; used for dressing stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patent hammers"@en .

aat:300023048 a skos:Concept ;
    skos:definition "Hammers used for rough-dressing stone, with one end pointed for picking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scabbling hammers"@en .

aat:300023050 a skos:Concept ;
    skos:definition "Flat pieces of metal or wood held by a wood handle on the underside; used by plasterers to carry plaster or mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hawks"@en .

aat:300023055 a skos:Concept ;
    skos:definition "Offset metal tools used to smooth or indent mortar joints in masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jointers"@en .

aat:300023057 a skos:Concept ;
    skos:definition "Plasterers' tools made of highly flexible carbon steel; used in trimming plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elastic knives"@en .

aat:300023059 a skos:Concept ;
    skos:definition "Knives, the blade of which is usually curved on one side and straight on the other, used to apply and smooth plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaster knives"@en .

aat:300023060 a skos:Concept ;
    skos:definition "Metal devices consisting of dovetail tenons; used to hoist heavy units of masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lewises"@en .

aat:300023062 a skos:Concept ;
    skos:definition "Three separate levels set in a straight bar of wood or metal which is approximately 4 feet long; used for determining level or plumb lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masons' levels"@en .

aat:300023063 a skos:Concept ;
    skos:definition "Machines employed for blending the constituents of materials such as concrete, grout, mortar, or paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixers"@en .

aat:300023064 a skos:Concept ;
    skos:definition "Apparatuses for mixing drywall mud and exposed aggregate materials, consisting of two bladed wheels, an upper which cuts the material downward and a lower which cuts it upward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jiffler mixers"@en .

aat:300023066 a skos:Concept ;
    skos:definition "Large tubs or vats used for mixing a material, such as plaster or cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixing troughs"@en .

aat:300023067 a skos:Concept ;
    skos:definition "Long-handled metal tools terminating in a small cup; used to dip stone-dust from drilled holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mud spoons"@en .

aat:300023071 a skos:Concept ;
    skos:definition "Tools used for raking out decayed mortar from the joints of brickwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rakers"@en .

aat:300023072 a skos:Concept ;
    skos:definition "Bricklayers' tools having a cutting edge on each side; used for cutting, trimming, and dressing brick or stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scotches"@en .

aat:300023074 a skos:Concept ;
    skos:definition "Motor-powered, portable pumps which feed plaster into a hose and onto the surface to be plastered without the use of hawks or trowels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastering machines"@en .

aat:300023075 a skos:Concept ;
    skos:definition "In plastering, sticks or beaters used for mixing hair with mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabs"@en .

aat:300023076 a skos:Concept ;
    skos:definition "Plastering tools consisting of a wooden arm fixed at one end to a center about which it swivels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radius tools"@en .

aat:300023077 a skos:Concept ;
    skos:definition "Saws, often metal and without teeth, used for cutting or otherwise working stone or masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone working saws"@en .

aat:300023078 a skos:Concept ;
    skos:definition "Hand-operated saws used for cutting stone, especially marble, into usable slabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grub saws"@en .

aat:300023081 a skos:Concept ;
    skos:definition "A variety of hand tools used to scratch a plaster surface to increase bonding of the successive coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratch tools"@en .

aat:300023083 a skos:Concept ;
    skos:definition "Pieces of metal with a serrated edge; used to scratch plaster and create a rough gripping surface for the next coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocks' combs"@en .

aat:300023084 a skos:Concept ;
    skos:definition "Hand-held flat tools with nails in each edge; used to scratch a coat of plaster prior to applying the next coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devil floats"@en .

aat:300023087 a skos:Concept ;
    skos:definition "Long serrated plates used to level and score plaster in preparation for the next coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drags"@en .

aat:300023088 a skos:Concept ;
    skos:definition "Plastering tools with long wirelike teeth; used to scratch the surface of unset plaster providing a sufficient bond for the next coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarifiers"@en .

aat:300023090 a skos:Concept ;
    skos:definition "In cement masonry flatwork, the wood or metal straightedges used to strike off or level newly placed concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screeds"@en .

aat:300023093 a skos:Concept ;
    skos:definition "Flat hand tools having a broad steel blade; used to apply, spread, and shape plaster or mortar or to smooth the surface of unformed concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trowels"@en .

aat:300023094 a skos:Concept ;
    skos:definition "Trowels having a flat, triangular steel blade in an offset handle, used to pick up and spread mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick trowels"@en .

aat:300023095 a skos:Concept ;
    skos:definition "Small trowels used to spread mortar on brick before it is laid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttering trowels"@en .

aat:300023096 a skos:Concept ;
    skos:definition "Plasterers' trowels having a V-shaped blade made for working corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner trowels"@en .

aat:300023097 a skos:Concept ;
    skos:definition "Trowels used to finish inside corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inside corner trowels"@en .

aat:300023098 a skos:Concept ;
    skos:definition "Plasterers' hand trowels on which the edges are turned up; used to finish plaster in corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "margin trowels"@en .

aat:300023101 a skos:Concept ;
    skos:definition "Diamond-shaped trowels used in pointing or repointing masonry joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointing trowels"@en .

aat:300023102 a skos:Concept ;
    skos:definition "Machines with interchangeable metal or rubber blades; used to compact and smooth plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical trowels"@en .

aat:300023106 a skos:Concept ;
    skos:definition "Tools used in the process of making molds from melted metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "founding tools"@en .

aat:300023108 a skos:Concept ;
    skos:definition "Wooden or metal frames that hold the sand forming the mold used in a foundry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flasks"@en .

aat:300023114 a skos:Concept ;
    skos:definition "Coarse sieves used for separating and grading granular material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riddles"@en .

aat:300023115 a skos:Concept ;
    skos:definition "The stems or straight parts of any tool or equipment, such as of a nail, needle, tongs, or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shanks"@en .

aat:300023116 a skos:Concept ;
    skos:definition "Tools for removing impurities from the surface of molten metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skimmers"@en .

aat:300023119 a skos:Concept ;
    skos:definition "Heavy, usually steel or iron blocks, on which metal is shaped by hand hammering or forging. Anvils are also used for working materials other than metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anvils"@en .

aat:300023121 a skos:Concept ;
    skos:definition "Anvils with two shaped ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench anvils"@en .

aat:300023123 a skos:Concept ;
    skos:definition "Items used in conjunction with anvils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anvil accessories"@en .

aat:300023124 a skos:Concept ;
    skos:definition "Metal components having a square shank for insertion into a hole in an anvil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardies"@en .

aat:300023127 a skos:Concept ;
    skos:definition "Metal plates designed with attachment points for various equipment on a workbench."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench plates"@en .

aat:300023129 a skos:Concept ;
    skos:definition "Blocks of various types, usually of metal, stone, or wood, used as a surface upon which metal sheets, or other metal components, are laid for punching or working."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking blocks"@en .

aat:300023131 a skos:Concept ;
    skos:definition "Anvils used in conjunction with dapping punches for depressing metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dapping blocks"@en .

aat:300023134 a skos:Concept ;
    skos:definition "Plates with holes through which wire is drawn and shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawplates"@en .

aat:300023136 a skos:Concept ;
    skos:definition "Tools similar to punches; used to open up punched holes, smoothing and shaping them at the same time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drifts"@en .

aat:300023137 a skos:Concept ;
    skos:definition "Furnaces where metal is heated before shaping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forges"@en .

aat:300023142 a skos:Concept ;
    skos:definition "Tools used for creating grooved joints in unhardened concrete slabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groovers"@en .

aat:300023143 a skos:Concept ;
    skos:definition "Hammers used for beating or otherwise working metal; the characteristics of the hammer may vary in relation to the differentproperties of the metals being worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking hammers"@en .

aat:300023145 a skos:Concept ;
    skos:definition "Machines consisting of hammers that are raised and dropped to form metal on an anvil or die. For similar devices used to drive piles into the earth use \"pile drivers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop hammers"@en .

aat:300023148 a skos:Concept ;
    skos:definition "Hammers whose head is a distinctively shaped truncated cone which is set off balance on the narrow end of its handle; used to cut teeth in files."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "file-cutting hammers"@en .

aat:300023149 a skos:Concept ;
    skos:definition "Power hammers consisting essentially of a heavy head at one end of a lever lifted by power and dropped by its own weight on work that rests on an anvil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helve hammers"@en .

aat:300023151 a skos:Concept ;
    skos:definition "Hammers of various designs having two opposite cutting or hammering edges; used especially by metal workers and stone masons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peen hammers"@en .

aat:300023152 a skos:Concept ;
    skos:definition "Hammers having a hemispherical peen, the end opposite the hammering face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball-peen hammers"@en .

aat:300023154 a skos:Concept ;
    skos:definition "Hammers having a wedge-shaped peen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-peen hammers"@en .

aat:300023156 a skos:Concept ;
    skos:definition "Hammers having a blunt chisel-shaped peen whose edge is parallel to the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight-peen hammers"@en .

aat:300023158 a skos:Concept ;
    skos:definition "Smooth-faced hammers used to planish metal surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planishing hammers"@en .

aat:300023159 a skos:Concept ;
    skos:definition "Combination tools taking the form of an iron hammer, often including an open wrench, a screwdriver, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plow hammers"@en .

aat:300023160 a skos:Concept ;
    skos:definition "Large heavy hammers that are usually wielded with both hands and used especially for driving stakes and breaking stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sledgehammers"@en .

aat:300023167 a skos:Concept ;
    skos:definition "Massive power hammers having a helve that is tripped and allowed to fall by cam or lever action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trip-hammers"@en .

aat:300023169 a skos:Concept ;
    skos:definition "Cylindrical tapered rods of iron or wood designed to hold a hollow part while it is being forged or turned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandrels"@en .

aat:300023176 a skos:Concept ;
    skos:definition "Tools used to hold nail rods while making nail heads in wrought nail making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail headers"@en .

aat:300023178 a skos:Concept ;
    skos:definition "Presses consisting of a frame containing stationary dies; used to cut or shape metal or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch presses"@en .

aat:300023180 a skos:Concept ;
    skos:definition "Punches made of metal, bone, stone, or another material, used for making punch marks on or cuts in metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking punches"@en .

aat:300023181 a skos:Concept ;
    skos:definition "Punches mounted on a handle; often used in conjunction with square and round punches in farriers' work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backing-out punches"@en .

aat:300023184 a skos:Concept ;
    skos:definition "Supports beneath metal being hammered or punched from above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterpunches"@en .

aat:300023187 a skos:Concept ;
    skos:definition "Punches used in conjunction with dapping blocks for depressing metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dapping punches"@en .

aat:300023190 a skos:Concept ;
    skos:definition "Tapered punches used to align holes for bolting and riveting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drift punches"@en .

aat:300023195 a skos:Concept ;
    skos:definition "Hand tools for punching holes in sheetmetal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand lever punches"@en .

aat:300023196 a skos:Concept ;
    skos:definition "Pointed steel punches which are struck with a hammer; used to mark metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prick punches"@en .

aat:300023197 a skos:Concept ;
    skos:definition "Punches used to stamp decorative scallop decorations on metal, for example on jewelry, silver plate, gold leaf of panel paintings, wrought iron items, and many other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scalloping punches"@en .

aat:300023198 a skos:Concept ;
    skos:definition "Tools used to shape the head of a rivet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rivet sets"@en .

aat:300023200 a skos:Concept ;
    skos:definition "Instruments used for scoring a variety of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scorers"@en .

aat:300023201 a skos:Concept ;
    skos:definition "Hand tools used in making sheet metal joints or seams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seamers"@en .

aat:300023202 a skos:Concept ;
    skos:definition "Closing machines that roll together the rims and lids of metal cans to make a hermetic seal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double seamers"@en .

aat:300023203 a skos:Concept ;
    skos:definition "Tools with a long beak, used in making raised work on metal surfaces by repercussion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snarling irons"@en .

aat:300023205 a skos:Concept ;
    skos:definition "Small anvils used for the working of thin sheet metal, so called because they are supported by a sharp vertical prop which is inserted into a hole in the workbench."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stakes"@en .

aat:300023207 a skos:Concept ;
    skos:definition "Stakes or small bench anvils having a slender horn on one side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beakhorn stakes"@en .

aat:300023208 a skos:Concept ;
    skos:definition "Long, tapered stakes used for a variety of shaping tasks with sheet metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blowhorn stakes"@en .

aat:300023210 a skos:Concept ;
    skos:definition "T-stakes having a flat top, grooves, or another surface for making creases and working metal and wire edges. The common type is symmetrical with the same surface on both arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creasing stakes"@en .

aat:300023211 a skos:Concept ;
    skos:definition "T-shaped creasing stakes having a different surface on each of the two arms. For example, one side of the T may be grooved or notched, while the other side may be flat or rounded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-creasing stakes"@en .

aat:300023212 a skos:Concept ;
    skos:definition "Sharp-edged stakes on which to bend sheet metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatchet stakes"@en .

aat:300023214 a skos:Concept ;
    skos:definition "Small stakes used in sheet metal work for thin, round items such as needle cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle case stakes"@en .

aat:300023216 a skos:Concept ;
    skos:definition "Slightly curved, square-headed stakes, used for smoothing hammer marks out of sheet metal work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planishing stakes"@en .

aat:300023217 a skos:Concept ;
    skos:definition "Tools used for various purposes but especially to set the teeth of saws, and in sheet metal work, hand tools used to shape material to the desired form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swages"@en .

aat:300023223 a skos:Concept ;
    skos:definition "Brushes used to clean saw dust from the teeth of rasps and files."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "file brushes"@en .

aat:300023226 a skos:Concept ;
    skos:definition "Threading tools, many-toothed or with a single cut edge, shaped especially for cutting or finishing external or internal threads; usually used in conjunction with a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chasers"@en .

aat:300023227 a skos:Concept ;
    skos:definition "Chisels designed to shape, form, or otherwise work metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking chisels"@en .

aat:300023228 a skos:Concept ;
    skos:definition "Common form of chisel with a cutting edge of 60 degrees formed of tempered steel; used for cutting metal which has not been softened by heating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold chisels"@en .

aat:300023230 a skos:Concept ;
    skos:definition "Long, cold chisels having long tapers and narrow cutting edges; used for cutting keyways and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cape chisels"@en .

aat:300023232 a skos:Concept ;
    skos:definition "Long chisels, ground to a cutting edge of 30 degrees, which are not hardened or tempered and can be used in work on heated metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot chisels"@en .

aat:300023233 a skos:Concept ;
    skos:definition "Cutting devices of various kinds used in metalworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking cutters"@en .

aat:300023234 a skos:Concept ;
    skos:definition "Tools which take a variety of forms; used for cutting threads in metal pegs to make bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolt cutters"@en .

aat:300023236 a skos:Concept ;
    skos:definition "Tools used for cutting horseshoe nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffers"@en .

aat:300023239 a skos:Concept ;
    skos:definition "Rotary tool-steel cutters used in a milling machine for shaping and dressing metal surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milling cutters"@en .

aat:300023240 a skos:Concept ;
    skos:definition "Hand tools consisting of a frame with a cutting wheel and drive wheels; used for cutting pipe and tubing by forcing the cutting wheel into the pipe material and rotating the tool around the pipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe cutters"@en .

aat:300023241 a skos:Concept ;
    skos:definition "Cutters used for clipping off the excess sprues of molded metal after the mold has been removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprue cutters"@en .

aat:300023245 a skos:Concept ;
    skos:definition "Tools used for cutting the threads of bolts, pipes, or other metal objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dies"@en .

aat:300023253 a skos:Concept ;
    skos:definition "Very small, thin files used in delicate work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle files"@en .

aat:300023254 a skos:Concept ;
    skos:definition "Round tapering files, 4 to 20 inches long, used for enlarging holes and shaping curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round files"@en .

aat:300023255 a skos:Concept ;
    skos:definition "Curved files in a variety of shapes and cross sections; used for carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riffler files"@en .

aat:300023258 a skos:Concept ;
    skos:definition "Files having the coarsest cutting ridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough files"@en .

aat:300023259 a skos:Concept ;
    skos:definition "Tools used for removing burrs from pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flute reamers"@en .

aat:300023263 a skos:Concept ;
    skos:definition "Machines or tools which grind with abrasives; used to cut hardened or tempered metals and to develop a smooth finish as on metal, wood, stone, or concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grinders"@en .

aat:300023264 a skos:Concept ;
    skos:definition "Small sharpening machines that utilize a horizontal, flat metal plate that is turned by means of a gearing system. The knives are held in specially designed clamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mower-knife grinders"@en .

aat:300023267 a skos:Concept ;
    skos:definition "Tools in the shape of a nippers or pliers used to trim glass to a particular shape, as in making stained glass or sizing window glass. The tool is typically used after the glass has been scored to allow a neat trim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grozing irons"@en .

aat:300023272 a skos:Concept ;
    skos:definition "Lathes having a turret for holding various different cutting tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turret lathes"@en .

aat:300023274 a skos:Concept ;
    skos:definition "Power saws with a continuous piece of flexible steel running around two pulleys and with teeth on one or both sides; used primarily to cut wood, but with the proper blade may be used to cut metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "band saws"@en .

aat:300023277 a skos:Concept ;
    skos:definition "Lightweight metal-cutting hand saws with a narrow fine-toothed blade retained in an adjustable metal frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hacksaws"@en .

aat:300023279 a skos:Concept ;
    skos:definition "Hand pincers with cutting jaws that meet parallel to each other rather than at an angle; used for cutting wire, thin metal rods, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nippers"@en .

aat:300023282 a skos:Concept ;
    skos:definition "A form of turret lathe usually having a hollow spindle through which a bar can be fed to be machined into bolts, studs, and other screws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw-cutting machines"@en .

aat:300023284 a skos:Concept ;
    skos:definition "Hand tools for cutting metal, that operate by simultaneous action of two blades on opposite sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking shears"@en .

aat:300023285 a skos:Concept ;
    skos:definition "Large shears used in sheet metal work typically having one handle bent to go into a hole in the top of the workbench so that they rest on the surface when in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench shears"@en .

aat:300023286 a skos:Concept ;
    skos:definition "Shears used to used to cut a circle out of sheet metal; they may be in the form of hand shears having a slight curve to the blade or mechanical shears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circle shears"@en .

aat:300023287 a skos:Concept ;
    skos:definition "Shears constructed on the principle of the lever, where a lever is used to apply pressure to lower the blades. Used to cut sheet metal and in various other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lever shears"@en .

aat:300023290 a skos:Concept ;
    skos:definition "Large, foot-operated machines that cut sheet metal square to a fence with a guillotinelike action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet shears"@en .

aat:300023293 a skos:Concept ;
    skos:definition "Sharp cutters used for snipping pieces of sheet metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin snips"@en .

aat:300023297 a skos:Concept ;
    skos:definition "Tools for forming internal screw threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taps"@en .

aat:300023299 a skos:Concept ;
    skos:definition "Hard stones used for sharpening edged tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whetstones"@en .

aat:300023303 a skos:Concept ;
    skos:definition "Curved stones used for sharpening gouges with an inside or an outside bevel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouge slips"@en .

aat:300023304 a skos:Concept ;
    skos:definition "Natural or artificial stones covered with oil; used for sharpening blades such as plane irons or chisels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil stones"@en .

aat:300023312 a skos:Concept ;
    skos:definition "Machines for welding that use a power supply to create an electric arc between an electrode and the base material, in order to melt metals at the welding point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arc welding machines"@en .

aat:300023319 a skos:Concept ;
    skos:definition "Benches used in conjunction with drawplates for drawing long or tough lengths of wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawbenches"@en .

aat:300023320 a skos:Concept ;
    skos:definition "Pincers with gripping jaws used for working metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking pliers"@en .

aat:300023322 a skos:Concept ;
    skos:definition "Any of several styles of pliers that can be used for cutting, swaging, or hammering, as well as for gripping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination pliers"@en .

aat:300023333 a skos:Concept ;
    skos:definition "Tools with a pistol grip and a small electrically heated bit that reaches operating temperatures rapidly; used to solder electrical components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soldering guns"@en .

aat:300023334 a skos:Concept ;
    skos:definition "Tools for joining metals with solder, having a wedge-shaped metal bit, usually of copper, which is heated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soldering irons"@en .

aat:300023336 a skos:Concept ;
    skos:definition "Tongs used in metalworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking tongs"@en .

aat:300023337 a skos:Concept ;
    skos:definition "Tongs designed with a gap for holding around an obstruction at or near one end, usually to fit over the head of a bolt in order to grip the shank of the bolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolt tongs"@en .

aat:300023338 a skos:Concept ;
    skos:definition "Tongs having a shank and bit where one side fits into the opposing side, which has a negative form of a proper shape to receive the first side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box tongs"@en .

aat:300023340 a skos:Concept ;
    skos:definition "Flat tongs whose faces are shaped to pull or grip wire; used in welding clips and in horseshoeing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clip tongs"@en .

aat:300023341 a skos:Concept ;
    skos:definition "Tongs with one straight jaw and one crooked jaw; used by blacksmiths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crook-bit tongs"@en .

aat:300023345 a skos:Concept ;
    skos:definition "Tongs whose jaws have flat straight faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat tongs"@en .

aat:300023349 a skos:Concept ;
    skos:definition "Blacksmiths' tongs having projecting lugs for engaging holes of hammerheads during forging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer tongs"@en .

aat:300023351 a skos:Concept ;
    skos:definition "Tongs to hold hammers being reforged. The prong fits into one eye of the hammer, while the bottom piece keeps the head from twisting sideways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box hammer tongs"@en .

aat:300023352 a skos:Concept ;
    skos:definition "Tongs with two hollow, rounded tips for gripping round stock, either metal or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow-bit tongs"@en .

aat:300023354 a skos:Concept ;
    skos:definition "Tongs whose jaws are bent at a right angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoop tongs"@en .

aat:300023355 a skos:Concept ;
    skos:definition "Very light duty tongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail tongs"@en .

aat:300023356 a skos:Concept ;
    skos:definition "Tongs of all kinds that are used for picking up work as opposed to holding the work while it is forged or manipulated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickup tongs"@en .

aat:300023360 a skos:Concept ;
    skos:definition "Tongs having slightly curved, rounded tips for gripping the end of round stock, as used by blacksmiths. For tongs with a larger rounded opening, designed for gripping the shank of round stock, use “hollow-bit tongs.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round-lip tongs"@en .

aat:300023361 a skos:Concept ;
    skos:definition "Tongs with cupped jaws for gripping horseshoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe tongs"@en .

aat:300023362 a skos:Concept ;
    skos:definition "Tongs with an overlapping bent bit designed to hold flat strips of iron from the side, parallel to the tongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side tongs"@en .

aat:300023365 a skos:Concept ;
    skos:definition "Vises designed to hold metal material or objects for metalworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking vises"@en .

aat:300023366 a skos:Concept ;
    skos:definition "Portable vises used to hold pipes in the jaw by means of a chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain-pipe vises"@en .

aat:300023367 a skos:Concept ;
    skos:definition "Any of the various blacksmithing vises that have one long leg which is attached to a bench (and often supported at the foot) and a simple spring mechanism to hold the jaws open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leg vises"@en .

aat:300023371 a skos:Concept ;
    skos:definition "Wrenches used for metalworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking wrenches"@en .

aat:300023373 a skos:Concept ;
    skos:definition "Wrenches which consist of a steel bar, hexagonal in section, bent to form a right angle; used for Allen screws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Allen wrenches"@en .

aat:300023374 a skos:Concept ;
    skos:definition "Plumbers' tongs used for turning pipes, consisting of a lever arm which has sharp teeth that engage the pipe and a short adjustable chain which is wrapped around the pipe to hold it securely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain tongs"@en .

aat:300023379 a skos:Concept ;
    skos:definition "Electric or pneumatic wrenches whose adjustable torque is supplied to a nut or bolt in short, rapid impulses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impact wrenches"@en .

aat:300023380 a skos:Concept ;
    skos:definition "Wrenches with one adjustable jaw which moves vertically along the shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monkey wrenches"@en .

aat:300023381 a skos:Concept ;
    skos:definition "Wrenches whose jaws have a fixed width of opening at one or both ends of the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open-end wrenches"@en .

aat:300023382 a skos:Concept ;
    skos:definition "Box wrenches with a recessed socket that fits over a nut; used for tightening or removing nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socket wrenches"@en .

aat:300023384 a skos:Concept ;
    skos:definition "Adjustable wrenches with long tapering steel handles terminating in an open-end wrench at one end; used primarily in plumbing to tighten large square nuts and to align holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spud wrenches"@en .

aat:300023385 a skos:Concept ;
    skos:definition "Wrenches used to turn taps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tap wrenches"@en .

aat:300023386 a skos:Concept ;
    skos:definition "Wrenches that measure and indicate the amount of turning and twisting force being applied, as when tightening nuts or bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torque wrenches"@en .

aat:300023389 a skos:Concept ;
    skos:definition "Stacks of iron rollers used in papermaking to smooth paper or to give it a glossy surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calenders"@en .

aat:300023390 a skos:Concept ;
    skos:definition "Handmade papermaking tools which consist of a removable rectangular frame that forms the raised edge of the wire cloth of the mold and holds the stock suspension on the wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deckles"@en .

aat:300023391 a skos:Concept ;
    skos:definition "Devices used for macerating fibers, usually from rags, into a pulp to be used for papermaking. Specifically: a hand-operated device with a handle and hammer-head fixed to a support, that is raised and lowered successively to pound the material beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stampers"@en .

aat:300023394 a skos:Concept ;
    skos:definition "General term for tools and equipment used to cut paper and paper products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papercutting tools"@en .

aat:300023395 a skos:Concept ;
    skos:definition "Knife-like devices or sharp rotating wheels for cutting paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papercutting knives"@en .

aat:300023396 a skos:Concept ;
    skos:definition "Knives used by paper hangers for trimming wall paper at baseboards and around window and door frames ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casing knives"@en .

aat:300023397 a skos:Concept ;
    skos:definition "Relatively small knives having a short, curved blade; used in interior construction and crafts. Used primarily for cutting linoleum, sheets of veneer, vinyl, heavy paper board, carpeting, and other moderately flexible materials of similar weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linoleum knives"@en .

aat:300023398 a skos:Concept ;
    skos:definition "Knife-like hand held cutting tools used for cutting mat board, often in combination with a separate straight edge. For devices having a cutting edge and straight edge mounted together, use \"mat cutters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mat knives"@en .

aat:300023399 a skos:Concept ;
    skos:definition "Devices or machines for cutting the edges of paper or cutting paper into sections, often having the mechanism of a guillotine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper cutters"@en .

aat:300023400 a skos:Concept ;
    skos:definition "Devices having a razor-sharp blade mounted with a straight edge, and so-designed to cut matboard; may be used for straight cutting or for bevel cutting of mat windows. For hand held, knife-like devices, use \"mat knives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mat cutters"@en .

aat:300023403 a skos:Concept ;
    skos:definition "Brushes with flat wooden handles of varying length mounted with very stiff bristles in a long, narrow formation, used to spread paste on the back of wallpaper and also to press the pasted paper onto the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper brushes"@en .

aat:300023405 a skos:Concept ;
    skos:definition "Equipment used in the cutting or weaving of weaving of rushes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rushworking tools"@en .

aat:300023406 a skos:Concept ;
    skos:definition "Long tapering cones used to stretch holes in rushwork, to open the strands of a rope in splicing, or to enlarge a hole, as in leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fids"@en .

aat:300023408 a skos:Concept ;
    skos:definition "Knives used for cutting rushes or weaving them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rushworking knives"@en .

aat:300023409 a skos:Concept ;
    skos:definition "Small knives with a wide blade; used for trimming a finished basket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picking knives"@en .

aat:300023411 a skos:Concept ;
    skos:definition "Knives with a long curved blade, used in rushworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "willow knives"@en .

aat:300023413 a skos:Concept ;
    skos:definition "Small awls used in caning chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peg awls"@en .

aat:300023417 a skos:Concept ;
    skos:definition "Clippers used for cutting off the ends of cane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side cutters"@en .

aat:300023418 a skos:Concept ;
    skos:definition "Chisels used for removing old cane strips from furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spline chisels"@en .

aat:300023426 a skos:Concept ;
    skos:definition "Instruments, often in the form of a comb or board, with sharp pins or teeth for the manual disentanglement of scutched hemp or flax fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatchels"@en .

aat:300023428 a skos:Concept ;
    skos:definition "Parts of a spinning machine which twist the thread as it conducts it to and winds it upon a bobbin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flyers"@en .

aat:300023430 a skos:Concept ;
    skos:definition "Revolving devices used in winding yarn or thread into hands or skeins consisting usually of a light frame with radial arms on a central axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reels"@en .

aat:300023431 a skos:Concept ;
    skos:definition "Hand reels used to skein and measure yarn, consisting of a bar with shorter horizontal bars at either end around which spun wool is wound in a figure-of-eight movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niddy-noddies"@en .

aat:300023433 a skos:Concept ;
    skos:definition "Wooden instruments resembling a sword, paddle, or butcher's knife, used for beating and scraping flax, hemp, cotton, or other fibrous plant material in order to separate the fibers from woody or coarse particles.The tools may be hand-held or attached to a wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swingles"@en .

aat:300023439 a skos:Concept ;
    skos:definition "Frames used for preparing very long warp threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warping mills"@en .

aat:300023441 a skos:Concept ;
    skos:definition "Pointed tweezers for lifting knots from wool, so that their luster is not lost by handling them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burling irons"@en .

aat:300023442 a skos:Concept ;
    skos:definition "Smooth shapes, often in the shape of an egg, over which fabrics are stretched for repair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darning eggs"@en .

aat:300023443 a skos:Concept ;
    skos:definition "Mushroom-shaped forms over which fabric is stretched for repair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darning mushrooms"@en .

aat:300023444 a skos:Concept ;
    skos:definition "Frames, often made of wire, used as a fitting model in making dresses. Often custom shaped to the person for whom the dress is designed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress forms"@en .

aat:300023446 a skos:Concept ;
    skos:definition "Small cushions, often shaped like strawberries, filled with emery powder and used to keep sewing needles rust free and sharp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emery cushions"@en .

aat:300023448 a skos:Concept ;
    skos:definition "Device to iron hats, for example men's silk hats, during creation and as part of maintenance in the owner's wardrobe. One use of the device was to lay down the nap on the fabric of the hat. The hat iron may be used for other tasks in sewing, beyond hat creation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat irons"@en .

aat:300023449 a skos:Concept ;
    skos:definition "Tools used for laying gold thread, or other metallic thread; one design is flat on one end and pointed on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mellores"@en .

aat:300023450 a skos:Concept ;
    skos:definition "Devices for threading needles; designs vary, but most have a pointed end to push the thread through the eye of a needle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle threaders"@en .

aat:300023451 a skos:Concept ;
    skos:definition "Cases for holding sewing needles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle cases"@en .

aat:300023455 a skos:Concept ;
    skos:definition "Small cushions into which pins are stuck until needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pincushions"@en .

aat:300023456 a skos:Concept ;
    skos:definition "Cylindrical cases to hold pins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pin-poppets"@en .

aat:300023457 a skos:Concept ;
    skos:definition "Thick and protective thimble palms, worn when using sharp tools like awls and needles to prevent injury to the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's palms"@en .

aat:300023459 a skos:Concept ;
    skos:definition "Cutting tools consisting of two bevel-edged cutting blades and handles, and being movable past one another on a pivot in the center by which they are held together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scissors"@en .

aat:300023460 a skos:Concept ;
    skos:definition "Small scissors having a form specialized for cutting buttonholes; they are typically forged for strong cuts and to stay sharp for long periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttonhole scissors"@en .

aat:300023461 a skos:Concept ;
    skos:definition "Small scissors with two sharp points designed for precision cutting of thread ends and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidery scissors"@en .

aat:300023462 a skos:Concept ;
    skos:definition "Scissors with zig-zag edges to make jagged cuts. Used to cut edges of fabrics to prevent fraying and unraveling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinking shears"@en .

aat:300023463 a skos:Concept ;
    skos:definition "Relatively small scissors with pointed tips, used for cutting thread, seams, and other tasks in sewing; may be used for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimming scissors"@en .

aat:300023464 a skos:Concept ;
    skos:definition "Small tool having a sharp, pointed edge for unpicking sewn stitches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seam rippers"@en .

aat:300023465 a skos:Concept ;
    skos:definition "Cylindrical pads on which seams can be pressed open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seam rolls"@en .

aat:300023466 a skos:Concept ;
    skos:definition "Clamps of metal, wood, or plastic, used to hold work at one end so that it can be stretched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing clamps"@en .

aat:300023467 a skos:Concept ;
    skos:definition "Sewing clamps used to keep fabric taut, usually made of bronze, and topped with the image of a bird."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemming birds"@en .

aat:300023469 a skos:Concept ;
    skos:definition "Slender, pointed needles designed for sewing, to pierce and draw thread or other fiber through cloth or another flexible material. They generally have one or more holes or eyes at one end for thread to pass through; they are now usually of polished steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing needles"@en .

aat:300023470 a skos:Concept ;
    skos:definition "Needles having rounded tips, used for sewing knits and other materials where it is desirable to shift fibers rather than piercing or snagging fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball-point needles"@en .

aat:300023471 a skos:Concept ;
    skos:definition "Very fine, straight sewing needles used for beading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead needles"@en .

aat:300023472 a skos:Concept ;
    skos:definition "Needles with a very large eye and a sharp point, used for making embroidery with chenille yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chenille needles"@en .

aat:300023473 a skos:Concept ;
    skos:definition "Needles with long-shaped eyes that take flat, darning threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darning needles"@en .

aat:300023475 a skos:Concept ;
    skos:definition "Sewing needles designed to allow easier threading. One design includes, in addition to a regular eye, a V-shaped opening and slit in the top end from which the thread can be inserted and pulled into the eye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-threading needles"@en .

aat:300023476 a skos:Concept ;
    skos:definition "Needles used for sewing in the loose ends and joining pieces woven in different colors of a tapestry. Tapestry needles are long, strong, and blunt-ended with a long-shaped, wide eye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry needles"@en .

aat:300023478 a skos:Concept ;
    skos:definition "Round or ham-shaped pads for pressing clothing during sewing or maintenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tailor's hams"@en .

aat:300023481 a skos:Concept ;
    skos:definition "A silver object suspended from the girdle, like a chatelaine, used in 18th century Holland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread holders"@en .

aat:300023482 a skos:Concept ;
    skos:definition "Devices for threading a needle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "threaders"@en .

aat:300023483 a skos:Concept ;
    skos:definition "Wheels either smooth or serrated, used to transfer pattern markings to fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracing wheels"@en .

aat:300023485 a skos:Concept ;
    skos:definition "Any of various small, round, or cylindrical devices usually of bone, wood, or metal on which threads are wound for use in textile fabrication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bobbins"@en .

aat:300023486 a skos:Concept ;
    skos:definition "Small pointed instruments for piercing holes in cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodkins"@en .

aat:300023487 a skos:Concept ;
    skos:definition "Frames used for the manufacture, processing, or embellishment of textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile frames"@en .

aat:300023488 a skos:Concept ;
    skos:definition "Devices that hold a stretched quilt horizontally which enables holding three layers of the quilt (backing, batting, and quilt top) without the need for basting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilting frames"@en .

aat:300023489 a skos:Concept ;
    skos:definition "Frames that hold the fabric support of a rug while it is being worked by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rug frames"@en .

aat:300023490 a skos:Concept ;
    skos:definition "Frames used for preparing the warp threads for a loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warping frames"@en .

aat:300023492 a skos:Concept ;
    skos:definition "Small generally straight implements used for looping stitches over one another in crochet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crochet hooks"@en .

aat:300023493 a skos:Concept ;
    skos:definition "Hand tools that take the yarn through the canvas and bring it back to the surface; used for knotting rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latch hooks"@en .

aat:300023494 a skos:Concept ;
    skos:definition "Devices used to create loops in a fabric support to create tufted or hooked rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rug hooks"@en .

aat:300023495 a skos:Concept ;
    skos:definition "Semi automatic hooks used to speed up work on looped rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speed hooks"@en .

aat:300023496 a skos:Concept ;
    skos:definition "Tools used for bead or French embroidery beading, as well as decorative chain stitch embroidery called tambour embroidery. These have a small, bent tip similar to a crochet hook or rug hooking tool. The hook catches the thread on the backside of the fabric, pulling it to the front side to create loops or attach beads or sequins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tambour hooks"@en .

aat:300023497 a skos:Concept ;
    skos:definition "Semi- for fully-mechanized devices comprising an assemblage of needles on which flat or tubular garments can be knitted. To facilitate the knitting process, an open toe circle of fabric is held on the device's split dial, which automatically folds over to transfer and double-up the loops onto half of the dial for loop-to-loop linking. These devices come in myriad models, varing in degrees of complexity. Depending on the device model, knitting pattern stitches can be selected by hand manipulation of the needles, push-bottons and dials, mechanical punch cards, or electronic pattern reading devices and computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting machines"@en .

aat:300023498 a skos:Concept ;
    skos:definition "Pillows on which a certain type of lace is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace pillows"@en .

aat:300023500 a skos:Concept ;
    skos:definition "Any looms used to weave a fabric 54 inches or wider."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broad looms"@en .

aat:300023503 a skos:Concept ;
    skos:definition "Looms on which the heddles operate on cords revolving over rods or pulley with or without heddle-horses for support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter-balance looms"@en .

aat:300023505 a skos:Concept ;
    skos:definition "Any of various looms or weaving devices operated wholly or partly by hand or foot power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handlooms"@en .

aat:300023507 a skos:Concept ;
    skos:definition "Simple looms with the warp threads stretched between parallel sticks, one of them attached to a post or tree, the other to the weaver's body by a strap around the waist by which the weaver controls tension in the warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backstrap looms"@en .

aat:300023508 a skos:Concept ;
    skos:definition "Looms designed for weaving beading, using strings or threads with threaded seed beads or similar beads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead looms"@en .

aat:300023511 a skos:Concept ;
    skos:definition "Simple hand looms consisting of a pliable branch bent in a semicircle, between the two arms of which the longer threads are stretched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow looms"@en .

aat:300023512 a skos:Concept ;
    skos:definition "Handlooms used for weaving long strips of braid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkle looms"@en .

aat:300023513 a skos:Concept ;
    skos:definition "Handloom used for weaving rectangles of fabric, used vertically. Yarn is wound across nails in the frame, and weaving sticks are used to form sheds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame looms"@en .

aat:300023514 a skos:Concept ;
    skos:definition "Looms fitted with rollers so that considerable lengths of fabric may be woven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table looms"@en .

aat:300023515 a skos:Concept ;
    skos:definition "Looms in which the warp threads are kept taut by weights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp-weighted looms"@en .

aat:300023516 a skos:Concept ;
    skos:definition "Devices incorporated in special looms to control individual warp yarns via a system of punched cards. This invention, by Joseph Marie Jacquard, and first demonstrated in 1801, enabled looms to produce fabrics with complex patterns and images such as tapestry, brocade, damask, and matelasse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacquard looms"@en .

aat:300023517 a skos:Concept ;
    skos:definition "Mechanized devices, comprising hairpin-like components called doups attached to the heedle, designed to produce leno weave in which some of the warp ends are twisted partly around, rather than lying parallel with, other ends. To facilitate the leno weaving process, the device's doup alternately pulls the second warp yarn up or down to the right or left of each pick passage, a process that twists the pair of warps around each filling yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leno looms"@en .

aat:300023519 a skos:Concept ;
    skos:definition "Small harp-shaped tools used for making chains of crocheted thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lucets"@en .

aat:300023520 a skos:Concept ;
    skos:definition "Boards made of soft material such as cork on which cord may be pinned and worked into knotted designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macrame boards"@en .

aat:300023523 a skos:Concept ;
    skos:definition "Paired needles made of steel, wood, bone or other material, used for knitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting needles"@en .

aat:300023524 a skos:Concept ;
    skos:definition "Flexible needles with a point on each end; used for knitting a seamless tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular needles"@en .

aat:300023525 a skos:Concept ;
    skos:definition "Knitting needles with points or hooks at each end used in either hand or machine knitting to create more complicated constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-pointed needles"@en .

aat:300023527 a skos:Concept ;
    skos:definition "Tools used for embroidery or rug making that create a field of tightly-packed loops of thread or yarn on a woven fabric substrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch needles"@en .

aat:300023528 a skos:Concept ;
    skos:definition "Cylindrical devices on which something is wound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spools"@en .

aat:300023529 a skos:Concept ;
    skos:definition "Implements used to hold stitches in yarn while they are not being worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stitch holders"@en .

aat:300023530 a skos:Concept ;
    skos:definition "Reed or bamboo pens used to apply hot wax to batik work. The hot wax is poured into a copper bowl at the tip the pen and exits through a thin needle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantings"@en .

aat:300023533 a skos:Concept ;
    skos:definition "Describes a variety of devices for winding fiber, thread, or yarn onto another object such as a spindle or bobbin, or into a self contained ball or skein."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winders"@en .

aat:300023534 a skos:Concept ;
    skos:definition "Devices used for producing bobbins that are evenly covered with yarn, used to wind thread or yarn around a bobbin. These usually include a fixed shaft that is rotated continously, distributing the thread uniformly onto the mounted bobbin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bobbin winders"@en .

aat:300023535 a skos:Concept ;
    skos:definition "Tools used in the process of covering and stuffing furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstering tools"@en .

aat:300023536 a skos:Concept ;
    skos:definition "Hammers with very small narrow faces used in upholstery for show-wood or neat work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabriolet hammers"@en .

aat:300023540 a skos:Concept ;
    skos:definition "Heavy-guage and often curved needles used to sew or repair any seam that cannot fit through a sewing machine or be flattened, such as on furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery needles"@en .

aat:300023543 a skos:Concept ;
    skos:definition "Fine steel needles that have a butt at one end and a long flexible hook at the other that curves back to the shank of the needle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring needles"@en .

aat:300023547 a skos:Concept ;
    skos:definition "Small wood tools used to give tension to the webbing which forms the foundation in most types of upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web strainers"@en .

aat:300023553 a skos:Concept ;
    skos:definition "Long-handled tools with a curved blade set perpendicular to the shaft and curving inwards towards it; used for cutting or slicing away the surface of wood, such as in dressing lumber. For similar tools but used for cutting, use \"axes (tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adzes"@en .

aat:300023554 a skos:Concept ;
    skos:definition "Tools similar to rounding adzes, but used for rougher work, including, but not limited to, cross-cutting bungs and stock for bungs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bunging adzes"@en .

aat:300023556 a skos:Concept ;
    skos:definition "Long handled adzes whose blade is beveled on the inside; later adzes have polls on the head which are used as a maul."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpenters' adzes"@en .

aat:300023557 a skos:Concept ;
    skos:definition "Short-handled adzes used for splitting wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleaving adzes"@en .

aat:300023558 a skos:Concept ;
    skos:definition "Adzes whose blade edges are turned upwards on each side to give a trenching cut, a square rather than round channel; also used to cut scores or notches across the grain at intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lipped adzes"@en .

aat:300023560 a skos:Concept ;
    skos:definition "Two-bladed tools having the larger blade in the form of an adz and the smaller in the form of a hatchet; distinguished from \"adze-hatchets\" in which the hatchet blade is larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatchet-adzes"@en .

aat:300023561 a skos:Concept ;
    skos:definition "Adzes with a blade gouge-shaped in cross section and designed for hollowing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollowing adzes"@en .

aat:300023568 a skos:Concept ;
    skos:definition "Very broad, flat adzes having a spur or punch on the back of the head which can be used as a nail set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipwrights' adzes"@en .

aat:300023569 a skos:Concept ;
    skos:definition "Adzes with dull blades; used to strike barrel hoops into place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trussing adzes"@en .

aat:300023572 a skos:Concept ;
    skos:definition "Tools with a long steel bit used for boring holes. Examples are carpenter's tools for boring holes in wood, etc., having a long pointed shank with a cutting edge and a screw point, and a handle fixed at right angles to the top of the shank, by means of which the tool is worked round with both hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "augers"@en .

aat:300023573 a skos:Concept ;
    skos:definition "Augers having a wood stock with a shell or nose bit; turned by a wood bar passing through a hole in the top of the stock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breast augers"@en .

aat:300023574 a skos:Concept ;
    skos:definition "Augers whose points are heated to burn holes in wood and then twisted to enlarge the holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burn augers"@en .

aat:300023575 a skos:Concept ;
    skos:definition "Augers designed with a hollow cylindrical tip or shaft, to allow removal of a plug, disk, or cylinder of wood, soil, or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder augers"@en .

aat:300023583 a skos:Concept ;
    skos:definition "Augers made in the form of a tapered, conical half-funnel, with one or both of the exposed edges side-sharpened to cut laterally. They are used to cut conical holes for coopers, ladder makers, wheelwrights, chair makers, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taper augers"@en .

aat:300023590 a skos:Concept ;
    skos:definition "Pointed tools used for making holes in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking awls"@en .

aat:300023591 a skos:Concept ;
    skos:definition "Tools resembling ice picks, used to make holes for brads and wood screws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bradawls"@en .

aat:300023595 a skos:Concept ;
    skos:definition "Awls used for burning holes in wood, often to remove sap from trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning awls"@en .

aat:300023596 a skos:Concept ;
    skos:definition "Sharp-pointed steel instruments used for laying out work, especially on hard wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scribe awls"@en .

aat:300023604 a skos:Concept ;
    skos:definition "Axes, typically having a metal or stone head mounted to a wooden shaft, used for chopping, cutting, smoothing, and otherwise working wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking axes"@en .

aat:300023605 a skos:Concept ;
    skos:definition "Axes having a large, broad blade bevelled on one side, used for the rough dressing of timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadaxes"@en .

aat:300023609 a skos:Concept ;
    skos:definition "Axes with a long blade, up to one foot, with a flared-shaped cheek and no poll; used for paring and trimming masts and spars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mast axes"@en .

aat:300023613 a skos:Concept ;
    skos:definition "Axes used like a chisel, in conjunction with a mallet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortising axes"@en .

aat:300023617 a skos:Concept ;
    skos:definition "Small two-headed axes used for cutting mortises; one end is chisel-shaped and the other is a triangular knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twivels"@en .

aat:300023630 a skos:Concept ;
    skos:definition "Axes of various kinds used in building ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipwrights' axes"@en .

aat:300023635 a skos:Concept ;
    skos:definition "Hand tools with a handle, crank, and chuck; used for turning a bit or auger to drill a hole by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braces"@en .

aat:300023649 a skos:Concept ;
    skos:definition "Braces with a ratchet-driven chuck, permitting its use in confined spaces where complete circular sweeps of an ordinary brace would be impossible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratchet braces"@en .

aat:300023650 a skos:Concept ;
    skos:definition "Chisels used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking chisels"@en .

aat:300023651 a skos:Concept ;
    skos:definition "A class of woodworking chisels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench chisels"@en .

aat:300023652 a skos:Concept ;
    skos:definition "Chisels with a short blade; used especially for setting hinges on doors and door frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butt chisels"@en .

aat:300023655 a skos:Concept ;
    skos:definition "Chisels with straight sides which flare rapidly at the blade, forming a fan shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishtail tools"@en .

aat:300023658 a skos:Concept ;
    skos:definition "Chisels with a sharp cutting edge cut at an oblique angle and having beveled sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skew chisels"@en .

aat:300023662 a skos:Concept ;
    skos:definition "Small, narrow V-shaped gouges used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veiners"@en .

aat:300023664 a skos:Concept ;
    skos:definition "Long narrow chisels used for mortising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forming chisels"@en .

aat:300023669 a skos:Concept ;
    skos:definition "Steel chisels having a broad blade and a long shank; especially used for ripping up floor boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor chisels"@en .

aat:300023670 a skos:Concept ;
    skos:definition "Heavier versions of forming chisels; used for harder work and generally fitted with an iron band on the handle to prevent it from splitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "framing chisels"@en .

aat:300023671 a skos:Concept ;
    skos:definition "Grooved or tooth-ended chisels used to cut the channels for hinge fittings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinge chisels"@en .

aat:300023672 a skos:Concept ;
    skos:definition "Steel chisels having a heavy body with a socket shank; used for cutting mortises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortise chisels"@en .

aat:300023676 a skos:Concept ;
    skos:definition "Chisels having two cutting edges which meet at right angles; used to cut corners of mortises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner chisels"@en .

aat:300023682 a skos:Concept ;
    skos:definition "Long-handled chisels used to shape wood by hand without the use of a mallet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paring chisels"@en .

aat:300023685 a skos:Concept ;
    skos:definition "Giant paring chisels which are pushed by the hands and shoulder rather than struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slicks"@en .

aat:300023689 a skos:Concept ;
    skos:definition "Bent chisels used to clear out mortises or seams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ripping chisels"@en .

aat:300023690 a skos:Concept ;
    skos:definition "Chisels having a wide blade honed on both sides; used for deep cutting, such as the mortises in pulley stiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash chisels"@en .

aat:300023693 a skos:Concept ;
    skos:definition "Hand tools that usually take the form of a triangular blade at the end of a shaft; used to make conical depressions for recessing the head of a bolt, nut, or screw so that it is flush with the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countersinks"@en .

aat:300023695 a skos:Concept ;
    skos:definition "Cutters of various types used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking cutters"@en .

aat:300023696 a skos:Concept ;
    skos:definition "Rotary cutting tools used to shape dovetails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dovetail cutters"@en .

aat:300023697 a skos:Concept ;
    skos:definition "Hardened steel plates containing holes of various diameters; used to cut dowels by driving pegs through the holes to remove excess wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dowel plates"@en .

aat:300023700 a skos:Concept ;
    skos:definition "Bits which terminate in a semicircle; used to cut around a hole to produce a core or plug which is then used to conceal recessed screwheads in hardwood floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plug cutters"@en .

aat:300023702 a skos:Concept ;
    skos:definition "Two-handled curved knives used in woodworking; similar knives may be used in other occupations. The knives are utilized by pulling them toward the user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawknives"@en .

aat:300023709 a skos:Concept ;
    skos:definition "Drawknives with a slight downward thrust of the handles for cutting outside curves, such as on the outside of barrel staves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backing drawknives"@en .

aat:300023710 a skos:Concept ;
    skos:definition "Drawknives used to cut an oblique surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamfer knives"@en .

aat:300023713 a skos:Concept ;
    skos:definition "Knives of various designs to be used by coopers, saddlers, curriers, and other professions for making or fitting a head for an object. An example is the knife used by coopers to smooth and trim barrel heads to the proper angle to fit into the staves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heading drawknives"@en .

aat:300023716 a skos:Concept ;
    skos:definition "Drawknives which combine a straight and a hollow blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jiggers"@en .

aat:300023718 a skos:Concept ;
    skos:definition "Long drawknives, approximately 24 inches in length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mast drawknives"@en .

aat:300023721 a skos:Concept ;
    skos:definition "Single-cut files which are half-round on one side and flat on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet files"@en .

aat:300023723 a skos:Concept ;
    skos:definition "Files having a blade-like cross section, with a sharp edge; used to finish narrow grooves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife files"@en .

aat:300023726 a skos:Concept ;
    skos:definition "Cleaving tools whose handles are at a right angle to the blade; used in conjunction with a froe club for splitting wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "froes"@en .

aat:300023750 a skos:Concept ;
    skos:definition "Froes shaped like a knife; usually about 1 foot long."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife froes"@en .

aat:300023752 a skos:Concept ;
    skos:definition "T-shaped tools with a steel shank and a wood head, used to make small holes in wood so that it is easier to start nails or screws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gimlets"@en .

aat:300023756 a skos:Concept ;
    skos:definition "Cutting chisels having a long, curved blade; used for hollowing out wood or making holes, channels, or grooves in wood or stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouges"@en .

aat:300023757 a skos:Concept ;
    skos:definition "Short bowl-shaped gouges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowl gouges"@en .

aat:300023758 a skos:Concept ;
    skos:definition "Long narrow gouges used for cutting grooves; generally beveled on the outside, although they may also be ground on the inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firmer gouges"@en .

aat:300023761 a skos:Concept ;
    skos:definition "Long thin woodworking gouges, the cutting edge of which is beveled on the concave side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paring gouges"@en .

aat:300023764 a skos:Concept ;
    skos:definition "Gouges having a shank that is either curved for its entire length or straight for most of its length with a sharp bend near the tip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bent gouges"@en .

aat:300023766 a skos:Concept ;
    skos:definition "Narrow-bladed hand tools having a V-shaped gouge; used in woodworking for cutting grooves, in wood turning, or for cutting pieces in two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parting tools"@en .

aat:300023767 a skos:Concept ;
    skos:definition "Wood-handled tools having a steel head flattened at one end suitable for striking or driving; formed at the other end into a wide sharp blade used for chopping. The underpart of the blade may be notched for pulling nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatchets"@en .

aat:300023768 a skos:Concept ;
    skos:definition "Two-bladed tools with the larger blade in the shape of a hatchet and the smaller shaped like an adz, as distinguished from \"hatchet-adzes\" in which the adz-shaped blade is the larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adze-hatchets"@en .

aat:300023769 a skos:Concept ;
    skos:definition "Small straight-handled broadaxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hewing hatchets"@en .

aat:300023770 a skos:Concept ;
    skos:definition "Hatchets with flared blades and nail-driving polls; used to split and nail wood roof shingles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shingling hatchets"@en .

aat:300023771 a skos:Concept ;
    skos:definition "Medium-sized hatchets with a nail-pulling claw at the side of a nail-driving poll."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claw hatchets"@en .

aat:300023776 a skos:Concept ;
    skos:definition "Heavy, round iron rods about 3 to 6 inches long, curved round at one end nearly at a right angle; used by coopers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jumpers"@en .

aat:300023782 a skos:Concept ;
    skos:definition "General term for knives used primarily for woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking knives"@en .

aat:300023783 a skos:Concept ;
    skos:definition "Long heavy blades with a handle on one end and an upturned prong on the other end of the blade, used with a stout staple in a bench; the prong is placed under the staple and wood is pared away from a block, log, or other wood piece by levering the knife down. An example of use for a block knife is in the traditional manufacture of wooden clogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block knives"@en .

aat:300023791 a skos:Concept ;
    skos:definition "Woodworkers' knives having fixed, single blades, used in woodcarving, slicing, and trimming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sloyd knives"@en .

aat:300023793 a skos:Concept ;
    skos:definition "Machines in which work is rotated about a horizontal axis and shaped by a fixed cutting, boring, or drilling tool while being held in a chuck, faceplate, or mandrel or between centers in headstock and tailstock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lathes"@en .

aat:300023794 a skos:Concept ;
    skos:definition "Lathes having a mandrel, which is a shaft or spindle to which work is fixed while being turned in the lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandrel lathes"@en .

aat:300023795 a skos:Concept ;
    skos:definition "Primitive lathes in which the cord passing around the work to rotate it is fastened at its ends to the treadle and to an elastic pole above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole lathes"@en .

aat:300023797 a skos:Concept ;
    skos:definition "Lathes in a variety of forms; used for turning irregular forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoke lathes"@en .

aat:300023801 a skos:Concept ;
    skos:definition "Tools having a sharp edge and used for leveling and smoothing the surface of wood or another material by paring shavings from it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planes"@en .

aat:300023802 a skos:Concept ;
    skos:definition "Planes with a moveable fence and interchangeable blades; used for a variety of grooving and molding purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination planes"@en .

aat:300023803 a skos:Concept ;
    skos:definition "Includes any of a variety of planes intended to make grooves in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grooving planes"@en .

aat:300023804 a skos:Concept ;
    skos:definition "Large wood hand planes, the mouths of which are cut obliquely from side to side, so that they can work close to a corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badger planes"@en .

aat:300023805 a skos:Concept ;
    skos:definition "Wide planes with a rabbet taken out of one side and a blade that cuts flush with the rabbet; used for cutting wide bands of particular depths, the depth determined by the depth of the rabbet and the width determined by the width of the blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banding planes"@en .

aat:300023806 a skos:Concept ;
    skos:definition "Planes whose iron is set on a skew; used to cut grooves across the grain of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dado planes"@en .

aat:300023812 a skos:Concept ;
    skos:definition "Four- to 6-inch planes with the front edge open so that the iron can cut at the very nose of the plane; used for trimming in hard to reach places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge planes"@en .

aat:300023816 a skos:Concept ;
    skos:definition "Planes used for cutting square or rectangular rabbets along the edges of boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillister planes"@en .

aat:300023824 a skos:Concept ;
    skos:definition "Carpenters' grooving planes which have an adjustable fence and are capable of being fitted with various irons for cutting grooves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plow planes"@en .

aat:300023829 a skos:Concept ;
    skos:definition "Wood or metal planes which are flat across the sole, in which the cutting iron extends to the extreme edge on one or both sides;(SALAM) used to cut a rabbet along the grain at the edge of the wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbet planes"@en .

aat:300023837 a skos:Concept ;
    skos:definition "Small planes whose mouths can be adjusted for coarse or fine work, used in corners and other difficult to reach places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullnose planes"@en .

aat:300023840 a skos:Concept ;
    skos:definition "Rabbet planes with a horn-shaped front handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horned rabbets"@en .

aat:300023841 a skos:Concept ;
    skos:definition "Planes in which the mouth and edge of the iron are obliquely across the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skew planes"@en .

aat:300023842 a skos:Concept ;
    skos:definition "Planes having special notched cutters, used for trimming the inside of a window frame or doorframe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash planes"@en .

aat:300023843 a skos:Concept ;
    skos:definition "Planes with the stock the same width as the blade, often with one side of the blade sharpened to cut at the same time as the bottom; often used for cleaning up around tenons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder planes"@en .

aat:300023845 a skos:Concept ;
    skos:definition "A class of planes used for reducing, leveling, and smoothing wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench planes"@en .

aat:300023846 a skos:Concept ;
    skos:definition "Small hand-held planes, either of wood or metal, with low-angled cutting blades; used for small work, to clean up rough spots, and especially to clean up end grain and miters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block planes"@en .

aat:300023848 a skos:Concept ;
    skos:definition "Bench planes with a slightly curved blade; used for smoothing flat surfaces of rough boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jack planes"@en .

aat:300023849 a skos:Concept ;
    skos:definition "The longest of the bench planes, ranging from 2 to 3 feet; used to level long boards that are to be joined together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jointer planes"@en .

aat:300023851 a skos:Concept ;
    skos:definition "Planes which are about 26 inches long, a shorter version of the jointer plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long planes"@en .

aat:300023852 a skos:Concept ;
    skos:definition "Two-man, two-handled planes used to make the edges of boards smooth and square in the joining of long staves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "short-jointer planes"@en .

aat:300023855 a skos:Concept ;
    skos:definition "Planes shorter than a jointer plane, about 11 or 12 inches long, with its blade set at less of a pitch than a normal jointer; used for fitting a short joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strike blocks"@en .

aat:300023858 a skos:Concept ;
    skos:definition "Long planes, 22 to 24 inches long, used for smoothing boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trying planes"@en .

aat:300023860 a skos:Concept ;
    skos:definition "Planes having a curved baseplate, either concave or convex, used for smoothing curved woodwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass planes"@en .

aat:300023864 a skos:Concept ;
    skos:definition "Coffin-shaped planes, similar to smoothing planes except that they are round in both planes on the bottom, with a 2-inch single or double iron made in different sizes to fit the barrel it is cleaning and smoothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coopers' stoup planes"@en .

aat:300023868 a skos:Concept ;
    skos:definition "Very small wood planes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger planes"@en .

aat:300023869 a skos:Concept ;
    skos:definition "Long planes, up to 36 inches, used in making floorboards; distinct from \"jointer planes\" in their size and use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor planes"@en .

aat:300023870 a skos:Concept ;
    skos:definition "Planes with a broad curved blade; used to smooth the inside of barrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "howell planes"@en .

aat:300023879 a skos:Concept ;
    skos:definition "Planes with a semicircular shape when viewed from above; used to smooth and level the ends of the staves of barrels after the barrels have been assembled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun-planes"@en .

aat:300023882 a skos:Concept ;
    skos:definition "Planes with a serrated blade mounted nearly vertical; used to roughen a surface prior to application of a veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothing planes"@en .

aat:300023885 a skos:Concept ;
    skos:definition "Molding planes with complicated profiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "complex molding planes"@en .

aat:300023886 a skos:Concept ;
    skos:definition "General term for wide molding planes with a simple or complicated profile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornice planes"@en .

aat:300023892 a skos:Concept ;
    skos:definition "Molding planes made with an ogee profile, usually made in sets of two for the two sides of a handrail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handrail planes"@en .

aat:300023893 a skos:Concept ;
    skos:definition "Any kind of large complex molding plane which is pulled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molding pull planes"@en .

aat:300023895 a skos:Concept ;
    skos:definition "Molding planes with simple profiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simple molding planes"@en .

aat:300023897 a skos:Concept ;
    skos:definition "Planes having a curved cutting edge which makes bead moldings along a wood surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead planes"@en .

aat:300023899 a skos:Concept ;
    skos:definition "Planes used in conjunction with a set of handrail planes; the former cuts the top of the handrail and the latter cuts the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capping planes"@en .

aat:300023909 a skos:Concept ;
    skos:definition "Planes with convex soles; used for planing out wooden gutters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guttering planes"@en .

aat:300023914 a skos:Concept ;
    skos:definition "Planes with a concave sole for cutting rounded moldings; usually paired with round planes in a set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow planes"@en .

aat:300023915 a skos:Concept ;
    skos:definition "Planes used to cut a semicircular convex profile on the edge of the wood, such as a stair tread or a window board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nosing planes"@en .

aat:300023916 a skos:Concept ;
    skos:definition "Planes with a convex blade for cutting hollow molding patterns; usually paired with hollow planes in sets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round planes"@en .

aat:300023917 a skos:Concept ;
    skos:definition "Planes with a single cutting iron, used for rough-shaping or preliminary planing; suited for rougher work than the jack plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roughing planes"@en .

aat:300023923 a skos:Concept ;
    skos:definition "Planes with a cutting blade set in a stock that has a round hole in it and is twisted down over a piece of work; used to make round stock such as broom handles and spokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rounder planes"@en .

aat:300023926 a skos:Concept ;
    skos:definition "Small planes used to hollow out scoops and shovels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scooper planes"@en .

aat:300023928 a skos:Concept ;
    skos:definition "Planes used to produce a shaving of wood for such purposes as basketry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splint planes"@en .

aat:300023935 a skos:Concept ;
    skos:definition "Small planes, approximately 4 to 6 inches long, with the sole curved along the longitudinal axis like a compass plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modeling planes"@en .

aat:300023938 a skos:Concept ;
    skos:definition "Punches used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking punches"@en .

aat:300023939 a skos:Concept ;
    skos:definition "Steel punches with a decorative face, used for marking wood to give texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carvers' punches"@en .

aat:300023940 a skos:Concept ;
    skos:definition "Short steel bars, square in section, with one end tapered to a chisel point and bent slightly backwards; used for tightening the nuts of handrail bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handrail punches"@en .

aat:300023941 a skos:Concept ;
    skos:definition "Short steel rods, usually tapered; used to drive a nail or brad below, or flush with, a wood surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail sets"@en .

aat:300023945 a skos:Concept ;
    skos:definition "Hinged tools with a stable bed for punching holes in shingles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shingle punches"@en .

aat:300023946 a skos:Concept ;
    skos:definition "Plain steel rods, about 8 to 10 inches long, usually tapered toward one end; used for driving bolts out of holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starting punches"@en .

aat:300023948 a skos:Concept ;
    skos:definition "Irregularly-shaped punches used when replacing damaged veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneer punches"@en .

aat:300023950 a skos:Concept ;
    skos:definition "Rasps which are half-round on one side and flat on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet rasps"@en .

aat:300023951 a skos:Concept ;
    skos:definition "Curved rasps in a variety of shapes and cross sections; used for carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riffler rasps"@en .

aat:300023956 a skos:Concept ;
    skos:definition "Curved, tapered cone-shaped blades with a handle and a hook on the tapered end; used to enlarge the hub-holes of wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooked reamers"@en .

aat:300023958 a skos:Concept ;
    skos:definition "Electrically driven devices with various bits; used for cutting grooves and channels in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "routers"@en .

aat:300023959 a skos:Concept ;
    skos:definition "Stationary machines having a moving belt, disk, or spindle with an abrasive surface, usually a sandpaper; used for smoothing surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanding machines"@en .

aat:300023960 a skos:Concept ;
    skos:definition "Portable tools with power-driven, abrasive-coated continuous belts, used to smooth surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt sanders"@en .

aat:300023962 a skos:Concept ;
    skos:definition "Sanders shaped so that they can be used to smooth complex moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contour sanders"@en .

aat:300023964 a skos:Concept ;
    skos:definition "Power hand tools that have a rotating, circular abrasive disk; used for smoothing or polishing a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disk sanders"@en .

aat:300023967 a skos:Concept ;
    skos:definition "Electric-powered hand tools used for smoothing and polishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power sanders"@en .

aat:300023968 a skos:Concept ;
    skos:definition "Sanding machines in which the sandpaper is carried on a small-diameter vertical drum located on the work table of the machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spindle sanders"@en .

aat:300023971 a skos:Concept ;
    skos:definition "Machines that utilizes several parallel saw blades which can cut all of the boards of a log in one pass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gang sawmills"@en .

aat:300023974 a skos:Concept ;
    skos:definition "Machines which utilize the up-and-down motion of a straight saw blade, but which depend on clamps to hold the saw blade stiff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muley sawmills"@en .

aat:300023975 a skos:Concept ;
    skos:definition "Machines which utilize a frame to support a vertical saw blade that moves up and down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "up-and-down sawmills"@en .

aat:300023976 a skos:Concept ;
    skos:definition "Saws designed for use with wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking saws"@en .

aat:300023977 a skos:Concept ;
    skos:definition "Small handsaws whose back edge is stiffened with a steel or brass strip; used in finish carpentry for cutting mitered joints and other joinery work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backsaws"@en .

aat:300023978 a skos:Concept ;
    skos:definition "Small backsaws, 3 to 6 inches in length, with very fine teeth and very little set; used for fine work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead saws"@en .

aat:300023983 a skos:Concept ;
    skos:definition "Back saws with removable interchangeable blades and a thumb hook at the toe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blitz-back saws"@en .

aat:300023985 a skos:Concept ;
    skos:definition "Small backsaws, about 9 inches in length, with thin blades, fine teeth, and straight handles; used for accurate work, as in cabinetmaking and patternmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dovetail saws"@en .

aat:300023993 a skos:Concept ;
    skos:definition "Saw sets in a plane-like stock with an adjustable fence and blade; used to saw rabbets in the edge of a board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbet saws"@en .

aat:300023995 a skos:Concept ;
    skos:definition "Thin saws with approximately 11 teeth per inch, stiffened with a metal rib along the top to prevent buckling; used to smooth cut the edges of tenons, dovetails, or miter fittings; a modern variety of the tenon saw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carcass saws"@en .

aat:300023996 a skos:Concept ;
    skos:definition "Thin steel disks, with teeth on their periphery, that rotate on a power-driven spindle; used either as hand tools or are table-mounted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular saws"@en .

aat:300023998 a skos:Concept ;
    skos:definition "Circular saws designed to operate with a built-in wobble so that the kerf it makes is greater than the thickness of the saw; used for grooving and for other special purposes in carpentry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drunken saws"@en .

aat:300024000 a skos:Concept ;
    skos:definition "Curved saws supported on a frame on a fulcrum, which can swing back and forth, cutting as it does."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendulum saws"@en .

aat:300024002 a skos:Concept ;
    skos:definition "Circular saws suspended from and moving along a cantilevered arm mounted above the saw table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radial-arm saws"@en .

aat:300024004 a skos:Concept ;
    skos:definition "Circular saws that are portable, not permanently mounted in a table, and are powered by electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric portable saws"@en .

aat:300024009 a skos:Concept ;
    skos:definition "Circular saws that are set below the surface of a table having a slot through which the saw blade protrudes.(DAC) The blade can be raised or lowered to control the depth of cut, and it can usually be tilted to provide a cut of a particular angle. The same equipment may be described as \"bench saws.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table saws"@en .

aat:300024010 a skos:Concept ;
    skos:definition "Saws which are set within a wood frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame saws"@en .

aat:300024011 a skos:Concept ;
    skos:definition "Hand saws with a thin blade held in place between the two ends of a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow saws"@en .

aat:300024015 a skos:Concept ;
    skos:definition "Light hand saws with a narrow blade mounted in a U-shaped frame with a handle; used to cut curves in wood. The blade may be rotated to keep the frame away from the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coping saws"@en .

aat:300024017 a skos:Concept ;
    skos:definition "Large frame saws used to cut straight or slightly curved pieces of wood; often used by wheelwrights and furniture workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felloe saws"@en .

aat:300024023 a skos:Concept ;
    skos:definition "Large pit saws supplied with frames; used to cut logs into boards or planks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame pit saws"@en .

aat:300024029 a skos:Concept ;
    skos:definition "Large two-man saws used to saw boards from the lengths of logs which are placed over big pits. The saws are operated by one man standing on the log and the other standing in the pit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pit saws"@en .

aat:300024032 a skos:Concept ;
    skos:definition "Hand saws set in a deep U-shaped frame with a thin blade, which is slightly wider than the blade of a fretsaw; especially suited to cutting curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scroll saws"@en .

aat:300024034 a skos:Concept ;
    skos:definition "Saws having a handle like that of a knife, being usually long enough to be used by two hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open saws"@en .

aat:300024035 a skos:Concept ;
    skos:definition "Hand saws having a narrow blade; used to cut small intricate shapes or circles of small radii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass saws"@en .

aat:300024037 a skos:Concept ;
    skos:definition "Compass saws with fine, tapered, flexible blades; used for cutting door mortises to receive locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locksaws"@en .

aat:300024039 a skos:Concept ;
    skos:definition "Large saws whose teeth are filed and set to cut across the grain of wood, providing more of a knife action in the cutting than ripsaws; designed for either one or two people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosscut saws"@en .

aat:300024041 a skos:Concept ;
    skos:definition "Saws 3 to 4 feet long generally having plain teeth; used for sawing trees into logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-man crosscut saws"@en .

aat:300024042 a skos:Concept ;
    skos:definition "Large two-handled saws up to 7 feet in length, designed for use by two people and having a variety of tooth patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-handed crosscut saws"@en .

aat:300024047 a skos:Concept ;
    skos:definition "Compass saws having especially narrow blades and fine teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyhole saws"@en .

aat:300024050 a skos:Concept ;
    skos:definition "Thick, long, taper-bladed, two-man instruments without a frame, with an upper handle and a lower adjustable handle; used for cutting boards from the lengths of logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open pit saws"@en .

aat:300024052 a skos:Concept ;
    skos:definition "Small, light hand saws, from 10 to 24 inches long, having closely set fine teeth; used in cutting open grain and paneling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel saws"@en .

aat:300024053 a skos:Concept ;
    skos:definition "Long, typically coarse-toothed hand saws, whose teeth are cut at a 60-degree angle, and have a chisel-like ripping action; used for cutting wood in the direction of the grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ripsaws"@en .

aat:300024056 a skos:Concept ;
    skos:definition "Lighter or shorter ripsaws, with teeth that are more closely spaced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-ripsaws"@en .

aat:300024057 a skos:Concept ;
    skos:definition "Keyhole-style saws with a short blade that is supported in a pistol-style grip; frequently having interchangeable blades for different purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saber saws"@en .

aat:300024065 a skos:Concept ;
    skos:definition "Refers saws attached to benches, often circular saws mounted on benches. For circular saws set into a slot of a table or bench, use \"table saws.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench saws"@en .

aat:300024067 a skos:Concept ;
    skos:definition "Metal cylinders with teeth cut on one end; used for cutting cylindrical objects or discs from wood, horn, metal, and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown saws"@en .

aat:300024074 a skos:Concept ;
    skos:definition "Electrically powered saws, having a narrow blade which moves with a reciprocating motion in a vertical direction; used especially for cutting curves and ornamental designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jigsaws"@en .

aat:300024079 a skos:Concept ;
    skos:definition "Short lengths of saw blade with shaped wood grips fitted along the upper edge, and sometimes made adjustable for depth of cut; used to cut the sides of grooves across or at an angle with the grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stairbuilders' saws"@en .

aat:300024083 a skos:Concept ;
    skos:definition "Commonly defined as large frame saws whose saw web is set in the middle of a wood frame; used for cutting veneer from wood. The term also refers to a kind of backsaw with a slightly curved blade and a heavy wood back that serves as a handle. It is also a particular kind of circular saw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneer saws"@en .

aat:300024084 a skos:Concept ;
    skos:definition "Tools, usually with a curved blade, which are a cross between an adz and a drawknife; used to hollow curved surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scorpers"@en .

aat:300024088 a skos:Concept ;
    skos:definition "Two-handed scorpers having a semicircular blade about 4 inches wide and bent to bring the wood handles in line with the blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed scorpers"@en .

aat:300024089 a skos:Concept ;
    skos:definition "Scorpers with a round, continuous blade set on a pair of handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open scorpers"@en .

aat:300024090 a skos:Concept ;
    skos:definition "Scrapers used for finishing in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking scrapers"@en .

aat:300024091 a skos:Concept ;
    skos:definition "Scraping tools whose blade is perpendicular to the handle and set at the end of two parallel arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box scrapers"@en .

aat:300024092 a skos:Concept ;
    skos:definition "Flat steel blades used to smooth wood surfaces after planing, or for scraping paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet scrapers"@en .

aat:300024097 a skos:Concept ;
    skos:definition "Small tools with interchangeable heads used to scratch metal and wood surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shavehooks"@en .

aat:300024099 a skos:Concept ;
    skos:definition "Carpenters' tools used for shaping curved edges, consisting of a blade set between two handles and used as a drawknife or planing tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spokeshaves"@en .

aat:300024100 a skos:Concept ;
    skos:definition "Spokeshaves which cut a chamfer on the edge of a piece of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamfer spokeshaves"@en .

aat:300024101 a skos:Concept ;
    skos:definition "Pieces of wood or metal tapering to a thin edge; used to adjust elevation or tighten formwork, or to split wood or rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedges"@en .

aat:300024104 a skos:Concept ;
    skos:definition "Wedges of hardwood, metal, or another material, used for inserting into a hole or crack and then struck, for splitting logs or firewood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splitting wedges"@en .

aat:300024108 a skos:Concept ;
    skos:definition "Devices, usually made of hardwood, used in carpentry to secure the work at the back of the workbench, in order to protect the surface of the workbench from being scarred or damaged by movement of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench hooks"@en .

aat:300024110 a skos:Concept ;
    skos:definition "Adjustable stops with a projecting knife or hook that holds a piece of work on a workbench."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench knives"@en .

aat:300024111 a skos:Concept ;
    skos:definition "Special tools used to grip and insert brads in an inaccessible location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brad pushers"@en .

aat:300024115 a skos:Concept ;
    skos:definition "Tools used in forming veneer to the shape of a curved surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauls"@en .

aat:300024116 a skos:Concept ;
    skos:definition "Clamps of various types used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking clamps"@en .

aat:300024118 a skos:Concept ;
    skos:definition "Simple tools used in conjunction with a workbench which hold a piece of wood firmly in place in a V-shaped mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench clamps"@en .

aat:300024119 a skos:Concept ;
    skos:definition "Clamps in the shape of the letter C in which force is applied by rotating a threaded shaft through one jaw of the C to force the work against the other jaw; frequently used in carpentry and joinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "C-clamps"@en .

aat:300024126 a skos:Concept ;
    skos:definition "Clamps used to join corners during gluing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner clamps"@en .

aat:300024129 a skos:Concept ;
    skos:definition "Devices, usually of iron, bent at the ends, or of dovetail form; used to hold together structural timbers or stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dovetail clamps"@en .

aat:300024131 a skos:Concept ;
    skos:definition "Long bar-type clamps either of wood or metal with an adjustable stop at one end, and a screw-type stop at the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar clamps"@en .

aat:300024133 a skos:Concept ;
    skos:definition "Somewhat lighter versions of bar clamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash clamps"@en .

aat:300024134 a skos:Concept ;
    skos:definition "Clamps used to hold saw blades during sharpening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saw clamps"@en .

aat:300024135 a skos:Concept ;
    skos:definition "Any clamps set by means of a screw; especially those used in woodworking which have two parallel jaws for holding together work to be pressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw clamps"@en .

aat:300024141 a skos:Concept ;
    skos:definition "Any clamps which exert pressure by a spring; used to hold parts together during gluing or as a temporary electric connection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring clamps"@en .

aat:300024144 a skos:Concept ;
    skos:definition "Clamps consisting of two double-cranked arms with swivel shoes connected by a system of levers actuated by a central threaded rod which also carries a round shoe; usually used for corner-clamping large mitered frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "universal clamps"@en .

aat:300024148 a skos:Concept ;
    skos:definition "Devices consisting of a fabric tape with a fastener that is secured with a wrench or screwdriver; used to hold carpentry work while gluing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web clamps"@en .

aat:300024149 a skos:Concept ;
    skos:definition "Simple metal devices, usually a bar with hooks at each end, used for binding two pieces of timber together. Also a general term for any device used for gripping, holding, or fastening an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogs"@en .

aat:300024152 a skos:Concept ;
    skos:definition "Pegs or pins partially inserted into a hole at an edge or end of a workbench to help secure a piece of work or prevent it from sliding off the bench."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench dogs"@en .

aat:300024153 a skos:Concept ;
    skos:definition "Devices for securing anything in its place, as a hook, bolt, or spike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holdfasts"@en .

aat:300024156 a skos:Concept ;
    skos:definition "Sticks used by wheelwrights to force the outer ends of spokes into the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoke dogs"@en .

aat:300024157 a skos:Concept ;
    skos:definition "Frames for holding a wood door in place while it is off its hinges and being planed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door jacks"@en .

aat:300024160 a skos:Concept ;
    skos:definition "Hammers used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking hammers"@en .

aat:300024161 a skos:Concept ;
    skos:definition "Hammers with a hardened face on one end of the head for driving nails, and curved forked tines on the other end for pulling out nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claw hammers"@en .

aat:300024163 a skos:Concept ;
    skos:definition "Hammers with an octagonal or round face, chamfered neck, and a cross peen with thick rounded edges; used as an anvil when held behind the head of a rivet or nail to hold it in position while its point is hammered over."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clench hammers"@en .

aat:300024164 a skos:Concept ;
    skos:definition "Large hammers, weighing as much as 32 ounces, with a long handle and a claw which is relatively straight; used in house framing and construction work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "framing hammers"@en .

aat:300024171 a skos:Concept ;
    skos:definition "General term for small- to medium-size hammers having a cross peen which tapers down to a narrow edge and if forked for drawing nails; used for general purposes by a variety of tradesmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joiner's hammers"@en .

aat:300024172 a skos:Concept ;
    skos:definition "Tools having a hatchet blade and a hammer face; used for cutting and nailing wood lath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lathing hatchets"@en .

aat:300024176 a skos:Concept ;
    skos:definition "Lightweight hammers that have usually one magnetized face and are used for holding and driving tacks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tack hammers"@en .

aat:300024177 a skos:Concept ;
    skos:definition "Round-faced hammers with chamfered necks and a heavy tapering peen; used by shipwrights to drive large nails and spikes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top maul hammers"@en .

aat:300024179 a skos:Concept ;
    skos:definition "Hammers used not for striking but for applying pressure to veneer after it has been glued into position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneer hammers"@en .

aat:300024180 a skos:Concept ;
    skos:definition "Hammers having a round face with a chamfered neck and a cross peen which tapers to a rounded tip; used as a general-purpose hammer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Warrington hammers"@en .

aat:300024187 a skos:Concept ;
    skos:definition "Horses used to hold saw blades in place during sharpening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saw-sharpening horses"@en .

aat:300024189 a skos:Concept ;
    skos:definition "Four-legged supports, usually having pairs of legs in an A-shaped configuration with a crossbar; often used in pairs to support wood while being sawed or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawhorses"@en .

aat:300024195 a skos:Concept ;
    skos:definition "X- or Y-shaped wood devices used to support logs during sawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawing tackles"@en .

aat:300024196 a skos:Concept ;
    skos:definition "Supports consisting of two crossed wood clubs; used to support logs that are being sawed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawyers' props"@en .

aat:300024197 a skos:Concept ;
    skos:definition "Hammering tools with a head and handle, of various designs, used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking mallets"@en .

aat:300024198 a skos:Concept ;
    skos:definition "Implements consisting of a heavy head, usually of wood, with a handle or stock, used in various industrial and domestic operations, and having various shapes according to the purpose for which it is used. Examples include beetles for driving wedges or pegs, ramming down paving stones, or for crushing, bruising, beating, flattening, or smoothing various materials or things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beetles"@en .

aat:300024202 a skos:Concept ;
    skos:definition "Mallets designed for loosening or removing the bung (stopper) of a cask."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bungstarts"@en .

aat:300024205 a skos:Concept ;
    skos:definition "Short-handled mallets with a wooden head used to strike a chisel or wedge in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpenters' mallets"@en .

aat:300024206 a skos:Concept ;
    skos:definition "Mallets whose head is a well-rounded truncated cone mounted upside down on a short handle. The shape enables the carver to strike the chisel from any angle without altering the hand's position on the tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carvers' mallets"@en .

aat:300024209 a skos:Concept ;
    skos:definition "Mallets whose heads are filled with lead shot so that there is no rebound to the blow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dead-blow mallets"@en .

aat:300024210 a skos:Concept ;
    skos:definition "Mallets used in conjunction with froes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "froe clubs"@en .

aat:300024223 a skos:Concept ;
    skos:definition "Blocks used in conjunction with the woodworker's body to hold a piece of wood in place during shaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving blocks"@en .

aat:300024224 a skos:Concept ;
    skos:definition "Vises designed to hold wooden materials or objects while working."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking vises"@en .

aat:300024225 a skos:Concept ;
    skos:definition "Vises having a threaded nut and flange, which is known as a \"box.\" Early vises had built up boxes, often made by forge welding and brazing parts together; the threads were made by brazing a coil inside a tube. Later, the boxes of box vises were made in solid pieces, often with screw threads being hand turned on a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box vises"@en .

aat:300024226 a skos:Concept ;
    skos:definition "Vises attached to chairs or stools, allowing the user to work while seated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair vises"@en .

aat:300024230 a skos:Concept ;
    skos:definition "Templates that govern the accurate matching cuts of corresponding pieces in dovetail joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dovetail templates"@en .

aat:300024232 a skos:Concept ;
    skos:definition "Steel tools resembling chisels, most often characterized by a large, thick, flat blade cast as a single piece with a narrower handle and striking surface; used in conjunction with a caulking mallet to drive various materials into seams and crevices to make joints water- and airtight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caulking irons"@en .

aat:300024235 a skos:Concept ;
    skos:definition "Tools used by coopers to insert a cooper's flag between the head and staves of a barrel after the head is in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chincing irons"@en .

aat:300024236 a skos:Concept ;
    skos:definition "Prying tools with a double-hooked head used in caulking barrels with flags or for removing barrel heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flagging irons"@en .

aat:300024242 a skos:Concept ;
    skos:definition "Hand tools which consist of a wood or metal bar about 2 feet long with four spirit levels set into it; used by carpenters to determine a horizontal or vertical plane or line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpenters' levels"@en .

aat:300024245 a skos:Concept ;
    skos:definition "Devices consisting of spirit levels set within metal or wood bars and used for determining or setting the horizontality or verticality of objects or surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "levels"@en .

aat:300024253 a skos:Concept ;
    skos:definition "Weights to be suspended from one end of plumb lines to determine verticality or to aid in locating points on the ground during surveying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumb bobs"@en .

aat:300024255 a skos:Concept ;
    skos:definition "Plier-like tools which set the teeth of a saw after they have been sharpened. They may be adjusted for use on different saws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saw sets"@en .

aat:300024257 a skos:Concept ;
    skos:definition "Tools consisting of two perpendicular arms, usually made of wood, metal, plastic, or a combination of these materials, fixed together so as to form a right angle; used for marking right angles or testing the squareness of sides, edges, or surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squares"@en .

aat:300024258 a skos:Concept ;
    skos:definition "Tools similar to the try square except that they have an adjustable blade which can be set at any angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bevel squares"@en .

aat:300024265 a skos:Concept ;
    skos:definition "Flat, metal, L-shaped tools that constitute an accurate right angle and are engraved with divisions and markings useful to a carpenter in laying out and erecting framing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpenters' squares"@en .

aat:300024268 a skos:Concept ;
    skos:definition "Squares usually consisting of a thin blade made of wood or metal which is attached at a right angle to the end of a thicker stock which may be placed against the edge of a drawing board or the like; predominantly used to draw or mark something at right angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "try squares"@en .

aat:300024283 a skos:Concept ;
    skos:definition "Tools made for gardens and gardening, and by extension with the range of tools made for agriculture and horticulture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden tools"@en .

aat:300024287 a skos:Concept ;
    skos:definition "Implements for clipping off small or medium-sized stems and branches from hedges and other woody or bushy plants; characterized by having sharp edges that meet or only slightly cross. For scissors-like implements for hedges, where the blades are long and cross, prefer \"hedge shears,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hedge clippers"@en .

aat:300024288 a skos:Concept ;
    skos:definition "Relatively large hand-held shears used to cut and shape hedges, and to otherwise cut stems, small branches, and leaves of bushes and other plants in a garden or landscaping environment. For implements used to cut somewhat thicker stems or small branches, where the sharpened edges meet rather than cross, prefer \"hedge clippers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hedge shears"@en .

aat:300024292 a skos:Concept ;
    skos:definition "Any of various hand-operated or power-driven machines for cutting grass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lawn mowers"@en .

aat:300024297 a skos:Concept ;
    skos:definition "Hand-held rakes of moderate size, used in gardening and landscaping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden rakes"@en .

aat:300024299 a skos:Concept ;
    skos:definition "Tools for trimming or cutting back plants in gardening, flower arranging, and tree cultivation. There are various blade designs, which may incorporate two sharpened blades or one blade that meets a flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pruning shears"@en .

aat:300024300 a skos:Concept ;
    skos:definition "Tools consisting of a broad blade or scoop used for taking up, removing, or throwing loose matter, such as earth, snow, or coal. Hand-operated shovels typically have the blade or scoop attached to a long handle. For long-bladed tools with shorter hafts and t-bars or handles to grasp, use \"spades.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shovels"@en .

aat:300024301 a skos:Concept ;
    skos:definition "Vehicles or attachments to vehicles for spraying liquids as insecticides or fungicides on plants and trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprayers"@en .

aat:300024302 a skos:Concept ;
    skos:definition "Three- or four-wheeled, powerful automotive vehicles propelled by a traction engine used for drawing, towing, bearing, or propelling wagons, artillery or equipment, most often farming equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tractors"@en .

aat:300024311 a skos:Concept ;
    skos:definition "Mill devices used to separate chaff from grains after the threshing; an example would be a large shallow container with a mesh or perforated wooden bottom, or sliding panels, that winnow the grain when turned manually by a metal crank and hand grip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanning mills"@en .

aat:300024316 a skos:Concept ;
    skos:definition "Devices for separating grain from the chaff, that employ a riddle, which is a coarse-meshed sieve formed of cross pieces of wires or stiff fiber, supported on circular rim with a base shaped like a shallow drum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain riddles"@en .

aat:300024321 a skos:Concept ;
    skos:definition "Flat containers, usually baskets, used in agriculture and ritual to separate grains from other plant material such as chaff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winnowing trays"@en .

aat:300024323 a skos:Concept ;
    skos:definition "Refers to both hand tools and large horse- or tractor-drawn vehicles that usually consist of a frame upon which is fastened shares, discs, or tines used for breaking up the surface of soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultivators"@en .

aat:300024327 a skos:Concept ;
    skos:definition "Cultivating implements used primarily for pulverizing or smoothing the soil, sometimes for mulching, covering seed, or removing weeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harrows"@en .

aat:300024329 a skos:Concept ;
    skos:definition "Agricultural implements having a thin, flat blade usually set transversely at the end of a long handle; used for such activities as breaking up or loosening the surface of the ground, dislodging weeds, and covering plants with soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoes"@en .

aat:300024334 a skos:Concept ;
    skos:definition "In agriculture, a device or machine for sowing seed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seeders"@en .

aat:300024335 a skos:Concept ;
    skos:definition "Tools intended for cutting, digging, or removing earth or turf, in the form of a wooden haft attached to an oblong metal blade. The haft usually has a cross-bar or handle at the end for grasping while forcing the metal blade into the ground with the foot. The blade itself is often formed to accommodate foot pressure. For similar tools with longer handles or hafts and broader blades intended for moving matter, use \"shovels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spades"@en .

aat:300024336 a skos:Concept ;
    skos:definition "Spades designed for digging ditches or troughs that feature handles on their hafts and blades that are slightly wider at the point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ditching spades"@en .

aat:300024337 a skos:Concept ;
    skos:definition "Spades with long, narrow blades designed to be used in vegetable gardens to cut soil for holes or for uprooting plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden spades"@en .

aat:300024338 a skos:Concept ;
    skos:definition "Spades fitted with longer hafts than the normal length of 14-22 inches, and a wider blade rounded to a point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long handle spades"@en .

aat:300024339 a skos:Concept ;
    skos:definition "Implements of various designs used for tilling soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tillers"@en .

aat:300024340 a skos:Concept ;
    skos:definition "A powered plow-like machine used for breaking up soil by means of rotating blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotary tillers"@en .

aat:300024343 a skos:Concept ;
    skos:definition "Any type of machinery used for the purpose of baling hay or straw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balers"@en .

aat:300024345 a skos:Concept ;
    skos:definition "Large vehicular pieces of agricultural machinery that perform various functions associated with harvesting, such as cutting, threshing, and bagging grain. These are generally equipped with a seat for the operator who drives it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combines"@en .

aat:300024349 a skos:Concept ;
    skos:definition "Implements consisting of a wooden staff or handle, at the end of which a stouter and shorter staff or club, called a swingle or swipple, is so hung as to swing freely. One example is used for threshing corn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flails"@en .

aat:300024351 a skos:Concept ;
    skos:definition "Agricultural tools consisting of a long straight handle, furnished at the end with two or more large prongs, and used for carrying, digging, lifting, or tossing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forks"@en .

aat:300024352 a skos:Concept ;
    skos:definition "Forks used in harvesting barley and other short-stemmed grains, having a guard where the handle joins the prongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barley forks"@en .

aat:300024353 a skos:Concept ;
    skos:definition "Hand-held long handled forks with two or three sharp, somewhat curved prongs, used for pitching hay, straw, and sheaves and breaking soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitchforks"@en .

aat:300024356 a skos:Concept ;
    skos:definition "Tool used to pull hay towards sickle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hay crooks"@en .

aat:300024358 a skos:Concept ;
    skos:definition "Long rakes for gathering together mown hay and other similar material into windrows ready for pitching; may be hand-held or mounted and pulled by an animal or tractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hay rakes"@en .

aat:300024360 a skos:Concept ;
    skos:definition "Knives of various kinds used for harvesting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harvesting knives"@en .

aat:300024362 a skos:Concept ;
    skos:definition "Long-bladed knives with heavy, rounded serrations on the edge of the blade, used for cutting portions off of haystacks or other compact bundles or piles of hay by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hay knives"@en .

aat:300024363 a skos:Concept ;
    skos:definition "Large heavy knives with a single-edged blade, used for cutting cane and clearing plant growth; also used as cutting weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machetes"@en .

aat:300024368 a skos:Concept ;
    skos:definition "Machines used for reaping crops, such as wheat, cane, corn, etc.; typically also which also binds up the sheaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harvesters"@en .

aat:300024369 a skos:Concept ;
    skos:definition "Mechanical harvesting devices pulled by horses that could both reap grain and rake the cut crops off of a platform in bunches, ready to be bound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-rake reapers"@en .

aat:300024371 a skos:Concept ;
    skos:definition "Implements used for mowing grass, grain, or other crops and composed of a long curving blade fastened at an angle to a long handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scythes"@en .

aat:300024375 a skos:Concept ;
    skos:definition "Harvesting machines used to separate grain from the stalk of a plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "threshing machines"@en .

aat:300024391 a skos:Concept ;
    skos:definition "Ropes, straps, clogs, or other contrivances used on the legs of a horse or other animal to limit its movement, to prevent it from straying or kicking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hobbles"@en .

aat:300024399 a skos:Concept ;
    skos:definition "Tools used to shape or smooth the rough edges of the hooves of farm animals after trimming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoof rasps"@en .

aat:300024400 a skos:Concept ;
    skos:definition "U-shaped metal plates, plain or with calks, nailed to a horse's hoof to protect it from being injured by hard or rough surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horseshoes"@en .

aat:300024409 a skos:Concept ;
    skos:definition "Traps of various designs used to capture or kill birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird traps"@en .

aat:300024410 a skos:Concept ;
    skos:definition "Traps of various designs used to capture insects or other arthropods for pest control or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insect traps"@en .

aat:300024411 a skos:Concept ;
    skos:definition "Describes devices that either trap a live mouse which can later be released, or those that kill mice attracted by bait."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mousetraps"@en .

aat:300024412 a skos:Concept ;
    skos:definition "Implements resembling hoes or pitchforks, designed to dig clams out of the sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clamming hoes"@en .

aat:300024413 a skos:Concept ;
    skos:definition "Type of eel traps comprising a container, often woven, with funnel-shaped openings; used for catching eels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eelpots"@en .

aat:300024415 a skos:Concept ;
    skos:definition "Floating structures, typically extending below the ordinary high-water mark, designed for fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish rafts"@en .

aat:300024416 a skos:Concept ;
    skos:definition "Gear used for fishing, including rod, reel, and bait."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing tackle"@en .

aat:300024417 a skos:Concept ;
    skos:definition "Gaffs with a large iron hook at the end for securing large fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish gaffs"@en .

aat:300024418 a skos:Concept ;
    skos:definition "Bent or curved devices with one or more, usually barbed points, tied to one end of a line for catching fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishhooks"@en .

aat:300024421 a skos:Concept ;
    skos:definition "The assembly or compilation of items used for fishing, including sinkers, hooks, swivels, and other gear on a fishing line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing rigs"@en .

aat:300024422 a skos:Concept ;
    skos:definition "Long slender tapering rods to which lines are attached for angling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing rods"@en .

aat:300024427 a skos:Concept ;
    skos:definition "Devices comprising a long-handled, streamlined board, oar-like in shape, with a lower edge studded with sharp-points upon which fish are impaled when the rake is passed through the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herring rakes"@en .

aat:300024428 a skos:Concept ;
    skos:definition "Oblong cases with slat sides and funnel-shaped net used as a trap for catching lobsters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lobster pots"@en .

aat:300024429 a skos:Concept ;
    skos:definition "Equipment comprising pieces of openwork fabric made of twine, synthetic fibres, strong cord, or another material that forms meshes of a suitable size; they are placed in the water and used for catching fish. Fishing nets are among the oldest known human technologies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing nets"@en .

aat:300024431 a skos:Concept ;
    skos:definition "Fishing nets of various types which are pulled through a body of water, or just above the bottom of the sea or a lake bed, in order to capture fish and other aquatic creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragnets"@en .

aat:300024434 a skos:Concept ;
    skos:definition "Large nets having one edge provided with sinkers and the other with floats that hangs vertically in the water and encloses fish when its ends are brought together or drawn ashore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seines"@en .

aat:300024442 a skos:Concept ;
    skos:definition "Axes used to split timber before removal of the bark. For tools used to strip bark from trees use \"300411589 barking axes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barking axes"@en .

aat:300024443 a skos:Concept ;
    skos:definition "Large axes designed for cutting down trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felling axes"@en .

aat:300024444 a skos:Concept ;
    skos:definition "Axes having a head similar to a hammer; used to stamp the owner's mark onto a log."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marking axes"@en .

aat:300024446 a skos:Concept ;
    skos:definition "Tools with a round, semicircular, or spade-shaped blades often socketed and mounted on a wood handle; used for stripping bark from logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barking irons"@en .

aat:300024455 a skos:Concept ;
    skos:definition "Machines used especially in pulp mills to remove bark from logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barkers"@en .

aat:300024458 a skos:Concept ;
    skos:definition "Horse-powered mills used for grinding bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bark mills"@en .

aat:300024459 a skos:Concept ;
    skos:definition "Large drawknives of varying shapes with the blade's bevel facing down so that the knife will not dig into the timber as it is removing the bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barking drawknives"@en .

aat:300024460 a skos:Concept ;
    skos:definition "Machines for reducing something, such as pulpwood, to chips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chippers"@en .

aat:300024461 a skos:Concept ;
    skos:definition "Ovens for drying and seasoning cut lumber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry kilns"@en .

aat:300024462 a skos:Concept ;
    skos:definition "Hooks of various designs used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking hooks"@en .

aat:300024463 a skos:Concept ;
    skos:definition "Wooden levers with metal hooks on their shafts, used to roll logs; later combined with the jam pike to become peavies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cant hooks"@en .

aat:300024464 a skos:Concept ;
    skos:definition "Tools which combine the jam pike and the cant hook; used by lumbermen to pry and roll logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peavies"@en .

aat:300024469 a skos:Concept ;
    skos:definition "Poles with a sharply pointed end and a hook, used by lumbermen in river driving and by tracklayers in aligning railroad ties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickaroons"@en .

aat:300024470 a skos:Concept ;
    skos:definition "Long-handled tools which terminate in an iron spike; used by lumbermen to pry logs. Later combined with the cant hook to become a peavey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jam pikes"@en .

aat:300024472 a skos:Concept ;
    skos:definition "Cutting tools with a blade hooked at the tip; used for marking outlines on wood or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "race knives"@en .

aat:300024473 a skos:Concept ;
    skos:definition "Augers for boring holes in logs, so that they can be pinned together as rafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raft augers"@en .

aat:300024474 a skos:Concept ;
    skos:definition "Lengths of chain with spikes at the ends; used to bind logs together into rafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raft shackles"@en .

aat:300024475 a skos:Concept ;
    skos:definition "Pocket-sized cant hooks for rolling logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring dogs"@en .

aat:300024477 a skos:Concept ;
    skos:definition "Saws with a fixed blade set in an H-shaped frame, used mainly for cutting across the grain of lumber and firewood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucksaws"@en .

aat:300024480 a skos:Concept ;
    skos:definition "Power-driven saws, usually hand-held, with a protruding arm that carries an endless chain into which the cutting teeth are set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain saws"@en .

aat:300024487 a skos:Concept ;
    skos:definition "Devices used to crush rock, usually in the context of the mining industry, either to extract ore or simply to break material into smaller pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crushing machinery"@en .

aat:300024491 a skos:Concept ;
    skos:definition "Hand-held implements having a long shaft mounted with a curved metal head with a sharpened point at one end and an adze-like blade at the other; for similar implements, but lacking the adze-like blade, use \"pick-axes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mattocks"@en .

aat:300024493 a skos:Concept ;
    skos:definition "Tools consisting of a long shaft mounted with a curved metal head with a sharpened point at one end, used for breaking up earth or rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickaxes"@en .

aat:300024497 a skos:Concept ;
    skos:definition "Tools and equipment used in the observation, measurement, and recording of objects and events outside of the earth's atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical instruments"@en .

aat:300024499 a skos:Concept ;
    skos:definition "Apparatuses or tools used in the context of the division of the natural sciences consisting of those sciences that deal with the organic world, including all aspects of living beings and the systems that sustain them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological sciences equipment"@en .

aat:300024500 a skos:Concept ;
    skos:definition "Artifacts originally created to be used in the study and/or manufacture of substances based on their composition, structure, and molecular properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemistry equipment"@en .

aat:300024504 a skos:Concept ;
    skos:definition "Tools for examining or testing doubly-refracting crystals or gemstones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dichroscopes"@en .

aat:300024505 a skos:Concept ;
    skos:definition "Tools having a long handle and scoop used for rock-hunting, for example to scrape rubble out of crevices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gem scoops"@en .

aat:300024507 a skos:Concept ;
    skos:definition "Any of various types of electronic instruments for detecting the presence of metallic objects by means of their effects on an electromagnetic field. Examples include portable devices with a search head that is swept over the ground to locate buried metal objects, a hand-held or walk-through security device for locating concealed weapons, and a device for checking for the presence of extraneous pieces of metal in food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal detectors"@en .

aat:300024509 a skos:Concept ;
    skos:definition "Hand tools consisting of a metal head flattened at one and usually pointed on the other end, mounted on a relatively long handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoe picks"@en .

aat:300024510 a skos:Concept ;
    skos:definition "Relatively large hand tools having a chisel or pick head, used for breaking up rocks; operated by swinging the tool with the arms. For similar but much smaller tools for breaking up rocks, use \"rock hammers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock picks"@en .

aat:300024511 a skos:Concept ;
    skos:definition "Medium-sized or small hand tools for breaking up rocks, usually having a flat head with either a chisel or a pick head at the other end, made of steel or other metal, mounted on a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock hammers"@en .

aat:300024515 a skos:Concept ;
    skos:definition "Any objects, tools, or printed matter used while conducting psychological examinations of individuals or groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychological equipment"@en .

aat:300024518 a skos:Concept ;
    skos:definition "Encompasses objects used in the study of sound and for transmitting sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustic equipment"@en .

aat:300024521 a skos:Concept ;
    skos:definition "Electronic devices or systems capable of automatically performing prescribed sequences of operations on digitised data to achieve a desired end result."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computers"@en .

aat:300024522 a skos:Concept ;
    skos:definition "Desk-top or portable computers, based on a microprocessor and meant for a single user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microcomputers"@en .

aat:300024526 a skos:Concept ;
    skos:definition "Mid-sized computers smaller than mainframes and usually with much more memory than microcomputers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minicomputers"@en .

aat:300024527 a skos:Concept ;
    skos:definition "Any devices that are connected to a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peripherals"@en .

aat:300024532 a skos:Concept ;
    skos:definition "Computer peripherals composed of a monitor or printing device and a keyboard, which are linked together to function as a single input/output unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer terminals"@en .

aat:300024533 a skos:Concept ;
    skos:definition "Assemblages of systematically arranged keys by which a machine is operated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyboards"@en .

aat:300024534 a skos:Concept ;
    skos:definition "Devices that enable data to be transmitted between computers, generally over telephone lines but sometimes on fiber-optic cable or radio frequencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modems"@en .

aat:300024535 a skos:Concept ;
    skos:definition "Output devices that convert coded information from the processor into a readable form on paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printers"@en .

aat:300024536 a skos:Concept ;
    skos:definition "Serial impact printers in which the font is formed on the end of spring fingers that extend radially from a central hub."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daisywheel printers"@en .

aat:300024537 a skos:Concept ;
    skos:definition "Electrophotographic printers in which a laser is used as the light source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser printers"@en .

aat:300024538 a skos:Concept ;
    skos:definition "Computer output devices that produce a line of print per cycle of its operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line printers"@en .

aat:300024539 a skos:Concept ;
    skos:definition "Printers in which the image is formed without use of mechanical impact with the printed surface material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonimpact printers"@en .

aat:300024540 a skos:Concept ;
    skos:definition "Printers that print complete pages of output in one cycle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "page printers"@en .

aat:300024542 a skos:Concept ;
    skos:definition "Any of various combinations of electric, hydraulic, or pneumatic systems that convert energy into mechanical movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actuators"@en .

aat:300024543 a skos:Concept ;
    skos:definition "Devices that increase the power level of quantities such as signals, electric currents, or mechanical forces, often used in electronic equipment such as radio and television receivers and audio equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amplifiers"@en .

aat:300024545 a skos:Concept ;
    skos:definition "Use to describe chemical batteries in which the electrolyte is held in a solid such as cardboard or a paste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry-cell batteries"@en .

aat:300024548 a skos:Concept ;
    skos:definition "Devices that generate electromagnetic radiation in the ultraviolet, visible, or infrared spectrum, in the form of a very narrow continuous or intermittent beam. Originally an acronym for \"light amplification by stimulated emission of radiation;\" the first functional laser was built by Theodore H. Maiman (1927-2007), and demonstrated in 1960. Lasers have multiple applications: they are used as components in information retrieval and transmission devices and systems, cutting, measuring, and medical tools, and as entertainment devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lasers"@en .

aat:300024549 a skos:Concept ;
    skos:definition "Rocks, material, or objects that produces a magnetic field external to itself, which causes the magnet to attract other ferromagnetic materials, such as iron, and attracts or repels other magnets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnets"@en .

aat:300024550 a skos:Concept ;
    skos:definition "Electronic devices that produce oscillatory electrical signals. Commonly used to create sine, square, or sawtooth sound waves for testing purposes or for electronic music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oscillators"@en .

aat:300024553 a skos:Concept ;
    skos:definition "Semiconductor devices used to amplify, control, or modify electrical current. Transistors perform the same function as a vacuum tube while requiring less power and producing less heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transistors"@en .

aat:300024559 a skos:Concept ;
    skos:definition "Motor-driven machines, such as endless belts or a series of rollers, used for the continuous transport of material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conveyors"@en .

aat:300024560 a skos:Concept ;
    skos:definition "Continuous belts passing over pulleys, providing a track on which loose materials or small articles are carried from one point to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt conveyors"@en .

aat:300024561 a skos:Concept ;
    skos:definition "Motor-driven machines employing an endless chain or parallel chains transmitting the pull from a driving unit, and used for the continuous transport of material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain conveyors"@en .

aat:300024562 a skos:Concept ;
    skos:definition "Conveyors consisting of fixed-location rollers over which materials are moved by gravity or propulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller conveyors"@en .

aat:300024565 a skos:Concept ;
    skos:definition "Conveyors consisting of one or more endless chains to which horizontal spaced slats are attached to form a moving support for the objects being conveyed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slat conveyors"@en .

aat:300024566 a skos:Concept ;
    skos:definition "Devices for moving materials via a vibrating work member driven by a vibratory force system. This allows materials to be \"live\" and move independently of the conveyor system, unlike a conventional belt conveyor where the material is static and the conveying medium is in motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vibrating conveyors"@en .

aat:300024570 a skos:Concept ;
    skos:definition "Jacks in which a screw is used for lifting and carrying a plate which bears on the load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackscrews"@en .

aat:300024572 a skos:Concept ;
    skos:definition "Screw or hydraulic-type jacks used as a cross bracing in a trench shoring system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trench jacks"@en .

aat:300024574 a skos:Concept ;
    skos:definition "Wheels having grooved rims for carrying a rope or other line and turning in a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulleys"@en .

aat:300024575 a skos:Concept ;
    skos:definition "Frames that contain one or more pulleys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulley blocks"@en .

aat:300024579 a skos:Concept ;
    skos:definition "Artifacts originally created to be used in the observation, measurement, and recording of atmospheric phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorological instruments"@en .

aat:300024585 a skos:Concept ;
    skos:definition "Artifacts originally created to be used in the observation and recording of light, including general-purpose optical equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical instruments"@en .

aat:300024587 a skos:Concept ;
    skos:definition "Optical devices for use with both eyes consisting of two small telescopes fitted together side by side on a single frame and containing an erecting system usually with both focusing tubes simultaneously adjustable by means of a single screw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binoculars"@en .

aat:300024588 a skos:Concept ;
    skos:definition "Binoculars intended for use outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field glasses"@en .

aat:300024591 a skos:Concept ;
    skos:definition "Lenses or fixed combinations of lenses used to increase the apparent size of an object when viewed directly. An example of a magnifier is as used in a magnifying glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnifiers"@en .

aat:300024592 a skos:Concept ;
    skos:definition "A device comprising a handle and a lens, usually of glass, that increases the apparent size of an object viewed through it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnifying glasses"@en .

aat:300024593 a skos:Concept ;
    skos:definition "Magnifying glasses designed to be held in the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand lenses"@en .

aat:300024594 a skos:Concept ;
    skos:definition "Optical instruments consisting of a lens or combination of lenses that allow the viewing of objects that are too small to be seen with the naked, unaided eye. The term may also be used for various types of instruments that use a stream of electrons (electron microscope), electromagnetic radiation (x-ray microscope), or other means other than light and lenses to magnify images of small objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microscopes"@en .

aat:300024595 a skos:Concept ;
    skos:definition "Microscopes having one microscope for each eye, arranged so that the specimen is viewed from slightly different angles, giving a three-dimensional picture. They are widely used in surgery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binocular microscopes"@en .

aat:300024596 a skos:Concept ;
    skos:definition "Microscopes in which a beam of electrons is focused by means of magnetic and electrostatic lenses onto a specimen and scattered by it to produce an image. The resolving power and the magnification of an electron microscope are much greater than can be obtained with an optical icroscope. microscope. The specimen must be examined in a vacuum, which necessitates special techniques for preparing it, and the electrons are usually focused onto a fluorescent screen (for direct viewing) or onto a photographic plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron microscopes"@en .

aat:300024597 a skos:Concept ;
    skos:definition "Microscopes that employ polarized light that vibrates in a single plane so that light can be transmitted through the specimen. It is used to examine thin sections of rocks and minerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petrographic microscopes"@en .

aat:300024600 a skos:Concept ;
    skos:definition "Equipment that produces energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power producing equipment"@en .

aat:300024602 a skos:Concept ;
    skos:definition "Machines that compress a refrigerant gas; used in air conditioning and refrigeration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compressors"@en .

aat:300024603 a skos:Concept ;
    skos:definition "Machines for producing a physical effect, usually the conversion of energy into motion or propulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engines"@en .

aat:300024604 a skos:Concept ;
    skos:definition "Engines that are activated through the use of animal locomotion. The animal works either in a vertical or horizontal plane to drive a central axis, treadwheel, or series of gears in more sophisticated machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal-powered engines"@en .

aat:300024605 a skos:Concept ;
    skos:definition "Engines driven or worked by steam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam engines"@en .

aat:300024606 a skos:Concept ;
    skos:definition "Mechanical or electromechanical devices that convert mechanical energy into electrical power, as alternators producing alternating current or dynamos producing direct current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "generators"@en .

aat:300024609 a skos:Concept ;
    skos:definition "Rotating machines that transform electrical energy into mechanical energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motors"@en .

aat:300024610 a skos:Concept ;
    skos:definition "Motors that are powered by a controlled circulation of pressurized fluids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic motors"@en .

aat:300024611 a skos:Concept ;
    skos:definition "Apparatus for producing rotary motion by the weight of men or animals treading on a succession of moving steps or a belt that forms a kind of continuous path, as around the periphery of a pair of horizontal cylinders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treadmills"@en .

aat:300024612 a skos:Concept ;
    skos:definition "Any of various machines which convert the kinetic energy of a moving fluid to mechanical energy; often used for driving an electric generator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turbines"@en .

aat:300024613 a skos:Concept ;
    skos:definition "Turbines that are powered by gas resulting from the combustion of fuels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas turbines"@en .

aat:300024614 a skos:Concept ;
    skos:definition "Turbines powered by moving water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic turbines"@en .

aat:300024615 a skos:Concept ;
    skos:definition "Turbines in which the rotor is driven by fluid jets impinging directly against the blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impulse turbines"@en .

aat:300024616 a skos:Concept ;
    skos:definition "Turbines that are driven by the pressure of steam which is discharged at high velocity against the turbine vanes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam turbines"@en .

aat:300024617 a skos:Concept ;
    skos:definition "Wheels made to rotate by the direct action of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterwheels"@en .

aat:300024643 a skos:Concept ;
    skos:definition "Instruments or machines that produce a strong current of air by expansion or contraction of an air chamber, usually used to fan a fire in a hearth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellows"@en .

aat:300024644 a skos:Concept ;
    skos:definition "Fire-making tools involving a bag, usually made from animal skin, with an attached nozzle and an opening that could be closed by gathering the bag material by hand to force air through the nozzle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bag bellows"@en .

aat:300024645 a skos:Concept ;
    skos:definition "Air-blowing tools of varied design but that share an attached pair of bowl-like chambers with long ducts emerging from the base of each. A diaphragm is fitted over each chamber, and these are manipulated to draw and force air from the bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drum bellows"@en .

aat:300024646 a skos:Concept ;
    skos:definition "Bellows in which the draft is supplied by the action of a piston."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piston bellows"@en .

aat:300024647 a skos:Concept ;
    skos:definition "Devices used to manually agitate air to excite fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire fans"@en .

aat:300024648 a skos:Concept ;
    skos:definition "Implements used for stirring up a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire sticks"@en .

aat:300024649 a skos:Concept ;
    skos:definition "Pieces of wood, paper, cord, cloth, or another material dipped in melted sulfur, phosphorus, or another composition that is readily ignited by friction with a flint or when rubbed against a roughened surface, or when brought into contact with a chemical reagent. Sulfur matches were recorded in China by the 6th century. The first modern, self-igniting match was invented in 1805 by Jean Chancel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matches"@en .

aat:300024650 a skos:Concept ;
    skos:definition "Refers to equipment designed for the production of heat by combustion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnaces"@en .

aat:300024660 a skos:Concept ;
    skos:definition "Equipment used to compress and destroy material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crushing equipment"@en .

aat:300024662 a skos:Concept ;
    skos:definition "Tools with a blade or sharpened edge with the primary function of cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting tools"@en .

aat:300024663 a skos:Concept ;
    skos:definition "Sharp metal points with wood handles; used to make small holes in wood or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awls"@en .

aat:300024664 a skos:Concept ;
    skos:definition "Cutting tools that consist of a relatively heavy edged, squarish head fixed to a handle, the edge or edges being parallel to the handle so as to be suited for striking, hewing, cleaving, or chopping, trees, wood, ice, or another material. For axes used as weapons, typically having wider blades, use \"axes (weapons).\" For similar tools that are smaller and lighter, use \"hatchets.\" For long-handled tools with a curved blade set perpendicular to the handle and used for dressing lumber, use \"adzes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axes"@en .

aat:300024665 a skos:Concept ;
    skos:definition "Metal hand tools with a cutting edge at one end, driven by a hammer or mallet; or now often electrically driven, used in dressing, shaping, or working wood, stone, or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chisels"@en .

aat:300024668 a skos:Concept ;
    skos:definition "Cutting instruments consisting of a blade with a sharpened longitudinal edge fixed in a handle, either rigidly as in a table-, carving, or sheath-knife, or with a joint as in a pocket- or clasp-knife. Knives may be used to cut food, especially in serving and eating, as weapons, and for other purposes. The blade may be of steel or another metal or stone, as in the flint knives of early man, or of another material such as ivory or wood (as with a paperknife). The term also refers to tools that are shaped or used as knives, even if the edge is not particularly sharp or actually used for cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knives"@en .

aat:300024669 a skos:Concept ;
    skos:definition "Cutting knives with a single-edge razor blade held between the two sides of the knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility knives"@en .

aat:300024671 a skos:Concept ;
    skos:definition "Cutting tools having thin, flat metal blades, bands, or stiff plates with cutting teeth along the edges. Used to cut wood, metal, or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saws"@en .

aat:300024672 a skos:Concept ;
    skos:definition "Hand operated cutting implements resembling scissors but of larger size, or any other cutting instruments that similarly operate by the simultaneous action of two blades on opposite sides of the material to be cut. The term may also be used for various machines used for cutting that are more or less analogous to shears in manner of operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shears"@en .

aat:300024674 a skos:Concept ;
    skos:definition "Machinery designed to pierce or bore a hole or passage into anything, including earth and rock for wells of water or oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drilling machinery"@en .

aat:300024676 a skos:Concept ;
    skos:definition "Machinery devised to excavate holes in rigid material such as rock or earth, for mining, digging wells, or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boring machinery"@en .

aat:300024678 a skos:Concept ;
    skos:definition "Rotary drills, mounted on a permanent stand, that operate along a vertical shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drill presses"@en .

aat:300024679 a skos:Concept ;
    skos:definition "Large machines or hand tools used for making holes in a variety of materials. Drills typically have fluted or spiral shanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drills"@en .

aat:300024680 a skos:Concept ;
    skos:definition "Percussive power tools for breaking up hard surfaces such as concrete through repeated blows of a bit driven by compressed air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pneumatic drills"@en .

aat:300024682 a skos:Concept ;
    skos:definition "Drills rotated by a cord or string wrapped tightly around it and strung to a bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow drills"@en .

aat:300024684 a skos:Concept ;
    skos:definition "Manual rotary drills which have an attachment for applying pressure with the chest; used by carpenters for drilling horizontal holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breast drills"@en .

aat:300024685 a skos:Concept ;
    skos:definition "Portable, hand-held, motor-driven tools used to turn a bit for boring holes in a material and powered either by direct or alternating current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric drills"@en .

aat:300024688 a skos:Concept ;
    skos:definition "Primitive drills in which the shaft is revolved by working up and down a bar carrying a cord attached at the center to the upper end of the shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pump drills"@en .

aat:300024689 a skos:Concept ;
    skos:definition "Hand drills in which a spiral ratchet rotates the bit; operated by pushing on the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "push drills"@en .

aat:300024691 a skos:Concept ;
    skos:definition "Steel rods with a star-shaped point; used for drilling holes in masonry by striking with a hammer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plugging chisels"@en .

aat:300024694 a skos:Concept ;
    skos:definition "Drills with one or more spiral cutting grooves; used to drill holes in metal, wood, and plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twist drills"@en .

aat:300024696 a skos:Concept ;
    skos:definition "Steel bars with a flattened, forked, or chisel-shaped end which is sometimes slightly bent; used for heavy prying, and as a lever for moving heavy objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowbars"@en .

aat:300024698 a skos:Concept ;
    skos:definition "Steel bars with a chisel point at one end; used as a lever for lifting or moving heavy objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinch bars"@en .

aat:300024703 a skos:Concept ;
    skos:definition "Electric devices that provide continuous heat to melt thermoplastic glue, which is typically inserted into the device in solid form, melted, and pushed through the gun by a mechanical trigger mechanism. The device is often hand-held and gun-like in shape with barrel and hand grip. Another form of the device may allow heat to be applied directly to the thermoplastic adhesives that have been placed in solid form onto the surface to be glued."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric glue guns"@en .

aat:300024704 a skos:Concept ;
    skos:definition "Hand tools with a handle and a shank with a tip shaped to fit the recess in the head of a screw; used to drive or remove screws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screwdrivers"@en .

aat:300024706 a skos:Concept ;
    skos:definition "Screwdrivers whose head is set at 90 degrees to its shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset screwdrivers"@en .

aat:300024707 a skos:Concept ;
    skos:definition "Screwdrivers used to drive or remove screws having an X-shaped indentation in the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phillips head screwdrivers"@en .

aat:300024710 a skos:Concept ;
    skos:definition "Screwdrivers having a blade that rotates with respect to the handle, as the handle is pushed inward toward the blade; permits a screw to be driven easily and with speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral ratchet screwdrivers"@en .

aat:300024711 a skos:Concept ;
    skos:definition "Small tools used for the removal of staples from materials such as paper or upholstery. These are of two basic designs, either a single wedge used as a lever, or a hinged pincer device with teeth that grasp the staple and pull it out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staple pullers"@en .

aat:300024712 a skos:Concept ;
    skos:definition "Spring-driven guns used to drive staples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staple guns"@en .

aat:300024713 a skos:Concept ;
    skos:definition "Small usually hand-held devices for inserting wire staples that bind two or more materials together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staplers"@en .

aat:300024714 a skos:Concept ;
    skos:definition "Hand tools consisting of a handle and a jaw at one end; used to turn or hold a bolt, nut, pipe, or fitting. The jaw may be shaped for a specific-sized object or may be adjustable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrenches"@en .

aat:300024718 a skos:Concept ;
    skos:definition "Abrasive wheels or disks used for cutting or smoothing materials such as metal, glass, plastics, or clay. They are distinguished from grinding stones, which are of different design and typically for culinary use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grinding wheels"@en .

aat:300024720 a skos:Concept ;
    skos:definition "Flat discs, made of sandstone or another stone of considerable thickness, that are rotated on an axle and used to grind, sharpen, polishing, or shape objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grindstones"@en .

aat:300024721 a skos:Concept ;
    skos:definition "Machines for the processing or treatment of materials in any kind of mill, as the operation of fulling cloth, rolling metals, or crushing minerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milling machines"@en .

aat:300024724 a skos:Concept ;
    skos:definition "Receptacles of a hard material, such as stone, brass, wood, or glass, that have a cup-shaped cavity in which materials are pounded or ground with a pestle. Often used to grind ingredients used in a pharmacy, painting, or cookery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortars"@en .

aat:300024725 a skos:Concept ;
    skos:definition "Club-shaped instruments of a hard material with a round end used for crushing, pounding, or grinding herbs, spices, drugs, pigments, or other materials in a mortar, which is a cup-shaped receptacle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pestles"@en .

aat:300024728 a skos:Concept ;
    skos:definition "Mechanical contrivances designed to remove moisture from surfaces or materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dryers"@en .

aat:300024729 a skos:Concept ;
    skos:definition "Any of various devices that emit an unusually hot flame for the purpose of welding, cutting, brazing, or burning off paint layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torches"@en .

aat:300024730 a skos:Concept ;
    skos:definition "Torches operated by compressed acetylene gas and oxygen; used in welding and metal-cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetylene torches"@en .

aat:300024731 a skos:Concept ;
    skos:definition "Handheld devices that throw flame using kerosene as fuel. These usually have a tank for the accelerant, and facilities for adjusting the oxygen flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerosene torches"@en .

aat:300024732 a skos:Concept ;
    skos:definition "Torches using oxygen and acetylene; used especially for welding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxyacetylene torches"@en .

aat:300024733 a skos:Concept ;
    skos:definition "Torches using oxygen and hydrogen; used especially for welding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxyhydrogen torches"@en .

aat:300024736 a skos:Concept ;
    skos:definition "Mechanical devices commonly used to hold items together or firmly in place while other operations are being performed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clamps"@en .

aat:300024743 a skos:Concept ;
    skos:definition "Joined tools with a pair of jaws and handles; used to grip objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pincers"@en .

aat:300024744 a skos:Concept ;
    skos:definition "Pincerlike hand tools with scissors action, usually with serrated jaws; used for gripping, holding, bending, and cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pliers"@en .

aat:300024745 a skos:Concept ;
    skos:definition "Pliers with long, narrow, flat jaws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlenose pliers"@en .

aat:300024748 a skos:Concept ;
    skos:definition "Any of numerous devices used for taking hold of objects, consisting commonly of two pieces that are joined at one end or near one end by a pivot or spring, forming the two jaws which are used for gripping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tongs"@en .

aat:300024749 a skos:Concept ;
    skos:definition "Any of various small pincer-shaped tools used for plucking, holding, or manipulating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tweezers"@en .

aat:300024751 a skos:Concept ;
    skos:definition "Vises attached to a workbench to hold material while it is being worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench vises"@en .

aat:300024753 a skos:Concept ;
    skos:definition "Portable mechanisms used for moving loads short distances by means of force applied with a lever, screw, hydraulic press, or air pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacks"@en .

aat:300024755 a skos:Concept ;
    skos:definition "Lifting devices operated by forced pumps of fluid with an external lever."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic jacks"@en .

aat:300024758 a skos:Concept ;
    skos:definition "Tools for sweeping. Originally made of twigs fixed to a handle; now refers to handled tools with bristles made of any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brooms"@en .

aat:300024759 a skos:Concept ;
    skos:definition "Small brooms with a short handles; used especially as a clothes brush or for light cleaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whisk brooms"@en .

aat:300024760 a skos:Concept ;
    skos:definition "Implements consisting of bristles, hair, or the like, set in or attached to a handle; used for painting, cleaning, polishing, or grooming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brushes"@en .

aat:300024762 a skos:Concept ;
    skos:definition "Flat brushes with long coarse bristles set in a wood handle; used by artists and draftsmen to sweep away eraser crumbs from work being done on a drawing board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dusting brushes"@en .

aat:300024763 a skos:Concept ;
    skos:definition "Hand-held brushes with short, very stiff bristles designed for cleaning debris from surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrub brushes"@en .

aat:300024764 a skos:Concept ;
    skos:definition "Flexible tubes for the conveyance of liquid materials from one place to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoses"@en .

aat:300024765 a skos:Concept ;
    skos:definition "Machines or structures in which solid, semisolid, liquid, or gaseous combustible wastes are burned, sometimes at high temperatures leaving little or no residue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incinerators"@en .

aat:300024766 a skos:Concept ;
    skos:definition "Cleaning instruments consisting of a pole or stick attached with a thick bundle of loose strings, yarn, or other absorbent material; used to soak up liquid in cleaning floors and other surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mops"@en .

aat:300024769 a skos:Concept ;
    skos:definition "Heavy hand tools with adjustable serrated jaws for gripping, screwing, or unscrewing metal pipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe wrenches"@en .

aat:300024770 a skos:Concept ;
    skos:definition "Tools consisting of a large rubber suction cup on a wood handle; used for clearing plumbing traps of minor obstructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plungers"@en .

aat:300024775 a skos:Concept ;
    skos:definition "Portable sets of flat broad steps or treads, with a frame hinged to the back for steadying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepladders"@en .

aat:300024787 a skos:Concept ;
    skos:definition "Devices or machines that compress and transport fluids, usually by pressure, suction, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumps"@en .

aat:300024788 a skos:Concept ;
    skos:definition "Tools used to penetrate materials, such as awls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piercing tools"@en .

aat:300024789 a skos:Concept ;
    skos:definition "Relatively slender, pointed instruments used for piercing, picking, scratching, engraving, or for other purposes.Common uses of needles include to draw thread or other fiber through cloth, leather, paper, skin and tissue, or another flexible material; as hollow, to inject a liquid; for engraving or etching metal. Historically, needles have been made of bronze, iron, bone, glass, steel, and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needles"@en .

aat:300024790 a skos:Concept ;
    skos:definition "Tools having a shaped tip at one end and a blunt butt end at the other, which is usually struck by a hammer. They are used by applying repeated sudden impact or by continuous pressure to make indentations, pricks, or sometimes perforations in various materials. They are usually in the form of a steel rod with an end that may take a variety of shapes used for marking, blanking, decoration, driving in nails, enlarging an existing hole. An example of the application of punches is in medieval altarpieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punches"@en .

aat:300024795 a skos:Concept ;
    skos:definition "Equipment designed for or used for extinguishing or containing fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firefighting equipment"@en .

aat:300024796 a skos:Concept ;
    skos:definition "Axes to be used in case of fire. They are standard equipment of firefighters and are also often found in public buildings; part of the head and heft may be painted red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire axes"@en .

aat:300024797 a skos:Concept ;
    skos:definition "Portable devices for immediate and temporary use in putting out a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire extinguishers"@en .

aat:300024798 a skos:Concept ;
    skos:definition "Hoses used to convey water to extinguish fires. These are usually made to withstand high pressurization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firehoses"@en .

aat:300024800 a skos:Concept ;
    skos:definition "Masks worn over the face to protect against inhalation of poisonous fumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas masks"@en .

aat:300024801 a skos:Concept ;
    skos:definition "Protective masks worn when working in an area with gas, fumes, smoke, or high dust density."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "respirators"@en .

aat:300024803 a skos:Concept ;
    skos:definition "Protective or restraining belts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety belts"@en .

aat:300024805 a skos:Concept ;
    skos:definition "Large strong nets intended to protect construction workers, circus acrobats, or others from falling to the ground from heights, or to protect people on the ground from falling debris or construction materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety nets"@en .

aat:300024806 a skos:Concept ;
    skos:definition "Fine nets designed as barriers to mosquitos, frequently hung around beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosquito nets"@en .

aat:300024809 a skos:Concept ;
    skos:definition "Steel hand tools with teeth or raised oblique ridges; used for scraping, redressing, or smoothing metal or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "files"@en .

aat:300024810 a skos:Concept ;
    skos:definition "Machines used in goffering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goffering machines"@en .

aat:300024813 a skos:Concept ;
    skos:definition "Power-operated machines, such as lathes, used for general cutting and shaping of metal and other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine tools"@en .

aat:300024817 a skos:Concept ;
    skos:definition "Fixed or portable machines used for planing wood or steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planing machines"@en .

aat:300024818 a skos:Concept ;
    skos:definition "Files with projecting teeth for rough work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rasps"@en .

aat:300024819 a skos:Concept ;
    skos:definition "Instruments for stamping, such as dies or tools for impressing or marking a design or pattern on metal, paper, sand, or other soft or absorbent material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamps"@en .

aat:300024822 a skos:Concept ;
    skos:definition "Equipment used to hammer or pound materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking tools"@en .

aat:300024823 a skos:Concept ;
    skos:definition "Hand tools having a hard solid head, usually of metal or stone, set transversely on a handle. They are used for driving nails, beating, breaking, or other applications involving pounding or striking. The term may also refer to machines in which a heavy block of metal is used for the same purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammers"@en .

aat:300024824 a skos:Concept ;
    skos:definition "Portable electric, pneumatic, and self-contained gasoline-driven hammers using a vibratory action principle and accommodating such tools as chisels, spade, and tampers; used for removing brick, hardened putty, mortar, and other similar applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power hammers"@en .

aat:300024825 a skos:Concept ;
    skos:definition "Hammering tools of modest size, having a handle and relatively large head, usually of wood but sometimes of other materials. Often used to drive another tool, such as a chisel or a gouge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mallets"@en .

aat:300024826 a skos:Concept ;
    skos:definition "Long-handled hammering tools with a heavy wooden or metal head, often specifically any of various special kinds of heavy hammering tools used in pile-driving, shipbuilding, and mining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mauls"@en .

aat:300024830 a skos:Concept ;
    skos:definition "Hand tools consisting of a steel or other metal head pointed at one or both ends and mounted on a handle or wood or another material; used for loosening and breaking up compacted soil or rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picks"@en .

aat:300024831 a skos:Concept ;
    skos:definition "Equipment used to provide strength to structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supporting equipment"@en .

aat:300024834 a skos:Concept ;
    skos:definition "Equipment used for cleaning or removing surfaces by a controlled stream of pressure-ejected material consisting of sand or manufactured grit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandblasting equipment"@en .

aat:300024836 a skos:Concept ;
    skos:definition "Any of various tools used for scraping, producing a clean or a smooth finished surface, cutting grooves, or shaping objects by scraping away superfluous material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrapers"@en .

aat:300024838 a skos:Concept ;
    skos:definition "Tools used for delicate or precision work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instruments"@en .

aat:300024839 a skos:Concept ;
    skos:definition "An assemblage of machines or machine parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machinery"@en .

aat:300024841 a skos:Concept ;
    skos:definition "Objects, especially those hand-held, for performing or facilitating mechanical operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tools"@en .

aat:300024854 a skos:Concept ;
    skos:definition "Prehistoric hammering implements consisting of rounded stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammerstones"@en .

aat:300024860 a skos:Concept ;
    skos:definition "Pieces of hard material, typically stone or metal, sharpened to have a cutting edge or penetrating point for use as projectiles or the heads of projectile weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projectile points"@en .

aat:300024861 a skos:Concept ;
    skos:definition "The pointed or edged heads of arrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrowheads"@en .

aat:300024870 a skos:Concept ;
    skos:definition "Tools powered by electric motors or by gasoline engines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power tools"@en .

aat:300024872 a skos:Concept ;
    skos:definition "Parts and components of anvils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anvil components"@en .

aat:300024873 a skos:Concept ;
    skos:definition "The tapered ends of anvils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beak irons"@en .

aat:300024878 a skos:Concept ;
    skos:definition "Continuous bands of tough, flexible material such as leather, fabric, rubber, or wire; used for transmitting motion and power from one pulley to another or for conveying materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belts"@en .

aat:300024879 a skos:Concept ;
    skos:definition "Tool components of varying sizes that fit into a brace or drill and are rotated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bits"@en .

aat:300024883 a skos:Concept ;
    skos:definition "Bits having a square tapered shank fitted into and rotated by a brace, and are used for drilling holes in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auger bits"@en .

aat:300024884 a skos:Concept ;
    skos:definition "Large, long, auger bits with a very open twist that may or may not terminate in a screw end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship auger bits"@en .

aat:300024886 a skos:Concept ;
    skos:definition "Tool components that fit into a brace or drill that are bent at one end into a semi-circular form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brush bits"@en .

aat:300024887 a skos:Concept ;
    skos:definition "Bits used to inscribe, smooth, and cut out circles from thin bone plates in the production of buttons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "button bits"@en .

aat:300024893 a skos:Concept ;
    skos:definition "Drilling bits whose blade can be adjusted to bore holes of different diameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expansion bits"@en .

aat:300024895 a skos:Concept ;
    skos:definition "Bits used to sink blind holes in timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Forstner bits"@en .

aat:300024896 a skos:Concept ;
    skos:definition "Bits with spiral flutes and sharp threaded points; used for boring small holes in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gimlet bits"@en .

aat:300024897 a skos:Concept ;
    skos:definition "Scooped-out bits with a rounded end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouge bits"@en .

aat:300024898 a skos:Concept ;
    skos:definition "Bits with a projecting lip or notched blade which allows wood shavings to accumulate in the spoon or hollow portion of the bit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nose bits"@en .

aat:300024899 a skos:Concept ;
    skos:definition "Bits with a twist at the end, used for boring wood pipes or pumps, or to start a hole to be finished with a shell bit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pod-bits"@en .

aat:300024901 a skos:Concept ;
    skos:definition "Bits having a sharp spiral cutting edge which may be square, half-round, half-round and hollow, or five- to eight-sided and with tapered ends; used for enlarging existing holes or to remove burrs from the inside of pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reamer bits"@en .

aat:300024907 a skos:Concept ;
    skos:definition "Gouge-shaped bits for boring holes in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell bits"@en .

aat:300024909 a skos:Concept ;
    skos:definition "Bits shaped like a half cylinder, used with a brace for drilling dowel holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoon bits"@en .

aat:300024913 a skos:Concept ;
    skos:definition "Bits used to cut a conical depression for recessing the head of a bolt, nut, or screw, so that it is flush with the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countersink bits"@en .

aat:300024915 a skos:Concept ;
    skos:definition "Boring bits that resemble twist drills in having two deep vertical grooves, but having a steeper cutting angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral bits"@en .

aat:300024917 a skos:Concept ;
    skos:definition "The sharpened, flat-edged cutting part of a tool or weapon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blades"@en .

aat:300024919 a skos:Concept ;
    skos:definition "Blades, often disposable or replaceable, used with a razor, for cutting or shaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "razor blades"@en .

aat:300024921 a skos:Concept ;
    skos:definition "Teeth on the rim of a wheel or gear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cogs"@en .

aat:300024926 a skos:Concept ;
    skos:definition "Handles of cutting tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hafts"@en .

aat:300024927 a skos:Concept ;
    skos:definition "Those portions of, or attachments to, objects that are designed to be grasped by the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handles"@en .

aat:300024928 a skos:Concept ;
    skos:definition "Tool handles, such as those of axes, hatchets, or hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helves"@en .

aat:300024936 a skos:Concept ;
    skos:definition "Devices, such as sticks or blocks, having a soft absorbent surface; used to apply polishing material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffs"@en .

aat:300024943 a skos:Concept ;
    skos:definition "Disks or drums with an attached abrasive for power tool application in sanding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanding disks"@en .

aat:300024944 a skos:Concept ;
    skos:definition "Disks composed of or coated with abrasive material, mounted in various ways to motors that spin at high speed. Objects are brought into contact with the spinning surface of these wheels to be ground down, smoothed, or cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanding wheels"@en .

aat:300024945 a skos:Concept ;
    skos:definition "Parts and components of hoists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoist components"@en .

aat:300024946 a skos:Concept ;
    skos:definition "Connections between an implement and a detachable source of motive power, as a tractor or a crane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hitches"@en .

aat:300024947 a skos:Concept ;
    skos:definition "Hoist components usually consisting of looped lines used to hold securely something to be hoisted, lowered, carried, or suspended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slings"@en .

aat:300024951 a skos:Concept ;
    skos:definition "Moveable bars carrying the reed of a loom that strike home each filling thread as they are interlaced with the warp by the passage of the shuttle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battens"@en .

aat:300024953 a skos:Concept ;
    skos:definition "In weaving; refers to the cords, wires, or steel strips that the warp passes through in a loom after passing through the reed, that allows the warp threads to be separated, allowing the shuttle to pass through the weft. Heddles are considered a major advance in the development of weaving technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heddles"@en .

aat:300024954 a skos:Concept ;
    skos:definition "Large sandstone blocks with holes for inserting a wooden stick, used in looms; the sticks are used to arrange warp threads when setting up a vertical loom. Examples of use are the Hopi and other southwestern Native Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loomblocks"@en .

aat:300024955 a skos:Concept ;
    skos:definition "Devices used in weaving, comprising a comb-like bar with evenly spaced pins along the long side, used to space the warp threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raddles"@en .

aat:300024956 a skos:Concept ;
    skos:definition "Implements which are inserted into the warp threads as they are prepared for the loom, and keep the different sheds separate while the loom is being threaded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaft sticks"@en .

aat:300024958 a skos:Concept ;
    skos:definition "Components of a loom, comprising sticks inserted close to the heddle rod of a frame loom. By pushing down or pulling up on the shed stick, the weaver forms a countershed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shed sticks"@en .

aat:300024960 a skos:Concept ;
    skos:definition "Weaving shuttles having a canoe-shape, often with an opening in the center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boat shuttles"@en .

aat:300024961 a skos:Concept ;
    skos:definition "Weaving shuttles of a stick shape, often having openings in the middle or on either end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stick shuttles"@en .

aat:300024964 a skos:Concept ;
    skos:definition "Devices with adjustable jaws used for centering and holding a cutting bit or a drill bit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chucks"@en .

aat:300024967 a skos:Concept ;
    skos:definition "Casings or sockets which hold a drill or other tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collets"@en .

aat:300024969 a skos:Concept ;
    skos:definition "The tapered or beveled tips or pairs of blades that form the pen point of a reed pen, quill pen, or pen with a metal point, such as a fountain pen. The term may also refer to the removable metal pen point of a pen, as distinguished from the handle or holder of the point. It may also refer to the tiny ball of iridium on the tip of a metal pen point, as distinguished from similar pen points that are blunt or have a fine sharp point. Nib is also used to refer to one of the two blades that form the point of a split pen point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nibs"@en .

aat:300024970 a skos:Concept ;
    skos:definition "Long, straight parts of various types of tools, machines, and weapons, such as the rods that transmit power or motion from one part of a machine to another, or the slender sticks that constitute the main bodies of arrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shafts"@en .

aat:300024976 a skos:Concept ;
    skos:definition "Circular frameworks of wood, metal, or other hard material often with cogs or teeth on the rim used to transmit or modify force and motion in machinery or a mechanical contrivance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheels"@en .

aat:300024979 a skos:Concept ;
    skos:definition "Members of the species Homo sapiens and their close extinct relatives, as distinguished from other animals, spirits, or other entities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people"@en .

aat:300024982 a skos:Concept ;
    skos:definition "Professionally-qualified people who record all the transactions affecting the financial status of an organization, including the collation, recording, and communication of financial information and the preparation of analyses for decision-making purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accountants"@en .

aat:300024983 a skos:Concept ;
    skos:definition "Persons trained in mathematics and statistics whose business it is to calculate insurance and annuity premiums, reserves, and dividends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actuaries"@en .

aat:300024984 a skos:Concept ;
    skos:definition "Persons authorized to examine and verify accounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auditors"@en .

aat:300024987 a skos:Concept ;
    skos:definition "People trained in or practicing architecture, which is the art of designing and building habitable structures, especially those considered to have aesthetic value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architects"@en .

aat:300024988 a skos:Concept ;
    skos:definition "Architects working with other architects in a temporary agreement or partnership of joint venture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "associated architects"@en .

aat:300024989 a skos:Concept ;
    skos:definition "People who design structures and are in the employ of a government, generally those who specialize in designing buildings that house a governmental body or agency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government architects"@en .

aat:300024993 a skos:Concept ;
    skos:definition "People who specialize in designing the scenic environment on a relatively large scale, including the layout of plants and accompanying structures. Distinguished from \"garden designers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape architects"@en .

aat:300024996 a skos:Concept ;
    skos:definition "People who specialize in designing ships and other waterborne craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval architects"@en .

aat:300024999 a skos:Concept ;
    skos:definition "Those who, in an auction or competition for a contract, offer a specific sum as the price they will pay or charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidders"@en .

aat:300025001 a skos:Concept ;
    skos:definition "Refers to all types of laborers employed in building construction, including skilled and unskilled workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction workers"@en .

aat:300025003 a skos:Concept ;
    skos:definition "Persons who lay down asphalt on streets, driveways, sidewalks, parking lots, and other sites of construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphalters"@en .

aat:300025004 a skos:Concept ;
    skos:definition "Construction workers whose work is blasting with explosives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blasters"@en .

aat:300025006 a skos:Concept ;
    skos:definition "Workers who conduct the secondary process that can enlarge or finish preexisting holes after they have been drilled. For workers who conduct the primary process used to create holes, use \"drillers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borers"@en .

aat:300025007 a skos:Concept ;
    skos:definition "Those responsible for erecting structures or buildings of any kind. Builders include the company that is responsible for the construction, as well as groups or individual professional people who receive instructions from an architect or patron, and employ other workers to carry out manual labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "builders"@en .

aat:300025008 a skos:Concept ;
    skos:definition "Those who build with wood, especially in the construction of buildings and other structures, including the installation of floors, windows, and other trim work. For craftsmen who make fine furniture and do intricate woodwork, see \"cabinetmakers.\" For those who work in wood more generally, see \"woodworkers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpenters"@en .

aat:300025009 a skos:Concept ;
    skos:definition "Persons who build or work with concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concreters"@en .

aat:300025011 a skos:Concept ;
    skos:definition "Men or women who operate a crane, which is a machine for raising, shifting, or lowering heavy weights, usually by means of a projecting swinging arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cranemen"@en .

aat:300025012 a skos:Concept ;
    skos:definition "Workers who attach slings to articles for hoisting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slingers"@en .

aat:300025013 a skos:Concept ;
    skos:definition "Persons whose business is the demolition and removal of buildings or other structures, often including the salvaging of material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wreckers"@en .

aat:300025017 a skos:Concept ;
    skos:definition "Men or women who operate a drill, which is a large machine or hand tool used for making holes in a variety of materials. For workers that conduct the secondary process of enlarging or refining drilled holes to particular tolerances, use \"borers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drillers"@en .

aat:300025018 a skos:Concept ;
    skos:definition "Those whose occupation is to work with electrical equipment or wiring by installing it, repairing it, or selling it. They may specialize in the electrical infrastructure of buildings or in machines and appliances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electricians"@en .

aat:300025019 a skos:Concept ;
    skos:definition "Persons who work on a structure, such as a steel building or bridge, by assembling fabricated parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erectors"@en .

aat:300025021 a skos:Concept ;
    skos:definition "One who works with either a manual or mechanical hammer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammermen"@en .

aat:300025028 a skos:Concept ;
    skos:definition "In the context of art and architecture, people who apply plaster, which is primarily a mixture of lime, sand, and water, to a wall, ceiling, or other surface, to which mural paintings may or may not be applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasterers"@en .

aat:300025030 a skos:Concept ;
    skos:definition "Originally and historically, plumbers were people who worked with or cast lead. Subsequently and currently this refers to people who fit or repair the pipes, fittings, and other apparatus relating to a water supply, sanitation systems, or heating or cooling of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumbers"@en .

aat:300025032 a skos:Concept ;
    skos:definition "Senior rig workers on an oil drilling crew who guide stands of drill pipe from a position at the top of a derrick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "derrickmen"@en .

aat:300025033 a skos:Concept ;
    skos:definition "People who construct or repair roofs as an occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofers"@en .

aat:300025035 a skos:Concept ;
    skos:definition "Those whose business or trade it is to erect scaffolds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaffolders"@en .

aat:300025036 a skos:Concept ;
    skos:definition "Workers who build or install shores, which are pieces of lumber used as temporary supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shorers"@en .

aat:300025037 a skos:Concept ;
    skos:definition "Those whose occupation it is to climb steeples, chimneys, or other tall structures, and to repair them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steeplejacks"@en .

aat:300025040 a skos:Concept ;
    skos:definition "Refers to people who cut, carve, dress, and lay stone in the context of creating a building. Masons were among the most prestigious craftsmen of the Middle Ages. The term may also refer to anyone who builds with stone or a similar material, such as brick, concrete, or artificial stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masons"@en .

aat:300025041 a skos:Concept ;
    skos:definition "Refers to the masons who carved the stone at their banker in the building lodge. They performed the final preparation work on stone masonry blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banker masons"@en .

aat:300025043 a skos:Concept ;
    skos:definition "Those whose occupation or craft it is to build with hardened clay bricks. For those who lay any combination of stone, blocks, or bricks, use \"mason.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bricklayers"@en .

aat:300025044 a skos:Concept ;
    skos:definition "Masons who place the great blocks of stone accurately into position in a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixer masons"@en .

aat:300025045 a skos:Concept ;
    skos:definition "Refers specifically to workmen who use hammers, chisels, and other cutting tools to shape and lay stones in building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stonemasons"@en .

aat:300025047 a skos:Concept ;
    skos:definition "Those whose occupation it is to quarry stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarriers"@en .

aat:300025052 a skos:Concept ;
    skos:definition "People or corporate bodies who perform work or provide supplies, often on a large scale, according to a legally binding contractual agreement at a certain price or rate. For example, in the building and related trades, contractors undertake construction work according to the terms of a contract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contractors"@en .

aat:300025053 a skos:Concept ;
    skos:definition "People or corporate bodies who are responsible for most of the work at the construction site, including that performed by the subcontractors. The services of a general contractor are unlimited as to the type of work which he or she may do for the project. For contractors whose services are limited to the construction of commercial buildings and single-dwelling or multiple-dwelling residential buildings, use \"building contractors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general contractors"@en .

aat:300025055 a skos:Concept ;
    skos:definition "Contractors who have contracts directly with an owner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prime contractors"@en .

aat:300025056 a skos:Concept ;
    skos:definition "Individuals or companies that undertake work under a contract that is part of or subject to a larger contract on a larger project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subcontractors"@en .

aat:300025058 a skos:Concept ;
    skos:definition "Individuals, companies, or corporations engaged in the development and improvement of land for construction purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developers"@en .

aat:300025059 a skos:Concept ;
    skos:definition "Persons skilled in the creation of technical drawings, as of structures or machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafters"@en .

aat:300025063 a skos:Concept ;
    skos:definition "Persons trained in a branch of engineering. In some jurisdictions the designation is legally restricted in technical use to persons who have completed a prescribed course of study and complied with requirements concerning registration or licensing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineers"@en .

aat:300025066 a skos:Concept ;
    skos:definition "Engineers who design aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical engineers"@en .

aat:300025067 a skos:Concept ;
    skos:definition "Engineers who design spacecraft, missles, and rockets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerospace engineers"@en .

aat:300025068 a skos:Concept ;
    skos:definition "Those working with techniques of modification or manipulation of organisms, which may involve the processes of heredity and reproduction, motor function, implantable devices, artificial limbs and organs, physical aids for the handicapped, and instrumentation used in research, diagnosis, and treatment of disease or physical disability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biomedical engineers"@en .

aat:300025069 a skos:Concept ;
    skos:definition "Refers to people employed in the design and development of the processes of creating chemicals and in the operation and requirements of a chemical plant. They are concerned with data and predictions that often have to be obtained or confirmed with pilot experiments. Their activities differ from chemists in that chemists deal with the research of and actual creation of chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical engineers"@en .

aat:300025070 a skos:Concept ;
    skos:definition "People who design public works such as bridges, highways, waterways, land drainage, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil engineers"@en .

aat:300025073 a skos:Concept ;
    skos:definition "Civil engineers specializing in the design and production of systems, equipment, and structures that either control, transport, or generate power from water or other fluids or that derive some or all of their power from the flow of water, such as hydraulic machinery, sewage disposal plants, waterworks, dams, pipelines, and hydroelectric power plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic engineers"@en .

aat:300025074 a skos:Concept ;
    skos:definition "Those whose occupation is the preparation of plans and specifications related to mechanical and structural water treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-supply engineers"@en .

aat:300025075 a skos:Concept ;
    skos:definition "People who design systems to protect public health and promote clean air, food, water, and housing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanitary engineers"@en .

aat:300025076 a skos:Concept ;
    skos:definition "Engineers who design bridges, dams, buildings, and other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural engineers"@en .

aat:300025078 a skos:Concept ;
    skos:definition "Engineers who design streets and roads to allow the smooth flow of traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic engineers"@en .

aat:300025079 a skos:Concept ;
    skos:definition "Those trained or working in the field of electrical engineering, which has to do with the transmission of electrical powery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical engineers"@en .

aat:300025082 a skos:Concept ;
    skos:definition "Those who apply principles of engineering and scientific management in industrial enterprises to maintain efficiency and high productivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial engineers"@en .

aat:300025083 a skos:Concept ;
    skos:definition "Engineers working in the design, construction, operation, and administration of machinery installations for seagoing vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine engineers"@en .

aat:300025085 a skos:Concept ;
    skos:definition "Engineers who design systems having to do with mechanics, thermodynamics, and material properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical engineers"@en .

aat:300025086 a skos:Concept ;
    skos:definition "Practitioners of military engineering, which is the designing and building of military installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military engineers"@en .

aat:300025087 a skos:Concept ;
    skos:definition "Those whose occupation is the preparation of plans and specifications related to municipal infrastructure, including streets, lighting, waste management, parks, and other public works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal engineers"@en .

aat:300025088 a skos:Concept ;
    skos:definition "Those whose occupation is the preparation of plans and specifications related to the technology of nuclear fission and fusion, particularly in the context of power generation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear engineers"@en .

aat:300025089 a skos:Concept ;
    skos:definition "Those whose occupation is the preparation of plans and specifications related to the prevention of accidental deaths and injuries. The duties of a safety engineer may include the identification and appraisal of accident-producing conditions and practices and the development of accident control methods or systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety engineers"@en .

aat:300025090 a skos:Concept ;
    skos:definition "Those trained or working in any of the planning fields, which have to do with the establishment of objectives, procedures, and resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planners"@en .

aat:300025091 a skos:Concept ;
    skos:definition "Those who specialize in designing and improving the spacial organization and content of urban areas. For those who work in the overall management of urban areas, encompassing the setting of objectives for urban life, the establishment of policies, and the planning, development, operation, and maintenance of the urban environment and services, use \"urban managers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban planners"@en .

aat:300025099 a skos:Concept ;
    skos:definition "People who estimate or measure quantities of materials and equipment necessary to build a construction project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quantity surveyors"@en .

aat:300025100 a skos:Concept ;
    skos:definition "Those who examine or inspect in order to achieve a comprehensive view, as of a place, a situation, or an area of study, or to ascertain condition or value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveyors"@en .

aat:300025102 a skos:Concept ;
    skos:definition "Persons who formulate concepts and supervise the execution of the visual appearance of a publication or performing arts production, including layout, illustrations, designs for art work and copy, etc. for visual communications media, such as magazines, books, newspapers, online publications, posters, packaging, television, film, theater, video games, and other visual media. Art directors are typically not in an executive position. For executives of a theater company or arts organization who choose the material staged in a season, the hiring of creative and production personnel, and other management tasks, use \"artistic directors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art directors"@en .

aat:300025103 a skos:Concept ;
    skos:definition "People who produce work in the visual arts. For those in the performing arts, see \"performing artists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists"@en .

aat:300025107 a skos:Concept ;
    skos:definition "Those skilled in creating specialized lettering by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calligraphers"@en .

aat:300025108 a skos:Concept ;
    skos:definition "Artists who create representations, often portraits, that exaggerate certain features or characteristics to humorous or ludicrous effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caricaturists"@en .

aat:300025110 a skos:Concept ;
    skos:definition "Persons who draw pictorial images using wit to comment on such things as contemporary events, social habits, or political trends, usually executed in a broad or abbreviated manner. For people who make cartoons in the sense of studies for a fresco, use \"draftsmen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartoonists"@en .

aat:300025113 a skos:Concept ;
    skos:definition "Artists who create collages, which are mixed media works in two dimensions or very low relief, made by gluing paper, fabrics, photographs, or other materials onto a flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collagists"@en .

aat:300025115 a skos:Concept ;
    skos:definition "A commercial artist who renders lettering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterers"@en .

aat:300025119 a skos:Concept ;
    skos:definition "Persons who design and create artwork and copy layouts, including both words and images, for presentation by visual media such as books, magazines, newspapers, posters, television, and packaging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic designers"@en .

aat:300025122 a skos:Concept ;
    skos:definition "Artists who paint or draw pictures or other decorative forms in manuscripts. For those who create works in miniature, such as paintings, photographs, furniture, and other objects, see \"miniaturists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illuminators"@en .

aat:300025123 a skos:Concept ;
    skos:definition "Artists who specialize in creating drawings, prints, or other pictures intended to elucidate a description, story, or other written material, usually in a book or periodical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illustrators"@en .

aat:300025126 a skos:Concept ;
    skos:definition "Persons who draw or paint illustrations of fashionable apparel and accessories, especially for advertisement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion illustrators"@en .

aat:300025129 a skos:Concept ;
    skos:definition "Commercial artists who render images to illustrate scientific concepts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific illustrators"@en .

aat:300025134 a skos:Concept ;
    skos:definition "Refers to artists who produce art within the context of a culturally cohesive community, generally guided by traditional rules or procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folk artists"@en .

aat:300025135 a skos:Concept ;
    skos:definition "Refers to painters; usage is generally limited to painters of miniatures or of portraits. Usage is slightly different depending upon the period of art cited. For art of the European Middle Ages, the term refers to manuscript illuminators, who were creating miniature paintings and other decoration. For art from the 16th to the 19th century, the term typically refers to painters of miniatures, particularly miniature portraits. In Colonial and 19th-century America, it generally refers to itinerant painters who were trained craftsmen and naive portrait painters, producing both miniatures and full-size portraits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limners"@en .

aat:300025136 a skos:Concept ;
    skos:definition "People who practice the art of painting, which is applying pigments suspended in liquid to a surface to create an expressive or communicative image. For people who apply paint primarily to protect or give simple color to a surface, use \"painters (tradespeople).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painters"@en .

aat:300025146 a skos:Concept ;
    skos:definition "Artisans who paint surfaces in imitation of woodgrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grainers"@en .

aat:300025151 a skos:Concept ;
    skos:definition "One who engages in the trade of varnishing with japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "japanners"@en .

aat:300025153 a skos:Concept ;
    skos:definition "Artists who execute paintings on a wall or ceiling as part of a scheme of decoration, as distinguished from \"painters (tradespeople),\" who paint for the primary purpose of protecting the surface or applying simple color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muralists"@en .

aat:300025161 a skos:Concept ;
    skos:definition "Artists who specialize in painting images of animals, generally cats, dogs, horses, or other prize pets, livestock, or exotic wild animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal painters"@en .

aat:300025163 a skos:Concept ;
    skos:definition "Artists who specialize in making pastels, which are works of art created with colored crayons made of ground pigment mixed with a small amount of binder, either oil or water and gum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastelists"@en .

aat:300025165 a skos:Concept ;
    skos:definition "Those who practice the printing process of engraving. For those who incise marks on the surface of a hard material, not to be printed from, use \"engravers (incisers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engravers"@en .

aat:300025166 a skos:Concept ;
    skos:definition "Printmakers who do stipple engraving, which creates tonal areas by short flicks or dots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stipple engravers"@en .

aat:300025167 a skos:Concept ;
    skos:definition "People who engage in making wood engravings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood engravers"@en .

aat:300025174 a skos:Concept ;
    skos:definition "Artists who etch, by hand, metal plates to be used in creating etchings, which are prints made by an intaglio process in which the design is worked into an acid-resistant substance coating the metal printing plate, and the plate is then dipped in acid to form the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etchers"@en .

aat:300025175 a skos:Concept ;
    skos:definition "Persons engaged in lithography, in which the design is deposited on a plate or stone with a greasy substance that will accept pigment for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographers"@en .

aat:300025176 a skos:Concept ;
    skos:definition "Printmakers who work in mezzotint, in which a plate is roughened with a rocker and lighter designs are created by smoothing the rough areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezzotinters"@en .

aat:300025177 a skos:Concept ;
    skos:definition "Those who make prints with the use of silk screens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serigraphers"@en .

aat:300025178 a skos:Concept ;
    skos:definition "Those who make woodcut blocks or the prints from them; for those who cut trees for lumber, use \"loggers\"; for those who carve objects or ornament in wood, use \"woodcarvers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodcutters"@en .

aat:300025179 a skos:Concept ;
    skos:definition "Draftsmen who do rendering, especially those who produce drawings of architectural designs in accurate, representational perspective to show what the project will look like when built."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "renderers"@en .

aat:300025181 a skos:Concept ;
    skos:definition "Artists who specialize in creating images and forms that are carried out primarily in three dimensions, generally of large or medium size, and in the media of stone, wood, or metal. It may also refer to artists who create relief or intaglio works. For artists who create small works, or for craftsmen who carve three dimensional forms that are not considered art, use \"carvers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculptors"@en .

aat:300025182 a skos:Concept ;
    skos:definition "Artists who specialize in creating three-dimensional images in which animals are the subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal sculptors"@en .

aat:300025189 a skos:Concept ;
    skos:definition "People who make copies, especially those who copy manuscripts, music notation, other documents, or art works by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copyists"@en .

aat:300025190 a skos:Concept ;
    skos:definition "People who create artistic drawings and plans for the construction or creation of something according to aesthetic or functional criteria; those who create plans or concepts for subsequent implementation of graphic works, objects, structures, systems, or conceptual schemes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "designers"@en .

aat:300025193 a skos:Concept ;
    skos:definition "A dealer in cloth, and by extension, other articles of textile manufacture, including clothing or dry goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drapers"@en .

aat:300025195 a skos:Concept ;
    skos:definition "Persons who plan and design displays to decorate streets, fairgrounds, buildings, and other places for celebrations, fairs, and special occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display designers"@en .

aat:300025197 a skos:Concept ;
    skos:definition "Those whose occupation is to arrange the display of merchandise in a shop window, often with decorative additions for effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window dressers"@en .

aat:300025198 a skos:Concept ;
    skos:definition "Persons engaged in fashion design, includes the design of clothes, accessories, and fashion ensembles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion designers"@en .

aat:300025201 a skos:Concept ;
    skos:definition "Persons who design and fashion live, cut, dried, and artificial floral and foliar arrangements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floral designers"@en .

aat:300025203 a skos:Concept ;
    skos:definition "Those professionally engaged in the field of industrial design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial designers"@en .

aat:300025204 a skos:Concept ;
    skos:definition "Engineers specializing in designing, building, and testing the prototype of a product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "product engineers"@en .

aat:300025205 a skos:Concept ;
    skos:definition "People who specialize in the design and arrangement of interiors, including the design of the space itself as well as designs, colors, and placement of moveable works located within buildings' spaces, such as furniture or accessories. For people whose profession focuses specifically on the design and construction of spaces inside architectural structures or parts of structures, prefer \"interior architects.\" For those whose interest is limited to the furnishings and accessories, use \"interior decorators.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior designers"@en .

aat:300025208 a skos:Concept ;
    skos:definition "Persons who conduct the sale of goods at public auction, usually as agents on commission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auctioneers"@en .

aat:300025209 a skos:Concept ;
    skos:definition "Those who carry on the business of banking, by variously accepting money on deposit, usually offering interest in return, facilitating transactions, buying and selling bills of exchange, promissory notes, bonds, stocks, or other securities, and loaning money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bankers"@en .

aat:300025210 a skos:Concept ;
    skos:definition "Men who engage in business as their primary occupation or function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "businessmen"@en .

aat:300025211 a skos:Concept ;
    skos:definition "Refers generally to those who obtain title to or an interest in property through purchase. Refers specifically to employees in mercantile businesses who have charge of the selection, buying, pricing, stockkeeping, and display of goods for resale to customers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buyers"@en .

aat:300025213 a skos:Concept ;
    skos:definition "People authorized to represent or act on behalf of someone else, particularly in business transactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agents"@en .

aat:300025215 a skos:Concept ;
    skos:definition "Individuals or companies that act as middlemen, who for a fee or commission negotiate contracts of purchase and sale between buyers and sellers. Distinct from \"commission merchants\" in that they do not take physical possession or control of the merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brokers"@en .

aat:300025216 a skos:Concept ;
    skos:definition "Individuals or companies that act as middlemen between buyers and sellers of stock, usually for a commission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stockbrokers"@en .

aat:300025217 a skos:Concept ;
    skos:definition "Agents of an insurer authorized to negotiate contracts of insurance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurance agents"@en .

aat:300025218 a skos:Concept ;
    skos:definition "Persons licensed to sell, buy, lease, or rent real estate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "real estate agents"@en .

aat:300025221 a skos:Concept ;
    skos:definition "Individuals or companies who arrange transportation and accomodations for travelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel agents"@en .

aat:300025222 a skos:Concept ;
    skos:definition "Refers to those who organize, manage, and usually own a business entreprise, assuming the risks of profit or loss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrepreneurs"@en .

aat:300025223 a skos:Concept ;
    skos:definition "Refers to people engaged in carrying or sending articles of trade or commerce out of one country to another or others for sale or exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exporters"@en .

aat:300025224 a skos:Concept ;
    skos:definition "Large-scale investors; also persons who undertake to secure large funds for government or business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "financiers"@en .

aat:300025225 a skos:Concept ;
    skos:definition "Refers to people engaged in bringing articles of trade or commerce into a country from abroad for sale or exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "importers"@en .

aat:300025226 a skos:Concept ;
    skos:definition "People or corporate bodies who own, control, or play a major role in the operation of an industrial enterprise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrialists"@en .

aat:300025227 a skos:Concept ;
    skos:definition "Individuals whose principal business consists of advising others, either directly or through publications, on their investments and on investment opportunities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "investment counsels"@en .

aat:300025229 a skos:Concept ;
    skos:definition "Persons who seek to commit funds for profitable return, such as by purchasing bonds or shares in companies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "investors"@en .

aat:300025230 a skos:Concept ;
    skos:definition "Refers to people or corporate bodies who own or run a manufacturing plant. For those who create or construct artifacts by their own labor, especially as their craft or profession, see \"makers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manufacturers"@en .

aat:300025231 a skos:Concept ;
    skos:definition "Persons associated as joint principals in carrying on an enterprise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partners"@en .

aat:300025234 a skos:Concept ;
    skos:definition "Generally, a person who collects specimens, works of art, curiosities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectors"@en .

aat:300025236 a skos:Concept ;
    skos:definition "Individuals or companies who buy and sell materials, such as antiques, works of art, or library materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dealers"@en .

aat:300025240 a skos:Concept ;
    skos:definition "People or groups of people who finance or who give, such as items or art works to a collection. For those who make a partial contribution to a larger whole, use \"contributors.\" For those who sponsor the broader work of people such as artists and writers, use \"patrons.\" For supporters who assume primary responsibility for projects or activities, use \"sponsors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "donors"@en .

aat:300025241 a skos:Concept ;
    skos:definition "Refers to those who own businesses or commercial establishments. For those who generally have legal title to something, see \"owners.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proprietors"@en .

aat:300025243 a skos:Concept ;
    skos:definition "Individuals working in stores who serve the customers and process sales, returns, and refunds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sales personnel"@en .

aat:300025244 a skos:Concept ;
    skos:definition "People who buy and sell books, including proprietors of bookshops. In contexts before about 1800, refers also to those responsible for issuing books, later called \"publishers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booksellers"@en .

aat:300025245 a skos:Concept ;
    skos:definition "Buyers and sellers of commodities for profit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merchants"@en .

aat:300025246 a skos:Concept ;
    skos:definition "Merchants, either individuals or companies, whose principal business consists in selling directly to final consumers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retailers"@en .

aat:300025247 a skos:Concept ;
    skos:definition "Retailers who own and operate small to medium-sized stores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shopkeepers"@en .

aat:300025248 a skos:Concept ;
    skos:definition "Merchants who buy goods in large quantities and then resells, generally in comparatively smaller quantities, to middlemen or retailers but not to the final consumers of the goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wholesalers"@en .

aat:300025252 a skos:Concept ;
    skos:definition "Generally, those employed in the business of making a consumer product directly or indirectly available to consumers; includes everyone in the chain of production and distribution, such as the manufacturers, wholesalers, distributers, and retailers. Specifically in the construction business, those who provide materials, equipment, and prefabricated parts to contractors, subcontractors, or owners, but who usually do not do any installation or labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suppliers"@en .

aat:300025255 a skos:Concept ;
    skos:definition "Persons who fit together the component parts of an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assemblers"@en .

aat:300025256 a skos:Concept ;
    skos:definition "Persons who engage in carving or cutting a figure, design, or shape out of a solid material such as stone or wood. For persons who create create large or medium-sized three-dimensional works that are considered art, see \"sculptors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carvers"@en .

aat:300025257 a skos:Concept ;
    skos:definition "Persons who engage in the process of making casts or of shaping in a mold; usually refers to those who pour liquid material, such as metal or glass, into a mold, as distinguished from pressing a material into a mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casters"@en .

aat:300025258 a skos:Concept ;
    skos:definition "Those who engage in enameling or creates enamel works, including the application of a vitreous coating by fusion to metal, ceramic, glass, or other surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enamelers"@en .

aat:300025261 a skos:Concept ;
    skos:definition "Those who apply gold to surfaces in the form of leaf, powder, or other forms to approximate the effect of solid or inlaid gold, especially as an occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilders"@en .

aat:300025262 a skos:Concept ;
    skos:definition "Craftsmen who gild the metal mounts on furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciseleur-doreurs"@en .

aat:300025268 a skos:Concept ;
    skos:definition "Persons who sharpen tools by grinding them, or who grinds metal, glass, or stone to shape or smooth it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grinders"@en .

aat:300025269 a skos:Concept ;
    skos:definition "Artists and craftsmen who insert small pieces of one material into a larger piece of another so as to create a design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inlayers"@en .

aat:300025270 a skos:Concept ;
    skos:definition "Craftsmen who coat the surface of something, such as a piece of furnishing or small object, with lacquer, often creating designs or pictures with it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacquerers"@en .

aat:300025271 a skos:Concept ;
    skos:definition "Persons who fabricate, assemble, or repair machinery; also craftsmen skilled in the use of machine tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machinists"@en .

aat:300025272 a skos:Concept ;
    skos:definition "Persons skilled in the construction, operation, or repair of machines or vehicles run by machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanics"@en .

aat:300025273 a skos:Concept ;
    skos:definition "Persons who own or operate flour mills and grind grain into flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millers"@en .

aat:300025274 a skos:Concept ;
    skos:definition "Persons who erect shafting, move machinery, or care for the mechanical equipment in a workshop, mill, or plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millwrights"@en .

aat:300025275 a skos:Concept ;
    skos:definition "Those whose occupation is to excavate the ground, particularly those who construct underground passages to extract minerals from the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miners"@en .

aat:300025276 a skos:Concept ;
    skos:definition "Craftsmen or artists who decorate surfaces with patterns or pictures composed of small, regularly-shaped pieces of colored durable material, such as stone or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosaicists"@en .

aat:300025278 a skos:Concept ;
    skos:definition "A person who engages in the setting of rivets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riveters"@en .

aat:300025279 a skos:Concept ;
    skos:definition "Carpenters or metalworkers who line out the details of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setters-out"@en .

aat:300025280 a skos:Concept ;
    skos:definition "Those whose occupation is to make and apply thin sheets of decorative material, usually wood, but also occasionally ivory, tortoiseshell or brass, used to cover the surface of furniture or another object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneerers"@en .

aat:300025282 a skos:Concept ;
    skos:definition "Those who make bricks as their trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brickmakers"@en .

aat:300025285 a skos:Concept ;
    skos:definition "People or corporate bodies who make objects of glass, which is an inorganic substance made by fusing silica (silicon dioxide) with a basic oxide, generally transparent but often translucent or opaque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassmakers"@en .

aat:300025286 a skos:Concept ;
    skos:definition "Glassworkers whose work is cutting and setting glass; examples are those who cut and set window panes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glaziers"@en .

aat:300025287 a skos:Concept ;
    skos:definition "People who carve, engrave, or otherwise decorate or create objects made from horn, which is material derived from outgrowths of compacted skin or hair on the heads of animals, often from cows. Examples include combs, cups, spoons, handles, and adornments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horn workers"@en .

aat:300025288 a skos:Concept ;
    skos:definition "People who make leather or articles from leather, or who decorate leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworkers"@en .

aat:300025290 a skos:Concept ;
    skos:definition "Persons who dress and color leather after it has been tanned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curriers"@en .

aat:300025291 a skos:Concept ;
    skos:definition "Persons that finish leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressers"@en .

aat:300025292 a skos:Concept ;
    skos:definition "Persons who remove animal hair, especially wool, from hides in preparation for leathermaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fellmongers"@en .

aat:300025293 a skos:Concept ;
    skos:definition "People who make or sell gloves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glovers"@en .

aat:300025294 a skos:Concept ;
    skos:definition "Craftsmen who make and sometimes also design shoes, boots, and other footwear, as well as repair or refinish them. For those whose primary work is to repair or refinish footwear, and sometimes also other items such as handbags, luggage, and belts see \"cobblers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoemakers"@en .

aat:300025296 a skos:Concept ;
    skos:definition "Those who treat hides or skins with tannins to produce leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanners"@en .

aat:300025301 a skos:Concept ;
    skos:definition "Metalworkers who apply a protective or decorative coating of one metal to another by means of an electrolytic bath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroplaters"@en .

aat:300025303 a skos:Concept ;
    skos:definition "Workers who melt and pour materials, such as ore, metal, or glass, into a mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "founders"@en .

aat:300025304 a skos:Concept ;
    skos:definition "Persons who install and repair furnaces in foundries or who tend them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnacemen"@en .

aat:300025311 a skos:Concept ;
    skos:definition "Metalworkers who join two pieces of metal by softening or melting both surfaces to be joined by the application of heat, with or without inserting filler metal and with or without the application of pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "welders"@en .

aat:300025313 a skos:Concept ;
    skos:definition "Ironsmiths who make iron into tools, horseshoes, machine parts, and other objects by heating it in a forge and hammering it into shape on an anvil. Includes those who fit and nail horseshoes to horses' hooves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blacksmiths"@en .

aat:300025314 a skos:Concept ;
    skos:definition "Persons who shoe horses or make horseshoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farriers"@en .

aat:300025315 a skos:Concept ;
    skos:definition "Metalworkers who work in brass. For metalworkers who work primarily in bronze, prefer \"bronze casters\" or \"bronzeworkers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braziers"@en .

aat:300025319 a skos:Concept ;
    skos:definition "Metalworkers who specialize in making objects out of gold, especially jewelry and tableware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldsmiths"@en .

aat:300025320 a skos:Concept ;
    skos:definition "Metalworkers who specialize in making objects out of iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironsmiths"@en .

aat:300025322 a skos:Concept ;
    skos:definition "Metalworkers who specialize in working with pewter, which is an alloy of tin and lead, antimony, and copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pewterers"@en .

aat:300025323 a skos:Concept ;
    skos:definition "Metalworkers who specialize in working with silver, especially in the making of jewelry, flatware, and tableware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silversmiths"@en .

aat:300025324 a skos:Concept ;
    skos:definition "Metalworkers who specialize in working with tin, particularly in the production of tin utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinsmiths"@en .

aat:300025327 a skos:Concept ;
    skos:definition "Metalworkers who make armor or arms, or that repair, assemble, and test firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armorers"@en .

aat:300025331 a skos:Concept ;
    skos:definition "Founders, casters, or makers of bells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell founders"@en .

aat:300025335 a skos:Concept ;
    skos:definition "Those whose occupation is to design, make, or repair hand arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunsmiths"@en .

aat:300025336 a skos:Concept ;
    skos:definition "Those whose occupation is to make, repair, or fit locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locksmiths"@en .

aat:300025337 a skos:Concept ;
    skos:definition "Designers, engravers, or makers of medals and coins. For workers or craftsmen who press coins in a mint, typically with no input into the design, use \"minters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medalists"@en .

aat:300025338 a skos:Concept ;
    skos:definition "Those who fabricate nails, primarily as an profession or trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail makers"@en .

aat:300025342 a skos:Concept ;
    skos:definition "Craftsmen who make swords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swordsmiths"@en .

aat:300025343 a skos:Concept ;
    skos:definition "Those whose occupation is to mend household items such as pots or utensils, and normally have no fixed shop, but travel door to door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinkers"@en .

aat:300025344 a skos:Concept ;
    skos:definition "Those whose occupation or trade is to fabricate thin matted or felted sheets or webs of fiber formed and dried on a fine screen from a pulpy water suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papermakers"@en .

aat:300025345 a skos:Concept ;
    skos:definition "Those who make decorative paper, such as wallpaper, printed from wood blocks and colored by hand. This was a profession, for example, in 15th-century France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dominotiers"@en .

aat:300025346 a skos:Concept ;
    skos:definition "People who make marbled paper. Examples were those who created marbled wallpaper, as was popular in 15th-century France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbreurs"@en .

aat:300025349 a skos:Concept ;
    skos:definition "Generally, craftspeople or industrial workers engaged in any or all of the processes involved in textile manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile workers"@en .

aat:300025351 a skos:Concept ;
    skos:definition "Textile workers who apply a coloring matter that is in a solution or fine dispersion so that at least some of the coloring matter is taken up by the textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dyers"@en .

aat:300025352 a skos:Concept ;
    skos:definition "Refers to people who make embroidery, which is needlework in which decorative designs are stiched into cloth, leather, or paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroiderers"@en .

aat:300025353 a skos:Concept ;
    skos:definition "Persons who buy and sell furs or fur products; also persons who make, repair, alter, or clean fur garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furriers"@en .

aat:300025354 a skos:Concept ;
    skos:definition "Persons who make, sell, clean, and repair hats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatters"@en .

aat:300025356 a skos:Concept ;
    skos:definition "Refers to people, often women, who make articles of female apparel, particularly hats or other headgear. In older usage, the term may refer to vendors of apparel and luxury items, including hats, ribbons, gloves, and cutlery; the term originally referred to the city of Milan, Italy, which was the source of fine headgear known as \"Milan bonnets\" and other luxury items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milliners"@en .

aat:300025357 a skos:Concept ;
    skos:definition "People who knit, which is the creation of handmade works or material created by interlacing loops of a long or continuous piece of yarn or thread by means of two needles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitters"@en .

aat:300025358 a skos:Concept ;
    skos:definition "Refers to people who make lace, which is fine, openwork textile with a ground of mesh or net on which patterns are worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace makers"@en .

aat:300025361 a skos:Concept ;
    skos:definition "A person who engages in the act of sewing textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewers"@en .

aat:300025363 a skos:Concept ;
    skos:definition "People who perform the process of making fibers or filaments into yarn or thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinners"@en .

aat:300025364 a skos:Concept ;
    skos:definition "Those whose occupation is to create, co-ordinate, or promote the fashions or designs for a firm's commodities, usually in the context of the retail clothing industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylists"@en .

aat:300025365 a skos:Concept ;
    skos:definition "People who whose occupation is making and altering garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tailors"@en .

aat:300025366 a skos:Concept ;
    skos:definition "Artisans who make tapestries, which are heavy wall hangings or other textiles characterized by ornamental or pictorial designs and woven by a process that differs from cloth-weaving in that the weft travels only to the warp at the edge of a particular color or pattern in the design, rather than traveling from edge to edge of the entire piece of fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry weavers"@en .

aat:300025367 a skos:Concept ;
    skos:definition "People who do weaving, which is the process of interlacing strands or textile or another material to make materials or objects such as cloth, wicker, baskets, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weavers"@en .

aat:300025373 a skos:Concept ;
    skos:definition "Skilled French craftsmen of luxury furniture; also French cabinetmakers specializing in veneering furniture, originally with ebony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ébénistes"@en .

aat:300025375 a skos:Concept ;
    skos:definition "Persons who make or repair wooden vessels formed of staves and hoops, such as casks, buckets, tubs. Also shipboard artisans who repair casks and other containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coopers"@en .

aat:300025376 a skos:Concept ;
    skos:definition "Persons who join wood, especially in the construction of doors, window sashes, paneling, and other permanent woodwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joiners"@en .

aat:300025378 a skos:Concept ;
    skos:definition "French joiners of the 17th and 18th centuries who specialized in small objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menuisiers"@en .

aat:300025379 a skos:Concept ;
    skos:definition "People who specialize in smoothing or levelling a surface, particularly in a woodworking context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planers"@en .

aat:300025380 a skos:Concept ;
    skos:definition "Those whose occupation it is to saw timber into planks or lumber roughly prepared to sell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawyers"@en .

aat:300025381 a skos:Concept ;
    skos:definition "Craftsmen who shape objects by means of cutting tools while the piece of wood from which the objects are made rotates rapidly on a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turners"@en .

aat:300025382 a skos:Concept ;
    skos:definition "People who specialize in carving in the medium of wood, making objects or ornament in wood. For those who make woodcut blocks or prints from them, use \"woodcutters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodcarvers"@en .

aat:300025384 a skos:Concept ;
    skos:definition "Craftsmen who make vehicle wheels and wheeled vehicles by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheelwrights"@en .

aat:300025388 a skos:Concept ;
    skos:definition "Persons who engage in ceramic arts, manufacturing, or technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramicists"@en .

aat:300025389 a skos:Concept ;
    skos:definition "Refers to those who practice an occupation, trade, or pursuit requiring manual dexterity or artistic skill, typically excluding those who produce painting, sculpture, drawing, or architecture. Generally distinguished from \"artists\" and \"architects,\" based on the media of their creations. For a more general term for those who construct artifacts directly by their own labor, especially as their profession or primary occupation, use \"makers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craftspeople"@en .

aat:300025398 a skos:Concept ;
    skos:definition "Craftsmen who make or repair watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watchmakers"@en .

aat:300025401 a skos:Concept ;
    skos:definition "General term for all those engaged in the production, repair, and refurbishing of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture workers"@en .

aat:300025407 a skos:Concept ;
    skos:definition "Craftsmen who create or repair soft coverings for furniture, especially seating and reclining furniture. Originally referred to those who created all the textile components of a room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholsterers"@en .

aat:300025409 a skos:Concept ;
    skos:definition "People who make or deal in jewels or jewelery, may include the design, creation, and repair of jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelers"@en .

aat:300025410 a skos:Concept ;
    skos:definition "Experts in precious and semiprecious stones and in the art or techniques of lapidary, the art of cutting and polishing precious and semiprecious stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapidaries"@en .

aat:300025412 a skos:Concept ;
    skos:definition "Those who make, design, or repair stringed instruments of the lute, harp, viol, and violin families, such as guitars, frame harps, violas da gamba, and violins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luthiers"@en .

aat:300025414 a skos:Concept ;
    skos:definition "Makers of vessels, tableware, vases, and other ware out of ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potters"@en .

aat:300025415 a skos:Concept ;
    skos:definition "People who make seals, artifacts bearing monograms, writing, numbers, or designs in intaglio for making an impression in relief on some soft, tenacious substance such as clay or wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealmakers"@en .

aat:300025419 a skos:Concept ;
    skos:definition "Those whose occupation is to fabricate cordage formed by twisting or braiding natural or artificial fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rope-makers"@en .

aat:300025420 a skos:Concept ;
    skos:definition "People who make, repair, or sell saddles, bridges, and other eqipment for horses, particularly riding horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddlers"@en .

aat:300025424 a skos:Concept ;
    skos:definition "Persons employed in the construction of ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipbuilders"@en .

aat:300025427 a skos:Concept ;
    skos:definition "Those involved in planning, organizing, directing, and controlling human or material resources to accomplish specific goals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administrators"@en .

aat:300025430 a skos:Concept ;
    skos:definition "Refers to officials or members of an administration divided into separate areas of responsibility or bureaux. Perjoritively, refers to such officials who work inflexibly by routine, without exercising independent intelligence or judgment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaucrats"@en .

aat:300025431 a skos:Concept ;
    skos:definition "Refers to official heads of organizations such as schools, institutions, or government bureaus, or those named to control a business. Distinct from \"managers,\" who control a portion or project within an institution or business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "directors"@en .

aat:300025432 a skos:Concept ;
    skos:definition "Persons who hold a high position of administrative or managerial responsibility in a private business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executives"@en .

aat:300025435 a skos:Concept ;
    skos:definition "Persons in control of a division, project, or phase of an institution or business. Distinct from \"directors (administrators),\" which denotes official heads of entire organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "managers"@en .

aat:300025436 a skos:Concept ;
    skos:definition "Those executives having the oversight and charge of an institution, department, place, or operation, generally having the chief governing power there, when used as the official job title for those holding such responsibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superintendents"@en .

aat:300025437 a skos:Concept ;
    skos:definition "Those who oversee a business, institution, or department, and who direct tasks or activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supervisors"@en .

aat:300025438 a skos:Concept ;
    skos:definition "Specially trained workers who work with and commonly lead a crew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foremen"@en .

aat:300025441 a skos:Concept ;
    skos:definition "On-site clerical workers who keep records of the workers on a building project, deliveries made, and progress of the job; they make reports, receive and catalog samples, and keep a log of job activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clerks of the works"@en .

aat:300025444 a skos:Concept ;
    skos:definition "Refers generally to those who plan, operate, and supervise government agencies, programs, and functions, as well as determine and implement public policy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public administrators"@en .

aat:300025445 a skos:Concept ;
    skos:definition "Refers to rulers or leaders of clans, tribes, or other groups. The term typically carries the connotation of rulers who are also military leaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chieftains"@en .

aat:300025446 a skos:Concept ;
    skos:definition "Government officials in charge of a department or bureau of the public service. The term may also refer to government representatives in a district, province, or other unit, often having both administrative and judicial duties and powers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissioners"@en .

aat:300025449 a skos:Concept ;
    skos:definition "Persons who frequent or are members of the retinue of a sovereign or high dignitary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtiers"@en .

aat:300025450 a skos:Concept ;
    skos:definition "Those enrolled in the military service of a government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military personnel"@en .

aat:300025454 a skos:Concept ;
    skos:definition "People who are legally empowered to witness and certify documents and to take affidavits and depostions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notaries"@en .

aat:300025457 a skos:Concept ;
    skos:definition "People holding posts to which they have been legally elected or appointed and exercising government functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public officers"@en .

aat:300025461 a skos:Concept ;
    skos:definition "In modern contexts, refers to officers having this title and appointed by or with the authority of a government to reside in a foreign country in order to represent the interests of citizens of the appointing country. Also refers to the chief magistrates of Republican Rome and of the First French Republic, 1799-1804, who bore this title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consuls"@en .

aat:300025462 a skos:Concept ;
    skos:definition "People employed by a national government or ruler to conduct official negotiations and maintain political, economic, and social relations with other nations or international organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diplomats"@en .

aat:300025463 a skos:Concept ;
    skos:definition "Rulers and chief magistrates of the former republics of Venice and Genoa, Italy. The term is also sometimes used in a more general sense to designate any chief magistrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doges"@en .

aat:300025465 a skos:Concept ;
    skos:definition "Refers to officers, appointed or elected, in various administrative bodies, that hold the chief governing authority. In the United States, refers to the executive heads of each of the states. In the British Commonwealth, refers to the representative of the Crown in a member nation or dependency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governors"@en .

aat:300025466 a skos:Concept ;
    skos:definition "Refers to people who enact or create laws, especially members of legislative bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legislators"@en .

aat:300025467 a skos:Concept ;
    skos:definition "Civil officers charged with the administration of laws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magistrates"@en .

aat:300025468 a skos:Concept ;
    skos:definition "Chief magistrates of a city or borough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mayors"@en .

aat:300025469 a skos:Concept ;
    skos:definition "Legislators elected to represent constituencies within the provinces or major subdivisions of their country in its primary governing body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "members of Parliament"@en .

aat:300025470 a skos:Concept ;
    skos:definition "Appointed or elected heads of groups, states, or organizations. Included are elected officials serving as both chief of state and chief political executive in a republic having a presidential government. Also included are the heads of organizations such as banks, clubs, and corporations when used as the official job title for those positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presidents"@en .

aat:300025471 a skos:Concept ;
    skos:definition "Refers to imperial officers of the ancient Roman empire entrusted with the management of the financial affairs of a province as agents of the emperor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "procurators"@en .

aat:300025472 a skos:Concept ;
    skos:definition "Refers to rulers of a country or province who act as the representative of their sovereign or king and who are empowered to act in the sovereign's name. They often rule on frontiers or in provinces distant from the seat of power of the state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viceroys"@en .

aat:300025474 a skos:Concept ;
    skos:definition "Refers to people who are actively involved in politics, particularly party politics, or, more specifically, to people who hold or seek political office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "politicians"@en .

aat:300025475 a skos:Concept ;
    skos:definition "Refers to people who rule or govern, specifically sovereigns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rulers"@en .

aat:300025480 a skos:Concept ;
    skos:definition "Sovereigns or supreme monarchs of an empire, which is a political unit that comprises a number of territories or nations and is ruled by a single supreme authority. The use of the term is often restricted to reference to such supreme authorities in only certain parts of the world, including the ancient Roman empire, the Early Christian Roman empire, and the empires of Austria-Hungary, China, Japan, Morocco, India, Asia Minor, and Germany. The rulers of conglomerate political states in other parts of the world are generally known by other titles. The term \"emperors\" always refers to males, while \"empresses\" refers to female rulers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emperors"@en .

aat:300025481 a skos:Concept ;
    skos:definition "Monarchs who reign over a kingdom, which is a major territorial unit or government ruled by a single person. The term may also refer to rulers of smaller entities and may include tribal rulers or rulers of petty states who are by tradition called \"king.\" If kings rule over a territory that is contained within an empire, kings are typically subordinate to the emperor. Kings are always male; female rulers of kingdoms are called \"queens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kings"@en .

aat:300025482 a skos:Concept ;
    skos:definition "Refers to a chief authority or ruler. It often refers particularly to certain male members of royal families, usually the sons or grandsons of kings or queens. The term may also be used to designate lower-ranking nobles. Princes are always males; for female rulers or daughters of kings and queens, see \"princesses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "princes"@en .

aat:300025483 a skos:Concept ;
    skos:definition "Refers to female monarchs and rulers of kingdoms, which are major territorial units or governments ruled by a single person. Queens may also be the wives or widows of kings. For male monarchs who rule a kingdom, use \"kings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queens"@en .

aat:300025484 a skos:Concept ;
    skos:definition "People who are experienced in the art of government or versed in the administration of government affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statesmen"@en .

aat:300025486 a skos:Concept ;
    skos:definition "Those who study human history through the remnants of material culture, environment, and animal remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeologists"@en .

aat:300025489 a skos:Concept ;
    skos:definition "Those engaged in the study and interpretation of ancient inscriptions, including writing, pictures, and random scratchings, incised on stone, clay, metal, or other hard surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epigraphers"@en .

aat:300025490 a skos:Concept ;
    skos:definition "Archaeologists who specialize in studying the sites, structures, and artifacts of the industries and processes of industrialization of former times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial archaeologists"@en .

aat:300025492 a skos:Concept ;
    skos:definition "Persons responsible for the intellectual content of books or other writings, namely those who write or otherwise compose books, articles, poems, plays, or other works which involve literary composition. The works are often, but not always, intended for publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authors"@en .

aat:300025494 a skos:Concept ;
    skos:definition "Authors who write accounts of the lives of individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biographers"@en .

aat:300025495 a skos:Concept ;
    skos:definition "Authors who write biographies of saints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hagiographers"@en .

aat:300025496 a skos:Concept ;
    skos:definition "Authors who write or compile detailed and continuous registers of events in order of time; especially those in which the facts are narrated without philosophic treatment, or any attempt at literary style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chroniclers"@en .

aat:300025497 a skos:Concept ;
    skos:definition "Persons who keep books containing the daily, personal accounts of their own experiences, attitudes, and observations. Usually they write for their own personal reasons, occasionally for publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diarists"@en .

aat:300025499 a skos:Concept ;
    skos:definition "Writers of short literary compositions on single subjects, often presenting the personal view of the author."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "essayists"@en .

aat:300025500 a skos:Concept ;
    skos:definition "Writers of fictitious narratives usually with animals or inanimate objects as protagonists, intended to convey a hidden meaning regarding human conduct., and often a moral lesson."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabulists"@en .

aat:300025501 a skos:Concept ;
    skos:definition "People whose profession is to collect, write, or edit the subject matter of a news medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "journalists"@en .

aat:300025502 a skos:Concept ;
    skos:definition "Persons that broadcast radio or television programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadcasters"@en .

aat:300025503 a skos:Concept ;
    skos:definition "Persons who introduce television or radio programs, often act as masters of ceremonies, make commercial announcements, and read brief items such as news summaries and sports reviews."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "announcers"@en .

aat:300025504 a skos:Concept ;
    skos:definition "Those who read out the news on television and radio newscasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newscasters"@en .

aat:300025505 a skos:Concept ;
    skos:definition "Journalists who analyze news and write columns or commentary based on personal knowledge and experience for publication or broadcast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columnists"@en .

aat:300025506 a skos:Concept ;
    skos:definition "Persons who write comments on topics of reader interest to stimulate or mold public opinion, usually in accordance with the viewpoints and policies of the publication they work for."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "editorial writers"@en .

aat:300025508 a skos:Concept ;
    skos:definition "People who observe and bring back an account of a news event or situation, usually also writing or narrating the account for broadcast, newspapers, journals, radio, television, or online."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reporters"@en .

aat:300025510 a skos:Concept ;
    skos:definition "Correspondents who report from abroad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foreign correspondents"@en .

aat:300025511 a skos:Concept ;
    skos:definition "Persons who write original plays, such as tragedies, comedies, or dramas, or adapt themes from fictional, historical, or narrative sources, for dramatic presentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playwrights"@en .

aat:300025513 a skos:Concept ;
    skos:definition "Authors ol compositions characterized by condensed language chosen for sound and suggestive power as well as meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poets"@en .

aat:300025514 a skos:Concept ;
    skos:definition "Those who write or compose satires for publication or performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satirists"@en .

aat:300025515 a skos:Concept ;
    skos:definition "Authors of scripts and screenplays for motion picture production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen writers"@en .

aat:300025517 a skos:Concept ;
    skos:definition "Scholars of the ancient classical period or adherents of classicism in art or literature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classicists"@en .

aat:300025519 a skos:Concept ;
    skos:definition "Persons who write or give orally critical reviews of literary, musical, or artistic works and performances for broadcast or publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "critics"@en .

aat:300025520 a skos:Concept ;
    skos:definition "People who report on, write about, analyze, or evaluate architecture, usually contemporary works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural critics"@en .

aat:300025522 a skos:Concept ;
    skos:definition "People who report on, write about, describe, interpret, or evaluate literary works, usually contemporary works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary critics"@en .

aat:300025523 a skos:Concept ;
    skos:definition "People who specialize in writing in code, or are otherwise engaged in the analysis and decoding of ciphers or codes, or in the creation of them. For people who study code as a discipline, and who may also write or decipher codes, use \"cryptologists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryptographers"@en .

aat:300025524 a skos:Concept ;
    skos:definition "Scientists trained and working in the field dealing with communication processes and automatic control systems in both living organisms and machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyberneticians"@en .

aat:300025526 a skos:Concept ;
    skos:definition "People who assemble, revise, correct, or arrange the contents or style of literary, artistic, or musical work or data for publication or presentation, particularly when the work was compiled largely by others. Includes those who edit electronic documents and records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "editors"@en .

aat:300025527 a skos:Concept ;
    skos:definition "Those who are responsible for the education of other people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educators"@en .

aat:300025528 a skos:Concept ;
    skos:definition "Persons who head one of the divisions, faculties, colleges, or schools of a university."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deans"@en .

aat:300025529 a skos:Concept ;
    skos:definition "Those whose job or function is to impart or convey the knowledge, or to give instruction or lessons in a subject, especially in a school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teachers"@en .

aat:300025533 a skos:Concept ;
    skos:definition "People who are members of the faculty at a college, university, or other institutions of post-secondary education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professors"@en .

aat:300025534 a skos:Concept ;
    skos:definition "Generally refers to teachers who give instruction to students outside of a regular classroom setting. Includes private tutors hired specifically to help students prepare for examinations. In some American colleges and universities, teachers ranking below professors, usually hired for a year or a few years. In British and Irish universities, graduate students or members of the teaching staff assigned to supervise an undergraduate student."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tutors"@en .

aat:300025537 a skos:Concept ;
    skos:definition "Those who study or practice in the field of grammar, the study of the rules of a language governing the sounds, words, sentences, and other elements, including their structure, combination, and interpretation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grammarians"@en .

aat:300025538 a skos:Concept ;
    skos:definition "People who study handwriting, especially for the purpose of character analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphologists"@en .

aat:300025539 a skos:Concept ;
    skos:definition "Those trained or working in the field that studies the chronological record of events, such as affecting a nation, community, individual, object, or place, based on a critical examination of source materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historians"@en .

aat:300025540 a skos:Concept ;
    skos:definition "Those who study the development over time of the human built environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural historians"@en .

aat:300025541 a skos:Concept ;
    skos:definition "Those who specialize in art history, which is the study of historical development of art in various cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art historians"@en .

aat:300025542 a skos:Concept ;
    skos:definition "Those who study the history of Christian Churches and their sects and branches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church historians"@en .

aat:300025543 a skos:Concept ;
    skos:definition "Those who make historical sense of the natural sciences by employing textual, ethnographic, and social scientific methods to investigate how the sciences work in practice, and how they relate to larger intellectual, cultural, social, and political trends and changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historians of science"@en .

aat:300025544 a skos:Concept ;
    skos:definition "Persons who engage in the study and writing of history based on the critical examination of sources, the selection of particulars from authentic material, and the synthesis of particulars into narratives that will stand the test of critical methods. Also, persons officially appointed to write a history or to record the continuing history of a country, group, or institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historiographers"@en .

aat:300025545 a skos:Concept ;
    skos:definition "Those who study literary trends and movements over time, as well as the development of various branches or genres of literature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary historians"@en .

aat:300025547 a skos:Concept ;
    skos:definition "Those who study the comparative history of the nature and structure of the world's religions and their diverse manifestations over time in different societies and cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious historians"@en .

aat:300025550 a skos:Concept ;
    skos:definition "Persons who engage in the study and activities concerning the nature, collection, dissemination, and retrieval of data and information, especially in automated environments, or who design information systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information scientists"@en .

aat:300025552 a skos:Concept ;
    skos:definition "Compilers of bibliographies, which are lists of books, periodical articles, and audiovisual materials on specialized subjects, annotate bibliographies with physical descriptors, and analyze subject content of materials. Also, scholars of books as physical objects and those who advise on the acquisition of materials in special subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliographers"@en .

aat:300025553 a skos:Concept ;
    skos:definition "Those whose occupation is to compile alphabetical lists of terms denoting names or subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexers"@en .

aat:300025554 a skos:Concept ;
    skos:definition "Persons who research information about words that make up language and write and review definitions for publication in a dictionary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lexicographers"@en .

aat:300025555 a skos:Concept ;
    skos:definition "Persons who administer libraries and perform related library services, including acquiring and processing library materials, and furnishing reference and other services to patrons. Also any other persons employed in a library with professional qualifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "librarians"@en .

aat:300025558 a skos:Concept ;
    skos:definition "Libraarians who manage and work with the circulation procedures and policies of a library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circulation librarians"@en .

aat:300025559 a skos:Concept ;
    skos:definition "Librarians who provide information services in governmental organizations and branches of government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government librarians"@en .

aat:300025560 a skos:Concept ;
    skos:definition "Librarians who work in contexts outside the traditional public, private, academic, and school libraries, including corporations, non-profit organizations, and governmental organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special librarians"@en .

aat:300025561 a skos:Concept ;
    skos:definition "Refers both to those specializing in the field of linguistics and to those who are fluent in several different languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linguists"@en .

aat:300025563 a skos:Concept ;
    skos:definition "Those who specialize in musicology, which is the study of the history and theory of music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musicologists"@en .

aat:300025564 a skos:Concept ;
    skos:definition "Persons who study music in a sociocultural context, especially that outside the European tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnomusicologists"@en .

aat:300025565 a skos:Concept ;
    skos:definition "Those who collect or study coins, tokens, medals, paper money, and objects closely resembling them in form or purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numismatists"@en .

aat:300025566 a skos:Concept ;
    skos:definition "Those who deliver speeches, are skilled in eloquence and rhetorical skill, or are proficient in public speaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orators"@en .

aat:300025567 a skos:Concept ;
    skos:definition "Those who collect or study postage stamps, revenue stamps, stamped envelopes, postmarks, post cards, covers, and similar materials relating to postal or fiscal history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philatelists"@en .

aat:300025568 a skos:Concept ;
    skos:definition "Experts in linguistics who study the structure and historical development of a language or languages, such as when doing close analysis of literary texts in the context of cultural and political research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philologists"@en .

aat:300025569 a skos:Concept ;
    skos:definition "Refers to those deeply versed in philosophy, especially those who create or develop views or theories on philosophical questions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philosophers"@en .

aat:300025570 a skos:Concept ;
    skos:definition "Those who study and write about perceptible beauty in art and nature, together with the intellectual and emotional responses to beauty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aestheticians"@en .

aat:300025571 a skos:Concept ;
    skos:definition "Those who work, study, or are skilled in that branch of philosophy concerned with the forms of thought and methods of correct statement in all areas of inquiry, especially with inference, deduction, induction, and scientific proof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logicians"@en .

aat:300025572 a skos:Concept ;
    skos:definition "Those who study the fundamental nature of reality, including such concepts as being, substance, essence, time, space, cause, and identity; refers especially to those who create or develop metaphysical theories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metaphysicians"@en .

aat:300025573 a skos:Concept ;
    skos:definition "Philosophers who study the description and classification of phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phenomenologists"@en .

aat:300025574 a skos:Concept ;
    skos:definition "People, firms, or corporate bodies responsible for placing a book or other work on the market for sale or distribution to the public. For those active before about 1800, see \"booksellers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publishers"@en .

aat:300025576 a skos:Concept ;
    skos:definition "Those who engage in research, which is systematic inquiry into a given subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "researchers"@en .

aat:300025578 a skos:Concept ;
    skos:definition "Those studying or practicing the art of using eloquence for persuasive effect in public speaking and writing. Refers more specifically to those who study the principles and rules of composition formulated by ancient critics and interpreted by classical scholars for application to discourse in the vernacular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhetoricians"@en .

aat:300025579 a skos:Concept ;
    skos:definition "Persons who have engaged in advanced study and acquired expertise in some special field along with accuracy and skill in investigation and powers of critical analysis in interpretation of such knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scholars"@en .

aat:300025580 a skos:Concept ;
    skos:definition "Persons who inscribe or copy texts, especially those who transcribed, copied, and edited manuscripts before mechanical printing technology was developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scribes"@en .

aat:300025583 a skos:Concept ;
    skos:definition "Those who engage in the scientific study of human history in its biological, linguistic, and social aspects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropologists"@en .

aat:300025584 a skos:Concept ;
    skos:definition "Anthropologists who study human cultures, especially with respect to social structure, language, law, politics, religion, magic, art, and technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social anthropologists"@en .

aat:300025585 a skos:Concept ;
    skos:definition "Those who engage in the scientific, historic, or comparative study of the origins, characteristics, and functions of human societies and cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnologists"@en .

aat:300025588 a skos:Concept ;
    skos:definition "Those who specialize in the comparative study of human physical evolution, variation, and classification, especially through measurement and observation of living people as well as human remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical anthropologists"@en .

aat:300025590 a skos:Concept ;
    skos:definition "Those who work in the statistical study of the characteristics of human populations, especially with reference to size and density, growth, distribution, migration, and vital statistics, and the effect of all these on social and economic conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demographers"@en .

aat:300025591 a skos:Concept ;
    skos:definition "Those who study or work in the field concerned with the production, distribution, and consumption of money, goods, and services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economists"@en .

aat:300025592 a skos:Concept ;
    skos:definition "Those trained or working in the social science dealing with the earth and its life, especially the description of land, sea, air, and the distribution of plant and animal life, including human beings, their activities and territorial organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geographers"@en .

aat:300025593 a skos:Concept ;
    skos:definition "Those who specialize in the science and art of calculating and representating the earth's surface or a part of it on a flat surface. For artists who make maps, use \"mapmakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartographers"@en .

aat:300025596 a skos:Concept ;
    skos:definition "Those who study the principles, institutions, and conduct of politics and government, including the political behavior of individuals and organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political scientists"@en .

aat:300025597 a skos:Concept ;
    skos:definition "Those who study or practice the science of human and animal mind and behavior, both healthy and unhealthy, with the focus on individuals in interaction with their environment. For those who deal with the treatment of mental, emotional, and behavioral disorders, use \"psychiatrists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychologists"@en .

aat:300025598 a skos:Concept ;
    skos:definition "Persons trained in applying occupational or physical measures in the treatment or rehabilitation of patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "therapists"@en .

aat:300025601 a skos:Concept ;
    skos:definition "Those who render text and speech from one language into another, following the original text as closely as possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "translators"@en .

aat:300025602 a skos:Concept ;
    skos:definition "Those who translate the communications of people speaking different languages; specifically those who do so orally while the people are present and conversing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interpreters"@en .

aat:300025604 a skos:Concept ;
    skos:definition "Persons trained in the theory or science of agriculture. Those engaged in the formal study, administration, or practice of the science of cultivating soil, harvesting crops, and raising livestock. For those who primarily work the land or raise livestock as a means of making a living, prefer \"farmers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agriculturists"@en .

aat:300025607 a skos:Concept ;
    skos:definition "Those who cultivate land or crops or raise livestock as their main occupation, whether for livlihood or for sustenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farmers"@en .

aat:300025608 a skos:Concept ;
    skos:definition "Those whose business or occupation is to catch fish or shellfish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishers"@en .

aat:300025609 a skos:Concept ;
    skos:definition "People who supervise the development, care, and management of forests or forest parks, including officers in charge of public forests and those who look after the growing of timber on an estate. For people who hunt, use \"hunters (people).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foresters"@en .

aat:300025610 a skos:Concept ;
    skos:definition "People who fell trees or cut timber into logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loggers"@en .

aat:300025611 a skos:Concept ;
    skos:definition "People who engage in or oversee the cutting, processing, and marketing of lumber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumberers"@en .

aat:300025614 a skos:Concept ;
    skos:definition "Those who practice the laying out or cultivating an area of plants, either professionally or as a hobby."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gardeners"@en .

aat:300025615 a skos:Concept ;
    skos:definition "Those who guard, tend, or keep domestic animals which go in herds, particularly cattle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herdsmen"@en .

aat:300025617 a skos:Concept ;
    skos:definition "Persons who guard, tend and herd flocks of sheep grazing at large."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shepherds"@en .

aat:300025619 a skos:Concept ;
    skos:definition "Those who kill animals as a main occupation for sustenance, livlihood, or sport, to obtain food, material, or trophies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunters"@en .

aat:300025621 a skos:Concept ;
    skos:definition "Those who trap or snare wild animals, usually for their fur, as an occupation or trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trappers"@en .

aat:300025622 a skos:Concept ;
    skos:definition "People who study, practice, or are otherwise active in the field of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people in law"@en .

aat:300025623 a skos:Concept ;
    skos:definition "People appointed as neutral parties to settle disputes, especially between labor and management. They are authorized to appraise the facts and arguments and to make decisions binding upon the disputants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arbitrators"@en .

aat:300025624 a skos:Concept ;
    skos:definition "Arbitrators who resolve disputes between labor and management in industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial arbitrators"@en .

aat:300025625 a skos:Concept ;
    skos:definition "Persons with authority to decide in a contest or competition or to arbitrate disputes, advise counsel, jury, litigants, or court personnel, and administer judicial systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judges"@en .

aat:300025626 a skos:Concept ;
    skos:definition "Members of a group of people selected and sworn to decide upon matters of fact and to declare the truth on the basis of the evidence presented before it in a court of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jurors"@en .

aat:300025627 a skos:Concept ;
    skos:definition "Generally, those who are learned in the law. Specifically, those who prosecute or defend causes in courts of record or other judicial tribunals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lawyers"@en .

aat:300025629 a skos:Concept ;
    skos:definition "Counsels admitted to plead cases in court and undertake the public trial of causes in the higher courts of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barristers"@en .

aat:300025630 a skos:Concept ;
    skos:definition "Generally, lawyers who do office work and can represent clients in some courts, but who by and large do not themselves represent their clients in court. Specifically, lawyers for city, town, or other governmental bodies or departments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solicitors"@en .

aat:300025633 a skos:Concept ;
    skos:definition "Persons who superintend or manage the collections, exhibitions, research activities, and personnel of a museum, art gallery, zoo, or other place of exhibit; also, the superintendents or managers of a single collection or subject of study in such an institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curators"@en .

aat:300025636 a skos:Concept ;
    skos:definition "American term used to refer to people, often volunteers working without pay, who conduct guided groups through a museum, art gallery, historical home, or other place. Also refers to teachers or lecturers in American universities who are not on the salaried staff, often post-graduate students."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "docents"@en .

aat:300025643 a skos:Concept ;
    skos:definition "People who prepare objects for exhibition in a museum, art gallery, or other exhibition space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preparators"@en .

aat:300025644 a skos:Concept ;
    skos:definition "Persons who create written records for the objects in a museum collection in order to identify the object and to record information about them such as provenance, condition, or value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registrars"@en .

aat:300025646 a skos:Concept ;
    skos:definition "Persons who contribute to the production of an animated cartoon or other animation, as by making drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animators"@en .

aat:300025647 a skos:Concept ;
    skos:definition "People who use cameras, particularly those who operate motion picture, video, or television cameras professionally. The term is used whether the person is male or female. For persons who oversee all the aspects of photography in a filmmaking, video, or television project, see \"cinematographers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera operators"@en .

aat:300025649 a skos:Concept ;
    skos:definition "Creators of dances and dance movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choreographers"@en .

aat:300025650 a skos:Concept ;
    skos:definition "Persons who oversee all the aspects of photography in a television, video, or filmmaking project, especially the lighting; they are particularly charged with achieving the photographic images and effects desired by the director. For operators of motion picture, video, or television cameras, use \"cameramen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinematographers"@en .

aat:300025651 a skos:Concept ;
    skos:definition "Persons who make, sell, or rent costumes, as for stage or fancy dress events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costumers"@en .

aat:300025653 a skos:Concept ;
    skos:definition "Those who engage in the activity of dancing or who practice the art of dance, especially as a profession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dancers"@en .

aat:300025654 a skos:Concept ;
    skos:definition "Artistic supervisors of productions in the performing arts, responsible for the work performed by the other artists and technicians, the conduct of rehearsals, and the general interpretation of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "directors"@en .

aat:300025658 a skos:Concept ;
    skos:definition "Persons who use movement, gesture, facial expressions, speaking, and intonation to create a fictional character for the stage, motion pictures, or television."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actors"@en .

aat:300025660 a skos:Concept ;
    skos:definition "Performers who play the comic fool, as in a circus, pantomime, or harlaquinade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clowns"@en .

aat:300025661 a skos:Concept ;
    skos:definition "Performers who amuse their audience by telling jokes or acting comically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comedians"@en .

aat:300025663 a skos:Concept ;
    skos:definition "People who perform as clowns, comedians, and musicians, especially at a court or in the service of a ruler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jesters"@en .

aat:300025666 a skos:Concept ;
    skos:definition "Those skilled or specializing in the art or practice of music, such as composers, conductors, and performers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musicians"@en .

aat:300025667 a skos:Concept ;
    skos:definition "Persons who transcribe music for voices or instruments for which it was not originally written, or adapt it to a style suitable to a particular performer or group of performers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrangers"@en .

aat:300025668 a skos:Concept ;
    skos:definition "Those who lead or conduct a band of musicians, often a brass or military band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandmasters"@en .

aat:300025671 a skos:Concept ;
    skos:definition "Those who create musical pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composers"@en .

aat:300025672 a skos:Concept ;
    skos:definition "Persons who conduct an orchestra, chorus, or other group of musical performers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conductors"@en .

aat:300025674 a skos:Concept ;
    skos:definition "Persons who compose text for opera, musical plays, or extended choral works, or who adapt text to accommodate the musical requirements of composers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "librettists"@en .

aat:300025675 a skos:Concept ;
    skos:definition "People who write words to be set to music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyricists"@en .

aat:300025678 a skos:Concept ;
    skos:definition "People who formulate works of performance art. For people in the traditional performing arts, use \"performing artists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performance artists"@en .

aat:300025681 a skos:Concept ;
    skos:definition "Designers of all visual aspects of a stage production, including scenery, properties, lighting, costume, and makeup. For artists who paint theatrical scenery, prefer \"theatrical painters.\" For those who design the visual aspects of a film or television production, use \"production designers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scenographers"@en .

aat:300025684 a skos:Concept ;
    skos:definition "People who perform vocal music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "singers"@en .

aat:300025687 a skos:Concept ;
    skos:definition "Individuals who specialize in creating photographs, which are still images produced from radiation-sensitive materials, typically by means of the chemical action of light on a sensitive film, paper, glass, or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographers"@en .

aat:300025695 a skos:Concept ;
    skos:definition "Those who photographically document news and significant events for publication in serial publications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photojournalists"@en .

aat:300025696 a skos:Concept ;
    skos:definition "Persons engaged in photography for scientific rather than artistic purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific photographers"@en .

aat:300025699 a skos:Concept ;
    skos:definition "Photographers who make single photographic images during the production of a motion picture. These images are meant to represent the action, actors, or making of the film, and are usually intended to be used for promotional purposes. Still photographers may have substantial control over the image, altering lighting and posing performers outside of the normal film production setups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "still photographers"@en .

aat:300025704 a skos:Concept ;
    skos:definition "People who bind books, which entails using various procedures, performed by hand or machine, to secure leaves or gatherings, usually within covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinders"@en .

aat:300025707 a skos:Concept ;
    skos:definition "Colorers who sprinkle reflective bronzing powder over paint or adhesive ink applied as an image to a substrate, either by hand or with a bronzing machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronzers"@en .

aat:300025708 a skos:Concept ;
    skos:definition "People who assemble, set, proof, and generally prepare type and illustrations for printing. For those engaged in the specific process of arranging type from copy for printing or making printing plates, whether by hand, by mechanical devices, or by inputting to computer, see \"typesetters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compositors"@en .

aat:300025714 a skos:Concept ;
    skos:definition "Persons who apply liquid to photographic negatives to cover blemishes, especially for making printing plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opaquers"@en .

aat:300025715 a skos:Concept ;
    skos:definition "Persons who engage in photoengraving, which is the production of relief prints for which an image is photographically transferred to a plate for printing in such a way that either the light or the dark areas become susceptible to attack by an etchant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoengravers"@en .

aat:300025726 a skos:Concept ;
    skos:definition "Those who engage in lithography: the photomechanical process that uses the same principle as lithography, the repulsion of oil and water, but uses a photographic process to transfer the image to the plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photolithographers"@en .

aat:300025731 a skos:Concept ;
    skos:definition "People who operate or manage a printing-press, particularly a hand-press printer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressmen"@en .

aat:300025732 a skos:Concept ;
    skos:definition "Refers to people in the commercial printing trade. For artists who make prints, see \"printmakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printers"@en .

aat:300025733 a skos:Concept ;
    skos:definition "Individuals designated to pull prints in an edition from blocks, engraved or etched plates, or type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impression printers"@en .

aat:300025734 a skos:Concept ;
    skos:definition "Persons who set type according to copy and operate a cylinder or automatic platen press to print complete job orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "job printers"@en .

aat:300025736 a skos:Concept ;
    skos:definition "Operators of photographic processing machines that produce a plan view from an aerial photograph taken at an oblique angle by correcting errors of perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectification printers"@en .

aat:300025743 a skos:Concept ;
    skos:definition "People who make printing plates by taking a mold of set type and making a cast in type metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereotypers"@en .

aat:300025744 a skos:Concept ;
    skos:definition "People engaged in the specific process of arranging type from copy for printing or making printing plates, whether by hand, by mechanical devices, or by inputting to computer. More generally, for the people who prepare copy, do casting off, arrange type, set spacing, and other tasks in the printing process, see \"compositors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typesetters"@en .

aat:300025745 a skos:Concept ;
    skos:definition "People skilled in the arrangement and use of type in creating printed matter, including the setting and arrangement of type to be printed from. The role of the typographer may also extend to designing typefaces themselves, but for those who design type exclusively, use \"type designers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typographers"@en .

aat:300025747 a skos:Concept ;
    skos:definition "Religious officials or functionaries prepared and authorized to conduct religious services or attend to other official religious duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clergy"@en .

aat:300025753 a skos:Concept ;
    skos:definition "Bishops of the highest rank, who preside over archdioceses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archbishops"@en .

aat:300025755 a skos:Concept ;
    skos:definition "High-ranking clergy in Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ayatollahs"@en .

aat:300025756 a skos:Concept ;
    skos:definition "Clergymen of the highest order in Christian churches, usually charged with an administrative function such as the supervision of a diocese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bishops"@en .

aat:300025757 a skos:Concept ;
    skos:definition "Clergy of a large Christian church living as a community under a rule; also Medieval clergymen belonging to the chapter or the staff of a cathedral or collegiate church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canons"@en .

aat:300025758 a skos:Concept ;
    skos:definition "Ecclesiastical officials of the Roman Catholic Church who constitute the Pope's council, or the Sacred College, and who retain the right of electing future popes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardinals"@en .

aat:300025759 a skos:Concept ;
    skos:definition "Refers to any Christian clergy officially attached to a household or institution. It includes, for example, the clergy for the house of a sovereign or lord, for a castle, ship, garrison, regiment, or any group in an army or navy, for a college, school, workhouse, prison, cemetery, legislative chamber, or other public institution. The term may also be used in its original sense, in which case it refers to the priest or other clergy assigned to or in charge of services in a chapel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaplains"@en .

aat:300025760 a skos:Concept ;
    skos:definition "Subordinate officers in a Christian church who assist priests or ministers in administrative, financial, and pastoral duties. In many churches, deaconesses are a separate order of parish assistants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deacons"@en .

aat:300025761 a skos:Concept ;
    skos:definition "Certain church officers or leaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elders"@en .

aat:300025762 a skos:Concept ;
    skos:definition "Those who preach or otherwise spread a religion or religious ideas, usually by speaking but may be in written works. Examples include the writers of the Christian gospels and modern Protestant occasional preachers having no fixed pastoral charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evangelists"@en .

aat:300025763 a skos:Concept ;
    skos:definition "Bishops or primates that oversee an ecclesiastical province, and the other bishops within it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metropolitans"@en .

aat:300025764 a skos:Concept ;
    skos:definition "Those who are sent on or engaged in religious work outside of their countries of origin. Missionary work is usually undertaken to convince others to join a religion or to assist impoverished or sick people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missionaries"@en .

aat:300025765 a skos:Concept ;
    skos:definition "Members of a religious brotherhood who are devoted to a discipline prescribed by their order. Monks take vows of poverty, chastity, and obedience. Performance of religious duties and contemplation are traditional priorities. Monks typically live apart from society in communal monasteries, but some live alone (hermits or anchorites). Monks are distinguished from \"friars\" in that for the monk retirement and solitude are undisturbed by public ministry, except in exceptional circumstances. Some of the more prominent orders of Christian monks include the Benedictines, Cluniacs, Cistercians, Trappists, Carthusians, the Premonstratensians, and Camaldolese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monks"@en .

aat:300025767 a skos:Concept ;
    skos:definition "Learned teachers of the religious law and doctrines of Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mullahs"@en .

aat:300025770 a skos:Concept ;
    skos:definition "Women belonging to religious orders devoted to religious service and meditation. Nuns typically take vows of poverty, chastity, and obedience and often live apart from society in convents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuns"@en .

aat:300025771 a skos:Concept ;
    skos:definition "Ordained, professional Christian clergy who conduct worship, administer the sacraments, preach, and assume responsibility for the pastoral care of a given congregation or parish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastors"@en .

aat:300025772 a skos:Concept ;
    skos:definition "Founding fathers or male heads of families, tribal lines, or entire social orders, classes, or peoples. Use also for the high-ranking prelates of that title in certain Christian churches, such as the Greek Orthodox, Russian Orthodox, and Coptic Churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patriarchs"@en .

aat:300025773 a skos:Concept ;
    skos:definition "People holding the rank of head of the Roman Catholic church and bishop of Rome. Also, the Orthodox patriarchs of Alexandria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popes"@en .

aat:300025774 a skos:Concept ;
    skos:definition "Refers specifically to those male clergy who perform sacrificial, ritualistic, mediatorial, interpretative, or ministerial functions. In modern usage, females may be called \"priests\" too."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "priests"@en .

aat:300025775 a skos:Concept ;
    skos:definition "Christian clergy whose defining official function is to hear the confessions of others, prescribes penance, and grants absolution. Prime examples are the private spiritual directors of a king or other great personage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confessors"@en .

aat:300025776 a skos:Concept ;
    skos:definition "Those who use the title of respect in use since the first century BCE given by the Jews to learned doctors and teachers of the law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbis"@en .

aat:300025777 a skos:Concept ;
    skos:definition "Clergymen having certain responsibilties, which varies by religious denomination: In the Protestant Episcopal Church, the clergy in pastoral charge of a parish. In the Roman Catholic Church, the clergy in pastoral charge of a college. In the Church of England, the clergy having pastoral charge of parsonages, with full possession of all rights and tithes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectors"@en .

aat:300025778 a skos:Concept ;
    skos:definition "Members of Muslim religious fraternities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dervishes"@en .

aat:300025779 a skos:Concept ;
    skos:definition "People in a religious faith who are not part of the clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laity"@en .

aat:300025781 a skos:Concept ;
    skos:definition "Followers of mysticism, such as beliefs in the existence of important realities beyond perceptual or intellectual understanding that are accessible by subjective experience, such as by intuition or meditation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mystics"@en .

aat:300025783 a skos:Concept ;
    skos:definition "Members of religious orders or communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious"@en .

aat:300025784 a skos:Concept ;
    skos:definition "Specialists in the study or science of theology, or religious doctrines and practices, generally from the viewpoint of religious believers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theologians"@en .

aat:300025786 a skos:Concept ;
    skos:definition "Scientists who specialize in the science of numbers, magnitudes, quantities expressed symbolically, and forms and figures, including their interrelationships and the operations performed on them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathematicians"@en .

aat:300025787 a skos:Concept ;
    skos:definition "Mathematicians who deal with the collection and arrangement of numerical facts or data,whether relating to human affairs or natural phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statisticians"@en .

aat:300025788 a skos:Concept ;
    skos:definition "People who are expert in one or more of the group of studies or branches of knowledge concerned with facts and phenomena of the observable or quantifiable world, and who employ the scientific method in their work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientists"@en .

aat:300025789 a skos:Concept ;
    skos:definition "Scientists who deal with the material universe beyond the earth's atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomers"@en .

aat:300025790 a skos:Concept ;
    skos:definition "Scientists trained or working in the study of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biologists"@en .

aat:300025791 a skos:Concept ;
    skos:definition "Scientists trained or working in the study of plant life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botanists"@en .

aat:300025792 a skos:Concept ;
    skos:definition "Scientists trained or working in the scientific study of animals, including their anatomy, physiology, biochemistry, genetics, ecology, evolution, and behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoologists"@en .

aat:300025793 a skos:Concept ;
    skos:definition "Scientists trained or working in the branch of physical science that deals with the composition and properties of the elementary substances of which all bodies are composed, the laws that regulate their combination, and the various phenomena that accompany their exposure to diverse physical conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemists"@en .

aat:300025794 a skos:Concept ;
    skos:definition "Chemists who analyze the value and quantity of metals in ores and alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assayers"@en .

aat:300025796 a skos:Concept ;
    skos:definition "Scientists trained or working in the science dealing with crystallization and the form, structure, and classification of crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystallographers"@en .

aat:300025797 a skos:Concept ;
    skos:definition "Scientists who study the relations and interactions between organisms and their habitat, including the other organisms that also live there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecologists"@en .

aat:300025798 a skos:Concept ;
    skos:definition "Zoologists specializing in the scientific study of insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entomologists"@en .

aat:300025799 a skos:Concept ;
    skos:definition "Those trained and working in the science that deals with the physical history of the earth, the rocks of which it is composed, and the physical changes which it has undergone and is undergoing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geologists"@en .

aat:300025800 a skos:Concept ;
    skos:definition "Geologists who deal with the land and submarine relief features of the earth's surface and seeks a generic interpretation of them using the principles of physical geography in its descriptive aspects and of structural geology in its explanatory phases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geomorphologists"@en .

aat:300025801 a skos:Concept ;
    skos:definition "Geologists who specialize in the study of minerals, including their formation, occurrence, properties, composition, and classification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineralogists"@en .

aat:300025804 a skos:Concept ;
    skos:definition "Those who study the origin, composition, distribution, and succession of strata or layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stratigraphers"@en .

aat:300025805 a skos:Concept ;
    skos:definition "Those who study seas, lakes, and other bodies of water, especially those who make hydrographic surveys or construct charts of the sea and its currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrographers"@en .

aat:300025806 a skos:Concept ;
    skos:definition "General term for those who engage in research in or practice with a degree of doctor in any of the medical sciences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medical scientists"@en .

aat:300025807 a skos:Concept ;
    skos:definition "Those who study the structure, function, and development of the cells, tissues, and organs constituting the animal body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anatomists"@en .

aat:300025808 a skos:Concept ;
    skos:definition "Those whose medical practice is focused on teeth and associated structures of the mouth, involving the prevention, diagnosis, and treatment of disease, injury, or malformation of the teeth, gums, and jaws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dentists"@en .

aat:300025809 a skos:Concept ;
    skos:definition "Practitioners of medicine with a doctorate in any of its branches, especially those licensed by the proper authorities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physicians"@en .

aat:300025810 a skos:Concept ;
    skos:definition "Those who perform manual or operative procedures to treat diseases, injuries, or deformities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surgeons"@en .

aat:300025811 a skos:Concept ;
    skos:definition "Physicians who specialize in the treatment of mental, emotional, and behavioral disorders, especially as originating in endogenous causes or as resulting from problematic interpersonal relationships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychiatrists"@en .

aat:300025813 a skos:Concept ;
    skos:definition "Those who study of the structure of metal and alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallurgists"@en .

aat:300025814 a skos:Concept ;
    skos:definition "Those who follow the study of atmosphere and all of its varied phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorologists"@en .

aat:300025815 a skos:Concept ;
    skos:definition "Specialists in weights and measures and in measuring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metrologists"@en .

aat:300025816 a skos:Concept ;
    skos:definition "Scientists trained in or working with the laws determining the structure of the observable universe and the interaction between its fundamental constituents, such as matter and energy, with the broad goal of explaining natural phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physicists"@en .

aat:300025817 a skos:Concept ;
    skos:definition "Scientists trained or working in the field dealing with the mechanics of animal function, from the level of the cell to that of the entire organism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physiologists"@en .

aat:300025819 a skos:Concept ;
    skos:definition "Those who write computer software or programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer programmers"@en .

aat:300025820 a skos:Concept ;
    skos:definition "Scientists who apply their knowledge to problems of conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation scientists"@en .

aat:300025821 a skos:Concept ;
    skos:definition "Those engaged in making changes to an object or structure so that it will closely approximate its state at a specific time in its history. When changes made are to prevent further deterioration, see \"preservationists.\" More generally, for those who undertake treatment, preventive care, and research directed toward long-term safekeeping of cultural and natural heritage, see \"conservators.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restorers"@en .

aat:300025822 a skos:Concept ;
    skos:definition "Those who analyze an organization's or business' activities in order to implement computer systems and software to meet their needs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "systems analysts"@en .

aat:300025823 a skos:Concept ;
    skos:definition "Practical specialists in the technical details of a subject or occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technicians"@en .

aat:300025826 a skos:Concept ;
    skos:definition "Those that advocate or engage in vigorous action, persuasion, or campaigning related to political or social causes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "activists"@en .

aat:300025827 a skos:Concept ;
    skos:definition "Dealers, collectors, experts, or students of antiquities or antique rare items, such as rare, out of print, and specialised books, prints, manuscripts, objets d'art, and related materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiquaries"@en .

aat:300025829 a skos:Concept ;
    skos:definition "Authorized people who estimate the market value, quality, usefulness, or performance of goods or real estate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appraisers"@en .

aat:300025833 a skos:Concept ;
    skos:definition "Persons who engage the professional advice or services of others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clients"@en .

aat:300025834 a skos:Concept ;
    skos:definition "Persons who advocate conservation of natural resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservationists"@en .

aat:300025835 a skos:Concept ;
    skos:definition "People called on for professional advice or services regarding matters in the field of their special knowledge or training, usually for specific projects or problems. For persons who give advice either professionally or nonprofessionally, usually on an ongoing basis, use \"advisors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consultants"@en .

aat:300025836 a skos:Concept ;
    skos:definition "Individuals who purchase, use, and dispose of goods and services, the ultimate clientele of manufacturers, wholesalers, retailers, and service providers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consumers"@en .

aat:300025837 a skos:Concept ;
    skos:definition "People who commit acts that are forbidden by, or who omit duties that are required by, public law and that make the offender liable to punishment by that law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "criminals"@en .

aat:300025838 a skos:Concept ;
    skos:definition "Criminals who make fraudulent copies of paper documents or coins. May also generally refer to criminals who imitate with intention to deceive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterfeiters"@en .

aat:300025839 a skos:Concept ;
    skos:definition "Criminals who make fraudulent fabrications with intent to deceive (of artwork, of documents, etc.). For people who copy with the intent of making a surrogate or other replica for study or another non-criminal reason, use \"copyists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forgers"@en .

aat:300025841 a skos:Concept ;
    skos:definition "Criminals who wrongfully take property with the intention of permanently depriving the rightful owner of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thieves"@en .

aat:300025843 a skos:Concept ;
    skos:definition "People who explore, usually by traveling, in search of scientific, geographical, or other types of information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "explorers"@en .

aat:300025844 a skos:Concept ;
    skos:definition "People who enter a country or region from another to settle there. For those who depart from their native or usual country or region to live elsewhere, use \"emigrants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immigrants"@en .

aat:300025845 a skos:Concept ;
    skos:definition "Persons who by creative imagination create a new device or process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inventors"@en .

aat:300025846 a skos:Concept ;
    skos:definition "Owners or holders of land or houses which are leased or rented to others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landlords"@en .

aat:300025847 a skos:Concept ;
    skos:definition "People who attempt to influence public officials to secure the passage of legislation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lobbyists"@en .

aat:300025848 a skos:Concept ;
    skos:definition "Generally refers to people who serve as objects for artists (especially painters and sculptors) to copy. May also refer to people employed in that profession, or people employed to display clothes or fashion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "models"@en .

aat:300025851 a skos:Concept ;
    skos:definition "People who travel on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestrians"@en .

aat:300025852 a skos:Concept ;
    skos:definition "The people employed by or active in a business, organization, or service; it is a collective term and never refers to an individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personnel"@en .

aat:300025854 a skos:Concept ;
    skos:definition "Those who practice philanthropy, or the benevolent donation of funds to good causes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philanthropists"@en .

aat:300025855 a skos:Concept ;
    skos:definition "Those engaged in making changes to an object or structure in order to prevent further deterioration. For those who make changes to an object or structure so as to closely approximate its state at a specific time in its past, see \"restorers.\" More generally, for those who undertake treatment, preventive care, and research directed toward long-term safekeeping of cultural and natural heritage, see \"conservators.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preservationists"@en .

aat:300025856 a skos:Concept ;
    skos:definition "People who reform practice, the state of things, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reformers"@en .

aat:300025862 a skos:Concept ;
    skos:definition "Refers to people employed by fire departments to fight fires, rescue persons, and perform other emergency-related duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firefighters"@en .

aat:300025864 a skos:Concept ;
    skos:definition "Persons of any gender who keep buildings, shops, or equipment in good repair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maintenance workers"@en .

aat:300025865 a skos:Concept ;
    skos:definition "People whose work involves transmitting messages and parcels or performing errands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "messengers"@en .

aat:300025866 a skos:Concept ;
    skos:definition "Those whose business or trade it is to pack goods and other objects for safe transportation and storage, such as museum objects or food items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packers"@en .

aat:300025867 a skos:Concept ;
    skos:definition "Members of a police force who are trained in methods of law enforcement and crime prevention and detection, and given authority to maintain the peace, safety, and order of the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police officers"@en .

aat:300025868 a skos:Concept ;
    skos:definition "Persons employed to carry baggage for patrons at a hotel or transportation terminal. For those stationed at a door or gate of a public or private building to admit or assist those entering or exiting, use \"doorkeepers.\" May also be used more generally as persons whose occupation is to carry loads; a carrier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porters"@en .

aat:300025869 a skos:Concept ;
    skos:definition "People of any gender whose occupation or business is making repairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repairpeople"@en .

aat:300025871 a skos:Concept ;
    skos:definition "Persons employed by an institution or organization to provide security."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "security guards"@en .

aat:300025874 a skos:Concept ;
    skos:definition "Generally in historical usage, for people who are privately employed to perform personal or household services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servants"@en .

aat:300025875 a skos:Concept ;
    skos:definition "People who consign or receive goods for transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shippers"@en .

aat:300025876 a skos:Concept ;
    skos:definition "People employed to keep watch or stand guard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watchmen"@en .

aat:300025877 a skos:Concept ;
    skos:definition "Persons who settle on land without a right, title, or payment of rent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squatters"@en .

aat:300025878 a skos:Concept ;
    skos:definition "Those who occupy or use land, buildings, or any other premises owned by another in consideration of some condition, typically the payment of rent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenants"@en .

aat:300025881 a skos:Concept ;
    skos:definition "Refers to persons, usually belonging to a group or board of persons, appointed to administer the affairs of an institution, company, or other body. Refers also to members of the controlling body of a trust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trustees"@en .

aat:300025882 a skos:Concept ;
    skos:definition "People who have visions, or have unknown things revealed to them in visions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visionaries"@en .

aat:300025883 a skos:Concept ;
    skos:definition "May refer generally to any person who visits a place that they do not normally inhabit. Specifically, an official that visits a place or operation at intervals for the purpose of inspection or supervision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visitors"@en .

aat:300025884 a skos:Concept ;
    skos:definition "Those who volunteer their efforts in a service or cause, or for a specific task."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volunteers"@en .

aat:300025886 a skos:Concept ;
    skos:definition "The people who perform labor in an economy. For the concept of the human activity that produces the goods or provides the services in demand in an economy, use \"labor.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workers"@en .

aat:300025887 a skos:Concept ;
    skos:definition "Wage earners performing manual work which usually calls for the wearing of work clothes or protective clothing on the job."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue collar workers"@en .

aat:300025891 a skos:Concept ;
    skos:definition "Refers to itinerant workers who move from place to place in search of work, especially agricultural work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "migrant workers"@en .

aat:300025892 a skos:Concept ;
    skos:definition "Workers possessing skills in a limited range of activities that demand less training, experience, and independent judgement than is required of skilled workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semiskilled workers"@en .

aat:300025895 a skos:Concept ;
    skos:definition "Workers whose duties consist primarily of nonmanual work which usually permits the wearing of street clothes, such as clerical, administrative, sales, professional, or technical work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white collar workers"@en .

aat:300025897 a skos:Concept ;
    skos:definition "Persons who engage in a particular pursuit, study, or science as a pastime rather than as a profession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amateurs"@en .

aat:300025898 a skos:Concept ;
    skos:definition "Persons who act as subordinates to another or as an official in a subordinate capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assistants"@en .

aat:300025902 a skos:Concept ;
    skos:definition "Students at any level in a professional field, such as medicine, who are getting practical professional experience under the supervision of experienced practitioners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interns"@en .

aat:300025903 a skos:Concept ;
    skos:definition "Artists or craftspeople who have completed apprenticeship but have not attained master status in a guild."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "journeypersons"@en .

aat:300025904 a skos:Concept ;
    skos:definition "Term used especially for artists or craftsmen qualified to teach apprentices and to carry on their trade independently; can be used broadly for persons eminently skilled in something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masters"@en .

aat:300025907 a skos:Concept ;
    skos:definition "Persons engaged in a particular pursuit, study, or science for gain or livelihood, rather than as amateurs; also persons belonging to the learned professions or any occupation requiring a great deal of training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professionals"@en .

aat:300025908 a skos:Concept ;
    skos:definition "People who devote themselves to a particular occupation, activity, or branch of knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specialists"@en .

aat:300025909 a skos:Concept ;
    skos:definition "People who are attending school, or otherwise engaged in study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "students"@en .

aat:300025910 a skos:Concept ;
    skos:definition "People undergoing training, especially for an occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trainees"@en .

aat:300025911 a skos:Concept ;
    skos:definition "Persons who learn by practical experience under skilled workers a trade or art, usually for a prescribed period of time and for a prescribed compensation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apprentices"@en .

aat:300025913 a skos:Concept ;
    skos:definition "People in the later stage of life, commonly considered as 65 years of age and older."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elderly"@en .

aat:300025921 a skos:Concept ;
    skos:definition "People who have a physical or mental impairment that substantially limits one or more major life activities, or who have a history or record of such an impairment, or those who are perceived by others as having such an impairment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people with disabilities"@en .

aat:300025924 a skos:Concept ;
    skos:definition "People with a cognitive or psychological condition that limits a major life activity in some way or requires special services. Mental disabilities can be caused by biological factors, environmental factors, substance abuse or brain trauma, that may result in an emotional, behavioral, or intellectual disadvantage that may hinder their ability to adapt to life activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people with mental disabilities"@en .

aat:300025925 a skos:Concept ;
    skos:definition "People having any of several conditions characterized by subnormal intellectual functioning and impaired adaptive behavior that are identified during the individual’s developmental years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intellectually disabled"@en .

aat:300025926 a skos:Concept ;
    skos:definition "People who have a physical impairment that substantially limits one or more major life activities, or who have a history or record of such an impairment, or those who are perceived by others as having such an impairment. Although ’handicapped’ is widely used in both law and everyday speech to refer to people having physical or disabilities those described by the word tend to prefer the expressions 'disabled' or 'people with disabilities.' The often-repeated recommendation to put the person before the disability would favor 'persons with physical disabilities' over ’physically disabled persons.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people with physical disabilities"@en .

aat:300025928 a skos:Concept ;
    skos:definition "Refers to male human beings from young adulthood through old age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "men"@en .

aat:300025929 a skos:Concept ;
    skos:definition "Smaller groups within a larger society that are the objects of prejudice or discrimination from the majority. For groups distinguished from the majority by their national, religious, linguistic, cultural,or sometimes racial background, use \"ethnic groups.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minorities"@en .

aat:300025930 a skos:Concept ;
    skos:definition "People who have children, either biologically or by adoption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parents"@en .

aat:300025931 a skos:Concept ;
    skos:definition "Men who have children, either biologically or by adoption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fathers"@en .

aat:300025932 a skos:Concept ;
    skos:definition "Women who have children, either biologically or by adoption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mothers"@en .

aat:300025933 a skos:Concept ;
    skos:definition "Persons involuntarily confined in prison or kept in custody. Use \"convicts\" for those serving a prison sentence following conviction for a criminal offense. Use \"inmates\" for those confined, voluntarily or involuntarily, to an institutional facility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prisoners"@en .

aat:300025934 a skos:Concept ;
    skos:definition "Persons given or kept as a pledge pending the fulfillment of an agreement, demand, or treaty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hostages"@en .

aat:300025935 a skos:Concept ;
    skos:definition "Persons who have fled their native country or usual country of residence to escape danger or persecution. For persons who have withdrawn voluntarily from their native country, especially those who have renounced allegiance to it, use \"expatriates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refugees"@en .

aat:300025939 a skos:Concept ;
    skos:definition "Social class, especially of Europe prior to the Industrial Revolution, comprised of persons that till the soil to support themselves. For individual members of this class, use \"peasants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peasantry"@en .

aat:300025942 a skos:Concept ;
    skos:definition "Upper class within the aristocracy, whose titles, property, and privileges are maintained and passed on by heredity. For individual members of the nobility use \"nobles (aristocrats).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nobility"@en .

aat:300025943 a skos:Concept ;
    skos:definition "Refers to female human beings from young adulthood through old age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "women"@en .

aat:300025944 a skos:Concept ;
    skos:definition "People below the age of full maturity, generally 17 years of age and younger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "youth"@en .

aat:300025945 a skos:Concept ;
    skos:definition "People in the earliest developmental stage of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children"@en .

aat:300025948 a skos:Concept ;
    skos:definition "Groups of people organized for a purpose, typically characterized by a more or less constant membership, a body of officers or functionaries, and a set of regulations governing their activities and conduct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organizations"@en .

aat:300025949 a skos:Concept ;
    skos:definition "Commercial organizations or certain administrative units of government that provide a service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agencies"@en .

aat:300025950 a skos:Concept ;
    skos:definition "Groups of people formally assembled to execute a purpose, advance a cause, or who share a common interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "associations"@en .

aat:300025952 a skos:Concept ;
    skos:definition "Groups of professionals assembled to execute a purpose, advance a cause, or who merely share common occupational interests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professional associations"@en .

aat:300025954 a skos:Concept ;
    skos:definition "Refers to organizational, regulatory, or representative bodies for particular trades or occupations. These may promote and develop commercial and industrial interests, or advocate for the views of members on matters of common interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade associations"@en .

aat:300025955 a skos:Concept ;
    skos:definition "Unincorporated groups of individuals associated together for purposes of mutual interest or common objectives, commonly but not exclusively commercial or financial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voluntary associations"@en .

aat:300025956 a skos:Concept ;
    skos:definition "Refers to groups of persons officially appointed or elected to direct or supervise some particular activity, often in the context of a public or private enterprise, institution, or other organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissions"@en .

aat:300025957 a skos:Concept ;
    skos:definition "Corporate bodies that collectively manage a company’s affairs. Decisions are made via majority vote, or delegation of authority to one or more members of the board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boards of directors"@en .

aat:300025959 a skos:Concept ;
    skos:definition "Organizations that regulate, promote, supervise, or protect commercial or business enterprises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boards of trade"@en .

aat:300025961 a skos:Concept ;
    skos:definition "Groups of individuals that have been appointed or elected to supervise the affairs of a private or public institution such as a university or art museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boards of trustees"@en .

aat:300025962 a skos:Concept ;
    skos:definition "Organizations established for ensuring health services to people within a geographical area or for a determined cultural group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health boards"@en .

aat:300025964 a skos:Concept ;
    skos:definition "Government bodies charged with the oversight of land or property use, defined by zoning codes, within distinct geographical or urban areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoning boards"@en .

aat:300025966 a skos:Concept ;
    skos:definition "Establishments specializing in commercial or mercantile activity involving the exchange of commodities, services, or financial resources, such as shops, offices, warehouses, and other commercial establishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "businesses"@en .

aat:300025969 a skos:Concept ;
    skos:definition "Groups of persons, commonly formed as business enterprises, considered in law as legal persons having an existence and rights and duties distinct from those of the individuals who form them. For unincorporated groups of persons contractually associated as joint principals in business, use \"partnerships.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporations"@en .

aat:300025971 a skos:Concept ;
    skos:definition "Partnerships of two or more persons who carry on business under a common name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firms"@en .

aat:300025975 a skos:Concept ;
    skos:definition "Private voluntary associations of persons for social and recreational purposes or for the promotion of some common object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clubs"@en .

aat:300025976 a skos:Concept ;
    skos:definition "Accumulated groups of objects or materials having a focal characteristic and that have been brought together by an individual or organization. A collection comprises multiple items that are conceptually or physically arranged together for the purpose of cataloging or retrieval. A collection differs from an archival group because the items in a collection are bound informally for convenience and do not necessarily share a common provenance or otherwise meet the criteria for an archival group. Collection-level cataloging is appropriate for materials that share one or more common characteristics that make it useful for them to be clustered together. Individual items in a collection may be cataloged separately and linked to the collection. Examples of collections include a selected set of art works in a museum or archive, or separate literary works that do not form a treatise or monograph on a subject but have been combined and issued together as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collections"@en .

aat:300025978 a skos:Concept ;
    skos:definition "Small chambers or studies in private homes housing collections of art works or biological or geological specimens, popular during the Italian Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studiolos"@en .

aat:300025979 a skos:Concept ;
    skos:definition "Accumulated groups of objects or materials having a focal characteristic and that have been brought together or are maintained by a corporate body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate collections"@en .

aat:300025980 a skos:Concept ;
    skos:definition "Groups of persons delegated to consider, investigate, or take action upon and usually to report concerning some matter or business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "committees"@en .

aat:300025982 a skos:Concept ;
    skos:definition "Governmental agencies having administrative, legislative, or judicial powers concerning the arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art commissions"@en .

aat:300025984 a skos:Concept ;
    skos:definition "Cooperative associations that make small loans to their members at low interest rates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credit unions"@en .

aat:300025985 a skos:Concept ;
    skos:definition "Organizations or institutions established by endowment or otherwise established with provision for future maintenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundations"@en .

aat:300025988 a skos:Concept ;
    skos:definition "Refers to sworn confraternities, brotherhoods, or associations formed for the mutual aid, protection of its members, or for the furtherance of professional interests. In the context of art and related disciplines, it refers to associations of artists, craftsmen, tradesmen, or merchants, which flourished in Europe between the 11th and 16th centuries and formed an important part of the economic and social fabric of this period. Most guilds were associated with a particular town or city. Guilds often monitored training, standards of production, and the welfare of their members. Guilds also provided significant patronage of the arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guilds"@en .

aat:300025995 a skos:Concept ;
    skos:definition "Groups of productive or profit-making enterprises or organizations that share a similar technological structure and that supply similar goods or services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industries"@en .

aat:300025998 a skos:Concept ;
    skos:definition "Manufacturing or other commercial activity or trade that is carried out partly or wholly in people's homes, rather than in a factory or communal workshop, Often carried on by a self-employed worker and their family, possibly with the aid of a few apprentices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottage industries"@en .

aat:300026002 a skos:Concept ;
    skos:definition "Organizations, societies, or regular meetings for the promotion of a particular literary, scientific, artistic, professional, or educational endeavor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "institutes"@en .

aat:300026004 a skos:Concept ;
    skos:definition "Formally structured organizations, establishments, or associations created for the promotion of a specific benevolent public or private objective, usually a religious, charitable, or educational objective, such as a church, school, college, hospital, asylum, reformatory, mission, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "institutions"@en .

aat:300026005 a skos:Concept ;
    skos:definition "Organizations engaged in the free assistance of the poor, the suffering, or the distressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charities"@en .

aat:300026007 a skos:Concept ;
    skos:definition "Formally structured organizations, establishments, or associations created for the promotion of a specific benevolent public objective, usually a charitable or educational objective, such as schools or colleges, hospitals, or museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public institutions"@en .

aat:300026008 a skos:Concept ;
    skos:definition "Interrelated systems or organizations that operate for the satisfaction of an important social need or function, such as family, economy, health, or education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social institutions"@en .

aat:300026009 a skos:Concept ;
    skos:definition "Associations or bodies of people united by common interests, purpose, or profession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "societies"@en .

aat:300026010 a skos:Concept ;
    skos:definition "Associations or bodies of people united by a common interest in the scientific study of the remains and monuments of the prehistoric period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological societies"@en .

aat:300026011 a skos:Concept ;
    skos:definition "Associations of professionals or amateurs united by a common interest in the study or preservation of built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural societies"@en .

aat:300026014 a skos:Concept ;
    skos:definition "Associations of people, usually men, joined for mutual help, support, protection, or action. For social fraternities, which are local or national organizations of male college students and which typically have names composed of two or three Greek letters, use \"fraternities\"; however, usage may overlap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brotherhoods"@en .

aat:300026015 a skos:Concept ;
    skos:definition "Organizations whose primary purpose is to advance social well-being and serve the public interest or common good."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charitable societies"@en .

aat:300026016 a skos:Concept ;
    skos:definition "Groups of people united for a religious, charitable, or other purpose, or in a profession or occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confraternities"@en .

aat:300026017 a skos:Concept ;
    skos:definition "Organizations whose pupose is the advancement of public education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational associations"@en .

aat:300026018 a skos:Concept ;
    skos:definition "Organizations who purpose is to advance the propagation and study of cultivated plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horticultural societies"@en .

aat:300026019 a skos:Concept ;
    skos:definition "Organization devoted to the advancement sciene itself, research, and experiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific societies"@en .

aat:300026020 a skos:Concept ;
    skos:definition "Any of various societies, the members of which are sworn to keep the rules, activities, and purposes secret from nonmembers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secret societies"@en .

aat:300026021 a skos:Concept ;
    skos:definition "Organizations dedicated to the advancement and study of technical disciplines, such as science and engineering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical societies"@en .

aat:300026022 a skos:Concept ;
    skos:definition "Groups convened to develop and promote standards for any particular technical field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standards organizations"@en .

aat:300026026 a skos:Concept ;
    skos:definition "It the context of visual and decorative arts, refers to groups of artists or craftsmen collaborating to produce works, usually under a master's name. The workshop typically included trained artists as well as a number of apprentices, who were learning a trade by practicing progressively more sophisticated tasks associated with the production of art works or decorative objects. Different people in the workshop generally performed different tasks associated with producing a work; for example, one person would apply the gilded background of a painting and another would paint the primary figures. The term is typically applied to groups active prior to the mid-17th century. The meaning of the term overlaps with \"studios (organizations),\" although there is often a subtle distinction in usage: \"Studios (organizations)\" typically refers to groups active in the 17th century and later, when the master artist or architect took on pupils rather than apprentices, and the emphasis of the pupil was on honing his native artistic skills rather than on learning a trade. \"Workshops (organizations)\" typically refers to earlier groups where the emphasis is on organized collaboration, smooth teamwork, a division of labor, and where apprentices are learning a trade rather than being trained as \"artists\" in the modern sense of the term. The phrases \"studio of\" or \"workshop of\" are often used to signify a work produced by persons in an artist's studio or workshop, but without the direct participation of the master's hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workshops"@en .

aat:300026030 a skos:Concept ;
    skos:definition "Physical or digital representations of a body of information designed with the capacity to communicate. In its broadest sense, \"documents\" include any item amenable to cataloging and indexing, that is, including nonprint media. For the activity of gathering and recording information, see \"documentation (function).\" For specfic types of documents, see concepts under \"document genres.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documents"@en .

aat:300026031 a skos:Concept ;
    skos:definition "Refers to the various types or classifications of documents, which are typically physical or digital representations of a body of information that is designed with the capacity to communicate. For the broad meaning of documents as a separate concept in itself, use \"documents.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "document genres"@en .

aat:300026032 a skos:Concept ;
    skos:definition "Brief summaries that provide the essential points of written works, such as the content of a publication or of a journal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abstracts"@en .

aat:300026037 a skos:Concept ;
    skos:definition "Collections of choice extracts, from the writings of one author, or various authors, and usually having a common characteristic such as subject matter or literary form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthologies"@en .

aat:300026049 a skos:Concept ;
    skos:definition "Literary genre of accounts of a person's life given by themselves. For examples of this genre, prefer \"autobiographies (literary genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autobiography"@en .

aat:300026061 a skos:Concept ;
    skos:definition "Complete, systematic, and critical listings of all the known works of a single artist, providing comprehensive information, including provenance, for each work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalogues raisonnés"@en .

aat:300026098 a skos:Concept ;
    skos:definition "Treatises or series of comments that systematically explain or annotate another work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commentaries"@en .

aat:300026100 a skos:Concept ;
    skos:definition "Notes added as comment or explanation, such as those accompanying an entry in a bibliography, reading list, or catalogue intended to describe, explain, or evaluate the publication referred to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annotations"@en .

aat:300026102 a skos:Concept ;
    skos:definition "Notes or symbols written or printed in the margins of pages. For scenes or figures in the margins or decorative borders of a page of text, use \"marginal illustrations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marginalia"@en .

aat:300026106 a skos:Concept ;
    skos:definition "Works containing in a smaller document the substance or general principles of larger works, often serving as a supplement to the larger work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compendiums"@en .

aat:300026114 a skos:Concept ;
    skos:definition "Authors' notes prefixed to works, offering them to friends or patrons as marks of esteem, affection, or gratitude, or as pleas for patronage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dedications"@en .

aat:300026121 a skos:Concept ;
    skos:definition "Books or treatises, containing rules or instructions needed to perform tasks related to building, intended to be used as reference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "builders' guides"@en .

aat:300026131 a skos:Concept ;
    skos:definition "Books of designs or plans circulated or published to enable widespread copying. May also be used for unbound collections of drawings or prints which serve as artists' models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern books"@en .

aat:300026178 a skos:Concept ;
    skos:definition "Manuals or guides that give examples of rules on the usage of words, punctuation, and typography for the preparation of copy for publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylebooks"@en .

aat:300026185 a skos:Concept ;
    skos:definition "Written compositions in which two or more characters are represented as conversing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dialogues"@en .

aat:300026186 a skos:Concept ;
    skos:definition "Reference sources containing alphabetical lists of words with information given for each word; generally including meanings, pronunciation, etymology, and often usage guidance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictionaries"@en .

aat:300026189 a skos:Concept ;
    skos:definition "Alphabetical lists of terms related to a particular subject or area of interest, including definitions or explanations of usage. Glossaries are typically part of a larger work and generally exclude pronunciation and etymological information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glossaries"@en .

aat:300026191 a skos:Concept ;
    skos:definition "Dictionaries, typically for children, that employ images or pictures to indicate definitions, in order to develop vocabulary, reading and spelling"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture dictionaries"@en .

aat:300026196 a skos:Concept ;
    skos:definition "Volumes composed of biographical sketches, arranged alphabetically, of people that share a common cultural context or origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biographical dictionaries"@en .

aat:300026198 a skos:Concept ;
    skos:definition "Dictionaries that collect words having the same general sense, but with shades of meaning appropriate to various contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictionaries of synonyms"@en .

aat:300026200 a skos:Concept ;
    skos:definition "Reference sources that consist primarily of the facts relating to the origin of words and the historical development of their form and meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etymological dictionaries"@en .

aat:300026202 a skos:Concept ;
    skos:definition "Geographical dictionaries with varying amounts of descriptive, geographical, historical, or statistical information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gazetteers"@en .

aat:300026212 a skos:Concept ;
    skos:definition "Dictionaries in any language other than that spoken by the people of a specific place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foreign-language dictionaries"@en .

aat:300026216 a skos:Concept ;
    skos:definition "Dictionaries book containing versions of the same text in several languages; especially Biblical texts in several languages"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyglot dictionaries"@en .

aat:300026228 a skos:Concept ;
    skos:definition "Dictionaries dedicated to terminology related to particular arts, crafts, or industries and their unique technical vocabularies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical dictionaries"@en .

aat:300026234 a skos:Concept ;
    skos:definition "Enumerations of names, addresses, and other data about specific groups of persons or organizations; may appear in alphabetic or graphic format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "directories"@en .

aat:300026238 a skos:Concept ;
    skos:definition "Books or publications with detailed maps of city streets, accompanied by an index of street names linked with coordinates or page numbers where the streets can be found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street directories"@en .

aat:300026241 a skos:Concept ;
    skos:definition "City directories usually contain an alphabetical list of businesses and residents for a municipality. Names of heads of households are included and in some cases, death dates, partners in firms, or forwarding addresses. Often these also include advertisements, information about schools, churches, and social organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city directories"@en .

aat:300026247 a skos:Concept ;
    skos:definition "Directories that provide government information and services for state employees, local government, and the general public. The directory services include state employee information, state agency information, and a State Government Organization Chart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state directories"@en .

aat:300026249 a skos:Concept ;
    skos:definition "Directories of public organizations encompassing regional communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional directories"@en .

aat:300026251 a skos:Concept ;
    skos:definition "Directories of public organizations encompassing a nation or country as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national directories"@en .

aat:300026253 a skos:Concept ;
    skos:definition "Reference works that provide data related to agents in various fields that exist globally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international directories"@en .

aat:300026256 a skos:Concept ;
    skos:definition "Directories of names, addresses, and other data about former students of schools, colleges, or universities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alumni directories"@en .

aat:300026260 a skos:Concept ;
    skos:definition "Directories lisitng names of and information on businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial directories"@en .

aat:300026266 a skos:Concept ;
    skos:definition "Publications that list manufacturers or fabricators of materials for those that seek their services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manufacturers' registers"@en .

aat:300026272 a skos:Concept ;
    skos:definition "Directories listing the names of and information on professional individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professional directories"@en .

aat:300026276 a skos:Concept ;
    skos:definition "Directories listing persons of social prominence in a community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social registers"@en .

aat:300026281 a skos:Concept ;
    skos:definition "Directories of the names of telephone subscribers with corresponding addresses and telephone numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephone directories"@en .

aat:300026284 a skos:Concept ;
    skos:definition "Includes articles in publications expressing the opinions of their editors or publishers and statements on radio, film or television expressing the opinions of a station, network, or individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "editorials"@en .

aat:300026285 a skos:Concept ;
    skos:definition "Mournful, melancholy, or plaintive poems, especially funeral songs or laments for the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elegies"@en .

aat:300026286 a skos:Concept ;
    skos:definition "Artistic genre that flourished in Europe particularly in the 16th and 17th centuries, focusing on a motto and an image representing that motto. Each emblem generally consists of three parts: a short, often Classical, motto (lemma, inscriptio), a pictorial representation or icon (pictura), and the explanation of the link between them in an epigram (subscriptio). The earliest known and most influential emblem book is the \"Emblematum liber,\" by Andrea Alciate, published in Augsburg in 1531. The format and definiton of emblem books are typically derived from the example of this work; however, the emblem itself remained an ambiguous concept that covered a variety of connections between word and image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emblem books"@en .

aat:300026291 a skos:Concept ;
    skos:definition "Short literary compositions on single subjects, often presenting the personal view of the author."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "essays"@en .

aat:300026294 a skos:Concept ;
    skos:definition "Tributes or laudatory speeches written in praise of a person or thing; often, but not always, refers to tributes in honor of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eulogies"@en .

aat:300026295 a skos:Concept ;
    skos:definition "Appendixes or digressions that contain further exposition on some point or topic from other works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excursuses"@en .

aat:300026297 a skos:Concept ;
    skos:definition "Collections of writings in the form of a volume of learned articles or essays by colleagues, students, and admirers to honor a scholar, other person, institution, or society on a special occasion or anniversary. Festschriften are usually complimentary or memorial publications in the form of collected essays, addresses, or biographical, bibliographical, scientific, or other contributions, often embodying the results of research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Festschriften"@en .

aat:300026300 a skos:Concept ;
    skos:definition "Handbooks for the guidance of strangers or visitors in a district, town, building, etc., giving a description of the roads, places, or objects of interest to be found there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guidebooks"@en .

aat:300026305 a skos:Concept ;
    skos:definition "Guidebooks designed for pilgrims, who are people who travel to sacred places as an act of religious devotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrimage guidebooks"@en .

aat:300026309 a skos:Concept ;
    skos:definition "Guidebooks aimed at those involved in the transportation of cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shippers' guides"@en .

aat:300026311 a skos:Concept ;
    skos:definition "Guidebooks aimed particularly at tourists or other leisure travelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel guidebooks"@en .

aat:300026358 a skos:Concept ;
    skos:definition "Chronological records of significant events, as of the life or development of a people, country, or institution, often with an explanation of the causes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "histories"@en .

aat:300026359 a skos:Concept ;
    skos:definition "Accounts of the chronological development of cases of disease or conditions of individuals, with details of symptoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case histories"@en .

aat:300026361 a skos:Concept ;
    skos:definition "Histories in which events are described in chronological order. For records of events in yearly sequence but less connected or filled out by commentary or interpretation, use \"annals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronicles"@en .

aat:300026365 a skos:Concept ;
    skos:definition "Documents in which are recorded household expenditures such as for food, utilities, and domestic help, maintained in a journal or other book; also includes classed or chronological files of the bills and receipts for household goods and services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housebooks"@en .

aat:300026367 a skos:Concept ;
    skos:definition "Print or nonprint materials used for the purpose of imparting knowledge, attitudes, or skills to others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instructional materials"@en .

aat:300026368 a skos:Concept ;
    skos:definition "Resources intended as preparation for specific exercises testing knowledge, aptitude, or skills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "examination study guides"@en .

aat:300026372 a skos:Concept ;
    skos:definition "Packets of subject-specific teaching materials containing objectives, directions for use, and test items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "learning modules"@en .

aat:300026378 a skos:Concept ;
    skos:definition "Elementary books for teaching children to read."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primers"@en .

aat:300026379 a skos:Concept ;
    skos:definition "Learning materials so designed that individuals can proceed to learn on their own with little or no personal supervision from an instructor or expert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-instructional materials"@en .

aat:300026380 a skos:Concept ;
    skos:definition "Books or treatises containing rules or instructions needed to perform methods of building, modifying, or repairing something without the aid of experts or professionals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "do-it-yourself manuals"@en .

aat:300026384 a skos:Concept ;
    skos:definition "Books used as standard works for the formal study of a particular subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textbooks"@en .

aat:300026387 a skos:Concept ;
    skos:definition "Books that include instructional material and also directions on how to assimilate information. Material in the textbooks is divided into units of information to be assimilated, combined with instructions on student fulfillment of assignments, additional explanations, and sections for self-testing for retention."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "programmed textbooks"@en .

aat:300026391 a skos:Concept ;
    skos:definition "Booklets containing problems and exercises in which a student may directly write or calculate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workbooks"@en .

aat:300026392 a skos:Concept ;
    skos:definition "Statements, transcripts, or recordings of conversations in which one person obtains information from another such as for research purposes, publication, or broadcast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interviews"@en .

aat:300026395 a skos:Concept ;
    skos:definition "Books or treatises, often compendious, containing rules or instructions needed to perform tasks, operations, processes, occupations, arts, or studies, and intended to be used as reference while the task or study is performed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manuals"@en .

aat:300026397 a skos:Concept ;
    skos:definition "Documents in any format describing, comparing, and contrasting the benefits of products for the benefit of consumers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buyers' guides"@en .

aat:300026401 a skos:Concept ;
    skos:definition "Specialized books containing information pertinent to the collecting of particular types of artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectors' guides"@en .

aat:300026405 a skos:Concept ;
    skos:definition "Books or documents given to employees by an employer that gather information about the employer’s policies and procedures regarding full or part-time employment, benefits, conduct and discipline, performance reviews and other relevant details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "employees' manuals"@en .

aat:300026409 a skos:Concept ;
    skos:definition "Sets of standards for the technical aspects of writing and design of documents, either for general use or for specific publications, organizations, or fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "style manuals"@en .

aat:300026413 a skos:Concept ;
    skos:definition "Documents that contain instructions for the installation, operation, use, or maintenance of equipment or systems, including parts lists, and technical support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical manuals"@en .

aat:300026415 a skos:Concept ;
    skos:definition "Books, pamphlets, or other documents containing instructions needed to control the proper functioning of a machine, process, or system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operating manuals"@en .

aat:300026419 a skos:Concept ;
    skos:definition "Documents comprised of collected instructions designed to inform the performance of specific tasks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "training manuals"@en .

aat:300026422 a skos:Concept ;
    skos:definition "General term for books used in church services containing the chants of the Latin liturgy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choirbooks"@en .

aat:300026424 a skos:Concept ;
    skos:definition "Books or booklets containing the text or words of an opera or similar extended musical composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "librettos"@en .

aat:300026427 a skos:Concept ;
    skos:definition "Original and entire drafts or transcripts of musical compositions or arrangements. Typically having the parts of all the different instruments or voices written on staffs one above another, so that they can be read at a glance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scores"@en .

aat:300026430 a skos:Concept ;
    skos:definition "Music printed on unbound sheets of paper, as opposed to in book form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet music"@en .

aat:300026432 a skos:Concept ;
    skos:definition "Books containing brief musical compositions written or adapted for singing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "songbooks"@en .

aat:300026434 a skos:Concept ;
    skos:definition "Collections of the texts of songs, but without accompanying musical notation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carol books"@en .

aat:300026435 a skos:Concept ;
    skos:definition "Short reports of the latest news or events, usually in a television or radio broadcast context, but these also may appear as printed matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "news bulletins"@en .

aat:300026437 a skos:Concept ;
    skos:definition "Official or authoritative statements distributed to the press typically by a public relations firm or government agency. For packets of promotional material distributed to the press, use \"press kits.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press releases"@en .

aat:300026441 a skos:Concept ;
    skos:definition "Written articles appearing regularly in a series in a newspaper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newspaper columns"@en .

aat:300026443 a skos:Concept ;
    skos:definition "Published notices of a death, usually with a brief biography of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obituaries"@en .

aat:300026446 a skos:Concept ;
    skos:definition "Books of images with little or no text, especially those intended for children or beginning readers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture books"@en .

aat:300026451 a skos:Concept ;
    skos:definition "Written or oral compositions characterized by condensed language chosen for sound and suggestive power as well as meaning, and by the use of such literary techniques as structured meter, natural cadences, rhyme, or metaphor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poems"@en .

aat:300026452 a skos:Concept ;
    skos:definition "Reverent petitions made to a deity or other spiritual entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayers"@en .

aat:300026456 a skos:Concept ;
    skos:definition "Medieval picture books of scriptural subjects, with descriptive vernacular text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Biblia pauperum"@en .

aat:300026457 a skos:Concept ;
    skos:definition "Books containing the prescribed order of prayers, readings from the bible, and rites for the canonical hours; often illuminated and intended for the lay community. For books containing the Divine Office for clerics or monastic contexts, use \"breviaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "books of hours"@en .

aat:300026459 a skos:Concept ;
    skos:definition "Religious books typically containing collections of prayers, psalms, readings, and rites.The form first appeared in the 11th century Christian monastic communities and among clerics, although the texts of the longer Divine Office had been established in the Roman rite by the 7th century and in Carolingian Europe by the 10th century. Although it was a complex book, it was briefer than the full Divine Office, thus known as a \"breviary.\" The \"book of hours\" was developed by the 13th century as an even less complex book of prayers for the lay community. Works similar to the Christian breviary were adapted from primary texts of other faiths, including the Koran and Hindu works; these works are also referred to as breviaries. Breviaries may contain elaborate illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breviaries"@en .

aat:300026460 a skos:Concept ;
    skos:definition "Manuals or guides for instructing through a series of questions and answers, especially for religious instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catechisms"@en .

aat:300026461 a skos:Concept ;
    skos:definition "Books containing records of naming ceremonies within a community, usually a church group. These also serve as civic documents, recording approximate dates of birth and names of newborns, parents, and sponsors in the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening books"@en .

aat:300026462 a skos:Concept ;
    skos:definition "Service books containing the musical portion of the mass sung by the choir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graduals"@en .

aat:300026463 a skos:Concept ;
    skos:definition "Books containing collections of hymns, usually to be sung in church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hymnals"@en .

aat:300026464 a skos:Concept ;
    skos:definition "Books containing the extracts (pericopes) from scripture appointed to be read at public worship; by the 13th century usually incorporated into the missal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lectionaries"@en .

aat:300026465 a skos:Concept ;
    skos:definition "Books containing the epistles to be read at the mass; by the 13th century, generally folded into the missal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epistolaries"@en .

aat:300026466 a skos:Concept ;
    skos:definition "Books containing the four Gospels, or readings from the Gospels arranged for the liturgical year; by the 13th century the gospels were generally folded into the missal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evangeliaries"@en .

aat:300026470 a skos:Concept ;
    skos:definition "Liturgical prayers consisting of phrases recited by a leader alternating with responses by a congregation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litanies"@en .

aat:300026471 a skos:Concept ;
    skos:definition "Lists, catalogs, histories, or accounts of religious martyrs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martyrologies"@en .

aat:300026472 a skos:Concept ;
    skos:definition "Books containing all the Roman Catholic prayers and responses necessary for celebrating the mass throughout the year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missals"@en .

aat:300026474 a skos:Concept ;
    skos:definition "Various liturgical books containing readings concerning the sufferings of the saints or of Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passionals"@en .

aat:300026476 a skos:Concept ;
    skos:definition "Books containing prayers and other forms of worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer books"@en .

aat:300026477 a skos:Concept ;
    skos:definition "Books or other document forms containing the Book of Psalms, which is composed of 150 psalms of the Old Testament. A psalter is usually divided into sections to be recited daily at Matins and Sunday Vespers, used as a liturgical book for the clergy in the Divine Office (forming the basis for the Breviary) or by the laity for private devotions. In addition to the psalms, psalters generally contain an ecclesiastical calendar, canticles, creeds, and the litany of the saints. King David and his court musicians were traditionally considered to be the authors of the psalms; the subjects of the psalms have to do with hymns in praise of God and pleas for help and mercy. In the Christian tradition, the psalms were interpreted with the Lord of the Old Testament understood to be Christ the Messiah. Various passages of individual psalms were seen as Christian metaphors and prefigurations. The Hebrew text of the psalms reached the Latin West by way of translations made by St. Jerome in the 4th century AD, two from the Greek version (the Septuagint) and one directly from the original language. The three versions, known respectively as the Roman, Gallican, and Hebrew Psalters. The psalter was one of the most frequently illustrated medieval texts in the West, beginning around 725 and flourishing between the 12th and 14th centuries. The text was often enhanced with precious ornament and images; however, psalms did not readily lend themselves to literal illustration, in contrast to the narrative portions of the bible. Consequently, their illustration was varied, both in format and in iconography. Most illuminated psalters were illustrated with decorated or historiated initials at the main divisions of the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psalters"@en .

aat:300026479 a skos:Concept ;
    skos:definition "Narrations of past experiences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reminiscences"@en .

aat:300026480 a skos:Concept ;
    skos:definition "Periodicals, reports, or essays giving critical estimates and appraisals of art, a performance, or event. For other critical descriptions and analyses, prefer \"criticism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reviews"@en .

aat:300026487 a skos:Concept ;
    skos:definition "Written texts of stage plays, screenplays, and radio or television broadcasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scripts"@en .

aat:300026488 a skos:Concept ;
    skos:definition "Copies of plays used by a prompter, showing action of the play, cues, movements of actors, properties, costume, and scene and light plots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prompt books"@en .

aat:300026489 a skos:Concept ;
    skos:definition "Texts for a broadcast announcement, talk, play, or other productions intended for radio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio scripts"@en .

aat:300026491 a skos:Concept ;
    skos:definition "Written forms of stories prepared for motion picture productions, including description of characters, details of scenes and settings, dialogue, and stage directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screenplays"@en .

aat:300026494 a skos:Concept ;
    skos:definition "Written texts of television productions or broadcasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television scripts"@en .

aat:300026497 a skos:Concept ;
    skos:definition "Lists of books, documents, and other bibliographical items, often all related by author, topic, or another criterion. Bibliographies are arranged in some logical order giving brief information about the works, such as author, date, publisher, and place of publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliographies"@en .

aat:300026506 a skos:Concept ;
    skos:definition "Bibliographies with notes added to the entries to elucidate, evaluate, or describe the subject and contents of the entries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annotated bibliographies"@en .

aat:300026511 a skos:Concept ;
    skos:definition "Bibliographies that list only a selection of the literature of a subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selective bibliographies"@en .

aat:300026516 a skos:Concept ;
    skos:definition "Bibliographies of recorded items compiled within limits set by the compiler, typically geographical, chronological, or topical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "systematic enumerative bibliographies"@en .

aat:300026524 a skos:Concept ;
    skos:definition "Bibliographies issued for, and usually by, booksellers and publishers to facilitate the sale of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade bibliographies"@en .

aat:300026527 a skos:Concept ;
    skos:definition "Bibliographies of books or other written records relating to a geographical area smaller than a county, which typically include those written by and about people born in the area, as well as books concering the area's geography, natural history, or architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local bibliographies"@en .

aat:300026529 a skos:Concept ;
    skos:definition "Includes bibliographies that list all the books and other publications published or distributed in a particular country and bibliographies that list publications about a particular country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national bibliographies"@en .

aat:300026534 a skos:Concept ;
    skos:definition "Lists of published works on a given subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject bibliographies"@en .

aat:300026536 a skos:Concept ;
    skos:definition "Lists of works that themselves collect other lists that collate works on a particular theme, rather than of a particular author, printer, or country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliographies of bibliographies"@en .

aat:300026537 a skos:Concept ;
    skos:definition "Includes indexes to the location of words or phrases in a text and finding aids, in two columns, establishing the relationship between the past and present reference numbers of individual items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concordances"@en .

aat:300026538 a skos:Concept ;
    skos:definition "Selective or complete lists of sound recordings, which can be compiled by composer, performer, or group of performers, or of a particular genre or recording label."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discographies"@en .

aat:300026539 a skos:Concept ;
    skos:definition "Documents, published or unpublished, listing or describing a body of records within a records center or archives, making them more readily accessible and comprehensible to the user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finding aids"@en .

aat:300026540 a skos:Concept ;
    skos:definition "Lists of descriptions of individual documents in a collection or of a specified kind, usually arranged in chronological order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival calendars"@en .

aat:300026542 a skos:Concept ;
    skos:definition "Finding aid in catalog form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival catalogs"@en .

aat:300026550 a skos:Concept ;
    skos:definition "Finding aids, whose normal unit of entry is the series. Usually include a brief history and description of the organization that produced the records, descriptive lists of each record series, and sometimes supplementary information, such as selective indexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival inventories"@en .

aat:300026552 a skos:Concept ;
    skos:definition "Finding aids developed at the Library of Congress to describe groups of papers, collections, and records by giving their provenance and conditions of administration, their scope and general content, including span and bulk dates, biographical notes about the person, group, or organization whose material it is, its arrangement, a container or folder listing, and, on occasion, selective document indexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival registers"@en .

aat:300026554 a skos:Concept ;
    skos:definition "Systematic guides to the contents of texts, files, documents, or collections, presented as a list, usually in alphabetical order, of persons and/or subjects referred to in documents, with location of references thereto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexes"@en .

aat:300026556 a skos:Concept ;
    skos:definition "Book indexes which give descriptions or definitions of the words indexed as well as their page numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glossarial indexes"@en .

aat:300026558 a skos:Concept ;
    skos:definition "Indexes in which each significant element of a multiword index entry appears as a filing element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotated indexes"@en .

aat:300026562 a skos:Concept ;
    skos:definition "Indexes in which each significant word in the entry is brought to the beginning, in alphabetical order, followed by the remaining words which follow it, and then followed by that part of the original title which came before the significant word."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key-word-and-context indexes"@en .

aat:300026566 a skos:Concept ;
    skos:definition "Indexes in which each significant word in the entry appears in a fixed position within the entry and is arranged with other entries in alphabetical order in a column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key-word-in-context indexes"@en .

aat:300026570 a skos:Concept ;
    skos:definition "Indexes in which each significant word in an entry is separated from the entry on separate lines of their own, with the full entry in original order under them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key-word-out-of-context indexes"@en .

aat:300026574 a skos:Concept ;
    skos:definition "Indexes computer generated by ABACUS (AB Atomic Energy Computerized User-oriented Service), the result of a collaboration between the Royal Institute of Technology, Stockholm and AB Atomenergi, Sweden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key-word-out-of-title indexes"@en .

aat:300026579 a skos:Concept ;
    skos:definition "Indexes to published materials that have cited a particular work; often includes subject and author indexes as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citation indexes"@en .

aat:300026581 a skos:Concept ;
    skos:definition "Indexes to one or more volumes of a periodical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periodical indexes"@en .

aat:300026583 a skos:Concept ;
    skos:definition "Indexes to information printed in newpapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newspaper indexes"@en .

aat:300026586 a skos:Concept ;
    skos:definition "Indexes consisting of the names of authors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "author indexes"@en .

aat:300026592 a skos:Concept ;
    skos:definition "Lists of subject terms that provide access to a classification or the contents of a publication, catalogue or collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject indexes"@en .

aat:300026597 a skos:Concept ;
    skos:definition "Indexes of publications released annually."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annual indexes"@en .

aat:300026599 a skos:Concept ;
    skos:definition "Indexes which combine separately published indexes into one sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cumulative indexes"@en .

aat:300026606 a skos:Concept ;
    skos:definition "Entries for books or other bibliographic material in the collection of a library, etc. that are printed and bound in book form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book catalogs"@en .

aat:300026612 a skos:Concept ;
    skos:definition "Catalogs, particularly of a library or other collection, in which each item is entered on a separate card and arranged alphabetically by author or title, or in another logical order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card catalogs"@en .

aat:300026614 a skos:Concept ;
    skos:definition "In general, refers to catalogs of any type available on or compiled using a computer network, including catalogs for library collections, for shopping online, or for any other purpose. Specifically, refers to online catalogs for libraries, comprising references to materials held by a library or group of libraries that are available to the public. It can typically be searched in various ways, such as by keyword, author, title, subject, or call number, to find out what resources a library owns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "online catalogs"@en .

aat:300026623 a skos:Concept ;
    skos:definition "Subject catalogs in which entries are arranged by the class numbers of a classification schedule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classified catalogs"@en .

aat:300026631 a skos:Concept ;
    skos:definition "Library catalog in which the entries are arranged in a single alphabetical sequence, regardless of their type, so that authors, titles, and other indexing terms are all alphabetized together alphabetically instead of in separate groupings by type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictionary catalogs"@en .

aat:300026635 a skos:Concept ;
    skos:definition "Arrangements of records for library materials by subject or topic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject catalogs"@en .

aat:300026637 a skos:Concept ;
    skos:definition "Lists of the holdings in a library, records center, or archives, arranged in the order of the contents of each shelf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelf lists"@en .

aat:300026640 a skos:Concept ;
    skos:definition "Lists of bibliographic terms of a given type, on a particular subject, in a given field, in the collections of a given group of libraries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "union lists"@en .

aat:300026642 a skos:Concept ;
    skos:definition "Publications in any medium issued in successive parts bearing numerical or chronological designations and intended to be continued indefinitely, such as periodicals, newspapers, annuals (reports, yearbooks, etc.), journals, memoires, proceedings, transactions, etc., of societies and numbered monographic series."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serials"@en .

aat:300026645 a skos:Concept ;
    skos:definition "Yearly publications, such as a book or journal published once a year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annuals"@en .

aat:300026646 a skos:Concept ;
    skos:definition "Books published annually as a compendium, report, or summary of the statistics or facts of a calendar year and intended as reference books, limited to a special subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yearbooks"@en .

aat:300026650 a skos:Concept ;
    skos:definition "Records of public events published periodically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gazettes"@en .

aat:300026652 a skos:Concept ;
    skos:definition "Letters, reports, or other brief written communications that communicate news, particularly those written by societies or buisiness organizations. Historically referred to serial publications consisting of one or a few printed sheets containing news and information of interest to the general public or to a special group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newsletters"@en .

aat:300026655 a skos:Concept ;
    skos:definition "Publications containing information concerning market conditions or expectations, especially those produced by firms or other financial organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market letters"@en .

aat:300026656 a skos:Concept ;
    skos:definition "Serials published at stated, frequent intervals, such as daily or weekly, and containing news, editorials, features, advertisements, and other items of current interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newspapers"@en .

aat:300026657 a skos:Concept ;
    skos:definition "Publications issued at regular intervals, but not daily, containing articles on various subjects by different authors for the general reader."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periodicals"@en .

aat:300026661 a skos:Concept ;
    skos:definition "Periodicals that are compendiums of previously published, summarized, or condensed literary, historical, legal, scientific, or other written matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digests"@en .

aat:300026662 a skos:Concept ;
    skos:definition "Periodicals produced by an organization, especially a commercial or industrial enterprise, and intended for primarily internal dissemination, or for distribution to customers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house organs"@en .

aat:300026669 a skos:Concept ;
    skos:definition "Religious discourses delivered as part of a church service, usually delivered from a pulpit, based upon a text of scripture, and with the purpose of giving religious instruction or exhortation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sermons"@en .

aat:300026671 a skos:Concept ;
    skos:definition "Document genre for the texts of public addresses or talks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speeches"@en .

aat:300026673 a skos:Concept ;
    skos:definition "Expositions of a given subject delivered before an audience or class, especially for the purposes of instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lectures"@en .

aat:300026674 a skos:Concept ;
    skos:definition "Formal addresses or speeches, especially those given on special occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orations"@en .

aat:300026675 a skos:Concept ;
    skos:definition "Brief statements or outlines of a subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synopses"@en .

aat:300026676 a skos:Concept ;
    skos:definition "Documents containing affirmation of person's character or the value of a thing. Specifically, written declarations stating an individual's achievements or the usefulness of a product or service, such as a letter of endorsement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testimonials"@en .

aat:300026677 a skos:Concept ;
    skos:definition "A semantic network of unique concepts, including relationships between synonyms, broader and narrower contexts, and other related concepts. Thesauri may be monolingual or multilingual. Thesauri may have the following three relationships between terms: equivalence (synonyms), hierarchical (whole/part), and associative (various types of other relationships)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thesauri"@en .

aat:300026679 a skos:Concept ;
    skos:definition "Genre comprising accounts of travel presented as film, video, or illustrated lectures; usually with narration, intended to give information about and an overall impression of places visited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travelog"@en .

aat:300026681 a skos:Concept ;
    skos:definition "Formal and systematic written expositions of the principles of a subject, generally longer and more detailed than essays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treatises"@en .

aat:300026684 a skos:Concept ;
    skos:definition "Commercially published groups of photographs of one place, event, or activity, sometimes spiral bound or accordion folded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viewbooks"@en .

aat:300026685 a skos:Concept ;
    skos:definition "Recorded information, often standardized in format and content and treated as a unit. Records include such compilations of data regardless of medium, that are created, received, and maintained by a project, agency, institution, organization, or individual in pursuance of legal obligations, in the transaction of business, for the storage of research and knowledge, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "records"@en .

aat:300026687 a skos:Concept ;
    skos:definition "Written recognitions of acts or achievements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acknowledgments"@en .

aat:300026688 a skos:Concept ;
    skos:definition "Printed matter included with or added to a text after it has been set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "addenda"@en .

aat:300026689 a skos:Concept ;
    skos:definition "Books listing names with residences, usually in alphabetical order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "address books"@en .

aat:300026690 a skos:Concept ;
    skos:definition "Books with blank pages used for assembling and presenting a collection, or any unpublished sets of pages that are bound or loose-leaf and have other materials affixed to them or writing or other images made on them. The volume may have been constructed with blank pages that were intended to have materials affixed, or it may have been assembled after having had materials affixed to separate pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albums"@en .

aat:300026691 a skos:Concept ;
    skos:definition "Books, loose-leaf binders, or other volumes containing blank leaves, on which persons have written sentiments, quotations, or signatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autograph albums"@en .

aat:300026693 a skos:Concept ;
    skos:definition "Books of blank or lined paper on which letters to be sent have been written; also copies of letters, originally on loose sheets, bound together, usually in chronological order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter books"@en .

aat:300026695 a skos:Concept ;
    skos:definition "Albums made up of mounted photographs, with or without identifying information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photograph albums"@en .

aat:300026697 a skos:Concept ;
    skos:definition "Albums made up of mounted postcards, with or without identifying information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postcard albums"@en .

aat:300026699 a skos:Concept ;
    skos:definition "Albums designed to be dedicated or presented to a person or organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation albums"@en .

aat:300026703 a skos:Concept ;
    skos:definition "Albums which keep mounted stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamp albums"@en .

aat:300026705 a skos:Concept ;
    skos:definition "Publications, usually annuals, containing a variety of useful facts of miscellaneous nature, or statistical information; originally included projections of coming days, months, and holidays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almanacs"@en .

aat:300026707 a skos:Concept ;
    skos:definition "Printed, spoken, or published statements or notices that inform the reader of an event or other news."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "announcements"@en .

aat:300026708 a skos:Concept ;
    skos:definition "Announcements informing customers of news concerning a business, such as the opening of a new branch, change in management or address, or the introduction of a new product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business announcements"@en .

aat:300026710 a skos:Concept ;
    skos:definition "Books for recording engagements; usually containing calendars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appointment books"@en .

aat:300026711 a skos:Concept ;
    skos:definition "Documents related to performing a contract for work and labor, or to supply materials or goods at a specified price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidding documents"@en .

aat:300026714 a skos:Concept ;
    skos:definition "Forms, furnished to bidders, on which to submit their bids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bid forms"@en .

aat:300026716 a skos:Concept ;
    skos:definition "Documents outlining the procedures for preparing and submitting bids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instructions to bidders"@en .

aat:300026722 a skos:Concept ;
    skos:definition "Documents advertising for bids to be submitted for a particular job."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidding announcements"@en .

aat:300026725 a skos:Concept ;
    skos:definition "Offers to perform a contract for work and labor or to supply materials or goods at a specified price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bids"@en .

aat:300026727 a skos:Concept ;
    skos:definition "Rough or approximate calculations of cost or value, such as statements of price for which certain work will be done by one who is willing to undertake it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estimates"@en .

aat:300026734 a skos:Concept ;
    skos:definition "Detailed listings of the quantities of all items of material and equipment projected for use in a project, and the actual quantities used in the completed work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quantity surveys"@en .

aat:300026739 a skos:Concept ;
    skos:definition "Sizeable single-sheet notices or advertisements printed on one or both sides, often chiefly textual rather than pictorial, and printed to be read unfolded. For the format in which the sheet is not folded, use \"broadsheet (format).\" For folded sheets having printed matter that generally does not cross the folds, use \"folders (printed matter).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadsides"@en .

aat:300026741 a skos:Concept ;
    skos:definition "Registers of days or other contrivances for reckoning days, months, years, etc., such as a table showing the division of a given year into its months, weeks, days, years, or other divisions of time. A calendar may include important astronomical data, ecclesiastical or other festivals, and other events belonging to specific days. For calendric systems of dates, see children under \"<dating systems by specific type>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calendars"@en .

aat:300026748 a skos:Concept ;
    skos:definition "Documents containing sets of tables for calculating astronomical events and movable dates on the calendar such as feast days; sometimes also recording the rules governing the tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computuses"@en .

aat:300026750 a skos:Concept ;
    skos:definition "Calendars that provide religious or spiritual readings for each calendar day. They may contain daily prayers or themes on which to meditate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional calendars"@en .

aat:300026752 a skos:Concept ;
    skos:definition "Charts or mechanical devices that indicate the day of the week corresponding to any given date over a period of many years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perpetual calendars"@en .

aat:300026754 a skos:Concept ;
    skos:definition "Calendars that highlight religious events and activities for specific days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious calendars"@en .

aat:300026756 a skos:Concept ;
    skos:definition "Rectangular pieces of stiff paper or plastic, usually of standard dimensions, used as a support on which information is typed, written, or transcribed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cards"@en .

aat:300026767 a skos:Concept ;
    skos:definition "Small cards produced since the 19th century bearing the name and address of a business concern and one of its representatives, and intended more for information than advertisement. For small printed sheets or cards bearing tradesmen's advertisements from the 17th through the 19th century, use \"trade cards.\" For cards made later and distributed for advertisement, use \"advertising cards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business cards"@en .

aat:300026769 a skos:Concept ;
    skos:definition "Cards of standard dimensions that are used to record information and filed in card catalogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalog cards"@en .

aat:300026771 a skos:Concept ;
    skos:definition "Cards containing pictures of birds, baseball players, celebrities, or other popular culture subjects packaged by manufacturers of cigarettes with their product during the 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigarette cards"@en .

aat:300026773 a skos:Concept ;
    skos:definition "Cards used to obtain money, goods, or services on credit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credit cards"@en .

aat:300026778 a skos:Concept ;
    skos:definition "Cards often imprinted with messages and suitable illustrations, sent or given on special occasions or holidays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greeting cards"@en .

aat:300026780 a skos:Concept ;
    skos:definition "Cards used for sending greetings to individuals on their birthdays, often bearing illustrations and printed sentiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birthday cards"@en .

aat:300026782 a skos:Concept ;
    skos:definition "Greeting cards that are sent or given as expressions of goodwill at Christmastime. The first Christmas cards were made in the 1840s in England. The tradition is followed in all English-speaking countries and the practice is growing in many others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christmas cards"@en .

aat:300026786 a skos:Concept ;
    skos:definition "Cards imprinted with greetings or messages and often suitable illustrations that are sent or given to celebrate Easter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Easter cards"@en .

aat:300026788 a skos:Concept ;
    skos:definition "Greeting cards that are sent or given as expressions of goodwill during the celebration of Hanukkah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanukkah cards"@en .

aat:300026794 a skos:Concept ;
    skos:definition "Greeting cards sent to a sweetheart on Saint Valentine's Day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valentines"@en .

aat:300026799 a skos:Concept ;
    skos:definition "Cards issued by a government or other authority that verifies the identity of those that carry them. These usually have photographs affixed to them and include personal and descriptive information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identity cards"@en .

aat:300026802 a skos:Concept ;
    skos:definition "Identifying cards issued by lending libraries to individuals or organizations that authorize the user to withdraw materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library cards"@en .

aat:300026810 a skos:Concept ;
    skos:definition "Cards notifying the recipient that a mass is being offered for a deceased person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass cards"@en .

aat:300026812 a skos:Concept ;
    skos:definition "Printed cards made on the occasion of a person's death, usually distributed at funeral ceremonies. Often the name and life dates of the deceased are printed along with a religious text and image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorial cards"@en .

aat:300026816 a skos:Concept ;
    skos:definition "Cards on which a message may be written or printed for mailing without an envelope, usually at a lower rate than that for letters in envelopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postcards"@en .

aat:300026819 a skos:Concept ;
    skos:definition "Postcards having a pictorial image on one side, often representations of a place or works of art, upon which a message can be written, then posted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture postcards"@en .

aat:300026821 a skos:Concept ;
    skos:definition "Cards sold by the post office with postage stamps already printed on them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postal cards"@en .

aat:300026823 a skos:Concept ;
    skos:definition "Small cards bearing the name, and sometimes the address of a person or married couple for presentation, as when formally calling or visiting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visiting cards"@en .

aat:300026829 a skos:Concept ;
    skos:definition "Books containing records of cases illustrative of general principles or typifying significant situations; used for reference or instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casebooks"@en .

aat:300026832 a skos:Concept ;
    skos:definition "Official, usually periodic, lists of persons or property with varying degrees of descriptive detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "census records"@en .

aat:300026841 a skos:Concept ;
    skos:definition "Documents giving authoritative recognition of a fact, qualification, or promise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates"@en .

aat:300026842 a skos:Concept ;
    skos:definition "Things conferred or bestowed as a reward for merit, including a prize, reward, honor, document, or remuneration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awards"@en .

aat:300026847 a skos:Concept ;
    skos:definition "Certificates attesting to the country of manufacture of a commodity, often required by the customs office before importation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates of origin"@en .

aat:300026848 a skos:Concept ;
    skos:definition "A tabular or graphic representation of a fluctuating or dependent variable, such as magnitude, temperature, cost, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charts"@en .

aat:300026859 a skos:Concept ;
    skos:definition "Graphic representations of symbols connected with lines showing the successive steps in a procedure or systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flow charts"@en .

aat:300026863 a skos:Concept ;
    skos:definition "Diagrams of the administrative and functional structure of an organization, showing the established relationships of personnel through lines of authority and responsibility with delegated and assigned duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organizational charts"@en .

aat:300026865 a skos:Concept ;
    skos:definition "Charts that plot the solar azimuth angle, solar altitude angle or solar time. These are used for a variety of purposes including navigation, orientation, or architectural planning. Common solar charts employ an artificial concentric scale of equidistant intervals to calculate solar geometric parameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar charts"@en .

aat:300026867 a skos:Concept ;
    skos:definition "Illustrations, pages, articles, or columns of text removed from books, newspapers, journals, or other printed sources and kept for their informational content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clippings"@en .

aat:300026876 a skos:Concept ;
    skos:definition "Includes authorizations granting the power to perform a task or duty and documents appointing or hiring someone to perform a task."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissions"@en .

aat:300026877 a skos:Concept ;
    skos:definition "Any forms of addressed and written communication sent and received, including letters, postcards, memorandums, notes, telegrams, or cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "correspondence"@en .

aat:300026879 a skos:Concept ;
    skos:definition "Pieces of correspondence that are somewhat more formal than memoranda or notes, usually on paper and delivered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters"@en .

aat:300026882 a skos:Concept ;
    skos:definition "Letters intended for circulation, either widely or throughout a particular group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular letters"@en .

aat:300026884 a skos:Concept ;
    skos:definition "Letters intended for wide or general circulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encyclicals"@en .

aat:300026886 a skos:Concept ;
    skos:definition "Letters addressed by the pope to all the bishops of the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal encyclicals"@en .

aat:300026888 a skos:Concept ;
    skos:definition "Letters, memorandums, or postcards which are printed and stocked in advance of actual use and usually contain prepared spaces for insertion of information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "form letters"@en .

aat:300026890 a skos:Concept ;
    skos:definition "Letters by which the drawer of a bill of exchange notifies the drawee that the bill has been issued and is forthcoming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of advice"@en .

aat:300026892 a skos:Concept ;
    skos:definition "Letters customarily employed to reduce to writing a preliminary understanding of parties who intend to enter into contract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of intent"@en .

aat:300026896 a skos:Concept ;
    skos:definition "Formal letters recommending a person as worthy or suitable or merely as introduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of recommendation"@en .

aat:300026904 a skos:Concept ;
    skos:definition "Letters that express love, admiration, or romantic sentiment, intended to be read by the object of affection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "love letters"@en .

aat:300026906 a skos:Concept ;
    skos:definition "Documents recording information used for internal communication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorandums"@en .

aat:300026909 a skos:Concept ;
    skos:definition "Messages sent by telegraph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telegrams"@en .

aat:300026914 a skos:Concept ;
    skos:definition "Commercial or business intercourse engaged in by two or more parties. May be considered broadly to include letters and other forms of communication including electronic mail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial correspondence"@en .

aat:300026916 a skos:Concept ;
    skos:definition "Formal and usually succinct letters issued from a business or individual requesting or delivering information, applying for a job, or addressing any other topic excluding personal communication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business letters"@en .

aat:300026918 a skos:Concept ;
    skos:definition "Letters either solicited or un-solicited intended to create incentive to buy a product or service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sales letters"@en .

aat:300026920 a skos:Concept ;
    skos:definition "Correspondence on the topic of any legal proceeding, as between a lawyer and a client regarding an impending trial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal correspondence"@en .

aat:300026922 a skos:Concept ;
    skos:definition "Use to designate evidence of authority, status, rights, entitlement to privileges, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credentials"@en .

aat:300026924 a skos:Concept ;
    skos:definition "Branch of mathematics that deals with the collection and arrangement of numerical facts or data,whether relating to human affairs or to natural phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statistics"@en .

aat:300026925 a skos:Concept ;
    skos:definition "Authoritative orders, edicts, laws, ordinances, or judicial decisions that are set forth by a civil or ecclesiastical authority, typically having the force of law and often settling a disputed issue or doctrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decrees"@en .

aat:300026927 a skos:Concept ;
    skos:definition "Letters of the pope determining some point or question in ecclesiastical law and possessing the force of law within the Roman Catholic Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decretals"@en .

aat:300026930 a skos:Concept ;
    skos:definition "Messages, intended usually for special or expeditious transmittal or delivery, such as important official messages, or news items sent with promptness by correspondents to newspapers or news agencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dispatches"@en .

aat:300026931 a skos:Concept ;
    skos:definition "Preliminary or tentative versions of documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafts"@en .

aat:300026932 a skos:Concept ;
    skos:definition "Rough or preliminary proposed texts of documents, not yet in definitive form, usually subject to review, revision, rejection, approval, or adoption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first drafts"@en .

aat:300026936 a skos:Concept ;
    skos:definition "Written questions or exercises testing knowledge, aptitude, or skills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "examinations"@en .

aat:300026939 a skos:Concept ;
    skos:definition "Portions of a larger work, such as a literary work or motion picture, reproduced or excised without further change from their original context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excerpts"@en .

aat:300026941 a skos:Concept ;
    skos:definition "Excerpts of parts of a literary composition, as into another book or writing; use also for statements of market price of one or more securities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quotations"@en .

aat:300026942 a skos:Concept ;
    skos:definition "Organized units of documents grouped together in an overall arrangement or plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "files"@en .

aat:300026944 a skos:Concept ;
    skos:definition "Files that employ paper cards of approximately the same dimensions, on which information is recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card files"@en .

aat:300026946 a skos:Concept ;
    skos:definition "Files where items, usually ephemeral and topical in nature, such as newspapers and magazines, are kept for information and reference, usually in folders in vertical files and arranged systematically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clippings files"@en .

aat:300026952 a skos:Concept ;
    skos:definition "Collections of materials, such as pamphlets, cuttings, and pictures, which are ephemeral in nature. The documents are often of varying sizes and typically unbound, stored in drawers or on their edges in special supports that allow vertical rather than horizontal storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical files"@en .

aat:300026957 a skos:Concept ;
    skos:definition "Collations of terms or names that serves as a standard for cataloging purposes, particularly electronic or physical files or other groupings of authorized cataloging entries for names, subjects, or other information. An authority file is characterized by having labeled the authoritative or preferred form of the name or subject entry for a particular entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authority files"@en .

aat:300026963 a skos:Concept ;
    skos:definition "Electronic or physical files or other groupings of authorized cataloging entries for names, particularly personal and corporate names, but the term could also be used for authorities containing other names, such as geographic names, titles of works of art, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "name authority files"@en .

aat:300026966 a skos:Concept ;
    skos:definition "Electronic or physical files or other groupings of authorized cataloging entries for terminology appropriate for subject indexing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject authority files"@en .

aat:300026972 a skos:Concept ;
    skos:definition "Files containing records with information about individuals, such as dates of birth or death, address, career information, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biography files"@en .

aat:300026977 a skos:Concept ;
    skos:definition "Collections of files in which each file relates to a specific project, action, event, patient illness, legal proceedings, or other subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case files"@en .

aat:300026979 a skos:Concept ;
    skos:definition "Collections of material relating to law cases; they may include brief decisions or histories of cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal files"@en .

aat:300026981 a skos:Concept ;
    skos:definition "Lists or registers of cases before a tribunal, usually kept by the clerk of the court, identifying the cases, with entries of action taken; used originally in connection with judicial proceedings, now also used in connection with quasi-judicial or administrative proceedings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dockets"@en .

aat:300026982 a skos:Concept ;
    skos:definition "Collections of files in which each file is related to one particular project, including but not limited to an engineering or architectural project. The term is also used to refer to electronic files related to a project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "project files"@en .

aat:300026988 a skos:Concept ;
    skos:definition "Collections of sheet or folded maps, that are often large and flat, requiring shelves or drawers with special dimensions and allowing flat storage, as opposed to upright storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "map files"@en .

aat:300026990 a skos:Concept ;
    skos:definition "Collections of files in which each file relates to a single order for a customer or patron, such as in a library or commercial sales business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "order files"@en .

aat:300026992 a skos:Concept ;
    skos:definition "Collections of files containing written or published material by or about an organization, including official minutes, proceedings, instructions for the staff, publicity materials, and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organization files"@en .

aat:300027002 a skos:Concept ;
    skos:definition "Forms used by persons requesting assistance, authorization, employment, admission, or other action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "application forms"@en .

aat:300027004 a skos:Concept ;
    skos:definition "Printed forms, characterized by a heading containing the name of a company or name and address, on which a statement of money due is recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billheads"@en .

aat:300027009 a skos:Concept ;
    skos:definition "Preformatted forms on which a consumer may indicate a required product or service. This form is subsequently consulted by the supplier of the product or service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "order forms"@en .

aat:300027015 a skos:Concept ;
    skos:definition "Accounts or histories of the descent of persons, families, or other groups, from an ancestor or ancestors; enumerations of ancestors and their descendants in the natural order of succession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genealogies"@en .

aat:300027016 a skos:Concept ;
    skos:definition "Documents representing the lineage of a person or persons in tabular or diagrammatic form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genealogical tables"@en .

aat:300027019 a skos:Concept ;
    skos:definition "Charts or lists showing lineage, especially those showing the ancestors of purebred animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedigrees"@en .

aat:300027020 a skos:Concept ;
    skos:definition "Representations of any sort of data by means of dots, lines, or bars; usually to illustrate relationships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphs"@en .

aat:300027021 a skos:Concept ;
    skos:definition "Statistical diagrams in which numerical quantities are illustrated by rectangles of equal width but of varying length extending horizontally or vertically from a base line, and which represent frequency distributions. The rectangles or bars are ranged along an x/y axis representing two sets of variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar graphs"@en .

aat:300027023 a skos:Concept ;
    skos:definition "Diagrams in the form of a circle divided by radii into sectors proportional to relative magnitudes, quantities, or frequencies of a set or to the number of data values in a corresponding class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular graphs"@en .

aat:300027027 a skos:Concept ;
    skos:definition "Graphic diagrams that plot the relationship between two variables. The relationship is plotted by points against these, the points joined by a broken line to illustrate fluctuation in variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line graphs"@en .

aat:300027029 a skos:Concept ;
    skos:definition "Recommendations and often examples, laying out best practice or advice regarding a certain procedure, activity, or topic. For documents containing more prescriptive instructions, use \"rules (instructional materials).\" For more prescriptive instructions, prefer \"rules.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guidelines"@en .

aat:300027033 a skos:Concept ;
    skos:definition "Small printed sheets usually containing a notice or advertisement intended to be distributed by hand and often doubling as posters. For small printed sheets intended for wider distribution, to the general public, use \"circulars.\" For larger pieces, intended especially for posting, use \"posters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handbills"@en .

aat:300027042 a skos:Concept ;
    skos:definition "Information in the form of outlines of procedures, as directions or commands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instructions"@en .

aat:300027043 a skos:Concept ;
    skos:definition "Sets of directions with a list of ingredients for making or preparing something, especially food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recipes"@en .

aat:300027045 a skos:Concept ;
    skos:definition "Detailed lists of things in one's view or possession, as of all goods and materials on hand, or detailed lists of all items in a given category. For documentation of examination conducted to achieve a comprehensive view, use \"surveys.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inventories"@en .

aat:300027079 a skos:Concept ;
    skos:definition "Surveys involving the gathering of basic information about records regarding the quantity, physical form and type, location, physical condition, storage facilities, rate of accumulation, uses, and similar data for the purpose of planning acquisition and disposal programs, microfilming operations, new facilities, and related archival activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "records surveys"@en .

aat:300027083 a skos:Concept ;
    skos:definition "Engraved, printed, or written expressions requesting a person's company at a certain event at a given time and place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invitations"@en .

aat:300027086 a skos:Concept ;
    skos:definition "Documents outlining a proposed journey. Originally, a list of destinations in the Roman Empire with the distances between them, thought to be measured from the 'Millarium Aureum' or 'Golden Milestone' in the Roman Forum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "itineraries"@en .

aat:300027087 a skos:Concept ;
    skos:definition "Books containing accounts of an individual's or organization's occurrences or transactions, including records of financial transactions. Use \"diaries\" when referring to personal accounts of the writer's experiences, attitudes, or observations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "journals"@en .

aat:300027093 a skos:Concept ;
    skos:definition "Books in which noteworthy literary passages, cogent quotations, poems, comments, recipes, prescriptions, and other miscellaneous document types are written."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commonplace books"@en .

aat:300027110 a skos:Concept ;
    skos:definition "Daily records of the progress of a ship at sea, with notes on the weather and important incidents of the voyage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships' logs"@en .

aat:300027112 a skos:Concept ;
    skos:definition "Refers to books containing the daily, personal accounts of the writer's own experiences, attitudes, and observations. Use \"journals (accounts)\" when referring to an individual's or an organization's account of occurrences or transactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaries"@en .

aat:300027117 a skos:Concept ;
    skos:definition "Diaries kept over a period of time, such as from month to month or year to year, that record aspects of weather such precipitation and temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weather diaries"@en .

aat:300027119 a skos:Concept ;
    skos:definition "Transcribed collections of numbers, names, or other text indicating tallies of concepts collocated for any particular purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lists"@en .

aat:300027123 a skos:Concept ;
    skos:definition "Lists in which items can be compared, scheduled, verified, or identified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checklists"@en .

aat:300027125 a skos:Concept ;
    skos:definition "Lists documenting persons or organizations from which a repository or institution has received gifts or donations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "donor lists"@en .

aat:300027135 a skos:Concept ;
    skos:definition "Books, usually of printed forms, in which visitors may write their names and addresses, and sometimes comments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visitors' books"@en .

aat:300027136 a skos:Concept ;
    skos:definition "Comprehensive records of projects undertaken by architectural and other firms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "job lists"@en .

aat:300027137 a skos:Concept ;
    skos:definition "Lists of addresses, usually kept by an organization or business, used when sending postal matter. May also refer to electronic-mail addresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mailing lists"@en .

aat:300027139 a skos:Concept ;
    skos:definition "Lists or records of subscriptions and subscribers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subscription lists"@en .

aat:300027141 a skos:Concept ;
    skos:definition "Lists or rolls of the collective body of members, as of a society, at a given time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membership lists"@en .

aat:300027157 a skos:Concept ;
    skos:definition "Lists of persons who travel in a train, plane, ship, bus, or other conveyance without participating in its operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passenger lists"@en .

aat:300027162 a skos:Concept ;
    skos:definition "Statements or lists of the prevailing prices of merchandise, stock, or other items for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "price lists"@en .

aat:300027166 a skos:Concept ;
    skos:definition "List of recommended books, periodical articles, or other information forms, typically as part of course which students are expected to read."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading lists"@en .

aat:300027168 a skos:Concept ;
    skos:definition "Official lists of entries of any information considered sufficiently important to be exactly and formally recorded, typically maintained in numerical or chronological order in a regular manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registers"@en .

aat:300027169 a skos:Concept ;
    skos:definition "Registers, usually in volume form, of copies of charters, title deeds, and other documents of significance belonging to a person, family, or institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartularies"@en .

aat:300027172 a skos:Concept ;
    skos:definition "Parchment rolls upon which charters were enrolled at the chancery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charter rolls"@en .

aat:300027176 a skos:Concept ;
    skos:definition "Records of the writs authorizing delivery of money out of the treasury."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liberate rolls"@en .

aat:300027178 a skos:Concept ;
    skos:definition "Use generally for any list of names of persons enrolled or enlisted for a particular purpose, as a list of names of military personnel enrolled for active duty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosters"@en .

aat:300027179 a skos:Concept ;
    skos:definition "Lists of names of registered voters, typically including demographic information, some vote history, and campaign contribution history, used for polling purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voters' lists"@en .

aat:300027185 a skos:Concept ;
    skos:definition "Lists of items lacking or needed, such as a list of books issued by a librarian or a list of objects wanted for a museum collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "want lists"@en .

aat:300027187 a skos:Concept ;
    skos:definition "Lists which display the available wines at restaurants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine lists"@en .

aat:300027189 a skos:Concept ;
    skos:definition "Records detailing the medical history and treatments conducted by individuals with a medical practitioner or in an institution such as a hospital or clinic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medical records"@en .

aat:300027191 a skos:Concept ;
    skos:definition "Lists of dishes to be served or available for meals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menus"@en .

aat:300027196 a skos:Concept ;
    skos:definition "Notebooks used in laboratories to make notations and calculations regarding experiments and observations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratory notebooks"@en .

aat:300027200 a skos:Concept ;
    skos:definition "Brief statements of a fact or experience, written down for review, or as an aid to memory, or to inform someone else; also includes short, informal letters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notes"@en .

aat:300027201 a skos:Concept ;
    skos:definition "Notes, often in books, kept by researchers or surveying parties while on site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field notes"@en .

aat:300027202 a skos:Concept ;
    skos:definition "Notes made in the course of scientific inquiry conducted in a controlled environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratory notes"@en .

aat:300027204 a skos:Concept ;
    skos:definition "Notes made with reference to a lecture, both those from which the lecturer speaks, and those taken by people in attendance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lecture notes"@en .

aat:300027206 a skos:Concept ;
    skos:definition "Any forms of attestation, written or verbal, by which persons signify that they are bound in conscience to perform an act faithfully and truthfully; also affirmations of the truth of a statement given before testifying, as in a court of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oaths"@en .

aat:300027207 a skos:Concept ;
    skos:definition "General descriptions covering the main points of a subject, such as summaries of written works or speeches expressed as headings and subheadings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outlines"@en .

aat:300027211 a skos:Concept ;
    skos:definition "Brief treatises for general distribution, usually on a religious or political topic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracts"@en .

aat:300027216 a skos:Concept ;
    skos:definition "Programs or posters announcing a theatrical performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playbills"@en .

aat:300027219 a skos:Concept ;
    skos:definition "Includes any written requests and lists of signatures submitted to an authority to appeal for the performance of specific action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petitions"@en .

aat:300027221 a skos:Concept ;
    skos:definition "Notices, usually decorative or pictorial, intended to be posted to advertise, promote, or publicize an activity, cause, product, or service; also, decorative, mass-produced prints intended for hanging. For small printed notices or advertisements intended for distribution by hand, use \"handbills.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posters"@en .

aat:300027231 a skos:Concept ;
    skos:definition "Directions or orders of remedy for a disease or illness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prescriptions"@en .

aat:300027232 a skos:Concept ;
    skos:definition "Reference books listing the prices of objects for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "price books"@en .

aat:300027237 a skos:Concept ;
    skos:definition "Documents that are publicly announced or officially declared; especially a public notice by an official of some order, intended action, or state of facts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proclamations"@en .

aat:300027243 a skos:Concept ;
    skos:definition "Official documents related to the transaction and ownership of property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "property records"@en .

aat:300027244 a skos:Concept ;
    skos:definition "Documents, such as deeds, by which title to property is conveyed from one person to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conveyances"@en .

aat:300027245 a skos:Concept ;
    skos:definition "Official lists that record ownership of property, mortgages, and other instruments that relate to real property, kept in official record books provided and maintained for such purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deed registers"@en .

aat:300027247 a skos:Concept ;
    skos:definition "Official lists kept by government agencies or departments in which information concerning land ownership, possession, or rights are recorded to provide evidence of title or transaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land registers"@en .

aat:300027249 a skos:Concept ;
    skos:definition "Documents, usually executed under seal, containing a conveyance, especially of real estate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deeds"@en .

aat:300027251 a skos:Concept ;
    skos:definition "Deeds embodying a mortgage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortgage deeds"@en .

aat:300027253 a skos:Concept ;
    skos:definition "Official documents from a government to an individual conveying fee simple title to public lands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land grants"@en .

aat:300027257 a skos:Concept ;
    skos:definition "Documents, often maps, which record the measuring and marking of land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land surveys"@en .

aat:300027261 a skos:Concept ;
    skos:definition "Includes offers by one person or organization to another of terms and conditions with reference to some work or undertaking and plans or schemes put forward for consideration, discussion, or adoption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proposals"@en .

aat:300027262 a skos:Concept ;
    skos:definition "Documents that outline formally and in detail a project or endeavor, and that are submitted to an entity capable of bestowing funding to realize the project described. The intended audience may be a government agency, a private foundation, or other corporation. Grant proposals are written on behalf of individuals, non-profit organizations, charities, companies, or educational institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grant proposals"@en .

aat:300027264 a skos:Concept ;
    skos:definition "Documents designed to inform prospective investors or patrons, consisting of a formal summary of a proposed commercial, literary, or other venture, or a description of the features or services of an institution or business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prospectuses"@en .

aat:300027265 a skos:Concept ;
    skos:definition "Documents containing a set of questions for submission to a number of persons in order to obtain statistically useful information. Use \"surveys\" for documentation of inspections conducted to achieve a comprehesive view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "questionnaires"@en .

aat:300027267 a skos:Concept ;
    skos:definition "Official or formal records of a special investigation, in the form of documents containing presentations of facts, proceedings, investigations, or events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reports"@en .

aat:300027268 a skos:Concept ;
    skos:definition "Official or formal records outlining administrative details, or events sucha as functions, proceedings, or investigations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administrative reports"@en .

aat:300027273 a skos:Concept ;
    skos:definition "Official or formal records of an investigation related to an unexpected happening, in the form of documents containing presentations of facts, proceedings, investigations, or an outline of events preceding the accident."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accident reports"@en .

aat:300027275 a skos:Concept ;
    skos:definition "Documents that state the mission and revenues of a corporation for the inspection of the public and shareholders alike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporation reports"@en .

aat:300027283 a skos:Concept ;
    skos:definition "Forms or other documents in which physical damage is recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damage reports"@en .

aat:300027286 a skos:Concept ;
    skos:definition "Reports prepared each day that provide performance information for any particular project or endeavor to its management."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daily reports"@en .

aat:300027288 a skos:Concept ;
    skos:definition "Reports prepared monthly that provide performance information for any particular project or endeavor to any agency of its management."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monthly reports"@en .

aat:300027290 a skos:Concept ;
    skos:definition "Reports produced at three-month intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarterly reports"@en .

aat:300027292 a skos:Concept ;
    skos:definition "Documentation summarizing the activities of an organization over the course of a year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annual reports"@en .

aat:300027294 a skos:Concept ;
    skos:definition "Official documents that collect facts about a particular subject or event, and often draw conclusions based on these facts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "official reports"@en .

aat:300027296 a skos:Concept ;
    skos:definition "Official announcements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communiques"@en .

aat:300027297 a skos:Concept ;
    skos:definition "Organized and often detailed proposals that lay out strategies and schemes of action for something to be done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plans"@en .

aat:300027299 a skos:Concept ;
    skos:definition "Organized, detailed proposals that are comprehensive in scope and lay out strategies and schemes of action for something to be done. Examples include land use control law, zoning, and urban redevelopment omnibus plans of cities or towns for housing, industry, commercial, and recreational facilities and their impact on environmental factors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comprehensive plans"@en .

aat:300027312 a skos:Concept ;
    skos:definition "Organized and often detailed proposals that lay out strategies and schemes of action for development and maintenance of a city or municipal area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal plans"@en .

aat:300027314 a skos:Concept ;
    skos:definition "Organized and often detailed proposals that lay out strategies and schemes of action for development and maintenance of a relatively large region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional plans"@en .

aat:300027316 a skos:Concept ;
    skos:definition "Records of meetings, conferences, learned societies, or other organizations, usually published, and frequently accompanied by abstracts or reports of papers presented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proceedings"@en .

aat:300027323 a skos:Concept ;
    skos:definition "Reports giving details and results of a specific investigation of a scientific or technical problem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical reports"@en .

aat:300027327 a skos:Concept ;
    skos:definition "Documents required by state and federal law that contain an analysis and report of the effects of major projects or programs on the quality of human, plant, or animal habitats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental impact statements"@en .

aat:300027335 a skos:Concept ;
    skos:definition "Reports on the results of tests or examinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "test reports"@en .

aat:300027337 a skos:Concept ;
    skos:definition "Books that contain actual samples, not just illustrations, usually of merchandise available for purchase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sample books"@en .

aat:300027339 a skos:Concept ;
    skos:definition "Plans of procedure, showing the sequence of items or operations and the time allotted for each."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schedules"@en .

aat:300027341 a skos:Concept ;
    skos:definition "Blank books or albums designed so that a variety of items may be affixed to the pages, including photographs, clippings, and other memorabilia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrapbooks"@en .

aat:300027343 a skos:Concept ;
    skos:definition "Books in which to keep records of a child's birth and development through infancy, usually in the form of an album to hold pictures and other memorabilia as well as text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby books"@en .

aat:300027345 a skos:Concept ;
    skos:definition "Albums or notebooks used by the bride to plan a wedding, including notes, lists, photographs, fabric samples, and other information regarding wedding planning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridal books"@en .

aat:300027349 a skos:Concept ;
    skos:definition "A conceptual grouping of visual arts works, literary works, or performance art created in succession by the same author, artist, or studio and intended by the creator(s) to be seen together or in succession as a cycle of works. Works in a series typically share the same or related subjects, the same or similar media, or other characteristics, but their defining characteristic is that they were intended to be conceptually related as a series. Individual items in a series may be cataloged separately and linked to the series."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "series"@en .

aat:300027352 a skos:Concept ;
    skos:definition "Papers carried by a vessel on a voyage, in order to furnish evidence of its national character, nature and destination of cargo, and of compliance with navigation laws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships' papers"@en .

aat:300027354 a skos:Concept ;
    skos:definition "Books or pads of blank sheets used or intended for sketching, which are informal or rough drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sketchbooks"@en .

aat:300027362 a skos:Concept ;
    skos:definition "Official records, in book form, of the pedigree of purebred animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studbooks"@en .

aat:300027363 a skos:Concept ;
    skos:definition "Complementary parts or sections added to serial or monographic books or documents to give further information, update information, or correct errors. Includes separate sections devoted to special subjects inserted into newspapers or periodicals. Supplements may be issued with the text or separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supplements"@en .

aat:300027364 a skos:Concept ;
    skos:definition "Condensed, orderly arrangements of data, especially those in which the data are arranged in columns and rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables"@en .

aat:300027365 a skos:Concept ;
    skos:definition "Tables for changing the values of units, typically of measure or weight, into equivalants in different systems of measure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conversion tables"@en .

aat:300027371 a skos:Concept ;
    skos:definition "Collections of documents associated with the assessment and payment of taxes, including tax returns, tax bills, and warrant books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tax records"@en .

aat:300027374 a skos:Concept ;
    skos:definition "Statements of money owed by individuals or corporate bodies for compulsory contributions to the support of government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tax bills"@en .

aat:300027376 a skos:Concept ;
    skos:definition "Books which record the collection of unpaid taxes and the seizure and sale of property due to unpaid taxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warrant books"@en .

aat:300027381 a skos:Concept ;
    skos:definition "Slips of paper or cardboard serving as evidence that the holder has paid a fare or admission or is entitled to some service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tickets"@en .

aat:300027384 a skos:Concept ;
    skos:definition "Official notices of traffic offenses, issued by police officers or members of a traffic control department."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic tickets"@en .

aat:300027388 a skos:Concept ;
    skos:definition "Written, printed, or typed copies of an original text or of words originally spoken, such as of court proceedings, broadcasts, or oral histories. Transcripts are extremely accurate copies with any editorial explanations or notations clearly distinguished from the original, including indications of misspellings or editorial omissions. For less formal copying, or for short documents or single words such as in a vocabulary, use \"transcriptions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transcripts"@en .

aat:300027389 a skos:Concept ;
    skos:definition "Translated versions of a text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "translations"@en .

aat:300027390 a skos:Concept ;
    skos:definition "Letters or characters from one alphabet displayed or exchanged for those of another that represent similar sounds in another language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transliterations"@en .

aat:300027391 a skos:Concept ;
    skos:definition "Official documents used during travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel documents"@en .

aat:300027392 a skos:Concept ;
    skos:definition "Official documents issued by a government that certify the identity and citizenship of individuals and grant them permission to travel abroad; includes permits issued by foreign countries allowing goods to be transported or persons to travel within that country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passports"@en .

aat:300027395 a skos:Concept ;
    skos:definition "Official endorsements made on passports by proper officials denoting a passport has been examined and the bearer is permitted to proceed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visas"@en .

aat:300027396 a skos:Concept ;
    skos:definition "Public records kept by a state, city, or other governmental subdivision, under a statutory provision, of births, deaths, marriages, diseases, divorces, and other life events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vital statistics records"@en .

aat:300027397 a skos:Concept ;
    skos:definition "Official documentation concerning dates and places of persons' births, as well as parentage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth records"@en .

aat:300027399 a skos:Concept ;
    skos:definition "Formal documents certifying the date and place of persons' births and their parentage, as issued by an official in charge of such records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth certificates"@en .

aat:300027401 a skos:Concept ;
    skos:definition "Official lists of recorded births, including details considered sufficiently important to be formally noted, and maintained in a regular manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth registers"@en .

aat:300027403 a skos:Concept ;
    skos:definition "Official records of deaths kept by public officials charged with registering deaths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "death records"@en .

aat:300027405 a skos:Concept ;
    skos:definition "Official lists of recorded deaths, including details considered sufficiently important to be formally noted, and maintained in a regular manner for a community; typically including the names of the deceased, dates of death, living relatives, and often location and cause of death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "death registers"@en .

aat:300027408 a skos:Concept ;
    skos:definition "Official documentation of burial kept by officials charged with registering interment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial records"@en .

aat:300027410 a skos:Concept ;
    skos:definition "Certificates issued by public officials stating that a person has died; often include the cause of death and the signature of the attending or examining physician."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "death certificates"@en .

aat:300027412 a skos:Concept ;
    skos:definition "Documents kept by a state, city, or town official which are permanent records of marriages and which include the names of the spouses, the maiden name of the wife, their addresses, and the date of marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage records"@en .

aat:300027414 a skos:Concept ;
    skos:definition "Records documenting the legal separation of husband and wife, effected by the judgment or decree of a court, and either totally dissolving the marriage relation, or suspending its effects so far as concerns the cohabitation of the parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divorce records"@en .

aat:300027418 a skos:Concept ;
    skos:definition "Certificates which serve as evidence of marriage, and are executed by the persons officiating at the marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage certificates"@en .

aat:300027420 a skos:Concept ;
    skos:definition "Licenses granted by public authority to persons who intend to marry, usually addressed to the authorized person who is to perform the ceremony, and usually a legal prerequisite to the marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage licenses"@en .

aat:300027422 a skos:Concept ;
    skos:definition "Official lists of marriages, including details considered sufficiently important to be formally noted, and maintained in a regular manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage registers"@en .

aat:300027425 a skos:Concept ;
    skos:definition "Records that relate to budget, personnel, supply, and similar facilitative operations within an organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administrative records"@en .

aat:300027426 a skos:Concept ;
    skos:definition "Documents, often in list form, stating things to be done, as items of business or discussions to be brought up at a meeting; includes programs consisting of such items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agendas"@en .

aat:300027427 a skos:Concept ;
    skos:definition "Any writing made or proposed as an addition to or improvement of some principal writing; in legislation, refers to modifications or alterations in a bill or enacted law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amendments"@en .

aat:300027428 a skos:Concept ;
    skos:definition "Sheets of paper, cards, or other devices used to cast a vote or announce a slate of candidates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballots"@en .

aat:300027433 a skos:Concept ;
    skos:definition "Laws, ordinances, or regulations made by a public or private corporation, association, or unincorporated society for the regulation of its own local or internal affairs, for its dealings with others, or for the government of its members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bylaws"@en .

aat:300027437 a skos:Concept ;
    skos:definition "Documents embodying the fundamental organic law of government of a nation, state, society, or other organized body; laying down fundamental rules and principles for the conduct of affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constitutions"@en .

aat:300027440 a skos:Concept ;
    skos:definition "Records of what was said and done at meetings or conferences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minutes"@en .

aat:300027441 a skos:Concept ;
    skos:definition "Records maintained by an organization for each of its employees giving personal details and information relating to their service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personnel records"@en .

aat:300027443 a skos:Concept ;
    skos:definition "Records maintained by an organization regarding the action or fact of individuals being present to take part in social transactions, entertainment, instruction, worship, or in answer to a summons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attendance records"@en .

aat:300027445 a skos:Concept ;
    skos:definition "Transcribed collections of names indicating tallies of the action or fact of being present, in answer to a summons, or to take part in public business, entertainment, instruction, worship or any other purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attendance lists"@en .

aat:300027447 a skos:Concept ;
    skos:definition "Formal requests submitted to an institution or individual as part of a selection process for a paid position, employment, or post."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "job applications"@en .

aat:300027451 a skos:Concept ;
    skos:definition "Brief records of one's personal history, career, qualifications, and experience, such as that submitted with a job application."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "résumés"@en .

aat:300027457 a skos:Concept ;
    skos:definition "Formal expressions of the opinion formed by some superior authority on matters referred to its decision and forwarded to inferior authorities for their instruction and government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resolutions"@en .

aat:300027458 a skos:Concept ;
    skos:definition "Authoritative instructions for conduct or prescriptive instructions regarding a certain procedure, activity, or topic. Examples are instructions governing procedure in documentation or cataloging, for a legislative body, game, sport, or contest. For less prescriptive recommendations, use \"guidelines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rules"@en .

aat:300027459 a skos:Concept ;
    skos:definition "Rules made by a legislative body concerning the mode and manner of conducting its business and for the purpose of making an orderly and proper disposition of the matters before it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rules of procedure"@en .

aat:300027462 a skos:Concept ;
    skos:definition "Administrative records that document work processes through completion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work-flow documents"@en .

aat:300027463 a skos:Concept ;
    skos:definition "Documents that outline the achievement of stated goals during a specified time period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "progress reports"@en .

aat:300027467 a skos:Concept ;
    skos:definition "Outlines of work or goals expected to be achieved during a projected time period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "progress schedules"@en .

aat:300027471 a skos:Concept ;
    skos:definition "Chronological registers that define working hours, shifts, or time frames applicable to proposed undertakings or creations, and that are used as input to the planning process for developing a schedule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "project calendars"@en .

aat:300027473 a skos:Concept ;
    skos:definition "Documents pertaining to money matters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "financial records"@en .

aat:300027474 a skos:Concept ;
    skos:definition "Recorded statements of evaluation or estimate of the market or other value, cost, utility, or other attribute of land, buildings, works of art, or other objects of property, by qualified persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appraisals"@en .

aat:300027475 a skos:Concept ;
    skos:definition "Final reports following formal examinations of accounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audits"@en .

aat:300027476 a skos:Concept ;
    skos:definition "The statements, usually monthly, rendered by a bank to a depositor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bank statements"@en .

aat:300027478 a skos:Concept ;
    skos:definition "Books held by depositors in which a bank enters a record of the depositor's transactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bankbooks"@en .

aat:300027480 a skos:Concept ;
    skos:definition "Documents created or amassed by those who keep a merchant’s books or accounts in pursuance of its legal obligations or in the transaction of business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookkeeping records"@en .

aat:300027483 a skos:Concept ;
    skos:definition "Books in which financial accounts are kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "account books"@en .

aat:300027486 a skos:Concept ;
    skos:definition "Statements of the financial condition, as of a corporation, at a given date showing the equality of total assets to total liabilities plus net worth, or of total liabilities to total assets plus deficit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balance sheets"@en .

aat:300027488 a skos:Concept ;
    skos:definition "Books in which entries of transactions or occurrences are made as they take place, usually pending their transfer to permanent record books; such as a police blotter or general merchandise store blotter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blotters"@en .

aat:300027489 a skos:Concept ;
    skos:definition "Volumes used in bookkeeping containing daily records of receipts and expenditures in the order of their occurrence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daybooks"@en .

aat:300027491 a skos:Concept ;
    skos:definition "Official lists that record financial transactions, typically maintained by those who manage a business’s accounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookkeeping registers"@en .

aat:300027493 a skos:Concept ;
    skos:definition "Books of original entry in which a record is kept of all cash receipts, disbursements, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cashbooks"@en .

aat:300027496 a skos:Concept ;
    skos:definition "Documents in which are entered debits, credits, and all other money transactions under each individual account or heading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ledgers"@en .

aat:300027497 a skos:Concept ;
    skos:definition "The records relating to the authorization, computation, distribution, and payment of wages and salaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "payroll records"@en .

aat:300027499 a skos:Concept ;
    skos:definition "Individual pay records of members of the armed forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paybooks"@en .

aat:300027502 a skos:Concept ;
    skos:definition "Lists, sometimes recorded in book form, of those entitled to receive compensation at a given time and of the amounts due to each."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "payrolls"@en .

aat:300027503 a skos:Concept ;
    skos:definition "Books in which hours spent on a job by workers are recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time books"@en .

aat:300027505 a skos:Concept ;
    skos:definition "Cards, either maintained by each employee or stamped by a time clock, recording the arrival and departure of an employee each day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time cards"@en .

aat:300027507 a skos:Concept ;
    skos:definition "Sheets for recording the times of arrival and departure of workers and for recording the amount of time spent upon each job; also sheets for totalling the hours worked by each worker during a pay period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time sheets"@en .

aat:300027514 a skos:Concept ;
    skos:definition "Statements of revenue and expenditure, financial proposals or schemes for a public body or the domestic accounts of a family or individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "budgets"@en .

aat:300027515 a skos:Concept ;
    skos:definition "Books containing blank checks on a bank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkbooks"@en .

aat:300027518 a skos:Concept ;
    skos:definition "Parts of bank checks that are retained as records of transactions and that are retained by the issuer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "check stubs"@en .

aat:300027521 a skos:Concept ;
    skos:definition "Documents that record an individual's or corporate body's past loan and repayment history, including information about late payments or bankruptcy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credit records"@en .

aat:300027523 a skos:Concept ;
    skos:definition "Documents related to insurance policies including explanations of benefits, claims, bills from medical offices, notices of supplemental insurance programs, or premium payment notices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurance records"@en .

aat:300027525 a skos:Concept ;
    skos:definition "Formal requests to insurance companies demanding payment based on the terms of an insurance policy. Claims are reviewed for their validity by the policy grantor and subsequently paid out to the insured or requesting party if approved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurance claims"@en .

aat:300027527 a skos:Concept ;
    skos:definition "Documents by which one party (the insurer) in consideration of a premium, engages to indemnify another (the insured) against a contingent loss, by making a payment in compensation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurance policies"@en .

aat:300027529 a skos:Concept ;
    skos:definition "Collections of data gathered and examined for the purpose of formulating insurance policies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurance surveys"@en .

aat:300027531 a skos:Concept ;
    skos:definition "Documents expressing the conveyance of property upon condition, such as that money will be paid or a duty will be performed, which operates as a lien, so that the issuer may, under certain conditions, take possession and foreclose the property upon default."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortgages"@en .

aat:300027532 a skos:Concept ;
    skos:definition "Certificates attached to bills of exchange drawn against shipments of property that empower the holder to dispose of merchandise as security for the payment of the bill if payment or acceptance is refused."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypothecation certificates"@en .

aat:300027536 a skos:Concept ;
    skos:definition "Surety bonds executed by the bidder on a construction project that serve as a guarantee that the bidder will enter into a contract within a specified time and furnish any required bonds ensuring completion of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bid bonds"@en .

aat:300027550 a skos:Concept ;
    skos:definition "Use both for letters addressed by a bank to a correspondent certifying that a person named therein is entitled to draw upon his credit up to a certain sum and for letters addressed by a banker to a person to whom credit is given, authorizing that person to draw on the issuing bank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of credit"@en .

aat:300027558 a skos:Concept ;
    skos:definition "Certificates of a corporation or joint stock company that a named person is owner of the designated number of shares of stock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock certificates"@en .

aat:300027563 a skos:Concept ;
    skos:definition "In investments, all securities held by one person or institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portfolios"@en .

aat:300027564 a skos:Concept ;
    skos:definition "Statements showing the income and expense accounts of a business over a stated time, the difference being the profit or loss for the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "profit and loss statements"@en .

aat:300027566 a skos:Concept ;
    skos:definition "Documents that serve as the evidence or record of cash and credit sales, including sales orders, tickets, slips, invoices, journals and summaries, and customers' ledgers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sales records"@en .

aat:300027568 a skos:Concept ;
    skos:definition "Documents showing items supplied, together with the prices charged for each; also, itemized bills or accounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invoices"@en .

aat:300027570 a skos:Concept ;
    skos:definition "Documents authorizing a vendor to deliver materials or equipment, or to perform services, which upon acceptance constitutes a purchase contract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purchase orders"@en .

aat:300027572 a skos:Concept ;
    skos:definition "Written demands that something be furnished; also demands or applications made, usually with authority, as a demand made by military authorities upon civilians for supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "requisitions"@en .

aat:300027573 a skos:Concept ;
    skos:definition "Written acknowledgment of the receiving or taking of goods or money delivered or paid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "receipts"@en .

aat:300027574 a skos:Concept ;
    skos:definition "Documents serving as evidence or proof, specifically, a receipt or statement attesting to the expenditure or receipt of money, usually accompanied by bills or other evidence of indebtedness or expenditure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vouchers"@en .

aat:300027578 a skos:Concept ;
    skos:definition "Written receipts given by a carrier for goods accepted for transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bills of lading"@en .

aat:300027581 a skos:Concept ;
    skos:definition "Lists or invoices of cargo or passengers, as of a ship or plane, usually containing marks or indications of contents or commodity, consignee, and other pertinent information for use at terminals or customhouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manifests"@en .

aat:300027582 a skos:Concept ;
    skos:definition "Lists or invoices of cargo on a ship, usually containing marks or indication of contents or commodity, consignee, and other pertinent information for use at terminals or customhouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships' manifests"@en .

aat:300027584 a skos:Concept ;
    skos:definition "Documents filed with a state or local agency used to calculate income tax or other taxes. Tax returns are normally prepared using forms created by the taxing authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tax returns"@en .

aat:300027588 a skos:Concept ;
    skos:definition "Documents in which are expressed security transactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trust receipts"@en .

aat:300027590 a skos:Concept ;
    skos:definition "General term for documents having legal relevance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal documents"@en .

aat:300027594 a skos:Concept ;
    skos:definition "Sworn statements in writing; especially made upon oath before an authorized magistrate or officer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "affidavits"@en .

aat:300027597 a skos:Concept ;
    skos:definition "Written agreements embodying the purposes or other conditions of the association of a number of persons for the pursuit of a joint enterprise; especially those duly executed and filed with a state's administrative authorities so as to have the force of a charter under general incorporation law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "articles of incorporation"@en .

aat:300027599 a skos:Concept ;
    skos:definition "Official records or accounts related to a legal declaration of insolvency, accompanied by abstracts or reports of papers presented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bankruptcy proceedings"@en .

aat:300027601 a skos:Concept ;
    skos:definition "Papers filed in a court of bankruptcy by a debtor seeking the benefits of the bankruptcy act, or by creditors alleging the commission of an act of bankruptcy by their debtor and seeking an adjudication of bankruptcy against the debtor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petitions for bankruptcy"@en .

aat:300027603 a skos:Concept ;
    skos:definition "Agreements pledging liability for financial or personal loss caused to another party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonds"@en .

aat:300027604 a skos:Concept ;
    skos:definition "Bonds executed by defendants or those legally liable for debt, that state defendants will appear in court when required and that in the event defendants fail to appear, the signers of the bonds will pay to the court the amount of money specified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bail bonds"@en .

aat:300027606 a skos:Concept ;
    skos:definition "Guarantees provided by a bonding or surety agency to the principle shareholder of a construction project on behalf of a contractor. These bonds cover payment for equipment, labor, goods and services in the event that the contractor fails to pay for them under the terms of a contract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labor and material bonds"@en .

aat:300027610 a skos:Concept ;
    skos:definition "Surety bonds submitted by a contractor that guarantees payment of all sums owed to its employees, suppliers, and subcontractors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "payment bonds"@en .

aat:300027612 a skos:Concept ;
    skos:definition "Bonds of the contractor in which a surety guarantees to the owner that the work will be performed in accordance with the contract documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performance bonds"@en .

aat:300027614 a skos:Concept ;
    skos:definition "Performance or surety bonds furnished by a subcontractor to a prime contractor as guarantee of payment and delivery for all associated equipment, labor, and materials for a specific contract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subcontractor bonds"@en .

aat:300027616 a skos:Concept ;
    skos:definition "Legal instruments under which one party guarantees to pay a second party for the debt, default, or failure to perform of a third party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surety bonds"@en .

aat:300027618 a skos:Concept ;
    skos:definition "Concise statements of the arguments of a party to a case in dispute, submitted to the court or other body hearing the case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "briefs"@en .

aat:300027619 a skos:Concept ;
    skos:definition "Documents issued by the Secretary of State or other state official, establishing a corporation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates of incorporation"@en .

aat:300027621 a skos:Concept ;
    skos:definition "Documents, usually sealed, granting specific rights, setting forth aims and principles of a newly established entity, and often embodying formal agreements and authorizing special privileges or exemptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charters"@en .

aat:300027622 a skos:Concept ;
    skos:definition "Documents asserting a right, including titles to debts, privileges, or other things in possession of another; also includes titles to anything which another should give, concede, or confer on the claimant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claims"@en .

aat:300027626 a skos:Concept ;
    skos:definition "Use with specific reference to documents, such as drawings and specifications, associated with a construction project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contract documents"@en .

aat:300027628 a skos:Concept ;
    skos:definition "Writing made to evidence the terms and conditions, or the fact, of an accord or arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agreements"@en .

aat:300027630 a skos:Concept ;
    skos:definition "Bargaining agreements as to wages and conditions of work entered into by groups of employees, usually organized into a union on one side and one or more employers or corporations on the other side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collective labor agreements"@en .

aat:300027638 a skos:Concept ;
    skos:definition "Legally binding instruments between a property owner and a hired contractor for a construction project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "owner-contractor agreements"@en .

aat:300027640 a skos:Concept ;
    skos:definition "Documents embodying the terms and conditions of a partnership, as an association of two or more persons to carry on, as co-owners, a business for profit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partnership agreements"@en .

aat:300027642 a skos:Concept ;
    skos:definition "Written and signed legal documents authorizing a change from the original plans, specifications, or other contract documents, or authorizing a change in the cost of the project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "change orders"@en .

aat:300027646 a skos:Concept ;
    skos:definition "Official statements of awards to independent contractors on project bids. These outline funding, bidders, contract amounts and other pertinent details related to the project at hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contract awards"@en .

aat:300027649 a skos:Concept ;
    skos:definition "Documents, enforceable by law, embodying agreements between two or more competent parties to do or not to do something, and specifying the terms and conditions of the agreement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contracts"@en .

aat:300027651 a skos:Concept ;
    skos:definition "Contracts in which the work of the job is divided into several prime contracts, such as general, mechanical, and electrical, rather than awarded to one contractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divided contracts"@en .

aat:300027653 a skos:Concept ;
    skos:definition "Contracts made between owners and builders other than general contractors for the construction of portions of a project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "separate contracts"@en .

aat:300027655 a skos:Concept ;
    skos:definition "Contracts for construction where all work is contracted under the responsibility of a single or prime general contractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single contracts"@en .

aat:300027657 a skos:Concept ;
    skos:definition "Contracts subordinate to another contract, made or intended to be made between the contracting parties, on one part, or some of them, and a third party (subcontractor)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subcontracts"@en .

aat:300027662 a skos:Concept ;
    skos:definition "Standard forms of agreement, often enforceable by law, between architects and independent contractors hired to complete a project. These contracts specify the terms and conditions of the agreement, in addition to duties, responsibilities, and liabilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architect-consultant contracts"@en .

aat:300027664 a skos:Concept ;
    skos:definition "Legal instruments for government procurement detailing funds spent on supplies, services, and interests in real property by and for the use of a government through purchase or lease, whether the supplies, services, or interests are already in existence or must be created, developed, demonstrated, or evaluated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government contracts"@en .

aat:300027673 a skos:Concept ;
    skos:definition "Agreements or contracts under which the contractor or the architect is reimbursed for the direct and indirect costs of performance of the agreement and in addition is paid a fee for services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cost plus fee agreements"@en .

aat:300027675 a skos:Concept ;
    skos:definition "Contracts based on payment by an agency to a contractor of reasonable costs incurred in the contract performance. These contracts may not require completion of a project, but rather the best efforts of the contractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cost reimbursement contracts"@en .

aat:300027677 a skos:Concept ;
    skos:definition "Types of contracts in which the buyer agrees to pay the seller a definite, predetermined price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed-price contracts"@en .

aat:300027684 a skos:Concept ;
    skos:definition "Documents attesting to the fulfillment of the terms or conditions of a contract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discharges of contracts"@en .

aat:300027686 a skos:Concept ;
    skos:definition "Documents comprised of a project description, including overviews of activities or products to be realized, and instructions for the project organization and methods, tools, and the definition of standards used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "project manuals"@en .

aat:300027690 a skos:Concept ;
    skos:definition "Lists or tables of working drawings or descriptions of the components of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schedules"@en .

aat:300027723 a skos:Concept ;
    skos:definition "Detailed and exact statements of particulars, especially statements prescribing materials, dimensions, and workmanship for something to be built, installed, or manufactured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specifications"@en .

aat:300027725 a skos:Concept ;
    skos:definition "Specifications listing or describing only the materials, equipment, and methods of construction upon which a base bid must be predicated, exclusive of any alternate bids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base bid specifications"@en .

aat:300027727 a skos:Concept ;
    skos:definition "Detailed and exact statements prescribing materials, dimensions, and workmanship for something to be built, installed, or manufactured, stipulating the use of proprietary products or processes without provision for substitution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed specifications"@en .

aat:300027729 a skos:Concept ;
    skos:definition "Detailed and exact statements of particulars describing materials, dimensions, and workmanship for the manufacture or installation of commercial products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial specifications"@en .

aat:300027733 a skos:Concept ;
    skos:definition "Specifications prepared as a standard for a particular type of project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master specifications"@en .

aat:300027735 a skos:Concept ;
    skos:definition "Statements prescribing materials, dimensions, or workmanship for something to be built, installed, or manufactured, and which provide for the submission of equivalent products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "or-equal specifications"@en .

aat:300027737 a skos:Concept ;
    skos:definition "Itemized lists using brief, concise statements of significant materials, systems, and equipment for something to be built, installed, or manufactured, including their criteria and levels of quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outline specifications"@en .

aat:300027739 a skos:Concept ;
    skos:definition "Specifications written according to recognized standards within the building industry, such as ASTM, and containing a complete description of the project including materials, products, designs, functions, and the performance to be expected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performance specifications"@en .

aat:300027741 a skos:Concept ;
    skos:definition "Specifications, often accompanying preliminary drawings, that briefly list the materials and finishes to be used in a building project and serve as the basis for preliminary cost estimates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preliminary specifications"@en .

aat:300027743 a skos:Concept ;
    skos:definition "Specifications describing the brand names, trade names, or manufacturers of equipment or material to be used in a building project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "product specifications"@en .

aat:300027745 a skos:Concept ;
    skos:definition "Specifications giving the names of products and manufacturers and permitting the contractor and the client to exercise close control over product selection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proprietary specifications"@en .

aat:300027749 a skos:Concept ;
    skos:definition "Documents by which a dispute is referred to arbitration pursuant to an agreement between the parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submittals"@en .

aat:300027750 a skos:Concept ;
    skos:definition "Systematically arranged summaries of laws, reported cases, decisions, and other legal documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digests"@en .

aat:300027751 a skos:Concept ;
    skos:definition "Any items, such as deeds, bonds, or monies, held in trust by a third party to be turned over to the grantee upon fulfillment of a condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escrows"@en .

aat:300027752 a skos:Concept ;
    skos:definition "Includes documents expressing special privileges conferred by government on individuals or corporations, any privileges granted or sold, such as to use a name or to sell products or services, and rights given by a manufacturer or supplier to a retailer to use his products or name, on terms and conditions mutually agreed upon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "franchises"@en .

aat:300027753 a skos:Concept ;
    skos:definition "Legally binding agreements between two or more parties in two or more originals or copies. Also, contracts binding one person to work for another for a given period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indentures"@en .

aat:300027754 a skos:Concept ;
    skos:definition "Formal written accusations originating with a prosecutor and issued by a grand jury against a party charged with a crime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indictments"@en .

aat:300027755 a skos:Concept ;
    skos:definition "Contracts by which one conveys land or other property for a specified time usually for compensation or rent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leases"@en .

aat:300027757 a skos:Concept ;
    skos:definition "Announcements required by law to be given for a specific purpose or case; typically required to be published in a newspaper or posted in a court house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal notices"@en .

aat:300027760 a skos:Concept ;
    skos:definition "Documents attesting to acts of registering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registrations"@en .

aat:300027761 a skos:Concept ;
    skos:definition "Legal instruments authorizing one to act as the attorney or agent of the grantor, either generally for the management of a specified enterprise or, specifically, for the accomplishment of a particular transaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powers of attorney"@en .

aat:300027762 a skos:Concept ;
    skos:definition "Written contracts signed by both or all parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syngraphai"@en .

aat:300027763 a skos:Concept ;
    skos:definition "Guarantees with reference to goods offered for sale which assure that a breach may be answered by a claim for damages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warranties"@en .

aat:300027764 a skos:Concept ;
    skos:definition "Legal instruments in which a person declares the disposition of his/her property, to take effect after his/her death, and which is revocable during the lifetime of that person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wills"@en .

aat:300027772 a skos:Concept ;
    skos:definition "Records evidencing the creation or existence of a corporate body, such as charters or articles of incorporation; also used generally to refer to records growing out of a corporate enterprise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporation records"@en .

aat:300027777 a skos:Concept ;
    skos:definition "Records made or received by an agency of government and maintained in the conduct of government business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government records"@en .

aat:300027791 a skos:Concept ;
    skos:definition "Executive records or documents related to the judicial process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judicial executive records"@en .

aat:300027793 a skos:Concept ;
    skos:definition "Documents amassed in the course of a presidential term that may include diaries, letter books, general and special correspondence, speeches, executive orders, press releases, scrap books and other miscellanea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presidential papers"@en .

aat:300027798 a skos:Concept ;
    skos:definition "Certificates that attest to the copyright status of a thing or idea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copyright certificates"@en .

aat:300027804 a skos:Concept ;
    skos:definition "Records tracking the goods passing through and fees collected at customs, which is the area at a seaport, airport, etc., where goods, luggage, and other incoming items are examined and customs duties levied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "customs records"@en .

aat:300027806 a skos:Concept ;
    skos:definition "Orders or regulations issued by the President, or some administrative authority under his direction, for the purpose of interpreting, implementing, or giving administrative effect to a provision of the Constitution or of some law or treaty. May also include similar state documents issued by governors or upper-level management in business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executive orders"@en .

aat:300027808 a skos:Concept ;
    skos:definition "Official records containing the names, dates of entry, ages, occupations, and other information about immigrants to a country, typically taken at the point of entry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immigration records"@en .

aat:300027814 a skos:Concept ;
    skos:definition "Documents officially certifying that premises conform to provisions of the zoning ordinance and building code and may be used or occupied; granted for new construction or for alteration or additions to existing structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates of occupancy"@en .

aat:300027819 a skos:Concept ;
    skos:definition "Originally, letters granted by a sovereign authorizing an individual to seize the subjects of a foreign state, or their goods, by way of retaliation or reprisal for injuries; later, specifically, any license or extraordinary commission granted by a government to a private person to command an armed vessel at sea to take an enemy's ships and merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of marque"@en .

aat:300027820 a skos:Concept ;
    skos:definition "Written communications, usually signed and sealed from a government or sovereign of a nation, conferring upon a designated person a grant (as a right, title, status, property, authority, privilege, monopoly, franchise, immunity, or exemption) that could not otherwise be enjoyed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters patent"@en .

aat:300027821 a skos:Concept ;
    skos:definition "Letters which bear an official seal, usually authorizing imprisonment without trial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettres de cachet"@en .

aat:300027822 a skos:Concept ;
    skos:definition "Official documents detailing an individual’s service and conduct while in military service, including certificates of discharge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military records"@en .

aat:300027824 a skos:Concept ;
    skos:definition "Warrants conferring authority to raise and command a body of troops; certificates conferring military or naval rank and authority on officers of certain rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military commissions"@en .

aat:300027826 a skos:Concept ;
    skos:definition "Documents giving permission to one or more military persons to travel unimpeded, although usually with some restrictions, in a territory occupied by a military force; issued to a person or persons living in, or visiting in, the occupied area, by the commander of the military force in control thereof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military passes"@en .

aat:300027828 a skos:Concept ;
    skos:definition "Lists of troops actually present, made on the day of muster or review of troops in order to take account of their condition; used as the paymaster's voucher for the pay he issued."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muster rolls"@en .

aat:300027830 a skos:Concept ;
    skos:definition "Documents which evidence the time, place, and court before which an alien is admitted to the rights and status of citizenship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naturalization records"@en .

aat:300027831 a skos:Concept ;
    skos:definition "Official documents declaring the exemption of a convicted person from the penalties of an offense or crime by the power of the executor of laws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pardons"@en .

aat:300027832 a skos:Concept ;
    skos:definition "Grants made by a government to an inventor, assuring the inventor the sole right to make, use, and sell the invention for a certain period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patents"@en .

aat:300027833 a skos:Concept ;
    skos:definition "Documents which grant a person the right to do something not forbidden by law but not allowable without such authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permits"@en .

aat:300027834 a skos:Concept ;
    skos:definition "Permits required by local governmental bodies for new building, or for major alteration or expansion of existing structures. Applications, building plans, estimated costs, and a fee are usually required before a permit is issued."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building permits"@en .

aat:300027838 a skos:Concept ;
    skos:definition "Permits granted by public officials authorizing the wrecking or destruction of property, especially by the use of explosives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demolition permits"@en .

aat:300027842 a skos:Concept ;
    skos:definition "Broad term for principles, rules, or laws designed to control or regulate behavior of individuals, corporations, or other entities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regulations"@en .

aat:300027843 a skos:Concept ;
    skos:definition "Regulations issued by a governmental agency, having the force of law, to interpret or implement the provisions of a statute. For acts of a legislature declaring, commanding, or prohibiting something, and that constitute the law, use \"statutes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administrative regulations"@en .

aat:300027845 a skos:Concept ;
    skos:definition "Systematically arranged and comprehensive collections of laws, or, more generally, systematic collections of regulations and rules of procedure or conduct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codes"@en .

aat:300027846 a skos:Concept ;
    skos:definition "Laws, ordinances, or government regulations concerning fitness for habitation setting forth standards and requirements for the construction, maintenance, operation, occupancy, use, or appearance of buildings, premises, and dwelling units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building codes"@en .

aat:300027850 a skos:Concept ;
    skos:definition "Records of a tribunal established for the administration of justice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judicial records"@en .

aat:300027857 a skos:Concept ;
    skos:definition "Conclusions or resolutions reached after consideration by a judicial body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decisions"@en .

aat:300027859 a skos:Concept ;
    skos:definition "Commands to appear at a certain time and place to give testimony upon a certain matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subpoenas"@en .

aat:300027860 a skos:Concept ;
    skos:definition "Instruments delivered by a sheriff or other appropriate party, notifying a person that a court action has been commenced against the person and that the person is required to appear in court on the day named to answer the complaint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summonses"@en .

aat:300027861 a skos:Concept ;
    skos:definition "Solemn declarations, written or verbal; usually made orally by a witness under oath in response to interrogation by a lawyer or authorized public official, then reduced to writing for the record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testimonies"@en .

aat:300027862 a skos:Concept ;
    skos:definition "Testimonies of witnesses, under oath or affirmation, before a person empowered to administer oaths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depositions"@en .

aat:300027863 a skos:Concept ;
    skos:definition "Documents giving authority to do something; especially used in civil and criminal law for the arrest of persons or for their production in court as witnesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warrants"@en .

aat:300027864 a skos:Concept ;
    skos:definition "Orders in writing, issued under seal (in the name of the sovereign or a court or judicial officer) from the proper authority, commanding the person to whom it is directed to perform or refrain from performing an act specified therein."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writs"@en .

aat:300027866 a skos:Concept ;
    skos:definition "Documents that are a product of courts dealing with civil, rather than criminal cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil court records"@en .

aat:300027868 a skos:Concept ;
    skos:definition "Records generated by probate courts, which have general powers over the probate of wills, administration of estates, and, in some states, over the appointment of guardians or the adoption of minors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "probate records"@en .

aat:300027870 a skos:Concept ;
    skos:definition "Documents generated, collected, or maintained by the executor of an estate. These generally include correspondence, memos, estate and income tax returns, probate court paperwork, insurance policies, records of debt and claims against the estate, and papers related to all assets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estate administration records"@en .

aat:300027873 a skos:Concept ;
    skos:definition "Formal documents issued by probate courts that serve to appoint an administrator of an estate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of administration"@en .

aat:300027875 a skos:Concept ;
    skos:definition "Written communications from a court, usually a probate court, or an officer informing an executor of his appointment and authority to execute the will of the testator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters testamentary"@en .

aat:300027876 a skos:Concept ;
    skos:definition "Lists, catalogs, accounts, or schedules, made by an estate executor or administrator of the tangible and intangible property of the estate, describing the items or classes of property so as to be identifiable and usually placing a value on each."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estate inventories"@en .

aat:300027881 a skos:Concept ;
    skos:definition "Lists, catalogs, accounts, or schedules, made by an estate executor, describing items of property as they appear in a particular physical environment, so as to be identifiable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "room-by-room inventories"@en .

aat:300027883 a skos:Concept ;
    skos:definition "Documents that are a product of courts dealing with criminal, rather than civil cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "criminal court records"@en .

aat:300027885 a skos:Concept ;
    skos:definition "Records documenting deliberations and decisions of a legislative body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legislative records"@en .

aat:300027888 a skos:Concept ;
    skos:definition "Drafts of proposed laws introduced in a legislative body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bills"@en .

aat:300027889 a skos:Concept ;
    skos:definition "Laws or statutes passed by a legislature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legislative acts"@en .

aat:300027891 a skos:Concept ;
    skos:definition "Acts of a legislature declaring, commanding, or prohibiting something, expressed according to the forms necessary to constitute law. For regulations having the force of law issued by a government agency in order to interpret or implement the provisions of a statute, use \"administrative regulations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statutes"@en .

aat:300027894 a skos:Concept ;
    skos:definition "Documents stating rules of action or conduct prescribed by controlling authority and having binding legal force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laws"@en .

aat:300027895 a skos:Concept ;
    skos:definition "Statutes or regulations, especially as enacted by local government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordinances"@en .

aat:300027905 a skos:Concept ;
    skos:definition "Documents recording the procedures of the House of Representatives and the Senate of the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "congressional records"@en .

aat:300027907 a skos:Concept ;
    skos:definition "Documents of deliberations and decisions of meetings of the United States Congress that are charged with a specific duty, rather than the general duties of Congress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "congressional committee records"@en .

aat:300027909 a skos:Concept ;
    skos:definition "Documents accompanying measures reported from a committee of the United States Congress. These contain explanations of the provisions of the measure, arguments for its approval, votes held in markup, individual committee members’ opinions, cost estimates, and other information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "congressional committee reports"@en .

aat:300027911 a skos:Concept ;
    skos:definition "Collected documents on policy making, correspondence, investigation and reporting related to legislation, or the political environment of the House of Representatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "House of Representatives records"@en .

aat:300027913 a skos:Concept ;
    skos:definition "Collected documents on investigation and reporting related to legislation, policy making, correspondence, or the political environment of the U.S. Senate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Senate records"@en .

aat:300027915 a skos:Concept ;
    skos:definition "Collective term for various documents presented to the House of Parliament. These consist of annual reports from government departments, or of organizations created by an Act of Parliament, regulations made by any Minister of the Crown under the authority of an Act of Parliament, and miscellaneous letters, typescripts and photocopies of documents presented by members with the House’s permission during the course of debates or other proceedings in the House."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parliamentary papers"@en .

aat:300027919 a skos:Concept ;
    skos:definition "Texts of legislative initiatives that a Minister of the Crown submits to Parliament to be approved, and possibly amended, before becoming law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "House of Commons bills"@en .

aat:300027921 a skos:Concept ;
    skos:definition "Collected documents on policy making, correspondence, investigation and reporting related to legislation, or the political environment of the House of Commons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "House of Commons papers"@en .

aat:300027923 a skos:Concept ;
    skos:definition "Collected documents on policy making, correspondence, investigation and reporting related to legislation, or the political environment of the House of Lords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "House of Lords papers"@en .

aat:300027928 a skos:Concept ;
    skos:definition "Documents created by county governments including records such as bonds, census reports, court records, land records, estates, marriage records, tax records, wills, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "county government records"@en .

aat:300027931 a skos:Concept ;
    skos:definition "Records made or received by the governing body of incorporated localities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal government records"@en .

aat:300027937 a skos:Concept ;
    skos:definition "Records in which documents from various governmental jurisdictions are represented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intergovernmental records"@en .

aat:300027942 a skos:Concept ;
    skos:definition "Records made or received by an agency of a state government and maintained in the conduct of state government business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state government records"@en .

aat:300027945 a skos:Concept ;
    skos:definition "Records made or received by an agency of the government of a nation-state and maintained in the conduct of national business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national government records"@en .

aat:300027948 a skos:Concept ;
    skos:definition "Books, papers, maps, photographs, machine-readable materials, or other documentary materials, regardless of physical form or characteristics, made or received by an agency of a federal government in connection with the transaction of public business and preserved or appropriate for preservation by that agency or its legitimate successor as evidence of the organization, functions, policies, decisions, procedures, operations, or other activities of the government, or because of the informational value of the data in them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federal government records"@en .

aat:300027954 a skos:Concept ;
    skos:definition "Treaties and other agreements of a contractual character between different countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international agreements"@en .

aat:300027956 a skos:Concept ;
    skos:definition "Agreements or contracts made between two or more states, formally signed by duly authorized representatives, and usually ratified by the lawmaking authority of the states, as treaties of peace or alliance, or commercial treaties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treaties"@en .

aat:300027957 a skos:Concept ;
    skos:definition "Records located in a hospital and having to do with individual patient admittance, care, and other matters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospital records"@en .

aat:300027959 a skos:Concept ;
    skos:definition "Records having to do with the history and transactions of a manor house and its estate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manorial records"@en .

aat:300027963 a skos:Concept ;
    skos:definition "Records to the history of founding and details of collecting, loans, and other transactions of a museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museum records"@en .

aat:300027967 a skos:Concept ;
    skos:definition "Records maintained by or relating to a particular church and its activities, such as baptisms and burials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church records"@en .

aat:300027970 a skos:Concept ;
    skos:definition "Certificates that record the administration of the sacrament of baptism for an individual. Where the custom is to baptize infants, in documenting biographies, baptismal certificates are often substituted for birth records that are nonexistent or unobtainable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal certificates"@en .

aat:300027972 a skos:Concept ;
    skos:definition "Short accounts of the news and events of a church or parish, often passed out at weekly services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church bulletins"@en .

aat:300027976 a skos:Concept ;
    skos:definition "Registers that record the administration of the sacrament of baptism to members of a community. In historical usage, these registers also served as important civic documents, in that they recorded the approximate date of birth and names of new babies, their parents, and baptismal sponsors in the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal registers"@en .

aat:300027978 a skos:Concept ;
    skos:definition "Lists of dates and locations of burials within a church, convent, or other institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial registers"@en .

aat:300027980 a skos:Concept ;
    skos:definition "Books with blanks on which those attending a funeral may sign their names and condolences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral registers"@en .

aat:300027987 a skos:Concept ;
    skos:definition "Records of the expenditures and activities of the churchwarden, a lay honorary officer of a parish church who manages secular affairs, particularly those relating to the church building and other property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "churchwardens' accounts"@en .

aat:300027992 a skos:Concept ;
    skos:definition "Records of districts or churches under the jurisdiction of a bishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diocesan records"@en .

aat:300027994 a skos:Concept ;
    skos:definition "Any of various records kept by the parish, including lists of members, activities, and expenditures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parochial records"@en .

aat:300027996 a skos:Concept ;
    skos:definition "Lists of the real estate and belongings of a parish, including chalices, patens, altarpieces, crucifixes, other liturgical equipment, vestments, candles and wax, hymnals, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parish inventories"@en .

aat:300028004 a skos:Concept ;
    skos:definition "Lists of students' names and records of grades, disciplinary issues, and other information pertaining to the education of a student in a given school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school records"@en .

aat:300028009 a skos:Concept ;
    skos:definition "Regular courses of study or training, particularly at a school or university."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curricula"@en .

aat:300028011 a skos:Concept ;
    skos:definition "Formal documents conferring some honor, degree, or privilege, especially those bearing record of graduation from or a degree conferred by an educational institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diplomas"@en .

aat:300028012 a skos:Concept ;
    skos:definition "Collections of materials including teaching material, publications, conference papers, research files, information about grants, curricula, and other materials related to the scholarly and teaching activities of the faculty at a given school or university."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faculty papers"@en .

aat:300028014 a skos:Concept ;
    skos:definition "Books used by teachers to record marks indicating students' grades, levels of accomplishment, or quality of academic work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grade books"@en .

aat:300028015 a skos:Concept ;
    skos:definition "Statements of a student's academic record for a particular period, often including grades and an evaluation of the student's rate of progress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "report cards"@en .

aat:300028024 a skos:Concept ;
    skos:definition "Annual publications by schools that provide information and often photographs relating to activities and the students at the school during the previous year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school yearbooks"@en .

aat:300028026 a skos:Concept ;
    skos:definition "Outlines or brief statements of the main points of a lecture or course of study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syllabi"@en .

aat:300028028 a skos:Concept ;
    skos:definition "Discourses advancing an original point of view as a result of research, especially as a requirement for an academic degree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theses"@en .

aat:300028029 a skos:Concept ;
    skos:definition "Written treatises, or the records of a discourse on a subject, usually prepared and presented as the final requirement for a degree or diploma and typically based on independent research and giving evidence of the candidate's mastery of the subject and of scholarly method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissertations"@en .

aat:300028037 a skos:Concept ;
    skos:definition "Private documents belonging to an individual. For records kept by public officials or other persons for their private or personal use but relating to their official duties, use \"office files.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal papers"@en .

aat:300028040 a skos:Concept ;
    skos:definition "Personal papers of members of a single family; usually of parents and their children, but sometimes including papers of spouses and their families as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "family papers"@en .

aat:300028042 a skos:Concept ;
    skos:definition "Documents amassed in the course of the execution of a vocation, career, or occupation, including correspondence, memos, official forms, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professional papers"@en .

aat:300028045 a skos:Concept ;
    skos:definition "Nonprint materials, such as slides, transparencies, motion pictures, or filmstrips, that make use of sight and sound to convey information; refers especially to such materials when used for instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiovisual materials"@en .

aat:300028048 a skos:Concept ;
    skos:definition "Strips of 16mm or 35mm film varying in length up to about fifty frames and bearing pictures, text, or captions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filmstrips"@en .

aat:300028051 a skos:Concept ;
    skos:definition "Items comprising a collection of leaves of paper, parchment, wood, stiffened textile, ivory, metal tablets, or other flat material, that are blank, written on, or printed, and are strung or bound together in a volume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "books"@en .

aat:300028052 a skos:Concept ;
    skos:definition "Any materials representing, in whole or part, the earth or any celestial body at any scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartographic materials"@en .

aat:300028053 a skos:Concept ;
    skos:definition "Volumes of maps, with or without descriptive text, which may be issued to supplement or accompany texts or be published independently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atlases"@en .

aat:300028065 a skos:Concept ;
    skos:definition "Atlases of a particular region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional atlases"@en .

aat:300028067 a skos:Concept ;
    skos:definition "Atlases of a particular nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national atlases"@en .

aat:300028069 a skos:Concept ;
    skos:definition "Atlases of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "world atlases"@en .

aat:300028085 a skos:Concept ;
    skos:definition "Atlases that includes historical maps and charts depicting the evolving geopolitical landscape, as well ast he scope and scale of historical events and subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical atlases"@en .

aat:300028087 a skos:Concept ;
    skos:definition "Atlases whose function is to display data of the inhabitants of a particilaur area, typically based on census information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statistical atlases"@en .

aat:300028089 a skos:Concept ;
    skos:definition "Representations of the Earth, heavens, or another planet in the form of a ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globes"@en .

aat:300028090 a skos:Concept ;
    skos:definition "Refers to globes that depict the celestial sphere, which is a representation of the heavens in which the stars, constellations, and planets are depicted as if the sky visible from Earth were a ball. They were used for astronomical or astrological calculations or as ornaments. They have been known since the time of the ancient Greeks. The globes are intended to depict the heavens, generally the night sky, that to an observer on Earth appears as a hemisphere resting on the horizon. The eastward rotation of the Earth on its axis produces an apparent diurnal westward rotation of the starry sphere, and the stars seem to rotate around a northern or southern celestial pole. For representations of the celestial sphere projected onto a flat plane, use \"planispheres.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celestial globes"@en .

aat:300028092 a skos:Concept ;
    skos:definition "Refers to spheres that bear a map of the Earth on their surface. They were first devised by the ancient Greeks, who had calculated that the Earth is a sphere. Modern terrestrial globes are typically mounted on an axle that permits rotation and is tilted 23.5 degrees from the vertical in order to simulate the inclination of the Earth relative to the plane in which it orbits the Sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrestrial globes"@en .

aat:300028094 a skos:Concept ;
    skos:definition "Refers to graphic or photogrammetric representations of the Earth's surface or a part of it, including physical features and political boundaries, where each point corresponds to a geographical or celestial position according to a definite scale or projection. The term may also refer to similar depictions of other planets, suns, other heavenly bodies, or areas of the heavens. Maps are typically depicted on a flat medium, such as on paper, a wall, or a computer screen. For similar depictions on a sphere, see \"globes (cartographic spheres).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maps"@en .

aat:300028098 a skos:Concept ;
    skos:definition "Maps representing the horizontal position of land features and not relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planimetric maps"@en .

aat:300028100 a skos:Concept ;
    skos:definition "Outline maps showing the important natural and man-made features of an area, to which specific information may be added for any of various purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base maps"@en .

aat:300028102 a skos:Concept ;
    skos:definition "Maps showing boundaries of subdivisions of land, buildings, or other details for purposes of describing and recording ownership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadastral maps"@en .

aat:300028125 a skos:Concept ;
    skos:definition "Maps, charts, or plans that show the location, boundaries, and ownership of individual properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plats"@en .

aat:300028132 a skos:Concept ;
    skos:definition "Small-scale maps keyed to an atlas or series of maps showing how the total area has been divided up by the individual maps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "index maps"@en .

aat:300028136 a skos:Concept ;
    skos:definition "Maps that show the actual routes and types of construction of wire circuits in an area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line-route maps"@en .

aat:300028140 a skos:Concept ;
    skos:definition "Refers to long, narrow maps that illustrate the course of a road and the places adjacent to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strip maps"@en .

aat:300028142 a skos:Concept ;
    skos:definition "Maps designed primarily to meet specific requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thematic maps"@en .

aat:300028151 a skos:Concept ;
    skos:definition "Maps in which aerial distribution is shown by distinctive colors or tints; most geological, soil, and political maps are of this type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chorochromatic maps"@en .

aat:300028155 a skos:Concept ;
    skos:definition "Maps displaying the distribution of a characteristic, such as precipitation, vegetation, or another feature, by using lines that connect points of equal value. They are distinct from \"contour maps\" in that they typically do not show the distribution of elevation of the landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isoline maps"@en .

aat:300028162 a skos:Concept ;
    skos:definition "Charts used for navigation beyond the earth's atmosphere, including interplanetary or interstellar space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronautical charts"@en .

aat:300028164 a skos:Concept ;
    skos:definition "Refers to maps of the heavens, including the constitution, relative positions, and motions of the heavenly bodies, which are all the bodies in the material universe outside of the Earth, as well as of the Earth itself relative to them. The earliest examples were often decorated with fantastic figures depicting the constellations and recognizable groupings of bright stars, and were primarily used as aids to navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical charts"@en .

aat:300028170 a skos:Concept ;
    skos:definition "Maps that display the geographic distribution of climatic variables, usually in monthly or annual values."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climatic maps"@en .

aat:300028180 a skos:Concept ;
    skos:definition "Maps that display area boundaries of zip codes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zip code maps"@en .

aat:300028187 a skos:Concept ;
    skos:definition "Maps prepared primarily for fire insurance underwriters, showing information, such as type of construction, about structures in a given area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire insurance maps"@en .

aat:300028194 a skos:Concept ;
    skos:definition "Maps showing the structure and composition of the Earth's crust, including the strata of its composition, plates, their mutual relationships, and the successive changes to which their present condition and positions are due."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological maps"@en .

aat:300028200 a skos:Concept ;
    skos:definition "Maps of hydrographic data that may include data on coastal intertidal and shallow water zones, vegetation, contours, land use, drainage, shoreline, wetlands, or other features. These may be rendered in digital or printed form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal zone maps"@en .

aat:300028206 a skos:Concept ;
    skos:definition "Maps which show the spatial distribution of water balance components and water resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrologic maps"@en .

aat:300028208 a skos:Concept ;
    skos:definition "Maps that outline or define the drainage systems or area of a region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watershed maps"@en .

aat:300028210 a skos:Concept ;
    skos:definition "Charts having lines that connect places of equal magnetic declination or variation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isogonic charts"@en .

aat:300028217 a skos:Concept ;
    skos:definition "Geological maps which map mineral deposits and underground mines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mine maps"@en .

aat:300028219 a skos:Concept ;
    skos:definition "Maps showing earthquake-related structural features of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismicity maps"@en .

aat:300028228 a skos:Concept ;
    skos:definition "Charts or maps indicating various existing soils in an area and often indicating particular soil use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil maps"@en .

aat:300028233 a skos:Concept ;
    skos:definition "Refers to maps that indicate political administrative boundaries or other characteristics of a region at periods of time before the present. They typically include historical names for places, historical population dispositions, and the historical state of physical features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical maps"@en .

aat:300028242 a skos:Concept ;
    skos:definition "Maps delineating the boundaries of districts which, along with the zoning text, comprise the zoning ordinances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoning maps"@en .

aat:300028249 a skos:Concept ;
    skos:definition "Refers to maps of a given region, intended to chart the areas covered by forests and other vegetation. They typically record the boundaries of the forest, the relief of the area, assessments of timber volume and expected growth rates, and features or projections related to concerns such as animal or human inhabitants and ecological matters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forestry maps"@en .

aat:300028253 a skos:Concept ;
    skos:definition "Refers to maps created or used in the context of military observations or activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military maps"@en .

aat:300028255 a skos:Concept ;
    skos:definition "Maps that depict the relief and other features of a battlefield, generally including representations of the disposition and movement of troops. It may also include references to military strategies and tactics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battlefield maps"@en .

aat:300028257 a skos:Concept ;
    skos:definition "Charts or maps showing the movements or progress of a ship, submarine, airplane, or other craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plotting charts"@en .

aat:300028259 a skos:Concept ;
    skos:definition "Refers to maps that depict a polar projection, which is an azimuthal projection drawn to show Arctic or Antarctic areas. Such a projection is based on a plane perpendicular to the Earth's axis in contact with the North or South Pole, and is limited to around 10 or 15 degrees from the poles. Parallels of latitude are depicted as concentric circles and meridians are radiating straight lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polar charts"@en .

aat:300028261 a skos:Concept ;
    skos:definition "Refers to maps that show the patterns of populations of people or animals, often within the context of political administrative boundaries. Indications of various demograhic characteristics may be included, such as the life-conditions of communities of people, as shown by statistics of births, deaths, diseases, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "population maps"@en .

aat:300028269 a skos:Concept ;
    skos:definition "Refers to maps that focus on the population patterns as described by a census, which is an official enumeration of the population of a country or district."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "census maps"@en .

aat:300028273 a skos:Concept ;
    skos:definition "Maps that display specific public infrastructure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public utility maps"@en .

aat:300028280 a skos:Concept ;
    skos:definition "Maps that indicate the locations of telecommunications, power, or other types of cable that are routed underground, and act as a guide for workers that are digging into the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buried cable maps"@en .

aat:300028284 a skos:Concept ;
    skos:definition "Maps depicting the locations of natural gas pipelines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural-gas-pipelines maps"@en .

aat:300028294 a skos:Concept ;
    skos:definition "Maps indicating the location of watermains in a building or buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watermain maps"@en .

aat:300028296 a skos:Concept ;
    skos:definition "Small-scale charts of the world designed to show the legal time on land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time zone maps"@en .

aat:300028298 a skos:Concept ;
    skos:definition "Maps intended to introduce a region or locality to tourists, who are visitors to an unfamiliar place, particularly those who travel for pleasure or culture, usually to visit a number of places with the goal of experiencing places of interest and scenery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourist maps"@en .

aat:300028300 a skos:Concept ;
    skos:definition "Maps that represent the routes and other features of a transportation system; usually restricted to ground transportation although routes for ferries and other water transportation may be included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation maps"@en .

aat:300028309 a skos:Concept ;
    skos:definition "Maps designed and used primarily for plotting courses and traveling on water in a ship or other vessel or in an aircraft or spacecraft. It is sometimes used also for maps specifically designed and used for traveling with motor vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navigation charts"@en .

aat:300028315 a skos:Concept ;
    skos:definition "Maps designed primarily for use in air navigation, giving surface features of aeronautical importance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical charts"@en .

aat:300028321 a skos:Concept ;
    skos:definition "Maps, often global in scope, that depict airline routes, destinations and connections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airline maps"@en .

aat:300028325 a skos:Concept ;
    skos:definition "Charts showing the depths of water, nature of the sea bottom, contours of the sea bottom and coastline, tides, and currents in a given sea or sea-land area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nautical charts"@en .

aat:300028327 a skos:Concept ;
    skos:definition "Nautical charts used for navigation close to shore, such as for entering or leaving bays and harbors or for navigating inland waterways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal charts"@en .

aat:300028333 a skos:Concept ;
    skos:definition "Charts of the sea, especially those used for navigational purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine charts"@en .

aat:300028339 a skos:Concept ;
    skos:definition "Charts depicting accurate, measurable features of underwater terrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathymetric maps"@en .

aat:300028359 a skos:Concept ;
    skos:definition "Maps indicating patterns of weather, such as the movement of clouds or wind, high and low systems, and rain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weather maps"@en .

aat:300028361 a skos:Concept ;
    skos:definition "Refers to maps representing a region at a level of detail or scale between a plan, which is a small area, and a chorographic map, which is a large regional map. Topographic maps include accurate representations of the location and shape of both natural and manmade features. The term refers to maps of various scales in different nations; it is generally limited to maps at scales of 1:500,000 or larger in the United States, but it often refers to scales of 1:1,000,000 or larger in Russia. The term is often mistakenly interpreted to mean maps that only represent natural relief features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topographic maps"@en .

aat:300028364 a skos:Concept ;
    skos:definition "Maps, usually maintained in the public works or engineering departments of a city, showing information such as street and rail rights of way, location of bridges, and grade separations; used for planning and executing engineering work in a locality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineering maps"@en .

aat:300028367 a skos:Concept ;
    skos:definition "Highly abstracted, simplified maps, which demonstrate a single idea or a specific type of data, often statistical, in a diagrammatic way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartograms"@en .

aat:300028368 a skos:Concept ;
    skos:definition "Maps that indicate density of distribution by dots of uniform size, each dot representing a given quantity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dot maps"@en .

aat:300028370 a skos:Concept ;
    skos:definition "Maps showing movement of materials, the direction or route followed being indicated by a line representing the railway, waterway, or other route concerned, while the width of the line represents the quantity of material conveyed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flow-line maps"@en .

aat:300028373 a skos:Concept ;
    skos:definition "Simple maps used in cartography to show the location of a particular geographic area within its larger context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "location maps"@en .

aat:300028375 a skos:Concept ;
    skos:definition "Maps that present just sufficient geographic information to permit the correlation of additional data placed on it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outline maps"@en .

aat:300028379 a skos:Concept ;
    skos:definition "Maps made by superimposing cartographic data on an aerial photograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomaps"@en .

aat:300028380 a skos:Concept ;
    skos:definition "Maps made from an assembly of perspective photographs in which tilt and relief have been removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthophotomaps"@en .

aat:300028381 a skos:Concept ;
    skos:definition "Maps comprised of assemblies of overlapping aerial photographs whose edges have been torn or cut and matched to form a continuous photographic representation of the earth's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomosaic maps"@en .

aat:300028385 a skos:Concept ;
    skos:definition "Refers to maps in which pictures are used to note the distribution of features, including physical features, flora, fauna, settlement patterns, or other characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial maps"@en .

aat:300028387 a skos:Concept ;
    skos:definition "Maps showing land or sea bottom relief in terms of height above or below a datum by any method, such as contours, hachures, shading, or tinting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief maps"@en .

aat:300028393 a skos:Concept ;
    skos:definition "Maps showing elevation and the configuration of the ground by the use of contour lines and usually lacking other detail. For maps that use lines to show the distribution of characteristics other than elevation, use \"isoline maps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contour maps"@en .

aat:300028403 a skos:Concept ;
    skos:definition "Maps on which relief is made to appear three-dimensional by the use of graded shadow effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaded-relief maps"@en .

aat:300028406 a skos:Concept ;
    skos:definition "Refers to maps where the relief of physical features is physically raised in three dimensions. They were first mass produced during World War I by a process in which an aluminum sheet that had a map drawn on it was worked with the repoussé technique of tapping the reverse in order to raise the physical features in relief on the obverse. The metal sheet was then used to shape maps printed on plastic sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raised-relief maps"@en .

aat:300028413 a skos:Concept ;
    skos:definition "Rough, freehand maps of the principal features of a locale, as one drawn from memory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sketch maps"@en .

aat:300028419 a skos:Concept ;
    skos:definition "Large-scale maps used for tactical and administrative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tactical maps"@en .

aat:300028436 a skos:Concept ;
    skos:definition "Maps of a particular region or area which maybe be defined by states, zip code, sales territories, natural landforms, demographics or any other natural, statistical or subjective criteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional maps"@en .

aat:300028440 a skos:Concept ;
    skos:definition "Maps depicting a particular nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national maps"@en .

aat:300028442 a skos:Concept ;
    skos:definition "Maps depicting all or most of the surface of the Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "world maps"@en .

aat:300028454 a skos:Concept ;
    skos:definition "Maps, as those published by the United States Geological Survey, which show tracts of a country on a series of sheets and according to a specified scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrangle maps"@en .

aat:300028457 a skos:Concept ;
    skos:definition "Maps created or presented by means of a computer or computer systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-assisted maps"@en .

aat:300028459 a skos:Concept ;
    skos:definition "Refers to maps that are stored in digital form, which is data recorded by digits or similar discrete elements compatible with storage and manipulation in a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital maps"@en .

aat:300028461 a skos:Concept ;
    skos:definition "Originals of compiled maps, drawn but not printed; loosely, any map drawn by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manuscript maps"@en .

aat:300028467 a skos:Concept ;
    skos:definition "The printed output of a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printouts"@en .

aat:300028469 a skos:Concept ;
    skos:definition "Documents often on tissue paper, produced by the transfer of ink through direct contact with the original, using moisture and pressure in a copy press."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterpress copies"@en .

aat:300028475 a skos:Concept ;
    skos:definition "Original documents, recordings, films, etc., from which copies can be made, or copies of such documents that are reserved for making additional copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master copies"@en .

aat:300028477 a skos:Concept ;
    skos:definition "Reproductions of documents or graphic materials in facsimile form by means other than conventional printing, for example photocopying, microfilm, and digitalization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reprographic copies"@en .

aat:300028484 a skos:Concept ;
    skos:definition "Copies made by xerography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xerographic copies"@en .

aat:300028490 a skos:Concept ;
    skos:definition "Documents produced by a duplicating machine operating on the stencil principle; includes any documents produced by an ink bleed-through stencil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mimeograph copies"@en .

aat:300028492 a skos:Concept ;
    skos:definition "Documents, such as letters, leaflets, or forms, produced on a small, office-type offset press used for duplicating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multigraphs"@en .

aat:300028499 a skos:Concept ;
    skos:definition "Reproductive prints of architectural plans, maps, mechanical drawings, and other technical drawings, characterized by having white images on blue backgrounds and produced by the blueprint process. For blue images on white backgrounds, use \"blueline prints.\" For blue-toned photographs produced by the blueprint process, use \"cyanotypes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blueprints"@en .

aat:300028509 a skos:Concept ;
    skos:definition "Prints produced using a duplicating process in which images are produced by the effect of light on diazonium-sensitized materials, most often architectural or other technical drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diazotypes"@en .

aat:300028517 a skos:Concept ;
    skos:definition "Copies made by light-sensitive processes, often the diazo process, usually of line drawings, in which black or colored lines appear on a white background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiteprints"@en .

aat:300028543 a skos:Concept ;
    skos:definition "Structured sets of data held in computer storage, especially those that incorporate software to make them accessible in a variety of ways. A database is used to store, query, and retrieve information, typically comprising a logical collection of interrelated information that is managed as a unit, stored in machine-readable form, and organized and structured as records that are presented in a standardized format in order to allow rapid search and retrieval by a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "databases"@en .

aat:300028549 a skos:Concept ;
    skos:definition "Magnetizable material in disk form, capable of storing information in the form of electromagnetic signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic disks"@en .

aat:300028553 a skos:Concept ;
    skos:definition "Thin, round, flexible disks with magnetic surfaces for storing and retrieving data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floppy disks"@en .

aat:300028558 a skos:Concept ;
    skos:definition "Tapes coated with magnetizable material, capable of storing information in the form of electromagnetic signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic tapes"@en .

aat:300028560 a skos:Concept ;
    skos:definition "Tapes made of paper and used for representing data by means of punched holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper tapes"@en .

aat:300028562 a skos:Concept ;
    skos:definition "Paper cards on which machine-readable data are recorded by the punching of holes in specified positions in accordance with a predesignated code."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punched cards"@en .

aat:300028566 a skos:Concept ;
    skos:definition "Computer system programs, procedures, and associated documentation concerned with the operation of data processing systems, and which require hardware for use to be made of them. For individual collections or sequences of code provided by a user to perform a particular task, use \"programs.\" For programs that serve a particular purpose and that may be packaged and sold by a manufacturer use \"applications.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "software"@en .

aat:300028569 a skos:Concept ;
    skos:definition "Handwritten documents, particularly books and other documents created before the invention of the printing press. May also be used to distinguish certain documents from published or otherwise printed documents, as in the cases of typed personal letters or a typescript from which printed versions are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manuscripts"@en .

aat:300028571 a skos:Concept ;
    skos:definition "Documents written in, and usually signed with, the writer's own hand; in certain legal instances, prefer \"holographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autographs"@en .

aat:300028573 a skos:Concept ;
    skos:definition "Documents wholly written in the hand of the author; used especially in law with regard to wills and deeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holographs"@en .

aat:300028576 a skos:Concept ;
    skos:definition "Written materials, usually parchment, that have been written upon more than once; the previous text may have been imperfectly erased, thus remaining partly legible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palimpsests"@en .

aat:300028577 a skos:Concept ;
    skos:definition "Copies of a work in typewritten form, as distinguished from those in printed or handwritten form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typescripts"@en .

aat:300028579 a skos:Concept ;
    skos:definition "Manuscripts that have been reviewed and prepared to be published."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manuscripts for publication"@en .

aat:300028589 a skos:Concept ;
    skos:definition "All media used to record microimages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microforms"@en .

aat:300028591 a skos:Concept ;
    skos:definition "Flexible, transparent sheets of film bearing a series of microimages on a flat sheet of film, usually arranged in a grid pattern, to be read by magnification on specially designed equipment; normally having an identifying strip legible without magnification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfiche"@en .

aat:300028594 a skos:Concept ;
    skos:definition "Cards with one or more openings into each of which is mounted a frame cut from a strip of microfilm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aperture cards"@en .

aat:300028596 a skos:Concept ;
    skos:definition "Microfiche with a reduction ratio greater than 90 times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultrafiche"@en .

aat:300028598 a skos:Concept ;
    skos:definition "Transparent films bearing microphotographs of documents, images, etc, to be read on specially designed equipment. The support is typically a fine grain, high resolution film in roll form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfilms"@en .

aat:300028602 a skos:Concept ;
    skos:definition "Segments of microfilm that are usually inserted into microfilm jackets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfilm strips"@en .

aat:300028607 a skos:Concept ;
    skos:definition "Opaque cards or strips bearing microphotographs of images, pages of a book, periodical, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microopaques"@en .

aat:300028609 a skos:Concept ;
    skos:definition "Computer output produced directly onto microform, without paper printout as an intermediary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-output microforms"@en .

aat:300028612 a skos:Concept ;
    skos:definition "Computer output produced directly onto microfiche, without paper printout as an intermediary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-output microfiche"@en .

aat:300028614 a skos:Concept ;
    skos:definition "Computer output produced directly onto microfilm, without paper printout as an intermediary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-output microfilms"@en .

aat:300028629 a skos:Concept ;
    skos:definition "Long strips of flexible material used for written documents and rolled for ease of handling and storage. For paintings on either hanging scrolls or handscrolls, use \"scroll paintings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrolls"@en .

aat:300028633 a skos:Concept ;
    skos:definition "Discs, tapes, filaments, or other media on which sound has been recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound recordings"@en .

aat:300028640 a skos:Concept ;
    skos:definition "Sound recordings invented by Thomas Edison in 1877. They were the earliest form of phonograph record, and were marketed commercially. Sound would be funnelled through a horn and against a diaphragm, which would vibrate. The resulting vibrations were transmitted to a stylus, which followed a helical path along a surface, usually wax, which coated a rotating cylinder. The resulting cylinder could be played by a cylinder phonograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinders"@en .

aat:300028643 a skos:Concept ;
    skos:definition "Discs (formerly cylinders) of shellac, polyvinyl chloride, or other substances so prepared that sound is reproduced when played on a phonograph player."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph records"@en .

aat:300028651 a skos:Concept ;
    skos:definition "Phonograph records made of wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Graphophone records"@en .

aat:300028653 a skos:Concept ;
    skos:definition "Sound recordings on magnetic tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiotapes"@en .

aat:300028661 a skos:Concept ;
    skos:definition "Cassettes of audiotape. According to international standards, the tape is usually 0.15 inches (3.8 millimetres) wide and can carry 4 to 8 tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiocassettes"@en .

aat:300028673 a skos:Concept ;
    skos:definition "Optical disks on which sound recordings, data, or programs, are digitally encoded for a laser beam to scan, decode, and transmit to a playback system, computer monitor, or television set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compact discs"@en .

aat:300028680 a skos:Concept ;
    skos:definition "Recordings of sound on a spool of wire rather than on magnetic tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire recordings"@en .

aat:300028682 a skos:Concept ;
    skos:definition "Manifestations of motion pictures, stored electronically, in any media or digitized format. Use 'videotapes' to refer specifically to electronic audio-visual recordings stored on tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video recordings"@en .

aat:300028685 a skos:Concept ;
    skos:definition "Optical disks on which still images, moving images or sound are recorded in an analog format. The images can be displayed on a video monitor, such as a television attached to a videodisc player, which may be controlled by a computer. Prior to the introduction of compact disks, which also use a laser to read the data, videodiscs were sometimes referred to as \"laser disks.\" For the digital versatile disc format specifically, use \"DVDs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videodiscs"@en .

aat:300028689 a skos:Concept ;
    skos:definition "Magnetic tapes on which visual images are electronically recorded and played back, with or without sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videotapes"@en .

aat:300028692 a skos:Concept ;
    skos:definition "Cassettes containing recordings on videotape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videocassettes"@en .

aat:300028702 a skos:Concept ;
    skos:definition "Words, texts, lettering, or symbols marked on a work, including texts, legends, documentation notes, or commemoration. For standardized symbols or notations on objects that convey official information, use \"marks (symbols).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inscriptions"@en .

aat:300028705 a skos:Concept ;
    skos:definition "Persons' names written in their own hand. In numismatics, on coins and medals serve as indicators of authorship (engraver, designer, etc.); while on bills, they signify the level of responsibility of various positions within the issuing institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signatures"@en .

aat:300028709 a skos:Concept ;
    skos:definition "The first letters of each word in names, as of a person or organization, used as an abbreviation for or to stand for the names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initials"@en .

aat:300028710 a skos:Concept ;
    skos:definition "Inscriptions historically placed at the end of a book and containing the title, the publisher's or printer's name, date and place of printing. Sometimes they include claims by the publisher or printer for their role in the production of the work in order to protect their property from the depredations of rival printer-publishers. By about 1480, part of the contents of the colophon was transferred to the blank cover page at the front of the book, thereby initiating the title page as it is now known today. In modern usage in most countries, the colophon now appears on the page opposite the title page and consists of a one-sentence statement that the book was printed by a given printer at a given location. Colophons stating the typeface, paper, and other production details of fine editions are sometimes still placed on the last page, however. For similar inscriptions on the final pages of manuscripts and incunabula, use \"explicits.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colophons"@en .

aat:300028711 a skos:Concept ;
    skos:definition "Script originally developed for the Sumerian language in the 3rd millennium BCE, consisting of characters made in clay with a wedge-shaped stylus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuneiform"@en .

aat:300028714 a skos:Concept ;
    skos:definition "Generally, representations, designs, or mottoes, or combinations of these, used to signify an individual, a group, or sometimes a commercial concern, and usually intended to convey a sense of lineage or quality. For devices that are symbol- or picture based, designed to identify at a glance a product, company, or organization, and often used as trademarks, see \"logos.\" For devices that specifically identify a person or object as belonging to a group or organization, sometimes denoting rank or office, see \"insignia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devices"@en .

aat:300028715 a skos:Concept ;
    skos:definition "Devices that are specifically symbol- or picture based, designed for ready recognition to identify a product, company, or organization and sometimes used as trademarks. For those graphic images similarly used but more word- or letter-based, see \"logotypes.\" For devices in any form that specifically identify a person or object as belonging to a group or organization, sometimes denoting rank or office, see \"insignia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logos"@en .

aat:300028719 a skos:Concept ;
    skos:definition "Inscriptions on statues, buildings, or other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epigraphs"@en .

aat:300028721 a skos:Concept ;
    skos:definition "Ancient Egyptian writing, and certain other scripts, such as Mayan, composed of characters that are for the most part pictographic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hieroglyphics"@en .

aat:300028725 a skos:Concept ;
    skos:definition "Devices in any form that identify a person or object as belonging to a group or organization, and sometimes denoting rank or office. For devices that are specifically symbol- or picture based, designed for ready recognition to identify a product, company, or organization and sometimes used as trademarks, see \"logos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignias"@en .

aat:300028729 a skos:Concept ;
    skos:definition "Inscriptions on sepulchral monuments in the memory of those buried in the tomb or grave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epitaphs"@en .

aat:300028730 a skos:Concept ;
    skos:definition "Pieces of paper, leather, fabric, or small tablets inscribed and affixed to something for identification or description. In the context of bookbinding, refers specifically to paper or other material separate from that used to cover a book, on which the author's name and the title are printed or engraved and glued to the spine or front board. For larger, more public identifying notices, use \"identification signs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labels"@en .

aat:300028731 a skos:Concept ;
    skos:definition "Labels affixed to a book to indicate ownership and often its location in a collection. They may be printed or engraved, frequently with a distinctive design, pasted or tipped into books on the inside of the upper cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookplates"@en .

aat:300028737 a skos:Concept ;
    skos:definition "Identifying marks attached to goods indicating they have been produced by union labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "union labels"@en .

aat:300028739 a skos:Concept ;
    skos:definition "Plaques, often of silver, with a chain for suspending around the neck of a bottle and lettered with the name of the contents; usually for wine or liquor, sometimes for other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle tickets"@en .

aat:300028744 a skos:Concept ;
    skos:definition "Standardized symbols, notations, or other markings applied to objects during or after creation, conveying information such as the object's origin or maker, its authenticity, or a change in its official status. For lettering marked on something for documentation or commemoration, use \"inscriptions.\" For marks inherent in the paper support, not applied as part of the image or work, use \"watermarks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marks"@en .

aat:300028749 a skos:Concept ;
    skos:definition "Faint designs or devices incorporated into paper as it is made and appearing as translucent or shaded areas visual only through transmitted light. They are often used to give the name of the manufacturer and the date of the paper's manufacture; symbols, seals, and initials are also common. Watermarks have also been used to detect and prevent counterfeiting and forgery. Watermarks were first introduced in Bologna, Italy in 1282."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watermarks"@en .

aat:300028754 a skos:Concept ;
    skos:definition "Marks in paper produced by placing a stereo in bronze, rubber, or other substance, on the press roll of the papermaking machine and so leaving a design in the paper where it was more compressed. Technically, they are not true watermarks but are made to serve the same purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impressed watermarks"@en .

aat:300028757 a skos:Concept ;
    skos:definition "Marks on a fixed and enduring object, indicating its elevation above sea level and serving as a reference in topographic surveys and tidal observations. In a more general sense, the term may also refer to any point of reference from which measurements may be made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench marks"@en .

aat:300028759 a skos:Concept ;
    skos:definition "One or more marks made to deface something in order to indicate a change in its status, such as through a pottery factory mark, indicating the piece is defective or outmoded, or as across a printing plate, assuring that no prints are produced beyond a limited edition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cancellation marks"@en .

aat:300028760 a skos:Concept ;
    skos:definition "Marks, often stamped in ink or embossed, that are affixed to drawings, prints, or other artworks to indicate ownership. These appear in many forms and may be used by private collectors or institutions such as museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectors' marks"@en .

aat:300028762 a skos:Concept ;
    skos:definition "Marks stamped on an object to indicate the year of its make."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "date marks"@en .

aat:300028763 a skos:Concept ;
    skos:definition "Marks stamped on an object by its dealer or seller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dealers' marks"@en .

aat:300028764 a skos:Concept ;
    skos:definition "Marks, typically found of mugs used in 19th century taverns, to indicate the amount of fluid to add."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excise marks"@en .

aat:300028765 a skos:Concept ;
    skos:definition "Devices applied to pottery, often to the bottom of a vessel or plate, for the purpose of identifying the origin of commercial pottery wares. Some ancient Greek wares include such marks; more are evident in Renaissance European wares; and the application of factory marks became nearly universally common in the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory marks"@en .

aat:300028767 a skos:Concept ;
    skos:definition "Official stamps affixed by guilds or assay offices upon articles made of gold or silver as evidence of the quality of the metal. Distinguished from \"makers' marks\" which are stamped on articles of gold or silver for the purpose of identifying the craftsman or workshop of origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hallmarks"@en .

aat:300028769 a skos:Concept ;
    skos:definition "Inscriptions, names, stamps, labels, or seals placed on articles to signify origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marks of origin"@en .

aat:300028771 a skos:Concept ;
    skos:definition "Marks on objects idicating the country in which it was manufactured, typically to determine the rate of duty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "country of origin marks"@en .

aat:300028772 a skos:Concept ;
    skos:definition "Marks, sometimes hidden, identifying an item as the property of an individual, library, museum, archive, or other institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ownership marks"@en .

aat:300028774 a skos:Concept ;
    skos:definition "Marks for printmaking, usually taking the form of right angles, crosses, or crosses within circles, put on printing plates to perfectly register them for color printing; also placed on mechanicals with overlays to ensure accurate registration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registry marks"@en .

aat:300028776 a skos:Concept ;
    skos:definition "The names, symbols, figures, letters, words, or other marks adopted and used by a manufacturer or merchant in order to designate his goods and to distinguish them from any others; usually registered with a governmental agency to assure its use exclusively by the owner of the mark. For devices similarly used but identifying services rather than products, use \"service marks.\" For specific graphic images derived from trademarks, use \"logotypes\" or \"logos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trademarks"@en .

aat:300028780 a skos:Concept ;
    skos:definition "Contemporary term sometimes applied to any marks placed on the underside of any ceramic object but strictly applicable to only such marks made with rubber stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back stamps"@en .

aat:300028783 a skos:Concept ;
    skos:definition "Stamps applied to bricks, containing information about their manufacture; they were used as an indicator of quality. Brick stamps have been known since ancient Egyptian and Roman times, where they noted the location and important people, such as the land owner, associated with the manufacture of the bricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick stamps"@en .

aat:300028789 a skos:Concept ;
    skos:definition "Marks of property, incised on the facade of a building, typically in the form of simple patterns of lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house marks"@en .

aat:300028797 a skos:Concept ;
    skos:definition "Promotional stickers on correspondence, popular especially in the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poster stamps"@en .

aat:300028815 a skos:Concept ;
    skos:definition "Marks stamped on bottles by the manufacturer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle makers' marks"@en .

aat:300028844 a skos:Concept ;
    skos:definition "In printing, general term for decorative designs, not usually part of a type font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printers' ornaments"@en .

aat:300028853 a skos:Concept ;
    skos:definition "Forms or models, made from a variety of materials, cut to the size or profile of the finished article and used as a guide during its construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patterns"@en .

aat:300028875 a skos:Concept ;
    skos:definition "A sample is a part of anything taken or presented for inspection or shown as evidence of the quality or composition of the whole. For instances that represent a class, use \"specimens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samples"@en .

aat:300028877 a skos:Concept ;
    skos:definition "Objects bearing designs, emblems, letters, names, words, etc. in intaglio that are used for stamping a flat surface or for making an impression in relief on some soft, tenacious substance such as clay or wax. They may be flat or cylindrical, the impression made by rolling the seal over the surface. Seals may be used to authenticate documents or for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seals"@en .

aat:300028878 a skos:Concept ;
    skos:definition "Visual works or designs produced by using tools also called \"stencils,\" which are sheets of celluloid, paper, cardboard, or other material in which desired lettering or designs have been cut out so that ink or paint applied to the sheets will reproduce the cut-out designs on the surface beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencils"@en .

aat:300028879 a skos:Concept ;
    skos:definition "Flat surfaces or slabs, either portable or mounted on a wall or other structure, bearing or intended to bear inscriptions or pictures; also, thin, rigid slabs used as writing surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablets"@en .

aat:300028881 a skos:Concept ;
    skos:definition "Items created, manufactured, or used for a specific, limited use; typically intended to be used for a short period and discarded thereafter, although ephemera is often actually collected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ephemera"@en .

aat:300028882 a skos:Concept ;
    skos:definition "Depiction or description of sexual love. For depiction or description of sexual activity in an explicit manner intended to stimulate erotic rather than aesthetic feeling, use \"pornography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erotica"@en .

aat:300028883 a skos:Concept ;
    skos:definition "Literary or artistic works produced by persons in their childhood or youth; usually used to set those works apart from later, mature works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juvenilia"@en .

aat:300028884 a skos:Concept ;
    skos:definition "Collected objects of various kinds with historical, personal, or locational interest, used generally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorabilia"@en .

aat:300028886 a skos:Concept ;
    skos:definition "Objects serving as tokens of remembrance of some person, place, or event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "souvenirs"@en .

aat:300030853 a skos:Concept ;
    skos:definition "Motifs representing the head or skull of an ox, often garlanded, common in classical style friezes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucrania"@en .

aat:300032101 a skos:Concept ;
    skos:definition "Wood of the species Quercus lobata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "California white oak"@en .

aat:300032286 a skos:Concept ;
    skos:definition "A pattern or ornament of interlaced curving bands in the form of two or more bands or strings twisting over each other, so as to repeat the same figure, in a continued series by the spiral returning of the bands; sometimes giving the effect of a braid, but most often in smooth curves forming circles. Sometimes considered a type of fret or a type of interlace. Named after the French engineer Guillot, who invented a machine that could scratch fine patterns and designs on metallic surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guilloche"@en .

aat:300032341 a skos:Concept ;
    skos:definition "Soft, pliable oil-tanned leather originally made from the skins of the chamois, Antilopa rupicapra, a small deer; now made from the skins of lamb, sheep, goat, or from the flesh split of skins or hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamois"@en .

aat:300033260 a skos:Concept ;
    skos:definition "Large and small items that are necessary to attach, anchor, hold, or join materials and components of structures, furniture, and other objects. Also, items used in the finishing of buildings and objects, such as hinges and knobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardware"@en .

aat:300033265 a skos:Concept ;
    skos:definition "Surface-mounted cabinet hinges that have the appearance of a butterfly when opened out flat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butterfly hinges"@en .

aat:300033266 a skos:Concept ;
    skos:definition "Spring bolts or magnetic latches, usually found on cabinets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet locks"@en .

aat:300033267 a skos:Concept ;
    skos:definition "Locks used principally to lock sliding cabinet doors by means of a pin extended into locked position by pushing; they are unlocked by inserting a key and pulling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "push-pull cabinet locks"@en .

aat:300033268 a skos:Concept ;
    skos:definition "Decorative hardware used on chests and trunks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign trim"@en .

aat:300033270 a skos:Concept ;
    skos:definition "Small spring catches operated by knobbed slides or thumb latches, employed in fastening light doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupboard catches"@en .

aat:300033271 a skos:Concept ;
    skos:definition "Keyed locks designed for use on cupboards or boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupboard locks"@en .

aat:300033272 a skos:Concept ;
    skos:definition "Small spring catches designed to secure light doors, operated by rotating knobs or handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupboard turns"@en .

aat:300033273 a skos:Concept ;
    skos:definition "Locks adapted to fasten rolling or hinged desk lids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desk locks"@en .

aat:300033274 a skos:Concept ;
    skos:definition "Strap hinges that form an \"H\" when open, and with the joint in the crossbar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "H hinges"@en .

aat:300033275 a skos:Concept ;
    skos:definition "Jointed plates or leaves that allow swinging motion in a single plane of one of the members to which they are attached, such as a door or gate, and formed in the shape of the letter 'H' but with an additional right-angled element on one component of the hinge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "H and L hinges"@en .

aat:300033276 a skos:Concept ;
    skos:definition "Hardware that allows the swinging motion of the doors mounted on insulated cabinets or boxes having a compartment for ice and used for refrigeration of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice box hinges"@en .

aat:300033277 a skos:Concept ;
    skos:definition "Latches designed to keep a tight seal on the doors of insulated cabinets or boxes having a compartment for ice and used for the refrigeration of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice box latches"@en .

aat:300033280 a skos:Concept ;
    skos:definition "Handles used for pulling open a door or drawer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulls"@en .

aat:300033281 a skos:Concept ;
    skos:definition "Arched pulls, typically found on furniture, where the ends of the hoop or half-ring are attached to the body of the item or to a plate attached to the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bail pulls"@en .

aat:300033282 a skos:Concept ;
    skos:definition "Hand-forged pulls mounted with plates shaped like balls with single spear points projecting from them; similar to onion pulls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball and spear pulls"@en .

aat:300033284 a skos:Concept ;
    skos:definition "Hand-forged pulls mounted with lima bean-shaped plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bean pulls"@en .

aat:300033285 a skos:Concept ;
    skos:definition "Refers to handles used for pulling open a door or drawer. These are usually in the form of a hollow convex piece of metal, and were originally designed for use as grips on storage bins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bin pulls"@en .

aat:300033286 a skos:Concept ;
    skos:definition "Pulls that are designed to be installed in recessed cavities in the edges of pocket doors, and that lie flush against the edge of the door when released."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door edge pulls"@en .

aat:300033287 a skos:Concept ;
    skos:definition "Handles or grips designed to fit the fingers, and used to open or close sliding receptacles in furniture or cupboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawer pulls"@en .

aat:300033288 a skos:Concept ;
    skos:definition "In furniture making, any type of handle, or drawer pull, which hangs like a pendant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop pulls"@en .

aat:300033289 a skos:Concept ;
    skos:definition "Door pulls for a sliding door that are mortised flush into the door and have a curved recess serving as a finger grip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush-cup pulls"@en .

aat:300033291 a skos:Concept ;
    skos:definition "Door pulls mortised into a door, each having a pulling ring that folds flat into a recess when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush rings"@en .

aat:300033293 a skos:Concept ;
    skos:definition "Refers to forged handles with heart-shaped mounting plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heart pulls"@en .

aat:300033294 a skos:Concept ;
    skos:definition "Pulls whose handles angle off to one side. Pulls offset to the right are used on right-hand doors and pulls offset to the left are used on left-hand doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset pulls"@en .

aat:300033295 a skos:Concept ;
    skos:definition "Hand-forged pulls mounted with plates resembling a sprouting onion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onion pulls"@en .

aat:300033297 a skos:Concept ;
    skos:definition "Refers to pulls designed to be either completely or partially mortised into a door or drawer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recessed pulls"@en .

aat:300033300 a skos:Concept ;
    skos:definition "Hand-forged pulls with mounting plates shaped like spade blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spade pulls"@en .

aat:300033305 a skos:Concept ;
    skos:definition "Large and small items that are attached to, or used in conjunction with, doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessory door hardware"@en .

aat:300033310 a skos:Concept ;
    skos:definition "Devices placed on the wall or floor behind a door to limit the swing of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door bumpers"@en .

aat:300033311 a skos:Concept ;
    skos:definition "Devices used for holding a door open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door holders"@en .

aat:300033312 a skos:Concept ;
    skos:definition "Any of various plates on doors added to protect the surface or as mounts for doorknobs or lever door handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door plates"@en .

aat:300033313 a skos:Concept ;
    skos:definition "Entrance doorbell devices activated by turning a bar or thumb piece located on the outside of an exterior door frame that communicates with a bell located somewhere inside the door frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door rings"@en .

aat:300033315 a skos:Concept ;
    skos:definition "Metal strips or plates attached to the bottom rail of a door for protection against marring, as by shoes; also, plates, usually metal, used to create a lip or ridge at the open edge of a stair platform or floor, or at the back edge or open ends of a stair tread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kickplates"@en .

aat:300033319 a skos:Concept ;
    skos:definition "Plates applied to doors to protect them against soiling and wear when being pushed open or during the operation of locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "push plates"@en .

aat:300033320 a skos:Concept ;
    skos:definition "Plates that serve as mounts for knobs or pulls and intervene between them and the cabinetry to which they are attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backplates"@en .

aat:300033321 a skos:Concept ;
    skos:definition "Small round door plates that serve as a mounting for a doorknob or lever door handle and intervene between it and the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roses"@en .

aat:300033325 a skos:Concept ;
    skos:definition "Small metal rods used as fasteners having a head and often helical threading and being usually secured by a nut or by riveting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolts"@en .

aat:300033327 a skos:Concept ;
    skos:definition "Cylindrical bolts that are mounted on a plate having a raised case that contains the bolt and guides it into a recess in a jamb or some other suitable cylindrical socket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel bolts"@en .

aat:300033328 a skos:Concept ;
    skos:definition "Vertically mounted bolts on the bottom of a door which slide into a socket in the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottom bolts"@en .

aat:300033329 a skos:Concept ;
    skos:definition "Bolts or pegs designed to be set into holes or slots in the interior walls of a bookcase, forming an attachment or small platform on which bookcase shelves can sit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookcase bolts"@en .

aat:300033333 a skos:Concept ;
    skos:definition "Heavy cane shaped bolt with the top beant and right angles. It is used on the bottom of doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cane bolts"@en .

aat:300033334 a skos:Concept ;
    skos:definition "Locks with a spring bolt at the top of the door that can be operated by pulling an attached chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain bolts"@en .

aat:300033335 a skos:Concept ;
    skos:definition "Chains that can be secured by a slide bolt between a door stile and a door jamb to allow the door to be opened slightly while remaining securely fastened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain door fasteners"@en .

aat:300033337 a skos:Concept ;
    skos:definition "Sliding bars or rods used for locking a door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door bolts"@en .

aat:300033338 a skos:Concept ;
    skos:definition "Sliding bars that move in opposing directions, mounted at the top and bottom of a door. The bars engage with strike plates or openings in the door frame to secure the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-door bolts"@en .

aat:300033339 a skos:Concept ;
    skos:definition "Bolts that can be projected beyond their normal position, thus giving extra security."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double throw bolts"@en .

aat:300033340 a skos:Concept ;
    skos:definition "Devices for locking together upper and lower leaves of a Dutch door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch-door bolts"@en .

aat:300033341 a skos:Concept ;
    skos:definition "Fastenings for French or casement doors that consist of long rods, often hooked, at the top and bottom of the sash and that operate with a handle in the center. These use a round or square bar, distinguished from the half-round bar of a cremorne bolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "espagnolette bolts"@en .

aat:300033342 a skos:Concept ;
    skos:definition "Flush bolts whose heads connect to the operating mechanism via a rod which is inserted through a hole bored in the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extension flush bolts"@en .

aat:300033344 a skos:Concept ;
    skos:definition "Door bolts or other bolts mounted on a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush bolts"@en .

aat:300033346 a skos:Concept ;
    skos:definition "Bolts applied at the bottom of a door and arranged for foot operation; held up by a spring when door is unbolted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot bolts"@en .

aat:300033348 a skos:Concept ;
    skos:definition "Beveled spring bolts usually operated by a knob, handle, or turn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latch bolts"@en .

aat:300033350 a skos:Concept ;
    skos:definition "Latch bolts that reduce friction applied to a strike plate. This is achieved by incorporating an extra swivelling antifriction piece held with a pivot pin, which allows a right angle direction of the motion initiated by the strike plate edge on the latch to the motion of the door, in order to avoid excessive pressure on the flat face of the latch bolt where it penetrates the lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antifriction latch bolts"@en .

aat:300033353 a skos:Concept ;
    skos:definition "Latch bolts hinged to a lock or door and operated by swinging rather than sliding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swinging latch bolts"@en .

aat:300033354 a skos:Concept ;
    skos:definition "Bolts made to slide into a mortise to secure a door rather than being applied to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortise bolts"@en .

aat:300033355 a skos:Concept ;
    skos:definition "Bolts having a bend or perpendicular projection from the body of the bolt that is made to engage with a strike or keeper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "necked bolts"@en .

aat:300033356 a skos:Concept ;
    skos:definition "Bolts that engage with a strike when closed, but which must be manually released."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-latching bolts"@en .

aat:300033358 a skos:Concept ;
    skos:definition "Door bolts operated by a rotating thumbpiece or a small knob."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumb bolts"@en .

aat:300033359 a skos:Concept ;
    skos:definition "Holding devices that rely on a roller, magnet, or friction as the means of closure. Distinguished from \"latches\" which rely on some form of horizontal bar, such as a bolt, rod, or hook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catches"@en .

aat:300033360 a skos:Concept ;
    skos:definition "Catches whose strike holds a communicating projection or finger by means of the pressure exerted by one or two spring-loaded balls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball catches"@en .

aat:300033361 a skos:Concept ;
    skos:definition "Any catches held in position by friction when engaged with their strikes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction catches"@en .

aat:300033362 a skos:Concept ;
    skos:definition "Devices on the interior surfaces of cabinet doors that employ the attraction of magnets to secure the door in a closed position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic catches"@en .

aat:300033363 a skos:Concept ;
    skos:definition "Magnetic catches with an inward and outward moving strike that retract and project by means of springs on successive applications of pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic push catches"@en .

aat:300033365 a skos:Concept ;
    skos:definition "A form of door hardware that consists of a single knob fastened to one end of a spindle, on the other end of which is a rose or plate used to secure the knob and spindle to the closet door. Distinguished from \"doorknobs,\" in which a pair of knobs on opposite ends of a spindle is used to release the door latch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closet knobs"@en .

aat:300033367 a skos:Concept ;
    skos:definition "Flexible plates or leaves joined by a pin so as to allow swinging motion in a single plane of one of the members to which they are attached, such as a door or gate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinges"@en .

aat:300033368 a skos:Concept ;
    skos:definition "Hinges so designed that, when the door is closed, only a ball-type knuckle is exposed. Such hinges have an adjustment for vertical control within limited scope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable ball hinges"@en .

aat:300033369 a skos:Concept ;
    skos:definition "Hinges with threaded arms instead of hinge plates, each leaf extended and bent into a flange, each side of the hinge forming a cantilever with its opposite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor hinges"@en .

aat:300033370 a skos:Concept ;
    skos:definition "Hinges mortised into the edge of a door and the edge of the jamb against which the edge of the door will butt when closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butt hinges"@en .

aat:300033372 a skos:Concept ;
    skos:definition "Butt hinges having ball bearings positioned between the knuckles to reduce friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball-bearing hinges"@en .

aat:300033373 a skos:Concept ;
    skos:definition "Door hinges that are visible when the door is open but concealed when the door is closed. Distinguished from \"invisible hinges\" which are completely concealed, from the outside, whether the door is open or closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concealed hinges"@en .

aat:300033375 a skos:Concept ;
    skos:definition "Hinges that allow a door to swing into a pocket at a right angle to a door frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmon hinges"@en .

aat:300033377 a skos:Concept ;
    skos:definition "Hinges that employ a pin in one leaf of the hinge and a socket in the other, allowing the joint to be disengaged simply by being lifted out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lift-off hinges"@en .

aat:300033378 a skos:Concept ;
    skos:definition "Pintle-type hinges having extended pins that it can be fastened to the casing of a door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rattail hinges"@en .

aat:300033379 a skos:Concept ;
    skos:definition "Hinges having a removable pin to permit the two parts of the hinge to be separated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loose-pin hinges"@en .

aat:300033380 a skos:Concept ;
    skos:definition "Door hinges fabricated with a slope on the knuckle which causes the door to rise when opened. Rising hinges are used when there are obstructions along the door's bottom edge, such as carpeting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rising hinges"@en .

aat:300033382 a skos:Concept ;
    skos:definition "Hinges containing one or more springs to move a door into a closed position. They may be either single- or double-acting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring hinges"@en .

aat:300033383 a skos:Concept ;
    skos:definition "Double-acting hinges equipped with a spring to bring the door back in line with the frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-acting spring hinges"@en .

aat:300033385 a skos:Concept ;
    skos:definition "Door hinges containing one or more springs that may automatically close or otherwise restrict movement of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jamb spring hinges"@en .

aat:300033387 a skos:Concept ;
    skos:definition "Holding devices that rely on some form of horizontal bar, such as a bolt, rod, or hook as the means of closure. Distinguished from \"catches\" which rely on a roller, magnet, or friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latches"@en .

aat:300033389 a skos:Concept ;
    skos:definition "Mechanisms in a lock that automatically deadlock the main latch bolt when the door is closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary dead latches"@en .

aat:300033390 a skos:Concept ;
    skos:definition "Heavy latches for large doors having plate-mounted pivoting bars that cross the joint of the door to engage with a strike on the jamb or opposing door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barn-door latches"@en .

aat:300033391 a skos:Concept ;
    skos:definition "Small and simple lift-latches used to secure cupboards, cabinets, gates, or other doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottage latches"@en .

aat:300033392 a skos:Concept ;
    skos:definition "Quadrant-shaped latches that fasten to the bottom leaves of Dutch doors, and that pivot around the point of the quadrant’s radii, engaging a strike attached to the upper leaf of the door, thus fastening them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch-door quadrants"@en .

aat:300033394 a skos:Concept ;
    skos:definition "Spring latches or deadlocking latches that have a 3/4-inch throw and an antifriction retractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire-door latches"@en .

aat:300033395 a skos:Concept ;
    skos:definition "Latches that provide positive push-pull operation, the two sides using the same latch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospital latches"@en .

aat:300033397 a skos:Concept ;
    skos:definition "Unencased surface-mounted latches consisting of a bar pivoted to a plate and engaging with a hook on the jamb, the bar being operated by a thumb piece on the outside of the door and by a lift handle on the inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lift latches"@en .

aat:300033398 a skos:Concept ;
    skos:definition "Door locks with a spring bolt that cannot be operated from the outside except by a key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night latches"@en .

aat:300033400 a skos:Concept ;
    skos:definition "Refers to simple door latches with rollers under spring tension rather than bevelled bolts. The roller engages with a recess in the strike plate designed to receive it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller latches"@en .

aat:300033401 a skos:Concept ;
    skos:definition "Light locking or latching devices for use on a screen door and operated by a knob, a lever handle, or a handle and push button."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen-door latches"@en .

aat:300033402 a skos:Concept ;
    skos:definition "Surface-mounted latches operated by a concealed button or other device, usually used on bank gates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secret gate latches"@en .

aat:300033403 a skos:Concept ;
    skos:definition "Plain latches, generally used on interior doors and having no locking mechanisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring latches"@en .

aat:300033404 a skos:Concept ;
    skos:definition "Door fastenings that incorporate a pivoted bar that crosses the joints of doors, and that engage with a strike; the free end of the bar is raised to disengage it from the strike by a transverse pivoted bar that is operated by the thumb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumb latches"@en .

aat:300033405 a skos:Concept ;
    skos:definition "Door latching devices used where one side of double doors needs to be secured at top and bottom, or where a single door is attached to a panic bolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-point latches"@en .

aat:300033406 a skos:Concept ;
    skos:definition "Mechanisms resembling front door locks but with the dead bolt omitted, and in which the latch bolt is operated from the outside by key and from the inside by a knob."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestibule latches"@en .

aat:300033407 a skos:Concept ;
    skos:definition "Various types of securing devices used to secure openings or containers, traditionally consisting of a dead bolt or system of bolts and operated by a key or similar device, but today, by extension, may include other locking devices that may have other forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locks"@en .

aat:300033409 a skos:Concept ;
    skos:definition "Locks used on doors of psychiatric institutions providing special protection against tampering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asylum locks"@en .

aat:300033410 a skos:Concept ;
    skos:definition "Mortise locks operated by a key having a wing bit, in which the keying of the lock is integral with the lock case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bit key locks"@en .

aat:300033412 a skos:Concept ;
    skos:definition "Locks with changeable tumblers and mechanisms controlled by a movable dial with number guides. The lock is released when a certain sequence of numbers on the dial is combined in succession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination locks"@en .

aat:300033413 a skos:Concept ;
    skos:definition "Locks that combine heavy deadbolts with latch bolts operated by thumb handles instead of knobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combined store-door locks"@en .

aat:300033414 a skos:Concept ;
    skos:definition "Locks designed for doors that separate connecting rooms, often incorporating knob latches and thumb bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communicating-door locks"@en .

aat:300033415 a skos:Concept ;
    skos:definition "Locks in which the keyhole and tumbler mechanism are contained in a cylinder or escutcheon separate from the lock case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder locks"@en .

aat:300033417 a skos:Concept ;
    skos:definition "Twinned dead bolts projecting from a lock mechanism that engage a common opening in the strike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split dead bolts"@en .

aat:300033418 a skos:Concept ;
    skos:definition "Locks with dead bolts only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deadlocks"@en .

aat:300033419 a skos:Concept ;
    skos:definition "Contrivances for securing doors in closed position, often with a combination of a keyed bolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door locks"@en .

aat:300033420 a skos:Concept ;
    skos:definition "Cylinder-type locks with independent pin tumblers, both controlling the same bolt, and operated with dual keys, one a master key designed to control a set of such locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duplex locks"@en .

aat:300033421 a skos:Concept ;
    skos:definition "Locks built to secure French doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French-door locks"@en .

aat:300033422 a skos:Concept ;
    skos:definition "Locks designed for the main entrance doors of public or residential buildings that usually have dead bolts and latch bolts, controlled by keys, knobs, or thumb-lift latches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "front-door locks"@en .

aat:300033423 a skos:Concept ;
    skos:definition "Locks designed or adapted to secure components of furniture such as drawers or cabinet doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture locks"@en .

aat:300033424 a skos:Concept ;
    skos:definition "Securing devices consisting of a dead bolt or system of bolts and that are operated by a key adapted to secure sliding receptacles fitted into furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawer locks"@en .

aat:300033432 a skos:Concept ;
    skos:definition "Mortise locks in which the cylinder is contained in the knob."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integral locks"@en .

aat:300033433 a skos:Concept ;
    skos:definition "Prison-type locks designed to be built into the masonry of the door jamb, the bolt when locked being projected from the jamb and engaging with the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jamb locks"@en .

aat:300033434 a skos:Concept ;
    skos:definition "Rim locks with opposing sides ornamented so that either side may be applied to a door, providing for both right and left hand orientation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "janus-face locks"@en .

aat:300033435 a skos:Concept ;
    skos:definition "Locks designed so that the key’s combination of bits can be changed at will, eliminating the operation of the lock with a previous key’s bit combination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key changing locks"@en .

aat:300033436 a skos:Concept ;
    skos:definition "Locks in which the bittings of a key lift each of the tumblers to exactly the right height so that they are all in proper alignment to permit the fence, a lug attached to the bolt, to pass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lever tumbler locks"@en .

aat:300033438 a skos:Concept ;
    skos:definition "Locking systems intended for use in a series, each lock of which may be actuated by two different keys, one capable of operating every lock of the series, and the other capable of operating only one or a few of the locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master-keyed locks"@en .

aat:300033439 a skos:Concept ;
    skos:definition "Locks designed to be cut into the edge of a door, not just applied to its surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortise locks"@en .

aat:300033443 a skos:Concept ;
    skos:definition "Locks designed with a push button or a turn-locking outside knob. When so locked, there is no entrance by key from the outside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patio locks"@en .

aat:300033444 a skos:Concept ;
    skos:definition "Locks having changeable tumblers actuated by either a key or dial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permutation locks"@en .

aat:300033445 a skos:Concept ;
    skos:definition "Factory assembled locks, requiring little or no alterations on installation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preassembled locks"@en .

aat:300033446 a skos:Concept ;
    skos:definition "Heavy duty locks designed specifically for securing cells or other doors in a prison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prison locks"@en .

aat:300033447 a skos:Concept ;
    skos:definition "Locks which are fitted into and flush with the rabbet on a rabbeted door jamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbeted locks"@en .

aat:300033448 a skos:Concept ;
    skos:definition "Locks with latch bolt bevels reversed from the normal direction to accommodate the swing of particular mounted doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverse bevel locks"@en .

aat:300033449 a skos:Concept ;
    skos:definition "Locks which can be adapted to fit a door of either hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reversible locks"@en .

aat:300033451 a skos:Concept ;
    skos:definition "Describes knobbed locks designed for doors opening from corridors into interior spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "room-door locks"@en .

aat:300033453 a skos:Concept ;
    skos:definition "Refers to mechanisms for securing doors that open by sliding sideways along a track rather than outward with hinges. These locks are usually designed to have a hook-shaped bolt to engage the strike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding-door locks"@en .

aat:300033454 a skos:Concept ;
    skos:definition "Time locks constructed to lock by the action of a clock at a predetermined time subsequent to and irrespective of the time of the closing of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subsequent locks"@en .

aat:300033455 a skos:Concept ;
    skos:definition "Locks for use on metal doors of the small chests or boxes within a fireproof safe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subtreasury locks"@en .

aat:300033456 a skos:Concept ;
    skos:definition "Door locks applied to the surface of a door with its strike applied to the face of the jamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rim locks"@en .

aat:300033457 a skos:Concept ;
    skos:definition "Assemblies that latch a pair of doors or the active leaf of a door at three points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-point locks"@en .

aat:300033458 a skos:Concept ;
    skos:definition "Locking mechanisms that are engineered to be disengaged only after a certain specified time period has elapsed. Often used on the doors of bank vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time locks"@en .

aat:300033459 a skos:Concept ;
    skos:definition "Locks having a case that requires a bored, round hole rather than a rectangular mortise. The face plate and the lock case are fastened together as a unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubular locks"@en .

aat:300033461 a skos:Concept ;
    skos:definition "Locks whose major dimension is vertical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upright locks"@en .

aat:300033462 a skos:Concept ;
    skos:definition "Mortise latches operated by knobs, levers, or thumb pieces from the inside, and from the outside by these same means when the stop works are not set, or by key when the stop works are set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestibule-door locks"@en .

aat:300033463 a skos:Concept ;
    skos:definition "Locks having for obstacles, projections cast in the keyhole opening or on the inside of the case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warded locks"@en .

aat:300033465 a skos:Concept ;
    skos:definition "Devices used to introduce capacitance into an electric circuit; consists of conducting plates insulated from each other by a layer of deilectric material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capacitors"@en .

aat:300033471 a skos:Concept ;
    skos:definition "Conductors, such as metallic substances or carbon, used to establish electrical contact with a non-metallic portion of a circuit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrodes"@en .

aat:300033472 a skos:Concept ;
    skos:definition "Bodies of electrically non-conducting material used for keeping charged conductors from contact with each other or from grounding and often also for supporting them. Usually refers to objects of glass or porcelain that support telephone or power lines, but that do not carry current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insulators"@en .

aat:300033473 a skos:Concept ;
    skos:definition "A passive device used in electronic circuitry to impede or control the flow of current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistors"@en .

aat:300033474 a skos:Concept ;
    skos:definition "Refers to an instrument used to determine the presence of electrical current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rheoscopes"@en .

aat:300033475 a skos:Concept ;
    skos:definition "A resistor that functions through manual or mechanical means to vary the flow of electrical current, or resistance, to a source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rheostats"@en .

aat:300033476 a skos:Concept ;
    skos:definition "Refers to a device used to interrupt electric current, now used historically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rheotomes"@en .

aat:300033486 a skos:Concept ;
    skos:definition "Hinges that swing casement windows outward, the phrase often used to describe those hinges that permit cleaning the outside glass surface on an outward-swinging window sash, when opened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casement hinges"@en .

aat:300033493 a skos:Concept ;
    skos:definition "Screws each having a head that is either curled or flattened so it can be turned with a thumb and fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumbscrews"@en .

aat:300033495 a skos:Concept ;
    skos:definition "Metal chains used in place of sash cords to connect a vertically hung sash with its counterweight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash chains"@en .

aat:300033496 a skos:Concept ;
    skos:definition "Ropes connecting a sash with its counterweight in a double-hung window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash cords"@en .

aat:300033498 a skos:Concept ;
    skos:definition "Devices attached to a sash rail by which the window may be raised or lowered; may be flush-mounted cups or surface-mounted bars or hooks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash lifts"@en .

aat:300033503 a skos:Concept ;
    skos:definition "Narrow rods inserted through holes drilled into both upper and lower sashes so that the lower sash may be held partly opened yet immobile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash pins"@en .

aat:300033504 a skos:Concept ;
    skos:definition "Hinged bars used to fasten a pair of shutters together in the closed position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutter bars"@en .

aat:300033505 a skos:Concept ;
    skos:definition "Ornamental gravitating catches used to hold opened shutters back against the exterior surface surrounding a window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutter dogs"@en .

aat:300033508 a skos:Concept ;
    skos:definition "Hinges designed to swing shutters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutter hinges"@en .

aat:300033510 a skos:Concept ;
    skos:definition "Any fastening devices which hold two window sashes together to prevent their opening or rattling. Sash fasts are usually attached to the meeting rails of a double-hung window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window locks"@en .

aat:300033512 a skos:Concept ;
    skos:definition "Spring bolts for holding a sliding sash in any desired position, open or shut; used with unbalanced sashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window spring bolts"@en .

aat:300033514 a skos:Concept ;
    skos:definition "Hinged strips, each with a slot on the free end so that it may be thrown over a staple and be secured there by means of a hook or lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hasps"@en .

aat:300033517 a skos:Concept ;
    skos:definition "Hinges in the form of long strips, and often used in furniture making, particularly for the lids of musical instruments such as pianos, hence the common variant “piano hinges.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous hinges"@en .

aat:300033519 a skos:Concept ;
    skos:definition "Hinges used on a swinging door that swings both ways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-acting hinges"@en .

aat:300033522 a skos:Concept ;
    skos:definition "Pivot door hinges mounted in or on the corners of a door, often installed with a door spring and door check."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor hinges"@en .

aat:300033523 a skos:Concept ;
    skos:definition "Hinges that use internal friction to hold a door or window in a selected position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction hinges"@en .

aat:300033524 a skos:Concept ;
    skos:definition "Hinges designed so that both leaves of the hinge are fully mortised into the frame and the edge of a door, leaving only the barrel of the hinge exposed when the door is closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-mortise hinges"@en .

aat:300033525 a skos:Concept ;
    skos:definition "Hinges that may be installed on the surface of a door and jamb without need of mortising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-surface hinges"@en .

aat:300033526 a skos:Concept ;
    skos:definition "Door hinges each having one plate surface-mounted on the jamb and the other plate mortised into the door stile; the opposite of half-surface hinges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-mortise hinges"@en .

aat:300033527 a skos:Concept ;
    skos:definition "Door hinges each having one plate surface-mounted onto the door leaf, and the other plate mortised into the jamb; the opposite of half-mortise hinges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-surface hinges"@en .

aat:300033529 a skos:Concept ;
    skos:definition "Door hinges each having a single joint, usually of modern design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paumelle hinges"@en .

aat:300033530 a skos:Concept ;
    skos:definition "Hinges with one leaf offset forward or backward to account for an insetting or projecting door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset hinges"@en .

aat:300033531 a skos:Concept ;
    skos:definition "Hinges designed to show only the knuckle, which is shaped like an olive, when the door is closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive knuckle hinges"@en .

aat:300033532 a skos:Concept ;
    skos:definition "Hinges equipped with oil-impregnated bearings between knuckles to reduce friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oilite bearing hinges"@en .

aat:300033534 a skos:Concept ;
    skos:definition "Devices that consist of a heavyweight hinge with an added pivot using the same pin. The leaves of the pivot interlock with the hinge leaves. Two conventional hinges are required to complete the set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pivot-reinforced hinges"@en .

aat:300033535 a skos:Concept ;
    skos:definition "Hinges, often ornamental, mounted on a face of a door rather than the edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface hinges"@en .

aat:300033536 a skos:Concept ;
    skos:definition "T-shaped, surface-mounted hinges. The cross arm of the T is fixed to a doorframe or post while the length of the T supports a door or gate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "T-hinges"@en .

aat:300033537 a skos:Concept ;
    skos:definition "Bent or curved devices used for suspending or fastening objects or for attaching objects to a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooks"@en .

aat:300033538 a skos:Concept ;
    skos:definition "Heavy hooks and eyes, generally used on marine installations. Distinguished from \"cabin hooks,\" which are generally used on cabinets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabin door hooks"@en .

aat:300033539 a skos:Concept ;
    skos:definition "Hooks that fasten to the ceiling or to the underside of shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling hooks"@en .

aat:300033541 a skos:Concept ;
    skos:definition "Hooks with one or more prongs, for use on the side walls of closets and wardrobes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wardrobe hooks"@en .

aat:300033542 a skos:Concept ;
    skos:definition "General purpose household hooks used for storage, especially in garages, sheds, utility rooms, or outdoors. Use includes for hanging bicycles, yard equipment, or sports gear, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility hooks"@en .

aat:300033544 a skos:Concept ;
    skos:definition "Describes handles in the form of small masses, usually rounded, which are intended to be mounted on the door of a cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet knobs"@en .

aat:300033545 a skos:Concept ;
    skos:definition "Knobs with a hole through which to receive a mounting screw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thru-screw knobs"@en .

aat:300033548 a skos:Concept ;
    skos:definition "Parts and components of bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolt components"@en .

aat:300033549 a skos:Concept ;
    skos:definition "Fastenings on a door frame into which a bolt is projected to secure a door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strikes"@en .

aat:300033550 a skos:Concept ;
    skos:definition "Strikes with enclosed recesses to receive lock bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box strikes"@en .

aat:300033551 a skos:Concept ;
    skos:definition "Strikes mortised into the edge of a door jamb and surrounding a deeper recess in the frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortise strikes"@en .

aat:300033552 a skos:Concept ;
    skos:definition "Strikes projecting slightly beyond the face of a door jamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface strikes"@en .

aat:300033553 a skos:Concept ;
    skos:definition "Strike plates for door frames that are designed to accept many or most lock latches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "universal strikes"@en .

aat:300033554 a skos:Concept ;
    skos:definition "Parts and components of hinges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinge components"@en .

aat:300033555 a skos:Concept ;
    skos:definition "Ornamental straps fastened to the surface of a door to render the appearance of a strap hinge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinge straps"@en .

aat:300033556 a skos:Concept ;
    skos:definition "Enlarged, protruding, cylindrical parts of a hinge through which the pin is inserted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knuckles"@en .

aat:300033558 a skos:Concept ;
    skos:definition "The long rods that pass through a hinge's knuckles to keep the two halves of the hinge joined together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pins"@en .

aat:300033559 a skos:Concept ;
    skos:definition "Parts and components of securing devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "securing device components"@en .

aat:300033561 a skos:Concept ;
    skos:definition "Parts of mortise locks that show at the edge of a door through which a latch bolt or dead bolt projects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faces"@en .

aat:300033562 a skos:Concept ;
    skos:definition "Lock parts through which spindles pass to actuate the mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hubs"@en .

aat:300033563 a skos:Concept ;
    skos:definition "Parts of strikes that project at an angle beyond the face of the door jamb to receive the beveled latch bolt and conduct it into the strike's recess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lips"@en .

aat:300033564 a skos:Concept ;
    skos:definition "Small knobs operated with a thumb and finger that engage and disengage a dead bolt and strike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumb turns"@en .

aat:300033565 a skos:Concept ;
    skos:definition "Fasteners that are designed for impact insertion, usually slender, pointed, and headed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nails"@en .

aat:300033566 a skos:Concept ;
    skos:definition "Nails having sharp edges along four sides of the shank, and often a flat, rectangular point. The shape of the shank allows the nail to punch its way through timber fibers rather than causing the wood to split. An example of use is for nailing hardwoods, such as oak flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut nails"@en .

aat:300033568 a skos:Concept ;
    skos:definition "Cylindrical fasteners having a head with a slot or recess and helical or spiral threading, to be inserted by rotating, as with a screwdriver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screws"@en .

aat:300033569 a skos:Concept ;
    skos:definition "Set screws that hold a cylinder in place to prevent the cylinder from being turned after installation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder screws"@en .

aat:300033570 a skos:Concept ;
    skos:definition "Fastener similar to a bolt but with a fine thread and a slotted head for use with a screwdriver. Often used to join sheet metal parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine screws"@en .

aat:300033571 a skos:Concept ;
    skos:definition "Screws that enable two objects to be secured together without a nut. These are usually in the form of shanks that are continuously threaded along their length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setscrews"@en .

aat:300033572 a skos:Concept ;
    skos:definition "Usually self-tapping screws, either round, flat, or pan-headed, threaded from tip to head, and used without a nut for fastening lapped sheet metal and some other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet metal screws"@en .

aat:300033573 a skos:Concept ;
    skos:definition "Heavy thumbscrews designed for securing one end of a vertical shutter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutter screws"@en .

aat:300033574 a skos:Concept ;
    skos:definition "Screws that clamp a movable part when it is required to be fixed, or otherwise form a stop, which check the motion or thrust of a mechanism or determine the position to which a part may be moved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stop screws"@en .

aat:300033575 a skos:Concept ;
    skos:definition "Wood screws designed to attach a stop bead, which is a narrow wooden strip that is molded on one edge, located in a door or window frame, and upon which a door or window sash closes. The screw is often placed within a washer-like recessed metal adjuster, to allow for periodic unscrewing and adjustment of the stop if the sash operation becomes difficult due to seasonal climate changes, and to allow for the easy removal of the stop for painting or glazing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stop bead screws"@en .

aat:300033578 a skos:Concept ;
    skos:definition "Plates with a cuplike inset used to facilitate opening sliding doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup escutcheons"@en .

aat:300033579 a skos:Concept ;
    skos:definition "The removable actuating devices of locks. For hand tools used for opening and closing devices other than locks and that do not have a jaw and do not fit into screws, use \"keys (adjusting equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keys"@en .

aat:300033584 a skos:Concept ;
    skos:definition "Keys with bittings on opposing sides of the shank, allowing either or both wings to operate the tumblers of a lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-bitted keys"@en .

aat:300033585 a skos:Concept ;
    skos:definition "Keys so constructed that the bit or portion that actuates the tumblers may be detached from the shank or handle of the key for convenience in carrying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detachable keys"@en .

aat:300033586 a skos:Concept ;
    skos:definition "Keys having a bow or handle pivoted to the shank so that it may drop or fall parallel with the surface of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop keys"@en .

aat:300033589 a skos:Concept ;
    skos:definition "Keys designed to open several different locks, each otherwise opened by different keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master keys"@en .

aat:300033590 a skos:Concept ;
    skos:definition "Keys that operate auxiliary locks that have a spring bolt operated from the outside by the key only and from the inside by a knob."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night keys"@en .

aat:300033591 a skos:Concept ;
    skos:definition "Round keys with hollow barrels made to fit over drill pin components generally found in cabinet locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe keys"@en .

aat:300033593 a skos:Concept ;
    skos:definition "Keys that are designed to operate the tumblers of a lock by longitudinal motion without rotation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "push keys"@en .

aat:300033594 a skos:Concept ;
    skos:definition "Describes keys designed with cylindrical shanks or stems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round keys"@en .

aat:300033595 a skos:Concept ;
    skos:definition "Keys adapted for use with a mortise lock and a cup escutcheon on sliding doors; its length is usually adjustable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding-door keys"@en .

aat:300033596 a skos:Concept ;
    skos:definition "Keys intended to be inserted into keyholes to prevent the insertion of keys from the opposing side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stop keys"@en .

aat:300033597 a skos:Concept ;
    skos:definition "Keys capable of controlling a subordinate group of master-keyed locks, each having a different key of its own, but all in turn controlled by the main master key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submaster keys"@en .

aat:300033598 a skos:Concept ;
    skos:definition "Pre-cut keys that fit multiple locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warded keys"@en .

aat:300033599 a skos:Concept ;
    skos:definition "Keys that have projections to operate the bolts of locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wing keys"@en .

aat:300033602 a skos:Concept ;
    skos:definition "The protective plates that surround keyholes, light switches, and doorknobs, for example."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escutcheons"@en .

aat:300033603 a skos:Concept ;
    skos:definition "Key plates with a pivoting pendant attached that drops to cover the keyhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop escutcheons"@en .

aat:300033604 a skos:Concept ;
    skos:definition "Cups or covers attached to the feet of furniture, to protect as well as to allow easy movement. Distinguished from \"castors (finish hardware)\" which are wheels set in a swivel and added to the feet on furniture to allow easy movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot sockets"@en .

aat:300033605 a skos:Concept ;
    skos:definition "Brackets, usually metal, used on closed stairways, and which fasten the handrail to the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handrail brackets"@en .

aat:300033606 a skos:Concept ;
    skos:definition "Rods affixed to the bases of stair risers that through pressure hold carpets designed for staircases securely in place, preventing slippage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stair carpet holders"@en .

aat:300033608 a skos:Concept ;
    skos:definition "The apparatus used or the manner of joining two or more parts of an object or structure. In bookbinding, the term describes the flexing exterior junctions of the spine and covers of a book. Distinguished from \"hinges (fasteners)\", which use strips of fabric or paper placed between the two halves of an endpaper where the body of the book is fixed to its cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joints"@en .

aat:300033609 a skos:Concept ;
    skos:definition "Connectors used to join concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete joints"@en .

aat:300033611 a skos:Concept ;
    skos:definition "Connectors used to join two or more pieces of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood joints"@en .

aat:300033618 a skos:Concept ;
    skos:definition "Unique works in which images are formed primarily by the direct application of pigments suspended in oil, water, egg yolk, molten wax, or other liquid, arranged in masses of color, onto a generally two-dimensional surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paintings"@en .

aat:300033622 a skos:Concept ;
    skos:definition "Circular paintings. For circular two-dimensional motifs, use \"medallions (ornament areas)\"; use \"roundels\" for circular panels in architectural contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tondi"@en .

aat:300033632 a skos:Concept ;
    skos:definition "Paintings on canvas attached to nonrectangular stretchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaped canvases"@en .

aat:300033636 a skos:Concept ;
    skos:definition "Japanese scrolls containing calligraphy and/or pictures, intended to be unrolled vertically and hung on the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kakemonos"@en .

aat:300033639 a skos:Concept ;
    skos:definition "Small paintings, generally smaller than two feet in any dimension, originally intended to be hung in small rooms or \"gabinetti\" of collectors. Typically dating to the 16th century and later; the support may be panel, ivory, metal, or canvas. The subjects depicted are of small scale, intended for viewing at close range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet pictures"@en .

aat:300033644 a skos:Concept ;
    skos:definition "Painted decorations or scenes that dominate a wall (or ceiling) surface. For works in other media that dominate a wall (or ceiling), use the more general term \"murals (any medium)\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mural paintings"@en .

aat:300033656 a skos:Concept ;
    skos:definition "Refers to paintings on wooden supports, including smaller portable paintings and medium-sized paintings, such as altarpieces, for which several planks of wood were joined to form a larger panel. The term is typically used to refer to paintings on a wooden support in Western art, generally dating from ancient Greece and Rome through the Renaissance, after which time canvas became the standard support for paintings in this size range. Panel paintings are still common today in Greek and Russian Orthodox icons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel paintings"@en .

aat:300033666 a skos:Concept ;
    skos:definition "Refers to paintings having a long, narrow scroll format. Term is often used in the context of Chinese and Japanese paintings on either hanging scrolls (kakemono, if Japanese) or on handscrolls (emakimono, if Japanese). For written documents on long, rolled strips, see \"scrolls (information artifacts).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scroll paintings"@en .

aat:300033668 a skos:Concept ;
    skos:definition "Refers to two-dimensional decoration applied to pottery by using paint made of metallic oxides or other pigments held in suspension in slip or another medium. The term is particularly used to refer to Ancient Greek red- and black-figure works. See also \"porcelain paintings (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vase paintings"@en .

aat:300033690 a skos:Concept ;
    skos:definition "Paintings executed in oil paint that were intended as preparatory studies of a more finished, usually larger, painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil sketches"@en .

aat:300033691 a skos:Concept ;
    skos:definition "Refers to abbozzi when in the context of French painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ébauches"@en .

aat:300033706 a skos:Concept ;
    skos:definition "Visual works made on any surface using the digits of the hand to apply paint or other liquidized medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger paintings"@en .

aat:300033725 a skos:Concept ;
    skos:definition "Images so executed as to give a distorted shape to the object represented but which, if viewed from a certain point or using a curved mirror or other instrument, show the object in true proportion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anamorphoses"@en .

aat:300033728 a skos:Concept ;
    skos:definition "Illusionistic paintings of the 16th to 18th century that appear to extend the actual architecture of an interior, usually on ceilings, sometimes on walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrature"@en .

aat:300033749 a skos:Concept ;
    skos:definition "Engravings, drawings, photographs, or other images that are shaded off gradually at the edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vignettes"@en .

aat:300033799 a skos:Concept ;
    skos:definition "Creative works in the medium of oil paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil paintings"@en .

aat:300033898 a skos:Concept ;
    skos:definition "Paintings that depict multi-figure narrative scenes of real or legendary events, especially those in the academic style and with subject matter intended to convey a noble sentiment. The term is especially applied to paintings that were common from the 17th through the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history paintings"@en .

aat:300033914 a skos:Concept ;
    skos:definition "Works of art that employ words and letters primarily as formal elements, often without regard to their verbal meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter pictures"@en .

aat:300033934 a skos:Concept ;
    skos:definition "Full-face portrait paintings placed on Egyptian mummies of the Roman period (2nd and 3rd centuries CE), most coming from Faiyum; usually in encaustic paint on panel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummy portraits"@en .

aat:300033936 a skos:Concept ;
    skos:definition "Paintings on a very small scale. The term is often applied specifically to small scenes in illuminated manuscripts or to portraits on vellum or ivory that were popular in Europe and America from the Renaissance into the 19th century. For paintings in manuscripts, the term \"illuminations\" may also be appropriate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniatures"@en .

aat:300033945 a skos:Concept ;
    skos:definition "In general meaning, images that portray a sacred entity and that are themselves regarded as sacred. In specific meaning, the term is typically used particularly for Christian images produced in the Eastern Rite churches, since the 6th century, according to prescribed formulas of subject (Christ, the Virgin, saints, and the great feasts) and composition, for devotional use in the church or home. Most commonly comprising tempera on panel, but they may be in any two-dimensional or relief medium, including fresco. Christians who venerate icons make the distinction between veneration and worship, although in actual practice the distinction is blurred. For a non-Christian image that is sacred or embodies a deity, use \"idol\" or \"cult image.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icons"@en .

aat:300033963 a skos:Concept ;
    skos:definition "Works in two dimensions or very low relief that were made by gluing paper, fabrics, photographs, or other materials onto a flat surface"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collages"@en .

aat:300033970 a skos:Concept ;
    skos:definition "Works produced by the technique of montage. If photographs dominate the composition, use \"photomontages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "montages"@en .

aat:300033973 a skos:Concept ;
    skos:definition "Visual works produced by drawing, which is the application of lines on a surface, often paper, by using a pencil, pen, chalk, or some other tracing instrument to focus on the delineation of form rather than the application of color. This term is often defined broadly to refer to computer-generated images as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawings"@en .

aat:300033982 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, created by oblique projection, in which parallel lines remain parallel. Typically two spatial axes are parallel to the plane of projection or drawing surface, and a third axis is projected at an angle other than 90 degrees to the plane. For drawings in which objects are depicted at an angle to the picture plane but parallel receding lines converge, use \"oblique perspectives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblique projections"@en .

aat:300033988 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, in oblique projection in which the vertical plane is parallel to the plane of projection (drawing surface)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elevation obliques"@en .

aat:300033998 a skos:Concept ;
    skos:definition "Drawings in oblique projection in which a vertical plane is parallel to the plane of projection (drawing surface), and receding planes are drawn at half the scale of that vertical plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet oblique drawings"@en .

aat:300034003 a skos:Concept ;
    skos:definition "Drawings in oblique projection in which the vertical plane is parallel to the plane of projection (drawing surface), and all three spatial axes are drawn to the same scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavalier oblique drawings"@en .

aat:300034010 a skos:Concept ;
    skos:definition "Drawings or works in another medium that show the components of a structure or object disassembled and spaced apart, but remaining in their proper relation with respect to their assembled positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exploded views"@en .

aat:300034017 a skos:Concept ;
    skos:definition "Drawings, prints, or other media in which the projectors are perpendicular to the plane of projection (drawing surface), that is, a three-dimensional object is shown fully frontally at all points, with no indication of recession into depth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthographic projections"@en .

aat:300034021 a skos:Concept ;
    skos:definition "Refers to drawings or works in another two-dimensional medium, where the image is created by using axonometric projection, which is a system of portraying a three dimensional object by depicting projectors parallel to each other and generally where at least one of the three spatial axes is inclined to the plane of projection. In modern architectural parlance, the term sometimes refers only to drawings depicted as if an orthographic rendering of the object has been tilted to the plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axonometric projections"@en .

aat:300034029 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, created by isometric projection, which is a projection in which all three spatial axes are equally inclined to the plane of projection or drawing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isometric projections"@en .

aat:300034039 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, created using dimetric projection, which is a projection in which all three spatial axes are inclined to the plane of projection or drawing surface, and two of the axes are equally inclined to the picture plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimetric projections"@en .

aat:300034043 a skos:Concept ;
    skos:definition "Refers to drawings in oblique projection in which the horizontal plane is parallel to the plane of projection or drawing surface, and the plan is rotated to any convenient angle so that verticals may be drawn. They are characterized by typically having a higher angle of view than an isometric drawing, and orthographic plans may be depicted on the horizontal surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plan oblique drawings"@en .

aat:300034058 a skos:Concept ;
    skos:definition "Refers to drawings created by trimetric projection, which is an axonometric projection where the three spatial axes are unequally inclined to the plane of projection or drawing surface, and the ratio of foreshortening is different for all three."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimetric projections"@en .

aat:300034063 a skos:Concept ;
    skos:definition "Refers to drawings or works in another two-dimensional medium where the work is created using multiview projection, which is a system of projection in which principal faces of an object or structure are parallel to the picture plane, but multiple views of the object or structure are provided in order to fully represent all sides of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiview projections"@en .

aat:300034065 a skos:Concept ;
    skos:definition "Drawings or works in another medium showing the arrangement of vertical elements of a building, either exterior or interior, as a direct projection to a vertical plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elevations"@en .

aat:300034092 a skos:Concept ;
    skos:definition "Elevations of only part of a structure. For drawings showing a structure as partly an exterior elevation and partly an interior elevation, use \"sectional elevations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partial elevations"@en .

aat:300034094 a skos:Concept ;
    skos:definition "Two-dimensional graphic renderings that represent half of the exterior façade of a symmetrical structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half elevations"@en .

aat:300034104 a skos:Concept ;
    skos:definition "Refers to drawings, sketches, prints, computer graphics, or works in other media depicting a building or any object viewed from above, geometrically represented as projected on a horizontal plane. The term is particularly used to refer to drawings or other images showing the relative positions of all the parts of a building, or of the parts of any one floor, roof, or other part of a building in horizontal section; it is thus distinguished from vertical sections or elevations. The term can also be used collectively to refer to sets of drawings or other images for a project, including plans per se as well as other drawings, such as sections. For general reference to depictions or photographs showing structures or sites seen from directly above, use \"plan views.\" For representations of portions of the Earth's surface use \"maps\" or \"plans (maps).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plans"@en .

aat:300034115 a skos:Concept ;
    skos:definition "Plans of one portion of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partial plans"@en .

aat:300034121 a skos:Concept ;
    skos:definition "Orthographic plans portraying buildings, topography, plantings, roads, and other features of an area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "area plans"@en .

aat:300034122 a skos:Concept ;
    skos:definition "Drawings or works in another medium laying out the precise arrangement of a structure on a plot of land. It may also refer to plans for gardens, groups of buildings, or developments, where the layout of buildings, roadways, utilities, landscape elements, topography, water features, and vegetation may be depicted. For drawings or other representations on a horizontal surface of cities or larger areas, particularly when such representations are not part of a design process, use \"plans (maps).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site plans"@en .

aat:300034135 a skos:Concept ;
    skos:definition "Plans that show the ground surface of a building site or other site, generally including grade elevations and contours."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grading plans"@en .

aat:300034137 a skos:Concept ;
    skos:definition "Site plans containing landscaping information, such as site grading, and location and description of plantings, sprinklers, or lighting devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscaping plans"@en .

aat:300034145 a skos:Concept ;
    skos:definition "Refers to plans indicating the layout of trees, shrubs, and other plants on a building site or for garden or landscape design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planting plans"@en .

aat:300034155 a skos:Concept ;
    skos:definition "Small-scale, simplified plans of a building or building site, with features or structures indicated by simple outlines or shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block plans"@en .

aat:300034157 a skos:Concept ;
    skos:definition "Orthographic drawings, prints, or sketches that depict a building, or sections of a building, on a horizontal plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building plans"@en .

aat:300034158 a skos:Concept ;
    skos:definition "Drawings or works in another two-dimensional medium that represent a horizontal section through a building taken above a floor to diagramatically illustrate the enclosing walls, interior spaces, doors, and windows of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor plans"@en .

aat:300034182 a skos:Concept ;
    skos:definition "Plans of one story of a building that has numerous stories in that form, thus illustrating what is typical or usual in the floor plans of this building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typical floor plans"@en .

aat:300034190 a skos:Concept ;
    skos:definition "Plans illustrating the piles, which are architectural foundation elements comprising timber, steel, or precast concrete columns that serve as subsurface supports for vertical loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piling plans"@en .

aat:300034192 a skos:Concept ;
    skos:definition "Plans that illustrate the beams and girders of each floor of a building and how they are connected. They typically use a simple system of symbols and drafting lines rather than detailed drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "framing plans"@en .

aat:300034200 a skos:Concept ;
    skos:definition "Plans designed for locating details that appear on other drawings, typically small-scale plans of a building or group of buildings that indicate the placement of principal elements of the scheme, which may each be represented in greater detail on other plans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key plans"@en .

aat:300034204 a skos:Concept ;
    skos:definition "Plans that are viewed from above, but laid out as if they were projected downward onto the back of an upper surface, such as a ceiling. In such a plan all members seen on the left from below appear on the right in the plan. The term also refers to plans for ceilings depicted as if reflected in a mirror on the floor, within the context of the floor plan, with the goal of illustrating how the ceiling design or configuration relates to the floor plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflected ceiling plans"@en .

aat:300034211 a skos:Concept ;
    skos:definition "Drawings or works in another medium, often made by an engineer, that indicate the location of utilities, including water supply lines, fire hydrants, sewage disposal lines, and other utilities typically located in the road right-of-way. As part of the construction process, these plans are generally required for submission to local authorities such as public works departments, public health boards, fire departments, pollution control regulators, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility plans"@en .

aat:300034215 a skos:Concept ;
    skos:definition "Scaled floor plans showing electrical layout; may include an adjacent small drawing of an elevation, or a riser diagram. For other drawings of electrical systems, use \"electrical drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical plans"@en .

aat:300034218 a skos:Concept ;
    skos:definition "Scaled floor plans showing HVAC layout, which is the layout for heating, ventilation, and air contitioning. They may include small drawings of an adjacent elevation. For other drawings of HVAC systems, use \"HVAC drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "HVAC plans"@en .

aat:300034221 a skos:Concept ;
    skos:definition "Refers to scaled floor plans showing plumbing layout; may include an adjacent small drawing of an elevation, or a riser diagram. For other drawings of plumbing systems, use \"plumbing drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumbing plans"@en .

aat:300034223 a skos:Concept ;
    skos:definition "Orthographic drawings or works in another media depicting a building, object, or site as if cut through and exposed at one specific plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sections"@en .

aat:300034229 a skos:Concept ;
    skos:definition "Oblique sections that are intended to show true shape of an oblique plane in the structure or object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary sections"@en .

aat:300034231 a skos:Concept ;
    skos:definition "Sections that are set apart from, but adjacent to, a main view of the structure or object through which the section is taken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "removed sections"@en .

aat:300034239 a skos:Concept ;
    skos:definition "Orthographic drawings that show a section of a structure or object revolved 90 degrees and drawn on the main view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolved sections"@en .

aat:300034243 a skos:Concept ;
    skos:definition "Orthographic drawings of the exterior of a structure or object with a small portion removed to show an interior detail. When a more substantial portion is removed, use \"half sections\" or \"sectional elevations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broken-out sections"@en .

aat:300034249 a skos:Concept ;
    skos:definition "Sections taken along the principal organizational axis of a structure or object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longitudinal sections"@en .

aat:300034254 a skos:Concept ;
    skos:definition "Orthographic images that depict a building, object, or site as if cut transversely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross sections"@en .

aat:300034256 a skos:Concept ;
    skos:definition "Drawings of sections taken at angles other than 90 degrees to the axis of the structure or object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblique sections"@en .

aat:300034258 a skos:Concept ;
    skos:definition "Sections in which the cutting plane is jogged to expose additional important features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset sections"@en .

aat:300034260 a skos:Concept ;
    skos:definition "Drawings of only part of a section through a building or object. For drawings of the exterior of a structure or object with a portion cut away so that the interior shows, use \"cutaway drawings,\" \"broken-out sections,\" \"half sections,\" or \"sectional elevations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partial sections"@en .

aat:300034264 a skos:Concept ;
    skos:definition "Orthographic drawings in which a symmetrical object is cut away so that one half of it is shown as an exterior elevation and the other as a section. For buildings thus represented, use \"sectional elevations.\" For drawings of an incomplete section alone, use \"partial sections.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half sections"@en .

aat:300034272 a skos:Concept ;
    skos:definition "Orthographic drawings or works of another medium depicting an object or structure seen in a vertical plane. In architecture, most often sections; in shipbuilding may be sections or elevations, but always showing the vessel broadside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "profiles"@en .

aat:300034294 a skos:Concept ;
    skos:definition "Refers to drawings or works in any other two-dimensional medium that employ perspective, meaning that they are executed by a systematic technique that creates the illusion of recession from a two-dimensional surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perspective views"@en .

aat:300034309 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, using two-point perspective, which is a system of linear perspective in which there are two vanishing points, one at either side of the composition, and where rectangular objects are generally set at an angle to the picture plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-point perspectives"@en .

aat:300034311 a skos:Concept ;
    skos:definition "Refers to drawings that are made using three-point perspective, which is either a system of linear perspective using three vanishing points where rectangular objects are set at an angle to the picture plane or a depiction where there are three points of view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-point perspectives"@en .

aat:300034319 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, that are made using one-point perspective, which is a system of linear perspective using one vanishing point to give the illusion of recession into space. The vanishing point is generally placed at or near the center of the composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-point perspectives"@en .

aat:300034336 a skos:Concept ;
    skos:definition "Perspective drawings of portions of the exterior or interior of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partial perspectives"@en .

aat:300034342 a skos:Concept ;
    skos:definition "Refers to drawings in which a structure or object is cut away in orthographic section, and a perspective is projected back from this plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectional perspectives"@en .

aat:300034364 a skos:Concept ;
    skos:definition "Refers to orthographic drawings or works in another medium projected at an angle other than the usual plan, section, or elevation, in order to show true shape of an oblique plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary views"@en .

aat:300034381 a skos:Concept ;
    skos:definition "Drawings done to express proposed designs in a competition, which is a formal process by which competing architects or artists submit plans to the same client or patron for the same architectural or artistic project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "competition drawings"@en .

aat:300034393 a skos:Concept ;
    skos:definition "Regarding the modern building trade, refers to drawings that indicate changes made during construction from the work proposed in the working drawings. For these and other drawings or copies of drawings that are kept as file records of a completed project, use \"record drawings.\" For scale drawings of existing structures, generally, use \"measured drawings\"; for drawings that generally depict actual locations, use \"topographical views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "as-built drawings"@en .

aat:300034395 a skos:Concept ;
    skos:definition "Drawings of an existing object, structure, or site, drawn to scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measured drawings"@en .

aat:300034403 a skos:Concept ;
    skos:definition "Drawings that are produced as a result of training under the tutelage of a master or an institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student drawings"@en .

aat:300034409 a skos:Concept ;
    skos:definition "Drawings required to be sent yearly from Rome to the Académie des Beaux-Arts in Paris by winners of the Prix de Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "envois"@en .

aat:300034430 a skos:Concept ;
    skos:definition "Drawings done early in a design process for art or architecture. They are typically more finished than sketches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preliminary drawings"@en .

aat:300034442 a skos:Concept ;
    skos:definition "Refers to full-size preparatory drawings made for the purpose of transferring a design to the working surface of a painting, tapestry, or other large work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartoons"@en .

aat:300034443 a skos:Concept ;
    skos:definition "Refers to complete drawings of whole compositions, whether as pattern drawings, working drawings, or done after a finished work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition drawings"@en .

aat:300034446 a skos:Concept ;
    skos:definition "Drawings done when an architectural design is more developed than at the stage of conceptual and schematic drawings but is not yet to the stage of working drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design development drawings"@en .

aat:300034451 a skos:Concept ;
    skos:definition "Architectural drawings presented to a client to illustrate how the building will look and function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation drawings"@en .

aat:300034458 a skos:Concept ;
    skos:definition "Diagrammatic drawings done early in the design process of an architectural project, usually drawn to scale and showing the entire project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schematic drawings"@en .

aat:300034464 a skos:Concept ;
    skos:definition "Underdrawings for fresco paintings made with the red earth pigment sinopia, which is brushed on the arriccio layer of plaster and over which the intonaco is applied before painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sinopie"@en .

aat:300034471 a skos:Concept ;
    skos:definition "Final drawings from which a structure, object, or work of art is made. For drawings done in developing a work, use \"sketches,\" \"studies (visual works),\" \"preliminary drawings,\" \"preparatory drawings,\" or \"design drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "working drawings"@en .

aat:300034478 a skos:Concept ;
    skos:definition "Refers to drawings, generally for engineering or construction, that depict how parts are positioned relative to one another in a design or plan. They may also depict how the parts are fixed in place and how depicted mechanisms should operate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assembly drawings"@en .

aat:300034482 a skos:Concept ;
    skos:definition "Graphic interpretations of the drawings or other contractual documents issued by the architect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clarification drawings"@en .

aat:300034486 a skos:Concept ;
    skos:definition "Drawings that are intended to show the assembly of small details of a larger construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minor assembly drawings"@en .

aat:300034490 a skos:Concept ;
    skos:definition "Drawings that form part of a contractual agreement and on the basis of which the contractor, architect, or artist is legally obliged to produce the drawings, building, painting, or other commissioned work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contract drawings"@en .

aat:300034494 a skos:Concept ;
    skos:definition "Drawings of construction or design details. For minute parts of a larger structure, object, or image, use \"details.\" For preparatory studies of pictorial or design details, use \"detail studies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detail drawings"@en .

aat:300034509 a skos:Concept ;
    skos:definition "Detail drawings made by an architectural office for reuse on more than one project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standard detail drawings"@en .

aat:300034518 a skos:Concept ;
    skos:definition "Working drawings that are usually produced by the manufacturer of a building element, and approved by the architect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shop drawings"@en .

aat:300034520 a skos:Concept ;
    skos:definition "Shop drawings depicting components and relative positions, for process of erection of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erection drawings"@en .

aat:300034530 a skos:Concept ;
    skos:definition "Refers to assembly drawings that depict only part of the equipment or design. They generally indicate how various components should operate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subassembly drawings"@en .

aat:300034540 a skos:Concept ;
    skos:definition "Drawings that are used to communicate information about buildings, specifically the mechanics of their construction, and used by the team tasked with erecting an edifice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction drawings"@en .

aat:300034549 a skos:Concept ;
    skos:definition "Drawings of electrical systems or parts thereof. For scaled floor plans specifically, use \"electrical plans.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical drawings"@en .

aat:300034557 a skos:Concept ;
    skos:definition "Drawings of the mechanical systems of buildings (e.g., HVAC and plumbing systems)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical drawings"@en .

aat:300034562 a skos:Concept ;
    skos:definition "Refers to drawings of HVAC systems, which are systems for heating, ventilation, and air conditioning. For scaled floor plans use \"HVAC plans\" or a more specific term, such as \"plumbing plans.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "HVAC drawings"@en .

aat:300034563 a skos:Concept ;
    skos:definition "Drawings of plumbing systems or parts thereof. For scaled floor plans specifically, use \"plumbing plans.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumbing drawings"@en .

aat:300034569 a skos:Concept ;
    skos:definition "Drawings that pertain specifically to the structural layout of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural drawings"@en .

aat:300034707 a skos:Concept ;
    skos:definition "Casual or aimless drawings or sketches. For hurried, negligent, and irregular writing or unmeaning marks, use \"scribbles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doodles"@en .

aat:300034719 a skos:Concept ;
    skos:definition "Refers to drawings or works in other media that are scaled representation of physical objects, meaning they represent the object and its parts in precisely the same proportion as the original, although it may be larger or smaller than the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scale drawings"@en .

aat:300034727 a skos:Concept ;
    skos:definition "Architectural drawings or drawings of other subjects, characterized by the depiction of shadows, textures, sometimes colors, often executed with watercolor washes, and showing some setting. Intended as visualizations of the full conception of a project or as an accurate record of the work depicted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "renderings"@en .

aat:300034736 a skos:Concept ;
    skos:definition "Images made by tracing, which is copying from an original by drawing over it onto a transparent or translucent piece of paper, cloth, or other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracings"@en .

aat:300034787 a skos:Concept ;
    skos:definition "Drawings of architecture and drawings for architectural projects, whether the project was executed or not. The term may also refer to any image in a two-dimensional medium that serves this same purpose, including prints and computer images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural drawings"@en .

aat:300034789 a skos:Concept ;
    skos:definition "The broad class of drawings that are intended for constructional, mechanical, or mapping purposes and that follow precise conventions of scale and projection, including cross-sections, details, diagrams, elevations, perspectives, plans, etc., made for use in a technical context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical drawings"@en .

aat:300034798 a skos:Concept ;
    skos:definition "Drawings made from a living model, typically drawings of the nude human figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life drawings"@en .

aat:300034808 a skos:Concept ;
    skos:definition "Refers to drawings intended as experiments rather than designs to be executed and that are not so speculative as fantastic art or architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theoretical drawings"@en .

aat:300036363 a skos:Concept ;
    skos:definition "Devices that fasten or hold together separate parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fasteners"@en .

aat:300036371 a skos:Concept ;
    skos:definition "Slender, smooth, wire nails having a small deep head used for finish carpentry work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brads"@en .

aat:300036375 a skos:Concept ;
    skos:definition "Distinctive hand-wrought nails of various designs made in historical China, typically characterized by having no head or with a head that is created by down pounding a finished nail, rather than being manufactured with a head using a head tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese nails"@en .

aat:300036377 a skos:Concept ;
    skos:definition "Nails used for the wooden decks of ships or decks attached to buildings, usually having a neat square or round, flat head that beds in flush with the surface of the plank of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deck nails"@en .

aat:300036382 a skos:Concept ;
    skos:definition "Large nails or spikes whose heads project over one side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog nails"@en .

aat:300036389 a skos:Concept ;
    skos:definition "Inverted-U-shaped nails made of a metal that is resistant to weather corrosion, used for attaching wire fencing to posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fencing nails"@en .

aat:300036391 a skos:Concept ;
    skos:definition "Steel nails each having a deformed shank, often helically threaded, having a countersunk head and a short diamond-shaped point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flooring nails"@en .

aat:300036393 a skos:Concept ;
    skos:definition "Flat-sided nails for fastening horseshoes to the horse’s hoof, and having an extended head to allow traction in the snow and ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frost horseshoe nails"@en .

aat:300036395 a skos:Concept ;
    skos:definition "Nails that have a broad head with a flat, rectangular shank and spear-like point. They differ from \"hurdle nails\" in that gate nails are usually stouter and made in various lengths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gate nails"@en .

aat:300036398 a skos:Concept ;
    skos:definition "Small nails, usually with a round head, used by upholsterers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gimp nails"@en .

aat:300036400 a skos:Concept ;
    skos:definition "Flat-sided nails of soft iron for fastening horseshoes to the horse’s hoof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horseshoe nails"@en .

aat:300036402 a skos:Concept ;
    skos:definition "Nails having a broad, round or rose head with a flat, rectangular shank and spear-like point, designed for easy clinching. So-named because they are well adapted for nailing and clinching together the oaken bars of portable hurdle fences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hurdle nails"@en .

aat:300036404 a skos:Concept ;
    skos:definition "Small wood nails with a tapered shank designed to avoid splitting the wood. Jobent nails are typically used for nailing thin plates of iron to wood or another material, for example when nailing small hinges on small chests or small cupboard doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jobent nails"@en .

aat:300036406 a skos:Concept ;
    skos:definition "Nails having a thin shank and a flat head, designed for attaching laths, which are narrow strips of wood, upon battens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lath nails"@en .

aat:300036408 a skos:Concept ;
    skos:definition "Nails with ringlike grooves around the shank to improve their grip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring-shank nails"@en .

aat:300036409 a skos:Concept ;
    skos:definition "Wrought nails with a faceted head, for example, cone-shaped or gem-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose nails"@en .

aat:300036411 a skos:Concept ;
    skos:definition "Screws that are driven with a hammer and removed with a screwdriver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drivescrews"@en .

aat:300036414 a skos:Concept ;
    skos:definition "Small, short nails with broad heads, designed to nail leathers to wood. Examples of use are nailing leather onto scuppers, which are holes on ships or other locations to allow water run-off, or to attach leathers to blacksmith bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scupper nails"@en .

aat:300036416 a skos:Concept ;
    skos:definition "Nails designed to fasten sheathing of wood or another material. Sheathing nails for wood sheathing have no points, but have square ends to punch out their own holes, driving a portion of the soft sheathing wood before them. Sheathing nails for metal sheathing are small sharp nails with a flat head. An example of sheathing requiring such nails is on a ship's bottom, where sheathing preserves the planks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheathing nails"@en .

aat:300036418 a skos:Concept ;
    skos:definition "Nails of various types used for wooden trunks, both to hold panels together and to attach leather or thin wooden supports to the face of panels. When attaching supports, the nails were driven part way into the panel and then a piece of iron was held against the interior, so that the nail hit the iron and clinched or curled back into the wood, in order create a smooth interior surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trunk nails"@en .

aat:300036421 a skos:Concept ;
    skos:definition "Cylindrical pieces of wood, metal, or other material used for fastening separate articles together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pegs"@en .

aat:300036423 a skos:Concept ;
    skos:definition "Small fasteners with a pointed or tapered end made of various materials used to pin something down or fasten something together. For jewelry having pins as methods of attachment, use \"pins (jewelry).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pins"@en .

aat:300036425 a skos:Concept ;
    skos:definition "Headed pinlike or boltlike fasteners of some malleable material used for uniting two or more pieces by passing the shank through a hole in each piece and then beating or pressing down the plain end so as to make a second head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rivets"@en .

aat:300036427 a skos:Concept ;
    skos:definition "Stout, sharp-pointed pieces of metal, wood, or other hard material, or stout sharp-pointed projecting parts of an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spikes"@en .

aat:300036429 a skos:Concept ;
    skos:definition "Bosses, rivets, or nails with a large head for ornament or protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studs"@en .

aat:300036430 a skos:Concept ;
    skos:definition "Small, sharp-pointed nail-like fasteners of iron or brass with a comparatively large head and used for fastening a light or thin object to something more solid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tacks"@en .

aat:300036432 a skos:Concept ;
    skos:definition "Flattened rings, usually made of metal, that are used in joints in order to relieve friction and prevent unsteadiness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washers"@en .

aat:300036436 a skos:Concept ;
    skos:definition "Half-round metal strips bent into a pinlike shape whose ends can be flared after insertion through a slot or hole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotter pins"@en .

aat:300036438 a skos:Concept ;
    skos:definition "Tapered pins used in steel erection to align holes for bolting or riveting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driftpins"@en .

aat:300036440 a skos:Concept ;
    skos:definition "Metal pins used in masonry work to support a horizontal string or line. The mason positions the line and then uses it as a guide in maintaining proper alignment of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line pins"@en .

aat:300036444 a skos:Concept ;
    skos:definition "Round pins used to fasten veneers until glue has set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneer pins"@en .

aat:300036446 a skos:Concept ;
    skos:definition "Nails having slender shanks and large, round, often decorative, heads, used to anchor upholstery and stuffing to the wooden frame of upholstered furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery studs"@en .

aat:300036448 a skos:Concept ;
    skos:definition "Flat-headed tacks used especially to fasten down carpets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpet tacks"@en .

aat:300036449 a skos:Concept ;
    skos:definition "Tacks with broad heads meant to be pressed with the thumb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumbtacks"@en .

aat:300036451 a skos:Concept ;
    skos:definition "Rose headed nails made of a soft material that allows for clinching, which is bending or beating back the tip after being driven through a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose clinch nails"@en .

aat:300036453 a skos:Concept ;
    skos:definition "Rose headed nails having a relatively flat head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose flat nails"@en .

aat:300036455 a skos:Concept ;
    skos:definition "Rose headed nails having sharp points and flat shanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose sharp nails"@en .

aat:300036745 a skos:Concept ;
    skos:definition "Refers generally to that category of costume designed to be worn or carried to protect the body in combat. Armor pieces which are always physical parts of or are affixed to other pieces and cannot function alone are collocated under the guide term \"<armor components>.\" For specifically groups of armor pieces designed as a whole to possess particular physical characteristics in order to suit a particular purpose or occasion, see \"armors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor"@en .

aat:300036752 a skos:Concept ;
    skos:definition "Pieces of armor protecting the back of the trunk, consisting either of several wide lames buckled together, or of a single plate, fastened to the breastplate by straps, hinges, or other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backplates"@en .

aat:300036753 a skos:Concept ;
    skos:definition "Pieces of armor protecting the front of the torso, consisting either of a single contoured plate, or of two or more plates or lames overlapping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breastplates"@en .

aat:300036755 a skos:Concept ;
    skos:definition "Jackets, sometimes sleeveless, made of leather, worn in 16th- and 17th-century Europe either under a cuirass or as an independent protection against edged weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buff coats"@en .

aat:300036756 a skos:Concept ;
    skos:definition "Tippets of mail attached around the lower edge and face opening of helmets, commonly basnets, to protect the shoulders, neck, and part of the face; used in the 14th and 15th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aventails"@en .

aat:300036760 a skos:Concept ;
    skos:definition "Plate armor for the thighs, usually attached to the poleyns at their lower end. Introduced during the 14th century, they evolved from a single plate covering the front of the thigh to articulated lames encircling the entire thigh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuisses"@en .

aat:300036765 a skos:Concept ;
    skos:definition "Plate armor for the knees, appearing first in the 14th century, consisting of a main cup-shaped piece fitting over the kneecap, often with additional articulated lames above and below it and a side wing on the outer side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poleyns"@en .

aat:300036767 a skos:Concept ;
    skos:definition "Armor pieces used in jousts in the 15th and 16th centuries, consisting of large metal plates, either shield-shaped or thigh-shaped, hung one on either side of the saddle or strapped to each of the combatant's thighs, to protect the thighs and knees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilting sockets"@en .

aat:300036768 a skos:Concept ;
    skos:definition "Armor protecting the front and back of the torso, variously made throughout their history of layers of linen or leather, metal scales, lames, or plates, or combinations of leather and metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuirasses"@en .

aat:300036769 a skos:Concept ;
    skos:definition "Cuirasses made in the form of a civilian doublet, consisting of two halves hinged to either side of a strip up the center of the back and fastened up the front like a waistcoat, generally with studs locked by hooks. Often they were furnished with steel imitation buttons down the front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waistcoat cuirasses"@en .

aat:300036770 a skos:Concept ;
    skos:definition "Armor pieces worn in both foot and mounted combat to protect the upper part of the buttocks, consisting of one or more articulated lames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culets"@en .

aat:300036772 a skos:Concept ;
    skos:definition "Gloves made of cloth or leather having a deep cuff which covers part of the forearm. Styled after those worn as armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauntlets"@en .

aat:300036775 a skos:Concept ;
    skos:definition "Plate armor pieces for the left hand and arm, protecting the hand and forearm up to or slightly beyond the elbow. They were used from the 15th through the 17th century, particularly in jousts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manifers"@en .

aat:300036780 a skos:Concept ;
    skos:definition "Gauntlets with a long cuff encircling the forearm up to the elbow where the edge often was cut at an angle to form a point. They were characteristic of foot soldiers' armor in the 16th century, and common for light cavalry from the 15th to the 17th century when they were worn on the left or bridle arm only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elbow gauntlets"@en .

aat:300036781 a skos:Concept ;
    skos:definition "Specialized type of mitten gauntlet, in which the end finger lame was extended so that, when the hand was closed, it could be fastened to the cuff, thus locking the hand in its grip on a weapon; they were popular in the 16th century as double pieces for foot-combat armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close gauntlets"@en .

aat:300036783 a skos:Concept ;
    skos:definition "Gauntlets consisting of a tubular plate cuff, a single plate or several articulated lames covering the back of the hand, and lames covering the fingers, with only the thumb being allowed independent movement. They were popular in German-dominated Europe from the 15th into the mid-16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitten gauntlets"@en .

aat:300036785 a skos:Concept ;
    skos:definition "Armor pieces protecting the neck and upper part of the chest, consisting either of a single plate or of two main front and back plates hinged together, often with additional lames at the upper edge encircling the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorgets"@en .

aat:300036787 a skos:Concept ;
    skos:definition "Large reinforcing armor pieces for tilt armor, usually made of a single heavy plate, protecting the left shoulder and upper arm, left side of the visor, and chest. They were used from the 15th through the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandguards"@en .

aat:300036788 a skos:Concept ;
    skos:definition "Plate armor for the lower legs, consisting of one contoured plate or two hinged together. Rare in Asia, they were worn in ancient Greece and Rome, and in the rest of Europe from the late 13th to the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greaves"@en .

aat:300036792 a skos:Concept ;
    skos:definition "Greaves consisting of front and back pieces, hinged together to enclose the lower leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed greaves"@en .

aat:300036794 a skos:Concept ;
    skos:definition "Any of various forms of protective coverings for the head, usually made of a hard material, including the outside steel layer of helmets that consist of inner and outer parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmets"@en .

aat:300036797 a skos:Concept ;
    skos:definition "Close-fitting helmets with a rounded skull, large hinged cheekpieces overlapping on the chin, and a pivoted visor, in use from the 15th to the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armets"@en .

aat:300036799 a skos:Concept ;
    skos:definition "Open helmets usually forged in one piece, having at first an ogival-shaped skull, later a rounded one, which extended down to protect the cheeks, leaving a small opening for the face. They were in use from the mid-14th to the late 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbuts"@en .

aat:300036802 a skos:Concept ;
    skos:definition "Helmets, generally ogival or egg-shaped with a pointed apex, and often fitted with an aventail and a hinged or pivoted visor, usually a pig-faced visor; used from the 13th to the 15th century. In the 15th century they became more globular and the aventail was replaced by gorget plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basnets"@en .

aat:300036806 a skos:Concept ;
    skos:definition "Light open helmets of ogival or hemispherical form, commonly furnished with a comb, a pointed peak projecting over the eyes, gorget plates on the lower part of the falling buffe, and hinged cheekpieces or earflaps. They were worn by infantry and light cavalry during the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burgonets"@en .

aat:300036807 a skos:Concept ;
    skos:definition "Helmets which are a cross between burgonets and close helmets; they are constructed like close helmets but, like burgonets, have a peak, cheekpieces, and a falling buffe instead of a visor and upper bevor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed burgonets"@en .

aat:300036810 a skos:Concept ;
    skos:definition "Closely fitting helmets with visor, bevor, and often gorget plates, enclosing the head and face; all main elements work on a common set of pivots at the temples. They were widely used from the 16th to the mid-17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close helmets"@en .

aat:300036811 a skos:Concept ;
    skos:definition "Heavy helmets completely enclosing the head and face, originally flat-topped, later having a conical or rounded top; used in warfare from the late 12th to the mid-14th century, and continued in use in tournaments until the mid-16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helms"@en .

aat:300036813 a skos:Concept ;
    skos:definition "Open helmets developed in the 16th century from the kettle hat, consisting of a skull with a broad curved brim, flat or turned down at the sides but sweeping upwards into a peak at front and rear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morions"@en .

aat:300036818 a skos:Concept ;
    skos:definition "Light European helmets of varying form, open-faced or with an attached visor, characterized by a laminated or solid pointed tail extending down the back to protect the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sallets"@en .

aat:300036824 a skos:Concept ;
    skos:definition "Low-skulled helmets that curve up and out at the top to form a flattened point along the line of sight, forming a thin gap between bevor and skull which served as an eye slit. Examples date from the late 14th to the 16th century, used in jousts rather than battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frog-mouthed helms"@en .

aat:300036843 a skos:Concept ;
    skos:definition "Parts and components of helmets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet components"@en .

aat:300036844 a skos:Concept ;
    skos:definition "Armor pieces protecting the throat and lower part of the face, worn either independently or attached to the helmet skull by pivoting rivets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bevors"@en .

aat:300036849 a skos:Concept ;
    skos:definition "Bevors to protect the chin and lower face, consisting of several lames articulated on sliding rivets, held in place by spring-operated catches or studs which, when released, allow the lames to fall open. They were commonly worn with open burgonets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falling buffes"@en .

aat:300036851 a skos:Concept ;
    skos:definition "Side plates on many types of helmets that protect the cheeks and sometimes the ears or the chin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheekpieces"@en .

aat:300036852 a skos:Concept ;
    skos:definition "Projecting pieces of headgear that shade or protect the eyes, entire face, or neck. Also, separate pieces of headgear attached to a stiffened headband, worn to protect the eyes or face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visors"@en .

aat:300036853 a skos:Concept ;
    skos:definition "Visors with deep horizontal ridges, used in the late 15th and early 16th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellows visors"@en .

aat:300036854 a skos:Concept ;
    skos:definition "Visors with sharply pointed or conical snouts, fitted on basnets in the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pig-faced visors"@en .

aat:300036863 a skos:Concept ;
    skos:definition "Devices attached to the right side of the breastplate, generally consisting of a small base plate to which is fixed or hinged a short, stout, projecting arm on which to rest the lance. They served to distribute the shock of impact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lance rests"@en .

aat:300036866 a skos:Concept ;
    skos:definition "Plate armor for the shoulders and upper arms, consisting either of one large plate shaped to the shoulder or several articulated lames, extending at the front and rear to protect the armpits and often the shoulder blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pauldrons"@en .

aat:300036868 a skos:Concept ;
    skos:definition "Armor pieces for the foot existing in various forms in Europe from Medieval times to the 16th century, comprised of mail or plates enclosing the ankle and lames covering the foot, plus a plate toecap. Some types had a detachable long point for the toecap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabatons"@en .

aat:300036869 a skos:Concept ;
    skos:definition "General term for armor pieces carried in the hand or on the arm, used to parry an opponent's blows or provide shelter from projectiles. They have existed worldwide throughout history in a wide variety of sizes, shapes, and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shields"@en .

aat:300036874 a skos:Concept ;
    skos:definition "Small shields with an internal grip, held in the left hand during foot combat; they were used from the 13th to the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucklers"@en .

aat:300036876 a skos:Concept ;
    skos:definition "Large shields, usually rectangular and typically with a central vertical groove on the inside into which a pole was fitted to prop the shields upright. They were commonly used from the 14th to the 16th century to protect archers on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavises"@en .

aat:300036879 a skos:Concept ;
    skos:definition "Light shields or bucklers, borne instead of the heavy shield by targemen, footmen, archers, and sometimes horsemen. They were in common use by infantry soldiers from the 13th to the 16th century and in tournaments. They may be fitted concave to the body, fitted on the inside with two straps, the forearm passing through one and the hand grasping the other, or having a slot for placement of a weapon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "targets"@en .

aat:300036881 a skos:Concept ;
    skos:definition "Circular steel plates attached to lances in front of the grip to protect the hand, in use from the 14th to the early 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vamplates"@en .

aat:300036893 a skos:Concept ;
    skos:definition "Armor pieces consisting of a single plate or a series of lames flexibly connected by straps and rivets, hung in front from each side of the fauld or breastplate to protect the upper part of the thigh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tassets"@en .

aat:300036905 a skos:Concept ;
    skos:definition "Armor pieces for the front of a horse's or camel's head, often with side plates to protect the cheeks and often decorated to match the armor of the rider. Known in classical Greece and from the 12th century on throughout Europe, the Middle East, Turkey, North Africa, and Japan, they were commonly made of either steel or leather, though the Japanese also used papier-maché and wood, the Ottoman Turks copper, and the Sudanese mainly brass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaffrons"@en .

aat:300036909 a skos:Concept ;
    skos:definition "Shaffrons covering only the upper part of the horse's head, popular in Europe during the mid-16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half shaffrons"@en .

aat:300036921 a skos:Concept ;
    skos:definition "Armor for the horse's neck, made of narrow lames articulated together, or of lames alternating with bands of mail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crinets"@en .

aat:300036922 a skos:Concept ;
    skos:definition "Leather straps that loop around the root of a horse's tail and fasten to the saddle to keep it from slipping forward. For the armor protecting a horse's hind quarters, use \"cruppers (horse armor).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruppers"@en .

aat:300036923 a skos:Concept ;
    skos:definition "Metal goads attached to a rider's boot heels, used to drive the horse on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spurs"@en .

aat:300036924 a skos:Concept ;
    skos:definition "Spurs furnished with a spiked wheel revolving on an axle fitted into the stem of the Y-shaped spur frame. They came into wide use in the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rowel spurs"@en .

aat:300036925 a skos:Concept ;
    skos:definition "Curved or pipelike armor pieces attached to the crupper to protect the root of the horse's tail, made of plate metal or leather, sometimes reinforced with metal scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tail guards"@en .

aat:300036926 a skos:Concept ;
    skos:definition "Implements or mechanisms used for defense or attack in combat, hunting, or war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weapons"@en .

aat:300036928 a skos:Concept ;
    skos:definition "Projectiles and propellants used to operate firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammunition"@en .

aat:300036930 a skos:Concept ;
    skos:definition "Deep containers made of metal, wood, or leather, used for holding and carrying arrows, typically worn slung across the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quivers"@en .

aat:300036931 a skos:Concept ;
    skos:definition "Relatively large firearms, generally having a bore of over one inch in diameter, designed to be supported on a gun mount or carriage when operated and requiring a crew of at least two people. Included are mounted guns, cannon, mortars, anti-aircraft weaponry, and other types of large-caliber firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artillery"@en .

aat:300036934 a skos:Concept ;
    skos:definition "Ancient projectile launchers used by the Imperial Romans, built like large crossbows and used to hurl javelins, large rocks, and other large projectiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballistae"@en .

aat:300036935 a skos:Concept ;
    skos:definition "Official nickname for a type of tube-shaped smoothbore portable rocket launcher, held atop the shoulder when fired, introduced as antitank weapons during the Second World War."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bazookas"@en .

aat:300036936 a skos:Concept ;
    skos:definition "General term for large artillery pieces, developed in Europe since the 14th century, consisting basically of a long smoothbore iron, bronze, or steel barrel, cast in one piece or built up by a series of forgings, supported on a carriage or stationary mount, capable of firing very heavy projectiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cannons"@en .

aat:300036937 a skos:Concept ;
    skos:definition "One of the common types of cannons in the 16th and 17th centuries, varying in weight and in the size and weight of shot fired from it, but generally of a bore between 6 and 7 inches in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demi-cannons"@en .

aat:300036938 a skos:Concept ;
    skos:definition "Relatively small cannons, generally breechloaders, originally used to fire stones, later also nails, iron scraps, and various types of shot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedreros"@en .

aat:300036939 a skos:Concept ;
    skos:definition "Cannons in use from the 15th to the 17th century, produced in various sizes and calibers but typically long in relation to their caliber and longer and lighter than bombards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentines"@en .

aat:300036942 a skos:Concept ;
    skos:definition "Term used from the 15th to the 17th century for cannons especially long in proportion to their bore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culverins"@en .

aat:300036943 a skos:Concept ;
    skos:definition "One of the common types of culverins in the 16th and 17th centuries, having a bore between 4 1/4 and 4 3/4 inches in diameter and firing balls of from 9 to 13 pounds in weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demi-culverins"@en .

aat:300036944 a skos:Concept ;
    skos:definition "Light cannons in use from the late 15th to the early 18th century, firing a ball of from 1 to 6 pounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falcons"@en .

aat:300036945 a skos:Concept ;
    skos:definition "Light cannons in use from the early 16th to the early 18th century, similar to falcons but comparatively smaller throughout their mutual development, firing a ball of from 1 to 3 pounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falconets"@en .

aat:300036947 a skos:Concept ;
    skos:definition "Artillery designed to fire at enemy aircraft in flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiaircraft guns"@en .

aat:300036948 a skos:Concept ;
    skos:definition "Guns designed for use against tanks or other armored vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antitank guns"@en .

aat:300036949 a skos:Concept ;
    skos:definition "Artillery designed to have cross-country or road mobility for use in the battlefield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field artillery"@en .

aat:300036950 a skos:Concept ;
    skos:definition "Artillery designed for use in defending fortresses; since they were not required to be mobile, they were generally heavier and of larger caliber than field artillery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garrison artillery"@en .

aat:300036951 a skos:Concept ;
    skos:definition "Machine guns first developed by Dr. Richard J. Gatling in 1861, featuring a cluster of revolving barrels equally spaced around a central shaft, a magazine to feed them, and an action by which the cartridges were chambered and fired. Early models were powered by a hand crank, later ones by electricity or gas, attaining a firing rate of up to 3000 rounds per minute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gatling guns"@en .

aat:300036952 a skos:Concept ;
    skos:definition "Heavy artillery mounted on and fired from rail-borne gun carriages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railway artillery"@en .

aat:300036953 a skos:Concept ;
    skos:definition "Describes artillery, particularly rifles, built so as to eliminate recoil, usually by means of an opening in the breechblock which permits controlled escape of propellant gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recoilless"@en .

aat:300036954 a skos:Concept ;
    skos:definition "Artillery specially designed for defending coastal areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal artillery"@en .

aat:300036955 a skos:Concept ;
    skos:definition "Artillery specially designed for the purpose of besieging a fortified location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siege artillery"@en .

aat:300036956 a skos:Concept ;
    skos:definition "Artillery mounted on vehicles that have their own motive power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-propelled artillery"@en .

aat:300036958 a skos:Concept ;
    skos:definition "Short, comparatively light artillery pieces combining some of the characteristics of cannons and mortars, able to fire heavy shells with a high curving trajectory but with a longer range than typical of mortars. Their development began around the end of the 16th century and continues to the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "howitzers"@en .

aat:300036960 a skos:Concept ;
    skos:definition "Small culverins about 7 feet long and of about a 3-inch bore, firing shot of approximately 4 pounds. They were in use during the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minions"@en .

aat:300036961 a skos:Concept ;
    skos:definition "Artillery, either rifled or smoothbore, characterized by shorter barrel, lower velocity, shorter range, and higher angle of fire than howitzers or cannons; most present day models are muzzleloading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortars"@en .

aat:300036965 a skos:Concept ;
    skos:definition "Devices, known since antiquity, used to batter through the walls or gates of a fortified place, basically consisting of a large beam with a heavy metal head, mounted on a wheeled carriage or a frame from which it could be swung back and forth, or carried by people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battering rams"@en .

aat:300036966 a skos:Concept ;
    skos:definition "Artillery pieces having a rifled bore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rifles"@en .

aat:300036969 a skos:Concept ;
    skos:definition "Small culverins used in the 16th and 17th centuries, designed to fire projectiles of less than 1 pound in weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robinets"@en .

aat:300036970 a skos:Concept ;
    skos:definition "Culverins in use from about the mid-14th to the late 17th century, between demi-culverins and minions in size, firing shot weighing from 5 to 6 pounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sakers"@en .

aat:300036972 a skos:Concept ;
    skos:definition "Medieval military weapons consisting basically of a lever with a great weight attached to the short arm and a basket, box, or sling attached to the end of the long arm to hold projectiles. When the weight is permitted to fall, the projectile is hurled with great velocity. Distinct from \"biffas\" in which the weight is attached flexibly to the longer arm and is movable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trebuchets"@en .

aat:300036973 a skos:Concept ;
    skos:definition "Weapons featuring a sharp edge or point for cutting, thrusting, clubbing, slashing, or various combinations thereof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edged weapons"@en .

aat:300036975 a skos:Concept ;
    skos:definition "Javelins of the ancient Franks, Anglo-Saxons, and others, comprising a long spear with a double barb, one tongue of which is longer than the other and flame-shaped. The weapon is found primarily in grave goods of the wealthy, and is believed to have been rarely used on the battlefield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angons"@en .

aat:300036976 a skos:Concept ;
    skos:definition "Projectiles generally consisting of a straight, slender shaft with a sharp point or carrying a sharp edged or pointed head of stone or metal, shot from a bow. More developed versions also have flights near the butt to stabilize their trajectory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrows"@en .

aat:300036979 a skos:Concept ;
    skos:definition "Parts and components of arrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrow components"@en .

aat:300036982 a skos:Concept ;
    skos:definition "Cutting weapons consisting basically of a relatively heavy, flat blade fixed to a handle, wielded by either striking or throwing. For axes used for other purposes, typically having narrower blades, use \"axes (tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axes"@en .

aat:300036987 a skos:Concept ;
    skos:definition "European staff weapons featuring a head with an axlike blade balanced behind by either a sharp, slightly curved fluke or a flat, ridged hammerhead, a short spike surmounting the staff, and metal reinforcement protecting the upper part of the staff, with a rondel just below it as a hand guard. They were popular in foot combat in both warfare and tournaments in the 15th and 16th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pollaxes"@en .

aat:300036989 a skos:Concept ;
    skos:definition "Pollaxes with a very long, narrow, curved blade, elongated at the uppper end for thrusting, used primarily in northeastern Europe, particularly Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berdyshes"@en .

aat:300036990 a skos:Concept ;
    skos:definition "Edged steel weapons resembling daggers or short swords, designed to be attached to the muzzle end of a firearm barrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bayonets"@en .

aat:300036991 a skos:Concept ;
    skos:definition "Detachable bayonets with a grip and sufficient breadth of blade to allow them to be used as knives or daggers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife bayonets"@en .

aat:300036992 a skos:Concept ;
    skos:definition "The earliest form of bayonet, consisting of a narrow, daggerlike blade with a grip tapered to fit into the muzzle of a firearm, thus converting it for use as a thrusting staff weapon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plug bayonets"@en .

aat:300036993 a skos:Concept ;
    skos:definition "Bayonets furnished with a socket handle which fitted over the muzzle and locked in place with a slot and stud, holding the bayonet parallel to the barrel; the firearm could still be fired when the bayonet was fixed. Introduced in the last quarter of the 17th century, they became the most popular form, continuing in use until the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socket bayonets"@en .

aat:300036994 a skos:Concept ;
    skos:definition "Bayonets introduced in Europe in the 18th century, designed primarily for use with shorter long guns such as carbines and musketoons, having long straight cutting blades and a swordlike grip and guard, Typically they attach to the barrel by means of a spring catch concealed in a slotted cavity in the grip which clips on to a bar on the side of the muzzle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sword bayonets"@en .

aat:300036996 a skos:Concept ;
    skos:definition "European staff weapons having a long blade with one cutting edge, convex or of flattened S-shape, divided at the top into a vertical spike and a forward curving hook, and with a horizontal fluke in the center of the back. They were used from at least the middle of the 13th until the 17th century, and were one of the most widely used foot soldiers' weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bills"@en .

aat:300036998 a skos:Concept ;
    skos:definition "Projectile weapons consisting of two or more stone or iron balls attached to the ends of a cord, whirled and thrown to entangle an animal or human being. Bolas were used by native peoples in the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolas"@en .

aat:300036999 a skos:Concept ;
    skos:definition "Stringed projectile weapons designed to propel arrows, generally consisting of a long stave of wood, metal, fiberglass, or other flexible material, with a length of strong string fastened to the tips of the stave which is bent in a curve, either permanently or from the tension of the string. The string is drawn back, holding the arrow by means of a notch in its rear tip, and propels the arrow upon release."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bows"@en .

aat:300037000 a skos:Concept ;
    skos:definition "Bows basically consisting of a curved stave mounted crosswise on a center shaft by means of a system of cord or gut bindings or metal bands, the string being drawn back, held, and released by some mechanical means such as a windlass or a rotatable nut. They were in use as early as the 11th century and continue to be used contemporarily for hunting and recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crossbows"@en .

aat:300037003 a skos:Concept ;
    skos:definition "Weapons worn on the hand to reinforce it and make a blow more effective, as by adding weight or sharp edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fist weapons"@en .

aat:300037005 a skos:Concept ;
    skos:definition "Ornamented barbed darts thrust into the neck and shoulders of the bull during a bullfight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banderillas"@en .

aat:300037006 a skos:Concept ;
    skos:definition "Highland Scottish sheath knives, daggerlike in appearance, having a blade with a single full-length cutting edge and a back which has a sharpened edge extending up for a short distance from the point, and a grip swelling in the center with a disc-shaped pommel. Also, short swords or daggers carried by navy officers in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dirks"@en .

aat:300037010 a skos:Concept ;
    skos:definition "Staff weapons widely used in warfare in the 15th and 16th centuries, having an axlike blade with a short fluke on the back and a spike at the top of the staff. After the late 16th century they increasingly came to be used solely as ceremonial weapons, in which capacity they survived well into the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halberds"@en .

aat:300037011 a skos:Concept ;
    skos:definition "Hunting weapons consisting of a fixed or detachable barbed head mounted on a staff, thrown by hand or fired from a harpoon gun, used against large fish and marine mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harpoons"@en .

aat:300037019 a skos:Concept ;
    skos:definition "Relatively short, light throwing spears used since ancient times in warfare and in hunting large game. Use also for the light shafts with pointed metal tip thrown for distance in track and field competition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "javelins"@en .

aat:300037021 a skos:Concept ;
    skos:definition "Large hunting and fighting knives with a heavy blade, typically from 10 to 15 inches long, that is straight and single-edged for most of their length until it curves concavely and acquires a double edge at the end. They were first produced for the American Colonel James Bowie in 1830."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowie knives"@en .

aat:300037029 a skos:Concept ;
    skos:definition "Staff weapons used both in warfare and tournaments, consisting of a long shaft with a steel head, carried by mounted knights or light cavalry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lances"@en .

aat:300037032 a skos:Concept ;
    skos:definition "Staff weapons having a broad, tapering triangular blade with two upturned lugs or wings at the base, used as thrusting and cutting weapons but also extremely popular as ceremonial weapons from the 16th to the 19th century, and still occasionally used as such today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partisans"@en .

aat:300037033 a skos:Concept ;
    skos:definition "Use generally for spears having a very sharply pointed steel head, somtimes with a hook or pick on the side. Use particularly for the very long type, from 16 to 22 feet in length, having a small leaf- or lozenge-shaped head, used by infantry as a defense against cavalry from the late 15th to the mid-17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pikes"@en .

aat:300037035 a skos:Concept ;
    skos:definition "Pikes with comparatively short, stout staffs, used as weapons aboard warships from the 16th into the 20th century either when boarding a ship or to repel boarders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boarding pikes"@en .

aat:300037036 a skos:Concept ;
    skos:definition "European daggers with light blades, square or triangular in section, and a reinforced beadlike point, in use primarily during the 16th and 17th centuries as parrying daggers in swordplay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poniards"@en .

aat:300037038 a skos:Concept ;
    skos:definition "Simple staff weapons having a sharp-pointed head and no auxiliary blades or points, used both in warfare and hunting since ancient times in many cultures and regions. Various forms have been designed for thrusting or throwing or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spears"@en .

aat:300037047 a skos:Concept ;
    skos:definition "Leading staffs with heads imitating those of various other staff weapons, but most commonly having a broad, pointed blade with a rounded base, often with two pointed lugs like a partisan or a crossbar like a boar spear. They were used in Great Britain and Continental Europe from the 18th into the mid-19th century by infantry subordinate officers, particularly English sergeants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spontoons"@en .

aat:300037048 a skos:Concept ;
    skos:definition "Edged weapons consisting basically of a blade, generally longer than that of daggers or knives, and a grip; designed for delivering cutting or thrusting blows or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swords"@en .

aat:300037050 a skos:Concept ;
    skos:definition "Term applied from at least the 17th century to heavy military swords with a large, straight, double-edged blade and a basket hilt or shell guard, designed primarily for cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadswords"@en .

aat:300037053 a skos:Concept ;
    skos:definition "Two-handed Scottish broadswords with a long, heavy double-edged blade, long diamond-section quillons angling toward the blade, and a tubular leather-covered hilt with a round pommel; they were used by Scottish Highlanders and mercenaries from the 15th to the 17th century. Use also for the one-handed Scottish broadswords with basket hilts in use in the British Army since the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claymores"@en .

aat:300037055 a skos:Concept ;
    skos:definition "Short, heavy cutting swords with a curved, single-edged blade. From the late 17th century onwards, the term has been used specifically for this type of sword as worn and used by navy personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutlasses"@en .

aat:300037058 a skos:Concept ;
    skos:definition "Weapons with a short, double-edged, sharp-pointed blade and a grip, used for stabbing or parrying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daggers"@en .

aat:300037062 a skos:Concept ;
    skos:definition "Daggers having a hilt shaped like a capital H on its side (becoming more like a capital I over time), usually worn at the girdle by civilians. The form originated in southern Germany or Switzerland in the late 13th century and remained in wide use throughout Europe until the late 15th century. Some types are as long as short swords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baselards"@en .

aat:300037063 a skos:Concept ;
    skos:definition "Heavy civilian daggers or short swords of 15th- and 16th-century Italy, characterized by a broad, flat double-edged triangular blade measuring five fingers in width at the hilt, a pair of short, arched quillons, a grip formed of two flat pieces riveted one on each side of the tang, and a pommel that is simply an arched cap fitted over the base of the grip. The blades are fluted and often elaborately decorated on the wider parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinquedeas"@en .

aat:300037069 a skos:Concept ;
    skos:definition "Daggers widely used by German and Swiss landsknechts during the 16th century, having a hilt, often of steel, with a grip which flares at the top and a guard with a shell or side ring and two quillons, either straight or curving towards the blade. They were furnished with a sheath, typically made of metal and decorated with raised bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Landsknecht daggers"@en .

aat:300037070 a skos:Concept ;
    skos:definition "Daggers designed to be held in the left hand to parry an opponent's weapon during swordplay. Typically they were made in sets as matching companion pieces to rapiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "left-hand daggers"@en .

aat:300037073 a skos:Concept ;
    skos:definition "Small daggers, probably Italian in origin, having a cross hilt and stiff, narrow blade of square or triangular section, used exclusively for stabbing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilettos"@en .

aat:300037075 a skos:Concept ;
    skos:definition "Stilettos having a scale for converting weight of shot into caliber engraved on the blade, issued to artillerymen in the 17th and 18th centuries for use as a weapon or tool, and as a symbol of rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunners' stilettos"@en .

aat:300037079 a skos:Concept ;
    skos:definition "Swords with a heavy, single-edged cutting blade, either straight or slightly convex, broadening out into a pronounced convex curve toward the tip, used in Europe roughly from the 13th to the 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falchions"@en .

aat:300037084 a skos:Concept ;
    skos:definition "Light double-edged swords having a simple cross hilt with small quillons and sometimes a side ring. They were used chiefly in the third quarter of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash swords"@en .

aat:300037085 a skos:Concept ;
    skos:definition "Light swords with a long, narrow, double-edged blade and a hilt furnished with extensive protection for the hand, such as arms of the hilt and side rings, a shell guard, or a cup guard. Originally designed for both cutting and thrusting, they developed into purely thrusting swords and became the principal fencing weapons of the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rapiers"@en .

aat:300037089 a skos:Concept ;
    skos:definition "Sabers with strongly curved blades tapering to a sharp point, traditionally associated with the Near East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scimitars"@en .

aat:300037094 a skos:Concept ;
    skos:definition "Swords with sharply pointed tips, designed primarily for thrusting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thrusting swords"@en .

aat:300037095 a skos:Concept ;
    skos:definition "Heavy swords of the 15th and 16th centuries, having a long rigid blade of square or triangular section, and originally a simple cross hilt with a relatively long grip, used primarily for thrusting. In the late 16th century the hilt acquired a more developed guard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estocs"@en .

aat:300037099 a skos:Concept ;
    skos:definition "Large, heavy European swords extending in length up to six feet and more and having an extra long grip, designed to be wielded with both hands. They were in use primarily in the 16th century by infantry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-handed swords"@en .

aat:300037101 a skos:Concept ;
    skos:definition "Swords that play a part in public state or civic ceremonies or rituals, being variously worn, carried, or presented, as symbols of honor or power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial swords"@en .

aat:300037105 a skos:Concept ;
    skos:definition "Swords designed specifically for hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting swords"@en .

aat:300037106 a skos:Concept ;
    skos:definition "Hunting swords having a long, straight, slender blade widening to a heavy point like a spearhead, often with a cross bar at the base to prevent the impaled prey from running up the blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boar-spear swords"@en .

aat:300037109 a skos:Concept ;
    skos:definition "Native American fighting hatchets used for striking blows and for throwing, consisting of a short wooden shaft and a head, originally of stone, later of metals such as iron and steel, with a blade usually narrow in proportion to its length. They were also used as tools, and sometimes combined with a tobacco pipe, the bowl being on the back of the blade. North American troops of colonial times and later often carried them in place of swords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomahawks"@en .

aat:300037110 a skos:Concept ;
    skos:definition "Parts and components of edged weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edged weapon components"@en .

aat:300037117 a skos:Concept ;
    skos:definition "The striking part of a percussion, edged, or projectile tool or weapon, or the part of an explosive projectile weapon carrying the live explosive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heads"@en .

aat:300037119 a skos:Concept ;
    skos:definition "Handles on edged weapons such as daggers, swords, and knives, typically consisting of the grip and the guard or guards, if any."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hilts"@en .

aat:300037121 a skos:Concept ;
    skos:definition "Hilts characterized by a cup- or bowl-shaped guard in front of the quillons, covering the user's hand and the arms of the hilt, developed in 17th-century Spain and those parts of Italy under Spanish influence. They are most often found on rapiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup-hilts"@en .

aat:300037122 a skos:Concept ;
    skos:definition "Sword hilts in which the knuckle guard extends or splits into one or more bars that sweep down in an S-shaped curve to link with the arms of the hilt. They were commonly made for rapiers in the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swept hilts"@en .

aat:300037126 a skos:Concept ;
    skos:definition "Terminal knobs, as on weapon handles or at the front of a saddle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pommels"@en .

aat:300037127 a skos:Concept ;
    skos:definition "Extended arms of a cross guard on a sword or dagger, consisting of straight, S-shaped, or inward curving bars set at the base of the grip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quillons"@en .

aat:300037130 a skos:Concept ;
    skos:definition "Curved sword guards, consisting of a metal bar extending from the cross guard toward the pommel, designed to give some protection to the knuckles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knuckle guards"@en .

aat:300037132 a skos:Concept ;
    skos:definition "Curving metal bands located one on each side of a sword hilt, between the quillons and the lower guard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arms of the hilt"@en .

aat:300037139 a skos:Concept ;
    skos:definition "Rigid sheaths made of wood, metal, or leather, used to enclose and carry edged weapons or tools, or hand weapons such as carbines and rifles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scabbards"@en .

aat:300037148 a skos:Concept ;
    skos:definition "Use generally for weapons using the power of exploding gunpowder to propel a projectile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firearms"@en .

aat:300037150 a skos:Concept ;
    skos:definition "Firearms, generally having a bore of 1 inch or less in diameter, that are designed to be operated by one person, held in one or both hands, with or without the support of the shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small arms"@en .

aat:300037153 a skos:Concept ;
    skos:definition "Smoothbore long guns that usually fire charges of shot rather than single projectiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shotguns"@en .

aat:300037158 a skos:Concept ;
    skos:definition "Firearms that can be held and fired with one hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handguns"@en .

aat:300037160 a skos:Concept ;
    skos:definition "Short firearms, either rifled or smoothbore, with the chamber made as an integral part of the barrel, designed for use with one hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pistols"@en .

aat:300037163 a skos:Concept ;
    skos:definition "Pistols with a flaring muzzle like a blunderbuss, intended to be loaded with shot for use at close range. They were extremely popular from the mid-18th to the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blunderbuss pistols"@en .

aat:300037165 a skos:Concept ;
    skos:definition "Pistols made expressly for formal personal combat, usually in pairs and furnished with a case, and generally characterized by high technical quality with only modest decoration. They commonly date from the late 18th to the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dueling pistols"@en .

aat:300037166 a skos:Concept ;
    skos:definition "Wheel lock, flintlock, or snaphance pistols designed to be carried in holsters on saddles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holster pistols"@en .

aat:300037168 a skos:Concept ;
    skos:definition "Large pocket pistols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt pistols"@en .

aat:300037169 a skos:Concept ;
    skos:definition "Pistols small enough to be carried in a pocket or otherwise concealed about the body, originating in the late 16th century though most common from the second half of the 17th to the late 19th century. Many feature mechanisms such as box locks, folding triggers, and safety catches to reduce the danger of the pistol catching on the clothing when withdrawn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket pistols"@en .

aat:300037173 a skos:Concept ;
    skos:definition "Single-barreled firearms, typically handguns but also some long guns and machine guns, having a multichambered cylinder which revolves around an axis parallel to the bore, each chamber firing separately. For firearms with several revolving barrels, use \"pepperboxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolvers"@en .

aat:300037179 a skos:Concept ;
    skos:definition "Heavy, smoothbore military long guns of large caliber, usually muzzleloading, furnished with varying types of firing mechanism throughout their history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muskets"@en .

aat:300037181 a skos:Concept ;
    skos:definition "Firearms having a rifled bore and designed to be fired by one person from the shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rifles"@en .

aat:300037183 a skos:Concept ;
    skos:definition "American-made muzzleloading flintlock rifles manufactured, mainly in Pennsylvania, from the Revolution to the late 19th century, characterized by a long octagonal barrel, maple stock, brass fittings, and ornamental openwork mounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American long rifles"@en .

aat:300037189 a skos:Concept ;
    skos:definition "Mechanical devices for igniting the propellant charge in firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locks"@en .

aat:300037190 a skos:Concept ;
    skos:definition "Locks in which the steel and pan cover are made in one piece and the sear operates vertically to engage in two notches in a tumbler attached to the inner end of the cock spindle, to place the mechanism in either half-cock or full cock. When the trigger is pressed, the flint strikes the steel and simultaneously the pan is uncovered, exposing the priming powder therein to a shower of sparks that ignite the charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flintlocks"@en .

aat:300037192 a skos:Concept ;
    skos:definition "The earliest type of mechanical ignition system for firearms, originating in the mid-15th century, consisting of a slow-burning match or wick held in an arm which, when the trigger is pressed, lowers the match into a pan full of priming powder, the burning of which ignites the main charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matchlocks"@en .

aat:300037196 a skos:Concept ;
    skos:definition "Firearms in which, after initial manual or mechanical loading, the process of firing, extraction, ejection, and reloading continues without intermission as long as the trigger is pressed and the supply of ammunition lasts. To describe firearms which reload automatically after firing but require a squeeze of the trigger for each shot, use \"semiautomatic.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automatic"@en .

aat:300037197 a skos:Concept ;
    skos:definition "Use to describe firearms that are loaded at the rear end of the barrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breechloading"@en .

aat:300037199 a skos:Concept ;
    skos:definition "Use to describe firearms which are loaded from the front end of the barrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muzzleloading"@en .

aat:300037200 a skos:Concept ;
    skos:definition "Firearms in which the cartridge case of a fired shot is extracted and ejected and a fresh one loaded, but which require a squeeze of the trigger for each shot. To describe firearms which continue to fire without intermission as long as the trigger is pressed and the supply of ammunition lasts, use \"automatic.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semiautomatic"@en .

aat:300037204 a skos:Concept ;
    skos:definition "Parts and components of weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weapon components"@en .

aat:300037206 a skos:Concept ;
    skos:definition "General term for percussive weapons typically consisting of a staff of wood, metal, or other hard, heavy material, often carrying a head of stone or metal, wielded by hand as striking weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clubs"@en .

aat:300037208 a skos:Concept ;
    skos:definition "Throwing clubs with a short shaft and a large heavy knob at one end, originating in southern Africa and typically made of hardwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knobkerries"@en .

aat:300037212 a skos:Concept ;
    skos:definition "American weapons consisting of a band of metal, either with holes for four fingers or a single large opening to slip the main part of the hand into, leaving the thumb outside, used to increase the effect of a blow with the fist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brass knuckles"@en .

aat:300037214 a skos:Concept ;
    skos:definition "Clubs used throughout Europe mainly from the 11th to the 17th century, made either entirely of metal or of a wooden shaft with a metal head, the head having longitudinal grooves or flanges and sometimes surmounted by a spike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maces"@en .

aat:300037216 a skos:Concept ;
    skos:definition "Throwing weapons consisting basically of a strap of leather, fabric, or similar flexible material, widening into a pouch at the center to hold the projectile. They are held by the two ends and swung round rapidly, then one end is released to hurl the projectile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slings"@en .

aat:300037217 a skos:Concept ;
    skos:definition "Historical military engines of various designs for discharging darts, stones, or other missiles. A typical design consists of a long upright arm with a spoon-shaped or slinglike holder to carry the projectile at the upper end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catapults"@en .

aat:300037219 a skos:Concept ;
    skos:definition "Short straight, angular, or curved sticks, flat or cylindrical in form, thrown by hand as a hunting or, more rarely, war weapon. They occur in various parts of the world, including ancient Egypt and Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing sticks"@en .

aat:300037220 a skos:Concept ;
    skos:definition "Highly developed throwing-sticks of the Australian aborigines, known also in India, Africa, the Americas, and ancient Egypt, being basically curved or angular flat sticks designed so that they can be thrown so as to return to their starting point. They have been used in warfare, for hunting, and as recreational objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boomerangs"@en .

aat:300037222 a skos:Concept ;
    skos:definition "Pieces of metal stamped by government authority for use as money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coins"@en .

aat:300037231 a skos:Concept ;
    skos:definition "Silver coins of Austria issued between 1740 and 1780 and then sporadically until 1961; used for trade with Africa and the Near East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maria Theresa dollars"@en .

aat:300037238 a skos:Concept ;
    skos:definition "Refers to any of various French gold or silver coins issued from the 13th through the 18th century, bearing the figure of a shield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "écus"@en .

aat:300037239 a skos:Concept ;
    skos:definition "General term for a number of gold or silver coins based on the Florentine original gold coin. Originally, florins were Florentine gold coins struck from 1252 until the 16th century; to refer specifically to the Florentine coins, prefer the narrower term \"fiorini d'oro.\" Examples of florins include Hungarian gold coins introduced in the early 14th century, Austrian silver coins of the 19th and 20th centuries, and English two-shilling silver coins issued in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "florins"@en .

aat:300037240 a skos:Concept ;
    skos:definition "French silver coins introduced by Louis IX in 1266 and stopped by Charles V in the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gros tournois"@en .

aat:300037241 a skos:Concept ;
    skos:definition "French silver coins of varying values used in the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testons"@en .

aat:300037245 a skos:Concept ;
    skos:definition "Ancient Greek silver coins worth ten drachmas, struck in the 5th and 4th centuries BCE, primarily in Sicily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decadrachms"@en .

aat:300037247 a skos:Concept ;
    skos:definition "Ancient Greek and Roman silver coins valued at two drachmas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "didrachms"@en .

aat:300037251 a skos:Concept ;
    skos:definition "Small silver coins struck in several areas of the ancient Greek world from the 6th century BCE and generally worth one sixth of a drachma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obols"@en .

aat:300037252 a skos:Concept ;
    skos:definition "Gold coins of the Roman and Byzantine periods from the early 4th until the 11th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solidi"@en .

aat:300037254 a skos:Concept ;
    skos:definition "Ancient Greek coins worth four drachmas, originally of pure silver but gradually debased over its lifetime from the mid-6th century BCE until about CE 300."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetradrachms"@en .

aat:300037256 a skos:Concept ;
    skos:definition "Ancient Greek coins valued at three obols or one half of a drachma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triobols"@en .

aat:300037257 a skos:Concept ;
    skos:definition "Coins used during Islamic reigns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic coins"@en .

aat:300037258 a skos:Concept ;
    skos:definition "Islamic silver coins struck from the 7th to the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dirhams"@en .

aat:300037265 a skos:Concept ;
    skos:definition "Billon or copper coins of the Roman Empire issued from the mid-4th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centenionales"@en .

aat:300037266 a skos:Concept ;
    skos:definition "Roman silver coins originally valued at ten asses, later debased in value and purity; in use from the late 3rd century BCE until the mid-3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denarii"@en .

aat:300037267 a skos:Concept ;
    skos:definition "Roman bronze or brass coins worth two asses minted from the early third century BCE until the mid-3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dupondii"@en .

aat:300037268 a skos:Concept ;
    skos:definition "Ancient Roman copper coins of the 3rd and 4th centuries, replaced by centenionales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folles"@en .

aat:300037269 a skos:Concept ;
    skos:definition "Roman silver coins of several valuations, originating at one-half denarius, produced beginning in the late 3rd century BCE; later also of gold or bronze and issued until the 3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quinarii"@en .

aat:300037270 a skos:Concept ;
    skos:definition "Ancient Roman silver or copper coins originally valued at two-and-one-half asses or one-fourth denarius, later at 4 asses, and issued from the late 3rd century BCE until the mid-3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sestertii"@en .

aat:300037271 a skos:Concept ;
    skos:definition "Late Roman and Early Byzantine silver coins issued between the late 3rd and early 7th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siliquae"@en .

aat:300037273 a skos:Concept ;
    skos:definition "Designates various Spanish and Spanish-American gold coins issued between the 15th and the 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doubloons"@en .

aat:300037275 a skos:Concept ;
    skos:definition "Silver coins of Spain and Spanish America introduced in the mid-14th century and issued until the mid-19th century, except in Guatemala where issue continued in copper-nickel into the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reales"@en .

aat:300037277 a skos:Concept ;
    skos:definition "Designates various copper, copper alloy, steel, and copper-plated zinc coins valued at one-hundredth part of a dollar or pound sterling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cents"@en .

aat:300037279 a skos:Concept ;
    skos:definition "Silver and cupronickel decimal coins of the United States and certain other former British colonies issued since 1796 and valued at one tenth of a dollar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimes"@en .

aat:300037280 a skos:Concept ;
    skos:definition "Silver or cupronickel coins valued at 100 cents; originally from a silver coin that circulated in many European countries, from the German \"thaler.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollars"@en .

aat:300037283 a skos:Concept ;
    skos:definition "United States copper or bronze coins minted at various times between 1793 and 1857 and valued at one half of a cent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half cents"@en .

aat:300037284 a skos:Concept ;
    skos:definition "Five-dollar gold pieces issued by the United States between 1795 and 1916 and again in 1929."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half eagles"@en .

aat:300037285 a skos:Concept ;
    skos:definition "United States silver coins valued at five cents and minted between 1794 and 1805 and between 1829 and 1873."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half dimes"@en .

aat:300037289 a skos:Concept ;
    skos:definition "Coins issued in various metals and valued at twenty-five cents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter dollars"@en .

aat:300037291 a skos:Concept ;
    skos:definition "United States gold coins issued between 1796 and 1929 and valued at two dollars and fifty cents or one quarter of an eagle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter eagles"@en .

aat:300037293 a skos:Concept ;
    skos:definition "Very thin, usually silver, coins struck with an obverse die only so that the design shows through on the reverse; used in Germany and neighboring territories between the 12th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracteates"@en .

aat:300037295 a skos:Concept ;
    skos:definition "Use only for those British large silver coins struck sporadically from 1551 to 1937 and valued at five shillings, and for British cupronickel coins of the same value issued from 1937 to 1965."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowns"@en .

aat:300037297 a skos:Concept ;
    skos:definition "Islamic gold coins issued from the 7th to the 18th century; originally struck with legends on both sides and in the same size and weight as Byzantine solidi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinars"@en .

aat:300037302 a skos:Concept ;
    skos:definition "Gold or silver coins of India issued from the late 16th to the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pagodas"@en .

aat:300037305 a skos:Concept ;
    skos:definition "Italian, medium-sized silver coins used from 1475 until 1846."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testoni"@en .

aat:300037316 a skos:Concept ;
    skos:definition "Objects that serve as media of exchange and are in general circulation, and by common agreement used as payment for goods and services and for the settlement of debts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "money"@en .

aat:300037320 a skos:Concept ;
    skos:definition "Seals or imprinted marks on documents or other objects, or small pieces of paper, usually adhesive-backed, issued by an organization to show that a payment has been made and that a service is due or that goods may be obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamps"@en .

aat:300037321 a skos:Concept ;
    skos:definition "Government-authorized adhesive stamps, imprinted stamps, hand stamps, or meter markings issued as evidence of prepayment of postage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postage stamps"@en .

aat:300037327 a skos:Concept ;
    skos:definition "Medium of exchange consisting of shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell money"@en .

aat:300037334 a skos:Concept ;
    skos:definition "Designates substitutes for money that move within a limited universe, usually not in general circulation, may be exchanged for particular goods or services, and are made from hard substances whose intrinsic value is always less than the stated value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tokens"@en .

aat:300037336 a skos:Concept ;
    skos:definition "Works that facilitate human activity and to provide for physical needs of people in or around a building generally by offering comfort, convenience, or protection. An example of usage is in distinguishing the architecture of a building from the furnishings that are placed in and around it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnishings"@en .

aat:300037348 a skos:Concept ;
    skos:definition "Heavy pieces of cloth painted to imitate carpet, tile, or some other floor covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor cloths"@en .

aat:300037353 a skos:Concept ;
    skos:definition "Various materials used to decorate and protect walls and other surfaces, often in the form of flexible sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall coverings"@en .

aat:300037448 a skos:Concept ;
    skos:definition "Wallpapers decorated with large nonrepeating scenes, usually of landscape, literary, or mythological subjects, which create a panoramic effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scenic wallpapers"@en .

aat:300037472 a skos:Concept ;
    skos:definition "Wallpapers with patterns that simulate draped textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drapery papers"@en .

aat:300037486 a skos:Concept ;
    skos:definition "Wallpapers with texture produced by means of powdered textile fibers glued into place on the paper surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flock papers"@en .

aat:300037523 a skos:Concept ;
    skos:definition "Wallpapers with colors blended in subtle gradations, particularly in the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rainbow papers"@en .

aat:300037560 a skos:Concept ;
    skos:definition "Embossed wall covering made of an impressed mixture of linseed oil, sawdust, and chalk adhered to a fabric or cloth backing; made by a process patented by Frederick Walton in 1877."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lincrusta"@en .

aat:300037564 a skos:Concept ;
    skos:definition "Hangings for windows, doorways, or other openings, usually of cloth, plastic, or another such material, that are generally finished with hems, casings, pleats, or ruffles and hung by the top edge; used for privacy, control of light and drafts, or decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtains"@en .

aat:300037581 a skos:Concept ;
    skos:definition "Apparatus, fixed or portable, whose primary purpose is to produce artificial light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting devices"@en .

aat:300037583 a skos:Concept ;
    skos:definition "Devices for supporting candles, having one or more candle sockets or spikes to secure candles; sometimes having drips to catch wax, push-ups, and other devices for removing the stub, or adjustable features for controlling the position of the flame. For lamps using candles as the source of illumination and containing the candle within a vessel, use \"candle lamps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candleholders"@en .

aat:300037584 a skos:Concept ;
    skos:definition "Candleholders with two or more arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candelabras"@en .

aat:300037585 a skos:Concept ;
    skos:definition "Figural candelabras or candlesticks of the mid- to late 19th century, made of cast brass with gilt finish, and having marble bases and cut prisms around the candle sockets, often used in sets consisting of a candelabrum flanked by two candlesticks; term originally applied to the set as well as to the individual pieces; also an ornate wall sconce with one or more candle branches mounted on the wall or attached to the sides of a mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girandoles"@en .

aat:300037588 a skos:Concept ;
    skos:definition "Candleholders with a single candle socket mounted on a support with a widened base or foot for balance; often the support is columnar in form. For candleholders with a single candle socket set on a flat saucer or traylike base, use \"chambersticks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlesticks"@en .

aat:300037589 a skos:Concept ;
    skos:definition "Lighting devices designed to hang on a wall having one or more candle sockets or lamp holders; often ornamental and frequently incorporating a reflector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sconces"@en .

aat:300037591 a skos:Concept ;
    skos:definition "Vessels, usually made of iron or earthware, used for holding burning oil, pitch, or other flammable substances for lighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cressets"@en .

aat:300037592 a skos:Concept ;
    skos:definition "Lighting devices having a vessel to contain fuel used as a source of illumination, such as grease or oil. The term also refers to relatively small -- of a size to be placed on or beside a desk or table -- household or office lighting devices that incorporate a vessel of glass or some similar material that encloses the source of illumination, whether a candle, oil, gas-jet, or incandescent wire inside a light bulb. The lamp was invented at least as early as 70,000 BCE, originally consisting of a hollowed-out rock filled with moss or some other absorbent material that was soaked with animal fat and ignited. To refer to the glass bulbs used as a component of electric lamps, use \"light bulbs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamps"@en .

aat:300037595 a skos:Concept ;
    skos:definition "Lamps having a shallow font of oval or pear shape with a wick support attached to the bottom of the font at the narrow end, usually partly or fully covered by a hinged or sliding lid and often a half-bail support at the end opposite the wick support with an attached halbred hook and wire wick pick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "betty lamps"@en .

aat:300037599 a skos:Concept ;
    skos:definition "Shallow pans, usually open, with the reservoir narrowed at one point to form a channel or slot for the wick; often have an attached curved half bail ending in a hook opposite the wick channel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crusies"@en .

aat:300037601 a skos:Concept ;
    skos:definition "Lamps in which the wick or wicks are enclosed in an up-curving or slanting tube attached to the side of the font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spout lamps"@en .

aat:300037602 a skos:Concept ;
    skos:definition "Spout lamps, usually made of tin, having a cylindrical font with a domed or conical cover and one or more wick tubes. The font is fitted into a separate container to which is attached a bail handle and drip catcher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kyals"@en .

aat:300037604 a skos:Concept ;
    skos:definition "Lamps with a burner that has a cylindrical wick sandwiched between two metal tubes that admit a current of air to the inside of the flame and a chimney to enclose the flame and direct air to the outside of it; use especially for such lamps with a separate fuel reservoir from which fuel is fed to the font and burner on the bird-fountain principle. Argand lamps were invented ca. 1782 by Aimé Argand in Geneva and were manufactured in England by Boulton, in the United States by Cornelius & Co. and in France by Quinquet, after whom they are sometimes named."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Argand lamps"@en .

aat:300037606 a skos:Concept ;
    skos:definition "Lamps with a ring-shaped reservoir and central Argand burner or burners; the name was originally used for hanging lamps, thus the name astral from star."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astral lamps"@en .

aat:300037607 a skos:Concept ;
    skos:definition "Lamps with Argand burners and ring-shaped reservoirs of wedge-shaped cross section designed to cast as little shadow as possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sinumbra lamps"@en .

aat:300037608 a skos:Concept ;
    skos:definition "Mechanical lamps which have a spring-driven pump to maintain a uniform flow of oil to the top of the wick. Developed in France by Carcel in 1798."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carcel lamps"@en .

aat:300037610 a skos:Concept ;
    skos:definition "Lamps, usually of painted metal but also found in brass, with a cylindrical font in the shape of a tubular column containing a T-shaped wick tube which supports a flat wick and a rack-and-pinion wick raiser. A flat oval reservoir to the side feeds fuel to the font through a tube. Used with a cylindrical glass chimney and a painted sheet iron shade. Invented about 1800 by Count Rumford."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rumford lamps"@en .

aat:300037612 a skos:Concept ;
    skos:definition "Lamps with usually one or two vertical wick tubes projecting from a tightly closed reservoir. From the patent of John Miles of Birmingham, England, 1787; so called because the fuel is protected from spillage when agitated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agitable lamps"@en .

aat:300037618 a skos:Concept ;
    skos:definition "Brass, sometimes nickel-plated, lamps with separate burners and reservoirs, which are usually cylindrical and are mounted on a vertical rod standard on which they may be raised and lowered; fitted with tall chimneys and glass conical or hemispherical shades. Originally oil lamps with Argand burners, the term was later applied to lamps resembling the form but employing different methods of illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student lamps"@en .

aat:300037621 a skos:Concept ;
    skos:definition "Lamps designed to be suspended from the ceiling and cast light downward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging lamps"@en .

aat:300037622 a skos:Concept ;
    skos:definition "Lighting devices designed to hang from the roof or ceiling having two or more branches, holding candles, burners, or lamps; often ornamental."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chandeliers"@en .

aat:300037623 a skos:Concept ;
    skos:definition "Electrical lighting fixtures designed so that the bulb housing and electrical supply may be inserted into a flat surface such as a ceiling or wall, the opening for the light source being flush with the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recessed luminaires"@en .

aat:300037627 a skos:Concept ;
    skos:definition "Lamps that use animal fat or lard as fuel for illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grease lamps"@en .

aat:300037630 a skos:Concept ;
    skos:definition "Lamps designed to burn oil as fuel, typically with a reservoir for holding the oil and an opening from which a wick can be extended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil lamps"@en .

aat:300037631 a skos:Concept ;
    skos:definition "Lamps which burn whale oil, especially small metal or glass ones equipped with whale oil burners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whale oil lamps"@en .

aat:300037632 a skos:Concept ;
    skos:definition "Lamps that burn lard or lard oil, employing some method to deliver the semi-solid fuel to the wick, either heat to liquify it so that it will flow, or pressure or gravity devices to force it to the wick; especially those of tinned sheet iron, painted or plain, dating to the 1840s and 1850s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard lamps"@en .

aat:300037635 a skos:Concept ;
    skos:definition "Lamps designed to burn rectified turpentine, having an Argand burner without a separate reservoir, and a button-shaped deflector to spread the flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camphene lamps"@en .

aat:300037638 a skos:Concept ;
    skos:definition "Lamps designed to burn kerosene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerosene lamps"@en .

aat:300037639 a skos:Concept ;
    skos:definition "Lamps fitted with gas burners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas lamps"@en .

aat:300037640 a skos:Concept ;
    skos:definition "Lamps in which electricity is the source of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric lamps"@en .

aat:300037643 a skos:Concept ;
    skos:definition "Lamps on tall standards, designed to rest on the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor lamps"@en .

aat:300037644 a skos:Concept ;
    skos:definition "Lamps with a relatively short stem making them suitable for standing on tables and other furniture. The term is especially used in reference to late 18th-century lamps designed to burn whale oil and burning fluid compounds, which generally maintain the traditional stemware divisions of top, stem, and foot and often resemble stemmed drinking glasses of the same period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table lamps"@en .

aat:300037646 a skos:Concept ;
    skos:definition "Any lamp (lighting device) intended to be hung on the wall. Use \"brackets (lighting devices)\" for wall lamps attached to or suspended from some form of bracket, by means of which it can be hung on the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall lamps"@en .

aat:300037647 a skos:Concept ;
    skos:definition "Lighting devices, fixed or portable, designed to protect and enclose the light source, usually with sides of glass, horn, pierced metal, paper, or other material, allowing light to emerge and often having a supporting frame, hanging device, or carrying handle. They may be purely utilitarian or decorative, sometimes having ceremonial significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanterns"@en .

aat:300037649 a skos:Concept ;
    skos:definition "Supports for rushlights, which must be held at an angle for proper burning. Usually consisting of upright pincers of wrought iron, jaws held closed by spring action or a curved arm counter-weighted by a metal ball, decorative element, or candle socket. The base may be an iron tripod or wooden block, often decoratively turned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rushlight holders"@en .

aat:300037650 a skos:Concept ;
    skos:definition "Devices which hold splints while they burn, usually simple wrought iron U-shaped grips, some with spring or pincer action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splint holders"@en .

aat:300037651 a skos:Concept ;
    skos:definition "Devices that support or hold tapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taper holders"@en .

aat:300037652 a skos:Concept ;
    skos:definition "Lights consisting of an open flame emitted from a stick-like handle, usually carried by hand or mounted on a wall or pole. Torches originally consisted of a stick of resinous wood or bundles of fiber soaked with pitch, wax, resin, tallow or other flammable substance. In later usage, includes other sorts of lamps on poles that are designed to be carried like torches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torches"@en .

aat:300037653 a skos:Concept ;
    skos:definition "Parts and components of lighting devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting device components"@en .

aat:300037654 a skos:Concept ;
    skos:definition "Cylindrical masses typically of tallow or wax containing a wick or loosely twisted linen or cotton threads burned to give light; made by dipping or casting in a metal mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candles"@en .

aat:300037659 a skos:Concept ;
    skos:definition "Tall blown glass cylinders usually bulged in the center and open at either end, placed over candleholders to protect the flame from drafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hurricane shades"@en .

aat:300037661 a skos:Concept ;
    skos:definition "Shades placed over or around the light source of a lamp, and that are designed to diffuse or direct light and shield glare. They may be designed to perform a task or to be primarily decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lampshades"@en .

aat:300037663 a skos:Concept ;
    skos:definition "Bulb-shaped dilatations of glass tubes used as the container of an incandescent filament or fourescent light, typically placed in a fixture or lamp that is connected to electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light bulbs"@en .

aat:300037666 a skos:Concept ;
    skos:definition "Tubular electric discharge lamps in which ionization of mercury vapor produces radiation that activates the fluorescent coating on the inner surface of the glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescent lamps"@en .

aat:300037668 a skos:Concept ;
    skos:definition "Cone-shaped devices used to extinguish flames on candles. For scissorlike devices with a boxlike receptacle attached to one blade, use \"candle snuffers.\" For scissorlike devices with flat disc-shaped ends used for pinching out a candle flame, use \"douters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extinguishers"@en .

aat:300037680 a skos:Concept ;
    skos:definition "Movable or fixed objects or equipment, which may be either functional or ornamental, particularly objects for sitting, reclining, or storage, such as chairs, beds, tables, cabinets, etc., in a dwelling, business, or public space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture"@en .

aat:300037682 a skos:Concept ;
    skos:definition "Objects with a highly polished surface, designed to reflect images clearly. The surface is typically smooth, flat, or sometimes slightly curved, made of polished metal in ancient and medieval times, but later usually of glass with a reflective coating on one side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mirrors"@en .

aat:300037700 a skos:Concept ;
    skos:definition "Mirrors of varied form designed to fit above mantels. Generally of two main types: those made to be hung horizontally and which usually consist of three but sometimes four panes of glass, of which the central pane is about twice the width of each outer one; and those made to be hung vertically, often consisting of a single square or rectangular pane of glass, sometimes with a painting set within the frame above the upper portion of the mirror. May have attached candle branches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overmantel mirrors"@en .

aat:300037709 a skos:Concept ;
    skos:definition "Small freestanding mirrors, usually supported on a standing frame within which the glass can be adjusted, designed to be used on a dressing table. Dressing glasses are sometimes made with a boxlike base fitted with small drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing glasses"@en .

aat:300037715 a skos:Concept ;
    skos:definition "Mirrors, often circular and convex, with elaborately carved and gilded frames that are fitted with branched candleholders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girandole mirrors"@en .

aat:300037737 a skos:Concept ;
    skos:definition "Refers to furniture or built-in features in the form of an upright partition that can be used to embellish, partition, shelter, and provide privacy. Screens are often highly decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screens"@en .

aat:300037741 a skos:Concept ;
    skos:definition "Small 18th-century screens used to protect lighted candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle screens"@en .

aat:300037744 a skos:Concept ;
    skos:definition "Firescreens with a shelf or slide attached, to be used for writing before the fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "écrans à secrétaire"@en .

aat:300037745 a skos:Concept ;
    skos:definition "Screens used to shelter the face or legs from the full heat of a fire in a fireplace. May include a decorated panel or panels, often set into a decorative wooden furniture structure that can be moved for the convenience of the sitter. For nonflammable metal screens placed directly in front of fireplace openings to prevent logs and sparks from escaping, use \"fire screens (equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire screens"@en .

aat:300037747 a skos:Concept ;
    skos:definition "Fire screens with a panel set between two standards or a frame, on four legs; distinguished from \"pole screens\" which have a tripod base and shaft which supports the fire screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheval fire screens"@en .

aat:300037748 a skos:Concept ;
    skos:definition "Fire screens of various designs, characterized by being adjustable or extendable to cover alternatively a smaller or largerspace as necessary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extension fire screens"@en .

aat:300037749 a skos:Concept ;
    skos:definition "Fire screens designed with two hinged leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding fire screens"@en .

aat:300037752 a skos:Concept ;
    skos:definition "Firescreens with a tripod base and an upright shaft which supports the framed panel; distinguished from \"cheval fire screens\" which are supported on four legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole screens"@en .

aat:300037758 a skos:Concept ;
    skos:definition "Fire screens supported upon a stand and designed so that the panels may be moved or extended by means of sliding the panels on a pole (a pole screen) or in a frame (a cheval screen)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding fire screens"@en .

aat:300037769 a skos:Concept ;
    skos:definition "General term for any furniture intended for seating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seating furniture"@en .

aat:300037771 a skos:Concept ;
    skos:definition "Seating furniture produced for use by one person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single seating furniture"@en .

aat:300037772 a skos:Concept ;
    skos:definition "Seats for one person with a back or a back and arms. Distinct from \"stools\" which have no back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chairs"@en .

aat:300037776 a skos:Concept ;
    skos:definition "Term applied to a wide variety of chairs with arms, to distinguish them from side chairs which have no arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armchairs"@en .

aat:300037784 a skos:Concept ;
    skos:definition "Armchairs with adjustable backs and loose cushions, of a type first produced by William Morris, Philip Webb, and the firm Morris, Marshall, Faulkner and Co. about 1866 in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morris chairs"@en .

aat:300037789 a skos:Concept ;
    skos:definition "Chairs in the form of a four-legged stool to which a back has been added. The term first appeared in the 16th century and was sometimes used in the 17th and 18th centuries for a chair without arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backstools"@en .

aat:300037798 a skos:Concept ;
    skos:definition "Chairs with a solid, rounded wood back, the cruder type being made by cutting away parts of a barrel. For easy chairs having a semicircular back, use \"circular easy chairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel chairs"@en .

aat:300037800 a skos:Concept ;
    skos:definition "Large, soft frameless chairs resembling a beanbag; typically a clothlike plastic shell filled with plastic chips, that molds itself readily to the contour of the occupant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beanbag chairs"@en .

aat:300037801 a skos:Concept ;
    skos:definition "Upholstered armchairs, differing from other armchairs in being upholstered between the arms and seats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bergères"@en .

aat:300037809 a skos:Concept ;
    skos:definition "Large, deep armchairs with sides and wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bergères en confessional"@en .

aat:300037813 a skos:Concept ;
    skos:definition "Bergères with flat backs; distinct from bergères with concave backs, which are called \"bergères en cabriolet.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bergères à la reine"@en .

aat:300037814 a skos:Concept ;
    skos:definition "Bergères with concave backs; distinct from bergères with flat backs, which are called \"bergères à la reine.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bergères en cabriolet"@en .

aat:300037815 a skos:Concept ;
    skos:definition "U-shaped armchairs, the upper rail of the back gently sloping down to the arms. Most popular during the Louis XV period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bergères en gondole"@en .

aat:300037819 a skos:Concept ;
    skos:definition "Chairs with a stuffed oval or cartouche-shaped back; of a type popular in the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabriole chairs"@en .

aat:300037824 a skos:Concept ;
    skos:definition "Small, low armchairs, or backstools, often upholstered, which have a wide front, a very narrow back, and a trapezoidal seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caquetoires"@en .

aat:300037825 a skos:Concept ;
    skos:definition "Heavily upholstered chairs having solid sides and low backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "club chairs"@en .

aat:300037830 a skos:Concept ;
    skos:definition "French armchairs with the crest rail curving downward in the center to enable the hair to be dressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coiffeuses"@en .

aat:300037833 a skos:Concept ;
    skos:definition "Heavily upholstered low armchairs, generally with fringe hiding the legs and woodwork; of a type first made in France in the 1840s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crapauds"@en .

aat:300037834 a skos:Concept ;
    skos:definition "Collector's term for square low-back chairs, often without arms, having turned legs and stretchers; this type, covered in leather or turkey work, long antedated the period of Cromwell but became widely popular in England in the mid-1600s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cromwellian chairs"@en .

aat:300037837 a skos:Concept ;
    skos:definition "Chairs usually with arms and having full-length leg rests, designed for lounging outdoors. Use \"chaises longues\" for similar forms used indoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deck chairs"@en .

aat:300037838 a skos:Concept ;
    skos:definition "Armchairs with an upholstered frame and projecting wings for protection against drafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "easy chairs"@en .

aat:300037850 a skos:Concept ;
    skos:definition "Easy chairs having a semicircular back forming a single upholstered piece with the wings and arms. For chairs with a solid, rounded wooden back or those made from cutting away parts of a barrel, use \"barrel chairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular easy chairs"@en .

aat:300037854 a skos:Concept ;
    skos:definition "Easy chairs having a straight back, as distinguished from those with circular backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square easy chairs"@en .

aat:300037856 a skos:Concept ;
    skos:definition "French chairs with open arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauteuils"@en .

aat:300037861 a skos:Concept ;
    skos:definition "Chairs whose backs gently curve forward and downward to form the arms; so called because of their resemblance to 18th-century gondolas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gondola chairs"@en .

aat:300037865 a skos:Concept ;
    skos:definition "Armchairs that are stuffed or have a loose cushion to support the back, and wooden legs and a slide-out frame in the front upon which to rest the feet. In many versions, the slide may extend to full length so that the occupant may recline. Popular in the late-18th- and early-19th-centuries, the name refers to the chairs having been common in hunting lodges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting chairs"@en .

aat:300037867 a skos:Concept ;
    skos:definition "Ancient Greek chairs having a deep top rail curving forward from the back and sabre legs; usually undecorated. Imitated during various classical revivals, especially in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "klismoi"@en .

aat:300037874 a skos:Concept ;
    skos:definition "Open-arm chairs with upholstered seats and backs, popular in the 18th and 19th centuries in North America. Seats are generally low and shallow, and the backs are high and often have serpentine cresting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lolling chairs"@en .

aat:300037892 a skos:Concept ;
    skos:definition "Refers to 16th-century Italian wooden side chairs having a solid carved back and small, usually octagonal, seat supported on carved end boards in the front and back, instead of legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sgabellos"@en .

aat:300037896 a skos:Concept ;
    skos:definition "Term generally applied to a wide range of chairs without arms to distinguish them from armchairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side chairs"@en .

aat:300037899 a skos:Concept ;
    skos:definition "Chairs made from looped and twisted iron wire, usually having circular oak seats. Chairs of this type were patented in the early 1900s. A number of manufacturers made such wire chairs; the name derives from their use in public restaurants and cafes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream parlor chairs"@en .

aat:300037904 a skos:Concept ;
    skos:definition "Chairs with X-shaped frames; often designed to fold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "X-chairs"@en .

aat:300037909 a skos:Concept ;
    skos:definition "Collector's term for Italian Renaissance X-chairs with crossing assemblies only in the front and back. Their name is derived from association with the 14th-century poet Dante, although it is questionable that such chairs were actually used by him."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dante chairs"@en .

aat:300037913 a skos:Concept ;
    skos:definition "Early 17th-century English folding chairs having legs crossed front to back and having arms connected to the back and to the front seat rail; design supposedly based on a chair used by the last Abbot of Glastonbury at Wells Cathedral and term derived from collectors' use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glastonbury chairs"@en .

aat:300037918 a skos:Concept ;
    skos:definition "Collector's term for Italian Renaissance chairs with numerous crosspieces linked up along the sides. Named for the 15th-century reforming monk, although it is questionable that such chairs were actually used by him."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Savonarola chairs"@en .

aat:300037925 a skos:Concept ;
    skos:definition "Chairs with open backs and usually horizontal splats with the top rail and uprights rounded to give an overall balloon shape to the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon-back chairs"@en .

aat:300037927 a skos:Concept ;
    skos:definition "Use with reference to chairs with backs consisting of a series of vertical banisters between the seat and top rail; of a type first made in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banister-back chairs"@en .

aat:300037933 a skos:Concept ;
    skos:definition "18th-century American turned baluster-back chairs whose crest rail has cutouts of these shapes; the period name for these chairs is not known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearts and crown chairs"@en .

aat:300037946 a skos:Concept ;
    skos:definition "Upholstered chairs with slightly concave backs to fit the contours of the human body; distinct from those with flat backs called \"chaises à la reine.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaises en cabriolet"@en .

aat:300037948 a skos:Concept ;
    skos:definition "Fauteuils with concave backs; distinct from \"fauteuils à la reine,\" which have flat backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauteuils en cabriolet"@en .

aat:300037953 a skos:Concept ;
    skos:definition "Upholstered chairs with flat backs; distinct from those with concave backs called \"chaises en cabriolet.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaises à la reine"@en .

aat:300037954 a skos:Concept ;
    skos:definition "Fauteuils with flat backs; distinct from \"fauteuils en cabriolet,\" which have concave backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauteuils à la reine"@en .

aat:300037956 a skos:Concept ;
    skos:definition "Term used by Chippendale and others for fret-back chairs incorporating Chinese frets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese chairs"@en .

aat:300037969 a skos:Concept ;
    skos:definition "Late 18th-century American chairs, with heart-shaped backs; especially popular in New England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heart-back chairs"@en .

aat:300037976 a skos:Concept ;
    skos:definition "Chairs with backs consisting of two crescent shapes, one inverted above the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunette-back chairs"@en .

aat:300037977 a skos:Concept ;
    skos:definition "Chairs whose backs are oval shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oval-back chairs"@en .

aat:300037989 a skos:Concept ;
    skos:definition "Chairs featuring an ornamental design pressed into its back. This effect is created by the use of a sharp steel die stamp mounted on a roller, passed over the chair with great pressure, resulting in a perfect impression of a design that was literally pressed into the wood, giving the illusion of hand carving. Press-back chairs were popular in the late 19th-early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press-back chairs"@en .

aat:300037998 a skos:Concept ;
    skos:definition "Chair designs made fashionable in the 1780s by George Hepplewhite. The rail and stile form the shape of a shield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shield-back chairs"@en .

aat:300038000 a skos:Concept ;
    skos:definition "Chairs or sofas of the Hepplewhite period whose back is comprised of carved or shaped veritcal bars curved to fit the shield of a shield-back chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar-back chairs"@en .

aat:300038003 a skos:Concept ;
    skos:definition "Chairs with horizontal slats across the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slat-back chairs"@en .

aat:300038011 a skos:Concept ;
    skos:definition "Late 18th-century American chairs with pierced and intertwined slats and generally associated with Philadelphia cabinetmakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pretzel-back chairs"@en .

aat:300038017 a skos:Concept ;
    skos:definition "Chairs whose backs are comprised of framed cylindrical bars or \"spindles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spindle-back chairs"@en .

aat:300038020 a skos:Concept ;
    skos:definition "Armchairs designed to be the largest pieces of furniture in a sitting room, particularly common in 17th-century Britain and America. They are made of wood, usually with conspicuous carvings and occasionally with upholstered seats. They may resemble a throne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great chairs"@en .

aat:300038026 a skos:Concept ;
    skos:definition "17th-century American turned great chairs styled after one that belonged to Elder William Brewster of Plymouth Colony. Such chairs have boldly turned posts and decorative spindles, but unlike Carver chairs they have spindles below the seat as well as in the back and below the arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brewster chairs"@en .

aat:300038027 a skos:Concept ;
    skos:definition "17th-century American turned great chairs styled after one that belonged to John Carver, Governor of Massachusetts Bay Colony. Such chairs have boldly turned posts and decorative spindles, but unlike Brewster chairs they have spindles only in the back and below the arms, and not below the seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carver chairs"@en .

aat:300038082 a skos:Concept ;
    skos:definition "Early 18th-century chairs with or without arms, having a vase-shaped splat in the back which was curved to give comfortable support to the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bended-back chairs"@en .

aat:300038085 a skos:Concept ;
    skos:definition "Chairs with a single back splat which resembles the outline of a fiddle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiddle-back chairs"@en .

aat:300038088 a skos:Concept ;
    skos:definition "Chairs that incorporate latticework adapted from Chinese sources in the back or arms. Coined by Thomas Chippendale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "India chairs"@en .

aat:300038092 a skos:Concept ;
    skos:definition "Chairs with interwoven splats in the form of interlaced ribbons, such as those popularized by Chippendale and appearing in mid-18th century England and America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon-back chairs"@en .

aat:300038100 a skos:Concept ;
    skos:definition "Chairs whose splats are pierced to form a cypher with the initials of their owners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cypher-back chairs"@en .

aat:300038107 a skos:Concept ;
    skos:definition "The name sometimes given to early 18th-century chairs in which the back has a gentle double curve designed to fit the back of the sitter. Also a mid-19th century chair with a rounded, waisted back and short legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoon-back chairs"@en .

aat:300038108 a skos:Concept ;
    skos:definition "Modern term for chair backs, made in the mid-18th century, with a waisted, pierced splat, which resembles the shape of a wheatsheaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheaf-back chairs"@en .

aat:300038111 a skos:Concept ;
    skos:definition "Use with reference to chairs with a square back such as those popularized by Sheraton and appearing from the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square-back chairs"@en .

aat:300038112 a skos:Concept ;
    skos:definition "Chairs having a back formed by slender members crossing over each other in a netlike pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lattice-back chairs"@en .

aat:300038117 a skos:Concept ;
    skos:definition "16th- and 17th-century joined chairs having a solid paneled back and a plank seat; generally made of oak and often carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wainscot chairs"@en .

aat:300038122 a skos:Concept ;
    skos:definition "Late 18th-century English chairs having round or oval backs with radiating spindles or bars resembling the spokes of a wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel-back chairs"@en .

aat:300038126 a skos:Concept ;
    skos:definition "Term generally applied to any of several varieties of chairs having a seat and back formed from a single sheet of canvas, leather, or the like, and hanging loosely on a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sling chairs"@en .

aat:300038128 a skos:Concept ;
    skos:definition "Chairs constructed of a molded shell mounted on a single support on a flared base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal chairs"@en .

aat:300038132 a skos:Concept ;
    skos:definition "Chairs used to seat the clients of a barber, specifically chairs fixed to the floor and incorporating a mechanical means of adjusting height, rotation, or angle of recline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbers' chairs"@en .

aat:300038134 a skos:Concept ;
    skos:definition "Type of elaborate wheelchairs, sometimes glassed, especially those made in England in the mid-19th century and used at spas and seaside resorts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bath chairs"@en .

aat:300038140 a skos:Concept ;
    skos:definition "Richly or splendidly decorated chairs used on ceremonial occasions by a monarch or other person of high rank. Generally less grandiose than \"thrones.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state chairs"@en .

aat:300038141 a skos:Concept ;
    skos:definition "Ceremonial chairs or seats occupied by a monarch, prelate, or other high dignitary, especially on state or other special occasions; usually placed upon a dais and covered with a canopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thrones"@en .

aat:300038144 a skos:Concept ;
    skos:definition "Chairs with backs which may be lowered and seats that are hinged to unfold or that can otherwise be extended to form beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed chairs"@en .

aat:300038148 a skos:Concept ;
    skos:definition "Armchairs with large backs which are hinged so that they can be swung forward to rest on the arms, converting the piece into a table. Chairs of this type were made from the Middle Ages to the late 17th century in Europe and until the late 19th century in America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair-tables"@en .

aat:300038151 a skos:Concept ;
    skos:definition "Chairs, often upholstered, having a full-length leg rest and usually arms, designed for one person to recline on. For similar chairs used outdoors, use \"deck chairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaises longues"@en .

aat:300038153 a skos:Concept ;
    skos:definition "Duchesses chairs made in two or three parts, each of which can be used separately as a seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duchesses brisées"@en .

aat:300038155 a skos:Concept ;
    skos:definition "Term generally applied to a variety of chairs fitted with a chamber pot. Use \"bidets (box stools)\" for box stools with a chamber pot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commode chairs"@en .

aat:300038164 a skos:Concept ;
    skos:definition "Chairs designed to be used in dentists' offices that allow the patient to be positioned in various ways for dental work. These are usually accessorized with various appliances. Modern dental chairs are equipped with pneumatics for raising or lowering the chair itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental chairs"@en .

aat:300038165 a skos:Concept ;
    skos:definition "Chairs of various form designed to be used in tandem with case furniture for readers or writers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desk chairs"@en .

aat:300038180 a skos:Concept ;
    skos:definition "Devices which allow the motions of horse exercise to be simulated indoors, consisting of springs encased in a concertinalike leather envelope, framed in mahogany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber horses"@en .

aat:300038184 a skos:Concept ;
    skos:definition "Children's chairs with long legs, a feeding tray, and a footrest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "highchairs"@en .

aat:300038191 a skos:Concept ;
    skos:definition "Term applied to a variety of mid-19th-century chairs designed especially for those who are sick or disabled and which often have ratchet mechanisms for raising and lowering the arms, back, or footrest or with large wheels for ease of motion. Use \"touring chairs\" for late 19th- and early 20th-century chairs intended primarily for tourists' use on boardwalks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invalids' chairs"@en .

aat:300038193 a skos:Concept ;
    skos:definition "Wheel chairs, sometimes propelled and steered by turning winches on the arms, and having a foot rest designed to elevate the legs. Developed by John Joseph Merlin in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouty chairs"@en .

aat:300038205 a skos:Concept ;
    skos:definition "Spanish Renaissance type of armchair with a rectangular leather hung seat and with a leather or velvet back; generally having a broad front stretcher, which is often carved. Sometimes hinged to allow for folding and easy transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraileros"@en .

aat:300038208 a skos:Concept ;
    skos:definition "Term generally applied to a variety of chairs with adjustable back heights and sometimes adjustable or revolving seats intended for use while playing a musical instrument. Use \"music stools\" for similar seating with a revolving or adjustable seat but no back and intended for use while playing the piano or other musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music chairs"@en .

aat:300038213 a skos:Concept ;
    skos:definition "Seats hinged against the end of a pew to afford accommodation when needed in the aisle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pew chairs"@en .

aat:300038217 a skos:Concept ;
    skos:definition "Comfortable chairs for reading, particularly 18th-century armchairs with padded, leather-covered, saddle-shaped seats and an adjustable platform to hold a book projecting from the back; designed so that the occupant may either sit on it in a normal way or straddle the seat facing the back. For adjustable reading platforms that are not attached to chairs, use \"reading desks.\" For backward-facing chairs intended for viewing card games, use \"voyeuses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading chairs"@en .

aat:300038220 a skos:Concept ;
    skos:definition "Portable chairs borne on two long poles; generally with elaborate upholstery and decoration. For conveyances for one person consisting generally of canvas or similar material stretched or laid across a frame for transporting the sick, wounded, or dead use \"stretchers (conveyances).\" For more elaborate conveyances boxlike in form and often enclosed by curtains and carried on poles by people or animals use \"litters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sedan chairs"@en .

aat:300038224 a skos:Concept ;
    skos:definition "Upholstered armchairs with a winged back which by means of a ratchet can be adjusted to any desired angle; first made in the Restoration period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeping chairs"@en .

aat:300038225 a skos:Concept ;
    skos:definition "High-backed, low-seated chairs without arms and often upholstered; intended for bedroom use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipper chairs"@en .

aat:300038227 a skos:Concept ;
    skos:definition "Chairs convertible into a stepladder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step chairs"@en .

aat:300038228 a skos:Concept ;
    skos:definition "Late 19th- and early 20th-century chairs intended primarily for tourists' use on boardwalks. Use \"invalids' chairs\" for chairs with ratchet mechanisms for raising or lowering arms, back, or footrest or with large wheels and designed especially for those who are sick or disabled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "touring chairs"@en .

aat:300038229 a skos:Concept ;
    skos:definition "Revolving chairs, usually with a spring back, made for office use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriter chairs"@en .

aat:300038232 a skos:Concept ;
    skos:definition "Chairs having a rather low seat and a padded top rail, designed to allow male spectators of card games to astride while resting their arms or elbows on the top rail. The term is derived from the French verb \"voir,\" \"to see.\" First made in France about 1740 and later in England. For a lower-seated variant of this chair designed for women, use \"voyeuse á genoux.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voyeuses"@en .

aat:300038242 a skos:Concept ;
    skos:definition "Chairs having a very low seat and a padded top rail, designed for female spectators of card games, who could kneel while resting their arms on the padded top rail. Males would sit astride a \"voyeuse\" with a somewhat higher seat, but it was considered inelegant for women to sit astride. For chairs having a very similar design but intended for prayer, use \"prie-dieu chairs.\" Prie-dieu chairs may be made of humble materials, such as a wooden frame with a rattan seat-kneeler, or they may be upholstered; they may include a shelf for prayer books. If they are part of a set, it is usually a bedroom set. Voyeuses à genoux are always upholstered, and are generally part of a larger set along with voyeuses intended for males."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voyeuses à genoux"@en .

aat:300038243 a skos:Concept ;
    skos:definition "Chairs mounted on wheels that may either be pushed or propelled by the occupant by means of hand rims attached to the two large side wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheelchairs"@en .

aat:300038249 a skos:Concept ;
    skos:definition "Chairs used for wheeling the elderly and the infirm through large gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden machines"@en .

aat:300038252 a skos:Concept ;
    skos:definition "Chairs having one flat arm wide enough to use as a writing surface, or with a small table surface attached to one arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablet-arm chairs"@en .

aat:300038272 a skos:Concept ;
    skos:definition "Easy chairs with a back and footrest adjustable up or down to comfort the user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reclining chairs"@en .

aat:300038273 a skos:Concept ;
    skos:definition "Chairs having legs mounted on curved supports, usually bands of wood or metal, which allow the chair to be rocked back and forth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocking chairs"@en .

aat:300038280 a skos:Concept ;
    skos:definition "19th-century American rocking chairs derived from Windsor chairs and having wooden seats that curve upwards to meet the spindles of the noticeably high, curved back with a scrolled top rail; usually grained or painted with fine ornamental detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boston rockers"@en .

aat:300038282 a skos:Concept ;
    skos:definition "Popular term for mid-19th-century American rocking chairs with a high, upholstered back and seat and open arms with upholstered pads on the elbows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lincoln rockers"@en .

aat:300038283 a skos:Concept ;
    skos:definition "Low-seated chairs, with the seats between 13 and 15 inches high, without arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing chairs"@en .

aat:300038284 a skos:Concept ;
    skos:definition "Rocking chairs which move upon a stationary base instead of rocking on curved bends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform rockers"@en .

aat:300038303 a skos:Concept ;
    skos:definition "Chairs that may be stacked on top of each other, usually for space-saving purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacking chairs"@en .

aat:300038305 a skos:Concept ;
    skos:definition "Chairs with a revolving seat on a fixed frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swivel chairs"@en .

aat:300038379 a skos:Concept ;
    skos:definition "Chairs designed for and used at a dining table, intended for use while eating meals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dining chairs"@en .

aat:300038382 a skos:Concept ;
    skos:definition "Chairs with elaborately carved or painted backs, frequently bearing emblems and coats of arms, and having solid wood seats often with hinged lids to reveal a storage compartment. Intended for use in halls and corridors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hall chairs"@en .

aat:300038383 a skos:Concept ;
    skos:definition "Chairs designed for use with kitchen tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen chairs"@en .

aat:300038418 a skos:Concept ;
    skos:definition "A seat for one person, often without a back. They were the most common type of seat furniture until the 19th century. Distinct from \"benches\" in that they seat only one person; usually distinguished from \"chairs\" in that they have no back; however, tall seating pieces at a bar or counter are called stools though they sometimes have backs. Generally made in two types; one supported on four straight legs and the other with legs arranged crosswise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stools"@en .

aat:300038422 a skos:Concept ;
    skos:definition "High stools that are usually one of a row of such stools standing in front of a bar, often taking the form of a rounded seat fixed on a central post."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barstools"@en .

aat:300038424 a skos:Concept ;
    skos:definition "Stools with the seat board hinged to the seat-rail in the form of a small lidded chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box stools"@en .

aat:300038426 a skos:Concept ;
    skos:definition "Low stools used in churches in Scotland before pews were introduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutty stools"@en .

aat:300038428 a skos:Concept ;
    skos:definition "Ancient Greek stools without a back and having four turned legs, sometimes connected by stretchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diphroi"@en .

aat:300038429 a skos:Concept ;
    skos:definition "Stools designed as seats at dressing tables; introduced in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing stools"@en .

aat:300038431 a skos:Concept ;
    skos:definition "Long stools located near or extending from a fireplace fender. Popular in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fender stools"@en .

aat:300038435 a skos:Concept ;
    skos:definition "Small, low stools, to support one's feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footstools"@en .

aat:300038438 a skos:Concept ;
    skos:definition "Footstools with a padded top which may be adjusted to support a gouty foot at the least uncomfortable angle. Made mainly in 18th-century England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gout stools"@en .

aat:300038440 a skos:Concept ;
    skos:definition "Large stuffed cushions that serve as seats or leg rests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hassocks"@en .

aat:300038442 a skos:Concept ;
    skos:definition "Footstools with thickly padded upholstered tops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ottoman footstools"@en .

aat:300038449 a skos:Concept ;
    skos:definition "Low, usually three-legged stools with heavy circular tops set on round-bottomed bases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milking stools"@en .

aat:300038450 a skos:Concept ;
    skos:definition "Stools generally having a revolving or adjustable seat and intended for use while playing the piano or other musical instrument. Prefer \"music chairs\" for similar forms of seating having an adjustable back and sometimes an adjustable or revolving seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music stools"@en .

aat:300038452 a skos:Concept ;
    skos:definition "Stools or low seats with brightly colored cushions, generally used by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "placets"@en .

aat:300038454 a skos:Concept ;
    skos:definition "Low, bench-like seats or kneelers used for prayer or meditation. Known in many cultures, including in Christianity and indigenous African cultures. For specifically Western Christian prayer furniture, 'prie-dieu (benches)' and 'prie-dieu chairs' are sometimes called 'prayer stools.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer stools"@en .

aat:300038457 a skos:Concept ;
    skos:definition "Stools with one or two steps that often fold away beneath the seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step stools"@en .

aat:300038459 a skos:Concept ;
    skos:definition "Refers to low seats or stools, without back or arms, often used for a child or as a footstool. It was originally in the shape of a drum, thus the name (from the diminutive of the French \"tambour,\" for drum). In the 18th century the term was applied to any low stool with fixed upright legs, as distinct from \"pliants,\" which had folding crossed legs. 18th-century tabourets were rectangular, not drum-shaped, with upholstered seats. For similar seats supported on six or more legs, use \"banquettes (benches).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabourets"@en .

aat:300038461 a skos:Concept ;
    skos:definition "Tabourets stools from the 18th-century, often lavishly carved and sometimes surrounded by a back on three sides so that they resembled the end of a miniature duchesse brisée."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabourets en chancelière"@en .

aat:300038467 a skos:Concept ;
    skos:definition "Applies to a variety of small stools, such as footstools, generally having splayed legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cricket stools"@en .

aat:300038478 a skos:Concept ;
    skos:definition "French stools with folding crossed legs; distinct from \"tabourets\" which have fixed upright legs, and used in domestic environments. For folding stools with ecclesiastical origins generally, use \"faldstools.\" For folding chairs used by bishops or other prelates in the chancel of a church, use \"faldistories.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pliants"@en .

aat:300038482 a skos:Concept ;
    skos:definition "Small, folding stools with a detachable seat of canvas or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campstools"@en .

aat:300038483 a skos:Concept ;
    skos:definition "Stools designed to placed or stacked on top of one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacking stools"@en .

aat:300038489 a skos:Concept ;
    skos:definition "Early backless seating forms of stout mortise and tenon construction and with turned legs joined by stretchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint stools"@en .

aat:300038493 a skos:Concept ;
    skos:definition "Seating furniture produced for use by multiple persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiple-seating furniture"@en .

aat:300038494 a skos:Concept ;
    skos:definition "Long seats for two or more people, with or without a back, usually of wood, but also of stone, metal, or another material. A bench is distinguished from a stool by its greater length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benches"@en .

aat:300038498 a skos:Concept ;
    skos:definition "Small benches usually with upholstered seats; in form they resemble a tabouret lengthened and supported on six or more legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquettes"@en .

aat:300038502 a skos:Concept ;
    skos:definition "Early American furniture for holding buckets. The furniture developed in Pennsylvania German communities in the 18th century, spread throughout the eastern United States and beyond by the 19th century. Early forms comprised a bench-like piece for holding buckets, but soon the form added shelves or cupboards with closed doors for holding water or milk buckets, cleaning supplies, or other kitchen or bathing supplies. May also be used for reproductions of this furniture form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water benches"@en .

aat:300038507 a skos:Concept ;
    skos:definition "Italian wood benches with a chest under the seat, in the form of a large cassone with back and arms added to form a settee or sofa with storage below. Loose cushions were used for comfort. The form was popular in Florence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassapanche"@en .

aat:300038509 a skos:Concept ;
    skos:definition "Benches that were historically seats for the deacons in early protestant church services; the style is now commonly seen in homes. The forms vary, but they are typically long enough for two or three sitters, with a wooden seat, often with a wooden back; the seat may comprise a hinged cover that opens to reveal storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deacons' benches"@en .

aat:300038514 a skos:Concept ;
    skos:definition "Long benches without a back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forms"@en .

aat:300038521 a skos:Concept ;
    skos:definition "Benchlike seats for the use of a church congregation. They are often fixed in place in rows, have backs and often walls, and are accessible by aisles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pews"@en .

aat:300038523 a skos:Concept ;
    skos:definition "Benches intended for use at a piano, generally made with a hinged seat that opens to reveal a storage area for sheet music, books, and other such items; often made en suite with the piano with which it is sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano benches"@en .

aat:300038524 a skos:Concept ;
    skos:definition "Benches used at picnics, used in conjuction with picnic tables, and typically fused to the table itself to create one piece of furniture. Commonly seen in parks and campgrounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picnic benches"@en .

aat:300038532 a skos:Concept ;
    skos:definition "Long seats of two basic types: a low-back bench with arms and a bench with a high, usually solid, back and with arms and wings. For settles with hinged seats use \"box settles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settles"@en .

aat:300038534 a skos:Concept ;
    skos:definition "Settles with a box seat with a hinged lid which allows access to a storage space beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box settles"@en .

aat:300038552 a skos:Concept ;
    skos:definition "Freestanding or built-in benches intended for use in the embrasure of a window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window seats"@en .

aat:300038555 a skos:Concept ;
    skos:definition "Banquettes made to stand in the embrasure of a window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquettes de croisée"@en .

aat:300038583 a skos:Concept ;
    skos:definition "Long seating forms with a back support and one end; primarily used for reclining rather than sitting. Distinct from \"sofas\" which have a back and two ends and are primarily used for sitting rather than reclining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couches"@en .

aat:300038586 a skos:Concept ;
    skos:definition "Extended chairs, generally without arms, used for lounging with one backed end usually made to tilt; often supported on a stretcher frame with six or eight legs. Also, long, wide, sofalike seats, often with two low ends that somewhat resemble headboards or footboards, that can be used for sitting or sleeping. Daybeds are typically designed for one person to recline on and were historically sometimes used for the formal reception of visitors. They are generally placed against the wall or in a niche."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daybeds"@en .

aat:300038592 a skos:Concept ;
    skos:definition "Term used during the Greek Revival era to describe the form of couch produced with scrolled ends reminiscent of Greek and Roman furniture designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grecian couches"@en .

aat:300038595 a skos:Concept ;
    skos:definition "Refers to long seats with a back and usually arms; large enough for two or more persons. The terms sofa and settee are virtually interchangeable in 20th-century usage but there is a distinction between the two; a settee is less fully upholstered than a sofa and can even be unupholstered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settees"@en .

aat:300038599 a skos:Concept ;
    skos:definition "Settees formed of three linked armchairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indiscrets"@en .

aat:300038601 a skos:Concept ;
    skos:definition "Term used, from the 19th century on, for a small upholstered sofa or settee designed to seat two people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "love seats"@en .

aat:300038607 a skos:Concept ;
    skos:definition "Backless upholstered seats, usually round, and large enough for several people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pouffes"@en .

aat:300038611 a skos:Concept ;
    skos:definition "Small sofas formed of two or three combined chair backs, with arms, backs, and legs similar to those of the open-back chairs of the particular period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair-back settees"@en .

aat:300038618 a skos:Concept ;
    skos:definition "Settees consisting of a solid wooden seat into which separate members for the back and legs are round-tenoned, or pushed into drilled holes. This is in contrast to standard chairs, where the back legs and the uprights of the back are of one continuous piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windsor settees"@en .

aat:300038634 a skos:Concept ;
    skos:definition "Long, upholstered seating objects with a back and two ends, and primarily used for sitting rather than reclining. Distinct from \"couches (reclining furniture)\" which have a back support and one end and are primarily used for reclining rather than sitting. The term \"sofa\" was first used in France at the end of the 17th century as an alternative for canapé. The terms sofa and settee are virtually interchangeable in 20th-century usage but there is a distinction between the two; a sofa is generally completely upholstered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sofas"@en .

aat:300038636 a skos:Concept ;
    skos:definition "Types of sofas or settees that were developed in France in the 18th century and picked up by Thomas Chippendale and other furniture makers in Europe and North America. They are distinguished by having a rather delicate and curvilinear style, carved and polished exposed sections of the wood frame, with stuffed backs and seats, arms that may or may not be stuffed, and elegantly carved exposed legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canapés"@en .

aat:300038638 a skos:Concept ;
    skos:definition "Sofas that are oval or round in form, with an upholstered pillar-like back located in the center of the seating area. Intended to stand in the center of the room, with seating around all sides of the sofa. The form developed in France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bornes"@en .

aat:300038639 a skos:Concept ;
    skos:definition "Late 18th- and early 19th-century sofas having a high-pitch back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabriole sofas"@en .

aat:300038644 a skos:Concept ;
    skos:definition "Straight-fronted sofas with small triangular seats (sometimes detachable) set outside the arms at either end. For S-shaped sofas with ends curving inward so two people could sit face to face, use \"canapés à confident.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confidantes"@en .

aat:300038659 a skos:Concept ;
    skos:definition "Late 18th-century English name for long, low, upholstered sofas. The term 'ottoman' first appeared in Le Bastide's \"La Petite Maison\" of 1753-1754. The French term is more precise, usually referring more specifically to ottomans built on an oval plan with one end higher than the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ottomans"@en .

aat:300038669 a skos:Concept ;
    skos:definition "Furniture made up of modular units capable of use separately or in various combinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectional furniture"@en .

aat:300038670 a skos:Concept ;
    skos:definition "Sofas that can be converted into beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sofa beds"@en .

aat:300038671 a skos:Concept ;
    skos:definition "Large upholstered sofas, often convertible into beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "davenports"@en .

aat:300038689 a skos:Concept ;
    skos:definition "Sofas with heavily overstuffed ends and backs that have no exposed wood and together form a continuous line that typically terminates in spiral-curved arm rest. One end may be adjustable or removable. The legs may be exposed or not; if exposed, they are typically the only exposed wood on the piece. Chesterfields are often upholstered in leather, but may also be covered in various textile fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chesterfields"@en .

aat:300038694 a skos:Concept ;
    skos:definition "Plain, unupholstered settees, usually with slat backs, for use either indoors or in a wagon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wagon seats"@en .

aat:300038697 a skos:Concept ;
    skos:definition "Generally, the sleeping places of humans and animals. Specifically, permanent pieces of furniture comprised of a bedstead, which is the wooden or metal support, and the bedding, including the mattress and cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beds"@en .

aat:300038700 a skos:Concept ;
    skos:definition "Beds enclosed with paneling on all sides but one, where there was a curtain over the opening; usually stood against the wall and, in some cases, were built into the wall or incorporated into the scheme of paneling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box beds"@en .

aat:300038704 a skos:Concept ;
    skos:definition "Beds for two people with one sleeping place above the other in the manner of tiered bunks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bunk beds"@en .

aat:300038710 a skos:Concept ;
    skos:definition "Beds with testers which only cover the head half of the bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-tester beds"@en .

aat:300038715 a skos:Concept ;
    skos:definition "Beds with a canopy, often suspended from an ornate horizontal frame, attached to the wall behind the head or to the ceiling and not supported on posts or columns. The term refers particularly to beds dating from the 17th century and later. For beds having simpler unsupported curtains, spanning a space shorter than the length bed, use \"lits d'ange.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits à la duchesse"@en .

aat:300038716 a skos:Concept ;
    skos:definition "Beds with an unsupported canopy, typically shorter than the bed; there are no posts on a lit d'ange, although sometimes the term is used incorrectly to refer to types of canopy beds with posts. For grander beds with a frame supporting the canopy, use \"lits à la duchesse.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits d'ange"@en .

aat:300038719 a skos:Concept ;
    skos:definition "Beds with frames in three sections equipped with mechanical spring parts that permit raising the head, foot, or middle as required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospital beds"@en .

aat:300038721 a skos:Concept ;
    skos:definition "Early 19th-century French beds having styles based on Classical models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits à l'antique"@en .

aat:300038723 a skos:Concept ;
    skos:definition "Beds for servants' use; term frequently found in 16th- and 17th-century inventories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livery beds"@en .

aat:300038725 a skos:Concept ;
    skos:definition "Beds, originating in Scandinavia in the 1930s, consisting of a simple shallow box for holding a mattress situated on a slightly recessed frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform beds"@en .

aat:300038732 a skos:Concept ;
    skos:definition "Beds with two or four posts approximately six feet in height which often, but not always, support a tester."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-post beds"@en .

aat:300038737 a skos:Concept ;
    skos:definition "Beds with a rooflike component supported above the bed by the bed posts. For beds with testers that only cover the head half of the bed, use \"half-tester beds.\" Use \"canopy beds\" when the rooflike component is suspended from the ceiling or the wall, as opposed to being supported on posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tester beds"@en .

aat:300038744 a skos:Concept ;
    skos:definition "Canopy beds having an upper portion in the shape of a dome over the bed, from which the curtains are suspended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dome beds"@en .

aat:300038745 a skos:Concept ;
    skos:definition "High-post beds with arched, or in the Federal period often serpentine, as opposed to straight canopies and whose posts are generally less than six feet in height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field beds"@en .

aat:300038753 a skos:Concept ;
    skos:definition "Beds with hexagonal or octagonal posts, usually thought to have been made prior to the American Revolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencil-post beds"@en .

aat:300038754 a skos:Concept ;
    skos:definition "Beds with two or four posts approximately four feet in height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-post beds"@en .

aat:300038756 a skos:Concept ;
    skos:definition "Settles convertible into beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settle beds"@en .

aat:300038758 a skos:Concept ;
    skos:definition "Beds with two ends of equal height intended to stand lengthwise along the wall. For beds with a simple wooden framework, which supports the bed hangings so as to form a plain, rectangular box, use \"French beds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleigh beds"@en .

aat:300038770 a skos:Concept ;
    skos:definition "Beds with ends of equal height and an upholstered back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits à la turque"@en .

aat:300038771 a skos:Concept ;
    skos:definition "Grand, lavishly upholstered beds intended for princes and noblemen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state beds"@en .

aat:300038775 a skos:Concept ;
    skos:definition "Beds having a liquid-filled rubber or plastic mattress in a rigid, often heated, waterproof frame and providing a surface that conforms to the sleeper's body in any position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water beds"@en .

aat:300038777 a skos:Concept ;
    skos:definition "Beds which are 54 inches wide; large enough to accommodate two adults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double beds"@en .

aat:300038781 a skos:Concept ;
    skos:definition "Term generally applied to beds measuring between 76 and 78 inches wide and between 80 and 84 inches long."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "king-size beds"@en .

aat:300038782 a skos:Concept ;
    skos:definition "Term generally applied to beds larger than double beds but smaller than king-size beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queen-size beds"@en .

aat:300038785 a skos:Concept ;
    skos:definition "Beds consisting of metal frames, box springs, mattresses, and headboards, but lacking footboards; of a type made in America about 1945."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollywood beds"@en .

aat:300038786 a skos:Concept ;
    skos:definition "Beds for one person, especially a matching pair in a bedroom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twin beds"@en .

aat:300038788 a skos:Concept ;
    skos:definition "Term used by Thomas Sheraton for a fanciful design which incorporates two twin beds sharing a common tester and having a passageway between the beds to allow easy access for servants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer beds"@en .

aat:300038791 a skos:Concept ;
    skos:definition "Beds, generally of the 19th-century, which when folded closed, looked to be an exact representation of another piece of furniture, such as a bureau, a dresser, or a cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding beds"@en .

aat:300038799 a skos:Concept ;
    skos:definition "Light beds, often collapsible and typically used for camping or by a child; generally made of canvas stretched on a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cots"@en .

aat:300038801 a skos:Concept ;
    skos:definition "Beds converted from sofas, settees, and other forms of seating furniture usually by folding out a concealed mattress and springs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hideaway beds"@en .

aat:300038803 a skos:Concept ;
    skos:definition "Any of various kinds of concealed or disguised beds first designed in the 18th century. Such beds were among the many ingenious forms of late 19th-century patent furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deception beds"@en .

aat:300038804 a skos:Concept ;
    skos:definition "Deception beds concealed in a carcase that outwardly resembles a bureau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureau beds"@en .

aat:300038806 a skos:Concept ;
    skos:definition "Deception beds which look like an upright piano but unfold to form a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano beds"@en .

aat:300038807 a skos:Concept ;
    skos:definition "Folding beds built into a cabinet which outwardly resembles a press or chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press beds"@en .

aat:300038817 a skos:Concept ;
    skos:definition "Low bedsteads specifically designed so that they can be moved under another bed when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trundle beds"@en .

aat:300038822 a skos:Concept ;
    skos:definition "Beds constructed so that they can be folded or swung into a closet; named after William L. Murphy, American inventor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murphy beds"@en .

aat:300038829 a skos:Concept ;
    skos:definition "Wooden beds with spool-shaped turnings in the spindles and usually in the rails and posts of the headboard and footboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spool beds"@en .

aat:300038847 a skos:Concept ;
    skos:definition "Small beds for infants, usually on bends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cradles"@en .

aat:300038850 a skos:Concept ;
    skos:definition "Infants' beds, especially those with a hood over one end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bassinets"@en .

aat:300038852 a skos:Concept ;
    skos:definition "Small bedsteads with a high enclosure and usually slatted sides for a child."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cribs"@en .

aat:300038859 a skos:Concept ;
    skos:definition "Cribs, typically consisting of a cot or bassinet suspended from a upright member, designed to allow to swing back and forth as to rock a baby to sleep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swinging cribs"@en .

aat:300038860 a skos:Concept ;
    skos:definition "Furniture that encloses a space and is generally boxlike in structure; intended for storage or display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case furniture"@en .

aat:300038866 a skos:Concept ;
    skos:definition "Case furniture of the 18th century, often in the \"Chinese style,\" which incorporate bookshelves behind glassed-in or trelliswork doors over chests of drawers.The design is epitomized in plate XXI of Ince and Mayhew's \"Universal System of Household Furniture\" (1762)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentlemen's repositories"@en .

aat:300038867 a skos:Concept ;
    skos:definition "Book furniture comprising bookcase units surmounting a cupboard support. These are of various design, but often with a center double-doored unit with two wings with single doors. The doors are often glassed or have a screen to allow viewing the contents within."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library bookcases"@en .

aat:300038870 a skos:Concept ;
    skos:definition "Writing desks surmounted by a bookcase, particularly where the desk and bookcase are separate units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secretary-bookcases"@en .

aat:300038879 a skos:Concept ;
    skos:definition "Boxes, usually of oak and with a slanting top, used to hold a Bible, books, or writing materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bible boxes"@en .

aat:300038888 a skos:Concept ;
    skos:definition "Case furniture consisting of a set of shelves, small drawers, or pigeonholes, fronted by one or more doors, and intended for the storage and sometimes the display of small objects. Also, similar built-in or fitted cases often designed for specific purposes, as in a kitchen or bathroom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinets"@en .

aat:300038892 a skos:Concept ;
    skos:definition "Case furniture consisting of a set of small drawers intended for the storage or display of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinets of drawers"@en .

aat:300038896 a skos:Concept ;
    skos:definition "Bureau-cabinets typical of fine furniture originating in the 17th century that feature cabinets of drawers or pigeon holes, fronted by one or more doors, and supported on a stand from which it may be detached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinets on stands"@en .

aat:300038898 a skos:Concept ;
    skos:definition "Spanish fall-front writing cabinets, taking the form of a rectangular chest supported on a decorative pie de puente or trestle stand. The interior is often elaborately decorated and generally contains tiers of drawers which may be supplemented with pigeonholes and a small cupboard. The name is a late 19th-century name that erroneously suggests that this type of writing cabinet was made in the Toledan village of Vargas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vargueños"@en .

aat:300038908 a skos:Concept ;
    skos:definition "Tall, narrow, and deep cabinets intended to accommodate the elaborate bonnets peculiar to Normandy and Brittany in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonnetières"@en .

aat:300038916 a skos:Concept ;
    skos:definition "Pieces of furniture fitted with pigeonholes or compartments to hold boxes made either as independent pieces of furniture or as pieces to be placed on top of a bureau plat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartonniers"@en .

aat:300038919 a skos:Concept ;
    skos:definition "Cabinets, often with glass fronts and sides, used to hold and display china."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "china cabinets"@en .

aat:300038924 a skos:Concept ;
    skos:definition "18th-century French cabinets with small drawers designed to house a collection of shells; fashionable between 1730 and 1750."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coquilliers"@en .

aat:300038936 a skos:Concept ;
    skos:definition "Cabinets with drawers sized to hold documents; often, but not always, made of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filing cabinets"@en .

aat:300038937 a skos:Concept ;
    skos:definition "Cabinets specially designed to hold handguns, long guns and other types of small arms; often with glass-fronted doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun cabinets"@en .

aat:300038939 a skos:Concept ;
    skos:definition "Popular term for tall kitchen cabinets mass-produced during the early 20th century; usually oak, with such features as an enameled work surface, storage bins, and a flour sifter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hoosier cabinets"@en .

aat:300038940 a skos:Concept ;
    skos:definition "French 17th- and 18th-century cabinets on stands used to store jewels; often heavily adorned with inlay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewel cabinets"@en .

aat:300038949 a skos:Concept ;
    skos:definition "Cabinets intended to stand against a pier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meubles d'entre deux"@en .

aat:300038950 a skos:Concept ;
    skos:definition "Cabinets of various form, but usually single or double-doored narrow vertically oriented cases intended to store sheet music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music cabinets"@en .

aat:300038952 a skos:Concept ;
    skos:definition "Kitchen cabinets in which food is stored, having a ventilated front, generally of pierced tin or sometimes of screening or cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen safes"@en .

aat:300038960 a skos:Concept ;
    skos:definition "Cabinets intended to hold household or cleaning supplies made of any material, but especially used in reference to such cabinets made of enameled steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility cabinets"@en .

aat:300038976 a skos:Concept ;
    skos:definition "Cabinets designed to fit into a corner of a room, usually by being triangular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner cabinets"@en .

aat:300038978 a skos:Concept ;
    skos:definition "Small chests or cabinets designed to store bottles of wine or liquor, often set on legs, and usually with locks and fitted with side handles. For metal-lined tubs or stands for cooling wine bottles, use \"wine coolers (containers).\" For sideboards with a place at one end to hold bottles of wine, use \"cellaret sideboards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellarets"@en .

aat:300038992 a skos:Concept ;
    skos:definition "Large boxes with hinged lids intended for the storage of textiles, clothing, and other articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chests"@en .

aat:300038995 a skos:Concept ;
    skos:definition "Chests for the safe-keeping of valuables usually made of wood and sheathed in iron, of a type made in the ancient and Medieval periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcae"@en .

aat:300038998 a skos:Concept ;
    skos:definition "Chests with one or two tiers of drawers below a deep storage space; precursor to chests of drawers. Use \"chests of drawers\" for case furniture having two or more drawers but lacking a deep storage space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chests with drawers"@en .

aat:300039006 a skos:Concept ;
    skos:definition "Small chests or boxes for holding objects of value such as money, letters, and jewels; usually of wood or metal and highly ornamented and often hinged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caskets"@en .

aat:300039007 a skos:Concept ;
    skos:definition "Refers to chests, particularly to Italian chests produced from the 14th through the 16th centuries, primarily in Florence, Siena and the Veneto. They were often richly carved or decorated with pastiglia decoration and painted panels. They were typically commissioned in pairs when a house was renovated for a newly married couple, and were generally purchased by the groom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassoni"@en .

aat:300039009 a skos:Concept ;
    skos:definition "Case furniture characterized by having drawers, typically three to five in number. A chest of drawers is generally supported on feet, but sometimes rests directly on the floor. Use \"commodes (chests of drawers)\" for similar case pieces generally supported on short legs. Use \"chests with drawers\" for chests with one or more tiers of drawers below a deep storage space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chests of drawers"@en .

aat:300039021 a skos:Concept ;
    skos:definition "Chests of drawers having a folding top which, when open, serves as a writing board; of a type made in 18th-century England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bachelors' chests"@en .

aat:300039027 a skos:Concept ;
    skos:definition "Two-part chests of drawers, one stacked on top of the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chests-on-chests"@en .

aat:300039039 a skos:Concept ;
    skos:definition "Chests of drawers which sit on a framed stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chests on frames"@en .

aat:300039042 a skos:Concept ;
    skos:definition "18th-century French term for a piece of furniture for the storage of stuffs (chiffons) and small articles of clothing. It is usually, but not necessarily, a small, low chest of drawers, narrower than the normal commode. For small cupboards with a top forming a sideboard, use \"chiffoniers (sideboards).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiffonnières"@en .

aat:300039044 a skos:Concept ;
    skos:definition "Commodes incorporating a tier of drawers flanked by open shelves or cupboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodes à encoignures"@en .

aat:300039046 a skos:Concept ;
    skos:definition "Term used in the 18th century for commodes with two tiers of drawers set on high legs; term later used for commodes with three or four tiers of drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodes à la régence"@en .

aat:300039047 a skos:Concept ;
    skos:definition "Commodes with two cupboard doors instead of the more usual drawer front. Inside there may be drawers or open shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodes à vantaux"@en .

aat:300039050 a skos:Concept ;
    skos:definition "Commodes which consist of a single drawer set on tall legs presumably intended to stand beneath a mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodes en console"@en .

aat:300039055 a skos:Concept ;
    skos:definition "Small and narrow chests of drawers or cabinets intended to stand beneath a mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demi-commodes"@en .

aat:300039072 a skos:Concept ;
    skos:definition "Tall case pieces generally having seven or more drawers, and divided by a cornice into two sections, consisting of a lower case resembling an enlarged dressing table and an upper case resembling a chest of drawers. For equivalent English pieces, use \"tallboys (furniture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "highboys"@en .

aat:300039119 a skos:Concept ;
    skos:definition "Small chests for the storage of valuables which may also serve as seats or tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffers"@en .

aat:300039121 a skos:Concept ;
    skos:definition "19th-century term for heavy iron-bound coffers used for the storage of valuables; generally of German make and rarely dating from before the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armada chests"@en .

aat:300039122 a skos:Concept ;
    skos:definition "Medieval French term for portable coffers or chests used for personal luggage, covered in leather and studded with nails and usually having a rounded top. Eventually they took the form of a chest mounted on feet, used for storing goods. The current French form is a decorative high chest or cabinet with an arched or curved top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bahuts"@en .

aat:300039124 a skos:Concept ;
    skos:definition "Wood boxes, often covered in leather and tooled in gilt or bound with iron, which were used as traveling trunks to store papers, valuables, and clothes; of a type made in the late Medieval period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trussing coffers"@en .

aat:300039125 a skos:Concept ;
    skos:definition "Chests made to commemorate or anticipate a wedding; usually incorporating names and dates in their decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dower chests"@en .

aat:300039136 a skos:Concept ;
    skos:definition "Term used for chests having a base containing two or more drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mule chests"@en .

aat:300039137 a skos:Concept ;
    skos:definition "Seaman's chests, generally used to store personal property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea chests"@en .

aat:300039139 a skos:Concept ;
    skos:definition "Miniature chests consisting of innumerable small drawers for holding spices; intended to be placed on a table or chest of drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice chests"@en .

aat:300039142 a skos:Concept ;
    skos:definition "Specialized furniture form most popular in the American South; generally having a hinged lid on top covering a large divided storage chamber for brown and white sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar chests"@en .

aat:300039143 a skos:Concept ;
    skos:definition "Square wooden cases usually fixed with sheet lead or tin and used for exporting tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea chests"@en .

aat:300039169 a skos:Concept ;
    skos:definition "Chests richly decorated with marquetry patterns of arches and fantastic architecture, reminiscent of Henry VIII's (vanished) palace of Nonsuch; the appellation means unequalled. Probably made in North Germany, or by 16th-century German craftsmen who settled in London."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nonsuch chests"@en .

aat:300039183 a skos:Concept ;
    skos:definition "General term for a closet or a cabinet enclosed by doors, often placed in a corner of a room or a recess in the wall, with shelves for keeping cups, dishes, provisions, books, or valuables. Originally boards or open structures of shelves on which cups, especially silver, might be placed for storage or display. Beginning in the 15th century, doors were added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupboards"@en .

aat:300039198 a skos:Concept ;
    skos:definition "Italian cupboards that were originally cassoni with doors instead of a lid, but from the 16th century developed into two-tiered pieces similar to English press cupboards. Generally having massive architectural decoration, including pilasters supporting a monumental cornice; frequently made for sacristies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armadios"@en .

aat:300039206 a skos:Concept ;
    skos:definition "Large but fairly low cupboards with an enclosed storage cabinet above and an open shelf or shelves below, or having two or three shelves and no enclosed cabinet. It is a type made in 16th- and 17th-century England and 17th-century America. Distinct from \"press cupboards,\" which have both the upper and lower sections enclosed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court cupboards"@en .

aat:300039218 a skos:Concept ;
    skos:definition "Freestanding cupboards, particulary with reference to cupboards in use in the mid-16th century in England for freestanding cupboards used for the storage of food and drink, generally in the form of a two-tier cupboard with pierced or spindle doors for ventilation. Use \"aumbries\" with reference to similar forms made before, after, or during the Medieval period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livery cupboards"@en .

aat:300039221 a skos:Concept ;
    skos:definition "Places for keeping victuals; variously applied to a store-closet, pantry, or cupboard in a pantry. The term was first used in the Medieval period for enclosed cupboards or storage niches enclosed by doors; often a receptacle for provisions to be given away as alms. The term remained in use chiefly for the aumbries enclosed in or hung on a wall near the altar in churches in which sacramental vessels were kept. When referring to such forms enclosed by doors from the 17th century on, use \"cupboards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aumbries"@en .

aat:300039235 a skos:Concept ;
    skos:definition "Large, but fairly low, cupboards with both the upper and lower sections containing enclosed storage space; of a type made in 16th- and 17th-century England and 17th-century America. Distinct from \"court cupboards\" which have an enclosed storage cabinet above and an open shelf or shelves below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press cupboards"@en .

aat:300039236 a skos:Concept ;
    skos:definition "Cupboards that are constructed in three levels, the lower two levels closed by doors and the upper level opened for display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tridarns"@en .

aat:300039237 a skos:Concept ;
    skos:definition "Large upright pieces of furniture fitted with hooks, pegs, or rods, used for hanging clothes, generally with two large doors and perhaps a drawer or drawers below. Although there may be a shelf in a wardrobe, the term is typically distinct from \"clothes presses,\" in which clothes are stored exclusively on shelves rather than hanging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wardrobes"@en .

aat:300039240 a skos:Concept ;
    skos:definition "Originally large closets or chests for storing arms, implements, or tools. Today refers to French-styled wardrobes for the storage of clothing or linens, with large doors opening to shelves, sometimes with drawers on the bottom of the piece, and short legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armoires"@en .

aat:300039243 a skos:Concept ;
    skos:definition "French case furniture consisting of two cupboards, set one above the other, each with two doors, the front and sides of the upper cupboard being recessed. They generally have an architectural framework with pilasters and a crowning pediment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armoires à deux corps"@en .

aat:300039249 a skos:Concept ;
    skos:definition "Wardrobes that are a typically American variations on the 17th-century Netherlandish kast or large cupboard; made by Dutch settlers in the Hudson and Delaware valleys about 1675-1750 and more widely into the 19th century. Generally have two raised paneled doors, and a heavy overhanging cornice with a drawer or drawers below; sometimes decoratively painted with grisaille panels and fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kassen"@en .

aat:300039252 a skos:Concept ;
    skos:definition "Term of Medieval origin generally applied to tall cupboards with doors and shelves for storing linens, clothing, and kitchen utensils. For presses with sliding shelves behind closed doors, use \"clothes presses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presses"@en .

aat:300039253 a skos:Concept ;
    skos:definition "Eighteenth-century term for large chests or cupboards used to store clothes, often having sliding shelves behind closed doors. For large upright case pieces fitted with hooks, pegs, or rods to hang clothes, use \"wardrobes (case furniture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothes presses"@en .

aat:300039264 a skos:Concept ;
    skos:definition "German wardrobes for the storage of clothes and linens; generally with two paneled doors and sometimes having one side with drawers and shelves and the other side an open space for hanging clothes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schranks"@en .

aat:300039285 a skos:Concept ;
    skos:definition "Freestanding, built-in, or hanging cupboards made to fit the shape of a room's corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner cupboards"@en .

aat:300039298 a skos:Concept ;
    skos:definition "Relatively small cupboards constructed to be hung on a wall rather than standing on the floor, sometimes placed above a larger piece of case furnture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging cupboards"@en .

aat:300039300 a skos:Concept ;
    skos:definition "Open-tiered shelves for displaying small objects; often with a mirrored back and sometimes having drawers or a cabinet below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "étagères"@en .

aat:300039305 a skos:Concept ;
    skos:definition "Chests of drawers having seven drawers and intended to hold a week's supply of clothing; of a type originally made in 18th-century France, Italy, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semainiers"@en .

aat:300039306 a skos:Concept ;
    skos:definition "In modern usage, a general term for case furniture of various designs, sometimes on legs, with cupboard space beneath and placed along the wall of a dining room for serving, storage, and displaying plate and other precious tableware. However, in early usage may refer to a table, as the term derives from pieces that were often simply a board on legs placed near the dining table. By the 17th century sideboards were being designed with a cupboard or drawers beneath a flat table surface. The top was higher than a standard table, allowing the plate on display to be seen easily, as well as making the food more conveniently accessible to a standing person. Victorian sideboards often had levels or shelves above the primary surface, in order to create more space for displaying tableware. \"Dressers (cupboards)\" may be similar in design and function, but were typically found in kitchens rather than dining rooms. In modern usage, for side tables used along the walls of dining rooms, use \"sideboard tables\" or the broader term \"serving tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sideboards"@en .

aat:300039318 a skos:Concept ;
    skos:definition "Sideboards with a place at one end to hold bottles of wine and at the other end either a plain drawer or a drawer lined with lead, in which glasses could be washed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellaret sideboards"@en .

aat:300039330 a skos:Concept ;
    skos:definition "Refers to sideboards with a cupboard. For small, low chests of drawers, use \"chiffonnières (low chests of drawers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiffoniers"@en .

aat:300039331 a skos:Concept ;
    skos:definition "Sideboards of French design, used for the serving of food. They are characterized by having a design more like a large table than case furniture, with a shelf below and often one or more drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "console dessertes"@en .

aat:300039333 a skos:Concept ;
    skos:definition "Sideboards having a center drawer and a large boxlike support on either end; often these supports are partitioned into divisions, or they may have drawers or shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal end sideboards"@en .

aat:300039337 a skos:Concept ;
    skos:definition "Furniture used to hold or support other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "support furniture"@en .

aat:300039338 a skos:Concept ;
    skos:definition "Various forms of furniture for readers or writers, generally having a flat writing surface and often drawers and other compartments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desks"@en .

aat:300039343 a skos:Concept ;
    skos:definition "Desks on frames set on high legs, of the type generally used in mercantile establishments in the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counting-house desks"@en .

aat:300039347 a skos:Concept ;
    skos:definition "Refers to desks surmounted by a bookcase with glazed or paneled doors. For similar English forms which have a steeply sloping lid, use \"bureau-bookcases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desks and bookcases"@en .

aat:300039355 a skos:Concept ;
    skos:definition "Desks and bookcases with a hinged one-piece round lid or cover that resembles a section of a cylinder and which rolls up into the desk top; chiefly made in the late 18th and early 19th centuries. For similar desks without a bookcase use \"cylinder fall desks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder desks and bookcases"@en .

aat:300039360 a skos:Concept ;
    skos:definition "Writing desks, generally fall-front desks sitting on top of a chest of drawers, having compartments, slots, and cubbyholes above. For secretaries surmounted by a bookcase, use \"secretaries-bookcases.\" The term \"secretary\" originally referred to a small, portable writing desk, often with drawers, that was placed on top of a table. In modern usage, these small portable desks are generally called \"escritoires,\" and the term \"secretaries\" refers to larger pieces meant to be placed against a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secretaries"@en .

aat:300039407 a skos:Concept ;
    skos:definition "Slant-front desks supported on low removable frames, popular in the Queen Anne period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desks-on-frames"@en .

aat:300039411 a skos:Concept ;
    skos:definition "Term generally applied to a variety of small-scale desks designed for women; of a type popular in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' desks"@en .

aat:300039413 a skos:Concept ;
    skos:definition "Desks having a flat top and two boxlike supports either containing cupboards or drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal desks"@en .

aat:300039414 a skos:Concept ;
    skos:definition "Desks or stands designed with a slanted front and ledge for the positioning of an open book for comfortable reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading desks"@en .

aat:300039424 a skos:Concept ;
    skos:definition "Small, portable desks, designed to be sutiable for use while traveling; typically equipped with a wrting surface and containers for pens, ink, and paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling desks"@en .

aat:300039426 a skos:Concept ;
    skos:definition "Term used loosely to describe Wooton cabinet office secretaries and rotary desks, each invented by William S. Wooton. Whenever possible use more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wooton desks"@en .

aat:300039427 a skos:Concept ;
    skos:definition "Boxlike nests of drawers enclosed in the front by a flap that drops down to form a writing surface. For flat-top desks on long legs, generally taking the form of a table with one long drawer in the apron, use \"writing tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing desks"@en .

aat:300039436 a skos:Concept ;
    skos:definition "Flat-top desks on long legs, generally taking the form of a table with one long drawer in the apron. Use \"writing desks\" for similar forms having a superstructure with pigeonholes for writing materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing tables"@en .

aat:300039449 a skos:Concept ;
    skos:definition "Bureaux plats with a set of drawers or pigeonholes along one side of the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux à gradin"@en .

aat:300039451 a skos:Concept ;
    skos:definition "Large flat-top writing tables, usually with drawers in the frieze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux plats"@en .

aat:300039452 a skos:Concept ;
    skos:definition "Writing tables with a low superstructure consisting of two or three tiers of small drawers rising from the back and curving around the sides. Presumably named in the late 18th century after the Prince Regent's Carlton House."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carlton House tables"@en .

aat:300039457 a skos:Concept ;
    skos:definition "Small writing cabinets of table height with drawers in the support and a flap top with drop leaves; of a type invented in late 18th-century England by the Reverend Sir Herbert Croft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crofts"@en .

aat:300039458 a skos:Concept ;
    skos:definition "Compact writing tables fitted with drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "davenports"@en .

aat:300039460 a skos:Concept ;
    skos:definition "Desks constructed so that two people may work face-to-face; generally taking the form of a large writing table or desk with drawers on both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partners' desks"@en .

aat:300039470 a skos:Concept ;
    skos:definition "Small writing tables of various forms, designed for women. They may have a relatively delicate form and distinctive features, such as a wide opening to accommodate ladies' skirts when seated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' writing tables"@en .

aat:300039475 a skos:Concept ;
    skos:definition "Women's small writing tables with a cabinet at the back; often elaborately decorated and occasionally fitted for toilet purposes as well as writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonheurs-du-jour"@en .

aat:300039487 a skos:Concept ;
    skos:definition "Oblong tables of sturdy construction for use in libraries both public and private, for writing and the inspection of books or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library tables"@en .

aat:300039490 a skos:Concept ;
    skos:definition "Small tables designed at such a height to be used for writing while sitting on a sofa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sofa writing tables"@en .

aat:300039495 a skos:Concept ;
    skos:definition "English desks which are a modification of the cylinder desk, having tambour shutters instead of a curved cylinder. Distinct from the American \"tambour desk,\" which has upright reeded or slatted shutters that cover up the rest of the drawers and pigeonholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tambour writing tables"@en .

aat:300039519 a skos:Concept ;
    skos:definition "Large French desks popular in the late Louis XV and the Louis XVI periods with a roll top in the shape of a quarter cylinder. This type was occasionally imitated in other countries, besides France, particularly in Germany and Scandinavia in the last decade of the 18th century and virtually every western country during the 19th and 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux à cylindre"@en .

aat:300039521 a skos:Concept ;
    skos:definition "Desks with a hinged cover that may be lowered to form the writing surface or table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fall-front desks"@en .

aat:300039526 a skos:Concept ;
    skos:definition "Fall-front desks having a writing surface that, when closed, folds upward and inward, forming an angle with the carcass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slant-front desks"@en .

aat:300039545 a skos:Concept ;
    skos:definition "American desks with upright reeded or slatted shutters that cover up the nest of drawers and pigeonholes. Distinct from English \"tambour writing tables\", which are a modification of the cylinder desk with tambour shutters instead of a curved solid cylinder. Distinct from \"rolltop desks\" which close by means of a flexible shutter of convex shape composed of horizontal slats of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tambour desks"@en .

aat:300039548 a skos:Concept ;
    skos:definition "Articles of furniture consisting of a flat, slablike top supported on one or more legs or supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables"@en .

aat:300039554 a skos:Concept ;
    skos:definition "Late 18th- and early 19th-century circular or octagonal pedestal tables which have a deep top with numerous drawers in the frieze. Often the drawers are marked with days of the week or dates, as such tables were used by landlords for filing collected rents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rent tables"@en .

aat:300039574 a skos:Concept ;
    skos:definition "Term for French tables with a deep rim or gallery around the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables en crachoir"@en .

aat:300039580 a skos:Concept ;
    skos:definition "Tables supported by a fixed bracket (console) against a wall, or supported by a substructure consisting of two or more legs of console form. The term may be used for similar tables having other forms of supporting legs. May have marble tops and heavily carved substructures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "console tables"@en .

aat:300039583 a skos:Concept ;
    skos:definition "Console tables supported by an eagle bracket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eagle console tables"@en .

aat:300039584 a skos:Concept ;
    skos:definition "Tables whose flaps are supported by jointed gates which swing out from the central section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gate-leg tables"@en .

aat:300039587 a skos:Concept ;
    skos:definition "Tables with a single columnar support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal tables"@en .

aat:300039591 a skos:Concept ;
    skos:definition "Large oval or circular card tables with a central support and tilt top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loo tables"@en .

aat:300039596 a skos:Concept ;
    skos:definition "Term applied to tables with legs jutting from a pillar, regardless of their form, and with feet terminating into claws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar and claw tables"@en .

aat:300039602 a skos:Concept ;
    skos:definition "A variant form of trestle table with an X-shaped trestle at either end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawbuck tables"@en .

aat:300039605 a skos:Concept ;
    skos:definition "Joined tables with three legs; of a type made in 17th-century England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cricket tables"@en .

aat:300039612 a skos:Concept ;
    skos:definition "Tables with a removable board top resting on two or three trestle supports connected by a longitudinal bar instead of legs. For tables with X-shaped trestle supports, use \"sawbuck tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trestle tables"@en .

aat:300039619 a skos:Concept ;
    skos:definition "Tables with a pedestal base supported by three legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripod tables"@en .

aat:300039627 a skos:Concept ;
    skos:definition "Tables with a slate surface covered with cloth and surrounded by cushioned rails, on which the game of billiards is played. Distinct from \"pool tables\" which are similar in form but have six pockets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billiard tables"@en .

aat:300039633 a skos:Concept ;
    skos:definition "Moderate-sized tables lacking the raised edge of a tea table or the scale of a dining table and having drop leaves and sometimes a small drawer or two in the apron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breakfast tables"@en .

aat:300039640 a skos:Concept ;
    skos:definition "Occasional tables, often placed in front of a sofa in a living room. A coffee table is relatively low, of a convenient height for access while seated at the sofa. It is used for serving coffee, tea, cocktails, displaying large books or magazines, or various other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee tables"@en .

aat:300039646 a skos:Concept ;
    skos:definition "Tables used for the distribution of communion during the Eucharist in Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion tables"@en .

aat:300039648 a skos:Concept ;
    skos:definition "Tables designed for and used while eating meals in a dining room. Distinguished from kitchen tables, which are intended for less formal meals in a kitchen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dining tables"@en .

aat:300039653 a skos:Concept ;
    skos:definition "Dining tables with extending frames whose tops can be lengthened by inserting loose leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extension dining tables"@en .

aat:300039659 a skos:Concept ;
    skos:definition "Extension dining tables invented during the Victorian period, which received their name from the slide action by which their length is varied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telescope tables"@en .

aat:300039661 a skos:Concept ;
    skos:definition "Tables common in the American Federal period that consist of two semicircular end parts and a rectangular middle section. The middle section often incorporates drop leaves that serve to extend the length of the table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-part dining tables"@en .

aat:300039667 a skos:Concept ;
    skos:definition "Tables with surfaces adjustable for elevation and angles of incline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing tables"@en .

aat:300039668 a skos:Concept ;
    skos:definition "Generally applied to a variety of tables used for dressing and conducting one's toilet; they may be fitted with a mirror and drawers to hold toilet articles such as brushes and combs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing tables"@en .

aat:300039670 a skos:Concept ;
    skos:definition "English and American 18th-century tables made to provide the facilities of the modern bathroom, with provisions for a basin, bottles, bidet, and other toilet equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentlemen's dressing tables"@en .

aat:300039672 a skos:Concept ;
    skos:definition "Men's or ladies' dressing boxes on a tall stand with a lid that opens to reveal a fitted interior, usually with drawers beneath. Unlike other dressing tables, it has taller legs and lacks a full case of drawers beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beau-Brummel dressing tables"@en .

aat:300039674 a skos:Concept ;
    skos:definition "Term generally applied to a variety of dressing tables which are fitted with a mirror and have drawers to hold toilet articles. For ladies' dressing tables having drawers on the side which swing out and provide mirrors on a quadrant, use \"Rudd tables.\" Use \"toilettes\" with reference to French dressing tables designed for women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' dressing tables"@en .

aat:300039677 a skos:Concept ;
    skos:definition "Term applied to a variety of French dressing tables designed for women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilettes"@en .

aat:300039685 a skos:Concept ;
    skos:definition "Heart-shaped dressing tables with drawers springing out at each side somewhat like butterfly wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilettes en papillon"@en .

aat:300039694 a skos:Concept ;
    skos:definition "Tables of various designs at which cards, dice, and other games are played. They may have tops marked as a game board for playing chess, backgammon, goobun, or other games; they may have tops edged with a railing. Distinct from \"card tables\" which have a smooth, undecorated top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaming tables"@en .

aat:300039699 a skos:Concept ;
    skos:definition "Gaming tables with tops marked as boards for playing backgammon. They may be similar to French \"tric-trac tables,\" because the games are similar. Tric-trac was popular in France and elsewhere from 16th through 19th centuries. Both games could be played on either table. Backgammon tables tend to be of more recent origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backgammon tables"@en .

aat:300039700 a skos:Concept ;
    skos:definition "Tables designed for a game similar to billiards called bagatelle. These tables have a semicircular area at one end in which there are nine numbered holes or cups, each number signifying the points to be scored by pocketing a ball. The table width is usually one-third of its length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bagatelle tables"@en .

aat:300039702 a skos:Concept ;
    skos:definition "Tables with a smooth top, generally intended to be used for playing cards; often having a folding top, may have inset pockets to hold coins or counters. Distinguished from \"gaming tables\" which may have tops marked as game boards for playing chess, backgammon, or other games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card tables"@en .

aat:300039705 a skos:Concept ;
    skos:definition "Small card tables for playing bassette, a card game popular in Italy and France in the late 17th century and in England in the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basset tables"@en .

aat:300039714 a skos:Concept ;
    skos:definition "Tables with round, octagonal, or sometimes rectangular tops supported on columns ending in three flared legs. The tops often include a mechanism that allows it to tilt down for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripod card tables"@en .

aat:300039715 a skos:Concept ;
    skos:definition "Tables with tops marked with a gameboard divided into 64 squares of two alternating colors, for playing chess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chess tables"@en .

aat:300039717 a skos:Concept ;
    skos:definition "Small, three-sided tables, with pits in the top to hold counters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ombre tables"@en .

aat:300039718 a skos:Concept ;
    skos:definition "Circular card tables with a depression in the center for the cards and for a candlestick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables de brelan"@en .

aat:300039719 a skos:Concept ;
    skos:definition "Gaming tables, often French, incorporating a tric-trac board; the board typically has twelve holes along the base of each side, used for scoring.The table may also include a chess board and surface for the playing of cards. Although similar, \"backgammon tables\" tend to be of more recent origin and different design. Tric-trac was popular in France and elsewhere 16th-19th centuries. Both games could be played on either table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tric-trac tables"@en .

aat:300039734 a skos:Concept ;
    skos:definition "Flat boards or other surfaces, usually cloth-covered and with one tapered end, on which clothing or similar articles are ironed; may be freestanding and supported with collapsible legs or attached to a vertical surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironing boards"@en .

aat:300039741 a skos:Concept ;
    skos:definition "Side or serving tables arranged with compartments or drawers for bottles and decanters, and a flat work space for mixing drinks. It may be marble-topped and have a roll top that descends to cover the marble slab when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixing tables"@en .

aat:300039743 a skos:Concept ;
    skos:definition "Small plank top tables supported on a triangular frame with three legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking tables"@en .

aat:300039745 a skos:Concept ;
    skos:definition "Small tables made to stand beside a bed; includes those having a cupboard to hold a chamber pot and those with a close stool that pulls forward in the lower part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night tables"@en .

aat:300039752 a skos:Concept ;
    skos:definition "Relatively small, easily movable tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occasional tables"@en .

aat:300039755 a skos:Concept ;
    skos:definition "Tables used at a picnic, often collapsible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picnic tables"@en .

aat:300039756 a skos:Concept ;
    skos:definition "Tables with slate surfaces covered with cloth, having six pockets and surrounded by cushioned rails. Distinct from \"billiard tables\" which do not have pockets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pool tables"@en .

aat:300039757 a skos:Concept ;
    skos:definition "Spanish and Portuguese Colonial very small, low tables generally having flat carving and heavy aprons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratonas"@en .

aat:300039760 a skos:Concept ;
    skos:definition "Relatively large side tables, some of which may have tops attached to the wall, which are used in a dining room for serving food or displaying dishes. For case furniture used to serve food and display, use \"sideboards (furniture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sideboard tables"@en .

aat:300039767 a skos:Concept ;
    skos:definition "Objects designed to support or display another object; examples are small tablelike pieces of furniture used for holding or displaying objects. For supporting structures that are designed with and attached to the supported object, use \"bases (object components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stands"@en .

aat:300039770 a skos:Concept ;
    skos:definition "Stands with two or more tiers or stands for maximizing surface area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiered stands"@en .

aat:300039789 a skos:Concept ;
    skos:definition "Carved tripod stand that was popular as a type of furniture, particularly in Neoclassical French design. Often used as a washstand. It was based on the style of the metal tripod on the choregic monument of Lysikrates and also found in Herculaneum. The form was reconstructed by James Stuart as a motif at Kedleston Hall, Derbyshire. The form is also depicted in a painting by Joseph-Marie Vien, \"La Vertueuse Athénienne\" (1763), and thus the name is derived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "athéniennes"@en .

aat:300039790 a skos:Concept ;
    skos:definition "Stands intended to hold books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookstands"@en .

aat:300039794 a skos:Concept ;
    skos:definition "Stands for supporting the Koran in a position convenient for reading. May resemble a common bookstand or take the form of an X, with the book supported in the upper cradle of the crossing planks. Stands for supporting the Koran in a position convenient for reading. May resemble a common bookstand or take the form of an X, with the book supported in the upper cradle of the crossing planks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koran stands"@en .

aat:300039797 a skos:Concept ;
    skos:definition "Portable stands with a very small top intended to hold a candle or lamp; usually having a round or shaped top supported on a central pillar and with a tripod base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlestands"@en .

aat:300039805 a skos:Concept ;
    skos:definition "Candlestands with a notched mechanism for raising or lowering a support for a candle and usually with a trestle base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratchet candlestands"@en .

aat:300039810 a skos:Concept ;
    skos:definition "Stands or small tables fitted for or of a size and shape appropriate for bottles and glasses, such as the horseshoe-shaped tables popular in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking stands"@en .

aat:300039813 a skos:Concept ;
    skos:definition "Articles of dining-room furniture intended to dispense with the services of a waiter at table. It comprises an upright pole bearing one or more trays or shelves, sometimes revolving. On these are placed glasses, dishes, and other table requisites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumbwaiters"@en .

aat:300039822 a skos:Concept ;
    skos:definition "Stands for terrestrial and celestial globes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globe stands"@en .

aat:300039823 a skos:Concept ;
    skos:definition "Compact, fitted dressing chests intended to hold a lady's jewelry and cosmetics. Compact, fitted dressing chests intended to hold a lady's jewelry and cosmetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' dressing stands"@en .

aat:300039830 a skos:Concept ;
    skos:definition "Furniture in the form of pedestals with an an inclined, sometimes moveable frame; used to hold scores or sheet music in position for reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music stands"@en .

aat:300039835 a skos:Concept ;
    skos:definition "Relatively small table-like or shelf-like pieces of furniture used to hold or display potted plants, or sometimes containers of cut flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant stands"@en .

aat:300039840 a skos:Concept ;
    skos:definition "Ornamental receptacles on an elevated stand, used for growing plants and flowers, sometimes having a lead-lined top. For receptacles not associated with a stand, use \"jardinières (containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jardinières"@en .

aat:300039843 a skos:Concept ;
    skos:definition "Stands for holding large prints; generally having a front which falls down and often having a lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portfolio stands"@en .

aat:300039844 a skos:Concept ;
    skos:definition "Stands with adjustable mirrors and a small table surface at chest-level, used by men to hold the implements required for shaving. The form appears in Europe in the 17th century, and was common in Britain and North America through the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving stands"@en .

aat:300039846 a skos:Concept ;
    skos:definition "Ashtrays mounted on a low pedestal stand generally used along side of a sofa. Distinct from \"smoking stands\" which are small stands or cabinets with zinc-lined compartments used to store smoking supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smokers"@en .

aat:300039851 a skos:Concept ;
    skos:definition "Stands designed to hold trays, typically for use in food service and display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tray stands"@en .

aat:300039852 a skos:Concept ;
    skos:definition "Stands or receptacles for holding umbrellas, generally located inside a home or other building near an exterior door. The term is used for stands of metal or wood construction as well as for large cylinder-shaped vessels of ceramic, metal, or another material, designed and used for holding umbrellas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbrella stands"@en .

aat:300039857 a skos:Concept ;
    skos:definition "Furniture combining features of a table and cupboard and used to hold articles (as a pitcher, basin, and towel) for washing the hands and face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washstands"@en .

aat:300039859 a skos:Concept ;
    skos:definition "Small stands for washing, having a shelf or ring to hold the basin, and often shelves for a pitcher and chamber pot beneath. Drawers, towel bars, and ledges for soap and other toiltries may be included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basin stands"@en .

aat:300039865 a skos:Concept ;
    skos:definition "Basin stands designed to fit into the corner of a room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner basin stands"@en .

aat:300039879 a skos:Concept ;
    skos:definition "Tables with adjustable tops which could be raised by means of a ratchet so that they could be used as standing desks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables à la tronchin"@en .

aat:300039880 a skos:Concept ;
    skos:definition "18th-century French term for any small, easily portable table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables ambulantes"@en .

aat:300039886 a skos:Concept ;
    skos:definition "Term applied to small tables of various designs, intended to hold a tea service, or part of the service, and other articles used for serving tea; may have a top so made that it could be lifted off for separate use as a tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea tables"@en .

aat:300039894 a skos:Concept ;
    skos:definition "Tables or other platforms on wheels used in serving tea and light refreshments; may have attached platforms or storage attachments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea wagons"@en .

aat:300039896 a skos:Concept ;
    skos:definition "Italian type of small, spindly three-legged tables, especially popular in 18th-century Venice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trespoli"@en .

aat:300039897 a skos:Concept ;
    skos:definition "Small bedroom tables, often of trestle form, with deeply rimmed tops and sometimes one or more shelves designed to hold the contents of a man's pockets when he undresses. First made in France in the 1720s and popular there and in England in the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vide-poches"@en .

aat:300039900 a skos:Concept ;
    skos:definition "Relatively small tables used for sewing and other handiwork, usually having storage areas for working materials and implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handiwork tables"@en .

aat:300039920 a skos:Concept ;
    skos:definition "Ladies' work tables with tray tops and sometimes shelves; from \"tricoter,\" meaning to knit, but used for a variety of needlework forms. A 19th-century term used mainly for 18th-century pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tricoteuses"@en .

aat:300039921 a skos:Concept ;
    skos:definition "French 18th-century term for small tiered tables, usually of tripod form, with movable arms to support candlesticks; generally used by women both for work and for reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serviteurs-fidèle"@en .

aat:300039922 a skos:Concept ;
    skos:definition "Small ladies' work tables. In their classic form, may have galleries around its top and the shelf joining its legs to provide shallow receptacles into which one could place chiffons (scraps of ribbon and cloth) and other needlework materials; either square or circular in form and generally having three drawers, the uppermost sometimes fitted with writing equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables en chiffonnière"@en .

aat:300039929 a skos:Concept ;
    skos:definition "Tables with flaps which may be drawn out from beneath the top to extend the length. Late 16th-century and early 17th-century hall tables are often of this type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draw tables"@en .

aat:300039933 a skos:Concept ;
    skos:definition "Generic term for various types of space-saving tables with leaves hinged to the top so that they can be raised to extend the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dropleaf tables"@en .

aat:300039937 a skos:Concept ;
    skos:definition "Drop leaf tables having a pear-shaped surface, that when the leaf is dropped, resemble butterfly wings; named after a table first designed by Finn Juhl in 1949."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butterfly tables"@en .

aat:300039939 a skos:Concept ;
    skos:definition "Tables with a triangular top and one triangular folding leaf that, when raised, converts it to a square-top table; intended to stand in corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handkerchief tables"@en .

aat:300039941 a skos:Concept ;
    skos:definition "Relatively small, rectangular dropleaf tables with a drawer or drawers below. The leaves are supported by brackets. The form was introduced during the Chippendale period and intended to serve many purposes. The name refers to the Earl of Pembroke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pembroke tables"@en .

aat:300039944 a skos:Concept ;
    skos:definition "A more elaborate version of the Pembroke table, with a small nest of drawers which is concealed in the body and may be made to rise from the top by means of weights; of a type made in late 18th-century England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harlequin tables"@en .

aat:300039951 a skos:Concept ;
    skos:definition "Double-top card or dining tables that unfold like a book, supported by pivoting about to the opposite axis, by a swing leg, or by a runner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flip-top tables"@en .

aat:300039958 a skos:Concept ;
    skos:definition "A set of several tables, graduated in size so as to fit one over another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nesting tables"@en .

aat:300039962 a skos:Concept ;
    skos:definition "Term used by Sheraton to describe a nest of four small tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartetto tables"@en .

aat:300039963 a skos:Concept ;
    skos:definition "Tables whose tops are hinged to tilt to a vertical position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilt-top tables"@en .

aat:300039998 a skos:Concept ;
    skos:definition "Any small tables used in relation to a couch or chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end tables"@en .

aat:300039999 a skos:Concept ;
    skos:definition "Tables designed to stand against the wall, generally with one side undecorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side tables"@en .

aat:300040000 a skos:Concept ;
    skos:definition "Side tables of a size and design to stand in front of the pier or wall between two windows; sometimes surmounted by a pier glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pier tables"@en .

aat:300040014 a skos:Concept ;
    skos:definition "Long, narrow tables having drop leaves and usually drawers, popular in the 18th and 19th centuries. The sofa table was usually placed in front of a sofa, but could be placed behind it. Modern versions typically have no drop leaves and are placed behind the sofa. For smaller drop leaf tables often placed near sofas or other seats, see \"Pembroke tables.\" For shorter tables without drop leaves that are placed in front of sofas, see \"coffee tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sofa tables"@en .

aat:300040023 a skos:Concept ;
    skos:definition "Containers for holding cold water and ice to chill one or more bottles of wine. There are two forms: one intended to be used on the table, sideboard, or the like, often of urn or bucketlike shape; the second form is a large open basin or box intended to stand on the floor. The latter is sometimes accompanied by a wine fountain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine coolers"@en .

aat:300040029 a skos:Concept ;
    skos:definition "Furniture designed by architects or to match or accord with the architectural features of the rooms for which it is intended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural furniture"@en .

aat:300040033 a skos:Concept ;
    skos:definition "Furniture, typically made of flexible, airtight material such as plastic or vinyl, designed to be inflated by air. Inflatable furniture can be uninflated when not in use and stored conveniently stored in small spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inflatable furniture"@en .

aat:300040036 a skos:Concept ;
    skos:definition "Refers to a great variety of furniture including barbers' chairs, wheelchairs, and space-saving office furniture; designed to solve a particular problem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical furniture"@en .

aat:300040038 a skos:Concept ;
    skos:definition "Variety of innovative furniture forms covered wholly or in part by a registered patent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patent furniture"@en .

aat:300040039 a skos:Concept ;
    skos:definition "Describes furniture made in related units, so that pieces such as wardrobes, chests, cupboards, bookcases, or writing desks, made in standard sizes, may be conveniently added to and rearranged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unit furniture"@en .

aat:300040041 a skos:Concept ;
    skos:definition "Furniture designed to be used for a number of functions, such as writing, reading, needlework, or games, as well as larger pieces with ingeniously fitted interiors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multipurpose furniture"@en .

aat:300040045 a skos:Concept ;
    skos:definition "Portable furniture intended for use outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camp furniture"@en .

aat:300040046 a skos:Concept ;
    skos:definition "Furniture designed to be erected and dissasembled easily and quickly, produced for officers to be taken on military campaign. Despite these requirements, campaign furniture is typically luxurious and crafted from quality materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign furniture"@en .

aat:300040048 a skos:Concept ;
    skos:definition "Furniture sold in units which can be packed flat and easily assembled with a screwdriver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knock-down furniture"@en .

aat:300040157 a skos:Concept ;
    skos:definition "Furniture built into the walls or overall structure of a building. This can include, chests, cabinets, corner cupboards, bookcases, beds, and seating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "built-in furniture"@en .

aat:300040163 a skos:Concept ;
    skos:definition "Furniture of simple design which makes the most economical use of materials and labor; generally austere, well-proportioned, and unornamented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility furniture"@en .

aat:300040206 a skos:Concept ;
    skos:definition "Steps used to climb into a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed steps"@en .

aat:300040210 a skos:Concept ;
    skos:definition "Ladders from which the upper shelves of a bookcase may be reached, often fitted into a chair, stool, table, or other piece of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library steps"@en .

aat:300040215 a skos:Concept ;
    skos:definition "Parts and components of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture components"@en .

aat:300040220 a skos:Concept ;
    skos:definition "Ornamental extensions below the bottom edge of the seat of a chair, or frame of a table or cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aprons"@en .

aat:300040237 a skos:Concept ;
    skos:definition "Supports for the elbow and forearm used in seating furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arms"@en .

aat:300040239 a skos:Concept ;
    skos:definition "Chair arms having supports that sweep back in a curve between where they meet the seat and the arm rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollowed arms"@en .

aat:300040240 a skos:Concept ;
    skos:definition "The scroll ending on arms of certain kinds of Windsor chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knuckled arms"@en .

aat:300040242 a skos:Concept ;
    skos:definition "Upholstered furniture arms that retain an open space between the back and seat, rather than being closed by the upholstery itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open arms"@en .

aat:300040243 a skos:Concept ;
    skos:definition "Upholstered furniture arms that curve out and away from the back and seat, creating the effect of a curl. Common to Chippendale sofas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolled arms"@en .

aat:300040246 a skos:Concept ;
    skos:definition "Furniture arms in which the support rises from the seat rail curving first toward the front and then toward the back, and leveling out for the armrest. Used in the Queen Anne and Early Georgian periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrolled arms"@en .

aat:300040253 a skos:Concept ;
    skos:definition "Furniture arms that are formed to resemble the curved neck of a swan, sometimes with anatomical details depicted such as the head and eyes, and occasionally the entire body and wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swan arms"@en .

aat:300040258 a skos:Concept ;
    skos:definition "Broad, flat arms on chairs intended to serve as a writing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing arms"@en .

aat:300040261 a skos:Concept ;
    skos:definition "Parts and components of furniture arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arm components"@en .

aat:300040262 a skos:Concept ;
    skos:definition "Refers to the upholstered elements of the arms of chairs. Arm pads may cover the entire arm or a small part. This term is also extended to the serpentine arms of Windsor chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arm pads"@en .

aat:300040263 a skos:Concept ;
    skos:definition "Rails that form some part of the support of the arms of chairs. Found on some Windsor chairs, where the arms are a part of one continuous rail around the back of the chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arm rails"@en .

aat:300040264 a skos:Concept ;
    skos:definition "Vertical or curved uprights supporting the front end of chair arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arm supports"@en .

aat:300040268 a skos:Concept ;
    skos:definition "Portions of furniture arms that are meant to be gripped by the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handholds"@en .

aat:300040377 a skos:Concept ;
    skos:definition "Parts and components of furniture backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture back components"@en .

aat:300040379 a skos:Concept ;
    skos:definition "Extensions of back legs which support the chair back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back rails"@en .

aat:300040387 a skos:Concept ;
    skos:definition "Chair or seat rails that form the upright support of the back, often with carved details such as fluting or \"ears.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crest rails"@en .

aat:300040394 a skos:Concept ;
    skos:definition "Up-curved ends of a crest rail; usually on Chippendale chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ears"@en .

aat:300040395 a skos:Concept ;
    skos:definition "Shaped projections that rise from the back rails of chair seats, into which the base of the splat is socketed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoes"@en .

aat:300040396 a skos:Concept ;
    skos:definition "Inward curvatures in the outline of the splats of a chair back, usually occurring where the splat is fitted to the frame. Shoulders may appear on one or both edges of the splat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulders"@en .

aat:300040400 a skos:Concept ;
    skos:definition "One of a series of slender turned rods set in vertical rows to fill open areas such as chair backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spindles"@en .

aat:300040402 a skos:Concept ;
    skos:definition "Decorative, flattened, arrow-tipped spindles incorporated in the chair backs of Sheraton, American Federal, and some Windsor chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrow spindles"@en .

aat:300040403 a skos:Concept ;
    skos:definition "Spindles split longitudinally and applied to furniture surfaces as decorative elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split spindles"@en .

aat:300040404 a skos:Concept ;
    skos:definition "Central, vertical members on a chair back, generally shaped or pierced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splats"@en .

aat:300040413 a skos:Concept ;
    skos:definition "The two forward extensions to the sides of the back on an easy chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wings"@en .

aat:300040418 a skos:Concept ;
    skos:definition "The board or boards that make up the back of a piece of case furniture and sometimes extend above the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backboards"@en .

aat:300040419 a skos:Concept ;
    skos:definition "Decorative border of contrasting types of wood cut at varying angles to the grain, such as for finishing the edges and rims of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banding"@en .

aat:300040420 a skos:Concept ;
    skos:definition "Decorative border of contrasting types of wood cut straight across the grain, generally used to finish edges and rims of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross banding"@en .

aat:300040425 a skos:Concept ;
    skos:definition "Parts and components of beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed components"@en .

aat:300040433 a skos:Concept ;
    skos:definition "Upright supports on a bedstead, such as those which support the tester on a high-post bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedposts"@en .

aat:300040435 a skos:Concept ;
    skos:definition "Constructions of springs and wire that support mattresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedsprings"@en .

aat:300040438 a skos:Concept ;
    skos:definition "Boards supporting the bedsprings, usually extending from side to side of a bedstead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed slats"@en .

aat:300040443 a skos:Concept ;
    skos:definition "Rails incorporated at the foot of some bedsteads that connect the bottom bedposts, and that may function as a place to rest an extra blanket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanket rails"@en .

aat:300040444 a skos:Concept ;
    skos:definition "Boards forming the end of anything, especially a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footboards"@en .

aat:300040445 a skos:Concept ;
    skos:definition "Posts at the foot of a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footposts"@en .

aat:300040447 a skos:Concept ;
    skos:definition "Boards forming the head of anything, especially a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headboards"@en .

aat:300040450 a skos:Concept ;
    skos:definition "Rectangular cases filled with yielding fabric such as cotton or hair, generally used on bedsteads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mattresses"@en .

aat:300040453 a skos:Concept ;
    skos:definition "Rooflike components supported above the bed by posts and covering the whole area of the bed. Use \"flying testers\" for rooflike components generally cantilevered from the headboard and extending over the whole area of the bed. Use \"half-testers\" for similar forms which only extend over the head half of the bed. Use \"canopies (structural elements)\" for rooflike components suspended over the head of the bed by means of a cord or chain attached to the ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testers"@en .

aat:300040464 a skos:Concept ;
    skos:definition "Rooflike components, generally cantilevered from the head posts, which extend over the head half of the bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-testers"@en .

aat:300040466 a skos:Concept ;
    skos:definition "Double-block devices with columns fitted between the top and the shaft of a tilt-top table that allows the top to tilt and rotate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birdcages"@en .

aat:300040477 a skos:Concept ;
    skos:definition "Small slides above the slant top in desks to support candlesticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle slides"@en .

aat:300040480 a skos:Concept ;
    skos:definition "The body or framework of furniture, to which veneers and other surface materials are applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carcases"@en .

aat:300040528 a skos:Concept ;
    skos:definition "Reinforcing blocks glued, nailed, or screwed into the corner of a chair or sofa frame to hold the leg and seat rail together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner blocks"@en .

aat:300040532 a skos:Concept ;
    skos:definition "Corners on furniture that have wide chamfers at the junctions of front and sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canted corners"@en .

aat:300040539 a skos:Concept ;
    skos:definition "Rounded elements or outlines which break the square corners of cabinetry, picture frames, or other furniture. The form is derived from classical architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ovolo corners"@en .

aat:300040557 a skos:Concept ;
    skos:definition "Doors concealing cubbyhole spaces found in case furniture such as fall-front desks, secretarys or escritoires, and often fitted with a lock. They are frequently decorated with carvings or marquetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prospect doors"@en .

aat:300040558 a skos:Concept ;
    skos:definition "Sliding receptacles, fitted into furniture, that can be drawn out horizontally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawers"@en .

aat:300040562 a skos:Concept ;
    skos:definition "Drawers which overlap their frames, usually with molded edges that protrude slightly from the cabinet they rest in, rather than sitting flush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lipped drawers"@en .

aat:300040565 a skos:Concept ;
    skos:definition "Deep drawers often lined with lead that are designed to hold wine bottles. Often included in sideboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellaret drawers"@en .

aat:300040567 a skos:Concept ;
    skos:definition "Drawers devised to store paper documents. These may be of various form, to hold documents either horizontally or vertically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "document drawers"@en .

aat:300040568 a skos:Concept ;
    skos:definition "Term used by Hepplewhite for a specially designed top drawer equipped with compartments for such items as combs, powders, and essences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing drawers"@en .

aat:300040570 a skos:Concept ;
    skos:definition "Fall-front drawers often incorporated in bookcases or as the upper drawer in chests of drawers to provide a level surface convenient for writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secretary drawers"@en .

aat:300040571 a skos:Concept ;
    skos:definition "Drawers that are contrived to be hidden in some mechanical or cosmetic way. Most often refers to drawers in mechanical furniture of the 18th century that were fitted with springs or levers that could reveal them. These were used as hiding places for valuables or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secret drawers"@en .

aat:300040579 a skos:Concept ;
    skos:definition "Drawers shaped as quarter circles that swing outward on a pivot when opened. These often contain divisions for the storage of small items such as bottles of ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrant drawers"@en .

aat:300040583 a skos:Concept ;
    skos:definition "Horizontal boards between drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dustboards"@en .

aat:300040584 a skos:Concept ;
    skos:definition "Boards, often carved in profile, that are components in chests or the support of stools or benches. Common support elements for stools in the Medieval period, and until the 17th century when legs became the norm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end boards"@en .

aat:300040586 a skos:Concept ;
    skos:definition "Ends of furniture panels or tabletop elements that have a rounded, convex section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astragal ends"@en .

aat:300040589 a skos:Concept ;
    skos:definition "Furniture elements characterized by a concave half-round section, usually where the corner or end of a squared rectangle would be found, as on a tabletop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow ends"@en .

aat:300040600 a skos:Concept ;
    skos:definition "Spherical feet, used mainly on tables and case furniture in the second half of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball feet"@en .

aat:300040601 a skos:Concept ;
    skos:definition "Feet on furniture in the shape of a cube, generally used with square untapered legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block feet"@en .

aat:300040602 a skos:Concept ;
    skos:definition "Feet shaped like a bracket, in common use on case furniture in the first half of the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracket feet"@en .

aat:300040607 a skos:Concept ;
    skos:definition "Cabinet feet with a cyma reversa profile, found in American and some English work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ogee bracket feet"@en .

aat:300040609 a skos:Concept ;
    skos:definition "Flattened ball feet, used on furniture from the mid-17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bun feet"@en .

aat:300040613 a skos:Concept ;
    skos:definition "Feet of slightly compressed spherical shape with vertical indented channels or crenellations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melon feet"@en .

aat:300040615 a skos:Concept ;
    skos:definition "Feet, in the shape of claws, on a piece of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claw feet"@en .

aat:300040616 a skos:Concept ;
    skos:definition "A termination mainly used on cabriole legs in the first half of the 18th century (though earlier examples occur), representing a bird's or dragon's claw clutching a ball. Of Oriental derivation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claw-and-ball feet"@en .

aat:300040623 a skos:Concept ;
    skos:definition "Claw and ball feet which have very sharp and thin claws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rat claw feet"@en .

aat:300040624 a skos:Concept ;
    skos:definition "Claw-and-ball feet associated with early American furniture originating in Massachusetts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retracted claw feet"@en .

aat:300040625 a skos:Concept ;
    skos:definition "Claw-and-ball type feet shaped like an animal's paw with wing-like pieces flanking them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winged claw feet"@en .

aat:300040626 a skos:Concept ;
    skos:definition "Plain, circular feet used to terminate the cabriole leg, particularly in the early 18th century. When such feet are set on a disk, use \"pad feet.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "club feet"@en .

aat:300040627 a skos:Concept ;
    skos:definition "Similar to club feet but resting on a disk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pad feet"@en .

aat:300040630 a skos:Concept ;
    skos:definition "Furniture feet in the shape of spinning tops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toupie feet"@en .

aat:300040631 a skos:Concept ;
    skos:definition "Feet on baluster legs which end in a ball flanked by rings, over the beginning of another baluster facing downwards; resembling the foot of a colt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colt feet"@en .

aat:300040633 a skos:Concept ;
    skos:definition "Popular motif used as the terminal ornament on chair feet and table legs in the 17th, 18th, and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolphin feet"@en .

aat:300040634 a skos:Concept ;
    skos:definition "Furniture elements that resemble the claw of a dragon grasping a jewel or pearl. The form may have derived from Dutch navigators coming in contact with Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragon feet"@en .

aat:300040635 a skos:Concept ;
    skos:definition "Furniture feet having the form of three connected lobes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trifid feet"@en .

aat:300040640 a skos:Concept ;
    skos:definition "Slender, outward-curving bracket feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French feet"@en .

aat:300040644 a skos:Concept ;
    skos:definition "Terminal for chair legs in the form of a cloven hoof; first used by ancient Egyptians, and popular in 17th- and 18th-century Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoof feet"@en .

aat:300040650 a skos:Concept ;
    skos:definition "Feet carved to represent an animal's paw; used on chairs, sofas, and case pieces, especially in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paw feet"@en .

aat:300040653 a skos:Concept ;
    skos:definition "Feet in the form of animal paws with elaborate hair, often found on chair legs, but appearing also on many decorative art objects, including andirons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairy paw feet"@en .

aat:300040654 a skos:Concept ;
    skos:definition "Decorative termination to the leg of a piece of furniture (generally a chair) used from the late 17th to the early 18th century and again in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lion's paw feet"@en .

aat:300040660 a skos:Concept ;
    skos:definition "Furniture feet common in the Renaissance characterized by horizontal side-bars connecting the front and rear legs at the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runner feet"@en .

aat:300040662 a skos:Concept ;
    skos:definition "Furniture feet in the form of a tight scroll, especially those found on mid-18th-century English chair legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scroll feet"@en .

aat:300040677 a skos:Concept ;
    skos:definition "S-curved legs with thin ankles which broaden to a shaped foot not unlike the head of a snake; used on tripod tables from the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snake feet"@en .

aat:300040678 a skos:Concept ;
    skos:definition "Furniture feet in the form of a tapered square block, much used in the second half of the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "therm feet"@en .

aat:300040688 a skos:Concept ;
    skos:definition "Popular in the late 17th century, feet in which the scroll turns under, towards the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish feet"@en .

aat:300040700 a skos:Concept ;
    skos:definition "Parts and components of furniture feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot components"@en .

aat:300040701 a skos:Concept ;
    skos:definition "Terminations on furniture legs having the form of a ball, which is a smooth, round object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balls"@en .

aat:300040702 a skos:Concept ;
    skos:definition "Modern American term for a band separating the leg and foot of a table or stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracelets"@en .

aat:300040709 a skos:Concept ;
    skos:definition "Disk-shaped turned or shaped terminations on furniture legs used especially during the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discs"@en .

aat:300040710 a skos:Concept ;
    skos:definition "Components of claw-and-ball feet that are modeled on the talons of birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talons"@en .

aat:300040737 a skos:Concept ;
    skos:definition "Supports for a person's feet, as for example an attachment to a barber's or a reclining chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footrests"@en .

aat:300040773 a skos:Concept ;
    skos:definition "Decorative, raised borders of wood or metal extending around the back and sides of a shelf or on the top of a piece of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleries"@en .

aat:300040814 a skos:Concept ;
    skos:definition "Shaped tops on cabinet pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoods"@en .

aat:300040816 a skos:Concept ;
    skos:definition "Triangular closed backs forming the hood or top to a tall piece of case furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonnet tops"@en .

aat:300040825 a skos:Concept ;
    skos:definition "Furniture legs comprising a molded shaft, square or lathe-turned, that resemble the form of a spindle or baluster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baluster legs"@en .

aat:300040831 a skos:Concept ;
    skos:definition "Legs with a double curve, convex above concave, introduced about 1700."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabriole legs"@en .

aat:300040840 a skos:Concept ;
    skos:definition "Legs having the form of a cluster of columns or shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cluster legs"@en .

aat:300040848 a skos:Concept ;
    skos:definition "Furniture legs, curved like a cavalry sabre, square or round in section and tapering gently toward the base. Derived from the Greek klismos and much used on late 18th-century and early 19th-century chairs and sofas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabre legs"@en .

aat:300040858 a skos:Concept ;
    skos:definition "English term for straight or tapering square legs, sometimes with a plinth foot. Used on American furniture from the mid-18th century, often with the inside edge chamfered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marlborough legs"@en .

aat:300040862 a skos:Concept ;
    skos:definition "Tapered furniture legs that are square in section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "therm legs"@en .

aat:300040867 a skos:Concept ;
    skos:definition "Furniture support components that are designed to demount from the surface they are attached to, by unscrewing from fittings, or any other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detachable legs"@en .

aat:300040868 a skos:Concept ;
    skos:definition "Refers to a hinged leg, without a stretcher, which swings out to support the drop leaf of a table, such as found on card tables. For similar legs with a stretcher, use \"gate legs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swing legs"@en .

aat:300040870 a skos:Concept ;
    skos:definition "Refers to hinged legs with a stretcher, which swing out to support the drop leaf of a table, such as found on gate-leg tables. For similar legs without a stretcher, use \"swing legs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gate legs"@en .

aat:300040882 a skos:Concept ;
    skos:definition "Parts and components of furniture legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture leg components"@en .

aat:300040883 a skos:Concept ;
    skos:definition "The outward upper portion of a furniture leg, especially of a cabriole leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knees"@en .

aat:300040886 a skos:Concept ;
    skos:definition "Knees with carved ornament on cabriole chair legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hipped knees"@en .

aat:300040889 a skos:Concept ;
    skos:definition "Parts and components of furniture knees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture knee components"@en .

aat:300040890 a skos:Concept ;
    skos:definition "Supports, usually of carved wood or scrolled wrought iron, used to support furniture legs, projecting windows, bays, bows, or other features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knee brackets"@en .

aat:300040891 a skos:Concept ;
    skos:definition "Vertical sliding pieces that when pulled out support the fall front of a desk or secretary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lopers"@en .

aat:300041086 a skos:Concept ;
    skos:definition "Open-fronted storage units in the well of a desk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigeonholes"@en .

aat:300041116 a skos:Concept ;
    skos:definition "The part of seating furniture on which one sits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seats"@en .

aat:300041123 a skos:Concept ;
    skos:definition "18th-century term for seats in which the middle and front are lower than the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollowed seats"@en .

aat:300041128 a skos:Concept ;
    skos:definition "Chair seats shaped like the cup of a saddle with a slight center ridge at the front edge; most often used on Windsor chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle seats"@en .

aat:300041156 a skos:Concept ;
    skos:definition "Upholstered or carved seats that have their own frame and fit loosely into the frame of the chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip seats"@en .

aat:300041161 a skos:Concept ;
    skos:definition "Upholstered seats with interior springs of coiled wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coil-spring seats"@en .

aat:300041163 a skos:Concept ;
    skos:definition "Parts and components of seats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seat components"@en .

aat:300041165 a skos:Concept ;
    skos:definition "Frames intended to hold or encase seats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seat frames"@en .

aat:300041167 a skos:Concept ;
    skos:definition "Frames on which the seat is built."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seat rails"@en .

aat:300041172 a skos:Concept ;
    skos:definition "Curved medial braces running from front to back of the seat frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medial braces"@en .

aat:300041183 a skos:Concept ;
    skos:definition "Horizontal panels that slide out of the body of a piece to increase the surface area temporarily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slides"@en .

aat:300041192 a skos:Concept ;
    skos:definition "Modern term for a melon-shaped swelling, often carved with gadrooning, used centrally on table legs, bed posts, and press cupboard supports in the late 16th and the 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melon bulb supports"@en .

aat:300041194 a skos:Concept ;
    skos:definition "Supports in form of animals' heads with one leg immediately below; used on tables and seats of the ancient world and revived in the late 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monopodia"@en .

aat:300041213 a skos:Concept ;
    skos:definition "Framing or brackets installed in chests, cabinetry, desks, or other furniture that support drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawer supports"@en .

aat:300041223 a skos:Concept ;
    skos:definition "Refers to 18th century chair stretchers that combine balusters or other turned elements with blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block and spindle stretchers"@en .

aat:300041225 a skos:Concept ;
    skos:definition "X-shaped horizontal braces or rails connecting and supporting the legs of chairs, tables, and case pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross stretchers"@en .

aat:300041232 a skos:Concept ;
    skos:definition "Horizontal members connecting and supporting the legs of furniture in an X-form. This form is of Italian origin, often having a scrolled or serpentine figure with a finial in the center. Introduced into England toward the end of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saltire stretchers"@en .

aat:300041237 a skos:Concept ;
    skos:definition "Name given to the bosses on large stretchers linking and strengthening the legs of a table or secretaire; often very richly carved and pierced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noix"@en .

aat:300041253 a skos:Concept ;
    skos:definition "Table supports of Medieval origin, consisting of two or more inverted T or Y shapes braced by a stretcher or brackets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trestles"@en .

aat:300041273 a skos:Concept ;
    skos:definition "Pictorial works produced by transferring images by means of a matrix such as a plate, block, or screen, using any of various printing processes. When emphasizing the individual printed image, use \"impressions.\" Avoid the controversial expression \"original prints,\" except in reference to discussions of the expression's use. If prints are neither \"reproductive prints\" nor \"popular prints,\" use the simple term \"prints.\" With regard to photographs, prefer \"photographic prints\"; for types of reproductions of technical drawings and documents, see terms found under \"reprographic copies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prints"@en .

aat:300041281 a skos:Concept ;
    skos:definition "Japanese prints of a long, narrow format, about 28 3/4 by 4 3/4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hashira-e"@en .

aat:300041283 a skos:Concept ;
    skos:definition "Japanese prints in the form of a hanging vertical scroll, usually about 30 by 10 1/4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kakemono-e"@en .

aat:300041286 a skos:Concept ;
    skos:definition "Japanese prints of a standard size, about 11 by 8 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chuban"@en .

aat:300041288 a skos:Concept ;
    skos:definition "Japanese prints in a long, narrow format measuring about 13 by 6 1/2 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoso-e"@en .

aat:300041289 a skos:Concept ;
    skos:definition "Japanese prints of a standard size, about 5 1/2 by 4 1/2 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koban"@en .

aat:300041290 a skos:Concept ;
    skos:definition "Japanese prints of a standard size about 15 3/4 by 10 1/2 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oban"@en .

aat:300041291 a skos:Concept ;
    skos:definition "Japanese prints of a standard size, about 14 by 4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanzaku"@en .

aat:300041296 a skos:Concept ;
    skos:definition "Small Japanese prints produced in luxury editions to present to friends to commemorate special occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surimono"@en .

aat:300041314 a skos:Concept ;
    skos:definition "Proofs numbered separately from the edition, but often made at the same time as the edition, for the use of the artist. They are typically signed and marked in a special way and are usually sold at inflated prices. Artists' proofs are often the first 10 to 20 prints of a run; although the number of artists' proofs occasionally approaches that of the main edition, this practice is considered unethical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' proofs"@en .

aat:300041316 a skos:Concept ;
    skos:definition "Proofs designated by the artist to serve as the standard, both aesthetically and technically, for the printing of the edition. Sometimes identical with the printers' proofs of the edition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bon à tirer proofs"@en .

aat:300041317 a skos:Concept ;
    skos:definition "Refers to prints having remarques, which are doodles or sketches by the artist outside the main design. While remarques were originally used to test the strength of the acid on a plate and then burnished away, since the nineteenth century they are sometimes deliberately kept in printed editions to produce rarities for collectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remarque proofs"@en .

aat:300041318 a skos:Concept ;
    skos:definition "Refers to notes, scribbles, sketches or doodles made by the artist outside the design on a plate to be printed. The practice started as a way of testing the strength of the acid on a plate about to be etched before risking the biting of the image. Remarques were usually burnished away before printing, though occasionally some marginal marks were deliberately left in some printed editions to exploit the collector's desire for rarities. See also \"remarque proofs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remarques"@en .

aat:300041319 a skos:Concept ;
    skos:definition "Impressions made from a printing element that has been defaced after completion of an edition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cancellation proofs"@en .

aat:300041321 a skos:Concept ;
    skos:definition "Impressions taken from a print, drawing, or printed or handwritten textual work, by pressing the original against a sheet of damp paper, often by passing it through a rolling press. Some of the ink of the original is transferred to the damp paper; the resulting image appears in reverse and may be fainter than the original. The original may be damaged in the process. Counterproofs are often made as part of the working process and are used as aids in correcting for the final version. In some cases, counterproofing was used to produce the finest quality copperplate printing; the second print consisted of delicate lines, and lacked the beveled impressions seen in the original print. Counterproofs are sometimes created as forgeries of valuable prints and drawings but the mirror image gives such copies away. For images or marks that result from an unintentional transfer of ink or other medium, use \"offsets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterproofs"@en .

aat:300041323 a skos:Concept ;
    skos:definition "Proofs showing the sequential and cumulative steps of a color printing process as each color is added. They are used to determine color density and the effect of each color on the other colors; any color corrections can be formulated for the platemaker. For a set of proofs showing each color from the process on an individual impression, use \"color proofs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "progressive proofs"@en .

aat:300041328 a skos:Concept ;
    skos:definition "Impressions made from a printing surface or a die after the original edition or issue has been completed; refers especially to prints and to coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restrikes"@en .

aat:300041338 a skos:Concept ;
    skos:definition "Prints made using the process of intaglio printing, in which recessed areas of the plate or block have been cut or etched away in order to hold ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intaglio prints"@en .

aat:300041339 a skos:Concept ;
    skos:definition "Prints made by collagraph printing, using a printing surface created by gluing objects to a support; can be relief or intaglio, and is often a hybrid of the two in that ink can be held and printed from recesses or the surface of the matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collagraphs"@en .

aat:300041340 a skos:Concept ;
    skos:definition "Prints on paper incorporating impressions of a reverse design created on a printing plate, usually copper, into which the design has been incised (engraved) using burins or gravers. Historically, \"engravings\" has sometimes been incorrectly used to refer to all prints, regardless of the specific technique. For prints made from designs engraved on a flat wooden block, use \"wood cuts\"; for prints made from a plate that is etched rather than engraved, use \"etchings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engravings"@en .

aat:300041341 a skos:Concept ;
    skos:definition "Prints made from an engraving in a copper plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper engravings"@en .

aat:300041342 a skos:Concept ;
    skos:definition "Prints made from plates with designs created by using dots from punches of various shapes and sometimes including burin lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dotted prints"@en .

aat:300041352 a skos:Concept ;
    skos:definition "Prints made using the process of line engraving, which is the printing process that produces images in line and with little tonal quality because the slight burr produced by the engraving process is scraped away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line engravings"@en .

aat:300041356 a skos:Concept ;
    skos:definition "Prints made using the mezzotint process, in which the surface of the plate is methodically roughened with a rocker to produce a dark background; areas may then be lightened using various scrapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezzotints"@en .

aat:300041362 a skos:Concept ;
    skos:definition "Prints made by inking the incised plates of niellos before the application of the black inlay; associated especially with Renaissance Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niello prints"@en .

aat:300041363 a skos:Concept ;
    skos:definition "Prints made by the \"steel engraving (printing process),\" in which plates of steel or steel-faced copper are used, having replaced the use of less durable copper plates in the early 19th century. Steel engraving was introduced in 1792 by Jacob Perkins, an American inventor, originally for banknote printing. They are often distinguished by the use of engraving, etching, and the roulette. For documents produced in long runs with precise replication, use \"siderographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel engravings"@en .

aat:300041364 a skos:Concept ;
    skos:definition "Prints made using the process of stipple engraving, which is the printmaking process that achieves tonal areas by directly engraving short flicks or dots in combination with engraved or etched lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stipple engravings"@en .

aat:300041365 a skos:Concept ;
    skos:definition "Prints made from an etched printing plate, which is a metal plate on which a design is made by coating the plate with an acid-resistant substance, creating a design in the coating, and then exposing the plate to acid, which etches the plate where the metal is exposed. For designs incised directly into a copper plate using a burin or graver, use \"engravings (prints).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etchings"@en .

aat:300041366 a skos:Concept ;
    skos:definition "Prints produced from designs created by the aquatint process, by which a printing plate is covered with a coating and etched with acid so as to create a range of tonal values, often combined with line work. The resulting print resembling a watercolor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquatints"@en .

aat:300041368 a skos:Concept ;
    skos:definition "Aquatints made with a ground obtained by running a normally grounded plate through the press with fine sandpaper placed faced down on it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandpaper aquatints"@en .

aat:300041375 a skos:Concept ;
    skos:definition "Prints made using the process of relief etching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief etchings"@en .

aat:300041376 a skos:Concept ;
    skos:definition "Prints made using the process of soft-ground etching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft-ground etchings"@en .

aat:300041379 a skos:Concept ;
    skos:definition "Prints made using the process of lithography, which is a planographic printing process in which a design is deposited on the stone or plate with a greasy substance which will accept ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographs"@en .

aat:300041384 a skos:Concept ;
    skos:definition "Color lithographs produced commercially in the latter half of the 19th century and later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromolithographs"@en .

aat:300041386 a skos:Concept ;
    skos:definition "Chromolithographs printed with oil paint onto a textured surface and often coated with varnish; popular as inexpensive reproductions of oil paintings in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oleographs"@en .

aat:300041387 a skos:Concept ;
    skos:definition "Lithographs made using diluted tusche, giving the appearance of wash drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithotints"@en .

aat:300041391 a skos:Concept ;
    skos:definition "Prints made using a process of relief printing, in which the nonprinting areas of the block or plate are carved, engraved, or etched away, leaving the original plane surface raised so that ink is deposited and transferred to paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief prints"@en .

aat:300041392 a skos:Concept ;
    skos:definition "Relief prints made by inking pieces of cardboard that have been attached to a base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardboard relief prints"@en .

aat:300041393 a skos:Concept ;
    skos:definition "Prints made from a design cut in linoleum-faced blocks on which a knife or gouge has been used to recess the non-printing area and leave the image to be printed in relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linocuts"@en .

aat:300041396 a skos:Concept ;
    skos:definition "Relief prints taken from an engraved metal plate; made chiefly in the 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal cuts"@en .

aat:300041405 a skos:Concept ;
    skos:definition "Prints made using the process of woodcut, which is a relief process in which the design is cut into and printed from the plank side of a wood block; distinct from \"wood engraving (process),\" which is a relief process using the grain end of a wood block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodcuts"@en .

aat:300041410 a skos:Concept ;
    skos:definition "Color woodblock prints in which two or more blocks are printed one on top of the other, one or more being flat tonal blocks with limited chromatic range and a line block printed last. Early scholars distinguished two-block from multi-block prints by calling them \"camaïeu,\" that is, the ‘monochrome method,’ distinguishing them from \"chiaroscuro woodcuts,\" Current usage does not make this distinction, and the terms have been used interchangeably in various sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiaroscuro woodcuts"@en .

aat:300041414 a skos:Concept ;
    skos:definition "Prints made using the process of white line engraving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white line engravings"@en .

aat:300041424 a skos:Concept ;
    skos:definition "Images produced by processes that involve a photographic process (that is, employing light-sensitivity) to transfer an image, and then a separate process to produce the print, which was never itself light-sensitive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomechanical prints"@en .

aat:300041486 a skos:Concept ;
    skos:definition "Reproductions, usually of documents, originally made with the Photostat (TM) machine, later also produced on similar machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stats"@en .

aat:300041502 a skos:Concept ;
    skos:definition "Japanese prints on which the principal hand coloring was executed with beni, a red pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beni-e"@en .

aat:300041503 a skos:Concept ;
    skos:definition "Refers to the style of 15th-century Italian engraving that uses bold thick lines producing the effect of a pen drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Broad Manner"@en .

aat:300041506 a skos:Concept ;
    skos:definition "Refers to the style of Italian 15th-century engraving that uses fine close lines and some cross-hatching to produce an effect of tonal gradation similar to a wash drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fine Manner"@en .

aat:300041507 a skos:Concept ;
    skos:definition "Japanese multi-colored woodblock prints in which a separate block is carved for every color, and printed serially to create the final image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nishiki-e"@en .

aat:300041508 a skos:Concept ;
    skos:definition "Japanese prints, popular during the second half of the 17th century, colored by hand with an orange-colored red lead pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tan-e"@en .

aat:300041515 a skos:Concept ;
    skos:definition "Japanese prints in which colors, red (beni) and usually green, were printed rather than hand-colored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benizuri-e"@en .

aat:300041516 a skos:Concept ;
    skos:definition "Prints made from surfaces built up with liquid plastics on wood, metal, cardboard, or plastic supports. May be printed intaglio or relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellocuts"@en .

aat:300041519 a skos:Concept ;
    skos:definition "Refers to prints made by the process of crayon manner. Such prints imitate chalk drawings by means of the roulette."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crayon manner prints"@en .

aat:300041523 a skos:Concept ;
    skos:definition "Prints in which the image is formed largely by areas forced into relief by the hollows of the printing plate or blocks, usually without ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossed prints"@en .

aat:300041537 a skos:Concept ;
    skos:definition "Japanese prints in which the outline block is faintly printed in color, giving an effect of extreme delicacy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mizu-e"@en .

aat:300041538 a skos:Concept ;
    skos:definition "Unique prints made using the process of monotype, which consists of placing a painting of an image onto a plate and then laying a sheet of paper on top to create the print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monotypes"@en .

aat:300041540 a skos:Concept ;
    skos:definition "Prints, especially from the 15th century, made by impressing a plate onto paper coated with a paste, producing an embossed image; sometimes printed with ink, with tinted paste, or with gold leaf pressed into the paste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste prints"@en .

aat:300041550 a skos:Concept ;
    skos:definition "Japanese prints in which some areas are printed in black varnishlike ink, which remains glossy; other areas may then be hand-colored. So-named because the surface may resemble lacquer (urushi)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urushi-e"@en .

aat:300041555 a skos:Concept ;
    skos:definition "Japanese erotic prints and paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shunga"@en .

aat:300041559 a skos:Concept ;
    skos:definition "Prints made using the process of nature printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nature prints"@en .

aat:300041563 a skos:Concept ;
    skos:definition "Prints popular in the 18th and 19th centuries depicting such subjects as hunting, shooting, and racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sporting prints"@en .

aat:300041567 a skos:Concept ;
    skos:definition "Used to distinguish prints that are original creations, for example prints by Rembrandt or Dürer, from \"reproductive prints,\" which are intended to copy a painting or drawing for mass circulation. In other contexts, for prints produced with the intention of their being works of art, simply use \"prints.\" In the 1960s, the term \"original print\" was defined by the Print Council of America as those prints for which the artist alone had created the plate or other master image to print from, and that photomechanical processes were not be used. Modern printmaking techniques blur this artistic distinction, but the term is still used to make the distinction with 17th- to 19th-century reproductive prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "original prints"@en .

aat:300041569 a skos:Concept ;
    skos:definition "Prints created to serve as copies of a painting or drawing by another artist, particularly popular in 17th- to 19th-century Europe. The print is considered a reproductive print if the primary intention was to record artistic heritage, even if the personality of the printmaker has been asserted to a small extent. The term is usually reserved for prints that reproduce another two-dimensional art work; however, occasionally it is also used to refer to prints that portray sculpture or decorative arts, if the printmaker’s primary intention was to record the original art works for a mass audience. Prints depicting architecture are not considered reproductive prints. Prints in which another art work is incidentally depicted as part of a larger subject are not reproductive prints. Reproductive prints are valued because they map the dissemination, reception, and historiography of original works. They were popular in Europe from the 17th through early 19th century, and fell out of fashion with the invention of photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductive prints"@en .

aat:300041572 a skos:Concept ;
    skos:definition "Tools and equipment used for conducting an examination or inspection to achieve a comprehensive view, as of a place, a situation, or an area of study, or to ascertain condition or value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveying instruments"@en .

aat:300041573 a skos:Concept ;
    skos:definition "Devices for measuring and recording the passage of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timepieces"@en .

aat:300041575 a skos:Concept ;
    skos:definition "Instruments that measure and indicate the passage of time, especially by mechanical means producing a regularly recurring action and indicating, usually by hands or changing numbers, the hours and minutes; not designed to be worn or otherwise carried about on a person. For wearable timepieces, see \"watches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clocks"@en .

aat:300041578 a skos:Concept ;
    skos:definition "Clocks designed to rest on mantels, generally squat, heavy, and lacking handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantel clocks"@en .

aat:300041580 a skos:Concept ;
    skos:definition "Clocks with cases designed to sit on shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelf clocks"@en .

aat:300041582 a skos:Concept ;
    skos:definition "Clocks originating in the United States in the early 19th century, distinguished by slender turned pillars flanking the case between top and base and by a scrolled top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar and scroll clocks"@en .

aat:300041585 a skos:Concept ;
    skos:definition "Clocks of various designs, made to stand on tables. Known since the early 15th century, especially in Germany. Examples are spring-driven clocks in gilt metal cases of the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table clocks"@en .

aat:300041586 a skos:Concept ;
    skos:definition "Pendulum-driven floor clocks having cases about 6 feet high or larger, developed in England in the mid-17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tall case clocks"@en .

aat:300041590 a skos:Concept ;
    skos:definition "Scaled-down versions of tall case clocks, usually 2 to 5 feet high, with 8-day brass movements, and having pendulums; popular in the United States in the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarf tall clocks"@en .

aat:300041592 a skos:Concept ;
    skos:definition "Clocks designed to be mounted on walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall clocks"@en .

aat:300041595 a skos:Concept ;
    skos:definition "American pendulum wall clocks having a circular case for the dial, a narrow tapering body, and a boxlike base, resembling a banjo; design invented and patented by Simon Willard in 1802."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banjo clocks"@en .

aat:300041601 a skos:Concept ;
    skos:definition "Wall clocks first produced in the early 19th century in the United States that resemble banjo clocks but instead of having a rectangular lower frame are circular and are generally decorated with acanthus leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girandole clocks"@en .

aat:300041602 a skos:Concept ;
    skos:definition "Wall clocks elaborately carved and decorated, usually with floral motifs, that announce the hours by a sound like the call of the cuckoo; often with exposed weights and pendulum. Introduced in the mid-18th century in the Black Forest region, the earliest examples had wooden movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuckoo clocks"@en .

aat:300041603 a skos:Concept ;
    skos:definition "Small, spring-driven or pendulum, wood-cased clocks intended to be placed on a bracket on the wall, set on a mantel, or carried from room to room; the brackets were often designed to match the style of clocks; generally from the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracket clocks"@en .

aat:300041609 a skos:Concept ;
    skos:definition "Mechanical clocks run by a series of weights and wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight-driven clocks"@en .

aat:300041614 a skos:Concept ;
    skos:definition "Instruments that indicate approximate time of day from a shadow cast by a gnomon in sunlight onto a graduated surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sundials"@en .

aat:300041615 a skos:Concept ;
    skos:definition "Timepieces small and convenient enough to be carried about on a person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watches"@en .

aat:300041620 a skos:Concept ;
    skos:definition "Sound-producing apparatuses whose primary function is to play music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical instruments"@en .

aat:300041622 a skos:Concept ;
    skos:definition "Sound devices that produce their sound by using the air itself as the primary vibrating agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerophones"@en .

aat:300041639 a skos:Concept ;
    skos:definition "Aerophones that produce sound from air caused by vibrations made by the lips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lip-vibrated aerophones"@en .

aat:300041641 a skos:Concept ;
    skos:definition "Sound devices that produce their sound by means of vibrating strings stretched between fixed points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chordophones"@en .

aat:300041645 a skos:Concept ;
    skos:definition "Musical instruments that produce vibrations which must be passed through electrical circuits ending in loudspeakers before they are heard as sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrophones"@en .

aat:300041646 a skos:Concept ;
    skos:definition "Any instruments that yield sound by their own substance, being stiff and elastic enough to vibrate without requiring a stretched membrane or strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idiophones"@en .

aat:300041649 a skos:Concept ;
    skos:definition "Instruments in which elastic tongues or lamellae, fixed at one end, are vibrated either with the fingers or mechanically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plucked idiophones"@en .

aat:300041650 a skos:Concept ;
    skos:definition "Idiophones having a corrugated surface that is scraped by a nonsonorous object such as a stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrapers"@en .

aat:300041657 a skos:Concept ;
    skos:definition "Sound devices made to vibrate by being struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "struck idiophones"@en .

aat:300041659 a skos:Concept ;
    skos:definition "Idiophones that vibrate when directly struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "directly struck idiophones"@en .

aat:300041660 a skos:Concept ;
    skos:definition "Idiophones that produce sounds as the result of indirect actions, such as shaking or scraping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indirectly struck idiophones"@en .

aat:300041661 a skos:Concept ;
    skos:definition "Instruments in which sound is produced by vibration of a stretched membrane, brought about by striking, plucking, friction, or sound waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membranophones"@en .

aat:300041663 a skos:Concept ;
    skos:definition "Membranophones sounded by friction, accomplished directly by rubbing the drumhead with the hand or a piece of leather or cloth, or by means of a cord or stick which passes back and forth through one or two holes in the drumhead. In some types, the drumhead is vibrated indirectly by friction on a cord or stick in contact with, but not piercing, the drumhead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction drums"@en .

aat:300041667 a skos:Concept ;
    skos:definition "Drums in which the vibrations of a plucked string are transferred to a membrane, thus producing sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plucked drums"@en .

aat:300041668 a skos:Concept ;
    skos:definition "Membranes used in musical instruments and other sound devices to modify the sound made by that device or by the human voice; their vibrations color the tone with a buzzing nasal timbre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mirlitons"@en .

aat:300041669 a skos:Concept ;
    skos:definition "Drums that are played either by striking the membrane directly or by shaking membranophones that have objects inside them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "struck drums"@en .

aat:300041671 a skos:Concept ;
    skos:definition "Drums in which the membrane is struck by enclosed pellets, pebbles, or other small objects or by an attached outside pendant as they are shaken or twirled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rattle drums"@en .

aat:300041674 a skos:Concept ;
    skos:definition "Musical instruments which are played by means of a keyboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyboard instruments"@en .

aat:300041675 a skos:Concept ;
    skos:definition "Zitherlike instruments in the form of a rectangular box with a keyboard set in the long side. Strings, usually two per note, run from hitch pins on the left over a bridge to tuning pins at the right. Brass tangents on the rear portion of each key strike the strings from below to produce sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clavichords"@en .

aat:300041676 a skos:Concept ;
    skos:definition "Earlier of the two basic models of clavichord, in which each pair of strings serves several different keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fretted clavichords"@en .

aat:300041677 a skos:Concept ;
    skos:definition "Later model of clavichord in which each key is served by its own pair of strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unfretted clavichords"@en .

aat:300041678 a skos:Concept ;
    skos:definition "Zitherlike chordophones having a keyboard which operates a plucking mechanism to sound the strings; typically of an an elongated wing shape like a grand piano with strings that run parallel to the keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harpsichords"@en .

aat:300041683 a skos:Concept ;
    skos:definition "Trapezoidal or wing-shaped harpsichords with the strings running diagonally from left to right, at an oblique angle to the keyboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinets"@en .

aat:300041684 a skos:Concept ;
    skos:definition "Small harpsichords that are usually rectangular in shape, and having one keyboard and with the strings running at right angles to the keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virginals"@en .

aat:300041686 a skos:Concept ;
    skos:definition "Complex aerophones consisting of one or more rows of individual pipes which are made to sound by air under pressure directed from a wind-raising device and admitted to the pipes by means of valves operated from a keyboard or set of levers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organs"@en .

aat:300041688 a skos:Concept ;
    skos:definition "Mechanical pipe organs operated by a rotary handle, which both works the bellows to supply air, and turns a pinned cylinder which, as it is turned, raises keys which cause the sounding of the appropriate pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel organs"@en .

aat:300041690 a skos:Concept ;
    skos:definition "Small organs housed in a compact, furniture-quality wood cabinet, usually with one manual and no pedal keys, the wind being pumped into the pipes by the player's foot. Popular for domestic use in Europe and North America from the 17th to the 19th century, they were often made to resemble other pieces of furniture, such as tables, bureaus, and desks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber organs"@en .

aat:300041691 a skos:Concept ;
    skos:definition "Electronic keyboard instruments designed to imitate the tone of conventional pipe organs, and, like pipe organs, are able to sustain the tone indefinitely, play chords, and decrease or increase sustained tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic organs"@en .

aat:300041695 a skos:Concept ;
    skos:definition "Small portable organs furnished with flue pipes, carried by a strap around the player's neck or shoulder; the bellows were worked by the left hand and the keyboard by the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portative organs"@en .

aat:300041696 a skos:Concept ;
    skos:definition "Small organs with flue pipes, not portable by the player but capable of being moved from one position to another; one person played the keyboard with both hands while a second worked the bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "positive organs"@en .

aat:300041697 a skos:Concept ;
    skos:definition "Keyboard instruments whose sound is produced by freely vibrating reeds, activated by air either under pressure or suction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed organs"@en .

aat:300041699 a skos:Concept ;
    skos:definition "Small European reed organs activated by wind under pressure supplied by a compression bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmoniums"@en .

aat:300041700 a skos:Concept ;
    skos:definition "Rectangular bellows-operated accordions with button keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melodeons"@en .

aat:300041702 a skos:Concept ;
    skos:definition "Floor-standing reed organs with unusually wide reed tongues operated by air pressure, making them bulkier than the regular reed organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocalions"@en .

aat:300041703 a skos:Concept ;
    skos:definition "Small portable organs in which the sound is produced by one or more sets of beating reeds, supplied with air from a pair of bellows and played from a keyboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regals"@en .

aat:300041705 a skos:Concept ;
    skos:definition "The tubular parts of an organ within which the air vibrates to produce sound, made of metal or wood, existing in various sizes and shapes, and arranged in groupings called ranks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ pipes"@en .

aat:300041707 a skos:Concept ;
    skos:definition "Organ pipes sounded by the vibrations of a flexible metal reed. For the simple pipes, used as complete and independent sound devices by themselves, in which the sound is produced through vibration of a single, double, or free reed, use \"reedpipes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed pipes"@en .

aat:300041711 a skos:Concept ;
    skos:definition "Mechanical upright pianos devoid of a keyboard, operated by pinned cylinders set in motion by a crank, often mounted on wheels for playing in the streets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel pianos"@en .

aat:300041712 a skos:Concept ;
    skos:definition "Upright grand pianos with straight bass side, the treble side usually curving over to form a scroll at the tail, made from about 1798 to 1850."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giraffe pianos"@en .

aat:300041713 a skos:Concept ;
    skos:definition "Pianofortes having a horizontal wing-shaped case, with one bent or curved side and one straight side, and most of the strings running parallel to the individual keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand pianos"@en .

aat:300041714 a skos:Concept ;
    skos:definition "Grand pianos of the smallest size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby grand pianos"@en .

aat:300041716 a skos:Concept ;
    skos:definition "Pianos fitted with a device for automatic playing, most commonly a mechanism for playing perforated paper rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "player pianos"@en .

aat:300041719 a skos:Concept ;
    skos:definition "Pianos with a horizontal rectangular case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square pianos"@en .

aat:300041720 a skos:Concept ;
    skos:definition "Keyboard instruments outwardly resembling grand pianos but with a different, simpler action, involving tangents being pushed against the strings, rather than hammers striking them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tangentenflügels"@en .

aat:300041721 a skos:Concept ;
    skos:definition "Pianos with strings arranged in a vertical plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upright pianos"@en .

aat:300041722 a skos:Concept ;
    skos:definition "Lamellaphones originating in Africa, consisting of tuned metal or split-cane tongues fitted to a wood board or resonator, so that the tongues can vibrate freely at one end; they are played by depressing and releasing the free ends of the tongues with thumbs and forefingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumb pianos"@en .

aat:300041725 a skos:Concept ;
    skos:definition "Musical instruments in which the sound is produced automatically or mechanically, usually without a performer although some instruments involve a degree of human participation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical instruments"@en .

aat:300041726 a skos:Concept ;
    skos:definition "Instruments played either by shaking, or by striking either a membrane or a plate or bar of wood, metal, or other hard material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion instruments"@en .

aat:300041729 a skos:Concept ;
    skos:definition "Membranophones with a resonating cavity covered at one or both ends by a membrane, which is sounded by striking, rubbing, or plucking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drums"@en .

aat:300041732 a skos:Concept ;
    skos:definition "Large cylindrical drums, usually double-headed, with a rather shallow body, the diameter always being greater than the length. When played, each head faces sideways and is struck close to the rim with a padded stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bass drums"@en .

aat:300041738 a skos:Concept ;
    skos:definition "Single-headed bass drums with a very shallow shell, suspended by straps from a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gong drums"@en .

aat:300041741 a skos:Concept ;
    skos:definition "Drums with hemispherical or egg-shaped bodies and a single tensioned head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kettledrums"@en .

aat:300041755 a skos:Concept ;
    skos:definition "Double-headed cylindrical drums characterized by having several gut, nylon, wire, or wire-covered silk strings (snares) stretched across the lower head; the snares vibrate sympathetically with the lower head (to which vibration is transmitted from the upper, or batter, head by air vibrations inside the drum), causing a snappy, penetrating, relatively high-pitched sound. The use of snares on drums was known in ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snare drums"@en .

aat:300041758 a skos:Concept ;
    skos:definition "Small round shallow drums, usually with one or more snares, played in ensemble with tabor pipes; they are played with the right hand while suspended from the player's neck or left arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabors"@en .

aat:300041759 a skos:Concept ;
    skos:definition "Small single-headed frame drums of Near Eastern origin, consisting of a shallow ring, usually of wood, covered on one side with a stretched membrane of parchment, animal skin, or plastic, usually furnished with jingling metal discs or small bells called jingles placed in slots or otherwise attached around the circumference. It is played by shaking, striking with the knuckles, or drawing the fingers across the parchment. The earlier name for this instrument, as mentioned in translations of the Bible, was \"timbrel.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tambourines"@en .

aat:300041771 a skos:Concept ;
    skos:definition "Single-headed open frame drums of the Yoruba of Nigeria, having an earthenware frame and either sticks or bamboo pegs for adjusting tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sakaras"@en .

aat:300041773 a skos:Concept ;
    skos:definition "Snared double-headed cylindrical drums of the Yoruba people of Nigeria, used with clapperless bells to accompany song and dance at harvest thanksgiving ceremonies. For the usually single-headed Afro-Cuban drums, see \"bembés.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bembes"@en .

aat:300041783 a skos:Concept ;
    skos:definition "Sets of two or more double-headed vertical cylindrical drums tuned by tension rods, used in Western rhythm bands since the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tom-toms"@en .

aat:300041789 a skos:Concept ;
    skos:definition "Percussion instruments known primarily in Africa and New Guinea which employ water as a resonator. The African instruments consist of a half-gourd floating upside down on water within a larger vessel; the floating gourd is struck by spoons, sticks, or the hands. The New Guinea instruments have an hourglass-shaped hollow body open at both ends, sounded by being stamped against the surface of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water drums"@en .

aat:300041799 a skos:Concept ;
    skos:definition "Tubular drums with a constricted waist and lacings along its length which attach the drumheads to the body and control their tension. The player holds the drum under an armpit and presses it to affect the tuning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hourglass pressure drums"@en .

aat:300041810 a skos:Concept ;
    skos:definition "Southeast Asian metal gongs, usually bronze, with a deep, curved rim and a flat surface often ornamented, suspended by handles and struck with beaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kettle gongs"@en .

aat:300041822 a skos:Concept ;
    skos:definition "Single-headed drums in which the main section of the body is goblet-shaped or cylindrical and set upon a slender stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goblet drums"@en .

aat:300041824 a skos:Concept ;
    skos:definition "Drums in the form of an hourglass, with the diameter smaller at the middle than at each end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hourglass drums"@en .

aat:300041834 a skos:Concept ;
    skos:definition "Drums that are beaten in such a way that certain features of an unvocalized text can be recognized by a listener, these features acting as clues to the meaning of the words being drummed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talking drums"@en .

aat:300041837 a skos:Concept ;
    skos:definition "Percussion instruments originating in the United States in the 1950s, consisting of a set of small tunable drums, in which the drum heads are stretched across the top of an open bamboo stem or deep wooden shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boobams"@en .

aat:300041839 a skos:Concept ;
    skos:definition "Small single-headed drums, Afro-Cuban in origin, with conical or cylindrical hardwood shells; they generally occur in pairs joined together horizontally, one being larger in diameter than the other. Existing in tunable and nontunable versions, they are played with the bare hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bongos"@en .

aat:300041841 a skos:Concept ;
    skos:definition "Afro-Cuban drums having a long tapered or barrel-shaped shell up to about 90 cm deep and a single head about 25 to 30 cm in diameter, usually played with the hands; they are generally though not invariably played in pairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "congas"@en .

aat:300041843 a skos:Concept ;
    skos:definition "Friction drums of the Akan people of western Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etwies"@en .

aat:300041844 a skos:Concept ;
    skos:definition "Small single-headed drums with a shallow shell, played in sets, normally of seven. They are tuned by rotation on a fixed, threaded spindle, or by pedal mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roto-toms"@en .

aat:300041845 a skos:Concept ;
    skos:definition "Parts and components of drums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drum components"@en .

aat:300041846 a skos:Concept ;
    skos:definition "Membranes stretched over the frames or shells of drums and sounded by being rubbed, plucked, or, most commonly, struck with the hands or beaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drumheads"@en .

aat:300041856 a skos:Concept ;
    skos:definition "The bodies of tubular and vessel drums, acting as resonators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shells"@en .

aat:300041858 a skos:Concept ;
    skos:definition "Clusters of small bells or metal discs, usually referring to such bells arranged on a strap, loop of wire, or handle, and sounded by shaking or striking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jingles"@en .

aat:300041860 a skos:Concept ;
    skos:definition "Strings of gut, metal, or wire-covered silk stretched over that head of a drum which is not struck, tensioned so as to give a crisp, brilliant tone to the drum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snares"@en .

aat:300041868 a skos:Concept ;
    skos:definition "Orchestral percussion instruments, consisting of one or two metal bars mounted on a resonating frame; occasionally, they are actual blacksmiths' anvils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anvils"@en .

aat:300041872 a skos:Concept ;
    skos:definition "Percussion vessels consisting of a hollow object, usually of metal but in some cultures of hard clay, wood, or glass, which when struck emits a sound by the vibration of most of its mass; they are held in position at their vertex, the point farthest from their rim, and their zone of maximum vibration is towards the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bells"@en .

aat:300041874 a skos:Concept ;
    skos:definition "Suspended bells sounded by a swinging clapper attached inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clapper bells"@en .

aat:300041875 a skos:Concept ;
    skos:definition "Orchestral bells resembling the clapper bells hung around the necks of cows and other herd animals, but without a clapper, sounded by being struck with a drumstick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowbells"@en .

aat:300041882 a skos:Concept ;
    skos:definition "Boat- or trough-shaped clapperless iron bells of the Ewe of Ghana, played by being held in the palm of the hand and the lip struck with a metal rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atokes"@en .

aat:300041883 a skos:Concept ;
    skos:definition "Double clapperless iron bells of the Ewe of Ghana, held by a tine at the top and struck with a stick, often in pairs, to accompany dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gankoguis"@en .

aat:300041884 a skos:Concept ;
    skos:definition "Bells having a handle enabling it to be held in the hand for ringing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handbells"@en .

aat:300041885 a skos:Concept ;
    skos:definition "Bells sounded by one or more loose percussion pellets inside the bell cavity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pellet bells"@en .

aat:300041886 a skos:Concept ;
    skos:definition "Bells attached to a sleigh or to the harness of a horse pulling a sleigh. Use also for orchestral vessel rattles consisting of a set of pellet bells strung on a hoop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleigh bells"@en .

aat:300041887 a skos:Concept ;
    skos:definition "Sets of tuned metal tubes hung vertically in a frame and struck with hammers, commonly used for bell effects in the orchestra and on the operatic stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubular bells"@en .

aat:300041895 a skos:Concept ;
    skos:definition "Keyboard instruments having the form of a small upright piano in which metal plates (usually steel) suspended over resonating boxes are struck by hammers and sustained in a manner similar to piano action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celestas"@en .

aat:300041897 a skos:Concept ;
    skos:definition "Concussion vessels of great antiquity, occurring in many sizes and grades of sound throughout their history. Traditionally they have consisted of a pair of round metal plates, usually slightly convex to create a resonant hollow, sounded by striking together. In modern orchestral and jazz music, cymbals are often played as percussion instruments, suspended and struck with drumsticks or wire brushes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cymbals"@en .

aat:300041899 a skos:Concept ;
    skos:definition "Small metal cymbals, attached in pairs to a hinged fork or forked sticks that can be tuned to a definite pitch. They were known in ancient Egypt, Greece, and Rome and continue in use in present-day Myanmar (formerly Burma)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crotales"@en .

aat:300041903 a skos:Concept ;
    skos:definition "Idiophones invented in the 1920s consisting of a small flexible steel blade or lamella suspended in a wire frame ending in a handle. As the player waves the instrument, the blade is struck alternately on each side by wooden or rubber knobs on the end of wires fastened to the frame. For instruments whose sound is produced essentially by plucking lamellae, use \"lamellaphones.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flexatones"@en .

aat:300041904 a skos:Concept ;
    skos:definition "Metallophones consisting of a series of tuned steel bars arranged in rows and played with two knobbed beaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glockenspiels"@en .

aat:300041905 a skos:Concept ;
    skos:definition "Percussion instruments in the form of a very shallow circular metal vessel, of varying size, usually with a turned-down rim, either nearly flat or with a central boss. Sounded by being struck with a beater midway between center and edge, or on the boss when present; they vibrate most strongly at the center and weakest at the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gongs"@en .

aat:300041908 a skos:Concept ;
    skos:definition "Term of Malayan origin used for gongs played in Western orchestras and rhythm bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tam-tams"@en .

aat:300041911 a skos:Concept ;
    skos:definition "Percussion instruments consisting of a steel rod bent into the shape of a triangle open at one angle, and struck with a metal beater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triangles"@en .

aat:300041914 a skos:Concept ;
    skos:definition "Metallophones consisting of tuned, graduated metal bars arranged in two rows suspended from a metal frame with tubular resonators suspended below them; motor-driven spinning discs fixed above the open tops of the resonators produce the unique vibrato characteristic of the instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vibraphones"@en .

aat:300041917 a skos:Concept ;
    skos:definition "Concussion instruments consisting of a pair of small shallow cup-shaped pieces of hardwood, strung together, hollow sides facing each other, on a cord which loops around the player's thumb. The two pieces are clicked together by the fingers. Usually two pairs are played together, one higher-pitched than the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castanets"@en .

aat:300041921 a skos:Concept ;
    skos:definition "Cuban concussion idiophones consisting of two cylindrical hardwood sticks; one stick is held in one hand so that it crosses the cupped palm, which acts as a resonator, while the other stick, held in the other hand between the thumb and first two fingers, is used to strike the first."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claves"@en .

aat:300041922 a skos:Concept ;
    skos:definition "Latin American instruments consisting of a long gourd or similar tubular object with notches cut in its surface which are scraped with a stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "güiros"@en .

aat:300041926 a skos:Concept ;
    skos:definition "Brazilian scrapers, made of a bamboo tube with transverse notches, which the player scrapes with a small stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reco-recos"@en .

aat:300041927 a skos:Concept ;
    skos:definition "Wooden beams placed on the ground and drummed upon with sticks, distributed in Africa, Asia, Oceania, and Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion beams"@en .

aat:300041929 a skos:Concept ;
    skos:definition "Concussion idiophones consisting of sticks, usually used in pairs, played by being struck together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concussion sticks"@en .

aat:300041933 a skos:Concept ;
    skos:definition "Shaken idiophones made in a variety of forms worldwide, in which one or more objects strike against each other or against the inside or outside of another object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rattles"@en .

aat:300041943 a skos:Concept ;
    skos:definition "Gourd rattles of the Ewe of Ghana, made of a calabash covered with a mesh of string, beads, shells, and pieces of bamboo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axatses"@en .

aat:300041944 a skos:Concept ;
    skos:definition "Gourd vessel rattles of the Yoruba people of Nigeria, with external strikers consisting of a network of cowrie shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sekere"@en .

aat:300041945 a skos:Concept ;
    skos:definition "South and Central American gourd rattles, usually oval, with a natural handle, filled with dried seeds or pebbles, or imitations thereof in wood, clay, bakelite, or metal filled with beads, shot, or other rattling pieces. They are usually played in pairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maracas"@en .

aat:300041948 a skos:Concept ;
    skos:definition "Latin American rattles consisting of a natural or synthetic round or pear-shaped gourd covered with a network of beads and finishing in a short handle, sometimes also containing rattling pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabacas"@en .

aat:300041949 a skos:Concept ;
    skos:definition "Generic term for Brazilian shaken and struck rattles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocalhos"@en .

aat:300041950 a skos:Concept ;
    skos:definition "Rattles enclosing small objects that strike against each other or the walls of the rattles when they are shaken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vessel rattles"@en .

aat:300041957 a skos:Concept ;
    skos:definition "Rattles consisting of rattling objects strung on a bar or ring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stick rattles"@en .

aat:300041961 a skos:Concept ;
    skos:definition "Percussion idiophones made by cutting, burning, or gouging a slit in the wall of a hollowed-out piece of wood, used for musical or signaling purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slit drums"@en .

aat:300041967 a skos:Concept ;
    skos:definition "Tubes of wood or bamboo, often hollow, which are stamped rhythmically against the ground or another object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamping tubes"@en .

aat:300041968 a skos:Concept ;
    skos:definition "Stamping tubes made from gourds, played by the Ashanti women of Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adenkums"@en .

aat:300041969 a skos:Concept ;
    skos:definition "Stamping tubes of Nigeria and northern Africa, consisting of a gourd open at the top and bottom, played by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shantus"@en .

aat:300041970 a skos:Concept ;
    skos:definition "Woodblocks used in temple rituals in China, Japan, and Korea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temple blocks"@en .

aat:300041971 a skos:Concept ;
    skos:definition "Japanese Buddhist wood slit drums, shaped like a stylized fish or pair of fish, struck to mark important points in temple services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mokugyo"@en .

aat:300041972 a skos:Concept ;
    skos:definition "Clappers made of two slabs of wood hinged at one end and clicked together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slapsticks"@en .

aat:300041973 a skos:Concept ;
    skos:definition "Small wood slit drums, generally in the form of a rectangular block of hardwood with one or two long, hollowed-out slots, played by being struck on the surface or the edge above the slots with drumsticks or hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodblocks"@en .

aat:300041975 a skos:Concept ;
    skos:definition "Resonant wood blocks of Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merewas"@en .

aat:300041976 a skos:Concept ;
    skos:definition "Percussion instruments found worldwide in a variety of forms, consisting basically of a set of two or more tuned bars of wood, bamboo, or synthetic material, supported at two nodes of vibration and struck with sticks or hammers; resonators are often included, either for each individual key or for all keys as a set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xylophones"@en .

aat:300041985 a skos:Concept ;
    skos:definition "Xylophones consisting of large wood keys or slabs resting across banana tree trunks, or a combination of straw bundles and banana tree trunks, found in many parts of sub-Saharan Africa. Commonly from two to six players interlock different melodic patterns on a single instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log xylophones"@en .

aat:300041986 a skos:Concept ;
    skos:definition "Xylophones of the Ganda of Uganda, consisting of 17 (formerly 22) wood slabs set on two banana trunks and held in position by two shoulders carved on the underside of the slabs. They require up to six players and are traditionally associated with royalty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "akadindas"@en .

aat:300041987 a skos:Concept ;
    skos:definition "Xylophones of the Ganda of Uganda, consisting of twelve wood slabs placed across two banana trunks and separated by tall thin sticks driven into the stems; they are played by three players."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amadindas"@en .

aat:300041988 a skos:Concept ;
    skos:definition "Log xylophones of the Gwere of Uganda, with six slabs supplemented by a drum, placed on two banana stems and separated by sticks; the drum is played as though it were another slab."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entaalas"@en .

aat:300041989 a skos:Concept ;
    skos:definition "Xylophones of the Zande of the Congo, consisting of a variable number of hardwood slabs laid over two trunks of banana tree and kept in position by wedges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kponimbos"@en .

aat:300041990 a skos:Concept ;
    skos:definition "Xylophones consisting of wood slabs resting on ropes of straw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straw fiddles"@en .

aat:300041991 a skos:Concept ;
    skos:definition "Calabash-resonated wood xylophones of Africa, introduced into Latin America where they took on various local forms. Also the modern orchestral instrument developed from Latin American models, having metal tube resonators and a four-octave compass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marimbas"@en .

aat:300041994 a skos:Concept ;
    skos:definition "Sets of percussion plaques made of sonorous stone, taking the form of either horizontally arranged bars, or vertically suspended plaques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithophones"@en .

aat:300041995 a skos:Concept ;
    skos:definition "Slabs of rock that emit pitched tones when struck, sometimes giving varied pitches from different places on their surfaces, and that are used intentionally as percussive instruments. For similar stones found in the landscape, use 'ringing stones.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock gongs"@en .

aat:300041996 a skos:Concept ;
    skos:definition "Drums made of earhtenware pots, having a membrane tied across the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pot drums"@en .

aat:300042003 a skos:Concept ;
    skos:definition "Components of certain musical instruments, such as xylophones, musical bows, and lutes, which reinforce the tone by sympathetic vibration and impart much of its characteristic quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resonators"@en .

aat:300042011 a skos:Concept ;
    skos:definition "Russian plucked lutelike chordophones consisting of a triangular body with a flat back and slightly arched belly, a long neck with frets, and three strings; it is made in six different sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balalaikas"@en .

aat:300042013 a skos:Concept ;
    skos:definition "American plucked chordophones with a long, guitarlike fretted neck and a circular belly of tautly stretched skin, parchment, or plastic against which the bridge is pressed by the strings, varying in number from four to six in different models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banjos"@en .

aat:300042015 a skos:Concept ;
    skos:definition "European lutelike chordophones, popular in 17th-century Italy, having a very long, narrow neck with up to 24 movable frets, a small pear-shaped body, and two or three strings played with a plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colasciones"@en .

aat:300042016 a skos:Concept ;
    skos:definition "European Medieval plucked lutelike chordophones having a flat body, short neck and pegbox carved from a single piece of wood, with a bridge, one central or two lateral soundholes, frets, and usually four but sometimes three or five strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citoles"@en .

aat:300042020 a skos:Concept ;
    skos:definition "European wire-strung plucked lutelike chordophones played with a plectrum, very popular in the 16th and 17th centuries, having a wedge-shaped body with a curved bottom and straight shoulders narrowing towards the neck, and a low flat bridge held in position only by the strings it supports. Their most characteristic feature is a long, fretted neck which is half cut away from behind the fingerboard on the bass side, making a channel along which the player's left thumb can slide to facilitate very rapid shifts to and from high positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citterns"@en .

aat:300042022 a skos:Concept ;
    skos:definition "Large wire-strung citterns popular in the 17th century, with slanting bridge and frets, tuned like the lute and interchangeable with it in much of the music written for either."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orpharions"@en .

aat:300042025 a skos:Concept ;
    skos:definition "Plucked lutelike chordophones with built-up ribs, gently-waisted body, fretted neck, flat peg disc, rear or machine tuning pegs, frontal string holder combined with bridge, and large circular soundhole. Their size, form, and number of strings can vary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guitars"@en .

aat:300042031 a skos:Concept ;
    skos:definition "Electroacoustic stringed instruments more or less in the form of guitars, occurring in two types. One has a hollow body which functions somewhat like a resonator; the other has a solid body serving solely as a mounting block for the bridge and electronic apparatus, and to bear the strings. In both types the sound is electronically amplified and its tone modified by electronic controls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric guitars"@en .

aat:300042033 a skos:Concept ;
    skos:definition "Large eight-string guitar with a triangular body, invented in London in 1798 by Edward Light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harp guitars"@en .

aat:300042042 a skos:Concept ;
    skos:definition "Zitherlike plucked chordophones with metal strings raised above the fingerboard on a steel nut; the strings are stopped by the pressure of a steel bar held in the player's hand, which slides along the strings creating a wavering or glissando effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel guitars"@en .

aat:300042044 a skos:Concept ;
    skos:definition "English guitars fitted with plucking or striking devices, to eliminate finger plucking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyed guitars"@en .

aat:300042047 a skos:Concept ;
    skos:definition "Chordophones consisting of a resonator and a neck, between which a series of parallel strings are stretched vertically or diagonally in a plane perpendicular to the resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harps"@en .

aat:300042052 a skos:Concept ;
    skos:definition "Ambient sound makers with strings, usually tuned in unison, which are sounded by the natural wind blowing across them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeolian harps"@en .

aat:300042053 a skos:Concept ;
    skos:definition "Open harps in which the strings are at one end attached to a resonator and at the other to an onbuilt neck which curves over the resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arched harps"@en .

aat:300042058 a skos:Concept ;
    skos:definition "Arched harps of the Teso of Uganda and Kenya, with a very slim elongated body and five or six strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adeudeus"@en .

aat:300042059 a skos:Concept ;
    skos:definition "Large harps of the Fula and the Malinke people of Africa, with an arched neck, three strings, and a gourd resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolons"@en .

aat:300042060 a skos:Concept ;
    skos:definition "Five-string arched harps of the Masa people of central Chad, having a skin-covered soundbox and tuning pegs; played resting either on the ground or on the shoulder of the player."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dillis"@en .

aat:300042061 a skos:Concept ;
    skos:definition "Five-string arched harps of the Barma people of southern Chad, having tuning-pegs and small clapper bells attached to the bridge and soundbox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kindes"@en .

aat:300042062 a skos:Concept ;
    skos:definition "Arched harps of the Fang of Gabon, with a troughlike wood body and from four to eight strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wombis"@en .

aat:300042063 a skos:Concept ;
    skos:definition "Harps having a string for each semitone, and thus able to play a full chromatic range without the need for tuning devices such as pedals or hooks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromatic harps"@en .

aat:300042068 a skos:Concept ;
    skos:definition "Harps having three rows of strings, two parallel outer ranks tuned identically and an inner rank of chromatic notes set between them, first developed in 16th-century Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triple harps"@en .

aat:300042069 a skos:Concept ;
    skos:definition "Triple harps developed in Wales in the 17th century, having a slender forepillar of nearly two meters and a steeply curving neck, with a range normally of five octaves plus one note."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Welsh triple harps"@en .

aat:300042072 a skos:Concept ;
    skos:definition "Single-string musical bows consisting of a flexible stick stuck in the ground with a string stretching from its free end to a soundboard of bark, leaf, or similar material secured above a small pit in the ground which acts as a resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground bows"@en .

aat:300042077 a skos:Concept ;
    skos:definition "West African chordophones in which the plane of the strings is at right angles to a soundbox; the strings pass over a notched vertical bridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harp lutes"@en .

aat:300042083 a skos:Concept ;
    skos:definition "West African chordophones consisting of a stick or narrow board and a tall notched bridge over which the strings pass in a vertical alignment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harp zithers"@en .

aat:300042085 a skos:Concept ;
    skos:definition "Harp zithers of western central Africa, made of a stalk of raffia palm from the surface of which from three to five strings are detached and supported above the string bearer by a central, vertical, notched bridge; from one to six gourd resonators are attached to the back of the string bearer. They are played by plucking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mvet"@en .

aat:300042087 a skos:Concept ;
    skos:definition "Diatonic frame harps with a series of hooks set in the neck to permit the player to raise the pitch of each string by a semitone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hook harps"@en .

aat:300042092 a skos:Concept ;
    skos:definition "Historic harps of Ireland characterized by brass strings, an outward-curving forepillar, and a resonator hollowed from a single block of willow wood. The term is also used for small, gut-strung harps with a hand-operated device to alter the tuning, developed in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irish harps"@en .

aat:300042093 a skos:Concept ;
    skos:definition "Harps equipped with a pedal mechanism which changes the string tension and thus alters their pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedal harps"@en .

aat:300042097 a skos:Concept ;
    skos:definition "Harps equipped with a single-action pedal mechanism, used to raise the pitch of the strings by a semitone during performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-action harps"@en .

aat:300042098 a skos:Concept ;
    skos:definition "Harps equipped with a double-action pedal mechanism to raise the pitch of the strings by either a semitone or a whole tone during performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-action harps"@en .

aat:300042101 a skos:Concept ;
    skos:definition "Use specifically for plucked chordophones developed in the European Renaissance, having a large pear-shaped body composed of thin, narrow ribs, a flat top, central circular soundhole covered by a rose, and from seven to ten frets on the neck. For the general class of all chordophones with the plane of the strings running parallel to the resonator and a neck that serves both as string bearer and as handle, see \"lutelike chordophones.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lutes"@en .

aat:300042102 a skos:Concept ;
    skos:definition "Large lutelike instruments, popular in Europe from about 1590 to 1655, with six double courses of stopped strings over the fingerboard and eight unstopped bass strings, about twice the length of the stopped strings, to accomodate which the neck is greatly extended beyond the pegbox of the stopped strings. Its primary use was to accompany the solo singing voice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chitarrones"@en .

aat:300042103 a skos:Concept ;
    skos:definition "Five-string plucked lutelike chordophones of the Wolof people of Senegal and the Gambia, having a narrow boat-shaped soundbox and an unfretted cylindrical neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khalams"@en .

aat:300042104 a skos:Concept ;
    skos:definition "Two-string plucked lutelike chordophones of the Hausa people of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "komos"@en .

aat:300042105 a skos:Concept ;
    skos:definition "Plucked lutelike chordophones with a short neck and two strings of the Bisa people of Upper Volta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kondes"@en .

aat:300042106 a skos:Concept ;
    skos:definition "Small single-string plucked lutelike chordophones of the Songhai peoples of Niger and northern Nigeria, with a short neck and a soundbox made either of a half-calabash or of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuntigis"@en .

aat:300042107 a skos:Concept ;
    skos:definition "Mandolins of alto-tenor range, having from four to eight pairs of strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandores"@en .

aat:300042108 a skos:Concept ;
    skos:definition "Large, fretted lutelike chordophones of India, having a pear-shaped body made of a gourd or of hollowed-out wood, and a long hollow neck. They are important instruments in the Indo-Muslim style of Hindustani music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sitars"@en .

aat:300042111 a skos:Concept ;
    skos:definition "Long-necked lutelike chordophones having two pegboxes, one for the strings running along the fingerboard which were stopped by the fingers while played, and another positioned above and to the side of the first, for the long off-board strings which are not stopped when plucked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theorbos"@en .

aat:300042114 a skos:Concept ;
    skos:definition "Chordophones with strings attached to a yoke, consisting of two arms and a crossbar, that lies in the same plane as the soundbox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyres"@en .

aat:300042116 a skos:Concept ;
    skos:definition "Large, usually rectangular but occasionally round, box lyres of Ethiopia and the Sudan with ten strings tuned in pairs in octaves, played with a plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baganas"@en .

aat:300042119 a skos:Concept ;
    skos:definition "Lyres having a natural or man-made bowl for a resonator and a membrane belly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowl lyres"@en .

aat:300042120 a skos:Concept ;
    skos:definition "Lyres having a built-up wooden box serving as a resonator and a wooden soundboard, existing today primarily in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box lyres"@en .

aat:300042121 a skos:Concept ;
    skos:definition "Ancient Greek box lyres having a square, flat wooden box resonator, two thick, hollow arms connected at the top by a crossbar, and a variable number of gut strings of equal length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitharas"@en .

aat:300042124 a skos:Concept ;
    skos:definition "Five-string wishbone-shaped frame lyres of the Kipsigis people of Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kibugandets"@en .

aat:300042125 a skos:Concept ;
    skos:definition "Five-string bowl lyres of Egypt and the Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kissars"@en .

aat:300042126 a skos:Concept ;
    skos:definition "Six-string bowl lyres of Ethiopia with round or rectangular body, membrane belly, wooden arms, and crossbar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "krars"@en .

aat:300042128 a skos:Concept ;
    skos:definition "Seven-string bowl lyres of Kenya and Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litungus"@en .

aat:300042131 a skos:Concept ;
    skos:definition "Large plucked bowl lyres of East Africa, with a deep resonating bowl and eight strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obukanos"@en .

aat:300042135 a skos:Concept ;
    skos:definition "Family of plucked lutelike chordophones with a fingerboard, pegbox, and rounded body, which is either carved from a single block of wood merging smoothly into the neck and pegbox, or is built up in a lutelike construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandolins"@en .

aat:300042136 a skos:Concept ;
    skos:definition "Plucked zitherlike chordophones consisting of a raised wood soundboard or shallow soundbox with sound holes, with strings stretched parallel to the board or box and attached at either side by wood pegs or metal pins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psalteries"@en .

aat:300042138 a skos:Concept ;
    skos:definition "A zither is a musical instrument introduced into England and America ca. 1850 from Austria, and having thirty to forty strings let into the lower rim of a shallow wooden resonance-box. It bears fretted melody strings of metal, usually five in number and tuned by machine screws, and unfretted strings of gut or nylon, sometimes numbering thirty or more, tuned by metal wrist pins. It is played by striking with the fingers and thumb. In modifications of the instrument a fretted finger-board is fitted across a resonance-box shaped like a heart (bow zither) or like a viola (viola zither), and the instrument is played with a bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zithers"@en .

aat:300042143 a skos:Concept ;
    skos:definition "Chordophones of Uganda, made of several individual single-string zitherlike instruments of millet stalk; they are held in the player's open palm and plucked in an upward motion by the index finger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lidukus"@en .

aat:300042144 a skos:Concept ;
    skos:definition "Zitherlike chordophones of Benin, having four sets of three strings which are plucked with the thumbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobas"@en .

aat:300042147 a skos:Concept ;
    skos:definition "Zitherlike chordophones with a stick string bearer and a gourd resonator of the Malagasy Republic. Formerly played by male slaves, they are now made for tourist sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lokanga voatavos"@en .

aat:300042148 a skos:Concept ;
    skos:definition "Zitherlike chordophones of Madagascar, varying regionally in form. The most common type is of bamboo with from seven to twenty strings raised at both ends by small bridges; the strings, traditionally cut from the outer layer of the bamboo, are nowadays of metal. They are plucked with the fingers while held in an upright position. For similar chordophones from Timor, use \"sesandos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valihas"@en .

aat:300042158 a skos:Concept ;
    skos:definition "Zitherlike chordophones with a shallow soundbox, furnished with a series of button-controlled chord bars lying across the strings which damp all strings not required for the chord being played at the moment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autoharps"@en .

aat:300042159 a skos:Concept ;
    skos:definition "Wire-strung psalteries having from 14 to 24 triple or quadruple courses of strings strung on a triangular frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell harps"@en .

aat:300042163 a skos:Concept ;
    skos:definition "Zitherlike chordophones with a box resonator and multiple strings but no keyboard, played by being struck with light hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dulcimers"@en .

aat:300042166 a skos:Concept ;
    skos:definition "Folk instruments from the Appalachian region of the United States, usually consisting of a long figure-eight shaped box, a fretted fingerboard set centrally along its entire length, and from three to five metal strings tensioned by lateral pegs. For the American chordophones of similar construction, but struck with hammers instead of plucked, use \"hammer dulcimers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Appalachian dulcimers"@en .

aat:300042168 a skos:Concept ;
    skos:definition "Hungarian dulcimers consisting of a shallow trapezoidal box with from 20 to 35 courses of metal strings crossing two bridges, played while suspended from the player's neck by a strap or resting on four legs; popular in gypsy, folk, and nightclub bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cimbaloms"@en .

aat:300042175 a skos:Concept ;
    skos:definition "Fiddles combining qualities of the guitar and the violoncello, being smooth-waisted like a guitar, with a guitarlike tuning and fitted with 24 frets, but of the size of the violoncello and bowed in the same manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arpeggiones"@en .

aat:300042176 a skos:Concept ;
    skos:definition "Viols of bass range, similar to the bass viol but with ten or more additional wire strings that pass close to the belly and under the neck, which sound sympathetically and may also be plucked by the left thumb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barytons"@en .

aat:300042178 a skos:Concept ;
    skos:definition "Bowed or plucked box lyres of ancient Wales, surviving into the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crwths"@en .

aat:300042179 a skos:Concept ;
    skos:definition "Mechanically bowed portable chordophones having a set of melody and drone strings, a resin-coated wood wheel rotated by a crank to bow the strings, and a keyboard with tangents that bear on the melody strings when depressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hurdy-gurdies"@en .

aat:300042181 a skos:Concept ;
    skos:definition "Instruments consisting of a rectangular soundbox bearing one metal string, furnished with a projecting keyboard and terminating in a small oval body set on folding legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyed monochords"@en .

aat:300042183 a skos:Concept ;
    skos:definition "Hurdy-gurdies with organ pipework and bellows housed in their bodies, popular in France in the 18th century; players could activate either the strings or the pipes, or both together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organized hurdy-gurdies"@en .

aat:300042185 a skos:Concept ;
    skos:definition "Bowed lutelike chordophones of modern Greece, Bulgaria, and Dalmatia, having a pear-shaped body, wooden belly, peg disc with rear pegs, and three strings. They are played in a vertical position resting on the player's knees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liras"@en .

aat:300042187 a skos:Concept ;
    skos:definition "Italian Renaissance fiddles, having a body shaped like a violin, a wide fingerboard, relatively flat bridge, a leaf-shaped pegbox with frontal pegs, five melody strings on the fingerboard, and two off-board drone strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liras da braccio"@en .

aat:300042188 a skos:Concept ;
    skos:definition "Bass liras da braccio with from nine to fourteen strings, held between the player's legs; they were known primarily in France and Italy, from the mid-16th to the end of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liras da gamba"@en .

aat:300042193 a skos:Concept ;
    skos:definition "Single-string spike fiddles of the Savanna area of West Africa, consisting of a half-kalabash resonator covered with monitor lizard skin with a hole on one side, a straight or curved wooden neck running through the resonator, a V- or Y-shaped wooden bridge, and a horsehair string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goges"@en .

aat:300042198 a skos:Concept ;
    skos:definition "Spike fiddles of the Tuareg of North Africa, consisting of a large gourd body covered with goat skin, a skin handle, and a single horsehair string which passes over a bridge to a notch in the end of the handle; it can be either bowed or plucked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imzads"@en .

aat:300042199 a skos:Concept ;
    skos:definition "Ethiopian single-string bowed spike fiddles, having a tuning-peg, bridge, and parchment-covered diamond-shaped soundbox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masinko"@en .

aat:300042201 a skos:Concept ;
    skos:definition "Single-string spike fiddles of the Fula people of the Gambia, having a hemispherical wood resonator with one or two holes in the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nyaanyoorus"@en .

aat:300042202 a skos:Concept ;
    skos:definition "One-string spike fiddles with a tube-shaped resonator, usually of wood or animal horn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tube fiddles"@en .

aat:300042204 a skos:Concept ;
    skos:definition "African zitherlike chordophones made in several regions and with varying forms and playing methods, including bowing, plucking, and stroking the strings. Generally consisting of a long stick or bar with a knob at either end to which the strings are attached, three frets, a U-shaped bridge, and sometimes one or two half-calabash resonators at one end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zezes"@en .

aat:300042206 a skos:Concept ;
    skos:definition "Bowed spike fiddles of Senegal and Gambia, with a heart-shaped calabash body, membrane belly, and single string held taut by a tuning ring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ritis"@en .

aat:300042208 a skos:Concept ;
    skos:definition "Five-string pluriarcs of Gabon and western Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nsambis"@en .

aat:300042211 a skos:Concept ;
    skos:definition "Bowed lutelike chordophones of Europe, popular chiefly during the Middle Ages and Renaissance, having a pear-shaped body with a rounded back and short neck, made of a single piece of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebecs"@en .

aat:300042213 a skos:Concept ;
    skos:definition "Single-string zitherlike chordophones with a slender, three-sided body made of thin boards tapering to the top, and a unique bridge, one of the feet of which does not rest on the belly of the instrument but is suspended a hairsbreadth above it, so that it drums rapidly against it when played. Common from the 15th to the mid-18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trumpets marine"@en .

aat:300042215 a skos:Concept ;
    skos:definition "The soprano members of the violin family, having a hollow, resonating body with an incurved waist, arched top and back, and two F-shaped holes cut in the top, a neck terminating in a pegbox and scroll, a bridge, and four strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violins"@en .

aat:300042216 a skos:Concept ;
    skos:definition "Largest and lowest-pitched instruments of the violin family, having four, or more rarely, five strings, and varying considerably in size and shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double basses"@en .

aat:300042220 a skos:Concept ;
    skos:definition "Refers generally for all lutelike instruments having a soundbox and played with a bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiddles"@en .

aat:300042221 a skos:Concept ;
    skos:definition "Norwegian folk fiddles, shaped like the violin but with a more highly arched belly, having four melody and four or five sympathetic strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hardanger fiddles"@en .

aat:300042222 a skos:Concept ;
    skos:definition "Fiddles with a short neck and fingerboard, rosette and sound slits, long tailpiece, flat pegdisc with rear pegs, and three strings, played by the Wends of eastern Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huslas"@en .

aat:300042223 a skos:Concept ;
    skos:definition "Small, unfretted fiddles, generally with four strings, made in a great variety of shapes and played from the 16th century to the 19th."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kits"@en .

aat:300042225 a skos:Concept ;
    skos:definition "Alto members of the violin family tuned a fifth below the violin; it is structurally identical with the violin but of longer body and string length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violas"@en .

aat:300042226 a skos:Concept ;
    skos:definition "Chordophones with a viol-like body but unfretted, held and bowed like the viola; it has seven playing strings which pass over the top of the bridge and seven sympathetic strings which run through the bridge and under the fingerboard into separate pegs in the pegbox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violas d'amore"@en .

aat:300042233 a skos:Concept ;
    skos:definition "Fiddles having a hollow soundbox curving inwards at the waist like a violin but with a flat back, and frets on the fingerboard. They are played held downwards on the lap or between the legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viols"@en .

aat:300042240 a skos:Concept ;
    skos:definition "Violas d'amore made around 1780 by Thomas Perry of Dublin, with a body about the size of a viola d'amore and five pairs of metal strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sultanas"@en .

aat:300042241 a skos:Concept ;
    skos:definition "Small English violas da gamba, developed around the middle of the 17th century, used primarily for the performance of free ornamentation by way of varying given melodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "division viols"@en .

aat:300042242 a skos:Concept ;
    skos:definition "Small bass viols popular in 17th-century England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyra viols"@en .

aat:300042248 a skos:Concept ;
    skos:definition "Simple zitherlike chordophones found worldwide, consisting of a flexible stick curved by the tension of a string or, rarely, several strings, stretched between its ends, with or without a detachable resonator. Different types are plucked, struck, bowed, blown upon, or played by a combination of methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical bows"@en .

aat:300042249 a skos:Concept ;
    skos:definition "Musical bows held, while played, in or near the player's mouth, which acts as a resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouth bows"@en .

aat:300042251 a skos:Concept ;
    skos:definition "Braced mouth bows of the Shona of Zimbabwe, made from a single stick of wood and with the string looped to the bow at its center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chipendanis"@en .

aat:300042252 a skos:Concept ;
    skos:definition "Mouth bows of southern Africa sounded by the player inhaling and exhaling sharply on a flattened ostrich quill attached to the string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goras"@en .

aat:300042254 a skos:Concept ;
    skos:definition "Mouth bows of the Mbuti Pygmies of Uganda, with tuning loop but no resonator. The string is placed between the teeth and both sections are plucked with a short grass plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kabaromes"@en .

aat:300042255 a skos:Concept ;
    skos:definition "Zulu mouth bows consisting of a short, wide, flat bow and a single string of metal, gut, or fiber, which the player strikes with a steel wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samuius"@en .

aat:300042256 a skos:Concept ;
    skos:definition "Mouth bows of the southern Sotho of southern Africa, consisting of a thick straight stick with slender flexible ends notched at their extremities to hold a wire string; a loop of gut pulls the wire string towards the center portion of the bow, dividing it into two unequal sections yielding fundamentals a fourth apart. The string is plucked and stopped by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setolotolos"@en .

aat:300042258 a skos:Concept ;
    skos:definition "Upright double psalteries with a trapeziform box acting as a soundboard between two rows of strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arpanettas"@en .

aat:300042261 a skos:Concept ;
    skos:definition "Parts and components of chordophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chordophone components"@en .

aat:300042266 a skos:Concept ;
    skos:definition "Braced musical bows of Uganda having a half-calabash resonator; the resonator is placed against the player's chest and the string is struck with a blade of grass or thin stick bent in the form of a V."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egobolis"@en .

aat:300042268 a skos:Concept ;
    skos:definition "Musical bows of Madagascar, having a gourd resonator and a tuning noose, up to two meters long; they can be either plucked or struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jejo lavas"@en .

aat:300042269 a skos:Concept ;
    skos:definition "Unbraced gourd-resonated musical bows of southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ligubus"@en .

aat:300042270 a skos:Concept ;
    skos:definition "Braced gourd-resonated musical bows of the Zulu and Swazi peoples of southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umakweyanas"@en .

aat:300042272 a skos:Concept ;
    skos:definition "Large musical bows of the Yowabu of Benin, having a half-calabash resonator which rests on the player's chest. The single string is plucked with the right hand and stopped by a rectangular plaque held in the left hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiepores"@en .

aat:300042273 a skos:Concept ;
    skos:definition "Large unbraced musical bows of the Zulu of southern Africa with a gourd resonator attached near the lower end, and a single undivided string of twisted cow-tail hair, which the player strikes with a piece of thatching grass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ugubos"@en .

aat:300042274 a skos:Concept ;
    skos:definition "Traditional name used in the Western music tradition for instruments in which sound is produced by a vibrating column of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind instruments"@en .

aat:300042276 a skos:Concept ;
    skos:definition "Lip-vibrated aerophones made of brass or other metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brass instruments"@en .

aat:300042278 a skos:Concept ;
    skos:definition "Signal instruments of Europe, made of horn or wood, later imitated in metal, having a straight conical tube with a slight flare at the end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buccins"@en .

aat:300042281 a skos:Concept ;
    skos:definition "Most commonly keyless, valveless aerophones with a wide conical bore, usually though not always coiled, and a cup mouthpiece, now used chiefly for military and parade use. Early in the 19th century, the addition of keys and valves lent a full chromatic scale: for these instruments use \"keyed bugles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bugles"@en .

aat:300042292 a skos:Concept ;
    skos:definition "Conical, wide-bore soprano bugle-like instruments with side holes controlled by keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyed bugles"@en .

aat:300042293 a skos:Concept ;
    skos:definition "Very large keyed bugles made of metal, with a U-shaped tube of wide conical bore ending in a slightly flared bell and a cup mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ophicleides"@en .

aat:300042294 a skos:Concept ;
    skos:definition "Valve bugles introduced by Adolphe Sax of Paris in 1843 and patented by him in 1845, having a moderately conical bore and medium-sized bell; made in nine different sizes from sopranino to contrabass, they have retained their popularity as band instruments to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saxhorns"@en .

aat:300042298 a skos:Concept ;
    skos:definition "European brass valve trumpets of tenor pitch, invented in 1837, having a narrow bore and three valves; their primary use was in French and Italian military bands in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clavicors"@en .

aat:300042300 a skos:Concept ;
    skos:definition "Valved brass instruments, essentially tenor tubas, pitched in B flat with a nine foot range, with a wide conical bore, cup-shaped mouthpiece, and built in helicon, tuba, or trumpet form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "euphoniums"@en .

aat:300042309 a skos:Concept ;
    skos:definition "Valved brass instruments of the cornet family of alto range, usually pitched at E flat or F, having a conical bore and medium-sized bell; the tube, about 79 inches in length, can be coiled in tuba, orchestral trumpet, or helicon shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "althorns"@en .

aat:300042312 a skos:Concept ;
    skos:definition "English post horns, having a straight conical tube, usually of brass, sometimes of copper, with mountings of a different metal, a narrow bore, and a widely flared bell, played with a cup mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coach horns"@en .

aat:300042314 a skos:Concept ;
    skos:definition "Valved brass instruments of medium conical bore, played with a cup mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornets"@en .

aat:300042318 a skos:Concept ;
    skos:definition "Tenors of orchestral oboes, having a pear-shaped bell with a small opening and its double reed carried on a short metal bocal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English horns"@en .

aat:300042319 a skos:Concept ;
    skos:definition "Aerophones of conical bore with a widely flared bell, funnel-shaped mouthpiece, and slender tube which curves into wide circular coils; today it is furnished with valves, which are usually positioned to be played by the left hand while the right hand is placed in the bell for stopping. Commonly used in the brass section of Western-style orchestras as well as smaller ensembles and in solo work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French horns"@en .

aat:300042320 a skos:Concept ;
    skos:definition "Natural horns played with the player's hand in the bell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand horns"@en .

aat:300042323 a skos:Concept ;
    skos:definition "Valved brass instruments of conical bore in circular form, designed to replace the French horn in marching bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mellophones"@en .

aat:300042332 a skos:Concept ;
    skos:definition "Brass instruments of the cornet family, of alto pitch, shaped like a tuba, with medium-sized bell, three valves, and a cup mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenor horns"@en .

aat:300042333 a skos:Concept ;
    skos:definition "Aerophones of conical bore with three, sometimes four valves, of nine foot range and pitched in B flat, popular as brass band instruments. Similar to but smaller than euphoniums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baritones"@en .

aat:300042335 a skos:Concept ;
    skos:definition "Aerophones with a predominantly cylindrical bore and cup-shaped mouthpiece; most are characterized by a telescopic slide with which the player varies the length of the tube; common brass instruments in Western-style orchestras, jazz ensembles, and bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trombones"@en .

aat:300042339 a skos:Concept ;
    skos:definition "Generally, all lip-vibrated aerophones of predominantly cylindrical bore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trumpets"@en .

aat:300042346 a skos:Concept ;
    skos:definition "Trumpets of the Teso of Uganda, consisting of a straight wood tube with a bottle-shaped calabash bell; they are played by men in sets of three as accompaniment for dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asukusuks"@en .

aat:300042350 a skos:Concept ;
    skos:definition "Sets of five or seven ivory trumpets of the Ashanti and other peoples of southern Ghana. They are played at the court of paramount chiefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ntaheras"@en .

aat:300042354 a skos:Concept ;
    skos:definition "Tubular trumpets in which the mouthhole faces the axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end-blown trumpets"@en .

aat:300042355 a skos:Concept ;
    skos:definition "Exceptionally long metal trumpetlike aerophones of West Africa, of conical bore and made in two sections, used in ceremonial music and usually associated with kings and emirs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kakakis"@en .

aat:300042356 a skos:Concept ;
    skos:definition "Side-blown Ethiopian trumpets made of an elongated gourd or a long bamboo tube, with a copper bell attached by means of a length of curved horn so that it is perpendicular to the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malakats"@en .

aat:300042357 a skos:Concept ;
    skos:definition "Trumpet-like aerophones of conical bore and fitted with keys, usually five, first made in Vienna in 1801 and popular until the 1840s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyed trumpets"@en .

aat:300042361 a skos:Concept ;
    skos:definition "Trumpets in which the mouthhole is located on the side, as opposed to the end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side-blown trumpets"@en .

aat:300042366 a skos:Concept ;
    skos:definition "Valved brass aerophones with a wide conical bore terminating in a flared bell, played with a cup mouthpiece; they are used as the bass or contrabass members of band or orchestral brass sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubas"@en .

aat:300042369 a skos:Concept ;
    skos:definition "Large bass tubas built in circular form for convenience in carrying, first produced in Vienna in 1845."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helicons"@en .

aat:300042371 a skos:Concept ;
    skos:definition "Bass tubas with a widely flared, detachable bell and helicon shape, the tubing encircling the player, used mainly in marching bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sousaphones"@en .

aat:300042381 a skos:Concept ;
    skos:definition "Tubas in elliptical shape with a conical bore that widens steadily throughout its length, terminating in a small bell, and having four rotary valves and a French horn mouthpiece. They were originally made to the specifications of Richard Wagner for use in his opera cycle \"Der Ring des Nibelungen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wagner tubas"@en .

aat:300042389 a skos:Concept ;
    skos:definition "Valveless lip-vibrated aerophones of conical bore, made in many shapes, originally used as signal instruments during the hunt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting horns"@en .

aat:300042399 a skos:Concept ;
    skos:definition "Flared or bulbous terminals found on many open-ended aerophone tubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bells"@en .

aat:300042402 a skos:Concept ;
    skos:definition "Devices applied to aerophones, primarily to brass instruments, to alter their tube length by a fixed amount during play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valves"@en .

aat:300042403 a skos:Concept ;
    skos:definition "Traditional name for Western orchestral or concert flutes, recorders, clarinets, and oboes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodwind instruments"@en .

aat:300042405 a skos:Concept ;
    skos:definition "Composite reedpipes consisting of an air-tight skin, cloth, or rubber bag which serves as the air reservoir, one or more chanters with fingerholes on which the melody is played, and often one or more drone pipes which sound a continuous background to the melody. All sounding pipes have reeds and are attached to the bag by being inserted into tubular wooden stocks which are tied into openings in the bag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bagpipes"@en .

aat:300042406 a skos:Concept ;
    skos:definition "Small mouth-blown bagpipes of Brittany, with a sheepskin bag, drone pipe, and conical wide-bore chanter with seven fingerholes and double reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binious"@en .

aat:300042407 a skos:Concept ;
    skos:definition "German mouth-blown bagpipes with a single horn-belled chanter and a bass drone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bocks"@en .

aat:300042410 a skos:Concept ;
    skos:definition "Any of a group of pipes or sets of pipes, usually consisting of a single piece of wood with two narrow cylindrical bores each having an idioglot single reed, less often of two pipes inserted into a common stock which holds the reeds. Some terminate in bells or are attached to bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diples"@en .

aat:300042411 a skos:Concept ;
    skos:definition "Bellows-blown bagpipes of Hungary, Poland, the Ukraine, and Yugoslavia, with kidskin bag, a double melody pipe set in a stock carved to resemble a goat's head, and a bass drone pipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dudas"@en .

aat:300042414 a skos:Concept ;
    skos:definition "Small bagpipes of France, especially those of aristocratic design which achieved popularity among the French nobility in the 17th and early 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musettes"@en .

aat:300042420 a skos:Concept ;
    skos:definition "Single-reed bagpipes of eastern and southeastern Europe and Asia Minor, taking a variety of forms from one region or culture to another, with varying numbers of pipes and being blown either by mouth or bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gajdes"@en .

aat:300042421 a skos:Concept ;
    skos:definition "Mouth-blown bagpipes of Scotland, having a sheepskin bag, conical double-reed chanter, three drone pipes, and a blowpipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Highland pipes"@en .

aat:300042425 a skos:Concept ;
    skos:definition "Bellows-blown Scottish bagpipes with one chanter pipe and one bass and two tenor drone pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lowland pipes"@en .

aat:300042426 a skos:Concept ;
    skos:definition "Bellows-blown bagpipes of northern England, having a stopped chanter with seven keys and four drone pipes in a common stock, only three of which are played at one time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northumbrian pipes"@en .

aat:300042434 a skos:Concept ;
    skos:definition "Irish bellows-blown bagpipes, dating in their present form back to the 18th century, having a double-reed chanter, three single-reed drone pipes in one stock, and three or four keyed double-reed pipes for playing chords. The instruments are played sitting with the drones lying across the player's knees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uilleann pipes"@en .

aat:300042438 a skos:Concept ;
    skos:definition "Maltese mouth-blown bagpipes with a bag of animal skin, a blowpipe, a chanter, and two cane pipes with reeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zaqqs"@en .

aat:300042439 a skos:Concept ;
    skos:definition "Italian mouth-blown bagpipes with sheepskin bag, blowpipe, two conical chanters (for separate hands) and two drone pipes, all inserted into the same stock and all fitted with double reeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zampognas"@en .

aat:300042442 a skos:Concept ;
    skos:definition "Wood reedpipes with a double reed and a conical bore which doubles back upon itself like a hairpin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bassoons"@en .

aat:300042444 a skos:Concept ;
    skos:definition "Bassoons pitched below the regular bassoon, with the tube usually, though not always, bent back upon itself several times in order to reduce the overall length and bring the keys within convenient playing position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contrabassoons"@en .

aat:300042445 a skos:Concept ;
    skos:definition "Organs involving a set of graded whistles operated by steam or compressed air, played by means of a keyboard, pinned cylinder, or paper roll. Producing a great volume of sound, their typical use has been outdoors, such as at circuses, fairgrounds, and on steamboats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calliopes"@en .

aat:300042446 a skos:Concept ;
    skos:definition "Wooden clarinets having seven fingerholes, one thumbhole, and two diametrically opposed keys, and usually a foot joint like that of a recorder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalumeaux"@en .

aat:300042447 a skos:Concept ;
    skos:definition "Generally all reedpipes with single reed and essentially cylindrical bore. May also refer specifically to those reedpipes with single reed used as solo and orchestral instruments in Western jazz, classical, folk, and band music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clarinets"@en .

aat:300042475 a skos:Concept ;
    skos:definition "Late 18th-century European clarinets, having a globular or pear-shaped bell with a narrow opening, and sometimes a curved metal crook to carry the mouthpiece; may be curved, angular, or straight-bodied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clarinettes d'amour"@en .

aat:300042492 a skos:Concept ;
    skos:definition "Short cylindrical sections of aerophones which couple the mouthpiece to the rest of the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrels"@en .

aat:300042496 a skos:Concept ;
    skos:definition "Aerophone components, constituting sections of the body of the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joints"@en .

aat:300042500 a skos:Concept ;
    skos:definition "Components of aerophones which are placed in or against the player's mouth and which, together with the player's lips or the reed, form the tone generator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouthpieces"@en .

aat:300042501 a skos:Concept ;
    skos:definition "European lip-vibrated aerophones of conical bore, consisting of a long wooden or ivory tube, straight or gently curved, with fingerholes, and made in three main sizes: treble, small treble, and tenor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornetts"@en .

aat:300042505 a skos:Concept ;
    skos:definition "Reedpipes with double reed and cylindrical bore, with a wind cap covering the reed, a body curved at the lower end and slightly flared at the opening, one thumbhole, seven fingerholes, and one or more ventholes in the curved lower section; modern versions often have a key above the top fingerhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crumhorns"@en .

aat:300042508 a skos:Concept ;
    skos:definition "Small transverse flutes, historically of cylindrical bore and keyless, with six fingerholes; they have a sharp, shrill sound and are traditionally used in military music and signalling. In the 19th century a new model was developed, having a conical bore and a seventh fingerhole for E flat, often with a key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifes"@en .

aat:300042509 a skos:Concept ;
    skos:definition "Duct flutes similar to recorders but having fewer finger holes and, from the mid-18th century on, furnished with a slender ivory mouthpiece connected to a small chamber holding a sponge to absorb breath moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flageolets"@en .

aat:300042513 a skos:Concept ;
    skos:definition "Generally refers to any musical wind instrument consisting of a hollow cylinder or pipe of wood, metal, or another material, with holes along its length that are stopped by the fingers or by keys that are opened by the fingers. Although most flutes are tubular, some are globular (as with a gourd flute). A flute is sounded by a stream of air from the player's lips striking against the sharp edge of an opening, breaking the air up and vibrating within the enclosed space. The air may be blown in from an end or from the side, depending upon the type of flute. Many, but not all, modern flutes are equipped with the Boehm system of keywork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flutes"@en .

aat:300042517 a skos:Concept ;
    skos:definition "Flutes blown with breath from the nose rather than the mouth; widely distributed but particularly common in Southeast Asia and Oceania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nose flutes"@en .

aat:300042519 a skos:Concept ;
    skos:definition "End-blown flutes of the Teso and Karamojong areas of Uganda, cut off at a slanting angle at the bottom end and blown obliquely; there are two sizes, the longer having a hemispherical gourd bell attached at the lower end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alamorus"@en .

aat:300042524 a skos:Concept ;
    skos:definition "Flutes blown directly against the sharp rim at the upper open end of the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical flutes"@en .

aat:300042526 a skos:Concept ;
    skos:definition "Conical end-blown flutes made of wood, horn, clay, or gourd, common among the Nilotes of Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cone flutes"@en .

aat:300042539 a skos:Concept ;
    skos:definition "Use generally for reedpipes with double reed and conical bore. May also be used specifically for those reedpipes with double reed played in Western orchestral, chamber, and solo music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oboes"@en .

aat:300042540 a skos:Concept ;
    skos:definition "West African shawms having a pirouette, a long iron staple carrying the reed, five or six fingerholes, and a bell; the pipe and bell are made from a single piece of wood and covered with leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "algaitas"@en .

aat:300042543 a skos:Concept ;
    skos:definition "European alto oboes with a bulbous, pear-shaped bell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oboes d'amore"@en .

aat:300042545 a skos:Concept ;
    skos:definition "Globular vessel flutes made of clay, porcelain, wood, or plastic in oblong form with whistle head, eight fingerholes, and two thumbholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ocarinas"@en .

aat:300042547 a skos:Concept ;
    skos:definition "Single-reed aerophones with a conical bore, beaked mouthpiece, small metal bell, and 14 keys, sounding somewhat like a soprano saxophone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octavins"@en .

aat:300042548 a skos:Concept ;
    skos:definition "Multiple flutes consisting of a number of pipes of graduated lengths, joined together in the form of a raft or bundle. The pipes have no fingerholes or mouthpieces, and are blown across their tops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panpipes"@en .

aat:300042549 a skos:Concept ;
    skos:definition "Panpipes of the Soga of Uganda, made of from eight to thirteen stopped pipes of bamboo, elephant grass, or other material tied in raft form. They are played in ensemble, grouped in three pairs, usually accompanied by drums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obuleres"@en .

aat:300042550 a skos:Concept ;
    skos:definition "European Renaissance and Baroque reedpipes with double reed, consisting of a short cylindrical body in which a number of parallel cylindrical channels were bored up and down, connected alternately at top and bottom to form one long continuous tube. The double reed, partially enclosed by a pirouette, was inserted into the center channel at the top of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rackets"@en .

aat:300042551 a skos:Concept ;
    skos:definition "Family of fipple flutes that originated in Europe, traditionally made of wood, recently sometimes of plastic, with seven fingerholes and a thumb hole. Recorders may be made in several sizes, including the following: garklein, sopranino, Soprano, alto, voice flute, tenor, bass, great bass, contrabass, sub-great bass, and sub-contrabass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recorders"@en .

aat:300042558 a skos:Concept ;
    skos:definition "Simple pipes, used as complete and independent sound devices by themselves, in which the sound is produced through vibration of a single, double, or free reed; the pipes themselves may be made from reed, cane, wood, bone, or metal. For the organ pipes sounded by the vibration of a flexible metal reed, use \"reed pipes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reedpipes"@en .

aat:300042560 a skos:Concept ;
    skos:definition "Brass instruments of wide conical bore ending in a flare, played with a double reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarrusophones"@en .

aat:300042561 a skos:Concept ;
    skos:definition "Single-reed instruments, commonly of brass, with wide conical bore and slightly flared bell; built in several sizes from sopranino to contrabass, all but the two smallest are bent back in a U-form with the bell tilted forward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saxophones"@en .

aat:300042562 a skos:Concept ;
    skos:definition "Reedpipes with double reed, conical bore, and characteristically a pirouette, distributed worldwide. They were the precursors of the oboe in Europe, introduced there from the Near East in the 12th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shawms"@en .

aat:300042564 a skos:Concept ;
    skos:definition "Aerophones of tenor range, resembling small bassoons but with a single reed; known in the 19th century, they are now generally considered obsolete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenoroons"@en .

aat:300042570 a skos:Concept ;
    skos:definition "Aerophones consisting of a spatulate piece of wood, bone, stone, or similar material, tied to a string and sounded by being whirled through the air by the player holding the free end of the string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bull-roarers"@en .

aat:300042571 a skos:Concept ;
    skos:definition "Small free-reed instruments consisting of a grooved rectangular metal box on which free reeds are mounted, played by moving it back and forth in front of the player's mouth while inhaling or exhaling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmonicas"@en .

aat:300042572 a skos:Concept ;
    skos:definition "Sets of tuned glass vessels played by rubbing or, more rarely, striking, producing sounds like bowed stringed instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical glasses"@en .

aat:300042576 a skos:Concept ;
    skos:definition "Generic term for a type of mouth-resonated instrument consisting of a flexible tongue fixed at one end to a surrounding frame. The free end of the tongue is placed in front of the player's mouth cavity and is plucked with a finger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jew's harps"@en .

aat:300042577 a skos:Concept ;
    skos:definition "Instruments consisting of a tube of wood, metal or plastic, with a mirliton covering a lateral hole, played by being sung or hummed into."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kazoos"@en .

aat:300042578 a skos:Concept ;
    skos:definition "Automatic pipe organs imitating the sounds of the orchestra, employing organ pipes controlled by perforated cards, pinned cylinders, or paper rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchestrions"@en .

aat:300042579 a skos:Concept ;
    skos:definition "Electronic instruments made in a wide variety of models differing considerably in size, appearance, and manner of operation, though generally their output must pass through external amplifiers and loudspeakers to produce sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthesizers"@en .

aat:300042580 a skos:Concept ;
    skos:definition "Electronic instruments played by the performer's hand moving back and forth at different distances from an antenna rising vertically from the instrument; the pitch of the single tone produced varies with the distance of the hand from the antenna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theremins"@en .

aat:300042593 a skos:Concept ;
    skos:definition "Flexible sticks of wood, very rarely of metal or plastic, carrying stretched between the two ends a length of horsehair or other stringlike material which is used to brush against the strings of a chordophone, causing them to sound. Historically bows have been evenly curved, curved only at one end, or straight in the middle with both ends curved; modern Western bows typically have a concave curve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bows"@en .

aat:300042604 a skos:Concept ;
    skos:definition "Devices used on sound devices to soften the tone, usually decreasing the volume in the process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutes"@en .

aat:300042609 a skos:Concept ;
    skos:definition "Percussion beaters consisting of sticks with knobs or padded heads with which such instruments as xylophones, tubular bells, and certain types of dulcimers are struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammers"@en .

aat:300042611 a skos:Concept ;
    skos:definition "Hammers or sticks, plain or with heads, used to sound struck instruments such as drums, dulcimers, and percussion idiophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion beaters"@en .

aat:300042613 a skos:Concept ;
    skos:definition "Sticks, usually of wood, either padded with fabric or some other soft material on one end or plain, used to strike drums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drumsticks"@en .

aat:300042628 a skos:Concept ;
    skos:definition "Devices made of some stiff material, such as wood, metal, bone, ivory, shell, or quill, used for plucking the strings of a musical instrument; they may be held in the hand, worn around a finger, or form part of the action of certain keyboard instruments such as harpsichords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plectra"@en .

aat:300042641 a skos:Concept ;
    skos:definition "Long poles surmounted by a crescent and an ornament shaped like a Chinese hat from which bells and jingles and, usually, two horsehair tails are suspended, adopted by European military bands from the Turks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jingling Johnnies"@en .

aat:300042642 a skos:Concept ;
    skos:definition "Sliding rattles known in the Near East since the 3rd millennium BCE, consisting of a U- or lyre-shaped frame with a handle, fitted with loose-fitting rods or wires which jingle when shaken; small loose discs were often strung on the rods or wires to create additional sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sistra"@en .

aat:300042653 a skos:Concept ;
    skos:definition "Bowed friction idiophones, consisting of a circular flat wood resonator with a set of nails or iron pins of varying heights driven into its sides, which were sounded by being rubbed with a rosined bow. Sympathetic strings were added to some models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail violins"@en .

aat:300042659 a skos:Concept ;
    skos:definition "Mechanical musical instruments in which tuned steel prongs are made to vibrate by contact with moving parts driven by a clockwork mechanism, the whole contained in a box."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music boxes"@en .

aat:300042670 a skos:Concept ;
    skos:definition "Instruments shaped like a flute with one open bell-like end, the other being closed by an onion-skin membrane protected by a removable cap, played by being sung or hummed into."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onion flutes"@en .

aat:300042693 a skos:Concept ;
    skos:definition "Basque tabor pipes of slightly conical bore, with two front fingerholes and one rear thumbhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chûrulas"@en .

aat:300042694 a skos:Concept ;
    skos:definition "Short duct flutes with a cylindrical bore widely flared at the lower end, two fingerholes and one rear thumbhole, introduced by the blind Italian flutist Picco in London in 1856 and copied by London flute makers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picco pipes"@en .

aat:300042695 a skos:Concept ;
    skos:definition "Fipple flutes played in ensemble with the small drums called tabors, held and played by the left hand while the tabor is played by the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabor pipes"@en .

aat:300042706 a skos:Concept ;
    skos:definition "Short, usually high-pitched duct flutes having no fingerholes, or no more than one; the body may contain a captive pellet to add a roll to the sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whistles"@en .

aat:300042715 a skos:Concept ;
    skos:definition "Flutes consisting of two or more pipes which are blown simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiple flutes"@en .

aat:300042717 a skos:Concept ;
    skos:definition "Double-duct flutes of Yugoslavia, consisting of two slightly divergent pipes bored in one piece of wood, with a beak-shaped double mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dvojnices"@en .

aat:300042724 a skos:Concept ;
    skos:definition "Welsh hornpipes, known in Medieval times, consisting of a single or double cylindrical pipe with a beating reed, terminating in a cow horn bell and having a cow horn mouth bell protecting the reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pibgorns"@en .

aat:300042726 a skos:Concept ;
    skos:definition "Hornpipes of southern Scotland, with a tube of wood or bone, elongated wood mouthpiece, a bell of natural animal horn, and single reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock and horns"@en .

aat:300042753 a skos:Concept ;
    skos:definition "Simple end-blown aerophones of Scandinavia and the Baltic region, made of goat's horn, having three to five fingerholes and a mouthpiece carved integrally at one end of the horn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bukkehorns"@en .

aat:300042755 a skos:Concept ;
    skos:definition "Late serpents appearing around the early 19th century, consisting of a conical tube about 230 cm long, generally made of copper, with six fingerholes, three or four keys, a swan-neck crook, and terminating in a widely flared bell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bass horns"@en .

aat:300042757 a skos:Concept ;
    skos:definition "Treble cornetts having a conical mouthpiece turned in the wood tube of the instrument itself rather than detachable; the mouthpiece thus merges with the bore without a sharp break, causing a softening and veiling of the tone quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mute cornetts"@en .

aat:300042758 a skos:Concept ;
    skos:definition "European lip-vibrated aerophones of bass register, consisting of a serpentine wood tube about seven feet in length and of conical bore, with a long crook carrying a cup mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpents"@en .

aat:300042759 a skos:Concept ;
    skos:definition "Cornetts made of a single piece of wood, with conical bore, straight tube, and six fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight cornetts"@en .

aat:300042763 a skos:Concept ;
    skos:definition "Medieval end-blown ivory aerophones made from elephants' tusks, finely carved and prized by the wealthy classes mainly as tokens of land tenure or by churches as reliquaries, rather than as sound devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oliphants"@en .

aat:300042765 a skos:Concept ;
    skos:definition "Jewish ritual instruments dating from Biblical times, consisting of a natural ram's or ibex horn, traditionally with no mouthpiece but simply a hole bored in the narrow end of the horn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shofars"@en .

aat:300042769 a skos:Concept ;
    skos:definition "Wooden trumpets of cylindrical or conical bore, made of a young tree curving upwards naturally from the roots to form the bell, found in pastoral communities in the Alps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphorns"@en .

aat:300042770 a skos:Concept ;
    skos:definition "Curved Roman brass aerophones of conical bore, their range limted to a few notes of the natural scale and filling primarily a signalling function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buccinae"@en .

aat:300042772 a skos:Concept ;
    skos:definition "End-blown trumpetlike aerophones dating from the Nordic Bronze Age, consisting of a conical tube two to three meters in length curved into a twisted S-shape and terminating in a flat ornamental disc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lurs"@en .

aat:300042803 a skos:Concept ;
    skos:definition "Hooked bronze trumpets of the Etruscans and Romans, consisting of a slender tube with a cylindrical bore, terminating in an upturned bell. The term continued in use in postclassical times, meaning crumhorns or cornetts, though in the 18th century it denoted brass instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litui"@en .

aat:300042804 a skos:Concept ;
    skos:definition "Natural trumpets in elongated crescent shape, built in Europe in the early 19th century and designed to accommodate the hand-in-bell playing technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stopftrompeten"@en .

aat:300042815 a skos:Concept ;
    skos:definition "Ancient pneumatic organs in which water was used to control the wind pressure. They first developed in Greece in the 3rd century BCE and were in use throughout the Roman Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulises"@en .

aat:300042818 a skos:Concept ;
    skos:definition "Aerophones in which the sound is produced by metal or cane tongues which vibrate through a closely fitting frame, moving freely at one end and held down at the other; the pitch is determined by the length and mass of the tongue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free reeds"@en .

aat:300042819 a skos:Concept ;
    skos:definition "Portable reed organs consisting of an expandable bellows worked by the player's arm and a variable number of melody and bass keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accordions"@en .

aat:300042820 a skos:Concept ;
    skos:definition "Very small harmoniums in the shape of a large book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book harmoniums"@en .

aat:300042821 a skos:Concept ;
    skos:definition "Portable free-reed instruments having two hexagonal casings connected by an expandable bellows, each of which has a small button keyboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concertinas"@en .

aat:300042822 a skos:Concept ;
    skos:definition "Portable reed organs invented in Paris in 1837, shaped like a guitar, harp, or violoncello with a keyboard on the neck and a bellows operated by a handle at the other end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mélophones"@en .

aat:300042823 a skos:Concept ;
    skos:definition "Portable American reed organs in the form of a deep rectangular box held across the player's lap, with a keyboard of ivory buttons on the upper surface and a double bellows worked by one hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lap organs"@en .

aat:300042838 a skos:Concept ;
    skos:definition "Welsh harps, long recognized as the main national instrument. Occurring in a variety of shapes and dimensions throughout their history, they were initially single-strung, until the triple-strung form was adopted around 1700 and continues to the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telyns"@en .

aat:300042840 a skos:Concept ;
    skos:definition "Wooden lyres of northeastern Europe, in use from pre-Christian to Medieval times; they had two upright arms, hollowed out for part of their length, extending up from the soundbox to merge with a curved yoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rottes"@en .

aat:300042842 a skos:Concept ;
    skos:definition "Traditional Finnish plucked psalteries of irregular trapezoid shape, with two long sides that almost meet at the bottom and a diagonal upperside where the tuning pegs are inserted. Originally furnished with fine horsehair strings, they now may have up to thirteen metal strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kanteles"@en .

aat:300042845 a skos:Concept ;
    skos:definition "German plucked zitherlike chordophones with one to four melody strings and several drone strings stretched over a slender rectangular soundbox with frets fitted to its long left side and tapering to form a pegbox at the upper end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scheitholts"@en .

aat:300042849 a skos:Concept ;
    skos:definition "Type of late cittern very popular in England from about 1750 to 1810, having a flat or slightly convex back and six courses of metal strings, the bottom two being single-strung and the upper four double."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English guitars"@en .

aat:300042854 a skos:Concept ;
    skos:definition "Guitars of southern Italy, known from the 17th and 18th centuries, having a deep body, slightly arched back, rounded edges, slight waist, and central soundhole filled with an ornamental rose. The metal strings, usually arranged in five double or triple courses, pass over the bridge to pins at the base of the body, and are played with a plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chitarras battente"@en .

aat:300042858 a skos:Concept ;
    skos:definition "Guitars developed in late 18th-century France, in the form of a modified lyre with a fretted fingerboard between the two lyrelike curving arms and having from six to nine strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyre-guitars"@en .

aat:300042863 a skos:Concept ;
    skos:definition "Small mandores with a very narrow almond-shaped body, short fretted neck, sickle-shaped pegbox, central soundhole with rose, frontal string fastener, and gut strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pandurinas"@en .

aat:300042864 a skos:Concept ;
    skos:definition "Lyres of the Mediterranean and Persian Gulf regions, having a circular or bowl-shaped body from which protrude two skin-covered arms, forming two sides of an isosceles triangle whose base is a yoke from which five or six strings, usually of gut, extend to the lower part of the body, attached there to a metal ring which also serves as a bridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanburas"@en .

aat:300042868 a skos:Concept ;
    skos:definition "European instruments consisting of a rectangular soundbox bearing a variable number of strings which are struck, all at the same time, with a small stick; frequently played in conjunction with a one-hand flute by the same player."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tambourins à cordes"@en .

aat:300042871 a skos:Concept ;
    skos:definition "Bowl lyres of ancient Greece, having a tortoise-shell resonator (or its imitation in wood), skin belly, two carved arms projecting from the bowl and connected at the top by a crossbar, and a variable number of gut strings of equal length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyras"@en .

aat:300042901 a skos:Concept ;
    skos:definition "Upright harpsichords having a vertical soundboard and a complicated action, often involving springs, in which the jacks move horizontally rather than vertically to pluck the strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clavicytheria"@en .

aat:300042908 a skos:Concept ;
    skos:definition "Small portable pianos built in the shape of a harp lying on a box and having a compass of from two to four octaves; intended for outdoor performances, they could be suspended around the player's neck or set on the lap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orphicas"@en .

aat:300042909 a skos:Concept ;
    skos:definition "Zitherlike chordophones with keyboards whose strings are sounded by being struck with rebounding hammers controlled by the keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pianos"@en .

aat:300042934 a skos:Concept ;
    skos:definition "Overland self-propelled devices for conveying people, materials, or goods or designed for specific transportation operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motor vehicles"@en .

aat:300042940 a skos:Concept ;
    skos:definition "Vessels that can float and are constructed for travel or transport on the water, such as a boat, ship, or raft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watercraft"@en .

aat:300042946 a skos:Concept ;
    skos:definition "Rounded, cuplike, hollow parts of objects, such as the body of a stemmed vessel or the part of a pipe in which tobacco is burned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowls"@en .

aat:300042949 a skos:Concept ;
    skos:definition "Bowls with integral supports in the form of figures, ususally female, with up-raised arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caryatid vessels"@en .

aat:300042950 a skos:Concept ;
    skos:definition "Bowls designed with a cover that may be removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered bowls"@en .

aat:300042952 a skos:Concept ;
    skos:definition "Broad category of vessels with rounded profiles that are set upon an integrated supporting member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footed bowls"@en .

aat:300042957 a skos:Concept ;
    skos:definition "Wide, shallow, often decorative bowls meant for display on a side table or in a hallway, for example."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "console bowls"@en .

aat:300042958 a skos:Concept ;
    skos:definition "Small bowls, usually of glass, for holding water to rinse fingers at the table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger bowls"@en .

aat:300042959 a skos:Concept ;
    skos:definition "Term generally applied to any bowl used to serve or display real or artifical fruit. Prefer \"compotes\" for bowls, usually set on a high footed stem and sometimes having a cover, used to serve fruit, compotes, nuts, or sweets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit bowls"@en .

aat:300042962 a skos:Concept ;
    skos:definition "Small vessels used to serve heated milk and sops, or small pieces of bread, which were dipped into the bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk bowls"@en .

aat:300042963 a skos:Concept ;
    skos:definition "Boat-shaped vessels, usually of silver or pottery, with a long spout used for feeding liquids and soft foods to children and perhaps invalids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papboats"@en .

aat:300042964 a skos:Concept ;
    skos:definition "Small, shallow, flat-bottomed bowls or basins, often of earthenware, metal, or wood and typically having a single handle, used for soup, stews, or similar dishes. A traditional design uses one horizontal pierced handle flush with the rim. Sometimes made in pairs or sets and varying in size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porringers"@en .

aat:300042966 a skos:Concept ;
    skos:definition "Large bowls intended primarily for serving salad. Also, small bowls used for an individual portion of salad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salad bowls"@en .

aat:300042968 a skos:Concept ;
    skos:definition "Bowls into which the dregs, leaves, and grounds of teacups and coffee cups are emptied at the table; usually made as part of a tea or coffee service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slop bowls"@en .

aat:300042970 a skos:Concept ;
    skos:definition "Bowls intended primarily for serving an individual portion of soup; made with or without handles and sometimes accompanied by a saucer or cover or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soup bowls"@en .

aat:300042971 a skos:Concept ;
    skos:definition "Bowls of varying form but usually lidded, intended primarily for holding and serving sugar; made as an individual piece, to match a creamer, or as part of a tea or coffee service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar bowls"@en .

aat:300042972 a skos:Concept ;
    skos:definition "Bowls of varied shape and materials, used for serving wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine bowls"@en .

aat:300042973 a skos:Concept ;
    skos:definition "Any of various broad, relatively shallow, open vessels with a flat bottom, concave sides, and nearly level rim, sometimes having a cover; made of pottery, glass, metal, wood or another material and used especially for holding or serving food. In modern usage it is typically reserved for vessels at a dining table used for serving or holding food other than the round, flat or very shallow object used by the person dining, which is called a \"plate\"; however, formerly the plate was also called a \"dish.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dishes"@en .

aat:300042976 a skos:Concept ;
    skos:definition "Dishes for holding and serving butter at the table. Use \"butter chips\" for small dishes used by an individual diner to hold a pat or small serving of butter. Use \"butter coolers\" for vessels designed to serve chilled butter at the table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter dishes"@en .

aat:300042978 a skos:Concept ;
    skos:definition "Relatively long and narrow dishes with low vertical sides intended for serving stalks of celery. For vessels used to serve celery upright, use \"celery glasses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celery dishes"@en .

aat:300042979 a skos:Concept ;
    skos:definition "Containers for storing and serving cheese, generally consisting of a flat dish with a dome cover. Use \"cheeseboards\" for boardlike trays use for serving cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese dishes"@en .

aat:300042981 a skos:Concept ;
    skos:definition "Dishes intended primarily for serving vegetables, usually shallow and sometimes made with one or more interior dividers. May have a cover or feet or sometimes both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable dishes"@en .

aat:300042983 a skos:Concept ;
    skos:definition "Metal, earthenware, or plastic containers, generally for domestic use, that are usually broad, shallow and open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pans"@en .

aat:300042984 a skos:Concept ;
    skos:definition "Shallow, metal pans with a relatively long, single handle used for frying foods; sometimes made with a lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frying pans"@en .

aat:300042985 a skos:Concept ;
    skos:definition "Frying pans heated electrically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric frying pans"@en .

aat:300042986 a skos:Concept ;
    skos:definition "Shallow pans with sloping sides and a long handle intended primarily for use when cooking omelets; includes those with two hinged sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "omelet pans"@en .

aat:300042987 a skos:Concept ;
    skos:definition "Flat-bottomed, metal pans with a long, straight handle and a cover intended primarily for cooking. Also, pans with vertical, bulging, or ogee-shaped sides and often a pouring lip used, for example, for making sauces, melting butter, or the like; generally of brass or copper; sometimes of silver when intended primarily for use as a serving receptacle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saucepans"@en .

aat:300042990 a skos:Concept ;
    skos:definition "In the 17th and 18th centuries, cylindrical or curved culinary vessels with three or four feet or which sat on a tripod. Today, a term sometimes used for shallow, metal pans with a long handle used for frying foods; for these, prefer \"frying pans (cookware).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skillets"@en .

aat:300042991 a skos:Concept ;
    skos:definition "Shallow, usually circular dishes from which food is eaten."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plates"@en .

aat:300042999 a skos:Concept ;
    skos:definition "Plates for holding an individual portion of the main course of a meal; often circular, but sometimes oval, octagonal, or other form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinner plates"@en .

aat:300043000 a skos:Concept ;
    skos:definition "Platelike vessels from which cake and similar food is served."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake plates"@en .

aat:300043001 a skos:Concept ;
    skos:definition "Small plates, generally 3 to 4 inches in diameter, made in pressed glass and used to hold ceramic teacups while tea is being drunk from the saucer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup plates"@en .

aat:300043002 a skos:Concept ;
    skos:definition "Collector's term for a type of small plate made in pressed glass from the 1830s to the 1860s. They may have been used under a toddy glass or as a large saucer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toddy plates"@en .

aat:300043021 a skos:Concept ;
    skos:definition "Small vessels for serving prepared mustard that are made in various forms and usually of glass, ceramic, or metal (if of metal, often made with a glass liner). They usually have a cover or lid, which often has an indentation for the stem of a mustard spoon. Sometimes made in sets of three for three varieties of mustard. For small vessels used to dispense dry mustard, use \"mustard casters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustard pots"@en .

aat:300043022 a skos:Concept ;
    skos:definition "Covered vessels for brewing and serving tea, usually with one spout, which is often long and gracefully curved, and, on the opposite side of the vessel, one handle, and sometimes small feet. Distinguished from \"teakettles\" which usually have a short pouring spout, a bail handle, and a broad, flat bottom, and are used for heating water from which tea is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teapots"@en .

aat:300043027 a skos:Concept ;
    skos:definition "Small perforated containers used for sprinkling sugar, salt, mustard, or other spices, especially at the table. Casters may be of varying shape and material either made as one piece, with holes in the top and filled through a corked or otherwise plugged hole in the bottom, or made as two pieces, with a threaded stopper or screw cap. Casters of various types and for various purposes were historically made in a set, often fitting onto a tray and set upon a table during dining. Casters were often made for use with a specific spice, sugar, or salt, but the forms are often very similar or identical, so that attributing a particular caster to its intended use may be difficult."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casters"@en .

aat:300043029 a skos:Concept ;
    skos:definition "Vessels, usually of baluster or cylindrical shape and intended for serving dry, ground mustard flour; used especially for vessels that were historically part of a set of casters at table. A mustard caster may have a pierced, domed lid or it may be a blind caster, meaning the lid is not pierced or is blocked with an interior sleeve to prevent moisture in the air from causing the powdered mustard to clump. For vessels used to contain and serve prepared, wet mustard, usually having a cover or lid, use \"mustard pots.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustard casters"@en .

aat:300043030 a skos:Concept ;
    skos:definition "Casters intended primarily for serving ground pepper, particularly in historical and formal usage. Pepper casters are usually of baluster or cylindrical shape, often of silver, other precious material, or porcelain; they have a finely pierced domed cover which was sometimes screwed to the container. They were often part of a set of casters that was positioned upon a special tray at table. For similar items used to sprinkle pepper, but forming one of a set of only two with a saltshaker, particularly in modern usage and when made of more modest materials and intended for daily use in a household or restaurant, use \"pepper shakers\"; however, usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pepper casters"@en .

aat:300043031 a skos:Concept ;
    skos:definition "Casters intended primarily for serving table sugar, usually of baluster or cylindrical shape with a pierced domed cover, which was sometimes screwed to the container. Used especially for such vessels that were historically used as part of a set at table. For larger vessels used for sprinkling table sugar or powdered sugar in the kitchen, as opposed to at table, use \"sugar shakers.\" For larger vessels having a wide spout or opening used for pouring sugar, use \"sugar dispensers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar casters"@en .

aat:300043034 a skos:Concept ;
    skos:definition "Trays or small receptacles for holding two or more small bottles or other vessels for ceremonial liquids or for oil, vinegar, spices, mustard, other condiments at meals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruet stands"@en .

aat:300043035 a skos:Concept ;
    skos:definition "Vessels, usually with a handle and a stopper, used to serve condiments; generally of glass and often made in sets of two or more."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruets"@en .

aat:300043038 a skos:Concept ;
    skos:definition "A type of composite centerpiece, often tiered and quite elaborate, consisting of a metal frame with dishes, vases, or candleholders of silver, glass, or porcelain intended to hold fruits, flowers, candies or the like, and used for service or decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epergnes"@en .

aat:300043040 a skos:Concept ;
    skos:definition "Manufacturers' term used in the 19th century to describe a small bowl in any shape. Some nappies are covered, while others look like small compotes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nappies"@en .

aat:300043053 a skos:Concept ;
    skos:definition "Large, shallow dishes, usually oval and having a ledge and a well, used for carrying other dishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platters"@en .

aat:300043054 a skos:Concept ;
    skos:definition "Large platters, usually circular or oval, often earthenware or metal, used for serving meat. For other, circular or rectangular dishes, sometimes of wood, on which meat or other food is carved or served, use \"trenchers.\" For large plates set under dinner plates at table, use \"service plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chargers"@en .

aat:300043061 a skos:Concept ;
    skos:definition "Large bowls, usually made of silver, ceramic, or glass, in which a beverage, such as punch or lemonade, is prepared and served. They are frequently accompanied by a ladle and sometimes a set of punch cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch bowls"@en .

aat:300043062 a skos:Concept ;
    skos:definition "Containers for holding table salt; made in a great variety of forms, styles, sizes and materials. Whenever possible use a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salts"@en .

aat:300043063 a skos:Concept ;
    skos:definition "Tall, open vessels for holding salt for communal use at the table; usually supported by several feet or legs or by a spreading foot. For small, low vessels for holding table salt, use \"saltcellars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing salts"@en .

aat:300043064 a skos:Concept ;
    skos:definition "Type of saltcellar used to hold salt for individual use at the table and which rests on a flat base without legs or feet. They occur in many shapes with one, two or three wells for salt and are often made in sets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trencher salts"@en .

aat:300043065 a skos:Concept ;
    skos:definition "Flat, dishlike serving vessels, sometimes having a high stem, used for a variety of purposes, especially presentation of food or drink. For drinking vessels with a wide, shallow bowl, especially 16th-century examples, use \"tazzas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salvers"@en .

aat:300043069 a skos:Concept ;
    skos:definition "Covered boxes of varying shape intended primarily for holding and serving sugar; often made en suite with one or two tea caddies. Sometimes containing a sugar spoon for serving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar boxes"@en .

aat:300043071 a skos:Concept ;
    skos:definition "Open, variously shaped containers of wood, metal or other rigid material with a flat bottom and a low rim for holding, carrying, or exhibiting articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trays"@en .

aat:300043072 a skos:Concept ;
    skos:definition "Meal trays of a size and designed to fit across the lap of a person sitting in bed; often fitted with legs or supports at each end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed trays"@en .

aat:300043073 a skos:Concept ;
    skos:definition "Shallow receptacles used to serve bread at the table; often rectangular with upcurving sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread trays"@en .

aat:300043078 a skos:Concept ;
    skos:definition "Circular or rectangular flat dishes, generally made of wood, pottery or metal, on which meat or other food is carved or served. Early wooden examples often have a depressed area for food and a second smaller cavity for salt. Use \"chargers\" for large platters, usually circular or oval and often made of earthenware or metal, used for serving meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trenchers"@en .

aat:300043083 a skos:Concept ;
    skos:definition "Small, low utensils for supporting the blade of a knife at the dinner table, sometimes made a part of a flatware service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife rests"@en .

aat:300043084 a skos:Concept ;
    skos:definition "Cups or stands for holding loose matches or a box of matches vertical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "match holders"@en .

aat:300043085 a skos:Concept ;
    skos:definition "Rings or bands through which a folded napkin is inserted, often as part of a place setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napkin rings"@en .

aat:300043086 a skos:Concept ;
    skos:definition "Vessels having a perforated top for sprinkling ground pepper on food. Pepper shakers are made in a variety of forms and materials, including glass, ceramic, and metal. They are often paired with a saltshaker. Saltshakers and pepper shakers may be designed in whimsical forms that are considered collectibles. For similar objects for sprinkling pepper but made of precious materials and designed as part of a larger set of casters, particularly in historical or formal usage, use \"pepper casters.\" For devices used for storing and grinding peppercorns, use \"peppermills.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pepper shakers"@en .

aat:300043088 a skos:Concept ;
    skos:definition "Vessels having a perforated top for sprinkling table salt on food. Saltshakers are made in a variety of forms and materials, including glass, ceramic, and metal. They are often paired with a pepper shaker. Saltshakers and pepper shakers may be designed in whimsical forms that are considered collectibles. For similar objects for sprinkling salt but made of precious materials and designed as part of a larger set of casters, particularly in historical or formal usage, use \"salt casters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saltshakers"@en .

aat:300043089 a skos:Concept ;
    skos:definition "Vaselike forms, typically made of glass, which resemble celery glasses but which usually have a scalloped rim and are frequently made to match tableware patterns; intended to be used on the dining table to hold spoons. For similar vessels, typically of glass, also used on the dining table and intended to hold stalks of celery, use \"celery glasses.\" For vaselike forms made of glass, wood, or bone and intended to be placed near a fireplace or lighting device, use \"spill holders.\" For footed vessels in the center of which is a column with a pierced gallery for the suspension of spoons, use \"spoon stands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoon holders"@en .

aat:300043090 a skos:Concept ;
    skos:definition "Small, open containers of varying form used to hold or dispense toothpicks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothpick holders"@en .

aat:300043094 a skos:Concept ;
    skos:definition "Containers in which milk or cream is stirred, beaten, or agitated by a plunging or revolving dasher, or by shaking, in order to separate the oily globules from the liquid and thus obtain butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "churns"@en .

aat:300043096 a skos:Concept ;
    skos:definition "Utensils consisting of concave containers fitted with long handles intended primarily for lifting liquids, such as drinking water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dippers"@en .

aat:300043097 a skos:Concept ;
    skos:definition "Broad-bladed implements with flat blades, often pierced or engraved in decorative patterns, and long handles used for serving fish; sometimes accompanied by \"fish forks (serving utensils).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish slices"@en .

aat:300043099 a skos:Concept ;
    skos:definition "Articles of flatware having a handle with a shank terminating in two or more tines, used to manipulate food especially in serving and eating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forks"@en .

aat:300043104 a skos:Concept ;
    skos:definition "Forks used to hold meat and similar food as it is carved, generally having two long tines which may be slightly curved and which sometimes have at the base of the handle a projection on which to rest one's forefinger and thumb. May be accompanied by a carving knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carving forks"@en .

aat:300043105 a skos:Concept ;
    skos:definition "Large and often ornamented forks used for serving meats and cold cuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold-meat forks"@en .

aat:300043106 a skos:Concept ;
    skos:definition "Forks smaller than a dinner fork intended primarily for eating desserts; generally having a short handle and three or four, but sometimes two, tines. May be accompanied by a dessert spoon; sometimes a part of a dessert service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dessert forks"@en .

aat:300043109 a skos:Concept ;
    skos:definition "Forks having three to five tines, sometimes having outer tines that are wider and with a curved point. Generally used with a conforming fish knife in consuming an individual portion of fish. For large, broad four-tined forks used with a fish slice or with a serving knife to serve fish, use \" fish forks (serving utensils).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish forks"@en .

aat:300043112 a skos:Concept ;
    skos:definition "Forks used to spear a lemon slice or wedge, generally considered a serving utensil, but sometimes included with each place setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon forks"@en .

aat:300043114 a skos:Concept ;
    skos:definition "Forks having a small head and tines, used for eating oysters and similar shellfish, often slender with a long handle and three or four pointed tines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster forks"@en .

aat:300043115 a skos:Concept ;
    skos:definition "Small long-handled forks with three or four short tines used to serve pickles and similar foods. For similar forks usually having two tines, use \"olive forks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickle forks"@en .

aat:300043116 a skos:Concept ;
    skos:definition "Forks, smaller than a dinner fork, used for eating salad and generally having three or four tines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salad forks"@en .

aat:300043117 a skos:Concept ;
    skos:definition "Wide forks with short tines, often having between five and seven tines, used to serve sardines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sardine forks"@en .

aat:300043120 a skos:Concept ;
    skos:definition "Small knives with a wide but dull blade and often with a rounded tip used to cut or serve butter from a butter dish. For similar knives used as a place piece by an individual diner, use \"butter spreaders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter knives"@en .

aat:300043121 a skos:Concept ;
    skos:definition "Large knives with a long blade and a serrated or scalloped cutting edge. May be accompanied by a cake server. For knives similar in form but having smaller teeth set closer together, use \"bread knives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake knives"@en .

aat:300043122 a skos:Concept ;
    skos:definition "Large knives with a sharp, curved, and often pointed blade used to carve or slice meat and similar food. May be accompanied by a carving fork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carving knives"@en .

aat:300043123 a skos:Concept ;
    skos:definition "Knives smaller than a dinner knife intended for eating desserts; generally having a shorter handle and may have a curved and pointed blade; sometimes a part of a dessert service. Use \"fruit knives\" for knives with a sharp, sometimes serrated blade and often an ornamental handle used to pare and cut fruit at the table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dessert knives"@en .

aat:300043124 a skos:Concept ;
    skos:definition "Knives in a place setting that are designed and used for consuming the main meal, typically excluding dessert. For similar knives in a more formal setting, in which there may be a number of other knives of various design and for various purposes, use \"entrée knives\" for the knife intended for the main course."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table knives"@en .

aat:300043126 a skos:Concept ;
    skos:definition "Small knives with a flat blade, often decoratively shaped and lacking a sharp edge but having a sharp tip; designed to remove the backbone of the individual serving of fish and with a conforming fish fork to eat fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish knives"@en .

aat:300043127 a skos:Concept ;
    skos:definition "Small knives with a sharp, sometimes serrated, blade used to pare and cut fruit at the table. Often with an ornamental handle and sometimes with a folding blade such as on a penknife. For other small knives with a short handle and sometimes a curved and pointed blade, use \"dessert knives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit knives"@en .

aat:300043128 a skos:Concept ;
    skos:definition "Large knives with a broad blade of varying form used to cut and serve ice cream and similar frozen desserts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream knives"@en .

aat:300043130 a skos:Concept ;
    skos:definition "Sharp knives in a place setting that are intended primarily for cutting meat and similar foods; usually having a serrated steel blade and often a handle of wood, bone, or plastic.The steak knife in modern usage will typically take the place of the normal dinner knife, although it may appear in addition to a duller dinner knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steak knives"@en .

aat:300043133 a skos:Concept ;
    skos:definition "Small ladles intended primarily for serving cream; generally smaller than gravy ladles. Sometimes made en suite with a cream pail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream ladles"@en .

aat:300043136 a skos:Concept ;
    skos:definition "Large ladles intended primarily for conveying punch or other beverages from punch bowls to punch cups; similar to soup ladles but generally having a longer and narrower handle and a smaller, lipped bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch ladles"@en .

aat:300043149 a skos:Concept ;
    skos:definition "Utensils consisting of a shallow bowl with a handle used for preparing, cooking, serving, or eating food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoons"@en .

aat:300043155 a skos:Concept ;
    skos:definition "Spoons having a broad deep bowl, sometimes silver gilt and may be pierced or embossed with fruit motifs; used to serve berries and other juicy foods. Often made by altering plain tablespoons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berry spoons"@en .

aat:300043156 a skos:Concept ;
    skos:definition "Spoons having a round bowl used for scooping bonbons from a bowl. The bowl may be pierced, for use with bonbons in liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonbon spoons"@en .

aat:300043159 a skos:Concept ;
    skos:definition "Spoons intended for eating desserts, intermediate in size between a teaspoon and a tablespoon. May be accompanied by a dessert fork; sometimes a part of a dessert service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dessert spoons"@en .

aat:300043162 a skos:Concept ;
    skos:definition "Spoons similar in size to teaspoons but having a bowl that tapers to a point and often a serrated edge; used to eat sliced grapefruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grapefruit spoons"@en .

aat:300043163 a skos:Concept ;
    skos:definition "Small spoons intended primarily for serving prepared (wet) mustard from mustard pots; usually have an elongated bowl and a long, thin handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustard spoons"@en .

aat:300043165 a skos:Concept ;
    skos:definition "Spoons designed to serve soup, stews, or similar dishes from a porringer, which is a small bowl or basin, typically with a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porringer spoons"@en .

aat:300043166 a skos:Concept ;
    skos:definition "Spoons, generally having a pierced bowl, designed to serve olives. For spoons with pierced bowls and long, tapered, sharpened handles, used to serve tea, use \"mote spoons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive spoons"@en .

aat:300043167 a skos:Concept ;
    skos:definition "Miniature spoons intended primarily for serving salt from a saltcellar or dish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt spoons"@en .

aat:300043168 a skos:Concept ;
    skos:definition "Spoons intended primarily for serving food from a bowl, dish, or the like; sometimes made en suite with a serving fork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving spoons"@en .

aat:300043175 a skos:Concept ;
    skos:definition "Spoons with circular or oval bowls, used to consume soup and similar foods, especially when served from soup plates. For similar but smaller spoons with a rounded bowl and used to consume bouillon or clear soup, use \"bouillon spoons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soup spoons"@en .

aat:300043176 a skos:Concept ;
    skos:definition "Spoons intended primarily for serving granulated sugar from a sugar bowl or sugar box; similar to a teaspoon but having a larger bowl. The bowl may be in the form of a seashell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar spoons"@en .

aat:300043180 a skos:Concept ;
    skos:definition "Small spoons, with a capacity one third the size of a tablespoon, used for stirring tea, coffee, or the like served in cups or mugs and used as a standard unit of measurement in recipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teaspoons"@en .

aat:300043182 a skos:Concept ;
    skos:definition "Utensils with a long handle and sometimes a spoon end for stirring food and drink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stirrers"@en .

aat:300043186 a skos:Concept ;
    skos:definition "Any of various devices used for straining beer; in southern Africa they take the form of long basket-like strainers with a tubular form and narrow base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer strainers"@en .

aat:300043192 a skos:Concept ;
    skos:definition "Tongs used to serve pasta, especially spaghetti."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spaghetti tongs"@en .

aat:300043196 a skos:Concept ;
    skos:definition "Articles, collectively, that are generally used for serving food at the table, including various types of flatware, cutlery, hollowware, plates, and accessories, such as coasters and napkin rings, but not necessarily constituting a service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tableware"@en .

aat:300043198 a skos:Concept ;
    skos:definition "Refers to many varieties of relatively large drinking vessels without handles, cylindrical or conical in shape, with a flat base in the form of an open cup or goblet. Specifically, in archaeology refers to the tall wide-mouthed vessels produced by the Bell Beaker culture and found in certain early Bronze Age graves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beakers"@en .

aat:300043199 a skos:Concept ;
    skos:definition "Drinking vessels, usually in the form of a cylindrical cup but sometimes slightly tapering, having a flat base with a low foot ring and one vertical handle; especially those made of silver or pewter in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canns"@en .

aat:300043202 a skos:Concept ;
    skos:definition "Open bowl-shaped vessels, used chiefly for drinking, often having one handle, but sometimes two handles or none, generally on a low foot-ring; also includes similar bowl-shaped vessels, generally without handles, resting on a stem and supported by a spreading foot. Occasionally made with a lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cups"@en .

aat:300043204 a skos:Concept ;
    skos:definition "Cups of identical form which fit together, rim to rim, sometimes having, when joined, the appearance of a barrel, its staves bound with hoops of wire bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double cups"@en .

aat:300043209 a skos:Concept ;
    skos:definition "Cups having a guard behind the rim to protect the mustache while drinking; a 19th-century innovation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustache cups"@en .

aat:300043210 a skos:Concept ;
    skos:definition "Vessels, often made of silver and similar in form to tankards, having one or two handles and a spout and usually a lid with a finial. Used for feeding invalids and babies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spout cups"@en .

aat:300043213 a skos:Concept ;
    skos:definition "Small unspouted cups with two vertical handles and usually a cover with a finial used to drink caudle; especially popular in the late 17th and the 18th centuries and typically made of silver. Formerly known as posset pots or in England as porringers. For similar forms having a spout, use \"spout cups.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caudle cups"@en .

aat:300043215 a skos:Concept ;
    skos:definition "Refers to cups for chocolate beverages, no matter in which culture the cup originates. Examples in Europe are ceramic, usually relatively large, with two side handles, often a cover, and a saucer; popular in 17th-19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocolate cups"@en .

aat:300043216 a skos:Concept ;
    skos:definition "Cups, with one or two handles, or sometimes with none, intended primarily for drinking coffee; often accompanied by a saucer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee cups"@en .

aat:300043217 a skos:Concept ;
    skos:definition "Drinking glasses with a very short stem or no stem, used for cordials. Distinguished from cordial glasses, which have a long stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cordial cups"@en .

aat:300043219 a skos:Concept ;
    skos:definition "Small shallow cups, often holding approximately a dram of liquid (1/8 of an ounce), usually with two loop handles and often flat bottoms and slightly rounded sides, typically used for drinking distilled spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dram cups"@en .

aat:300043220 a skos:Concept ;
    skos:definition "Small, usually semi-ovoid cups with an often stemmed base, made in a variety of materials and used for serving individual boiled eggs in the shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggcups"@en .

aat:300043224 a skos:Concept ;
    skos:definition "Small cups intended for drinking punch or similar beverages served from a punch bowl, having a flat bottom or stemmed foot and usually a single handle. Generally made in sets accompanying and conforming to a punch bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch cups"@en .

aat:300043226 a skos:Concept ;
    skos:definition "Cups, usually accompanied by a saucer, intended primarily for drinking hot tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teacups"@en .

aat:300043229 a skos:Concept ;
    skos:definition "Drinking vessels made of horn, especially those elaborately mounted in bronze or silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking horns"@en .

aat:300043230 a skos:Concept ;
    skos:definition "Vessels intended for an individual to use for drinking wine, water, or other beverage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking glasses"@en .

aat:300043231 a skos:Concept ;
    skos:definition "Glasses intended for drinking ale or beer. Early 17th- and 18th-century examples are often similar in form to elongated wine glasses with ogee or rounded funnel bowls, resting on stems of varying length; bowl capacity is usually between three and five ounces. Modern examples are often in the form of tall, thin glasses, generally of 12-ounce capacity, which taper at the bottom and rest on solid bases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ale glasses"@en .

aat:300043232 a skos:Concept ;
    skos:definition "Tall slender glasses intended to be used for beer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilsners"@en .

aat:300043234 a skos:Concept ;
    skos:definition "Small drinking glasses for cocktails, with a foot, stem, and bowl, which varies in shape and size but is often funnel-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocktail glasses"@en .

aat:300043235 a skos:Concept ;
    skos:definition "Low drinking glasses having a short thick heavy stem and a heavy foot, and made with bowls of various shapes. They were used in private clubs, drinking societies, and at ceremonial occasions. So called from the custom of rapping the foot of the glass on the table which, in concert, sounded like gunfire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firing glasses"@en .

aat:300043236 a skos:Concept ;
    skos:definition "Drinking glasses with a large bowl, of various shapes, resting on a stemmed foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goblets"@en .

aat:300043239 a skos:Concept ;
    skos:definition "Short dessert glasses with a rudimentary stem or no stem intended for jellies or ices; often with a single or double handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jelly glasses"@en .

aat:300043240 a skos:Concept ;
    skos:definition "Glasses intended primarily for drinking juice, sometimes small drinking glasses in the form of a narrow tumbler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juice glasses"@en .

aat:300043242 a skos:Concept ;
    skos:definition "Small drinking glasses with tall stems and small bowls, generally having 1- to 1 1/2-ounce capacity, intended for drinking cordials, which were historically any of several alcoholic beverages considered medicinal. Typically, distinguished from \"liqueur glasses\" that have shorter stems. The beverages cordials and liqueurs over time have become synonyms, thus usage of the terms for glasses to serve them also overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cordial glasses"@en .

aat:300043243 a skos:Concept ;
    skos:definition "Type of late-18th- and early-19th-century English drinking glass having a capacious bowl which rests on a short stem. Early examples have ovoid bowls of fairly thin glass; later ones are much thicker, straight-sided and stand on heavy, sometimes square, feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rummers"@en .

aat:300043244 a skos:Concept ;
    skos:definition "Drinking glasses intended for water; also a term applied in 18th-century England to a glass of cylindrical form to distinguish it from a tumbler, which has an incurving base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water glasses"@en .

aat:300043246 a skos:Concept ;
    skos:definition "In a general sense, refers to all drinking glasses intended for wine, made in various shapes (usually stemmed), sizes, and styles; each is said to be most suitable for a particular type of wine. In a specific sense, the term refers only to glasses intended for use at table for wine to accompany the meal, and excluding champagne glasses and other specialty glasses. In this sense, in a matching set of stemware, the wine glass is smaller than a goblet for water, but larger than glasses for sherry, port wine, or liqueur. In such a set, there may be separate glasses of distinctive form for white and for red wine. For similar but smaller drinking glasses used for serving other beverages, use \"gin glasses\" or another specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine glasses"@en .

aat:300043247 a skos:Concept ;
    skos:definition "Glasses intended for drinking champagne and other sparkling wine, having either a shallow saucer-shaped bowl on a stemmed foot or flute-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "champagne glasses"@en .

aat:300043248 a skos:Concept ;
    skos:definition "Drinking vessels, often cylindrical, resting on a flat base without a stem and having a single handle and sometimes a lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mugs"@en .

aat:300043255 a skos:Concept ;
    skos:definition "Drinking vessels, usually cylindrical in form and having one handle and sometimes a hinged lid; to reference those intended specifically for beer, use the narrower concept \"beer steins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steins"@en .

aat:300043256 a skos:Concept ;
    skos:definition "Tall, one-handled drinking vessels, usually with a hinged lid and often a thumbpiece; generally made of silver or pewter, but sometimes made of glass. Tankards were formerly made of wooden staves and hooped; used chiefly for drinking beer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tankards"@en .

aat:300043257 a skos:Concept ;
    skos:definition "Drinking vessels without a stem, foot, or handle and traditionally having a rounded bottom; also includes similar forms with heavy, flattened bottoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumblers"@en .

aat:300044008 a skos:Concept ;
    skos:definition "Works made from the inner bark of the lime or linden, which is cut into strips and coarsely plaited. Examples include costume and decorations. The term is also applied to works made of similar flexible fibrous barks or similar materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bast work"@en .

aat:300044016 a skos:Concept ;
    skos:definition "Visual works made of the metal alloy brass, particularly sculptures, containers, and other decorative or utilitarian objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brasswork"@en .

aat:300044018 a skos:Concept ;
    skos:definition "Components of works or sometimes stand-alone works that are made of strips of cane, which is the long, hollow, pithy, jointed stem of certain plants, such as bamboo, rattan, sugarcane or certain palms. Examples of canework include furnishings, such as the woven seat of a chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canework"@en .

aat:300044025 a skos:Concept ;
    skos:definition "Visual works, including architecture, that are made of concrete, which is a hard, strong construction material comprising a mixture of sand, gravel, crushed rock that may be poured into molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete work"@en .

aat:300044027 a skos:Concept ;
    skos:definition "Visual works made of copper, particularly works of artistic merit or archaeological interest. Visual works that are made of copper but gilded may be included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copperwork"@en .

aat:300044032 a skos:Concept ;
    skos:definition "Visual works or parts of works, such as elements of costume, furnishings, ceremonial objects, or decorations, that are made of feathers. Generally the feathers are either adhered to a solid support or tied individually to a woven support. Important examples of featherwork are found in Mexico and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "featherwork"@en .

aat:300044039 a skos:Concept ;
    skos:definition "Visual works made primarily of felt, which is a dense textile constructed usually of wool and fur fibers that are held together by heat, moisture, and pressure without weaving or spinning. The term is usually reserved for artistic or decorative works having felt as the medium and support (if any); clothing made of felt is not called \"felt work.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felt work"@en .

aat:300044041 a skos:Concept ;
    skos:definition "Parts of works or complete visual works employing basketmaking that uses a type of plait having two canes or willows twisted together in the same direction, so as to enclose a crossing weft at each half-turn. Examples of fitched works include baskets and backs and seats of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fitched work"@en .

aat:300044045 a skos:Concept ;
    skos:definition "Visual works or parts of works made of the metal gold or of threads or another material covered in gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldwork"@en .

aat:300044053 a skos:Concept ;
    skos:definition "Decorative work made entirely or primarily of paper, such as decorative folding, stamping, scrapbooking, cardmaking, stenciling, or decorative punching or cutting, artificial flower making,etc., but excluding the fine arts of drawing and painting where paper is the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paperwork"@en .

aat:300044061 a skos:Concept ;
    skos:definition "Visual works or parts of works created using raffia, which is a strong, lightweight fiber from leafstalks of palms of the genus Raphia, most native to Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raffia work"@en .

aat:300044063 a skos:Concept ;
    skos:definition "Visual works or parts of visual works that are created from ribbons, which are strips of fine textile, such as silk, satin, or velvet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbonwork"@en .

aat:300044065 a skos:Concept ;
    skos:definition "Visual works, parts of visual works, or practical applications comprising complex and decorative working and tying of rope, which is a heavy cord formed by twisting or braiding fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ropework"@en .

aat:300044068 a skos:Concept ;
    skos:definition "Visual works or parts of works made from rush, which is material from the leaves and pithy or hollow stems of grasslike plants of the genus Juncus. Examples are seats of wooden chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rushwork"@en .

aat:300044071 a skos:Concept ;
    skos:definition "Costume, visual works, or other items made from plaited straw, which is the dried stalks of cereals or other grasses. Included are costume articles such as hats and bags, artificial flowers, and pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straw work"@en .

aat:300044074 a skos:Concept ;
    skos:definition "Visual works created with real or simulated flexible twigs, osiers, canes, or the like that are woven and plaited together. Examples of wickerwork are baskets and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wickerwork"@en .

aat:300044077 a skos:Concept ;
    skos:definition "Visual works made with wire, which is a filament or slender rod of drawn metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wirework"@en .

aat:300044085 a skos:Concept ;
    skos:definition "Oil-modified alkyds made with 30-45 percent added oil are called short-oil alkyds and are often used in baked enamel finishes on metal objects. Oil-modified alkyds with 56-70 percent added oil, called long-oil alkyds, are typically used in commercial paint formulations and varnishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil-modified alkyd"@en .

aat:300044188 a skos:Concept ;
    skos:definition "Digital databases of bibliographic records that form an organized collection of references to published literature such as journal and newspaper articles, conference proceedings, reports, government and legal publications, patents, books, etc. Records in bibliographic databases often contain abstracts, keywords, and subject classification terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliographic databases"@en .

aat:300044839 a skos:Concept ;
    skos:definition "Certified reports by election officers on the outcome vote in an election."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "election returns"@en .

aat:300045032 a skos:Concept ;
    skos:definition "Technical drawing leads for use on drafting film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic leads"@en .

aat:300045075 a skos:Concept ;
    skos:definition "Reports summarizing the financial condition of an organization on any date or for any period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "financial statements"@en .

aat:300045309 a skos:Concept ;
    skos:definition "Visible, functional hardware that has a finished appearance and is often treated as part of the decorative scheme on objects such as furniture, architecture, and book bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finish hardware"@en .

aat:300045319 a skos:Concept ;
    skos:definition "Hardware that is used in the construction of buildings and other structures, such as screws, nuts, and bolts, and that is generally meant to be concealed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough hardware"@en .

aat:300045357 a skos:Concept ;
    skos:definition "Long, square spikes used in heavy timber construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barge spikes"@en .

aat:300045363 a skos:Concept ;
    skos:definition "Locks designed and constructed with the front and strike protected, thus preventing the latchbolt from being tampered with through the crevice between the door and the jamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guarded front locks"@en .

aat:300045364 a skos:Concept ;
    skos:definition "Mortise locks each having a front turned into two perpendicular planes, used on a door with a rabbeted edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-rabbeted locks"@en .

aat:300045365 a skos:Concept ;
    skos:definition "Devices permanently secured to the hasp on a door which causes the hasp to be locked as soon as the door is closed; often used in prisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hasp locks"@en .

aat:300045367 a skos:Concept ;
    skos:definition "Master-keyed locks, often with a latch bolt and one or two dead bolts, designed for use by both a guest in a rented room and for a maid’s use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hotel locks"@en .

aat:300045369 a skos:Concept ;
    skos:definition "Automatic locks actuated by the closing of the door; also, time locks working on the same principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instant locks"@en .

aat:300045374 a skos:Concept ;
    skos:definition "Items, usually of metal, used to assemble, join, or manipulate components of furniture. This may include objects such as hinges and knobs, or otherwise purely decorative applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture hardware"@en .

aat:300045375 a skos:Concept ;
    skos:definition "Various items used to furnish doors functionally including kick plates, garment hooks, roller latches, bolts, stops, numbers, and letterbox plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door hardware"@en .

aat:300045377 a skos:Concept ;
    skos:definition "Wood joints of various types that are not locked or housed, but for which the edges of two members meet in various configurations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simple joints"@en .

aat:300045380 a skos:Concept ;
    skos:definition "Square joints between two members at right angles to each other. The contact surface of the outstanding member is cut square and fits flush to the surface of the other member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butt joints"@en .

aat:300045382 a skos:Concept ;
    skos:definition "Joints formed by two boards with beveled edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miter joints"@en .

aat:300045386 a skos:Concept ;
    skos:definition "Joints made by fitting a projecting rib on one piece into a groove in another. If the pieces are metal, the joint may also be welded. For plastic or wood pieces, the joint may be glued."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tongue-and-groove joints"@en .

aat:300045389 a skos:Concept ;
    skos:definition "Joints formed by two boards with curved edges; favored for dropleaf tables because they minimize the gap between a table top and its leaf in the closed position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rule joints"@en .

aat:300045391 a skos:Concept ;
    skos:definition "In construction, joints in which two building elements are not butted up against each other, but are overlapped, part of one covering part of the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lap joints"@en .

aat:300045395 a skos:Concept ;
    skos:definition "In carpentry, joints formed by fitting together two pieces of timber, at least one of which has been rabbeted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbet joints"@en .

aat:300045397 a skos:Concept ;
    skos:definition "Wood joints in which the ends or edges of both members are milled with matching rabbets and combined at right angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double rabbet joints"@en .

aat:300045399 a skos:Concept ;
    skos:definition "Joints formed where the full thickness of one member's edge or end is accepted into a corresponding housing, groove, or dado in another member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housed joints"@en .

aat:300045402 a skos:Concept ;
    skos:definition "Wood joints of various types that are held securely in place through the shape of the lock, having one or more pieces that join to corresponding pieces in the opposite member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locking joints"@en .

aat:300045404 a skos:Concept ;
    skos:definition "Joints made when connecting two pieces of wood where a projecting tongue (tenon) of one piece is made to fit into the corresponding cutout (mortise) in the other piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortise-and-tenon joints"@en .

aat:300045409 a skos:Concept ;
    skos:definition "In carpentry, mortise-and-tenon joints where the projecting tongue (tenon) of one piece is round in cross-section, made to fit into the corresponding round cutout (mortise) in the other piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round mortise-and-tenon joints"@en .

aat:300045411 a skos:Concept ;
    skos:definition "In carpentry, joints created by fitting, usually at right angles, the end of a piece of wood into a groove cut across the width of another piece to a depth of half its thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dado joints"@en .

aat:300045416 a skos:Concept ;
    skos:definition "In carpentry, a dovetail joint having horizontal ledges or shoulders at its base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shouldered dovetail joints"@en .

aat:300045417 a skos:Concept ;
    skos:definition "Dovetail joints in wood, designed so that interlocking pins and tails are concealed within the edge of the wood member and not visible when the two members are joined; often used with fine woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind dovetail joints"@en .

aat:300045475 a skos:Concept ;
    skos:definition "Metal protective grilles, often of elaborate, decorative character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window guards"@en .

aat:300045477 a skos:Concept ;
    skos:definition "Pens or shelters for sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheepfolds"@en .

aat:300045482 a skos:Concept ;
    skos:definition "Indoor enclosures for horseback riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding halls"@en .

aat:300045485 a skos:Concept ;
    skos:definition "One of a number of small, individually housed units in a motel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourist cabins"@en .

aat:300045490 a skos:Concept ;
    skos:definition "Farm complexes, including living quarters and outbuildings, belonging to a monastery or a feudal lord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granges"@en .

aat:300045498 a skos:Concept ;
    skos:definition "Refers to enclosed, oval, circular, or rectangular spaces designed and equipped for horseback riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding rings"@en .

aat:300045501 a skos:Concept ;
    skos:definition "Copies, usually of technical drawings, made by a light-sensitive process that produced blue lines on a green ground; produced in small numbers around 1900."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green prints"@en .

aat:300045514 a skos:Concept ;
    skos:definition "A dense, black, semiprecious form of lignite that takes a brilliant polish and is used ornamentally, particularly in Victorian mourning jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jet"@en .

aat:300045517 a skos:Concept ;
    skos:definition "Refers to glass blown with double walls and sealed after silvering of the enclosed surfaces; used to produce ornamental wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silvered glass"@en .

aat:300045533 a skos:Concept ;
    skos:definition "Native round huts of southern Africa, usually built of mud and thatch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rondavels"@en .

aat:300045536 a skos:Concept ;
    skos:definition "Tunnels built to give toads, moving to breeding ponds in mating season, safe passage beneath roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toad tunnels"@en .

aat:300045539 a skos:Concept ;
    skos:definition "Self-propelled and steerable lighter than air vehicles dependent on the displacement of air by a lighter gas for lift; generally composed of a streamlined hull, usually prolate ellipsoids, with one or more cells, a cabin for crew and passengers, and a propulsion system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airships"@en .

aat:300045549 a skos:Concept ;
    skos:definition "African stone palaces. The outer walls and cattle kraals were built of dressed stone while the main buildings within the walls were of mud and wattle construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zimbabwes"@en .

aat:300045614 a skos:Concept ;
    skos:definition "Open, rounded vessels of greater width than depth, with sloping or curving sides, used for receiving running water or holding water and other liquids, especially for washing purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basins"@en .

aat:300045627 a skos:Concept ;
    skos:definition "Vessels having a neck and mouth considerably narrower than the body, used for packaging and containing liquid and dry preparations. For vessels having wider necks and mouths, use \"jars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottles"@en .

aat:300045639 a skos:Concept ;
    skos:definition "Bottles of varying size and shape intended primarily for storing or serving wine. Often made of glass, which may be clear or colored, and sealed with a cork. For decorative bottles usually plugged with a stopper and used to store or serve wine, use \"decanters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine bottles"@en .

aat:300045643 a skos:Concept ;
    skos:definition "Rigid, often rectangular containers usually with a lid or cover in which something nonliquid is kept or carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxes"@en .

aat:300045651 a skos:Concept ;
    skos:definition "Typically, round wooden vessels for drawing water from a well; also, any comparable vessel for catching, holding, or carrying liquids or solids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckets"@en .

aat:300045657 a skos:Concept ;
    skos:definition "Sealed metal containers for food or beverages. Also, other containers for holding or carrying liquids, such as oilcans, and metal or plastic containers for holding film on cores or reels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cans"@en .

aat:300045658 a skos:Concept ;
    skos:definition "Containers of various designs used to store molasses, which is a thick, brown, uncrystallized syrup drained from raw sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molasses containers"@en .

aat:300045659 a skos:Concept ;
    skos:definition "A receptacle, holder, box, chest, bag, sheath, or covering fitted to contain or enclose something else; typically used for transporting or protecting the enclosed item or items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cases"@en .

aat:300045663 a skos:Concept ;
    skos:definition "Vessels for holding drinking water that is cooled and drawn off by a faucet or spigot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water coolers"@en .

aat:300045664 a skos:Concept ;
    skos:definition "Decorative bottles, often with a stopper, used to store or serve beverages, especially wine or liquor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decanters"@en .

aat:300045666 a skos:Concept ;
    skos:definition "Tall, wide-mouthed vessels, generally having a pouring lip, and that have a deep bowl on a stemmed base and a single vertical handle. The bowl is usually cylindrical, baluster-shaped, or helmet-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ewers"@en .

aat:300045667 a skos:Concept ;
    skos:definition "Ewers used for washing hands, especially those made of pottery and used in Roman times, and metal versions, often in animal forms, made in the medieval period, used for hand washing at the table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquamaniles"@en .

aat:300045671 a skos:Concept ;
    skos:definition "Spheroidal, bulbous shape, pear-shaped, or flattened vessels with a narrow neck and a small mouth, usually of glass, ceramic, metal, animal skin, wicker, or another material and used for various purposes. Also used specifically for distinctive narrow-necked vessels, usually of glass, having a rounded body, used in laboratories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flasks"@en .

aat:300045685 a skos:Concept ;
    skos:definition "Vessels, generally made of earthenware, stoneware or porcelain and often of large capacity, which have a narrow neck and a handle (usually a vertical loop or scroll handle); may sometimes have a pouring lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jugs"@en .

aat:300045688 a skos:Concept ;
    skos:definition "Jugs of ceramic, glass, or metal, designed to store and pour syrup at dining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syrup jugs"@en .

aat:300045689 a skos:Concept ;
    skos:definition "Globe-shaped bottles with applied handles made from 1815 to 1875 and used both as containers for store-bought whiskey and as decanters at home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiskey jugs"@en .

aat:300045695 a skos:Concept ;
    skos:definition "Typically cylindrical or nearly cylindrical vessels, generally of metal or plastic, for catching, holding, or carrying liquids or solids and usually having a bail handle or other handle and sometimes a removable cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pails"@en .

aat:300045697 a skos:Concept ;
    skos:definition "Cylindrical or rounded containers, often of metal or earthenware and varying in size; used chiefly for domestic purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pots"@en .

aat:300045712 a skos:Concept ;
    skos:definition "Covers for the opening at the top of a vessel or other receptacle, or which close the mouth of an aperture; lids may be detached or turned upon a hinge in order to give access to the interior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lids"@en .

aat:300045716 a skos:Concept ;
    skos:definition "Covers designed to be placed on open pots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pot-lids"@en .

aat:300045717 a skos:Concept ;
    skos:definition "Closures designed to plug an opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoppers"@en .

aat:300045990 a skos:Concept ;
    skos:definition "Ornamental bands or circlets worn on the upper arm. Use \"bracelets (jewelry)\" for similar articles worn on the lower arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armlets"@en .

aat:300045991 a skos:Concept ;
    skos:definition "Ornamental bands or circlets worn on the lower arm. Use \"armlets\" for similar articles worn on the upper arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracelets"@en .

aat:300045992 a skos:Concept ;
    skos:definition "Nonflexible bracelets that slip over the hand or which are hinged and closed by a clasp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bangles"@en .

aat:300045993 a skos:Concept ;
    skos:definition "Bracelets of metal links, to which are attached charms or trinkets, often acquired as souvenirs or mementos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charm bracelets"@en .

aat:300045995 a skos:Concept ;
    skos:definition "Ornamental jewelry made in a variety of forms fastened by a pin. For decorative items, similar in appearance to a brooch, but attached to a garment with a spring fastening, use \"clips (jewelry).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brooches"@en .

aat:300045998 a skos:Concept ;
    skos:definition "Ear ornaments worn suspended from a bent wire or a thin loop passed through a hole pierced in the lobe of the ear or clipped or screwed to the lobe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earrings"@en .

aat:300046000 a skos:Concept ;
    skos:definition "Earrings attached through a hole in the lobe of the ear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pierced earrings"@en .

aat:300046001 a skos:Concept ;
    skos:definition "Ornaments worn around the neck, usually in the form of chains or strands of beads, pearls, stones, or decorative or precious materials, and often including a suspended ornamental pendant. Use \"chokers\" for short, narrow necklaces worn close to the throat. Use \"dog collars (necklaces)\" for wide ornamental bands worn tightly around the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "necklaces"@en .

aat:300046002 a skos:Concept ;
    skos:definition "Articles of jewelry designed to be suspended, such as from a necklace, brooch, or earrings. Examples include Renaissance pendants fastened to the sleeve and articles of devotional, magical, or mourning jewelry concealed under clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendants"@en .

aat:300046004 a skos:Concept ;
    skos:definition "Small decorative cases, opening to reveal a portrait or memento, generally worn suspended from a chain around the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lockets"@en .

aat:300046005 a skos:Concept ;
    skos:definition "Ring-shaped ornaments worn in the nose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nose rings"@en .

aat:300046006 a skos:Concept ;
    skos:definition "Ornaments consisting essentially or partly of a pointed penetrating wire or shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pins"@en .

aat:300046007 a skos:Concept ;
    skos:definition "Small pins or stickpins worn on the lapel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapel pins"@en .

aat:300046009 a skos:Concept ;
    skos:definition "Small pins intended to be worn in clusters, often in the shape of insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scatter pins"@en .

aat:300046012 a skos:Concept ;
    skos:definition "Small circular bands worn on the finger; typically circlets of real or simulated precious metal, and frequently set with precious stones or imitations of these, intended for wearing upon the finger either as an ornament or as a token."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rings"@en .

aat:300046014 a skos:Concept ;
    skos:definition "Finger rings made with a signet or seal and used from the earliest times for the utilitarian purpose of authenticating a document by impressing the seal, or later for ornamental wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signet rings"@en .

aat:300046020 a skos:Concept ;
    skos:definition "Ornamental fillets, wreaths, or similar encircling ornaments for the head worn to signify rank, for personal adornment, or as a mark of honor or achievement; also, coronal wreaths of leaves or flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowns"@en .

aat:300046021 a skos:Concept ;
    skos:definition "Ornamental frontals or headbands, often of metal or cloth, may be adorned with jewels; often worn as a symbol of honor or royalty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diadems"@en .

aat:300046023 a skos:Concept ;
    skos:definition "Elaborate coverings or objects for the head, especially those worn for ceremonial or ornamental purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headdresses"@en .

aat:300046025 a skos:Concept ;
    skos:definition "Small pieces of metal, usually gold, silver, or bronze and bearing a relief design on one or both sides and having a commemorative purpose; resembling a coin, but not used as a medium of exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medals"@en .

aat:300046026 a skos:Concept ;
    skos:definition "Academic caps consisting of a close-fitting cap surmounted by a broad, flat projecting square top from which a tassel hangs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortarboards"@en .

aat:300046040 a skos:Concept ;
    skos:definition "Long, single-pronged accessories used to keep hair or headgear in place or for decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodkins"@en .

aat:300046042 a skos:Concept ;
    skos:definition "Single- or multi-pronged pins used to hold hair or headgear in place or for decorative effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairpins"@en .

aat:300046046 a skos:Concept ;
    skos:definition "Ornamental coronets or headbands; in modern usage, typically reserved for such ornaments worn by women.Originally used to designate royalty or members of the nobility, on state or formal occasions. Typically comprising a curved (less than semicircular) vertical band, usually with a central peak, encrusted with diamonds or other gems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiaras"@en .

aat:300046047 a skos:Concept ;
    skos:definition "Swatches of hair worn in addition to the wearer's natural hair, either to cover bald areas of the head or to supplement hair for a more elaborate hairdo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairpieces"@en .

aat:300046048 a skos:Concept ;
    skos:definition "Hairpieces of artificial hair worn to cover a bald area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toupees"@en .

aat:300046049 a skos:Concept ;
    skos:definition "Head coverings of artificial hair knotted into a shaped net foundation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wigs"@en .

aat:300046057 a skos:Concept ;
    skos:definition "Footwear, the leg of which extends above the ankle joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boots"@en .

aat:300046063 a skos:Concept ;
    skos:definition "Shoes or overshoes having a platform sole, often but not exclusiely for women, usually with a mulelike upper; the high platform sole was made of cork or wood. Worn from the 14th to 18th century to increase height and protect the feet from cold, wet, and dirt. For mulelike footwear with thinner soles used as slippers or overshoes, use \"pantofles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopines"@en .

aat:300046064 a skos:Concept ;
    skos:definition "Shoes or boots made with an extremely long pointed toe and worn in Europe in the 14th and 15th centuries. May also refer to toes of such footwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crakows"@en .

aat:300046065 a skos:Concept ;
    skos:definition "Footwear with a relatively stiff sole and heel, and generally covering the foot at or below the ankle joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoes"@en .

aat:300046066 a skos:Concept ;
    skos:definition "Footwear made partly or wholly of wood, with a thick sole usually of wood, but sometimes of leather or cork; originally to protect the foot, hosiery, or other footwear. The term \"clogs\" may also apply to shoes in the style of wooden clogs, but made of other materials. For overshoes consisting of a sole set on bands of iron, use \"pattens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clogs"@en .

aat:300046068 a skos:Concept ;
    skos:definition "Rope-soled shoes often with canvas or cotton upper, sometimes laced across the vamp and around the ankle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "espadrilles"@en .

aat:300046072 a skos:Concept ;
    skos:definition "Low-heeled, slip-on shoes of adapted moccasin-type construction with a slotted strap stitched to the vamp. Also, similar shoes decorated on the vamp with a metal chain or tied tassels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loafers"@en .

aat:300046074 a skos:Concept ;
    skos:definition "Shoes with an upper having a portion cut out to expose a toe or toes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open-toed shoes"@en .

aat:300046076 a skos:Concept ;
    skos:definition "Overshoes of rubber, especially those without buckles and not extending as high as the ankle. For overshoes of rubber or waterproof fabric that extend above the ankle and often have buckles or other fasteners, use \"galoshes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbers"@en .

aat:300046077 a skos:Concept ;
    skos:definition "Shoes consisting essentially of a sole fastened to the foot by straps, strips, or cords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandals"@en .

aat:300046078 a skos:Concept ;
    skos:definition "Shoes, often laced over the instep and with rubber or rubberlike soles, made in a wide variety of forms. Originally designed for sports and now also worn for casual dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sneakers"@en .

aat:300046079 a skos:Concept ;
    skos:definition "Athletic shoes specifically designed for playing tennis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tennis shoes"@en .

aat:300046080 a skos:Concept ;
    skos:definition "Sandals held on the foot by inverted V-straps that pass between the first and second toes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thongs"@en .

aat:300046081 a skos:Concept ;
    skos:definition "Ballet slippers with reinforced toes, usually tied on with criss-crossed satin ribbons, for dancing on point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toe shoes"@en .

aat:300046082 a skos:Concept ;
    skos:definition "Athletic shoes specifically designed for track sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "track shoes"@en .

aat:300046083 a skos:Concept ;
    skos:definition "Light footwear made for indoor wear, generally without means of fastening and made to be easily slipped on and off the foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slippers"@en .

aat:300046084 a skos:Concept ;
    skos:definition "Heelless or low wedge backless slippers with a vamp, or front portion, of a soft fabric, often open-toed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scuffs"@en .

aat:300046086 a skos:Concept ;
    skos:definition "Slippers often with a flexible sole and either heelless or with a low heel, intended for indoor use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedroom slippers"@en .

aat:300046087 a skos:Concept ;
    skos:definition "Hosiery that covers the foot and extends to somewhere below the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socks"@en .

aat:300046088 a skos:Concept ;
    skos:definition "Hosiery that covers the foot and extends to the knee or above; can be heavy or lightweight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stockings"@en .

aat:300046090 a skos:Concept ;
    skos:definition "Small, round skullcaps, often brightly colored, worn especially by children and collegians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beanies"@en .

aat:300046091 a skos:Concept ;
    skos:definition "Soft, flat-topped, visorless caps with a tight-fitting headband; in a military context, worn as an official item of headgear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berets"@en .

aat:300046094 a skos:Concept ;
    skos:definition "Brimless head coverings, often made with a visor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caps"@en .

aat:300046096 a skos:Concept ;
    skos:definition "Military undress caps in a great variety of forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forage caps"@en .

aat:300046097 a skos:Concept ;
    skos:definition "Visorless, folding, textile caps worn as part of a military uniform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garrison caps"@en .

aat:300046101 a skos:Concept ;
    skos:definition "Cloth caps primarily intended to be worn in bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nightcaps"@en .

aat:300046104 a skos:Concept ;
    skos:definition "Ear coverings worn as protection against the cold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earmuffs"@en .

aat:300046106 a skos:Concept ;
    skos:definition "Shaped coverings for the head having a brim and crown, or one of the two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hats"@en .

aat:300046107 a skos:Concept ;
    skos:definition "Lightweight hats made of fine, pale straw with a molded ridge front to back across the crown; hand-plaited in Central and South America from the leaves of the jipijapa. Also, term used loosely for similar summer hats regardless of the type of straw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panama hats"@en .

aat:300046108 a skos:Concept ;
    skos:definition "Women's hats of various materials having a wide brim which frames the face; derived from similar hats depicted in portraits by Gainsborough and Reynolds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture hats"@en .

aat:300046109 a skos:Concept ;
    skos:definition "Low, circular, brimless hats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillboxes"@en .

aat:300046111 a skos:Concept ;
    skos:definition "Protective hats made of strengthened, rigid materials with a shock-absorbing lining, often yellow; worn in hazardous working conditions for protection and visibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard hats"@en .

aat:300046113 a skos:Concept ;
    skos:definition "Tall, cylindrical hats with a stiff brim usually slightly curved on the sides; worn by men, especially on formal occasions. For hats of the same shape that are collapsible, use 'opera hats.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top hats"@en .

aat:300046114 a skos:Concept ;
    skos:definition "19th-century name for cocked hats with the brim turned up to form three corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tricornes"@en .

aat:300046115 a skos:Concept ;
    skos:definition "Bands worn around the head, made of cloth, leather, metal, or various other materials, typically worn to keep the hair in place, for decorative purposes, or as a sign of status or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headbands"@en .

aat:300046116 a skos:Concept ;
    skos:definition "Bands of absorbent material worn on head or wrists to absorb perspiration; also a component of headgear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweatbands"@en .

aat:300046121 a skos:Concept ;
    skos:definition "Soft coverings for the head and neck, and sometimes extending to the shoulders, either separate or attached to a garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoods"@en .

aat:300046122 a skos:Concept ;
    skos:definition "Square or triangular headcloths worn as a covering for the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerchiefs"@en .

aat:300046123 a skos:Concept ;
    skos:definition "Pieces of cloth made in varying widths and lengths and worn for decoration or warmth across the shoulders, around the neck, over the head, or about the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarves"@en .

aat:300046124 a skos:Concept ;
    skos:definition "Large veils, often of black or white lace, covering the head and shoulders and sometimes worn over a high hair comb; worn especially by Spanish and Latin American women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantillas"@en .

aat:300046125 a skos:Concept ;
    skos:definition "Close-fitting caps, often made of mesh, wool, silk, or velvet, covering only the crown of the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skullcaps"@en .

aat:300046126 a skos:Concept ;
    skos:definition "Skullcaps worn by Jewish males, especially during prayer and religious study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yarmulkes"@en .

aat:300046127 a skos:Concept ;
    skos:definition "Headdresses consisting of a tight-fitting cap around which is wound a long cloth, originating in eastern Mediterranean and southern Asian countries. Also, headgear of similar appearance which may be constructed differently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turbans"@en .

aat:300046128 a skos:Concept ;
    skos:definition "Thin and lightweight coverings worn over the head or face, and sometimes extending to the shoulders, for ornament, protection, or concealment; also, similar coverings made as component parts of headgear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veils"@en .

aat:300046131 a skos:Concept ;
    skos:definition "Garments worn over main garments for protection and sometimes ornamentation. Usually cover the front of the body and tie at the waist with strings, but may have a bib or shoulder straps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aprons"@en .

aat:300046133 a skos:Concept ;
    skos:definition "Main garments for the upper body, usually lightweight and loose-fitting, made with or without sleeves and worn over or tucked in the waistband of a skirt or trousers. Examples include loose garments worn by workmen, peasants and artists, as well as women's upper body garments of various designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blouses"@en .

aat:300046135 a skos:Concept ;
    skos:definition "Knee-length trousers commonly worn by men and boys in the 17th, 18th, and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breeches"@en .

aat:300046139 a skos:Concept ;
    skos:definition "Long, coatlike garments, fastened at the waist with a sash, having extra long sleeves.Originally men's garments worn in Turkey and other eastern countries, but later became fashionable garments for men and women in the west."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caftans"@en .

aat:300046140 a skos:Concept ;
    skos:definition "Sleeveless outer garments of varying lengths, fastening at the neck and falling loosely from the shoulders that function as either separate garments or attach to longer coats or cloaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capes"@en .

aat:300046141 a skos:Concept ;
    skos:definition "Leather leg coverings held together at the top by a belt or lacings, worn over trousers when horseback riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaps"@en .

aat:300046142 a skos:Concept ;
    skos:definition "Sleeveless outer garments which fasten at the neck and fall loosely from the shoulders to cover the entire body; may have a yoke or some shaping from the neck to the shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloaks"@en .

aat:300046143 a skos:Concept ;
    skos:definition "Main garments usually fitted to the upper body, extending below the hip line, open at the front or side and generally having sleeves. Also, similar outer garments worn for warmth or protection from the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coats"@en .

aat:300046144 a skos:Concept ;
    skos:definition "Suit coats with tails and a front that is cut away from near the waist in front and curving downward to an area in the back above the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutaways"@en .

aat:300046146 a skos:Concept ;
    skos:definition "Men's and boy's coats with a close-fitting body and a rather full knee-length skirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frock coats"@en .

aat:300046148 a skos:Concept ;
    skos:definition "Appendages in the form of a flap or bag worn at the position of the genitals on close-fitting hose or concealing an opening in the front of men's breeches or armor, worn by men from the 15th to the 17th century; often conspicuous and ornamented. Also, similar appendages of female attire, worn on the breast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codpieces"@en .

aat:300046157 a skos:Concept ;
    skos:definition "One-piece garments consisting of a trouserlike portion and a full top with or without sleeves worn over other garments for protection. For one-piece garments consisting of trousers with a bib use \"overalls (main garments).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coveralls"@en .

aat:300046158 a skos:Concept ;
    skos:definition "Wide trousers that form the exterior silhouette of a skirt. May have a panel to cover the joint between the legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culottes"@en .

aat:300046159 a skos:Concept ;
    skos:definition "Main garments for women, children, or infants consisting of a bodice and skirt made in one or more pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dresses"@en .

aat:300046160 a skos:Concept ;
    skos:definition "Informal but rather elegant dresses suitable for late afternoon and evening events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocktail dresses"@en .

aat:300046161 a skos:Concept ;
    skos:definition "Long garments for women, typically cut with flowing lines. Examples include semi-fitted women's dresses worn from the Middle Ages forward, and more formal dresses of modern times. Use \"robes\" for long, loose garments that tend to be one piece and open down the front, not necessarily women's fashion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gowns"@en .

aat:300046165 a skos:Concept ;
    skos:definition "Women's dresslike garments made in various lengths, worn informally around the house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housecoats"@en .

aat:300046167 a skos:Concept ;
    skos:definition "Short coats for the upper body made in various forms and lengths, but usually no lower than the waist or upper hip; worn indoors or for light warmth and protection from the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackets"@en .

aat:300046169 a skos:Concept ;
    skos:definition "Hip-length, double-breasted, straight-hanging jackets, especially those worn by sailors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pea jackets"@en .

aat:300046170 a skos:Concept ;
    skos:definition "Men's loose-fitting jackets, often of a heavy fabric and trimmed with a braid, worn for smoking or lounging at home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoking jackets"@en .

aat:300046171 a skos:Concept ;
    skos:definition "Loose, wide-sleeved garments fastened around the waist with an obi or broad sash, traditionally worn by Japanese men and women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kimonos"@en .

aat:300046173 a skos:Concept ;
    skos:definition "Close-fitting trouserlike garments, often with a strap that goes under the foot or shoe at the instep; includes those made to match a coat or jacket and worn outdoors by children. Also, leg coverings, usually extending from the ankle to the knee but sometimes higher, worn for protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leggings"@en .

aat:300046174 a skos:Concept ;
    skos:definition "Long, loose-hanging dresses, usually brightly colored or patterned, worn especially by Hawaiian women. Also, similar dresses worn as housecoats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muumuus"@en .

aat:300046178 a skos:Concept ;
    skos:definition "One-piece garments consisting of trousers with a bib and having straps extending from the bib to the back. For one-piece garments consisting of a trouserlike portion and a full top with or without sleeves worn over other garments for protection use \"coveralls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overalls"@en .

aat:300046184 a skos:Concept ;
    skos:definition "Close-fitting trousers with a strap passing under the instep; worn especially in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantaloons"@en .

aat:300046185 a skos:Concept ;
    skos:definition "Hooded pullover garments reaching to the thighs or knees made usually of skins or hides and worn by Arctic native peoples; may also be used for similar garments made of water-repellent or windproof fabric for sports or military wear, constructed as a jacket or as a pullover. For hooded pullover hip-length garments made of weather-resistant material often with zipper closure at neck and drawstring hem, use \"anoraks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parkas"@en .

aat:300046187 a skos:Concept ;
    skos:definition "Blanketlike garments, usually square or oblong with a slit in the center for the head, originating in South America. Also, similar garments used elsewhere, including those made of water-repellent fabric and usually having a hood, and when not worn, used as a blanket or tarpaulin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ponchos"@en .

aat:300046202 a skos:Concept ;
    skos:definition "Bags used primarily for carrying books and school supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schoolbags"@en .

aat:300046209 a skos:Concept ;
    skos:definition "Small cases in which keys are carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key cases"@en .

aat:300046216 a skos:Concept ;
    skos:definition "Bags of canvas, nylon, leather, or other flexible material worn on the back by means of a strap over each shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knapsacks"@en .

aat:300046218 a skos:Concept ;
    skos:definition "Small umbrellas used as a sunshade or simply carried as a fashionable accessory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parasols"@en .

aat:300046219 a skos:Concept ;
    skos:definition "Small to medium-sized receptacles made of leather or other flexible material and frequently having several inner compartments, used for carrying money and other personal items, fastened with a zipper, clasp, press stud, etc., and carried as a ladies' handbag or shoulderbag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purses"@en .

aat:300046224 a skos:Concept ;
    skos:definition "Pieces of luggage; usually rectangular, rigid, and flat; especially for carrying clothes while traveling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suitcases"@en .

aat:300046227 a skos:Concept ;
    skos:definition "Portable, usually waterproof canopies consisting of a frame with hinged ribs radiating from a center pole with handle, carried for protection against the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbrellas"@en .

aat:300046265 a skos:Concept ;
    skos:definition "Implements having two or more teeth and an ornamental portion intended to be seen when the teeth are inserted in the hair. For similar implements that are intended primarily for grooming rather than display, use \"combs (grooming tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combs"@en .

aat:300046266 a skos:Concept ;
    skos:definition "Accessories for carrying cosmetics on the person. Usually made of metal or plastic and can be quite decorative. Interior most often contains a mirror in the lid of one half and face powder in the other half, but may also have compartments for rouge or lipstick or a fitting for the attachment of a lipstick case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compacts"@en .

aat:300046300 a skos:Concept ;
    skos:definition "Refers to still images produced from radiation-sensitive materials (sensitive to light, electron beams, or nuclear radiation), generally by means of the chemical action of light on a sensitive film, paper, glass, or metal. Photographs may be positive or negative, opaque or transparent. The concept does not include reproductive prints of documents and technical drawings, for which descriptors found under \"<reprographic copies>\" are more appropriate. The concept may include photographs made by digital means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographs"@en .

aat:300047090 a skos:Concept ;
    skos:definition "Three-dimensional works of art in which images and forms are produced in relief, in intaglio, or in the round. The term refers particularly to art works created by carving or engraving a hard material, by molding or casting a malleable material (which usually then hardens), or by assembling parts to create a three-dimensional object. It is typically used to refer to large or medium-sized objects made of stone, wood, bronze, or another metal. Small objects are typically referred to as \"carvings\" or another appropriate term. \"Sculpture\" refers to works that represent tangible beings, objects, or groups of objects, or are abstract works that have defined edges and boundaries and can be measured. As three-dimensional works become more diffused in space or time, or less tangible, use appropriate specific terms, such as \"mail art\" or \"environmental art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture"@en .

aat:300047098 a skos:Concept ;
    skos:definition "Delicately balanced constructions of movable parts made to be suspended in such a way that parts will be set in motion by the movement of air; originally used to describe the work of Alexander Calder, but now used to describe any constructions of this sort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobiles"@en .

aat:300047108 a skos:Concept ;
    skos:definition "Sculptured representations of the deceased on a tomb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomb effigies"@en .

aat:300047112 a skos:Concept ;
    skos:definition "Sculptural works installed in public places and thus accessible and visible to all members of the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public sculpture"@en .

aat:300047167 a skos:Concept ;
    skos:definition "Sculpture in the form of a herm but usually depicting the Roman god Terminus; used by the ancient Romans as boundary markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terms"@en .

aat:300047170 a skos:Concept ;
    skos:definition "Sculpture in the form of a head, bust, or half figure, supported by, as if growing out of, a gaine or tapering pilaster, sometimes exhibiting a phallus below; originally usually depicting the Greek god Hermes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herms"@en .

aat:300047180 a skos:Concept ;
    skos:definition "Sculpture designed to be placed outdoors. For contemporary outdoor works that especially exploit or incorporate aspects of their sites, use \"environmental art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outdoor sculpture"@en .

aat:300047194 a skos:Concept ;
    skos:definition "Works that use non-art elements, often junk and/or debris, to form a work of art. Assemblages are sculptural works created since about 1945 by the technique of assemblage, the creation of a three-dimensional work of art by combining various elements, especially found objects. They may include elements painted, carved, or modeled by the artist. For such works created earlier in the 20th century, see \"object sculpture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assemblages"@en .

aat:300047195 a skos:Concept ;
    skos:definition "Sculpture fabricated by assembling and joining a number of separate parts rather than by traditional sculptural processes such as modeling, casting, or carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constructions"@en .

aat:300047196 a skos:Concept ;
    skos:definition "Works composed primarily of industrial and modern consumer-culture waste, usually presented as assemblages of found objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junk sculpture"@en .

aat:300047199 a skos:Concept ;
    skos:definition "Term used prior to about 1945 to describe three-dimensional works of art that incorporate found objects. For such works created after about 1945, use \"assemblages (sculpture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "object sculpture"@en .

aat:300047203 a skos:Concept ;
    skos:definition "Refers to works executed by cutting a figure or design out of a solid material such as stone or wood. It typically refers to works that are relatively small in size, are part of a larger work, or are not considered art. For large and medium-sized three-dimensional works of art, use the broader term \"sculpture\" or another appropriate term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carvings"@en .

aat:300047210 a skos:Concept ;
    skos:definition "Objects, natural or human-made, unaltered or only slightly altered, presented by an artist as works of art in themselves or used as parts of works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "found objects"@en .

aat:300047216 a skos:Concept ;
    skos:definition "Sculptural works composed of a sunken design carved or incised into a hard and generally flat surface, most often the surface of a gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intaglios"@en .

aat:300047225 a skos:Concept ;
    skos:definition "Sculptural works composed primarily of neon lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neon sculpture"@en .

aat:300047229 a skos:Concept ;
    skos:definition "Technique for translating multiple camera images of a subject into outlines in a block of clay, which is then further refined by hand into a three-dimensional representation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photosculpture"@en .

aat:300047230 a skos:Concept ;
    skos:definition "Sculptures in which the ornaments or figures are attached to a background from which they stand out to a greater or lesser degree. Reliefs are often used as architectural decoration and because of their capacity for narration they are often used for pictorial narrative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reliefs"@en .

aat:300047259 a skos:Concept ;
    skos:definition "Raised ornamental or protective projections or knobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bosses"@en .

aat:300047261 a skos:Concept ;
    skos:definition "Small reliefs made from materials having layers of different colors, such as gems, glass, ceramics, or shell, and carved so that the design stands out in one color against a background in another. Cameos may be incorporated in jewelry. For works created from different pieces of stone and other materials, prefer \"commessi (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cameos"@en .

aat:300047264 a skos:Concept ;
    skos:definition "Sculpture in which forms are carved or modeled about their full circumference, as opposed to having forms projecting from or sunk into a continuous surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture in the round"@en .

aat:300047265 a skos:Concept ;
    skos:definition "Sculptural works that utilize soft, pliable materials such as felt, rubber, plastics, or vinyl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft sculpture"@en .

aat:300047267 a skos:Concept ;
    skos:definition "Sculptural works that incorporate sound; used especially in reference to sculptural instruments for performance, such as those created by François and Bernard Baschet, Robert Rutman, Charles Mattox, and Harry Bertoia, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound sculpture"@en .

aat:300047296 a skos:Concept ;
    skos:definition "Sculptural works, vessels, or structural forms made from terracotta, a fairly coarse, porous clay product that when fired typically assumes a reddish or orange brown color, and often is left unglazed. When possible, for indexing use a more specific term, created locally by combining the material term plus a more specific object name, such as \"terracotta\" + \"figurines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terracottas"@en .

aat:300047325 a skos:Concept ;
    skos:definition "Objects carved from ivory, or from natural substances resembling ivory, such as bone. When possible, use the material term plus a more specific object name, such as \"ivory\" + \"diptychs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivories"@en .

aat:300047333 a skos:Concept ;
    skos:definition "Collectively, the class of sculptures, containers, or other objects executed in bronze, especially artifacts or works considered to be art. When possible, use the material term \"bronze (metal)\" plus a more specific object name, such as \"bronze\" + \"figurines\" or \"bronze\" + \"bowl.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronzes"@en .

aat:300047355 a skos:Concept ;
    skos:definition "Temporary sculptural forms created in wet sand, usually at the seashore, and resembling the form of a castle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandcastles"@en .

aat:300047449 a skos:Concept ;
    skos:definition "Recumbent effigies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gisants"@en .

aat:300047453 a skos:Concept ;
    skos:definition "Sculptured figures of extraordinarily large size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colossi"@en .

aat:300047455 a skos:Concept ;
    skos:definition "Three-dimensional works that represent humans, animals, or mythical beasts at less than half life-size. While the term may be used interchangeably with \"statuette\" in certain situations, it differs in that a statuette is always free-standing while a figurine may be part of a larger work, such as a decorative detail on a candelabra or mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figurines"@en .

aat:300047457 a skos:Concept ;
    skos:definition "Representations of only the head and shoulders of a figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "busts"@en .

aat:300047469 a skos:Concept ;
    skos:definition "Representations of persons from the head down to the waist only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half figures"@en .

aat:300047498 a skos:Concept ;
    skos:definition "Figural sculptures serving as vessels for spiritual forces to promote individual or collective healing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fetish figures"@en .

aat:300047515 a skos:Concept ;
    skos:definition "Jointed figures of humans or animals able to assume a variety of poses to serve as substitutes for living models for artists. For three-dimensional representations of human figures used specifically for fitting or displaying clothing, use \"mannequins.\" For models of the human body used for teaching anatomy or demonstrating surgical operations, use \"manikins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lay figures"@en .

aat:300047520 a skos:Concept ;
    skos:definition "Japanese clay or terracotta cylinders surmounted by modeled figures or heads, placed in a fencelike position around burial mounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haniwa"@en .

aat:300047570 a skos:Concept ;
    skos:definition "Sculptures of the Archaic Greek period depicting standing nude male youths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kouroi"@en .

aat:300047600 a skos:Concept ;
    skos:definition "Sculpture in the round, usually but not always depicting humans, animals, mythical beings, or small figure groups. Statues are relatively large in scale, being life-size, larger than life-size, or only slightly smaller than life-size. For small-scale representations of humans, animals, or mythical beings, use \"figurines,\" \"statuettes,\" or another appropriate term. For depictions of humans, animals, or mythical beings in media other than sculpture, use \"figures (representations).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statues"@en .

aat:300047606 a skos:Concept ;
    skos:definition "Sculptural groups consisting of a horse and rider."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equestrian statues"@en .

aat:300047724 a skos:Concept ;
    skos:definition "Casts taken of a person's face after death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "death masks"@en .

aat:300047726 a skos:Concept ;
    skos:definition "Casts of the face or whole head of a living person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life masks"@en .

aat:300047753 a skos:Concept ;
    skos:definition "Refers to scaled or lifesize representations of objects, structures, beings, or other subjects, usually three-dimensional."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "models"@en .

aat:300047762 a skos:Concept ;
    skos:definition "Works in which three-dimensional objects, often figural sculpture, in the foreground blend with a realistic painted background. The entire work is usually enclosed in a case or niche and is viewed from a distant, darkened vantage point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dioramas"@en .

aat:300047806 a skos:Concept ;
    skos:definition "Sculptures or more generally an object that is shaped by pouring a molten material or a slurry into a mold in which it will solidify. Plaster of Paris, metal, and wax are among the cast-forming sculptural materials routinely involved in bronze production in particular. The term may also refer to the amount of homogenous molten metal resulting from a single pour. In industrial and building trade contexts, prefer \"castings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casts"@en .

aat:300047837 a skos:Concept ;
    skos:definition "Small, rough, three-dimensional sketches for sculpture. For somewhat more developed sculptural sketches, use \"bozzetti.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maquettes"@en .

aat:300047838 a skos:Concept ;
    skos:definition "Fairly developed sketches, most often three-dimensional ones for sculpture, but may be painted or drawn. With regard to sketches for architecture, use \"preliminary sketches.\" For rougher sculptural sketches, use \"maquettes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bozzetti"@en .

aat:300047851 a skos:Concept ;
    skos:definition "Refers to the Italian art movement of the 1970s that was analogous to the Minimalist and Conceptual Art movement in North America. The style is characterized by the use of intentionally humble and worthless materials, and artistic expression through happenings and installations, with often obscure or conflicting meanings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arte Povera"@en .

aat:300047857 a skos:Concept ;
    skos:definition "Artist works that manipulate natural earth and stone, altering the terrain of the land itself for artistic purposes. For large-scale outdoor works that otherwise exploit or incorporate aspects of their sites, use the more general term \"environmental art.\" For the results of grading, trenching, or embanking earth, for utilitarian purposes, use \"earthworks (engineering works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthworks"@en .

aat:300047869 a skos:Concept ;
    skos:definition "Art influenced by systems analysis, dealing, for example, with systems of natural phenomena, social signs, or the art world itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Systems art"@en .

aat:300047891 a skos:Concept ;
    skos:definition "First used to describe the work of a group of artists working in San Francisco in the late 1950s, and later used as the title of an exhibition held in Callifornia in 1967. The style is characterized by a preoccupation with sick, shocking, and sexually provocative imagery resulting in bizarre combinations of materials such as leather, steel, clay, vinyl, fur, and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Funk"@en .

aat:300047896 a skos:Concept ;
    skos:definition "Works dating from the 1960s or later that use their exhibition space as part of their design. Demanding a viewer's active engagement, installations are often created by artists in direct opposition to the notion of permanent artwork, or art as a commodity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "installations"@en .

aat:300047910 a skos:Concept ;
    skos:definition "Contemporary works of art that employ several distinct art forms, such as sculpture and music or painting and light art. For the concept that certain contemporary works merge known art forms to inaugurate a new type, use \"intermedia.\" To indicate that works are composed of a variety of materials, use \"mixed media.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multimedia works"@en .

aat:300047918 a skos:Concept ;
    skos:definition "Mechanical sculpture and other works of art capable of responding to external stimuli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cybernetic art"@en .

aat:300047930 a skos:Concept ;
    skos:definition "Refers to works produced since the 1960s that employ the artists own body, or other people's bodies, as the medium of expression. May be in the form of performance art or conceptual art, where the artist uses his or her own body as a focus or theme. For visual works that are body modifications based on traditional or ancient practices, such as scarification or tattooing, prefer \"body art (visual works, adornment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body art"@en .

aat:300047933 a skos:Concept ;
    skos:definition "Refers to a movement formed of a group of Austrian artists active in the 1960s. The style is characterized by violent and disturbing forms of expression such as actions or happenings, often involving nudity, blood, and the destruction of animal corpses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Direct art"@en .

aat:300047935 a skos:Concept ;
    skos:definition "Works from the 1950s and 1960s that were unique, unrehearsed events, often combining elements of theater, music, and the visual arts. Usually nonverbal, they may incorporate visual, tactile, and olfactory responses, chance, and audience participation. The term was coined by artist Allan Kaprow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "happenings"@en .

aat:300048090 a skos:Concept ;
    skos:definition "Horizontal masonry joints sloped from a point inside the face of the wall to the face of the wall so the joint will shed water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weather-struck joints"@en .

aat:300048092 a skos:Concept ;
    skos:definition "Mortar joints having a groove that is V-shaped in cross section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-shaped joints"@en .

aat:300048095 a skos:Concept ;
    skos:definition "Interlocking joints formed by a flaring or fanlike tenon and a mortise into which it fits tightly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dovetail joints"@en .

aat:300048116 a skos:Concept ;
    skos:definition "A non-woven textile made by beating the inner bark of certain trees and bushes until it is fine and soft. Bark cloth can be painted, stamped, embroidered, or cut and sewn as patchwork although it is relatively fragile, especially when wet. Used in many places arond the globe. An example is the cloth once used in almost all of sub-Saharan Africa, being reported as early as the mid-16th century in Liberia; today it is found in Ghana and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bark cloth"@en .

aat:300048124 a skos:Concept ;
    skos:definition "Pasteboard made of straw, certain grasses, and other low-cellulose paper materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strawboard"@en .

aat:300048153 a skos:Concept ;
    skos:definition "Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants. Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bast"@en .

aat:300048163 a skos:Concept ;
    skos:definition "Thesauri consisting of sets of terms in multiple languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multilingual thesauri"@en .

aat:300048165 a skos:Concept ;
    skos:definition "Thesauri consisting of sets of terms in a single language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monolingual thesauri"@en .

aat:300048571 a skos:Concept ;
    skos:definition "Fastenings for French doors or casement windows that consist of sliding rods that engage with strikes or plates at the top or bottom of the frame of the portal. The rod is controlled by a handle that retracts the upper and lower parts of the bolt from the frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cremorne bolts"@en .

aat:300048572 a skos:Concept ;
    skos:definition "Modified form of barrel bolts, in which the locking bar is shortened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower bolts"@en .

aat:300048573 a skos:Concept ;
    skos:definition "Door locks that must be operated actively in both directions by turning a key or a thumb bolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dead bolts"@en .

aat:300048591 a skos:Concept ;
    skos:definition "Locks made of bronze for use on ships, usually of heavy construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship locks"@en .

aat:300048592 a skos:Concept ;
    skos:definition "Locks usually having a latch bolt controlled from both sides by knobs, with the latch arranged to be set by stops so that the outside knob is inoperative and entrance is gained by key only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office locks"@en .

aat:300048626 a skos:Concept ;
    skos:definition "In fresco, the final coat of plaster on which the painter actually works, while it is still wet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intonaco"@en .

aat:300048627 a skos:Concept ;
    skos:definition "In the preparation of a wall for fresco, the second coat of plaster, over the roughcast and under the intonaco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arriccio"@en .

aat:300048635 a skos:Concept ;
    skos:definition "A clear, glasslike ceramic coating with a distinctive uneven surface produced by throwing common table salt into a hot kiln."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt glaze"@en .

aat:300048642 a skos:Concept ;
    skos:definition "In ceramics, the application of color to the surface of a clay body before application of a transparent glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underglazing"@en .

aat:300048659 a skos:Concept ;
    skos:definition "Metal ties or plates used to fasten together timbers or masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchors"@en .

aat:300048661 a skos:Concept ;
    skos:definition "Anchors made of sheet steel or other metal, cast into a surface with a chase narrower at the surface than at the base into which shaped metal tongues are inserted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slot anchors"@en .

aat:300048682 a skos:Concept ;
    skos:definition "Short blocks, usually metal, each having a threaded hole in the center for receiving a bolt or threaded rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuts"@en .

aat:300048688 a skos:Concept ;
    skos:definition "Nuts provided with winglike projections to facilitate turning by fingers and thumb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wing nuts"@en .

aat:300048689 a skos:Concept ;
    skos:definition "Helically threaded fasteners that cut their way into wood when turned under axial pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood screws"@en .

aat:300048698 a skos:Concept ;
    skos:definition "Complexes designed to board horses and accommodate equestrian events such as competitions, dressage, and recreational riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding clubs"@en .

aat:300048709 a skos:Concept ;
    skos:definition "Records documenting additions to a collection, whether acquired by transfer under a legally based procedure, or by deposit, purchase, gift, or bequest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accession records"@en .

aat:300048713 a skos:Concept ;
    skos:definition "Records documenting the design and construction of buildings or other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural records"@en .

aat:300048715 a skos:Concept ;
    skos:definition "Literary compositions prepared for publication as an independent portion of a magazine, newspaper, encyclopedia, or other work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "articles"@en .

aat:300048719 a skos:Concept ;
    skos:definition "Indexes recorded on cards of uniform size, arranged alphabetically, numerically, or by some other order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card indexes"@en .

aat:300048720 a skos:Concept ;
    skos:definition "Records pertaining to an exhibition of art or other cultural objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition records"@en .

aat:300048722 a skos:Concept ;
    skos:definition "Posted texts that accompany an exhibition of art or other cultural material, including wall labels and other explanatory texts, charts, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibit scripts"@en .

aat:300048725 a skos:Concept ;
    skos:definition "Manuals intended to be taken into the \"field,\" i.e., in natural environments, and containing information or pictures to aid in the identification and disambiguation of flora, fauna, and other objects of natural occurrence, such as minerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field guides"@en .

aat:300048727 a skos:Concept ;
    skos:definition "Dictionaries of the words of a language, especially one giving the meaning in another language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lexicons"@en .

aat:300048730 a skos:Concept ;
    skos:definition "Correspondence, typically written letters or notes, from one person to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal correspondence"@en .

aat:300048763 a skos:Concept ;
    skos:definition "Redoubts formed by a number of re-entering and salient angles, the sides of which flank each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "star-forts"@en .

aat:300048764 a skos:Concept ;
    skos:definition "In Mayan architecture, exterior spaces that resemble plazas, but are of smaller size; distinguished from Mayan courtyards on the basis of the differing relationships of bordering structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plazuelas"@en .

aat:300048769 a skos:Concept ;
    skos:definition "Dense plantings used as fortifications. The best known examples are barriers used as defensive walls in North Africa, Sub-Saharan Africa, Moorish Spain, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant fortifications"@en .

aat:300048776 a skos:Concept ;
    skos:definition "Structures built for festivals, ceremonies, processions, and funerals, particularly when referring to such structures dating to the 17th and 18th centuries in Europe. They may take many forms, including the form of a monument, building, or sculpture. Although macchine may be portable, for more modern portable structures used in parades, use \"floats (vehicles).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macchine"@en .

aat:300048788 a skos:Concept ;
    skos:definition "Artistic concepts comprising proposed undertakings or creations, including the creation of works of art or architecture, or for the actual carrying out of such proposals. When emphasis is on specific conceptual schemes for the organization or appearance of graphic works, objects, structures, or systems, use \"designs.\" For visual works and other physical items that are used to carry out the project, use \"projects (object groupings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projects"@en .

aat:300048798 a skos:Concept ;
    skos:definition "Buildings that house either Hebrew-English day schools providing both secular and religious instruction, usually operated under Orthodox Jewish auspices, or for schools providing training in Talmudic law and which may ordain rabbis. For educational facilities specifically devoted to the training of rabbis, use \"rabbinical seminaries.\" For buildings that house day schools operated under Reform or Conservative Jewish auspices, use \"Hebrew schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yeshivas"@en .

aat:300048800 a skos:Concept ;
    skos:definition "Fortifications that incorporate enclosed earthworks with bastions (projecting portions) at the angles where the curtain walls meet. They are designed to provide coverage by defensive weapons, which are able to fire from the projecting portions along the fronts of the curtain walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastioned forts"@en .

aat:300048803 a skos:Concept ;
    skos:definition "Fortifications erected along seacoasts, as to prevent the passage of ships or to protect the land from attack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal fortifications"@en .

aat:300048808 a skos:Concept ;
    skos:definition "Dwellings that are made within natural caves or within caves that have been altered for habitation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cave dwellings"@en .

aat:300048811 a skos:Concept ;
    skos:definition "Bases located on the Moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunar bases"@en .

aat:300048816 a skos:Concept ;
    skos:definition "Huts or boxes to shelter a sentry at his post."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sentry boxes"@en .

aat:300048827 a skos:Concept ;
    skos:definition "Protective caps, tops, or covers of walls, parapets, or other structures, often of stone, terracotta, or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copings"@en .

aat:300048911 a skos:Concept ;
    skos:definition "Wood of the trees belonging to the Acacia genus, native to tropical and subtropical regions of the world, mostly Australia. Historically the term has been used to refer to wood of genera other than Acacia as well, especially trees of genera Vachellia and Senegalia. The strong, elastic, hardwood is used for furniture, walking sticks, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acacia"@en .

aat:300048920 a skos:Concept ;
    skos:definition "Door hinges which are completely concealed when the door is either open or closed. Distinguished from \"concealed hinges\" which are invisible only when the door is closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invisible hinges"@en .

aat:300048921 a skos:Concept ;
    skos:definition "Hinges mounted on the outside of a door or hinged surface, as distinguished from concealed or invisible hinges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exposed hinges"@en .

aat:300048927 a skos:Concept ;
    skos:definition "Nails having a tip that is tapered on two sides to form a sharp edge, as a chisel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chisel nails"@en .

aat:300048928 a skos:Concept ;
    skos:definition "Nails having a tip that is faceted to form a point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond nails"@en .

aat:300048929 a skos:Concept ;
    skos:definition "Nails having a shank that is barbed rather than smooth, to improve the grip. Distinguished from “ring-shank nails,” which have ringlike grooves around the shank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbed nails"@en .

aat:300048930 a skos:Concept ;
    skos:definition "Nails having a tip that is tapered gradually to a point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle nails"@en .

aat:300048931 a skos:Concept ;
    skos:definition "Nails having a tip that is blunt rather than pointed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blunt nails"@en .

aat:300048932 a skos:Concept ;
    skos:definition "Nails having a tip comprised of a bevel on one side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side nails"@en .

aat:300048933 a skos:Concept ;
    skos:definition "Nails having a rounded tip formed by tapering on two sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duck bill nails"@en .

aat:300048934 a skos:Concept ;
    skos:definition "Nails having two points, with the shank bent in the shape of an inverted-U."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staple nails"@en .

aat:300048941 a skos:Concept ;
    skos:definition "Special nails having a flat head projecting at a right angle to one side of the shank, used for securing the hoops of a barrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoop fastener nails"@en .

aat:300048942 a skos:Concept ;
    skos:definition "Nails having an indented head; used, for example, for ease of applying a tool for countersinking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupped nails"@en .

aat:300048944 a skos:Concept ;
    skos:definition "Nails having a shank and tip, but no head. Distinguished from brads and other finishing nails, which have a very narrow head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headless nails"@en .

aat:300048945 a skos:Concept ;
    skos:definition "Nails designed so the top of the shank or a small head projects through a relatively broad, shallow, inverted-cup-shaped head; used for roofing and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbrella nails"@en .

aat:300048946 a skos:Concept ;
    skos:definition "Nails of various types designed to be hammered into the end of a window shade roller, and having an extension of the shank or a cap to allow attachment of the roller into a bracket on the window frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shade roller pin nails"@en .

aat:300048947 a skos:Concept ;
    skos:definition "Nails having two heads, one above the other, used for temporary construction such as concrete forms and scaffolds. The nail can secure the work but still be easily extracted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-headed nails"@en .

aat:300048949 a skos:Concept ;
    skos:definition "General-use nails each having a head and a diamond-shaped point that are used where appearance is not important, as in framing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common nails"@en .

aat:300048952 a skos:Concept ;
    skos:definition "Nails having one pointed end and the other end comprising a hook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hook nails"@en .

aat:300048953 a skos:Concept ;
    skos:definition "Slender nails, each having a narrow head, that may be driven entirely into a wood surface leaving a small hole that can be filled with putty or a similar compound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finishing nails"@en .

aat:300048959 a skos:Concept ;
    skos:definition "Special-purpose short-threaded nails each having a large head and usually galvanized or aluminum with a neoprene or plastic washer to aid in fastening roof coverings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing nails"@en .

aat:300048961 a skos:Concept ;
    skos:definition "Relatively short, stout nonferrous nails having a cut shank, designed to avoid splitting the underlying planks of wood when nailing down slates to slate roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut slating nails"@en .

aat:300048963 a skos:Concept ;
    skos:definition "Long, thin nails designed to be used with a ferrule to secure gutters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gutter spikes"@en .

aat:300048964 a skos:Concept ;
    skos:definition "Hardware used in supporting or connecting members of similar or different material as, for instance, a beam hanger for supporting the end of a beam or joist at a masonry wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangers"@en .

aat:300048967 a skos:Concept ;
    skos:definition "Hangers that are suspended, supported, or anchored to ceilings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling hangers"@en .

aat:300048974 a skos:Concept ;
    skos:definition "In construction, hangers designed to attach joists to supporting beams, bearing walls, or other members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joist hangers"@en .

aat:300048991 a skos:Concept ;
    skos:definition "Metal supports, wires, straps, or other hardware devices used to hang the formwork for concrete beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beam hangers"@en .

aat:300049003 a skos:Concept ;
    skos:definition "Objects of one material around which another material, as concrete, plastic, or metal sets or solidifies, especially to provide a means of attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inserts"@en .

aat:300049004 a skos:Concept ;
    skos:definition "Inserts for attachment or fastening that allow for a certain amount of adjustment in positioning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable inserts"@en .

aat:300049007 a skos:Concept ;
    skos:definition "Inserts used to attach furring to a wall or ceiling, typically plates or formed metal sections inserted in concrete or masonry walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furring inserts"@en .

aat:300049008 a skos:Concept ;
    skos:definition "Inserts to provide support for the position on a wall or area where a nail will be used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nailer inserts"@en .

aat:300049009 a skos:Concept ;
    skos:definition "Threaded sockets inserted into a pre-drilled hole in wood, concrete, metal, or another material, serving as an anchor for a bolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nut inserts"@en .

aat:300049010 a skos:Concept ;
    skos:definition "Inserts designed to attach flashing, which is an impervious material located between a roof and a wall and over exterior door openings and windows to prevent leaking and to allow water drainage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reglet inserts"@en .

aat:300049013 a skos:Concept ;
    skos:definition "Inserts having a wedge or triangular shape at the point where they are inserted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedge inserts"@en .

aat:300049015 a skos:Concept ;
    skos:definition "Strips of flexible material, especially leather, used for fastening or holding things together. May have a buckle or other fastener attached. For strips that pass over the shoulder, use \"shoulder straps (object components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straps"@en .

aat:300049017 a skos:Concept ;
    skos:definition "The black carbonaceous particulate substance formed by the incomplete combustion of coal, oil, wood, or other fuels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soot"@en .

aat:300049060 a skos:Concept ;
    skos:definition "General term referring to formulary documents having an established arrangement of different parts and often a fixed order of words. Forms are used for acquiring particular information or for presenting particular information in a prescribed sequence and format. Forms may be handwritten, printed, typed, or online. Forms for acquiring information typically have titles for each type of data accompanied by blank spaces or lines, check boxes, pull-down lists, data entry fields, or other methods to prompt for the insertion of the requested information for each data type; they may also include instructions for how to fill out the form. Forms that present information do so in a standardized sequence and format, typically with a sequence of titles naming the types of data followed by the values of information related to that type of data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forms"@en .

aat:300049111 a skos:Concept ;
    skos:definition "Artists who design for logos, advertisements, illustrations, books, brochures, signs, posters, animation, Web pages, or other displays to promote sale or acceptance of products, services, or ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial artists"@en .

aat:300049113 a skos:Concept ;
    skos:definition "Artists who voice dissent, generally in response to politics or religion, often in a totalitarian state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissident artists"@en .

aat:300049197 a skos:Concept ;
    skos:definition "Recreation buildings equipped with gambling devices and often providing other forms of entertainment and restaurant facilities; for similar buildings but which lack gambling devices, use \"casinos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gambling casinos"@en .

aat:300049869 a skos:Concept ;
    skos:definition "Any of the equipment effecting movement on the stage, including groove systems, devices for flying figures, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stage machinery"@en .

aat:300049945 a skos:Concept ;
    skos:definition "Works of art that incorporate several different styles or are made up of parts drawn from a variety of sources. May also refer to other artistic works, such as works of music or literature, that piece together fragments from various sources or that closely imitate the style of another work. A pastiche typically selfconsciously borrows its style, technique, or motifs from other works of art, yet is not a direct copy of any work; it is often deliberately exaggerated and satirical. The term may also be applied in a derogatory sense, implying that the creator was unoriginal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastiches"@en .

aat:300049946 a skos:Concept ;
    skos:definition "Social, cultural groups, the members of which are held to be descended from a common ancestor, composed of numerous families, clans, or villages. They typically occupy a specific geographic territory, possess cultural, religious, and linguistic homogeneity, and are united politically under one head or chief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribes"@en .

aat:300049957 a skos:Concept ;
    skos:definition "Groups of families and households, the heads of which claim descent from a common ancestor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clans"@en .

aat:300050374 a skos:Concept ;
    skos:definition "Furrows or channels constructed to house electrical conductors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raceways"@en .

aat:300050379 a skos:Concept ;
    skos:definition "Electric conduits prefabricated in sections and containing heavy conductors for transmission of large currents at relatively low voltage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "busways"@en .

aat:300050387 a skos:Concept ;
    skos:definition "Network of electrical components constructed to supply, transfer, and use electric power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical systems"@en .

aat:300050479 a skos:Concept ;
    skos:definition "Librarians who manage the reference collection of a library and assist library patrons to find the information they seek in it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reference librarians"@en .

aat:300050588 a skos:Concept ;
    skos:definition "Electrical systems temporarily produced or supplied by standby power generators when normal electric power supply fails or is interrupted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency power supply"@en .

aat:300050605 a skos:Concept ;
    skos:definition "Systems of electric conductors, at least one of which is intentionally grounded, either solidly or by means of a device that limits currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grounded systems"@en .

aat:300050611 a skos:Concept ;
    skos:definition "Parts and components of electrical systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical system components"@en .

aat:300050615 a skos:Concept ;
    skos:definition "Use both for electric conductors comprising a number of twisted or braided wire strands and for groups of electric conductors bound together and insulated from one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric cables"@en .

aat:300050627 a skos:Concept ;
    skos:definition "Reusable electrical devices for discontinuing current flow during abnormal conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circuit breakers"@en .

aat:300050635 a skos:Concept ;
    skos:definition "Refers to the complete paths taken by electric currents flowing through conductors, usually wires, from one terminal of a generating source through energy-consuming units and returning through different conductors, usually wires, back to another terminal on the power source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circuits"@en .

aat:300050645 a skos:Concept ;
    skos:definition "Tubes especially constructed for the purpose of enclosing electrical conductors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric conduits"@en .

aat:300050680 a skos:Concept ;
    skos:definition "Large panels, frames, or other assemblies on which are mounted switches, fuses, instruments, and protective devices; for smaller panels containing switches and fuses or circuit breakers, use \"panelboards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "switchboards"@en .

aat:300050682 a skos:Concept ;
    skos:definition "Mechanisms for making, breaking, or changing connections in electrical circuits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric switches"@en .

aat:300050687 a skos:Concept ;
    skos:definition "Refers to the aggregate of wires in electrical systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric wiring"@en .

aat:300050700 a skos:Concept ;
    skos:definition "Special devices to interrupt electrical current where a weak electrical loss or ground occurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground-fault circuit interruptors"@en .

aat:300050702 a skos:Concept ;
    skos:definition "Terminals of an electricity system made to receive the pins of a plug or other means of supplying current to an appliance or device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power outlets"@en .

aat:300050726 a skos:Concept ;
    skos:definition "Small electrical panels containing switches and fuses or circuit breakers. For larger panels, frames, or assemblies containing switches, fuses, instruments, and protective devices, use \"switchboards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panelboards"@en .

aat:300050728 a skos:Concept ;
    skos:definition "Devices installed in electrical outlet boxes for the connection of portable equipment or appliances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "receptacles"@en .

aat:300050773 a skos:Concept ;
    skos:definition "Electric devices for introducing mutual coupling between circuits, generally used to convert a power supply at one voltage to another voltage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transformers"@en .

aat:300051150 a skos:Concept ;
    skos:definition "Building systems or devices designed to move people, equipment, or goods through a building or complex; for networks of equipment designed to move similar items through and between settlements, use \"transit systems;\" for machinery designed for the continuous transport of material, use \"conveyors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conveying systems"@en .

aat:300051152 a skos:Concept ;
    skos:definition "Systems in buildings designed to vertically move people, equipment, or goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical conveying systems"@en .

aat:300051183 a skos:Concept ;
    skos:definition "Hoisting or lowering mechanisms equipped with a car or platform used in buildings exclusively for carrying materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumbwaiters"@en .

aat:300051201 a skos:Concept ;
    skos:definition "Tandem elevators with one car above the other riding in the same hoistway and serving two consecutive floors simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-deck elevators"@en .

aat:300051207 a skos:Concept ;
    skos:definition "Elevators with glass-enclosed cars with operating mechanisms so located as to maximize viewing area for the passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "observation elevators"@en .

aat:300051210 a skos:Concept ;
    skos:definition "Elevators operating through a sidewalk, especially for the handling of goods or refuse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sidewalk elevators"@en .

aat:300051212 a skos:Concept ;
    skos:definition "Elevators whose cars or platforms move at a degree less than completely vertical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inclined elevators"@en .

aat:300051215 a skos:Concept ;
    skos:definition "Elevators designed to move large objects, such as freight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freight elevators"@en .

aat:300051219 a skos:Concept ;
    skos:definition "Elevators intended for combined freight and passenger use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service elevators"@en .

aat:300051228 a skos:Concept ;
    skos:definition "Elevators that can be operated by the passengers, having at least automatic doors and leveling at landings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automatic elevators"@en .

aat:300051235 a skos:Concept ;
    skos:definition "Elevators in which the motion of the car is obtained by means of friction between the traction sheave and the hoisting cable, as is usually the case in contemporary installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traction elevators"@en .

aat:300051239 a skos:Concept ;
    skos:definition "Elevators operated by electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric elevators"@en .

aat:300051241 a skos:Concept ;
    skos:definition "Devices consisting of a powerdriven endless belt provided with steps or platforms and handholds for the transportation of persons in a vertical position through successive floors or levels of a building or structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manlifts"@en .

aat:300051244 a skos:Concept ;
    skos:definition "Refers to continuously operating, power-driven, moving stairways used as transportation between floors or levels in subways, buildings, and other mass pedestrian areas. An inclined belt for passengers riding on cleats was invented by Jesse W. Reno of the United States in 1891; it was inclined at an angle of 25 degrees, and in the first model, the handrail was stationary. The name \"escalator\" was first applied to a moving stairway shown at the Paris Exposition of 1900, originally a trademark of the Otis Elevator Company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escalators"@en .

aat:300051252 a skos:Concept ;
    skos:definition "Devices for raising and lowering passengers or freight on a car or platform that travel on guide rails set on an angle, rather than being directly vertical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inclined lifts"@en .

aat:300051254 a skos:Concept ;
    skos:definition "Continuously moving belts designed to carry passengers or goods either horizontally or up inclines; for similar devices moving only horizontally, use \"moving walkways.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving ramps"@en .

aat:300051256 a skos:Concept ;
    skos:definition "Systems for conveying papers or small objects through tubes in specially designed receptacles by means of air pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pneumatic tubes"@en .

aat:300051259 a skos:Concept ;
    skos:definition "Refers to a series of chairlike elements suspended from an endless cable designed for carrying skiers up a slope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair lifts"@en .

aat:300051260 a skos:Concept ;
    skos:definition "Systems in buildings designed to horizontally move people, equipment, or goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizontal conveying systems"@en .

aat:300051267 a skos:Concept ;
    skos:definition "Conveying systems having a moving surface on which passengers stand or walk and that remains parallel to its direction of travel; for similar devices designed to carry passengers or goods either horizontally or up inclines, use \"moving ramps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving walkways"@en .

aat:300051285 a skos:Concept ;
    skos:definition "Counterbalancing weights in various contexts, used to stabilize or otherwise affect the weight or position of another member. Examples of use are in cranes and other construction equipment, and in mechanical devices, such as elevators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterweights"@en .

aat:300051314 a skos:Concept ;
    skos:definition "Fasteners attached to an outside wall for securing a shutter, blind, or door in an open position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back catches"@en .

aat:300051316 a skos:Concept ;
    skos:definition "Hinges in two leaves, screwed to the face of a door which is not thick enough to permit the use of butt hinges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backflap hinges"@en .

aat:300051319 a skos:Concept ;
    skos:definition "Hinges containing a spring for closing a compression chamber in which the liquid escapes slowly, thus retarding the closing action to prevent slamming of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checking floor hinges"@en .

aat:300051320 a skos:Concept ;
    skos:definition "Door locks whose spring bolts are operated by one or more knobs, but whose dead bolts are actuated by a key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knob locks"@en .

aat:300051413 a skos:Concept ;
    skos:definition "Vertical passages through which dumbwaiters, lifts, or similar contrivances move from level to level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoistways"@en .

aat:300051474 a skos:Concept ;
    skos:definition "Systems that supply the heating, ventilation, and air conditioning to buildings and complexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "HVAC"@en .

aat:300051479 a skos:Concept ;
    skos:definition "Assemblies of interrelated equipment designed to provide heat to buildings and other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating systems"@en .

aat:300051480 a skos:Concept ;
    skos:definition "Threaded bolts having a round smooth head; prevented from rotating in their holes by a square neck directly under the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage bolts"@en .

aat:300051483 a skos:Concept ;
    skos:definition "Anchoring or fastening devices used in masonry, which expand within a predrilled hole as a bolt is tightened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expansion bolts"@en .

aat:300051485 a skos:Concept ;
    skos:definition "Straight, headless, usually steel bolts, having a wood thread on one end and machine thread on the other end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanger bolts"@en .

aat:300051487 a skos:Concept ;
    skos:definition "Bolts having a wrench head, usually square or hexagonal in shape, pointed and threaded like a wood screw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lag bolts"@en .

aat:300051488 a skos:Concept ;
    skos:definition "Common bolts each having a round or flat head and a slot for a screwdriver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove bolts"@en .

aat:300051489 a skos:Concept ;
    skos:definition "Specialized bolts of various types used for installing handrails on staircases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handrail bolts"@en .

aat:300051490 a skos:Concept ;
    skos:definition "Mechanical systems generating heat by the resistance of conductors to electric current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistance heating"@en .

aat:300051494 a skos:Concept ;
    skos:definition "Devices used to fasten the ends of joists to masonry walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joist anchors"@en .

aat:300051500 a skos:Concept ;
    skos:definition "HVAC systems fueled by heated water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot water heating"@en .

aat:300051501 a skos:Concept ;
    skos:definition "Hanging devices used to support pipes, designed to allow adjustment for pipes of various sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable pipe hangers"@en .

aat:300051505 a skos:Concept ;
    skos:definition "Systems for heating by radiation from a surface, especially from a surface heated by means of electricity, hot air, or hot water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiant heating"@en .

aat:300051508 a skos:Concept ;
    skos:definition "Two-part fastening devices, as on a garment, textiles, or moveable components such a doors, windows, or shutters consisting of a hook that catches over a bar or into a loop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooks and eyes"@en .

aat:300051512 a skos:Concept ;
    skos:definition "Systems supplying heat and hot water by the capture and conversion of radiant energy from the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar heating"@en .

aat:300051518 a skos:Concept ;
    skos:definition "Solar heating systems that include mechanical equipment and hardware to collect and transport heat; for solar heating systems without mechanical assistance, use \"passive solar heating.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "active solar heating"@en .

aat:300051520 a skos:Concept ;
    skos:definition "Solar heating systems that collect and transfer heat by the natural laws of convection, conduction, and radiation with little or no mechanical assistance; for solar heating systems utilizing mechanical devices to transfer heat, use \"active solar heating.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passive solar heating"@en .

aat:300051524 a skos:Concept ;
    skos:definition "Heating systems utilizing steam circulated through radiators and pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam heating"@en .

aat:300051529 a skos:Concept ;
    skos:definition "Steam heating systems that include vacuum pumps that separate air from condensation in the return main of the system, maintaining the pressure at a constant level and accelerating the circulation of steam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum heating"@en .

aat:300051531 a skos:Concept ;
    skos:definition "Heating systems in which warm air is distributed through a system of ducts and registers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warm air heating"@en .

aat:300051535 a skos:Concept ;
    skos:definition "Systems that use motor-driven fans or blowers to distribute heated air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forced air heating"@en .

aat:300051541 a skos:Concept ;
    skos:definition "Systems that introduce air into or remove air from spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ventilation"@en .

aat:300051547 a skos:Concept ;
    skos:definition "Ventilation that allows fresh air to enter a space through available or controlled openings and employs mechanical means such as fans to remove foul air from the same space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhaust ventilation"@en .

aat:300051551 a skos:Concept ;
    skos:definition "Systems supplying and exhausting fresh air by mechanical means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical ventilation"@en .

aat:300051554 a skos:Concept ;
    skos:definition "Ventilation systems that depend on natural atmospheric conditions and the manual operation of building openings, such as windows, doors, and transoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural ventilation"@en .

aat:300051557 a skos:Concept ;
    skos:definition "Building systems in which air is treated to control its temperature, humidity, cleanliness, or distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air conditioning"@en .

aat:300051563 a skos:Concept ;
    skos:definition "Air conditioning systems run from one or more centralized units that provide controlled air to an entire building or complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "central air conditioning"@en .

aat:300051566 a skos:Concept ;
    skos:definition "Air conditioning systems in which units can operate independently without the need for a central distribution system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incremental air conditioning"@en .

aat:300051632 a skos:Concept ;
    skos:definition "Building system for the lowering of air temperature, as for comfort, process control, or food preservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air cooling"@en .

aat:300051921 a skos:Concept ;
    skos:definition "Threaded nuts, used for alignment of an object, that are often coupled with a locking nut to secure them in position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjusting nuts"@en .

aat:300051922 a skos:Concept ;
    skos:definition "Screws, used for alignment of an object, that are often coupled with a locking nut to secure them in position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjusting screws"@en .

aat:300051923 a skos:Concept ;
    skos:definition "Fasteners used to secure the parts of a wall to some stable object, such as another wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor ties"@en .

aat:300051924 a skos:Concept ;
    skos:definition "In masonry work, brick or metal ties used to bind the angles or corners of the walls together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle bonds"@en .

aat:300051926 a skos:Concept ;
    skos:definition "Plates attached to an object to which accessories or structural members may be attached by welding, screwing, nailing, or bolting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor plates"@en .

aat:300051927 a skos:Concept ;
    skos:definition "Joints formed where two construction members meet at an angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle joints"@en .

aat:300051928 a skos:Concept ;
    skos:definition "Joints filled with mortar and located between masonry units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abreuvoirs"@en .

aat:300051930 a skos:Concept ;
    skos:definition "Flexible mechanical joints that allow the axis of one part to be set at an angle to the other by virtue of the design of the two components. One possesses a fixed spherical shell to accommodate the ball-shaped end of the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball joints"@en .

aat:300051932 a skos:Concept ;
    skos:definition "Intersections consisting of two pieces of molding where one is cut to fit the contour of the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coped joints"@en .

aat:300051933 a skos:Concept ;
    skos:definition "In carpentry, joints made by cutting a set of complementary cuts, usually three or more, in two pieces of wood, in such a way that they interlock when joined. A common use of finger joints is to form long pieces of lumber from shorter boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger joints"@en .

aat:300051936 a skos:Concept ;
    skos:definition "Butt-joints in which the edges of the boards are not square with their faces due to the pitch of the sides, as used to make a box having a wider top than bottom. Examples of items requiring hopper joints are hoppers, bins, chutes, and other items. The difficulty in making this joint is in laying out the pieces to obtain the proper angle for the edges to meet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hopper joints"@en .

aat:300051939 a skos:Concept ;
    skos:definition "In carpentry, right-angle joints comprising ends that are both mitered and rabbeted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbeted ledge-and-miter joints"@en .

aat:300051941 a skos:Concept ;
    skos:definition "In carpentry, right-angle joints that comprise one piece having a rabbet cut and another having a dado groove cut, produced in a way so the protruding rabbet fits into the groove of the opposing piece to form a joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dado and rabbet joints"@en .

aat:300051943 a skos:Concept ;
    skos:definition "Scarf joints between timbers with their ends fashioned to lock together positively and resist tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hook-and-butt joints"@en .

aat:300051944 a skos:Concept ;
    skos:definition "Arrangements and installation systems of lighting devices for particular effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting"@en .

aat:300051955 a skos:Concept ;
    skos:definition "Light other than daylight that is produced using any of various energy sources and human-made mechanisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial light"@en .

aat:300051958 a skos:Concept ;
    skos:definition "Any source of illumination powered by electricity, usually filaments or gas housed in glass bulbs or tubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric lighting"@en .

aat:300051961 a skos:Concept ;
    skos:definition "Any source of illumination by means of gas, usually a flame issuing from a jet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas-lighting"@en .

aat:300051964 a skos:Concept ;
    skos:definition "Use with reference to the natural light of day; for the direct light of the sun specifically, use \"sunlight.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daylight"@en .

aat:300051980 a skos:Concept ;
    skos:definition "Lighting techniques in which 90 to 100 percent of the light is directed toward the surface to be illuminated; usually downward light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct lighting"@en .

aat:300051982 a skos:Concept ;
    skos:definition "Lighting of an object or work plane primarily from a specific and preferred direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "directional lighting"@en .

aat:300051994 a skos:Concept ;
    skos:definition "Lighting from units that direct 40 to 60% of their emitted light upward, and the remainder downward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general diffuse lighting"@en .

aat:300051996 a skos:Concept ;
    skos:definition "Lighting techniques providing substantially uniform levels of illumination throughout an area exclusive of special local requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general lighting"@en .

aat:300051998 a skos:Concept ;
    skos:definition "Lighting achieved by directing 90 to 100% of the light toward a ceiling, wall, or other reflecting surface, rather than directly at the area to be illuminated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indirect lighting"@en .

aat:300052002 a skos:Concept ;
    skos:definition "Lighting technique that distributes illumination over a relatively limited area or confined space without significantly altering the illumination of its general surroundings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local lighting"@en .

aat:300052009 a skos:Concept ;
    skos:definition "Lighting technique providing additional quality and quantity of illumination to supplement the general lighting system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supplementary lighting"@en .

aat:300052015 a skos:Concept ;
    skos:definition "Lighting systems for the illumination of building elements, spaces, or exteriors for visual effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural lighting"@en .

aat:300052025 a skos:Concept ;
    skos:definition "Lighting systems supplying light outdoors for safety, pleasure, or information, as for playing fields, highways, or advertising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior lighting"@en .

aat:300052027 a skos:Concept ;
    skos:definition "Lighting arrangements to illuminate indoor spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior lighting"@en .

aat:300052030 a skos:Concept ;
    skos:definition "Lighting systems comprising light sources shielded by a panel set parallel to the wall and attached to the ceiling to distribute light over the wall; generally used for visual effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornice lighting"@en .

aat:300052032 a skos:Concept ;
    skos:definition "Indirect lighting systems comprising light sources shielded by vertical or horizontal ledges or recesses attached to walls and distributing light over the ceiling and upper and side walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cove lighting"@en .

aat:300052034 a skos:Concept ;
    skos:definition "Lighting arrangements with light sources shielded by a panel parallel to the wall and set at the top of windows; light may be directed upward or downward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valance lighting"@en .

aat:300052036 a skos:Concept ;
    skos:definition "Utility that provides lighting to an urban area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal lighting"@en .

aat:300052040 a skos:Concept ;
    skos:definition "Utility consisting of lighting typically attached to a series of tall poles, are spaced at intervals along a public street or roadway, illuminated from dusk to dawn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street lighting"@en .

aat:300052051 a skos:Concept ;
    skos:definition "Lighting used in the production of theater, dance, opera and other performancing arts. In addition to basic lighting, modern stage lighting can also include special effects, such as lasers and fog machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stage lighting"@en .

aat:300052056 a skos:Concept ;
    skos:definition "Building lighting systems that supply illumination essential to the safety of life and property in the event of failure of normal supply."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency lighting"@en .

aat:300052062 a skos:Concept ;
    skos:definition "Emergency lights above exit doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exit lights"@en .

aat:300052064 a skos:Concept ;
    skos:definition "Illumination directed at a specific target area for aiding visual tasks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "task lighting"@en .

aat:300052081 a skos:Concept ;
    skos:definition "Devices for removing undesirable gaseous or solid particles from ambient air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air filters"@en .

aat:300052090 a skos:Concept ;
    skos:definition "Devices for removing pollutants from the air in a system by passing it through various screens and dry porous materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry filters"@en .

aat:300052092 a skos:Concept ;
    skos:definition "Air-cleaning filters that employ a surface covered with a viscous oil or fluid, to which dirt particles and other airborne impurities cling as the air passes through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viscous impingement filters"@en .

aat:300052107 a skos:Concept ;
    skos:definition "Devices, such as fans or blowers, that distribute a conditioned air supply to a room or space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-handling units"@en .

aat:300052109 a skos:Concept ;
    skos:definition "Heavy-duty fans, such as those for ventilating building shafts or forcing air through large ducted systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blowers"@en .

aat:300052114 a skos:Concept ;
    skos:definition "Devices, such as valves or gates, for controlling the flow of air in a ventilation system, or the flow of combustion gases in a chimney flue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dampers"@en .

aat:300052118 a skos:Concept ;
    skos:definition "That part of a ventilation system which includes supply and return air ducts and plenum chambers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air distribution systems"@en .

aat:300052122 a skos:Concept ;
    skos:definition "Outlets in an air supply duct for distributing and blending air in an enclosure, usually mounted in suspended ceilings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air diffusers"@en .

aat:300052124 a skos:Concept ;
    skos:definition "Includes any tubes or conduits for conveying air to and from enclosed spaces or corridors within a wall or other structure used for conveying air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air ducts"@en .

aat:300052126 a skos:Concept ;
    skos:definition "Grilles with damper assemblies covering the outlets of air distribution systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registers"@en .

aat:300052142 a skos:Concept ;
    skos:definition "Parts of air conditioning systems in which the air is freed from dust and given the desired humidity by means of a spray of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air washers"@en .

aat:300052148 a skos:Concept ;
    skos:definition "Refers to a wide range of pressure vessels in which water or other fluid is heated and then discharged to supply hot water for heating or steam for heating or power generation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boilers"@en .

aat:300052153 a skos:Concept ;
    skos:definition "Any heating unit in a hot water heating system in which water is heated before being circulated through pipes to radiators or baseboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot water boilers"@en .

aat:300052156 a skos:Concept ;
    skos:definition "Boilers that supply hot water or steam for space heating, processing, or power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam boilers"@en .

aat:300052159 a skos:Concept ;
    skos:definition "Air cooling systems in which cold water is circulated between mechanical refrigeration water chilling units and remote cooling equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chilled water systems"@en .

aat:300052161 a skos:Concept ;
    skos:definition "Piping or tubing in coils, spirals, or other various configurations, employed in cooling or heating systems to serve as heat exchangers. For the any general object genre designed as concentric rings or circles, use \"coils (object genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coils"@en .

aat:300052163 a skos:Concept ;
    skos:definition "Designates coiled arrangements of piping or tubing used to cool by transferring heat between one fluid and another or between a space and a refrigerant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooling coils"@en .

aat:300052165 a skos:Concept ;
    skos:definition "Coils that convert enegry into heat through means of electrical current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating coils"@en .

aat:300052168 a skos:Concept ;
    skos:definition "Coils designed to remove moisture from the air by condensation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dehumidifying coils"@en .

aat:300052176 a skos:Concept ;
    skos:definition "In refrigeration systems, the heat exchangers that remove heat from the refrigerant and transform a hot gas under pressure into a cool liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condensers"@en .

aat:300052180 a skos:Concept ;
    skos:definition "Outdoor structures frequently placed on roofs, through which warm water is circulated to cool it by evaporation and exposure to the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooling towers"@en .

aat:300052185 a skos:Concept ;
    skos:definition "Equipment used in systems that heat or cool areas and that have compression cycles and reverse refrigeration cycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat pumps"@en .

aat:300052193 a skos:Concept ;
    skos:definition "Devices for supplying or maintaining humidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humidifiers"@en .

aat:300052197 a skos:Concept ;
    skos:definition "Systems in which a refrigerant is compressed, condensed, and expanded as a means of removing heat from a cold reservoir; the heat is rejected elsewhere at a higher temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refrigerant systems"@en .

aat:300052201 a skos:Concept ;
    skos:definition "Portable or fixed apparatuses that furnish heat for warmth or cooking, commonly using coal, oil, gas, wood, or electricity as a source of power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoves"@en .

aat:300052208 a skos:Concept ;
    skos:definition "Furnaces that generate warm air for a heating system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warm air furnaces"@en .

aat:300052212 a skos:Concept ;
    skos:definition "Furnaces in which the high-temperature heat required is produced by electricity; used especially for forging alloys and refractory materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric furnaces"@en .

aat:300052223 a skos:Concept ;
    skos:definition "Furnaces for the production of heat by the combustion of oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil furnaces"@en .

aat:300052235 a skos:Concept ;
    skos:definition "Refers generally to the components of heating systems that distribute heat within rooms and spaces, usually by radiation or convection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-distributing units"@en .

aat:300052252 a skos:Concept ;
    skos:definition "Heating elements that are housed in special panels placed horizontally along the baseboards of a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baseboard units"@en .

aat:300052257 a skos:Concept ;
    skos:definition "Room heating units consisting of a heating device, often a finned tube, mounted in a metal enclosure with openings to allow the transfer of heat to the air, principally by convection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convectors"@en .

aat:300052261 a skos:Concept ;
    skos:definition "Use to designate a nest of pipes containing circulating water or steam for heating a room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiators"@en .

aat:300052267 a skos:Concept ;
    skos:definition "Openings or recesses in chimneys or walls in which fires may be built, as for heating or cooking; may also refer to low fireproof structures erected outdoors for cooking over open flames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplaces"@en .

aat:300052273 a skos:Concept ;
    skos:definition "Parts and components of fireplaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace components"@en .

aat:300052342 a skos:Concept ;
    skos:definition "Single, large stones forming the floors of fireplaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearthstones"@en .

aat:300052347 a skos:Concept ;
    skos:definition "Decorative frames around fireplace openings, sometimes including a shelf or ledge and decorative elements mounted above the opening, such as to support a mirror or painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantels"@en .

aat:300052384 a skos:Concept ;
    skos:definition "That part of a hearth on which the fire is built."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back hearths"@en .

aat:300052387 a skos:Concept ;
    skos:definition "Refers to the parts of hearths that project into rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "front hearths"@en .

aat:300052392 a skos:Concept ;
    skos:definition "Chimneys containing a number of flues, especially when rising as shafts above a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney stacks"@en .

aat:300052398 a skos:Concept ;
    skos:definition "Large chimneys through which smoke and gases of combustion are discharged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smokestacks"@en .

aat:300052407 a skos:Concept ;
    skos:definition "Portions of chimneys that project from the general wall plane into the room, often decorated with mantels and overmantels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney breasts"@en .

aat:300052411 a skos:Concept ;
    skos:definition "Uppermost cornices of masonry or other noncombustible material atop chimneys, either as an ornament or as a cover; for extra components specifically intended to cover flue openings, use \"chimney hoods.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney caps"@en .

aat:300052537 a skos:Concept ;
    skos:definition "Plumbing systems used to pump water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water distribution systems"@en .

aat:300052538 a skos:Concept ;
    skos:definition "Water distribution systems in which water is pumped to holding tanks above the points of use, thereby increasing water pressure through gravity; most often employed in tall buildings where municipal water supply lacks the pressure necessary for an upfeed system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downfeed systems"@en .

aat:300052540 a skos:Concept ;
    skos:definition "Water distribution systems in which water is forced upward by pumps or pressure within a main."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upfeed systems"@en .

aat:300052546 a skos:Concept ;
    skos:definition "Parts of building plumbing systems that carry away waste; for sewers designed to carry away waste in larger drainage systems, use \"sanitary sewers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanitary drainage systems"@en .

aat:300052551 a skos:Concept ;
    skos:definition "Systems used for conveying rainwater, surface water, condensate, cooling water, or similar liquid wastes, exclusive of sewage or industrial waste, to the storm sewer or other legal place of disposal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stormwater systems"@en .

aat:300052554 a skos:Concept ;
    skos:definition "Receptacles that separate and retain greases, oil, dirt, gravel, and all other substances lighter or heavier than the liquid waste that bears them, such as to prevent their entrance into the house sewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catch basins"@en .

aat:300052556 a skos:Concept ;
    skos:definition "Covered pits into which raw sewage is discharged, the liquid portion seeping or leaching into the surrounding porous soil, and the solids being retained in the pit to undergo partial decomposition before removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cesspools"@en .

aat:300052558 a skos:Concept ;
    skos:definition "Artificial reservoirs for the storage of water, typically water-tight tanks in a high part of a building or underground for the capture of rainwater or water from another source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cisterns"@en .

aat:300052560 a skos:Concept ;
    skos:definition "Any vertical pipes, including those within a building, that convey rainwater to sewers, drains, or the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downspouts"@en .

aat:300052564 a skos:Concept ;
    skos:definition "Artificial channels by means of which liquid or other matter is drained or carried off."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drains"@en .

aat:300052565 a skos:Concept ;
    skos:definition "Shallow channels positioned on a building for the purpose of collecting and diverting water from a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gutters"@en .

aat:300052572 a skos:Concept ;
    skos:definition "In plumbing and storm water systems, assemblies of pipes, tubes, and fittings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piping"@en .

aat:300052575 a skos:Concept ;
    skos:definition "Receptacles in plumbing or drainage systems, other than traps, intended to receive or discharge liquid or waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumbing fixtures"@en .

aat:300052581 a skos:Concept ;
    skos:definition "Receptacles designed to collect surface or rainwater from open areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "area drains"@en .

aat:300052586 a skos:Concept ;
    skos:definition "Drains that lead from the trap of a fixture to another drain pipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixture drains"@en .

aat:300052594 a skos:Concept ;
    skos:definition "Drains intended for conveying rainwater, subsurface water, condensate, cooling water, or other similar discharges, but not sewage or industrial waste, to points of disposal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm drains"@en .

aat:300052600 a skos:Concept ;
    skos:definition "The piping comprising the plumbing of a drainage system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drainage piping"@en .

aat:300052603 a skos:Concept ;
    skos:definition "Piping, typically PVC or metal, used in the contruction of drainage, waste, and ventitlation systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DWV piping"@en .

aat:300052607 a skos:Concept ;
    skos:definition "The principal supply pipes that feed all branches of a plumbing system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mains"@en .

aat:300052614 a skos:Concept ;
    skos:definition "Vertical mains of a system of soil, waste, or vent piping extending through one or more stories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacks"@en .

aat:300052617 a skos:Concept ;
    skos:definition "Vertical pipes or stacks in a plumbing system that convey the discharge from toilet fixtures; for stacks that convey the waste from fixtures other than toilets, use \"waste stacks\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil stacks"@en .

aat:300052619 a skos:Concept ;
    skos:definition "Vertical vent pipes installed primarily for the purpose of providing circulation of air to or from any part of the building drainage system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vent stacks"@en .

aat:300052621 a skos:Concept ;
    skos:definition "Vertical pipes or stacks in a plumbing system that convey wastes other than those from toilet fixtures; for stacks that convey the waste from toilet fixtures, use \"soil stacks\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waste stacks"@en .

aat:300052625 a skos:Concept ;
    skos:definition "Plumbing fixtures, usually in the form of tubs or basins, in which baths can be taken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathtubs"@en .

aat:300052630 a skos:Concept ;
    skos:definition "Bathroom fixtures used for hygienic washing of the genitals and posterior parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidets"@en .

aat:300052632 a skos:Concept ;
    skos:definition "Sinks used for washing the hands and face. For deep, relatively large sinks used for washing the arms and upper body, use \"wash sinks\"; for deep, large sinks used for washing laundry, use \"laundry trays.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavatories"@en .

aat:300052634 a skos:Concept ;
    skos:definition "Basins connected with a drain and usually a water supply for washing and drainage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sinks"@en .

aat:300052638 a skos:Concept ;
    skos:definition "Plumbing fixtures consisting typically of a water-flushed bowl with a toilet seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilets"@en .

aat:300052650 a skos:Concept ;
    skos:definition "Covered pits with open-jointed linings through which the septic tank effluent seeps or leaches into the surrounding soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seepage pits"@en .

aat:300052652 a skos:Concept ;
    skos:definition "Watertight reservoirs or tanks that receive sewage and by sedimentation and bacterial action effect a process of clarification and partial purification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "septic tanks"@en .

aat:300052657 a skos:Concept ;
    skos:definition "Tanks or pits, located below the normal grade of a gravity system, and that receive the discharge from drains or other wastes; must be emptied by mechanical means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sumps"@en .

aat:300052660 a skos:Concept ;
    skos:definition "Fittings or devices so designed and constructed as to provide, when properly vented, a liquid seal that will prevent the back passage of air without materially affecting the flow of sewage or waste water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traps"@en .

aat:300052669 a skos:Concept ;
    skos:definition "Appliances to make hot water, usually consisting of an electrical or gas heating unit under a tank in which water is heated and stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water heaters"@en .

aat:300052673 a skos:Concept ;
    skos:definition "Holding containers utilized to store water in private water supply systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water storage tanks"@en .

aat:300052675 a skos:Concept ;
    skos:definition "Traps integral with or serving plumbing fixtures and for interceptors serving as such traps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixture traps"@en .

aat:300052677 a skos:Concept ;
    skos:definition "Traps installed in building drains to prevent circulation of air between the plumbing system of the building and the building sanitary drainage system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house traps"@en .

aat:300052679 a skos:Concept ;
    skos:definition "Water heaters whose primary source of heat energy is the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar water heaters"@en .

aat:300052683 a skos:Concept ;
    skos:definition "Parts and components of HVAC systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "HVAC components"@en .

aat:300052727 a skos:Concept ;
    skos:definition "Mechanical and electrical systems that relay information within buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communication systems"@en .

aat:300052730 a skos:Concept ;
    skos:definition "Two-way direct communication systems for communicating within limited areas, such as office buildings or airplanes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intercom systems"@en .

aat:300052733 a skos:Concept ;
    skos:definition "Refers to a combination of devices designed to transmit, amplify, and reproduce sound, so as to make it audible to an audience in a public space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public address systems"@en .

aat:300052739 a skos:Concept ;
    skos:definition "Bells, gongs, buzzers, or sets of chimes that ring inside a building when their control, usually a button located adjacent to an entrance, is activated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorbells"@en .

aat:300052741 a skos:Concept ;
    skos:definition "Electrical or mechanical systems, installed in a building that sound a blast or bell when smoke or flames are detected; certain alarms are engineered to trigger sprinkler systems for added protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire alarm systems"@en .

aat:300052744 a skos:Concept ;
    skos:definition "Fire alarm systems that transmit an alarm over a municipal system to the fire station."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary fire alarm systems"@en .

aat:300052746 a skos:Concept ;
    skos:definition "Fire alarm systems that produce signals on the protected premises only, primarily to notify occupants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local fire alarm systems"@en .

aat:300052748 a skos:Concept ;
    skos:definition "Fire alarm systems operated from a central supervising station at the protected premises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proprietary fire alarm systems"@en .

aat:300052750 a skos:Concept ;
    skos:definition "Fire alarm systems in which the alarm signals are transmitted to an off-premises station, and then to a fire department."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remote-station fire alarm systems"@en .

aat:300052756 a skos:Concept ;
    skos:definition "Systems which include equipment that supplies a television signal to a building or complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television antenna systems"@en .

aat:300052758 a skos:Concept ;
    skos:definition "Parts and components of telecommunication systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telecommunication systems components"@en .

aat:300052763 a skos:Concept ;
    skos:definition "Sensors and interconnected monitoring equipment that detect fires or the effects of fires and activate alarm systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire detectors"@en .

aat:300052765 a skos:Concept ;
    skos:definition "Equipment that detects fire in the flame stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flame detectors"@en .

aat:300052768 a skos:Concept ;
    skos:definition "Components of fire alarm systems that are activated by the presence of smoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoke detectors"@en .

aat:300052771 a skos:Concept ;
    skos:definition "Detectors of fire and smoke that work by detecting ionized particles in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ionization detectors"@en .

aat:300052775 a skos:Concept ;
    skos:definition "Smoke detectors that work by detecting the obscuration of light by smoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoelectric smoke detectors"@en .

aat:300052778 a skos:Concept ;
    skos:definition "Fire detectors that sense the presence of heat sufficient to indicate the presence of an openly burning fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperature detectors"@en .

aat:300053004 a skos:Concept ;
    skos:definition "The process by which a liquid, or a mixture of gases and liquids, is drawn into and tends to fill permeable pores in a porous solid material; usually accompanied by a physical change, chemical change, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absorption"@en .

aat:300053005 a skos:Concept ;
    skos:definition "The decay of sound energy as its distance from the sound source increases, due to the conversion of the acoustic energy to heat generated in the medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound absorption"@en .

aat:300053006 a skos:Concept ;
    skos:definition "The taking up of the molecules of gases, dissolved substances, or liquids by the surfaces of solids and liquids with which they are in contact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adsorption"@en .

aat:300053007 a skos:Concept ;
    skos:definition "Fitting together various parts to make an operative whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assembling"@en .

aat:300053010 a skos:Concept ;
    skos:definition "The joining of two surfaces by means of a generally viscous, sticky composition such as an adhesive or through physical or chemical force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesion"@en .

aat:300053013 a skos:Concept ;
    skos:definition "Causing to adhere by or as if by means of a soft plastic mixture or composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pasting"@en .

aat:300053014 a skos:Concept ;
    skos:definition "Includes the process of binding or tying, usually by lapping one unit over another, as various masonry units, and holding or adhering together firmly by means of a binder or bond, as the fibers in paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonding"@en .

aat:300053015 a skos:Concept ;
    skos:definition "The action of attaching something firmly or securely to something else with a bond of any kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fastening"@en .

aat:300053016 a skos:Concept ;
    skos:definition "Fixing or attaching one thing to another with a metal pin or cylinder with a head, often joined or secured with a nut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolting"@en .

aat:300053017 a skos:Concept ;
    skos:definition "The action of fixing or fastening something with nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nailing"@en .

aat:300053018 a skos:Concept ;
    skos:definition "The action of fastening or assembling with pins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinning"@en .

aat:300053019 a skos:Concept ;
    skos:definition "Forming a permanent connection between two or more pieces of material by passing a rivet through aligned holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riveting"@en .

aat:300053020 a skos:Concept ;
    skos:definition "The action of attaching, closing, or securing with an inserted screw or screws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screwing"@en .

aat:300053021 a skos:Concept ;
    skos:definition "The action of securing or fastening with the use of staples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stapling"@en .

aat:300053022 a skos:Concept ;
    skos:definition "The uniting superposed layers of one or more materials, typically the fusing of thin sheets of plastic to the surfaces of paper or cardboard by means of heat and pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laminating"@en .

aat:300053025 a skos:Concept ;
    skos:definition "The action of joining two discontinuous lengths of material together into one, as in weaving together two ends of rope, making a joint in magnetic tape or film, or lapping two pieces of timber into a continuous length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splicing"@en .

aat:300053026 a skos:Concept ;
    skos:definition "The action of fastening one thing to another, or two or more things together, with a length of cord, string, rope, or other flexible line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tying"@en .

aat:300053027 a skos:Concept ;
    skos:definition "Removing dirt, surface coatings, accretions, discolorations, or other undesired matter from a substrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleaning"@en .

aat:300053028 a skos:Concept ;
    skos:definition "Cleaning method that removes soil, discolorations, or coatings through the action of certain materials which impact and abrade the surface under pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrasive cleaning"@en .

aat:300053036 a skos:Concept ;
    skos:definition "The act of removing the poison or effect of poison from something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detoxification"@en .

aat:300053037 a skos:Concept ;
    skos:definition "Freeing from infection especially by destroying harmful microorganisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disinfecting"@en .

aat:300053038 a skos:Concept ;
    skos:definition "Treating with a gas for the purpose of disinfecting or of destroying pests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fumigating"@en .

aat:300053040 a skos:Concept ;
    skos:definition "Cleaning oxide or flux from silver or other metals by the use of extremely dilute sulphuric acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickling"@en .

aat:300053041 a skos:Concept ;
    skos:definition "The application of a poultice, which is a substance with a soft, absorbent, or pasty consistency. For cleaning, the poultice is applied to an area in order to draw out a stain or remove other substances in a controlled manner. Poultices are also used in medical applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poulticing"@en .

aat:300053042 a skos:Concept ;
    skos:definition "Cleansing with water or other liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washing"@en .

aat:300053047 a skos:Concept ;
    skos:definition "The process of whitening or lightening the color of a material by means of oxidation through the use of chemicals or exposure to sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleaching"@en .

aat:300053048 a skos:Concept ;
    skos:definition "A gradual loss of color or intensity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fading"@en .

aat:300053049 a skos:Concept ;
    skos:definition "Process of applying a coloring matter that is in a solution or fine dispersion so that at least some of the coloring matter is taken up by the substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dyeing"@en .

aat:300053050 a skos:Concept ;
    skos:definition "Resist dyeing in which wax is used as the resist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batik"@en .

aat:300053051 a skos:Concept ;
    skos:definition "Technique of dyeing threads of a fabric in different colors so as to produce an image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiné technique"@en .

aat:300053053 a skos:Concept ;
    skos:definition "Dyeing cloth by repeatedly putting a resist on different parts of its pattern and placing it in successive dye baths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resist dyeing"@en .

aat:300053057 a skos:Concept ;
    skos:definition "A mode of dyeing in which the cloth is tied in different places, to prevent the parts from receiving the dye. It is done by hand create colored patterns in the fabric by gathering together many small portions of material and tying them tightly with string before immersing the cloth in the dyebath. The dye fails to penetrate the tied sections. After drying, the fabric is untied to reveal irregular circles, dots, stripes, or other shapes. Varicoloured patterns may be produced by repeated tying and dipping in additional colours. This hand method, common in India and Indonesia, has been adapted to machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie-dyeing"@en .

aat:300053058 a skos:Concept ;
    skos:definition "Process of applying a coloring matter that tinges and penetrates or combines with the substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staining"@en .

aat:300053059 a skos:Concept ;
    skos:definition "The action of imparting a color or shade to another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinting"@en .

aat:300053060 a skos:Concept ;
    skos:definition "The action or process of coating a surface such as a wall with whitewash: a powdered mineral substance such as calcium hydroxide or chalk suspended in water, often with size or other ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whitewashing"@en .

aat:300053063 a skos:Concept ;
    skos:definition "The process of consolidating or compressing substances to form a more dense unit, such as packing of the solid particles in freshly mixed concrete, mortar, or other mixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compaction"@en .

aat:300053067 a skos:Concept ;
    skos:definition "Inducing compaction in mortar or concrete by the use of a tamping rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puddling"@en .

aat:300053069 a skos:Concept ;
    skos:definition "Making incisions with a sharp-edged instrument, thus removing material or dividing something into parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting"@en .

aat:300053070 a skos:Concept ;
    skos:definition "Drilling or cutting out material left between adjacent holes in a row of closely spaced drill holes; process used especially in mining and quarrying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broaching"@en .

aat:300053072 a skos:Concept ;
    skos:definition "The action of cutting something by drawing a band or plate having a cutting edge of continuous teeth back and forth over the material to be cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawing"@en .

aat:300053073 a skos:Concept ;
    skos:definition "The action of cutting, clipping, or dividing something with scissors or a similar tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snipping"@en .

aat:300053074 a skos:Concept ;
    skos:definition "Cutting excess or irregular material, thereby reducing the size of an object. In the context of bookbinding, refers to the removal of a small amount of excess material from the edges of a book, either to remove the bolts and produce cut edges, or simply to make the page edges roughly even. For cutting or scraping away layers from the surface of something, use \"shaving.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimming"@en .

aat:300053075 a skos:Concept ;
    skos:definition "The trimming or cutting away of edges, as portions of a photograph or printed page. To trim; cutting down prints, photographs, or pages to a required size, often without regard for their original composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cropping"@en .

aat:300053077 a skos:Concept ;
    skos:definition "Rubbed or scuffed areas caused by a gradual loss of material on the surface due to rubbing, wearing, or scraping of an object or material against itself or another usually harder object or material. Abrasion may be a deliberate attempt to smooth, clean, or polish a surface. It may also be a deteriorative process that occurs over time as a result of weathering or handling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrasion"@en .

aat:300053079 a skos:Concept ;
    skos:definition "The action of shaving, forming, or reducing something with a hardened, usually metallic, tool with cutting ridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filing"@en .

aat:300053080 a skos:Concept ;
    skos:definition "Smoothing a surface with abrasive paper or cloth, either by hand or by machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanding"@en .

aat:300053081 a skos:Concept ;
    skos:definition "The process of loosening rock, or other hard-packed materials, with explosives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blasting"@en .

aat:300053082 a skos:Concept ;
    skos:definition "The blasting of a boulder by placing a quantity of explosives against it without confining the explosives in a drill hole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mud-capping"@en .

aat:300053083 a skos:Concept ;
    skos:definition "Splitting into pieces or smashing into parts or fragments, typically by a blow or stress and with suddenness or violence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breaking"@en .

aat:300053084 a skos:Concept ;
    skos:definition "The action of compressing something from its original shape in order to break, reduce, or destroy it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crushing"@en .

aat:300053085 a skos:Concept ;
    skos:definition "Refers to the action of physically destroying or deconstructing something; particularly aplied to a building or other structure that is pulled or knocked down, reduced to rubble or ruins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demolition"@en .

aat:300053087 a skos:Concept ;
    skos:definition "Process of ruining, demolishing, pulling to pieces, reducing to fragments, undoing, wasting, rendering useless, putting an end to a material object, structure, or other thing. May also refer to the ruining of an immaterial thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "destruction"@en .

aat:300053088 a skos:Concept ;
    skos:definition "Refers to the action of effacing, rubbing out, or removing something written, drawn, engraved, or recorded on any media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erasing"@en .

aat:300053090 a skos:Concept ;
    skos:definition "Pulverizing, polishing, wearing down, or sharpening by friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grinding"@en .

aat:300053091 a skos:Concept ;
    skos:definition "Process of grinding a material in a wet state, such as in preparation of paint pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "levigation"@en .

aat:300053092 a skos:Concept ;
    skos:definition "Inserting material into a hole, crack, or cavity. In the specific context of mosaic conservation, the application of mortar or other material into an area of loss of the mosaic surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filling"@en .

aat:300053093 a skos:Concept ;
    skos:definition "Filling or finishing with a grout. In the specific context of mosaic conservation, the introduction of a fluid binder-aggregate mixture into a void between preparatory layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grouting"@en .

aat:300053094 a skos:Concept ;
    skos:definition "The placing of fill composed of solids, liquids, and usually water. After placement, the liquid eventually drains, leaving the solid fill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic filling"@en .

aat:300053095 a skos:Concept ;
    skos:definition "In masonry, the final treatment of joints by the troweling of mortar or a puttylike filler into the joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointing"@en .

aat:300053096 a skos:Concept ;
    skos:definition "The rectifying of a defect in a plaster wall or mural painting by digging out the defective spot and filling it in with a plastic gesso, plaster of Paris, Keene's cement, or other similar material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spackling"@en .

aat:300053097 a skos:Concept ;
    skos:definition "Making a material or object firm, stable, or stationary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixing"@en .

aat:300053098 a skos:Concept ;
    skos:definition "Shaping, molding, or fashioning into a certain state or condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forming"@en .

aat:300053101 a skos:Concept ;
    skos:definition "Turning, pressing, or forcing with stress concentrated at specific points in order to form angular or curved forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bending"@en .

aat:300053104 a skos:Concept ;
    skos:definition "The act or process of making casts or of shaping in a mold; usually refers to pouring liquid material into a mold, as distinguished from pressing a material into a mold, for which prefer \"molding.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casting"@en .

aat:300053105 a skos:Concept ;
    skos:definition "An industrial process in which molten metal is solidified into a continuous length for further processing, rather than being formed into individual ingots. Molten metal is forced through a water-cooled die to create a two-dimensional profile of indeterminate length. The resulting material may then be cut into shorter lengths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous casting"@en .

aat:300053106 a skos:Concept ;
    skos:definition "Metal casting technique in which a molten metal (as a zinc, lead, or aluminum alloy) is forced into a die."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "die casting"@en .

aat:300053113 a skos:Concept ;
    skos:definition "A method of casting metal or glass in a mold, the cavity of which, or the positive of the form to be made, is formed with wax which is then melted or burned off, and displaced by molten metal or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost-wax process"@en .

aat:300053118 a skos:Concept ;
    skos:definition "A method of casting by the lost-wax process using a machine in which the mold revolves so that its cavity is filled with molten metal by centrifugal force and pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centrifugal casting"@en .

aat:300053119 a skos:Concept ;
    skos:definition "A casting technique in which metal is poured into a piece moldmade of a specific type of sand that is bound by clay (or oil or resinin modern foundries). The piece mold is made by ramming thesand around a rigid model or chef-modèle within stacked metalframes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand casting"@en .

aat:300053122 a skos:Concept ;
    skos:definition "Pinching together, often to make wavy or bent; also the process of drawing molten glass to form the neck of a vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crimping"@en .

aat:300053123 a skos:Concept ;
    skos:definition "The distortion of an object originally linear or planar so that it is curved or coiled in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curling"@en .

aat:300053124 a skos:Concept ;
    skos:definition "The process of shaping a heated or unheated material, such as plastic or metal, by forcing or pressing it through a dye or other shaping device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extrusion"@en .

aat:300053127 a skos:Concept ;
    skos:definition "The making of knurls, small protuberances, or knobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knurling"@en .

aat:300053136 a skos:Concept ;
    skos:definition "Forming by means of pressure, especially a steady, overall pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressing"@en .

aat:300053137 a skos:Concept ;
    skos:definition "The process of giving paper or cloth a flat, smooth, glossy, or embossed surface by running it between rollers under strong pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calendering"@en .

aat:300053138 a skos:Concept ;
    skos:definition "Forming objects by applying pressure with a tool, for example, shaping metal, including coins, with dies. For stamping that creates surface designs, use \"stamping (marking).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamping"@en .

aat:300053141 a skos:Concept ;
    skos:definition "A technique of pottery surface treatment in which an implement is pressed into wet clay using a rocking motion. Varied patterns may be achieved depending on the form of the tool, and direction or spacing of impressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocker stamping"@en .

aat:300053142 a skos:Concept ;
    skos:definition "The process of extending something flexible, such as a cord or piece of fabric, from one point to another, across a space, or over a form, for the purpose of drawing it taut or rigid or for making it larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretching"@en .

aat:300053144 a skos:Concept ;
    skos:definition "The working of a metal by means of hammer blows, or by bombardment, as with steel balls or shot, including the cleaning of a metal surface by bombardment, as with glass beads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peening"@en .

aat:300053145 a skos:Concept ;
    skos:definition "Giving a smooth finish to metal by striking lightly with a smoothly faced hammer, or to metal or other materials by passing through rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planishing"@en .

aat:300053146 a skos:Concept ;
    skos:definition "Finishing the cross section of a metal item to size or shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swaging"@en .

aat:300053149 a skos:Concept ;
    skos:definition "The act of shaping, marking, or decorating wood, stone, or another material by cutting or incising, typically using tools such as chisels and other blades. It refers to this process as it is applied to small-scale objects or to objects that are not considered art. \"Carving\" may also be considered a sculpture technique that is employed in the creation of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carving"@en .

aat:300053150 a skos:Concept ;
    skos:definition "Sculptural process in which the sculptor forms the image by cutting away from the block of stone, generally without working from a model. The concept of the work evolves and develops during the carving process and adaptation may be made according to the character of the stone found within the block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct carving"@en .

aat:300053151 a skos:Concept ;
    skos:definition "Refers to the making of holes in metal, wood, or other materials, and for making holes in the earth, as for drilling a well or for oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drilling"@en .

aat:300053152 a skos:Concept ;
    skos:definition "Sharpening edged tools with or as if with a whetstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honing"@en .

aat:300053153 a skos:Concept ;
    skos:definition "A process of making deep cuts in wood so that it may be bent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerfing"@en .

aat:300053154 a skos:Concept ;
    skos:definition "Processes for changing the size or shape of a workpiece by means of machine-operated cutting tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machining"@en .

aat:300053155 a skos:Concept ;
    skos:definition "In metalwork, the process of dressing a surface with various shapes of rotary cutters to produce a flat or grooved surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milling"@en .

aat:300053156 a skos:Concept ;
    skos:definition "Enlarging a round hole, as in a piece of metal, by means of a revolving-edge tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reaming"@en .

aat:300053157 a skos:Concept ;
    skos:definition "The act or process of marking with lines, scratches, or notches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scoring"@en .

aat:300053158 a skos:Concept ;
    skos:definition "The shaping of objects by means of cutting tools while the material from which the objects are made rotates rapidly on a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turning"@en .

aat:300053160 a skos:Concept ;
    skos:definition "Refers to the process of making still images appear to move, particularly by the technique of photographing drawings or objects in progressive stages of performing an action, so that movement is simulated when the images are projected as a series in quick succession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animation"@en .

aat:300053161 a skos:Concept ;
    skos:definition "Refers to the process of creating animated images by using computer-assisted or computer-generated techniques. It includes limited animation where only a part of the figure is animated, and sophisticated animation, where computers supply in-between drawings based on a limited number of hand-drawn images and digitized figures that can appear to move or rotate convincingly through space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer animation"@en .

aat:300053162 a skos:Concept ;
    skos:definition "Art of writing, particularly the creation of beautiful, elegant letters or flourishes by hand with a pen, either in unjoined characters or in cursive writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calligraphy"@en .

aat:300053163 a skos:Concept ;
    skos:definition "The science and practice of calculation and representation of a geographical area, usually on a flat surface such as a map or chart. It may involve the physical or geographical features, superimposition of political, cultural, or other non-geographical divisions, or the distribution of socio-economic, political, agricultural, meteorological, or other information. Each point in the representation will correspond to an actual geographical position according to a fixed scale or projection. The term map also apply to those who study and calculate similar representations of the positions of stars, planets, the surface of other planet, or the like. For the artistic process of making maps, use \"mapmaking (process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartography"@en .

aat:300053164 a skos:Concept ;
    skos:definition "The activity of creating \"cartoons (humorous images).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartooning"@en .

aat:300053165 a skos:Concept ;
    skos:definition "The art of making characters or designs in or with wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cerography"@en .

aat:300053167 a skos:Concept ;
    skos:definition "Methods employed in the act of drawing, such as contouring, cross-hatching, or stumping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing techniques"@en .

aat:300053168 a skos:Concept ;
    skos:definition "A technique, usually in watercolor, in which the design is derived from an accidental mark or blot. This technique was originally described by the watercolor painter Alexander Couzens in 1786."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blot drawing"@en .

aat:300053170 a skos:Concept ;
    skos:definition "Use generally for computer processing activities in which the output is in pictorial form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer graphics"@en .

aat:300053174 a skos:Concept ;
    skos:definition "The technique of drawing the contours of an object while looking at the object and not at the drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind contour drawing"@en .

aat:300053178 a skos:Concept ;
    skos:definition "The action of drawing or sketching casually or aimlessly, often while engaged in some other activity such as conversation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doodling"@en .

aat:300053179 a skos:Concept ;
    skos:definition "The technique that produces graphical representations of structures, machines, and their component parts that communicate the engineering intent of a technical design to the craftsman or worker who makes the product. Drafting is based on the concept of orthographic projection, which in turn is the principal concern of the branch of mathematics called descriptive geometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting"@en .

aat:300053182 a skos:Concept ;
    skos:definition "Image-making technique that uses smoke as a medium. Paper is held above candle flame and carbon deposits are allowed to collect on the paper, creating a smooth, slick texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fumage"@en .

aat:300053183 a skos:Concept ;
    skos:definition "Capturing in a few strokes the major forms of a figure, object, or composition. A method of drawing in which the artist responds to the action, gesture, and movement of the subject, not the details of structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gesture drawing"@en .

aat:300053195 a skos:Concept ;
    skos:definition "Creating a technical drawing, such as an elevation, with an indication of light and shadow, and sometimes of color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rendering"@en .

aat:300053203 a skos:Concept ;
    skos:definition "Processes that involve a photographic process (that is, employing light-sensitivity) to transfer an image, and then a separate process to produce a print that was never itself light-sensitive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomechanical processes"@en .

aat:300053204 a skos:Concept ;
    skos:definition "A type of photolithography in which the printing plate is prepared using a bichromate process. Unhardened gelatin areas hold water and thus resist greasy ink; hardened areas accept ink and hold it in the characteristic wormlike pattern of cracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collotype"@en .

aat:300053207 a skos:Concept ;
    skos:definition "An intaglio photomechanical process of reproducing an image or design, a combination of photography and etching. A metal printing plate is prepared using a bichromate process, leaving a gelatin resist of varying thickness. The plate is etched to form cells of varying depth able to hold different amounts of ink. Crucially, the gelatine in the photographic negative of the image acts as the acid resist when the image comes to be etched. Hand photogravure was very popular in the later 19th century, involves the photographic transfer of the image to a copper plate, prepared with aquatint to give it tone, into which the design is etched. The plate is hand-inked and printed as an ordinary intaglio plate. Machine photogravure, very much more common and commercial, uses a cross-line screen instead of aquatint to provide the tone, and a cylinder is employed rather than a plate. Very fast printing in large editions, for example of magazines, is possible with this technique. If done with an aquatint grain, prefer \"photoaquatint.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogravure"@en .

aat:300053218 a skos:Concept ;
    skos:definition "Printing processes in which the image prints from ink held in the recessed areas of the plate or block, which have been cut or etched away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intaglio printing"@en .

aat:300053224 a skos:Concept ;
    skos:definition "Shaping material, such as paper or sheet metal, between two plates, one with the design in relief and the other with the corresponding design recessed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "die stamping"@en .

aat:300053225 a skos:Concept ;
    skos:definition "The intaglio process in which the design is incised into a printing plate, usually a flat copper plate, with the aid of a graver or burin that is held in the palm of the hand and pushed against the copper to cut lines comprising V-shaped grooves. The plate is then inked up, wiped so that ink is retained in the grooves and then forced out under the pressure of the printing process to create lines on the paper. The technique was first developed in the early 15th century in Germany, probably by goldsmiths who wished to keep records of the designs they had engraved on their wares. The process is distinct from \"wood engraving (process),\" which is a process for relief printing; \"wood cut (process)\" refers to engraving wood blocks for printing. Historically, \"engraving\" has sometimes been used incorrectly to refer to all printmaking processes, particulalry any process employing printing plates. For the single step of incising an inscription or design into any surface, not only a printing plate, see \"engraving (incising).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engraving"@en .

aat:300053228 a skos:Concept ;
    skos:definition "Intaglio process in which a sharp needle scratches the plate creating a burr that yields a characteristically soft and velvety line in the final print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drypoint"@en .

aat:300053231 a skos:Concept ;
    skos:definition "Printing process that produces images in line and with little tonal quality; the plate, usually of copper, is incised using a burin, the slight burr produced is scraped away, and the plate is inked for intaglio printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line engraving"@en .

aat:300053233 a skos:Concept ;
    skos:definition "Intaglio process in which the surface of the plate is methodically roughened with a rocker to produce a dark background; areas may then be lightened using various scrapers; produces a printed image having a continuous tonal range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezzotint"@en .

aat:300053239 a skos:Concept ;
    skos:definition "Printmaking process that achieves tonal areas by directly engraving short flicks or dots, usually in conjunction with engraved or etched lines. For the 15th-century process of making relief-printed engravings with stippled areas, use \"dotted manner.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stipple engraving"@en .

aat:300053241 a skos:Concept ;
    skos:definition "Intaglio process in which the design is worked into an acid-resistant substance coating the metal printing plate; the plate is then exposed to acid, which etches the plate where the metal is exposed, to create lines and dark areas. For the single step of exposing the plate to acid, use \"biting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etching"@en .

aat:300053242 a skos:Concept ;
    skos:definition "An intaglio etching technique in which a metal plate is sprinkled with a finely-powdered resin (asphaltum, rosin, etc.); the plate is heated to melt the resin, then cooled, and placed in an acid bath. The acid lightly etches areas not covered with the resin. The results in a plate with fine pockmarks. The process was invented in the 1760s by J.B. LePrince. Aquatints were popular until the late 1830s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquatint"@en .

aat:300053243 a skos:Concept ;
    skos:definition "Aquatint process in which the image is drawn on the plate with a water-soluble solution; the plate is covered with a ground and submerged in water which dissolves the solution, lifts the ground, and exposes the image areas so the plate can be etched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lift-ground"@en .

aat:300053250 a skos:Concept ;
    skos:definition "The biting of a printing plate to such a degree that the printing area becomes substantially recessed and thereby productive of sharper definition and longer runs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep etching"@en .

aat:300053251 a skos:Concept ;
    skos:definition "Printing process in which the ground is mixed with a soft substance, such as tallow, allowing the rendering of textured lines and areas when the plate is etched. Sometimes, paper is placed over the grounded plate and drawn on, to pick up the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft-ground etching"@en .

aat:300053255 a skos:Concept ;
    skos:definition "Printing processes in which the image is printed from a flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planographic printing"@en .

aat:300053257 a skos:Concept ;
    skos:definition "Refers to any of various processes or techniques involving making, imitating, or reproducing objects, built works, or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copying"@en .

aat:300053264 a skos:Concept ;
    skos:definition "General term for the practice of reproducing relatively flat originals, most often documents, in a machine employing a light-sensitive process and usually at a one-to-one scale. In the early and mid-20th century, used regarding various specific processes; since the mid-20th century, most often used regarding xerography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photocopying"@en .

aat:300053265 a skos:Concept ;
    skos:definition "Printing process utilizing master sheets that release color through type indentations when a colorless chemical fluid is applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit duplicating"@en .

aat:300053268 a skos:Concept ;
    skos:definition "A method of producing multiple copies of documents from a specially prepared wax master. A particular kind of ink is forced through the cuts in the stencil and transferred to the paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mimeography"@en .

aat:300053271 a skos:Concept ;
    skos:definition "Planographic printing process in which a design is deposited on a stone or plate with a greasy substance and the surface is chemically treated to accept ink only in the greasy areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithography"@en .

aat:300053272 a skos:Concept ;
    skos:definition "Lithographic printing in colors by means of separate stones or plates for the various colors, with some colors printed over others, of a type used commercially in the latter half of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromolithography"@en .

aat:300053275 a skos:Concept ;
    skos:definition "A planographic photomechanical process that uses the same principle as lithography, the repulsion of oil and water, but uses a photographic process to transfer the image to the plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photolithography"@en .

aat:300053276 a skos:Concept ;
    skos:definition "A type of lithography in which the image is created on one surface and then transferred to a stone or plate for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transfer lithography"@en .

aat:300053277 a skos:Concept ;
    skos:definition "A printing process that consists of painting an image onto a plate and then laying a support on top to transfer the image. Only one impression can be made, although if enough of the original paint remains on the plate, subsequent prints can be made by reapplication. These prints are called ghosts or cognates, and no two prints will be alike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monotype"@en .

aat:300053279 a skos:Concept ;
    skos:definition "Printing method in which the image is transferred from a roller, plate, block, or stone to an intermediary, such as a rubber blanket or roller, then onto the paper or other final surface. It is a method used for printing a large number of impressions. If the original image is created by lithographic technique specifically, use \"offset lithography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset printing"@en .

aat:300053281 a skos:Concept ;
    skos:definition "Stencil technique of printing in which ink or dye is forced through a mesh, traditionally silk, on which a design has been formed by stopping out certain areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen printing"@en .

aat:300053285 a skos:Concept ;
    skos:definition "Printing processes in which the nonprinting areas of the block or plate are carved, engraved, or etched away, leaving the original plane surface raised so that ink is deposited and transferred to paper. Traditionally a woodcut technique, relief printing developed into letterpress for the printing of text and wood engraving to provide accompanying illustrations. It is one of the oldest printing techniques known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief printing"@en .

aat:300053288 a skos:Concept ;
    skos:definition "A process of relief etching, usually on zinc plates, used in the 19th century to reproduce existing printed material, including drawings and pages of type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anastatic printing"@en .

aat:300053289 a skos:Concept ;
    skos:definition "Printing from wooden blocks, as in block books before movable type, or from wood or occasionally metal blocks on textile. Sometimes used loosely with reference to relief printmaking processes; there prefer \"relief printing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block printing"@en .

aat:300053294 a skos:Concept ;
    skos:definition "Printing using the surface of a potato that has been sliced and carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potato printing"@en .

aat:300053296 a skos:Concept ;
    skos:definition "A relief process in which the design is cut into and printed from the plank side of a wood block; distinct from \"wood engraving (process),\" which is a relief process using the grain end of a wood block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodcut"@en .

aat:300053297 a skos:Concept ;
    skos:definition "The process of relief printing by which an image is photographically transferred to a plate for printing in such a way that either the light or the dark areas become susceptible to attack by an etchant. As contrasted with photogravure, the non-printing areas are etched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoengraving"@en .

aat:300053300 a skos:Concept ;
    skos:definition "Relief printing processes in which the nonprinting engraved lines form a white image on a black background. Most often used in reference to wood engraving and the dotted manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white line engraving"@en .

aat:300053303 a skos:Concept ;
    skos:definition "A relief process in which the design is cut into and printed from the grain end of a wood block; distinct from \"woodcut (process),\" which is a relief process using the plank side of a wood block. The process is considered engraving due due to the use of a burin to carve the image, though the result is a relief printing process like woodcut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood engraving"@en .

aat:300053310 a skos:Concept ;
    skos:definition "Refers to the specific step of corroding a material by the action of acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biting"@en .

aat:300053313 a skos:Concept ;
    skos:definition "Applying ink to a printing plate or block or through a stencil with a roller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling up"@en .

aat:300053316 a skos:Concept ;
    skos:definition "Applying a liquid, such as ink or paint, in a scattered, usually random pattern. For the similar technique resulting in a surface covered with fine specks, use \"spattering.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splashing"@en .

aat:300053317 a skos:Concept ;
    skos:definition "A procedure used to transfer small amounts of mixed printing ink to paper so as to examine the accuracy of the color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapping out"@en .

aat:300053319 a skos:Concept ;
    skos:definition "Various means of reproducing identical copies of graphic matter in a fixed form. Processes by which an image, pictorial or textual, is transferred, usually to paper or cloth, most often by means of a plate, block, stone, or screen. Use also for the making of photographic prints and, with computers, for the production of a paper copy of stored data. For the production of prints in a fine arts context, prefer \"printmaking.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing"@en .

aat:300053320 a skos:Concept ;
    skos:definition "Process of reprinting a plate or block to ensure a strong, fully printed image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double printing"@en .

aat:300053324 a skos:Concept ;
    skos:definition "Process of printing new matter over, or on the same sheet as, already printed matter, including one color over another to produce a mixture of the two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overprinting"@en .

aat:300053326 a skos:Concept ;
    skos:definition "In multicolor printing, the precise aligning of the plates or stencils, usually by means of registry marks so that each color successively printed will be aligned with the others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registration"@en .

aat:300053339 a skos:Concept ;
    skos:definition "Process in which matter printed by letterpress is dusted with powder and heated to make the lettering rise, thus giving an engraved appearance, as on business cards and stationery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermography"@en .

aat:300053341 a skos:Concept ;
    skos:definition "Photographic recording of a light field, rather than of an image formed by a lens, used to display a three-dimensional image of the holographed subject. Processes create three-dimensional appearing images by laser light; when properly viewed, the interference pattern recreates the pattern of light originally reflected by the subject. Allows multiple perspectives such that images in the background are obscured and revealed by those in the foreground as the angle of view changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holography"@en .

aat:300053342 a skos:Concept ;
    skos:definition "The inscribing or impressing of letters, often by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettering"@en .

aat:300053343 a skos:Concept ;
    skos:definition "Methods of paint application employed to create a specific effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting techniques"@en .

aat:300053347 a skos:Concept ;
    skos:definition "Technique of creating paintings by dripping or pouring paint in a semi-controlled manner onto the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drip painting"@en .

aat:300053348 a skos:Concept ;
    skos:definition "The technique of creating a broken or mottled effect with paint or ink on a relatively dry brush, allowing traces of the paper or underpainting to show through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry-brush painting"@en .

aat:300053349 a skos:Concept ;
    skos:definition "A technique of stroking paint lightly over a rough surface so that it covers the high spots and leaves the depressions untouched, thus creating a broken area of color with irregular spots of the color underneath showing through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragging"@en .

aat:300053353 a skos:Concept ;
    skos:definition "Technique of painting with pigments dispersed in molten wax. It is applied while warm to panels or murals with a brush or palette, and fixed by passing a heat source over the surface to fuse and permanently bond the paint. It is an ancient technique that was particularly popular in ancient Greece. The term derives from a Greek word meaning 'burnt in.' Although it fell into disuse in the 8th or 9th centuries C.E., there continue to be exponents of the technique today. For the technique of decorating clay, use \"encaustic decoration.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encaustic painting"@en .

aat:300053354 a skos:Concept ;
    skos:definition "The stage of encaustic painting in which the surface of a painting is heated so that the colors may be manipulated and blended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning in"@en .

aat:300053356 a skos:Concept ;
    skos:definition "The practice of applying layers of color rich in oil over an underpainting that contains less oil and is therefore less flexible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fat over lean technique"@en .

aat:300053357 a skos:Concept ;
    skos:definition "Mural painting technique in which dry pigments are ground with water then brushed onto wet or partially dry lime plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fresco painting"@en .

aat:300053360 a skos:Concept ;
    skos:definition "A method of oil painting in which the final effects are achieved in the initial application of paint as opposed to covering the canvas layer by layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alla prima"@en .

aat:300053364 a skos:Concept ;
    skos:definition "Fresco technique common in the latter half of the 16th century where painting was done on partially dry intonaco, with lime added to the colors to enhance their adherence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezzo fresco"@en .

aat:300053365 a skos:Concept ;
    skos:definition "A fresco method using equal parts of white slaked pit lime and marble grit. The surface is ironed with a hot iron to produce a gloss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stucco-lustro technique"@en .

aat:300053366 a skos:Concept ;
    skos:definition "Technique of applying paint to the back of a sheet of glass in reverse order, that is, with details and highlights first and background last. The finished picture is viewed from the front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverse painting on glass"@en .

aat:300053367 a skos:Concept ;
    skos:definition "The removal of granulation by scraping or friction; in painting refers especially to the creation of forms and textures by scraping a wet painted surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grattage"@en .

aat:300053368 a skos:Concept ;
    skos:definition "Application of paint in thick, opaque masses, usually with a well-loaded brush or a palette knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impasto"@en .

aat:300053371 a skos:Concept ;
    skos:definition "In painting, the technique of creating a special textural effect resembling that of the dragging stroke, by layering a sheet of cloth or paper on the surface of wet paint, rubbing lightly, and lifting away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifting"@en .

aat:300053372 a skos:Concept ;
    skos:definition "Refers to the process of rubbing oil into a painting, especially popular in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oiling out"@en .

aat:300053373 a skos:Concept ;
    skos:definition "The technique of applying a coat of opaque or semiopaque color to a painting with a nearly dry brush to make an image less defined or brilliant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scumbling"@en .

aat:300053374 a skos:Concept ;
    skos:definition "Technique of painting a mural in which an aqueous pigment slurry, often pigments mixed with egg as a medium, is applied to dry plaster. It produced a painting of shorter longevity than buon fresco. Fresco secco was sometimes applied over buon fresco painted regions to correct mistakes or to add details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fresco secco"@en .

aat:300053376 a skos:Concept ;
    skos:definition "A method of painting which produces soft stains or blots of color through the use of heavily diluted paint on unsized canvas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soak-stain technique"@en .

aat:300053377 a skos:Concept ;
    skos:definition "Applying paint or ink so as to cover a surface with irregular, sparse patterns of fine specks. Use \"splashing\" when the paint or ink more randomly covers wide areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spattering"@en .

aat:300053378 a skos:Concept ;
    skos:definition "Process of marking a surface with small flicks or dots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stippling"@en .

aat:300053386 a skos:Concept ;
    skos:definition "Painting of images in monochrome, usually gray tones; employed in paintings, stained glass, enamels, and on pottery and other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grisaille"@en .

aat:300053388 a skos:Concept ;
    skos:definition "Painting carried out entirely in black ink, with no additional color but often giving the impression of color through manipulation of tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sumi-e"@en .

aat:300053400 a skos:Concept ;
    skos:definition "The application of a first coating, such as size, ground, paint, or varnish, to a surface that is to be painted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "priming"@en .

aat:300053402 a skos:Concept ;
    skos:definition "The technique or activity of executing the lay-in of a painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laying in"@en .

aat:300053405 a skos:Concept ;
    skos:definition "A method of painting by means of a small, finely controllable mechanical paint sprayer; used also in the retouching of photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airbrushing"@en .

aat:300053411 a skos:Concept ;
    skos:definition "Refers to the application of paint to a surface with a revolving paint roller covered in an absorbent material. The technique allows for rapid coverage of large areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller painting"@en .

aat:300053412 a skos:Concept ;
    skos:definition "A drawing technique of blending or smudging the applied medium, such as charcoal, soft pencil, pastel, chalk, or crayon, by using a cigar-shaped implement called a \"stump.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stumping"@en .

aat:300053414 a skos:Concept ;
    skos:definition "The technique of contrasting light and dark within a picture, especially one in which the forms are largely determined, not by sharp outlines, but by the meeting of lighter and darker areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiaroscuro"@en .

aat:300053417 a skos:Concept ;
    skos:definition "In pictorial representation, the diminishing of certain dimensions of an object or figure in order to indicate its recession into the pictorial space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foreshortening"@en .

aat:300053418 a skos:Concept ;
    skos:definition "Painting or drawing technique in which the rendition of forms is completed by raising the value of appropriate areas with white or pale color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heightening"@en .

aat:300053420 a skos:Concept ;
    skos:definition "Refers to a system based on projective geometry and used in art, architecture, cartography and other disciplines for representing three-dimensional objects or spaces on a two-dimensional surface by following strict conventions by which imaginary sight lines project from the observer's eye to the object, transmitting an image of the object to an intervening transparent surface, which is the picture plane. The mathematical requirement of a projection is that every point in the object and the corresponding point in the image must lie on a straight line, the projection ray; projection rays typically pass through the center of the projection. In many cases, the center of the projection is assumed to be infinitely distant from the object, so that all projection rays are parallel rather than converging as they recede in space. Although its meaning overlaps somewhat with \"perspective,\" \"projection\" is used for technical and architectural drawings that emphasize the mathematical properties of objects that are preserved in the images; \"perspective\" is used for art works and renderings that include the distortions of lengths, angles, shapes, and straightness of lines that optically appear to occur as objects recede into space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projection"@en .

aat:300053421 a skos:Concept ;
    skos:definition "In oil painting, the creation of soft, delicately blended effects by the fusion of one tone into another, particularly in glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sfumato"@en .

aat:300053422 a skos:Concept ;
    skos:definition "The darkening of areas of a picture to indicate shadows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shading"@en .

aat:300053423 a skos:Concept ;
    skos:definition "In photographic processing, converting some or all of the silver in a black-and-white image using inorganic salts or mordant dyes, and usually altering the overall tone of the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toning"@en .

aat:300053426 a skos:Concept ;
    skos:definition "Technique of transferring pictures and designs from specially prepared paper onto a surface, such as glass, and the Surrealist painting technique in which one freshly painted or inked surface is pressed against another to form an image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decalcomania"@en .

aat:300053427 a skos:Concept ;
    skos:definition "The technique of copying a drawing by pricking holes in the outlines and using fine chalk or graphite powder to transfer these to a surface beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pouncing"@en .

aat:300053430 a skos:Concept ;
    skos:definition "The technique of making a rubbing from a textured surface, especially when the rubbing is then incorporated into a collage or montage; popular among the Surrealists as a form of automatism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frottage"@en .

aat:300053431 a skos:Concept ;
    skos:definition "A method for transferring a drawing to another surface on a different scale, especially to a larger surface that is to be painted, such as a canvas or a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squaring"@en .

aat:300053436 a skos:Concept ;
    skos:definition "Stencil process for making colored prints or adding color to printed illustrations; usually where a monochrome print is colored by hand using a series of stencils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pochoir"@en .

aat:300053439 a skos:Concept ;
    skos:definition "Copying from an original by drawing over it onto a transparent or translucent piece of paper, cloth, or other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracing"@en .

aat:300053443 a skos:Concept ;
    skos:definition "Refers to the activity of taking photographs from aircraft. The term may also be used to refer to any photography from the air, including photographs obtained by cameras mounted on aircraft, rockets, or Earth-orbiting satellites and other spacecraft. The purpose of photography from airborne or spaceborne vehicles is generally to provide information on ground features for military and other reconnaissance, or to record the dimensional disposition of such features for surveying or mapmaking. To refer specifically only to photography taken from beyond the Earth's atmosphere, use \"space photography\"; for photography of celestial phenomena, use \"astronomical photography.\" When emphasis is on the view achieved by photographing from aircraft or other high locations, use \"aerial views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial photography"@en .

aat:300053446 a skos:Concept ;
    skos:definition "Photography or cinema utilizing shots taken at short range in order to magnify detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close-up photography"@en .

aat:300053448 a skos:Concept ;
    skos:definition "Photography that takes place in an indoor setting, often employing lighting of some sort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor photography"@en .

aat:300053449 a skos:Concept ;
    skos:definition "Photography that takes place at night, typically outside, and often with emphasis on the existing light, such as neon signs, street lights, or stars"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night photography"@en .

aat:300053450 a skos:Concept ;
    skos:definition "The making of radiographs, images produced on photographic film by a radiation other than light, especially x-rays or gamma rays. Modern radiography systems are moving away from x-ray sensitive film to produce these images, with a digital plate replacing film. For the science or practice of dealing with x-rays or nuclear radiation in general, use \"radiology.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiography"@en .

aat:300053451 a skos:Concept ;
    skos:definition "Process that records the location and distribution in an object of radioactive substances, or those made radioactive in order to be detected, when radiation from these substances act on a photographic emulsion placed in close contact with the object. When used on a painting, identifies areas of pigments through elemental half lives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autoradiography"@en .

aat:300053452 a skos:Concept ;
    skos:definition "Photography of distant objects using either a telephoto lens or a telescope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephotography"@en .

aat:300053454 a skos:Concept ;
    skos:definition "Refers to the activity of taking photographs while below the surface of water, often occuring in tandem with activities such as scuba diving, snorkeling, swimming, or from a submersible or remotely operated underwater vehicle. Either waterproof cameras or dry work cameras stored in waterproof housings are used to produce underwater photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater photography"@en .

aat:300053459 a skos:Concept ;
    skos:definition "Refers to the technique of taking photographs that utilize natural and artificial light sources that are present at a scene, and excludes light sources produced or supplied by the photographer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "available light photography"@en .

aat:300053462 a skos:Concept ;
    skos:definition "Still photography in which the camera shutter operates at a speed much higher than normal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-speed photography"@en .

aat:300053464 a skos:Concept ;
    skos:definition "Quasi-photographic techniques to record different densities in a gas as a pattern of colored bands of light and dark; frequently used to record patterns of radiated heat; not all forms of this technique require a camera and lens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schlieren photography"@en .

aat:300053465 a skos:Concept ;
    skos:definition "Refers to the photographic technique of recording images using light from the ultraviolet (UV) segment of the electromagnetic spectrum (400-40 nanometers). Objects are photographed from the reflection of UV radiation or its transmission through them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet photography"@en .

aat:300053471 a skos:Concept ;
    skos:definition "Photomechanical process in which gelatin relief matrices are made by a bichromate process from color separation negatives or positives; a full-color print is then made by transferring dye from the matrices, in register, to a support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dye transfer process"@en .

aat:300053472 a skos:Concept ;
    skos:definition "Variant of the daguerreotype process devised by Claude-Abel Niépce de St. Victor, distinguished by the use of silver chloride to produce natural color. The image cannot be fixed, and therefore is impermanent. In the early 20th century, sometimes used to mean color photography in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliochromy"@en .

aat:300053484 a skos:Concept ;
    skos:definition "William Henry Fox Talbot's process to make negatives on paper; the image is formed from silver iodide coated on the base without a binder and is developed. The calotype process produced a translucent original negative image from which multiple positives could be made by simple contact printing. This gave it an important advantage over the daguerreotype process, which produced an opaque original positive that could only be duplicated by copying it with a camera. In the mid-20th century, the term was sometimes used incorrectly for any salted paper or paper negative process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calotype"@en .

aat:300053489 a skos:Concept ;
    skos:definition "Printing process based on light-sensitive diazonium compounds, most often used to reproduce technical drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diazo process"@en .

aat:300053490 a skos:Concept ;
    skos:definition "An iron process for making prints using a light-sensitive emulsion of a ferric salt and silver nitrate. When developed, a metallic silver image is formed; various developers can produce black, brown, purple, or maroon tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kallitype"@en .

aat:300053492 a skos:Concept ;
    skos:definition "An iron process for making photographic prints in which platinum is reduced from a salt to form the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platinum process"@en .

aat:300053494 a skos:Concept ;
    skos:definition "An iron process for making photographic prints in which palladium is reduced from a salt to form the image. Similar to the platinum process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palladium process"@en .

aat:300053495 a skos:Concept ;
    skos:definition "Photographic processes in which the light-sensitive salt is formed in the fibers of the paper rather than in a binder. Sometimes designed to be developed out, as in the calotype process, and sometimes printed out, as when making salted paper prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salted paper processes"@en .

aat:300053498 a skos:Concept ;
    skos:definition "Photographic processes in which images are formed using pigments rather than silver or other metal. Common pigments included lampblack, watercolor pigments, oil paints, and oil-based inks. The pigments themselves are not light-sensitive; the photochemical action of another transparent agent makes a support bind, attract, or receive pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigment processes"@en .

aat:300053499 a skos:Concept ;
    skos:definition "Processes for making photographic prints using a bichromate compound which, when exposed to light, causes its colloid binder to harden; unhardened areas are washed or abraded away. Pigments may be incorporated before exposure or during development. Though the expression dichromate is now preferred in chemistry, bichromate remains common usage in photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bichromate processes"@en .

aat:300053500 a skos:Concept ;
    skos:definition "Printing process in which powdered carbon is used as a pigment to form an image, particularly when the process employs sensitized carbon tissue on gelatin. The process was patented by Joseph Wilson Swan in 1864, his work having been base on the work of A. L. Poitevin; it was actively exploited in England by the Autotype Company, who acquired Swan's patent rights in 1868. The process depends upon the hardening action of light on bichromated gelatin, whereby sheets of pigmented gelatin are used to transfer images to a paper support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon process"@en .

aat:300053501 a skos:Concept ;
    skos:definition "A process to make photographic prints using a colloid emulsion of bichromated gum arabic as the binder and pigment as the final image material. The image is formed as the emulsion hardens in relation to exposure and is developed by washing away the unhardened emulsion to reveal the support, forming the highlights and midtones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum bichromate process"@en .

aat:300053505 a skos:Concept ;
    skos:definition "Photographic process that is a variant of the oil process in which the developed silver in a gelatin print is used as a catalyst to tan the gelatin. The untanned highlights become saturated when the print is soaked in water and will resist a greasy ink, while the tanned shadows accept the ink. The original print may be the end product or may be used as a master for transferring the image to another support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bromoil process"@en .

aat:300053506 a skos:Concept ;
    skos:definition "A carbon process to produce photographic prints in which the carbon transfer tissue is made sensitive when placed in contact with a developed silver bromide print. Distinguished from the \"carbon process\" by the chemical method for hardening the carbon transfer tissue and by the use of a silver bromide print, which allows carbro prints to be made from smaller negatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbro process"@en .

aat:300053509 a skos:Concept ;
    skos:definition "A photomechanical process that produces continuous tone images in slight relief. A gelatin relief is prepared by a bichromate process and then used to make an intaglio plate. This plate is used as a mold and is filled with pigmented gelatin; the gelatin layer is then pressed onto a paper support. Widely used for fine book illustration from about 1875 to 1900."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Woodburytype"@en .

aat:300053525 a skos:Concept ;
    skos:definition "A photographic process employing silver in a gelatin binder on a glass photographic plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin dry plate process"@en .

aat:300053530 a skos:Concept ;
    skos:definition "Process that produces a direct positive image on a silver-coated copper plate, invented by Louis-Jacques-Mandé Daguerre of France and Joseph-Nicéphore Niepce in the 1830s. In the process, a copper plate is coated with silver iodide and exposed to light in a camera, then fumed with mercury vapour and fixed with common salt in solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daguerreotype"@en .

aat:300053531 a skos:Concept ;
    skos:definition "A variant of the wet collodion process producing a direct positive image on a thin sheet of lacquered metal (usually iron, never tin)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tintype"@en .

aat:300053535 a skos:Concept ;
    skos:definition "Refers to the making of chronophotographs, recording motion or change with a still camera of a series of photographic images, either discrete photographs taken sequentially or a single exposure capturing movement, with a blurred effect on the images of the people and objects moved. Not to be confused with \"cinematography,\" which is the photography of people and objects in motion with a motion picture camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronophotography"@en .

aat:300053539 a skos:Concept ;
    skos:definition "Photographic processes that incorporate a screen of minute lenses into the film or print. Used for both stereoscopic photographs and to create the illusion of motion in static images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lenticular processes"@en .

aat:300053540 a skos:Concept ;
    skos:definition "Technique of taking a series of photographs at set intervals to record changes that take place slowly with time, such as the growth of a plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time-lapse photography"@en .

aat:300053544 a skos:Concept ;
    skos:definition "Procedures for making a latent photographic image visible and then fixing it (making it insensitive to further changes from light)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developing"@en .

aat:300053545 a skos:Concept ;
    skos:definition "Printing techniques in which light is obstructed or reduced in selective portions of the image, lessening exposure (and resulting density) in those areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dodging"@en .

aat:300053550 a skos:Concept ;
    skos:definition "Techniques to photograph subjects that can be viewed only with the aid of a microscope or other magnifier. For the production and use of microforms generally, use \"micrographics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microphotography"@en .

aat:300053555 a skos:Concept ;
    skos:definition "Photographic processing procedure in which a print having a gelatin emulsion layer is dried in contact with a polished surface so that the gelatin retains a highly glazed surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrotyping"@en .

aat:300053557 a skos:Concept ;
    skos:definition "Photographic processing procedure used to increase the density of a processed negative or print to enhance overall density or contrast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intensification"@en .

aat:300053564 a skos:Concept ;
    skos:definition "Reducing the density of a negative or print by dissolving some of the silver forming its image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reduction"@en .

aat:300053567 a skos:Concept ;
    skos:definition "Attaching a drawing, print, photograph, or other work of art done on paper to a cardboard or other backing by using a thermoplastic tissue as an adhesive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry mounting"@en .

aat:300053569 a skos:Concept ;
    skos:definition "A photographic process usually used for reproducing technical drawings. The image is formed using aniline dyes and appears blue-black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aniline process"@en .

aat:300053575 a skos:Concept ;
    skos:definition "The technique of scratching designs or images into a dry plaster surface which has been covered with a thin or moderately thick lime wash layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry sgraffito"@en .

aat:300053576 a skos:Concept ;
    skos:definition "Working out or recording the chief features of a visual form, usually but not necessarily by drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sketching"@en .

aat:300053577 a skos:Concept ;
    skos:definition "The procedure of marking or coloring the skin by pricking in coloring matter so as to form indelible marks as figures or by production of scars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tattooing"@en .

aat:300053578 a skos:Concept ;
    skos:definition "Generally, the action or process of determining or calculating a length, quantity, value, magnitude, extent, or other designation of dimensions, size, weight, number, or volume of an object or group of objects, person, animal, plant, plot of land, or other thing, typically by the application of an instrument or device marked in standard units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring"@en .

aat:300053580 a skos:Concept ;
    skos:definition "Refers to the technique of making measurements by using photography. It usually refers to this technique as applied to mapmaking, measuring site elements, and surveying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogrammetry"@en .

aat:300053581 a skos:Concept ;
    skos:definition "Technique of using photographs to measure, survey, or map the Earth's surface, specifically employing aerial photographs, which are photographs obtained by cameras mounted on aircraft, rockets, or Earth-orbiting satellites and other spacecraft. The technique typically uses an overlapping series of photographs taken from an aircraft following a systematic flight pattern at a fixed altitude."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial photogrammetry"@en .

aat:300053582 a skos:Concept ;
    skos:definition "Any process of measuring sensitivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sensitometry"@en .

aat:300053584 a skos:Concept ;
    skos:definition "Refers to measuring the sensitivity of photographic film, specifically recording the film’s response to light exposure and silver formation in development. The process entails exposing film to graduated levels of light, recording the density of produced-silver deposit and plotting this data on a graph against the logarithm of the exposure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic sensitometry"@en .

aat:300053585 a skos:Concept ;
    skos:definition "Refers to the process of combining together separate constituents to form one cohesive substance or mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixing"@en .

aat:300053586 a skos:Concept ;
    skos:definition "Mingling or combining so that the separate constituents or the line of demarcation cannot be distinguished. In painting, includes the gradation of color so that two hues or values merge imperceptibly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blending"@en .

aat:300053592 a skos:Concept ;
    skos:definition "The process, involving various procedures done by hand or machine, of securing leaves or gatherings, usually within covers, to form a book. In book production, the process of assembling the finished book; the concept of securing the leaves of sections of a text so as to keep them in proper order and protect them"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinding"@en .

aat:300053594 a skos:Concept ;
    skos:definition "Method of bookbinding in which the free edges of double leaves are sewn together as the binding edge, with the folds at the fore edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traditional format"@en .

aat:300053595 a skos:Concept ;
    skos:definition "Bookbinding technique in which slanted cuts are made across the back edge of the text block, through which threads are passed and secured by adhesive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saw-kerf binding"@en .

aat:300053596 a skos:Concept ;
    skos:definition "Method for bookbinding in which the entire thickness of the text block is sewn through with thread near the folds of the gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side sewing"@en .

aat:300053599 a skos:Concept ;
    skos:definition "Process of weaving with split rattan such as for seats or backs of chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caning"@en .

aat:300053600 a skos:Concept ;
    skos:definition "Describes the activity of creating and repairing devices that indicate or measure time. See “watch making” for making or repairing timepieces worn or carried as personal accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock making"@en .

aat:300053603 a skos:Concept ;
    skos:definition "The construction and repair of wooden vessels formed of staves and hoops, such as casks, buckets, barrels, and tubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coopering"@en .

aat:300053605 a skos:Concept ;
    skos:definition "The tearing away of parts of posters, or other materials, that have been applied in layers, so that selected portions of the underlayers contribute to the total image. To designate the resulting works, use \"affiches lacerérées.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "décollage"@en .

aat:300053606 a skos:Concept ;
    skos:definition "Describes the activity of producing and repairing movable objects that support various human activities in in a dwelling, business, or public space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture making"@en .

aat:300053610 a skos:Concept ;
    skos:definition "The making, designing or repairing of small arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunsmithing"@en .

aat:300053612 a skos:Concept ;
    skos:definition "Describes the activity of fabricating small objects, of any shape or material, pierced for threading or stringing"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beadmaking"@en .

aat:300053615 a skos:Concept ;
    skos:definition "Process of creating works in which pieces of hard, polished stone of varying shapes are set into marble or another hard surface to form a pattern. It differs from \"mosaic\" in that the pieces are not of uniform size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra dura"@en .

aat:300053618 a skos:Concept ;
    skos:definition "Describes techniques for creating three-dimensional objects with malleable or hard materials, such as clay, wood, stone, bronze, ivory, and found objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture techniques"@en .

aat:300053619 a skos:Concept ;
    skos:definition "The creation of scaled representations of objects or structures, usually three-dimensional and made of hard, nonmalleable material such as wood or stone. For the creation of malleable material such as wax or clay to create a form which is three-dimensional, see \"modeling\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model-making"@en .

aat:300053620 a skos:Concept ;
    skos:definition "Process of using nonglare wax to polish a sculpture or painting to reduce its shine; associated with the ancient Greeks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ganosis"@en .

aat:300053621 a skos:Concept ;
    skos:definition "A technique used by sculptors to reproduce a clay or plaster model or to copy a finished work through measurements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointing"@en .

aat:300053622 a skos:Concept ;
    skos:definition "Use to describe a surface that has been carved, molded, or stamped so that an image or design projects from or is sunk into a continuous surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief"@en .

aat:300053623 a skos:Concept ;
    skos:definition "Sculptural relief technique in which the projection of the forms is relatively shallow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bas-relief"@en .

aat:300053626 a skos:Concept ;
    skos:definition "Sculptural relief technique in which half or more than half of the natural circumference of the modeled form projects from the surrounding surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high relief"@en .

aat:300053628 a skos:Concept ;
    skos:definition "Preparing lifelike representations of animals by stuffing the skin or molding it around a model of the specimen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxidermy"@en .

aat:300053632 a skos:Concept ;
    skos:definition "Textile construction involving the interlocking of looped stitches, employing a single cord or strand of yarn and a single hooked needle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crocheting"@en .

aat:300053633 a skos:Concept ;
    skos:definition "Drawing loops of thread, yarn, or cloth through a supporting mesh into a pattern, usually to make a rug or wall hanging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooking"@en .

aat:300053634 a skos:Concept ;
    skos:definition "The forming and interlacing of loops by means of needles according to a prescribed manner or pattern, either by machine or by hand; most often used for textiles or costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting"@en .

aat:300053635 a skos:Concept ;
    skos:definition "Describes the act of interlacing or tying linear material to form knots, which in succession can produce decorative patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knotting"@en .

aat:300053636 a skos:Concept ;
    skos:definition "Refers to the technique of knotting cords or thick threads to create a coarse lace or decorative fringe. It is generally performed by using a padded cushion mounted on a wooden frame to secure the knot-bearing supporting cords or the hem of a piece of fabric. From the hem or a line of knot-bearing cords, long threads or cords are mounted by knots, and the long threads are then tied to each other with a variety of knots to form patterns or designs. Pins may be used to secure threads to the cushion while the piece is being worked. The technique was developed in 19th-century Genoa, Italy, but the term is derived from the Turkish word for \"towel,\" because the process was inspired by decorative fringes on Turkish towels and other fabrics. It is also based on the techniques used by 16th-century Italian artisans in the creation of \"punto a groppo.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macrame"@en .

aat:300053637 a skos:Concept ;
    skos:definition "Handicraft characterized by simple meshes of thread or cord joined by knots. It is of ancient origin and known in most cultures of the world. When produced under tension, it creates a stable fabric. In making the net, the thread is wound on an elongated shuttle or large needle; a mesh stick or gauge is used to maintain a uniform size of mesh. As the thread is looped round the gauge it is passed through a secondary loop to form a fisherman's knot or other non-slipping knot. The net can vary greatly in weight, shape, or size. It is used to make utilitarian objects, such as fishing nets, snares, and apparel, and as a foundation upon which to apply ornamentation, such as in the creation of lace or other textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "netting"@en .

aat:300053638 a skos:Concept ;
    skos:definition "Technique in which strands of pliable material, often three or four strands, are intertwined so as to form a plait, band, or rope. An example is in textile work, where flat over-and-under oblique interlacing is achieved using the undifferentiated elements of a single set of strands, characterized by the oblique crossings of the elements and their common directional trend. Other examples include in the making of leather items, basketmaking, and in styling of hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braiding"@en .

aat:300053641 a skos:Concept ;
    skos:definition "Making a distinctive type of lace by hand by looping and knotting with a single sewing thread and a small shuttle, making varied designs of rings and semicircles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tatting"@en .

aat:300053642 a skos:Concept ;
    skos:definition "Generally, the process of interlacing strands or strips of various materials, such as cane, textile, or twigs, to make materials or objects such as wicker, cloth, baskets, or wreaths. Specifically used for the process of making textile on a loom or other weaving device by interlacing warp and weft in a particular order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaving"@en .

aat:300053643 a skos:Concept ;
    skos:definition "Weaving on a loom or other device operated wholly or partly by hand or foot power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand weaving"@en .

aat:300053647 a skos:Concept ;
    skos:definition "Visual works comprising designs, patterns, or other arrangements of beads, typically stringed or attached to textile supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beadwork"@en .

aat:300053648 a skos:Concept ;
    skos:definition "Weft patterning technique of weaving raised patterns on a woven textile. For the process of stitching decorative designs into cloth, leather, or paper by hand or machine, use \"embroidering.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brocading"@en .

aat:300053650 a skos:Concept ;
    skos:definition "Activity of cutting, sewing, and creating ladies clothing, particularly dresses, coats, and shirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressmaking"@en .

aat:300053652 a skos:Concept ;
    skos:definition "Refers to any process or technique done with a needle and thread, such as sewing, stitching, smocking, quilting, and embroidery. In common usage, the term is sometimes used to refer to decorative work rather than plain sewing; however, to distinguish more decorative work from plain sewing, it is less ambiguous to use \"fancy needlework\" or a specific needlework technique, such as \"embroidery.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needleworking"@en .

aat:300053653 a skos:Concept ;
    skos:definition "Refers to the process in which a needle and thread or fine wire are used to stitch decorative designs into cloth, leather, paper, or other material. It may also refer to the process used to create machine-made imitations of hand-made embroidery. For the weft patterning technique of weaving raised patterns on a woven textile, use \"brocading.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidering"@en .

aat:300053654 a skos:Concept ;
    skos:definition "Embroidering a design by laying down a thread and fastening it with small stitches at regular intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couching"@en .

aat:300053655 a skos:Concept ;
    skos:definition "In embroidery and other needleworking, using one, two, or three threads for binding a raw edge on cloth or making an ornamental edge, finish, or hem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overstitching"@en .

aat:300053656 a skos:Concept ;
    skos:definition "Stitching together two or more layers of cloth, usually working the stitches into designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilting"@en .

aat:300053658 a skos:Concept ;
    skos:definition "Refers to the process of joining, attaching, repairing, enclosing, securing, or decorating cloth, leather, or other flexible materials with thread, cord, or other filament by means of a needle or awl. Its meaning overlaps with \"stitching.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing"@en .

aat:300053659 a skos:Concept ;
    skos:definition "Temporarily joining two or more pieces of material together by sewing with long loose stitches in order to hold them in place until final sewing. For a slight or temporary fastening done by other means, use \"tacking.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basting"@en .

aat:300053660 a skos:Concept ;
    skos:definition "Refers to the process of creating stitches, which are the portions of thread left in fabric or another material by the in and out movement of a threaded needle through the thickness or surface of the material, or the loops of thread created on a needle in knitting or other needlework. Stitching is used for fastening, joining, closing, uniting, mending, or creating ornamentation. Its meaning overlaps with \"sewing (needleworking techinique).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stitching"@en .

aat:300053661 a skos:Concept ;
    skos:definition "The process of making fibers or filaments into yarn or thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning"@en .

aat:300053662 a skos:Concept ;
    skos:definition "Spinning of fibers done by hand rather than by machine, often producing a less than regular yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand spinning"@en .

aat:300053664 a skos:Concept ;
    skos:definition "The art or craft of fabricating objects intended as playthings, most often for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy making"@en .

aat:300053665 a skos:Concept ;
    skos:definition "The art or craft of fabricating dolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollmaking"@en .

aat:300053670 a skos:Concept ;
    skos:definition "The technique or practice of building with brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bricklaying"@en .

aat:300053671 a skos:Concept ;
    skos:definition "The positioning of communications cables, electric cables, or other cables, whether underground, undersea, or aerially."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable laying"@en .

aat:300053672 a skos:Concept ;
    skos:definition "Refers to the act of putting liquid concrete into the location where it is to harden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "placing"@en .

aat:300053676 a skos:Concept ;
    skos:definition "Refers to the installation of glass as a transparent barrier, as in windows or for works on display. Includes glass used in framing, display case construction, or display space illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazing"@en .

aat:300053677 a skos:Concept ;
    skos:definition "Laying or covering with stone, brick, asphalt, concrete, or other material, making a firm, level, or convenient surface for travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paving"@en .

aat:300053678 a skos:Concept ;
    skos:definition "The act, work, or trade of joining pipes together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe fitting"@en .

aat:300053679 a skos:Concept ;
    skos:definition "The installation or repairing of gas pipes and appliances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas fitting"@en .

aat:300053683 a skos:Concept ;
    skos:definition "Forcing a pile into a definite position in the ground without previous excavation, accomplished by the use of either drop hammers or steam hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile driving"@en .

aat:300053685 a skos:Concept ;
    skos:definition "The technique or practice of applying shingles to a surface, typically in the construction of a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shingling"@en .

aat:300053686 a skos:Concept ;
    skos:definition "The laying of slate shingles, as on a roof or wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slating"@en .

aat:300053687 a skos:Concept ;
    skos:definition "The process of building a roof with dry vegetation such as straw, reed, sedge, rushes, or heather; the vegetation is layered so that rain water is shed away from the inner roof. Thatching is an ancient roofing method, found in both tropical and temperate climates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thatching"@en .

aat:300053688 a skos:Concept ;
    skos:definition "Covering a surface with tiles, generally in some sort of fixative with as grout or mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiling"@en .

aat:300053694 a skos:Concept ;
    skos:definition "Process to make an object or environment impervious to or resistant to low temperatures and frost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frostproofing"@en .

aat:300053696 a skos:Concept ;
    skos:definition "The action or process of making something able to withstand rust by applying a moisture resistant surface coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rustproofing"@en .

aat:300053697 a skos:Concept ;
    skos:definition "Process of insulating a space to prevent the passage of loud or disturbing sound or noise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soundproofing"@en .

aat:300053698 a skos:Concept ;
    skos:definition "Process of making materials or surfaces impervious to water. To describe materials or articles having surfaces resistant, but not impervious, to water, use \"water-repellent.\" For the state or quality of having little or no affinity for water, especially on a molecular level, use \"hydrophobicity.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterproofing"@en .

aat:300053701 a skos:Concept ;
    skos:definition "Refers to the removal of water from a site to maintain a dry and stable condition during construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dewatering"@en .

aat:300053702 a skos:Concept ;
    skos:definition "Generally, the action or process of digging out a hollow or hollows in the earth. Specifically, refers to the systematic digging and documentation of an archaeological site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excavation"@en .

aat:300053705 a skos:Concept ;
    skos:definition "Digging or pulling out with a dredge, especially for the purpose of deepening a body of water, searching for foreign objects in a body of water, or for keeping waterways clean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dredging"@en .

aat:300053706 a skos:Concept ;
    skos:definition "The earthmoving required to create a surface of desired grade elevation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grading"@en .

aat:300053708 a skos:Concept ;
    skos:definition "The process of creating a tunnel through excavation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tunneling"@en .

aat:300053710 a skos:Concept ;
    skos:definition "The process of making or forming a hole by piercing or probing with a pointed instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picking"@en .

aat:300053711 a skos:Concept ;
    skos:definition "Process of removing an outer layer by drawing the edge of some instrument held nearly perpendicularly across the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scraping"@en .

aat:300053712 a skos:Concept ;
    skos:definition "The process of removing an outer layer of material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stripping"@en .

aat:300053720 a skos:Concept ;
    skos:definition "The process of removing the outer layer of something, such as the removal of original paint when restoring a painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skinning"@en .

aat:300053721 a skos:Concept ;
    skos:definition "Refers broadly to painting conservation treatments, such as oiling and inpainting, intended to recreate the original appearance of the design in a defect that cannot be corrected. Use a more specific term if possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compensation"@en .

aat:300053725 a skos:Concept ;
    skos:definition "The process of covering the front surface of something with new material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facing"@en .

aat:300053732 a skos:Concept ;
    skos:definition "A painting conservation technique where a deteriorated canvas is strengthened by affixing a strip of canvas to its outside edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strip-lining"@en .

aat:300053736 a skos:Concept ;
    skos:definition "Technique for the transporting of images from one surface to another, such as the separating of a paint film from its mount and moving it to a new support, and for processes of precisely copying or reforming an image on another surface, as in pouncing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transferring"@en .

aat:300053737 a skos:Concept ;
    skos:definition "Restoring to a whole by replacing a part or putting together what is torn or broken, or otherwise restoring to sound condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repairing"@en .

aat:300053739 a skos:Concept ;
    skos:definition "The reassembly of a monument or other structure using the original architectural elements to the greatest degree possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anastylosis"@en .

aat:300053742 a skos:Concept ;
    skos:definition "The process of making changes to an object or structure so that it will closely approximate its original state or other state at a specific time in its history. For changes not considering historical correctness, see \"remodeling\" or \"renovation.\" When changes are made to prevent further deterioration, see \"preservation.\" More generally, for treatment, preventive care, and research directed toward long-term safekeeping of cultural and natural heritage, see \"conservation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restoration"@en .

aat:300053744 a skos:Concept ;
    skos:definition "The process of constructing of new objects or structures that are built to replace or resemble old ones, based on historic, archaeological, or other similar evidence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reconstruction"@en .

aat:300053745 a skos:Concept ;
    skos:definition "Refers to the function of restoring people to physical or mental health or good repute. Refers also to the activity of returning to good condition deteriorated objects, structures, neighborhoods, or public facilities; may involve repair, renovation, conversion, expansion, remodeling, or reconstruction. For actions taken to prevent further changes or deterioration in things, see \"preservation.\" When deterioration has not occurred, see \"renovation\" for actions taken to improve the quality of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rehabilitation"@en .

aat:300053748 a skos:Concept ;
    skos:definition "Dividing a whole object or aggragate of objects or object components into constituent parts. For the removal of an object or object components from physical contact with another, see \"detachment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "separating"@en .

aat:300053749 a skos:Concept ;
    skos:definition "The loss or migration of colorant due to contact with liquids, especially water; also in painting the diffusion or migration of coatings or the pigments in them into surrounding layers or surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleeding"@en .

aat:300053751 a skos:Concept ;
    skos:definition "Preparing relatively short fibers for spinning by cleansing, disentangling, and collecting them together using a card."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carding"@en .

aat:300053752 a skos:Concept ;
    skos:definition "The separation of small pieces or fragments from an object or surface. May refer to accidental activity or process, or to intentional activity, as with the making of arrowheads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chipping"@en .

aat:300053753 a skos:Concept ;
    skos:definition "Preparing fiber for spinning by cleansing, disentangling, and collecting together by the use of a comb; used to prepare relatively long fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combing"@en .

aat:300053754 a skos:Concept ;
    skos:definition "Removal of salts, as from water or soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desalination"@en .

aat:300053756 a skos:Concept ;
    skos:definition "Process whereby particles intermingle and move from a region of higher to one of lower concentration, and for the transmission or reflection of light. Includes the effect of such processes, such as the softening of sharp outlines in a photograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffusion"@en .

aat:300053757 a skos:Concept ;
    skos:definition "The action of diffusing or spreading, as in particulate matter in liquid suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dispersion"@en .

aat:300053758 a skos:Concept ;
    skos:definition "Making free or nearly free of liquids. For the removal or deprivation of water, though other liquids may remain, use \"dehydration.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drying"@en .

aat:300053759 a skos:Concept ;
    skos:definition "The process of passing a liquid or other material through a filter or porous medium in order to remove or separate solid particles or impurities. May also refer to the process of passing an electrical signal or other signal through a filter to remove excess noise or undesired frequencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filtration"@en .

aat:300053761 a skos:Concept ;
    skos:definition "Extraction of an element or compound from a solid alloy or mixture by dissolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaching"@en .

aat:300053762 a skos:Concept ;
    skos:definition "Process of stabilizing or reinforcing to give additional physical support, typically be adding thickness or by covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strengthening"@en .

aat:300053766 a skos:Concept ;
    skos:definition "Securing of a work of art, document, or other generally flat object within a mat for support, protection, or display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matting"@en .

aat:300053767 a skos:Concept ;
    skos:definition "The process of supporting a structure or part of one temporarily upon shores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoring"@en .

aat:300053768 a skos:Concept ;
    skos:definition "The process of providing assistance, relief, or reinforcement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supporting"@en .

aat:300053772 a skos:Concept ;
    skos:definition "Covering a surface with a layer of substance, especially a substance that is spread on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coating"@en .

aat:300053775 a skos:Concept ;
    skos:definition "Enameling process developed in Mughal, India, which uses both translucent and opaque enamel applied over gold and silver and carved into a bas-relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basse-taille"@en .

aat:300053777 a skos:Concept ;
    skos:definition "Enameling that is accomplished by carving away troughs or cells in metal, leaving a raised line that forms the outline of the design. The enamel is laid in the cells, fired, and then filed and polished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "champlevé"@en .

aat:300053778 a skos:Concept ;
    skos:definition "A technique of enameling in which the design is laid down in thin metal strips on a metal or porcelain ground, forming chambers (cloisons) to receive the vitreous enamel pastes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloisonné"@en .

aat:300053782 a skos:Concept ;
    skos:definition "Enamel decoration characterized by an opaque coating of enamel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "en ronde bosse"@en .

aat:300053785 a skos:Concept ;
    skos:definition "A process of enameling similar to cloisonné, except that the narrow wires or strips of metal are soldered to each other instead of to a metal base. Usually applies to jewelry and metal objects but may also apply to porcelain decorated by this technique such as that produced at Limoges in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plique-à-jour"@en .

aat:300053786 a skos:Concept ;
    skos:definition "Creating a textured effect similar to suede or felt by blowing fibers of cotton, silk, nylon, or other material onto a tacky surface, usually paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flocking"@en .

aat:300053789 a skos:Concept ;
    skos:definition "Process involving the surface application of gold or another metal in the form of leaf, powder applied directly to the surface, powder mixed with a binder, electroplating, or other forms to approximate the effect of solid or inlaid metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilding"@en .

aat:300053790 a skos:Concept ;
    skos:definition "Gilding technique in which an amalgam of gold with mercury is applied to a metal, such as copper or silver, then the metal is heated to flash volatilize the mercury and deposit a thin layer of gold. The process has been in use since at least 300 CE in China. In most regions, it was replaced in the mid-19th century by electrogilding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amalgam gilding"@en .

aat:300053793 a skos:Concept ;
    skos:definition "Technique of laying gold leaf on articles made of inferior metals by covering the parts to be gilded with mercury and pressing the gold leaf into place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garm-mulamma"@en .

aat:300053794 a skos:Concept ;
    skos:definition "Gilding technique in which metal leaf is laid with an oil or varnish gold size rather than with water, producing a mat finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mordant gilding"@en .

aat:300053795 a skos:Concept ;
    skos:definition "Technique of adhering precious-metal leaf to a gesso or bole ground that is moistened with water before each leaf is laid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water gilding"@en .

aat:300053796 a skos:Concept ;
    skos:definition "Coating the surface of something, such as a piece of furnishing or small object, with lacquer, often creating designs or pictures with it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacquering"@en .

aat:300053797 a skos:Concept ;
    skos:definition "The hard-finish lacquering technique which utilizes many coats of varnish composed of shellac dissolved in spirit, then polished and decorated, usually Oriental in style and subject matter. Originally developed as a substitute for genuine Oriental lacquer which was popular during the second half of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "japanning"@en .

aat:300053800 a skos:Concept ;
    skos:definition "The process of finishing or refinishing so as to give the appearance of age to an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiquing"@en .

aat:300053809 a skos:Concept ;
    skos:definition "Producing a grain pattern on the surface of something, such as leather, book cloth, or wood, by any of various processes, such as boarding, embossing, painting, printing, or plating; includes operations to enhance the natural grain patterns of materials as well as to impart totally artificial or imitative patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graining"@en .

aat:300053812 a skos:Concept ;
    skos:definition "The technique of imitating or suggesting the appearance or pattern of marble or another such stone, usually by hand painting on paper, wood, fresco, or other surfaces. For a broader, less delicate technique, as used in construction, use \"marbleizing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbling"@en .

aat:300053816 a skos:Concept ;
    skos:definition "The action of applying a coating by adding pressurized air to a paint emulsion, and directing it onto a support through a nozzle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spray painting"@en .

aat:300053822 a skos:Concept ;
    skos:definition "The action of closing a vessel, aperture, or package by placing a coating of material or a fastening on it that must be broken before access can be obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealing"@en .

aat:300053823 a skos:Concept ;
    skos:definition "A method of joining plastic sheets or films by the simultaneous application of heat and pressure to the areas in contact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-sealing"@en .

aat:300053825 a skos:Concept ;
    skos:definition "The application to a surface of a resin in a volatile solvent, which dries to a hard, glossy, and usually transparent film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "varnishing"@en .

aat:300053826 a skos:Concept ;
    skos:definition "Producing raised letters or designs on a surface, typically by means of stamping or molding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossing"@en .

aat:300053827 a skos:Concept ;
    skos:definition "Decorating a surface by indenting or embossing it, as in stamping of linen book bindings or gold leaf surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauffering"@en .

aat:300053829 a skos:Concept ;
    skos:definition "Creating marks on the surface of a hard material, such as metal or glass, by incising with a sharp tool, when the designs or images created are for their own sake and not to be printed from. For printing processes that involve this technique plus intaglio printing from the surface, use \"engraving (printing process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engraving"@en .

aat:300053831 a skos:Concept ;
    skos:definition "The process of cutting or engraving glass pieces using a wheel or grindstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel-engraving"@en .

aat:300053832 a skos:Concept ;
    skos:definition "A technique for decorating glass, and sometimes porcelain, by scratching or stippling it with a diamond-tipped stylus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond-point engraving"@en .

aat:300053833 a skos:Concept ;
    skos:definition "Technique of decorating glass in which a painted, drawn, or gilded image is executed on the underside of the glass and backed with metal foil, usually gold or silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verre églomisé"@en .

aat:300053837 a skos:Concept ;
    skos:definition "Process of engraving and printing from steel plates for the production of documents requiring long runs with precise replication, such as banknotes or postage stamps. It is mechanical a process developed by Jacob Perkins in the early 1800s, which enables the transfer of an impression from a steel plate to a steel cylinder in a rolling press. For the related printmaking process using steel or steel-faced copper plates, use \"steel engraving.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siderography"@en .

aat:300053840 a skos:Concept ;
    skos:definition "Creating marks on the surface of a hard material such as metal or glass, by the controlled corrosive action of acid. Use \"etching (printing process)\" for the series of steps that includes printing from a bitten plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etching"@en .

aat:300053841 a skos:Concept ;
    skos:definition "The process of producing designs or pictures (as on wood or leather) by burning or scorching with hot instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrography"@en .

aat:300053844 a skos:Concept ;
    skos:definition "Refers generally to processes that complete an object, treatment, or work, including the chemical, electrolytic, and mechanical application of finishes. In the context of bookbinding, refers to that sequence of processes carried out on a book and its binding after forwarding, up to the point of attaching its cover. In case binding, where the cover is attached prior to the application of lettering or decoration, the attachment of the cover is part of the forwarding, not the finishing. In the context of leather manufacture, all the processes carried out on the leather after tanning. In the context of papermaking, all the processes carried out on the paper after it leaves the papermaking machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finishing"@en .

aat:300053845 a skos:Concept ;
    skos:definition "Surface finishing process for concrete and mortar that embeds aggregate, removes slight imperfections, humps, and voids to produce a level surface, and consolidates material rising to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating"@en .

aat:300053847 a skos:Concept ;
    skos:definition "The process and technique of producing, forming, or tracing a pattern, text, or other usually linear motif by cutting, carving, or engraving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incising"@en .

aat:300053850 a skos:Concept ;
    skos:definition "Any process by which small pieces of one material are inserted into a larger piece of another so as to create a design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inlay"@en .

aat:300053852 a skos:Concept ;
    skos:definition "Decorative wood process in which the design or pattern is made by assembling small pieces of veneer in various shapes. The term, which derives from 15th-century Italy, is commonly used to describe both \"marquetry,\" in which the entire surface is veneered, and \"wood inlay,\" in which the pattern pieces are laid into a solid ground. The term may also be used to refer to similar works of stone, glass, or another material. Distinguished from mosaics, as pieces in intarsia work are precision-cut to tightly fit together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intarsia"@en .

aat:300053853 a skos:Concept ;
    skos:definition "The technique in which small pieces of specially shaped wood, or sometimes other materials such as ivory, are incorporated into a suface of decorative veneer. Distinguished from \"inlay,\" where decorative pieces are set into a solid ground; in marquetry, the entire surface is veneered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marquetry"@en .

aat:300053854 a skos:Concept ;
    skos:definition "Marquetry comprised of brass and tortoise shell, applied to furniture especially in the late 17th and early 18th centuries. The term derives from the name of the artist André-Charles Boulle and his sons, whose work was imitated widely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boulle work"@en .

aat:300053858 a skos:Concept ;
    skos:definition "Marquetry executed in a geometrical pattern, used especially for floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parquetry"@en .

aat:300053859 a skos:Concept ;
    skos:definition "The placing of lath in forming walls, or other building elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lathing"@en .

aat:300053860 a skos:Concept ;
    skos:definition "Process or technique of applying wallpaper used for covering interior walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paperhanging"@en .

aat:300053862 a skos:Concept ;
    skos:definition "Giving wood a whitish finish by scraping off paint while leaving the remains of the gesso base still embedded in the grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickling"@en .

aat:300053863 a skos:Concept ;
    skos:definition "A process for smoothing the surface of wood or another material by shaving off small fragments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planing"@en .

aat:300053864 a skos:Concept ;
    skos:definition "In the context of art and architecture, the practice of applying plaster, which is primarily a mixture of lime, sand, and water, to a surface. In the context of architecture generally, plaster is applied to walls or ceilings with broad graceful strokes, with the goal of achieving denseness, solidity, and rapid drying. In the context of frescoes or other wall paintings, the plaster is applied with force, using short, pounding blows, with the goal of achieving a surface that is somewhat porous and ready to receive paint or additional layers of plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastering"@en .

aat:300053865 a skos:Concept ;
    skos:definition "In wall plastering, the creating of an insulating space of a few inches between an exterior wall of a building and the lath of the plaster wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furring"@en .

aat:300053867 a skos:Concept ;
    skos:definition "Process of rubbing a surface to make it smooth or shiny."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polishing"@en .

aat:300053869 a skos:Concept ;
    skos:definition "Making shiny or lustrous by rubbing with a tool that compacts or smooths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnishing"@en .

aat:300053870 a skos:Concept ;
    skos:definition "Smoothing or brightening of surfaces by means of metal pellets, balls, or other metal shapes in a rotating container."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball-burnishing"@en .

aat:300053872 a skos:Concept ;
    skos:definition "Producing a smooth bright surface on a metal object by immersion as an anode in an electrolytic bath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electropolishing"@en .

aat:300053874 a skos:Concept ;
    skos:definition "Application of a penetrating liquid to fill pores, to isolate coatings, or to make surfaces suitable to receive coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sizing"@en .

aat:300053875 a skos:Concept ;
    skos:definition "Process or techinque of applying a surface with fine plaster, so as to cover or add ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuccoing"@en .

aat:300053876 a skos:Concept ;
    skos:definition "Intentionally leaving the marks of a tool on a surface, especially on leather or stone; produced during the finishing or dressing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tooling"@en .

aat:300053878 a skos:Concept ;
    skos:definition "The process or technique of applying veneer, which comprises thin sheets of wood, metal, ivory, or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneering"@en .

aat:300053879 a skos:Concept ;
    skos:definition "Techniques used with materials that involve heating and cooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperature-related techniques"@en .

aat:300053880 a skos:Concept ;
    skos:definition "Refers to the initial act or instance of burning and for the chemical processes in which light or heat are produced by the vigorous union of various substances with oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combustion"@en .

aat:300053881 a skos:Concept ;
    skos:definition "Proccess of removing heat in order to lower the temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooling"@en .

aat:300053882 a skos:Concept ;
    skos:definition "Refers to the process of exposing a material or an object to cold for the purpose of preserving, cooling, or freezing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refrigeration"@en .

aat:300053883 a skos:Concept ;
    skos:definition "Causing to become hardened into a solid body by the abstraction of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freezing"@en .

aat:300053885 a skos:Concept ;
    skos:definition "Process of adding heat in order to raise the temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating"@en .

aat:300053886 a skos:Concept ;
    skos:definition "Refers to the process by which materials, such as metal and glass, are softened and made workable by heating and controlled cooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annealing"@en .

aat:300053887 a skos:Concept ;
    skos:definition "Refers to the processes of preparing, curing, or purposely transforming materials, such as clay, silica, or glass, by means of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firing"@en .

aat:300053888 a skos:Concept ;
    skos:definition "Refers to the process by which an open fire or a special firing pit is used to prepare, cure, or transform clay or another material by means of heat. It is characterized by the free circulation of oxygen, which results in the oxidation of iron and other components in the material, and a relatively low firing temperature. It differs from firing in a kiln, where the structure of the kiln allows a higher firing temperature to be achieved and the space may be sealed from oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonfire firing"@en .

aat:300053889 a skos:Concept ;
    skos:definition "Pottery covered with a lead glaze and fired at a very low temperature, leaving the body soft and porous; originally developed in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raku"@en .

aat:300053890 a skos:Concept ;
    skos:definition "Refers to the process of heating metal, glass, or other material to a temperature below the transformation stage and then cooling it at a controlled rate to change its hardness, strength, or toughness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tempering"@en .

aat:300053891 a skos:Concept ;
    skos:definition "Process of melting previously frozen object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thawing"@en .

aat:300053892 a skos:Concept ;
    skos:definition "Use generally for the activity of conveying, carrying, or removing something or someone from one physical location to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transporting"@en .

aat:300053895 a skos:Concept ;
    skos:definition "The process of elevating or hoisting something into the air or a higher position from the ground or a lower position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifting"@en .

aat:300053899 a skos:Concept ;
    skos:definition "Process of transporting goods sending goods to people, stores, or other destinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipping"@en .

aat:300053901 a skos:Concept ;
    skos:definition "Methods or practices used with pottery production and creation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery techniques"@en .

aat:300053903 a skos:Concept ;
    skos:definition "Pottery technique in which the piece is built up from ropelike coils of clay, without the use of a potter's wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coiling"@en .

aat:300053904 a skos:Concept ;
    skos:definition "A ceramic technique in which fine cord is wrapped around a paddle and pressed against an unfired clay vessel, leaving the cord imprint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cord marking"@en .

aat:300053905 a skos:Concept ;
    skos:definition "A technique of forming pottery by hand, in which a mass of wet clay is flattened to a slab with a rolling pin. The slab may be beaten into various shapes, joined to other slabs with slip, or paddled over a wood form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slab method"@en .

aat:300053907 a skos:Concept ;
    skos:definition "The process of forming clayware by pouring slip into plaster molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip casting"@en .

aat:300053908 a skos:Concept ;
    skos:definition "The process of making a ceramic object on a potter's wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing"@en .

aat:300053909 a skos:Concept ;
    skos:definition "Methods or practices used with pottery decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery decorating techniques"@en .

aat:300053910 a skos:Concept ;
    skos:definition "Technique of cold transfer of an overglaze design to pottery, developed in England in the late 18th century. The process involved creating a design on a printing plate; then a bat, a thin sheet of gelatinous substance, was used instead of paper to pick up the oiled design from the plate and transfer it to the ceramic surface. Color in powder form was dusted onto the porcelain; only the oiled parts having the design retained the pigment. First designs were primarily in black, thus it is also called \"black printing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bat printing"@en .

aat:300053913 a skos:Concept ;
    skos:definition "The technique of decorating clay in which the body material is inlaid with the clay of another color. For the technique of wall or panel painting using pigment suspendied in molten wax, use \"encaustic painting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encaustic decoration"@en .

aat:300053914 a skos:Concept ;
    skos:definition "Overlaying or covering with a smooth and lustrous coating, or polishing and burnishing to create a smooth, shiney surface. To refer specifically to glazing paintings, use the narrower concept \"glazing (painting technique).\" To refer specifically to glazing ceramics, use the narrower concept \"pottery glazing (process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazing"@en .

aat:300053915 a skos:Concept ;
    skos:definition "A technique of decoration employed in Spain for tiles and other wares which superseded the cuerda seca method. It involved impressing the pattern on tiles to form ridges which prevented the colored glazes from intermingling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuenca"@en .

aat:300053916 a skos:Concept ;
    skos:definition "Decoration technique in which outlines are drawn on the surface of wares (especially tiles) with a greasy substance colored with manganese, allowing glazes of several colors to be used without intermingling; the grease disappears during firing; found primarily in Iberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuerda seca"@en .

aat:300053917 a skos:Concept ;
    skos:definition "Refers to a style of pottery that is named for the city of Mishima in Shizuoka prefecture, Japan, although it was originally developed in Korea. It is created using a distinctive technique of decorating the ceramic piece with inlaid clays in contrasting colors, then generally covering the piece with a celadon glaze. The name \"Mishima\" dates from the 17th century, but the style dates to the Koryo Period (935-1392), when it was called \"Korai\" or \"Zogan.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mishima"@en .

aat:300053918 a skos:Concept ;
    skos:definition "Application of a second glaze to a piece of pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overglazing"@en .

aat:300053919 a skos:Concept ;
    skos:definition "The application of slip to a piece of pottery with a syringelike device so as to create slightly raised linear decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip trailing"@en .

aat:300053922 a skos:Concept ;
    skos:definition "Process of decorating ceramics by transferring the design from prints on another material, often using heat; invented in England in the 1750s. Designs are first engraved and then printed on paper or another material using a special ceramic ink. The paper is then pressed against the surface of the ceramic, enamel, or glass and the design is thus transferred, often with the application of heat. The process is also used for enamels and glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transfer printing"@en .

aat:300053925 a skos:Concept ;
    skos:definition "Applying a load to a structure or material, such as concrete, deforming it so that it will withstand a working load more effectively or so that it will deflect less."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prestressing"@en .

aat:300053929 a skos:Concept ;
    skos:definition "Includes the making of or working on or with glass or glass articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassworking"@en .

aat:300053931 a skos:Concept ;
    skos:definition "A method of coloring glass by dipping clear glass, while still pliant, into a bath of molten glass of a deep color, or by fusing a thin piece of dark glass to a thicker one of clear glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flashing"@en .

aat:300053932 a skos:Concept ;
    skos:definition "The process of shaping glass by blowing air through a blowpipe into a glob of molten glass and forming it with tongs and shears or by rolling it against a hard surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassblowing"@en .

aat:300053937 a skos:Concept ;
    skos:definition "Collectively, all the processes pertaining to the art of cutting and polishing precious and semiprecious stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapidary"@en .

aat:300053941 a skos:Concept ;
    skos:definition "The process of making things from or decorating leather. For the making of leather itself, use \"leather\" plus \"manufacturing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworking"@en .

aat:300053943 a skos:Concept ;
    skos:definition "Incorporating a fatty substance into heavy leather, such as belting leather, to increase its strength, pliability, and water repellency; distinguished from \"fat-liquoring,\" which is the introduction of a fatty substance into light leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "currying"@en .

aat:300053944 a skos:Concept ;
    skos:definition "An irreversible process of treating hides or skins with tannins to produce leather. Distinct from \"tawing\" which is reversible by washing. For the simpler process of drying a pelt, use \"skin curing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanning"@en .

aat:300053945 a skos:Concept ;
    skos:definition "Processes that follow the tanning or tawing of hide or skin, or the stretching and drying of skin that is to be made into parchment, in order to modify it to meet specific needs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing"@en .

aat:300053949 a skos:Concept ;
    skos:definition "The process of joining two pieces of metal by inserting solder between them and applying heat, sometimes but not necessarily softening or melting the surfaces to be joined; usually carried out within a temperature range of 183 to 310 degrees Celsius, with an upper limit of 750 degrees Celsius. For the similar process carried out at temperatures ranging between 750 and 900 degrees Celsius, use \"brazing.\" For the process of joining two pieces of metal that necessarily involves softening or melting the surfaces to be joined but not necessarily the insertion of filler metal, use \"welding.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soldering"@en .

aat:300053950 a skos:Concept ;
    skos:definition "Refers to the process of joining two pieces of metal by inserting filler metal of very high melting point, such as hard solder, between them and applying heat, at temperatures ranging between 750 and 900 degrees Celsius; sometimes but not necessarily involves softening or melting the surfaces to be joined. For the similar process carried out at temperatures below 750 degrees Celsius, see \"soldering.\" For the process of joining two pieces of metal that necessarily involves softening or melting the surfaces to be joined but not necessarily the insertion of filler metal, see \"welding.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brazing"@en .

aat:300053951 a skos:Concept ;
    skos:definition "Brazing with an electric arc, that is, the electrical discharge between two electrodes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arc brazing"@en .

aat:300053952 a skos:Concept ;
    skos:definition "Process whereby the metals to be joined are dipped into a bath of molten salt, which acts as both flux and a source of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dip brazing"@en .

aat:300053953 a skos:Concept ;
    skos:definition "Brazing method whereby the entire assembly, including brazing alloy and flux set correctly in place, is raised to brazing temperature in a furnace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnace brazing"@en .

aat:300053954 a skos:Concept ;
    skos:definition "Brazing method where heat is developed by electricity in a heating coil and induced into the parts to be brazed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "induction brazing"@en .

aat:300053955 a skos:Concept ;
    skos:definition "Brazing process in which the heat required is obtained from the resistance to electric current in a circuit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistance brazing"@en .

aat:300053956 a skos:Concept ;
    skos:definition "Brazing in which the flame of a gas torch is used to heat the metals and brazing materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torch brazing"@en .

aat:300053958 a skos:Concept ;
    skos:definition "Refers to the process of joining two pieces of metal by softening or melting both surfaces to be joined by the application of heat, with or without inserting filler metal and with or without the application of pressure. For the metal joining process that necessarily involves the insertion of solder but not necessarily the softening or melting of the surfaces to be joined, see \"soldering\" for the process carried out at temperatures below 750 degrees Celsius, or \"brazing\" for the similar process carried out at temperatures ranging between 750 and 900 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "welding"@en .

aat:300053959 a skos:Concept ;
    skos:definition "Method of welding whereby a groove, fillet, plug, or seat weld is made using a nonferrous filler metal having a melting point below that of base metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braze welding"@en .

aat:300053960 a skos:Concept ;
    skos:definition "Any of a number of methods of welding that use electricity as a source of power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric welding"@en .

aat:300053961 a skos:Concept ;
    skos:definition "A form of electrical pressure welding in which the necessary heat is produced by a flow of current through the parts to be welded. Sufficient pressure to make the weld is applied simultaneously with the flow of current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistance welding"@en .

aat:300053962 a skos:Concept ;
    skos:definition "The uniting of two pieces of hot metal by hammering them together on an anvil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forge welding"@en .

aat:300053964 a skos:Concept ;
    skos:definition "A process by which thermoplastic materials are softened and welded together with heat produced by friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction welding"@en .

aat:300053965 a skos:Concept ;
    skos:definition "The welding of metals in a molten state without mechanical pressure or pounding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fusion welding"@en .

aat:300053966 a skos:Concept ;
    skos:definition "The joining of metal parts by fusion in which the necessary heat is produced by means of an electric arc, that is, the electrical discharge between two electrodes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arc welding"@en .

aat:300053969 a skos:Concept ;
    skos:definition "Arc welding in which a flux-coated metal electrode is consumed to form a pool of filler metal and a gas shield around the weld area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shielded metal arc welding"@en .

aat:300053971 a skos:Concept ;
    skos:definition "Type of arc welding process in which elements are joined by heating between a metal stud and the other work part until their surfaces are joined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stud welding"@en .

aat:300053973 a skos:Concept ;
    skos:definition "Any method of welding that uses burning gas as a source of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas welding"@en .

aat:300053976 a skos:Concept ;
    skos:definition "The joining of metals at room temperature by subjecting to pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold-welding"@en .

aat:300053978 a skos:Concept ;
    skos:definition "A solid-state welding process in which the parts are joined by the local application of high-frequency sound waves as they are held together under pressure. This process is used in many industrial applications to join dissimilar materials. It is also used in the conservation of parchment, the encapsulation of paper objects, and in joining woven and non-woven textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultrasonic welding"@en .

aat:300053980 a skos:Concept ;
    skos:definition "The application of an aluminum coating such as to iron and steel sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminizing"@en .

aat:300053981 a skos:Concept ;
    skos:definition "The process whereby a protective coat of zinc is applied to steel or iron to protect it from corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galvanizing"@en .

aat:300053982 a skos:Concept ;
    skos:definition "Galvanizing by a process in which the zinc is deposited by an electroplating method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrogalvanizing"@en .

aat:300053984 a skos:Concept ;
    skos:definition "The application of a protective coating to ferrous metal by dipping it in a bath of molten zinc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-dip galvanizing"@en .

aat:300053985 a skos:Concept ;
    skos:definition "The process of coating, treating, or combining with a metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallizing"@en .

aat:300053988 a skos:Concept ;
    skos:definition "The treatment of a surface to give the appearance of bronze. In printmaking, refers to printing with metallic inks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronzing"@en .

aat:300053989 a skos:Concept ;
    skos:definition "The act or process of covering with silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silvering"@en .

aat:300053990 a skos:Concept ;
    skos:definition "Technique of applying silver leaf in which silver is mixed with mercury and applied to the surface of the object; the object is then heated to dispel the mercury."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amalgam silvering"@en .

aat:300053991 a skos:Concept ;
    skos:definition "The process of coating an object with a thin adherent layer of gold, silver, or other metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plating"@en .

aat:300053999 a skos:Concept ;
    skos:definition "Deposition of a metallic coating by a controlled chemical reduction that is catalyzed by the metal or alloy being deposited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroless plating"@en .

aat:300054000 a skos:Concept ;
    skos:definition "Applying a protective or decorative coating of one metal to another by means of an electrolytic bath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroplating"@en .

aat:300054004 a skos:Concept ;
    skos:definition "Coating steel with a thin corrosion-resistant cladding of zinc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sherardizing"@en .

aat:300054006 a skos:Concept ;
    skos:definition "Cutting desired shapes out of a material such as metal to be used for forming or other manufacturing operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanking"@en .

aat:300054012 a skos:Concept ;
    skos:definition "Methods or practices used with metal decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal decorating techniques"@en .

aat:300054013 a skos:Concept ;
    skos:definition "Enrichment consisting of a line of tiny beads; common on silver and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beading"@en .

aat:300054014 a skos:Concept ;
    skos:definition "Copper-zinc alloy of India, finished with a velvety-black color by a solution of copper sulfate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidri"@en .

aat:300054016 a skos:Concept ;
    skos:definition "The process of fine detailed “cold work” after casting and fettlingthat serves to correct or enhance the cast surface by removingand/or compressing metal using hand tools by punching,engraving, and/or chiseling, and in modern times also with powerand pneumatic tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chasing"@en .

aat:300054018 a skos:Concept ;
    skos:definition "The final chasing or smoothing of a metal object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciselure"@en .

aat:300054019 a skos:Concept ;
    skos:definition "Decorating metal, usually iron, with flat ornaments of precious metal, such as gold or silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damascening"@en .

aat:300054021 a skos:Concept ;
    skos:definition "Technique of jewelry decoration in which minute grains of gold or silver are applied to an object of the same metal; in ancient times achieved without using solder, in modern times done with solder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granulation"@en .

aat:300054022 a skos:Concept ;
    skos:definition "A technique of decorating metal, usually gold or silver, by engraving it with designs that are then filled with a black inlay. Prints are sometimes made from the engraved metal before inlaying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niello"@en .

aat:300054023 a skos:Concept ;
    skos:definition "In metalwork, a technique for decorating a surface by hammering the reverse of the object, sometimes into a mold of wood that has been carved in intaglio, to create designs in relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repoussé"@en .

aat:300054025 a skos:Concept ;
    skos:definition "Process in which the surface of a metal is coated with a protective or decorative layer through electrolytic action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anodizing"@en .

aat:300054027 a skos:Concept ;
    skos:definition "Hardening the surface of a metal by case-hardening or other method, such as by induction or flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface hardening"@en .

aat:300054028 a skos:Concept ;
    skos:definition "Producing a hard surface layer on steel, as by carbonizing, cyaniding, and flame hardening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case-hardening"@en .

aat:300054031 a skos:Concept ;
    skos:definition "The stretching, spreading, or shaping of metal by passing through dies or by stamping successively, as with a series of dies or by hammering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing"@en .

aat:300054033 a skos:Concept ;
    skos:definition "Forming the shape of a metal object by heating and hammering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forging"@en .

aat:300054038 a skos:Concept ;
    skos:definition "Process of melting and pouring materials, such as metal or glass, into a mold; for glass also includes fusing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "founding"@en .

aat:300054040 a skos:Concept ;
    skos:definition "Process of shaping sheet metal into hollow vessels by pressing it against a wood form on a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning"@en .

aat:300054041 a skos:Concept ;
    skos:definition "Melting or fusing ore, often with an accompanying chemical change, usually to separate the metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smelting"@en .

aat:300054045 a skos:Concept ;
    skos:definition "The process of making objects out of brass or employing brass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brass smithing"@en .

aat:300054046 a skos:Concept ;
    skos:definition "Ironworking specifically to make tools and other heavy iron pieces with a forge and anvil; an example is the making of horseshoes by blacksmithing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blacksmithing"@en .

aat:300054047 a skos:Concept ;
    skos:definition "Activity of working with copper, especially to create objects such as kettles, coils, tubing, and fittings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coppersmithing"@en .

aat:300054048 a skos:Concept ;
    skos:definition "The process of making objects out of gold, especially jewelry, tableware, and decorative objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldsmithing"@en .

aat:300054049 a skos:Concept ;
    skos:definition "The process of fashioning things from iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironworking"@en .

aat:300054051 a skos:Concept ;
    skos:definition "Metalworking focusing primarily on works in pewter, which is an alloy of tin and lead, antimony, and copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pewtersmithing"@en .

aat:300054053 a skos:Concept ;
    skos:definition "The process of making objects out of silver or employing silver, especially jewelry, tableware, and decorative objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silversmithing"@en .

aat:300054054 a skos:Concept ;
    skos:definition "The process of making objects out of tin or employing tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinsmithing"@en .

aat:300054058 a skos:Concept ;
    skos:definition "The Japanese art of folding paper into intricate decorative designs and objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "origami"@en .

aat:300054060 a skos:Concept ;
    skos:definition "The process of creating a sheet or web from matted and felted fibers, mostly vegetable, often with the addition of sizing, filler, and coloring material, either by hand or machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papermaking"@en .

aat:300054061 a skos:Concept ;
    skos:definition "Refers to the pressing of a wet sheet of newly made paper still on the mold onto a felt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couching"@en .

aat:300054074 a skos:Concept ;
    skos:definition "Forming process in which heated plastic sheet is drawn against the mold surface by evacuating the air between it and the mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum forming"@en .

aat:300054080 a skos:Concept ;
    skos:definition "Refers generally to the process of cutting or dressing stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stonecutting"@en .

aat:300054082 a skos:Concept ;
    skos:definition "The art or process of carving gems or seals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glyptics"@en .

aat:300054083 a skos:Concept ;
    skos:definition "Refers broadly to the activity of fashioning in wood. For the art of making fine furniture and intricate woodwork, see \"cabinetmaking.\" See the narrower \"carpentry\" for constructing buildings and other structures with wood, including the installation of floors, windows, and other trim work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking"@en .

aat:300054085 a skos:Concept ;
    skos:definition "The art of building with wood, especially in the construction of buildings and other structures, including the installation of floors, windows, and other trim work. For the making of fine furniture and intricate woodwork, see \"cabinetmaking.\" For the broader activity of working in wood more generally, use \"woodworking.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpentry"@en .

aat:300054087 a skos:Concept ;
    skos:definition "Light woodwork, including furniture constructed with dovetail or other joints, and features such as doors or staircases in buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joinery"@en .

aat:300054089 a skos:Concept ;
    skos:definition "The art of fashioning or ornamenting objects of wood by cutting with a sharp implement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodcarving"@en .

aat:300054091 a skos:Concept ;
    skos:definition "Hand carving of wood by cutting chips with a knife or other instrument usually in simple geometric designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chip carving"@en .

aat:300054098 a skos:Concept ;
    skos:definition "Refers to the process of striking metal with a hammer or other instrument in order to create a vessel or other shape, or to create decoration. The oldest technique may have been to create a thin disk of metal by hammering it into a hollow carved in a block of wood. A vessel may be slowly raised by being struck on the outside surface using a specially shaped hammer and anvil. Embossing or repoussé work use hammering to create a design or pattern in a metal object, usually by hammering from the back of the piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammering"@en .

aat:300054100 a skos:Concept ;
    skos:definition "Generally, the use of or investigation with a microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microscopy"@en .

aat:300054101 a skos:Concept ;
    skos:definition "To form with right angles and straight edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squaring"@en .

aat:300054106 a skos:Concept ;
    skos:definition "Broadly, the action or process of growing worse or becoming impaired in quality, state, or condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deterioration"@en .

aat:300054107 a skos:Concept ;
    skos:definition "The deterioration of metal or other substances by chemical or electrochemical reaction resulting from exposure to weathering, moisture, chemicals, or other agents, causing the metal to change from a metallic state into a chemically more stable mineral compound known as a corrosion product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrosion"@en .

aat:300054108 a skos:Concept ;
    skos:definition "Corrosion that occurs when current flows between cathodic and anodic areas on metallic surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrochemical corrosion"@en .

aat:300054112 a skos:Concept ;
    skos:definition "A deterioration of photographs, occurring when silver is attacked by any of a wide variety of oxidants that convert metallic silver atoms to highly reactive and mobile silver ions. It is the most common cause of fading of silver images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxidative-reductive deterioration"@en .

aat:300054113 a skos:Concept ;
    skos:definition "A symptom of oxidative-reductive deterioration in photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver mirroring"@en .

aat:300054115 a skos:Concept ;
    skos:definition "The action of weather elements in altering the color, texture, composition, or form of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weathering"@en .

aat:300054116 a skos:Concept ;
    skos:definition "Process whereby materials are worn away and removed by natural causes including weathering, solution, corrosion, or transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erosion"@en .

aat:300054118 a skos:Concept ;
    skos:definition "The action or process of becoming smaller, shorter, or pressed together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contraction"@en .

aat:300054119 a skos:Concept ;
    skos:definition "The increase in length or volume of a material, or a body, caused by temperature, moisture, or other environmental condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expansion"@en .

aat:300054120 a skos:Concept ;
    skos:definition "Contracting or lessening of size, especially as a result of conditions of temperature or moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrinkage"@en .

aat:300054122 a skos:Concept ;
    skos:definition "The process that causes blisters, which are areas bulging out from the main mass or surface, such as paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blistering"@en .

aat:300054124 a skos:Concept ;
    skos:definition "Fracturing in a material or object, usually along a single or branched path."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cracking"@en .

aat:300054126 a skos:Concept ;
    skos:definition "Fine cracks or fissures in the surface of hardened or dried material, such as varnish, concrete, plaster, paint, or ceramic glazes; sometimes appearing opaque; usually not exposing the underlying surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crazing"@en .

aat:300054128 a skos:Concept ;
    skos:definition "Separation into constituent layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "delamination"@en .

aat:300054129 a skos:Concept ;
    skos:definition "Separating into thin flattened pieces or layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flaking"@en .

aat:300054130 a skos:Concept ;
    skos:definition "The presence of small cavities or depressions in a surface caused by weathering, erosion, or other processes over time. For similar depressions in set plaster, see popping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitting"@en .

aat:300054131 a skos:Concept ;
    skos:definition "Breaking or chipping of masonry or pavement at joints, cracks, or edges, usually resulting in fragments with feather edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spalling"@en .

aat:300054132 a skos:Concept ;
    skos:definition "The formation of small ridges or furrows on a formerly smooth surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrinkling"@en .

aat:300054135 a skos:Concept ;
    skos:definition "Branches of learning, professions, and areas of professional specialization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disciplines"@en .

aat:300054136 a skos:Concept ;
    skos:definition "Branches of learning regarded as having primarily a cultural character, such as languages, literature, and philosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humanities"@en .

aat:300054138 a skos:Concept ;
    skos:definition "Discipline that concerns expertise or the study of objects, environments, or experiences (as in performance art) that are visual in nature, were created by the use of skill and imagination, and possess an aesthetic that is valued and of a quality and type that would be collected by art museums. It may refer to the study of the fine arts or the fine and decorative arts together. With reference to the visual and performing arts together, use \"arts (broad discipline).\" The meaning is broader than \"works of art\" or \"art objects,\" including architecture as well. For general reference to the genre, use \"art (object genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art"@en .

aat:300054140 a skos:Concept ;
    skos:definition "Disciplines concerning arts that depend upon performances presented to the attention of observers through the live or recorded actions of the artists, such as actors, musicians, poets, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performing arts"@en .

aat:300054141 a skos:Concept ;
    skos:definition "Discipline encompassing the art and form of expression of filmmaking and motion pictures, which are produced in the media of film or videotape, on which a series of pictures are presented to the eye in such rapid succession as to give the illusion of natural movement. It may also refer to similar art created in digital media. For the actual works created on film, use \"motion pictures (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film"@en .

aat:300054144 a skos:Concept ;
    skos:definition "Performing arts genre concerning rhythmic movement, creating visual designs by a series of poses and tracing of patterns through space in the course of measured units of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance"@en .

aat:300054145 a skos:Concept ;
    skos:definition "The discipline having to do with ballet, which is artistic dance in which stylized poses and steps are combined with light and flowing figures and movements, such as leaps and turns; often combined with music, scenery, costume, and sometimes pantomime or speech to convey a story, theme, or atmosphere to the audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballet"@en .

aat:300054146 a skos:Concept ;
    skos:definition "Performing arts genre having to do with the combining of vocal or instrumental sounds in measured time to communicate emotions, ideas, or states of mind, usually according to cultural standards of rhythm, melody, and, in most Western music, harmony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music"@en .

aat:300054147 a skos:Concept ;
    skos:definition "Performing arts genre combining theater and music, in which some or all of the roles are sung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opera"@en .

aat:300054152 a skos:Concept ;
    skos:definition "Academically oriented study of theater, comprising theater criticism, history, aesthetics, and the study of drama as a specialized form of literature. For the professionally oriented study and practice of theater, use \"theater (discipline).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drama"@en .

aat:300054153 a skos:Concept ;
    skos:definition "The study and practice of recording, reproducing, broadcasting, or distributing moving visual images on magnetic tape or (in later use) in a digital format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video"@en .

aat:300054154 a skos:Concept ;
    skos:definition "Discipline concerning physical objects that are meant to be perceived primarily through the sense of sight, were created by the use of skill and imagination, and possess an aesthetic that is valued and of a quality and type that would be collected by art museums or private collectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual arts"@en .

aat:300054156 a skos:Concept ;
    skos:definition "The art or science of designing and building structures, especially habitable structures, in accordance with principles determined by aesthetic and practical or material considerations. For a general term for the actual structures or parts of structures that were made by human beings, see \"architecture (object genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architecture"@en .

aat:300054157 a skos:Concept ;
    skos:definition "Branch of architecture concerning the design of the scenic environment, including the development and planting of all types of planned outdoor green spaces, often with accompanying structures and roadways, outdoor public areas, landmarks, and structures with the aim of creating a natural setting for human structures and settlements. For the planning discipline concerned with the physical environment and any and all human involvement with it, with the objective of assuring proper habitat for people, animals, and plants and the resources on which they depend, use \"environmental design.\" For the development and decorative planting of gardens and grounds in particular, use \"landscape gardening.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape architecture"@en .

aat:300054159 a skos:Concept ;
    skos:definition "Art or science of designing and building ships and other waterborne craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval architecture"@en .

aat:300054162 a skos:Concept ;
    skos:definition "Study of the development over time of the human built environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural history"@en .

aat:300054166 a skos:Concept ;
    skos:definition "Refers to actions taken to promote the protection and continued use of the built environment for cultural, aesthetic, or historic reasons. For actions taken specifically to return an object, site, or structure to a state of historical correctness, see \"restoration (process).\" For actions taken generally to prevent further changes or deterioration in objects, sites, or structures, see \"preservation.\" For actions taken to return an already deteriorated structure to sound condition, see \"rehabilitating.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic preservation"@en .

aat:300054168 a skos:Concept ;
    skos:definition "The discipline concerning works that are primarily utilitarian in form or function, but that have aesthetic value provided by the design, decoration, or embellishment, such as ceramics, furniture, textiles, glass, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative arts"@en .

aat:300054171 a skos:Concept ;
    skos:definition "Discipline comprising the creation of conceptual schemes for the organization or appearance of graphic works, objects, structures, or systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design"@en .

aat:300054178 a skos:Concept ;
    skos:definition "Refers to the process by which a computer is used as a tool in designing architecture, landscape design, cities, transportation infrastructure, engineering projects, automobiles, computer chips, or other objects of any size. The process uses a computer program to provide an interactive drawing tool, with an interface to allow simulation and analysis. In architectural design, the computer typically allows the user to virtually walk through three-dimensional spaces, to view the architecture in position on the proposed site, and to test aspects of stress and support. It is also used to reconstruct ruined buildings and cities, and to depict archaeological sites at different periods of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-aided design"@en .

aat:300054181 a skos:Concept ;
    skos:definition "The process of designing visual communications and text for commercial applications, usually to be printed or reproduced photographically, such as in advertisements, books, magazines, newspapers, leaflets, posters, diagrams, trademarks, corporate identities, sign systems, packaging, film, television graphics, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic design"@en .

aat:300054183 a skos:Concept ;
    skos:definition "The design of functional objects that can be mass-produced, including machine-made consumer and commercial products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial design"@en .

aat:300054184 a skos:Concept ;
    skos:definition "Discipline specializing in the design of interiors of homes or other buildings, including placement of furniture, accessories, aesthetic or decorative schemes, and spatial arrangements, construction, building systems, acoustics, lighting, heating, and air conditioning of spaces. May refer to design for existing spaces or for spaces in the planning phases. For the discipline limited to the choices of color, texture, and superficial arrangement of furnishings of a space, prefer \"interior decoration.\" For the discipline focusing more on the architecture of the interior, prefer \"interior architecture (discipline).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior design"@en .

aat:300054188 a skos:Concept ;
    skos:definition "Discipline focusing on the composition of spaces, often but not always interior architectural spaces. It includes plans for the flow of the inhabitants or users of the space, adherence to building codes, environmental factors, and other such concerns. For the discipline focusing more on the aesthetic planning of spaces, prefer \"interior architecture (discipline).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space planning"@en .

aat:300054190 a skos:Concept ;
    skos:definition "The discipline of design for the stage, including design of all visual aspects of a stage production, such as scenery, properties, lighting, costume, and makeup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scenography"@en .

aat:300054195 a skos:Concept ;
    skos:definition "Discipline concerning physical objects that are that are meant to be perceived primarily through the sense of sight, are of high quality, requiring refined skill in creation, and typically using the media of painting, drawing, sculpture, and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine arts"@en .

aat:300054196 a skos:Concept ;
    skos:definition "Producing visible forms primarily by delineation, usually by the direct application of material or instrument to the surface of the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing"@en .

aat:300054200 a skos:Concept ;
    skos:definition "The art or process of providing drawings or other pictures intended to elucidate a description, story, or other written material, usually in a book or periodical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illustration"@en .

aat:300054203 a skos:Concept ;
    skos:definition "The activity of drawing or painting illustrations of fashionable apparel and accessories, especially for advertisement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion illustration"@en .

aat:300054207 a skos:Concept ;
    skos:definition "The activity of making technical illustrations, which are illustrations used to elucidate informational texts such as reference works and technical manuals, or to explain a process or concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical illustration"@en .

aat:300054210 a skos:Concept ;
    skos:definition "The technique of creating illustrations that communicate information of a scientific nature by employing exploded views, cutaways, diagrams and etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific illustration"@en .

aat:300054216 a skos:Concept ;
    skos:definition "The art and practice of applying pigments suspended in water, oil, egg yolk, molten wax, or other liquid to a surface to create an expressive or communicative image. Paint is usually, but not always, applied with a brush. For the application of paint primarily to protect a surface or add a general color, use \"painting (coating).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting"@en .

aat:300054225 a skos:Concept ;
    skos:definition "The art or process of making photographs, which are pictures produced by means of the chemical action of light on a sensitive film, glass, paper, metal, or by digital means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photography"@en .

aat:300054227 a skos:Concept ;
    skos:definition "The art and science of photographing animate or animated beings or objects in motion, using a motion picture camera. Distinct from \"chronophotography,\" which records motion or change with a series of photographic images shot with a still camera, either discrete photographs taken sequentially or a single exposure capturing movement, as blurred images. For terms concerning the overall process of making motion pictures and the various techniques involved, see descriptors under the guide term \"<filmmaking and filmmaking processes and techniques>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinematography"@en .

aat:300054228 a skos:Concept ;
    skos:definition "Use with regard to military applications of photography, such as for mapping or training. For photography in war for the purposes of historical documentation, use \"war photography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military photography"@en .

aat:300054229 a skos:Concept ;
    skos:definition "Photography created as a journalistic device; especially serial photographic documentation of significant events intended for publication in magazines and newspapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "journalistic photography"@en .

aat:300054232 a skos:Concept ;
    skos:definition "Branches of learning devoted to the arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arts-related disciplines"@en .

aat:300054233 a skos:Concept ;
    skos:definition "Study of the visual arts within a historical framework, from from prehistory to the present, including stylistic development, use of art in communication and decoration, and the aesthetic and intellectual value of art. It first became a dedicated field of study in the 19th century Western world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art history"@en .

aat:300054235 a skos:Concept ;
    skos:definition "A method of interpreting the meaning of a work of art by synthesising iconography with the full historical context. Iconology is a broader approach than iconography to analysis of meaning in the visual arts, taking account of the tradition of pictorial motifs and their historical, cultural, or social meaning. In a more narrow sense, refers to the study of icons and their specific subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iconology"@en .

aat:300054236 a skos:Concept ;
    skos:definition "Study and practice of the therapeutic use of images and objects, to foster nonverbal communication, creativity, and physical interaction, and to uncover verbal associations and interpretations, helping to identify and understand patients' emotional, motor, and perceptual dysfunctions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art therapy"@en .

aat:300054238 a skos:Concept ;
    skos:definition "The discipline involving treatment, preventive care, and research directed toward the long-term safekeeping of cultural and natural heritage. For actions taken to halt changes or deterioration in objects, sites, or structures, see \"preservation (function)\"; for changes made to an object or structure so that it will closely approximate its original or other past state, see \"restoration (process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation"@en .

aat:300054239 a skos:Concept ;
    skos:definition "Study of the physical objects made by a people for satisfaction of their needs, especially those articles required for sustenance and perpetuation of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "material culture"@en .

aat:300054240 a skos:Concept ;
    skos:definition "Scientific and orderly investigation and study of music and related areas, including history, theory, music education, acoustics, psychology, and social and cultural aspects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musicology"@en .

aat:300054241 a skos:Concept ;
    skos:definition "Branch of musicology focusing on the study of music in its cultural context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnomusicology"@en .

aat:300054242 a skos:Concept ;
    skos:definition "Area of study covering the civilizations of ancient Greece and Rome, including history, philosophy, language, literature, and to some extent art and archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classics"@en .

aat:300054244 a skos:Concept ;
    skos:definition "The study of language in general or of particular languages other than the students' native tongue, for the purpose of acquiring some degree of facility in the use of those languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "languages"@en .

aat:300054245 a skos:Concept ;
    skos:definition "Scientific study of language as a system, covering the structure, sounds, and meaning, as well as the history of the relations of languages to each other and the cultural place of language in human behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linguistics"@en .

aat:300054247 a skos:Concept ;
    skos:definition "Branch of linguistics where the primary concern is the application of linguistic theories, methods, and findings to practical language problems, such as language teaching, lexicography, translation, stylistics, and speech therapy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "applied linguistics"@en .

aat:300054248 a skos:Concept ;
    skos:definition "Study of speech communities, particularly those with no writing system, by the application of anthropological and linguistic techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropological linguistics"@en .

aat:300054250 a skos:Concept ;
    skos:definition "Branch of linguistics concerned with the use of computers for the analysis and synthesis of language data, as in translation, word frequency counts, and speech recognition and synthesis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computational linguistics"@en .

aat:300054251 a skos:Concept ;
    skos:definition "Study of writing systems and of their relation to speech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphemics"@en .

aat:300054253 a skos:Concept ;
    skos:definition "The study of the mental processes and skills underlying language acquisition, production, and comprehension, and the diagnosis and clinical treatment of speech or language problems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psycholinguistics"@en .

aat:300054254 a skos:Concept ;
    skos:definition "Theory and study of signs and symbols dealing especially with their function in languages, including syntax, semantics, and pragmatics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semiotics"@en .

aat:300054255 a skos:Concept ;
    skos:definition "The study of language as it functions in society, and of the interaction between linguistic and social variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sociolinguistics"@en .

aat:300054256 a skos:Concept ;
    skos:definition "Branch of linguistics where the primary aim is to establish universal principles for the study of language and languages, and to determine the underlying structure and other characteristics of human language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theoretical linguistics"@en .

aat:300054257 a skos:Concept ;
    skos:definition "Study of the development of or changes in words, speech, and language or groups of languages over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical linguistics"@en .

aat:300054258 a skos:Concept ;
    skos:definition "Branch of linguistics that deals with the relation of language to the rest of culture-determined behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalinguistics"@en .

aat:300054259 a skos:Concept ;
    skos:definition "The branch of grammar that studies the smallest meaningful units of languages and their formation into words, hence, also the structure of words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morphology"@en .

aat:300054262 a skos:Concept ;
    skos:definition "Study of the production, transmission, perception, classification, and physical or acoustical properties of speech sounds and how they are organized in language. For the study of the sound patterns and systems of languages, use \"phonology.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonetics"@en .

aat:300054263 a skos:Concept ;
    skos:definition "Study of the systems and patterns of language, including how speech sounds are combined, organized, and convey meaning. For the study of the production, transmission, perception, and description of speech sounds, use \"phonetics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonology"@en .

aat:300054264 a skos:Concept ;
    skos:definition "Study of the aspects of meaning in language that are related to the use of language in a natural context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pragmatics"@en .

aat:300054268 a skos:Concept ;
    skos:definition "Study of meanings in language and of changes in those meanings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semantics"@en .

aat:300054269 a skos:Concept ;
    skos:definition "That branch of grammar that studies the formation of sentences, the relationships among their component words, clauses, and phrases, and the rules governing word order in a given language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syntax"@en .

aat:300054272 a skos:Concept ;
    skos:definition "Etymological study of the place-names of a region or language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toponymy"@en .

aat:300054273 a skos:Concept ;
    skos:definition "Discipline dealing with the written and oral verbal works of a nation, region, period, or language, of a particular group or individual, of a particular form or genre, on a particular subject, or for a particular audience. For written works on a particular subject, use \"literature (documents).\" For the written works of a particular individual or group of individuals, use \"writings (documents).\" For the genre of liturature rather than the discipline that studies it, use \"literature (genre).\" Use \"book history\" for the study of the trade, production, and consumption of books as physical objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary studies"@en .

aat:300054274 a skos:Concept ;
    skos:definition "The study of similar literary works from two or more nations, periods, or languages in relation to each other, or the study of any literary phenomenon from the perspective of at least two literatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comparative literature"@en .

aat:300054275 a skos:Concept ;
    skos:definition "The theory and practice of the organization, administration, functions, and technical processes of museums, including documentation and collections management, as well as their history, philosophy, and purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museology"@en .

aat:300054277 a skos:Concept ;
    skos:definition "Superintending or managing the collections, exhibitions, research activities, and personnel of a museum, art gallery, zoo, or other place of exhibit; also, the superintending or managing of a single collection or subject of study in such an institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curating"@en .

aat:300054278 a skos:Concept ;
    skos:definition "Use generally for the study of language and literature together. Use specifically for the study of language history, especially when involving the close analysis of literary texts in the context of cultural and political research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philology"@en .

aat:300054279 a skos:Concept ;
    skos:definition "Critical examination of the grounds for fundamental beliefs and analysis of the basic concepts, doctrines, or practices that express such beliefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philosophy"@en .

aat:300054280 a skos:Concept ;
    skos:definition "Appreciation or criticism of the beautiful. The term refers to a branch of Western philosophy concerned primarily with the fine arts, although it may also be used in the context of the appreciation of natural beauty. Usage of the term dates from the 18th century, although historical discussions regarding issues now called \"aesthetics\" date from Antiquity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aesthetics"@en .

aat:300054283 a skos:Concept ;
    skos:definition "Study of values, primarily of intrinsic values (as those in ethics, aesthetics, and religion), but also of instrumental values (as those in economics), particularly with reference to the manner in which they can be known or experienced, their nature and kinds, and their ontological status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axiology"@en .

aat:300054287 a skos:Concept ;
    skos:definition "Term originating in the 16th century for the general science that describes and maps the overall features of the universe, both the heavens and the earth, encompassing what is now considered to fall within astronomy, geography, and geology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmography"@en .

aat:300054288 a skos:Concept ;
    skos:definition "Branch of philosophy that studies the nature, origin, limits, and validity of human knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epistemology"@en .

aat:300054290 a skos:Concept ;
    skos:definition "Branch of philosophy dealing with values relating to human conduct, with respect to the rightness and wrongness of certain actions, and to the goodness and badness of the motives and ends of such actions. For the concept of a system of moral principles or rules of conduct for voluntary human action, use \"ethics (concept).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethics"@en .

aat:300054292 a skos:Concept ;
    skos:definition "Refers to that branch of philosophy concerned with the forms of thought and methods of correct statement in all areas of inquiry, especially with inference, deduction, induction, and scientific proof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logic"@en .

aat:300054293 a skos:Concept ;
    skos:definition "Branch of philosophy inquring into the fundamental nature of reality, including such concepts as being, substance, essence, time, space, cause, and identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metaphysics"@en .

aat:300054294 a skos:Concept ;
    skos:definition "Branch of systematic philosophy that deals with the character of the universe as a cosmos, combining speculative metaphysics and scientific knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmology"@en .

aat:300054295 a skos:Concept ;
    skos:definition "The branch of metaphysics concerned with the nature and relations of being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ontology"@en .

aat:300054296 a skos:Concept ;
    skos:definition "Refers to the theistic philosophy that views creative becoming as the universal form of reality and emphasizes the relational nature of all being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "process philosophy"@en .

aat:300054297 a skos:Concept ;
    skos:definition "Branch of modern philosophy dealing with the description and classification of phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phenomenology"@en .

aat:300054298 a skos:Concept ;
    skos:definition "Discipline concerning the principles and rules of composition for persuasive speech, particularly as formulated by ancient critics and interpreted by classical scholars for application to discourse in the vernacular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhetoric"@en .

aat:300054300 a skos:Concept ;
    skos:definition "Study of religious beliefs and traditions in human life and culture from the perspective of the humanistic disciplines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religion"@en .

aat:300054302 a skos:Concept ;
    skos:definition "Comparative study of the characteristics of religious systems in different societies that focuses on the origin and evolution of religious beliefs and practices from earlier or less urbanized societies to modern ones, aims to develop a universal evolutionary continuum of religions, and stresses a scientific methodology. For the comparative study of religions that largely disregards evolutionary schemes and features a primarily historical methodology, use \"religious history.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comparative religion"@en .

aat:300054303 a skos:Concept ;
    skos:definition "The philosophical study of religion, especially concerning the rationality of religious beliefs, and the descriptive analysis and elucidation of religious language, belief, and practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philosophy of religion"@en .

aat:300054304 a skos:Concept ;
    skos:definition "Branch of religious study in which religious thought, experience, and behavior are studied using the concepts and methodology of psychology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychology of religion"@en .

aat:300054305 a skos:Concept ;
    skos:definition "Study of religion using the sociological method of approach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sociology of religion"@en .

aat:300054306 a skos:Concept ;
    skos:definition "Branches of learning devoted to religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religion-related disciplines"@en .

aat:300054307 a skos:Concept ;
    skos:definition "Critical study of the Bible and biblical writings, including such approaches as textual analysis, historical study, exegesis, hermeneutics, and literary and linguistic criticism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biblical studies"@en .

aat:300054308 a skos:Concept ;
    skos:definition "Study of the history of the Christian Church and its sects and branches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church history"@en .

aat:300054309 a skos:Concept ;
    skos:definition "Refers to the comparative historical study of the nature and structure of the world's religions and their diverse manifestations over time in different societies and cultures. For the comparative study of the characteristics of religious systems in different societies that aims to develop a universal evolutionary continuum of religions and stresses a scientific methodology, see \"comparative religion.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious history"@en .

aat:300054310 a skos:Concept ;
    skos:definition "Study of the doctrines of the church, including the study of ecclesiastical art, antiquities, and the adornment and equipment of churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecclesiology"@en .

aat:300054311 a skos:Concept ;
    skos:definition "The science or teachings concerned with last things, such as the end of history or of the present world, the fate of the soul after death, the final judgment of individuals, and the creation or restoration of a perfect world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eschatology"@en .

aat:300054312 a skos:Concept ;
    skos:definition "Study of ethics inspired and informed by religious doctrine, faith, and experience, also the study of religious doctrine and commitment with reference to ethics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious ethics"@en .

aat:300054313 a skos:Concept ;
    skos:definition "Study of religious doctrines and practices as understood within a particular religious tradition, usually from the viewpoint of committed religious believers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theology"@en .

aat:300054314 a skos:Concept ;
    skos:definition "Disciplines dealing with the institutions and functioning of human society and with the interpersonal relationships of individuals as members of society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social sciences"@en .

aat:300054315 a skos:Concept ;
    skos:definition "The scientific study of human history in its biological, linguistic, and social aspects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropology"@en .

aat:300054316 a skos:Concept ;
    skos:definition "The scientific, historic, or comparative study of the origins, characteristics, and functions of human cultures and societies. For the study of the history and culture of ethnic groups within a larger cultural or social order, use \"ethnic studies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnology"@en .

aat:300054319 a skos:Concept ;
    skos:definition "Direct observation and descriptive study of the culture and way of life of particular societies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnography"@en .

aat:300054321 a skos:Concept ;
    skos:definition "Study of the nature and essence of humankind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philosophical anthropology"@en .

aat:300054322 a skos:Concept ;
    skos:definition "Comparative study of human physical evolution, variation, and classification, especially through measurement and observation of living people as well as human remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical anthropology"@en .

aat:300054324 a skos:Concept ;
    skos:definition "Study of human body measurements on a comparative basis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropometry"@en .

aat:300054326 a skos:Concept ;
    skos:definition "Branch of anthropology dealing with fossil remains of the human species and its predecessors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleoanthropology"@en .

aat:300054327 a skos:Concept ;
    skos:definition "Study of anthropology through the application of structuralist theory and method in the analysis of problems and data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural anthropology"@en .

aat:300054328 a skos:Concept ;
    skos:definition "Scientific study of the material remains of past human life and activities, including human artifacts from the very earliest stone tools to the man-made objects that are buried or thrown away in the present day. Archaeological investigations are a principal source of knowledge of prehistoric, ancient, and extinct cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeology"@en .

aat:300054331 a skos:Concept ;
    skos:definition "Field of archaeology that deals with the culture and artifacts of the ancient Greek and Roman civilizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classical archaeology"@en .

aat:300054333 a skos:Concept ;
    skos:definition "Field of archaeology dealing with the sites, structures, and artifacts of the industries and processes of industrialization of former times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial archaeology"@en .

aat:300054339 a skos:Concept ;
    skos:definition "Branch of archaeology that deals with the recovery of ancient objects found beneath the sea, as shipwrecks or remains from submerged human settlements, and with the techniques of underwater exploration, excavation, and retrieval."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater archaeology"@en .

aat:300054343 a skos:Concept ;
    skos:definition "Broad area of commercial or mercantile activity involving the exchange of commodities, services, or financial resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business"@en .

aat:300054345 a skos:Concept ;
    skos:definition "Collecting data, usually in monetary terms, about economic activity, processing those data, and reporting them for the use of interested decision-makers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accounting"@en .

aat:300054347 a skos:Concept ;
    skos:definition "Public presentation of or calling attention to a product, service, event, or idea, that is openly paid for by an identified entity. Media for advertising include print and online publications, posters, television, and other media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising"@en .

aat:300054348 a skos:Concept ;
    skos:definition "Business of receiving and safeguarding money on deposit, loaning money, extending credit, and facilitating the transfer of funds by check, draft, or exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banking"@en .

aat:300054349 a skos:Concept ;
    skos:definition "Science and technology of the transmission and reception of information, between or among small or large groups of people, other living beings, or machines, including the study of signs and symbols in vocal, pictorial, gestural, and digital languages, of behavior and interaction through messages, and of large-scale institutions and systems. For the function of conveying awareness, knowledge, or information to others, use \"communication (function).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communications"@en .

aat:300054351 a skos:Concept ;
    skos:definition "Refers to the profession concerned with the systematic transmission of entertainment, information, advertising, and educational programming by radio or television for simultaneous reception by a scattered public audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadcasting"@en .

aat:300054354 a skos:Concept ;
    skos:definition "Communications field concerned with the collection, preparation, and distribution of news and related commentary through the mass media, both print and electronic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "journalism"@en .

aat:300054355 a skos:Concept ;
    skos:definition "Science of communication over long distances, especially by electronic means, such as telephone systems or broadcasting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telecommunications"@en .

aat:300054356 a skos:Concept ;
    skos:definition "Scientific study of offenders, of crime as a social phenomenon, and of the criminal justice system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "criminology"@en .

aat:300054357 a skos:Concept ;
    skos:definition "Statistical study of the characteristics of human populations especially with reference to size and density, growth, distribution, migration, and vital statistics, and the effect of all these on social and economic conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demography"@en .

aat:300054359 a skos:Concept ;
    skos:definition "Study concerned with the production, distribution, and consumption of money, goods, and services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economics"@en .

aat:300054360 a skos:Concept ;
    skos:definition "Discipline that concerns the entire process of imparting knowledge, attitudes, skills, or socially valued qualities of character or behavior. For the specific activities involved in deliberately conveying knowledge, skills, or social values to others, use \"educating.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "education"@en .

aat:300054362 a skos:Concept ;
    skos:definition "Includes activities and experiences that are intended to effect developmental changes in children from birth through the early years of elementary school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "early childhood education"@en .

aat:300054366 a skos:Concept ;
    skos:definition "Branch of education covering kindergarten through grade 3."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary education"@en .

aat:300054367 a skos:Concept ;
    skos:definition "Branch of education covering kindergarten or grade 1 through grades 6, 7, or 8."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elementary education"@en .

aat:300054368 a skos:Concept ;
    skos:definition "Branch of education covering grades 7 or 8 through to the end of high school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary education"@en .

aat:300054370 a skos:Concept ;
    skos:definition "Postsecondary education leading to a formal degree or certificate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "higher education"@en .

aat:300054373 a skos:Concept ;
    skos:definition "Education, usually at the postsecondary level and taken on a part-time or short-term basis, sometimes noncredit, designed to advance or update adult learning for personal, academic, or occupational development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuing education"@en .

aat:300054377 a skos:Concept ;
    skos:definition "The field of education that trains professional architects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural education"@en .

aat:300054384 a skos:Concept ;
    skos:definition "Scientific study of human settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ekistics"@en .

aat:300054385 a skos:Concept ;
    skos:definition "Study of human physiological and psychological capacities, limitations, and needs in relation to the human environment. In modern usage, the term is used particularly to refer to the workplace, regarding the the spaces, objects, and systems that people use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ergonomics"@en .

aat:300054387 a skos:Concept ;
    skos:definition "The study of family history and ancestry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genealogy"@en .

aat:300054388 a skos:Concept ;
    skos:definition "Science dealing with the earth and its life, especially the description of land, sea, air, and the distribution of plant and animal life, including human beings, their activities and territorial organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geography"@en .

aat:300054389 a skos:Concept ;
    skos:definition "Branch of geography that deals with the exterior physical features and changes of the earth in land, sea, and air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical geography"@en .

aat:300054392 a skos:Concept ;
    skos:definition "Study and explanation of the spatial, organizational, and behavioral patterns of people across the natural and built landscapes; includes the methods and theories of behavioral geography, cognitive geography, economic geography, marketing and decision theory, and locational analysis. For the sociological study of individuals and their near environment, use \"human ecology.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human geography"@en .

aat:300054393 a skos:Concept ;
    skos:definition "Study of aging and the special problems and capabilities of the elderly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gerontology"@en .

aat:300054394 a skos:Concept ;
    skos:definition "Discipline that studies the chronological record of events, such as affecting a nation, community, individual, object, or place, based on a critical examination of source materials and usually presenting an explanation of their causes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history"@en .

aat:300054397 a skos:Concept ;
    skos:definition "Branch of history that deals with the evolution of ideas, how these ideas were influenced by various factors, and what happens to these ideas or thoughts among people in a given society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intellectual history"@en .

aat:300054398 a skos:Concept ;
    skos:definition "Field of history concerned with topics that are distinctly localized in subject matter and source materials, generally covering specific neighborhoods, communities, counties or other specific subdivisions of larger geopolitical bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local history"@en .

aat:300054399 a skos:Concept ;
    skos:definition "The analysis and interpretation of historical events using psychological theories and insights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychohistory"@en .

aat:300054402 a skos:Concept ;
    skos:definition "History in which historical information is recorded, or histories are presented, in the form of audible speech or song."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oral history"@en .

aat:300054403 a skos:Concept ;
    skos:definition "History that concentrates on the sociocultural aspects of the life, customs, trends, and institutions of a people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social history"@en .

aat:300054404 a skos:Concept ;
    skos:definition "The history of cities and towns, the urbanization of human life, and all aspects of urban life over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban history"@en .

aat:300054406 a skos:Concept ;
    skos:definition "Study of home management, including such skills as budgeting, child care, nutrition, cooking, and sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home economics"@en .

aat:300054412 a skos:Concept ;
    skos:definition "Area of knowledge or study of the principles and regulations established in a state or community by some authority and binding on its people, whether in the form of legislation or of custom and policies recognized and enforced by judicial decision. Also the professional practice that deals with these principles and regulations and legal procedure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law"@en .

aat:300054414 a skos:Concept ;
    skos:definition "System of law concerned with private relations between members of a community rather than criminal, military, or religious affairs. Examples are systems developed from the Roman law, influenced by Germanic, ecclesiastical, and purely modern institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil law"@en .

aat:300054415 a skos:Concept ;
    skos:definition "Branch of jurisprudence that relates to crimes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "criminal law"@en .

aat:300054417 a skos:Concept ;
    skos:definition "Field of law dealing with matters relating to the environment and environmental legislation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental law"@en .

aat:300054418 a skos:Concept ;
    skos:definition "Branch of law that regulates the interrelationships of sovereign states and their rights and duties with regard to one another, in both peace and war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international law"@en .

aat:300054419 a skos:Concept ;
    skos:definition "Study of coins, tokens, medals, paper money, and objects closely resembling them in form or purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numismatics"@en .

aat:300054420 a skos:Concept ;
    skos:definition "Study of ancient modes of writing, either inscribed or in manuscript form, including their identification in terms of origin or period, and the formation of individual characters. For the study and interpretation of ancient inscriptions specifically, whether of writing, pictures, or random scratchings, use \"epigraphy.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleography"@en .

aat:300054423 a skos:Concept ;
    skos:definition "Study of the conformation of the skull as indicative of mental faculties and personal character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phrenology"@en .

aat:300054424 a skos:Concept ;
    skos:definition "Study of the interpretation of facial features with respect to qualities of mind or character, shown by peculiarities of configuration or cast or characteristic expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physiognomy"@en .

aat:300054425 a skos:Concept ;
    skos:definition "The activity of determining objectives and outlining or arranging the procedures and resources for attaining them, especially in a formal project proposal or scheme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planning"@en .

aat:300054427 a skos:Concept ;
    skos:definition "Long term planning for additions and improvements to the spatial organization and content of urban areas. It concerns planning for interaction between people, businesses, government, transportation infrastructure, mass transit, water and power infrastructure, pollution, waste management, and other broad and long term interests in an urban setting. For the overall management of urban areas, encompassing the setting of objectives for urban life, the establishment of policies, and the planning, development, operation, and maintenance of the urban environment and services, use \"urban management.\" For the field concerned with designing the specific appearance and function of cities, use “urban design.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban planning"@en .

aat:300054434 a skos:Concept ;
    skos:definition "The field of planning concerned with development, resource utilization, and environmental preservation and amelioration in rural communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural planning"@en .

aat:300054438 a skos:Concept ;
    skos:definition "The social science dealing with the principles, institutions, and conduct of politics and government, including the political behavior of individuals and organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political science"@en .

aat:300054439 a skos:Concept ;
    skos:definition "Study of the ways in which different societies establish and work with their political structures and government, with the goal of developing general theories concerning government based on the analysis of the differences and similarities among political units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comparative politics"@en .

aat:300054441 a skos:Concept ;
    skos:definition "Branch of political science concerned with political, military, and economic interactions among nations, as well as among some organizations and individuals of international status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international relations"@en .

aat:300054444 a skos:Concept ;
    skos:definition "A branch of law that deals with the organization of government, the responsibilities of public agencies and officers, and the relations between a government and its citizens, as well as those of sovereign states to one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public law"@en .

aat:300054445 a skos:Concept ;
    skos:definition "Governing principles that serve as guidelines for decision-making and action as embodied in legislative and judicial enactments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public policy"@en .

aat:300054446 a skos:Concept ;
    skos:definition "Science of human and animal mind and behavior, both healthy and unhealthy, with the focus on individuals in interaction with their environment. For the branch of medicine dealing with the treatment of mental, emotional, and behavioral disorders, use \"psychiatry.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychology"@en .

aat:300054447 a skos:Concept ;
    skos:definition "Branch of psychology dealing with the minds and behavior of ethnic groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnopsychology"@en .

aat:300054452 a skos:Concept ;
    skos:definition "Study of how people are affected by others and by their social environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social psychology"@en .

aat:300054453 a skos:Concept ;
    skos:definition "Science of society, social institutions, and social relationships; specifically the systematic study of the development, structure, and function of human groups conceived as processes of interaction or as organized patterns of collective behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sociology"@en .

aat:300054454 a skos:Concept ;
    skos:definition "Associated with the Frankfurt School of critical sociology founded in 1923, it refers to the exercise of negative judgment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "critical theory"@en .

aat:300054456 a skos:Concept ;
    skos:definition "Branch of sociology concerned with study of the origins, stages, and laws of social life and social institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical sociology"@en .

aat:300054457 a skos:Concept ;
    skos:definition "Refers to the branch of sociology dealing with rural communities and rural life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural sociology"@en .

aat:300054459 a skos:Concept ;
    skos:definition "Refers to the branch of sociology that studies the relation between thought and society, particularly the social processes and structures that produce or condition the forms and the content of knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sociology of knowledge"@en .

aat:300054460 a skos:Concept ;
    skos:definition "Branch of sociology that deals with social relationships and structures in urban communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban sociology"@en .

aat:300054461 a skos:Concept ;
    skos:definition "The overall study of human settlements and human life in settlements, with the primary frame of reference being cities and towns, and the focus on solving urban problems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban studies"@en .

aat:300054462 a skos:Concept ;
    skos:definition "Refers to the group of studies or branches of knowledge concerned with facts and phenomena of the observable or quantifiable world, systematically arranged and showing the operation of general laws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science"@en .

aat:300054463 a skos:Concept ;
    skos:definition "Science or discipline of cultivating the soil, harvesting crops, and raising livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agriculture"@en .

aat:300054464 a skos:Concept ;
    skos:definition "Division of the natural sciences, consisting of those sciences that deal with the organic world, including all aspects of living beings and the systems that sustain them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological sciences"@en .

aat:300054465 a skos:Concept ;
    skos:definition "Discipline concerned with the structure, function, and development of the cells, tissues, and organs constituting the animal body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anatomy"@en .

aat:300054466 a skos:Concept ;
    skos:definition "The study of living organisms, including their structure, functioning, origin and evolution, classification, interrelationships, and distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biology"@en .

aat:300054467 a skos:Concept ;
    skos:definition "The scientific study of all plant life, including their structure, properties, and biochemical processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botany"@en .

aat:300054468 a skos:Concept ;
    skos:definition "Branch of biology dealing with the relations and interactions between organisms and their habitat, including other organisms. For aggregates of physical things, conditions, and influences surrounding and affecting given organisms or communities of organisms at any time, use \"environments (object groupings).\" For the concept of the external world, including the forces at work in it and the nonhuman life inhabiting it, perceived by human beings as separate and independent from themselves, their activities and civilization, use \"Nature.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecology"@en .

aat:300054469 a skos:Concept ;
    skos:definition "Branch of biology that deals with micro-organisms such as bacteria, viruses, and fungi, and their effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microbiology"@en .

aat:300054470 a skos:Concept ;
    skos:definition "The study of the structure and function of large molecules associated with living organisms, particularly proteins and the nucleic acids DNA and RNA."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molecular biology"@en .

aat:300054471 a skos:Concept ;
    skos:definition "Biological science concerned with the mechanisms of animal function, from the level of the cell to that of the whole organism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physiology"@en .

aat:300054472 a skos:Concept ;
    skos:definition "The scientific study of animals, including their anatomy, physiology, biochemistry, genetics, ecology, evolution, and behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoology"@en .

aat:300054473 a skos:Concept ;
    skos:definition "Comparative study of automatic control systems and communication processes in both living organisms and machines. The study links the working of the brain and nervous system with the functioning of computers and automated feedback devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cybernetics"@en .

aat:300054474 a skos:Concept ;
    skos:definition "The discipline of applying technical, scientific, and mathematical knowledge to the design and construction of architecture, machines, systems, processes, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineering"@en .

aat:300054478 a skos:Concept ;
    skos:definition "Branch of engineering that deals with the design, development, testing, and production of aircraft, spacecraft, missiles, rocket propulsion systems, and other equipment operating both within and beyond the earth's atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerospace engineering"@en .

aat:300054480 a skos:Concept ;
    skos:definition "Discipline in which chemistry, physics, and mathematics are combined with basic engineering principles to solve environmental, biomedical, societal, or technological problems arising in the application of chemistry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical engineering"@en .

aat:300054481 a skos:Concept ;
    skos:definition "Branch of engineering concerned primarily with public works such as highways, bridges, waterways, harbors, and water supply systems, but also private enterprises such as land drainage and railroad building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil engineering"@en .

aat:300054483 a skos:Concept ;
    skos:definition "Professional application of scientific principles and technical practices to the management and optimum use of air, water, and land resources, with the goal of protecting the environment from the adverse effects of human activity, protecting human populations from the effects of adverse environmental factors, and improving environmental quality for human health and well-being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental engineering"@en .

aat:300054485 a skos:Concept ;
    skos:definition "Branch of enironmental engineering specifically concerned with the protection and promotion of the public health, specifically with the provision of clean air, food, water, and housing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanitary engineering"@en .

aat:300054489 a skos:Concept ;
    skos:definition "Branch of civil engineering discipline dealing with the design and production of systems, equipment, and structures that either control, transport, or generate power from water or other fluids or that derive some or all of their power from the flow of water, such as hydraulic machinery, sewage disposal plants, waterworks, dams, pipelines, and hydroelectric power plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic engineering"@en .

aat:300054490 a skos:Concept ;
    skos:definition "Branch of engineering that deals with the practical application of electricity, especially with the design and construction of electrical devices, the transmission of electrical power, and communication devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical engineering"@en .

aat:300054494 a skos:Concept ;
    skos:definition "Professional field applying principles of engineering and scientific management in industrial enterprises to maintain efficiency and high productivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial engineering"@en .

aat:300054496 a skos:Concept ;
    skos:definition "The study of the characteristics and use of materials, such as metal, ceramic, glass, polymers, and composite materials; includes the development of new materials with specific properties to suit specific contexts or functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "materials science"@en .

aat:300054497 a skos:Concept ;
    skos:definition "Branch of engineering concerned with the development, production, and application of ceramic and ceramic products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramic engineering"@en .

aat:300054499 a skos:Concept ;
    skos:definition "Study of the structure of metal and alloys as related to properties that are important in their technological utilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallurgy"@en .

aat:300054500 a skos:Concept ;
    skos:definition "Field dealing with the synthesis, characterization, formulation, processing, and use of polymer or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymer science"@en .

aat:300054504 a skos:Concept ;
    skos:definition "Study and application of the principles of mechanics, thermodynamics, and material properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical engineering"@en .

aat:300054505 a skos:Concept ;
    skos:definition "The branch of engineering concerned with the daily technical and managerial operations of a factory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant engineering"@en .

aat:300054506 a skos:Concept ;
    skos:definition "Branch of civil engineering dealing primarily with the design and construction of structures such as bridges, buildings, and dams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural engineering"@en .

aat:300054507 a skos:Concept ;
    skos:definition "Branch of engineering involving the design of relatively large-scale, complex systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "systems engineering"@en .

aat:300054508 a skos:Concept ;
    skos:definition "Branch of civil engineering concerned with the design and construction of streets and roads that will best facilitate traffic movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic engineering"@en .

aat:300054510 a skos:Concept ;
    skos:definition "Interdisciplinary area of study, education, and research into the environment, including effective resource use, resource conservation, and environmental protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental sciences"@en .

aat:300054511 a skos:Concept ;
    skos:definition "The science, management, and cultivation of forests for recreation, timber production, conservation, and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forestry"@en .

aat:300054512 a skos:Concept ;
    skos:definition "Intensive and extensive cultivation of garden plants including fruits, vegetables, flower crops, and landscape and nursery crops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horticulture"@en .

aat:300054513 a skos:Concept ;
    skos:definition "The cultivation of flowers or flowering plants, especially on a commercial scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floriculture"@en .

aat:300054514 a skos:Concept ;
    skos:definition "Branch of horticulture concerned with the cultivation of ornamental trees, shrubs, flowers, and other plants, primarily for landscape amenity and not food-producing purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornamental horticulture"@en .

aat:300054515 a skos:Concept ;
    skos:definition "Broad category of sciences and professions that deal with the health of humans and animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health sciences"@en .

aat:300054516 a skos:Concept ;
    skos:definition "Study of the processes of human health and disease, giving special attention to spinal mechanics, musculoskeletal, neurological, vascular, nutritional, and environmental relationships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiropractic"@en .

aat:300054517 a skos:Concept ;
    skos:definition "Science or profession concerned with the teeth and associated structures of the mouth, involving the prevention, diagnosis, and treatment of disease, injury, or malformation of the teeth, gums, and jaws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dentistry"@en .

aat:300054518 a skos:Concept ;
    skos:definition "Discipline concerned with the study of human diseases and injuries, including their causes, treatment, and prevention, and with the diagnosis and management of patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine"@en .

aat:300054519 a skos:Concept ;
    skos:definition "The study and practice of caring for and waiting on the sick, injured, or others unable to look after themselves or to deal with their specific medical needs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing"@en .

aat:300054520 a skos:Concept ;
    skos:definition "Study and practice of preparing, preserving, compounding, and dispensing medicinal drugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharmacy"@en .

aat:300054521 a skos:Concept ;
    skos:definition "Branch of medicine that deals with the treatment of mental, emotional, and behavioral disorders, especially as originating in endogenous causes or as resulting from problematic interpersonal relationships. For the general science of human and animal mind, emotions, and behavior, healthy as well as unhealthy, use \"psychology.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychiatry"@en .

aat:300054522 a skos:Concept ;
    skos:definition "Science of numbers, magnitudes, quantities expressed symbolically, and forms and figures, including their interrelationships and the operations performed on them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathematics"@en .

aat:300054523 a skos:Concept ;
    skos:definition "Branch of mathematics that investigates general statements of relations, using letters and other symbols to represent specific mathematics entities such as sets of numbers, values, vectors, and series."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "algebra"@en .

aat:300054524 a skos:Concept ;
    skos:definition "Mathematics that deals with concrete problems of data in the empirical sciences, rather than fundamental theory or principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "applied mathematics"@en .

aat:300054525 a skos:Concept ;
    skos:definition "Branch of mathematics dealing with the properties, relationships, and computation of real numbers, involving chiefly addition, subtraction, multiplication, and division."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arithmetic"@en .

aat:300054526 a skos:Concept ;
    skos:definition "Statistical study of biological observations and phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biometrics"@en .

aat:300054528 a skos:Concept ;
    skos:definition "A method of calculation and especially one of several highly systematic methods of treating problems by a special system of algebraic notations, as differential or integral calculus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calculus"@en .

aat:300054529 a skos:Concept ;
    skos:definition "Branch of mathematics dealing with the measurement, relationships and properties of points, lines, curves, angles, surfaces, and solid figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometry"@en .

aat:300054531 a skos:Concept ;
    skos:definition "Branch of mathematics dealing with the relations holding among the sides and angles of triangles and among closely related magnitudes, especially with methods of deducing from given parts other required parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trigonometry"@en .

aat:300054532 a skos:Concept ;
    skos:definition "Division of the natural sciences that systematically studies inanimate matter and energy apart from the vitality of living beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical sciences"@en .

aat:300054534 a skos:Concept ;
    skos:definition "The science that deals with the material universe beyond the earth's atmosphere, comprising the study of celestial objects and extraterrestrial phenomena, and of the nature and history of the universe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomy"@en .

aat:300054535 a skos:Concept ;
    skos:definition "Study of astronomical phenomena in terms of the underlying physical processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrophysics"@en .

aat:300054537 a skos:Concept ;
    skos:definition "Branch of physical science that deals with the composition and properties of the elementary substances of which all bodies are composed, the laws that regulate their combination, and the various phenomena that accompany their exposure to diverse physical conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemistry"@en .

aat:300054538 a skos:Concept ;
    skos:definition "The study of the chemistry of living organisms and the reactions and methods for identifying their chemical substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biochemistry"@en .

aat:300054540 a skos:Concept ;
    skos:definition "The study of chemical reactions and properties of all the elements and their compounds, with the exception of hydrocarbons; however, usually includes carbides, carbon oxides, metallic carbonates, carbon-sulfur compounds, and carbon-nitrogen compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic chemistry"@en .

aat:300054541 a skos:Concept ;
    skos:definition "Branch of chemistry dealing with hydrocarbons and their derivatives, found in organic structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic chemistry"@en .

aat:300054542 a skos:Concept ;
    skos:definition "The sciences concerned with the nature, origin, evolution, and behavior of the solid earth, its waters, and the air that envelops it, including the geologic, hydrologic, and atmospheric sciences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth sciences"@en .

aat:300054543 a skos:Concept ;
    skos:definition "Study of the chemical composition of the earth. It involves estimating the abundance of the constituent elements and their isotopes, as well as their distribution in the lithosphere, atmosphere, biosphere, and hydrosphere, and in the rocks and minerals that make up the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geochemistry"@en .

aat:300054544 a skos:Concept ;
    skos:definition "Science that determines the size and shape of the earth or other celestial bodies, and carries out measurements and computations necessary for accurate mapping of the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geodesy"@en .

aat:300054546 a skos:Concept ;
    skos:definition "Science that deals with the physical history of the earth, the rocks of which it is composed, and the physical changes which it has undergone and is undergoing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geology"@en .

aat:300054547 a skos:Concept ;
    skos:definition "Science that deals with the land and submarine relief features of the earth's surface and seeks a generic interpretation of them using the principles of geology in its descriptive aspects and of structural geology in its explanatory phases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geomorphology"@en .

aat:300054548 a skos:Concept ;
    skos:definition "Branch of physics dealing with the physical forces acting on, and particularly within, the earth. It includes the study of earthquake waves, geomagnetism, gravitational fields, and electrical conductivity using precise quantitative principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geophysics"@en .

aat:300054549 a skos:Concept ;
    skos:definition "Description and study of seas, lakes, and other bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrography"@en .

aat:300054550 a skos:Concept ;
    skos:definition "Science dealing with the atmosphere and all of its varied phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorology"@en .

aat:300054552 a skos:Concept ;
    skos:definition "The scientific study of minerals, including their formation, occurrence, properties, composition, and classification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineralogy"@en .

aat:300054553 a skos:Concept ;
    skos:definition "Science dealing with the physical and biological properties and phenomena of the oceans and seas, including their exploration, preservation, use, and interactions with air, dry land, and all life forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oceanography"@en .

aat:300054556 a skos:Concept ;
    skos:definition "Science that deals with the origin, history, occurrence, structure, chemical composition, and classification of rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petrology"@en .

aat:300054557 a skos:Concept ;
    skos:definition "Science concerned with all aspects of soils, including their origin, distribution, classification, utilization, physical and chemical properties, and the role of organisms in soil production and in relation to soil character. For the branch of agriculture that deals with land cultivation, soil management, and field crop improvement, management, and production, see \"agronomy\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil science"@en .

aat:300054558 a skos:Concept ;
    skos:definition "The study of the form, pattern, and evolution of large-scale units of the earth's crust, such as basins, disturbed belts, forelands, and continental shelves. For the study of smaller, individual geological structures, use \"structural geology.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tectonics"@en .

aat:300054559 a skos:Concept ;
    skos:definition "Science that studies the laws determining the structure of the observable universe and the interaction between its fundamental constituents, such as matter and energy, with the broad goal of explaining natural phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physics"@en .

aat:300054560 a skos:Concept ;
    skos:definition "Field concerned with the application of techniques developed in engineering to problems in physics, and the application of new concepts developed in the basic sciences, particularly physics, to engineering problems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "applied physics"@en .

aat:300054562 a skos:Concept ;
    skos:definition "Branch of physics that deals with sound and sound waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustics"@en .

aat:300054565 a skos:Concept ;
    skos:definition "Branch of physics that deals with the properties, relationships, and interactions of elementary particles, especially those produced in collisions involving very high energies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particle physics"@en .

aat:300054566 a skos:Concept ;
    skos:definition "Science that deals with practical applications of water or other liquids in motion, such as the transmission of energy or the effects of flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulics"@en .

aat:300054567 a skos:Concept ;
    skos:definition "Branch of physics aimed at deducing the consequences of established physical theories using mainly the method of mathematical solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathematical physics"@en .

aat:300054568 a skos:Concept ;
    skos:definition "Study of forces on matter or systems, involving the identification and description of such systems by cause-and-effect associations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanics"@en .

aat:300054569 a skos:Concept ;
    skos:definition "Branch of physics dealing with the structure of atomic nuclei and their interactions with each other, their constituent particles, and the whole spectrum of elementary particles provided by very large accelerators, with particular reference to the generation of nuclear energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear physics"@en .

aat:300054570 a skos:Concept ;
    skos:definition "Branch of physics that deals with the properties and phenomena of both visible and invisible light, including its generation, transmission, and detection or perception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optics"@en .

aat:300054572 a skos:Concept ;
    skos:definition "The branch of dynamics concerned with the action of forces in producing equilibrium or relative rest, and with the forces acting on systems and structures in equilibrium. Formerly, statics referred to weight and its mechanical effects, and with the conditions of equilibrium resulting from the distribution of weight; it was considered in opposition to dynamics, as dynamics was previously defined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statics"@en .

aat:300054573 a skos:Concept ;
    skos:definition "Fields that are interdisciplinary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross- and interdisciplinary fields"@en .

aat:300054574 a skos:Concept ;
    skos:definition "Refers to the study of the nature, collection, and management of data and information in automated environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information science"@en .

aat:300054575 a skos:Concept ;
    skos:definition "Study of phenomena related to computers, including the construction, operation, programming, and applications of computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer science"@en .

aat:300054576 a skos:Concept ;
    skos:definition "The profession concerned with the application of knowledge and those principles, theories, techniques, and technologies which contribute to the establishment, preservation, organization and utilization of libraries and library materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library science"@en .

aat:300054578 a skos:Concept ;
    skos:definition "Studies such as language, philosophy, history, literature, and abstract science, that are presumed to provide chiefly general knowledge and to develop the general intellectual capacities such as reason or judgement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liberal arts"@en .

aat:300054580 a skos:Concept ;
    skos:definition "Disciplines as taught in Medieval universities, such as grammar, logic, rhetoric, arithmetic, geometry, music, astronomy, physics, metaphysics, and moral philosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medieval disciplines"@en .

aat:300054581 a skos:Concept ;
    skos:definition "One of the three ancient categories of learning, along with the seven liberal and the seven mechanical arts; included magic, divination, and thievery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forbidden arts"@en .

aat:300054582 a skos:Concept ;
    skos:definition "Studies comprising the trivium and quadrivium in the Middle Ages, usually arithmetic, geometry, astronomy, music, grammar, rhetoric, and logic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liberal arts"@en .

aat:300054583 a skos:Concept ;
    skos:definition "Group of studies in the Middle Ages constituting the higher division of the seven liberal arts and consisting of arithmetic, music, geometry, and astronomy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrivium"@en .

aat:300054584 a skos:Concept ;
    skos:definition "Group of studies in the Middle Ages forming the elementary division of the seven liberal arts and consisting of grammar, rhetoric, and logic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trivium"@en .

aat:300054585 a skos:Concept ;
    skos:definition "In Medieval times, practical areas of knowledge such as weaponry, military science, navigation, hunting, medicine, and construction arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical arts"@en .

aat:300054587 a skos:Concept ;
    skos:definition "Range of studies, theories, and practices involving a belief in and knowledge or use of supernatural forces or beings, the goal of practice being the manipulation or subversion of natural laws to achieve some desired purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occult sciences"@en .

aat:300054588 a skos:Concept ;
    skos:definition "A form of chemistry and speculative philosophy practiced in the Middle Ages and the Renaissance and concerned principally with discovering methods for transmuting base metal into gold and with finding a universal solvent and an elixir of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alchemy"@en .

aat:300054589 a skos:Concept ;
    skos:definition "The study that assumes and attempts to interpret and foretell the influence of the stars, moon, and planets upon human affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrology"@en .

aat:300054590 a skos:Concept ;
    skos:definition "Study and practice of ritual activities intended to control or influence human or natural events through the invocation of external and impersonal mystical forces beyond the ordinary human sphere; typical ritual activities include the manipulation of special objects and the recitation of spells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magic"@en .

aat:300054591 a skos:Concept ;
    skos:definition "Popularized, general term for varied belief systems or rituals derived from African diaspora religions practiced in the Caribbean or southern United States, or in West Africa itself that combine elements of Roman Catholic ritual with traditional West African elements. It is recommended to avoid use of this term, but instead to reference more specific concepts such as Vodou, Vodun, or Voodoo (Mississippi River)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voodoo"@en .

aat:300054594 a skos:Concept ;
    skos:definition "Functions including organizing, supervising, and carrying out the activities of a person, group, organization, or enterprise, and controlling its human and material resources, involving primarily the application rather than the formulation of policy. When the formulation of policy is the primary aspect, use \"administration.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "management"@en .

aat:300054595 a skos:Concept ;
    skos:definition "Examining an object, action, material, or concept in detail by separating it into its fundamental elements or component parts, reducing something complex into its various simple elements. It is the opposite process to \"synthesis.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analysis"@en .

aat:300054596 a skos:Concept ;
    skos:definition "Systematic, quantitative appraisal of a project to determine whether its benefits justify its costs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cost benefit analysis"@en .

aat:300054601 a skos:Concept ;
    skos:definition "Determining the legitimacy of a document or other artifact, or validating a document, as done by an authorized person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authentication"@en .

aat:300054602 a skos:Concept ;
    skos:definition "Offering a specific sum as the price one will pay or charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidding"@en .

aat:300054605 a skos:Concept ;
    skos:definition "Planning, coordinating, and allocating financial resources and expenditures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "budgeting"@en .

aat:300054607 a skos:Concept ;
    skos:definition "Judging how well a building performs its functions, through an understanding of the building's purpose, present use, environment, and history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building diagnostics"@en .

aat:300054608 a skos:Concept ;
    skos:definition "The process of building by combining parts or elements, and also for the manner in which the buiilt work has been put together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction"@en .

aat:300054612 a skos:Concept ;
    skos:definition "The entering of two or more legally competent parties into a binding agreement to do or not to do something, subject to specified terms and conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contracting"@en .

aat:300054614 a skos:Concept ;
    skos:definition "Contracting with a third party to perform all or a specific part of the obligations required in another contract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subcontracting"@en .

aat:300054615 a skos:Concept ;
    skos:definition "Process of making choices between or among alternatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decision making"@en .

aat:300054617 a skos:Concept ;
    skos:definition "Giving an approximate or tentative judgment regarding the value or quality of something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estimating"@en .

aat:300054621 a skos:Concept ;
    skos:definition "Determining qualitative or quantitative worth or significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evaluation"@en .

aat:300054622 a skos:Concept ;
    skos:definition "Generally reserved for the process or function of assigning a price for a thing based on market value, insurance value, or another such means of estimation; often determined by comparing the thing to other similar things that have been sold in a recent timespan. An example is the insurance value of an item that is vouched for by a reputable antiquarian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appraising"@en .

aat:300054624 a skos:Concept ;
    skos:definition "Broadly, functions associated with the organization and control of information, including processing, storage, and retrieval. For the gathering and recording of information, see \"documenting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information management"@en .

aat:300054625 a skos:Concept ;
    skos:definition "Production of a document surrogate which summarizes the subject matter or describes other essential qualities of the document. For the process of making visual forms less representational, see \"abstraction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abstracting"@en .

aat:300054626 a skos:Concept ;
    skos:definition "Recording the entry of items into a collection in the order of acquisition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessioning"@en .

aat:300054627 a skos:Concept ;
    skos:definition "Filing or collecting (as records or documents) in an archive or other repository."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archiving"@en .

aat:300054631 a skos:Concept ;
    skos:definition "Arranging a series or system of classes in order according to a principle, concept, purpose, interest, or other established criteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classification"@en .

aat:300054636 a skos:Concept ;
    skos:definition "Creating and manipulating data in machine-readable form by means of computers, including inputting, storage, conversion, editing, and printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data processing"@en .

aat:300054638 a skos:Concept ;
    skos:definition "The process or function of gathering and recording information, especially to record facts or characteristics or to establish evidence or testimony. For the organizing and controlling of information, use \"information management.\" For the records of information, use \"documents.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentation"@en .

aat:300054640 a skos:Concept ;
    skos:definition "Assigning key words or subject headings to texts, files, or documents. Indexing entails preparing indexes for books or other publications, or analyzing the subject content of textual or visual documents and assigning terms or strings of terms representing that content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexing"@en .

aat:300054641 a skos:Concept ;
    skos:definition "Composing precise, logical sequences of instructions that direct the actions of a computer or computer system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer programming"@en .

aat:300054645 a skos:Concept ;
    skos:definition "Examining or reviewing officially."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inspection"@en .

aat:300054651 a skos:Concept ;
    skos:definition "Granting lawful authority to an individual or group to do something which would be illegal or invalid without that authorization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "licensing"@en .

aat:300054672 a skos:Concept ;
    skos:definition "The study and practice of the administration of museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museum administration"@en .

aat:300054673 a skos:Concept ;
    skos:definition "Activity by which the transfer of title or possession of goods or the supplying of services from seller to buyer is effected, including advertising, shipping, storing, and selling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marketing"@en .

aat:300054676 a skos:Concept ;
    skos:definition "A body of methods, procedures, working concepts, rules, and postulates employed by a science, art, or discipline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methodology"@en .

aat:300054681 a skos:Concept ;
    skos:definition "Teaching methodology using cases as a pedagogical tool in fields such as law, business, medicine, and education. Cases may include real and imagined scenarios, critical incident analysis, case studies, vignettes, and anecdotal accounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case method"@en .

aat:300054682 a skos:Concept ;
    skos:definition "Methology used in running experiments, involving duplication of the essential characteristics of a task or situation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simulation methods"@en .

aat:300054686 a skos:Concept ;
    skos:definition "The actions, functions, or event of issuing printed, taped, or otherwise reproduced records of knowledge or visual works in any medium for sale or distribution to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publishing"@en .

aat:300054687 a skos:Concept ;
    skos:definition "Conducting diligent and systematic inquiry or investigation into a subject or question, especially in order to discover or revise facts or theories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research"@en .

aat:300054688 a skos:Concept ;
    skos:definition "Going over or examining critically or deliberately, for example, examining a literary work, work of art, concert, play, etc., with the intention of publishing the critique in a periodical or newspaper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "review"@en .

aat:300054690 a skos:Concept ;
    skos:definition "Overseeing activity in an organization; also, the overseeing by the original artist of the production of such things as photographic prints. For the activity of directing the business affairs and human and material resources of an organization or enterprise, involving primarily the formulation of policy, use \"administration.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supervising"@en .

aat:300054691 a skos:Concept ;
    skos:definition "The process of conducting an examination or inspection in order to achieve a comprehensive view, as of a place, a situation, or an area of study, or to ascertain condition or value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveying"@en .

aat:300054694 a skos:Concept ;
    skos:definition "Recording the configuration of a surface, including its relief and the locations of its natural and man-made features, usually indicated by means of contour lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topographical surveying"@en .

aat:300054695 a skos:Concept ;
    skos:definition "Examining and measuring critically the qualities or abilities of something or someone, often with reference to established standards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testing"@en .

aat:300054698 a skos:Concept ;
    skos:definition "Forming or producing letters to record the ideas which characters and words express or to communicate the ideas by visible signs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing"@en .

aat:300054700 a skos:Concept ;
    skos:definition "Collecting, preparing, altering, and arranging materials for publication or public presentation, including but not restricted to data, written materials, film, and tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "editing"@en .

aat:300054701 a skos:Concept ;
    skos:definition "Writing of manuals, reports, proposals, descriptions, or other documentation, usually highly specialized or concerned with practical applications, used for scientific engineering, business, or other technical purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical writing"@en .

aat:300054702 a skos:Concept ;
    skos:definition "Documenting in writing the requirements of a project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specification writing"@en .

aat:300054704 a skos:Concept ;
    skos:definition "Refers to handmade articles, the creation of which require skill, dexterity, and at least a certain amount of aesthetic sensibility. Media may include textiles, ceramics, paperwork, needlework, woodworking, and others. Although there is overlap, crafts are often distinguished from \"fine arts,\" in that the fine arts are of the media of painting, sculpture, drawing, and architecture, which were traditionally considered by many to require greater aesthetic sensibility, education, and training, even though this view may in fact be biased. Historically in Western art, the fine arts required extensive formal training and were taught primarily to males, whereas crafts were often taught at home or in an informal setting, and to females as well as to males."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crafts"@en .

aat:300054706 a skos:Concept ;
    skos:definition "Activity or occupation of laying out or cultivating an area of plants, or other occupations involving horticulture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gardening"@en .

aat:300054708 a skos:Concept ;
    skos:definition "The development and decorative planting of gardens and grounds. For the branch of architecture that deals with the design of the scenic environment, including the development and planting of all types of planned outdoor green spaces with the aim of creating a natural setting for buildings, towns, and cities, use \"landscape architecture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape gardening"@en .

aat:300054709 a skos:Concept ;
    skos:definition "Arranging and modifying the effects of the natural environment for aesthetic effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscaping"@en .

aat:300054710 a skos:Concept ;
    skos:definition "Process or action of digging to extract metal, coal, or other substances, or to create a tunnel, such as under a wall, fort, mountain, or another thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mining"@en .

aat:300054711 a skos:Concept ;
    skos:definition "The activity of setting or placing a seed, bulb, seedling, or other plant in the ground so that it may take root and grow; establishing a garden, orchard, field of crops, woods, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planting"@en .

aat:300054714 a skos:Concept ;
    skos:definition "Determining or fixing a date of origination, fabrication, composition, or occurrence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dating"@en .

aat:300054715 a skos:Concept ;
    skos:definition "The technique of dating events, intervals of time, and variations in environment understood by studying the sequence of and differences between rings of growth in trees and aged wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dendrochronology"@en .

aat:300054717 a skos:Concept ;
    skos:definition "Method of dating, based on the known half-life of carbon-14, by measuring the amount of low-level radioactivity of carbon remaining in ancient and dead material of organic origin and thus determining when a plant or animal had died."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiocarbon dating"@en .

aat:300054718 a skos:Concept ;
    skos:definition "Luminescence dating technique, where mineral samples are heated to 400 to 500 degrees Celsius and are measured to determine the release of stored energy in the form of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoluminescence dating"@en .

aat:300054719 a skos:Concept ;
    skos:definition "Taking action which keeps people, physical objects, or property operational or sustains them in their existing state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maintenance"@en .

aat:300054727 a skos:Concept ;
    skos:definition "Occurrences of rapid descent of large masses of snow or ice down a mountainside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avalanches"@en .

aat:300054728 a skos:Concept ;
    skos:definition "Occasions of shaking or trembling of earth, divisible into two major types, volcanic or tectonic, according to the major precipitating factor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthquakes"@en .

aat:300054731 a skos:Concept ;
    skos:definition "Risings and overflowings of bodies of water, covering land not usually underwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floods"@en .

aat:300054733 a skos:Concept ;
    skos:definition "Accurately, refers to high water waves caused by the movement of the tide. Now in common usage, refers to exceptionally large and often destructive ocean waves caused by an earthquake, landslide, or other event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tidal waves"@en .

aat:300054734 a skos:Concept ;
    skos:definition "Violent disturbances of the atmosphere attended by wind and usually also by rain, snow, sleet, or hail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storms"@en .

aat:300054735 a skos:Concept ;
    skos:definition "Long, severe snowstorms, often accompanied by strong winds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blizzards"@en .

aat:300054738 a skos:Concept ;
    skos:definition "Violent, destructive whirling winds, accompanied by funnel-shaped clouds, that progress in a narrow path over the land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tornadoes"@en .

aat:300054739 a skos:Concept ;
    skos:definition "Violent storms or hurricanes that generally occur in the China seas, or across India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typhoons"@en .

aat:300054741 a skos:Concept ;
    skos:definition "Storms in which falling rain freezes as soon as it touches any object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice storms"@en .

aat:300054742 a skos:Concept ;
    skos:definition "Periodic winds in various latitudes in the Indian Ocean and South Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monsoons"@en .

aat:300054743 a skos:Concept ;
    skos:definition "Desert windstorms that are accompanied by clouds of sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandstorms"@en .

aat:300054751 a skos:Concept ;
    skos:definition "Public sales of property to the highest bidder, as by successive increased bids. May refer to a single sales event as well as to multiple sales over a period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auctions"@en .

aat:300054754 a skos:Concept ;
    skos:definition "Formal acts or series of acts, especially those conducted elaborately, solemnly, and as prescribed by the ritual or protocol of religious, state, court, social, or tribal procedure. For events serving to call someone or something to remembrance, use \"commemorations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonies"@en .

aat:300054756 a skos:Concept ;
    skos:definition "Ceremonies that celebrate the structure of a building under construction reaching its highest point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toppings out"@en .

aat:300054760 a skos:Concept ;
    skos:definition "Events during which parties compete for an honor, job, or the like. A prime example is in the context of art and architecture, where a competition is a formal process by which competing architects or artists submit plans, and often budgets and other information, to the same client or patron for the same architectural or artistic project. For the physical works produced by the competition, use \"competitions (object groupings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "competitions"@en .

aat:300054766 a skos:Concept ;
    skos:definition "Organized, usually named, temporary public displays of works of art, crafts, natural history, science, or other items of cultural interest. For less formal and isolated displays of works, prefer \"showings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibitions"@en .

aat:300054769 a skos:Concept ;
    skos:definition "Events by which something new is put officially into operation, often but not always formal, public, and invitational."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "openings"@en .

aat:300054770 a skos:Concept ;
    skos:definition "Events which are advance showings of a performance such as a film, play, or exhibition, before being made available to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "previews"@en .

aat:300054773 a skos:Concept ;
    skos:definition "Exhibitions of art, artifacts, or other items designed to be mounted in several venues, circulating from one museum, gallery, or other display space to another over a period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling exhibitions"@en .

aat:300054776 a skos:Concept ;
    skos:definition "Exhibitions in which different exhibitors participate to publicize and promote their products, services, or activities, sometimes though not necessarily involving buying and selling, and often combined with entertainment. For meetings of buyers and sellers at stated times and places for the purpose of trade, use \"markets (events).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fairs"@en .

aat:300054777 a skos:Concept ;
    skos:definition "Exhibitions of the products and services of a particular market or industry, with attendance usually restricted to members of the relevant trades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade shows"@en .

aat:300054778 a skos:Concept ;
    skos:definition "International expositions that feature exhibits on arts, agriculture, science, and industry, with participants from around the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "world's fairs"@en .

aat:300054779 a skos:Concept ;
    skos:definition "Fairs that showcase advancements in science and the arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial expositions"@en .

aat:300054788 a skos:Concept ;
    skos:definition "Events comprising of the coming together of two or more people or assemblies of people for social, business, academic, or other purposes. Instances of assemblies or the coming together of two or more people for social, business, academic, or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meetings"@en .

aat:300054789 a skos:Concept ;
    skos:definition "Meetings of two or more people for discussing matters of common concern, usually a formal or public exchange of views."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conferences"@en .

aat:300054792 a skos:Concept ;
    skos:definition "Formal meetings at which several specialists deliver short addresses on a topic or on related topics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symposia"@en .

aat:300054795 a skos:Concept ;
    skos:definition "Journeys or excursions, either for business, pleasure, or education, that include visiting numerous places in a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tours"@en .

aat:300054796 a skos:Concept ;
    skos:definition "Extended tours; the tour is often used to refer to European tours through France, Germany, Italy, and Switzerland; formerly taken by youth of the aristocracy as part of their education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand tours"@en .

aat:300055018 a skos:Concept ;
    skos:definition "Books in which the entire text and illustrations for each individual page is printed from a single carved wood block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block books"@en .

aat:300055021 a skos:Concept ;
    skos:definition "Books printed before 1501."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incunabula"@en .

aat:300055023 a skos:Concept ;
    skos:definition "Coverings of a book which hold the sheets together to provide protection, and collectively all the parts of books applied in the process of attaching the leaves and covering them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bindings"@en .

aat:300055024 a skos:Concept ;
    skos:definition "Bindings decorated with arms or other devices of royalty or nobility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armorial bindings"@en .

aat:300055026 a skos:Concept ;
    skos:definition "The portions of books' outer covers that enclose and protect the back of the text block, usually the part visible as the books stand on a shelf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spines"@en .

aat:300055027 a skos:Concept ;
    skos:definition "Portions of documents or other written works, either included as discrete sections in an extant document or detached from the original document."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partial documents"@en .

aat:300055029 a skos:Concept ;
    skos:definition "Opening phrases of a manuscript or early printed book, or a section of same, sometimes containing details of its production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incipits"@en .

aat:300055032 a skos:Concept ;
    skos:definition "Texts preceding the main literary work and containing comments about such matters as the reason for or circumstances of the author's writing the work, or comments by another about the author or the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prefaces"@en .

aat:300055033 a skos:Concept ;
    skos:definition "Pages on the right-hand side, recto of a leaf, at the beginning of a book where the bibliographic information about the work is provided, displaying the book's title and usually the author's name, the publisher, and sometimes the date of publication. Where more than one page giving particulars of the title are present, that giving the fullest information is the title page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "title pages"@en .

aat:300055047 a skos:Concept ;
    skos:definition "Manuscripts written on papyrus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papyri"@en .

aat:300055055 a skos:Concept ;
    skos:definition "Conventional symbols, usually written or printed, representing alone or in combination simple or complex speech sounds and constituting the units of an alphabet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters"@en .

aat:300055061 a skos:Concept ;
    skos:definition "In type, the largest letters in a given type size. In handwritten scripts, letters modeled on ancient Roman capital letters. For handwritten scripts without ascenders or descenders more generally, prefer \"majuscule.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capital letters"@en .

aat:300055064 a skos:Concept ;
    skos:definition "In type, those letters that in a given font are not the capitals nor the small capitals and that usually are smaller than the capitals and employ ascenders and descenders. For handwritten scripts having ascenders and descenders, use \"minuscule.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lowercase letters"@en .

aat:300055079 a skos:Concept ;
    skos:definition "Flat surfaces or boards, sometimes substantial structures, constructed for or used for posting announcements or advertisements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billboards"@en .

aat:300055099 a skos:Concept ;
    skos:definition "Small cardboard folders into which paper matches are stapled or glued."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matchbooks"@en .

aat:300055100 a skos:Concept ;
    skos:definition "Materials for the packing or protective wrapping of products that contain information or otherwise convey a message about the product. For material used to protect, cushion, or brace objects for safe shipment or storage, carrying no information or message about the objects, use \"packing material.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packaging"@en .

aat:300055118 a skos:Concept ;
    skos:definition "Copy prepared for photographing to make a printing plate, consisting of such elements as text, titles, and artwork that have been arranged, pasted, and marked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanicals"@en .

aat:300055128 a skos:Concept ;
    skos:definition "Scientific concepts related to biology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological concepts"@en .

aat:300055130 a skos:Concept ;
    skos:definition "An abnormal, pathological condition that affects part or all of an organism, affecting the functioning of one or more of an organism's systems, parts, or organs. It is often construed as a medical condition associated with specific symptoms and signs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disease"@en .

aat:300055131 a skos:Concept ;
    skos:definition "General term for any emotional or organic mental impairments, manifested in maladaptive behavior, psychological problems, or impairment in one or more significant areas of functioning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mental disorders"@en .

aat:300055132 a skos:Concept ;
    skos:definition "Persistent mental disorder or derangement. The terms ‘insane,’ ‘insanity’ are commonly used informally to denote mental instability or mental illness but can be considered offensive. The medical profession favors use of the terms ‘mental disorder’ or ‘psychopathology.’ The term can be used in a descriptive or historical context, in which case the use of quotation marks is suggested."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insanity"@en .

aat:300055133 a skos:Concept ;
    skos:definition "State of well-being of an organism or part of one, characterized by normal function and unattended by disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health"@en .

aat:300055134 a skos:Concept ;
    skos:definition "The condition which distinguishes active animals and plants from inorganic matter, including the capacity for growth, functional activity, continual change preceding death, and reproduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life"@en .

aat:300055135 a skos:Concept ;
    skos:definition "Refers to the gradual development of living organisms over successive generations, from lower to higher forms, especially as articulated in Darwinian theory or in alternatives to or modifications of Darwinian theory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evolution"@en .

aat:300055136 a skos:Concept ;
    skos:definition "The act or process of increasing in size or substance through natural development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "growth"@en .

aat:300055137 a skos:Concept ;
    skos:definition "The five faculties by which stimuli from outside or inside the body are received and felt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senses"@en .

aat:300055139 a skos:Concept ;
    skos:definition "The faculty or sense by which sound is perceived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearing"@en .

aat:300055140 a skos:Concept ;
    skos:definition "The faculty of perceiving odors via the olfactory organs' reception of chemical substances in the surrounding air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smell"@en .

aat:300055141 a skos:Concept ;
    skos:definition "The appreciative sensibility of observers who experience delight when disinterestedly observing or experiencing certain natural and manmade objects and events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taste"@en .

aat:300055142 a skos:Concept ;
    skos:definition "The faculty of perception through physical contact, especially with the fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "touch"@en .

aat:300055143 a skos:Concept ;
    skos:definition "The faculty of perception with the eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sight"@en .

aat:300055145 a skos:Concept ;
    skos:definition "Partial or complete loss of sight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blindness"@en .

aat:300055146 a skos:Concept ;
    skos:definition "Biological characteristics and physiological traits that distinguish the males and females of a species. For the pattern of attitudes and behavior that in any society is deemed appropriate to one sex rather than another, use \"sex role.\" For the sum of an individual's sexual emotions, ideas, and behavior, use \"sexuality.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sex"@en .

aat:300055147 a skos:Concept ;
    skos:definition "Pattern of attitudes and behavior that in any society is deemed appropriate to one sex rather than another. For the concept of physiological traits that distinguish the males and females of a species, use \"sex.\" For the sum of an individual's sexual emotions, ideas, and behavior, use \"sexuality.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sex role"@en .

aat:300055148 a skos:Concept ;
    skos:definition "Scientific concepts related to psychology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychological concepts"@en .

aat:300055149 a skos:Concept ;
    skos:definition "Mental processes by which knowledge is acquired. These include knowing, perceiving, reasoning and problem-solving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cognition"@en .

aat:300055150 a skos:Concept ;
    skos:definition "Refers to a complex phenomena and quality of consciousness, featuring the synthesis or combination of subjective experiences and perceptions, expressive physiological and psychological behaviors, and the excitation or stimulation of the nervous system. Among psychological studies, the concept is associated with ideas on personality formation, rational and irrational thinking, and cognitive motivation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emotion"@en .

aat:300055151 a skos:Concept ;
    skos:definition "Strong emotional reaction of displeasure or hostility demonstrated by physical reactions, particular facial grimaces and body positions characteristic of action in the autonomic nervous system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anger"@en .

aat:300055154 a skos:Concept ;
    skos:definition "Refers to the irrationally-based feeling of apprehension or dread, a product of internal emotional or psychological conflicts. The feeling can be situation-specific, chronic, or general and diffuse. Often associated with Freudian ideas of suppressed feelings and impulses and with the idea of learned or conditioned response mechanism in which the anxiety is triggered by events or stimuli associated with circumstances that previously produced a frightening or stressful experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anxiety"@en .

aat:300055155 a skos:Concept ;
    skos:definition "Emotion, combining dread, veneration, and wonder, aroused by authority or by the sacred or sublime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awe"@en .

aat:300055156 a skos:Concept ;
    skos:definition "The capacity for participating in, or a vicarious experiencing of, another's feelings, volitions, or ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "empathy"@en .

aat:300055158 a skos:Concept ;
    skos:definition "Emotional and psychological state generated from the resentment and awareness of an advantage enjoyed by another joined with the desire to possess the same advantage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "envy"@en .

aat:300055160 a skos:Concept ;
    skos:definition "The state of alarm and urgency; apprehension toward a potentially harmful experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fear"@en .

aat:300055162 a skos:Concept ;
    skos:definition "The state of deep and poignant distress caused by bereavement over an unfortunate outcome or event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grief"@en .

aat:300055163 a skos:Concept ;
    skos:definition "State of intense hostility and aversion usually derived from fear, anger, loathing, and sense of injury or offense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hate"@en .

aat:300055164 a skos:Concept ;
    skos:definition "Emotion expressing the mental state of happiness, bliss, and felicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joy"@en .

aat:300055165 a skos:Concept ;
    skos:definition "Emotional and psychological state based on strong affection, loyalty, and benevolence for another arising out of kinship, as in maternal love; arising out of sexual attraction and emotional affinity, as in affection and tenderness felt between lovers; and arising out of respect and admiration, as in the valuation and appreciation among friends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "love"@en .

aat:300055166 a skos:Concept ;
    skos:definition "A pensive psychological state characterized by despair and dejection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melancholy"@en .

aat:300055168 a skos:Concept ;
    skos:definition "The way people act in response to their environments and to others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human behavior"@en .

aat:300055169 a skos:Concept ;
    skos:definition "Conduct that departs from a society's established norms, rules, standards, or expectations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deviant behavior"@en .

aat:300055170 a skos:Concept ;
    skos:definition "A socially unacceptable pattern of sexual behavior in which one's preferred means of sexual arousal is the clandestine observing of others when they are disrobing, nude, or actually engaging in sexual activity. Arousal is dependent upon the observed person(s) being unaware of their being observed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voyeurism"@en .

aat:300055171 a skos:Concept ;
    skos:definition "Reactions and interactions of an individual or groups of individuals with relation to the immediate surrounding area including the animate or inanimate objects within that area. Perception of the environment induces certain actions, for instance, self-motions of the agent. In turn, this behavior leads to a changed perception, e.g. a novel view of the environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spatial behavior"@en .

aat:300055173 a skos:Concept ;
    skos:definition "The area immediately surrounding individuals which they reserve for themselves. Also, the space allocated for normal conversational voice and friendly interactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal space"@en .

aat:300055176 a skos:Concept ;
    skos:definition "The process of becoming aware of objects, qualities, or relations via the sense organs; involves the reception, processing, and interpretation of sensory impressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perception"@en .

aat:300055179 a skos:Concept ;
    skos:definition "Refers to the awareness or consciousness of an organism to the relative position and orientation of its body and to the objects around it; based on recognition of depth and distance and other external stimuli. The concept also describes the compensatory capacity to use limited perceptual clues to orient oneself or predict and construct an environment's spatial field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space perception"@en .

aat:300055181 a skos:Concept ;
    skos:definition "The consciousness of perceiving or seeming to perceive a condition of one's body or its parts or of the senses as messages from the body's sensory receptors register in the brain as information about the environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sensation"@en .

aat:300055182 a skos:Concept ;
    skos:definition "The bodily and emotional experience consisting of physiological and affective responses to an undesirable event. Often serves as a warning mechanism that protects an organism from the threat of injury or potential injury by stimulating a withdrawing response from harmful stimuli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pain"@en .

aat:300055183 a skos:Concept ;
    skos:definition "The state of emotional, mental, or physical gratification. Also refers to the source of joy or amusement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleasure"@en .

aat:300055184 a skos:Concept ;
    skos:definition "The state or experience based on the endurance of pain, distress, loss, or damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suffering"@en .

aat:300055186 a skos:Concept ;
    skos:definition "Purely animal or physical part of human nature; the senses and appetites of the physical body. Also, gratification of the senses, self-indulgence, or the quality of being lascivious."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sensuality"@en .

aat:300055187 a skos:Concept ;
    skos:definition "Generally used for the sum of an individual's sexual emotions, ideas, and behavior. For the pattern of attitudes and behavior that in any society is deemed appropriate to one sex rather than another, use \"sex role.\" For the concept of the physiological traits that distinguish the males and females of a species, use \"sex.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sexuality"@en .

aat:300055188 a skos:Concept ;
    skos:definition "Sexuality characterized by romantic love or sexual desire toward members of one's own sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homosexuality"@en .

aat:300055189 a skos:Concept ;
    skos:definition "The greater part of the psychic apparatus accumulated through life experience that is not ordinarily integrated or available to consciousness, considered by many psychologists to be a powerful motive force in overt behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unconscious"@en .

aat:300055191 a skos:Concept ;
    skos:definition "The act or process of coming to direct knowledge or certainty without reasoning or inferring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intuition"@en .

aat:300055192 a skos:Concept ;
    skos:definition "Refers to the fact or condition of knowing something with familiarity gained through experience or association, as in the acquaintance with or understanding of a science, art, or technique. Also refers to the body of knowledge, or range of information acquired by study, investigation, observation, or experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knowledge"@en .

aat:300055193 a skos:Concept ;
    skos:definition "The means of communicating beyond simple gesture or facial expression, but including the words and their pronunciation or symbolic representation as understood by a considerable community and established by long usage. It includes both verbal and non-verbal communication. Language is typically held by experts to exist only among humans and their ancestors, but not known in other species; however, disagreement on this point exists. Language also refers to the vocabulary or phraseology of a particular sphere, discipline, profession, or social group. For specific, established systems of communication, such as Spanish or English, use \"languages (established systems of communication).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "language"@en .

aat:300055194 a skos:Concept ;
    skos:definition "The faculty or process of forming logical inferences or comprehensive principles; often used in contrast to pure sensation or emotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reason"@en .

aat:300055195 a skos:Concept ;
    skos:definition "The act of expressing or describing thoughts, feelings, or perceptions by the articulation of words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speech"@en .

aat:300055199 a skos:Concept ;
    skos:definition "Removal of ground or surface water by artificial or natural means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drainage"@en .

aat:300055202 a skos:Concept ;
    skos:definition "In agriculture, the removal of surplus water from land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land drainage"@en .

aat:300055207 a skos:Concept ;
    skos:definition "The running of rainfall or melted snow over land and into streams; also, the running of excess fertilizer or pesticides from farmland and into rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runoff"@en .

aat:300055212 a skos:Concept ;
    skos:definition "The utilization of energy resources, resulting in their destruction, reduction of supply, or transformation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "energy consumption"@en .

aat:300055213 a skos:Concept ;
    skos:definition "The utilization of fossil fuels or nuclear fuel to produce energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuel consumption"@en .

aat:300055214 a skos:Concept ;
    skos:definition "The utilization of fuels so as to conserve supplies and promote efficiency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuel economy"@en .

aat:300055215 a skos:Concept ;
    skos:definition "The ratio of the amount of work performed by a heat engine in one cycle to the amount of energy input required to operate the engine over one cycle. This ratio may be applied to the ability of an object, machine, or structure to maintain temperature parameters measured against the energy expended to control that temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal efficiency"@en .

aat:300055216 a skos:Concept ;
    skos:definition "The net increase in heat within a space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat gain"@en .

aat:300055217 a skos:Concept ;
    skos:definition "The net decrease in heat within a space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat loss"@en .

aat:300055218 a skos:Concept ;
    skos:definition "Available supplies or means of producing energy, whether natural, such as fossil fuels or hydro-electric power, or manmade, such as nuclear fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "energy resources"@en .

aat:300055221 a skos:Concept ;
    skos:definition "Energy supplied by the heat of the earth's interior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geothermal power"@en .

aat:300055222 a skos:Concept ;
    skos:definition "Power provided by a nuclear reaction, such as the fission of an atom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear power"@en .

aat:300055225 a skos:Concept ;
    skos:definition "The use of the sun's energy to provide heating or to generate electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar power"@en .

aat:300055227 a skos:Concept ;
    skos:definition "Power produced by converting the potential power of natural stream flow into energy, usually electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydroelectric power"@en .

aat:300055230 a skos:Concept ;
    skos:definition "The use of wind energy to generate electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind power"@en .

aat:300055231 a skos:Concept ;
    skos:definition "The supply of electric power to the human built environment or to tools and equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power supply"@en .

aat:300055232 a skos:Concept ;
    skos:definition "Physical phenomenon involving electric charges and their effects when at rest and in motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electricity"@en .

aat:300055233 a skos:Concept ;
    skos:definition "The large-scale production of electricity for industrial, residential, or rural use, generally in stationary plants designed for that purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric power production"@en .

aat:300055235 a skos:Concept ;
    skos:definition "On-going essential services provided by government relating to the protection and maintenance of the lives and property of community members as a whole. For the actual enterprises, use a more specific term such as \"public utilities,\" \"public works,\" or \"social services.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public services"@en .

aat:300055237 a skos:Concept ;
    skos:definition "Systematic administration of activities that provide for collection, processing, and disposal of solid wastes, including the recovery of materials and energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid waste management"@en .

aat:300055239 a skos:Concept ;
    skos:definition "Discarding or throwing away unneeded or excess material including equipment, products, or materials in any form including oils, chemicals, gases, or liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waste disposal"@en .

aat:300055241 a skos:Concept ;
    skos:definition "Disposal of the solid wastes of a community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refuse disposal"@en .

aat:300055243 a skos:Concept ;
    skos:definition "Disposal of the wastewater of a community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewage disposal"@en .

aat:300055244 a skos:Concept ;
    skos:definition "The study, planning, and actions of conveying people or things from one place to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation"@en .

aat:300055246 a skos:Concept ;
    skos:definition "The carrying from one place to another by way of a craft that utilizes air as the travel meduim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air transport"@en .

aat:300055248 a skos:Concept ;
    skos:definition "An area reserved for leaving vehicles temporarily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parking"@en .

aat:300055250 a skos:Concept ;
    skos:definition "The passage of people or vehicles along routes of transportation. Also, vehicles or pedestrians in transit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic"@en .

aat:300055252 a skos:Concept ;
    skos:definition "Generally, transportation in urban areas, whether by transit systems or private means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban transportation"@en .

aat:300055262 a skos:Concept ;
    skos:definition "Artificial systems that water land to supply moisture for plant growth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irrigation systems"@en .

aat:300055267 a skos:Concept ;
    skos:definition "Measures taken to forestall criminal or delinquent acts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crime prevention"@en .

aat:300055270 a skos:Concept ;
    skos:definition "The concept of a residential environment in which inhabitants can enhance the quality of their lives, while providing security for their families, neighbors, and friends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defensible space"@en .

aat:300055277 a skos:Concept ;
    skos:definition "Activities and precautions designed to avoid an outbreak of fire, reduce the potential for fire to spread, and to safeguard persons, property, wildlife, and flora in the event of fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire prevention"@en .

aat:300055278 a skos:Concept ;
    skos:definition "Protective measures against floods, including relief channel and reservoir construction, afforestation, and bans on building in flood-prone areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flood control"@en .

aat:300055282 a skos:Concept ;
    skos:definition "The condition of being safe, free from danger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety"@en .

aat:300055286 a skos:Concept ;
    skos:definition "Important subjects of debate or litigation having to do with an organized and interdependent community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social issues"@en .

aat:300055288 a skos:Concept ;
    skos:definition "Economic, religious, or racial discrimination against Jews."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antisemitism"@en .

aat:300055289 a skos:Concept ;
    skos:definition "Illegal activities collectively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crime"@en .

aat:300055290 a skos:Concept ;
    skos:definition "The act or result of intentionally inflicting damage on the surface or outer appearance of buildings or objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defacement"@en .

aat:300055291 a skos:Concept ;
    skos:definition "Alteration of something, often the destruction of an essential part, to a degree that it is considered imperfect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutilation"@en .

aat:300055292 a skos:Concept ;
    skos:definition "The wrongful taking of property with the intention of permanently depriving the rightful owner of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theft"@en .

aat:300055298 a skos:Concept ;
    skos:definition "Passing off the ideas or words of another as one's own, or deliberately using the work of another without crediting the source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plagiarism"@en .

aat:300055299 a skos:Concept ;
    skos:definition "Willful destruction of or damage to property belonging to another or to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vandalism"@en .

aat:300055301 a skos:Concept ;
    skos:definition "Biased or differential attitudes toward or treatment of people on the basis of the group, class, or category to which they belong."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discrimination"@en .

aat:300055302 a skos:Concept ;
    skos:definition "Discriminatory attitudes or practices toward people on the basis of their age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "age discrimination"@en .

aat:300055303 a skos:Concept ;
    skos:definition "Restriction or denial of residential occupation, tenancy, or ownership because of prejudice based on such factors as age, sex, sexual preference, race or ethnic group, or social or economic status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housing discrimination"@en .

aat:300055304 a skos:Concept ;
    skos:definition "Discriminatory attitudes and denial of rights, privileges, or choice because of race."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racial discrimination"@en .

aat:300055305 a skos:Concept ;
    skos:definition "Discriminatory attitudes and practice directed against either sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sex discrimination"@en .

aat:300055306 a skos:Concept ;
    skos:definition "The condition of having no home or permanent place of residence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homelessness"@en .

aat:300055307 a skos:Concept ;
    skos:definition "The condition of having little or no wealth or material possessions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poverty"@en .

aat:300055308 a skos:Concept ;
    skos:definition "The degree of well-being felt by an individual about his or her lifestyle, often defined in terms of social indicators, such as nutrition, air quality, crime rates, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quality of life"@en .

aat:300055309 a skos:Concept ;
    skos:definition "Refers to the condition in which one human being is considered owned by another. An enslaved person is deprived of most of the rights ordinarily held by non-enslaved persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slavery"@en .

aat:300055311 a skos:Concept ;
    skos:definition "The theory describing various aspects of social disintegration involving individuals, groups or social classes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social conflict"@en .

aat:300055312 a skos:Concept ;
    skos:definition "Occasions of sweeping change in established patterns of government or social organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolutions"@en .

aat:300055313 a skos:Concept ;
    skos:definition "Systematic use of terror, violence, and intimidation against people, usually civilians, or property to create a general climate of fear in a population. The purpose of terrorism is typically to bring about a particular political or social objective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrorism"@en .

aat:300055314 a skos:Concept ;
    skos:definition "Events taking place over a prolonged period and comprising open and declared hostile armed conflict between nations or parties within a nation. For individual instances of armed conflict, use \"battles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wars"@en .

aat:300055315 a skos:Concept ;
    skos:definition "Wars between different areas, factions, or parties of the same nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil wars"@en .

aat:300055316 a skos:Concept ;
    skos:definition "Wars characterized by hit-and-run tactics by small, mobile groups of irregular forces operating in territory controlled by a hostile regular force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guerrilla warfare"@en .

aat:300055317 a skos:Concept ;
    skos:definition "Wars characterized by the substantial use of nuclear weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear wars"@en .

aat:300055322 a skos:Concept ;
    skos:definition "The long-term total of atmospheric variations at a specific geographical location. Regarding shorter-term atmospheric conditions, use \"weather.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climate"@en .

aat:300055325 a skos:Concept ;
    skos:definition "The aggregate of physical things, conditions, and influences surrounding and affecting an organism, object, or structure. For the branch of biology dealing with the relations and interactions between organisms and their habitat, use \"ecology.\" For the earth's major animal and plant communities, use \"biomes.\" For the concept of the perceived external world, including the forces at work in it and the nonhuman life inhabiting it, use \"Nature.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environments"@en .

aat:300055336 a skos:Concept ;
    skos:definition "Unwanted or incidental sounds audible in a particular space or area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noise"@en .

aat:300055337 a skos:Concept ;
    skos:definition "Noise produced by land, air and water vehicles and navigational devices such as foghorns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation noise"@en .

aat:300055339 a skos:Concept ;
    skos:definition "Noise produced by vehicles passing along streets and highways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic noise"@en .

aat:300055342 a skos:Concept ;
    skos:definition "Noise produced by the activities of urban life, generally audible within the city or near to it, including within buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city noise"@en .

aat:300055344 a skos:Concept ;
    skos:definition "The introduction of or condition of having harmful or otherwise undesirable substances or products in the environment; for the substances themselves use \"pollutants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pollution"@en .

aat:300055348 a skos:Concept ;
    skos:definition "Pollution of the earth's atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air pollution"@en .

aat:300055353 a skos:Concept ;
    skos:definition "Smoke-filled fog that contaminates the air, most often originating over industrial sites and cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smog"@en .

aat:300055354 a skos:Concept ;
    skos:definition "Contamination of the unconsolidated material on the earth's surface formed by the weathering of rock and that portion of the earth's surface that can support plant life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil pollution"@en .

aat:300055355 a skos:Concept ;
    skos:definition "Contamination of water resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water pollution"@en .

aat:300055356 a skos:Concept ;
    skos:definition "Contamination or fouling of ocean or sea waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine pollution"@en .

aat:300055359 a skos:Concept ;
    skos:definition "Noise in the environment which is harmful, or irritating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noise pollution"@en .

aat:300055361 a skos:Concept ;
    skos:definition "Ecologically harmful discharge of heat or hot water, especially into natural waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal pollution"@en .

aat:300055364 a skos:Concept ;
    skos:definition "The control and removal of pollution, specifically harmful odors and gases, from the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air purification"@en .

aat:300055365 a skos:Concept ;
    skos:definition "Control and reduction of smoke, particularly smoke from industry, in an environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoke abatement"@en .

aat:300055366 a skos:Concept ;
    skos:definition "State of the atmosphere with respect to such factors as wind, temperature, cloudiness, moisture, and pressure. For the long-term total of atmospheric variations at a specific geographical location, use \"climate.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weather"@en .

aat:300055367 a skos:Concept ;
    skos:definition "The temperature at which air becomes saturated when cooled, without the addition of moisture or any change in pressure; further cooling causes condensation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dew point"@en .

aat:300055368 a skos:Concept ;
    skos:definition "A period of abnormally dry weather sufficiently prolonged that a serious hydraulic imbalance occurs, such as crop damage or reduced water supply."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drought"@en .

aat:300055370 a skos:Concept ;
    skos:definition "The amount of water held as a vapor in the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humidity"@en .

aat:300055371 a skos:Concept ;
    skos:definition "Condensed or diffused water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moisture"@en .

aat:300055373 a skos:Concept ;
    skos:definition "Any form of water that falls on the earth's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precipitation"@en .

aat:300055374 a skos:Concept ;
    skos:definition "Water droplets or ice crystals suspended in the air in sufficient concentration to appreciably reduce visibilty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fog"@en .

aat:300055375 a skos:Concept ;
    skos:definition "A deposit of minute ice crystals formed when water vapor condenses at a temperature below freezing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frost"@en .

aat:300055376 a skos:Concept ;
    skos:definition "Precipitation in the form of spherical or irregular pellets of ice larger than five millimeters in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hail"@en .

aat:300055377 a skos:Concept ;
    skos:definition "Water condensed from atmospheric vapor and falling in drops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rain"@en .

aat:300055380 a skos:Concept ;
    skos:definition "Form of precipitation (rain, snow, sleet, or hail) containing high levels of sulfuric or nitric acids. It is produced by the combination of atmospheric water with oxides released when hydrocarbon fuels are burned. Acid rain damages architecture and outdoor sculpture; it kills or harms forests, crops, and aquatic life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid rain"@en .

aat:300055381 a skos:Concept ;
    skos:definition "Frozen precipitation in the form of white or translucent hexagonal ice crystals that fall in soft, white flakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow"@en .

aat:300055395 a skos:Concept ;
    skos:definition "Moving air, especially a natural and perceptible movement of air parallel to or along the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind"@en .

aat:300055398 a skos:Concept ;
    skos:definition "Statistical data of a population, especially relating to density, growth, distribution, and vital statistics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demographics"@en .

aat:300055399 a skos:Concept ;
    skos:definition "Type of use of a lot or parcel of real property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land use"@en .

aat:300055401 a skos:Concept ;
    skos:definition "The settling of permanent residents on a certain area of land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land settlement"@en .

aat:300055402 a skos:Concept ;
    skos:definition "Extension of political and economic control over an area by a foreign occupying state that usually has organizational and military superiority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonization"@en .

aat:300055403 a skos:Concept ;
    skos:definition "The use of a lot or parcel of real property for farming or agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural land use"@en .

aat:300055405 a skos:Concept ;
    skos:definition "The function of moving from one country, region, or place to settle in another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "migration"@en .

aat:300055406 a skos:Concept ;
    skos:definition "Departure from a place of abode, natural home, or country for life or residence elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emigration"@en .

aat:300055407 a skos:Concept ;
    skos:definition "Arrival into a country, area, or abode for the purpose of permanent residence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immigration"@en .

aat:300055408 a skos:Concept ;
    skos:definition "Migration within a country or region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internal migration"@en .

aat:300055411 a skos:Concept ;
    skos:definition "The frequency with which an individual or individuals change residence, either in the same city or town, or between cities, states or communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "residential mobility"@en .

aat:300055412 a skos:Concept ;
    skos:definition "Migration within a country or region from rural areas to towns or cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural-urban migration"@en .

aat:300055414 a skos:Concept ;
    skos:definition "Geographic mobility of students from one region or school district to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student mobility"@en .

aat:300055415 a skos:Concept ;
    skos:definition "Migration within a country or region from towns or cities to rural areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban-rural migration"@en .

aat:300055416 a skos:Concept ;
    skos:definition "Filling beyond what is usual or comfortable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overcrowding"@en .

aat:300055417 a skos:Concept ;
    skos:definition "The total number of individuals of a given species or other class of organism in a defined area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "population"@en .

aat:300055418 a skos:Concept ;
    skos:definition "The fluctuations that occur in the numbers of individuals in plant and animal populations in time and space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "population change"@en .

aat:300055419 a skos:Concept ;
    skos:definition "A decrease in the total number of individuals of a given species or other class of organism in a defined area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "population decline"@en .

aat:300055420 a skos:Concept ;
    skos:definition "An increase in the total number of individuals of a given species or other class of organism in a defined area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "population growth"@en .

aat:300055421 a skos:Concept ;
    skos:definition "The ratio of a number of individuals to a given unit of the area in which they live."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "population density"@en .

aat:300055422 a skos:Concept ;
    skos:definition "Setting people in a new place or a new way of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resettlement"@en .

aat:300055423 a skos:Concept ;
    skos:definition "Change over time in human activities, institutions, or settlements, usually in the sense of improvement or expansion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "development"@en .

aat:300055424 a skos:Concept ;
    skos:definition "Beautifying or improving the working condition of small-scale public amenities in a municipality, such as sidewalks, road signs, and green areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civic improvement"@en .

aat:300055426 a skos:Concept ;
    skos:definition "Activity of planting and landscaping carried out along highways to improve their appearance, and to stabilize the soil, and create wind or sound breaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roadside improvement"@en .

aat:300055429 a skos:Concept ;
    skos:definition "Improving the appearance of an urban site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban beautification"@en .

aat:300055432 a skos:Concept ;
    skos:definition "Development of low-income economies into industrial economies. Rather than strictly referring to economic growth, economic development refers to improvements in national economies that are both quantitative and qualitative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economic development"@en .

aat:300055433 a skos:Concept ;
    skos:definition "Activity of solving or ameliorating a community's social and economic problems, organized and controlled mainly by the community itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community development"@en .

aat:300055435 a skos:Concept ;
    skos:definition "Basic development of rural regions emphasizing improvements in the standard of living and the active participation of the local population."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural development"@en .

aat:300055438 a skos:Concept ;
    skos:definition "Improvement and development of urban areas including infrastructure, especially by building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban development"@en .

aat:300055440 a skos:Concept ;
    skos:definition "The renovation and settlement of decaying urban areas by middle- and high-income people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentrification"@en .

aat:300055441 a skos:Concept ;
    skos:definition "Removing a slum by demolishing it, or altering it by correcting the conditions that caused it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slum clearance"@en .

aat:300055442 a skos:Concept ;
    skos:definition "Activity of clearing, rebuilding, restoring, or refurbishing urban areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban renewal"@en .

aat:300055447 a skos:Concept ;
    skos:definition "Development rights to the space above a piece of real estate; the owner of the land may sell or lease these rights to another party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air rights"@en .

aat:300055448 a skos:Concept ;
    skos:definition "The transfer, usually by sale, of the right to construct a certain amount of building space, from one piece of property to another, adjacent or in the same area; often as a means of subsidizing the preservation of landmark buildings in built-up areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "development rights transfer"@en .

aat:300055451 a skos:Concept ;
    skos:definition "Activity of dividing an area of land into smaller parcels for lots, blocks, streets, open spaces, and public areas, and the designation of the location of utilities and other services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land subdivision"@en .

aat:300055457 a skos:Concept ;
    skos:definition "Modifications to an object or structure. Refers especially to the physical evidence of the change. In architecture, use \"additions\" if the change increases the structure's volume; \"alterations\" if it does not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alterations"@en .

aat:300055458 a skos:Concept ;
    skos:definition "Refers to parts added onto an object or structure. In architecture, if a modification does not substantially increase a structure's volume, use \"alterations.\" With regard to printed matter, use \"addenda.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "additions"@en .

aat:300055460 a skos:Concept ;
    skos:definition "Causing to become densely populated and built up like towns and cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urbanization"@en .

aat:300055461 a skos:Concept ;
    skos:definition "The increase in population of the suburbs of large cities, spurred on in part by the spread of highways and rail systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suburban growth"@en .

aat:300055462 a skos:Concept ;
    skos:definition "The spreading of urban developments (such as houses and shopping centers) on undeveloped land near a city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban sprawl"@en .

aat:300055466 a skos:Concept ;
    skos:definition "Area of manufacture that is concerned with the factors that determine where producers choose to locate and the effects of the location of a piece of land on the use made of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial location"@en .

aat:300055472 a skos:Concept ;
    skos:definition "Changes in the social status of individuals or groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social mobility"@en .

aat:300055473 a skos:Concept ;
    skos:definition "The enduring, orderly and patterned relationships between elements of a society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social structure"@en .

aat:300055474 a skos:Concept ;
    skos:definition "Groups of individuals related by blood, marriage, adoption, or cohabitation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "families"@en .

aat:300055475 a skos:Concept ;
    skos:definition "Legal and social unions of a man and woman as husband and wife, or of the union of a gay couple. For the act or ceremony of instituting a marriage, use \"weddings (ceremonies).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage"@en .

aat:300055476 a skos:Concept ;
    skos:definition "The state of being related by common ancestry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinship"@en .

aat:300055479 a skos:Concept ;
    skos:definition "The condition in which different levels of caste, class, privilege, or status make up a society. A person's strata may be ascribed at birth or achieved. Factors involved in social stratification include gender, race, age, wealth, family relationships, education, occupation, marital status, and language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social stratification"@en .

aat:300055480 a skos:Concept ;
    skos:definition "Closed social classes rigidly sanctioned by custom, law, or religion and based on heredity, that determine their members' prestige, occupation, and social relationships, especially marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castes"@en .

aat:300055481 a skos:Concept ;
    skos:definition "Social class ranking between upper and lower classes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle class"@en .

aat:300055482 a skos:Concept ;
    skos:definition "One of the social classes whose income derives from the profits of commercial and industrial enterprise, especially as distinguished from the landed gentry, wage earners, farmers, and the professions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bourgeoisie"@en .

aat:300055483 a skos:Concept ;
    skos:definition "That social and economic class that ranks above the middle class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper class"@en .

aat:300055484 a skos:Concept ;
    skos:definition "The class of people in a society who hold exceptional rank, power, and privileges. The government in which this class is the ruling class is called an \"aristocracy (form of government).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aristocracy"@en .

aat:300055485 a skos:Concept ;
    skos:definition "Class of persons employed for wages, usually at manual labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "working class"@en .

aat:300055486 a skos:Concept ;
    skos:definition "The portion of the working class at the lowest end of the social and economic scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proletariat"@en .

aat:300055490 a skos:Concept ;
    skos:definition "Social science concepts related to politics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political concepts"@en .

aat:300055491 a skos:Concept ;
    skos:definition "A term referring to the legal separation of any religious and political orders in a nation or state. Usually applied in the context of the United States government as stated in the first amendment of the United States Constitution: \"Congress shall make no law respecting an establishment of religion, or prohibiting the free exercise thereof.\"France has a similar statute regarding the separation of church and state, enacted 9 December 1905."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church and state"@en .

aat:300055492 a skos:Concept ;
    skos:definition "A state or commonwealth's members' taking part in the political processes that lead to the selection of political leaders and determine or influence public policy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citizen participation"@en .

aat:300055495 a skos:Concept ;
    skos:definition "Distributing the functions and powers of an organization, governing body, or other authority over a less centralized area or among a large number of parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decentralization"@en .

aat:300055496 a skos:Concept ;
    skos:definition "Withdrawing voluntarily from one's native country, especially if renouncing allegiance to it or to its government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expatriation"@en .

aat:300055497 a skos:Concept ;
    skos:definition "An ideal, state, or right involving being one's being free from oppressive restrictions on a way of life, behavior, or political views. Often associated with rights guaranteed by a constitution or fundamental law having as goals the exemption or liberation from slavery, imprisonment, or restraint by a despotic power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freedom"@en .

aat:300055499 a skos:Concept ;
    skos:definition "The political concept according to which a nation or community is governed, defined by the nature of the community governed, such as civil government or ecclesiastical government, or the kind of organization adopted, such as monarchical government or republican government. To refer to the bodies themselves which exercise the authority to govern, use “governments (administrative).”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government"@en .

aat:300055500 a skos:Concept ;
    skos:definition "Administration by a local political unit, such as a city, town or village."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal government"@en .

aat:300055502 a skos:Concept ;
    skos:definition "Administration by the principal division of a country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provincial government"@en .

aat:300055504 a skos:Concept ;
    skos:definition "Administration by an internally autonomous territorial or political unit constituting a federation under one government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state government"@en .

aat:300055506 a skos:Concept ;
    skos:definition "Central administration by a system of government in which several states form a unity but remain independent in internal affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federal government"@en .

aat:300055507 a skos:Concept ;
    skos:definition "A course or principle of action adopted or proposed by a government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government policy"@en .

aat:300055508 a skos:Concept ;
    skos:definition "A course or principle of action adopted or proposed by a government to protect wildlife and endangered species and habitats, and decrease the threat to planetary systems posed by pollution, deforestation, desertification, and other effects of human activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental policy"@en .

aat:300055512 a skos:Concept ;
    skos:definition "Activity of effecting a more equitable distribution of agricultural land especially by dividing large estates into small holdings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land reform"@en .

aat:300055515 a skos:Concept ;
    skos:definition "A government or political system in which absolute power or control is exercised by a single ruler or a tightly knit group of people, often with the connotation of arbitrariness and self-interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "despotism"@en .

aat:300055516 a skos:Concept ;
    skos:definition "A form of government in which the political authority exercises absolute and centralized control over all aspects of life, the individual is subordinated to the state, and opposing political and cultural expression is suppressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "totalitarianism"@en .

aat:300055517 a skos:Concept ;
    skos:definition "A political theory aimed at maximizing personal freedom and abolition of the state and all governmental authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anarchism"@en .

aat:300055518 a skos:Concept ;
    skos:definition "Economic system characterized by private or corporate ownership of capital goods, by investments that are determined by private decision rather than state control, and by prices, production, and the distribution of goods that are determined mainly by competition in a free market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capitalism"@en .

aat:300055519 a skos:Concept ;
    skos:definition "Economic and political system in which land and capital goods are publicly owned, and the governing authorities control the means of production, prices, and distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communism"@en .

aat:300055520 a skos:Concept ;
    skos:definition "A political outlook that values and seeks to conserve established institutions, respects traditions as embodying the accumulated wisdom of the ages, and generally opposes liberalism and socialism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservatism"@en .

aat:300055521 a skos:Concept ;
    skos:definition "Political entities have a government in which people either rule themselves or elect representatives to rule in their interests. Elections, to be democratic, must be held regularly, be secret, and provide a choice of candidates; the elected assembly must also be free to legislate and criticize government policy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "democracies"@en .

aat:300055522 a skos:Concept ;
    skos:definition "Autocratic governments ruled by a dictator, without effective constitutional limitations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictatorships"@en .

aat:300055523 a skos:Concept ;
    skos:definition "Political ideology and mass movement that dominated many parts of central, southern, and eastern Europe between 1919 and 1945, and that also had adherents in western Europe, the United States, South Africa, Japan, Latin America, and the Middle East. It is characterized by strongly nationalistic policies exercising regimentation of industry, commerce, and finance, rigid censorship, and oppression of opposition. Developed in the Italian nationalist movement that was organized in 1919 to oppose communism in Italy and that controlled the government under Benito Mussolini from 1922 to 1943."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fascism"@en .

aat:300055524 a skos:Concept ;
    skos:definition "Totalitarian movement led by Adolf Hitler as head of the Nazi Party in Germany; characterized by intense nationalism, mass appeal, and dictatorial rule that shared many elements with Italian fascism. However, Nazism was far more extreme both in its ideas and in its practice; it was an anti-intellectual and atheoretical movement, emphasizing the will of the charismatic dictator and including racist nationalism, national expansion, and state control of the economy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "National Socialism"@en .

aat:300055526 a skos:Concept ;
    skos:definition "Any social system in which great landlords or overlords exact revenue from the land and also exercise the functions of government in their domain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feudalism"@en .

aat:300055527 a skos:Concept ;
    skos:definition "A political philosophy based on belief in progress, the essential goodness of man and the autonomy of the individual and standing for tolerance and freedom for the individual from arbitrary authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liberalism"@en .

aat:300055528 a skos:Concept ;
    skos:definition "The political, economic, and social principles advocated by Karl Marx, Friedrich Engels, and their followers; it includes the labor theory of value, dialectical materialism, economic determination of human actions, and class struggle as a fundamental force in history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marxism"@en .

aat:300055529 a skos:Concept ;
    skos:definition "Political entities having a government with a single, usually hereditary, chief of state with life tenure who may exercise governmental powers varying from nominal to absolute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monarchies"@en .

aat:300055530 a skos:Concept ;
    skos:definition "Sense of national consciousness exalting one nation above all others and placing primary emphasis on promotion of its culture and interests as opposed to those of other nations or supranational groups. For love of one's country and devotion to its interests in general, use \"patriotism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nationalism"@en .

aat:300055531 a skos:Concept ;
    skos:definition "Use generally to mean love of one's country and devotion to its interests. For the sense of national consciousness exalting one nation above all others and placing primary emphasis on promotion of its culture and interests as opposed to those of other nations or supranational groups, use \"nationalism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patriotism"@en .

aat:300055532 a skos:Concept ;
    skos:definition "Political and economic doctrines advocated by the populists, including representation of agrarian interests, free coinage of silver, and government control of monopolies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "populism"@en .

aat:300055533 a skos:Concept ;
    skos:definition "Political and economic ideology advocating collective or governmental ownership and administration of the means of production and distribution of goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socialism"@en .

aat:300055535 a skos:Concept ;
    skos:definition "Places of ideal perfection, especially with regard to laws, government, and social conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utopias"@en .

aat:300055537 a skos:Concept ;
    skos:definition "The art or science of government or governing, especially the governing of a political entity, such as a nation, and the administration and control of its internal and external affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "politics"@en .

aat:300055539 a skos:Concept ;
    skos:definition "Ideas, facts, or allegations spread deliberately to support one cause or individual or to damage another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propaganda"@en .

aat:300055540 a skos:Concept ;
    skos:definition "Derived from agitation propaganda, meaning intended to inspire political action. With reference to visual art, refers to the specific art movement arising in Soviet Russia following the Bolshevik revolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agitprop"@en .

aat:300055542 a skos:Concept ;
    skos:definition "Imposition by a public authority of compulsory contributions to raise revenue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxing"@en .

aat:300055545 a skos:Concept ;
    skos:definition "The process or function of evaluating a thing or person against a scale, standard, or other criteria for quality, condition, value, extent, fitness, or other characteristics. Examples are the assessment of the habitable condition of a building or the academic value of a written work. For the estimation of the overall monetary value of a thing, generally prefer “appraising” or “valuation.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assessing"@en .

aat:300055547 a skos:Concept ;
    skos:definition "Social science concepts related to law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal concepts"@en .

aat:300055550 a skos:Concept ;
    skos:definition "An appropriation or giving up of property to public use that precludes the owner from asserting any right of ownership inconsistent with the use for which the property is dedicated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dedication to public use"@en .

aat:300055552 a skos:Concept ;
    skos:definition "Usually nonprofitable interest granted by deed or will that is held by one person in land owned by another and that entitles the holder to a specific limited use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "easement"@en .

aat:300055560 a skos:Concept ;
    skos:definition "The right of the state to seize private property for public purposes, normally without compensation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eminent domain"@en .

aat:300055561 a skos:Concept ;
    skos:definition "Any right or interest in land which diminishes the value of the fee but does not prevent the conveyance of the fee by the owner. Encumbrances such as taxes, mortgages, and judgements are known as liens; restrictions, reservations and easements are encumbrances but are not liens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encumbrances"@en .

aat:300055562 a skos:Concept ;
    skos:definition "Promises or undertakings of legal validity embodied in a contract under seal; also particular agreements contained in a deed or contract under seal which are incidental to the main purpose of the document."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covenants"@en .

aat:300055563 a skos:Concept ;
    skos:definition "Agreements generally running with specific pieces of land, restricting the free use of that land with reference to particular purposes or occupancy by members of a particular group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restrictive covenants"@en .

aat:300055565 a skos:Concept ;
    skos:definition "Charges upon real or personal property for the satisfaction of some debt or duty ordinarily arising by operation of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liens"@en .

aat:300055567 a skos:Concept ;
    skos:definition "Agreements by which one person undertakes to secure another in the possession or enjoyment of something, such as an expressed or implied assurance of the quality or performance of goods purchased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guarantees"@en .

aat:300055570 a skos:Concept ;
    skos:definition "Declarations of laws, regulations, fund allocations, international treaties, etc., having the force of authority by virtue of their passing or enactment by an official organ of a state or other governing body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legislation"@en .

aat:300055572 a skos:Concept ;
    skos:definition "Limitations placed, usually by the government, on the vertical distance from the base to the top of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "height restrictions"@en .

aat:300055576 a skos:Concept ;
    skos:definition "Body of laws undertaking to provide relief for the poor. Prime examples are laws developed out of late-medieval and Tudor-era laws being codified in 1587-1598 in England and Wales, and in existence until the emergence of the modern welfare state after WWII."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poor laws"@en .

aat:300055581 a skos:Concept ;
    skos:definition "An obligation to transfer economic benefits as a result of past transactions. Also, what a person or organization is responsible for, especially debts or pecuniary obligations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liability"@en .

aat:300055583 a skos:Concept ;
    skos:definition "Failure to exercise the degree of care expected of the normally reasonable person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negligence"@en .

aat:300055584 a skos:Concept ;
    skos:definition "Improper or negligent professional treatment, especially by medical professionals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malpractice"@en .

aat:300055586 a skos:Concept ;
    skos:definition "An association of two or more people formed for the purpose of carrying on a business that does not have a legal personality of its own, and therefore partners must agree on the method of distribution of profits and losses and are liable for the debts of the firm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partnership"@en .

aat:300055588 a skos:Concept ;
    skos:definition "Anything that can be owned, tangible or intangible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "property"@en .

aat:300055590 a skos:Concept ;
    skos:definition "Real or notional lines marking the limits of an area, territory, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boundaries"@en .

aat:300055591 a skos:Concept ;
    skos:definition "Lines on a land plot beyond which the law forbids the erection of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building lines"@en .

aat:300055592 a skos:Concept ;
    skos:definition "The boundary lines between pieces of property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "property lines"@en .

aat:300055593 a skos:Concept ;
    skos:definition "Movable works or built works, or parts of works, having archaeological or ethnological value to a particular culture, often subject to export restrictions of the particular country where they were created or discovered. Includes property having significant importance to the cultural heritage of a people, such as monuments of architecture, art or history, whether religious or secular; archaeological sites; groups of buildings which, as a whole, are of historical or artistic interest, works of art, artifacts, manuscripts, books and other objects of artistic, historical or archaeological interest; as well as scientific collections and important collections of books or archives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural property"@en .

aat:300055596 a skos:Concept ;
    skos:definition "Aggregate of property or liabilities of all kinds that a person leaves for his or her disposal at death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estates"@en .

aat:300055597 a skos:Concept ;
    skos:definition "Intangible assets that include patents, trade marks, copyrights, and registered and unregistered design rights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intellectual property"@en .

aat:300055598 a skos:Concept ;
    skos:definition "Exclusive, legally secured rights determining who may publish, copy, or distribute a work of art, writing, music, photograph, or other work. Works protected by copyright require the permission of the creator or other rights holder for their use. Some nations have the provision of fair use, which allows for limited use for educational purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copyright"@en .

aat:300055603 a skos:Concept ;
    skos:definition "General term for the right or condition of complete dominion, title, or proprietary right to a real or other property as allowed by law. Ownership may be private, collective, or common. Ownership may be present even in the absence of possession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ownership"@en .

aat:300055605 a skos:Concept ;
    skos:definition "Right or condition of owning real property that is intended for domestic use, usually by one family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home ownership"@en .

aat:300055607 a skos:Concept ;
    skos:definition "Estate or property other than real property consisting of things temporary or movable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal property"@en .

aat:300055608 a skos:Concept ;
    skos:definition "Property consisting of freehold land or certain rights over freehold land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "real estate"@en .

aat:300055611 a skos:Concept ;
    skos:definition "Land owned and controlled by the state or federal government. Also, the status of publications, products, and processes that are not protected under patent or copyright."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public domain"@en .

aat:300055614 a skos:Concept ;
    skos:definition "A legal right of passage over another's ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "right of way"@en .

aat:300055615 a skos:Concept ;
    skos:definition "An easement conferring on the owner of a dominant tenement rights in connection with water, such as the rights to draw water from a particular source or to discharge water onto another's land, or a right to enter another's land to open sluice gates in order to prevent flooding of the dominant tenement. Also, a natural right to use water flowing through a channel on one's land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water rights"@en .

aat:300055617 a skos:Concept ;
    skos:definition "The right of one owning waterfront land to have access to and use of the shore and water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riparian rights"@en .

aat:300055618 a skos:Concept ;
    skos:definition "Scientific concepts related to mathematics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathematical concepts"@en .

aat:300055619 a skos:Concept ;
    skos:definition "Mathematical concepts related to geometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometric concepts"@en .

aat:300055620 a skos:Concept ;
    skos:definition "The shapes, or measures of the shapes, formed by two line segments that meet at a common point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angles"@en .

aat:300055621 a skos:Concept ;
    skos:definition "The quantity of two-dimensional space that is contained within given limits. Area is typically measured in square units, for example square meters or square miles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "area"@en .

aat:300055622 a skos:Concept ;
    skos:definition "Fixed reference lines for the measurement of coordinates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axes"@en .

aat:300055623 a skos:Concept ;
    skos:definition "The length of a line that bounds a circular plane surface, equal to pi times the diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circumference"@en .

aat:300055624 a skos:Concept ;
    skos:definition "The length of a straight line passing through the center of a circle or sphere, terminated at each end by its circumference or surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diameter"@en .

aat:300055625 a skos:Concept ;
    skos:definition "Degree or amount of separation between two points, lines, surfaces, or objects in geometrical space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distances"@en .

aat:300055626 a skos:Concept ;
    skos:definition "Definite geometric forms or shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometric figures"@en .

aat:300055627 a skos:Concept ;
    skos:definition "Geometric plane figures bounded by a single curved line which is everywhere equally distant from the center of the figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circles"@en .

aat:300055628 a skos:Concept ;
    skos:definition "Solid figures of which the base is a circle, and the summit a point, and every point in the intervening surface is in a straight line between the vertex and the circumference of the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cones"@en .

aat:300055630 a skos:Concept ;
    skos:definition "Geometric plane figures produced when a cone is cut obliquely by a plane taking a smaller angle with the base than the side of the cone makes with the base; the form is symmetric about its horizontal and vertical axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ellipses"@en .

aat:300055631 a skos:Concept ;
    skos:definition "Geometric plane figures having the shape of an elongated circle, bounded by a smooth curve having no concave parts, longer along one axis and rounded at each end. An oval differs from an elliptical shape in that it is not necessarily symmetric about its horizontal and vertical axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ovals"@en .

aat:300055632 a skos:Concept ;
    skos:definition "Polygons having five angles and five sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pentagons"@en .

aat:300055633 a skos:Concept ;
    skos:definition "Geometric plane figures having three or more straight sides and the same number of angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polygons"@en .

aat:300055634 a skos:Concept ;
    skos:definition "Polygons with six sides and six angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hexagons"@en .

aat:300055635 a skos:Concept ;
    skos:definition "Polygons having eight sides and eight angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octagons"@en .

aat:300055636 a skos:Concept ;
    skos:definition "Quadrilateral parallelograms having four right angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectangles"@en .

aat:300055637 a skos:Concept ;
    skos:definition "Parallelograms with four equal sides and four right angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squares"@en .

aat:300055639 a skos:Concept ;
    skos:definition "A geometrical figure comprising the set of all points in three-dimensional space lying the same distance (the radius) from a given point (the center), or the result of rotating a circle about one of its diameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spheres"@en .

aat:300055640 a skos:Concept ;
    skos:definition "Flat surfaces in three dimensions such that all points on a line joining any pair of points also belong to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planes"@en .

aat:300055641 a skos:Concept ;
    skos:definition "A radius is a line segment joining the center of a circle or sphere to the circle or sphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radii"@en .

aat:300055642 a skos:Concept ;
    skos:definition "In general, the relative extent of something, its overall dimensions, magnitude, bulk, or bigness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "size"@en .

aat:300055644 a skos:Concept ;
    skos:definition "The length of a straight vertical line extending from the bottom to the top of a form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "height"@en .

aat:300055645 a skos:Concept ;
    skos:definition "The dimension of a straight horizontal line extending from the left side to the right side of a horizontal form. Usage may overlap with \"width.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "length"@en .

aat:300055646 a skos:Concept ;
    skos:definition "The measurement or extension through or between opposite surfaces, for example of an object or material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thickness"@en .

aat:300055647 a skos:Concept ;
    skos:definition "The length of a straight horizontal line extending from one side to the other of a form. For the measure or distance of the extent across a surface, prefer \"breadth,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "width"@en .

aat:300055648 a skos:Concept ;
    skos:definition "Inclined surfaces, slopes, or declivities; a slope is the numerical measure of a line’s inclination relative to the horizontal. In analytic geometry, the slope of any line, ray, or line segment is the ratio of the vertical to the horizontal distance between any two points on it. Given a straight line in a plane, the constant value m=(y2-y1)/(x2-x1), where (x1, y1) and (x2, y2) are any two points on the line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slopes"@en .

aat:300055649 a skos:Concept ;
    skos:definition "The quantity or mass of an object or material that occupies space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volume"@en .

aat:300055650 a skos:Concept ;
    skos:definition "Mathematical concepts related to statistics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statistics-related concepts"@en .

aat:300055651 a skos:Concept ;
    skos:definition "Degree to which two or more attributes or measurements on the same group of elements show a tendency to vary together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "correlation"@en .

aat:300055653 a skos:Concept ;
    skos:definition "The relative possibility that an event will occur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "probability"@en .

aat:300055654 a skos:Concept ;
    skos:definition "An average value of a set of numbers found by computation. There are three principle types: arithmetic, harmonic and geometric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mean"@en .

aat:300055656 a skos:Concept ;
    skos:definition "In statistics, the set of values, together with their relative frequencies, of any variable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distribution"@en .

aat:300055657 a skos:Concept ;
    skos:definition "A value in an ordered set of quantities above and below which fall an equal number of quantities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "median"@en .

aat:300055659 a skos:Concept ;
    skos:definition "Statements that each of two expressions is equal to the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equations"@en .

aat:300055660 a skos:Concept ;
    skos:definition "Algorithms, often expressed in algebraic symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formulas"@en .

aat:300055662 a skos:Concept ;
    skos:definition "Mathematical rules between two sets which assign to each member of the first set exactly one member of the second."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "functions"@en .

aat:300055663 a skos:Concept ;
    skos:definition "The power to which a number, called a base, has to be raised to give another number."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logarithms"@en .

aat:300055664 a skos:Concept ;
    skos:definition "The quantity of matter in a body, as distinct from its weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass"@en .

aat:300055665 a skos:Concept ;
    skos:definition "Abstract units belonging to a mathematical system and subject to specified laws of succession, addition, and other functions. For the written or printed characters that denote units in a numerical sequence, use \"numerals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numbers"@en .

aat:300055668 a skos:Concept ;
    skos:definition "Quantities that when taken as factors the number of times indicated produce other quantities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roots"@en .

aat:300055669 a skos:Concept ;
    skos:definition "The sum of a sequentially ordered finite or infinite set of terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "series"@en .

aat:300055673 a skos:Concept ;
    skos:definition "Social science concepts related to economics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economic concepts"@en .

aat:300055674 a skos:Concept ;
    skos:definition "Gradual reduction of a financial obligation by payment of a part of the principal, contribution to a sinking fund, or the gradual depreciation of an asset."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amortization"@en .

aat:300055675 a skos:Concept ;
    skos:definition "Refers to the buying, selling, and trading of works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art market"@en .

aat:300055678 a skos:Concept ;
    skos:definition "Bringing articles of trade or commerce into a country from abroad for sale or exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "importing"@en .

aat:300055679 a skos:Concept ;
    skos:definition "Something given or received in return for goods or services, or as settlement of a debt or injury."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compensation"@en .

aat:300055680 a skos:Concept ;
    skos:definition "Compensation often in the form of a fixed charge for professional services or requested exercise of talent or skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fees"@en .

aat:300055684 a skos:Concept ;
    skos:definition "Regular payments made by the government, an employer, or a private fund to people above a specified age, usually after retirement from work, the disabled and widows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pensions"@en .

aat:300055686 a skos:Concept ;
    skos:definition "Compensation, usually in money, paid to employees for services rendered according to contract or other agreement, on an hourly, daily, or piecework basis. For such compensation paid on the basis of longer time periods, use \"salaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wages"@en .

aat:300055689 a skos:Concept ;
    skos:definition "Using corrective measures through management and interpretation of cost benefit analyses to increase efficiency and economy of operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cost control"@en .

aat:300055694 a skos:Concept ;
    skos:definition "The amount of money or a material equivalent expected, required, or given in payment for a commodity or service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prices"@en .

aat:300055698 a skos:Concept ;
    skos:definition "Payment by a tenant to an owner under the terms of a lease or tenancy agreement for the services of a durable good such as a piece of land or property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rent"@en .

aat:300055699 a skos:Concept ;
    skos:definition "Rate of rent which is sufficient to cover all costs of maintenance and operation of a building and, in addition, yield a reasonable return on the investment of the owner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economic rent"@en .

aat:300055700 a skos:Concept ;
    skos:definition "A price per year or term of years paid for the right to occupy and improve a piece of land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground rent"@en .

aat:300055701 a skos:Concept ;
    skos:definition "The restriction of rent that may be charged for the occupation or use of certain premises in a municipality, usually residential, by local law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rent control"@en .

aat:300055706 a skos:Concept ;
    skos:definition "The extent to which a person can receive money or goods for payment in the future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credit"@en .

aat:300055707 a skos:Concept ;
    skos:definition "A decline in value or reduction of worth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depreciation"@en .

aat:300055708 a skos:Concept ;
    skos:definition "The degree or extent to which paid work is provided or available to the population. For the ongoing activity of providing individuals with and paying them for work, use \"employing.\" For the action of engaging the services of a person or persons for wages or other payment, use \"hiring.\" For the concept of those activities that people pursue as their livelihood or their primary business or work, whether paid or not, use \"occupations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "employment"@en .

aat:300055709 a skos:Concept ;
    skos:definition "The state of being without a paying job."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unemployment"@en .

aat:300055711 a skos:Concept ;
    skos:definition "An interest, commonly expressed in money, which an owner has in property over and above all liens against the property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equity"@en .

aat:300055713 a skos:Concept ;
    skos:definition "Vesting control or ownership of something located or based within a country, such as natural resources or industrial enterprises, in the national government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nationalization"@en .

aat:300055715 a skos:Concept ;
    skos:definition "Branch of economics concerning the management or use of funds and credit by a government, business, or individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finance"@en .

aat:300055716 a skos:Concept ;
    skos:definition "Used generally for city, town, borough, or village finance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal finance"@en .

aat:300055718 a skos:Concept ;
    skos:definition "Refers to organized activity in which capital and labor are utilized for some useful purpose or to manufacture goods or to manipulate or process a product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industry"@en .

aat:300055719 a skos:Concept ;
    skos:definition "Coverage by contract whereby for a stipulated consideration one party undertakes to indemnify or guarantee another against loss by a specified contingency or peril."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurance"@en .

aat:300055726 a skos:Concept ;
    skos:definition "Legal right, and evidence of that right, regarding the possession of property, usually real property or large items such as automobiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "title"@en .

aat:300055727 a skos:Concept ;
    skos:definition "Expenditures of money for income or profit or to purchase something of extrinsic value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "investments"@en .

aat:300055732 a skos:Concept ;
    skos:definition "Contractual business transaction between two or more parties that is restricted to specified undertakings during a particular time frame. It differs from \"partnership (legal concept),\" in that partnership is a long-term agreement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint venture"@en .

aat:300055736 a skos:Concept ;
    skos:definition "The supporting of artists and buying or funding of their work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patronage"@en .

aat:300055744 a skos:Concept ;
    skos:definition "Wealth or success."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prosperity"@en .

aat:300055745 a skos:Concept ;
    skos:definition "Grants or gifts of money or other property made by way of financial aid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subsidies"@en .

aat:300055753 a skos:Concept ;
    skos:definition "Financial assistance given for the purpose of education to a person who is studying, especially at a place of higher education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student aid"@en .

aat:300055754 a skos:Concept ;
    skos:definition "The financial grants awarded to members of a college or university graduate community for a limited number of years, on condition of pursuing some specified branch of study. Distinct from scholarships in that fellowships are given to members of graduate communities, rather than undergraduates, and the course of study is specified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fellowships"@en .

aat:300055755 a skos:Concept ;
    skos:definition "A need-based or merit-based financial award given to a student, usually from the funds of a school, college, or university, for the purpose of defraying the cost of education. Distinct from fellowships in that scholarships are awarded to members of an undergraduate community, rather than graduates, and the course of study is unspecified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scholarships"@en .

aat:300055756 a skos:Concept ;
    skos:definition "A list of duties or charges established by an organization to be paid for services or goods, usually imports and exports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tariff"@en .

aat:300055759 a skos:Concept ;
    skos:definition "An amount, as of goods, services, or money, considered to be a fair and suitable equivalent for something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "value"@en .

aat:300055767 a skos:Concept ;
    skos:definition "All property or resources that have monetary or exchangeable value or economic utility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wealth"@en .

aat:300055768 a skos:Concept ;
    skos:definition "The sum total of ways of living, artifacts, customs, and so on, built up by a group of people and transmitted from one generation to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culture"@en .

aat:300055770 a skos:Concept ;
    skos:definition "The attitude and movement characterized by the love of practicing a craft, art, or work without direct remuneration or professional status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amateurism"@en .

aat:300055771 a skos:Concept ;
    skos:definition "The quality or procedure characteristic of a person who cultivates an art or a branch of knowledge as a pastime without pursuing it professionally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dilettantism"@en .

aat:300055772 a skos:Concept ;
    skos:definition "Use generally for opposition to the use of idols. For more vehement movements against religious images, use \"iconoclasm.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aniconism"@en .

aat:300055773 a skos:Concept ;
    skos:definition "Interest in or devotion to things of the past, especially of ancient times. The term implies admiration of a style or object simply because it is old."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiquarianism"@en .

aat:300055774 a skos:Concept ;
    skos:definition "The retention or imitation of what is old or obsolete, especially the use in language, art, and other cultural areas of the characteristics of an earlier period. It often is based on the belief in the innate value of the earlier model coming from a simpler, purer golden age, and that the revival of these forms will encourage a revival of the imagined quality of life of those former days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaism"@en .

aat:300055775 a skos:Concept ;
    skos:definition "New or experimental concepts, particularly attitudes, ideas, or works of art or architecture from the late 19th to the mid-20th century, that depart from the existing norm in an original and experimental way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avant-garde"@en .

aat:300055776 a skos:Concept ;
    skos:definition "The life, habits, and character of one who either cuts himself off, or is by his habits cut off, from society for which he is otherwise fitted. Especially an artist, literary person, or performer, who leads a free, vagabond, or irregular life, not being particular as to the society he frequents, and despising social conventions generally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bohemianism"@en .

aat:300055777 a skos:Concept ;
    skos:definition "Literary or artistic style often associated with the English and French decadents of the late 19th century, marked especially by precocity of language and refined emotionalism of subject matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dandyism"@en .

aat:300055779 a skos:Concept ;
    skos:definition "Theory in sociology that sociocultural advance is the product of intergroup conflict and competition and that therefore the socially elect classes (those possessing wealth and power) possess biological superiority in the struggle for existence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Social Darwinism"@en .

aat:300055780 a skos:Concept ;
    skos:definition "Belief in and advocacy of leadership or rule by an elite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elitism"@en .

aat:300055781 a skos:Concept ;
    skos:definition "A philosophical movement of the late 18th century characterized by an untrammeled but frequently uncritical use of reason, a lively questioning of authority and traditional doctrines, a tendency toward individualism, and an emphasis on the idea of universal human progress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Enlightenment"@en .

aat:300055782 a skos:Concept ;
    skos:definition "Tendency toward viewing alien cultures with disfavor; also the resulting sense of inherent superiority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnocentrism"@en .

aat:300055783 a skos:Concept ;
    skos:definition "Interest in or adoption of the exotic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exoticism"@en .

aat:300055784 a skos:Concept ;
    skos:definition "Representation of characteristics of Asian art or culture appearing in Western practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orientalism"@en .

aat:300055785 a skos:Concept ;
    skos:definition "Style and cultural movement, primarily European and North American, that comprised a wide range of borrowings from Japanese art and culture, particularly in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japonisme"@en .

aat:300055786 a skos:Concept ;
    skos:definition "Social and political critical theory and movement asserting the inherent value of women and female characteristics, and working to protect and promote women's rights and interests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feminism"@en .

aat:300055788 a skos:Concept ;
    skos:definition "The most flourishing period in the history of something, the time of highest achievement or greatest development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golden age"@en .

aat:300055789 a skos:Concept ;
    skos:definition "A system of ideas based on hermetic teachings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hermetism"@en .

aat:300055791 a skos:Concept ;
    skos:definition "A philosophy that asserts the essential dignity and worth of humanity and its capacity to achieve self-realization through reason; also (capitalized), the Renaissance movement characterized by the revival of classical letters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humanism"@en .

aat:300055792 a skos:Concept ;
    skos:definition "Doctrine, practice, or attitude of one who destroys religious images or opposes their veneration. Use also for the specific period of Byzantine history. For opposition to the use of idols generally, use \"aniconism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iconoclasm"@en .

aat:300055793 a skos:Concept ;
    skos:definition "Belief that the only or the highest values or objectives in life lie in material well-being and pleasure, and in the furthering of material progress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "materialism"@en .

aat:300055794 a skos:Concept ;
    skos:definition "The dance, literature, music, theater, cinema, television, language, fashion, and other cultural indicators intended for or appreciated by the mainstream public rather than an elite audience. Popular culture reflects changes of style, fads, nostalgia, critical revivals, popular institutions, and forms borrowed from elite art, folk art, or foreign culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popular culture"@en .

aat:300055796 a skos:Concept ;
    skos:definition "The quality of belonging to a dialectal, idiomatic, local group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provincialism"@en .

aat:300055797 a skos:Concept ;
    skos:definition "Style or movement characterized by the adoption of aggressively unconventional and often bizarre, violent, or shocking appearances and the defiance of social norms of behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punk"@en .

aat:300055798 a skos:Concept ;
    skos:definition "Refers to the way of thinking, prominent in the 1960s and 1970s in America, associated with the rejection of stable, middle-class values and conservative attitudes in regard to fashion, politics, musical tastes, education, and social values. The movement is generally characterized by radical political beliefs, sexual liberation, provocative fashion styles, and drug use. In a limited sense, the movement also catalyzed the spirit of the civil rights and environmental movements of the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radicalism"@en .

aat:300055800 a skos:Concept ;
    skos:definition "Refers to a general consciousness of and loyalty to a distinct subnational or supranational area usually characterized by a common culture, background, or interests. For the specific movement in American painting in the 1930s and 1940s, use \"Regionalist.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regionalism"@en .

aat:300055801 a skos:Concept ;
    skos:definition "Theory or method applicable in many fields in which interrelations of constituent elements (as of a work of literature, an activity, or an approach) are regarded as more significant than the elements in isolation; sometimes applied to all human activity and its products, such that even thought itself is seen as constructed and not natural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structuralism"@en .

aat:300055802 a skos:Concept ;
    skos:definition "The adherence to the doctrines or practices of a tradition based on beliefs often opposed to modernism, liberalism, and radicalism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traditionalism"@en .

aat:300055803 a skos:Concept ;
    skos:definition "A German philosophical concept of a “national spirit” or ingrained popular consciousness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Volksgeist"@en .

aat:300055804 a skos:Concept ;
    skos:definition "General intellectual and moral state or the trend of culture and taste characteristic of an era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zeitgeist"@en .

aat:300055806 a skos:Concept ;
    skos:definition "Generally, a relatively high level of cultural and technological development in human society. Specifically, the stage of cultural development at which writing and the keeping of written records is attained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civilization"@en .

aat:300055807 a skos:Concept ;
    skos:definition "Usages, practices, or conventions that regulate social life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "customs"@en .

aat:300055810 a skos:Concept ;
    skos:definition "The forms required by good breeding or prescribed by authority to be observed in social or official life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etiquette"@en .

aat:300055811 a skos:Concept ;
    skos:definition "A prevailing usually short lived custom, usage, or style in clothing, cars, restaurants, or other personal possessions and services. For the field of study and commercial activity of the design of clothing, accessories, and ensembles for personal wear, use \"fashion design.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion"@en .

aat:300055812 a skos:Concept ;
    skos:definition "Means of communication designed to reach large numbers of people, such as hardcopy or online newspapers, radio, and television, regarded collectively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass media"@en .

aat:300055815 a skos:Concept ;
    skos:definition "Literary device based on the Latin word, allusio, meaning 'a play on words', used to insinuate, suggest, or provide indirect reference to a person, event, thing, or part of another text. Allusions are distinguished from devices such as direct quote or imitation and are based on the assumption that a body of knowledge and cultural understanding is shared by the author and reader."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allusion"@en .

aat:300055816 a skos:Concept ;
    skos:definition "References to past visual art in another work of visual art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quotations"@en .

aat:300055818 a skos:Concept ;
    skos:definition "Use generally to mean belonging to the period or manner of ancient Greece or Rome. Use specifically to refer to those aspects of classical art, particularly the representation of the human figure in ancient sculpture and also the use of ornament in ancient art, when they are used as models of perfection in other periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antique, the"@en .

aat:300055820 a skos:Concept ;
    skos:definition "Use when referring to the manner in which contiguous shapes are joined or formed in architectural or decorative designs or in works of art; also, the clarification of an architectural design by emphasizing certain elements of the structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "articulation"@en .

aat:300055821 a skos:Concept ;
    skos:definition "A pleasing quality associated with harmony of form or color, excellence of craftsmanship, truthfulness, originality, or another, often unspecified, quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beauty"@en .

aat:300055825 a skos:Concept ;
    skos:definition "Literary device consisting of the use of vivid and evocative figurative language to represent objects or ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imagery"@en .

aat:300055826 a skos:Concept ;
    skos:definition "Aesthetic concept that takes imitation as the primary operative aspect in the creation of a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mimesis"@en .

aat:300055828 a skos:Concept ;
    skos:definition "The form of analytical criticism in which one performance or work of art or literature subversively mimics another work or its style by adapting and inverting its characteristic features, in order to reveal weaknesses, pretensions, or lack of self-awareness in the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parody"@en .

aat:300055829 a skos:Concept ;
    skos:definition "Aesthetic concept or expression, arising in Europe first in painting of the 18th century and later in architecture of the 19th century, characterized by rough, curious, or irregular forms; it applies particularly to rustic landscapes and crumbling buildings having neither the awe-inspiring grandeur of the Sublime nor the order and regularity of beauty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picturesque, the"@en .

aat:300055834 a skos:Concept ;
    skos:definition "The effect conveyed by some works of art of skillful execution done without apparent effort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprezzatura"@en .

aat:300055835 a skos:Concept ;
    skos:definition "Configuration of artistic elements that together constitute a manner of expression peculiar to a certain epoch, people, or individual. A distinctive appearance or manner; a visual language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "style"@en .

aat:300055836 a skos:Concept ;
    skos:definition "Representation of natural forms in a simplified or exaggerated manner. More broadly, the representation of appearances, sounds, motions, shapes, speech, or gestures in accordance with conventions of a particular style rather than with observation of individual examples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylization"@en .

aat:300055837 a skos:Concept ;
    skos:definition "The conception or expression of awe-inspiring grandeur in a work of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sublime, the"@en .

aat:300055841 a skos:Concept ;
    skos:definition "A critical concept concerning the qualities of congruence among the elements of a work of visual art, literature, or theater, and good taste in the work's relationship to external reality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorum"@en .

aat:300055843 a skos:Concept ;
    skos:definition "The manner in which an artist or craftsman uses the technical elements of a medium to achieve a desired aesthetic effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technique"@en .

aat:300055845 a skos:Concept ;
    skos:definition "That which evokes an awareness or feeling of deep revulsion or painfully disturbs a previously accepted aesthetic ideal. Can be considered as culturally defined or as an individual reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ugliness"@en .

aat:300055847 a skos:Concept ;
    skos:definition "Education in art aimed at encouraging an understanding of it based on its perceptible qualities, including training students in the sensory experiencing of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art appreciation"@en .

aat:300055848 a skos:Concept ;
    skos:definition "The quality of being genuine or original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authenticity"@en .

aat:300055851 a skos:Concept ;
    skos:definition "Analyzing and evaluating the characteristics of man-made objects, literary works and documents, actions or projects. For critical descriptions or analyses of relatively recent works or events, use \"reviews.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "criticism"@en .

aat:300055857 a skos:Concept ;
    skos:definition "Exposition or explanation, especially critical interpretation of a portion of Scripture or other text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exegesis"@en .

aat:300055858 a skos:Concept ;
    skos:definition "The study and application of the methodological principles of interpretation and explanation; specifically the general principles of Biblical interpretation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hermeneutics"@en .

aat:300055859 a skos:Concept ;
    skos:definition "Refers to subject matter in works of art, including characters, animals, plants, themes, stories, events, places, objects, and their symbolism and allegoric signficance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iconography"@en .

aat:300055860 a skos:Concept ;
    skos:definition "The effect exercised by someone or their work upon the creative thought or work of others. For the activity of affecting the actions, behavior, opinions, or work of others use \"influencing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "influence"@en .

aat:300055863 a skos:Concept ;
    skos:definition "The history of the ownership and transmission of an object, including previous locations of a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provenance"@en .

aat:300055865 a skos:Concept ;
    skos:definition "Method of representing things by symbols, or of giving a symbolic character to objects or acts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symbolism"@en .

aat:300055866 a skos:Concept ;
    skos:definition "Method of expressing complex or abstract ideas in the literary or visual arts under the guise of another subject of aptly suggestive resemblance. An allegory is principally constructed from personifications and symbols. In art, allegories include combinations of personifications and/or symbols, which, on the basis of a conventionally agreed relation between concept and representation, refer to an idea outside the work of art. The properties and circumstances attributed to the apparent subject of the allegory really refer to another subject in an extended or continued metaphor. Allegories may have meaning on two or more levels that the viewer or reader can understand only through an interpretive process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allegory"@en .

aat:300055870 a skos:Concept ;
    skos:definition "The practice of referring to intangible or religious concepts through architectural proportion or repetition of forms in works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "number symbolism"@en .

aat:300055874 a skos:Concept ;
    skos:definition "Refers to the practice of representing tangible objects or personifications as signs of religious beliefs or ideals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious symbolism"@en .

aat:300055878 a skos:Concept ;
    skos:definition "Visible signs (which can include figures, such as personifications, or objects) that stand for something else, often something abstract or invisible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symbols"@en .

aat:300055880 a skos:Concept ;
    skos:definition "Body of generalizations and principles developed in association with practice in a field of activity and forming its content as an intellectual discipline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theory"@en .

aat:300055893 a skos:Concept ;
    skos:definition "The principles derived from the analysis of literature, and by extension, art and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary theory"@en .

aat:300055898 a skos:Concept ;
    skos:definition "Correspondence between two things, or in the relationship between two things and their respective attributes. In visual and literary works, a figure of speech or depiction used to cite or hypothesize a relationship of similarity and comparability between two disparate ideas or elements; often used as a point of clarification, or to elucidate an unfamiliar point or idea in terms of something more familiar and accessible. An example would be describing the correspondence between a river moving through a valley, with which readers would be familiar, and a glacier moving through a valley, which is much slower and more difficult to perceive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analogy"@en .

aat:300055899 a skos:Concept ;
    skos:definition "Literary device in which a painting, sculpture, or other work of visual art is described in detail; the work may be real or imaginary. In original usage, was undertaken as a rhetorical exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ekphrasis"@en .

aat:300055900 a skos:Concept ;
    skos:definition "Device used in verbal or written form, in which the real and actual meaning or intention is obscured or contradicted by the literal meaning of the words; used also in the structuring of dramatic situations in which an incongruity exists between what is expected and what occurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irony"@en .

aat:300055901 a skos:Concept ;
    skos:definition "A figure of speech or visual work that implies comparison between two unlike entities, in which a word, phrase, or idea is applied to something to which it is not literally applicable in order to suggest a resemblance. Metaphor is the fundamental language of poetry, although it is common in all kinds of language and in visual works. An example is the title of the Tennessee Williams play, \"Sweet Bird of Youth,\" which implyies that the time of youth seems to fly, i.e., pass quickly. For an explicit comparison signaled by the words \"like\" or \"as,\" use \"simile.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metaphor"@en .

aat:300055902 a skos:Concept ;
    skos:definition "A figure of speech that consists in using the name of one thing for that of something else with which it is associated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metonymy"@en .

aat:300055903 a skos:Concept ;
    skos:definition "The technique of storytelling, particularly in the visual arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrative"@en .

aat:300055905 a skos:Concept ;
    skos:definition "Artistic device that consists of attributing and granting human characteristics to an abstract quality, animal, or inanimate object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personification"@en .

aat:300055906 a skos:Concept ;
    skos:definition "Figure of speech used mostly in poetry that consists in establishing or defining a whole concept or idea with a part or aspect of that concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synecdoche"@en .

aat:300055908 a skos:Concept ;
    skos:definition "The genre of nonfiction that concerns accounts of the lives of individuals. For examples of this genre, prefer \"biographies (literary works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biography"@en .

aat:300055909 a skos:Concept ;
    skos:definition "A genre of that concerns accounts of the lives of the saints. For written examples of this genre, prefer \"hagiographies (literary works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hagiography"@en .

aat:300055911 a skos:Concept ;
    skos:definition "Genre encompassing forms of theatre, literature, and improvisation with the basic objective to amuse, humor, and induce laughter. In general, it is often contrasted with tragedy and can be applied in the form of social criticism through satire and political or intellectual wit or applied in the form of pure spectacle through farce or burlesque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comedy"@en .

aat:300055912 a skos:Concept ;
    skos:definition "Italian 16th- to 18th-century comedy performed by companies of actors trained to improvise dialogue, gesture, and movement from a written plot built around standardized situations and stock characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commedia dell'arte"@en .

aat:300055913 a skos:Concept ;
    skos:definition "Genre of dramatic forms dealing with issues of religion, spirituality, faith, and moral decorum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious drama"@en .

aat:300055914 a skos:Concept ;
    skos:definition "Medieval plays based on the lives of the saints or other biblical legends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mystery plays"@en .

aat:300055915 a skos:Concept ;
    skos:definition "Dramatic performances that follow the Passion of Jesus Christ from the Last Supper to Crucifixion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passion plays"@en .

aat:300055916 a skos:Concept ;
    skos:definition "Performing arts and literary genre that evokes a serious examination of human events such as birth, death, decay, obsolescence, disaster, love, marriage, and family encountered by individuals or groups. Originating in ancient Greece, the genre developed in a strict format featuring a chorus, a heroic character, myths, and pontification of universal morals or themes. Historically, the criterion of what is tragic has changed, with the idea of psychological corruption, disillusionment, isolation, and individual accountability defining tragedy in the 19th and 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tragedy"@en .

aat:300055917 a skos:Concept ;
    skos:definition "Fictitious narratives usually with animals or inanimate objects as protagonists, intended to convey a hidden meaning regarding human conduct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fables"@en .

aat:300055918 a skos:Concept ;
    skos:definition "Genre that refers to works evoked from the imagination of the creator and not conferred as fact. In literature, fiction generally refers to the novel, novella, short story, and poetic forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiction"@en .

aat:300055919 a skos:Concept ;
    skos:definition "Refers to the form of fiction established in the 20th century, though notable precursors were established in the 19th century, in reaction to the growing controversy over the impact of science on society and individuals. Generally, the term encompasses fiction that deals with fantasy with dominant elements of plausibility and deals with future conceptions of society that include the informed extrapolation of scientific principles as a legitimizing and directional component. Prominent examples in this genre from the 19th century include Mary Shelley's Frankenstein (1818) and Robert Louis Stevenson's Strange Case of Dr. Jekyll and Mr. Hyde (1886); examples from the 20th century include works by Jules Verne, H.G. Wells, Hugo Gernsback, and Isaac Asimov. Later in the 20th century, the elements of science fiction appear in works by Kurt Vonnegut, C.S. Lewis, and Ray Bradbury, featuring future scenarios of human society and the possible consequences of space travel and extraterrestrial life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science fiction"@en .

aat:300055920 a skos:Concept ;
    skos:definition "Discipline dealing with the study of traditional and expressive forms of culture, such as song, story, dance, ritual, handicraft, art, food, costume, custom, religion, architecture, and work skills, and of the processes and meanings that underlie them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folklore"@en .

aat:300055922 a skos:Concept ;
    skos:definition "Traditional stories or legends in a given culture that are passed down over time, often orally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folk tales"@en .

aat:300055923 a skos:Concept ;
    skos:definition "Stories handed down by tradition from earlier times, usually concerned with a real person, place, or event, and popularly regarded as historical although not entirely verifiable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legends"@en .

aat:300055926 a skos:Concept ;
    skos:definition "The study and writing of history based on the critical examination of sources, the selection of particulars from authentic material, and the synthesis of particulars into a narrative that will stand the test of critical methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historiography"@en .

aat:300055931 a skos:Concept ;
    skos:definition "Literary and oral genre rooted in the compressed and cogent imaginative awareness or associations of experiences, ideas, or emotional responses and arranged under an organized criterion of meaning, conscious and unconscious expression, symbolism, formal or informal pattern, sound, and rhythm. The genre encompasses narrative, dramatic, satiric, didactic, erotic, and personal forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poetry"@en .

aat:300055932 a skos:Concept ;
    skos:definition "Genre of visual poetry, particularly of the concrete poetry movement of the 1950s and 1960s, in which language elements are arranged freely, not necessarily in linear syntax, and meaning is derived from spatial, pictorial, and typographic characteristics of the work, as well as from the sense of the words. For pre-20th-century works of visual poetry in which letters, words, or lines are arranged to form a shape or image, usually related to the meaning of the words, see \"pattern poetry.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete poetry"@en .

aat:300055933 a skos:Concept ;
    skos:definition "Depiction or description of explicit sexual activity in a manner intended to stimulate a primarily carnal, rather than aesthetic, feeling. For aesthetisized depictions or descriptions that focus on sexual love, use \"erotica.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pornography"@en .

aat:300055934 a skos:Concept ;
    skos:definition "Artistic device holding up human folly and vice to scorn, derision, or ridicule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satire"@en .

aat:300055935 a skos:Concept ;
    skos:definition "Alliances or organizations of writers that share intellectual and artistic influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary movements"@en .

aat:300055937 a skos:Concept ;
    skos:definition "A early 20th-century literary movement created in revolt against romanticism, specifically its optimism and supposed carelessness; the movement called for free verse and precise imagery. It is seen as the successor to French symbolism in the sense that it has an affinity to sculpture as symbolism has an affinity to music. Ezra Pound, inspired by the critical views of T.E. Hulme, devised its poetic ideals in about 1912."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imagism"@en .

aat:300055938 a skos:Concept ;
    skos:definition "Concepts related to knowledge, learning, and scholarship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philosophical concepts"@en .

aat:300055939 a skos:Concept ;
    skos:definition "System of moral principles or rules of conduct for voluntary human action. For the branch of philosophy that studies these principles and rules, with respect to the rightness or wrongness of certain human actions, and the goodness or badness of the motives and ends of such actions, use \"ethics (philosophy).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethics"@en .

aat:300055942 a skos:Concept ;
    skos:definition "Principles of conduct or proper action that members of professions are expected to observe in the practice of their professions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professional ethics"@en .

aat:300055944 a skos:Concept ;
    skos:definition "Ethics that have as their utilitarian end the well-being and fair treatment of the entire community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social ethics"@en .

aat:300055945 a skos:Concept ;
    skos:definition "Philosophical concepts that deal with the nature of reality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metaphysical concepts"@en .

aat:300055946 a skos:Concept ;
    skos:definition "Originally in ancient Greece, a form of logical argumentation proceeding by question and answer. In modern times it is the idea that internal contradictions are transcended, but then give rise to new contradictions that themselves must be resolved. As a concept of evolution, it applies to diverse fields including philosophy, nature, and history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dialectic"@en .

aat:300055947 a skos:Concept ;
    skos:definition "Beyond or outside of the natural order. The term is typically used to refer to events or phenomena that are not explicable given the existing characterizations of nature. Occult phenomena and extrasensory perception are examples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supernatural"@en .

aat:300055949 a skos:Concept ;
    skos:definition "The act, process, or policy of prohibition of the production, distribution, circulation, or access to a work, or the suppression or deletion of parts of a work, on the grounds that the work contains material or is of an appearance considered politically or morally offensive by some."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "censorship"@en .

aat:300055952 a skos:Concept ;
    skos:definition "Refers to behavior, expression, or appearance that is indecent, lewd, or offensive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obscenity"@en .

aat:300055954 a skos:Concept ;
    skos:definition "The act of following the formal rules and traditions of literature and art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academicism"@en .

aat:300055955 a skos:Concept ;
    skos:definition "A theory of art which maintains that the philosophy of art is separate from any other philosophy and that art can be judged only by its own standards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aestheticism"@en .

aat:300055956 a skos:Concept ;
    skos:definition "Interpretation of what is not human in terms of human characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropomorphism"@en .

aat:300055957 a skos:Concept ;
    skos:definition "Philosophy incorporating essential features of the thinking of Aristotle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aristotelianism"@en .

aat:300055958 a skos:Concept ;
    skos:definition "In psychological studies, denotes the dissociation or discrepancy between behavior and the conscious awareness of the behavior. The concept is generally used to describe benign behavior based on familiarity and repetitiveness, but is more often used to describe pathological behaviors that ensue from psychological conflicts between conscious and subconscious desires and result in sensory hallucinations and mild to severe catatonia. It influenced Surrealist theories associated with the power and legitimacy of unconscious expression, free association, and prime creative forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automatism"@en .

aat:300055959 a skos:Concept ;
    skos:definition "Doctrine that all acts of will result from causes which determine them either in such a manner that people have no alternative course of action, or that the will is still free in the sense of being uncompelled. Determinism holds that all behaviors and events are determined by God or by the laws of the universe before they occur. Determinism takes different forms in religions, but the basic issue is how to reconcile the omnipotence of God or the inevitable effects of karma with the freedom and resposibility of a individual person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "determinism"@en .

aat:300055963 a skos:Concept ;
    skos:definition "Refers to a religious ideology popular in the 4th-century Christian world although it may have had earlier, non-Christian roots stemming from a break from Judaism. The believers in Gnosticism felt that they alone would attain full salvation because they possessed the teachings of Christ regarding the cosmic origins and spiritual destiny of people. It was considered heretic because of its low view of God as Creator, its secret traditions, and its belief that Christ was not really human and that his crucifixion was simply an attempt to fool evil forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gnosticism"@en .

aat:300055964 a skos:Concept ;
    skos:definition "Use to refer to the influences of Greek culture as it spread to new areas following the conquests of Alexander the Great; use also for devotion to Greek culture and ideals in any later period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hellenism"@en .

aat:300055965 a skos:Concept ;
    skos:definition "In philosophy, a theory that affirms that mind or the spiritual ideal archetype is of central importance in the interpretation of experience. It holds that the world or reality exists essentially as spirit or consciousness, and that abstractions and laws are more fundamental in reality than sensory things. Idealism is thus directly opposed to materialism, which is the theory that the basic substance of the world is matter and that it is known primarily through and as material forms and processes. Idealism is also opposed to the philosophy of realism, which holds that in human knowledge objects are grasped and seen as they really are in their existence outside and independently of the mind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idealism"@en .

aat:300055966 a skos:Concept ;
    skos:definition "The ethical doctrine or principle that the interests of the individual are or ought to be paramount in determination of conduct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "individualism"@en .

aat:300055967 a skos:Concept ;
    skos:definition "Refers in a general sense to a spiritual quest for hidden truth, the goal of which is to be united with the divine. It also refers more specifically to a belief in the existence of important realities beyond perceptual or intellectual understanding that are accessible by subjective experience, such as by intuition or meditation. Forms of mysticism are found in all major religions as well as in secular experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mysticism"@en .

aat:300055968 a skos:Concept ;
    skos:definition "Refers to a philosophy based on the idea that all phenomena can be explained in terms of natural causes without attributing spiritual, moral, or supernatural significance to them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naturalism"@en .

aat:300055969 a skos:Concept ;
    skos:definition "Refers to the philosophy of Plato or to any philosophy inspired by Plato, especially to Plato's idea that the phenomena perceived by the senses are an imperfect and transitory reflection of the ideal forms of an unchanging and eternal reality. This absolute reality (or realities) gives value and meaning to everything's existence, particularly to human life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platonism"@en .

aat:300055970 a skos:Concept ;
    skos:definition "Refers to a philosophy developed by Plotinus in Alexandria in the 3rd century CE that consists of a modified version of Platonism combined with aspects of Judaic and Christian thought and possibly Oriental mysticism. Neo-Platonism holds that there is one source from which all existence comes from and with which an individual soul can be mystically united; it also emphasizes the plurality of levels of being, with the physical universe perceptible to the senses being the lowest. Neo-Platonism developed in a variety of forms over many centuries and it has enjoyed numerous revivals and modifications throughout history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Platonism"@en .

aat:300055971 a skos:Concept ;
    skos:definition "The philosophical doctrine of Auguste Comte and his successors. It asserts that knowledge of reality can be achieved only through the particular sciences and ordinary observation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "positivism"@en .

aat:300055972 a skos:Concept ;
    skos:definition "Philosophical movement, dominant in the United States during the first quarter of the 20th century, based on the principle that the usefulness, workability, and practicality of ideas, policies, and proposals are the criteria of their merit. It stresses the priority of action over doctrine, of experience over fixed principles, and it holds that ideas borrow their meanings from their consequences and their truths from their verification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pragmatism"@en .

aat:300055973 a skos:Concept ;
    skos:definition "A theory that reason is in itself a source of knowledge superior to and independent of sense perception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rationalism"@en .

aat:300055974 a skos:Concept ;
    skos:definition "The philosophical systems and speculative tendencies of various Medieval Christian thinkers, who, working against a background of fixed religious dogma, sought to solve anew general philosophical problems (as of faith and reason, will and intellect, and the provability of the existence of God), initially under the influence of the mystical and intuitional tradition of patristic philosophy, and especially Augustinianism, and later under that of Aristotle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scholasticism"@en .

aat:300055975 a skos:Concept ;
    skos:definition "Use with reference to endeavors to communicate with the souls of the dead or other spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiritualism"@en .

aat:300055977 a skos:Concept ;
    skos:definition "A philosophical movement that flourished in Greek and Roman antiquity. Stoics have always believed that the goal of all inquiry is to provide humanity with a mode of conduct characterized by tranquility of mind and certainty of moral worth, and urged participation in the affairs of humankind. Thus, moral worth, duty, and justice are singularly Stoic emphases, together with a certain sternness of mind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoicism"@en .

aat:300055978 a skos:Concept ;
    skos:definition "A philosophic movement based on an idealistic belief in the essential unity of all things, the innate goodness of man, and the supremacy of insight over logic and experience in understanding reality and ascertaining truths. It is considered to be a part of the Romantic movement and had a powerful impact on the arts, particularly literature. The term generally refers to 19th-century transcendentalism in New England although the movement was found in other countries including Germany and England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transcendentalism"@en .

aat:300055979 a skos:Concept ;
    skos:definition "Doctrine that usefulness is the highest good and that the determining characteristic of right conduct should be the usefulness of its consequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utilitarianism"@en .

aat:300055981 a skos:Concept ;
    skos:definition "The quality or state of being divine; the nature or essence of God."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divinity"@en .

aat:300055982 a skos:Concept ;
    skos:definition "Act or state of wholeheartedly and steadfastly believing in the existence, power and benevolence of a supreme being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faith"@en .

aat:300055983 a skos:Concept ;
    skos:definition "Refers generally to the prescribed rites of formal and public worship, typically including words, music, symbolic aids, and ritual actions. The diverse forms of liturgy reflect the needs and attitudes of different religious communities. The term can also refer more specifically to the Christian rite of the Eucharist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgy"@en .

aat:300055985 a skos:Concept ;
    skos:definition "Genre and tradition concerning the study of a culture's body of myths, belonging to a particular religious or cultural tradition in an authoritative and official fashion and through symbolic narrative, iconography, or characterization, usually through the forms and personalities of deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mythology"@en .

aat:300055986 a skos:Concept ;
    skos:definition "Place or state of perfect freedom, peace, innocence, and plenty, often referred to both as the original state of humanity and a blissful world to come. Common to many religions and mythologies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paradise"@en .

aat:300055987 a skos:Concept ;
    skos:definition "Organized bodies of ideas and attitudes having to do with religion, which is broadly defined as belief systems that encompass various personal and institutional relationships between human beings and what they regard as holy, sacred, or divine, usually but not always a deity, or a spiritual or occult force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious ideologies"@en .

aat:300055988 a skos:Concept ;
    skos:definition "Christian doctrine that Jesus of Nazareth became the son of God by exaltation that was not his at birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adoptionism"@en .

aat:300055989 a skos:Concept ;
    skos:definition "Doctrine affirming that the existence of God is possible, but denying that there are any sufficient reasons for holding either that God does or does not exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agnosticism"@en .

aat:300055990 a skos:Concept ;
    skos:definition "Doctrine that there is neither God nor any other deity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atheism"@en .

aat:300055991 a skos:Concept ;
    skos:definition "A form of religious life that emphasizes the perfection of the individual through immersion in a consecrated community or, more rarely, through a solitary and ascetic existence. Monasticism is found in both Buddhism and Christianity, particularly in the Roman Catholic and Orthodox churches. Although it began as a lay movement in Christianity, clergy soon came to dominate and it began to involve voluntary poverty and a life devoted to worship. The rule of Benedict was the most important early monastic legislation and it became the standard of Western Christian monasticism. The mendicant orders, which combined monastic life with missionary work and preaching, were created in the 13th century. Scholarship was emphasized in some medieval monastic systems, which led to important religious research and manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monasticism"@en .

aat:300055992 a skos:Concept ;
    skos:definition "The religious ideology that there is only one god, as opposed to polytheism and pantheism. Whereas facets of earlier cultures, such as the Egyptians, worshipped one god, a full long-term doctrine of monotheism developed first within Judaism and it remains a central part of Judaism, Christianity, and Islam. Muslims and Jews think that Christianity's belief in the three aspects of God, the Holy Trinity, denies monotheism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monotheism"@en .

aat:300055993 a skos:Concept ;
    skos:definition "Refers to the religious beliefs and practices of religions outside of the so-called 'major' religions. Pagans are sometimes defined as those who are not Christian, Jewish, or Muslim; occasionally the term is more narrowly used to described any non-Christian, sometimes even Jews."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paganism"@en .

aat:300055995 a skos:Concept ;
    skos:definition "Religious ideology based on the belief that God and the universe are ultimately identical, and therefore only the divine is real and sense experience is not. Pantheism is an important element of Hinduism and some schools of Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantheism"@en .

aat:300055996 a skos:Concept ;
    skos:definition "A religious ideology originally developed within Lutheranism in the 17th and 18th centuries as a reform movement and reaction against rigid Protestant dogmatism. Pietism emphasizes good works, study of the Bible, and devotion. It came to influence other movements and ideologies such as evangelicalism, Methodism, and Moravian Brethren."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pietism"@en .

aat:300055997 a skos:Concept ;
    skos:definition "The religious ideology that there are many gods, as opposed to monotheism. Polytheism is characteristic of primitive religions as well as the religions of ancient Greece and Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polytheism"@en .

aat:300055998 a skos:Concept ;
    skos:definition "Refers generally to the belief that God only works in a person who is completely quiet and passive; religious followers should therefore withdraw from the everyday world and suppress their will. It also refers more specifically to forms of Christian mysticism, particularly to trends in the Middle Ages and 17th-century controversies in Spain and France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quietism"@en .

aat:300055999 a skos:Concept ;
    skos:definition "Refers generally to the religious practices of some northern Asian peoples who believe that good and evil spirits inhabit the world and can be summoned or heard through inspired priests acting as mediums. Shamanism is also found amongst the pre-Chrisitian Lapps, the Inuit, the Plains Indians of North America, some Australian Aborigines, and some other peoples. The term was originally used by the Tungus people of Siberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shamanism"@en .

aat:300056000 a skos:Concept ;
    skos:definition "Any religious or philosophic ideology based on mystical insight into the nature of God or divine truth. This insight is attained only through direct experience of the divine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theosophy"@en .

aat:300056002 a skos:Concept ;
    skos:definition "Complex of religious and social beliefs and practices whereby individuals or groups of people identify with or consider themselves to be in close kinship or spiritual affinity with a specific natural object or plant or animal species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "totemism"@en .

aat:300056003 a skos:Concept ;
    skos:definition "The doctrinal concept of the deliverance of man or his soul from evil or sin by religious means, the restoration of people to their true state, and the attainment of eternal and blessed life. God's intervention is responsible for salvation in theistic religions while in Buddhism salvation comes from escaping the cycle of birth and rebirth, thereby reaching nirvana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salvation"@en .

aat:300056004 a skos:Concept ;
    skos:definition "The doctrinal concept of divine manifestation, especially the appearance of a god to a human."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theophany"@en .

aat:300056005 a skos:Concept ;
    skos:definition "The reverent love and allegiance accorded a deity, idol, or sacred object, often expressed through ceremonies, prayers, or other religious rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worship"@en .

aat:300056006 a skos:Concept ;
    skos:definition "Concepts that are found in the sciences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific concepts"@en .

aat:300056007 a skos:Concept ;
    skos:definition "Generally, the capacity to do work; precisely, any quantity with dimensions that can be represented as mass times length squared divided by time squared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "energy"@en .

aat:300056015 a skos:Concept ;
    skos:definition "Includes both the quantity that is a measure of the amount of energy in a system not available for doing work, and the ultimate state in the degradation of matter and energy in the universe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entropy"@en .

aat:300056017 a skos:Concept ;
    skos:definition "Any interaction that, when unopposed, will change the motion of an object; force may be an agency or influence (as a push or pull) that, if applied to a free body, results chiefly in an acceleration of the body and sometimes in elastic deformation and other effects. Equations differ in ancient, pre-Newtonian, and Newtonian understandings of force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "force"@en .

aat:300056020 a skos:Concept ;
    skos:definition "Energy in the process of transfer between a system and its surroundings as a result of temperature differences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat"@en .

aat:300056021 a skos:Concept ;
    skos:definition "Transfer of heat from one point to another due to the tendency of heat to flow from an area of higher temperature to an area of lower temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat transmission"@en .

aat:300056024 a skos:Concept ;
    skos:definition "That portion of the electromagnetic spectrum visible to the human eye, having a wavelength in the range from about 4,000 (violet) to about 7,700 (red) angstroms and may be perceived by the normal unaided human eye. It ranges from the red end to the violet end of the spectrum, with wavelengths from 700 to 400 nanometres and frequencies from 4.3 x 1014 to 7.5 x 1014 Hz. Like all electromagnetic radiation, light travels through empty space at a speed of about 186,000 miles per second (300,000 km/sec). In the mid-19th century, light was described by James Clerk Maxwell in terms of electromagnetic waves, but 20th-century physicists have shown that it exhibits properties of particles as well; its carrier particle is the photon. Light is the basis for the sense of sight and for the perception of color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light"@en .

aat:300056026 a skos:Concept ;
    skos:definition "That portion of light that is deflected from a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflected light"@en .

aat:300056027 a skos:Concept ;
    skos:definition "The deflection from a straight path undergone by a light ray or energy wave when passing obliquely from one medium to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refraction"@en .

aat:300056028 a skos:Concept ;
    skos:definition "Use with reference to the direct light of the sun; for the light of day in general, use \"daylight.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunlight"@en .

aat:300056029 a skos:Concept ;
    skos:definition "Light that has passed through a material without being absorbed or reflected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmitted light"@en .

aat:300056030 a skos:Concept ;
    skos:definition "Energy-related concepts dealing with light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light-related concepts"@en .

aat:300056031 a skos:Concept ;
    skos:definition "Lacking or having very little light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darkness"@en .

aat:300056032 a skos:Concept ;
    skos:definition "Harsh, uncomfortably brilliant, usually reflected light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glare"@en .

aat:300056034 a skos:Concept ;
    skos:definition "The perceived result of rays of light turned back when they strike a surface and are not absorbed, as from a mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflections"@en .

aat:300056035 a skos:Concept ;
    skos:definition "Light diminished in intensity as a result of the interception of the rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shade"@en .

aat:300056036 a skos:Concept ;
    skos:definition "Areas of partial darkness produced by a body intercepting the direct rays of the sun or other luminary, so that radiation is unable to reach the darkened area directly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shadows"@en .

aat:300056039 a skos:Concept ;
    skos:definition "Action or process of one body passing from one place or position to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion"@en .

aat:300056040 a skos:Concept ;
    skos:definition "The rate at which the velocity of a body changes with time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acceleration"@en .

aat:300056041 a skos:Concept ;
    skos:definition "Force that tends to impel matter outward from a center of rotation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centrifugal force"@en .

aat:300056042 a skos:Concept ;
    skos:definition "Force that keeps an object moving in a circular path and that is directed inward toward the center of rotation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centripetal force"@en .

aat:300056043 a skos:Concept ;
    skos:definition "Property of matter by which it remains at rest or in uniform motion in the same straight line unless acted upon by some external force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inertia"@en .

aat:300056044 a skos:Concept ;
    skos:definition "Force of motion acquired by a moving body as a result of the continuance of its motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "momentum"@en .

aat:300056045 a skos:Concept ;
    skos:definition "The motion of a body about an internal axis of symmetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotation"@en .

aat:300056046 a skos:Concept ;
    skos:definition "The tendency of a force applied to an object to cause the object to rotate about a given point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torque"@en .

aat:300056047 a skos:Concept ;
    skos:definition "The time-rate at which any physical process takes place; a scalar quantity. For example, the rate at which an object covers distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speed"@en .

aat:300056048 a skos:Concept ;
    skos:definition "Exertion of force per unit area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure"@en .

aat:300056049 a skos:Concept ;
    skos:definition "Pressure that the air exerts on any surface in contact with it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air pressure"@en .

aat:300056050 a skos:Concept ;
    skos:definition "Pressure exerted in every direction at any given point by the weight of the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmospheric pressure"@en .

aat:300056051 a skos:Concept ;
    skos:definition "Pressure exerted by soil or other sub-surface material, as on a wall located below ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth pressure"@en .

aat:300056052 a skos:Concept ;
    skos:definition "The pressure exerted by a gas when it is in equilibrium with its liquid form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vapor pressure"@en .

aat:300056054 a skos:Concept ;
    skos:definition "The emission of energy or energy emitted in the form of electromagnetic waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electromagnetic radiation"@en .

aat:300056055 a skos:Concept ;
    skos:definition "The electromagnetic waves emitted by the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar radiation"@en .

aat:300056056 a skos:Concept ;
    skos:definition "Electromagnetic radiation with wavelength shorter than that of visible light and longer than that of x-rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet radiation"@en .

aat:300056058 a skos:Concept ;
    skos:definition "High energy radiation (from some keV to 110 keV) with very short wavelengths (0.001 - 10 nm). X-rays were discovered by Wilhelm Conrad Röntgen in 1895. They can pass through materials, ionize gases, and expose photographic film. Widely used in medical diagnosis and treatment and in many analytical techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray"@en .

aat:300056059 a skos:Concept ;
    skos:definition "Physics concepts dealing with the properties of sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustics concepts"@en .

aat:300056060 a skos:Concept ;
    skos:definition "Mechanical disturbance from a state of equilibrium that propagates energy through air, water, or another elastic medium. It is responsible for the sensation of hearing, although it also includes energy waves that cannot be heard by the human ear but can be detected by sonar equipment and other devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound"@en .

aat:300056063 a skos:Concept ;
    skos:definition "A packet of sound waves that has been reflected or otherwise returned with a sufficient delay and magnitude to be perceived as a signal distinct from the original transmission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "echo"@en .

aat:300056065 a skos:Concept ;
    skos:definition "The movement of acoustic energy, by wave motion, through a medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustic transmission"@en .

aat:300056066 a skos:Concept ;
    skos:definition "The degree of heat as measured on a relative scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperature"@en .

aat:300056069 a skos:Concept ;
    skos:definition "The general application of science and related disciplines, typically to commercial or industrial objectives, often with the implication of mechanical, electronic, or computerized components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technology"@en .

aat:300056083 a skos:Concept ;
    skos:definition "Concepts related to technical processes or knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technology-related concepts"@en .

aat:300056084 a skos:Concept ;
    skos:definition "Using or devising mechanical or electronic devices, processes, or systems which take the place of human effort, observation, or decision, and which require minimal human intervention in their operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automation"@en .

aat:300056087 a skos:Concept ;
    skos:definition "Selecting the quality standards required for a project, and monitoring the properties of the finished work to assure compliance with those standards. For the concept of inherent merit, worthiness, or excellence in the context of aesthetic judgment, use \"quality.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quality control"@en .

aat:300056088 a skos:Concept ;
    skos:definition "Establishing or bringing into conformity with standards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standardization"@en .

aat:300056090 a skos:Concept ;
    skos:definition "The effective working together of standardized independent units, especially in an electronic system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modular coordination"@en .

aat:300056095 a skos:Concept ;
    skos:definition "Allowable variations in any measurable property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tolerances"@en .

aat:300056100 a skos:Concept ;
    skos:definition "Physical forces that affect the motion or equilibrium of material bodies, in modern usage including both statics and kinetics. In earlier usage, dynamics was restricted to the action of force in producing or varying motion, and thus was opposed to statics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamics"@en .

aat:300056101 a skos:Concept ;
    skos:definition "The branch of science that deals with the properties of air and other gases in motion and the interaction between a gas and objects moving through it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerodynamics"@en .

aat:300056102 a skos:Concept ;
    skos:definition "A branch of dynamics concerning the relations between the motion of bodies and the forces acting upon them; it is opposed to \"statics,\" which treats of bodies in equilibrium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinetics"@en .

aat:300056104 a skos:Concept ;
    skos:definition "Discipline that arranges time into periods or divisions, and places events in the sequence in which they occurred, either at a defined point or period in time, or in relation to an established time sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronology"@en .

aat:300056108 a skos:Concept ;
    skos:definition "Artistic concepts that deal with creation of works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concepts relating to the creative process"@en .

aat:300056109 a skos:Concept ;
    skos:definition "Ascribing a work to a particular artist or school of artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attribution"@en .

aat:300056110 a skos:Concept ;
    skos:definition "Origin of a work of writing, music, or art; frequently used for the profession of writing itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authorship"@en .

aat:300056111 a skos:Concept ;
    skos:definition "Expertise, study, or knowledge in matters of taste and discrimination, particularly in relation to art, art objects, wines, or other delicacies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "connoisseurship"@en .

aat:300056112 a skos:Concept ;
    skos:definition "Skill of producing work of high quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craftsmanship"@en .

aat:300056113 a skos:Concept ;
    skos:definition "The quality of being creative; or the ability to use original ideas and imagination when thinking or producing work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creativity"@en .

aat:300056115 a skos:Concept ;
    skos:definition "The capacity to form or the state of forming mental images or ideas of people, objects, and situations that are not truly present to the senses, including both remembered and constructed ideas and images. In modern philosophy, imagination is the power or capacity by which the mind integrates sensory data in the process of perception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imagination"@en .

aat:300056119 a skos:Concept ;
    skos:definition "The quality of original and productive creativity. Use with reference specifically to art theory, especially during the Renaissance, to mean the selection and utilization of subject matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invention"@en .

aat:300056120 a skos:Concept ;
    skos:definition "A German word meaning 'art wish' that is used to refer to artistic intention."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kunstwollen"@en .

aat:300056123 a skos:Concept ;
    skos:definition "Characteristic attributed to freshness of aspect, design, or style; the power of independent thought or constructive imagination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "originality"@en .

aat:300056126 a skos:Concept ;
    skos:definition "Use to identify highly exceptional creative ability involving originality, imagination, the ability to think and work in areas previously unexplored or unconsidered; often used to characterize the ability to contribute something of value or use to society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genius"@en .

aat:300056128 a skos:Concept ;
    skos:definition "Standards of behavior, job performance, and work habits considered to be characteristic of professionals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professional standards"@en .

aat:300056145 a skos:Concept ;
    skos:definition "Phenomenon of visual perception which occurs when interlocking areas of contrasting colors are combined on the retina and perceived as a mixed color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assimilation"@en .

aat:300056147 a skos:Concept ;
    skos:definition "The percentage of light reflected by a given surface. The highest brightness value, 100%, is a brilliant white and 0% is black. When referring to the degree of lightness or darkness of a color, use \"value (color).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brightness"@en .

aat:300056148 a skos:Concept ;
    skos:definition "The technique of disguising the appearance of beings or things so as to make them blend into their surroundings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camouflage"@en .

aat:300056160 a skos:Concept ;
    skos:definition "The property or characteristic of a color regarding its position in the visible spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hue"@en .

aat:300056164 a skos:Concept ;
    skos:definition "The tendency of two colored surfaces that appear alike when viewed under one kind of light to differ from each other when viewed under another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metamerism"@en .

aat:300056166 a skos:Concept ;
    skos:definition "Includes the range of color which an artist uses, the typical color range of a school or group, or the range of colors possible when mixing a prescribed group of colorants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palette"@en .

aat:300056170 a skos:Concept ;
    skos:definition "The phenomenon through which the same color can reveal different hues, depending only on the colors surrounding it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simultaneous contrast"@en .

aat:300056171 a skos:Concept ;
    skos:definition "Generally an array of the components of an emission or wave separated and arranged in the order of some varying characteristic, as wavelength, mass, or energy. Specifically, the colored band into which a beam of light is decomposed by means of a prism or diffraction grating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectrum"@en .

aat:300056172 a skos:Concept ;
    skos:definition "Effect produced by slightly changing or adding a color to a thing, making the thing a lighter or darker shade of color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tint"@en .

aat:300056173 a skos:Concept ;
    skos:definition "The variation of color produced by changes in intensity or value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tone"@en .

aat:300056176 a skos:Concept ;
    skos:definition "The degree of lightness or darkness of a hue, white having the lightest value and black the darkest. When referring generally to the relative degree of lightness or darkness of a surface, use \"brightness.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "value"@en .

aat:300056179 a skos:Concept ;
    skos:definition "Movement and positioning of limbs, hands, or body as a means of intentional expression. For positioning of the body primarily for artistic effect, prefer \"pose.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gesture"@en .

aat:300056180 a skos:Concept ;
    skos:definition "The quality of being majestic, magnificent, splendid, stately, or imposing in an awe-inspiring way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandeur"@en .

aat:300056181 a skos:Concept ;
    skos:definition "Designation applied to artistic or literary material, produced to appeal to popular taste, and marked especially by sentimentalism, sensationalism, or slickness. For the related concept applied to taste, use \"camp.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitsch"@en .

aat:300056182 a skos:Concept ;
    skos:definition "Concept in art from the 20th century on, particularly architecture of the 1920s and 1930s, promoting virtues of machines, engineering principles and technology, and placing emphasis on clean, uncluttered forms thought to be characteristic of machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine aesthetic"@en .

aat:300056183 a skos:Concept ;
    skos:definition "Certain combinations of lines, colors, and spatial elements that excite pure aesthetic emotion; term coined by art critic Clive Bell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "significant form"@en .

aat:300056185 a skos:Concept ;
    skos:definition "Properties relating to the chemistry of a material or the body of a living being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical properties"@en .

aat:300056186 a skos:Concept ;
    skos:definition "The degree of acid content of a substance. Use particularly with reference to solutions having a pH value less than 7."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acidity"@en .

aat:300056187 a skos:Concept ;
    skos:definition "The extent to which one substance will dissolve into another, usually specified, substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solubility"@en .

aat:300056190 a skos:Concept ;
    skos:definition "The ease with which an electrical current will pass through a material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical conductivity"@en .

aat:300056191 a skos:Concept ;
    skos:definition "The characteristics of a material or object that concern its degree of magnetism and the magnetic phenomena it evinces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic properties"@en .

aat:300056192 a skos:Concept ;
    skos:definition "Properties that involve relationships between stress and strain or that involve reactions to applied forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical properties"@en .

aat:300056193 a skos:Concept ;
    skos:definition "The property of being hard and rigid with little tensile strength, tending to break readily with a comparatively smooth fracture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brittleness"@en .

aat:300056194 a skos:Concept ;
    skos:definition "Property by which a decrease of volume results when an external pressure is applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compressibility"@en .

aat:300056195 a skos:Concept ;
    skos:definition "The property of being permanently deformed by tension without rupture, that is, the ability to be drawn from a large to a small size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ductility"@en .

aat:300056196 a skos:Concept ;
    skos:definition "The capability of a strained substance or body to recover its size and shape after deformation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elasticity"@en .

aat:300056197 a skos:Concept ;
    skos:definition "Property of being capable of deformation by compression without rupture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malleability"@en .

aat:300056198 a skos:Concept ;
    skos:definition "The three-dimensional quality of a form, its roundness, palpability, apparent solidity, or quality of relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasticity"@en .

aat:300056199 a skos:Concept ;
    skos:definition "The property of being firm or devoid of flexibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigidity"@en .

aat:300056200 a skos:Concept ;
    skos:definition "The material property which is measured by the rate at which the stress in a material increases with strain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stiffness"@en .

aat:300056201 a skos:Concept ;
    skos:definition "The ability of materials to resist stress without yielding or fracture, especially as described by the stress level at which it fractures or fails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strength of materials"@en .

aat:300056202 a skos:Concept ;
    skos:definition "Ability of a material, usually in sheet form, to withstand hydrostatic pressure without rupture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bursting strength"@en .

aat:300056204 a skos:Concept ;
    skos:definition "Highest stress that a material can withstand for a given number of cycles without breaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fatigue strength"@en .

aat:300056205 a skos:Concept ;
    skos:definition "Resistance of a material to fracture by a blow expressed in terms of amount of energy absorbed before fracture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impact strength"@en .

aat:300056206 a skos:Concept ;
    skos:definition "The maximum pulling or ductile stress that a material can be subjected too without breakage. It is usually measured by taking a bar of the material and stretching it to destruction. The ultimate tensile strength is the maximum load divided by the bar's cross-sectional area and is measured in newtons per square meter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tensile strength"@en .

aat:300056207 a skos:Concept ;
    skos:definition "The stress, calculated on the maximum value of the force and the original area of cross section, which causes fracture of the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultimate strength"@en .

aat:300056210 a skos:Concept ;
    skos:definition "The properties of light and its interaction with matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical properties"@en .

aat:300056211 a skos:Concept ;
    skos:definition "Emission of electromagnetic radiation, usually visible light, caused by excitation of atoms in a material, which then reemit almost immediately. The initial excitation is usually caused by absorption of energy from incident radiation or particles, such as X-rays or electrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescence"@en .

aat:300056212 a skos:Concept ;
    skos:definition "Optical property in which fine colors are produced on a surface by the interference of light that is reflected from both the front and back of a thin film. Things that appear iridescent show rainbow-like luminous colors, and often change color as their positions change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iridescence"@en .

aat:300056213 a skos:Concept ;
    skos:definition "Quality or state of exhibiting a milky iridescence like that of an opal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opalescence"@en .

aat:300056214 a skos:Concept ;
    skos:definition "Emission of light through a means other than heat, as contrasted to light emitted from incandescent bodies, such as burning wood or molten iron. Luminescence may be seen in neon and fluorescent lamps, television, radar, in organic substances such as luminol or the luciferins in fireflies and glowworms, and in natural electrical phenomena such as lightning and the aurora borealis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luminescence"@en .

aat:300056215 a skos:Concept ;
    skos:definition "The glow or emission of light produced by the application of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoluminescence"@en .

aat:300056216 a skos:Concept ;
    skos:definition "The quality or state of a substance or body of being impervious to rays of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opacity"@en .

aat:300056217 a skos:Concept ;
    skos:definition "The ability of a paint, varnish, or other medium to completely hide or cover a surface, often in one coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covering power"@en .

aat:300056218 a skos:Concept ;
    skos:definition "Light emission that follows the absorption of energy by a substance from sources such as visible light, infrared light, ultraviolet light, electricity, cathode rays or x-rays, and that continues for a relatively long time after the energy supply has ceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphorescence"@en .

aat:300056219 a skos:Concept ;
    skos:definition "The quality or state of a substance or body of transmitting light, but without allowing clear visibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "translucency"@en .

aat:300056220 a skos:Concept ;
    skos:definition "The quality or state of a substance or body of transmitting light without appreciable scattering so that things lying beyond are entirely visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparency"@en .

aat:300056222 a skos:Concept ;
    skos:definition "Property of porous material which is measured by the rate by volume at which a fluid passes through a cross section of the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permeability"@en .

aat:300056223 a skos:Concept ;
    skos:definition "The extent to which gases, liquids, or plant roots penetrate into or pass through a layer of soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil permeability"@en .

aat:300056224 a skos:Concept ;
    skos:definition "The ratio of the volume of the interstices of a material to the volume of its mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porosity"@en .

aat:300056226 a skos:Concept ;
    skos:definition "The temperature at which liquid comes to a boil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boiling point"@en .

aat:300056227 a skos:Concept ;
    skos:definition "The lowest temperature at which vapors from a volatile liquid will ignite instantaneously upon the application of a small flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash point"@en .

aat:300056230 a skos:Concept ;
    skos:definition "Temperature at which a solid begins to liquify."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melting point"@en .

aat:300056232 a skos:Concept ;
    skos:definition "The number of calories required to raise 1 gram of a material 1 degree Celsius in temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specific heat"@en .

aat:300056235 a skos:Concept ;
    skos:definition "The maximum percentage of acid that a material, such as paper or leather, is capable of absorbing without deteriorating with time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid resistance"@en .

aat:300056237 a skos:Concept ;
    skos:definition "The distribution of something per unit area; can be, for example, the measure of the mass of a substance per unit volume, or the number of dwelling units per acre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "density"@en .

aat:300056238 a skos:Concept ;
    skos:definition "The ratio of the mass of a given volume of a substance to the mass of the same volume of water at 4 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specific gravity"@en .

aat:300056240 a skos:Concept ;
    skos:definition "Measurement of the relative heaviness of an object or other body; the force with which a body is attracted toward the earth or a celestial body by gravity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight"@en .

aat:300056246 a skos:Concept ;
    skos:definition "The use of similar forms around a center of balance. The forms may give a feeling of equal relationships, but are varied to prevent visual monotony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "approximate symmetry"@en .

aat:300056247 a skos:Concept ;
    skos:definition "The impression of visual equilibrium in a composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balance"@en .

aat:300056252 a skos:Concept ;
    skos:definition "Arrangement of forms in which three or more forces, which are similar in visual strength and character, are distributed around a center point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radial symmetry"@en .

aat:300056254 a skos:Concept ;
    skos:definition "As an artistic concept, the state or quality of having many intricate or interrelated parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "complexity"@en .

aat:300056255 a skos:Concept ;
    skos:definition "Structure or arrangement of the internal elements of a work of art, such as a drawing, sculpture, or written or musical work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition"@en .

aat:300056257 a skos:Concept ;
    skos:definition "The process of embellishing architecture, furniture, or other objects. In reference to specific forms of decoration, such as fluting, finials, or monograms, that embellish and are part of the building or object, but are not structurally essential to it, use \"ornaments\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decoration"@en .

aat:300056260 a skos:Concept ;
    skos:definition "A lack of symmetry or proper relation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disproportion"@en .

aat:300056261 a skos:Concept ;
    skos:definition "Doctrine that the universe is under the dominion of two opposing principles, one of which is good and the other evil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dualism"@en .

aat:300056263 a skos:Concept ;
    skos:definition "The outer boundary of an object or shape, especially when it suggests volume or mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contour"@en .

aat:300056265 a skos:Concept ;
    skos:definition "Term used to describe soft, delicate and often exaggerated blending in oil paint, particularly when applied to flesh tones; art historical term used primarily in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morbidezza"@en .

aat:300056267 a skos:Concept ;
    skos:definition "Suites of apartments with doorways placed opposite to each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enfilades"@en .

aat:300056268 a skos:Concept ;
    skos:definition "The gently swelling convex curvature along the line of taper of columns, made to prevent the illusion of concavity in straight or regularly tapered columns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entasis"@en .

aat:300056269 a skos:Concept ;
    skos:definition "In an image, the way in which an object or shape is related to the background against which it is seen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figure-ground perception"@en .

aat:300056272 a skos:Concept ;
    skos:definition "Use with reference to works of art and architecture regarding the design of visual elements such as line, mass, shape, or color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "form"@en .

aat:300056273 a skos:Concept ;
    skos:definition "The outline, form, or characteristic configuration of an object, including its contours; the external form or outer boundary of the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shape"@en .

aat:300056274 a skos:Concept ;
    skos:definition "The quality possessed by a sculpture, building, or other structure that is designed to be viewed from directly in front; in pictorial compositions, the quality possessed by figures that face directly out of the picture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontality"@en .

aat:300056276 a skos:Concept ;
    skos:definition "In art, refers generally to a pleasing, orderly, and consistent arrangement of the parts of a whole. The concept of aesthetic description in which architectural proportion or artistic design displays congruity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmony"@en .

aat:300056279 a skos:Concept ;
    skos:definition "In mathematics, the trace of a moving point in continuous extent, either straight or curved, having length but without breadth or thickness. In geometry, the concept of a line can vary with the definition of geometry; for example in analytic geometry, a line is the set of points on a plane having coordinates that satisfy a given linear equation; in incidence geometry, a line may be an independent object distinct from the set of points which lie on it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lines"@en .

aat:300056287 a skos:Concept ;
    skos:definition "The reliance on line for the principal effect in a drawn or painted composition, rather than on color or tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linearity"@en .

aat:300056288 a skos:Concept ;
    skos:definition "Describes the relationship between various masses or volumes of a building or structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "massing"@en .

aat:300056295 a skos:Concept ;
    skos:definition "Describes an enclosed empty space in architecture, sculpture, or painting which makes an essential contribution to the composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negative space"@en .

aat:300056297 a skos:Concept ;
    skos:definition "The relative position of something, usually as regarding relative direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orientation"@en .

aat:300056299 a skos:Concept ;
    skos:definition "Relation between respective parts or between parts and the whole, in a building or any work of art, whether considered purely visually or numerically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proportion"@en .

aat:300056300 a skos:Concept ;
    skos:definition "Canon of proportion based on the ratio between two unequal parts of a whole when the proportion of the smaller to the larger is equal to that of the larger to the whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golden section"@en .

aat:300056305 a skos:Concept ;
    skos:definition "In art, a flow or sense of movement achieved by repetition of regular or patterned units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhythm"@en .

aat:300056307 a skos:Concept ;
    skos:definition "An expression of the ratio between the size of the representation of something and that thing, such as the size of the drawn structure in an architectural drawing and the actual built work. May also refer in general to the concept of relative size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scale"@en .

aat:300056309 a skos:Concept ;
    skos:definition "Describes the impression of grandeur, nobility, permanence, and often, though not necessarily, size in a work of art or structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumentality"@en .

aat:300056311 a skos:Concept ;
    skos:definition "As an artistic concept, the absence of intricacy or excessive ornament in form, structure, or appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simplicity"@en .

aat:300056315 a skos:Concept ;
    skos:definition "The lengths of lot lines or building sites adjacent to a street or other public way, or to a body of water forming a boundary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontages"@en .

aat:300056316 a skos:Concept ;
    skos:definition "Real estate development which aims to maintain the character of an older area by adding new buildings that are architecturally similar to those already there. For the insertion of material to fill a hole or area of loss, see \"filling.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infill"@en .

aat:300056324 a skos:Concept ;
    skos:definition "As an artistic concept, the appearance or condition of oneness or wholeness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unity"@en .

aat:300056325 a skos:Concept ;
    skos:definition "Parallel relationships to a vertical axis in designs for graphic works, objects, and structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verticality"@en .

aat:300056327 a skos:Concept ;
    skos:definition "Visual sensation occurring after the external cause has disappeared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "afterimages"@en .

aat:300056330 a skos:Concept ;
    skos:definition "Pictorial narrative device featuring two or more successive actions from the same story or related stories within one setting. Term may be confused with \"simultaneous representation,\" which has to do with point of view, not with sequential episodes depicted in one scene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous narration"@en .

aat:300056331 a skos:Concept ;
    skos:definition "Range of distances, near and far, within which objects appear in sharp focus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depth of field"@en .

aat:300056332 a skos:Concept ;
    skos:definition "The quality or state in a painting or of an object due to the use of optical illusions, manipulated surfaces, or discordantly juxtaposed images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distortion"@en .

aat:300056335 a skos:Concept ;
    skos:definition "Deceptive visual phenomena induced by the refraction of light as it passes through one substance to another or by atmospheric conditions that manipulate light rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical illusion"@en .

aat:300056336 a skos:Concept ;
    skos:definition "Visual phenomena derived from the French word for 'watered' that is produced when a set of straight or curved lines spaced equally apart is superimposed onto another set at a particular angle, resulting in a distinct geometrical design; used to represent and identify fluid flow, wave motion, and optic and magnetic field patterns and flows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moiré effect"@en .

aat:300056338 a skos:Concept ;
    skos:definition "The small variation in the form of an architectural member in order to correct an apparent bulge or sag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical correction"@en .

aat:300056339 a skos:Concept ;
    skos:definition "Meaning \"from below upwards\" in Italian, refers to distinctive representations, generally in two-dimensional art, in which foreshortening is employed to create the realistic effect of architecture, figures, and objects being seen from a point of view below the art work, as opposed to a point of view opposite the work of art. It was used to some extent in ancient Roman mural paintings, but is most often seen in Western art dating from the Renaissance forward. It was typically used in ceiling paintings, wall paintings placed high on a wall, and other paintings or bas-reliefs meant to be seen from below. Some, but not all, \"di sotto in su\" depicitions may be drawn from a \"worm's-eye view,\" which is drawn as if the viewer is lying on the floor and looking upward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sotto in sù"@en .

aat:300056340 a skos:Concept ;
    skos:definition "Refers to any graphic method concerned with conveying an impression of depth, usually on a two-dimensional surface, by means of geometric projection using one or more vanishing points, foreshortening, and/or atmospheric effects. Techniques include receding lines, gradients of color, tone and texture, and degrees of clarity. In Western art, the term generally refers to the geometrical technique of linear perspective that was invented in the early Renaissance, based on ancient Greek and Roman models. Although its meaning overlaps somewhat with \"projection,\" \"projection\" is typically used for technical and architectural drawings that emphasize the mathematical properties of objects that are preserved in the images; \"perspective\" is used for art works and renderings that include the distortions of lengths, angles, shapes, and straightness of lines that optically appear to occur as objects recede into space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perspective"@en .

aat:300056345 a skos:Concept ;
    skos:definition "The area or feature of a composition, whether pictorial, sculptural, or architectural, to which the eye is especially drawn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "focal point"@en .

aat:300056348 a skos:Concept ;
    skos:definition "Refers to the system of perspective in which orthogonals converge toward one or more vanishing points. In Western art, the term often refers to the system of one-point perspective that was developed in the Italian Renaissance, but based on ancient Greek and Roman models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear perspective"@en .

aat:300056351 a skos:Concept ;
    skos:definition "Lines that define an unimpeded field of vision,(RHDEL2) as within rooms or open spaces or along city streets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sight lines"@en .

aat:300056353 a skos:Concept ;
    skos:definition "Representation of an object, person, or structure in such a way that its most essential features are all seen in one view without regard to perspective or a single point of view. For visual works containing subjects depicting sequential episodes in one scene, use \"continuous narration.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simultaneous representation"@en .

aat:300056361 a skos:Concept ;
    skos:definition "Surface characteristics perceptible by touch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tactile values"@en .

aat:300056362 a skos:Concept ;
    skos:definition "Tactile surface characteristics. For the visual characteristics of an artistic composition, use \"texture (visual characteristics).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "texture"@en .

aat:300056363 a skos:Concept ;
    skos:definition "The quality of having a surface diversified with small projections, points, and irregularities so as to be harsh or uneven to the sight or touch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roughness"@en .

aat:300056364 a skos:Concept ;
    skos:definition "The quality of having a surface free from projections, irregularities, or inequalities, presenting no roughness or unevenness to the touch or sight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoothness"@en .

aat:300056365 a skos:Concept ;
    skos:definition "Imagined or real point in space from which a viewer of an art work would look at an object or visual field. Compositions and perspectival systems in works of Western art are often designed with the viewer's point of view in mind. The meaning overlaps with \"station point,\" although \"station point\" is more often used in reference to perspectival conventions of architectural drawings, while \"viewpoint\" is used to refer to all art forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viewpoint"@en .

aat:300056367 a skos:Concept ;
    skos:definition "That part of a pictorial composition that appears to be closest to the viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foreground"@en .

aat:300056368 a skos:Concept ;
    skos:definition "In pictorial arts, that part of the composition between the foreground and the background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle ground"@en .

aat:300056369 a skos:Concept ;
    skos:definition "The surface or part of a composition that appears to be farthest from the viewer and against which represented objects or forms are perceived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "background"@en .

aat:300056375 a skos:Concept ;
    skos:definition "Quality of being able to change or be changed so as to suit new circumstances or function in a new role or capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adaptability"@en .

aat:300056377 a skos:Concept ;
    skos:definition "A continuous flow of space linking the parts of a building or buildings, or through any series of interior or exterior spaces. Used often with reference to traffic patterns through areas or buildings, including the means of travel through a building, such as doors, corridors, stairs, or elevators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circulation"@en .

aat:300056381 a skos:Concept ;
    skos:definition "The functions involved with producing or maintaining certain humidity levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humidity control"@en .

aat:300056385 a skos:Concept ;
    skos:definition "Real property held and occupied by two or more persons in undivided equal shares with the right of survivorship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint tenancy"@en .

aat:300056387 a skos:Concept ;
    skos:definition "The state of being apart from company or observation, generally in voluntary seclusion. Also refers to the right to freedom from unauthorized intrusion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "privacy"@en .

aat:300056390 a skos:Concept ;
    skos:definition "The safekeeping of objects or materials in a depository, such as a warehouse or cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage"@en .

aat:300056392 a skos:Concept ;
    skos:definition "The conversion of outmoded or unused things, often things having historic value, to new uses or application in new contexts. Examples include reuse of buildings, objects, software, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adaptive reuse"@en .

aat:300056398 a skos:Concept ;
    skos:definition "Forces carried by a structure, or part of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loads"@en .

aat:300056400 a skos:Concept ;
    skos:definition "Loads or forces acting through the center of gravity of the section of structural members, therefore perpendicular to the plane of the section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axial loads"@en .

aat:300056402 a skos:Concept ;
    skos:definition "Two or more different types of loads (such as dead load, live load, or wind load) occurring simultaneously on a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combined loads"@en .

aat:300056404 a skos:Concept ;
    skos:definition "Loads acting on a very small area of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concentrated loads"@en .

aat:300056405 a skos:Concept ;
    skos:definition "The loads to which a structure is subjected during construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction loads"@en .

aat:300056406 a skos:Concept ;
    skos:definition "A load that is diffused over a large area of a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distributed loads"@en .

aat:300056407 a skos:Concept ;
    skos:definition "Dynamic loads created in a structure caused by the rapid movement of structural members due to seismic vibrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthquake loads"@en .

aat:300056408 a skos:Concept ;
    skos:definition "Load on a column or pile which is nonsymmetric with respect to the central axis, therefore producing a bending moment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eccentric loads"@en .

aat:300056411 a skos:Concept ;
    skos:definition "The dynamic effect on a structure, either moving or at rest, of a forcible momentary contact with another moving body; also, a mathematical fraction of a calculated live load used to account for additional stresses resulting from movement of that load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impact loads"@en .

aat:300056412 a skos:Concept ;
    skos:definition "Load applied horizontally owing to wind pressure or seismic blast effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lateral loads"@en .

aat:300056413 a skos:Concept ;
    skos:definition "Structural loads that move."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving loads"@en .

aat:300056416 a skos:Concept ;
    skos:definition "The live loads allowed by local building code, used to design roofs in areas subject to snowfall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow loads"@en .

aat:300056421 a skos:Concept ;
    skos:definition "The force of the flows of vehicles, persons or objects along a specified route that is supported by a structure or body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic loads"@en .

aat:300056422 a skos:Concept ;
    skos:definition "Uniformly distributed loads over part of or the whole of a length or surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uniform loads"@en .

aat:300056423 a skos:Concept ;
    skos:definition "The imposed force of pressure by air in motion that is supported by a structure or body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind loads"@en .

aat:300056427 a skos:Concept ;
    skos:definition "Constant loads in structures that are due to the combined weight of its members, the supported structures, and permanent attachments or accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dead loads"@en .

aat:300056429 a skos:Concept ;
    skos:definition "Structural loads that fluctuate in strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "live loads"@en .

aat:300056431 a skos:Concept ;
    skos:definition "Gradual subsidence of structures, caused by the compression of soil below foundation level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settlement of structures"@en .

aat:300056433 a skos:Concept ;
    skos:definition "The distance between the supports of a transverse structural member or between the abutments of an arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "span"@en .

aat:300056434 a skos:Concept ;
    skos:definition "Resultant condition of applied force; condition existing in a body when its internal structure or surfaces resist a force that produces or tends to produce deformation in the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stress"@en .

aat:300056435 a skos:Concept ;
    skos:definition "The overloading or overstraining of structures to such an extent that they can no longer perform their required functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural failures"@en .

aat:300056436 a skos:Concept ;
    skos:definition "The overloading or overstraining of bridges to such an extent that they can no longer perform their required functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridge failures"@en .

aat:300056438 a skos:Concept ;
    skos:definition "The ability of a structure to maintain its intended position and orientation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural stability"@en .

aat:300056445 a skos:Concept ;
    skos:definition "Categories of architecture that are characterized by form or content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architecture genres"@en .

aat:300056446 a skos:Concept ;
    skos:definition "Conforming to the architectural theories of the European and American academies of architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic architecture"@en .

aat:300056452 a skos:Concept ;
    skos:definition "A philosophy of architectural design, emerging in the early 20th century, asserting that in structure and appearance a building should be based on organic forms and should harmonize with its natural environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic architecture"@en .

aat:300056460 a skos:Concept ;
    skos:definition "An outdated designation formerly used for the architecture of certain people considered to be outside the spheres of influence of other, politically dominant cultural groups; was used especially concerning communities in sub-Saharan Africa, the Pacific Islands, and native tribal groups throughout the Americas. Use instead other terms, such as \"vernacular architecture,\" or use the most specific name known for the culture of origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primitive architecture"@en .

aat:300056462 a skos:Concept ;
    skos:definition "Categories of art that are characterized by form or content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art genres"@en .

aat:300056465 a skos:Concept ;
    skos:definition "Conforming to the official standards and principles of taste of European and American art academies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic art"@en .

aat:300056469 a skos:Concept ;
    skos:definition "Any art which deals with the final doom or ultimate destiny of the world, including that in the Biblical story of Armageddon in the Book of Revelations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apocalyptic art"@en .

aat:300056472 a skos:Concept ;
    skos:definition "Refers to art created or collected according to a philosophy of avoidance of the conventional fine art tradition. The concept generally refers to art that fits the ideal described by Jean Dubuffet, who posited that art should be inventive, non-conformist, unprocessed, spontaneous, insulated from all social and cultural influences, \"brut,\" created without thought of financial gain or public recognition, and based upon autonomous inspiration, in direct contrast to the stereotypes of the traditional or official artistic culture. Dubuffet sought such art in the work of psychiatric patients and other insulated individuals. It is generally distinct from \"naive art,\" which is created by those without formal training, but not necessarily in accordance with the principles described above. It is also typically distinct from \"folk art,\" which is made according to the rules and traditions of a particular culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outsider art"@en .

aat:300056475 a skos:Concept ;
    skos:definition "Art utilizing photography, graphic design, or other art forms to design logos, advertisements, illustrations, books, brochures, signs, posters, animation, Web pages, or other displays to promote sale or acceptance of products, services, or ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial art"@en .

aat:300056476 a skos:Concept ;
    skos:definition "Includes art undertaken in conjunction with particular communities, often socially deprived, usually with the idea of producing an effect or inspiring response specifically within those communities, with no reference to widely established standards. For art intended to beautify and enrich public places, use \"public art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community art"@en .

aat:300056477 a skos:Concept ;
    skos:definition "Contemporary outdoor paintings, drawings, or three-dimensional works on walls, sidewalks, or street surfaces in public thoroughfares of urban environments, sometimes intended to draw attention to urban issues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street art"@en .

aat:300056478 a skos:Concept ;
    skos:definition "Includes both art created by court artists and art produced for a royal court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court art"@en .

aat:300056485 a skos:Concept ;
    skos:definition "Art, generally pictorial rather than sculptural, that depicts the unreal in a realistic manner. Works of 'fantastic art' may use Biblical, allegorical, or symbolic subject matter as departure points. The term is used to describe the work of artists from many periods and countries, but, most often, products of art tradition in Europe and the post-Columbian Americas. The term is not used for works from Medieval Europe, nor Oceanic or Asiatic cultures before the 20th century. While works from these latter cultures may exhibit depictions of the monstrous, mythological, or the unseen world, they lack the elements of eccentricity and willfull grotesquery that are hallmarks of the 'fantastic.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fantastic art"@en .

aat:300056487 a skos:Concept ;
    skos:definition "Art and crafts that exist outside the received canons of taste established by academic art, that are produced in culturally cohesive communities or contexts, and that are guided by local traditional rules or procedures. Included are paintings, ceramics, textiles, sculpture, and other art forms. It is generally distinct from \"naive art,\" which is created by those without formal training, but not necessarily within a cohesive cultural community. It is also distinct from \"outsider art,\" which usually refers specifically to art created or collected according to a philosophy of avoidance of traditional training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folk art"@en .

aat:300056488 a skos:Concept ;
    skos:definition "Art produced for rituals commemorating the dead and for art produced as an individual expression of grief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary art"@en .

aat:300056496 a skos:Concept ;
    skos:definition "Art produced by children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's art"@en .

aat:300056499 a skos:Concept ;
    skos:definition "Art that portrays forms recognizably derived from objective sources, in however altered or distorted form. Includes but not limited to representations of the human figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figurative art"@en .

aat:300056500 a skos:Concept ;
    skos:definition "An outdated designation formerly used for the art of certain people considered to be outside the spheres of influence of other, politically dominant cultural groups; was used especially concerning communities in sub-Saharan Africa, the Pacific Islands, and native tribal groups throughout the Americas. Use instead \"indigenous art,\" \"tribal art,\" or the most specific name known for the culture of origin. Distinct from \"primitivism,\" a term sometimes used for artistic styles or movements intended, often romantically or sentimentally, to emulate the appearance of art made by people operating outside of mainstream art markets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primitive art"@en .

aat:300056501 a skos:Concept ;
    skos:definition "Art and architectural elements having the purpose of beautifying and enriching public places rather than private spaces, whether or not the works are also functional. For art undertaken in conjunction with particular communities, usually to produce an effect or inspire response specifically within those communities, use \"community art.\" For art associated with urban design, planning, and preservation, use \"municipal art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public art"@en .

aat:300056506 a skos:Concept ;
    skos:definition "French term meaning \"deceive the eye,\" applied to images so realistic that they may fool the viewer into thinking that the represented objects, scenes, textures, or points of view are real rather than images. The term is generally used to refer to Western art, generally to two-dimensional art or bas-relief. It was seen in ancient Greek art, refined by the ancient Romans, and was popular in the Renaissance and later in Europe and America. Effects include painted textures of wood or marble on walls or columns, realistic portrayals of views framed by painted faux windows, false frames from which the contents of a still life or portrait appear to extend into the viewer's space, and depictions of shelves or cupboards with various articles seen through half-open doors. In the late 20th century, the exteriors of entire buildings have been painted in trompe l'oeil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trompe-l'oeil"@en .

aat:300056508 a skos:Concept ;
    skos:definition "Refers to a concept or idea not associated with any specific instance, and to the process of formulating general concepts by abstracting common properties of instances. It includes the consideration of a thing independently of its associations; or a substance independently of its attributes; or an attribute or quality independently of the substance to which it belongs. It is the idea of something that has no independent existence; a thing which exists only as an idea. For the modern art movement and its products, use \"Abstract.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abstraction"@en .

aat:300056509 a skos:Concept ;
    skos:definition "Characterized by the use of simple geometric forms placed in nonillusionistic space and combined into nonobjective compositions, geometric abstraction evolved as the logical conclusion of the Cubist destruction and reformulation of the established conventions of form and space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometric abstraction"@en .

aat:300056510 a skos:Concept ;
    skos:definition "Refers to certain works that continued Abstract Expressionism into the 1960s and 1970s (e.g., by Guston, Frankenthaler). For the French painting of the late 1940s sometimes called Abstraction Lyrique, use \"Tachiste.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lyrical Abstraction"@en .

aat:300056511 a skos:Concept ;
    skos:definition "Term coined by the architectural historian Charles Jencks to describe design which comes about, not by formulating new solutions to problems, but by combining pre-existing elements to achieve a new result."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhocism"@en .

aat:300056513 a skos:Concept ;
    skos:definition "Includes any manifestation of the material culture of classical Greece and Rome. With reference to the period of late 18th- and 19th-century art and architecture which featured a return to classical principles, use \"Neoclassical.\" With reference to the period of architecture and ornament of the late 18th- to early 20th-century based relatively closely on ancient classical forms, use \"Classical Revival.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classicism"@en .

aat:300056522 a skos:Concept ;
    skos:definition "Approach or practice of selecting the best elements from different doctrines, methods, or styles to apply them in a new creation. In the specific context of art or architectural criticism, use to mean borrowing from a variety of visual sources in the creation of a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eclecticism"@en .

aat:300056528 a skos:Concept ;
    skos:definition "Use when referring to the critical attitude which places emphasis on analysis of form and the use of formal elements rather than on context or content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formalism"@en .

aat:300056529 a skos:Concept ;
    skos:definition "Doctrine or practice that emphasizes practical utility or functional relations in the design and construction of structures, objects, and systems. Use also when referring to the contemporary design philosophy, relating chiefly to architecture and furnishings, holding that form should be adapted to use, material, and structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "functionalism"@en .

aat:300056536 a skos:Concept ;
    skos:definition "Refers to pictorial techniques such as perspective and foreshortening to deceive the eye into taking that which is depicted for that which is real."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illusionism"@en .

aat:300056541 a skos:Concept ;
    skos:definition "Refers to the satirical movement that developed in German painting in the early 1920s and continued until the rise of National Socialism in the 1930s. Reacting to the violence of World War I, the style is characterized by a rejection of Expressionism and an emphasis on close observation of objects; social criticism; cold, static, figures; and sometimes naive styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neue Sachlichkeit"@en .

aat:300056542 a skos:Concept ;
    skos:definition "Includes references to or interest in hidden, mysterious, or supernatural powers, as manifested in all fields of human endeavor or creativity. Excludes occult sciences themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occultism"@en .

aat:300056548 a skos:Concept ;
    skos:definition "A term sometimes used for artistic styles or movements intended, often romantically or sentimentally, to emulate the appearance of art that was formerly designated primitive and other art made by people operating outside of mainstream art markets. Distinct from \"primitive art\" and \"primitive architecture,\" which are outdated terms formerly used for art and architecture of certain people considered to be outside the spheres of influence of other, politically dominant cultural groups. For the Russian art movement, active from about 1905 to 1920, which combined influences from Russian folk art with ideas borrowed from Cubism and Futurism, use \"Primitivist.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primitivism"@en .

aat:300056550 a skos:Concept ;
    skos:definition "General term for a quality of art works in which the depiction is based on or seems to be based on the direct observation of the external world, including or even emphasizing flaws and imperfections rather than the beauty or idealized characteristics. Although a work may be both realistic and naturalistic, naturalism may somewhat idealize the flaws or ugliness of the subject depicted. For the formal style and period displaying the general characteristics of realism, such as in the painting of Gustave Courbet, use \"Realist (modern European fine arts styles).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "realism"@en .

aat:300056554 a skos:Concept ;
    skos:definition "Extreme form of realism that repudiates idealization, nobility, and heroism in visual art, literature, and theater, aiming to reproduce exact descriptions or appearances of even repugnant subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verism"@en .

aat:300056555 a skos:Concept ;
    skos:definition "Self-conscious use of earlier styles in new works of visual art, architecture, literature, or theatre, on a scale broader than quotations or pastiches, generally to the point of an artistic movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revival"@en .

aat:300056557 a skos:Concept ;
    skos:definition "Refers to the approach to visual art, literature, theater, and music that emphasizes the emotional, dramatic, or exotic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "romanticism"@en .

aat:300056558 a skos:Concept ;
    skos:definition "Describes the interest in, or passion for, the Middle Ages, beginning in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medievalism"@en .

aat:300060022 a skos:Concept ;
    skos:definition "Architectural and interior design popular in Europe and North America in the 1970s. In architecture, the style is characterized by the use of sleek lines, space-age materials, and pre-fabricated parts, with the purpose of exploring the limits of technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High-Tech"@en .

aat:300060037 a skos:Concept ;
    skos:definition "Refers to the various styles of English porcelain and earthenware produced by Thomas Minton in Staffordshire beginning in 1793: majolica, Parian ware, Palissy ware, and blue printed earthenware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minton"@en .

aat:300060056 a skos:Concept ;
    skos:definition "Devices or small structures, either freestanding or attached to trees or buildings, designed to hold and dispense feed such as seeds, suets, and sugar water, for feral birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird feeders"@en .

aat:300060244 a skos:Concept ;
    skos:definition "Sets of information describing the contents, format, and structure of a database and the relationship between its elements, used to control access to and manipulation of the database."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data dictionaries"@en .

aat:300060248 a skos:Concept ;
    skos:definition "Documents used in making preliminary plans, auxiliary computations, notes, or comments as a guide in doing some piece of work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worksheets"@en .

aat:300060257 a skos:Concept ;
    skos:definition "Heavy-duty digging, hauling, and grading machinery having a cutting edge, a carrying bowl, a movable front wall or apron, and a dumping or ejecting mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrapers"@en .

aat:300060368 a skos:Concept ;
    skos:definition "Reconciliation or union of conflicting (as religious) beliefs or an effort intending such."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syncretism"@en .

aat:300060417 a skos:Concept ;
    skos:definition "Separate treatises on a particular subject, typically written expositions of a subject narrow enough in scope to exclude all but a single aspect of the subject, for example, a study of the works of a single artist. In book cataloging, non-serial bibliographic items complete in one part or in a finite number of separate parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monographs"@en .

aat:300060422 a skos:Concept ;
    skos:definition "All the writings of an author, including those which have not been printed previously, published in one volume or a number of volumes in a uniform style of binding, usually with an inclusive title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collected works"@en .

aat:300060712 a skos:Concept ;
    skos:definition "Accounting that deals with systematically classifying, recording, analyzing, and summarizing the costs incident to production or the rendering of a service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cost accounting"@en .

aat:300060720 a skos:Concept ;
    skos:definition "Printing process that uses engraved linoleum, which may or may not be mounted on a wood block as the plate for printing or stamping a design or composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linoleum block printing"@en .

aat:300061003 a skos:Concept ;
    skos:definition "Characteristic qualities of color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color properties"@en .

aat:300061066 a skos:Concept ;
    skos:definition "Refers to works depicting realistic situations with tones of social protest, common especially in the 1930s and 1940s. For the representational art in Communist countries sanctioned by the government, use \"Socialist Realist.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social realism"@en .

aat:300061163 a skos:Concept ;
    skos:definition "Taking apart or removing significant pieces, especially to reduce or disable the function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dismantling"@en .

aat:300061289 a skos:Concept ;
    skos:definition "Vaults in which the crown of the vault is higher than the crown of the transverse arches so that the ridge line is curved in elevation often having a transverse of a semi-circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domical vaults"@en .

aat:300061324 a skos:Concept ;
    skos:definition "Vaults of approximately quarter-circle profile, such as would cover an aisle in a church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half barrel vaults"@en .

aat:300061886 a skos:Concept ;
    skos:definition "General term for the activity of buying, selling, or bartering commodities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade"@en .

aat:300061887 a skos:Concept ;
    skos:definition "Trees or shrubs pruned and trained into various geometric, zoomorphic, or fantastic shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topiary"@en .

aat:300061920 a skos:Concept ;
    skos:definition "Process of cutting solid materials, such as stone, into certain shapes or figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereotomy"@en .

aat:300061924 a skos:Concept ;
    skos:definition "A process in which an object, as a leaf or piece of lace, is pressed into a plain surface, as of soft metal, to make either a direct printing surface or a matrix."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nature printing"@en .

aat:300061961 a skos:Concept ;
    skos:definition "Thin vaults of one or more layers of terracotta tiles laid flat edge to edge and deriving their rigidity from cohesion and curvature rather than from massiveness or compression; can be erected without centering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timbrel vaults"@en .

aat:300061981 a skos:Concept ;
    skos:definition "Refers to the process used to create tapestries, which are heavy, woven textiles characterized by ornamental or pictorial designs and used as wall hangings, curtains, upholstery, or to hang from windows or balconies. The process is performed on a tapestry loom and differs from cloth-weaving in that the weft travels only to the warp at the edge of a particular color or pattern in the design, rather traveling from edge to edge of the entire piece of fabric. Various techniques are used in mixing and overlaying colors to create shading and patterns. Details of the design are often painted or embroidered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry"@en .

aat:300065017 a skos:Concept ;
    skos:definition "Screens that separate the altar area from the space behind it. Distinct from \"reredoses,\" which relate visually to the altar and may form part of the inner side of an altar screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar screens"@en .

aat:300065023 a skos:Concept ;
    skos:definition "Gables with curved sides and surmounted by a pediment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch gables"@en .

aat:300065024 a skos:Concept ;
    skos:definition "Shingled roofs with inward curvature at the eaves and other features causing them to resemble thatched roofs; popular in the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false thatched roofs"@en .

aat:300065026 a skos:Concept ;
    skos:definition "Pointed arches in which the length of the voussoirs increases toward the center, so that the arch of the extrados has more vertical proportions than the arch of the intrados. For similar arches when rounded, use \"Florentine arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian pointed arches"@en .

aat:300065029 a skos:Concept ;
    skos:definition "Screens, partitions, or railings serving to enclose or shut off a space in a building, particularly such structures located in a church, where they are designed to exclude nonworshippers from a chapel or shrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parcloses"@en .

aat:300065033 a skos:Concept ;
    skos:definition "Distinctive rood screens found in Italian churches, often deep free-standing structures found particularly in mendicant churches and in many other monastic churches in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tramezzi"@en .

aat:300065035 a skos:Concept ;
    skos:definition "Rooms at a spa designed for drinking mineral waters, as at Bath, England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pump rooms"@en .

aat:300065037 a skos:Concept ;
    skos:definition "Capitals whose basic form is shaped like a bell or an inverted bell; may be enriched with carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell capitals"@en .

aat:300065040 a skos:Concept ;
    skos:definition "Pediments with a top in the form of a segmental arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "segmental pediments"@en .

aat:300065045 a skos:Concept ;
    skos:definition "Porches or rooms having open sides or many windows arranged to permit sleeping in the open air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeping porches"@en .

aat:300065047 a skos:Concept ;
    skos:definition "Boxes, usually elongated, containing soil and used for growing ornamental plants, placed on a window sill or at the level of a sill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window boxes"@en .

aat:300065050 a skos:Concept ;
    skos:definition "Rooms designed or used for sewing, which is the process of creating or mending clothing or other works by joining or decorating cloth, leather, or other flexible materials with thread by means of a needle. Sewing rooms may be furnished for hand sewing or machine sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing rooms"@en .

aat:300065054 a skos:Concept ;
    skos:definition "Spaces designed for viewing a landscape, or observing wildlife. These may be open spaces at the tops of tall buildings or constructed in natural environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "observation decks"@en .

aat:300065075 a skos:Concept ;
    skos:definition "Representations of conditions, processes, concepts, etc. using the scientific study of quantities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathematical models"@en .

aat:300065080 a skos:Concept ;
    skos:definition "Very small city parks, directly adjacent to and usually between buildings in a densely built area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vest-pocket parks"@en .

aat:300065090 a skos:Concept ;
    skos:definition "Buildings that house prisons having the highest level of security for dangerous inmates or those likely to escape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maximum-security prisons"@en .

aat:300065096 a skos:Concept ;
    skos:definition "Extravagantly illustrated books about flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "florilegia"@en .

aat:300065103 a skos:Concept ;
    skos:definition "Foundations consisting of concrete, brick, or stone piers which deliver the load to a support stratum; the piers are usually more substantial than piles and are not clustered. Now commonly produced by excavating within a caisson."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pier foundations"@en .

aat:300065107 a skos:Concept ;
    skos:definition "A series of numbers in which each number is the sum of the two preceding numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fibonacci numbers"@en .

aat:300065116 a skos:Concept ;
    skos:definition "Upthrusts of ground caused by freezing of moist soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frost heaves"@en .

aat:300065117 a skos:Concept ;
    skos:definition "Combined footings in which two independent footings are connected to each other to counterbalance an asymmetrical load on one of them, usually one supporting an off-center exterior wall or column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantilever footings"@en .

aat:300065178 a skos:Concept ;
    skos:definition "Financial assistance, usually to a business or other organization, given by the central government, as distinct from the separate units constituting it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federal aid"@en .

aat:300065204 a skos:Concept ;
    skos:definition "Semicircular arches in which the rise is less than half the span."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surbased arches"@en .

aat:300065206 a skos:Concept ;
    skos:definition "The relative prestige of an individual or group and the hierarchical position of a social role in a social structure or stratification system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social status"@en .

aat:300065218 a skos:Concept ;
    skos:definition "The phenomena by which a force causes the body to which it is applied to rotate about a point or line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moments"@en .

aat:300065222 a skos:Concept ;
    skos:definition "The maximum shear stress which a material or soil is capable of sustaining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shear strength"@en .

aat:300065239 a skos:Concept ;
    skos:definition "The application of the principles of mechanics and hydraulics to engineering problems dealing with soil as an engineering material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil mechanics"@en .

aat:300065242 a skos:Concept ;
    skos:definition "A brilliant, highly reflective surface quality, giving a more mirrorlike reflected image than a lustrous or shiny surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gloss"@en .

aat:300065244 a skos:Concept ;
    skos:definition "A reflective surface quality less bright than a gloss and giving less of an impression of depth in the finish than a luster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shine"@en .

aat:300065245 a skos:Concept ;
    skos:definition "An aged appearance caused by environmental factors, acquired naturally or artificially induced; used especially with regard to a surface layer on metal caused by oxidation or corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patina"@en .

aat:300065248 a skos:Concept ;
    skos:definition "Dialectical critiques, generally based on the social and political philosophies associated with the leaders of the Frankfurt School, such as Theodor Adorno and Walter Benjamin, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "critical theories"@en .

aat:300065250 a skos:Concept ;
    skos:definition "The theory adopted as the official philosophy of the Soviet communists which states that physical matter is the only true reality, that every aspect of it is subject to constant change resulting from the pressure of conflicting forces, and that mental processes are dependent on material ones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dialectical materialism"@en .

aat:300065251 a skos:Concept ;
    skos:definition "Ownership or control that permits domination of the means of production or the market in a business or occupation, usually in order to control prices; it is achieved through an exclusive legal privilege, control of the source of supply, or combination or concert of action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monopolies"@en .

aat:300065252 a skos:Concept ;
    skos:definition "The middle point, especially of a line, circle or sphere, equidistant from the ends or from any point on the circumference or surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centers"@en .

aat:300065269 a skos:Concept ;
    skos:definition "Arches built across a nave or hall that support walls rather than vaults; for such arches when they support vaults, use \"transverse arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaphragm arches"@en .

aat:300065275 a skos:Concept ;
    skos:definition "The condition in which one type of sensory stimulation is interpreted or perceived through another sense. The most common type is known as 'colored hearing' where a person experiences a visual sensation while receiving an auditory stimulus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synesthesia"@en .

aat:300065284 a skos:Concept ;
    skos:definition "Generally, practices or patterns of behavior regularly performed in a set, precise manner, for either personal or public purposes. Specifically, particular activities performed during a designated event, often a ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rituals"@en .

aat:300065289 a skos:Concept ;
    skos:definition "Wood structural frames in which the studs are only one story high, the floor joist of each story rests on the top plates of the story below or on the foundation sill for the first story, and the bearing walls and partitions rest on the subfloor of each story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform frames"@en .

aat:300065291 a skos:Concept ;
    skos:definition "Wooden frameworks in which all vertical structural elements, posts and studs, of the exterior bearing walls and partitions extend the full height of the frame from sill to roof plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon frames"@en .

aat:300065299 a skos:Concept ;
    skos:definition "Conceits or techniques used in literature and other arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artistic devices"@en .

aat:300065309 a skos:Concept ;
    skos:definition "Belief in or claim to personal intellectual, cultural, or spiritual superiority not accessible to mankind in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illuminism"@en .

aat:300065372 a skos:Concept ;
    skos:definition "The disputatious comparison of the various arts, popular in Renaissance Humanist circles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paragone"@en .

aat:300065377 a skos:Concept ;
    skos:definition "Doctrine or theory that emphasizes psychological conceptions outside the field of psychology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychologism"@en .

aat:300065446 a skos:Concept ;
    skos:definition "Concepts in the sciences that deal with the inorganic world, such as those concepts related to astronomy, Earth science, physics, and chemistry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical sciences concepts"@en .

aat:300065458 a skos:Concept ;
    skos:definition "The science of pure motion; the study of the geometry of motion without regard for the effects of mass or force on the system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinematics"@en .

aat:300065463 a skos:Concept ;
    skos:definition "Parallel relationships to a horizontal axis in designs for graphic works, objects, and structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizontality"@en .

aat:300065467 a skos:Concept ;
    skos:definition "Strength or purity of a color, determined by the quality of light reflected from it; a vivid color is of high intensity, a dull color of low intensity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intensity"@en .

aat:300065581 a skos:Concept ;
    skos:definition "The properties of sound, especially the sound properties of built environments, materials, and sound devices, such as reverberation and absorbency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustical properties"@en .

aat:300065585 a skos:Concept ;
    skos:definition "Sets of logical procedures for solving problems in a finite number of steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "algorithms"@en .

aat:300065624 a skos:Concept ;
    skos:definition "Formal artistic concepts that deal with the representation of objects on a plane surface in relation to their distance, size, and position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perspective-related concepts"@en .

aat:300065626 a skos:Concept ;
    skos:definition "Lines in a perspective system that are perpendicular to the picture plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthogonals"@en .

aat:300065674 a skos:Concept ;
    skos:definition "A state of balance between opposing forces that is either static or dynamic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equilibrium"@en .

aat:300065709 a skos:Concept ;
    skos:definition "The appearance of wounds on the hands, feet, and side corresponding to those received by Christ upon crucifixion, which have appeared, inexplicably, on some people who intensely contemplate the Passion of Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stigmatization"@en .

aat:300065728 a skos:Concept ;
    skos:definition "Parts or components of shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaft components"@en .

aat:300065747 a skos:Concept ;
    skos:definition "In technical drawing and other contexts, broken lines indicating alternative position of delineated parts or the relative position of an absent part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phantom lines"@en .

aat:300065748 a skos:Concept ;
    skos:definition "Extreme regularity of balance achieved by the correspondence of identical compositional units on either side of a central axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bilateral symmetry"@en .

aat:300065751 a skos:Concept ;
    skos:definition "Doctrine espoused by certain French painters of the 18th century emphasizing the importance of line over color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poussinism"@en .

aat:300065758 a skos:Concept ;
    skos:definition "A style developed in the mid 20th century, characterized by simplicity and lack of decoration to the point of starkness. The movement advocated reducing art to the state of non-art by removing nature and culture, resulting in artwork in pure, simple forms and objects placed randomly. The term can be extended to all art, including literature, design, music, visual art, and performance. With specific reference to the visual arts, the term is used to describe an abstract art movement and style, predominantly of sculpture, that flourished in the mid- and late 1960s. With specific reference to music, it refers to a style that emerged in the United States in the 1960s featuring prolonged repetition of short passages and unvarying harmonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minimal"@en .

aat:300065789 a skos:Concept ;
    skos:definition "In art or aesthetics, S-shaped curved lines appearing within an object, as the boundary line of an object, or as a virtual boundary line formed by the composition of several objects. The idea originated with William Hogarth as an essential part of his theory of aesthetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lines of beauty"@en .

aat:300065818 a skos:Concept ;
    skos:definition "Concepts that deal with the study of human society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sociological concepts"@en .

aat:300065851 a skos:Concept ;
    skos:definition "Refers to a perspective system in which there are two vanishing points, generally characterized by a rectangular form represented at an angle to the picture plane, so that horizontal parallels recede to points to the right and the left but vertical lines remain parallel to the picture plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-point perspective"@en .

aat:300065853 a skos:Concept ;
    skos:definition "Refers to a perspective system in which parallel lines converge to various points on a vertical axis. The system was used by ancient Greeks and continued in Western art until one-point perspective was codified in the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axial perspective"@en .

aat:300065854 a skos:Concept ;
    skos:definition "In a perspective system, an area where orthogonals converge in a general vicinity rather than a single point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vanishing area"@en .

aat:300065855 a skos:Concept ;
    skos:definition "Refers to the pictorial device of making parallel lines diverge, rather than converge, to suggest recession into depth. The system was used in Western art prior to the codification of one-point perspective, and it appears incorrect to modern eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inverted perspective"@en .

aat:300065856 a skos:Concept ;
    skos:definition "Hardware fasteners incorporating a hook, designed to hold blinds in place while in a closed position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind catches"@en .

aat:300065858 a skos:Concept ;
    skos:definition "Door latches employing a spring-loaded steel ball. The loaded ball holds the door closed but rolls free when the door is pulled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullet catches"@en .

aat:300065859 a skos:Concept ;
    skos:definition "Catches used to secure casement windows when closed, often in the form of a swivelling handle that is held in place by a hook or latch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casement-window fasteners"@en .

aat:300065863 a skos:Concept ;
    skos:definition "Braces or bars used to hold a casement window open in any of several positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casement stays"@en .

aat:300065869 a skos:Concept ;
    skos:definition "Surface-mounted hinges with one leaf or both leaves elongated to accommodate additional fasteners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strap hinges"@en .

aat:300065871 a skos:Concept ;
    skos:definition "Small hooks and eyes, generally used on cabinets. Distinguished from \"cabin door hooks,\" which are generally used on marine installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabin hooks"@en .

aat:300065873 a skos:Concept ;
    skos:definition "Hooks that are attached to the inside, back, or side walls of a fireplace, used for suspending pots and kettles over a fire or for holding implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney hooks"@en .

aat:300065875 a skos:Concept ;
    skos:definition "Refers to catches of various kinds, but usually spring bolt latches used to secure the doors of cabinets or other furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet latches"@en .

aat:300065880 a skos:Concept ;
    skos:definition "Handles designed specifically for pulling open doors, formed so that the fingers have a bar or surface to grasp, and commonly mounted on a metal plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door pulls"@en .

aat:300065884 a skos:Concept ;
    skos:definition "Devices consisting of wheels mounted to heavy doors that roll on a track or rail either above or below the door itself, designed for doors of large size and weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barn-door rollers"@en .

aat:300065888 a skos:Concept ;
    skos:definition "Devices used to retard the movement of a closing door and to guard against its slamming or banging, but also insures the closing of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door checks"@en .

aat:300065895 a skos:Concept ;
    skos:definition "Wheels set in a swivel and added to the feet on furniture to allow easy movement. Distinguished from \"foot sockets\" which serve to protect the feet on furniture as well as to allow easy movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castors"@en .

aat:300065897 a skos:Concept ;
    skos:definition "Metal ties for securing a beam, joist, or floor firmly to a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beam anchors"@en .

aat:300065905 a skos:Concept ;
    skos:definition "Anchoring devices comprising a threaded shank with a lopped head designed to accept a hook, cable, or rope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyebolts"@en .

aat:300065909 a skos:Concept ;
    skos:definition "Hangers used for heavy exterior sliding or rolling doors, consisting of two pulleys secured to the top of the door in tandem, connected by a heavy metal strap. The door is moved by rolling along a horizontal track which either hangs from the lintel or is anchored to a parallel member projecting slightly from it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barn-door hangers"@en .

aat:300065911 a skos:Concept ;
    skos:definition "Devices such as pipe sleeves, threaded bolts, or nailing blocks that are attached to a concrete form before pouring the concrete. When the forms are removed, the inserts remain embedded in the concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete inserts"@en .

aat:300065913 a skos:Concept ;
    skos:definition "Devices of varying form that grip and hold tightly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clips"@en .

aat:300065915 a skos:Concept ;
    skos:definition "L-shaped clips designed to join two longer members at a right angle to form a corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner clips"@en .

aat:300065924 a skos:Concept ;
    skos:definition "Wire nails with a flaring head, used for outside finish and also for nailing floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casing nails"@en .

aat:300065928 a skos:Concept ;
    skos:definition "Large-headed nails with which doors, window shutters, or other such wooden coverings are studded for strength, protection, or ornamentation. Such a nail was also sometimes placed under a door knocker, to receive the blow and make a sound. For ornamental nails used in large numbers and primarily for decoration, particularly in historical Spain and its colonies, use \"chatônes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doornails"@en .

aat:300065931 a skos:Concept ;
    skos:definition "Mechanical fasteners designed to bridge a joint and pull the two pieces tightly together as they are driven in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clamp nails"@en .

aat:300065933 a skos:Concept ;
    skos:definition "Nails similar to common nails with the same penny designation of length but having a shank smaller in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box nails"@en .

aat:300065935 a skos:Concept ;
    skos:definition "Nails which are coated with cement in order to increase friction and holding power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cement-coated nails"@en .

aat:300065937 a skos:Concept ;
    skos:definition "Steel nails each having a diamond point that has been hardened so that it can be driven into concrete without bending."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete nails"@en .

aat:300065939 a skos:Concept ;
    skos:definition "Short, headless pins with a sharp point on one end and barbs between the two ends, used largely for fastening the mortise-and-tenon joints in a window sash and for door work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbed dowel pins"@en .

aat:300065941 a skos:Concept ;
    skos:definition "Special nails that are pointed at both ends and are used to fasten mortise-and-tenon joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dowel pins"@en .

aat:300065943 a skos:Concept ;
    skos:definition "Small nails, usually brass and often ornamental, used to fix an escutcheon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escutcheon pins"@en .

aat:300065945 a skos:Concept ;
    skos:definition "Screws that in connection with wood or metal jaws may be used to provide a clamping force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clamping screws"@en .

aat:300065953 a skos:Concept ;
    skos:definition "Joints consisting of two crossing pieces of wood, each piece notched to fit into the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cogged joints"@en .

aat:300065955 a skos:Concept ;
    skos:definition "Joints between two consecutive pours of concrete if the time elapsed between the first and second pours is such that the first pour has started to harden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold joints"@en .

aat:300065957 a skos:Concept ;
    skos:definition "In masonry construction, any mortar joints on the face of a brick or stone wall, above the ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exposed joints"@en .

aat:300065959 a skos:Concept ;
    skos:definition "Commonly used joints in cast iron pipe. Each piece is made with an enlarged diameter or bell at one end into which the plain or spigot end of another piece is inserted. The joint is sealed by cement, oakum, lead, or rubber caulked into the bell around the spigot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell-and-spigot joints"@en .

aat:300065962 a skos:Concept ;
    skos:definition "Plumbing joints sealed with the use of a blowtorch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blown joints"@en .

aat:300065964 a skos:Concept ;
    skos:definition "In plumbing, joints packed with oakum and finished with molten lead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calk joints"@en .

aat:300065966 a skos:Concept ;
    skos:definition "In plumbing, a socket joint formed between two similar pipes in the same line, by opening out the end of one pipe to receive the tapered end of the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup joints"@en .

aat:300065968 a skos:Concept ;
    skos:definition "In plumbing and other lead work, a folding joint formed at the corner of a sheet-lead tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog-ear joints"@en .

aat:300065970 a skos:Concept ;
    skos:definition "Mortise-and-tenon joints used when two timbers are joined at an angle of less than 90 degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridle joints"@en .

aat:300065972 a skos:Concept ;
    skos:definition "Joints between two pieces of wood in which the direction of the grain of one piece is at an angle (usually 90 degrees) to the grain in the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abutting joints"@en .

aat:300065974 a skos:Concept ;
    skos:definition "Wood joints in which two pieces are each cut to half their thickness at the overlap, so that the total thickness of the system does not change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosslap joints"@en .

aat:300065976 a skos:Concept ;
    skos:definition "In carpentry, joints formed by the meeting of a number of adjacent heading joints occurring in a line with each other. An example is as used in connection with the laying of floor planks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaking joints"@en .

aat:300065978 a skos:Concept ;
    skos:definition "Joints made on a curved surface similar to the joints made between the staves of a barrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coopered joints"@en .

aat:300065980 a skos:Concept ;
    skos:definition "Joints in any material in which the edge of one member laps over onto the face of the other. An example is for joints made by rebating or ploughing the edge of the projecting piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered joints"@en .

aat:300065987 a skos:Concept ;
    skos:definition "Wood joints made by notching each member to receive the other. An example is in notched joints of two structural timbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dap joints"@en .

aat:300066015 a skos:Concept ;
    skos:definition "Sense by which the flavor or savor of things is perceived when they are brought into contact with the tongue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taste"@en .

aat:300066017 a skos:Concept ;
    skos:definition "Concepts related to the transport of people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation-related concepts"@en .

aat:300066035 a skos:Concept ;
    skos:definition "Concepts related to the natural environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental concepts"@en .

aat:300066040 a skos:Concept ;
    skos:definition "Manufacturing goods in large quantities so as to attain high rates of output at decreasing unit cost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass production"@en .

aat:300066047 a skos:Concept ;
    skos:definition "Money compulsorily levied by the state or local authorities on individuals, property, or businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxes"@en .

aat:300066048 a skos:Concept ;
    skos:definition "Changing from one substance to another as a tenet of doctrine. The primary example is in Roman Catholic and Orthodox Eastern dogma, the eucharistic elements at their consecration become the body and blood of Christ while keeping only the appearances of bread and wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transubstantiation"@en .

aat:300066049 a skos:Concept ;
    skos:definition "The Christian doctrinal concept that the Virgin Mary was free from original sin from the moment of conception, unlike all other humans after Adam and Eve. Although this belief was promulgated as Roman Catholic dogma by Pope Pius IX in 1854, it has been rejected by Protestants and the Orthodox Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immaculate conception"@en .

aat:300066052 a skos:Concept ;
    skos:definition "Butt hinges that have caps to cover the securing screws of each leaf. Small screws secure the butt to the cap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capped butt hinges"@en .

aat:300067121 a skos:Concept ;
    skos:definition "Strategy of critical analysis arising in the mid-20th century, directed toward exposing unquestioned assumptions and internal contradictions in philosophical and literary language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deconstruction"@en .

aat:300067141 a skos:Concept ;
    skos:definition "Architectural designs that are eccentric, outrageous, or unconventional, that jolt or excite the viewer, and that are generally characterized by an unusual juxtaposition of shapes or materials; may be spontaneously constructed, incomplete, or unbuilt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fantastic architecture"@en .

aat:300067209 a skos:Concept ;
    skos:definition "Generally, the comparative study and analysis of the characteristics of things, including their grouping into classes on the basis of common characteristics; also includes the analysis of the origin and meaning of Biblical types, especially in comparing the Old and New Testaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typology"@en .

aat:300067272 a skos:Concept ;
    skos:definition "Storms accompanied by hail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hailstorms"@en .

aat:300067309 a skos:Concept ;
    skos:definition "General theory that emphasizes the importance of history as a standard of value or as a determinant of events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historicism"@en .

aat:300067390 a skos:Concept ;
    skos:definition "Sustained posture or positioning of the torso and limbs, especially when assumed for artistic or ritual effect, particularly as found in still images and dance. Common examples are in fashion modeling, in subjects of portraits, and in figures of other art works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pose"@en .

aat:300067391 a skos:Concept ;
    skos:definition "Position of a figure standing at rest, with weight shifted on to one leg. The pose is balanced but asymmetrical, in which twisting or bending of the body's vertical axis results in hips, shoulders, and head turned or tipped in different directions. In western art it refers to the Greek concept of \"antithesis,\" fundamental in Classical rhetoric as the pose considered most pleasing and convincing, the visual equivalent to words presented in direct opposition to one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contrapposto"@en .

aat:300067402 a skos:Concept ;
    skos:definition "In architecture, the arrangement of bearing and carried parts in post and beam construction, usually the ensemble of column with its entablature and base, which encodes standardized details and style, or variations of these. For the traditional five orders of classical architecture, prefer the narrower concept \"classical orders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural orders"@en .

aat:300067406 a skos:Concept ;
    skos:definition "Refers to the architectural order characterized by columns generally without bases, relatively simple capitals, and a frieze composed of alternating triglyphs and metopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Doric order"@en .

aat:300067415 a skos:Concept ;
    skos:definition "Refers to an architectural order characterized by capitals composed of foliate echini derived from the Corinthian order superposed by volutes derived from the Ionic order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Composite order"@en .

aat:300067417 a skos:Concept ;
    skos:definition "Refers to the architectural order characterized by a capital having a bell-shaped echinus decorated with a combination of spiral and plant, usually acanthus, motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian order"@en .

aat:300067420 a skos:Concept ;
    skos:definition "Refers to the architectural order characterized by unfluted columns, torus bases, unadorned cushion capitals, and plain friezes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuscan order"@en .

aat:300067423 a skos:Concept ;
    skos:definition "Refers to the architectural order characterized by capitals with volutes, richly carved moldings, and columns with bases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionic order"@en .

aat:300067450 a skos:Concept ;
    skos:definition "Painting technique whereby tones and hues are obtained by applying regular small dots or touches of unmixed pigment on the canvas so that they combine optically. The French critic Félix Fénéon coined the term \"peinture au point\" in 1886 after seeing Seurat's \"La Grande Jatte.\" Paul Signac offered the alternative term of \"divisionism\" in his book \"D'Eugène Delacroix au Néo-Impressionnisme (1899), although in modern usage \"pointillism\" is reserved for the technique involving dots applied in a controlled manner, while \"divisionism\" refers to use of marks of unmixed color in Italian painters’ works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointillism"@en .

aat:300067518 a skos:Concept ;
    skos:definition "Trusses with parallel chords between which the braces and ties are set at the same angle so as to form a series of isoceles triangles, the diagonals of which are alternately placed either in tension or compression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Warren trusses"@en .

aat:300067571 a skos:Concept ;
    skos:definition "Roof trusses which are smaller in size than the others, usually because of location, as in a hip roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jack trusses"@en .

aat:300067597 a skos:Concept ;
    skos:definition "Refers to a system of linear perspective in which primary buildings, objects, or figures are depicted parallel to the picture plane. It also refers to perspective systems in which parallel projecting lines do not converge but remain parallel; this system is common in East Asian painting. Use \"parallel projection,\" \"axonometric drawings,\" or a narrower term in the context of architectural drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel perspective"@en .

aat:300067617 a skos:Concept ;
    skos:definition "Trusses of the type utilized in hammer-beam roofs, with a combination of hammer beams, hammer posts, and braces taking the place of the beam at the base of the roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer-beam trusses"@en .

aat:300067713 a skos:Concept ;
    skos:definition "Refers to linear perspective in which there are three vanishing points, generally in the context of rectangular forms depicted so that none of their sides is parallel to the picture plane, but instead each of three groups of parallel lines recede to their own vanishing points. This technique was made popular in 17th-century European stage design. It may also refer to depictions in which there are three points of view, as was also often used in Chinese hanging scroll landscapes, in which the viewer sees the foreground from above, the middle ground at eye-level, and the highest objects from below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-point perspective"@en .

aat:300067716 a skos:Concept ;
    skos:definition "Refers to perspective depicted by using a single vanishing point. The technique was codified by the Renaissance artist and theoretician, Leon Battista Alberti, who described a visual pyramid, the vertex of which is in the viewer's eye. The illusion of recession into space is produced by parallel lines converging at one vanishing point, which was usually at or near the center of the composition and was at that time called the \"centric point.\" Alberti described how to determine the correct intervals for horizontal lines at progressively deeper positions in space, and how to draw objects and figures to the correct scale for their position in space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-point perspective"@en .

aat:300067731 a skos:Concept ;
    skos:definition "Use with reference to perspective systems for the line in which the horizontal plane containing the eye meets the picture plane and for the line containing the vanishing points of horizontal planes in the picture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizon line"@en .

aat:300067738 a skos:Concept ;
    skos:definition "Includes the implied location in a perspective system where the viewer would be standing and the fixed actual observation point for viewing a perspectival picture. The meaning overlaps with \"view point,\" although \"station point\" is more often used in reference to architectural drawings, while \"viewpoint\" is used to refer to all art forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "station point"@en .

aat:300067745 a skos:Concept ;
    skos:definition "The axis toward which parallel lines converge in an axial perspective system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vanishing axis"@en .

aat:300067903 a skos:Concept ;
    skos:definition "Structures supported by a series of double cables of different curvature used in the same vertical plane and held apart by struts in compression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-cable structures"@en .

aat:300067974 a skos:Concept ;
    skos:definition "Refers to a Christian religious ideology usually based on an interpretation of Revelation 20. 1-7 which holds that there will be a thousand-year reign of the saints, either right before or after Christ's return. Millenarianism has had its followers since the early days of Christianity, but it became particularly popular in the 19th century, when groups such as the Plymouth Brethren and the Adventists embraced apocalyptic and millennial ideas. Recently the term has also been applied by social scientists to any religious group waiting for a sudden transformation of the world; such groups tend to become popular during times of social change or crisis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millenarianism"@en .

aat:300067987 a skos:Concept ;
    skos:definition "Commodities or assets with some economic value that exist without any effort of mankind. Natural resources can be of three types. The first is non-renewable, like oil and coal, stocks of which will eventually run out . The second is renewable, like water and fish, which are reproducible. The third is non-expendable: it is not used up in the consumption process. An example is a landscape of outstanding beauty, which yields utility for those that see it, and tourist income for the owner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural resources"@en .

aat:300068034 a skos:Concept ;
    skos:definition "Making areas of the natural landscape available for human use by changing natural conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reclamation"@en .

aat:300068046 a skos:Concept ;
    skos:definition "Structural systems in which the primary reinforcing steel runs in one direction only; may or may not include one-way supporting beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-way solid slab systems"@en .

aat:300068050 a skos:Concept ;
    skos:definition "One-way structural systems in which the slab is articulated with ribs or joists, closely spaced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-way joist systems"@en .

aat:300068085 a skos:Concept ;
    skos:definition "Refers to a variety of types of architectural drawings or other two-dimensional works in another medium, including axonometric, perspective drawings, and others using a form of projection that give an impression of depth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial views"@en .

aat:300068118 a skos:Concept ;
    skos:definition "Two-way slab systems, with the slab reinforced by ribs running in both directions, creating a waffle pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waffle slabs"@en .

aat:300068132 a skos:Concept ;
    skos:definition "Vertical sections of soil showing the nature and sequence of the various layers, as developed by deposition, weathering, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil profiles"@en .

aat:300068293 a skos:Concept ;
    skos:definition "Drawings done in preparation for further work, most often for work in a medium other than drawing, especially for printmaking. They are typically more finished than sketches. For drawings done in preparation for architectural construction, use other terms, such as \"preliminary drawings\" or \"design drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preparatory drawings"@en .

aat:300068302 a skos:Concept ;
    skos:definition "Action or function of determining the worth of a piece of land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land valuation"@en .

aat:300068483 a skos:Concept ;
    skos:definition "Broad term for any architecture built of local materials to suit particular local needs, generally constructed outside any academic tradition and without professional guidance. It is often of unknown authorship and makes little reference to established styles or theories of architecture. Most architectural works in the world are vernacular architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernacular architecture"@en .

aat:300068545 a skos:Concept ;
    skos:definition "Ideas having to do solely with the spectacular and improbable, with no or very little relationship to real people, objects, or events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fantasy"@en .

aat:300068573 a skos:Concept ;
    skos:definition "Differential movements of the earth's crust or parts of its surface, or elevations or subsidences of land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth movements"@en .

aat:300068575 a skos:Concept ;
    skos:definition "In the United States, patents granted for the ornamental design, configuration or shape, and surface ornamentation of a functional item, such as furniture, appliances, containers, tools, computer icons, etc. (but not including fine art)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design patents"@en .

aat:300068579 a skos:Concept ;
    skos:definition "Designs, patterns, or images created by using scissors to remove small portions from the interior or edges of a piece of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut-paper work"@en .

aat:300068588 a skos:Concept ;
    skos:definition "Door hinges that can be separated by lifting. The door can thus be removed without unscrewing the hinges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loose-joint hinges"@en .

aat:300068589 a skos:Concept ;
    skos:definition "Types of butt hinges mounted on the third leaf of three-ply shutters, designed to allow the leaf to enter a recess in the interior jamb of a window without jamming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket butts"@en .

aat:300068591 a skos:Concept ;
    skos:definition "Metal projections used to secure a ladder to a ledge or to the ridge of a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladder hooks"@en .

aat:300068594 a skos:Concept ;
    skos:definition "Anchors for bolts and screws used to secure structural wood parts to masonry or concrete walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rawl plugs"@en .

aat:300068595 a skos:Concept ;
    skos:definition "The development and use of sustainable approaches to meeting human and ecological needs through the applications of scientific principles and engineering techniques as they are connected to the place, resources, economics, culture and impacts of their uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appropriate technology"@en .

aat:300068596 a skos:Concept ;
    skos:definition "Anchor bolts used to fasten a sill to its foundation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sill anchors"@en .

aat:300068598 a skos:Concept ;
    skos:definition "Fasteners used in concrete, consisting of two semicircular shields that are forced apart, to bear on the walls of a hole, as a bolt is driven into the shields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "star expansion bolts"@en .

aat:300068600 a skos:Concept ;
    skos:definition "Bolt and nut assemblies used to fasten objects to a hollow wall or a wall accessible from only one side. The nut has pivoted wings that close against a spring when the nut end of the assembly is pushed through a hole and open on the other side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toggle bolts"@en .

aat:300068601 a skos:Concept ;
    skos:definition "Bolts, usually of steel, that hold overlapping sections of gutters to each other, and that attach the gutter to the eaves of a roof. For long nails or spikes used to secure gutters to the structure, use \"gutter spikes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gutter bolts"@en .

aat:300068603 a skos:Concept ;
    skos:definition "In construction, specialized clips applied to metal shingles or siding to provide support for a nail, so the shingle or siding may be nailed to a wooden or other support. For example, in roofing, a nailing clip may be soldered to a metal shingle so that it can be nailed to the roof sheathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nailing clips"@en .

aat:300068604 a skos:Concept ;
    skos:definition "Clip connectors used in assembling trusses or in joining timber end to end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss clips"@en .

aat:300068608 a skos:Concept ;
    skos:definition "Plates used to connect members of a truss together or to connect several steel members at a joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gusset plates"@en .

aat:300068612 a skos:Concept ;
    skos:definition "Very small nails having a small, flat head; usually used for trim or fine finishing work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-head wire brads"@en .

aat:300068613 a skos:Concept ;
    skos:definition "Nails which come in 1-inch and 1 3/4-inch lengths; used primarily for applying gypsum board or rock lath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsum board nails"@en .

aat:300068614 a skos:Concept ;
    skos:definition "Roofing nails having a plain shank and a lead cap or washer, used for attaching corrugated or other metal roofing. The advantage of using lead washers is that they make a tight joint and prevent leaking and rusting at the nail hole; given that the lead washer is soft, it conforms to the curve and irregular surface of the metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead-capped nails"@en .

aat:300068617 a skos:Concept ;
    skos:definition "Annular ring nails used for nailing into metal studs to hold gypsum board in drywall construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratchet nails"@en .

aat:300068620 a skos:Concept ;
    skos:definition "Hardened-steel nails used primarily for fastening wood to masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry nails"@en .

aat:300068621 a skos:Concept ;
    skos:definition "Secondary nuts used on a bolt to prevent the first nut from turning; also nuts which lock when tightened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locknuts"@en .

aat:300068623 a skos:Concept ;
    skos:definition "Screws each having a recessed head and an X-shaped driving indentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phillips head screws"@en .

aat:300068625 a skos:Concept ;
    skos:definition "Long pins of hardwood used for fastening planks or timbers in some post-and-beam construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treenails"@en .

aat:300068629 a skos:Concept ;
    skos:definition "Joints formed by joining the ends of boards together, end-to-end. In construction, given that heading joints must be supported by joists or bearers, the joints often appear in a straight line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heading joints"@en .

aat:300068630 a skos:Concept ;
    skos:definition "Visible joints on the surface of a masonry wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face joints"@en .

aat:300068631 a skos:Concept ;
    skos:definition "Joints between two adjacent masonry units in the same course."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "head joints"@en .

aat:300068632 a skos:Concept ;
    skos:definition "In masonry or stonework, joints which employ joggles in the adjacent members so as to prevent their later movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joggle joints"@en .

aat:300068634 a skos:Concept ;
    skos:definition "Sunken joints between building stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rustic joints"@en .

aat:300068635 a skos:Concept ;
    skos:definition "In construction, joints that allow a certain amount of sliding or contraction and expansion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip joints"@en .

aat:300068636 a skos:Concept ;
    skos:definition "Masonry joints in which the mortar has been shaped or worked before it sets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tooled joints"@en .

aat:300068637 a skos:Concept ;
    skos:definition "In concrete finishing, a space or break of about 1/8 inch made at regular intervals, particularly over expansion joints, to allow for contraction and expansion in the topping layer of sidewalks, driveways, and similar structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topping joints"@en .

aat:300068638 a skos:Concept ;
    skos:definition "Masonry joints protected from rain and snow by sloping the surface of the stone away from the wall, so it will shed water easily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water joints"@en .

aat:300068639 a skos:Concept ;
    skos:definition "Watertight pipe connections that use iron filings as a catalyst to induce rusting in iron pipe joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rust joints"@en .

aat:300068640 a skos:Concept ;
    skos:definition "Joints between two squared, closely butted boards made by plowing a groove along the length of each and fitting them with a common tongue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather joints"@en .

aat:300068641 a skos:Concept ;
    skos:definition "Joints formed by bolting a fishplate (supporting plate) to each side of two abutting rails, timbers, beams, or other members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fished joints"@en .

aat:300068642 a skos:Concept ;
    skos:definition "Transverse joints formed at the intersection of two equally thick pieces of wood, both having been notched to half their original depth, so as to form a joint with flush faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-lap joints"@en .

aat:300068643 a skos:Concept ;
    skos:definition "Butt joints in which one of the members has a bevelled cut where it butts against the other, so that there is not a right angle between the pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblique joints"@en .

aat:300068646 a skos:Concept ;
    skos:definition "Poorly bonded glue joints resulting from the use of too little glue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starved joints"@en .

aat:300068647 a skos:Concept ;
    skos:definition "Masonry joints formed without tools, as excess mortar is squeezed out from between the bricks. In appearance, rustic and textured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extruded joints"@en .

aat:300068648 a skos:Concept ;
    skos:definition "Relatively large rabbet joints that are typically made in structural timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillistered joints"@en .

aat:300068652 a skos:Concept ;
    skos:definition "Tongue-and-groove joints in which the tongue is wedge-shaped and the groove is tapered to receive it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tongue-and-lip joints"@en .

aat:300068654 a skos:Concept ;
    skos:definition "Concepts related to the study of the Earth, including geologic, atmospheric, and hydrologic concepts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth sciences concepts"@en .

aat:300068655 a skos:Concept ;
    skos:definition "Tongue-and-groove joints between two matchboards, which are boards having a tongue cut along one edge and a groove cut along the other edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matched joints"@en .

aat:300068657 a skos:Concept ;
    skos:definition "Joints used in furniture making when pieces of veneer are joined without special attention to whether or not the various pieces are of equal widths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "random joints"@en .

aat:300068658 a skos:Concept ;
    skos:definition "For joining two narrow boards. Both boards are planed smooth, coated with glue, and rubbed together until all air pockets and excess glue are expelled from the joint. No clamping is necessary and the joint is extremely strong."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbed joints"@en .

aat:300068676 a skos:Concept ;
    skos:definition "The state of an artifact, structure, or atmosphere when it contains moisture, usually meaning more than a desirable amount of moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dampness"@en .

aat:300068713 a skos:Concept ;
    skos:definition "Amount paid, given, or charged, or engaged to be paid or given, for anything bought or taken in barter or for service rendered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costs"@en .

aat:300068735 a skos:Concept ;
    skos:definition "A philosophy that is based on the idea that human existence is unexplainable. Existentialism emphasizes the uniqueness and isolation of the individual in a hostile or indifferent world as well as freedom of choice and responsibility for one's actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "existentialism"@en .

aat:300068741 a skos:Concept ;
    skos:definition "Polyhedra composed of four triangular faces, three of which meet at each vertex. It has six edges and four vertices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetrahedra"@en .

aat:300068744 a skos:Concept ;
    skos:definition "Political entities have a government in which the supreme rule is intended to be God or a god directly, or through a priestly order. Also, one whose government is heavily influenced by religious leaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theocracies"@en .

aat:300068753 a skos:Concept ;
    skos:definition "Relief features or surface configurations of a place or an object, including its natural and man-made features. For the art or practice of the accurate graphic representation of the topography of a specific urban area, tract of land, or other place, use \"topography (image-making).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topography"@en .

aat:300068765 a skos:Concept ;
    skos:definition "A property of beliefs, propositions, and linguistic statements, being that they conform with fact or agree with reality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truth"@en .

aat:300068773 a skos:Concept ;
    skos:definition "The carrying from one place to another by way of a craft that utilizes water as the travel medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water transport"@en .

aat:300068783 a skos:Concept ;
    skos:definition "Personal liberties that belong to each individual due to his or her status as a citizen of a particular country or community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil rights"@en .

aat:300068795 a skos:Concept ;
    skos:definition "An abrupt discontinuous natural electric discharge in the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lightning"@en .

aat:300068811 a skos:Concept ;
    skos:definition "Criteria, rules, procedures, or devices approved by official authority or general consent, that serve as examples to be followed or as measures for evaluation or comparative judgment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standards"@en .

aat:300068836 a skos:Concept ;
    skos:definition "The periodic variations in the surface level of the oceans and its associated bodies of water, caused by gravitational attraction of the moon and sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tides"@en .

aat:300068844 a skos:Concept ;
    skos:definition "The ability or permission to, or the method or manner of employing, occupying, applying or exploiting the value of something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "use"@en .

aat:300068848 a skos:Concept ;
    skos:definition "The creation of buildings which are intended to be universally accessible or usable, regardless of the individual user's abilities or disabilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrier-free design"@en .

aat:300068875 a skos:Concept ;
    skos:definition "The branch of science that is concerned with the study of energy and with the relationship of heat transfer and work to other forms of energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermodynamics"@en .

aat:300068896 a skos:Concept ;
    skos:definition "In art and architecture, a compositional element comprising the two- and three-dimensional areas around, above, below, beside, between, and within objects, whether the area is actual or simulated. Included is space occupied by architecture, a work of art, other object, or things depicted in a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space"@en .

aat:300068915 a skos:Concept ;
    skos:definition "Metallic cables or rods extending from the highest point on a roof to the ground that protect the building should lightning strike, by providing a direct path to the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lightning rods"@en .

aat:300068931 a skos:Concept ;
    skos:definition "People who practice the performing arts, such as such as singers, actors, dancers, acrobats, magicians, circus performers, comedians, etc. For persons who make performance art, considered a fine art and often seen in a museum, see \"performance artists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performing artists"@en .

aat:300068940 a skos:Concept ;
    skos:definition "Physical injury to a thing, such as impairs its value or usefulness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damage"@en .

aat:300068986 a skos:Concept ;
    skos:definition "Events where something is totally or partially consumed by fire, whether intentionally or by accident. For the process of altering, injuring, or consuming something by fire or heat, see \"burning.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fires"@en .

aat:300068991 a skos:Concept ;
    skos:definition "The state of low temperature or to describe processes or situations that take place under conditions of low temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold"@en .

aat:300069002 a skos:Concept ;
    skos:definition "The bringing into existence of the world or universe, usually by a deity or supernatural force, either making the universe out of nothing, or fashioning pre-existing materials into the universe. As defined by many historical and some current religions, the beginning of the world as an event from which the reckoning of time begins. Most modern religions reconcile the doctrine with scientific theory by treating the literary tradition of creation stories, such as in the Bible, as allegory, while some consider the literary tradition of creation as fact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creation"@en .

aat:300069012 a skos:Concept ;
    skos:definition "Doors of several hinged horizontal sections, that slide up along tracks to end in a horizontal position over the space to be entered; common in the United States as garage doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overhead doors"@en .

aat:300069026 a skos:Concept ;
    skos:definition "Annual or multiannual commemorations, often occurring on the specific calendar date of the event remembered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anniversaries"@en .

aat:300069030 a skos:Concept ;
    skos:definition "Christian rituals or sacraments that vary by denomination, but always involve the immersion of a person in water, or the application of water by pouring or sprinkling; baptisms betoken the initiation of the baptized into the church. Baptism is symbolic of moral or spiritual purification or regeneration. When the baptized is a baby, it includes the naming of the infant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptisms"@en .

aat:300069034 a skos:Concept ;
    skos:definition "Confirmation ceremonies held in a synagogue on the occasion of a Jewish boy having reached the age of thirteen, regarded as the age of religious responsibility for males."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar mitzvahs"@en .

aat:300069042 a skos:Concept ;
    skos:definition "Traveling or seasonal amusement enterprises, consisting of sideshows, games of chance, rides, and other similar entertainments. For the festive period of balls, masquerades, parades, and general revelry held in the pre-Lenten season, use \"Carnival (pre-Lenten festival).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnivals"@en .

aat:300069049 a skos:Concept ;
    skos:definition "Refers to days on which custom or the law dictates a suspension of general business activity to commemorate or celebrate particular events. Originally derived from \"holy days,\" which are in modern usage called \"religious holidays\": for religious feast days or holy days that are specified for religious observance, use \"religious holidays.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holidays"@en .

aat:300069053 a skos:Concept ;
    skos:definition "Refers to the Christian feast and festival observed on December 25 to celebrate the birth of Jesus Christ. Its observance is first documented in Rome in 336. The practice of celebrating on December 25 began in the 4th century in the Western church as a Christian replacement for the pagan festival held on the winter solstice to celebrate the birth of the unconquered sun. The East originally gave the date of January 6 for the nativity but the date of December 25 was generally accepted by the 5th century; the Armenian Church, however, still celebrates on January 6. Christmas took on the festivity (i.e. decorations and gift-giving) of the Roman Saturnalia and other pagan festivals of that time of year. Christmas has continued to accumulate traditions over the centuries; many of the customs associated with the holiday are of non-Christian origin. Evergreens, for example, are symbols of survival and have been associated with Christmas ever since the European Middle Ages. Christmas is traditionally regarded as a festival of the family and of children. In many countries presents are exchanged in the name of or in the spirit of the holiday's patron, Saint Nicholas, or Santa Claus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christmas"@en .

aat:300069057 a skos:Concept ;
    skos:definition "Refers to the principal festival and feast of the Christian church in which the resurrection of Jesus Christ is celebrated. In Western churches it is observed between March 22 and April 25 depending on the date of the first full moon after the vernal equinox. Orthodox churches use the Julian date for the equinox and so usually celebrate Easter on a different, later date. The name may derive from 'Eostre,' the name of an Anglo-Saxon spring goddess. Some traditions associated with Easter (e.g. Easter eggs, the Easter rabbit) have pagan origins. Easter evolved from the primitive Christian feast known as the Pasch of the 2nd and 3rd centuries; it was the Christian counterpart to the Jewish festival of Passover and it commemorated both Christ's death and Christ's resurrection. The paschal vigil is the main celebration of Easter in liturgical churches and is held on the night before; the paschal candle was introduced in about the 4th century. While the festival of Easter occurs on one particular Sunday, its importance is emphasized by the long preparation of Lent, by the solemn services of Holy Week, and by the following fifty days until Pentecost, a period known as Eastertide or Paschaltide. Easter's importance is reflected in the fact that the entire liturgical year of worship is arranged around it, as is the ecclesiastical calendar of movable feasts. There are many allusions to baptism in Easter services, reflecting the early practice of baptizing catechumens during the vigil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Easter"@en .

aat:300069061 a skos:Concept ;
    skos:definition "Holiday in the United States and some other countries, intended for giving thanks for a good harvest and other blessings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thanksgiving"@en .

aat:300069065 a skos:Concept ;
    skos:definition "Biomorphic forms or images are ones that while abstract nevertheless refer to, or evoke, living forms such as plants and the human body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biomorphic abstraction"@en .

aat:300069078 a skos:Concept ;
    skos:definition "Vertical members in woodwork or furniture, such as in a door, a sash, or a chest of drawers, into which secondary members are fitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stiles"@en .

aat:300069079 a skos:Concept ;
    skos:definition "Distinct portions, sections, or divisions of a surface, especially when sunk below or raised above the general level or enclosed by a frame or border. Common on walls, ceilings, and doors, and also on furniture pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panels"@en .

aat:300069080 a skos:Concept ;
    skos:definition "Any of various horizontal structural members in a frame or paneling, as in a window sash, paneled door, or chest of drawers, or joining the vertical posts of furniture, as in the crest rail of a chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rails"@en .

aat:300069081 a skos:Concept ;
    skos:definition "The vertical members forming the sides of doorways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorjambs"@en .

aat:300069082 a skos:Concept ;
    skos:definition "Rough wood or metal subframes, set in a wall, to which finished doorframes are attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door bucks"@en .

aat:300069084 a skos:Concept ;
    skos:definition "Occurrences taking place during a particular interval of time. The term is much broader in meaning than the scope of the facet also called \"Events.\" While the facet includes only terms referring to general events, the actual term \"events\" may be used to index these as well as specific named events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "events"@en .

aat:300069086 a skos:Concept ;
    skos:definition "Events related to the instruction and training of people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational events"@en .

aat:300069089 a skos:Concept ;
    skos:definition "Events surrounding the sale of goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sales events"@en .

aat:300069091 a skos:Concept ;
    skos:definition "Ceremonies at which degrees or diplomas are conferred by an educational institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commencements"@en .

aat:300069092 a skos:Concept ;
    skos:definition "Assemblies of members of a college or university to observe a particular ceremony, such as the opening of the academic year or the announcing of prizes, awards, and honors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convocations"@en .

aat:300069093 a skos:Concept ;
    skos:definition "Observances, usually celebratory in nature, marking the anniversary of someone's birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birthdays"@en .

aat:300069095 a skos:Concept ;
    skos:definition "Occasions, usually religious, where the tone is solemn and activities are marked by abstaining from food and drink for all or most of the day or series of days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fasts"@en .

aat:300069097 a skos:Concept ;
    skos:definition "Celebratory occasions, either joyous or solemn, at which elaborate or ritual meals are a central feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feasts"@en .

aat:300069124 a skos:Concept ;
    skos:definition "Observances or rites related to religious practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious ceremonies"@en .

aat:300069125 a skos:Concept ;
    skos:definition "Rites or observances related to the construction of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building ceremonies"@en .

aat:300069146 a skos:Concept ;
    skos:definition "Rites or sacraments administered as a reaffirmation of a particular religious faith. Examples are the rites administered to baptized persons in various Christian churches, intended to bestow a special grace upon the recipient that confirms or strengthens their Christian faith."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confirmations"@en .

aat:300069158 a skos:Concept ;
    skos:definition "Ceremonies or rites joining a couple in matrimony, with its attendant festivities. For the state of marriage, use \"marriage (social construct).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weddings"@en .

aat:300069162 a skos:Concept ;
    skos:definition "Ceremonies or rites held in connection with the burial or cremation of the body of a deceased person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerals"@en .

aat:300069164 a skos:Concept ;
    skos:definition "The platforms between flights of stairs, or at the termination of a flight of stairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landings"@en .

aat:300069180 a skos:Concept ;
    skos:definition "Ceremonies formally admitting someone into a community, organization, or other group, or investing them with a particular role or status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initiations"@en .

aat:300069188 a skos:Concept ;
    skos:definition "Generally, competitions in games, sports, and combat in which many contestants compete for championship in a series of elimination contests. Use specifically for contests of mock combat engaged in by two groups of combatants, either mounted on horseback or on foot. They were traditional events among European aristocracy from Medieval times into the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tournaments"@en .

aat:300069189 a skos:Concept ;
    skos:definition "Passages through fences or walls separating two exterior spaces, or the structures or ornamental constructions enclosing such passages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gateways"@en .

aat:300069193 a skos:Concept ;
    skos:definition "Art having a primary or secondary purpose of teaching, such as art intended to convey a moral theme or other truth to the viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "didactic art"@en .

aat:300069200 a skos:Concept ;
    skos:definition "Instances of the execution of an action, operation, or process in performing a literary, artistic, musical, theatrical, or other creative work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performances"@en .

aat:300069206 a skos:Concept ;
    skos:definition "Parts or components of gateways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gateway components"@en .

aat:300069210 a skos:Concept ;
    skos:definition "Musical performances, typically public and consisting of a series of separate songs or pieces; may include a number of singers or musicians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concerts"@en .

aat:300069235 a skos:Concept ;
    skos:definition "Performances that include trained animal acts or exhibitions of human skill and daring, or both. Circuses usually include a trained, traveling company or troupe of performers, various animals, and their equipage. The term \"circus\" refers to the circular arena surrounded by tiers of seats below which the performance occurs in a circular area called the \"ring.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circuses"@en .

aat:300069240 a skos:Concept ;
    skos:definition "Entertainments, frequently held in the open air, illustrating themes by means of spectacle rather than by consecutive narrative and dramatic characterization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pageants"@en .

aat:300069256 a skos:Concept ;
    skos:definition "Formal or ceremonial inductions, investitures, or installations of a person to an office or dignity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inaugurations"@en .

aat:300069272 a skos:Concept ;
    skos:definition "Formal dedications and settings apart by a cleric or other religious dignitary of buildings, plots of land, or objects for ceremonial or religious purposes. For the bestowings of a sacred office upon a person, use \"ordinations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consecrations"@en .

aat:300069274 a skos:Concept ;
    skos:definition "Acts or rites of setting aside something or someone to a special use or purpose, or to the memory of particular people or events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dedications"@en .

aat:300069276 a skos:Concept ;
    skos:definition "Acts or ceremonies of removing the sacred character of a thing or place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deconsecrations"@en .

aat:300069279 a skos:Concept ;
    skos:definition "Journeys, usually long, undertaken as acts of homage or devotion, often to a shrine, birthplace, or sacred site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrimages"@en .

aat:300069281 a skos:Concept ;
    skos:definition "The festive period of balls, masquerades, parades, and general revelry held in the pre-Lenten season, over periods of time ranging from between Christmas and Shrove Tuesday to the last few days before Lent, varying from one country or city to another. For traveling or seasonal amusement enterprises consisting of sideshows, games of chance, rides, and other similar entertainments, use \"carnivals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carnival"@en .

aat:300069283 a skos:Concept ;
    skos:definition "Large public processions of a festive nature, often including floats and marching bands, and held in honor of an anniversary, person, or event. For occasions where a group of people move in orderly succession in a formal, ceremonial context, use \"processions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parades"@en .

aat:300069290 a skos:Concept ;
    skos:definition "Occasions consisting of a group of people moving in orderly succession in a formal ceremonial context. For large public processions of a festive nature, often including floats and marching bands and held in honor of an anniversary, person, or event, use \"parades.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processions"@en .

aat:300069303 a skos:Concept ;
    skos:definition "Certain approaches to architecture that rely on a rethinking of architectural problems rather than on tradition, especially the specific movements in France and England in the 18th and 19th centuries, and in Italy in the 1920s. Adherents of rationalism maintained that architectural structure should take priority over form, ornamentation, and historical reference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rationalism"@en .

aat:300069306 a skos:Concept ;
    skos:definition "The aesthetic quality of the permanent, essential, or eternal character of appearances or other phenomena, which is rooted in an idea of perfection or archetype. It is ultimately derived from from Plato's \"Theory of Ideas,\" which holds that perfection is a concept that is only mirrored imperfectly in real life. This perfection was the ideal to which artists sought to strive in certain periods, styles, or contexts. The concept was particularly evident in various periods of antique art, the Renaissance, and in the 17th- and 18th-century art academies throughout Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ideal, the"@en .

aat:300069311 a skos:Concept ;
    skos:definition "Openings on surfaces intended to help emit or disperse light into areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toplighting openings"@en .

aat:300069319 a skos:Concept ;
    skos:definition "Heavy glass set into a pavement to convey light to a space below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavement lights"@en .

aat:300069325 a skos:Concept ;
    skos:definition "The theory, art, or study of the nature and function of poetry and with identifying and describing its types, forms, and techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poetics"@en .

aat:300069331 a skos:Concept ;
    skos:definition "In art, harmony or fitness in the adaptation of the parts of a whole to each other; often, studied elegance of design or arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concinnity"@en .

aat:300069335 a skos:Concept ;
    skos:definition "An Italian word meaning design or drawing, referring broadly and theoretically to the conception of a work of art, incorporating the idea that drawing was the foundation of art; the theory was expounded in Renaissance Italy, particularly in Tuscany. By extension, in Mannerist art theory the term refers to the work of art in ideal or Platonic form which could exist only in the artist's mind. The term is contrasted to \"colorito\" or \"colore,\" which is the application and use of color in a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disegno"@en .

aat:300069339 a skos:Concept ;
    skos:definition "The act, process, or instance of representing in a medium; something that manifests, embodies, or symbolizes something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expression"@en .

aat:300069349 a skos:Concept ;
    skos:definition "Feast days or other days that are specified for religious observance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious holidays"@en .

aat:300069381 a skos:Concept ;
    skos:definition "Two closely spaced windows which form a pair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupled windows"@en .

aat:300069389 a skos:Concept ;
    skos:definition "Slender windows with lancet arches at the top, common in Gothic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lancet windows"@en .

aat:300069390 a skos:Concept ;
    skos:definition "Participation by workers and residents in the design of the spaces, structures, or communities which they use or inhabit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "participatory design"@en .

aat:300069395 a skos:Concept ;
    skos:definition "Removal of water vapor from air by chemical or physical methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dehumidification"@en .

aat:300069400 a skos:Concept ;
    skos:definition "Irregularities in the surface or structure of something that spoil appearance or cause weakness or failure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defects"@en .

aat:300069405 a skos:Concept ;
    skos:definition "A Jewish festival and holiday commemorating the first and most momentous event in Jewish history: the liberation of the Hebrews from bondage in Egypt and the \"passing over\" of God of the houses of the Isrealites during the tenth plague of Egypt (when the first-born children of the Egyptians were killed). Passover begins on the 15th and ends on the 21st or 22nd day of the month of Nisan (March or April). On these seven (or eight) days, also called the Festival of Unleavened Bread, all leaven is prohibited, and only unleavened bread (matzo) may be eaten. The matzo symbolizes the Hebrews' suffering while in slavery and the haste with which they left Egypt during the Exodus. After the destruction of the Temple in Jerusalem, Passover celebrations became home-based. The first night of Passover is particularly celebratory, with a special family meal called the seder. Symbolic foods commemorating the Hebrews' liberation are eaten at the seder and prayers and traditional recitations are performed. Custom also calls for a place to be set for Elijah, the herald of the messiah. Though Passover is one of great rejoicing, strict dietary laws must be observed, and there are certain restrictions regarding work at the beginning and end of the festival."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passover"@en .

aat:300069407 a skos:Concept ;
    skos:definition "Jewish ritual services and ceremonial dinners held on the first evening of the Passover and repeated on the second evening by Orthodox Jews outside Israel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seders"@en .

aat:300069410 a skos:Concept ;
    skos:definition "Openings located in fortresses or fortified structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortification openings"@en .

aat:300069411 a skos:Concept ;
    skos:definition "Drawings created by artists qualified to teach apprentices and to carry on their trade independently. This term is usually applied to works created before 1800."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master drawings"@en .

aat:300069413 a skos:Concept ;
    skos:definition "Drawings intended to work out the scheme of a project, whether the project is expected to be executed or not; more finished than sketches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design drawings"@en .

aat:300069415 a skos:Concept ;
    skos:definition "Windows designed for use in mental institutions, characterized by heavy intermediate sections, restricted glass sizes and ventilator heights, plus special screens and hardware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychiatric windows"@en .

aat:300069416 a skos:Concept ;
    skos:definition "Finished drawings presented by the artist to a friend or patron; usually used with regard to the Renaissance-Baroque period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation drawings"@en .

aat:300069417 a skos:Concept ;
    skos:definition "Several windows set directly adjacent, without intervening wall space, so as to form a horizontal band of fenestration; found in buildings of Modernist style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon windows"@en .

aat:300069430 a skos:Concept ;
    skos:definition "Drawings preliminary to other works of art that are actually incorporated into those works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underdrawings"@en .

aat:300069431 a skos:Concept ;
    skos:definition "Small round or oval openings, such as windows in a wall or openings in the crown of a dome. For the design motif in the shape of an eye, use \"eyes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oculi"@en .

aat:300069449 a skos:Concept ;
    skos:definition "Windows having one or more rotatable sashes which swing either inward or outward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projected windows"@en .

aat:300069451 a skos:Concept ;
    skos:definition "Events intended to entertain audiences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entertainment events"@en .

aat:300069452 a skos:Concept ;
    skos:definition "Actions or processes surrounding the conferring of holy orders, or otherwise appointing or admitting a person to the ministry of a priesthood of the Christian church another another religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordinations"@en .

aat:300069454 a skos:Concept ;
    skos:definition "Performances by a soloist or a small group, typically referring to musical recitals of a single musical piece or a selection of music, but may also refer to similar performances of dance or drama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recitals"@en .

aat:300069456 a skos:Concept ;
    skos:definition "Holidays celebrating the year about to begin or just beginning; many cultures celebrate the new year, usually according to their own calendars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Year's Day"@en .

aat:300069473 a skos:Concept ;
    skos:definition "Refers broadly to artworks in a variety of styles that incorporate some aspect of motion, including machines, mobiles, and actual objects in motion. Orginating between 1913 and 1920 with the works of Marcel Duchamp, Naum Gabo, and Vladamir Tatlin, the style reached its peak in the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kinetic Art"@en .

aat:300069478 a skos:Concept ;
    skos:definition "Term applied to digital art works that emphasize the computer’s role in thier creation and apprehension. Specifically used for artworks that employ computer terminals or technology for display, distribution, or interaction, so that the machinery is an integral part of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer art"@en .

aat:300069482 a skos:Concept ;
    skos:definition "Windows of a type commonly used in residential basements, usually having between one and three lights only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basement windows"@en .

aat:300069485 a skos:Concept ;
    skos:definition "Windows designed to meet the requirements of school buildings, usually featuring large multipaned glass areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classroom windows"@en .

aat:300069495 a skos:Concept ;
    skos:definition "Framed areas of fixed glass alongside a door or window opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side lights"@en .

aat:300069526 a skos:Concept ;
    skos:definition "Refers to the style of Medieval glazed pottery in the Humber/Trent river area of northern England, generally beginning in the 12th century and lasting through the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Humber"@en .

aat:300069563 a skos:Concept ;
    skos:definition "Durable floor coverings made primarily of linseed oil, with a filler of cork dust or wood flour, and flax, with pigments added to create the desired colors and patterns; also, similar floor coverings made with substitutes for the linseed oil or filler or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linoleum"@en .

aat:300069614 a skos:Concept ;
    skos:definition "Occasions of celebration or merrymaking by groups of people. For larger and more formal occasions of celebration, use \"festivals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parties"@en .

aat:300069616 a skos:Concept ;
    skos:definition "Refers to occasions when a preselected group passes judgement on the work of artists, architects, and architectural or other students."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juries"@en .

aat:300069619 a skos:Concept ;
    skos:definition "Social gatherings for dancing, especially events where people belonging to a common group, establishment, society, or profession gather and sometimes having an organized program and special entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balls"@en .

aat:300069622 a skos:Concept ;
    skos:definition "Parties or formal social gatherings, particularly after a wedding, at which a person or persons are honoured or welcomed, and at which guests may be formally received."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "receptions"@en .

aat:300069624 a skos:Concept ;
    skos:definition "The Jewish New Year, celebrated on 1 Tishri (in September or October). According to Jewish tradition, this is considered the day on which all humans are judged and it ushers in a 10-day period of self-examination and penitence. During these ten days, all Jews should review his or her relationship with God, the Supreme Judge. During the service for this holiday a shofar is blown as a call for spiritual renewal and repentance. As the holiday is also known as the Day of Remembrance, it is a time for Jews to commemorate the creation of the world (created during the month of Tishri) and to recall their responsibilities as God's chosen people. It is customary to eat sweets as good omens of the sweet year ahead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosh Hashanah"@en .

aat:300069626 a skos:Concept ;
    skos:definition "The most important and solemn holiday in the Jewish liturgical calendar, observed on 10 Tishri (September or October). This day, which concludes the \"ten days of repentance\" that begin with Rosh Hoshanah, is a day of atonement and reconciliation with God. Jews must abstain from food, drink, and sex and all work must cease. In the Bible, Yom Kippur is referred to as \"Shabbat Shabbaton,\" meaning \"Sabbath of Solemn Rest\" or \"Sabbath of Sabbaths.\" Extremely Orthodox Jews may wear long white robes called kippelot and may forbid the wearing of leather and the anointing with oil. The evening before and the entire day of Yom Kippur are spent in prayer and meditation. Asking for and obtaining forgiveness from others signifies the forgiveness of God. Yom Kippur services are concluded with closing prayers and the blowing of the shofar. Before the destruction of the Temple in Jerusalem, the high priest performed an elaborate sacrificial ceremony that ended with a goat (the scapegoat) being driven into the wilderness, symbolically carrying the sins of Israel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yom Kippur"@en .

aat:300069629 a skos:Concept ;
    skos:definition "The Jewish autumn festival celebrated in September or October (15-21 Tishri) as a festival of thanksgiving. Sukkot is one of three Jewish pilgrim festivals. In biblical times the festival was associated with the agricultural year. Following the tradition established in Leviticus (23: 42), 'booths' or temporary shelters are built in homes, gardens, and synagogues in memory of the huts used by the Israelites after leaving Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sukkot"@en .

aat:300069632 a skos:Concept ;
    skos:definition "Jewish religious season commemorating the rededication of the Second Temple of Jerusalem after its desecration. Marked by the rite of lighting the menorah, symbolic of the Talmud story in which the small supply of nondesecrated oil, enough for one day, miraculously burned in the Temple for eight full days. Gifts are also exchanged and children play holiday games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanukkah"@en .

aat:300069634 a skos:Concept ;
    skos:definition "Refers to the Friday before Easter during Holy Week. On this day the crucifixion of Jesus Christ is commemorated. It is a day of penance in liturgical churches. Good Friday and the following day (Holy Saturday) are the only days of the years on which mass is not celebrated in the Roman Catholic Church. The rite includes the veneration of the cross and communion with hosts consecrated on Maundy Thursday. Good Friday is kept as a feast rather than as a fast in some Protestant churches and is considered a special celebration of the Lord's Supper. The Three Hours Service is the main service of Good Friday in many denominations. The day is known as Great Friday in Eastern Orthodox churches. Some denominations come together to celebrate Good Friday as an expression of Christian unity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Good Friday"@en .

aat:300069636 a skos:Concept ;
    skos:definition "Refers to the first day of Lent, occuring 6 1/2 weeks before Easter. The name comes from the practice of marking the foreheads of clergy and worshippers with ash. Typically the ash comes from burning the palms used on the previous Palm Sunday. It is the only other day besides Good Friday for which fasting is prescribed by the Roman Catholic Church. Ash Wednesday is also observed in the Anglican, Lutheran, and some other Protestant churches. Eastern Orthodox churches do not observe Ash Wednesday because Lent begins on a Monday in their calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ash Wednesday"@en .

aat:300069640 a skos:Concept ;
    skos:definition "Refers to a major Christian festival commemorating Christ's ascension into heaven. The festival has been observed 40 days (i.e. the fifth Thursday) after Easter in both the Eastern and Western churches since the 4th century. Ascension Day celebrates the kingship of Christ, Christ's entry into heaven with human nature glorified, and the completion of the work of the salvation of believers in Christ (through the final redemptive act of the Ascension). In the Middle Ages the festival included a procession to remember Christ's journey to the Mount of Olives, the traditional site of the Ascension. Another early practice was to raise a crucifix or a statue of the risen Christ through an opening in the church roof; this was sometimes accompanied by a figure of the devil made to descend at the same time. A distinctive feature of the Western liturgy of Ascension Day is the extinguishing of the Paschal candle after the Gospel has been read. The Paschal candle, which is first lit on Easter, is extinguished as a symbol of Christ's leaving the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ascension Day"@en .

aat:300069649 a skos:Concept ;
    skos:definition "Confirmation ceremonies held on the occasion of a Jewish girl having reached the age of twelve, regarded as the age of religious majority for females."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bat mitzvahs"@en .

aat:300069655 a skos:Concept ;
    skos:definition "Vigils held over the dead prior to burial, often accompanied by festivities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wakes"@en .

aat:300069657 a skos:Concept ;
    skos:definition "Forms of competitive play, usually involving an element of strategy, especially to interfere with an opponent's play; may or may not require physical skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "games"@en .

aat:300069660 a skos:Concept ;
    skos:definition "Ceremonies surrounding the accession to power of a sovereign, or the consort of a sovereign; typically involves bestowing a crown as an emblem of royal dignity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronations"@en .

aat:300069662 a skos:Concept ;
    skos:definition "Refers to all forms of parallel projection, particularly where at least one of the three spatial axes is inclined to the plane of projection or picture surface. It is often used to refer to projections depicted as if a plan were drawn to scale, and the plan is then tilted at a 45 degree angle to provide a third dimension, typically height, which is drawn to the same scale as the plan. This system for projection depicts both the plan and volume simultaneously and with a consistent measurement, without the distortion caused by the converging lines of one-point perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axonometric projection"@en .

aat:300069664 a skos:Concept ;
    skos:definition "Refers to a technique for representing three-dimensional objects in two dimensions by using parallel projecting lines that are perpendicular to the plane of projection or picture surface. Principal surfaces of objects are parallel to the picture plane. It does not include foreshortening, shifts in scale and proportion, or other distortions that would be caused by employing linear perspective. It is often used for technical and architectural drawings, including plans, sections, and elevations. It is also used to create azimuthal projections of the Earth or another heavenly body as seen from space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthographic projection"@en .

aat:300069665 a skos:Concept ;
    skos:definition "The examination and determination of a cause by a judicial tribunal, often including determination of the guilt or innocence of an accused person by a court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trials"@en .

aat:300069671 a skos:Concept ;
    skos:definition "Events related to the life cycles of human beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal life events"@en .

aat:300069676 a skos:Concept ;
    skos:definition "Acts of unlawful killing of human beings by others with malice aforethought."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "murders"@en .

aat:300069678 a skos:Concept ;
    skos:definition "The act of dying by one's own hand. The act of dying by one's own hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suicides"@en .

aat:300069680 a skos:Concept ;
    skos:definition "Actions causing the infliction of the punishment of death in pursuance of a judicial sentence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executions"@en .

aat:300069682 a skos:Concept ;
    skos:definition "Murders of high public officials or other prominent persons, whether by persons acting alone or in conspiracy with others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assassinations"@en .

aat:300069688 a skos:Concept ;
    skos:definition "Events, separate from holidays and ceremonies, that relate to religious life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious events"@en .

aat:300069689 a skos:Concept ;
    skos:definition "Describes the compartments of windows or window sashes through which daylight may pass; for the divisions of openings each consisting of a single plate of glass, use \"panes (architectural elements).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lights"@en .

aat:300069691 a skos:Concept ;
    skos:definition "Meetings of inhabitants or taxpayers constituting the legislative authority of a town. Meetings of inhabitants or taxpayers constituting the legislative authority of a town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "town meetings"@en .

aat:300069710 a skos:Concept ;
    skos:definition "Occupations, amusements, or physical activities carried out by humans and animals for their own sake or for relaxation and entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreation"@en .

aat:300069715 a skos:Concept ;
    skos:definition "The activity of making something or carrying out a plan. In the context of visual works, refers to the carrying out and production of a work, as contrasted to the design phase of the creation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "execution"@en .

aat:300069726 a skos:Concept ;
    skos:definition "Parts or components of louvers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louver components"@en .

aat:300069730 a skos:Concept ;
    skos:definition "Includes small projecting covers serving to carry off the fumes from stoves, fireplaces, or laboratory benches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoods"@en .

aat:300069732 a skos:Concept ;
    skos:definition "Roof-like coverings of various kinds, not attached to four walls, but suspended by poles, cords, or attached on one side to a wall. Examples include coverings or hangings suspended over a throne, couch, bed, etc., or held over a person walking in procession, or an architectural roof-like ornamented projection, surmounting a niche, door, window, tomb, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canopies"@en .

aat:300069734 a skos:Concept ;
    skos:definition "General functions related to analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analytical functions"@en .

aat:300069735 a skos:Concept ;
    skos:definition "Providing direct cash support to another person or organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funding"@en .

aat:300069741 a skos:Concept ;
    skos:definition "Giving or letting out a thing or funds for temporary use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lending"@en .

aat:300069743 a skos:Concept ;
    skos:definition "Directly instructing others in knowledge, attitudes, or skills. For the acquiring or imparting of specific skills relating to particular functions or activities through instruction or practice, use \"training.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teaching"@en .

aat:300069747 a skos:Concept ;
    skos:definition "A manner of expression by the artist in which the subject matter is presented so that the observer is reminded of actual visible forms. However, the subject represented may or may not exist in the visible world. For example, representations may include presentations of subject matter that are invisible to the eye, such as emotions or imaginary events, as if they are visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "representation"@en .

aat:300069748 a skos:Concept ;
    skos:definition "The formal concept of the layout of spaces and elements in the built environment, such as of a building or city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plan"@en .

aat:300069755 a skos:Concept ;
    skos:definition "Use generally for conferences or courses of instruction for specialists. Use in an academic context for meetings of small groups of advanced students studying a subject in depth under a professor, each student doing some original research, and all exchanging results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seminars"@en .

aat:300069765 a skos:Concept ;
    skos:definition "Refers to relatively small instructional sessions or classes emphasizing demonstration and practical application of skills and principles in a specialized field or occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workshops"@en .

aat:300069787 a skos:Concept ;
    skos:definition "Systematic courses of aggressive activities designed to persuade or establish power over others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaigns"@en .

aat:300069793 a skos:Concept ;
    skos:definition "Organized series of actions designed to arouse public opinion throughout the country for or against some political object, or to influence voting at an election of members of the legislature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political campaigns"@en .

aat:300069796 a skos:Concept ;
    skos:definition "Horizontal members across a window or door opening near the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transoms"@en .

aat:300069799 a skos:Concept ;
    skos:definition "Trips, journeys, voyages, or excursions made for some definite purpose, often for military or scientific purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expeditions"@en .

aat:300069802 a skos:Concept ;
    skos:definition "Pieces of metal, wood, or other material used to cover joints around doors and windows to prevent drafts and to keep out rain and snow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weather strips"@en .

aat:300069806 a skos:Concept ;
    skos:definition "Rooms in or attached to a horse barn or stable for the storage and maintenance of riding tack and often of stud records or for the display of prizes or other honors of the stable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tack rooms"@en .

aat:300069809 a skos:Concept ;
    skos:definition "Roofs with sloping sides but a substantial flat area on top. When such a roof is hipped, it will resemble a truncated pyramid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform roofs"@en .

aat:300069831 a skos:Concept ;
    skos:definition "The activity of comprehending, analyzing, and expressing written or spoken material in a different language from the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "translation"@en .

aat:300069835 a skos:Concept ;
    skos:definition "Process of raising money for nonpersonal, noncommercial purposes, such as for nonprofit organizations or political concerns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fund raising"@en .

aat:300069853 a skos:Concept ;
    skos:definition "Carrying or sending articles of trade or commerce out of a country into another or others for sale or exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exporting"@en .

aat:300069856 a skos:Concept ;
    skos:definition "Regulating land use for stated purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoning"@en .

aat:300069904 a skos:Concept ;
    skos:definition "Roofs in which the slope is broken, the lower slope being steeper than the upper slope; may be two-sided or four-sided roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curb roofs"@en .

aat:300069918 a skos:Concept ;
    skos:definition "Refers to gable roofs on towers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddleback roofs"@en .

aat:300069924 a skos:Concept ;
    skos:definition "Establishing appointed times for events or for the start and completion of projects or series of events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scheduling"@en .

aat:300069942 a skos:Concept ;
    skos:definition "Describes art or architecture that is not distinctly Assyrian or Babylonian but has characteristics of both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assyro-Babylonian"@en .

aat:300069952 a skos:Concept ;
    skos:definition "The style and culture of the ancient Greco-Bactrian kingdom ruled by Greco-Macedonian monarchs, the easternmost part of the Hellenistic world, covering Bactria and Sogdiana (Afghanistan, Pakistan, part of India) in Central Asia from beginning in 250 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greco-Bactrian"@en .

aat:300070045 a skos:Concept ;
    skos:definition "Stone finished to a specific size and weight and squared to specific dimensions and thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimension stone"@en .

aat:300070050 a skos:Concept ;
    skos:definition "Dimension stone with a smooth exposed face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressed stone"@en .

aat:300070083 a skos:Concept ;
    skos:definition "Roofs in which the common rafters do not transfer their loads to secondary support members, such as rafters or purlins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-framed roofs"@en .

aat:300070114 a skos:Concept ;
    skos:definition "A matte, opaque water-soluble paint typically having gum arabic, gum senegal, or dextrin as a binder. Gouache differs from watercolor paints primarily through the addition of white fillers, such as chalk or baryte, which give it a higher opacity and matte surface quality. Gouache was used for miniature paintings in the 16th-18th centuries, for decorative paintings on interior walls, and for printing wall paper patterns. The term originally had a different meaning, referring to oil applied on top of tempera painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouache"@en .

aat:300070122 a skos:Concept ;
    skos:definition "Roofs in which one or more of the hipped sides (usually two) are surmounted by gables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable-on-hip roofs"@en .

aat:300070131 a skos:Concept ;
    skos:definition "Roofs in which the common rafters rest on purlins which transfer the loads to principal rafters or trusses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-framed roofs"@en .

aat:300070136 a skos:Concept ;
    skos:definition "Structures appended to roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roof appendages"@en .

aat:300070138 a skos:Concept ;
    skos:definition "Rooftop pavilions intended as lookouts or for the enjoyment of a view. For unroofed platforms, use \"widows' walks\"; for rooftop structures that are primarily ornamental, use \"cupolas,\" for small pavilions, in a garden setting, intended for enjoyment of a view, use \"gazebos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belvederes"@en .

aat:300070186 a skos:Concept ;
    skos:definition "The works produced by an artist or composer regarded collectively. For the collective body of works by a writer, use \"corpora.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oeuvre"@en .

aat:300070228 a skos:Concept ;
    skos:definition "Parts or components of verges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verge components"@en .

aat:300070229 a skos:Concept ;
    skos:definition "Parts or components of horizontal roof frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizontal roof frame components"@en .

aat:300070230 a skos:Concept ;
    skos:definition "Short wood framing members nailed to the sides of joists or rafters to extend a roof or floor beyond an exterior wall line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lookouts"@en .

aat:300070233 a skos:Concept ;
    skos:definition "In roofing, strips of wood fixed to the upper side of rafters at the eaves, that raise the edge of the eaves and form a break in the roof line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprockets"@en .

aat:300070431 a skos:Concept ;
    skos:definition "Extreme form of skepticism that denies the objective reality of all values, beliefs, and truths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nihilism"@en .

aat:300070544 a skos:Concept ;
    skos:definition "Theory that there are no universal essences in reality, that the mind can frame no single concept or image corresponding to any universal or general term, and that only individual concrete entities have existence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nominalism"@en .

aat:300070643 a skos:Concept ;
    skos:definition "Highly toxic material used as a solvent for fat, wax, oil, and plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chlorinated hydrocarbon"@en .

aat:300070971 a skos:Concept ;
    skos:definition "Masonry walls that are constructed without mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry walls"@en .

aat:300071159 a skos:Concept ;
    skos:definition "Structural frames of monolithic reinforced concrete with walls and floors in the form of slabs creating a cellular appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box frames"@en .

aat:300071272 a skos:Concept ;
    skos:definition "Large imposing, and usually elegant and costly, dwellings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mansions"@en .

aat:300071887 a skos:Concept ;
    skos:definition "Metal members having a C- or U-shaped section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "channels"@en .

aat:300071924 a skos:Concept ;
    skos:definition "Metal members having an L-shaped section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angles"@en .

aat:300072215 a skos:Concept ;
    skos:definition "Covered spouted vessels for preparing and serving coffee. The term is often reserved for a decorative vessel made of ceramic, silver, or another material and used to transport and serve the coffee at table after it has been prepared in another vessel. Coffee pots typically have a handle and sometimes small feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffeepots"@en .

aat:300072219 a skos:Concept ;
    skos:definition "Systems designed to alert for and protect against various hazards, such as fire and security systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protection systems"@en .

aat:300072222 a skos:Concept ;
    skos:definition "Protection systems that provide safeguards to construction and exit facilities through the use of fire alarm, fire detecting, and fire extinguishing equipment to reduce the risk and spread of fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire protection systems"@en .

aat:300072226 a skos:Concept ;
    skos:definition "Installations of automatic sprinklers, foam distribution systems, fire hoses, and/or portable fire extinguishers designed for extinguishing fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire extinguishing systems"@en .

aat:300072237 a skos:Concept ;
    skos:definition "Bark cloth of Hawaii and other Polynesian Islands, made by pounding the bark of the paper mulberry, breadfruit, or other plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapa"@en .

aat:300072250 a skos:Concept ;
    skos:definition "Tracts set aside for recreation and located on land in contact with the sea, in submerged areas, along sea beds, or on emerged land areas near the sea coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine parks"@en .

aat:300072312 a skos:Concept ;
    skos:definition "The concept of the few outstanding works in which the artistic personality of a great artist finds its fullest expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masterpiece"@en .

aat:300072324 a skos:Concept ;
    skos:definition "Masonry courses of headers fastened together continuously by metal clamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain courses"@en .

aat:300072326 a skos:Concept ;
    skos:definition "Courses of brick or tile built into masonry walls for bonding and leveling purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacing courses"@en .

aat:300072347 a skos:Concept ;
    skos:definition "Masonry courses which project beyond the courses below; when referring to projecting structural elements, especially when used in a series to form arches, domes, or vaults, prefer \"corbels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oversailing courses"@en .

aat:300072496 a skos:Concept ;
    skos:definition "Designs that are rhetorical, reflecting a theoretical or speculative architectural position on social or political issues, often considered ahead of their time, and usually not intended to be carried out; often applied, but not necessarily restricted, to designs by certain French architects of the late 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visionary architecture"@en .

aat:300072513 a skos:Concept ;
    skos:definition "Solid figures or bodies having a finite number of plane faces (plane polygons). In general, polyhedrons are named according to number of faces (tetrahedron, pentahedron, hexahedron, etc.)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyhedra"@en .

aat:300072553 a skos:Concept ;
    skos:definition "Collocates records for elements developed originally or primarily as portions of built works, including architecture, landscape architecture, engineering, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "built work divisions"@en .

aat:300072597 a skos:Concept ;
    skos:definition "A measure of the spread of a set of numbers about their mean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standard deviation"@en .

aat:300072602 a skos:Concept ;
    skos:definition "Property of materials indicating solidity and firmness in substance or outline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardness"@en .

aat:300072604 a skos:Concept ;
    skos:definition "Refers to the belief in spiritual beings capable of influencing human events, based on the idea that animals, plants and even inanimate objects have souls like humans. The 19th-century anthropologist Edward Tylor thought it to be the earliest form of religion, a view not accepted by modern anthropologists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animism"@en .

aat:300072633 a skos:Concept ;
    skos:definition "Length of a straight line measured downward from a plane or surface, or inward from a plane or surface. For the measurement or extension through or between opposite surfaces, prefer \"thickness,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depth"@en .

aat:300072639 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Liquidambar, today native to North and South America and Asia. It is used for furniture, veneer, small decorative items, and for pulp for book paper. The reddish-brown heartwood is sold as \"red gum wood.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweet gum"@en .

aat:300072646 a skos:Concept ;
    skos:definition "Informal or formally organized cooperative living arrangements based on ideological, religious, or political affiliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communal living"@en .

aat:300072657 a skos:Concept ;
    skos:definition "Tension and compression forces that are collinear with the long axes of structural members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axial stress"@en .

aat:300072660 a skos:Concept ;
    skos:definition "Stress developed at the point of contact between two loaded structural members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bearing stress"@en .

aat:300072661 a skos:Concept ;
    skos:definition "Stress induced by loads perpendicular to the member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bending stress"@en .

aat:300072663 a skos:Concept ;
    skos:definition "Severe bending, warping, or bulging; in the case of a structural member, failure caused by lateral or torsional instability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckling"@en .

aat:300072676 a skos:Concept ;
    skos:definition "Bending or twisting stress in a structural member combined with direct tension or compression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combined stress"@en .

aat:300072678 a skos:Concept ;
    skos:definition "The deformation or movement of a structure and its flexural members (such as beams or trusses) from their original positions, due to loads and forces acting on that structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deflection"@en .

aat:300072682 a skos:Concept ;
    skos:definition "Buckling of a structural member involving lateral deflection and twist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lateral buckling"@en .

aat:300072684 a skos:Concept ;
    skos:definition "The measure of resistance of a body to angular acceleration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moment of inertia"@en .

aat:300072688 a skos:Concept ;
    skos:definition "In mechanics, the distance from the axis to a point, such that, if the whole mass of a body were concentrated at it, the moment of inertia would remain unchanged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radius of gyration"@en .

aat:300072692 a skos:Concept ;
    skos:definition "The moment of inertia of the area of the cross section of a structural member divided by the distance from the center of gravity to the farthest point of the section; a measure of the flexural strength of the beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "section modulus"@en .

aat:300072696 a skos:Concept ;
    skos:definition "The ratio of change in size or shape of elements subjected to stress to the original size or shape of those elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strain"@en .

aat:300072720 a skos:Concept ;
    skos:definition "A number, numerical quantity, or element in a field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scalars"@en .

aat:300072728 a skos:Concept ;
    skos:definition "Methodology of solving problems in statics by analysis using graphic methods such as diagrams, rather than pure mathematical and other calculations; for example, using a scale drawing of the associated forces and reactions in order to estimate effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic statics"@en .

aat:300072730 a skos:Concept ;
    skos:definition "Diagrams or graphs using lines that react as if they were cords or ropes; typically used for stress analysis in architecture, engineering, and related disciplines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funicular lines"@en .

aat:300072733 a skos:Concept ;
    skos:definition "Design of a beam that is proportioned to carry at ultimate capacity the design load multiplied by the safety factor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic design"@en .

aat:300072734 a skos:Concept ;
    skos:definition "Diagrams that represent open or closed figures that are not necessarily plane and that take a form as if a rope or cord were acted upon at a number of points by forces acting in various directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funicular polygons"@en .

aat:300072751 a skos:Concept ;
    skos:definition "Physical quantities with magnitude and direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vectors"@en .

aat:300072759 a skos:Concept ;
    skos:definition "Regions of a member where yielding occurs as loads are increased; the regions of highest moment that develop when all fibers are fully yielded at a cross section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic hinges"@en .

aat:300072768 a skos:Concept ;
    skos:definition "The increase in amplitude of oscillation of a mechanical system exposed to the periodic force of a naturally occurring or artificially induced earthquake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resonance"@en .

aat:300072856 a skos:Concept ;
    skos:definition "Refers to the ratios of pressure force to viscous force in fluid mechanics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shape factors"@en .

aat:300072878 a skos:Concept ;
    skos:definition "Ratio of the unit stress to unit strain within the elastic limit of a material without fracture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modulus of elasticity"@en .

aat:300072885 a skos:Concept ;
    skos:definition "An undesired oscillation in a part of a machine or structure under stress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flutter"@en .

aat:300072894 a skos:Concept ;
    skos:definition "The force per unit area that tends to cause deformation of a material by slippage along a plane or planes parallel to the imposed stress. In nature, this force is related to the downslope movement of earth materials and earthquakes. When shear stress occurs in liquids, it is related to fluid viscosity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shear stress"@en .

aat:300072926 a skos:Concept ;
    skos:definition "Stress developed as a result of a twisting or turning motion of a solid body about its axis of symmetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torsional stress"@en .

aat:300072929 a skos:Concept ;
    skos:definition "Diagrams or graphs that illustrate and calculate the shear stress, bending moment, or other effect of a movable load on a structural member versus the position of the load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "influence lines"@en .

aat:300072934 a skos:Concept ;
    skos:definition "Physics concepts related to the function of machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanics concepts"@en .

aat:300072974 a skos:Concept ;
    skos:definition "Floor plans taken near ground level and showing the foundation and ground floor of the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground plans"@en .

aat:300072976 a skos:Concept ;
    skos:definition "Any change of form, shape, or dimensions produced in a body by a stress or force without a breach of the continuity of its parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deformation"@en .

aat:300072979 a skos:Concept ;
    skos:definition "Slow, continuous deformation or movement of structures and landscape features under sustained pressure or downward pull, such as by gravity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creep"@en .

aat:300072982 a skos:Concept ;
    skos:definition "Drawings or works in another two-dimensional medium in which part of an object or structure is removed to show the interior. For orthographic drawings specifically, use \"broken-out sections,\" \"half sections\" (for objects), or \"sectional elevations\" (for structures)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutaways"@en .

aat:300072984 a skos:Concept ;
    skos:definition "Refers to perspective drawings having a viewpoint well above normal eye level; for other nonphotographic depictions from a high viewpoint, where perspective is not used or is not emphasized, use \"bird's-eye views.\" For photographs taken from high locations, use \"aerial views\" or \"aerial photographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird's-eye perspectives"@en .

aat:300072985 a skos:Concept ;
    skos:definition "Orthographic drawings that show a structure as partly an exterior elevation and partly an interior elevation. If only a small portion of exterior is taken away, use \"broken-out sections.\" For smaller, symmetrical objects shown as half exterior and half interior, use \"half sections.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectional elevations"@en .

aat:300072990 a skos:Concept ;
    skos:definition "Drawings at the same size as the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-scale drawings"@en .

aat:300073003 a skos:Concept ;
    skos:definition "Curtains which close the stage of a theater from the auditorium in case of fire, preventing the spread of flame and smoke; usually fabricated of woven asbestos and steel wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asbestos curtains"@en .

aat:300073022 a skos:Concept ;
    skos:definition "Quadrilateral figures in which both pairs of opposite sides are parallel to each other, especially used for such figures in which the sides do not intersect at right angles. For four-sided figures having right angles, the terms \"square\" or \"rectangle\" are more commonly used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallelograms"@en .

aat:300073061 a skos:Concept ;
    skos:definition "Water droplets condensed from the air, usually at night, onto cool surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dew"@en .

aat:300073063 a skos:Concept ;
    skos:definition "Precipitation consisting of generally transparent frozen or partially frozen raindrops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleet"@en .

aat:300073132 a skos:Concept ;
    skos:definition "The interpersonal behavior regulator, which covers the defining of a space, and the creation of visible and invisible boundaries to that space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "territoriality"@en .

aat:300073212 a skos:Concept ;
    skos:definition "A term used to indicate that a quantity grows without bound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infinity"@en .

aat:300073222 a skos:Concept ;
    skos:definition "The husbanding and efficient use of energy resources so as to extend non-renewable supplies or to make the most cost-effective use of renewable supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "energy conservation"@en .

aat:300073244 a skos:Concept ;
    skos:definition "The acts or processes of adding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summations"@en .

aat:300073252 a skos:Concept ;
    skos:definition "Refers to the gaseous products of burning materials, especially of organic origin, made visible by the presence of small particles of carbonaceous matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoke"@en .

aat:300073254 a skos:Concept ;
    skos:definition "Numerical values given to materials that designate their resistance to fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flame spread ratings"@en .

aat:300073256 a skos:Concept ;
    skos:definition "A disruptive often luminous charge around or over the surface of an insulator, usually due to high voltage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flashover"@en .

aat:300073261 a skos:Concept ;
    skos:definition "Ceremonial events that are related to culture or background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural ceremonies"@en .

aat:300073437 a skos:Concept ;
    skos:definition "The doctrinal concept that some aspect of the self or soul can be reborn any number of times in a new body (animal or human) after death. Fundamental to a number of Eastern religions such as Hinduism and Buddhism, this belief is also found in some modern Western belief systems such as theosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reincarnation"@en .

aat:300073472 a skos:Concept ;
    skos:definition "Gala occasions devoted to community observances, such as harvests or anniversaries of notable persons; also cultural events consisting typically of a series of performances of works in the arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festivals"@en .

aat:300073488 a skos:Concept ;
    skos:definition "Drawings, especially from the late Middle Ages and Renaissance, that served as exemplars in the workshop, either for apprentice copying or for transfer to final works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern drawings"@en .

aat:300073497 a skos:Concept ;
    skos:definition "Geometrical shapes or patterns made up of identical parts, which are in turn identical to the overall pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fractals"@en .

aat:300073642 a skos:Concept ;
    skos:definition "Sheds for railway engines built around a central turntable, and often circular or semicircular in plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheelhouses"@en .

aat:300073690 a skos:Concept ;
    skos:definition "Physics concepts that deal with energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "energy-related concepts"@en .

aat:300073708 a skos:Concept ;
    skos:definition "Belief systems that encompass various personal and institutional relationships between human beings and what they regard as holy, sacred, or divine, usually but not always a deity, or a spiritual or occult force. Participation in a religion is typically manifested in obedience, reverence, and worship, often including group activities and alliance with a leader. Elements of a religion or similar belief system include doctrine, ritual, defined parameters of morality, and a code of living, often seen as a means of achieving spiritual or material improvement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religions"@en .

aat:300073711 a skos:Concept ;
    skos:definition "Refers to the world religion and culture that developed in the first century CE, driven by the teachings of Jesus Christ of Nazareth. Its roots are in the Judaic tradition and the Old Testament. The tenets include a belief in the death and redemptive resurrection of Jesus. The religion incorporates a tradition of faith, ritual, and a form of church authority or leadership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christianity"@en .

aat:300073715 a skos:Concept ;
    skos:definition "Refers to the religious beliefs and social practices founded in the seventh century by the Arabian Prophet Muhammad, held to be the last of a series of major prophets, which include, according to Islamic dogma, Adam, Noah, and Jesus. It later spread throughout the Middle East, Africa, Europe, and parts of Asia. It is characterized by the belief in the fundamental idea that a devotee 'surrenders' and submits his will to Allah, the prime creator and sustainer of the universe and all creation. In Islam, God is unique and has no partner or intermediary as in the Christian Trinity. Social service and the active alleviation of suffering in others is considered the only path to salvation and prayer and sacred ritual alone are inadequate forms of submission to Allah. The Qur'an (Koran), the sacred text of the religion, is a compilation of revelations from Allah believed to have been received by Muhammad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islam"@en .

aat:300073723 a skos:Concept ;
    skos:definition "Refers to the monotheistic religion of the Jewish people, central to which is the belief that the ancient Israelites experienced God's presence in human events. Jews believe that the one God delivered the Israelites out of bondage in Egypt, revealed the structure of communal and individual life to them, and chose them to be a holy nation of people able to set an example for all humankind. The Hebrew Bible and Talmud are the two primary sources for Judaism's spiritual and ethical principles. The religion, which traces its origins to Abraham, places more emphasis on expressing beliefs through ritual rather than through abstract doctrine. The Sabbath, beginning on sunset on Friday and ending at sunset on Saturday, is the central religious observance; there is also an annual cycle of religious festivals and days of fasting. Judaism has had a diverse history of development over almost 4000 years, with a number of resulting branches in modern times, namely Orthodox, Conservative, and Reform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Judaism"@en .

aat:300073727 a skos:Concept ;
    skos:definition "General term for the set of intellectual and philosophical tenets and highly diverse beliefs and practices that define the civilization, art, literature, society, and politics of the Indian subcontinent. Hinduism is not a common set of rigid beliefs , but varies significantly between different regions; it includes Shaivism, Vaishnavism, Srauta, and numerous other traditions. Among other practices and philosophies, Hinduism includes a wide spectrum of laws and prescriptions of \"daily morality\" based on karma, dharma, and societal norms. The highest divine powers are seen as complementary to one another and not exclusive. Hinduism does not have a particular founder or central authority. Hindu literature is rich and varied, with no one text considered uniquely authoritative. The Vedas, dating to the Vedic period (ca. 1200-500 BCE), are the earliest extant writings. Religious law books and epics such as the Ramayana and the Mahabharata have been and continue to be highly influential."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hinduism"@en .

aat:300073730 a skos:Concept ;
    skos:definition "Refers to the branch of Christianity characterized by a uniform, highly developed ritual canon and organizational structure with doctrinal roots based in the teachings of the Apostles of Jesus Christ in the first century, in the Alexandrian school of theology, and in Augustinian thought. In this religious branch, faith is considered an acceptance of revelation; revelation appears as doctrine. In juridical terms, it refers to the branch of Christianity distinguished as a unified, monolithic sacramental system under the governance of papal authority. Throughout much of its history, the seat of the Pope has been in Rome, thus \"Roman Catholicism\" is often used to distinguish this concept from the Orthodox Catholic church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman Catholicism"@en .

aat:300073735 a skos:Concept ;
    skos:definition "The general term for types of Christian faith originating from the Reformation. Although the early forms of Protestantism were those who followed Luther, Calvin, and Zwingli, the term now includes most non-Roman Catholic or non-Orthodox denominations. Protestants want to be closer to the style of faith of the early Church which they feel has been obscured in Catholic practices. The term derives from the word 'protestari' which means not only to protest but to avow or confess. Common characteristics of Protestantism include the justification by faith alone, the authority of scripture, and the priesthood of all believers, in which not only the clergy are able to hear the confession of sin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protestantism"@en .

aat:300073738 a skos:Concept ;
    skos:definition "Refers to the philosophy and religion based on the enlightenment and teachings of the Buddha Gautama in the early sixth century BCE in the northeastern region of modern India. Playing dominant roles in the art and culture of Southeast Asia and East Asia, this religion is based on the transcendence of human suffering and pain through the acceptance of the limitations of individuality, the surrender of worldly desires and cravings that cause disappointment and sorrow, and the deliverance from the impermanence of living and individual ego based on wealth, social position, or family through the process of enlightenment (nirvana). The religion also centers around 'anatman', or no-self, the idea that the self is in a state of action or a series of changing manifestations rather than in a state of fixed, metaphysical substance. The structure of the religion is based on the Triratna (\"Three Jewels\" of Buddha), a tripartite schematic for living based on three elements: Buddha (the teacher), dharma (the teaching), and sangha (community)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhism"@en .

aat:300073751 a skos:Concept ;
    skos:definition "Ceilings divided into compartments or panels separated by moldings or ribs, particularly those in which the compartments or panels are not all uniform rectangles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compartment ceilings"@en .

aat:300073756 a skos:Concept ;
    skos:definition "Being more ample or extensive than usual in quantity, spatial extent, or transverse dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "large"@en .

aat:300073760 a skos:Concept ;
    skos:definition "Size that is very large, solid, and imposing; comparable to a monument in massiveness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumental"@en .

aat:300073768 a skos:Concept ;
    skos:definition "Of limited size or comparatively restricted dimensions, especially in comparison with other things of the same kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small"@en .

aat:300073775 a skos:Concept ;
    skos:definition "Ceilings covered with a material designed to absorb sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustical ceilings"@en .

aat:300073786 a skos:Concept ;
    skos:definition "Use with reference to the various interpretations of this phrase from Horace's Ars Poetica in relation to pictorial arts, literally translated \"as is painting so is poetry.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ut pictura poesis"@en .

aat:300073789 a skos:Concept ;
    skos:definition "A periodic motion or oscillation about equilibrium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vibration"@en .

aat:300073795 a skos:Concept ;
    skos:definition "The use of a lot or parcel of real property for a town or city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban land use"@en .

aat:300073799 a skos:Concept ;
    skos:definition "The overloading or overstraining of buildings to such an extent that they can no longer perform their required functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building failures"@en .

aat:300073855 a skos:Concept ;
    skos:definition "Rectangular or spiral stairs that wind around an open wellhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open newel stairs"@en .

aat:300073907 a skos:Concept ;
    skos:definition "Stairs with one flight up from the lower floor to the landing and two flights from the landing to the next floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double return stairs"@en .

aat:300073920 a skos:Concept ;
    skos:definition "Refers to the historicizing, classicizing movement in Italian painting of the 1980s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pittura Colta"@en .

aat:300073922 a skos:Concept ;
    skos:definition "Refers to the most heavily armored warships carrying the most powerful armament and deployed directly in the line of battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battleships"@en .

aat:300073927 a skos:Concept ;
    skos:definition "Parts or components of newels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newel components"@en .

aat:300073952 a skos:Concept ;
    skos:definition "Portions of stair handrails that are curved in both the vertical and horizontal planes, which occur where the handrail changes direction and slope; may also refer to strings of similar shape and location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wreaths"@en .

aat:300074185 a skos:Concept ;
    skos:definition "Beveled moldings, either having a beveled back for nailing into a corner or angle, or one whose face or profile is a cant or oblique surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cant moldings"@en .

aat:300075188 a skos:Concept ;
    skos:definition "Small, convex moldings of semicircular or greater profile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead moldings"@en .

aat:300075330 a skos:Concept ;
    skos:definition "Projecting, scroll-shaped architectural members serving as brackets or corbels. Often used to support entablatures and cornices over doorways and windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consoles"@en .

aat:300075331 a skos:Concept ;
    skos:definition "Refers to the topmost projecting element of a pedestal classically divided by tripartation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caps"@en .

aat:300075338 a skos:Concept ;
    skos:definition "Rooms designed or used for showing films on a large screen for a private audience, usually for a small audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screening rooms"@en .

aat:300075358 a skos:Concept ;
    skos:definition "The illusion of or erroneous perception of perspective; usually characterized by a subtly distorted depiction of three-dimensional objects, spatial relationships, and color, and by the perversion of the linear perspectival system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false perspective"@en .

aat:300075405 a skos:Concept ;
    skos:definition "Lounges reserved for privileged and important individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V.I.P. lounges"@en .

aat:300075419 a skos:Concept ;
    skos:definition "Function used when real estate is legally declared unfit for habitation or use, usually accompanied by the appropriation of that property under the power of eminent domain. For the appropriating of real estate or other property as a punishment for breach of the law, use \"confiscating.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condemning"@en .

aat:300075420 a skos:Concept ;
    skos:definition "Legally removing a person or persons from the premises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evicting"@en .

aat:300075421 a skos:Concept ;
    skos:definition "Proceeding against a property owner who has failed to meet the obligation of a mortgage loan or other liens like tax liens; used to force the sale of the property to pay the debt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foreclosing"@en .

aat:300075458 a skos:Concept ;
    skos:definition "Rooms that are connected or combined, such as apartments or suites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combinations of rooms"@en .

aat:300075459 a skos:Concept ;
    skos:definition "Building spaces that are covered, and located on the exterior of the buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior covered spaces"@en .

aat:300075460 a skos:Concept ;
    skos:definition "Spaces attached to buildings that are uncovered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncovered spaces"@en .

aat:300075465 a skos:Concept ;
    skos:definition "Drawings or works in another two-dimensional medium in which two or more related images (e.g., different views of the same structure, or a figure in various poses) are displayed together or fused into one. In disciplines outside architecture, the term refers to any image compiled from multiple parts, including faces constructed for forensic identification, maps, geographic diagrams, or images of planets created from telescopic imagery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite views"@en .

aat:300075467 a skos:Concept ;
    skos:definition "Small, brief, concise drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumbnail sketches"@en .

aat:300075472 a skos:Concept ;
    skos:definition "In the architecture of military fortifications, the term refers to ground plans of fortified works, including fortifications, mine fields, defensive positions, military installations, or other plans. The plans may be superimposed on a map or photograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traces"@en .

aat:300075477 a skos:Concept ;
    skos:definition "Oblique drawings, or works in another mediu, in which a vertical plane is parallel to the plane of projection, and receding planes are drawn at a scale that is somewhere between the same scale as and one-half the scale of that vertical plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general oblique projections"@en .

aat:300075480 a skos:Concept ;
    skos:definition "Refers to perspective drawings having a stationpoint well below normal eye level, typically depicted as if seen from the surface of the earth or the floor, as if the viewer is lying down and looking straight up. For photographs or other images with low viewpoints, but where precise calculation of perspective is not employed or not emphasized, use \"worm's-eye views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worm's-eye perspectives"@en .

aat:300075493 a skos:Concept ;
    skos:definition "Functions related to the handling of communicated knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information handling functions"@en .

aat:300075496 a skos:Concept ;
    skos:definition "Maps that chart the extent of past incursions of water on land, showing possible patterns that may occur in the future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flood-prone-area maps"@en .

aat:300075498 a skos:Concept ;
    skos:definition "Charts depicting rivers and the features of rivers, especially those used for navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river charts"@en .

aat:300075520 a skos:Concept ;
    skos:definition "Artists formally attached to a university, college, community, or other organization, usually for a specified period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists-in-residence"@en .

aat:300075671 a skos:Concept ;
    skos:definition "Actions or activities specifically performed by governments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governmental functions"@en .

aat:300075767 a skos:Concept ;
    skos:definition "Use to designate large rooms that are much longer than they are wide, such as the long galleries of Elizabethan country houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long galleries"@en .

aat:300075830 a skos:Concept ;
    skos:definition "Large vaulted halls having one side open to a court; prevalent in Parthian, Sassanian, and Islamic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iwans"@en .

aat:300075880 a skos:Concept ;
    skos:definition "Spaces in buildings used specifically for receptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reception spaces"@en .

aat:300075881 a skos:Concept ;
    skos:definition "Rooms in buildings specifcally used for gatherings or meetings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assembly spaces"@en .

aat:300075882 a skos:Concept ;
    skos:definition "Rooms and spaces located in places of burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomb spaces"@en .

aat:300075884 a skos:Concept ;
    skos:definition "Semicircular or polygonal circulation spaces enclosing an apse or a straight-ended sanctuary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambulatories"@en .

aat:300075933 a skos:Concept ;
    skos:definition "The upper, horizontal surfaces of altars, especially the top slabs; may be arranged or placed upon supports in various ways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mensas"@en .

aat:300075936 a skos:Concept ;
    skos:definition "Cavities in altars or altarpieces for containing relics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepulchers"@en .

aat:300075940 a skos:Concept ;
    skos:definition "Refers to painted or carved image-bearing objects in a Christian church. Altarpieces are characterized by usually being framed and either set on the rear part of the altar abutting the back of the altarblock or hung on the wall behind the altar. Altarpieces may be set on both the central high altar and side altars. The subject of the image is typically a religious figure or figures, often included in a narrative or didactic scene; it may also include a patron of the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altarpieces"@en .

aat:300075947 a skos:Concept ;
    skos:definition "Refers to relatively large ornamented walls, screens, or other structures located above and behind the high altar of a Christian church, often holding the sacred tabernacle. A reredos may be placed against the apse wall, directly behind the altar, or may form part an altar screen. Its form evolved from the dossal, a tapestry or painting on the wall behind the altar. In church design, It may serve as a screen between celebrant and the congregation or between the choir and the retrochoir. In Spanish churches the reredos grew to be as wide as the nave and reaching to the vaulting of the roof. The reredos may be made of precious materials and heavily decorated, often with carvings, niches, sculptures, paintings and tapestries. It is distinct from a 'retable'; while the reredos typically rises from ground level behind the altar, the retable is smaller, standing either on the back of the altar itself or on a pedestal behind it. Many altars have both a reredos and a retable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reredoses"@en .

aat:300076035 a skos:Concept ;
    skos:definition "Refers to appendages placed on the mensa of an altar in a Christian church. A retable may consist of a simple shelf or ledge raised above the back of the altar and used to hold candles. It may also include an attached frame or structure enclosing painted or carved panels, with or without a shelf for candles, serving as an altarpiece. Smaller shelves are ledges are generally called \"gradines,\" although usage overlaps. A \"retable\" is distinct from a 'reredos'; while the reredos typically rises from ground level behind the altar, the retable is smaller, standing either on the back of the altar itself or on a pedestal behind it. Many altars have both a reredos and a retable. For the smaller Mexican and Spanish American paintings of Christian saints and other holy figures, use 'retablos (panel painting).'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retables"@en .

aat:300076039 a skos:Concept ;
    skos:definition "Pews screened and enclosed by high backs and sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box pews"@en .

aat:300076058 a skos:Concept ;
    skos:definition "Use generally for partitions set up in religious and Roman Imperial buildings or outdoor areas between sacred and profane spaces or between certain Imperial and public spaces; use specifically in Jewish contexts for partitions in front of Torah shrines, especially in Byzantine and earlier periods, and in Christian churches for partitions separating the chancel from the body of the church, particularly when the chancel does not also include a choir. Use \"choir screens\" for the screens around the choir when the choristers are seated in the chancel area. For screens separating the sanctuary from the nave in Orthodox Eastern churches, use \"iconostases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chancel screens"@en .

aat:300076084 a skos:Concept ;
    skos:definition "Roofed structures with four or more columns built over an altar; for suspended, projecting, or freestanding canopies over such features as altars, thrones, or doorways, use \"baldachins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciboria"@en .

aat:300076094 a skos:Concept ;
    skos:definition "Gables having a stairstep form along the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepped gables"@en .

aat:300076122 a skos:Concept ;
    skos:definition "Fixed seats for the clergy with high, enclosing backs and sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stalls"@en .

aat:300076128 a skos:Concept ;
    skos:definition "Seats in the choir area of a church, wholly or partly enclosed on the back and sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choir stalls"@en .

aat:300076149 a skos:Concept ;
    skos:definition "In mosques, high podiums on columns from which the celebrant's assistant repeats his Koran readings and gestures for the more distant worshippers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dikkas"@en .

aat:300076155 a skos:Concept ;
    skos:definition "Niches, chambers, or slabs in mosques, indicating the direction of Mecca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mihrabs"@en .

aat:300076157 a skos:Concept ;
    skos:definition "Crowning moldings of a classical cornice, especially when in the form of a cyma, though they may also be an ovolo or cavetto molding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cymatia"@en .

aat:300076168 a skos:Concept ;
    skos:definition "Particular arrangements of vertical elements of a building, either exterior or interior. For the external areas of buildings, not necessarily restricted to surface features, use \"fronts (architectural).\" For the features of a primary front, restricted for the most part to surface elements in a single plane, use \"façades.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elevations"@en .

aat:300076214 a skos:Concept ;
    skos:definition "Parts or components of coffered ceilings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffered ceiling components"@en .

aat:300076275 a skos:Concept ;
    skos:definition "Overall plans, usually graphic and drawn on a small scale, into which the details of other specific plans are fitted. A master plan is frequently supplemented by written material. For plans having to do with land use control law, zoning, and urban redevelopment used to describe the omnibus plans of cities or towns for housing, industry, commercial, and recreational facilities and their impact on environmental factors, use \"comprehensive plans\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master plans"@en .

aat:300076303 a skos:Concept ;
    skos:definition "Parts or components of pedestals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal components"@en .

aat:300076527 a skos:Concept ;
    skos:definition "Massive form of sepiolite used especially for tobacco pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meerschaum"@en .

aat:300076542 a skos:Concept ;
    skos:definition "Structural elements, usually metal beams, that have rolled sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolled sections"@en .

aat:300076598 a skos:Concept ;
    skos:definition "Visual works that focus on the delineation of form in two dimensions and that are created using a computer, software, and input hardware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer drawings"@en .

aat:300076600 a skos:Concept ;
    skos:definition "Computer drawings when emphasizing that they were produced on a plotter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plots"@en .

aat:300076608 a skos:Concept ;
    skos:definition "Parts or components of arches, domes, or vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch, dome or vault components"@en .

aat:300076641 a skos:Concept ;
    skos:definition "Refers to impressive, monumental entrances, gateways, or doorways usually to buildings or courtyards, especially those emphasized by stately architectural treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portals"@en .

aat:300076648 a skos:Concept ;
    skos:definition "Ceilings formed by or suggesting open-timbered roofs, often higher than the ceilings of the other rooms in the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedral ceilings"@en .

aat:300076660 a skos:Concept ;
    skos:definition "Building systems that secure or protect a premises from unwanted intruders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "security systems"@en .

aat:300076663 a skos:Concept ;
    skos:definition "Rooms adjacent to a lady's bedroom, serving as private sitting rooms and dressing rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boudoirs"@en .

aat:300076922 a skos:Concept ;
    skos:definition "Works of art, typically on a paper or vellum support, to which designs are applied using crayons made of ground pigment held together with a binder, typically oil or water and gum. Works in this medium are sometimes classified as drawings, and sometimes as paintings, typically based on the local curatorial department responsible for the work or on the material of the support (pastels on paper may be classified as drawings, while pastels on vellum may be classified as paintings)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastels"@en .

aat:300076932 a skos:Concept ;
    skos:definition "Refers to plans representing the layout and configuration of heating facilities in a structure. They typically include the position of boilers, radiators, or other heating sources, pipes, air conduits, and the number of rooms and desired temperatures. They may include specialized symbols and conventions, such as the flow of steam or heated air depicted in red, and the return in blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating plans"@en .

aat:300077046 a skos:Concept ;
    skos:definition "Official recognition of an institution as maintaining standards that render them eligible for membership in an association of similar institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accreditation"@en .

aat:300077049 a skos:Concept ;
    skos:definition "Settling disputes by legal process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjudication"@en .

aat:300077063 a skos:Concept ;
    skos:definition "Including or appropriating an area within the limits of a governmental unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annexing"@en .

aat:300077092 a skos:Concept ;
    skos:definition "Generally, reviewing a practice or set of practices to certify that they are being conducted in accordance with established principles. In the context of financial matters, the periodic or continual assessment of the financial assets and liabilities of an organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auditing"@en .

aat:300077096 a skos:Concept ;
    skos:definition "Giving sanction to an action or object, as done by a valid authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authorization"@en .

aat:300077114 a skos:Concept ;
    skos:definition "Officially attesting that something is valid or meets a standard, or, with regard to people, that a standard degree of qualification has been met."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certification"@en .

aat:300077121 a skos:Concept ;
    skos:definition "Gathering things in order to retain them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collecting"@en .

aat:300077124 a skos:Concept ;
    skos:definition "Examining two or more entities in order to note relative similarities and differences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comparison"@en .

aat:300077136 a skos:Concept ;
    skos:definition "Causing discrete agents or agencies to work together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coordinating"@en .

aat:300077176 a skos:Concept ;
    skos:definition "Rooms whose purpose is the formal reception of guests, tradesmen, and other visitors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reception rooms"@en .

aat:300077189 a skos:Concept ;
    skos:definition "Windows that have sashes that move up and down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hung windows"@en .

aat:300077190 a skos:Concept ;
    skos:definition "Windows having one vertically hung movable sash and one fixed sash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-hung windows"@en .

aat:300077230 a skos:Concept ;
    skos:definition "Full-length adjustable mirrors suspended on four-legged frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheval glasses"@en .

aat:300077236 a skos:Concept ;
    skos:definition "Term of convenience for a type of chair with a wide but not very deep seat, low back, and no arms, originating in England in Elizabethan times. Term may have been coined under the assumption that the chairs were designed to accommodate the wide, hooped dresses called farthingales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farthingale chairs"@en .

aat:300077244 a skos:Concept ;
    skos:definition "Medieval Spanish type of X-chairs, often with inlaid decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sillones de cadera"@en .

aat:300077250 a skos:Concept ;
    skos:definition "Term first used by Sheraton to describe armchairs having a semicircular back and elongated seat, the shape suggesting an open carriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curricles"@en .

aat:300077252 a skos:Concept ;
    skos:definition "American adaptations of late Sheraton-Style, open-backed side chairs. These are usually painted black with stencilled decoration that emulated gilt and lacquered furniture imported from Europe, and were developed and sold by Lambert Hitchcock in Connecticut in the mid-nineteenth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hitchcock chairs"@en .

aat:300077258 a skos:Concept ;
    skos:definition "French 18th-century chairs that stood in the center of a room and could be moved. Distinct from \"sièges meublants\" which were largely decorative and were positioned against the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sièges courants"@en .

aat:300077260 a skos:Concept ;
    skos:definition "French 18th-century chairs that were positioned against the wall. Their use was governed by strict protocol and sièges meublants were usually not sat on, but rather meant to be a part of the architectural decoration of a room. Distinct from \"sièges courants\" which stood in the center of a room and could be moved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sièges meublants"@en .

aat:300077268 a skos:Concept ;
    skos:definition "19th-century sofas with a central backrest on either side of which people can sit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boudeusses"@en .

aat:300077277 a skos:Concept ;
    skos:definition "Refers to chests of drawers or cabinets of chair-rail height, made for display as well as storage and often quite elaborately decorated. Term is applied especially to French forms, and to English, American, and other styles to indicate a form inspired by French taste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodes"@en .

aat:300077279 a skos:Concept ;
    skos:definition "Popular name for a type of 18th-century American dressing table with drawers, set on high legs, and similar in form to the lower section of a high chest of drawers, which it was often made to match."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low chests"@en .

aat:300077291 a skos:Concept ;
    skos:definition "Cupboards for the storage of linen items, including undergarments, shirts, bed linens, or table linens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linen presses"@en .

aat:300077292 a skos:Concept ;
    skos:definition "Small triangular cupboards made to fit into a corner; usually made in pairs, often to match a commode; often of ornamantal design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encoignures"@en .

aat:300077298 a skos:Concept ;
    skos:definition "French desks with a vertical fall front enclosing drawers and pigeonholes; usually with a cupboard below, but sometimes raised up on tall legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secrétaires à abattant"@en .

aat:300077310 a skos:Concept ;
    skos:definition "Slant-front desks generally intended for a woman's use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux en pente"@en .

aat:300077316 a skos:Concept ;
    skos:definition "Moldings with bird, animal, or human heads biting a roll molding as the ornamental motif; used in Norman architecture. For fillet moldings with the front portion pendant, use \"beak moldings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beakhead moldings"@en .

aat:300077320 a skos:Concept ;
    skos:definition "Kidney-shaped tables, generally used as writing or dressing tables, which were first made in France during the Louis XV period and later introduced in England and America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kidney tables"@en .

aat:300077332 a skos:Concept ;
    skos:definition "18th-century English writing tables with oblong tops, shallow drawers below, and four slender tapering legs joined with a shelf; often made in satinwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheverets"@en .

aat:300077337 a skos:Concept ;
    skos:definition "Small tables near the altar in a church, used for the eucharistic elements before consecration and afterwards; may be freestanding or attached to a wall. They are named after the similar tables used historically in dining rooms. For shelves used for the same purpose, use \"credence shelves\"; for shelving or platforms within niches, use \"credence niches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credence tables"@en .

aat:300077342 a skos:Concept ;
    skos:definition "Stands made to support hot water urns or teakettles. May be short-legged stands that are set upon a table, or taller stands with legs that reach the floor. For tables that support a tea service, use \"tea tables.\" Use \"teakettles-on-stands\" for teakettles made en suite with a stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kettle stands"@en .

aat:300077354 a skos:Concept ;
    skos:definition "Round or oval enframements, usually containing figures or ornamental motifs. Primarily found in two-dimensional media, such as textiles, stained glass, and manuscript illuminations; for circular decorated panels in architectural contexts, use \"roundels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medallions"@en .

aat:300077356 a skos:Concept ;
    skos:definition "Cases of any size, usually made of glass, designed to display books, museum objects, or other objects and protect them from dust and insects; often having controlled humidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibit cases"@en .

aat:300077357 a skos:Concept ;
    skos:definition "Large commemorative medals. For circular two-dimensional motifs, use \"medallions (ornament areas)\"; for circular decorated panels in architectural contexts, use \"roundels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medallions"@en .

aat:300077360 a skos:Concept ;
    skos:definition "Decorative inlaid border of contrasting types of wood cut diagonally across the grain, generally used to finish edges and rims of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather banding"@en .

aat:300077362 a skos:Concept ;
    skos:definition "Decorative inlaid border of contrasting types of wood cut along the length of the grain, generally used on the edges and rims of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight banding"@en .

aat:300077506 a skos:Concept ;
    skos:definition "Listing items on hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inventorying"@en .

aat:300077518 a skos:Concept ;
    skos:definition "Taking legal action; carrying on an action by judicial process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litigation"@en .

aat:300077524 a skos:Concept ;
    skos:definition "Attempting to influence or sway public officials toward a desired end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lobbying"@en .

aat:300077526 a skos:Concept ;
    skos:definition "Sending through a postal service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mailing"@en .

aat:300077527 a skos:Concept ;
    skos:definition "Making goods and articles by hand or using equipment. After the industrial revolution of the nineteenth century, the term came to denote industrial production by means of machinery rather than production by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manufacturing"@en .

aat:300077565 a skos:Concept ;
    skos:definition "The action or process of making something ready for use or service or of getting ready for some occasion, test, or duty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preparing"@en .

aat:300077610 a skos:Concept ;
    skos:definition "Creating a record of data or information in some lasting form, such as writing on paper or electronic signals on magnetic tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recording"@en .

aat:300077723 a skos:Concept ;
    skos:definition "Papers, research results, or other documents presenting the author's research and submitted in support of candidature for a Master's Degree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masters theses"@en .

aat:300077781 a skos:Concept ;
    skos:definition "Process of making changes to objects, especially buildings or other structures, with the intention of improving their physical condition and returning them to a good state of repair. When such changes intend to return a building or structure to a state of historical correctness, use \"restoration (process).\" Distinguished from \"rehabilitating\" which refers to improving deteriorated structures. To relay the implication that the building is updated for the purpose of making it more sustainable, use \"refurbishment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "renovation"@en .

aat:300077803 a skos:Concept ;
    skos:definition "Process of becoming brittle; includes the loss of flexibilty or elasticity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embrittlement"@en .

aat:300077808 a skos:Concept ;
    skos:definition "Field of knowledge dealing with coats of arms and armorial insignia, including their depiction and use, determination of who is entitled to display them, the genealogy of families having coats of arms, and the maintenance and interpretation of heraldic records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heraldry"@en .

aat:300077886 a skos:Concept ;
    skos:definition "In concrete work, a joint cut into hardened concrete by means of a special blade, generally not through the full depth of the member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawed joints"@en .

aat:300077889 a skos:Concept ;
    skos:definition "Vertical longitudinal joints between wythes of masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar joints"@en .

aat:300077890 a skos:Concept ;
    skos:definition "Joints between two timbers that are located or secured by a wedge or insert that prevents movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyed joints"@en .

aat:300077893 a skos:Concept ;
    skos:definition "Masonry joint in which the mortar is flush at the edges, but with a concave groove is added, centered along the joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush and rodded joints"@en .

aat:300077895 a skos:Concept ;
    skos:definition "Joints of various types that join two or more wooden planks, panels, or boards by securing them with wooden batten cross pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batten joints"@en .

aat:300077898 a skos:Concept ;
    skos:definition "Joints that are joined continuously with the members. An example is metal joints, such as on a bridge, or joints in plumbing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integral joints"@en .

aat:300077899 a skos:Concept ;
    skos:definition "Joints that appear to be recessed from the surface, rather than being flush or projecting from the surface. Examples are joints in masonry where the mortar is recessed rather than flush with the bricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recessed joints"@en .

aat:300077904 a skos:Concept ;
    skos:definition "Devices mounted at the tops of doors and to door frames that allow for the door to be held open at any desired angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overhead door holders"@en .

aat:300077905 a skos:Concept ;
    skos:definition "Objects of various form, but usually rubber buttons inserted into the metal frame of a door that cushion the door so that the audible impact of door closure reduced ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door silencers"@en .

aat:300077906 a skos:Concept ;
    skos:definition "Bars, or series of bars, usually across a door, used as a means of pushing a door open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "push bars"@en .

aat:300077937 a skos:Concept ;
    skos:definition "Handles in the form of a single bar mounted on one or more brackets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar handles"@en .

aat:300077938 a skos:Concept ;
    skos:definition "Handles or pulls of various shapes intended for doors on public spaces. These often have a large surface area to grasp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrance handles"@en .

aat:300077940 a skos:Concept ;
    skos:definition "Fixtures designed for hanging towels or robes in a bathroom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathroom hooks"@en .

aat:300077960 a skos:Concept ;
    skos:definition "Double-pointed, U-shaped pieces of metal used to attach separate articles together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staples"@en .

aat:300077989 a skos:Concept ;
    skos:definition "Obtaining something by the payment of money or its equivalent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purchasing"@en .

aat:300078025 a skos:Concept ;
    skos:definition "Establishments, typically found in the United States, which provide refreshment, fuel, and services for truck-drivers and their vehichles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truck stops"@en .

aat:300078048 a skos:Concept ;
    skos:definition "Architectural elements that are part of the structure of a building, as opposed to elements that are decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural elements"@en .

aat:300078050 a skos:Concept ;
    skos:definition "Architectural elements of the structure of a building that enclose areas of the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enclosing structural elements"@en .

aat:300078051 a skos:Concept ;
    skos:definition "Structural elements in buildings, often in columns such as architectural orders or colonnades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural assemblies"@en .

aat:300078052 a skos:Concept ;
    skos:definition "Architectural elements that consist of entire systems to support structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural systems"@en .

aat:300078053 a skos:Concept ;
    skos:definition "Parts or components of structural elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural element components"@en .

aat:300078065 a skos:Concept ;
    skos:definition "The action of transforming, altering, or treating a thing by using a special process or technique, including operating upon the thing mechanically or chemically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processing"@en .

aat:300078072 a skos:Concept ;
    skos:definition "System components that support systems of public works of countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrastructural elements"@en .

aat:300078073 a skos:Concept ;
    skos:definition "Elements of the built environment that are not part of a built environment, yet are used or exist on sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site elements"@en .

aat:300078076 a skos:Concept ;
    skos:definition "Parts or components of surface elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface element components"@en .

aat:300078091 a skos:Concept ;
    skos:definition "Locks used on transoms, having the latch bolt operated by a ring-shaped part that is moved by using a pole with a hook on its end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transom catches"@en .

aat:300078096 a skos:Concept ;
    skos:definition "Heavy grips or pulls mounted on sectional or elongated plates and provided with a thumbpiece to operate the latch trip of a store-door lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "store-door handles"@en .

aat:300078098 a skos:Concept ;
    skos:definition "Hinges designed to pass electric wires from the frame to the door for use in an electrically controlled lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric hinges"@en .

aat:300078103 a skos:Concept ;
    skos:definition "Mechanical contrivances that allow swinging motion in a single plane of one of the members to which they are attached, such as a door, and in which water or some other liquid is employed in the mechanism to control the speed at which the hinge moves; usually to slow the motion of a closing door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic hinges"@en .

aat:300078112 a skos:Concept ;
    skos:definition "Door knobs that are attached to the spindles using special wrenches, rather than the more common side screw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screwless knobs"@en .

aat:300078114 a skos:Concept ;
    skos:definition "Handles in the form of small rounded masses that project from the interior surfaces of movable screens that cover portals, especially windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutter knobs"@en .

aat:300078129 a skos:Concept ;
    skos:definition "Refers to screens in Christian churches that separate the choir from the nave and aisles of a church. For partitions that separate the chancel from the nave of the church, use \"chancel screens.\" For partitions that separate the altar from the choir, use \"reredos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choir screens"@en .

aat:300078131 a skos:Concept ;
    skos:definition "Exchanging property or services for money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selling"@en .

aat:300078138 a skos:Concept ;
    skos:definition "Relatively small, private rooms, often adjacent to bedrooms in great houses, serving as sitting rooms, rooms for dressing, study, devotion, or private meetings, and, during certain periods, often containing collections of curiosities and art objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinets"@en .

aat:300078146 a skos:Concept ;
    skos:definition "Refers to the ground floors of theaters, especially those at the rear; most appropriate in an English and historical rather than a modern American context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pits"@en .

aat:300078150 a skos:Concept ;
    skos:definition "Fire walls that separate a stage or enclosed platform from the public or spectators in an auditorium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proscenium walls"@en .

aat:300078157 a skos:Concept ;
    skos:definition "The systems within a building that supply water to the occupants and carry off liquid or liquid-suspended wastes; includes pipes, traps, vents, and fixtures, but not sources or destinations outside the building such as wells or septic tanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumbing systems"@en .

aat:300078186 a skos:Concept ;
    skos:definition "Plates or boxes containing a handle or grip that are mortised into the edge of doors that open by sliding along a track."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding-door pulls"@en .

aat:300078193 a skos:Concept ;
    skos:definition "Structural members secured to a wall or upright, from which they also project to support a shelf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelf brackets"@en .

aat:300078200 a skos:Concept ;
    skos:definition "Threaded bolts for holding together temporarily parts of a structure during riveting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assembling bolts"@en .

aat:300078206 a skos:Concept ;
    skos:definition "Short sections of angle iron used to attach structural members, such as precast panels, to structural steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle cleats"@en .

aat:300078213 a skos:Concept ;
    skos:definition "Nails having large ornamental heads or bosses, and that are liberally applied to fill large door panels or chests. They were particularly popular in historical Spain, Mexico, and other colonial Spanish locations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chatônes"@en .

aat:300078215 a skos:Concept ;
    skos:definition "Nails having a flat head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-head nails"@en .

aat:300078218 a skos:Concept ;
    skos:definition "Tacks having an inverted U-shape or square shape, with a point on both ends. Distinguished from staple nails, which are of heavier construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double pointed tacks"@en .

aat:300078221 a skos:Concept ;
    skos:definition "Hardware used for the control of awning windows, allowing the window to swing out and open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awning hardware"@en .

aat:300078223 a skos:Concept ;
    skos:definition "Items used to furnish a bathroom, including rails for holding towls, soap, or toilet paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathroom hardware"@en .

aat:300078228 a skos:Concept ;
    skos:definition "Hardware used in the context of spaces for storing clothing, utensils, or provisions. This may include hooks or rods for suspending clothing on hangers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closet hardware"@en .

aat:300078245 a skos:Concept ;
    skos:definition "Metal objects designed to be applied to swinging or sliding barriers between two exterior spaces. These may include hinges, latches, or hooks, for hanging, opening, or securing the gate itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gate hardware"@en .

aat:300078247 a skos:Concept ;
    skos:definition "Items that are necessary to attach, anchor, hold, or join components of systems that convey water or gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumbing hardware"@en .

aat:300078271 a skos:Concept ;
    skos:definition "Items that are designed to attach, anchor, or support rigid material fixed in a horizontal position to a wall or in a case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelf hardware"@en .

aat:300078295 a skos:Concept ;
    skos:definition "Parts or components of keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key components"@en .

aat:300078296 a skos:Concept ;
    skos:definition "Parts of keys which are inserted into a lock and engage the tumblers or bolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bits"@en .

aat:300078298 a skos:Concept ;
    skos:definition "Keys adapted to open a particular set of locks in a group, distinguished from master keys, which are designed to open all the locks in the group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "changes"@en .

aat:300078300 a skos:Concept ;
    skos:definition "The housing containing the tumbler mechanism and the key way, which can be actuated only by the correct key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinders"@en .

aat:300078312 a skos:Concept ;
    skos:definition "Pieces of hardware that act as protective covers on keyholes or lock cylinder mechanisms that may restrict intrusion of foreign bodies or incorrect keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caps"@en .

aat:300078315 a skos:Concept ;
    skos:definition "Lock hubs designed to compensate for shrinkage or swelling in a door, and subsequently to prevent the disengagement of the lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compensating hubs"@en .

aat:300078321 a skos:Concept ;
    skos:definition "In construction and machine design, joints secured with bolts and nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolted joints"@en .

aat:300078323 a skos:Concept ;
    skos:definition "Joints made by deforming the members in order to make the connection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deformed joints"@en .

aat:300078328 a skos:Concept ;
    skos:definition "Joints in wood, metal, and other materials that are held secure by driving or inserting dowel pins or other pins into holes drilled into the joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinned joints"@en .

aat:300078346 a skos:Concept ;
    skos:definition "Sheet metal seams used primarily with light material, distinguished by an offset along the side of the seam. To make a grooved seam, the edges of both pieces are turned and hooked together; a grooving machine or other roller is run over the seam, creating an offset in the upper sheet, securing it so the seam does not come apart. Examples of uses for this seam are for joining two flat sheets, making longitudinal seams in round pipes, and vertical seams in articles having a flaring or cylindrical surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grooved seams"@en .

aat:300078348 a skos:Concept ;
    skos:definition "Sheet metal seams formed by slipping a cap strip, which is a narrow metal strip that has had long edges turned, over the turned edges of the two metal pieces to be joined, to form a lock. An example of use is in assembling cross seams of ducts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap strip seams"@en .

aat:300078350 a skos:Concept ;
    skos:definition "Seams, in sheet metal and roofing, made by turning up two adjacent edges and folding the upstanding parts over on themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing seams"@en .

aat:300078352 a skos:Concept ;
    skos:definition "Sheet metal seams having a bottom plate with a turned edge that overlaps the side plate; the seam may be secured by welding, soldering, or riveting at the overlapping joint. An example of a lap bottom seam is the seam at the bottom of a tin or steel can."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lap bottom seams"@en .

aat:300078354 a skos:Concept ;
    skos:definition "Sheet metal seams having a bottom plate with a turned edge that is inserted inside the side plate; the seam may be secured by welding, soldering, or riveting at the overlapping joint. For bottom seams having the bottom plate with a turned edge that overlaps the side plate rather than being inserted inside it, use \"lap bottom seams.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insert bottom seams"@en .

aat:300078356 a skos:Concept ;
    skos:definition "Sheet metal bottom seam in which only the bottom edge is turned, and then locked into an opposing sheet with a simple bent edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single bottom seams"@en .

aat:300078358 a skos:Concept ;
    skos:definition "Sheet metal seams comprising interlocking turnings on each of the two pieces, made in a manner so they lock together at the bottom. Such a seam is used to fasten bottoms to cylindrically shaped articles such as pails, tanks, and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottom double seams"@en .

aat:300078361 a skos:Concept ;
    skos:definition "Distinctive sheet metal seams made with one sheet edge turned, double-bent, and locked onto a sheet having a simple bend; usually created using a special Pittsburgh lockforming machine. An example of use for the seam is at the corners of elbows and square or rectangular pipes of ducts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pittsburgh lock seams"@en .

aat:300078363 a skos:Concept ;
    skos:definition "Sheet metal seams comprising interlocking turnings on each of the two pieces, in a manner so they fit firmly together at a corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner double seams"@en .

aat:300078365 a skos:Concept ;
    skos:definition "Sheet metal seams comprising one sheet turned and placed over the bent edge of the second sheet. To prevent the elbow from breaking at the joint through handling, the elbow seam is closed using a special machine or with a mallet over a bench stake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elbow seams"@en .

aat:300078375 a skos:Concept ;
    skos:definition "Sheet metal dovetail seams that are secured with a rim or collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flange dovetail seams"@en .

aat:300078380 a skos:Concept ;
    skos:definition "The simplest variety of dovetail seams in sheet metal, where tabs are cut from the sheet of metal and folded or bent over the collar to form a seam; usually used for joining collars to flanges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain dovetail seams"@en .

aat:300078384 a skos:Concept ;
    skos:definition "Dovetail seams in sheet metal, for joining collars to flanges, where the seam has a bead formed by means of a beading machine. This bead acts as a stop for the flange to rest upon and the tabs are bent over to hold the flange in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaded dovetail seams"@en .

aat:300078388 a skos:Concept ;
    skos:definition "Angle joints involving two members, each having been cut to half its thickness and lapped over the other in such a manner as to result in a change of direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end lap joints"@en .

aat:300078434 a skos:Concept ;
    skos:definition "Parts or components of structural slabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural slab components"@en .

aat:300078438 a skos:Concept ;
    skos:definition "Flat, often rectangular or oval, plates bearing a usually printed or engraved name of, for example, a person or company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nameplates"@en .

aat:300078440 a skos:Concept ;
    skos:definition "Escutcheons, usually small, inset into a surface and following the outline of an opening, often a keyhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread escutcheons"@en .

aat:300078446 a skos:Concept ;
    skos:definition "Lock housings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cases"@en .

aat:300078457 a skos:Concept ;
    skos:definition "Refers to directions as referenced on a compass, which is an instrument for measuring a horizontal reference direction relative to magnetic north. The four basic points are at the top, bottom, right and left sides of a compass, corresponding to north, south, east and west. Points between the four basic points are described by combining terms, for example, northeast, southeast, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass points"@en .

aat:300078473 a skos:Concept ;
    skos:definition "Constructions, usually in large gardens or grounds, meant to imitate ruined buildings for aesthetic effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial ruins"@en .

aat:300078480 a skos:Concept ;
    skos:definition "Foundations that sustain loads by distributing them over a large planar surface; may support one or more columns, piers, or walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spread footings"@en .

aat:300078728 a skos:Concept ;
    skos:definition "Refers to isolated masonry foundation components delivering loads to a bearing stratum; distinct from \"piles,\" which are smaller and may be clustered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piers"@en .

aat:300078735 a skos:Concept ;
    skos:definition "The process by which a fresco is detached from a wall, used when the plaster on which it is painted has greatly deteriorated; the color layer is removed by a strong glue without removing excessive amounts of plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strappo"@en .

aat:300078737 a skos:Concept ;
    skos:definition "In fresco, transferring a pricked drawing onto the final plaster layer by dusting it with a cloth sack filled with charcoal powder, leaving an outline of the design on the fresh intonaco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spolvero"@en .

aat:300078739 a skos:Concept ;
    skos:definition "The process of detaching a fresco painting from the wall by removing the pigment layer and a layer of intonaco. Cloth is glued to the painted surface and, when dry, the cloth, painting, and plaster are stripped from the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacco"@en .

aat:300078748 a skos:Concept ;
    skos:definition "Parts or components of pier foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pier foundation components"@en .

aat:300078750 a skos:Concept ;
    skos:definition "Parts or components of pile foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile foundation components"@en .

aat:300078751 a skos:Concept ;
    skos:definition "Parts or components of spread footings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spread footing components"@en .

aat:300078755 a skos:Concept ;
    skos:definition "Having a form or outline delimited on at least one end by two intersecting lines, that is, tapering to or ending in a point or apex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointed"@en .

aat:300078757 a skos:Concept ;
    skos:definition "Forms or outlines delimited by lines defining a sector equal to one quarter of a circle or half a semicircle, having an arc of 90 degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrant"@en .

aat:300078759 a skos:Concept ;
    skos:definition "The compass point that is 90 degrees clockwise from the north point, or generally the direction towards the half of the sky where the sun rises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "east"@en .

aat:300078761 a skos:Concept ;
    skos:definition "The compass point towards the magnetic pole, to which a compass needle points, or generaly towards or in the direction of the pole on the earth's surface that lies on the earth's axis of rotation and at which the heavens appear to turn anticlockwise about a point directly overhead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "north"@en .

aat:300078762 a skos:Concept ;
    skos:definition "Partly embedded in or bonded to a supporting structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engaged"@en .

aat:300078763 a skos:Concept ;
    skos:definition "Positional attribute used to describe something situated at or near an extremity of a long, thin object. To refer to those extremities themselves, use \"ends (portions)\" from the Components hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end"@en .

aat:300078767 a skos:Concept ;
    skos:definition "Positional attribute used to describe something situated at or near the forward or most important part of something. To refer to those parts themselves, use \"fronts\" from the Components hierarchy. For the sense of facing the viewer, as a figure in a picture, use \"frontal.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "front"@en .

aat:300078785 a skos:Concept ;
    skos:definition "Describes objects, structures, or spaces, or portions thereof, located to the left of an observer facing in the same direction as the object or space specified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "left"@en .

aat:300078790 a skos:Concept ;
    skos:definition "Spaces located in the interior of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior spaces"@en .

aat:300078791 a skos:Concept ;
    skos:definition "Building a coherent and reliable collection over a number of years by the selection and acquisition of material, and establishing criteria for decisions on the material to be included or excluded in that collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collection development"@en .

aat:300078809 a skos:Concept ;
    skos:definition "The compass point lying midway between north and east."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "northeast"@en .

aat:300078812 a skos:Concept ;
    skos:definition "The compass point lying midway between north and west."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "northwest"@en .

aat:300078814 a skos:Concept ;
    skos:definition "Refers to the front, top, or principal surface of coins, medals, seals, or other two-sided objects. Use \"rectos\" specifically for the principal side of sheets of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obverses"@en .

aat:300078817 a skos:Concept ;
    skos:definition "The front or obverse sides of a leaf; the right-hand pages of an open book or manuscript. Thus, refers to the principal side of sheets of paper. For the back of leaves or pages, use \"versos.\" Use \"obverses\" for the front, top, or principal surface of coins, medals, seals, or currency notes, bearing the main design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectos"@en .

aat:300078820 a skos:Concept ;
    skos:definition "Refers to the back, underside, or subordinate surface of coins, medals, seals, or currency notes. Use \"versos\" for the reverse or subordinate side of sheets of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverses"@en .

aat:300078823 a skos:Concept ;
    skos:definition "Describes objects, structures, or spaces, or portions thereof, located to the right of an observer facing in the same direction as the object or space specified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "right"@en .

aat:300078825 a skos:Concept ;
    skos:definition "The compass point in the direction of that part of the earth or heavens which is directly opposite to north."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "south"@en .

aat:300078827 a skos:Concept ;
    skos:definition "The compass point lying midway between south and west."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southeast"@en .

aat:300078829 a skos:Concept ;
    skos:definition "The compass point lying midway between south and west."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southwest"@en .

aat:300078836 a skos:Concept ;
    skos:definition "The compass point in the direction of that part of the horizon where the sun sets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "west"@en .

aat:300078853 a skos:Concept ;
    skos:definition "Pale, brownish, diffuse spots that appear on paper or other surfaces, probably either from mold or fungus growth, metallic impurities in the paper, or other conditions in combination with dampness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foxing"@en .

aat:300078898 a skos:Concept ;
    skos:definition "Walls that project from or are separate from a building; the term is reserved for substantial constructions of masonry, lumber, or another such material. Examples of a freestanding walls could be a wall used as a room divider or a wall used as a privacy fence. For walls used to resist lateral loads, use \"retaining walls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freestanding walls"@en .

aat:300078912 a skos:Concept ;
    skos:definition "Ground plans that represent a horizontal section of a building, a site, a city, or occasionally, of an object. The term is used particularly in the context of 16th- to 18th-century drawings, and the meaning of the concept overlaps with \"ground plans\" and \"plans (maps).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ichnographic plans"@en .

aat:300078928 a skos:Concept ;
    skos:definition "Paintings using gouache, which is opaque color that is ground in water and mixed with glue, such as gum and honey. Gouaches may be classified as either drawings or paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouaches"@en .

aat:300078937 a skos:Concept ;
    skos:definition "Horizontal members that tie together and stiffen two opposite rafters, usually at a point about halfway up the rafters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar beams"@en .

aat:300079019 a skos:Concept ;
    skos:definition "Any wall facings over less durable or attractive substances or constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revetments"@en .

aat:300079022 a skos:Concept ;
    skos:definition "Generally, bolts used with nuts to join the side rails or posts of a bed frame to the headboard and footboard. In modern usage, the term commonly refers specifically to a particular kind of bolt and nut configuration: Very long bolts are seated in a counter-bored hole in the bed posts, penetrating into the side rails. A special nut is located in a recess, usually in a round mortise, within the side rail. A special wrench is used to tighten the bolt, which draws the components together securely. This type of bolt used with special nuts is referred to as a \"bed bolt,\" even when used to join parts of other furniture, such as tables, chairs, or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed bolts"@en .

aat:300079026 a skos:Concept ;
    skos:definition "Tacks or pins with a head that is easy to grasp; used to affix papers or pictures to notice boards, to mark points on a map, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "push pins"@en .

aat:300079031 a skos:Concept ;
    skos:definition "Metal plates which protect the lower part of a door from kicks and scratches; similar to kickplates but covering the door to a greater height, usually 39 inches (1 meter) or more from the bottom of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor plates"@en .

aat:300079032 a skos:Concept ;
    skos:definition "Weights, usually cast iron, used to balance vertically hung windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash weights"@en .

aat:300079037 a skos:Concept ;
    skos:definition "Devices used to draw or regulate the flow of water from a pipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faucets"@en .

aat:300079044 a skos:Concept ;
    skos:definition "Pulls for components of furniture or doors that incorporate hanging rings as their main graspable element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring handles"@en .

aat:300079045 a skos:Concept ;
    skos:definition "Decorative handles that use a stylized figure of a lion’s head or body holding a movable or fixed ring in its mouth or looped tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lion and ring handles"@en .

aat:300079054 a skos:Concept ;
    skos:definition "Finish hardware used to hold or support other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holders"@en .

aat:300079055 a skos:Concept ;
    skos:definition "Boxes or receptacles of varied design that are engineered to release a small amount of liquid or powdered soap, usually intended for use in handwashing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soap dispensers"@en .

aat:300079057 a skos:Concept ;
    skos:definition "Wall mounted hardware of varied design intended to secure rolls or sheets of tissue in a restroom or bathroom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet paper holders"@en .

aat:300079058 a skos:Concept ;
    skos:definition "Wall-mounted hardware for use in bathrooms that allow for multiple toothbrushes to be held between uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothbrush holders"@en .

aat:300079059 a skos:Concept ;
    skos:definition "Wall-mounted hardware for use in bathrooms that hold tumblers at the ready for drinking water or rinsing the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumbler holders"@en .

aat:300079060 a skos:Concept ;
    skos:definition "Containers or devices that hold and dispense a small paper towel or cloth, especially as used to dry the hands after washing them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand towel dispensers"@en .

aat:300079067 a skos:Concept ;
    skos:definition "Any projecting piece by which a mechanism is operated or adjusted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "levers"@en .

aat:300079068 a skos:Concept ;
    skos:definition "Hardware mounted on the exterior of the water tank of a toilet that lifts the valve inside the tank allowing water to flow into the toilet bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet tank levers"@en .

aat:300079071 a skos:Concept ;
    skos:definition "Bars or fences erected to prevent people from entering a prohibited area. These are often brightly colored and demountable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety rails"@en .

aat:300079072 a skos:Concept ;
    skos:definition "Devices using a flap, lid, plug, or other design, applied to a pipe or aperture to control the passage of air, steam, water, etc., and that act by yielding to pressure in one direction only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valves"@en .

aat:300079075 a skos:Concept ;
    skos:definition "Racks on which to hang neckties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie racks"@en .

aat:300079076 a skos:Concept ;
    skos:definition "Bars attached to the wall in a shower or near a bathtub that may be grasped to steady the bather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grab bars"@en .

aat:300079077 a skos:Concept ;
    skos:definition "Bars, usually of metal, installed around or near a toilet, or existing as a demountable unit, and used as an assist for lower and raising the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet safety rails"@en .

aat:300079078 a skos:Concept ;
    skos:definition "Valves installed in the bottom of a toilet tank to discharge the water needed to flush the fixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush valves"@en .

aat:300079079 a skos:Concept ;
    skos:definition "Valves connected to water faucets in hospitals or other sanitary environments that control the flow of water without the use of the hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot pedal valves"@en .

aat:300079080 a skos:Concept ;
    skos:definition "Devices for regulating the flow of liquid, usually water, in a pipeline, and providing for the regulation of temperature through the controlled combination of hot and cold sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixing pressure valves"@en .

aat:300079082 a skos:Concept ;
    skos:definition "Devices that are components of soap dispensers that control the passage of soap from the reservoir. These are usually designed to yield to pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soap valves"@en .

aat:300079087 a skos:Concept ;
    skos:definition "Covers, often decorative and metal, that attach to the leg or frame of a piece of wooden furniture so as to hide the hole into which a bed bolt has been inserted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed bolt covers"@en .

aat:300079088 a skos:Concept ;
    skos:definition "Electric or electronic keys in the form of cards, usually with a magnetic stripe or RFID tag embedded that allow the user to open a lock by swiping or inserting the card into a reader."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key cards"@en .

aat:300079089 a skos:Concept ;
    skos:definition "Keys with large parts of the bit filed away to enable it to open low-quality locks as master keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeleton keys"@en .

aat:300079091 a skos:Concept ;
    skos:definition "Joints that have a bead cut on the edge of one or both adjoining members, to conceal the joint and create a more finished appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaded joints"@en .

aat:300079092 a skos:Concept ;
    skos:definition "Hinged joints by which two rods are connected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knuckle joints"@en .

aat:300079093 a skos:Concept ;
    skos:definition "Joints used to separate extremely long buildings into a series of adjacent volumes to resist earthquake damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismic joints"@en .

aat:300079168 a skos:Concept ;
    skos:definition "Refers to caps or hoodlike devices which cover and protect the open top of pipes, stacks, or shafts while permitting the free passage of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowls"@en .

aat:300079172 a skos:Concept ;
    skos:definition "Columns shaped from a single block of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monolithic columns"@en .

aat:300079201 a skos:Concept ;
    skos:definition "Seizing and appropriating real estate or other property to the public domain as a punishment for breach of the law. For the appropriation of real estate accompanying the declaration of its unfitness for habitation or use, use \"condemning.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confiscating"@en .

aat:300079218 a skos:Concept ;
    skos:definition "Rods used as connecting members or braces, especially to counteract the spreading action of vaults or roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie rods"@en .

aat:300079267 a skos:Concept ;
    skos:definition "Small frames that attach to a door surface for insertion of a name card or plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card frames"@en .

aat:300079303 a skos:Concept ;
    skos:definition "Inserts for attachment or fastening that provide a continuous slot for attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "channel inserts"@en .

aat:300079342 a skos:Concept ;
    skos:definition "Threaded bolts, usually embedded in a foundation, for securing a sill, framework, or machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor bolts"@en .

aat:300079368 a skos:Concept ;
    skos:definition "Locks manufactured to fit into a circular hole in a door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bored locks"@en .

aat:300079409 a skos:Concept ;
    skos:definition "Hinges each having a pin fixed permanently in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fast-pin hinges"@en .

aat:300079433 a skos:Concept ;
    skos:definition "Nails having round shanks scored or threaded in a helical pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helical nails"@en .

aat:300079435 a skos:Concept ;
    skos:definition "Stable, three-dimensional structures consisting of members under tension that are contiguous and members under compression that are not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tensegrity structures"@en .

aat:300079436 a skos:Concept ;
    skos:definition "Gifts, funds, or other donations to an institution, to public or charitable causes, or another project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "donations"@en .

aat:300079440 a skos:Concept ;
    skos:definition "Gifts of personal property by will."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bequests"@en .

aat:300079528 a skos:Concept ;
    skos:definition "Small columns in Medieval architecture that are usually attached to walls, piers, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shafts"@en .

aat:300079633 a skos:Concept ;
    skos:definition "Small cabinets with glass doors and generally glass shelves for the display of miniatures or art objects; developed in France and adopted elsewhere. Also, small tables with glass tops used for the same purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitrines"@en .

aat:300079638 a skos:Concept ;
    skos:definition "Stands or frames for supporting or displaying at an angle an artist's canvas, a blackboard, china plate, or other object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "easels"@en .

aat:300079639 a skos:Concept ;
    skos:definition "Pieces of furniture having hooks, used to receive hats, coats, umbrellas, and scarves, and often having shelves, a seat, and mirror. Usually situated near the front door in the hall of the house. For upright postlike stands with pegs or hooks around the top, use \"coat trees.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hall stands"@en .

aat:300079641 a skos:Concept ;
    skos:definition "Frameworks of wire, pegs, bars, gratings, or shelves in or on which articles are placed or suspended, often for storage or stowage; may be freestanding or attached to surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racks"@en .

aat:300079654 a skos:Concept ;
    skos:definition "Permanently removing an object from a collection. In the context of public collections, it is generally done only with reference to a set of official criteria. Typically, the process is applied to art works, books, or other materials that are no longer appropriate, functional, or meeting the standards or objectives of the owner or repository."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deaccessioning"@en .

aat:300079658 a skos:Concept ;
    skos:definition "Making a legal or official record or list of people or objects. Specifically, in museology, creating a written record for an object in a collection in order to identify the object and to record information about it such as provenance, condition, or value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registration"@en .

aat:300079719 a skos:Concept ;
    skos:definition "Surveys of the surface configuration of an area, including natural and man-made features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topographic surveys"@en .

aat:300079749 a skos:Concept ;
    skos:definition "In the context of the modern building trade, refers to drawings or copies of drawings that are kept as file records after completion of a project; may include as-built drawings, which indicate changes made during construction. In historical contexts, refers to copies of architects' design drawings, often on a reduced scale, whether executed or unexecuted designs, kept as records of their work. For scale drawings made from existing structures, generally, use \"measured drawings\"; for drawings that generally depict actual locations, use \"topographical views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record drawings"@en .

aat:300079762 a skos:Concept ;
    skos:definition "Refers to cartoons that depict small portions of a design or other details related to the main cartoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary cartoons"@en .

aat:300079783 a skos:Concept ;
    skos:definition "Designates architectural drawings done early in the design process; often not to scale and may include diagrammatic elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conceptual drawings"@en .

aat:300079795 a skos:Concept ;
    skos:definition "The process of affixing an identification number, tag, or label to an object in a collection or stock of merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marking"@en .

aat:300080031 a skos:Concept ;
    skos:definition "Strips on the door frame against which the door closes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorstops"@en .

aat:300080054 a skos:Concept ;
    skos:definition "Areas or spaces located in ancient Roman baths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman bath spaces"@en .

aat:300080058 a skos:Concept ;
    skos:definition "Natural chalk containing carbon or shale and used for drawing especially since the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black chalk"@en .

aat:300080064 a skos:Concept ;
    skos:definition "Drawing medium made from natural red clay containing iron ocher, ranging in color from reddish brown to blood red. It was used for wall paintings by ancient Egyptians and Romans; in the 16th century it was a popular drawing medium. Originally cut from deposits but later fabricated from the same material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red chalk"@en .

aat:300080091 a skos:Concept ;
    skos:definition "The activity or function of representing in spoken, written, or signed language the attributes or qualities of something or someone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "description"@en .

aat:300080094 a skos:Concept ;
    skos:definition "The action, condition, or cultural concept of visiting different cities, countries or regions, especially distant or unfamiliar places, whether by necessity or for pleasure or education. One common purpose of travel is to see different sights and acquaint oneself with cultures different from one's own."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel"@en .

aat:300080099 a skos:Concept ;
    skos:definition "Monetary assistance, generally used to support people or causes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "financial aid"@en .

aat:300080102 a skos:Concept ;
    skos:definition "Written accounts of the lives of individuals. For the genre regardless of medium, prefer \"biography (general genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biographies"@en .

aat:300080104 a skos:Concept ;
    skos:definition "Literary works that are biographies of individuals written by themselves. For the overall genre, use \"autobiography (genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autobiographies"@en .

aat:300080111 a skos:Concept ;
    skos:definition "Works consisting of separate accounts of lives of people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collective biographies"@en .

aat:300080112 a skos:Concept ;
    skos:definition "Maps that illustrate the routes taken by buses, usually for an urban area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bus route maps"@en .

aat:300080114 a skos:Concept ;
    skos:definition "Appendages, usually of iron or brass, fastened to a door and hinged so that it may be made to strike against a metal plate or the door itself, to attract the attention of those within. Door knockers are usually placed on exterior doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door knockers"@en .

aat:300080123 a skos:Concept ;
    skos:definition "Paintings made on living rock, usually by ancient peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock paintings"@en .

aat:300080131 a skos:Concept ;
    skos:definition "Marks or relief sculpture carved into living rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock carvings"@en .

aat:300080140 a skos:Concept ;
    skos:definition "Surface pattern originally for stone but frequently simulated in other materials, giving the effect of large blocks with deep, wide joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rustication"@en .

aat:300080149 a skos:Concept ;
    skos:definition "Handles in the form of relatively small masses, usually rounded, and projecting from a surface or extremity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knobs"@en .

aat:300080192 a skos:Concept ;
    skos:definition "Published alphabetical lists of post offices in particular regions, often will additional information on staff and administration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post office directories"@en .

aat:300080199 a skos:Concept ;
    skos:definition "Catalogs of works arranged alphabetically by authors' names or by other persons responsible for the intellectual content of the works, such as editors or translators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "author catalogs"@en .

aat:300080208 a skos:Concept ;
    skos:definition "Prehistoric art, especially Paleolithic, found in caves, including paintings, carvings, and certain artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cave art"@en .

aat:300080212 a skos:Concept ;
    skos:definition "Nails designed to attach metal mesh lath to a wood or masonry support, either having a short shank and broad head, or having a hook head, which is an offset top at a right angle to the shank of the nail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal lath nails"@en .

aat:300080226 a skos:Concept ;
    skos:definition "Metal or plastic ringlike devices that provide a reinforced hole in a material, such as cloth or leather, that might otherwise tear from the stress on the hole when a fastener or other device is passed through it or attached to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grommets"@en .

aat:300080232 a skos:Concept ;
    skos:definition "Escutcheons cut for both knob and keyhole or cylinder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combined escutcheon plates"@en .

aat:300080241 a skos:Concept ;
    skos:definition "Subsidies or grants of financial aid from a government or other institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subventions"@en .

aat:300080248 a skos:Concept ;
    skos:definition "Use broadly for funds allocated by a government or organization usually for a specific purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grants"@en .

aat:300080311 a skos:Concept ;
    skos:definition "Fiber made from the inner bark of the mulberry tree, including species Broussonetia papyrifera and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kozo"@en .

aat:300080316 a skos:Concept ;
    skos:definition "Fiber from the species Wikstroemia canescens, used in papermaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gampi"@en .

aat:300080402 a skos:Concept ;
    skos:definition "The study or practice of the analytical description, interpretation, and evaluation of architectural works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural criticism"@en .

aat:300080408 a skos:Concept ;
    skos:definition "Outdoor entertainments on a lavish scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fêtes"@en .

aat:300080418 a skos:Concept ;
    skos:definition "In carpentry, right-angle joints comprising one piece having a dado groove cut, and the other having a tongue, groove, and rabbet cut, produced in a way so the protruding parts fit into the grooves of the opposing pieces to form a joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dado, tongue and rabbet joints"@en .

aat:300080484 a skos:Concept ;
    skos:definition "Pipes conducting water from a head gate to a water wheel; also conduits for conveying water to a power plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penstocks"@en .

aat:300080499 a skos:Concept ;
    skos:definition "Blocks, usually plain, forming the low pedestals of statues or columns, and also for the plain faces at the lower part of walls or pedestals. [Savannah: Could refer to a hoof, clogs, or an architectural base. Would need more context to assign a value.]"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socles"@en .

aat:300080505 a skos:Concept ;
    skos:definition "Plumbing fixtures for receiving and draining away urine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urinals"@en .

aat:300080511 a skos:Concept ;
    skos:definition "Open web trusses with vertical members but without diagonals and with rigid joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vierendeel trusses"@en .

aat:300080514 a skos:Concept ;
    skos:definition "Systems of trenches containing coarse aggregate and distribution pipes through which septic tank effluent may seep into the surrounding soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaching fields"@en .

aat:300080539 a skos:Concept ;
    skos:definition "Parts or components of fire alarm systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire alarm system components"@en .

aat:300080597 a skos:Concept ;
    skos:definition "Tools and devices used to carry out surgeries, both invasive surgery or non-invasive surgery, including tools for modifying bodily tissue and providing access for viewing it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surgical instruments"@en .

aat:300080603 a skos:Concept ;
    skos:definition "Rooms in barns or stables with provisions for feeding horses or other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feed rooms"@en .

aat:300080610 a skos:Concept ;
    skos:definition "In barns or stables, individual compartments in which an animal may move about freely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box stalls"@en .

aat:300080617 a skos:Concept ;
    skos:definition "Large basins or other vessels, often made of stone and with a cover, set in or on the ground or fixed on a pedestal; intended to catch the runoff water used during the baptism ceremony. As used in certain denominations, the basin must have a drain so that the baptismal water can flow directly into the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal fonts"@en .

aat:300080628 a skos:Concept ;
    skos:definition "Projects designed and carried out by students as part of a learning or training experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student projects"@en .

aat:300080663 a skos:Concept ;
    skos:definition "Material that prevents build-up or promotes discharge of static electricity, as in film or textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antistatic agent"@en .

aat:300080665 a skos:Concept ;
    skos:definition "An inert powder added to a base material such as a paint, pigment, adhesive, plastic, paper, fabric, wax, or concrete. Fillers may serve multiple purposes such as: extend a matrix, dilute a color, decrease cost, provide bulk, increase strength, improve working properties or generally enhance performance. Examples of materials that are used as fillers are acrylic, calcium carbonate, barium sulfate, clay, diatomaceous earth, glass fibers, glass spheres, gypsum, sand, starch, talc, titanium dioxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filler"@en .

aat:300080672 a skos:Concept ;
    skos:definition "Window locks that require special keys or tools to open, ensuring that the windows they are mounted on stay closed until they need to be cleaned, or for any other purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air conditioning locks"@en .

aat:300080680 a skos:Concept ;
    skos:definition "All the devices, fittings, or assemblies necessary to operate a window, such as catches, sash cords, fasteners, hinges, handles, locks, pulls, pulleys, and sash weights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window hardware"@en .

aat:300080693 a skos:Concept ;
    skos:definition "Large cupped pulls for heavy doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barn-door pulls"@en .

aat:300080744 a skos:Concept ;
    skos:definition "Strikes with a spring plunger that completely fills the hole when the door is open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dustproof strikes"@en .

aat:300080791 a skos:Concept ;
    skos:definition "Refers to the main rooms of ancient Greek houses and for similar rooms in ancient Roman houses used as reception areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oeci"@en .

aat:300080798 a skos:Concept ;
    skos:definition "Refers to many-storied, skylit spaces in or between high-rise buildings, common since 1960."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atriums"@en .

aat:300080819 a skos:Concept ;
    skos:definition "In the strictest sense, refers to the cultures of the countries of South America, North America, Central America, and the Caribbean that were originally colonized by Spain. It may also refer more broadly to all the cultures of this region, including those that were originally colonized by the French or Portuguese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin American"@en .

aat:300080839 a skos:Concept ;
    skos:definition "Finish hardware used to secure objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "securing devices"@en .

aat:300080840 a skos:Concept ;
    skos:definition "The protruding parts of latches or locks that prevent a door from opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolts"@en .

aat:300080862 a skos:Concept ;
    skos:definition "Threaded bolts with straight shanks and with heads of varied shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine bolts"@en .

aat:300080876 a skos:Concept ;
    skos:definition "Nails each having a large flat head, round shank, and long flattened point; used on sheet metal and dry wallboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clout nails"@en .

aat:300080898 a skos:Concept ;
    skos:definition "Various types of patterns that consist of interweaving lines or bands. If these are rectilinear, use \"frets (patterns)\" or \"fretwork,\" if they form a very regular series of near circles, use \"guilloche.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interlace"@en .

aat:300080942 a skos:Concept ;
    skos:definition "Pear-shaped pendants installed as handles or pulls on doors or cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pear drop handles"@en .

aat:300080948 a skos:Concept ;
    skos:definition "Machine screws that are permanently combined with a lock washer which was inserted before the thread was cut. The term probably derives from an abbreviation for “assemblies,” because the screw and washer are pre-assembled when purchased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sems"@en .

aat:300080971 a skos:Concept ;
    skos:definition "Refers to the court toward the back of a Roman house, commonly with a small garden surrounded by a colonnade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peristyles"@en .

aat:300081023 a skos:Concept ;
    skos:definition "Drawing material prepared by binding carbon particles in gall extract (from an abnormal growth on oak trees), that when applied to paper darkens by oxidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron-gall ink"@en .

aat:300081053 a skos:Concept ;
    skos:definition "Works in any medium of the visual arts that explore a subject or are preliminary to a separate, more finalized work; more finished than sketches. For representations or diagrams that clarify, usually accompanying a text, use \"illustrations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studies"@en .

aat:300081060 a skos:Concept ;
    skos:definition "Preparatory studies of pictorial or design details. For minute parts of a larger structure, object, or image, use \"details.\" For drawings of architectural construction or design details, use \"detail drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detail studies"@en .

aat:300081067 a skos:Concept ;
    skos:definition "Studies, usually drawings, that concentrate on the depiction of cloth or a detail of cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drapery studies"@en .

aat:300081078 a skos:Concept ;
    skos:definition "More finished than \"preliminary sketches\" and more concentrated on one portion of a design than \"preparatory drawings.\" Not appropriate with regard to architecture; then prefer \"studies (visual works)\" or \"detail studies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preparatory studies"@en .

aat:300081090 a skos:Concept ;
    skos:definition "Drawings, prints, or statues of flayed human or animal figures, used in the study of musculature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "écorchés"@en .

aat:300081106 a skos:Concept ;
    skos:definition "Things made, usually visual works or writings, chiefly in order to practice or display a specific technical point or aspect, especially by students."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exercises"@en .

aat:300081124 a skos:Concept ;
    skos:definition "Rooms containing a sink and toilet, but neither tub nor shower."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavatories"@en .

aat:300081126 a skos:Concept ;
    skos:definition "Refers to enclosures erected around toilets for privacy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet compartments"@en .

aat:300081128 a skos:Concept ;
    skos:definition "Showrooms in hotels specially arranged for the display of merchandise by traveling salesmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sample rooms"@en .

aat:300081138 a skos:Concept ;
    skos:definition "Handmade, sun-dried brick typically made from wet mud and straw, sometimes also containing sand, clay, dung, grass, chaff, or blood. It is porous, wettable, susceptible to wet-dry cycle degradation, but good heat insulation. Adobe walls are typically built using mud mortar between the brick layers followed with a mud stucco finish layer. It was used as early as 7000 BCE for houses, buildings, and pyramids, particularly in arid climates such as Mesopotamia, Persia, Palestine, India, China, and the pre-Columbian Americas. For sun-dried brick that may or may contain the binders of adobe, use the more general \"sun-dried brick.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adobe"@en .

aat:300081146 a skos:Concept ;
    skos:definition "Brick that is baked in the sun rather than hardened by the heat of a fire or kiln; the earliest type of brick. Sun-dried brick has the advantage of being less expensive than fired brick but is generally less durable; it is well-suited to dry climates. For sun-dried brick containing straw and other binders, use the more specific \"adobe.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun-dried brick"@en .

aat:300081172 a skos:Concept ;
    skos:definition "A reddish hardwood obtained from any of several trees of the genus Pterocarpus native to Sierra Leone and the west coast of Africa. For the wood of the genus Baphia, which is similar in appearance, use \"camwood.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barwood"@en .

aat:300081180 a skos:Concept ;
    skos:definition "A black ink containing powdered carbon pigment, usually lampblack in a dilute aqueous solution of gum or glue. Carbon inks were used in China as early as the 3rd millennium BCE, also found on Egyptian papyrus and medieval manuscripts. Black carbon inks were replaced with iron gall inks in the 12th century. Distinguished from \"India ink,\" which is a dispersion of carbon black in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black carbon ink"@en .

aat:300081184 a skos:Concept ;
    skos:definition "Rooms devoted to gambling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaming rooms"@en .

aat:300081245 a skos:Concept ;
    skos:definition "Tablets hung in church that display to the congregation the numbers of hymns and readings for services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hymn boards"@en .

aat:300081247 a skos:Concept ;
    skos:definition "Sprinklers installed inside buildings to extinguish fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire sprinklers"@en .

aat:300081299 a skos:Concept ;
    skos:definition "Refers to a system of projection that strictly uses the distinctive procedure of projective geometry by which the representation or mapping of one line or plane to another line or plane is done by projecting a series of points from one onto the other. A series of points on one plane is projected onto the second plane by choosing a point of origin, from which lines are constructed that pass through the points on the first plane and make contact with the second plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perspective projection"@en .

aat:300081303 a skos:Concept ;
    skos:definition "Refers to a system for representing three-dimensional objects in two dimensions by using projecting lines that are parallel to each other, as opposed to using lines that converge to suggest recession in space. In some senses, the meaning of the term overlaps with \"parallel perspective.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel projection"@en .

aat:300081309 a skos:Concept ;
    skos:definition "Axonometric projection in which all three spatial axes are inclined, but only two are equally inclined to the plane of projection or drawing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimetric projection"@en .

aat:300081313 a skos:Concept ;
    skos:definition "Axonometric projection in which the three spatial axes are equally inclined to the plane of projection or drawing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isometric projection"@en .

aat:300081316 a skos:Concept ;
    skos:definition "Refers to a projection in which parallel lines project from the picture plane at an angle that is slanting or declining from the vertical or horizontal, as opposed to being perpendicular to the picture plane. It is distinct from \"oblique perspective,\" in which parallel lines may appear to converge as they recede into space rather than remaining parallel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblique projection"@en .

aat:300081319 a skos:Concept ;
    skos:definition "Refers to axonometric projection in which the three spatial axes are unequally inclined to the plane of projection or drawing surface, and the ratio of foreshortening is different for all three axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimetric projection"@en .

aat:300081328 a skos:Concept ;
    skos:definition "Refers to a system of projection in which principal faces of an object or structure are parallel to the picture plane, but multiple views of the object or structure are provided in order to fully represent all sides of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiview projection"@en .

aat:300081335 a skos:Concept ;
    skos:definition "Use generally for the production and use of microforms. For the process of producing microforms, use \"microphotography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micrographics"@en .

aat:300081341 a skos:Concept ;
    skos:definition "Areas in a building, usually a tall building, where there is a step-like recession in a wall or building profile in order to reduce the obstruction the upper stories offer to sunlight and air reaching the lower stories and street."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setbacks"@en .

aat:300081345 a skos:Concept ;
    skos:definition "Distance from the curb or other established line within which no building may be erected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setback"@en .

aat:300081349 a skos:Concept ;
    skos:definition "Plate consisting of an overlay of silver on copper, brass, or other metal so as to simulate solid silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sheffield plate"@en .

aat:300081356 a skos:Concept ;
    skos:definition "Utilitarian and decorative objects made of tinplate and, more rarely, of pure tin. The earliest recorded objects of pure tin appear were found in Egypt, dating to the 18th dynasty (1567-1320 BCE). The process of plating sheets of iron and steel with tin was perfected in the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinware"@en .

aat:300081361 a skos:Concept ;
    skos:definition "Any object made from wood: from \"tree.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treenware"@en .

aat:300081370 a skos:Concept ;
    skos:definition "Attaching to a secondary support; as in attaching a paper artifact to a stiff board, sometimes preparatory to matting, or in science to the mounting of specimens onto slides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounting"@en .

aat:300081382 a skos:Concept ;
    skos:definition "Devices, usually small, that perform calculations, requiring manual action for each individual operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calculators"@en .

aat:300081446 a skos:Concept ;
    skos:definition "The length of time during which something runs its course, characterized by some prevalent or distinguishing condition, circumstance, or occurrence, or by the rule of a particular government or dynasty; a distinct historical or cultural portion or division of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "period"@en .

aat:300081475 a skos:Concept ;
    skos:definition "Material derived from or comprising roots, which are parts of a plant that develop, growing typically from the radicle and downward into the soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "root"@en .

aat:300081476 a skos:Concept ;
    skos:definition "Stairs in which two spiral stairs are intertwined, one of the most famous examples being the central staircase at the Château of Chambord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double spiral stairs"@en .

aat:300081531 a skos:Concept ;
    skos:definition "Drawings, computer models, or works in other media that propose how something may have looked at a previous time, and for full-scale new objects or structures based on historical, archaeological, or other similar evidence. For models made to represent how something looked at a previous time, use \"historical models.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reconstructions"@en .

aat:300081545 a skos:Concept ;
    skos:definition "Pairs of columns which interlock as if the shaft of one were gripping the shaft of the other; for pairs of columns set close together so as to form a visual unit, use \"coupled columns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doubled columns"@en .

aat:300081547 a skos:Concept ;
    skos:definition "Engaged columns flanked by half pilasters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flanked columns"@en .

aat:300081551 a skos:Concept ;
    skos:definition "Stairs cantilevered from the stairwell without a newel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying stairs"@en .

aat:300081553 a skos:Concept ;
    skos:definition "Straight wire hangers that may be cut to appropriate lengths, used to support forms for concrete work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut and straight hangers"@en .

aat:300081559 a skos:Concept ;
    skos:definition "Support or anchoring hangers suspended from horizontal ceiling slabs or other members by means of tabs or clips extending at right angles from the vertical portion of the hanger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clip hangers"@en .

aat:300081562 a skos:Concept ;
    skos:definition "Hangers for steel-to-steel or for wood comprising parallel inverted-U-shaped metal wires or bands joined at the open ends by a channeled bar, intended to be suspended from a horizontal surface and clipped to or otherwise attached to another horizontal member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "channel saddle hangers"@en .

aat:300081565 a skos:Concept ;
    skos:definition "Threaded fasteners that screw into a threaded hole rather than into a nut. Cap screws are specified by diameter, length, and thread pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap screws"@en .

aat:300081570 a skos:Concept ;
    skos:definition "Hangers bent into a U-shape, typically having a rounded rather than angled base, used to support forms for concrete work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottom bend hangers"@en .

aat:300081574 a skos:Concept ;
    skos:definition "U-shaped supporting or anchoring hangers having upper ends that are bent at right angles, used to support forms for concrete work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottom and flange bend hangers"@en .

aat:300081589 a skos:Concept ;
    skos:definition "Semicircular outdoor seats, usually of stone or concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exedrae"@en .

aat:300081593 a skos:Concept ;
    skos:definition "Metal support or anchoring hangers mounted at the ceiling and attached at least in part by being driven into a horizontal or vertical beam, slab, or other member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drive type hangers"@en .

aat:300081602 a skos:Concept ;
    skos:definition "Joist hangers that allow a joist to be hung from two points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double style hangers"@en .

aat:300081606 a skos:Concept ;
    skos:definition "Joist hangers having metal seats for the joist that have been shaped or formed, rather than being made of metal that has been bent into shape. The formed seat tends to be stronger than bent metal seats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formed seat hangers"@en .

aat:300081608 a skos:Concept ;
    skos:definition "Hangers designed to attach to a formed ridge, such as at a roof line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formed ridge hangers"@en .

aat:300081610 a skos:Concept ;
    skos:definition "Joist hangers designed to allow the top of the attached joist to be flush or even with the top of the beam to which it is attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush top hangers"@en .

aat:300081612 a skos:Concept ;
    skos:definition "Hangers made of metal wire that are attached to the top of the supporting member, bending at a right angle down the face to receive the supported member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flange hangers"@en .

aat:300081614 a skos:Concept ;
    skos:definition "Deep, large sinks used for washing laundry; for deep, large sinks used predominantly in factories and hospitals for washing the arms and upper body, use \"wash sinks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundry trays"@en .

aat:300081616 a skos:Concept ;
    skos:definition "Large, deep sinks used for washing the arms and upper body and more commonly encountered in factories and hospitals than in houses; for smaller sinks for washing the hands and face, use \"lavatories (sinks).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wash sinks"@en .

aat:300081618 a skos:Concept ;
    skos:definition "Panels or ornamental structures situated above mantels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overmantels"@en .

aat:300081658 a skos:Concept ;
    skos:definition "Measuring techniques used to date bone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone dating techniques"@en .

aat:300081659 a skos:Concept ;
    skos:definition "Method of relative dating by measuring the amount of fluorine absorbed by groundwater percolation into the crystal lattice of the mineral component of buried bone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorine dating"@en .

aat:300081681 a skos:Concept ;
    skos:definition "Method used for the relative dating of bone by measuring the amount of nitrogen remaining in its collagen, which decomposes at a generally uniform rate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrogen dating"@en .

aat:300081683 a skos:Concept ;
    skos:definition "Techniques having to do with analysis and testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analysis and testing techniques"@en .

aat:300081685 a skos:Concept ;
    skos:definition "Analysis of the chemical composition of a material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical analysis"@en .

aat:300081693 a skos:Concept ;
    skos:definition "Analyzing an artifact to find out what trace elements are present, and in what proportion, especially to determine the source of the raw materials from which the artifact was made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trace element analysis"@en .

aat:300081731 a skos:Concept ;
    skos:definition "Refers to the outer or lesser courts of mansions or castles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base-courts"@en .

aat:300081742 a skos:Concept ;
    skos:definition "Technique of activation analysis induced by neutrons to determine chemical elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutron activation analysis"@en .

aat:300081748 a skos:Concept ;
    skos:definition "Method of dating by measuring, on an exposed surface of obsidian, the thickness of the hydration layer caused by the natural intake of water on that surface from the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obsidian hydration dating"@en .

aat:300081754 a skos:Concept ;
    skos:definition "Method of dating by measuring the direction and intensity of the paleomagnetism in materials and comparing the results to known records of fluctuations in the earth's magnetic field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleomagnetic dating"@en .

aat:300081761 a skos:Concept ;
    skos:definition "Markets at which buyers and sellers converge according to a regular schedule; merchants set up temporary stands or tables, usually occupying the same location in the market space and offering the same goods for sale on each occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periodic markets"@en .

aat:300081762 a skos:Concept ;
    skos:definition "The network of small, repeated cellular forms resembling bottomless niches and sometimes corbeled and structural, more often suspended and decorative, which form the undersurfaces of vaults and domes common in Islamic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muqarnas"@en .

aat:300081772 a skos:Concept ;
    skos:definition "Joist hangers designed to hang a joist at a corner or recess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nook type hangers"@en .

aat:300081774 a skos:Concept ;
    skos:definition "Support or anchoring hangers made of wire that is notched or nicked to allow bending; used to support forms for concrete work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nicked hanging wire hangers"@en .

aat:300081777 a skos:Concept ;
    skos:definition "Bolts shaped into wedges at the end, which are inserted into a prepared hole in a heavy unit or stone and secured in place with poured concrete or melted lead; also, eyebolts inserted into heavy stones and used in the manner of a lewis to lift and move the stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lewis bolt anchors"@en .

aat:300081781 a skos:Concept ;
    skos:definition "Rooms or spaces in domestic contexts used for reading, writing, and study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studies"@en .

aat:300081784 a skos:Concept ;
    skos:definition "Rooms set aside for writing, as in a residence, hotel, or club."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing rooms"@en .

aat:300081818 a skos:Concept ;
    skos:definition "U-shaped joist hangers forming a pocket for attaching a beam or other member, attached to a vertical surface by wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket style hangers"@en .

aat:300081820 a skos:Concept ;
    skos:definition "Hangers for steel-to-steel or for wood, comprising parallel inverted-U-shaped metal wires or bands joined at the open ends by a flat plate or bar, intended to be suspended from a horizontal member and attached to a horizontal beam or ceiling slab."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate saddle hangers"@en .

aat:300081842 a skos:Concept ;
    skos:definition "Small dining areas, usually extensions of kitchens or pantries; for such areas when they are extensions of living rooms, use \"dining alcoves.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinettes"@en .

aat:300081912 a skos:Concept ;
    skos:definition "Dating by measuring processes which involve the decay of radioactive isotopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radioactive dating"@en .

aat:300081920 a skos:Concept ;
    skos:definition "Method of dating glassy materials or objects based on the known rate of spontaneous fission of uranium 233 atoms, which leave detectable damage trails, called fission tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fission track dating"@en .

aat:300081924 a skos:Concept ;
    skos:definition "Method of dating potassium-rich materials or objects by measuring the amount of radioactive decay in the ratio of potassium to argon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium-argon dating"@en .

aat:300081949 a skos:Concept ;
    skos:definition "U-shaped joist hangers that are suspended from a beam or other horizontal member by a hook-shaped extension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hook-over hangers"@en .

aat:300081956 a skos:Concept ;
    skos:definition "Rooms containing a number of beds and serving as communal sleeping quarters, as in an institution, fraternity house, or passenger ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dormitories"@en .

aat:300081958 a skos:Concept ;
    skos:definition "Rooms for sitting and relaxation, often located adjacent to bedrooms and generally more private than living rooms or parlors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sitting rooms"@en .

aat:300081962 a skos:Concept ;
    skos:definition "Inverted-U-shaped metal wire tie supports or anchors used for the purpose of hanging concrete slabs or other materials on a ceiling. The ties are called \"snap ties\" because they are designed to be broken off at a specified depth below the exposed surface, for example after the concrete slab has hardened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snap-tie hangers"@en .

aat:300081964 a skos:Concept ;
    skos:definition "Metal, plastic, or fiber shells inserted into a hole in masonry, plaster, or concrete, which expand when the screw is driven in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw anchors"@en .

aat:300081966 a skos:Concept ;
    skos:definition "Hangers for wood-to-masonry attachments or other materials, that are suspended or lapped over the top of the girder or other member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle hangers"@en .

aat:300081975 a skos:Concept ;
    skos:definition "Inverted-U-shaped metal or wire tie supports or anchors used for hanging concrete slabs or other materials on a ceiling. For such ties designed so that the ends may be broken off, use \"snap-tie hangers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie hangers"@en .

aat:300081982 a skos:Concept ;
    skos:definition "Tie hangers or other hangers that incorporate a coil or other mechanism to allow small amounts of vertical or lateral movement, used to suspend ceilings, floors, in bridges, and for other construction uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coil hangers"@en .

aat:300082014 a skos:Concept ;
    skos:definition "Service rooms between kitchens and dining rooms, typically equipped with counters, a sink, and storage space for china and silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butlers' pantries"@en .

aat:300082037 a skos:Concept ;
    skos:definition "Hangers for wood-to-masonry attachments or other materials, designed so that they can be adjusted to a variety of pitch angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable hangers"@en .

aat:300082041 a skos:Concept ;
    skos:definition "Parts or components of manholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manhole components"@en .

aat:300082077 a skos:Concept ;
    skos:definition "Stories in basilican churches that are above the nave arcade and contain a substantial gallery passage; distinct from \"triforiums,\" which always are at the level just below the side roof and do not have large passages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribunes"@en .

aat:300082087 a skos:Concept ;
    skos:definition "Rooms in which guns or other armaments are kept, whether in a private residence, an institutional building, or a ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun rooms"@en .

aat:300082091 a skos:Concept ;
    skos:definition "Rooms in houses set aside for the care of babies and young children during the night, typically having little furniture beyond bedding for the children, a chair and sometimes a cot or bed for the caretaker, and facilities for washing, bathing, and preparing the infant's bottle or food. Night nurseries were seldom playrooms, however, playrooms and schoolrooms were usually located nearby."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night nurseries"@en .

aat:300082094 a skos:Concept ;
    skos:definition "Rooms where servants gather and dine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servants' halls"@en .

aat:300082114 a skos:Concept ;
    skos:definition "Control centers for on-call nursing staff in health facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nurses' stations"@en .

aat:300082152 a skos:Concept ;
    skos:definition "In construction, support or anchoring hangers made of metal wire, used to attach a wooden member to a metal member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal-to-wood wire hangers"@en .

aat:300082154 a skos:Concept ;
    skos:definition "In construction, hangers that are designed for wood-to-steel attachment of joists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood-to-steel joist hangers"@en .

aat:300082156 a skos:Concept ;
    skos:definition "In construction, support or anchoring hangers used to attach two steel members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel-to-steel beam hangers"@en .

aat:300082158 a skos:Concept ;
    skos:definition "In construction, support or anchoring hangers used to attach a wooden member to masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood-to-masonry hangers"@en .

aat:300082243 a skos:Concept ;
    skos:definition "Rooms in the Roman bath or gymnasium between the laconicum, sudatorium, or stove, and the caldarium or warm bath where athletes retired to remove sweat from their bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sudationes"@en .

aat:300082254 a skos:Concept ;
    skos:definition "Rooms or separate structures devoted to funeral services in funeral homes. For chapels intended to permanently contain individual or family tombs, use \"sepulchral chapels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral chapels"@en .

aat:300082428 a skos:Concept ;
    skos:definition "Foliate or clawlike ornaments that project from the round base of a column toward a corner of a plinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "griffes"@en .

aat:300082545 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in northwestern Burkina Faso and Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bobo"@en .

aat:300082888 a skos:Concept ;
    skos:definition "Rooms found in large houses and hotels intended for meals that are part of late evening entertainments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supper rooms"@en .

aat:300082978 a skos:Concept ;
    skos:definition "Spaces constructed and used for containing and safekeeping valuables from theft or damage; may be climate controlled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaults"@en .

aat:300082981 a skos:Concept ;
    skos:definition "Watercraft generally larger and more seaworthy than boats, usually propelled by sails or engines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships"@en .

aat:300082988 a skos:Concept ;
    skos:definition "Sail- or power-driven watercraft of various kinds, usually light and used for racing or for recreation. In early use, yachts were fast and often used for the conveyance of royal or other important persons; in modern use, recreational yachts are luxury vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yachts"@en .

aat:300082998 a skos:Concept ;
    skos:definition "Generally, any electronic calculator that is small enough to be carried in a pocket or bag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket calculators"@en .

aat:300083002 a skos:Concept ;
    skos:definition "Camouflaged or otherwise purposely concealed places in which hunters, especially wildfowl hunters, hide from game, or for similar lightly built structures for observing wildlife at close range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blinds"@en .

aat:300083005 a skos:Concept ;
    skos:definition "Christian liturgical vessels in which the Host (the bread consecrated in the Eucharist) may be displayed through an opening or through a transparent material; used either on an altar or in processions. It is usually made of gold or silver and is often decorated with precious stones. From the Baroque period onwards the Host is typically surrounded by a sunburst design. Modern usage has limited the meaning to vessels intended for the exposition of the Host; however the term was originally applied to all kinds of vessels of goldsmith's or silversmith's work in which glass or crystal were used to allow the contents to be readily visible, whether the contents were the Host, a relic of a saint, or another object. Distinguished from \"pyxes,\" which are vessels used to hold the reserved Host on the altar or to carry the Eucharist to the sick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monstrances"@en .

aat:300083008 a skos:Concept ;
    skos:definition "Christian liturgical vessels or containers, usually circular, used to hold the reserved hosts on the altar or to carry the eucharist to the sick. For the similar small vessels found within the tabernacle, holding the host for use in the monstrance, use \"custodes.\" For vessels used to hold the hosts for distribution to the faithful during a liturgy, use \"ciboria (vessels).\" Early in church history, the word \"pyx\" was used in a very general sense, derived from the Latin and Greek words for wood of the boxwood tree, and intended to mean any containers of various sizes and shapes used to contain eucharistic bread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyxes"@en .

aat:300083012 a skos:Concept ;
    skos:definition "Farm buildings, generally of the 17th to early 19th century, where dairy products are made and stored, usually supervised by country ladies. Distinguished from \"dairy plants\" by their lack of mechanization. For subsidiary agricultural buildings devoted primarily to the care of milk, whether mechanized or not, prefer \"milk houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dairies"@en .

aat:300083021 a skos:Concept ;
    skos:definition "Illustrations on the first page of a book, usually facing the title page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontispieces"@en .

aat:300083023 a skos:Concept ;
    skos:definition "Endleaves made of paper, often decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endpapers"@en .

aat:300083029 a skos:Concept ;
    skos:definition "Parts or components of scaenae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaenae components"@en .

aat:300083030 a skos:Concept ;
    skos:definition "Refers to the facades of the stage buildings of ancient Roman theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaenae frontes"@en .

aat:300083039 a skos:Concept ;
    skos:definition "Passages or aisles in Greek theaters concentric with the outer wall. For similar features in Roman theaters, use \"praecinctiones.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diazomata"@en .

aat:300083042 a skos:Concept ;
    skos:definition "The semicircular spaces before the scaena in ancient theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchestras"@en .

aat:300083076 a skos:Concept ;
    skos:definition "Spaces between the outer and inner doors to buildings, or for sheltered spaces, recessed in the mass of the building, just outside the outer doors. For spaces just inside the outer door but not separated from the building interior by any barrier such as a door, use \"entrance halls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestibules"@en .

aat:300100045 a skos:Concept ;
    skos:definition "Small, often quite highly finished versions of larger paintings or sculptures, made to be shown to the patron in order to indicate what is intended, or a highly finished drawing serving that purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modelli"@en .

aat:300100052 a skos:Concept ;
    skos:definition "Architectural elements found in theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theater elements"@en .

aat:300100054 a skos:Concept ;
    skos:definition "Framing arches through which, in most modern theaters, the stage setting is revealed to the audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proscenium arches"@en .

aat:300100057 a skos:Concept ;
    skos:definition "The surface of a stage, commonly made of wood, on which the players perform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stage floors"@en .

aat:300100059 a skos:Concept ;
    skos:definition "Openings for the passage of actors or objects, commonly in the stage floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traps"@en .

aat:300100062 a skos:Concept ;
    skos:definition "Open frameworks of beams over a stage, below the roof but with working room between the grid and the roof, used principally for the suspension of drapery and scenery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gridirons"@en .

aat:300100078 a skos:Concept ;
    skos:definition "Parts of theaters holding the stage and the space above it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stage houses"@en .

aat:300100082 a skos:Concept ;
    skos:definition "Parts or components of stages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stage components"@en .

aat:300100084 a skos:Concept ;
    skos:definition "Parts of theater stages nearest the audience and usually projecting beyond the curtain. For the acting surfaces of ancient Greek and Roman theaters, use \"proscenia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forestages"@en .

aat:300100093 a skos:Concept ;
    skos:definition "Open stages that project into the audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thrust stages"@en .

aat:300100100 a skos:Concept ;
    skos:definition "The spaces above the stage behind the proscenium, out of view of the audience, used during a performance for the storage of hanging scenery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly lofts"@en .

aat:300100104 a skos:Concept ;
    skos:definition "The placing of something, usually a building, in relation to the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar orientation"@en .

aat:300100106 a skos:Concept ;
    skos:definition "The areas offstage and to the side of the acting area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wings"@en .

aat:300100113 a skos:Concept ;
    skos:definition "Sunken spaces in front of the forestage from which an orchestra plays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchestra pits"@en .

aat:300100118 a skos:Concept ;
    skos:definition "Off-stage lounges for performers, also serving as a place where they may receive visitors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green rooms"@en .

aat:300100120 a skos:Concept ;
    skos:definition "An enclosed seating area within a theater that is either permanently or temporarily reserved for small groups of persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxes"@en .

aat:300100131 a skos:Concept ;
    skos:definition "Parts or components of bastions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastion components"@en .

aat:300100132 a skos:Concept ;
    skos:definition "Refers to the spaces between an inner wall and a keep in a castle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inner baileys"@en .

aat:300100134 a skos:Concept ;
    skos:definition "In complex castles, the spaces between the outer and inner walls that form courtyards bordering the central defenses of the castle, and that may house facilities for animal husbandry, storage, processing of materials, or gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outer baileys"@en .

aat:300100142 a skos:Concept ;
    skos:definition "Componenets of battlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battlement components"@en .

aat:300100153 a skos:Concept ;
    skos:definition "Any fixed hanging architectural ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendants"@en .

aat:300100166 a skos:Concept ;
    skos:definition "Plans that illustrate the configuration and location of the foundation, which comprises the supporting elements of a building, located primarily below ground level, that transmit building loads to the soil or rock underneath. They may also note the conditions that are required for the support of a specific structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundation plans"@en .

aat:300100171 a skos:Concept ;
    skos:definition "Renderings made in projection on a plane surface of the finished appearance of the interior walls of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior elevations"@en .

aat:300100175 a skos:Concept ;
    skos:definition "Renderings made in projection on a vertical plane of the finished appearance of the exterior walls of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior elevations"@en .

aat:300100179 a skos:Concept ;
    skos:definition "Architectural drawings that render structural interior space and give the impression of relative position, size, or distance, as the space would appear if viewed from a physical vantage point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior perspectives"@en .

aat:300100181 a skos:Concept ;
    skos:definition "Architectural drawings that render the exteriors of structures and give the impression of relative position, size, or distance, as the structure would if viewed from a physical vantage point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior perspectives"@en .

aat:300100184 a skos:Concept ;
    skos:definition "Drawings, usually in watercolor, in which the design is derived from an accidental mark or blot. This was originally described by the watercolor painter Alexander Couzens in 1786."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blot drawings"@en .

aat:300100186 a skos:Concept ;
    skos:definition "Generally any drawing made without the use of devices such as t-squares, triangles, or other mechanical means of rendering or tracing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freehand drawings"@en .

aat:300100190 a skos:Concept ;
    skos:definition "Drawings of figures that are characterized by rapid execution, either in a studio setting, from public observation, or as purely imaginative renderings of figures in motion. Typically these are not considered finished works but as excercises, preparatory works, or studies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gesture drawings"@en .

aat:300100194 a skos:Concept ;
    skos:definition "Drawings in which forms are indicated primarily by lines, with few or no areas of continuous tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line drawings"@en .

aat:300100197 a skos:Concept ;
    skos:definition "Distinct from \"outline drawings\" in that the lines in contour drawings also follow major spatial edges within an outline; distinct from \"contour maps,\" which delineate contours at regular intervals of elevation; distinct from \"cross-countour drawings,\" in which the lines follow contours across the surface of the form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contour drawings"@en .

aat:300100201 a skos:Concept ;
    skos:definition "Drawings made by moving a drawing implement in one continuous line while looking at the subject of the drawing and not at the drawing itself. These are usually done as excercises in hand-eye coordination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind contour drawings"@en .

aat:300100203 a skos:Concept ;
    skos:definition "Drawings in which lines follow contours of the form across the surface of the form; distinct from \"contour drawings,\" in which lines follow edges of the form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-contour drawings"@en .

aat:300100207 a skos:Concept ;
    skos:definition "Distinct from \"contour drawings\" which depict major spatial contours as well as outlines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outline drawings"@en .

aat:300100209 a skos:Concept ;
    skos:definition "Drawings produced with the aid of instruments such as compasses or T-squares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical drawings"@en .

aat:300100217 a skos:Concept ;
    skos:definition "Drawings executed in silverpoint on pigmented, prepared paper and highlighted in white, where the range of the three resulting tonal values is exploited to depict three-dimensional form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-tone drawings"@en .

aat:300100222 a skos:Concept ;
    skos:definition "Drawings in which surfaces and planes are indicated by contrast between different tones or values, rather than by lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tone drawings"@en .

aat:300100392 a skos:Concept ;
    skos:definition "Wire fences designed to give a shock upon touching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric fences"@en .

aat:300100538 a skos:Concept ;
    skos:definition "Parts or components of pews."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pew components"@en .

aat:300100599 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lwena"@en .

aat:300100810 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting scattered areas of eastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twa"@en .

aat:300100884 a skos:Concept ;
    skos:definition "Use to refer to works produced by a group of nine Bantu-speaking peoples of coastal Kenya who share a common history and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mijikenda"@en .

aat:300100985 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Kenya and in Uganda northeast of Lake Victoria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luyia"@en .

aat:300101041 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in southeastern Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Teita"@en .

aat:300101050 a skos:Concept ;
    skos:definition "Lots used for to store or park motor vehicles for various purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motor vehicle lots"@en .

aat:300101057 a skos:Concept ;
    skos:definition "Volumes containing reproductions of correspondence, made directly from originals through a transfer process. Using a screw-powered letter press in conjunction with a press book, a bound volume of blank, tissue paper pages. Letters written in special copying ink were placed on a dampened page. The book was then closed and the mechanical press screwed down tightly, causing the ink to be transferred to the bound page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterpress copybooks"@en .

aat:300101066 a skos:Concept ;
    skos:definition "Ancient Greek altars to supreme gods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bomoi"@en .

aat:300101210 a skos:Concept ;
    skos:definition "Refers to the the upper-level stages in Elizabethan and contemporary European theaters, including the chamber and tarrase in Elizabethan theaters, although the extent of its existence is controversial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper stages"@en .

aat:300101214 a skos:Concept ;
    skos:definition "Parts or components of upper stages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper stage components"@en .

aat:300101215 a skos:Concept ;
    skos:definition "Houses in which two pens are separated by a passageway, and the whole is covered by a single roof. Originally constructed of logs, they may now be built from any material, the passageway being the prime characteristic of these houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogtrot houses"@en .

aat:300101219 a skos:Concept ;
    skos:definition "Upper stage acting areas, in front of the chamber, of Elizabethan theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarrases"@en .

aat:300101235 a skos:Concept ;
    skos:definition "Portions of the theater backstage used as a place for dressing and storage, for a green room, and sometimes for an inner stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiring houses"@en .

aat:300101241 a skos:Concept ;
    skos:definition "Parts or components of tiring houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiring house components"@en .

aat:300101242 a skos:Concept ;
    skos:definition "Refers to the upper parts of tiring houses in Elizabethan theaters, possibly used as music galleries and for sound effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turrets"@en .

aat:300101256 a skos:Concept ;
    skos:definition "Tanks in which liquid petroleum-based fuel is stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasoline tanks"@en .

aat:300101328 a skos:Concept ;
    skos:definition "Housing whose ultimate cost to the occupant is low, generally due to assistance from government subsidies. Distinguished from \"low income housing,\" which refers to the mandated low income of the occupants rather than the low cost of the units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low cost housing"@en .

aat:300101336 a skos:Concept ;
    skos:definition "Housing units available to occupants whose income does not exceed certain maximum income limits set by local housing authorities. Distinguished from \"low cost housing,\" which refers to the subsidized low rent of the units rather than the low income of the occupants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low income housing"@en .

aat:300101346 a skos:Concept ;
    skos:definition "Designates public sanitary sewers into which branch sewers are connected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "main sewers"@en .

aat:300101361 a skos:Concept ;
    skos:definition "Either of the two edges or borders along a road, especially that portion on which vehicles can be parked in emergencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulders"@en .

aat:300101421 a skos:Concept ;
    skos:definition "Paper screens serving as wall partitions or sliding doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoji"@en .

aat:300101426 a skos:Concept ;
    skos:definition "Deep sinks, usually set low, principally used for emptying waste water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slop sinks"@en .

aat:300101468 a skos:Concept ;
    skos:definition "Circular stone towers which taper toward the top, have a conical stone cap, four to five internal floors, and an entry door high above the ground; common in Ireland, associated with churches, and probably built between the 10th and 12th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round towers"@en .

aat:300101503 a skos:Concept ;
    skos:definition "Road arrangements, resembling four-leaf clovers in plan, for permitting easy traffic movement between intersecting highways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloverleafs"@en .

aat:300101513 a skos:Concept ;
    skos:definition "Refers to wet or dry defensive ditches, often associated with fortifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fosses"@en .

aat:300101536 a skos:Concept ;
    skos:definition "Posts usually supporting outdoor lamps or lanterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lampposts"@en .

aat:300101570 a skos:Concept ;
    skos:definition "Crossings of two highways, or of highways and pedestrian paths or railroads, utilizing an underpass or overpass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grade separations"@en .

aat:300101579 a skos:Concept ;
    skos:definition "Line drawing technique, often used as a training exercise, where the artist or student draws an outline of a subject without lifting their pencil from paper, and without glancing down at the drawing. The method was popularized by Kimon Nicolaïdes in his book The Natural Way to Draw (1941)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contour drawing"@en .

aat:300101582 a skos:Concept ;
    skos:definition "Drawing technique in which lines move in any direction across the form rather than along the edge of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-contour drawing"@en .

aat:300101629 a skos:Concept ;
    skos:definition "Infrastructural components of systems that allow for the movement of large numbers of people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transit system elements"@en .

aat:300101808 a skos:Concept ;
    skos:definition "Structures supporting a number of railroad signals for several tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signal gantries"@en .

aat:300101820 a skos:Concept ;
    skos:definition "New impressions of an edition of a printed publication using the same setting-up of type or plates of the original, or articles, chapters, or other portions of previously published larger works, printed separately subsequent to the original publication, usually but not always from the original type or plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reprints"@en .

aat:300101826 a skos:Concept ;
    skos:definition "Documents which evidence the status of being a citizen, such as passports and birth certificates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citizenship papers"@en .

aat:300101828 a skos:Concept ;
    skos:definition "Sheets that provide detailed information about horse races, including background data on the horses and jockeys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racing forms"@en .

aat:300101908 a skos:Concept ;
    skos:definition "A drawing technique, usually employing red chalk and black chalk or charcoal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "à deux crayons"@en .

aat:300101910 a skos:Concept ;
    skos:definition "A drawing technique usually employing a combination of red, black, and white chalks on a yellowish or off-white paper; especially common in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "à trois crayons"@en .

aat:300101917 a skos:Concept ;
    skos:definition "The shadow of a figure or an object portrayed as it falls or is \"cast\" on another surface. Often used in reference to painting or drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cast shadows"@en .

aat:300101921 a skos:Concept ;
    skos:definition "Shading or modeling with fine, closely laid parallel lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatching"@en .

aat:300101925 a skos:Concept ;
    skos:definition "Hatching in which a network of lines creating a darker value is made by drawing one set of hatchings over another at a different angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-hatching"@en .

aat:300101932 a skos:Concept ;
    skos:definition "Output devices for translating information from computers into pictorial or graphic form on paper or a similar medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plotters"@en .

aat:300101934 a skos:Concept ;
    skos:definition "Plotters in which paper passes under an array of fine metal teeth that deposit electrostatic charges which then attract toner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrostatic plotters"@en .

aat:300101939 a skos:Concept ;
    skos:definition "Plotters that create plots by moving a pen over drafting paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen plotters"@en .

aat:300101943 a skos:Concept ;
    skos:definition "In pouncing, the puncturing of the cartoon or spolvero with a needle as opposed to a perforating wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pricking"@en .

aat:300102051 a skos:Concept ;
    skos:definition "Specific conceptual schemes for the organization or appearance of graphic works, objects, structures, or systems. For details of proposed undertakings or creations in general, including works of art or architecture, or for the actual carrying out of such proposals, use \"projects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "designs"@en .

aat:300102059 a skos:Concept ;
    skos:definition "Planned works, such as works of art or architecture, that were never physically produced. For architecture more specifically, use \"unbuilt projects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unexecuted designs"@en .

aat:300102067 a skos:Concept ;
    skos:definition "Works of art that employ video technology, especially videotapes. For the study and practice of the art of producing such works, use \"video.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video art"@en .

aat:300102117 a skos:Concept ;
    skos:definition "The culture and style of a large ethnic and linguistic group based in the Iringa Region of south-central Tanzania; they the Bantu Bena language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bena"@en .

aat:300102138 a skos:Concept ;
    skos:definition "Refers to the style and culture of an African people living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbunga"@en .

aat:300102195 a skos:Concept ;
    skos:definition "Style and culture of the southern African ethnic group of the same name currently inhabiting Malawi and Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngoni"@en .

aat:300102205 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living mainly in Malawi and also in Zambia, Zimbabwe, and Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyanja"@en .

aat:300102231 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in eastern Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lungu"@en .

aat:300102451 a skos:Concept ;
    skos:definition "Styles belonging to Alaskan Native cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alaskan Native styles"@en .

aat:300102489 a skos:Concept ;
    skos:definition "Refers to the culture of the Yup'ik, a Western Eskimo group of Siberian Asia and of Saint Lawrence Island and the Diomede Islands in the Bering Sea and Strait. The Yup'ik are culturally related to the Chukchi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yup'ik"@en .

aat:300102495 a skos:Concept ;
    skos:definition "Styles belonging to Canadian Arctic Native cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canadian Arctic Native styles"@en .

aat:300102550 a skos:Concept ;
    skos:definition "Refers to products of the Inuit people living along the northern coast of Labrador, now part of Quebec and Newfoundland. Originally a hunting culture focused on bowhead whales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Labrador Inuit"@en .

aat:300102579 a skos:Concept ;
    skos:definition "Native cultures and styles of Greenland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Greenlandic"@en .

aat:300102641 a skos:Concept ;
    skos:definition "Generally, people whose work or business is cleaning, especially of building interiors or of clothing and linens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleaners"@en .

aat:300102799 a skos:Concept ;
    skos:definition "Civil engineers who primarily work with roads and highways, railroads, bridges, aviation, and water transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation engineers"@en .

aat:300102831 a skos:Concept ;
    skos:definition "Formerly included in the Shasta group of Native American peoples but now classified separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Atsugewi"@en .

aat:300102842 a skos:Concept ;
    skos:definition "People responsible for treatment, preventive care, and research directed toward the long-term safekeeping of cultural and natural heritage. For those engaged in making changes to an object or structure in order to prevent further deterioration, see \"preservationists.\" For those who make changes to an object or structure so as to closely approximate its state at a specific time in its past, see \"restorers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservators"@en .

aat:300103035 a skos:Concept ;
    skos:definition "Images made by placing a material such as paper or cloth over a relief or incised or textured surface, and rubbing with a pigment in order to transfer the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbings"@en .

aat:300103043 a skos:Concept ;
    skos:definition "People whose profession has to do with communications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people in communications"@en .

aat:300103375 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Assiniboine, an indigenous people primarily residing in central Canada, as well as parts of the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assiniboine"@en .

aat:300103380 a skos:Concept ;
    skos:definition "Ceramics styles belonging to German Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German Renaissance-Baroque ceramics styles"@en .

aat:300103849 a skos:Concept ;
    skos:definition "Apartments in a substandard building having a series of rooms arranged in a line usually with each room forming the corridor to the next."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad flats"@en .

aat:300103935 a skos:Concept ;
    skos:definition "Rooms such as shelters, or other spaces specifically for protection from outside forces or elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protective spaces"@en .

aat:300103941 a skos:Concept ;
    skos:definition "Spaces or rooms used to store equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equipment spaces"@en .

aat:300103967 a skos:Concept ;
    skos:definition "The sanctuaries of Indian temples. The term may be used for earlier Indian temples as a whole, including sanctuary and attached porches. In Dravidian, Karṇāṭan as well as early Indian architecture, the main temple-structure or shrine or prāsāda in a temple complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vimānas"@en .

aat:300103997 a skos:Concept ;
    skos:definition "Metalworking plants where ore is melted or fused, often with an accompanying chemical change, usually to separate the metal from the other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smelters"@en .

aat:300104098 a skos:Concept ;
    skos:definition "Particular arrangements of vertical elements of a building as seen by observers from the garden view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden elevations"@en .

aat:300104106 a skos:Concept ;
    skos:definition "Particular arrangements of vertical elements of a building as seen by observers from the primary street view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street elevations"@en .

aat:300104224 a skos:Concept ;
    skos:definition "Towers terminated by spires or approximations of spires; refers to the entire construction of tower, spire, and lantern, if present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steeples"@en .

aat:300104300 a skos:Concept ;
    skos:definition "Parts or components of steeples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steeple components"@en .

aat:300104479 a skos:Concept ;
    skos:definition "Refers to spaces in Christian churches, generally between the altar area or sanctuary and the nave, reserved for choristers. For spaces containing the altar area and the choir, when present, use \"chancels.\" For elevated platforms from which a choir, often composed of laity, sings, use \"choir lofts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choirs"@en .

aat:300104620 a skos:Concept ;
    skos:definition "Use to refer to devices that convert chemical energy into voltaic electrical current. Strictest usage applies this term only to devices of two or more galvanic cells, but American English usage is most commonly applied to the single-cell variety."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batteries"@en .

aat:300104723 a skos:Concept ;
    skos:definition "Parts or components of façades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "façade components"@en .

aat:300104771 a skos:Concept ;
    skos:definition "Spaces in theaters used to seat or contain audiences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audience spaces"@en .

aat:300104803 a skos:Concept ;
    skos:definition "Kilns consisting of a series of adjacent chambers in a ring or oval through which fire moves, taking several days to make a circuit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber kilns"@en .

aat:300105442 a skos:Concept ;
    skos:definition "The process of changing something in some particular characteristic such as measure, dimension, course, arrangement, or inclination, without changing into something else. For the modifications themselves, use \"alterations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alteration"@en .

aat:300105444 a skos:Concept ;
    skos:definition "The maintenance of objects as closely as possible to their original condition through appropriate environmentally controlled collection maintenance, repair, and physical treatment. Refers to actions taken to prevent further changes or deterioration in objects, sites, or structures. When such actions are taken on buildings or other structures specifically for cultural, aesthetic, or historic reasons, see \"historic preservation.\" For changes that return an object or structure to a state of historical correctness, see \"restoration (process).\" For actions taken to return to sound condition an already deteriorated structure, see \"rehabilitating.\" For the activity of keeping people and things safe from harm or deterioration generally, see \"protection.\" More generally, for the treatment, preventive care, and research directed toward the long-term safekeeping of cultural and natural heritage, see \"conservation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preservation"@en .

aat:300105494 a skos:Concept ;
    skos:definition "Cable structures in which a field of crossed cables, of different and often reverse curvatures, make up the primary roof surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable net structures"@en .

aat:300105539 a skos:Concept ;
    skos:definition "Long shallow channels positioned under and paralleling the eaves of a building for the purpose of collecting and directing water from a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eaves gutters"@en .

aat:300105584 a skos:Concept ;
    skos:definition "Structures enclosing useful space that constitute the top level of multistory buildings and have walls set back significantly from the walls of the story below; includes quite small structures, surrounded by large areas of flat roof, such as shelters for elevator machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penthouses"@en .

aat:300105595 a skos:Concept ;
    skos:definition "Openwork spires, the upper portion being carried over an open area by crossed arches or buttresses, thus resembling a crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown steeples"@en .

aat:300105599 a skos:Concept ;
    skos:definition "Refers to the style of Italian porcelain produced by Francesco Vezzi in Venice between 1720 and 1729. Influenced by the style of porcelain produced at Vienna and Meissen, it is characterized by a wet looking clear glaze and bold applied and painted decoration including chinoiseries, coats of arms, and forms derived from European silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vezzi"@en .

aat:300105607 a skos:Concept ;
    skos:definition "Refers to the style of German pottery produced in an area including Höhr-Grenzhausen and Grenzau after 1590. It is characterized by a gray body, decorated with regularly placed incised or stamped figures or coats of arms and partially colored with cobalt blue or manganese purple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Westerwald"@en .

aat:300105650 a skos:Concept ;
    skos:definition "Used to describe ceramics originating from the town of the same name, dating from the Middle Ages. From 1800, the work consisted of stoneware jugs and tableware with a shiny brown slip glaze and applied relief, often in white clay. In 1829, a fledspathic glaze was introduced that gave the work the appearance of porcelain. Styles ranged form Classical to Gothic Revival, and animal, flower, and heraldic motifs survived until the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bunzlau"@en .

aat:300105654 a skos:Concept ;
    skos:definition "Places where automobiles are displayed and sold; may include single buildings as well as complexes with sales-and-service buildings and surrounding lots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automobile showrooms"@en .

aat:300105664 a skos:Concept ;
    skos:definition "Refers to the style of ceramics produced by the German factory of the same name, established in 1758. Known predominantly for faience, the factory produced porcelain from the 1760s to the 1790s, turning to creamware from 1802 until production ceased in the 1820s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kelsterbach"@en .

aat:300105675 a skos:Concept ;
    skos:definition "Refers to the style of ceramics originating in the German region of Thuringia and manufactured since the mid 18th century. The work consists of predominently hard-paste porcelain tableware, often in a Baroque style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thuringian"@en .

aat:300105679 a skos:Concept ;
    skos:definition "Parts of a building that project beyond the rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jetties"@en .

aat:300105686 a skos:Concept ;
    skos:definition "Decorative arts styles belonging to French Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Renaissance-Baroque decorative arts styles"@en .

aat:300105688 a skos:Concept ;
    skos:definition "Ceramics styles belonging to French Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Renaissance-Baroque ceramics styles"@en .

aat:300105690 a skos:Concept ;
    skos:definition "Refers to the style of pottery produced in Lorraine at the Sarreguemines factory beginning in 1778 and includes white earthenware, decorative stoneware in the style of Wedgewood, and tableware in the English and Italian styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarreguemines"@en .

aat:300105709 a skos:Concept ;
    skos:definition "Spaces in which furniture is arranged to be inspected and sold. These may be designed to resemble domestic or office environments in which the furniture would be used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture showrooms"@en .

aat:300105714 a skos:Concept ;
    skos:definition "Central warm-air heating systems through which air is circulated by gravity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravity heating"@en .

aat:300106326 a skos:Concept ;
    skos:definition "Refers to a style of faïence that developed in the 1720s in Haguenau, Bas-Rhin département, Alsace région, northeastern France. It was begun by the Hannong family, who had big ceramics factories in Strasbourg. The style is characterized by distinctive blue and white ware inspired by Chinese porcelains and by pottery with borders of lambrequins imitating wares from Rouen. Later, the style was characterized by more colorful designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haguenau"@en .

aat:300106332 a skos:Concept ;
    skos:definition "Ceramics styles belonging to modern French cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern French ceramics styles"@en .

aat:300106333 a skos:Concept ;
    skos:definition "Describes French porcelain produced in Limoges beginning in the 18th century and known for its simple and utilitarian design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Limoges"@en .

aat:300106339 a skos:Concept ;
    skos:definition "Refers to the style of faience produced at the Strasbourg pottery and porcelain factory in the 18th century. Widely imitated throughout Europe, the style features naturalistic floral decoration rendered in brightly colored enamel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strasbourg"@en .

aat:300106350 a skos:Concept ;
    skos:definition "Refers to the style of Dutch pottery and porcelain produced in Tournai as early as the 17th century until the 19th century. Though influenced by Meissen and Sèvres, the style is identified mainly with simply decorated blue and white wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tournai"@en .

aat:300106356 a skos:Concept ;
    skos:definition "Ceramics styles belonging to Netherlandish Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Netherlandish Renaissance-Baroque ceramics styles"@en .

aat:300106361 a skos:Concept ;
    skos:definition "Refers to the style of Dutch tin-glazed earthenware produced in Delft beginning in the mid-17th century and characterized by blue and white patterns inspired by imported Chinese porcelain. It also refers to similar, Delft inspired wares produced in Germany and England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Delft"@en .

aat:300106389 a skos:Concept ;
    skos:definition "Refers to the the culture, style, and period associated with the Early Bronze Age Chinese culture dating from the first half of the 2nd millennium BCE, named after the village of Erlitou which is situated in what is now Henan Province, near the modern city of Luoyang. The major art produced during this period consists of bronze and jade ritual vessels, small plaques inlaid with pieces of turquoise, and a few tools and weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Erlitou"@en .

aat:300106401 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating 907 to 923."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Liang"@en .

aat:300106403 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic period dating 923 to 937."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Tang"@en .

aat:300106406 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating 937 to 946."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Jin"@en .

aat:300106409 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating 947 to 950."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Han"@en .

aat:300106411 a skos:Concept ;
    skos:definition "Chinese dynastic culture, style, and period dating to 951 to 960 CE, marked by a loose hegemony of states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Zhou"@en .

aat:300106415 a skos:Concept ;
    skos:definition "Refers to a Chinese dynastic culture, style, and period dating 1115 to 1234, an empire formed by the Tungus Juchen (or Jurchen) tribes of Manchuria. The empire covered much of Inner Asia and all of present-day North China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jin"@en .

aat:300106421 a skos:Concept ;
    skos:definition "Style and culture of an era during the late Qing Dynasty, under the rule of Yuan Shikai, dating late 19th-early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hongxian"@en .

aat:300106426 a skos:Concept ;
    skos:definition "Refers to the style of pottery produced at Saint-Clément beginning in 1758 and includes works produced in enameled faience, white biscuit, and tablewares decorated with enamel colors and gilding in the Rococo style of Sceaux pottery and porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Clément"@en .

aat:300106447 a skos:Concept ;
    skos:definition "Architecture styles belonging to Chinese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese architecture styles"@en .

aat:300106449 a skos:Concept ;
    skos:definition "A Chinese temple style influenced by earlier Japanese structural traditions but with a tendency toward minutely detailed, intricate surface decoration. A famous example is Engaku-ji in Kamakura."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kara yo"@en .

aat:300106458 a skos:Concept ;
    skos:definition "Refers to the style of Chinese painting that flourished at the beginning of the 17th century. The style is characterized by typically detailed, complicated compositions, executed in fine lines and delicate colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bai miao"@en .

aat:300106466 a skos:Concept ;
    skos:definition "A Chinese narrative landscape painting style associated with the Tang dynasty. It is so-called for the artists' use of azurite blue and malachite green, and is always done with kung-pi technique. Exponents of the style include Qian Xuan, Zhao Mengfu, and Li Sixun. Li Sixun (651-716) is considered the master of this style and is particularly noted for his use of color and gold to outline rocks, decorative elements, and architecture. The style was continued by some of the early Ming court painters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue-and-green"@en .

aat:300106468 a skos:Concept ;
    skos:definition "Refers to a style and school of influential Chinese landscape painting. Yuan dynasty painters such as Huang Gongwang, Wu Zhen, and Zhao Mengfu were greatly influenced by the Dong-Ju style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dong-Ju"@en .

aat:300106476 a skos:Concept ;
    skos:definition "Refers to the work of a group of artists working in the conservative style of the Ch'ing dynasty. Epitomized by the Four Wangs: Wang Shi-min (1592-1680), Wang Chien (1598-1677), Wang Hui (1632-1717) and Wang Yuan-ch'i (1642-1715), the style is characterized by landscape paintings with traditional compostions, solidly built up forms with complex details, and delicate brushwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Loudong"@en .

aat:300106490 a skos:Concept ;
    skos:definition "Refers to the work of a school of artists, named after its founders: Ma Yuan (1139-1194) and Xia Gui (around 1190-1225). The style is characterized by landscape paintings in ink and color with bold, dry brushstrokes, twisted forms, and expansive spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ma-Xia"@en .

aat:300106498 a skos:Concept ;
    skos:definition "Refers to the work of a school of artists lead by the traditionalist painter Prince P'u Ju, working in the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern School"@en .

aat:300106501 a skos:Concept ;
    skos:definition "Refers to the work of a school of artists lead by painter Chi'i Pai-shih (1863-1957). The style is characterized by the use of vigorous brushstrokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern School"@en .

aat:300106504 a skos:Concept ;
    skos:definition "Refers to a group of painters working primarily in Shanghai from the mid-19th century to the early 20th century. Although not a school in the Western sense, the painters associated with it shared subject-matter, styles, techniques, and the patronage of Shanghai merchants. After the devastating Taiping Rebellion (1850-1864), four professional painters surnamed Ren moved to Shanghai: Ren Xiong (1820-1857), his brother Ren Xun (1835-1893) and his son Ren Yu (1853-1901) from Xiaoshan and the unrelated Ren Yi (1840-1896) from Hangzhou, both in Zhejiang province. The four Rens, of whom Ren Yi was the most influential and successful, formed the nucleus of the emerging school. Shanghai school painting was made to please its merchant patrons. The paintings, typically displayed in the merchants' offices and homes, were mostly decorative, and their subjects often contain auspicious symbolism pertaining to longevity, good fortune, or prosperity. The hanging scroll format was particularly popular, as was the folding fan format. The works typically feature bold coloration and accessible and everyday subject-matter such as figures, birds, and plants. Landscape usually had a minor role in Shanghai painting. Shanghai flower painting was popularized by Zhao Zhiqian (1829-1884), who is known for his large, decorative scrolls of flowers painted in broad brushstrokes of rich, opaque color. The Shanghai school attained its height in the early 20th century under Wu Changshi, arguably the best of the Shanghai artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shanghai school"@en .

aat:300106507 a skos:Concept ;
    skos:definition "Refers to the work of a group of artists, lead by the late 16th and eartly 17th century painter Zhao Zuo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Su-Song"@en .

aat:300106509 a skos:Concept ;
    skos:definition "Refers to a style of Chinese painting, the ideals of which were formulated in the eleventh century, though the tradition is evident from at least the tenth century to the twentieth century. It was created by scholars and gentlemen, as opposed to professional painters or craftsmen, for a small, well-educated audience. It is characterized by the combination of painting, poetry, and calligraphy, with a preference for subtle brushwork, monochromatic or subdued coloring, high literary content, and the abstraction of natural forms to convey highly personal views of nature. It inspired the Japanese \"Nanga\" style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wen ren"@en .

aat:300106520 a skos:Concept ;
    skos:definition "Refers to the work of a school of artisst founded by Wu Wei (1465-1508). The style is characterized by rapidly sketched compositions, with loose and forceful brushstrokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zhe"@en .

aat:300106550 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China for the Imperial court during the Yuan Dynasty (1280-1368). The style is characterized by a combination of the pale blue-green of Qingbai porcelain, with a thicker, more solid glaze that results in heavier and stronger wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shufu"@en .

aat:300106568 a skos:Concept ;
    skos:definition "Refers to the style of porcelain made in China during the T'ang dynasty (618-907 BCE). The style is typically characterized by pure white, simple shaped bowls and dishes, and more rarely in elaborately carved vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xing"@en .

aat:300106576 a skos:Concept ;
    skos:definition "Manually operated fire alarms, usually boxes with a handle that is pulled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manual stations"@en .

aat:300106580 a skos:Concept ;
    skos:definition "Periods and cultures in Japan when certain civilizations has not yet developed writing, but other cultures have provided written historical records for these people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese Protohistoric"@en .

aat:300106581 a skos:Concept ;
    skos:definition "Periods, styles, and cultures related to Japan in early historical times, often considered to begin around the 3rd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Historical Japanese"@en .

aat:300106598 a skos:Concept ;
    skos:definition "Refers to the phase of the Heian period that developed from approximately 898 to 1185, when the power of the emperor was usurped by aristocratic clans and two courts were established in Kyoto. In painting, the style is characterized by the inflkuence of Tan'g Chinese painting, with its fine linear qualities and flat, abstract backgrounds. In sculpture, the style is characterized by richly polychromed wood figures. Architecture of the period also shows a Chinese influence with tile roofs and stone platforms, along with the traditional practice of richly carved interiors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Heian"@en .

aat:300106605 a skos:Concept ;
    skos:definition "Periods, styles, and cultures related to Medieval Japan, often considered to date to the late 12th century through the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medieval Japanese"@en .

aat:300106610 a skos:Concept ;
    skos:definition "Parts or components of fire extinguishing systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire extinguishing system components"@en .

aat:300106616 a skos:Concept ;
    skos:definition "Refers to the Japanese period begining with the Onin War (1467-1477) and ending with the capture of of Kyoto in 1568, although some scholars date the period from the early 1490s. The period saw the development of castle towns, which served as commercial and political centers, and the popularity of tea ceremonies, haiku, and classical Chinese ink painting and pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sengoku"@en .

aat:300106623 a skos:Concept ;
    skos:definition "Period, styles, arts, and cultures of Japan in early modern times, the range of which varies in different contexts, but often roughly 1500 to the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Modern Japanese"@en .

aat:300106643 a skos:Concept ;
    skos:definition "Refers to the period and style that developed from the unification of Japan in 1600 until the end of the shogunal dynasty in 1868. During this period, economic expansion encouraged the rise of an educated merchant class who created their own forms of literature and theater as well as new schools of painting and woodblock printing. A wide diversity of pictorial subjects and styles developed during this period and many 19th century Western artists were influenced by them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edo"@en .

aat:300106652 a skos:Concept ;
    skos:definition "Refers to the phase of the Edo period that developed from approximately 1603 to 1704. This period saw the rise of rival schools of painting and calligraphy, which emphasized a decorative approach to nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Edo"@en .

aat:300106656 a skos:Concept ;
    skos:definition "Refers to the phase of the Edo period that developed from approximately 1704 to 1789."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Edo"@en .

aat:300106658 a skos:Concept ;
    skos:definition "Refers to the phase of the Edo period that developed from approximately 1789 to 1868. The style is characterized by the rise of the Ukiyo-e school of printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Edo"@en .

aat:300106660 a skos:Concept ;
    skos:definition "General term for the period, styles, and cultures of Japan in modern times, typically referring to the 20th and 21st centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modern Japanese"@en .

aat:300106675 a skos:Concept ;
    skos:definition "Refers to the period that coincided with the rule of Choson in Korea, during the middle of the 4th century BCE. During this time, there were improvements in agriculture with the use of iron implements, and better living conditions with the construction of the first wooden houses. Artifacts that remain from the period include iron weapons, sarcophagi of wood and stone, harnesses and jewelry that testify to the rise of the ruling class. The kingdom survived for a century before being conquered by the Chinese under the Han dynasty (206 BCE- 221 CE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chosen"@en .

aat:300106705 a skos:Concept ;
    skos:definition "Systems that bring several clocks into conformity, and may ring bells or alarms at scheduled intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock and program systems"@en .

aat:300106711 a skos:Concept ;
    skos:definition "In the discipline of art and architectural history, typically refers to the period in Europe, Asia Minor, and north Africa, prior to the fall of the western Roman Empire. The term is also sometimes applied more generally to prehistory and to early cultures in other areas of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient"@en .

aat:300106715 a skos:Concept ;
    skos:definition "Lacquer styles belonging to Japanese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese lacquer styles"@en .

aat:300106716 a skos:Concept ;
    skos:definition "Can be used for substantial periods of any cultures from which little reliable data are available."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dark Ages"@en .

aat:300106723 a skos:Concept ;
    skos:definition "Division of human prehistory into three ages: the Stone Age, the Bronze Age, and the Iron Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-age system"@en .

aat:300106724 a skos:Concept ;
    skos:definition "Refers to the period and culture associated with the first age of the Three Age system developed by Christian Jürgensen Thomsen in 1836. It is a stage in the development of hominids or of a prehistoric human culture characterized by the creation and use of stone tools and weapons, as distinguished from later stages of culture when bronze or iron were used for these purposes. The Stone Age is generally divided into three periods, Paleolithic, Mesolithic, and Neolithic, distinguished from each other by the degree of sophistication evident in the fashioning and use of tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stone Age"@en .

aat:300106727 a skos:Concept ;
    skos:definition "Refers to the style of sculpture developed by the artist Unkei (1142-1212). The style is characterized by realistic, sensitive portraits of Buddhist priests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unkei"@en .

aat:300106730 a skos:Concept ;
    skos:definition "Refers to the transitional phase between Paleolithic and Neolithic cultures. The concept differs from Mesolithic in that it generally is applied particularly to the culture in eastern Europe, and stresses the continuity with processes begun earlier rather than distinct innovations that developed during this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Epipaleolithic"@en .

aat:300106734 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters begun around 1600 by Sōtatsu and his contemporary Hon'Ami Koetsu, revised in the 18th century by Korin and again in the 19th century by Saki Hoitsu. The alternate name for the school, \"Rimpa\" is devised from the last syllable in Korin's name (rin) and the word school (ha). The style is characterized by an adherence to the classical Japanese sense of decorativeness, delicate coloring, and a keen observation of the natural world. Precious materials such as gold and silver along with colors were used on folding screens, fans, and other objects. Subject matter was taken from medieval literature as well as nature. Although the style did not last past the Edo period (1600-1868), it influenced 20th century Japanese painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sōtatsu-Korin School"@en .

aat:300106738 a skos:Concept ;
    skos:definition "Refers to the earliest phase of the Iron Age, when the distinct functional properties of iron were first exploited, including the use of forging, and it began to supplant bronze in the production of tools and weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Iron Age"@en .

aat:300106739 a skos:Concept ;
    skos:definition "Refers to a phase of Iron Age culture marked by technological and social developments, including carburized iron or steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Iron Age"@en .

aat:300106745 a skos:Concept ;
    skos:definition "Refers to a phase of Iron Age culture noted for particular technological and social developments, including the tempering of iron implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Iron Age"@en .

aat:300106747 a skos:Concept ;
    skos:definition "Transitional periods related to Stone Age to Bronze Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transitional periods Stone Age to Bronze Age"@en .

aat:300106750 a skos:Concept ;
    skos:definition "Printmaking styles belonging to Japanese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese printmaking styles"@en .

aat:300106751 a skos:Concept ;
    skos:definition "Refers to the beginning of the Chalcolithic period and culture, when people who normally used stone for making tools began to use copper on rare occasions, primarily for creating small, precious objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Chalcolithic"@en .

aat:300106753 a skos:Concept ;
    skos:definition "Refers to the middle phase of the Chalcolithic period and culture, when copper was used more often than in the Lower Chalcolithic. It is generally believed to have occurred from around 3,500 BCE to around 2,000 BCE in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Chalcolithic"@en .

aat:300106755 a skos:Concept ;
    skos:definition "Refers to the last phase of the Chalcolithic period and culture, when stone tools were still used, though copper was used more often than in Middle Chalcolithic, and it was occasionally used in an alloy. Stone tools of this phase were sometimes fashioned to imitate copper tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Chalcolithic"@en .

aat:300106757 a skos:Concept ;
    skos:definition "Refers to the period and culture associated with the transitional phase between the Stone Age and the Bronze Age. Some scholars distinguish this period from the Chalcolithic by classifying Eneolithic as late Neolithic, when copper and flint implements were used at the same time, while Chalcolithic would be the transitional phase when bronze and stone were used at the same time. Most literature does not make the distinction, and uses the term \"Chalcolithic\" to cover this entire phase. An exception is among Italian scholars, who tend to use the term \"Eneolithic\" instead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eneolithic"@en .

aat:300106759 a skos:Concept ;
    skos:definition "Refers to the last stage of a Neolithic culture, which often partially overlaps with the Early Bronze Age. It is generally held to have occurred from around 4,000 BCE to around 3,000 BCE in Europe, lasting until around 2,000 BCE in parts of the British Isles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Final Neolithic"@en .

aat:300106769 a skos:Concept ;
    skos:definition "Distinctive genre in painting and other media, but most prominently in woodblock printing. It arose in the Edo period (1600-1868) and built up a broad popular market among the middle classes. Subject matter typically focused on brothel districts and kabuki theatres, with formats ranging from single sheet prints to book illustrations. Generally, the style is characterized by a mixture of the realistic narrative of the Kamakura period and the mature decorative style of the Momoyama and Edo periods. Distinctive styles and specialties in subject matter were developed by different schools throughout the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ukiyo-e"@en .

aat:300106792 a skos:Concept ;
    skos:definition "Refers to the early stages of the Byzantine period that began when the Emperor Constantine made the city of Byzantium the new capital of the Roman Empire in 330 CE. The style is sometimes grouped with Early Christian art, because there was at that time no official split between the eastern and western Roman empires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Byzantine"@en .

aat:300106797 a skos:Concept ;
    skos:definition "Refers to the period of prehistoric tool making that followed the Mousterian industry in Upper Paleolithic Europe. It is named after a region in south central France. It overlaps somewhat with the Aurignacian industry, and was succeeded by the Solutrean. The Perigordian industry is characterized by denticulate Mousterian-style tools, stone knives with one sharp edge and one flat edge, and various scrapers, borers, burins, small blades, and pendants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Perigordian"@en .

aat:300106799 a skos:Concept ;
    skos:definition "Refers to a stage of Upper Paleolithic stone tool-making culture that is believed to have developed in Asia but was later concentrated in the Périgord region of France. It is characterized by the preference for curved-backed knives that are sharpened on both the cutting edge and the back, as well as other stone tools. Châtelperronian culture was formerly held to be an early stage of Aurignacian culture, but is now believed to overlap with Lower Perigordian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Châtelperronian"@en .

aat:300106804 a skos:Concept ;
    skos:definition "Style and period of the Utpala dynasty, a Hindu kingdom that ruled over the Kashmir region from 8th to 10th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Utpala"@en .

aat:300106810 a skos:Concept ;
    skos:definition "Refers to the period and culture of the last Acheulian stage where tools evolved from earlier ovate forms. It is characterized by elongated hand axes with very straight and finely chipped edges, and points with a triangular cross section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Micoquian"@en .

aat:300106812 a skos:Concept ;
    skos:definition "Refers to the Upper Paleolithic tool-making culture that is contemporaneous with the Aurignacian culture and is concentrated in eastern Europe. It is characterized by burins, borers, leaf-shaped points, Levallois flakes, side scrapers, and end scrapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Szeletian"@en .

aat:300106814 a skos:Concept ;
    skos:definition "Refers to the Paleolithic style and culture that is named after the Bay of Uluzzo at the heel of Italy, and existed through southern Italy and into the central and northern parts of the peninsula. It is characterized by distinctive side scrapers, and occasionally with end scrapers and burins. Some scholars believe this culture is associated with Homo sapiens neanderthalensis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uluzzian"@en .

aat:300106816 a skos:Concept ;
    skos:definition "Refers to the style and culture named for the site at Grotta Romanelli, Calabria, Italy, which dates to around 8,000 before present. It is particularly characterized by cave art consisting of stylized and geometric incised patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romanellian"@en .

aat:300106822 a skos:Concept ;
    skos:definition "Refers to a tool making industry named for a site at Ertebølle, Denmark and evident in northern Europe from about 9,000 to 3,500 BCE. It is classified as Mesolithic rather than Neolithic because it is characterized by chipped, rather than polished, stone tools, and because the people were primarily hunters and fishers rather than agriculturists. However, the culture was partially contemporaneous with Neolithic industries of central Europe, and it demonstrated Neolithic achievements, including the creation of kitchen middens, pottery, chisel-shaped arrowheads, flat and radial techniques for working flint, and limited agriculture and stock raising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ertebølle"@en .

aat:300106828 a skos:Concept ;
    skos:definition "Refers to the earlier phase of Vinca style and culture, from the fifth to fourth millennia BCE. The style differs from the later Vinca-Plocnik in the creation of works that are cruder in execution and figures that are more naturalistic in form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vinca-Tordos"@en .

aat:300106833 a skos:Concept ;
    skos:definition "Refers to the later phase of Vinca style and culture, from the fourth to the third millennia BCE. The style differs from the earlier Vinca-Tordos particularly in its evolution of sleek, stylized figures decorated with incised lines and abstract patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vinca-Plocnik"@en .

aat:300106839 a skos:Concept ;
    skos:definition "Refers to the ancient culture of the Andhra region of central India, particularly from the 1st century BC to the early 3rd century CE. At the end of the 1st century BC the Andhras made impressive stone renovations and additions to the stupa at Sanchi, particularly the four carved gates (toranas), resulting in it becoming the greatest Buddhist monument in India. Other Buddhist complexes were built by the Andhrans, including the Great Stupa at Amaravati in the 2nd century. Amaravati was the principal city of the Satavahanas who were great builders; the Buddhist monuments of this city inaugurated a new style of architecture. The Great Stupa at Amaravati, for example, boasted a upper level for circumambulation, richly carved railings, and columns instead of toranas. Early Andhra sculpture, particularly the abundant architectural reliefs, are noted for their decorative story-telling & their encyclopedic quality; delicate floral design, naturalistic depictions of animals, and sensuous and voluptuous human figures are highly valued. As in other early Buddhist art, Buddha is usually represented symbolically, but around 200 CE, Buddha is also shown as a human figure; sometimes these two methods of depiction are found on the same monument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Andhra"@en .

aat:300106840 a skos:Concept ;
    skos:definition "Central European Neolithic culture and style that probably developed from the influx of Neolithic peoples into Mesolithic cultures, and spread quickly from the Hungarian plain to Slovakia, Czech lands, Austria, Germany, Poland, the Low Countries, and eastern France between ca. 5,400 and ca. 4,900 BCE. It is characterized by the introduction of farming, animal husbandry, large longhouses, chipped stone tools, and distinctive pottery decorated with incised bands of lines, strokes, and indentations. \"Bandkeramik\" is sometimes used interchangeably with \"Linienbandkeramik,\" however, according to traditional classification the latter is a variety of the former. \"Danubian\" was formerly more commonly used to refer to this culture, though \"Bandkeramik\" is more often used by modern scholars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bandkeramik"@en .

aat:300106843 a skos:Concept ;
    skos:definition "Refers generally to the later ancient culture of the Andhran region and Andhran tribes, particularly to Buddhist art forms of the 3rd century CE. Flowing sculptural volume and life-like illusion are both hallmarks of later Andhran art. With the decline of Andhra power in the Deccan, Brahmanism again dominated the south. The term can also be used to refer to culture from the Andhran region of later centuries that is not necessarily related to the patronage of Andhran tribes or dynasties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Andhra"@en .

aat:300106849 a skos:Concept ;
    skos:definition "Refers to the later phase of Bandkeramik culture and style, characterized by pottery decoration that has evolved from earlier delineated bands to instead use rows of incisions, punctures, impressions, and notches arranged to suggest bands, but without the defined delineation. This later phase is also characterized by the culture developing stronger regional differences. This phase is called \"Danubian II\" in the classification scheme of scholar V. Gordon Childe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stichbandkeramik"@en .

aat:300106850 a skos:Concept ;
    skos:definition "Refers to the Neolithic culture and style of the Cris people, who lived in the area of modern Bulgaria, Romania, and south Russia. They are particularly characterized by the creation of rather crudely executed clay female figures reminiscent of Paleolithic figures, with huge, shelf-like posteriors, which may be intended to indicate a sitting position. This culture is related to the Körös culture, and both cultures are sometimes grouped together as \"Cris-Körös.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cris"@en .

aat:300106852 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture that appeared in northern and central Europe after 3,000 BCE. It is named for a charactistic decorative technique where twisted cord was impressed on the surface of pottery, particularly drinking cups, usually in parallel rows. It is also characterized by individual burials of adult males accompanied by stone battle axes under round mounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corded Ware culture"@en .

aat:300106854 a skos:Concept ;
    skos:definition "Late Neolithic and Early Bronze Age cultures that lived in the fourth millennium BCE. The name is derived from the inverted-cloche form of the characteristic vessel. Bell Beaker vessels occur in a variety of styles with specific regional distributions and chronological limits. The beakers are typically decorated in bands of incised and corded decoration and frequently occur in graves associated with wristguards of polished and perforated stone and V-perforated buttons. While earlier generations of archaeologists attributed the beakers to a particular \"Beaker folk\" who originated in Spain and spread to central and western Europe carrying bronze technology to the British Isles, scholars now tend to think that the beakers were prestige items whose popularity spread over time among existing peoples as symbols of social rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bell Beaker"@en .

aat:300106864 a skos:Concept ;
    skos:definition "Refers to the culture, particularly sculpture, of Mathura, a cosmopolitan city on the Jumna river, during the Kushan period of ancient India; Mathura seems to have been a second capital of the Kushan dynasty and it was one of the dynasty's two important artistic centers, the other being Gandhara. Buddhist Mathura sculpture includes Buddha portraits based on yaksha (male earth-spirit) models, as well as some of the earliest examples of entirely Indian Buddha figures. The many vivacious and frankly sexual yakshi figures (female earth-spirits) are also well-known examples of Mathuran sculpture. One of the most notable achievements of the period was the assimilation of the Mauryan-style standing colossus to Buddhist purposes. Characteristics of Mathura sculpture include monumental frontality; the rendering of gathered, transparent drapery as small ringed folds; and later Buddha figures with large haloes decorated with foliated scroll-work. Deep relief is common in the 2nd century while a more smooth and linear style is found in the 5th century. Much Mathura sculpture is carved out of local Sikri sandstone, which is pink or mottled red with cream spots. Mathuran icons were imported to other areas of India and they were also copied by other workshops. Although the Kushan dynasty declined in the 3rd century, the Kushan style of art at Mathura survived and later led to the further development of the Buddha icon in the Gupta period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mathura"@en .

aat:300106866 a skos:Concept ;
    skos:definition "Northern European period and culture that began in the last phase of the Neolithic Period and ended by ca. 1400 BCE. It is characterized by enormous technical skill in flint working, particularly in the production of elaborate daggers and spearheads that were imitations of imported metal weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dagger period"@en .

aat:300106868 a skos:Concept ;
    skos:definition "Refers to the culture, particularly sculpture, of the city of Sarnath in northern India, during the Gupta period. Sarnath is especially known for its Buddha figures which were widely disseminated and for centuries influenced representations of Buddha in eastern India as well as Southeast Asia. Developed in the late 5th century, these sculptures break with the plastic forms created by Mathura sculptors; instead, the Buddhas, depicted in a transcendent state, are perfectly and harmonically proportioned but are not naturalistically treated. Also, their clothing clings to their bodies but not in a realistic manner. The smooth bodies and clothing contrast with the intricately decorated haloes, which resemble those of contemporary standing Buddha figures from Mathura. Sarnath sculptors also created high-quality narrative sculpture, mainly stelae depicting events from the Buddha's life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarnath"@en .

aat:300106871 a skos:Concept ;
    skos:definition "Bronze Age culture and style found in northern Europe and Scandinavia during the first millennium BCE. It is characterized by ornament made of round, knob-like prominences, or \"bosses,\" and delicate embossed designs on beaten bronze objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boss Style"@en .

aat:300106876 a skos:Concept ;
    skos:definition "Refers to a northern European Iron Age period and culture that thrived from ca. 600 to ca. 300 BCE, particularly between the Oder and Weser rivers. It is characterized by distinctive pottery and metal objects, including belt hooks and sheet-bronze belts that were influenced by the Halstatt culture to the south."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jastorf"@en .

aat:300106880 a skos:Concept ;
    skos:definition "Culture, ethnicity, style, or historical period occurring just before or after European colonization in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Indian"@en .

aat:300106900 a skos:Concept ;
    skos:definition "Refers to a regional school of Rajasthani miniature painting centered around the city of Raghogarh in Malwa in central India. The patrons of this school of painting were the Rajput rulers of the Khichi Chauhan clan, whose capital was at Raghogarh. The school, which flourished in the 17th century, is stylistically related to the Bundi school although the link between the two is unclear. Figures are often depicted with small waists, delicate limbs, large eyes, and somewhat elongated heads. Raghorgarh painting continued until the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raghogarh"@en .

aat:300106913 a skos:Concept ;
    skos:definition "Refers to the period and style of art produced by the Teutonic tribes who overran the declining Roman Empire from about 370 CE to about 800 CE, including Franks, Lombards, Vandals, Ostrogoths, and Visigoths. The style influenced architecture, sculpture, and manuscript illumination, but is most evident in the portable objects of the migrants, including metalsmiths' work and jewelry, often in gold, garnet, and enamel inlay. The style is characterized by a departure from classical design to instead favor stylized and ornamental design, isolated areas of color, and repetitive patterns of chevrons, crosses, lines, and dots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Migration period"@en .

aat:300106920 a skos:Concept ;
    skos:definition "Periods related to Aegean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean periods"@en .

aat:300106921 a skos:Concept ;
    skos:definition "Styles belonging to Aegean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean styles"@en .

aat:300106924 a skos:Concept ;
    skos:definition "Periods related to Aegean Neolithic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean Neolithic periods"@en .

aat:300106927 a skos:Concept ;
    skos:definition "Periods related to Aegean Bronze Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean Bronze Age periods"@en .

aat:300106928 a skos:Concept ;
    skos:definition "Refers to an Early Neolithic style and culture predominant in Thessaly and part of Macedonia, and typified by artifacts from the rich site at Nea Nikomedeia in SW Macedonia. It is characterized by pottery that is better made and more varied than preceding styles, often having elaborate feet, and generally comprising red- or pink-slipped ware or red-on-white painted ware. It is also known for open settlements with free-standing architecture and rectangular structures typically made of an oak framework entwined by reeds and coated with mud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Sesklo"@en .

aat:300106931 a skos:Concept ;
    skos:definition "Refers to a Middle Neolithic style and culture that developed from the Proto-Sesklo culture and was found from western Macedonia south to Phthiotis. It is named for the type site in Magnesia, and it differs from the earlier culture in being more uniform, richer, and more complex. It is characterized by elaborately decorated red-on-white painted ware that often features zig-zag or flame motifs, monochrome red-slipped ware, and distinctive architectural features, including rectangular plans, pitched roofs, and interior buttressing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sesklo"@en .

aat:300106933 a skos:Concept ;
    skos:definition "Refers to a Late Neolithic style and culture found in Thessaly and named after a site in eastern Thessaly where a regional variant of this style was found. There are chronological and regional variations in the style, but in general it is characterized by pottery, particularly jars and bowls that are angular in form and decorated with bichrome or polychrome geometric patterns, including spirals and curvilinear meanders painted in brown slip on a cream ground. Sculpture from this culture generally depicts human figures of distinctive schematic design, though strikingly naturalistic figures occasionally appear. Architecture often comprises small forts with multiple enclosure walls and a central megaron opening onto a courtyard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dimini"@en .

aat:300106937 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in the Cycladic archipelago between circa 3200 and 2700. Works of art include pottery with incised decoration, marble vessels, and marble figurines of the Plastiras and Louros types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Cycladic I"@en .

aat:300106939 a skos:Concept ;
    skos:definition "Refers to a Bronze Age Cycladic style and culture defined by artifacts from the type sites on Amorgós island, Greece. The art is characterized by distinctive folded-arm stone figurines, seals, fine silver objects, and other metal work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amorgos group"@en .

aat:300106941 a skos:Concept ;
    skos:definition "Refers to the style of artistic production on the Cycladic archipelago between circa 2700 and 2300 BCE. Works of art include marble vessels, folded-arm type marble figurines, and pottery with painted or stamped decoration and in new forms such as the frying pan type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Cycladic II"@en .

aat:300106943 a skos:Concept ;
    skos:definition "Refers to the style of artistic production at Kastri on Syros in the Cycladic archipelago during the Early Cycladic period. It is distinguished by pottery forms such as the depas beaker with a dark, lustrous, painted finish that suggest Anatolian influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kastri group"@en .

aat:300106945 a skos:Concept ;
    skos:definition "Refers to a Bronze Age style and culture defined by artifacts from the type site near the village of Lefkandi, on Euboia island, Greece. This term generally applies to the culture prior to the influx of refugees fleeing the destruction of Mycenaean palaces, which took place around 1200 BCE, and not to the later rich culture at Lefkandi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lefkandi I"@en .

aat:300106948 a skos:Concept ;
    skos:definition "Refers to the Middle Helladic period and culture associated with the graves that date from around 1600 BCE to around 1400 BCE and were found at Mycenae and other Bronze Age Greek sites. It is characterized by tomb construction that is distinct from earlier and other contemporary cultures in that the tombs were typically arranged in circles and probably were surmounted by tumuli, burials were multiple and successive burials rather than individual, and portable gold and weapons were preferred as grave goods, reminiscent of a nomadic culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shaft Grave period"@en .

aat:300106959 a skos:Concept ;
    skos:definition "Architecture styles belonging to French Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Medieval architecture styles"@en .

aat:300106963 a skos:Concept ;
    skos:definition "Architecture styles belonging to German Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German Medieval architecture styles"@en .

aat:300106965 a skos:Concept ;
    skos:definition "Styles belonging to Italian Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian Medieval styles"@en .

aat:300106969 a skos:Concept ;
    skos:definition "Pottery styles belonging to Italian Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian Medieval pottery styles"@en .

aat:300106975 a skos:Concept ;
    skos:definition "Styles belonging to Carolingian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carolingian styles"@en .

aat:300106976 a skos:Concept ;
    skos:definition "Refers to the style of art, particularly manuscript illuminations, that developed in the ninth century in northern French monasteries and spread to other areas in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Franco-Saxon"@en .

aat:300106978 a skos:Concept ;
    skos:definition "Styles belonging to Migration period cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Migration period styles"@en .

aat:300106982 a skos:Concept ;
    skos:definition "Refers to the earliest phase of the Orientalizing period, when curvilinear patterns began to replace the angular patterns of the Geometric period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Orientalizing"@en .

aat:300106984 a skos:Concept ;
    skos:definition "Refers to the second phase of the Orientalizing period, when curvilinear patterns and exotic motifs had replaced the earlier style and themes of the Geometric period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Developed Orientalizing"@en .

aat:300106986 a skos:Concept ;
    skos:definition "Refers to the last phase of the Greek Orientalizing period. It is characterized by patterns and figures that are more exuberant and busy than in earlier phases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Orientalizing"@en .

aat:300106990 a skos:Concept ;
    skos:definition "Refers to the first phase of the Greek Archaic period, from around 660 BCE to around 580 BCE. It is characterized in sculpture by the creation of more large-scale stone sculpture than in earlier periods, and by a style that is close to the Egyptian prototypes. In vase painting it is characterized by the Black-figure method used to depict more naturalistic figures than those of the Orientalizing period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Archaic"@en .

aat:300106993 a skos:Concept ;
    skos:definition "Refers to a phase of the Greek Archaic period, from around 580 BCE to around 535 BCE. It is characterized in sculpture and vase painting by figures that are more naturalistic than in the Early Archaic phase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Archaic"@en .

aat:300106995 a skos:Concept ;
    skos:definition "Refers to the last phase of the Greek Archaic period, from around 540 BCE to around 480 BCE. It is characterized in vase painting by the introduction of the Red-figure method, and in both vase painting and sculpture by the development of figures that are more naturalistic and that have more fluid movements than in earlier phases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Archaic"@en .

aat:300106998 a skos:Concept ;
    skos:definition "Refers to the end of the Hellenistic period and style, from around 150 to around 31 BCE. It is characterized by the accelerated decline of the Hellenistic world and the disintegration of established artistic schools. It is known for a rapid proliferation of diverse styles, including an invigorated neo-Classicism that combines elements of various Classical styles, a \"baroque\" revival style typified by emotion, asymmetry, and movement, and a style that is outright copying of Classical works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Hellenistic"@en .

aat:300107001 a skos:Concept ;
    skos:definition "Pottery styles belonging to Island Greek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Island Greek pottery styles"@en .

aat:300107002 a skos:Concept ;
    skos:definition "Pottery styles belonging to Mainland Greek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mainland Greek pottery styles"@en .

aat:300107003 a skos:Concept ;
    skos:definition "Pottery styles belonging to Peloponnesian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peloponnesian pottery styles"@en .

aat:300107009 a skos:Concept ;
    skos:definition "Refers to a style of pottery painting dating from the sixth century BCE, found on various vessels and terracotta sarcophagi, and named after a site at Klazomenai in Ionia, Turkey. It is characterized by the use of Black-figure painting, and later by Red-figure painting, with distinctive, graceful designs of human figures, sphinxes, animals, monsters, and sirens executed in a technique that includes occasional outline drawing, with the addition of white or incisions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clazomenian"@en .

aat:300107014 a skos:Concept ;
    skos:definition "Period, culture, and English style in architecture and fine and decorative arts during the reign of James I from 1603 to 1625. Detailed and jewel-like portraits dominate easel and miniature painting while decorative arts are characterized by rich carving, bulb and twist shapes and motifs including coats of arms, thistles, and pomegranates. In architecture, Renaissance forms and motifs combine with details derived from Northern European Mannerism and include features such as Dutch gables, balustrades, and strapwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jacobean"@en .

aat:300107022 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in Dutch colonies featuring a combination of Dutch and native characteristics. Applied to architecture, the style refers especially to structures in South Africa and parts of North America featuring gambrel roofs, overhanging eaves, stepped gables, and brickwork. It also describes furniture produced especially in the East Indies between 1602 and 1942 characterized by twisted legs or bed-posts, canework, and the use of native woods such as satinwood, teak, ebony, and calamander."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch Colonial"@en .

aat:300107024 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in French colonies featuring a combination of French and native characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Colonial"@en .

aat:300107026 a skos:Concept ;
    skos:definition "Styles belonging to Eastern European Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern European Renaissance-Baroque styles"@en .

aat:300107027 a skos:Concept ;
    skos:definition "Ceramics styles belonging to Eastern European Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern European Renaissance-Baroque ceramics styles"@en .

aat:300107029 a skos:Concept ;
    skos:definition "Styles belonging to Portuguese Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portuguese Renaissance-Baroque styles"@en .

aat:300107030 a skos:Concept ;
    skos:definition "Generally refers to the style of art and architecture in Portuguese possessions in south and east Asia and in Brazil during the 16th and 18th centuries. The term usually is not applied to art produced in later Portuguese holdings in Africa. The style combines elements of Manueline, Renaissance, Baroque, Rococo, and Neo-Classical styles from Europe with original motifs that developed in the colonies, to produce a style characterized by lyrical elegance. In architecture the style is typically seen in fortresses and churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portuguese Colonial"@en .

aat:300107032 a skos:Concept ;
    skos:definition "Sculpture styles belonging to Aegean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aegean sculpture styles"@en .

aat:300107033 a skos:Concept ;
    skos:definition "Refers to the style and period dating from the early 16th century through the early 19th century, in areas colonized by Spain, particularly the Americas. The style is mainly seen in paintings, sculpture, and in ecclesiastical and military architecture. The style reflects the tastes of aristocratic landholders and the church, and generally imitates styles current in Spain, the Netherlands, Italy, and France, with some limited influence from native traditions of design and representation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Colonial"@en .

aat:300107037 a skos:Concept ;
    skos:definition "Pottery styles belonging to Cycladic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cycladic pottery styles"@en .

aat:300107038 a skos:Concept ;
    skos:definition "Refers to a style of Cycladic pottery characterized by the use of some curvilinear motifs, rather than the strictly rectilinear motifs typical of Cycladic styles that preceded and followed it. The range of shapes of vessels increases from what was known in earlier styles, including the curious so-called \"frying-pan\" form, and curvilinear running spirals, scenes of boats, and other designs were introduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Curvilinear Style"@en .

aat:300107042 a skos:Concept ;
    skos:definition "Refers to the style of pottery produced in the Cycladic archipelago between 2000 and 1600 BCE during the Middle Cycladic period. It is characterized by a creamy or sandy color and curvilinear or naturalistic painted decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cycladic White"@en .

aat:300107044 a skos:Concept ;
    skos:definition "Refers to the style of pottery produced in the Cycladic archipelage between 2000 and 1600 BCE during the Middle Cycladic period. It is characterized by a lustrous finish and white and sometimes black painted decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dark Burnished"@en .

aat:300107046 a skos:Concept ;
    skos:definition "Refers to the style of pottery produced in the Cycladic archipelago during the early Cycladic period between roughly 3500 or 3000 and 2000 BCE though some authors date the period from circa 2500 to circa 1900 BCE. It is characterized by incised decoration on a burnished surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dark-faced Incised"@en .

aat:300107048 a skos:Concept ;
    skos:definition "Refers to a style of Cycladic pottery that is decorated with a distinctive yellow slip, perhaps intended to simulate metalwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow-slipped"@en .

aat:300107052 a skos:Concept ;
    skos:definition "Refers to one of many ethnic cultures of modern Myanmar. It also identifies the last capital of the Burmese empire built in 1857-1859 on the Irrawaddy River by King Mindon before the fall of Burma to British imperialists in 1885. Architectural art in this region reflects Italian influences as depicted in composite temple and monastery structures comprised of stone and native wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mandalay"@en .

aat:300107054 a skos:Concept ;
    skos:definition "Hellenistic pottery style characterized by relief designs that imitate metal work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calene"@en .

aat:300107055 a skos:Concept ;
    skos:definition "Refers to the style named for the city Pegu that flourished during the ninth century as capital of the Mon Kingdom, located on the Pegu River, 47 miles northeast of Yangôn. Examples of artistic production in this style include the ancient and sacred Shwemawdaw, a pagoda shrine 288 feet high, and the Shwethalyaung, a gargantuan reclining statue of Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pegu"@en .

aat:300107058 a skos:Concept ;
    skos:definition "Hellenistic pottery style named after the town of Canosa, Apulia, Italy, characterized by very sumptuous decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canosa"@en .

aat:300107061 a skos:Concept ;
    skos:definition "Refers to a style of pottery named after a site where many distinctive vases were found. It dates from around 600 BCE to around 550 BCE and is characterized by the portrayal of human figures in very lively postures and decoration that is inspired by Near Eastern art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daphne"@en .

aat:300107063 a skos:Concept ;
    skos:definition "Refers to a pottery style found in the Cyclades, spanning both the Late Geometric and Early Orientalizing periods. It is characterized by an emphasis on linear patterns, including alternating areas of vertical and horizontal lines on the neck, in frames on the shoulder, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linear Island Style"@en .

aat:300107068 a skos:Concept ;
    skos:definition "Refers to a style of pottery decoration that existed during the third and second centuries BCE, and was first found at Megara, but later in Attica and numerous other places. It is generally found on bowls, and is characterized by relief decoration on the exterior, created by a combination of wheel work, stamping, and molding. The surface may be covered with glaze that is also ornamented in black or red. Themes are usually of flowers, with occasional figures and narrative scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megarian"@en .

aat:300107070 a skos:Concept ;
    skos:definition "Refers to a pottery style first found on the west slope of the Acropolis in Athens, but later known in many other locations. It existed from the fifth century BCE through the fourth century BCE, and is characterized by a stamped decoration that was covered with black glaze. Floral motifs and other decorations were sometimes painted in red, white, or yellow on the black surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Slope"@en .

aat:300107079 a skos:Concept ;
    skos:definition "Refers to a style of ancient Greek Red-figure vase painting that developed from the Ornate Style in the early fourth century BCE. It is distinct from the Ornate Style in that it is more copiously decorated and it uses many more colors, gilding, and applied clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Florid Style"@en .

aat:300107081 a skos:Concept ;
    skos:definition "Refers to an ancient Greek Red-figure vase painting style that existed chronologically and geographically side-by-side with the Florid Style. It is found primarily on smaller vases and is distinguished from the Florid Style by being simpler and using mainly the original red and black colors, with only a few touches of additional colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Simple Style"@en .

aat:300107083 a skos:Concept ;
    skos:definition "Pottery styles belonging to Helladic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Helladic pottery styles"@en .

aat:300107084 a skos:Concept ;
    skos:definition "Refers to the earliest style of Neolithic pottery on the Greek mainland. It is characterizecd by being decorated with burnishing, that is, the pot was rubbed with a tool that compacted the surface and made it shiny or lustrous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black burnished"@en .

aat:300107086 a skos:Concept ;
    skos:definition "Refers to a pottery style that developed after ca. 1200 BCE in the region of Mycenae. It is characterized by decoration in which a crowded, unsophisticated composition is rendered with meticulous care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Close Style"@en .

aat:300107088 a skos:Concept ;
    skos:definition "Refers to a Late Neolithic pottery style that developed in Thessaly. It is characterized by decoration consisting of thick white or rose-colored paint that was applied after the initial firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crusted"@en .

aat:300107090 a skos:Concept ;
    skos:definition "Refers to a pottery style that was evident in Thessaly and elsewhere beginning in the Late Neolithic period. It is characterized by the painting of a design in a darker color on a light-colored vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark-on-light painted"@en .

aat:300107092 a skos:Concept ;
    skos:definition "Style of ancient Greek pottery characterized by a single, abstract, decorative element often representing marine or plant life, on an otherwise plain surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ephyraean"@en .

aat:300107094 a skos:Concept ;
    skos:definition "Refers to the style of pottery produced on the Greek mainland and dating from the Middle Helladic, characterized by simple, handmade shapes including many closed vessels, and decorated with painted geometric or linear motifs. It is also recognizable due to the dull appearance of the surface, in contrast to pottery where the surface has been burnished, and thus rendered lustrous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Matt-painted"@en .

aat:300107099 a skos:Concept ;
    skos:definition "Style of pottery produced on the Greek mainland and dating from the Middle Helladic, characterized by wheelmade, angular shapes, and unornamented surfaces. The pottery style was named by Schliemann after the legendary inhabitants of Orchomenus in central Greece, where he first came upon it; today it is believed unlikely that the Minyans were the original creators of Minyan ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minyan"@en .

aat:300107102 a skos:Concept ;
    skos:definition "Refers to a style of Minyan pottery that developed in the Argive plain and is characterized by having a plain burnished black finish with simple incised decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Argive Minyan"@en .

aat:300107108 a skos:Concept ;
    skos:definition "Refers to the style named for the temple complex founded by Jayavarman VII (1181-1220 CE) in 1191 CE. The style is driven by centralized authoritarian rule, a revival in urban planning, the establishment of Buddhism as the state religion, and the infusion of religious architectural symbolism. The style is noted for its use of monumental garuas in the guise of telamones, the installation of hundreds of statues along walkways, religious veneration for the cosmos, and the first occurrence of large sanctuaries decorated with colossal faces on each of its sides representing the bodhisattva Lokeshvara and the king. The style is evidenced by sculpture of coiled serpents in the smaller sanctuaries and by the use of axial pools to symbolize the cosmic lakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Preah Khan"@en .

aat:300107109 a skos:Concept ;
    skos:definition "Refers to the style of pottery produced on the Greek mainland dating from the Middle Helladic and characterized by a light colored surface and shapes that include a low stemmed goblet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yellow Minyan"@en .

aat:300107112 a skos:Concept ;
    skos:definition "Refers to a style of Early Helladic pottery that developed from around 2,500 BCE to around 2,000 BCE. It is characterized by being hand-made and not thrown on a wheel, and by a finish of semi-lustrous paint rather than burnished slip, with a variegated appearance that ranges from reddish to brownish to black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urfirnis"@en .

aat:300107114 a skos:Concept ;
    skos:definition "Pottery styles belonging to Minoan cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minoan pottery styles"@en .

aat:300107115 a skos:Concept ;
    skos:definition "Style of Early Minoan pottery named for a site near Phaistos, characterized by extensive use of painted lines instead of the earlier scored or burnished patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayios Onouphrios"@en .

aat:300107120 a skos:Concept ;
    skos:definition "Refers to the early Angkor style named for the monument inaugurated in the reign of King Suryavarman I (1002-1050 CE). The style is driven by the prominent use of natural settings such as hillsides and mountain backdrops to promote and enhance the sacredness of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Preah Vihear"@en .

aat:300107125 a skos:Concept ;
    skos:definition "Middle Minoan style of pottery that was produced primarily at the palaces of Knossos, Phaistos, and Mallia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggshell"@en .

aat:300107128 a skos:Concept ;
    skos:definition "Refers to a style of Late Minoan pottery that developed under the patronage of the rulers of the new palaces. It is characterized by exhuberant painted decoration that depicts plants, especially ivy, grass, reeds, palms, and flowers, especially daisies and imaginary hybrids based on papyrus and lilies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Floral Style"@en .

aat:300107135 a skos:Concept ;
    skos:definition "Refers to a style of Early Minoan pottery produced primarily in northeastern Crete, though used widely throughout the island. It may have developed from Vasiliki ware, when painted ornament first reappeared in the form of a few painted white lines. In its mature form, it is characterized by crisp geometric motifs painted in off-white paint on a coat of dark slip. Designs typically include circles, complex diagonal bands, and spirals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light-on-dark"@en .

aat:300107137 a skos:Concept ;
    skos:definition "Refers to a style of Late Minoan pottery that developed around 1500 BCE under the patronage of rulers in the new palaces, and then spread through exports to the Cyclades and the Greek mainland. It is characterized by inventiveness and naturalism in painted decoration that typically includes depictions of argonauts, starfish, coral shells, octopuses, seaweed, and other details of underwater life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marine Style"@en .

aat:300107141 a skos:Concept ;
    skos:definition "Refers to a distinctive style of Greek vase painting that evolved in the twelfth century BCE. It probably developed in the Dodecanese and was inspired by the octopus designs of Minoan Marine Style vessels. It was found in Rhodes, Cos, the Cyclades, and eastern Attica. It is characterized by dark designs on a light ground, with designs typically depicting a large stylized octopus with small birds and fish painted between its tentacles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Octopus Style"@en .

aat:300107144 a skos:Concept ;
    skos:definition "A style of later Bronze Age pottery that developed after ca. 1450 BCE at Knossos, Crete. It is characterized by new shapes of vases introduced from the mainland and by decoration that is dark-on-light with motifs that derive from the Floral and Marine styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palace style"@en .

aat:300107146 a skos:Concept ;
    skos:definition "Refers to a pottery style found on Crete in the Late Neolithic and Early Minoan periods. It is characterized by a surface fired to a dark brown or black and burnished with a smooth pebble or wooden burnisher to produce a linear decoration. In its early phase, decoration was simple. In its later phases, decoration was more advanced, comprising horizontal or vertical burnished lines, zigzags, crosshatching, parallel lines, or solid areas of burnishing. It was made in various shapes, although it is especially noted for distinctive footed chalices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pyrgos"@en .

aat:300107153 a skos:Concept ;
    skos:definition "Refers to a style of Minoan pottery that developed around 1550 BCE. It is characterized by distinctive painted decoration, where the vessel is often divided into zones. Motifs are inspired by the borders of fresco painting and metalwork, including stylized double-headed axes, thick-rimmed spirals linked by tangents, and other geometric patterns. In later examples, motifs are arranged in strict alternation around the vase in an empty field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pattern Style"@en .

aat:300107155 a skos:Concept ;
    skos:definition "Style of Early Minoan pottery named after a site in eastern Crete. It is characterized by the invention of unusual shapes, including teapots with exagerated, long spouts and jugs with tall, beaked spouts. Distinctive decoration was created by covering the entire pot with a coat of slip, which was mottled during firing to achieve a variegated effect in brilliant red and black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vasiliki"@en .

aat:300107157 a skos:Concept ;
    skos:definition "Sculpture styles belonging to Cycladic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cycladic sculpture styles"@en .

aat:300107159 a skos:Concept ;
    skos:definition "Refers to the style of marble, folded-arm type figures produced in the Cycladic archipelago between roughly 2800 or 2600 and 2300 BCE. Named for the site where they were discovered, this type is charcterized by a thin but more triangular form with wide shoulders and tapering legs and feet, and precise, angular incision depicting anatomical details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dokathismata type"@en .

aat:300107161 a skos:Concept ;
    skos:definition "Refers to the style of marble figures produced in the Cycladic archipelago during the Early Cycladic period but specifically during the period between roughly 2800 or 2600 and 2300 BCE. Rendered in simple, elegant, and geometric forms, the figures are typically female and are characterized by upturned faces, triangular noses, long necks, down-turned feet, and schematic arms that fold left over right across the abdomen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folded-arm type"@en .

aat:300107163 a skos:Concept ;
    skos:definition "Refers to the style of marble figures produced in the Cycladic archipelago during the Early Cycladic period but specifically during the period between roughly 3500 or 3000 and 2800 or 2600 BCE. Named for the site of their discovery on the island of Paros, the figures include representations of both male and female figures. They are characterized by a sense of naturalism represented in their almond-shaped heads, facial features depicted in low relief, arms bent at the elbows, hands meeting at the chest, legs placed apart, and flat-soled feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plastiras type"@en .

aat:300107165 a skos:Concept ;
    skos:definition "Refers to the style of marble, folded-arm type figures produced in the Cycladic archipelago between roughly 2800 or 2600 and 2300 BCE. Named for the site where they were discovered, this type is characterized by spade-shaped heads, rounded contours, and a wider use of incision to depict anatomical details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spedos type"@en .

aat:300107168 a skos:Concept ;
    skos:definition "Refers to a style of Archaic Greek sculpture found on the Ionian Islands, off the southern coast of Peloponnesus. It is characterized by the use of marble rather than limestone, which had been common earlier, and by a progressive understanding of human anatomy and the development of new formal concepts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionian Island Style"@en .

aat:300107170 a skos:Concept ;
    skos:definition "The culture and style of artistic production on the Aegean island of Melos. Important during the Bronze Age for its obsidian quarries, the island is known for Geometric style pottery between roughly 2300 and 2000 BCE and later, for Black-and-red style pottery. Artistic production after the Cycladic period shows the influence of Minoan then Mycenean culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melian"@en .

aat:300107172 a skos:Concept ;
    skos:definition "The culture and style of the Aegean island of Samos, a site important in the cult of Hera and especially in the 6th century during the reign of Polykrates, as a cultural and commercial power. Important artistic production included grave stelae, funerary reliefs, monumental kouroi and korai, and in architecture, the Temple of Hera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samian"@en .

aat:300107181 a skos:Concept ;
    skos:definition "Refers to the period named for the region of Nakhon Pathom in the Dvaravati kingdom. In ceramics, the period features high-fired earthenware containers, funeral urns, clay votive tablets, kendi or water vessels with a bulbous spout and tall neck with flared rim, and oil lamps, decorated in red pigment or incised stamped patterns. Some ceramic pieces such as terracotta figurines served as architectural decorations. In sculpture, the period features Buddha images with some Mon stylistic elements such as broad facial features and large hair curls. Sculpture in the round is rigidly frontal and symmetrical and the hands in the vitarka mudr position in which the two hands jointly perform a unified gesture as in Dvaravati sculpture. The period also features Buddha seated in the 'European' manner, legs hanging down and knees apart. Bas-relief sculpture from the period is characterized by narrative panels divided into two registers and is used to decorate stupa monuments. Other artistic productions also include gold and silver votive tablets signifying wealth and power, neck and chest ornaments made of flat gold plates, gold betel sets, gold plaques in relief, images of Buddha cut out of gold sheet, and ornaments and figurines decorated with repoussé, filigree, enameling and niello work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nakhon Pathom"@en .

aat:300107183 a skos:Concept ;
    skos:definition "Refers to the period associated with the temple precinct of Wat Kukut in the Lamphun region established in the 13th century. The style of the period is based on the architectural features of the temple, such as the two large stupas made from laterite and constructed in the late Dvaravati style, a large square monument with a high base and five square receding tiers surmounted by pointed spires and decorated with miniature stupa, and niches housing Buddha image in stucco and terracotta. In sculpture, artistic production from this period includes an octagonal-shaped monument crowned with small, round stupa and decorated with panels containing a standing Buddha image in stucco. Around the base of the stupa, seated Buddha statues perform the gesture of subduing Mara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wat Kukut"@en .

aat:300107186 a skos:Concept ;
    skos:definition "Refers to the period from the 14th to the 17th centuries, named for the province of Nakhon si Thammarat on the eastern coast of Thailand. In architecture, the period features temples with laterite or brick bell-shaped and lotus-shaped stupa set on square bases, free-standing elephant statuaries, wihan, mondop, double staircases, and decorated pediments with inward turning makaras. In sculpture, the period features bronze images of Buddha, terracotta or pewter votive tablets that displayed rows of identical Buddha images, and wood sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nakhon Si Thammarat"@en .

aat:300107189 a skos:Concept ;
    skos:definition "Refers to the period named for the city Chiang Mai in northern Thailand. The style of this period is driven by the region's long political and religious history. In architecture, the period features many wat temple complexes that reflect Burmese stylistic influences, European colonial influences, and the innovations of monk Khruba Srivijaya in the 1930s. Prominent temples of the period include Wat Chiang Man (1297 CE) that features a square stupa reflecting strong Mon influences; Wat Umong (1296 CE) featuring stucco construction and heavy Mon influences as well; Wat Phra Sing Luang (1345 CE) housing a gilded bronze Buddha image; and Wat Chedi Chet Yot (1455 CE), a funerary monument featuring seven spires resting on a high laterite base decorated with deity figures modeled after Sukhothai styles. Sculptural productions from the period reflect Sukhothai methods and generally exude vibrant serenity. The period features ungilded bronze statues and Buddha statues posed in the m'ravijaya mudr position with right hand resting on right knee and extended towards the ground and characterized by broad torsos and large hair curls adorned with a lotus-bud ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiang Mai"@en .

aat:300107202 a skos:Concept ;
    skos:definition "Periods, culture, and styles from predynastic times in Upper Egypt, which constituted a political entity separate from the delta region, Lower Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upper Egyptian Predynastic"@en .

aat:300107203 a skos:Concept ;
    skos:definition "Periods, cultures, and styles related to the Predynastic era of Lower Egypt. is GT, needs to be concept"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Egyptian Predynastic"@en .

aat:300107204 a skos:Concept ;
    skos:definition "Refers to the Predynastic period in Lower Egypt from about 3500 to 3250 BCE named after the site of El-Omari. The period is characterized by the continuation of lithic and pottery forms from the previous Merimde period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "El-Omari"@en .

aat:300107206 a skos:Concept ;
    skos:definition "Refers to the Predynastic period in Lower Egypt from about 4800 to 4000 BCE named after the location of settlements in the Fayum. These settlements were based on hunting, fishing, and gathering and are characterized by coarsely made and simply shaped pottery and a richly varied lithic industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fayum A"@en .

aat:300107212 a skos:Concept ;
    skos:definition "Refers to the Predynastic culture or period in Lower Egypt from about 3250 to 3100 BCE named after the site of Ma'adi. The period is characterized by evidence of connections with Upper Egypt and Palestine and the introduction of copper artifacts and new lithic technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ma'adi"@en .

aat:300107214 a skos:Concept ;
    skos:definition "Refers to the Predynastic period in Lower Egypt from about 4500 to 3500 BCE named after the site of Merimde. The period is characterizd by a fully sedentary village life with pottery and stone artifacts similar to those of Fayum A but with more variation and elaboration in the pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Merimde"@en .

aat:300107218 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 2130 to 1970 BCE comprising the Ninth Dynasty and Tenth Dynasty. The period is characterized by a shift of power from the city of Memphis to Heracleopolis after which the period is named. Little is known of the art and architectue of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heracleopolitan period"@en .

aat:300107224 a skos:Concept ;
    skos:definition "Periods related to Vietnamese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vietnamese periods"@en .

aat:300107225 a skos:Concept ;
    skos:definition "Primarily refers to the period of the prominent Later Ly dynasty (1010-1225 CE) established in the Red River Delta region, but may also refer to the style and period of the lesser-developed Earlier Ly dynasty (544-c. 603 CE). The style of Later Ly period is driven by dynastic stability and is generally thought to have helped influenced the style of the modern Vietnamese state. In architecture, the period features Buddhist temples with indigenous innovations such as the use of stone, superimposed trusses, beams and half-columns and the use of eaves decorated with terracotta symbols. A prime architectural example from this period is the Lotus Temple (1049 CE) in Hanoi, featuring decorative motifs in terracotta along the roof ridges, a distinct lotus-shaped construction, and a complex truss system consisting of intersecting beams and columns. In sculpture, the period features Buddha figures seated on platforms with dragon and flower decorations, relief panels reflecting Cham or Chinese art styles, stupas with sculpted motifs of oak and vine leaves, and statues of lions, elephants, buffaloes, and horses each on a lotus pedestal and carved from a single block of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ly"@en .

aat:300107228 a skos:Concept ;
    skos:definition "Refers to the period and culture marking the Trân dynasty (1225-1400 CE) characterized by a strong resurgence of Buddhist-inspired art and political stability. In sculpture, the period reflects a combination of Chinese styles, as reflected in the use of the lotus base and drapery, and of Cham styles, as reflected in the dominance of symmetry and slender, rhythmic constructions and in facial features such as large eyes, high nose, and thick lips. Naturalistic stone figures of animals on tomb sites are prevalent during this period as evidenced by the tomb of King Tran Hien Tong (1329-1341 CE) featuring a reclining water buffalo and dog. Architecture of this period imitates the forms used during the Ly dynasty, featuring brick and stone construction, lower external walls adorned with bas-relief carvings of flowers, leaves, waves, clouds, higher external walls that depicted dragon images, sanctuaries, doors of iron-wood, and incense-burning halls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trân"@en .

aat:300107232 a skos:Concept ;
    skos:definition "Refers to period of the Later Lê dynasty (1418-1802 CE) but may also refer to the style and period of the Earlier Lê dynasty (980-1010 CE). The style of the Earlier Lê period generally features developments in sculpture and architecture leading to artistic culmination in the subsequent Ly period (1010-1225 CE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lê"@en .

aat:300107235 a skos:Concept ;
    skos:definition "Refers to the period marking the Nguyên dynasty (1802-1954 CE). The style of the earlier part of the period is patterned after the art of the Chinese Qing dynasty (1644-1911 CE) as evidenced by the manner in which the Nguyên city of Hue is constructed to duplicate the Forbidden City in Beijing. Temples and shrines in this period feature lacquered wood statues of Buddha and of monks in styles similar to those executed in the 18th century. In the early 20th century, the Chinese traditions and Buddhist themes were generally abandoned for a more European neo-classical approach as evidenced by the founding of the Ecole des Beaux Arts de l'Indochine de Hanoi in 1925, which taught Western techniques such as bronze-casting. The period also features traditional woodblock print production styles characterized by the use of rice paper colored with mineral or plant extracts. Print designs feature motifs from the lunar calendar, illustrations of popular myths, scenes from village festivals, and historic figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nguyên"@en .

aat:300107240 a skos:Concept ;
    skos:definition "Refers to the style associated with the Flores region in Indonesia. The style features shell and bone carvings, elaborate beadwork, and gilded, gem-encrusted jewelry. The style also incorporates non-indigenous materials such as glass and coral beads into native designs. Head and neck ornaments were often cast in the lost-wax method and depicted motifs of buffalo heads and horns. Monumental sculpture in this style is heavily influenced by religion and features sacrificial altars and sacred megalith structures as well as menhirs, dolmens, and terraced burial mounds. With the introduction of Hinduism and Buddhism, monumental sculpture developed into symbols of Buddha and Shiva. In sculpture, the style reveals a strong wood-carving tradition in which the representation of a mythical dragon-serpent exists as a dominant ornamental and protective symbol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flores"@en .

aat:300107241 a skos:Concept ;
    skos:definition "Refers to the style developed in the island region of Timor which later spread to various parts of Indonesia. The style is driven by territorial expansion, Portuguese colonialism, and a maritime trading culture. The style features traditional batik crafts, relief carvings, and jewelry designs of chest ornaments, modesty plates (badong or cupeng), headdresses comprised of gold repoussé, and gilded bracelets. Popular motifs in jewelry design and relief carvings are the boat symbol, the snake, and the buffalo horn, signifying rank and lineage. Wood carving and drawing designs in the style feature scroll and curvilinear shapes emphasized through the use of white chalk rubbed into incision and various Portuguese designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Timor"@en .

aat:300107244 a skos:Concept ;
    skos:definition "Refers to a style associated with Wayang puppetry plays characterized by the use of theatre space, symbolism, iconography, and narrative from Javanese and Arabic legends and from Hindu and Muslim texts in relief sculpture and in decorative arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wayang"@en .

aat:300107250 a skos:Concept ;
    skos:definition "Refers to the period and French style in architecture and decorative arts during the reign of Henri II from 1547 to 1559 characterized by Italian Renaissance forms and motifs that replaced earlier Gothic elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Henri II"@en .

aat:300107253 a skos:Concept ;
    skos:definition "Refers to the period in Egypt from about 664 to 332 BCE comprising the Twenty-sixth Dynasty through the Thirty-first Dynasty; some sources begin with the Twenty-fifth Dynasty about 750 BCE. The period is the last during which Egypt functioned as an independent political entity and its culture was increasingly under pressure from major civilizations of the Eastern Mediterranean and Near East. Works of art particularly sculpture are characterized by a uniform idealized style known as the Saite style, developed in the Tewnty-sixth Dynasty which was dominant throughout the Late period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Period"@en .

aat:300107260 a skos:Concept ;
    skos:definition "Refers to the period and culture in Indonesia influenced by the Chinese style of art that flourished in the late years of the Zhou Dynasty (ending 3rd century BCE). The style is characterized by various simple decorative styles of ceramics and ritual, house, and bronze wares. Jade productions of conservative designs also appear in this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Zhou"@en .

aat:300107281 a skos:Concept ;
    skos:definition "Includes Chinese heated masonry beds and similar Chinese heating systems employing ducts in walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kangs"@en .

aat:300107283 a skos:Concept ;
    skos:definition "Pottery styles belonging to Egyptian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian pottery styles"@en .

aat:300107286 a skos:Concept ;
    skos:definition "Refers to the Egyptian pottery style produced during the Badarian, Amratian, and Gerzean periods from about 6000 to 2925 BCE. The style is characterized by polishd thin-walled, handmade vesels coated with a red ocher wash, with black tops probably produced by placing the vessels while hot in carbonizing organic matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-topped"@en .

aat:300107290 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the Hellenistic period in Egypt in the 3rd century BCE, named after the cemetery at Hadra near Alexandria where many vessels of this style were found. The style is characterized by funeral vases covered with a white slip and decorated with a variety of floral and animal designs in polychrome paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadra"@en .

aat:300107292 a skos:Concept ;
    skos:definition "Refers to the Egyptian pottery style produced during the Old Kingdom from about 2650 to 2150 BCE. The style is characterized by vessels covered with an orange slip and burnished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange-burnished"@en .

aat:300107296 a skos:Concept ;
    skos:definition "Refers to the Egyptian pottery style produced during the Badarian and Amratian periods from about 6000 to 3200 BCE. The style is characterized by thin-walled handmade vessels coated with a red ocher wash and polished with a pebble or some other hard smooth object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red-polished"@en .

aat:300107298 a skos:Concept ;
    skos:definition "Refers to the Egyptian pottery style produced during the Badarian period from about 6000 to 4000 BCE. The style is characterized by vessels with a ripple-burnished surface achieved by combing ripples into wet clay or rubbing a pebble over hard clay and then burnishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ripple-burnished"@en .

aat:300107302 a skos:Concept ;
    skos:definition "Refers to the Egyptian pottery style produced during the Amratian period from about 4000 to 3200 BCE. The style is characterized by burnished Nile clay vessels coated with ochre and decorated with either geometric designs, imitating basketry or woven cloth, or abstracted figures of animals, human beings, and plants in white gypsum pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white cross-lined"@en .

aat:300107304 a skos:Concept ;
    skos:definition "Styles, periods, and cultures found on the peninsula of Italy, especially those dating from the most ancient times through the Roman period, but may include any period prior to the formation of the modern nation of Italy in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Italian"@en .

aat:300107307 a skos:Concept ;
    skos:definition "Periods related to Italian Bronze Age cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian Bronze Age periods"@en .

aat:300107308 a skos:Concept ;
    skos:definition "Refers to the Bronze Age period and culture that occupied much of the Italian peninsula. It is characterized by a scarcity of metal objects, elaborate pottery with complex handles, and generally by small settlements, with occasional larger ones forming notable exceptions. It was formerly believed that this culture was primarily seminomadic and pastoral, but most modern scholars believe that many people of this culture lived in permanent dwellings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apennine"@en .

aat:300107311 a skos:Concept ;
    skos:definition "Refers to a Bronze Age period and culture that supplanted existing cultures on the Aeolian islands from around 1250 BCE. It is apparently of Apennine origin and is characterized by a new type of dwelling, generally of wood on stone, with an oval or square foundation. It has much in common with the contemporary Morgetian culture in Sicily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ausonian"@en .

aat:300107313 a skos:Concept ;
    skos:definition "Refers to a Bronze Age period and culture of Apennine origin that arrived in Sicily in the thirteenth century BCE. It has much in common with the contemporary Ausonian culture on the Aeolian islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morgetian"@en .

aat:300107315 a skos:Concept ;
    skos:definition "Refers to a transition period and culture of the late Bronze Age in Italy. It is characterized by an increase in population, development of larger, permanent settlements, cremation burials with biconical ash urns, and artifacts that include fibulae, razors, axes, bronze weapons, and amber objects. This culture overlaps with the Sub-Apennine culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Villanovan"@en .

aat:300107317 a skos:Concept ;
    skos:definition "Refers to a Bronze Age period and culture that developed around 1500 BCE in Emilia in northern Italy and lasted until the Early Iron Age. The term is derived from \"terra marna,\" meaning \"rich land\" in Emilian dialect and referring to the large amount of archaeological remains associated with the sites. It is characterized by distinctive ornamentation of weapons and pottery, cremation of the dead, and adaptations to a flat terrain that was prone to violent seasonal rains and flooding, including habitations built upon pilings and protected from floods by a vallum or wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Terramare"@en .

aat:300107319 a skos:Concept ;
    skos:definition "Refers to a transition period and culture of the late Bronze Age in Italy. It is characterized by permanent settlements, cremation burials, and distinctive bronze and amber objects. This culture overlaps with the Proto-Villanovan culture. This term is not to be confused with the homograph in geology that refers to a series of strata of the Pliocene age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sub-Apennine"@en .

aat:300107321 a skos:Concept ;
    skos:definition "Korean heating systems employing warm air chambers or ducts beneath the floor; similar to Roman hypocausts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ondols"@en .

aat:300107328 a skos:Concept ;
    skos:definition "Refers to the Italian style of pottery produced in the region of Abruzzo in the 17th and 18th centuries. Initially derivative of istoriato ware, the style developed local character with the use of naturalistic colors such as olive green, brown, and yellow, and religious, mythological, and landscape themes based on the work of Baroque artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castelli"@en .

aat:300107331 a skos:Concept ;
    skos:definition "Plastic sheeting, building paper, or similar materials that wrap the walls of a building beneath the outermost surface, serving to diminish the infiltration and exfiltration of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air infiltration barriers"@en .

aat:300107337 a skos:Concept ;
    skos:definition "Refers to the earlier stages of Etruscan culture and style, before the influence of Roman culture predominated. It includes the Early Iron Age, from the ninth century BCE to around 675 BCE, the Orientalizing phase, to around 575 BCE, and the early part of the Classical phase, to around 400 BCE. For classification systems that place the Iron Age Villanovan culture outside the Etruscan culture, the Early Etruscan culture would begin around 750 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Etruscan"@en .

aat:300107339 a skos:Concept ;
    skos:definition "Refers to the later stages of Etruscan culture and style, particularly after the Roman influence was evident, beginning in the Classical phase, from around 400 BCE, through the Hellenistic phase, from around 300 BCE to around 50 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Etruscan"@en .

aat:300107341 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the rule of the Roman consul and dictator, Julius Caesar, who died in 44 BCE. It is also sometimes used to refer to that which pertains to the Caesars more generally, that is, to all the Roman emperors who assumed the title of Caesar, from Augustus down to Hadrian, and thereafter, to the heir-presumptive of the emperor. In modern literature, it is also sometimes used to refer to all emperors down to the fall of Constantinople, or to that which has to do with the followers of the Roman Emperor in opposition to the Pope. In the context of art and architecture, this term is not limited to its common meaning in the discipline of history, where it may be used to refer narrowly to the Caesarian party of the ancient Roman senate or the armed forces of Julius Caesar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caesarian"@en .

aat:300107343 a skos:Concept ;
    skos:definition "Refers to the period and style that coincided with the rule of the Roman general and dictator, Lucius Cornelius Sulla, who lived from around 138 BCE to 78 BCE. The period is characterized by an emphasis on political and legal reforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sullan"@en .

aat:300107346 a skos:Concept ;
    skos:definition "Refers to the period and style of art 27 BCE-197 CE, that coincided with the time in Roman history when popular assemblies and the Senate were superceded by the reign of Emperors, most notably Augustus. The style is characterized by the influence of Classical Greek art and the construction of large-scale temples, forums, aqueducts, and villas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Imperial"@en .

aat:300107348 a skos:Concept ;
    skos:definition "Refers to the period and style of art, predominantly sculpture and architecture, that coincided with the reign of Trajan from 98 to 117 CE. In architecture, the style is charcterized by the construction of large, expansive public structures with axial plans similar to that of Egyptian temples. In sculpture, the style is characterized by friezes featuring a continuous narrative conveying scenes of the Emperor's military campaigns, typified in the Column of Trajan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trajanic"@en .

aat:300107350 a skos:Concept ;
    skos:definition "Refers to the period and style of art, predominantly sculpture and architecture, that coincided with the reign of Hadrian, 117 to 138 CE. In sculpture, the style is characterized by the influence of Classical Greek art, while in architecture, the style is characterized by a monumental sense of mass, large interior spaces, and the extensive use of poured concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadrianic"@en .

aat:300107354 a skos:Concept ;
    skos:definition "Architecture styles belonging to ancient Italian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient Italian architecture styles"@en .

aat:300107355 a skos:Concept ;
    skos:definition "Pottery styles belonging to ancient Italian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient Italian pottery styles"@en .

aat:300107356 a skos:Concept ;
    skos:definition "Pottery styles belonging to Abbasid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abbasid pottery styles"@en .

aat:300107357 a skos:Concept ;
    skos:definition "Refers to a style of Etruscan pottery that was probably influenced by styles that developed in Rhodes, Greece. It is often characterized by dark-on-light decoration, particularly stylized black animals or human figures painted in horizontal bands across the vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Civitavecchia"@en .

aat:300107359 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in Falerii now present day Cività Castellana in central Italy. Known mainly as a significant center of red-figure pottery during the 4th century BCE, works of art include red-figure vases produced by the Aurora Painter and the Nazzano Painter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Faliscan"@en .

aat:300107361 a skos:Concept ;
    skos:definition "Pottery styles belonging to Roman cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman pottery styles"@en .

aat:300107362 a skos:Concept ;
    skos:definition "Style of early Roman pottery that is characterized by having a fine, hard, thin, reddish fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brittle"@en .

aat:300107367 a skos:Concept ;
    skos:definition "Refers to a distinctive style of pottery made in Gaul, the Rhineland, Great Britain, and elsewhere. It is characterized by the use of a wash containing specks of yellow mica, which creates an effect that resembles bronze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micaceous"@en .

aat:300107370 a skos:Concept ;
    skos:definition "Refers to distinctive style of pottery manufactured beginning in the first century BCE. Though the name refers to the city of Pergamon, it was actually produced in many places in Greece, Asia Minor, and the Middle East. It is characterized by a buff-colored body that varies in color, a dark-red gloss, and designs that are usually impressed or incised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pergamene"@en .

aat:300107372 a skos:Concept ;
    skos:definition "Generally, the style of any ancient pottery that is solid red in color, has a satiny gloss, and comes from Rome, the Near East, or Greece. It is characterized by being unpainted, though sometimes having ovolo molding or relief decoration. To specifically distinguish the style of Roman pottery that has a fine gloss and sealing-wax red color, created by using a refined slip and a firing technique that allows oxidation, use \"Terra sigillata (pottery style).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red-gloss"@en .

aat:300107374 a skos:Concept ;
    skos:definition "Refers to earthenware and stone ware that is often unglazed, made of clays that range in color from tan to red or black that fire to a shade of red; it is usually wheel-thrown and fired at a relatively low temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redware"@en .

aat:300107376 a skos:Concept ;
    skos:definition "Refers a style used in fine pottery of Italy, Gaul, and Germany, and throughout the Roman Empire from the first century BCE to the third century CE. It developed from the traditions of ancient Greek pottery in the use of calcitic clays rich in iron compounds to produce a glossy surface, but it differs from Greek pottery in employing a single-phase firing in an open kiln. It is characterized by its red color, smooth finish, and sometimes by decorations of stamped figures or patterns. The term was coined in the ninteenth century, and historically there has been disagreement regarding to which pottery it applies, stemming from various interpretations of the term as either \"stamped earth,\" with reference to the stamped designs, or \"sealed earth\" with reference to an astringent, fatty, medicinal bole called \"terra sigillata,\" from the island of Lemnos, that was thought to be the clay from which the pottery was made. Further confusion has surrounded the relationship of this term and \"Samian ware\" or \"Samian.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Terra sigillata"@en .

aat:300107378 a skos:Concept ;
    skos:definition "Refers to a style of Roman pottery that is a variety of Terra sigillata pottery either made on Samos, an island in the Aegean Sea, or made of clay from Samos. Modern scholars generally use the term as a synonym for \"Terra sigillata,\" believing the earlier use of the term was based on a misunderstanding of ancient usage, which probably simply referred to a varnishing technique used for Terra sigillata and not to the island of Samos. The term is also sometimes used to refer to Greek Geometric and Orientalizing pottery made or excavated on Samos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samian"@en .

aat:300107380 a skos:Concept ;
    skos:definition "Refers to a style of Terra sigillata ware that developed in Italy and elsewhere in the western Roman Empire, after it had first been introduced in the Hellenistic east. It is characterized by being high quality tableware based on the typical Roman technology and design, merged with various local features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western sigillata"@en .

aat:300107384 a skos:Concept ;
    skos:definition "Refers to a style of Roman pottery that generally has a fine, hard, thin fabric and is decorated with painted designs and distinctive wedge-shaped projections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thorn"@en .

aat:300107387 a skos:Concept ;
    skos:definition "Sculpture styles belonging to ancient Italian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient Italian sculpture styles"@en .

aat:300107388 a skos:Concept ;
    skos:definition "Refers to a style of Roman sculpture that developed in the second century CE and is characterized by the movement away from the earlier modeling techniques that employed positive modification of the surface by shaping the material, to instead use negative modeling. The style used gouging, the running drill, and other methods to create sharp contrasts in light and shade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hard Style"@en .

aat:300107391 a skos:Concept ;
    skos:definition "Wall painting styles belonging to ancient Italian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient Italian wall painting styles"@en .

aat:300107415 a skos:Concept ;
    skos:definition "Painting styles belonging to Timurid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Timurid painting styles"@en .

aat:300107429 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Manus Islands. The artwork of the peoples of Manus consists primarily of woodcarvings of the human figure, commonly in combination with crocodiles and fish. Wooden beds were produced by the Manus people; Manus beds were the only large furniture produced in Melanesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manus"@en .

aat:300107446 a skos:Concept ;
    skos:definition "Refers to the style and cultures that developed on the Italian peninsula in places where Etruscans came into contact with Greek culture through Greek colonists and their art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greco-Etruscan"@en .

aat:300107447 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Fiji islands whose settlers are well known for their Lapita pottery. Fijian men tend to utilize wood as a primary medium during art production. Specialist Fijian carpenters produce sculptures, bowls, canoes, drums, weapons, headrests and ornaments. Late 20th-century Fijian art production includes traditional objects made for the craft market and local use, and 19th-century antique reproductions, as well as tourist art products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fijian"@en .

aat:300107448 a skos:Concept ;
    skos:definition "Refers to styles and cultures on the Italian peninisula, particularly in the area of ancient Etruria, that combine elements of the Etruscan culture and other non-Roman, or \"Italic,\" cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etrusco-Italic"@en .

aat:300107453 a skos:Concept ;
    skos:definition "Refers to the styles and cultures that developed in the British Isles under the influence of Roman rule and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romano-British"@en .

aat:300107457 a skos:Concept ;
    skos:definition "Refers to the phase of Villanovan style and culture defined by artifacts at the type sites west of Bologna, on land owned by the Benacci family. It is tyically divided into Benacci I, lasting from around 1050 BCE to around 900 BCE, and Benacci II, lasting from around 900 BCE to around 700 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Benacci"@en .

aat:300107459 a skos:Concept ;
    skos:definition "Refers to the phase of Villanovan style and culture defined by artifacts at the type site in Bologna, on land owned by the Arnoaldi family. It existed from around 700 BCE to around 450 BCE and overlapped with Etruscan culture, though most scholars believe it is distinct from Etruscan culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arnoaldi"@en .

aat:300107466 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Irian Jaya. Most of the art of Irian Jaya comes from the coastal areas. Masks, ceremonial costume, and body paint design are very important art forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irian Jaya"@en .

aat:300107472 a skos:Concept ;
    skos:definition "Regional styles belonging to Irian Jaya cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irian Jaya regional styles"@en .

aat:300107475 a skos:Concept ;
    skos:definition "Refers to the first distinct phase of of Spanish Plateresque style, starting in the late 15th century. It is characterized by a merging of Flamboyant Gothic and traditional Spanish styles. The style overlaps with Isabelline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Plateresque"@en .

aat:300107478 a skos:Concept ;
    skos:definition "Native styles belonging to Irian Jaya cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irian Jaya native styles"@en .

aat:300107498 a skos:Concept ;
    skos:definition "Sculpture stules belonging to New Ireland cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Ireland sculpture styles"@en .

aat:300107499 a skos:Concept ;
    skos:definition "The Malanggan style describes a type of narrative ceremonial figurative wooden sculpture, carving or mask native to the region of New Ireland, Australia. Malanggan artworks consist of a single piece of softwood that has been engraved, usually in openwork and painted red, black, yellow, or white. The carvings include references to specific persons, animals, and historical events that played a role in the life of the deceased. There are endless amounts of recorded Malanggan motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malanggan style"@en .

aat:300107501 a skos:Concept ;
    skos:definition "Describes the artwork created by the inhabitants of Choiseul Island. The general figural style in the southern islands was more naturalistic in human proportions and features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Choiseul"@en .

aat:300107503 a skos:Concept ;
    skos:definition "Describes works created by the inhabitants of the Tuvalu Islands. The artwork of the Tuvalu primarily consists of tattoo and canoe design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuvalu"@en .

aat:300107526 a skos:Concept ;
    skos:definition "Anatolian Paleolithic cultures and periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian Paleolithic"@en .

aat:300107527 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period before around 10500 BCE in southwestern Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kemerian"@en .

aat:300107529 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period in southwestern Turkey around 10500 BCE named after the site of Belbasi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belbasi"@en .

aat:300107531 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period in southwestern Turkey around 9500 BCE named after the site of Beldibi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beldibi"@en .

aat:300107543 a skos:Concept ;
    skos:definition "Refers to the Hittite period from about 1500 to 1400 BCE in Anatolia during a dark age between the Old Hittite Kingdom and the Hittite Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Hittite Kingdom"@en .

aat:300107545 a skos:Concept ;
    skos:definition "Pottery styles belonging to Anatolian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian pottery styles"@en .

aat:300107554 a skos:Concept ;
    skos:definition "Refers to the pottery style found in central Anatolia from about 3400 to 2700 BCE. The style is characterized by elegant shapes decorated with painted purple-brown designs on an orange slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cappadocian"@en .

aat:300107556 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the Konya plain of Anatolia around 5000 BCE, named after the site of Çatal Hüyük West. The style is characterized by vessels, most commonly jars, simple bowls, and cups, decorated with red painted linear designs on a buff or red ground that are sometimes burnished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Çatal West"@en .

aat:300107558 a skos:Concept ;
    skos:definition "Style of pottery from Anatolia in the 5th millenium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gritty buff"@en .

aat:300107561 a skos:Concept ;
    skos:definition "Refers to the pottery found in central Anatolia from about 2400 to 2000 BCE. The style is characterized by vessels decorated with painted pink to brown geometric motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Intermediate"@en .

aat:300107563 a skos:Concept ;
    skos:definition "Refers to the pottery style found at the site of Troy in Anatolia around 1150 BCE. The pottery is crude and handmade with similarities to a style found in Hungary and central Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Knobbed"@en .

aat:300107565 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the Konya plain of southern Anatolia from about 3300 to 2500 BCE. The pottery is handmade and well fired with sharp profiles and beveled edges. It is characterized by a pale red or buff body often decorated with white, red, or orange painted hatching, stripes, or wavy lines and later with overall brown or purplish paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Metallic"@en .

aat:300107567 a skos:Concept ;
    skos:definition "Refers to a pottery style found in southeastern Anatolia from about 3200 to 2500 BCE. The pottery is wheelmade and well fired with an orange buff or light greenish buff body painted with red-orange to greenish black or black wavy lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Multiple-Brush Painted"@en .

aat:300107580 a skos:Concept ;
    skos:definition "Refers to the period from about 3000 to 500 BCE in the area of modern Bahrain, Failaka Island, and the eastern coast of Saudi Arabia. The art of the period is characterized by varying cultural influences over time resulting from contact with Mesopotamia to the west and the Indus Valley to the east."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dilmun"@en .

aat:300107582 a skos:Concept ;
    skos:definition "Refers to the period from about 3000 to 1750 BCE in the area of modern Bahrain, Failaka Island, and the eastern coast of Saudi Arabia. The style of the period shows evidence for close links with both the Indus Valley and Mesopotamia, seen especially in stamp seals which exhibit motifs from both regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Dilmun"@en .

aat:300107584 a skos:Concept ;
    skos:definition "Refers to the period from about 1750 to 1250 BCE in the area of modern Bahrain, Failaka Island, and the eastern coast of Saudi Arabia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Dilmun"@en .

aat:300107586 a skos:Concept ;
    skos:definition "Refers to the period from about 1250 to 500 BCE in the area of modern Bahrain, Failaka Island, and the eastern coast of Saudi Arabia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Dilmun"@en .

aat:300107591 a skos:Concept ;
    skos:definition "Periods related to Cypriote cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypriote periods"@en .

aat:300107592 a skos:Concept ;
    skos:definition "Styles belonging to Cypriote cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypriote styles"@en .

aat:300107593 a skos:Concept ;
    skos:definition "Refers to the period from about 2300 to 1900 BCE on the island of Cyprus. The art of the period is characterized by flat painted or incised terracotta figurines, vessels with scenes of daily life modeled around their outer rims, and the dominance of red-polished pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Cypriote"@en .

aat:300107595 a skos:Concept ;
    skos:definition "Refers to the transitional phase on the island of Cyprus from about 2500 to 2300 BCE between the end of the Chalcolithic period and the start of the Early Cypriote period, named after the site of Philia. Pottery of the period includes both late Chalcolithic and Early Cypriote wares including shapes and designs with parallels in southwestern Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Philia stage"@en .

aat:300107599 a skos:Concept ;
    skos:definition "Refers to the period from about 1900 to 1600 BCE on the island of Cyprus. The art of the period is characterized by a continuation of Early Cypriote styles including red-polished pottery and the production of flat painted or incised terracotta figurines some with modeled legs and arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Cypriote"@en .

aat:300107602 a skos:Concept ;
    skos:definition "Refers to the period from about 1600 to 1050 BCE on the island of Cyprus. The art of the period is characterized by distinctive pottery styles, refined metalwork and decorative ivory pieces, and the growth of eclectic styles resulting from increased trading links with the Near East, Egypt, and Aegean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Cypriote"@en .

aat:300107604 a skos:Concept ;
    skos:definition "Pottery styles belonging to Cypriote cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypriote pottery styles"@en .

aat:300107605 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus during the Late Cypriote period from about 1600 to 1050 BCE. The style is characterized by vessels with applied ring shaped bases, finished in a highly polished brown slip with incised or relief decoration or white painted lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Base Ring"@en .

aat:300107607 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus during the Chalcolithic period from about 3800 to 2300 BCE. The style is characterized by hand-thrown vessels covered with a thick, lustrous black slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black Lustrous"@en .

aat:300107609 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus during the Late Chalcolithic period from about 2800 to 2300 BCE. The style is characterized by handmade vessels covered with a thick red slip and then a black slip on which designs were scratched in order to uncover the underlying red slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black-slip-and-combed"@en .

aat:300107613 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus from the Late Neolithic period beginning around 4500 BCE through the Chalcolithic period ending around 2300 BCE. The style, one of the first indigenous ones to emerge in Cyprus, went through several stages of development but is generally characterized by handmade vessels, most commonly thick walled bowls and handleless flasks, decorated with red paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red-on-white"@en .

aat:300107614 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus during the Chalcolithic period from about 3800 to 2300 BCE. The style is characterized by hand-thrown vessels covered with a thick lustrous black slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red Lustrous"@en .

aat:300107616 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus during the Middle Cypriote period from about 1900 to 1600 BCE. The style is characterized by vessels covered with a uniform black slip and decorated with red painted lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red-on-black"@en .

aat:300107618 a skos:Concept ;
    skos:definition "Refers to the pottery style predominant in Cyprus from the Philia stage beginning around 2500 BCE through the Middle Cypriote period ending around 1600 BCE. While the style underwent many changes in quality and appearance over time, generally it is characterized by a burnished red slip, fired to the colors of red and black, and decorated with incised and relief motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red Polished"@en .

aat:300107620 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus from the Early Cypriote period beginning around 2300 BCE through the Geometric period ending around 750 BCE. While the style underwent changes over time, generally it is characterized by pottery decorated with dark paint on a white or light background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "White Painted"@en .

aat:300107622 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Cyprus during the Late Cypriote period from about 1600 to 1050 BCE. The style is generally characterized by vessels with a thick, creamy white slip that are decorated with dark colored paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "White Slip"@en .

aat:300107629 a skos:Concept ;
    skos:definition "Periods related to Levantine cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levantine periods"@en .

aat:300107631 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period from about 30,000 to 25,000 BCE in northern and central Levant. The period is characterized by lithic production of blades and flakes, and a rich bone and antler industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levanto-Aurignacian"@en .

aat:300107633 a skos:Concept ;
    skos:definition "Periods related to Levantine Neolithic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levantine Neolithic periods"@en .

aat:300107637 a skos:Concept ;
    skos:definition "Refers to the Pottery Neolithic period in the southern Levant from about 5500 to 5000 BCE based on the site of Munhatta. The period is characterized by the continuation of cultural traits of the previous Yarmukian period, particularly the production of pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Munhatta phase"@en .

aat:300107641 a skos:Concept ;
    skos:definition "Refers to the Neolithic period from about 4200 to 4000 BCE in the Levant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Ghassulian"@en .

aat:300107643 a skos:Concept ;
    skos:definition "Pottery styles belonging to Levantine cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levantine pottery styles"@en .

aat:300107646 a skos:Concept ;
    skos:definition "Refers to the pottery style found in northern Mesopotamia during the Mitannian period from about 1500 to 1300 BCE. The style is characterized by painted vessels decorated with white designs on a dark ground, of which goblets are the most common form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuzi"@en .

aat:300107653 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the northern Levant particularly in the Amuq plain from about 6000 to 5500 BCE. The style is characterized by vessels decorated with red painted simple motifs on a white slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brittle Painted"@en .

aat:300107655 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the Levant from about 6000 to 5300 BCE. The style is characterized by thin-walled vessels that were burnished and impressed or incised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dark-faced Burnished"@en .

aat:300107657 a skos:Concept ;
    skos:definition "Refers to the pottery style found in northern Mesopotamia in the early 2nd millennium BCE named after the Khabur River region. The style is characterized by rounded forms decorated with simple designs in bands or zones on a buff ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khabur"@en .

aat:300107659 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the Levant during the mid-3rd millennium BCE named after the site of Khirbet Kerak but thought to have originated in the Caucasus area. The style is characterized by vessels covered with a brilliant black burnished slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khirbet Kerak"@en .

aat:300107662 a skos:Concept ;
    skos:definition "Refers to the pottery style found in northern Mesopotamia during the late 3rd millennium BCE, named after the metallic clink made when sherds are knocked together. The style is characterized by gray-black, highly fired, dense and hard vessels that are sometimes decorated with spiral burnishing or painted horizontal bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Metallic"@en .

aat:300107668 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the northern Levant from about 5500 to 5000 BCE. The style is characterized by vessels covered with a red wash that are sometimes decorated with plain reserve bands with impressed or incised ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red Wash"@en .

aat:300107675 a skos:Concept ;
    skos:definition "Refers to the period in the southern Levant from about 5000 to 4500 BCE, named after the site of Wadi Rabah. The period is characterized by the continued production of pottery, particularly bright red-or glossy black, burnished vessels, and the introduction of maceheads and biconical sling bullets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wadi Rabah"@en .

aat:300107678 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the northern Levant from about 6600 to 6000 BCE. The style is characterized by vessels formed by coils made from a composite of lime and salty gray ashes that when dried and fired turned into a hard white material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "White"@en .

aat:300107688 a skos:Concept ;
    skos:definition "Refers to the style and culture of the area of Palestine, located between the eastern coast of the Mediterranean Sea and the Arabian desert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palestinian"@en .

aat:300107690 a skos:Concept ;
    skos:definition "Columns with shafts smaller in radius at the top than at the bottom, particularly when the inward taper is a straight line, as opposed to exhibiting entasis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diminishing columns"@en .

aat:300107694 a skos:Concept ;
    skos:definition "Glyptic styles belonging to Mesopotamian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesopotamian glyptic styles"@en .

aat:300107695 a skos:Concept ;
    skos:definition "Periods related to prehistoric Mesopotamian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric Mesopotamian periods"@en .

aat:300107696 a skos:Concept ;
    skos:definition "Periods related to prehistoric Northern Mesopotamian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric Northern Mesopotamian periods"@en .

aat:300107697 a skos:Concept ;
    skos:definition "Refers to the period in the late 7th and early 6th millennium BCE in Mesopotamia, named after the site of Jarmo located in the Zagros Mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jarmo"@en .

aat:300107699 a skos:Concept ;
    skos:definition "Periods related to prehistoric Southern Mesopotamian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric Southern Mesopotamian periods"@en .

aat:300107701 a skos:Concept ;
    skos:definition "Refers to the phase in the Ubaid period in southern Mesopotamia from about 5500 to 5000 BCE. This phase is named after pottery found at early levels at the site of Eridu. The pottery was a fine monochrome ware with a limited distribution in southern Mesopotamia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eridu"@en .

aat:300107704 a skos:Concept ;
    skos:definition "Refers to the phase in the Ubaid period in southern Mesopotamia from about 5200 to 4800 BCE. This phase is named after a distinctive type of pottery found at the site of Hajji Muhammed, which was usually painted with dense patterns creating dark zones on the light buff pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hajji Muhammed"@en .

aat:300107710 a skos:Concept ;
    skos:definition "Refers to the period and culture from about 4000 to 3000 BCE, in northern Mesopotamia, named after the site of Gawra. The period is characterized by the presence of seals, metal objects, clay figurines, and the development of monumental architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gawra period"@en .

aat:300107712 a skos:Concept ;
    skos:definition "Refers to the Protoliterate period from about 4000 to 2900 BCE, in southern Mesopotamia, named after the site of Uruk. During this period developments such as the invention of writing and cylinder seals, the emergence of large cities, the establishment of widespread trade, and the appearance of monumental public buildings occurred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uruk"@en .

aat:300107716 a skos:Concept ;
    skos:definition "Refers to the Protoliterate period from about 3100 to 2900 BCE, in southern Mesopotamia, named after the site of Jamdat-Nasr."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jamdat Nasr"@en .

aat:300107720 a skos:Concept ;
    skos:definition "Refers to the period in Mesopotamia specifically in the Diyala region at the end of the Early Dynastic period from about 2425 to 2340 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protoimperial"@en .

aat:300107723 a skos:Concept ;
    skos:definition "Refers to a period and style in Mesopotamia from about 2150 to 2112 BCE, between the end of the Akkadian Empire and the start of the Third Dynasty of Ur. Used in particular to describe the sculptural style of Gudea of Lagash and cylinder seals of the period; however the dates of the reign of Gudea are now debated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post-Akkadian"@en .

aat:300107729 a skos:Concept ;
    skos:definition "Refers to the period at the beginning of the 2nd millennium BCE in Mesopotamia during which the city of Mari rose to prominence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mari Age"@en .

aat:300107732 a skos:Concept ;
    skos:definition "Refers to the style and culture of the region of Babylonia in southern Mesopotamia, beginning with the unification of the area in the early 2nd millennium BCE and lasting through the first millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Babylonian"@en .

aat:300107735 a skos:Concept ;
    skos:definition "Pottery styles belonging to Mesopotamian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesopotamian pottery styles"@en .

aat:300107736 a skos:Concept ;
    skos:definition "Refers to pottery found in Mesopotamia from the 6th millennium to the 2nd millennium BCE that is burnished to a black color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black burnished"@en .

aat:300107738 a skos:Concept ;
    skos:definition "Refers to the pottery style found in southern Mesopotamia and south western Persia during the fifth millennium BCE. The style is characterized by highly fired buff pottery decorated with black painted designs and is found in a variety of shapes including large carinated and convex bowls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black-on-Buff"@en .

aat:300107742 a skos:Concept ;
    skos:definition "Refers to a pottery style found in northern Mesopotamia during the Hassuna period, from about 6200 to 5700 BCE. The style is characterized by a red paint and a glossy surface finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hassuna archaic"@en .

aat:300107748 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the Diyala region of Mesopotamia and characterized by generally large, broad-shouldered pots with painted red designs, outlined in black, on a buff or yellow ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scarlet"@en .

aat:300107750 a skos:Concept ;
    skos:definition "Prehistoric periods related to Zagros Mountain cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zagros Mountain prehistoric periods"@en .

aat:300107755 a skos:Concept ;
    skos:definition "Refers to the period from about 10,000 to 8000 BCE in the Zagros Mountains in Iran named after the site of Zawi Chemi and the Shanidar cave. The period is characterized by a heavy stone industry, flaked and chipped stone tools, bone tools, and bead ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zawi Chemi Shanidar"@en .

aat:300107759 a skos:Concept ;
    skos:definition "Refers to the prehistoric period from about 8000 to 6500 BCE in the Zagros Mountains in Iran named after the site of Karim Shahir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karim Shaharian"@en .

aat:300107776 a skos:Concept ;
    skos:definition "Refers to the period from about 3100 to 2800 BCE after Elamites settled in Fars and established a state that was the forerunner of historic Elam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Elamite"@en .

aat:300107778 a skos:Concept ;
    skos:definition "Refers to the Elamite period from about 2500 to 1500 BCE when rulers of the Awan, Shimashki, and Sukkalmakh Dynasties ruled southwest Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Elamite"@en .

aat:300107783 a skos:Concept ;
    skos:definition "Pottery styles belonging to Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian pottery styles"@en .

aat:300107784 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Persia around 6000 BCE. The style is characterized by fine, plain buff pottery tempered with straw that is sometimes decorated with simple red or orange painted designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaic"@en .

aat:300107787 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Persia from about 6000 to 4000 BCE. The style is characterized by pottery tempered with straw and sometimes slightly burnished that has a buff to orange buff surface color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buff"@en .

aat:300107792 a skos:Concept ;
    skos:definition "Refers to the pottery style found in the northern Iranian plateau around 5000 BCE, named after the site of Ismailabad. The style is characterized by a wide variety of shapes and painted designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ismailabad"@en .

aat:300107794 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Persia around 5000 BCE named after the site of Mehmeh. The style is characterized by straw tempered pottery which is decorated with dark red paint on a pale red slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mehmeh Red-on-Red"@en .

aat:300107796 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Persia around 6000 BCE. The style is characterized by pottery tempered with straw that is covered with a red and often highly polished slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red Burnished"@en .

aat:300107798 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Iran around 6000 BCE named after the site of Tepe Sarab. The pottery is decorated with geometric or tadpole like designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarab"@en .

aat:300107800 a skos:Concept ;
    skos:definition "Refers to the pottery styles found at the site of Tepe Sialk in the Iranian central plateau dating from about 6000 to 3000 BCE. Different styles correspond to each of the four stages of the settlement sequence revealed in excavations but generally the pottery is known for its elaborate painted decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sialk"@en .

aat:300107802 a skos:Concept ;
    skos:definition "Refers to the period representing the initial spread of pottery making in Persia during which the pottery is tempered with vegetal matter and fired at a low temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soft Ware Horizon"@en .

aat:300107804 a skos:Concept ;
    skos:definition "Refers to the pottery style found in Persia around 6000 BCE. The style is characterized by buff pottery tempered with straw which is sometimes burnished and is decorated with red painted designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Standard Painted"@en .

aat:300107812 a skos:Concept ;
    skos:definition "Styles, periods, and culture belonging to Colonial North America. Refers to the culture and style of architecture, furniture, and domestic articles created in the area of the current United States during the period when it was colonized by Europeans, primarily during the seventeenth and eighteenth centuries. It may be also be used to refer to the culture and styles that persisted into the early nineteenth century, after the colonies gained independence. The term generally refers specifically to the culture and styles of the British colonies on the East Coast of the United States, generally not including the French or Spanish colonies. The meaning of the term overlaps with \"British Colonial,\" which is typically used to refer to the cultures and styles in British colonies other than those that existed in the area that is now the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial North American"@en .

aat:300107813 a skos:Concept ;
    skos:definition "Refers to style and culture of early British colonists to the East Coast of what is now the United States, including the culture of the English Puritans who founded the colony of Plymouth, Massachusetts, in 1620, and the cultures of other seventeenth-century British settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pilgrim"@en .

aat:300107826 a skos:Concept ;
    skos:definition "Refers to the earlier phase of Bandkeramik culture and style, characterized by pottery decorated with scratches, grooves, and relief patterns arranged in bands of meanders, curves, spirals, and wave-shapes. The term is sometimes used interchangeably with \"Bandkeramik.\" This phase is called \"Danubian I\" in the classification scheme of scholar V. Gordon Childe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linienbandkeramik"@en .

aat:300107832 a skos:Concept ;
    skos:definition "Refers to the culture and style of the people occupying land that was governed by the Real Audiencia of Charcas, near the end of the 18th century. The region is now the independent country of Bolivia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Altoperuvian"@en .

aat:300107834 a skos:Concept ;
    skos:definition "Refers to a style that originated in late 18th-century Mexico. In architecture, it developed from the Spanish Baroque and is characterized by lavishly carved facades with distinctive tapering estípites, brilliantly colored exteriors of glazed tiles, and varied geometric contours of doorways, windows and roof levels. The style was introduced in Mexico City in the Metropolitan Sacristy facade (1749-1768) by architect Lorenzo Rodríguez, and spread swiftly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Puebla"@en .

aat:300107836 a skos:Concept ;
    skos:definition "Refers to a style of architecture built from the 16th to the 19th centuries in the mountainous region of southern Peru. It is characterized by the use of local volcanic tufa or sillar and an integration of Creole, Mestizo, and Pre-Columbian styles and motifs such as maize, cantuta flowers, birds, fish, and mythic figures into Baroque relief. In sculpture, it refers to 17th century Mestizo Baroque relief styles characterized by careful incisions in the surface that generate a tapestry-like effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arequipa"@en .

aat:300107838 a skos:Concept ;
    skos:definition "Colonial architecture style of viceregal Mexico named for the Sanctuario deTepalcingo, particularly in regard to it's sculptural facade, which influenced other structures in the region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tepalcingo"@en .

aat:300107840 a skos:Concept ;
    skos:definition "Fine arts styles belonging to Colonial Latin American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial Latin American fine arts styles"@en .

aat:300107841 a skos:Concept ;
    skos:definition "Refers to a culture, and style of painting and sculpture promoted and established in a colonial Ecuadorean art school in 1552. It marked the foundation of a religious art movement, featuring wooden polychrome sculpture and paintings. In architecture, the style influenced the construction of churches, cloisters, and mansions, characterized by such features as Baroque columns, ceilings, and massive altars covered with gold leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quito"@en .

aat:300107846 a skos:Concept ;
    skos:definition "Styles, periods, cultures, and movements of Latin America in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern Latin American"@en .

aat:300107847 a skos:Concept ;
    skos:definition "Refers to the movement in Latin America in the early 20th century advocating a new social and political role for the indigenous peoples of regions formerly dominated by European elites. The movement became influential with the presidency of Lßszaro Cßsrdenas (1934-1940) and sought to revitalize Indian heritage through art and revolutionary movements, such as Aprismo, a social movement in Peru whose members proposed to rename Latin America, \"Indo-America\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indigenismo"@en .

aat:300107850 a skos:Concept ;
    skos:definition "Refers to the movement in Mexico, spearheaded by artists Diego Rivera and David Alfaro Siquieros, which sought to elevate and legitimize mural works as a recognized Mexican art form. The Mexican Muralist School, which included Rufino Tamayo, Juan Soriano, and José Clemente Orozco, politicized the movement, often depicting scenes from the Mexican Revolution, aspects of the nation's modernization, the relentless social upheavals with class struggles in satirical and life-like styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mexican Muralist"@en .

aat:300107861 a skos:Concept ;
    skos:definition "Supporting elements in the shape of human figures. For piers with engaged figures where the pier, not the statue, supports the entablature, see, for example, \"Osiride pillars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropomorphic supporting elements"@en .

aat:300107873 a skos:Concept ;
    skos:definition "Refers to the movement in architecture and design in the late 1860s and 1870s marked by an aesthetic of wealth and affluence and characterized by elaborate embellishments such as carved wooden latticework and the addition of the veranda derived from the Picturesque period of English architecture of the 1830s. The style is prevalent in resorts such as Cape May and Martha's Vineyard and in opera houses and mansions of the boomtown mining colonies of the old West."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gingerbread"@en .

aat:300107905 a skos:Concept ;
    skos:definition "Refers to movement in America that flourished from around 1785 to 1820 based on the revival of Roman architectural styles in the design of government buildings. The movement, endorsed by Thomas Jefferson and Benjamin Latrobe, is driven by the metaphorical concept of the United States as analogous to the Roman Republic in its grandeur and political philosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Federal"@en .

aat:300107913 a skos:Concept ;
    skos:definition "Refers to the movement in the Gothic Revival period in architecture characterized by the use of Gothic forms in domestic buildings primarily in the United States Northeast and Midwest during the mid-19th century and by the use of the scroll saw in construction. The style reveals an awkward attempt at imitation and implementation of original Gothic proportions and ornamentation such as turrets, spires, and pointed arches, with no sense of logical spatial relationship to the house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carpenter Gothic"@en .

aat:300107922 a skos:Concept ;
    skos:definition "Style and movement inspired by the architecture and iconography of pre-Columbian Mesoamerican cultures. Most works date to the 1920s and 1930s; examples include architecture, mosaics, and other works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mayan Revival"@en .

aat:300107946 a skos:Concept ;
    skos:definition "Used to describe styles of the regions of the Americas, including styles found in North, Central, and South America, as well as the Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American regions"@en .

aat:300107947 a skos:Concept ;
    skos:definition "Refers to certain West Indian cultures, particularly those on the islands and the bordering mainlands of the Caribbean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caribbean"@en .

aat:300107949 a skos:Concept ;
    skos:definition "Culture, style, and nationality of Haiti, a country in the Caribbean Sea that includes the western third of the island of Hispaniola and several smaller islands. The population is largely descended from enslaved Africans; the country won independence from France in 1804."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haitian"@en .

aat:300107952 a skos:Concept ;
    skos:definition "Refers to the cultures of the area of Central America, which is bounded by the Atlantic Ocean, the Pacific Ocean, Mexico, and South America. In classifications schemes based on physical geography, Central America and North America are parts of the same continent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central American"@en .

aat:300107956 a skos:Concept ;
    skos:definition "Refers to the context of or associated specifically with the modern political entity of the United States of America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American"@en .

aat:300107962 a skos:Concept ;
    skos:definition "The culture and nationality of the people in the current nation of Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canadian"@en .

aat:300107963 a skos:Concept ;
    skos:definition "Culture and nationality of the nation of Mexico or its people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mexican"@en .

aat:300107964 a skos:Concept ;
    skos:definition "Refers to the cultures of the continent of South America, which is bounded by the Pacific Ocean, the Atlantic Ocean, Central America, and the Antarctic region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South American"@en .

aat:300107965 a skos:Concept ;
    skos:definition "Of or belonging to the nation of Argentina or its people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Argentine"@en .

aat:300107967 a skos:Concept ;
    skos:definition "Of or belonging to the nation of Brazil or its people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brazilian"@en .

aat:300107971 a skos:Concept ;
    skos:definition "Of or belonging to the nation of Peru or its people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peruvian"@en .

aat:300107979 a skos:Concept ;
    skos:definition "Comparatively small open areas attached to a house or other building or enclosed by it, and open to the sky; sometimes walled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yards"@en .

aat:300107996 a skos:Concept ;
    skos:definition "Buildings designed or used for activities surrounding international relations, typically housing or accommodating a country's representatives abroad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diplomatic buildings"@en .

aat:300107997 a skos:Concept ;
    skos:definition "Official headquarters of foreign ministers appointed primarily to oversee and protect the home country's economic interests in a host country; when such headquarters are for ministers called ambassadors appointed to transact matters of international policy and business with a foreign government, use \"embassies.\" For the official residences of foreign ministers in general, use \"legations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consulates"@en .

aat:300108008 a skos:Concept ;
    skos:definition "Refers to the official headquarters of foreign ministers called ambassadors appointed to transact international business with a foreign government; when such headquarters are for ministers appointed primarily to oversee and protect the home country's economic interests in a host country, see \"consulates.\" For the official residences of foreign ministers in general, see \"legations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embassies"@en .

aat:300108017 a skos:Concept ;
    skos:definition "The official residences of foreign ministers. When such residences include offices for ministers appointed primarily to oversee and protect the home country's economic interests in a host country, use \"consulates,\" but use \"embassies\" when the offices and residences are for ministers called ambassadors appointed to implement items of international foreign policy in a host country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legations"@en .

aat:300108027 a skos:Concept ;
    skos:definition "Pieces of lumber used as temporary supports, as when in an oblique position to hold a wall under pressure or as a component of formwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shores"@en .

aat:300108063 a skos:Concept ;
    skos:definition "Styles belonging to Gulf Coast Mesoamerican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gulf Coast Mesoamerican styles"@en .

aat:300108079 a skos:Concept ;
    skos:definition "Pottery styles belonging to Chorotegan cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chorotegan pottery styles"@en .

aat:300108088 a skos:Concept ;
    skos:definition "Refers to the 19th century English revival style in architecture and decorative arts that combines characteristics of both the Elizabethan and Jacobean periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jacobethan"@en .

aat:300108090 a skos:Concept ;
    skos:definition "Architectural style that references French Rennaissance architecture, particularly the styles of monumental French houses (called \"chateaux\") built at the Loire Valley on the 5th-7th centuries. Seen extensively in North America, but also elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Château Style"@en .

aat:300108106 a skos:Concept ;
    skos:definition "Refers to the German late-18th-century Antique Revival style, known in German as the \"pig-tail style.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zopfstil"@en .

aat:300108127 a skos:Concept ;
    skos:definition "Refers to art styles that were a reaction against the traditional European conception of art as the imitation of nature. In the strictest sense, the term refers to 20th-century Western painting, sculpture, or graphic art having subject matter that does not include forms that represent objects from the visible world. For the general concept of art in which natural forms are only simplified or changed in their representation, but not eliminated entirely, use \"abstract (general art genre).\" For the process of formulating general concepts by abstracting common properties of instances, use \"abstraction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abstract"@en .

aat:300108149 a skos:Concept ;
    skos:definition "Refers to late 18th- to early 20th-century architecture and ornament based relatively closely on ancient classical forms. For other architecture and art of the late 18th and the 19th centuries that follow principles of classicism, use \"Neoclassical.\" Refers to the early 20th century (1905-1925) architectural style in Russia that emerged as a rejection of bourgeois aesthetics seen as decadent by monarchists and ideologically conservative critics in the architecture and art represented by Jugendstil (Art Nouveau and Russia's Stil' Modern). Certain critics saw Neoclassical Revival as a validation of Russia's imperial status. Select aspects of the style were transferred to early Soviet architecture by the same architects (such as Ivan Fomin) who practiced before the Russian Revolution. It is separate from neo-Russian Style, which has no references to the classical system and includes heavy usage of decorative elements not found in Neoclassical Revival. It is equivalent in specialist literature to the Russian term neoklassitsizm (whereas Neoclassicism is specified in Russian as klassitsizm)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Classical Revival"@en .

aat:300108167 a skos:Concept ;
    skos:definition "Pre-Colombian pottery style associated with Huari in the Nazca Valleys during the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Viñaque"@en .

aat:300108174 a skos:Concept ;
    skos:definition "Pottery styles belonging to Diaguita cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diaguita pottery styles"@en .

aat:300108180 a skos:Concept ;
    skos:definition "Periods related to Pre-Columbian Argentine cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Argentine periods"@en .

aat:300108181 a skos:Concept ;
    skos:definition "Refers to the movement among American Pictorialist photographers lead by Alfred Stieglizt in New York in 1902 with the objective of promoting photography as a valid and refined artistic medium. The style sought to elevate the status of fine photographic printing through the use of gum bichromate or platinum prints to emulate paint, pastel or other traditional media and with the emphasis on soft focus, composition, and texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Photo-Secession"@en .

aat:300108188 a skos:Concept ;
    skos:definition "Refers to the English architectural and decorative style in the mid-17th century. Developed by artisans through the use of pattern books, it is characterized by a rough Classicism that reflects regional differences and the work of individual workshops. Architectural elements include hipped roofs, broken pediments, and lugged architraves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Artisan Mannerist"@en .

aat:300108204 a skos:Concept ;
    skos:definition "Refers to the style in late-19th-century architecture in which Queen Anne and vernacular styles mixed freely with Classical and Gothic elements often producing less rigid, asymmetrical, and complex plans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Free Style"@en .

aat:300108215 a skos:Concept ;
    skos:definition "Refers to the movement and style in 19th century America centered around the desire to understand nature through a realistic and detailed rendering of light and atmosphere in painting. The style features great sense of interior depth and depiction of magical aura through careful, invisible brushstrokes. The movement is thought to be inspired by the rise of photography and by the literary philosophies of Ralph Waldo Emerson (1803-1882) who advocated a meditative, pantheistic communion with nature and the landscape. Later, the style was superceded by the techniques of Impressionism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luminist"@en .

aat:300108235 a skos:Concept ;
    skos:definition "Land portions of estates kept in possession by the owner for personal use or the use of servants; manorial land not granted out or held by tenants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demesnes"@en .

aat:300108265 a skos:Concept ;
    skos:definition "Cavities in the earth resulting from removal of soil and rock for purposes of building construction or archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excavations"@en .

aat:300108270 a skos:Concept ;
    skos:definition "Refers to the style and movement heavily influenced by the Suprematist school, featuring textured, monochrome compositions and geometric divisions of canvas space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unist"@en .

aat:300108287 a skos:Concept ;
    skos:definition "Formal gardens that emphasize large, open spaces with wall-like hedges, and enclosed garden rooms. French gardens also emphasize elements found in Italian gardens, such as elaborate fountain design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French gardens"@en .

aat:300108307 a skos:Concept ;
    skos:definition "Structures that enclose fountains, most often leaving one side or section open for viewing. These may be simple columned porches or more elaborate structures and usually include sculptural elements. The term is most often applied to such structures in classical Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fountain-houses"@en .

aat:300108310 a skos:Concept ;
    skos:definition "Refers to the style of painting seen from the 1950s until the 1970s, and characterized by thick, crusted paint and the incorporation of discarded materials such as charred wood, cinders, and sacking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Matter art"@en .

aat:300108326 a skos:Concept ;
    skos:definition "Structures built for the drying, baling, and storing of hops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hop barns"@en .

aat:300108349 a skos:Concept ;
    skos:definition "Designates certain Central and South African village compounds and their cattle enclosures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kraals"@en .

aat:300108354 a skos:Concept ;
    skos:definition "Freestanding structures with a single-pitched roof leaning against two posts or trees. For similarly roofed minor structures built against the side of buildings use \"appentices.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lean-tos"@en .

aat:300108361 a skos:Concept ;
    skos:definition "Buildings that physically illustrate their name or function in their plan or elevation, for example a dairy stand shaped like a milk bottle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mimetic buildings"@en .

aat:300108367 a skos:Concept ;
    skos:definition "Grave shrines used in Ancient Greece, which may frame individual statues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naiskoi"@en .

aat:300108377 a skos:Concept ;
    skos:definition "A parish church is the principal church of a parish, serving the needs of religious administrative districts called \"parishes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parish churches"@en .

aat:300108395 a skos:Concept ;
    skos:definition "Hotels that are on, or adjoining, a railway station."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railway hotels"@en .

aat:300108407 a skos:Concept ;
    skos:definition "Distinguished from \"wild animal parks\" by the lack of restrictions on animal movement and by the mingling of animals and the visiting public, who generally drive through the parks in their own vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safari parks"@en .

aat:300108449 a skos:Concept ;
    skos:definition "Oblong enclosures curved at one end and built for horse and chariot racing, usage is typically restricted to such structures in Greek cities of the Hellenistic, Roman, and Byzantine eras; meaning overlaps with similar structures in ancient Rome itself, \"circuses (Roman arenas).\" For sports structures used for horse racing in more modern contexts, use \"horse racetracks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hippodromes"@en .

aat:300108466 a skos:Concept ;
    skos:definition "Use only to denote the Spanish-speaking quarters of cities or towns especially in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrios"@en .

aat:300108469 a skos:Concept ;
    skos:definition "Sections of towns or cities in which Chinese immigrants originally lived as a colony and to great extent followed their own customs; often, but not exclusively sea ports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinatowns"@en .

aat:300108565 a skos:Concept ;
    skos:definition "Styles and cultures belonging to Africa under colonial, usually European, rule or influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial African"@en .

aat:300108572 a skos:Concept ;
    skos:definition "Sculpture styles belonging to African cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African sculpture styles"@en .

aat:300108579 a skos:Concept ;
    skos:definition "Periods related to Karanga cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karanga periods"@en .

aat:300108683 a skos:Concept ;
    skos:definition "Official or approved style, as of art, architecture, or costume, established at a ruler's court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court style"@en .

aat:300108693 a skos:Concept ;
    skos:definition "Toilets that are not connected to a sewage system, and which have a compartment in which waste is treated with a chemical solution for temporary storage, and for deodorization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical toilets"@en .

aat:300108926 a skos:Concept ;
    skos:definition "Buttresses set back slightly from the corners of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setback buttresses"@en .

aat:300109010 a skos:Concept ;
    skos:definition "Refers to the loosely-organized movement in the 1920s characterized by subtle, quiet detachment and dedicated to the depiction of sharply defined forms such as the urban or rural skyline, the industrial landscape of buildings and machinery, or the bucolic landscapes of barns and fields. Artists in this style include Charles Demuth, Preston Dickinson, and Charles Sheeler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Precisionist"@en .

aat:300109697 a skos:Concept ;
    skos:definition "People who are afflicted that an illness or disease so serious that there is no chance of recovery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terminally ill"@en .

aat:300109700 a skos:Concept ;
    skos:definition "Continuous roof covering of laminations or piles of saturated or coated felt, alternated with layers of bitumen and surfaced with mineral aggregate or asphaltic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "built-up roofing"@en .

aat:300109703 a skos:Concept ;
    skos:definition "Activity of engaging the services of a person or persons for wages or other payment. For the ongoing activity of providing individuals with and paying them for work, use \"employing.\" For the concept of the degree or extent of the provision or availability of paid work to the population, use \"employment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hiring"@en .

aat:300109707 a skos:Concept ;
    skos:definition "Ornamental screens in churches which either support an organ, or separate an organ chamber from the main space of the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ screens"@en .

aat:300109710 a skos:Concept ;
    skos:definition "Closed chambers used to distribute or collect warmed or cooled air in forced air heating or cooling systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plenum chambers"@en .

aat:300109733 a skos:Concept ;
    skos:definition "Records of established forms or methods for conducting the affairs of a business, legislative body, or court of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "procedures"@en .

aat:300109737 a skos:Concept ;
    skos:definition "Those contracts in which a builder agrees to complete the work of building and installation to the point of readiness for occupancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turnkey contracts"@en .

aat:300109740 a skos:Concept ;
    skos:definition "Ornamental features, usually in relief and triangular in form, resembling pediments and located over doors or windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronets"@en .

aat:300109756 a skos:Concept ;
    skos:definition "The process of furnishing a building or other object with new parts or equipment not available at the time of its manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retrofitting"@en .

aat:300109915 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that developed during the Heian period (794-1185). The style is characterized by a type of shrine in which two buildings are directly connected so the roofs touch along the eaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hachiman"@en .

aat:300109917 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that was developed during the Nara (710-794) and Heian (794-1185) periods. The style is characterized by a type of shrine with a pent roof added to the gable end that extends over a flight of stairs leading to its doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kasuga"@en .

aat:300109920 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that developed during the Nara (710-794) and Heian periods (794-1185). The style is characterized by a type of shrine that is small in size and constructed in a two-bay by three-bay system upon a earthen mound. The roof or canopy sweeps down on the long side of the building, covering the stairs and providing shelter for worshippers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nagare"@en .

aat:300109922 a skos:Concept ;
    skos:definition "Refers to the style of Japanese residential architecture used mainly for palatial mansions of the aristocracy, reaching it's peak in the Hein Perion (794-1185). The name is derived fron the shiden, or main hall, that is constructed in the center of a lot facing south. To the east, west and north are gabled pavllions or annexes connected by covered, paved passageways and surrounding an elaboarte landscape garden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shinden"@en .

aat:300109924 a skos:Concept ;
    skos:definition "Refers to the style of Japanese residential architecture used in mansions of the military and temple guest halls during the Momoyama (1568-1600) and Edo (1600-1868) periods. Forming the basis of today's traditonal-style Japanese house, the style is characterized by a covered entrance arcade, a broad southern veranda, louvered doors with latticed paper screens, and floors covered with woven mats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shoin"@en .

aat:300109926 a skos:Concept ;
    skos:definition "Refers to the style of Kutani porcelain manufactured in the 17th century and painted with rich enamels on a red-patterned ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ko Kutani"@en .

aat:300109930 a skos:Concept ;
    skos:definition "Refers to the style of Kutani porcelain manufactured in the 19th century and typically painted with red and gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saiko Kutani"@en .

aat:300110005 a skos:Concept ;
    skos:definition "Roofs having trusses rather than rafters, and beams or purlins, meaning the frame comprises a triangle-based webbing having the function to support the roof and tie the outside walls. Truss roofs may be wood or steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss and beam roofs"@en .

aat:300110008 a skos:Concept ;
    skos:definition "Roofs having rafters as framing; rafters are very long planks that incline from a point along a central ridge beam and meet in an intersection with the outer walls, in stick framing.The function of the long planks is to hold up the roofing frame as well as the roof sheathing. Compare to \"truss and beam roofs,\" which use triangular forms as further support for the roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rafter roofs"@en .

aat:300110170 a skos:Concept ;
    skos:definition "Period, cultures, and styles typical of the Paleolithic era in Egypt, associated with the first use of chipped stone tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian Paleolithic"@en .

aat:300110171 a skos:Concept ;
    skos:definition "Refers to the Paleolithic period in Egypt from about 12,000 to 10,000 BCE. The period is characterized by flint tools of the Levallois type which were transformed into a microlithic flint industry later in the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sebilian"@en .

aat:300110281 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters, originating in the 9th century and surviving into the 15th century. One of the earliest and longest lived, the school played a central role in transforming the style imported from China during the 7th and 8th century, into the classical Hein period style known as \"Yamato-e.\" Founded by Kose No Kanaoka, the style evolved from typical Chinese subject matter such as Confusius, to more secular Japanese images, such as animals and landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kose School"@en .

aat:300110922 a skos:Concept ;
    skos:definition "Refers to the style of sculpture named after a mid-7th century statue of the Buddhist goddess of mercy in the Chuguji nunnery. The style is characterized by figures with rounded, pronounced modelling and soft, supple drapery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chuguji"@en .

aat:300111002 a skos:Concept ;
    skos:definition "A subtype of the Spanish Colonial Revival architecture style, characterized by simplicity of form and ornamentation. Use \"Mission\" for the late 19th-century, early 20th-century American decorative arts style, applied principally to furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mission Style"@en .

aat:300111088 a skos:Concept ;
    skos:definition "Diagonal braces connecting posts and tie beams or rafters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spurs"@en .

aat:300111149 a skos:Concept ;
    skos:definition "Used to describe styles of the regions of Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European regions"@en .

aat:300111150 a skos:Concept ;
    skos:definition "Refers to the culture of Albania, either the modern nation in the western part of the Balkan peninsula, or the ancient province of Albania on the Caspian Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albanian"@en .

aat:300111153 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Austria, or of the culture in central Europe in the area comprising modern Austria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austrian"@en .

aat:300111156 a skos:Concept ;
    skos:definition "Refers to the culture of Belgium, usually the modern nation established in 1830 and defined as the Netherlandish provinces watered by the Meuse and Scheldt rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgian"@en .

aat:300111159 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of the United Kingdom. It also refers to the cultures of historical nations that had Great Britain as the central ruling power. For the culture of the ancient Britons, who were those tribes that spoke the Celtic (Brythonic) language, use \"Ancient British.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British"@en .

aat:300111163 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Bulgaria, or in general to cultures that have occupied the area of modern Bulgaria in the Balkans in modern history. For the culture of the ancient Bulgars, use \"Bulgar.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bulgarian"@en .

aat:300111166 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of the Czech Republic, or in general to cultures that have occupied the area of the modern nation in central Europe. It is also used to refer broadly to the culture of the Bohemian people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Czech"@en .

aat:300111169 a skos:Concept ;
    skos:definition "Refers to the modern or historical cultures of the region of Scandinavia, which is the historic land of the Norseman in northern Europe, comprising the areas of the modern nations of Denmark, Norway, and Sweden, and sometimes understood to extend to the territory of modern Finland and Iceland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scandinavian"@en .

aat:300111172 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Denmark, or in general to the cultures that have occupied the area of northwestern Europe, north of Germany. It is often used to refer specifically to the cultures of the historic Danes, a Scandinavian branch of the Teutons. It is also sometimes used to refer to the culture of all Scandinavians who invaded England from the 9th century to the 11th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Danish"@en .

aat:300111175 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of the Netherlands, or in general to cultures that have occupied the same area in northwestern Europe along the North Sea. It is often used to distinguish the culture of the northern historic Netherlands from \"Flemish,\" which is the culture of the southern Netherlands or Flanders. It may also be used to refer in general to the culture of Germanic or Teutonic peoples; however, this meaning is seldom found in modern texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch"@en .

aat:300111178 a skos:Concept ;
    skos:definition "Refers to the culture of the modern country of England, or in general to cultures that have occupied the southern part of the island of Great Britain, usually excluding Wales. It may refer to the the culture of the Angles, one of the Teutonic peoples who settled in Britain in fifth century CE. The term is occasionally used to refer to the culture of the entire nation of the United Kingdom, although technically England is an administrative subdivision of the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English"@en .

aat:300111181 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Finland, or in general to cultures that have occupied the area of northern Europe, south of Norway and east of the Gulf of Bothnia. It may also be used to refer specifically to the culture of the historical Finns, who are generally understood to have been the Suomi or Suomelaisset and who spoke a language of the Ural-Altaic class. It may also refer more widely to the cultures of other peoples closely allied ethnically and linguistically to the Suomi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Finnish"@en .

aat:300111184 a skos:Concept ;
    skos:definition "Refers to the culture of the southern Netherlands, roughly corresponding to modern Belgium, Luxembourg, and part of France, particularly during the historical period when Flanders was an independent principality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flemish"@en .

aat:300111188 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of France, or in general to cultures that have occupied the area of the modern nation in western Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French"@en .

aat:300111192 a skos:Concept ;
    skos:definition "Refers to the cultures, periods, and styles of the modern nation of Germany, or the cultures that have occupied the area of the modern nation in central Europe. More broadly, it can refer to the cultures of the ancient groups of related peoples who inhabited central and northern Europe, and who spoke dialects from which the Germanic or Teutonic languages developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German"@en .

aat:300111195 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Hungary, or in general to the cultures that have occupied the area of modern Hungary in central Europe. More broadly, it may refer to the culture of the Magyars, a Finno-Ugric people who settled in the middle basin of the Danube River in the late ninth century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hungarian"@en .

aat:300111198 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Italy, or in general to cultures that have occupied the boot-shaped Italian peninsula in the Mediterranean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian"@en .

aat:300111201 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Norway, or in general to the cultures that have occupied the western part of the Scandinavian peninsula in northwestern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norwegian"@en .

aat:300111204 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Poland, or in general to the cultures that have occupied the same area in central Europe south of the Baltic Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polish"@en .

aat:300111207 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Portugal, or in general to the cultures that have occupied the same area in the western part of the Iberian Peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portuguese"@en .

aat:300111210 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Romania, or in general to the cultures that have occupied the same area of southeastern Europe west of the Black Sea. It is occasionally also used to refer to the culture of the Romany or gypsies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romanian"@en .

aat:300111212 a skos:Concept ;
    skos:definition "Refers to the culture of the modern country of Scotland, or in general to cultures that have occupied the northern part of the island of Great Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scottish"@en .

aat:300111215 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Spain, or in general to the cultures that developed on the Iberian Peninsula in southwestern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish"@en .

aat:300111218 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Sweden, or in general to cultures that have occupied the area of the eastern section of the Scandinavian peninsula in northwestern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swedish"@en .

aat:300111221 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Switzerland, or in general to cultures that have occupied the Alpine region of northwestern Europe, north of Italy and west of Austria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swiss"@en .

aat:300111224 a skos:Concept ;
    skos:definition "Refers to a style of porcelain and interior decoration that developed at the Schloss Sankt Emmeram, which was the Thurn and Taxis palace in Regensburg, Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Regensburg"@en .

aat:300111225 a skos:Concept ;
    skos:definition "Refers to the culture of the modern principality of Wales, or in general to the cultures that have occupied the wide peninisula on the western part of the island of Great Britain. The term formerly referred specifically to the native British population of England in contrast to the Anglo-Saxons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Welsh"@en .

aat:300111228 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Yugoslavia, or to the culture of the nation of the same name that existed from 1918 to 1992 and had a larger area. It may also refer generally to the culture of the various groups of southern Slavs, including the Serbs, Croats, and Slovenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yugoslav"@en .

aat:300111241 a skos:Concept ;
    skos:definition "Refers to the style and culture of the nomadic peoples of the Syro-Arabian desert during the later Greek and Roman periods. Also used for Muslims who remained in Spain after it had been again conquered by Christians at the time of the Crusades. Although the term in older texts is also used to refer generally to Islamic art and architecture, this is considered undesirable to modern sensibilities, due to the negative connotation. For the style and culture of Muslim lands use \"Islamic (style and culture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saracenic"@en .

aat:300111259 a skos:Concept ;
    skos:definition "Refers to the culture of the island of Ireland, which is located west of England on the Irish Sea and is currently divided administratively between the Republic of Ireland and Northern Ireland. It often refers specifically to the Celtic culture of the island of Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irish"@en .

aat:300111264 a skos:Concept ;
    skos:definition "Footings that are slabs under two or more columns or columns and a wall, one of which is internal rather than on the perimeter so that the footing cannot take a beamlike form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combined footings"@en .

aat:300111271 a skos:Concept ;
    skos:definition "Footings that support a wall or a number of columns in a line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous footings"@en .

aat:300111276 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Russia, or to the cultures that have occupied the principal lands of historic Russia in eastern Europe and northern and western Asia. It may also be used to refer to the larger group of cultures controlled by the historic Soviet Union."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian"@en .

aat:300111307 a skos:Concept ;
    skos:definition "Use with reference to the period c.1250 to as late as 1500 where the terms \"Gothic (Medieval)\" or \"Late Gothic\" are not appropriate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Medieval"@en .

aat:300111457 a skos:Concept ;
    skos:definition "Ceramics styles belonging to modern European cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern European ceramics styles"@en .

aat:300111540 a skos:Concept ;
    skos:definition "Refers broadly to the arts of the last two decades of the 19th century. The period is characterized by its artistic and literary spirit of jaded sophistication and self-conscious aestheticism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fin de siècle"@en .

aat:300111542 a skos:Concept ;
    skos:definition "Refers to illnesses and ailments that seem to be induced in occupants of a building by conditions inside the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sick building syndrome"@en .

aat:300111544 a skos:Concept ;
    skos:definition "Tools powered by the compression or exhaustion of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pneumatic tools"@en .

aat:300111546 a skos:Concept ;
    skos:definition "Describes the practice of coordinating the physical workplace with the workflow of an organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facility management"@en .

aat:300111551 a skos:Concept ;
    skos:definition "Used to designate vegetable gardens cultivated to increase food production during the Second World War, especially in England and America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "victory gardens"@en .

aat:300111554 a skos:Concept ;
    skos:definition "Refers generally to houses seeming to be inhabited by ghosts or other apparitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haunted houses"@en .

aat:300111557 a skos:Concept ;
    skos:definition "Refers to a trend among the German architectural avant-garde of the mid-1920s, that promoted data and practical functionalism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neues Bauen"@en .

aat:300111559 a skos:Concept ;
    skos:definition "Use with reference to the 19th-century movement in photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pictorialist"@en .

aat:300111580 a skos:Concept ;
    skos:definition "Describes the works of the groups of German and Austrian artists who rebeled against the Salon system and exhibited independently at the end of the 19th century. The exhibition of art and concerns about the art market formed the basis of the movement. The artists involved were not commited to a particular style but works tend to be lyrical, focus on nature, and avoid modern themes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Secession Movement"@en .

aat:300111588 a skos:Concept ;
    skos:definition "Seeking out and enlisting people for an enterprise, usually for a stated period of time, on either a paid or volunteer basis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recruiting"@en .

aat:300111602 a skos:Concept ;
    skos:definition "The making of components, usually standardized and factory-made, that are later assembled during the construction of an object or structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prefabrication"@en .

aat:300111604 a skos:Concept ;
    skos:definition "Describes construction that utilizes prefabricated units, based on the combination of similar subcomponents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modular construction"@en .

aat:300111605 a skos:Concept ;
    skos:definition "Refers to the works of art associated with the aesthic doctrines developed by Argentine-Italian artist Lucio Fontana (1899-1968). The style is characterized by a desire to end the separation of architcture, painting and sculpture by synthesizing elements such as color, sound, space, motion and time into a new kind of total art. Notable are Fontana's canvases with have holes or slits, that cast shadows upon the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spatialist"@en .

aat:300111612 a skos:Concept ;
    skos:definition "Method of construction that prevents or retards the passage of hot gases or flames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire-resistive construction"@en .

aat:300111619 a skos:Concept ;
    skos:definition "Types of construction using a wooden frame; in the field of insurance, buildings for which walls, partitions, floors, and roof are wholly or partly made of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame construction"@en .

aat:300111636 a skos:Concept ;
    skos:definition "Type of boat, aircraft, or other construction in which the shell carries most of the stresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monocoque construction"@en .

aat:300111640 a skos:Concept ;
    skos:definition "Construction utilizing various different building materials and for the use of more than one type of construction method in a structure, such as a masonry building with a laminated wood beam roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite construction"@en .

aat:300111645 a skos:Concept ;
    skos:definition "Construction in which a thin material on the exterior surface of a building is utilized to carry loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stressed-skin construction"@en .

aat:300111648 a skos:Concept ;
    skos:definition "Consists of two thin, dense, strong, and hard facing layers of plastic, metal, or wood bonded with adhesives to a core of lightweight material to form a panel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich construction"@en .

aat:300111652 a skos:Concept ;
    skos:definition "Construction which is strong enough to resist bombs or shelling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombproof construction"@en .

aat:300111664 a skos:Concept ;
    skos:definition "Solvent that has been treated or mixed with oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxygenated solvent"@en .

aat:300111665 a skos:Concept ;
    skos:definition "Solvent that contains a hydrogen and carbon compound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrocarbon solvent"@en .

aat:300111669 a skos:Concept ;
    skos:definition "Nonpolar hydrocarbon solvent, used in the production of corn oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hexane"@en .

aat:300111672 a skos:Concept ;
    skos:definition "A colorless volatile highly flammable liquid that is obtained from petroleum and used as an anesthetic, a solvent, and in determining octane ratings. It is a constituent hydrocarbon of gasoline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heptane"@en .

aat:300111817 a skos:Concept ;
    skos:definition "Refers to the work of a school of artists who re-established the literati tradition in painting in China during the late 15th and early 16th centuries. The style is characterized by balanced, harmonious landscape compositions, with an emphasis on sinuous lines and flattened space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wu"@en .

aat:300111871 a skos:Concept ;
    skos:definition "Rooms provided for eating meals, particularly at a work place, school, or other such establishment where many people spend the day away from home; the the food is often brought from elsewhere, but prepared food may also be offered for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunchrooms"@en .

aat:300111885 a skos:Concept ;
    skos:definition "Slides, especially found in apartment blocks or offices, where mail is sent to a main repository."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail chutes"@en .

aat:300111912 a skos:Concept ;
    skos:definition "Styles belonging to Northern European Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern European Medieval styles"@en .

aat:300111915 a skos:Concept ;
    skos:definition "Styles belonging to Southern European Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern European Medieval styles"@en .

aat:300111951 a skos:Concept ;
    skos:definition "Pottery styles belonging to Pre-Columbian Panamanian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Panamanian pottery styles"@en .

aat:300111961 a skos:Concept ;
    skos:definition "Basins or bowls containing holy water at the entrance of a church. The font may be of various forms, either built into the wall, standing on a pedestal, or as a bucket hanging from a fixture. Often richly decorated, they are typically used by worshippers to cross themselves upon entering and exiting the church. The holy water font evolved from the fountain for ablutions that was placed in the center of the atrium of the early Christian basilica, and is still placed there in Eastern rites. Before entering the church, worshippers washed their hands and feet in accordance with a rite derived from Judaism. When the atrium of the Christian basilica was reduced to the proportions of a narrow court or a simple porch, the fountain gave way to a smaller structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy water stoups"@en .

aat:300111981 a skos:Concept ;
    skos:definition "Refers to the condition of being impervious to air penetration, or nearly so."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airtightness"@en .

aat:300111985 a skos:Concept ;
    skos:definition "Activity of making something beautiful or repairing or enhancing its appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beautification"@en .

aat:300111987 a skos:Concept ;
    skos:definition "The quality or state of being secure against wind and rain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weathertightness"@en .

aat:300111990 a skos:Concept ;
    skos:definition "An alignment of at least five neolithic sites in less than ten miles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leys"@en .

aat:300111999 a skos:Concept ;
    skos:definition "Documents distributed to the public by sale or other transfer of ownership, or by rental, lease, or lending."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publications"@en .

aat:300112003 a skos:Concept ;
    skos:definition "Sheets torn from a publication, usually to send as proof of insertion to an advertiser whose advertisement appears on it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tear sheets"@en .

aat:300112007 a skos:Concept ;
    skos:definition "Exhibitions which inform professionals on trends in garden architecture, and which feature collections of exotic plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden shows"@en .

aat:300112013 a skos:Concept ;
    skos:definition "Reformers who advocate the abolition of a custom or institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abolitionists"@en .

aat:300112017 a skos:Concept ;
    skos:definition "Those who establish or originate things such as cultures, movements, institutions, or communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "founders"@en .

aat:300112020 a skos:Concept ;
    skos:definition "Clubs which promote civic beautification, conservation, and historic preservation. Historically organized by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden clubs"@en .

aat:300112028 a skos:Concept ;
    skos:definition "Those who study family history and ancestry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genealogists"@en .

aat:300112031 a skos:Concept ;
    skos:definition "People who practice the art and science of horticulture, or the cultivation and growing of gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horticulturists"@en .

aat:300112034 a skos:Concept ;
    skos:definition "Those trained or occupied in natural history, especially those who study animals and plants in their natural setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naturalists"@en .

aat:300112039 a skos:Concept ;
    skos:definition "Persons who own or direct plant nurseries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nurserymen"@en .

aat:300112048 a skos:Concept ;
    skos:definition "Refers to a style of architecture dependent on exposed rough concrete as structural form, particularly dating to the 1960s and 1970s, but which is allied to the late works of Le Corbusier, which itself was characterized by raw concrete and undisguised functional features. The term originated from the French béton brut, or 'raw concrete.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brutalist"@en .

aat:300112061 a skos:Concept ;
    skos:definition "Refers to the term applied to the work of Abstract Expressionist painters such as Jackson Pollock and Willem de Kooning. The style is characterized by the use of impulsive and energentic brushstrokes that reflect the artist's psycological state, and by an emphasis on the work being an arena in which to perform the act of painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Action painting"@en .

aat:300112063 a skos:Concept ;
    skos:definition "Refers to certain Abstract Expressionist paintings. Use \"Color-field\" to encompass Abstract Imagist painting and the works of the 1960s derived from it, and \"Action painting\" for more spontaneous, gestural works of this era and genre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abstract Imagist"@en .

aat:300112069 a skos:Concept ;
    skos:definition "Refers to the two central columns in a range, when more widely spaced than the columns to either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "median columns"@en .

aat:300112086 a skos:Concept ;
    skos:definition "Supply outlets for drawing water from mains or service pipes and usually located along streets and used for firefighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire hydrants"@en .

aat:300112105 a skos:Concept ;
    skos:definition "Use with reference to mostly French art of the 1960s that is realist in the sense of appropriating materials from the environment or staging actions or happenings. This movement was announced by the publication of a short manifesto in Paris, 1960; authored by Pierre Restany, and signed by the artists Arman, François Dufrêne, Raymond Hains, Yves Klein, Martial Raysse, Daniel Spoerri, Jean Tinguely and Jacques de la Villeglé."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nouveau Réalisme"@en .

aat:300112128 a skos:Concept ;
    skos:definition "Persons who first enter or settle a region, thus opening it for occupation and development by others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pioneers"@en .

aat:300112185 a skos:Concept ;
    skos:definition "Domestic structures with separate dwelling units for two individual families placed one above the other. When the units are placed side by side use \"double houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duplex houses"@en .

aat:300112289 a skos:Concept ;
    skos:definition "Use to describe projects or buildings when there is a highly site-intensive mixture of several different, major, revenue-producing functions involved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed use"@en .

aat:300112347 a skos:Concept ;
    skos:definition "Congregations of people at a stated time and place for the purpose of private buying and selling, usually not by auction. For exhibitions in which different exhibitors participate to publicize and promote their products, services, or activities, sometimes though not necessarily involving buying and selling, use \"fairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "markets"@en .

aat:300112407 a skos:Concept ;
    skos:definition "Refers to the philosophical and literary movement associated with the writing of French scholar Jacques Derrida in the 1960s and later applied to the visual arts and architecture in the 1980s. The movement advocates undermining the dominant component in established binary structures, such as nature vs culture, in order to arrive at a new dialectic. In architecture, the style is charcterized by a purposeful displacement of structural elements, resulting in buildings with no specific purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Deconstructivist"@en .

aat:300112426 a skos:Concept ;
    skos:definition "Designating works which are in an early or undeveloped Baroque style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Baroque"@en .

aat:300112462 a skos:Concept ;
    skos:definition "Refers to the work of a group of artists that was formed in Germany in1949. Rejecting Nazi artistic ideals, the style is typically characterized by simple, un-idealized portraits and landscapes showing the destruction in Germany during World War II."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neue Rheinische Sezession"@en .

aat:300112469 a skos:Concept ;
    skos:definition "Refers to the French style in architecture and decorative arts during the Second Empire from 1852 to 1871 and characterized by polychromy and decorative motifs such as griffins, masks, lotus buds, and the Greek fret pattern. An eclectic form of Neoclassicism, it was inspired by Greece, Rome, Egypt, and archaeological discoveries in Pompeii as well as the Adam and Louis XVI styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Néo-Grec"@en .

aat:300112472 a skos:Concept ;
    skos:definition "Refers to the style of Spanish architecture, painting, and decoration associated with the reign of Isabella I during the end of the 15th century and concentrated in central Spain, which reflects a combination of the decorative Mudéjar style and more realist Netherlandish forms. The style is closely related to the Manueline style in Portugal and overlaps significantly with the Isabelline style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hispano-Flemish"@en .

aat:300112476 a skos:Concept ;
    skos:definition "Architecture styles belonging to British Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Renaissance-Baroque architecture styles"@en .

aat:300112477 a skos:Concept ;
    skos:definition "Vase painting style which became popular from ca. 670-ca. 630 BCE, known as the Middle Proto-Attic period. Vase painting style which became popular from ca. 670-ca. 630 BCE, known as the Middle Proto-Attic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black and White Style"@en .

aat:300112480 a skos:Concept ;
    skos:definition "Spaces or containers for a casket in a burial site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaults"@en .

aat:300112569 a skos:Concept ;
    skos:definition "Pottery styles belonging to British Isles Medieval cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Isles Medieval pottery styles"@en .

aat:300112572 a skos:Concept ;
    skos:definition "Regional styles belonging to Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance-Baroque regional styles"@en .

aat:300112718 a skos:Concept ;
    skos:definition "Art in which the process of destruction of objects or materials within the work is regarded as the work, and especially work created in the 1960s related to a movement founded by Gustav Metzger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Auto-destructive art"@en .

aat:300112743 a skos:Concept ;
    skos:definition "Refers to the art and cultural movement of the mid- to late 1960s that was international in scope, but flourished mainly on the American West Coast. The movement advocated the exploration of the subconscious mind through drugs, sensory deprivation, and a total immersion of the senses through music and light shows. In the visual arts, the style is characterized by obsessively detailed images, ambiguous representations of space, and acidic colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Psychedelic"@en .

aat:300112822 a skos:Concept ;
    skos:definition "Design movement which emerged in Italy, in the 1960s and 1970s. The movement was in opposition to functionalist design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuovo Design"@en .

aat:300112839 a skos:Concept ;
    skos:definition "Use with reference to abstract paintings of the 1960s and 1970s that repeat or vary a motif from work to work or within a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Systemic"@en .

aat:300112846 a skos:Concept ;
    skos:definition "Post-1945 art movement building upon some of the aesthetic principles of Constructivism. Began in Russia, organized by Lev Nusberg (born 1937), Francisco Infante (born 1943) and Vyacheslav Koleychuk (born 1941)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Constructivist"@en .

aat:300112920 a skos:Concept ;
    skos:definition "Study of the history of a particular word or element of a word, or of historical linguistic change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etymology"@en .

aat:300112974 a skos:Concept ;
    skos:definition "Style and culture of the area of Khaydarabad and Tepe, Afghanistan, Central Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khaydarabad-Tepe"@en .

aat:300112975 a skos:Concept ;
    skos:definition "A style and culture of Greco-Bactrian Central Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kukhn-Kala"@en .

aat:300112980 a skos:Concept ;
    skos:definition "Culture and style related to Kuva (Quva), now in Uzbekistan, which was a medieval hub of culture and art. Style is particularly associated with pottery, jewelry, and metalwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuva"@en .

aat:300112992 a skos:Concept ;
    skos:definition "Style and culture of a people originally of Iranian stock, closely related to the Scythians. The Sarmatians migrated from Central Asia to the Ural Mountains between the 6th and 4th century BCE and eventually settled in most of southern European Russia and the eastern Balkans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarmatian"@en .

aat:300113018 a skos:Concept ;
    skos:definition "Refers to the style of sculpture that flourished during the 7th century, its name derived from the statue known as the Kudara Kannon, said to have been taken from the old state of Paikche, Korea. The style is characterized by slender, flowing lines, sharp drapery folds, and an emphasis on the side view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kudara Kannon"@en .

aat:300113090 a skos:Concept ;
    skos:definition "Refers to the Eneolithic culture established in the Minusinsk Basin between the 1st century BCE and the 5th century CE. Notable artifacts from the period include examples of the Scynthian-Siberian Animal style on bronze and gold, and clay funeral masks portraying faces with a two-color decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tashtyk"@en .

aat:300113163 a skos:Concept ;
    skos:definition "Pottery styles belonging to Fatimid cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fatimid pottery styles"@en .

aat:300113164 a skos:Concept ;
    skos:definition "Refers to a pottery style that flourished in Fostat (Old Cairo) during the Fatimid period. Fragments from the earlier Tulunid period prove that the technique of luster painting was introduced at this time in close association with Samarra ware to Fostat workshops. Nuances in the luster are seen in the wares made during the Fatimid period, although each piece only has one luster. The decorative motifs become more rich and varied as well and, as they are drawn from many different cultures, demonstrate that Fatimid Egypt was open to influences from all over the Mediterranean and beyond. Animals in scrolls, fish, birds, and good luck inscriptions in decorative Kufic are popular; fantastic animals and human figures are also favored just as are more schematic motifs such as heart palmettes. Some of the animals depicted have been interpreted as lunar, solar or astrological symbols. No tiles, only vessels, were made in Egypt. Fostat lusterware seems to have stopped being made in the Mamluk period when potters favored relief decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fostat"@en .

aat:300113171 a skos:Concept ;
    skos:definition "Commissions which are in charge of maintaining local parks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "park commissions"@en .

aat:300113278 a skos:Concept ;
    skos:definition "Self-contained residential communities which provide extensive services for the complete daily needs of residents, including dining, medical, recreation, entertainment and, possibly, estate care facilities. Distinguished from \"continuing care retirement communities\" by normally requiring a one-time up-front fee instead of monthly charges, which may be variable over the duration of the residency. For similar facilities for retired people in which the services offered are less comprehensive, use \"retirement communities.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life care communities"@en .

aat:300113285 a skos:Concept ;
    skos:definition "Documents concerning the real or personal property of a person or group of persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estate records"@en .

aat:300113288 a skos:Concept ;
    skos:definition "Refers generally to any and all personnel employed by a government at any level of jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "government employees"@en .

aat:300113355 a skos:Concept ;
    skos:definition "Immense, open praying areas with nothing but a qibla wall with a mihrab and an open air pulpit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idgahs"@en .

aat:300113388 a skos:Concept ;
    skos:definition "Self-propelled, nonrevenue rail vehicles designed to convert electrical or mechanical energy into tractive effort to haul railway cars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locomotives"@en .

aat:300113515 a skos:Concept ;
    skos:definition "Refers to the syle of Shinto architecture that developed during the Heian period (794-1185), originally called the Ishinoma style. The style is characterized by a type of shrine in which two buildings are joined together by an intervening space that is paved and covered by a gable roof. The style became popular for mausoleums during the Kamakura period (1185-1333), and was later referred to as the Gongen style during the Edo period (1615-1868)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gongen"@en .

aat:300113518 a skos:Concept ;
    skos:definition "The style and culture of the Uzbek khanate, refering to any of the three states that ruled Transoxania, in present-day Uzbekistan, before it came under Russian rule in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uzbek"@en .

aat:300113519 a skos:Concept ;
    skos:definition "Pottery style first made in near Kuwana and later Tokyo, Japan, characterized by a pale yellow milky glaze and decorated with a three-color design mostly of red, green and blue or purple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banko"@en .

aat:300113530 a skos:Concept ;
    skos:definition "Refers to the style of ink painting which literally means \"break ink,\" based on contrasts of tonal washes and darker washes, dots or lines. First refered to in Chinese texts in 847 CE, the style first appeared in Japan in the 14th century, continuing through the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haboku"@en .

aat:300113534 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters active in Nagasaki from the 17th century through the 19th century. Nagasaki was the only port open to foreigners during the Edo period (1600-1868), and consequently Nagasaki artists painted foreign subjects such as Dutch and Chinese residents of the city, often borrowing European or Chinese stylistic innovations. The style is evident in four main types: woodblock prints; official portraits painted by government artists; Chinese-inspired bird and flower paintings; and individualist work that often employed Western techniques of shading and perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nagasaki"@en .

aat:300113550 a skos:Concept ;
    skos:definition "The name given to naive narrative paintings of folk tales and religious subjects presented in illustrated books and scrolls that emerged in 16th century Japan. These are considered a popularized version of the Tosa style, and are characterized by a simplicity and a lack of illusionistic rendering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nara-e"@en .

aat:300113552 a skos:Concept ;
    skos:definition "Refers to the style of folk painting that developed in Okiwake from the Kan'ei era (1624-44). Popular with pilgrims to the nearby temple of Midera and other travellers, the style is characterized by works drawn in ink and plain colors, often illustrating popular folk tales or common religious beliefs. During the Meiji period (1868-1912), their quality declined and production dwindled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otsu-e"@en .

aat:300113555 a skos:Concept ;
    skos:definition "Refers to the works of a school of painters who specialized in ink painting, active from the 15th century to the 18th century. Centered around the Kyoto temple of Daitokuji, the schools important paintings include panels for the subtemple Shinjuan, as well as numerous scrolls in a wide variety of subject matter, including bird-and-flower paintings, portraits of the Zen master Ikkyu Sojun, and ink landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soga"@en .

aat:300113571 a skos:Concept ;
    skos:definition "Refers generally to any Japanese variety of the visual arts that uses Western Techniques. The term came into usage during the Meiji Restoration (1868-1912) to distinguish Western-style art from traditional styles of Japanese painting. Western style painting was first know in Japan in the 16th century, but interest faded with the policy of National Seclusion during the reign of the Togukawa shogunate (1603-1867). In 1855, the shogunate set up a research bureau for Western studies, with the Technological Art School established in 1876. During the 1880s, there was a reaction against Western-style painting and a revival of interest in traditional arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yōga"@en .

aat:300113602 a skos:Concept ;
    skos:definition "Period, culture, and English style in architecture and decorative arts from the restoration of Charles II in 1660 to the arrival of William and Mary in 1688. Characterized by opulent Baroque forms and motifs, it was influenced by artistic trends in Holland and France and the appearance of exotic imports of Japanese lacquer and Indian chintz. Architectural elements include spiral columns, hipped roofs, pediments, and sculptural figures, while the significant development in decorative arts was the taste for veneered walnut furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Restoration"@en .

aat:300114171 a skos:Concept ;
    skos:definition "A school or style of woodblock printmaking named for Nishimura Shigenaga, active in the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nishimura School"@en .

aat:300114345 a skos:Concept ;
    skos:definition "Japanese painting school or style named for Hanabusa Itchō."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanabusa School"@en .

aat:300114349 a skos:Concept ;
    skos:definition "Japanese printmaking style or school founded ca.1700-1714 by the painter Kaigetsudo Ando. It is characterized by larger format prints depicting female figures wearing elaborately patterned kimono, often with attendants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kaigetsudo School"@en .

aat:300114356 a skos:Concept ;
    skos:definition "School or style of woodblock printmaking named for the Japanese port city. It offered glimpses of the customs and appearances of recently arrived visitors and large foreign resident population, usually produced for a Western audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yokohama-e"@en .

aat:300114364 a skos:Concept ;
    skos:definition "The Edo period school or style of Japanese art associated with Kitagawa Utamaro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kitagawa School"@en .

aat:300114368 a skos:Concept ;
    skos:definition "The school or style of Japanese art founded by and associated with Katsushika Hokusai."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hokusai School"@en .

aat:300114373 a skos:Concept ;
    skos:definition "Refers to the works of the pupils of ukiyo-e artist Moronobu (d. 1694), son of the famous brocade artist Hishigawa Kichizaemon. The style is characterized by the continuation of Moronobu's controlled, powerful brushstrokes and solid, dynamic figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hishigawa School"@en .

aat:300114379 a skos:Concept ;
    skos:definition "Refers to the style of Ukiyo-e prints that feature views of Edo (Tokyo)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edo-e"@en .

aat:300114381 a skos:Concept ;
    skos:definition "Japanese prints or paintings employing Western-style perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uki-e"@en .

aat:300114385 a skos:Concept ;
    skos:definition "School of ukiyo-e print designers associated with the Torii family, particularly with Torii Shōbei Kiyonobu, beginning in the late Genroku period (1688-1703)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torii School"@en .

aat:300114390 a skos:Concept ;
    skos:definition "Refers to the work of a school of printmakers working in the Ukiyo-e style in Osaka between the middle of the 18th century and the beginning of the 19th century. Related mostly to the kabuki theater, the style is characterized by large format prints of heads or full length figures of actors, that appeared in the 1840's. In the Meiji period (1868-1912), many scenic views and historical prints were published, but the style had adapted to the conventions of Tokyo schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Osaka Print School"@en .

aat:300114395 a skos:Concept ;
    skos:definition "Ukiyo-e print style or school associated with the port city of Nagasaki after 1750. Nagasaki-e prints primarily depict Dutch and Chinese foreigners, their customs, and ships, and were probably intended as souvenirs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nagasaki-e"@en .

aat:300114406 a skos:Concept ;
    skos:definition "Refers to the ukiyo-e school or style associated with the Kamigata region of Japan, which varies from its Edo counterpart. Kamigata-e works depicting kabuki performers exhibit less idealized, and more specific portraits of individual actors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamigata-e"@en .

aat:300114411 a skos:Concept ;
    skos:definition "Japanese prints made to give an effect similar to stone rubbings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ishizuri-e"@en .

aat:300114422 a skos:Concept ;
    skos:definition "Refers to the works of a school of Buddhist painters active from the mid-12th century to the late 14th century. The style is characterized by the use of bold brushstrokes inspired by Chinese works of the Song Dynasty (960-1270)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Takuma"@en .

aat:300114427 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters active in the 17th -19th centuries, as an ofshoot of the Tosa school. The school was founded by Sumiyoshi Jokei, who was appointed head of the Office of painting of the Sumiyoshi Shrine in Osaka. The style is characterized by the continuation of the miniaturist tradition of the Tosa school, with small format albums and picture scrolls, typically showing man in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumiyoshi"@en .

aat:300114437 a skos:Concept ;
    skos:definition "Refers to the style of painting that flourished in Kyoto in the late Edo period (1600-1868). Founded by Matsumura Keiben (Goshun), the style emphasized precise depiction of nature with soft pliable brushstrokes and less exacting details than the work of the Maruyama School."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shijo"@en .

aat:300114441 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters whose careers spanned the Edo period (1600-1868) to the early part of the Meiji period (1868-1912). The style is characterized by the use of traditional Japanese materials and techniques such as black or colored ink made from minerals, shells or plants and painted on paper or silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nihonga"@en .

aat:300114448 a skos:Concept ;
    skos:definition "Refers to the style of painting that means \"Chinese-style painting,\" often contrasted with Yamato-e (Japanese style painting). In the 8th century, Kara-e referred to the works of Chinese artists of the Tang dynasty (618-907) and later was extended to include Japanese depictions of Chinese scenery or motifs, typically portraits of sages and horses. During the Hein period, the opulent style became associated with court life. In the 14th and 15th centuries, Chinese ink paintings of the Song (960-1279) and Yuan (1279-1368) dynasties were imported into Japan and the name kara-e was given to distinguish this style from the continuing Hein style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kara-e"@en .

aat:300114457 a skos:Concept ;
    skos:definition "Refers to the work of a school of painters during the 15th century, who emerged out of the Zen monastaries and revived the ink painting tradition of the Muromachi period (1333-1568). The school was represented by three generations of Ami painters, whose main duty was curator of Chinese art objects in the collection of the Ashikaga shogunate. The style combines the rich washes and dots of traditional Chinese painting of the Southern Song dynasty (1127-1279), with some elements of Korean painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ami School"@en .

aat:300114463 a skos:Concept ;
    skos:definition "Refers to the style of stoneware produced in Seto and southward onto the Chita Peninsula in the 12th century. The style is characterized by the production of everyday ware such as bowls, jars and motors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yakishime"@en .

aat:300114474 a skos:Concept ;
    skos:definition "Refers generally to a variety of styles of ash-glazed pottery produced at the Sanage kilns east of the present-day city of Nagoya, throughout the Heian period (794-1185). Productions typically included bowls, jars, dishes and vases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sanage"@en .

aat:300114476 a skos:Concept ;
    skos:definition "Refers to the style of early glazed wares of the Nara period (645-794 CE), produced directly under government control. The style is characterized by green glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ryokuyo"@en .

aat:300114479 a skos:Concept ;
    skos:definition "Refers to the style of early glazed wares of the Nara period, produced directly under government control. The style is characterized by two-color wares, typically in green and white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nisai"@en .

aat:300114485 a skos:Concept ;
    skos:definition "Refers to the style of architecture developed during the Song dynasty (970-1279 BCE) in China and introduced into Japan along with Zen Buddhism during the Kamakura period (1185-1333). The style is characterized by smaller, more structurally complex buildings than before, with strongly articulated bracketing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zenshuyo"@en .

aat:300114491 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that developed around 300 BCE. The style is characterized by a type of shrine that is rectangular in shape, divided into two parts and constructed of rough unbarked wood. The roof is gabled with each end terminating in two crossed members, and is supported by large round posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumiyoshi"@en .

aat:300114497 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that developed around 300 BCE. The style is characterized by a type of shrine that is said to have been derived from a simple two-bay by three-bay system typical of prehistoric granaries and storehouses. The shrine is surrounded by a continuous deck with stairs leading to the entrance on the long side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shimmei"@en .

aat:300114506 a skos:Concept ;
    skos:definition "Refers to a style of Japanese domestic structure intended for farmers, fishermen, and low ranking samurai, dating from the Edo period (1600-1868). Common features of minka include a cooking area with an earthen floor and raised areas with mat flooring for sleeping or other social activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minka"@en .

aat:300114510 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that developed during the Heian period (794-1185). The style is characterized by a type of shrine consisting of a pent roof added to the front and two sides of the main building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hie"@en .

aat:300114513 a skos:Concept ;
    skos:definition "Referes to the style of Shinto architecture that developed during the Yayoi period (ca. 300 BCE to ca. 300 CE). The style is characterized by a type of shrine with features suggestive of residential architecture of the Kofun period (ca. 300-710), such as columns set directly into the ground, a gable roof, and floors raised high above the earth and accessible by stairs at the gable end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Izumo Taisha"@en .

aat:300114517 a skos:Concept ;
    skos:definition "Refers to the type of Sanage pottery consisting typically of small ash-glazed bowls, produced during the Hein period (794-1185)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yamachawan"@en .

aat:300114529 a skos:Concept ;
    skos:definition "Painting styles belonging to Tibetan cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tibetan painting styles"@en .

aat:300114605 a skos:Concept ;
    skos:definition "Refers to the art and architecture associated with the Islamic dynasty of this name that governed Tunisia, Algeria and Sicily from 800 to 909. The dynasty reached its apogee under Abu Ibrahim Ahmad (reigned 856-63) when the Great Mosque of Kairouan was embellished. Kairouan became an important religious and cultural center, attracting scholars and artisans who developed local variants of Abbasid styles. The Zaytuna Mosque in Tunis, a building that rivaled the Great Mosque of Kairouan, was restored in a campaign that was completed in 864-5. Art historically the Aghlabid dynasty is also remembered for a group of Koran manuscripts found in the library of the Great Mosque of Kairouan, of which the earliest are traditionally attributed to the Aghlabid period; they include some of the finest examples of early Islamic calligraphy and bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aghlabid"@en .

aat:300114633 a skos:Concept ;
    skos:definition "Refers to the art and culture associated with the Islamic Berber dynasty that ruled in Spain and North Africa from 1054 to 1147, when it was succeeded by the Almohad dynasty. The Almoravids developed out of a puritanical movement in western Africa that appealed to North African Berbers. The Almoravid leader Yusuf b. Tashfin founded Marrakesh in 1069. From 1090 the dynasty controlled Andalusia and it was through this connection that the Umayyad art of Spain was transplanted to North Africa. Egyptian influence was also felt. Known for their puritanical fervor, the Almoravids were mostly patrons of religious architecture. They built mosques in Tilimsen and Algiers that were inspired by the mosque at Córdoba; other noteworthy mosques were built in Fès. Almoravid architects were known for their imaginative manipulation of three-dimensional space using ornamental arches and decorative vaults, architectural forms traditionally kept apart. These and other architectural forms animate their buildings instead of applied decoration. The hallmark of their distinctively Maghribi muqarnas is that the exterior reveals nothing of the internal configuration. The muqarnas vault at Fès is built over a rectangular space and so visually acts as a suspended ceiling rather than as a traditional dome. A fountain that was once part of the Great Mosque of Marrakesh is noted for its lobed and crinkled arch forms that create a powerful sculptural rhythm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Almoravid"@en .

aat:300114767 a skos:Concept ;
    skos:definition "Refers to the art and architecture of the Islamic dynasty of the same name that ruled Iraq and Azerbaijan from 1336 to 1432. The architect of the early Jalayirids continued in the manner of earlier local styles with an emphasis on geometric brickwork, stucco decoration, and fine inscriptions. The major building of this period is the funerary complex built from 1356-1359 built by Mirjan , the amir who governed the city. Manuscript illustration also flourished during this period, particularly under the patronage of Ahmad (reigned 1382-1410). These works saw a fusion of Chinese and Near Eastern pictorial elements along with a new formula for depicting space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jalayirid"@en .

aat:300115114 a skos:Concept ;
    skos:definition "Piles formed by driving a hollow tube into the ground, excavating within the tube, and filling it with concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caisson piles"@en .

aat:300115179 a skos:Concept ;
    skos:definition "Prints made on light-sensitized surfaces that produce brown lines on neutral backgrounds. For white images on brown backgrounds, use \"brownprints.\" For brownline prints on translucent paper, use \"sepia prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brownline prints"@en .

aat:300115190 a skos:Concept ;
    skos:definition "Prints made on light-sensitized surfaces that produce blue images on neutral backgrounds. For white images on blue backgrounds, use \"blueprints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blueline prints"@en .

aat:300115199 a skos:Concept ;
    skos:definition "Prints made on light-sensitized surfaces that produce white images on brown backgrounds. For brown images on neutral backgrounds use \"brownline prints\" or \"sepia prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brownprints"@en .

aat:300115217 a skos:Concept ;
    skos:definition "Prints made on light-sensitized surfaces that produce black lines on neutral backgrounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackline prints"@en .

aat:300115233 a skos:Concept ;
    skos:definition "Brownline prints on translucent paper, usually used as intermediates from which more prints can be made and usually made by a diazo process; distinct from \"brownprints,\" which show a white image on brown background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepia prints"@en .

aat:300115251 a skos:Concept ;
    skos:definition "Those who use their means or influence to benefit individuals, institutions, or causes; especially those who support the work of artists and writers, and including those who commission and pay for individual works. For supporters who assume primary responsibility for projects or activities, use \"sponsors.\" For supporters who give voluntary work, money, or public expressions of support through membership in a voluntary association, use \"friends.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patrons"@en .

aat:300115264 a skos:Concept ;
    skos:definition "Persons responsible for checking that a product or service meets required standards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkers"@en .

aat:300115825 a skos:Concept ;
    skos:definition "Books in which copies are written or printed for pupils to imitate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copybooks"@en .

aat:300115833 a skos:Concept ;
    skos:definition "A leaf is a single sheet of paper or parchment, recto and verso, making two pages of a book; the basic bibliographical unit of a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaves"@en .

aat:300116032 a skos:Concept ;
    skos:definition "Painting styles belonging to Uzbek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uzbek painting styles"@en .

aat:300116196 a skos:Concept ;
    skos:definition "Legal concepts related to land use and planning restructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoning concepts"@en .

aat:300116398 a skos:Concept ;
    skos:definition "Retaining walls prevented from overturning by their own weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravity walls"@en .

aat:300116399 a skos:Concept ;
    skos:definition "Style of painting that flourished in Tibet from the 11th to the 14th century. Two distinct versions of this style exist, both closely associated with the Kadampa monasteries. One style developed in central Tibet, the other in western Tibet. The Pala-Tibetan style of central Tibet was known for its distinctive coloration and slim, willowy figures adorned with peculiar jewelry and pointed diadems. The western version of the style is more cursive and freely drawn; overall it is more expressive and less elegant than its central counterpoint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pala-Tibetan"@en .

aat:300116651 a skos:Concept ;
    skos:definition "Usually rectangular units of scenery consisting of a framework of lightweight lumber and covered with canvas, linen, or other fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flats"@en .

aat:300116666 a skos:Concept ;
    skos:definition "Refers to the work of a group of artists working in Chicago who gained national recognition in 1959 after an exhibition in New York where they were labeled the \"Monster School.\" There were three distinct self-identified groups associated with the Chicago Imagist school: The Hairy Who, The Monster Roster, and The Chicago Imagists. The style is influenced by popular culture and outsider art, often incorporating images from comic strips and other print media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chicago Imagist"@en .

aat:300116922 a skos:Concept ;
    skos:definition "Styles belonging to Siberian Arctic Native cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siberian Arctic Native styles"@en .

aat:300116926 a skos:Concept ;
    skos:definition "Complexes designed as unified sites that include a mix of building types and uses, common open space, and controlled density increases, rather than lot-by-lot schemes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planned unit developments"@en .

aat:300117125 a skos:Concept ;
    skos:definition "Artifacts created or produced in former periods. The term was traditionally applied primarily to works of fine or decorative art and furnishings, but is currently employed for any type of man-made object of a past era. U.S. customs laws define antiques as artifacts whose date of initial purchase was at least 100 years before the present. In common usage with respect to automobiles, the term includes those at least 25 years old."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiques"@en .

aat:300117127 a skos:Concept ;
    skos:definition "Generally, objects or other things made or modified by humans, typically manually portable products of human workmanship, such as tools, utensils, objects for personal adornment, or art, as distinguished from natural remains. In archaeology, an artifact is an object made by a human culture and later recovered by an archaeological endeavor. In the context of museum objects, use \"cultural artifact.\" In the context of technical and medical research, for a spurious result that is a product or effect resulting from the experimental technique or procedure itself, use \"experimental artifact.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artifacts"@en .

aat:300117130 a skos:Concept ;
    skos:definition "Portions of objects that are torn, broken off from, or dislocated from their original whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fragments"@en .

aat:300117132 a skos:Concept ;
    skos:definition "Limited to fragments of pottery or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sherds"@en .

aat:300117359 a skos:Concept ;
    skos:definition "Refers to depictions or photographs showing structures or sites seen from directly above. For scaled orthographic drawings, use \"plans (orthographic projections).\" For views of objects seen from above, use \"top views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plan views"@en .

aat:300117363 a skos:Concept ;
    skos:definition "Refers to depictions with a vantage point that allows three-quarters of the subject to be seen. It is particularly used with portraits, where the face is seen at an angle between profile and full face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-quarter views"@en .

aat:300117446 a skos:Concept ;
    skos:definition "Refers to views where the emphasis is on the closeness of the camera or other viewpoint to the subject, as distinct from \"details,\" where emphasis is on the partial nature of the view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close-up views"@en .

aat:300117546 a skos:Concept ;
    skos:definition "Creative works that depict the ocean or other large body of water where the water itself dominates the scene. When lesser bodies of water are depicted, use \"landscapes (representations).\" When ships, shipbuilding, or harbors are depicted, use \"marines (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seascapes"@en .

aat:300117554 a skos:Concept ;
    skos:definition "Sketches made when the artist or architect is traveling, especially for recording monuments and scenes for later study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel sketches"@en .

aat:300118112 a skos:Concept ;
    skos:definition "Styles belonging to Angkorean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angkorean styles"@en .

aat:300118515 a skos:Concept ;
    skos:definition "Refers to the colonnaded forecourts of Early Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atriums"@en .

aat:300120010 a skos:Concept ;
    skos:definition "Includes the complete examination, investigation, and testing of surface and subsurface soil and conditions at a site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site analysis"@en .

aat:300120011 a skos:Concept ;
    skos:definition "Chinese site analysis method that employs geomantic techniques; used especially in determining the placement and design of houses, graves, and gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fengshui"@en .

aat:300120015 a skos:Concept ;
    skos:definition "Refers to the intellectual and artistic movement among Mexican writers and artists such as Fermín Revueltas and Diego Rivera in the 1920s. The movement is characterized by a focus on cosmopolitanism and the public obligations of art and by a disdain for the academic art world and the Symbolist movement. The movement, borrowing ideas from Futurist manifestos and Spanish Ultraist ideas, roused a strong cultural revival at the community level, criticizing religiosity and patriotism, promoting the Muralist movement in Mexico, and advocating the USSR as an ideological model."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Estridentismo"@en .

aat:300120023 a skos:Concept ;
    skos:definition "Boats having sails as their primary means of propulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailboats"@en .

aat:300120039 a skos:Concept ;
    skos:definition "Describes the style and culture of distinct Australian regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australian regional styles"@en .

aat:300120040 a skos:Concept ;
    skos:definition "Describes the style and culture of the Aboriginal Australian group located in Arnhem Land, a northeastern territory in Australia. The Fijian missionaries introduced fan making to the original inhabitants of Arnhem Land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arnhem Land"@en .

aat:300120043 a skos:Concept ;
    skos:definition "Describes the style and culture of the aboriginal community of Kimberleys who are well known for their rock art and ceremonial dances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kimberleys"@en .

aat:300120045 a skos:Concept ;
    skos:definition "Describes the style and culture of Aboriginal Tasmanians, who suffered greatly with European colonization. Hardly any artwork survives of Tasmania. Early records suggest that Tasmania was equally as rich with artistic traditions similar to those found in the rest of Australia. Early photographs and paintings by Thomas Bock exemplify elaborate hair decoration and body adornment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tasmanian"@en .

aat:300120047 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Tikopia Island. The people of Tikopia are most well known for their carved wooden artifacts and personal ornaments. The Tikopia neck-rests were exceptionally carved with a crescent outline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tikopia"@en .

aat:300120063 a skos:Concept ;
    skos:definition "Refers to the culture and style of artifacts found at the site of Cheng-chou, south of the Yellow River in the modern day province of Honan, dating around 1300 BCE. Royal tombs as well as ordinary cemeteries have yielded a vast quantity of artifacts, most notably gray pottery and bronze objects belonging to the first phase of Shang culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zhengzhou"@en .

aat:300120068 a skos:Concept ;
    skos:definition "Refers to the culture and style of artifacts found on a site near the Yellow River at Anyang, the last capital of the Shang dynasty, 1384 to 111 BCE. Excavations from this site have unearthed, building foundations, stone and jade, bronze vessels, cord-impressed pottery with geometric and anthropomorthic designs, and inscribed animal oracle bones, the earliest Chinese written records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anyang"@en .

aat:300120069 a skos:Concept ;
    skos:definition "Refers to the culture and style of artifacts found at the site of Hsiao-t'un, dating from the Late Neolithic period, Excavations from this site have unearthed gray pottery with cord-impressed designs, and most notable the li tripod, a bronze vessel comprised of three vases with pointed bottoms joined together. Later in Chinese Bronze Age culture, the tripod developed hollow legs for more a direct transference of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xiaotun"@en .

aat:300120070 a skos:Concept ;
    skos:definition "Refers to the culture and style of pottery found in the suburbs of Zhengzhou at Erligang, China around 1652 BCE. The style is typically characterized by earthenware vessels with 3 hollow legs and cord impressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Erligang"@en .

aat:300120077 a skos:Concept ;
    skos:definition "Refers to the culture of a North American Indian tribe that inhabited the east side of the lower Mississippi River when European settlers arrived in the area in the early 18th century. Their language was of the Macro-Algonquian phylum, Muskogean family; their culture was agricultural and related to other Muskogean tribes. They are often considered the last survivors of the great Mississippian culture. Their imagery is characterized by references to sun worship, fire, and their midsummer Green Corn festival. Their culture declined and their people were dispersed after the arrival of Europeans. Many Natchez fled to join with the Cherokee or Mvskoke (Creek); today many of their descendents live in the Cherokee and Mvskoke communities in Oklahoma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Natchez"@en .

aat:300120089 a skos:Concept ;
    skos:definition "Buildings, other structures, and complexes of structures whose primary function is mental health care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mental health facilities"@en .

aat:300120137 a skos:Concept ;
    skos:definition "Buildings or building complexes providing wholesalers with a single location having display spaces for product vendors of various trades, such as apparel, furnishings, or business equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade marts"@en .

aat:300120146 a skos:Concept ;
    skos:definition "Refers to the cultures of the region of Asia situated east of the Indian subcontinent and south of China, encompassing the long-historied and ethnically diverse cultures of a continental mainland and a series of archipelagoes 700 miles to the east and south of the continent. In general, the arts in the region predominantly reflect religion, particularly the personality and character of Buddha and the Hindu gods, and history, particularly glorified heroes of national and mythic pasts. The Buddha image remains the central motif in sculptural and painting styles, while other minor or native figures from Buddhist, Islamic, and Hindu scriptures are sometimes reflected in mural works. Art in the region features tribal geometric and spiral patterns, Indian floral designs, and animal imagery based on local mythologies. A general penchant for themes of fantasy, human and divine beauty, and celebratory sensuality pervades the art of this region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southeast Asian"@en .

aat:300120165 a skos:Concept ;
    skos:definition "Refers to a style named for the former capital of ancient Burma from the 11th to the end of the 13th century. Known as the central religious and intellectual nexus of the country, featuring Buddhist shrines and walled citadels built in carved brick, stucco, and terra-cotta, and temples and shrines dedicated to spirit deities of animist origins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pagán"@en .

aat:300120209 a skos:Concept ;
    skos:definition "Refers to the civilization, period, and style that developed from around 802 CE to 1432 CE in the Khmer region known today as Cambodia. Artistic production based in the Angkor culture marked the height of Cambodian creativity, featuring prominent architectural structures such as the temples at Angkor Vat and Angkor Thom. Temples from this period are generally characterized by large-scale and intricately stylized sculptural representations of deities' faces and bodies carved into exterior walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angkorean"@en .

aat:300120309 a skos:Concept ;
    skos:definition "Refers to the recessed part of an upper stage in an Elizabethan theater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chambers"@en .

aat:300120324 a skos:Concept ;
    skos:definition "Designates the style and movement of the early 1900s centralized on the portrayal of pedestrian and ordinary aspects of urban living. The style challenges the academic aesthetic of 'art for art's sake' and champions the idea of 'art for life' in the abandonment of learned techniques and the focus on the vitality and idiosyncrasies of everyday street life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ashcan School"@en .

aat:300120350 a skos:Concept ;
    skos:definition "Style of porcelain made and decorated in China to European order, as distinct from porcelain in native taste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese export"@en .

aat:300120355 a skos:Concept ;
    skos:definition "Style of porcelain made in China and shipped to France by the Compagnie des Indes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Compagnie des Indes"@en .

aat:300120364 a skos:Concept ;
    skos:definition "Ceremonial structures that are related to or concerned with religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious structures"@en .

aat:300120377 a skos:Concept ;
    skos:definition "Public or private ancient Roman baths or bath buildings of ordinary size. For the great ancient Roman baths, use \"thermae.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balnea"@en .

aat:300120424 a skos:Concept ;
    skos:definition "Quadripartite Islamic gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chahar bagh"@en .

aat:300120431 a skos:Concept ;
    skos:definition "Periods related to Chinese Paleolithic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese Paleolithic periods"@en .

aat:300120439 a skos:Concept ;
    skos:definition "Refers to the movement of the late 19th and early 20th centuries governed by the desire of American architects and landscape architects to boost the national standards and prestige of American urban planning and city development through municipal reform and beautification rather than through social reform. With the driving force of the World's Columbian Exposition in Chicago (1893), the movement secured the active development of metropolitan park systems and the establishment of reform-motivated art societies in major cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "City Beautiful Movement"@en .

aat:300120447 a skos:Concept ;
    skos:definition "Buildings housing businesses that sell merchandise at a price below the usual price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discount houses"@en .

aat:300120452 a skos:Concept ;
    skos:definition "Shrines, churches, or oratories built in memory of a martyr. Shrines, churches, or oratories built in memory of a martyr."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martyria"@en .

aat:300120461 a skos:Concept ;
    skos:definition "Buildings where electrical power is generated for distribution, often as part of a larger power plant complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power plant buildings"@en .

aat:300120478 a skos:Concept ;
    skos:definition "Refers to megalithic prehistoric structures comprising two monolithic upright stones topped by a monolithic lintel. For smaller structures formed by two or more large standing stones capped by monolithic horizontal slabs, use \"megalithic chamber tombs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trilithons"@en .

aat:300120486 a skos:Concept ;
    skos:definition "Designates circular areas bounded by a ditch and an enclosing embankment, the whole usually surrounding a circle or circles of standing stones or wood posts. For prehistoric circular enclosures of well-spaced large upright stones only, lacking bordering features, use \"cromlechs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "henges"@en .

aat:300120504 a skos:Concept ;
    skos:definition "Designates ancient Roman storage buildings or warehouses, commonly used as granaries or for wine storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horrea"@en .

aat:300120507 a skos:Concept ;
    skos:definition "Archaeological or anthropological contexts for accumulations of refuse associated with human occupation. These accumulations may include discarded artifacts and food remains such as bones and shells. They are often used as valuable sources of archaelogical data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middens"@en .

aat:300120555 a skos:Concept ;
    skos:definition "Stations, along ancient Roman and Byzantine roads (through the 7th century), spaced generally one day's travel apart and intended as stopping places for overnight stays, initially primarily reserved for imperial parties. For intermediary rest stops along these routes, use \"mutationes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mansiones"@en .

aat:300120556 a skos:Concept ;
    skos:definition "Designates ancient rectangular dwellings consisting of a large main space and a shallower front porch framed by projecting antae; may be used for similarly shaped central features within more complex ancient buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megarons"@en .

aat:300120561 a skos:Concept ;
    skos:definition "Relay stations or rest stops set along ancient Roman and Byzantine roads (through the 7th century) and providing for the minimal needs of travelers. For stopping places for overnight stays along these ancient routes, use \"mansiones.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutationes"@en .

aat:300120599 a skos:Concept ;
    skos:definition "Settlement areas possessing a harbor and terminal facilities used for loading or unloading, or water transportation. By extension, the term is also applied to such areas facilitating air transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ports"@en .

aat:300120624 a skos:Concept ;
    skos:definition "Private, single chamber tombs made of rock, used in ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-cut tombs"@en .

aat:300120649 a skos:Concept ;
    skos:definition "Used to designate ancient Roman funerary structures of several stories usually rising from a stepped square or rectangular base and topped by a pyramidal, domical, or flat roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower-tombs"@en .

aat:300120651 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings where people do both basic and applied research, usually set up in support of a larger organization which may then test and implement the research results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research laboratories"@en .

aat:300120658 a skos:Concept ;
    skos:definition "Camps or bases in an isolated part of the Arctic or Antarctic, manned by specialists to monitor such things as the weather, geologic formations, and wildlife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice stations"@en .

aat:300120662 a skos:Concept ;
    skos:definition "Built works designed and used specifically for research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research structures"@en .

aat:300120670 a skos:Concept ;
    skos:definition "Designates structures in which electrons, protons, or heavy ions are accelerated along a straight line by the action of alternating voltages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear accelerators"@en .

aat:300120672 a skos:Concept ;
    skos:definition "Designates structures in which charged atomic particles are accelerated along a spiral path by means of alternating electric currents with a constant magnetic field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclotrons"@en .

aat:300120676 a skos:Concept ;
    skos:definition "Temporary and often spontaneously established, settlements of displaced peoples along borders of neighboring or nearby countries, generally having minimal shelter, supplies, and sanitary facilities and created without the granting of technical asylum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refugee camps"@en .

aat:300120678 a skos:Concept ;
    skos:definition "Second dwellings that are owned in addition to a principal home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second homes"@en .

aat:300120681 a skos:Concept ;
    skos:definition "Public roads giving direct access to the land, premises, or highways on one or both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "access roads"@en .

aat:300120693 a skos:Concept ;
    skos:definition "Structures of any kind that serve the transportation and transport of goods and passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation structures"@en .

aat:300120696 a skos:Concept ;
    skos:definition "Structures specifically designed for the business of a railroad or railway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railway buildings"@en .

aat:300120699 a skos:Concept ;
    skos:definition "Storage facilities specifically built to house vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vehicle storage buildings"@en .

aat:300120707 a skos:Concept ;
    skos:definition "Use only for large communities established in space or on natural extraterrestrial bodies. For smaller manned installations established on natural extraterrestrial bodies for specific functions, use \"extraterrestrial bases.\" Use \"space stations\" for manned artificial satellites placed in a fixed orbit and serving as a base for specific functions (e.g., scientific observations or the refueling of spaceships)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space colonies"@en .

aat:300120719 a skos:Concept ;
    skos:definition "Buildings or groups of buildings used for manufacturing beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beverage processing plants"@en .

aat:300120748 a skos:Concept ;
    skos:definition "Enclosures or narrow, artificial basins that hold single ships, boats, or other watercraft, and from which the water may be pumped or let out to leave the vessel dry for the purpose of maintenance, repair, or shipbuilding. (Sometimes also used for building ships.). Dry docks are known in the historical record as early as the 10th century in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry docks"@en .

aat:300120766 a skos:Concept ;
    skos:definition "Use only for individual freestanding urban dwellings. For attached urban dwellings each having its own private entrance, use \"row houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "town houses"@en .

aat:300120767 a skos:Concept ;
    skos:definition "Structures that float on the water and can be partly submerged to permit a ship to enter it and afterward floated to raise the ship high and dry as in \"dry docks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating docks"@en .

aat:300120772 a skos:Concept ;
    skos:definition "Large watertight enclosures in which the water is maintained at the level of high tide so that vessels remain constantly afloat in them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet docks"@en .

aat:300120779 a skos:Concept ;
    skos:definition "Structures extending from the shoreline out over the sea or tidal river, to protect or partially enclose a harbor and form a landing place for vessels, or to serve as a recreational or entertainment place. A pier may also be a projecting landing stage or jetty on the bank of a river or lake. For structures built along or parallel to the shoreline serving as landing, loading, or unloading places for vessels, use \"wharves\" or \"quays.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piers"@en .

aat:300120782 a skos:Concept ;
    skos:definition "Substantial, man-made banks or landing stages, typically built of stone, lying alongside or projecting into water for loading and unloading ships. For structures that are not man-made banks, but built in similar locations and for similar purposes, use \"wharves\"; use \"piers (marine landings)\" for lighter structures that extend out over the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quays"@en .

aat:300120786 a skos:Concept ;
    skos:definition "Structures built generally parallel to the shoreline so that vessels may moor alongside to receive or discharge cargo or passengers. For similar loading and unloading places built to extend from the shoreline out over water, use \"piers (marine landings)\"; if such places are artificial solid banks or shoreline extensions built parallel to the shoreline, use \"quays.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wharves"@en .

aat:300120792 a skos:Concept ;
    skos:definition "Open water spaces located along a waterfront."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterfront spaces"@en .

aat:300120799 a skos:Concept ;
    skos:definition "Unoccupied open water spaces set between adjacent piers or perpendicular to landing places, especially those spaces which can accommodate only one vessel at a time; when such spaces are alongside land places, use \"berths (waterfront spaces).\" Use \"docks\" for open water spaces when occupied by vessels made fast to landing places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slips"@en .

aat:300120801 a skos:Concept ;
    skos:definition "Artificial basins excavated and often built up with masonry or another material, and often fitted with flood-gates, into which boats or ships are received for purposes of landing, loading and unloading, or for repair. The earliest known docks date to ca. 2500 BCE in Egypt. The plural term is often used to refer to a single such artificial basin. When such spaces are unoccupied and are alongside a landing place, use \"berths (waterfront spaces)\"; use \"slips (waterfront spaces)\" when such water spaces are unoccupied and set between adjacent piers or perpendicular to landing places. Use \"dockyards\" for the group of landing places in ports or for port facilities as a whole. For the structures that surround a dock, excluding the space occupied by water, prefer \"piers (marine landings)\" or \"wharves.\" For structures used for docking for various purposes, use \"dry docks,\" \"wet docks,\" or \"floating docks.\" Distinguished from the structures, \"docks (general waterside structures),\" which in casual, modern usage may refer to any waterside structure supporting people or their activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "docks"@en .

aat:300120802 a skos:Concept ;
    skos:definition "Complexes built for use related to water transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water transportation complexes"@en .

aat:300120803 a skos:Concept ;
    skos:definition "Spacious enclosures, usually adjoining a sea or river, in which ships are repaired or built, and where ships' stores are prepared or brought together. The term is often reserved for government establishments of this character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dockyards"@en .

aat:300120804 a skos:Concept ;
    skos:definition "Watercraft complexes facilitating the operation of air-cushion vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoverports"@en .

aat:300120810 a skos:Concept ;
    skos:definition "Distinguished from \"gallery graves\" by having a clear distinction between the burial chamber and the tunnellike entry passage leading to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passage graves"@en .

aat:300120824 a skos:Concept ;
    skos:definition "Secure mooring facilities primarily for yachts and other recreational small craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marinas"@en .

aat:300120849 a skos:Concept ;
    skos:definition "Style and culture of the area around ancient Vaisali, in Bihar, India, important to Buddhism and Jainism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vaisali"@en .

aat:300120850 a skos:Concept ;
    skos:definition "Mirrors having frames partly or fully of marble and often ornamented with filigree or openwork cresting; popular in the late 18th and early 19th centuries and thought to have originated in Bilbao, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bilbao mirrors"@en .

aat:300120980 a skos:Concept ;
    skos:definition "Style of porcelain from China made during the Qing dynasty and decorated with Christian subjects taken from European engravings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jesuit"@en .

aat:300120984 a skos:Concept ;
    skos:definition "Refers to the style named for the raised temple-mountain complex built by King Suryavarman II (1113-1150 CE) in the 12th century as a colossal funerary temple for himself. It is identified as the last Hindu-influenced style in Angkor before the ascendancy of Mahayana Buddhism. The temple embodies the hallmark style of artistic production in the Middle Angkor period (1080-1181 CE). The temple complex is constructed in laterite and sandstone, featuring vaulted ceilings, wooden rafters, and the use of blocks rather than pegs for joining joists and columns. The style introduced the cruciform forecourt supported by covered galleries with pillars and interlinked galleries and pavilions illuminated by natural light enabled through an innovative vaulting system. Sculptural works of this style predominantly feature narrative bas-reliefs rather than sculpture in the round. Relief panels depict scenes from the Mahabharata and the Ramayana as well as tableaus of Suryavarman II conducting royal affairs. Figures of deities and other eminent personages in friezes are distinguished by bright colors and gold leaf touches. Numerous statues of apsara figures are portrayed wearing pleated, waist-high garments with decorated flower patterns adorn the temple. Eight other temple complexes in the royal capital follow this style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angkor Vat"@en .

aat:300120989 a skos:Concept ;
    skos:definition "Refers to the style inspired by the building of the temple of Banteay Srei during the mid-tenth century in Angkor and partly reflects the revival of the pre-Angkor sculptural styles of the seventh and eighth centuries. The temple features pink sandstone construction, small-scale and elaborate jewel-like relief decoration, tympanum reliefs of large and small deities enveloped in swirling foliage, sophisticated narrative relief panels that portray Shiva, Vishnu, and Krishna placed at staggered levels, and wall paintings. Sculptural figures display slimmer bodies, more naturalistic proportions, narrower heads, more youthful demeanors, and garments that lack narrow vertical pleats and cling to the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banteay Srei"@en .

aat:300121011 a skos:Concept ;
    skos:definition "Periods related to Kerma cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kerma periods"@en .

aat:300121012 a skos:Concept ;
    skos:definition "Periods related to Kushite cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kushite periods"@en .

aat:300121100 a skos:Concept ;
    skos:definition "Pottery styles belonging to Pre-Columbian Andean cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Columbian Andean pottery styles"@en .

aat:300121110 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period based in the Bronze Age of Vietnamese history (around the 15th or 14th century BCE) associated with the site in northern Vietnam in the Thanh Hoa Province known as Dông-Son. The period is characterized by the high production of bronze ritual objects and bronze kettledrums reflecting strong Indonesian stylistic influences and a predilection for animal motifs. Objects produced in this period also display affinity in form and style to Chinese pottery and bronze works. In architecture, the period features houses and temples with curved roofs and support structures based on a stilts system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dông-Son"@en .

aat:300121145 a skos:Concept ;
    skos:definition "Wicker chairs with arms that are a forward continuation of the back, usually with a cane-shaped base in lieu of legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basket chairs"@en .

aat:300121151 a skos:Concept ;
    skos:definition "Term for the earliest type of bentwood chairs; patented by Samuel Gragg in 1808."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elastic chairs"@en .

aat:300121177 a skos:Concept ;
    skos:definition "Easy chairs with exaggerated wingbacks that protect the sitter from noise or drafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauteuils à oreilles"@en .

aat:300121196 a skos:Concept ;
    skos:definition "Refers to a variety of 19th-century chairs with nautical motifs and often a tablet top and a backrail incorporating cable molding. Made after the Battle of Trafalgar in 1805."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trafalgar chairs"@en .

aat:300121227 a skos:Concept ;
    skos:definition "Use to designate circular buildings of classical date, with or without a peristyle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tholoi"@en .

aat:300121231 a skos:Concept ;
    skos:definition "French chairs with oval or medallion-shaped backs, the frames being carved in the center of the top with a ribbon bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaises à la d'artois"@en .

aat:300121246 a skos:Concept ;
    skos:definition "Desk chairs with deeply coved backs and usually, but not always, with a projecting central front leg; may have four or five legs. Very often carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauteuils de bureau"@en .

aat:300121255 a skos:Concept ;
    skos:definition "Ancient Greek folding stools without a back and having crossed legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diphroi okladiai"@en .

aat:300121262 a skos:Concept ;
    skos:definition "Refers to the style of German faience produced between 1661 and 1806 and largely imitative of blue and white Delft pottery. After circa 1725, pieces are characterized by blue dots applied to a white ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanau"@en .

aat:300121292 a skos:Concept ;
    skos:definition "Styles belonging to Japanese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese styles"@en .

aat:300121293 a skos:Concept ;
    skos:definition "Objects that are based on or signifiantly borrow from other existing objects, rather than being original creations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "derivative objects"@en .

aat:300121294 a skos:Concept ;
    skos:definition "Groups of multiples of one work issued together, such as of a book, print, photograph, or cast sculpture. All copies of a book, print, etc., produced from substantially the same master, and issued at one time are part of the same edition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "editions"@en .

aat:300121295 a skos:Concept ;
    skos:definition "Editions of multiples, typically a book or prints, limited to a specifically stated number of copies, which are usually numbered consecutively and sometimes signed by the artist. After the production of an edition, the plates, molds, dies, or stereos are often destroyed, or, in the case of books, the type scattered, after the edition has been completed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limited editions"@en .

aat:300121305 a skos:Concept ;
    skos:definition "Reproductions of whole objects when the intention is to deceive; includes sculptures cast without the artist's permission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterfeits"@en .

aat:300121308 a skos:Concept ;
    skos:definition "Popular American term for mid-19th-century benches on rockers, with detachable fences two thirds of their length so that a baby could lie on the seat without rolling off, while the mother sat beside it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cradle benches"@en .

aat:300121326 a skos:Concept ;
    skos:definition "Refers to S-shaped sofas with ends curving inward so two people could sit face to face. For straight-fronted sofas with small triangular seats (sometimes detachable) set outside the arms at either end, use \"confidantes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canapés à confident"@en .

aat:300121340 a skos:Concept ;
    skos:definition "Long, low, upholstered seats of Turkish origin usually without backs or arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divans"@en .

aat:300121345 a skos:Concept ;
    skos:definition "Beds, particularly those created in Europe prior to the 16th century, of various designs having a high wooden frame suspended over the head half of the bed, from which curtains may be hung in a tent-like fashion. Sparver beds typically do not have bedposts, but the frame may be attached to the wall or ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sparver beds"@en .

aat:300121352 a skos:Concept ;
    skos:definition "Cupboards containing bookshelves and closed with doors usually of glass or sometimes fitted with grilles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliothèques"@en .

aat:300121376 a skos:Concept ;
    skos:definition "Chests made from a hollowed log or tree trunk, and used primarily in the Middle Ages. Frequently used as safes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dug-out chests"@en .

aat:300121378 a skos:Concept ;
    skos:definition "Cases or shelflike surfaces, usually of a height convenient for a person standing before them, as in a kitchen or store, or sitting on stools in front of them, as in a restaurant or bar. For small tables or chests with the top marked for counting money, sometimes with a cupboard below, use the more specific \"counter tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counters"@en .

aat:300121380 a skos:Concept ;
    skos:definition "Ancient Roman cupboards, generally having a rectangular case, mounted on feet, with doors reaching approximately from top to bottom, a gabled or flat top, and interior shelving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armaria"@en .

aat:300121381 a skos:Concept ;
    skos:definition "Wooden kitchen sinks, especially of the 19th century, that are counter height, not connected to an external drain, often with a shallow zinc or tin-lined well on top in which a dishpan or basin can be placed, and usually a cupboard below. A dry sink is often not connected to an external water supply, however, some are mounted with a hand pump. For similar pieces of furniture located in bathrooms or bedrooms, intended for personal hygiene rather than washing dishes, use \"washstands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry sinks"@en .

aat:300121391 a skos:Concept ;
    skos:definition "Exact copies of an original object, usually in the same dimensions as the original, especially of books, documents, prints, and drawings. Today often reproduced photographically; in the past, reproduced by engraving or other printmaking process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facsimiles"@en .

aat:300121393 a skos:Concept ;
    skos:definition "Use when a valued object is made by the same artist, craftsman, or studio that created an original on which it is closely based, and when the resulting work shows some variation from the original. If little or no variation is apparent, use \"replicas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "versions"@en .

aat:300121402 a skos:Concept ;
    skos:definition "In the context of a collection of images or printed matter, refers to additional copies in the same format and medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duplicates"@en .

aat:300121408 a skos:Concept ;
    skos:definition "Describes the style and culture of a group of inhabitants of the New Britain Islands. The Tolai have a painted carving tradition, manifested both in many kinds of carvings, such as their well known bearded masks and headdresses. These masks and headdresses contain the front of human skulls, which are remodelled with a paste of parinarium nut, and decorated red, white, and black and have a crossbar meant to be held between the teeth of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tolai"@en .

aat:300121430 a skos:Concept ;
    skos:definition "Works of art created as a series, a popular genre since the late 19th century, especially in Minimal art of the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serial art"@en .

aat:300121438 a skos:Concept ;
    skos:definition "Works of art produced using the technology of copying machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copy art"@en .

aat:300121445 a skos:Concept ;
    skos:definition "Refers to works of art that unfold over time and that combine elements of theater and object-oriented art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performance art"@en .

aat:300121446 a skos:Concept ;
    skos:definition "Refers to works of art, first appearing in the late 1960s, that exploit the possibilities of compressed air, or the natural force of the wind, usually in association with plastic envelopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air art"@en .

aat:300121451 a skos:Concept ;
    skos:definition "Contemporary works of art, usually outdoors and on a grand scale, that surround or involve the participation of the viewer and that especially exploit or incorporate aspects of their sites. For such works that specifically manipulate the land itself, use \"earthworks (sculpture).\" For indoor installations that create surroundings that can be entered by the viewer, use \"environments (sculpture).\" For sculpture that is designed to be placed outdoors but is not especially site-specific, use \"outdoor sculpture.\" For art that utilizes natural physical forces, biological organisms and processes, and performance to illustrate, question, and explain ecological and environmental issues, use \"ecological art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental art"@en .

aat:300121460 a skos:Concept ;
    skos:definition "Visual works that utilize lasers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser art"@en .

aat:300121461 a skos:Concept ;
    skos:definition "Artwork featuring light as an artistic medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light art"@en .

aat:300121462 a skos:Concept ;
    skos:definition "Works produced by artists, often in post card format, specifically when intended to be mailed to other artists or to be displayed in an exhibition; may be unique works or multiples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail art"@en .

aat:300121481 a skos:Concept ;
    skos:definition "Ancient Roman sideboards, generally having a tablelike lower member and an upper member with shelving; used to display highly prized ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abaci"@en .

aat:300121482 a skos:Concept ;
    skos:definition "Sideboards usually for use in the dining room and typically of Italian or Italian-styled designs, generally having two or three cupboard doors and drawers in the frieze area; the bases are often molded and rest directly on the floor or on short feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credenzas"@en .

aat:300121499 a skos:Concept ;
    skos:definition "Desks that close by means of a flexible shutter of convex shape and composed of horizontal slats of wood. Distinguished from \"tambour desks\" which close by means of upright reeded or slatted shutters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolltop desks"@en .

aat:300121537 a skos:Concept ;
    skos:definition "Tea tables of various designs, having a raised edge or gallery to protect china against slipping off or other damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "china tables"@en .

aat:300121551 a skos:Concept ;
    skos:definition "Shaped extensions of backboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splashboards"@en .

aat:300121555 a skos:Concept ;
    skos:definition "Refers to the style of art inspired by the avant-garde literary movement among Spanish writers in France, Spain, and Latin America during the early 20th century. Founded by Chilean poet Vicente Huidobro, the movement emphasizes the personal and imaginary world over the naturalistic world through juxtaposed and often irrational but highly evocative imagery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Creationist"@en .

aat:300121558 a skos:Concept ;
    skos:definition "Refers to the flowering of literary, musical, and artistic creativity and production that was focused n the primarily African American neighborhood of Harlem in New York City in the 1920s. Artists of the movement were also active in Paris and other cities. The movement radically revitalized the cultural aspirations and confidence of African Americans by exploring the psychological and emotional uniqueness of the African American community through art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Harlem Renaissance"@en .

aat:300121571 a skos:Concept ;
    skos:definition "Refers to the style of art designating the native Malay culture, featuring influences and cross-currents from Siamese, Javanese, Chinese, and Sumatran cultures. The style also features Hindu Indian and Islamic elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malayan"@en .

aat:300121598 a skos:Concept ;
    skos:definition "Ball feet with small collars at their bases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turnip feet"@en .

aat:300121599 a skos:Concept ;
    skos:definition "Feet formed by cutting sections from sideboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bootjack feet"@en .

aat:300121617 a skos:Concept ;
    skos:definition "Pointed and elongated feet found mostly on Queen Anne furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipper feet"@en .

aat:300121622 a skos:Concept ;
    skos:definition "X-shaped legs based on Roman chair design, used on Federal and other classically inspired furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curule legs"@en .

aat:300121626 a skos:Concept ;
    skos:definition "Chair seats that are rounded in the front and which sometimes have incurving sides, forming an outline like a horseshoe; most popular in America between the 1730s and 1760s, although in many areas persisting into the Federal period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass seats"@en .

aat:300121663 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of Malaita Island. The people of Malaita are known for creating figures that combined human and animal characteristics, such as a shark with human limbs. Although the Malaita people created the figures in this manner, the general style in the southern islands was more naturalistic in human proportions and features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malaita"@en .

aat:300121765 a skos:Concept ;
    skos:definition "Persons to whom anything is dedicated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dedicatees"@en .

aat:300121766 a skos:Concept ;
    skos:definition "People who assemble items of information into reference works such as dictionaries and encyclopedias, typically by selecting and putting together matter from the works of various persons or bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compilers"@en .

aat:300121785 a skos:Concept ;
    skos:definition "Persons who assign or address a work of art or literature, in a style less formal than that of a dedication; also, persons who mark a surface with words or characters, especially in a durable or conspicuous way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inscribers"@en .

aat:300121793 a skos:Concept ;
    skos:definition "Use with reference to the collective actions and objectives of Modernist architecture, especially, but not exclusively, of the International Style. For art, architecture, or design more generally, use \"Modernist.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modern Movement"@en .

aat:300121802 a skos:Concept ;
    skos:definition "Presses for expressing oil from nuts, olives, seeds, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil presses"@en .

aat:300121807 a skos:Concept ;
    skos:definition "Engaging in business transactions in the anticipation of profit from changes in the economic situation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speculating"@en .

aat:300121812 a skos:Concept ;
    skos:definition "Conditions caused under certain climatic situations that result in heat loss and unwanted heat flow in rooms and spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal bridges"@en .

aat:300121827 a skos:Concept ;
    skos:definition "Windows formed by pieces of glass set into lead cames. While the glass may be colored, uncolored, or clear, the more specific \"stained-glass windows\" is typically used for windows in which all or most of the glass is colored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leadlights"@en .

aat:300121918 a skos:Concept ;
    skos:definition "General term that groups all structures built for the purpose of industry. For buildings or groups of buildings intended to house the machinery and activities associated with modern industry and machine manufacture that arose after the Industrial Revolution, beginning in the mid-19th century, use \"industrial buildings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial structures"@en .

aat:300121919 a skos:Concept ;
    skos:definition "Built works used for arts and public performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performing arts structures"@en .

aat:300121943 a skos:Concept ;
    skos:definition "Havng the form or outline of an egg, that is of an oval with only one with axis of symmetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg-shaped"@en .

aat:300121959 a skos:Concept ;
    skos:definition "A curving fluted pattern; common on Roman sarcophagi and in Neoclassical ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strigillation"@en .

aat:300121961 a skos:Concept ;
    skos:definition "Use in relation to something that is facing the viewer. For the sense of being situated at or relating to the front or forward part of something, use \"front.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontal"@en .

aat:300121967 a skos:Concept ;
    skos:definition "Positional attribute used to describe something situated at or near the lowest or deepest part of an object. For the noun denoting these parts of objects, use \"bottoms\" from the Components hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottom"@en .

aat:300121968 a skos:Concept ;
    skos:definition "Positional attribute used to describe something situated at or near the highest or loftiest part of something. To refer to those highest or loftiest parts, use \"tops (portions)\" from the Components hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top"@en .

aat:300121969 a skos:Concept ;
    skos:definition "Forms or outlines having a degree of curvature approximating that of a circle or sphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round"@en .

aat:300121970 a skos:Concept ;
    skos:definition "Characteristics of the layout of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building plan attributes"@en .

aat:300121971 a skos:Concept ;
    skos:definition "Plan for a building or city that is arranged longitudinally along an axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axial plan"@en .

aat:300121975 a skos:Concept ;
    skos:definition "Plan of a building or city that radiates from a central point, often symmetrical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "central plan"@en .

aat:300121980 a skos:Concept ;
    skos:definition "Plan of a building or city that is shaped like a Greek cross, with a square central mass and four arms of equal length. The Greek cross plan was widely used in Byzantine architecture and in Western churches inspired by Byzantine examples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek cross plan"@en .

aat:300121984 a skos:Concept ;
    skos:definition "Plan of buildings and cities in the shape of a Latin cross, having three short arms and one long arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin cross plan"@en .

aat:300121987 a skos:Concept ;
    skos:definition "Plan of a building or city that is arranged to most conveniently accommodate the flow of traffic, activities, or work that goes on inside it, instead of along an axis or radiating from a central point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open plan"@en .

aat:300121990 a skos:Concept ;
    skos:definition "Forms or outlines consisting of a curved line that winds or meanders in multiple directions but does not cross or intersect itself. An example is when describing furniture pieces, the fronts of which are shaped in alternating concave and convex curves. For other features, such as arches or moldings, composed of flowing, wavelike curves, use \"undulating.\" For features consisting of or bounded by curved lines in general use \"curvilinear.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentine"@en .

aat:300121993 a skos:Concept ;
    skos:definition "Dimensions of a work that are the size of life, or, with reference to visual representations of something, equal in size to the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life-size"@en .

aat:300121995 a skos:Concept ;
    skos:definition "Use to describe objects and beings of a reduced size or scale compared to the average or normal range for its kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature"@en .

aat:300122124 a skos:Concept ;
    skos:definition "Generally very small barns comprised of one or more cribs or pens, constructed of small-diameter, rough-hewn logs serving various functions, such as food or equipment storage or animal shelter. For similar small wooden structures exclusively for storing corn, use \"corncribs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crib barns"@en .

aat:300122131 a skos:Concept ;
    skos:definition "Barns built into hillsides and generally characterized by stone end walls and a ramp up to a second floor containing crops and machinery which overhangs, on the barnyard side, a first floor kept for livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pennsylvania bank barns"@en .

aat:300122138 a skos:Concept ;
    skos:definition "Industrial structures specifically used for drilling purposes, such as those used for oil drilling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drilling structures"@en .

aat:300122139 a skos:Concept ;
    skos:definition "Industrial structures used where metal is produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal works structures"@en .

aat:300122140 a skos:Concept ;
    skos:definition "Industrial structures found in yards where ships are repaired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipyard structures"@en .

aat:300122142 a skos:Concept ;
    skos:definition "Drilling structures designed to haul the, drill, lengths of pipe and drill bit in and out of a hole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drilling rigs"@en .

aat:300122143 a skos:Concept ;
    skos:definition "Large oil rigs built on the ocean, used to harness oil below the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offshore rigs"@en .

aat:300122180 a skos:Concept ;
    skos:definition "Designates usually slight and often temporary structures erected for the display or sale of merchandise or at which business is conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stands"@en .

aat:300122183 a skos:Concept ;
    skos:definition "Buildings housing businesses that comprise a series of stores which belong to one firm, and sell the same type of merchandise. Series of stores which belong to one firm, and sell the same type of merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain stores"@en .

aat:300122187 a skos:Concept ;
    skos:definition "Built works used for the purposes of communications, including telecommunications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communications structures"@en .

aat:300122195 a skos:Concept ;
    skos:definition "Detached houses designed for or used exclusively by one family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-family dwellings"@en .

aat:300122208 a skos:Concept ;
    skos:definition "Ceremonial structures built for funerals or burials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary structures"@en .

aat:300122210 a skos:Concept ;
    skos:definition "Refers to the chief public administration buildings of a city, generally housing the mayor's office and legislative chambers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city halls"@en .

aat:300122216 a skos:Concept ;
    skos:definition "Buildings or complexes where people are detained for various reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detention complexes"@en .

aat:300122220 a skos:Concept ;
    skos:definition "Industrial structures found at textile mills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile mill structures"@en .

aat:300122241 a skos:Concept ;
    skos:definition "Articles or physical resources used to array, dress up, rig out, equip, or otherwise provide with what is requisite for efficient action by a person or animal or for a thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equipment"@en .

aat:300122263 a skos:Concept ;
    skos:definition "Built works used for purpose of recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreation structures"@en .

aat:300122264 a skos:Concept ;
    skos:definition "A subdivided residential, governmental, institutional, or commercial lot which contains no structures of a permanent or temporary nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacant lots"@en .

aat:300122265 a skos:Concept ;
    skos:definition "Designates the north-south streets used in laying out ancient Roman countryside tracts and associated towns and thus, by extension, the main north-south streets, distinguished by greater width and scale of appointments, of planned Roman towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardines"@en .

aat:300122283 a skos:Concept ;
    skos:definition "Crafted instruments used for scientific purposes and research, in all branches of science."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific instruments"@en .

aat:300122339 a skos:Concept ;
    skos:definition "Tools, equipment, and supplies originally created for capturing terrestrial animals by any means other than weaponry. This subclass does not include objects used for the trapping of household pests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trapping equipment"@en .

aat:300122438 a skos:Concept ;
    skos:definition "Open spaces used for the movement of people or things from once place to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation spaces"@en .

aat:300122621 a skos:Concept ;
    skos:definition "Colored crayons or chalk-like sticks that consist of finely ground pigments mixed with a small amount of a water-based binder, such as gum tragacanth or, from the mid-20th century, methyl cellulose. Used in drawing. Many pastels contain pure pigments producing intense, deep colors; lighter colors are diluted with an inert filler (chalk, gypsum, talc, kaolin, etc.). Pastels produce a powdery, easily smudged drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastels"@en .

aat:300122664 a skos:Concept ;
    skos:definition "Refers to the movement in European painting begun circa 1918 as a response to the decorative quality in Cubism and characterized by clear, delineated geometric forms and pure color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Purist"@en .

aat:300122684 a skos:Concept ;
    skos:definition "Settlement of disputes, especially between labor and management, by a neutral party authorized to appraise the facts and arguments and make a decision binding upon the disputants. Distinguished from \"mediation\" in which a neutral party proposes a solution but has no authority to make a binding decision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arbitration"@en .

aat:300122715 a skos:Concept ;
    skos:definition "Communities of modest size that have tourism as an important industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourist towns"@en .

aat:300122717 a skos:Concept ;
    skos:definition "Refers to the French artistic and literary movement founded in 1908 by Jules Roman that influenced the Abbaye, a community of young artists and writers living in Paris. The movement is characterized by an emphasis on group consciousness and collective emotion and the need for the artist's work to reflect this experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unanimist"@en .

aat:300122723 a skos:Concept ;
    skos:definition "Creative work in which is sought the unification of many art forms, including those from the visual, decorative, and performing arts, into a single total work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gesamtkunstwerk"@en .

aat:300122729 a skos:Concept ;
    skos:definition "The application of modern scientific and technical methods to the interpretation of archaeological remains, for example the dating of specimens through scientific techniques such as radiocarbon dating and amino-acid dating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeometry"@en .

aat:300122734 a skos:Concept ;
    skos:definition "Piercing or dividing by passing through or across something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intersecting"@en .

aat:300122745 a skos:Concept ;
    skos:definition "Branch of Symbolist movement and style inspired by and borrowing from Rosicrucian philosophy, traditions, and allegory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosicrucian"@en .

aat:300122751 a skos:Concept ;
    skos:definition "Refers to the style and movement founded by Leon Chwistek in the 1920s after the disintegration of the Formists and is based on the philosophical theory of painting that entails the grouping of elements of similar shape and color into 'zones'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zonist"@en .

aat:300122754 a skos:Concept ;
    skos:definition "A painting trend of the late 19th century related to Symbolism, sharing that movement's engagement with emotions and ideas represented in a concrete allegorical style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gedankenmalerei"@en .

aat:300122757 a skos:Concept ;
    skos:definition "Refers to the style and movement in Italy during the 1930s and early 1940s promulgated in the Manifesto dell' Aeropittura (1929) by artists such as Giacomo Balla, Gerardo Dottori, and Tato, and which emanated from a second wave of Futurism. The movement, more fascinated with the dynamics of motion, engaged in naturalistic representations of landscapes as seen from extreme angles of perspective and motion, abstract depictions of circles, spirals, and intersecting shapes symbolizing motion, and manipulated media and artistic forms to create analogies for movement as evidenced by the turbulent plunge to the earth represented by rotating circular forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aeropittura"@en .

aat:300122761 a skos:Concept ;
    skos:definition "Refers to the style and movement in Italian literature and art that flourished in Milan between 1860 and 1870. The style is based on a spirited rebellion against middle-class values and complacency. Painters working in this style, such as Filippo Carcano, Eugenio Gignous, and Luigi Conconi, emphasized softened contours, open brushwork, impasto, an evocative fusion of figure and background, and an interplay of colors that exemplified the movement's philosophy of fusion of the arts. Early works in this style favored portraiture of nobility or literary figures, while later works in this style served as a prelude to Symbolist works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scapigliatura"@en .

aat:300122762 a skos:Concept ;
    skos:definition "Refers to the movement and style based on Filippo Tommaso Marinetti's Manifesto del tattilismo, written in 1921, advocating 'tactile harmonies' and a spiritual and tangible connection between the artist and the audience. The movement influenced dance, visual arts, theatre, photography, and cinematography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tactilist"@en .

aat:300122766 a skos:Concept ;
    skos:definition "Use with reference to certain Italian sculpture of the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Verismo"@en .

aat:300122772 a skos:Concept ;
    skos:definition "Refers to the style and movement in painting and set design conceived by Uruguayan-born painter and theatre stage designer Rafael Barradas as a reaction to Futurist principles and ideas. The movement emphasized the vibrating, shimmering quality of surfaces and flat planes through manipulated color and light. The style later influenced the works of filmmaker Luis Buñuel and painter Salvador Dalí."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vibrationist"@en .

aat:300122943 a skos:Concept ;
    skos:definition "Persons engaged in professional or voluntary service of a specialized nature concerned with community welfare and family or social problems such as arise from poverty, mental or physical handicaps, or maladjustment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social workers"@en .

aat:300122946 a skos:Concept ;
    skos:definition "Those who study aging and the special capabilities and problems of the elderly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gerontologists"@en .

aat:300122949 a skos:Concept ;
    skos:definition "Members of a band of musicians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandmembers"@en .

aat:300122956 a skos:Concept ;
    skos:definition "Judical magistrates of low rank with jurisdiction over minor criminal offences and some civil matters prescribed by statute, such as the performance of marriages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "justices of the peace"@en .

aat:300122959 a skos:Concept ;
    skos:definition "Officers ranking below the office of president in a government or organization, and designated to act as president in case of that officer's absence or disability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vice-presidents"@en .

aat:300122999 a skos:Concept ;
    skos:definition "Floors which span the entire distance between end supports without additional intermediate support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspended floors"@en .

aat:300123013 a skos:Concept ;
    skos:definition "Lettered notices or other displays that bear names, directions, warnings, advertisements, or symbols that are displayed or posted for public view. For smaller, less public identifying notices, use \"labels (identifying artifacts).\" For systems of signs arranged to communicate directions or essential information, use \"signage.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signs"@en .

aat:300123016 a skos:Concept ;
    skos:definition "Books, whether unique items or multiples, made or conceived by artists, including commercial publications (usually in limited editions), as well as unique items formed or arranged by the artist. For texts written by artists for the sake of their informational content, use \"writings.\" For artists' books that emphasize the physical book as a work of art rather than the content, use \"bookworks.\" For works that look like or incorporate books but do not communicate in the ways characteristic of books, see \"book objects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' books"@en .

aat:300123017 a skos:Concept ;
    skos:definition "Barriers used to close sluices, which are artificial passages for water fitted with a valve or gate for stopping or regulating the flow. Often taking the form of a \"wicket (architectural element),\" which is a gate or door set into a larger gate or door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sluice gates"@en .

aat:300123034 a skos:Concept ;
    skos:definition "Forming or arranging in layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "layering"@en .

aat:300123036 a skos:Concept ;
    skos:definition "Objects, or representations of objects, symbolizing and suggesting other objects or ideas, especially by clear natural aptness or association, such as a balance as an emblem of justice. For allegorical pictures with mottoes, use \"emblems (allegorical pictures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emblems"@en .

aat:300123040 a skos:Concept ;
    skos:definition "Allegorical pictures, often inscribed with mottoes, common especially in Europe in the 16th and 17th centuries. Emblems combine both words and images, the interpretation of which requires intellectual effort and results in the communication of a moral lesson. For the simpler symbol that represents an idea, use \"emblems (symbols).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emblems"@en .

aat:300123042 a skos:Concept ;
    skos:definition "Devices that signify an individual rather than a family or organization, usually composed of a design and a motto, popular especially in the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impresas"@en .

aat:300123224 a skos:Concept ;
    skos:definition "Cartoons which act as visual satire, combining exaggerated caricature with political statements. The form became popular in French graphic art during the 19th century, particularly with artist Honoré Daumier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political cartoons"@en .

aat:300123227 a skos:Concept ;
    skos:definition "Refers to anything inserted into a larger whole, as a piece of cloth to a garment or a replaced portion of a drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inserts"@en .

aat:300123305 a skos:Concept ;
    skos:definition "Pictorial representations using circles and squares so positioned as to represent an operation in set theory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venn diagrams"@en .

aat:300123316 a skos:Concept ;
    skos:definition "Components which are broad, limber, or flat, usually hanging or working on a hinge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flaps"@en .

aat:300123319 a skos:Concept ;
    skos:definition "Refers to side views of figures, especially when a clear outline is emphasized. For certain orthographic drawings of objects or structures, use \"profiles (orthographic projections).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "profiles"@en .

aat:300123430 a skos:Concept ;
    skos:definition "Pictorial images, usually drawings, that are humorous or that use wit and satire to comment on contemporary events, social habits, political trends, or other topical subjects, often executed in a broad or abbreviated manner. Originally referred to full-page illustrations in a circulating paper or periodical, especially when comical and relating to current events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartoons"@en .

aat:300123431 a skos:Concept ;
    skos:definition "Cartoons that express editorial opinions, usually by appearing on the editorial pages of a newspaper or periodical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "editorial cartoons"@en .

aat:300123562 a skos:Concept ;
    skos:definition "Refers to massively large stones, especially those very roughly worked or left as found; used in various ancient monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megaliths"@en .

aat:300123571 a skos:Concept ;
    skos:definition "Siding in which joints between vertically placed boards are covered by narrow strips of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board and batten"@en .

aat:300123578 a skos:Concept ;
    skos:definition "Picking out or choosing in preference to another or others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selection"@en .

aat:300123582 a skos:Concept ;
    skos:definition "Extended horizontal bands decorating architecture, furniture, or other objects and containing figures, scenes, inscriptions, or ornamental motifs. For the specific parts of classical entablatures, see \"friezes (entablature components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friezes"@en .

aat:300123627 a skos:Concept ;
    skos:definition "Crafted instruments used for drawing and measuring, such as rulers, scales, protractors, pens, pencils, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing instruments"@en .

aat:300124033 a skos:Concept ;
    skos:definition "Elements of low conductivity placed between two conductive materials to limit heat flow; for use in metal windows of curtain walls that are to be used in cold climates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal breaks"@en .

aat:300124063 a skos:Concept ;
    skos:definition "Illustrations used to elucidate informational texts such as reference works and technical manuals, or to explain a process or concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical illustrations"@en .

aat:300124083 a skos:Concept ;
    skos:definition "Concepts related to perception of what is ideal or beautiful."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aesthetic concepts"@en .

aat:300124094 a skos:Concept ;
    skos:definition "Use with regard to legal protection for the work of visual artists, including copyright, protection from mutilation, and royalty payments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' rights"@en .

aat:300124096 a skos:Concept ;
    skos:definition "To change into glass or a glassy substance by heat and fusion; especially to produce, as in ceramics, close crystallization by high firing to make the substance nonporous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitrification"@en .

aat:300124098 a skos:Concept ;
    skos:definition "The process of studying and interpreting the land surface and subsurface conditions of a geographical area using, for example, aerial photography or computer models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrain analysis"@en .

aat:300124108 a skos:Concept ;
    skos:definition "Development practice whereby developers contribute toward new urban improvements, such as affordable housing or child care facilities, in return for concessions on new in-town developments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linkage"@en .

aat:300124111 a skos:Concept ;
    skos:definition "Brick produced by a process of forming wet clay in molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft-mud brick"@en .

aat:300124112 a skos:Concept ;
    skos:definition "Gardens designed for children, to teach them about ecology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's gardens"@en .

aat:300124114 a skos:Concept ;
    skos:definition "Large low narrow containers for supplying water to livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watering troughs"@en .

aat:300124117 a skos:Concept ;
    skos:definition "Material derived from plants or any part of a plant, whether in raw form or processed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant material"@en .

aat:300124118 a skos:Concept ;
    skos:definition "A boat propelled by steam power; especially one designed for river or coastal travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steamboats"@en .

aat:300124122 a skos:Concept ;
    skos:definition "Use with reference to the multifunctional or multipurpose nature of a built work; especially to describe those building types that are flexible enough to serve a wide variety of activities, such as gymnasiums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiuse"@en .

aat:300124127 a skos:Concept ;
    skos:definition "Brick made of clay mixed with only enough water to produce plasticity, and extruded through a die."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stiff-mud brick"@en .

aat:300124132 a skos:Concept ;
    skos:definition "Area of information management concerned with achieving economy and efficiency in the creation, use, handling, control, maintenance, and disposition of records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "records management"@en .

aat:300124160 a skos:Concept ;
    skos:definition "Concept in early 20th-century visual art, theater, and literature regarding the expression of multiple awareness of things happening in different places at the same time or extended in time, challenging the traditional idea of unity of time, action, and place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simultaneism"@en .

aat:300124171 a skos:Concept ;
    skos:definition "A key concept for Futurist artists concerning the representation of movement and the persistence of images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamism"@en .

aat:300124173 a skos:Concept ;
    skos:definition "A concept of art important to the Symbolist painters and opposed to academic idealism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ideism"@en .

aat:300124200 a skos:Concept ;
    skos:definition "Paint that dries to a surface substantially free from gloss or sheen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat paint"@en .

aat:300124267 a skos:Concept ;
    skos:definition "Visual boundaries of a form, without regard to internal features; distinct from a \"contour,\" which may bound a form within an outline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outlines"@en .

aat:300124411 a skos:Concept ;
    skos:definition "Highly simplified or conventionalized pictures that stand for the thing pictured; may be used as writing signs corresponding to individual words or phonetic elements in a language. Use also for certain prehistoric pictures and linear designs whose meanings are uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictographs"@en .

aat:300124499 a skos:Concept ;
    skos:definition "Private bills brought from the House of Lords to the House of Commons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "House of Lords bills"@en .

aat:300124515 a skos:Concept ;
    skos:definition "Refers to photographs or other representations of the exterior of a building or other structure or object that has interior and exterior spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior views"@en .

aat:300124520 a skos:Concept ;
    skos:definition "Refers to photographs or other representations of the inside of a building or other structure or object that has interior and exterior space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior views"@en .

aat:300124525 a skos:Concept ;
    skos:definition "Portraits depicting two or more individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "group portraits"@en .

aat:300124534 a skos:Concept ;
    skos:definition "Works in which someone produces a likeness of himself or herself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-portraits"@en .

aat:300124574 a skos:Concept ;
    skos:definition "Includes finding aids that give a general account of the holdings of one or more archives, including background history, usually arranged by record group, thereunder by series; also, finding aids that describe the holdings of one or more archives relating to particular subjects or to specified types of documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival guides"@en .

aat:300124640 a skos:Concept ;
    skos:definition "Colors without hue: black, white, and the grays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutrals"@en .

aat:300124707 a skos:Concept ;
    skos:definition "Hue name for the range of colors intermediate between red and white, often a pale red, sometimes with a slight purple or yellow tinge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pink"@en .

aat:300124708 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of pink colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vivid pink"@en .

aat:300124714 a skos:Concept ;
    skos:definition "Draftsmen who execute technical drawings from others' designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "delineators"@en .

aat:300124728 a skos:Concept ;
    skos:definition "Structures under tensile loads, such as cable or membrane structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tensile structures"@en .

aat:300124733 a skos:Concept ;
    skos:definition "Change in one or more of various socioeconomic and biophysical characteristics of a given environment as a result of site development or new government regulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental impact"@en .

aat:300124737 a skos:Concept ;
    skos:definition "Designates licensed bookmaking establishments that take off-track bets, especially with relation to horse racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "betting parlors"@en .

aat:300124741 a skos:Concept ;
    skos:definition "Buildings that are constructed consciously in violation of building and zoning codes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illegal buildings"@en .

aat:300124744 a skos:Concept ;
    skos:definition "The study and application of medical knowledge to questions of civil and criminal law, especially in court proceedings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forensic medicine"@en .

aat:300124775 a skos:Concept ;
    skos:definition "Copies of images or objects on a smaller scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reductions"@en .

aat:300124780 a skos:Concept ;
    skos:definition "Swinging doors or flexible barriers which may be closed across stairs, doorways, or other indoor circulation points to restrain the free movement of dogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog gates"@en .

aat:300124782 a skos:Concept ;
    skos:definition "Designates a framework of open bins filled with rocks or other pervious materials and used as retaining walls or to support a construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cribbing"@en .

aat:300124785 a skos:Concept ;
    skos:definition "Rooms in banks open to the public for doing business and generally containing the tellers' stations, writing desks, and sometimes also officers' platforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banking rooms"@en .

aat:300124793 a skos:Concept ;
    skos:definition "Public accomodations having an orderly array of individual cabins set alongside a highway and having an internal system of driveways, parking spaces, and a clearly visible and distinctly articulated office near the complex's entrance; especially popular in the United States from the late 1920s to the early 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motor courts"@en .

aat:300124808 a skos:Concept ;
    skos:definition "Vessels holding or intended to hold the ashes of cremated bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cremation urns"@en .

aat:300124818 a skos:Concept ;
    skos:definition "Series of seats, usually three in number, or a bench, and rarely only one seat, either movable or recessed in the wall and crowned with canopies, pinnacles, and other enrichments, usually placed on the south side of the choir near the altar for the officiating clergy: celebrant, deacon, and sub-deacon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sedilia"@en .

aat:300124822 a skos:Concept ;
    skos:definition "Buildings that house archives, which are institutions that store, maintain, and care for non-active public records or other important historical documents. The facilities typically include shelves and drawers for storage of boxes, folders, and other containers or documents; areas of the facility may be climate controlled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archives"@en .

aat:300124834 a skos:Concept ;
    skos:definition "Refers to views taken from a distance, typically showing the overall layout, design, or plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distant views"@en .

aat:300124990 a skos:Concept ;
    skos:definition "Objects collected by fanciers, such as toys, miniatures, spoons, or various other items, but generally not applied to collections of art, stamps, coins, or furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectibles"@en .

aat:300125441 a skos:Concept ;
    skos:definition "Refers to maps representing relatively large regions, such as countries or continents, on a small scale. Chorographic maps may include the natural configuration and features of a region, in addition to political boundaries and major towns. They are distinct from \"topographic maps,\" which depict a smaller area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chorographic maps"@en .

aat:300125446 a skos:Concept ;
    skos:definition "Ships equipped with sails as their primary means of propulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailing ships"@en .

aat:300125456 a skos:Concept ;
    skos:definition "Oared fighting ships, principally of the Mediterranean, in operation from the Early Bronze Age until the 18th century CE; most commonly with numerous oars on one or several decks and equipped with a ram with which to damage and sink enemy vessels. For post-18th century steamships equipped with an armored prow as a primary weapon, use \"rams.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleys"@en .

aat:300125457 a skos:Concept ;
    skos:definition "Ancient warships propelled by oarsmen arranged on three levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triremes"@en .

aat:300125459 a skos:Concept ;
    skos:definition "Any of various devices or machines for cutting or shaping food or expressing liquids from food by means of applied pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presses"@en .

aat:300125467 a skos:Concept ;
    skos:definition "Toothed wheels, cones, or cylinders, or other machined elements that are designed to mesh with other similarly toothed elements for purposes which include the transmission of power and the change of speed or direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gears"@en .

aat:300125479 a skos:Concept ;
    skos:definition "The vernacular building technique in which the spaces between the heavy supporting timbers are filled with brick, wattle and daub, or other material. The term is also used to describe buildings with a false-timber frame attached to the outside wall to give the appearance of half-timber construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-timber construction"@en .

aat:300125571 a skos:Concept ;
    skos:definition "Sections of hospitals which which provide care for women during pregnancy and childbirth, as well as care for newborn infants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maternity wards"@en .

aat:300125627 a skos:Concept ;
    skos:definition "General term for equipment used for processing of data for analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data processing equipment"@en .

aat:300125738 a skos:Concept ;
    skos:definition "Ornaments in the form of finials that surmount roof hips or gables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hip knobs"@en .

aat:300125739 a skos:Concept ;
    skos:definition "Adornments found on the terminating points of roof ridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "épis"@en .

aat:300125741 a skos:Concept ;
    skos:definition "Roof systems in which the cross framing members are some form of light wood truss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trussed rafter roofs"@en .

aat:300125743 a skos:Concept ;
    skos:definition "Designates light, wood, roof trusses, usually prefabricated and often used in residential construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trussed rafters"@en .

aat:300125766 a skos:Concept ;
    skos:definition "Buildings or complexes constructed for or serving agricultural purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural complexes"@en .

aat:300125768 a skos:Concept ;
    skos:definition "Areas designated for transportation related to aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air transportation spaces"@en .

aat:300125933 a skos:Concept ;
    skos:definition "Chairs or thrones of a bishop in his cathedral church, in which he presides at solemn functions. The form is based on the ancient Roman cathedra. Originally the bishop's cathedra stood in the center of the apse, flanked at a lower level on either side by the benches where the assisting priests sat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedrae"@en .

aat:300126038 a skos:Concept ;
    skos:definition "The study of individual geological structures such as anticlines, thrust vaults, and lineations. For the study of larger-scale units of the earth's crust, use \"tectonics (geology).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural geology"@en .

aat:300126045 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of pink colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strong pink"@en .

