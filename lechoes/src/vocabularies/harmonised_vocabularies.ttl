        "Zampogna"@it,
        "Zampogna"@nl,
        "Zukra"@pl,
        "Zampogna"@sv,
        "Zampogna"@zh .

mimo:3784 a skos:Concept ;
    skos:altLabel "Mashq"@zh,
        "Souqqarah"@zh ;
    skos:definition "The zukra (zokra, zoughara, Arabic: زكرة) is a Libyan bagpipe with a double-chanter terminating in two cow horns; it is similar in construction to the Tunisian mizwad. The instrument is played as a bagpipe in the south and west of Libya, but played by mouth without a bag in the east. The instrument is played at feasts, weddings, and funerals."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Zukra"@ca,
        "Zukra"@de,
        "Zukra"@en,
