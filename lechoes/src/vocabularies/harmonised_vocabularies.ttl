aat:300446935 a skos:Concept ;
    skos:definition "In Indian architecture, a niche frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parikarma"@en .

aat:300446936 a skos:Concept ;
    skos:definition "In Indian architecture, a niche on the karṇa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karṇakōṣṭha"@en .

aat:300446937 a skos:Concept ;
    skos:definition "In Indian architecture, a niche with pañjara top."@en ;
