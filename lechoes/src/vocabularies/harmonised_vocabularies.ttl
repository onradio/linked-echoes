    skos:inScheme lev:aat ;
    skos:prefLabel "citra-tōraṇa"@en .

aat:300446963 a skos:Concept ;
    skos:definition "In Indian architecture, a ornamented frieze; carved band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śōbhāpaṭṭikā"@en .

aat:300446964 a skos:Concept ;
    skos:definition "In Indian architecture, an ornate ceiling type with deep concentric cusped-and-coffered courses or bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nābhicchanda"@en .

aat:300446965 a skos:Concept ;
    skos:definition "In Indian architecture, a ornate frame or niche."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khattaka"@en .

