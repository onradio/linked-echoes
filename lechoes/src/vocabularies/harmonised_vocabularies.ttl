        "kaftan"@sr,
        "kaftan"@sv .

euf:10426 a skos:Concept ;
    skos:altLabel "Kostümentwurf"@de ;
    skos:definition "Has both a narrative and visual context. The narrative context is the creation of the people in the screenplay and the actualization of fictional characters through the dramatic arc of the story. The visual context is placing these people in the designed and constructed world created by the production designer and the cinematographer. The motion picture must achieve a visual cohesion of people and place to best support the screenplay. (UCLA)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kostümdesign"@de,
        "σχέδιο ενδύματος"@el,
        "costume design"@en,
        "diseño de vestuario"@es,
        "création de costume de film"@fr,
        "עיצוב תלבושות"@he,
        "attività del costumista"@it,
        "kostuumontwerp"@nl,
        "dizajn kostima"@sr,
        "dräkt design"@sv .

euf:10427 a skos:Concept ;
    skos:altLabel "application"@fr ;
    skos:definition "Technique of forming a design by applying cut out pieces of a material to a ground material; generally associated with needleworking, but also used in ceramics, leatherworking, woodworking, and metalworking (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Applikation (Technik)"@de,
        "appliqué (τεχνική)"@el,
        "appliqué (technique)"@en,
        "apliqué (técnica)"@es,
        "appliqué (technique)"@fr,
        "יישום (טכניקה)"@he,
        "appliqué (tecnica)"@it,
        "appliqué (techniek)"@nl,
        "appliqué (técnica)"@pt,
        "appliqué (tehnika)"@sr,
        "applikation (teknik)"@sv .

