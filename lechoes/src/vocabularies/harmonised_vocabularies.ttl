    skos:prefLabel "deep bluish green"@en .

aat:300128675 a skos:Concept ;
    skos:definition "Positive transparencies having gelatin as the binder, holding silver as the final image material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin silver transparencies"@en .

aat:300128678 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of bluish green colors."@en ;
