mimo:6809 a skos:Concept ;
    skos:altLabel "Washint (flute)"@en,
        "Washint (flûte)"@fr ;
    skos:definition "Washint (Amharic: ዋሽንት) is an end-blown wooden flute originally used in Ethiopia. Traditionally, Amharic musicians would pass on their oral history through song accompanied by the washint as well as the krar, a six stringed lyre, and the masenqo, a one string fiddle."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Washint"@ca,
        "Washint"@de,
        "Washint"@en,
