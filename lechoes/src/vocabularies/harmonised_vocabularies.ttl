        "paglia di sparto"@it,
        "esparto (vezel)"@nl,
        "esparto"@pt,
        "esparto trava"@sr,
        "espartogräs"@sv .

euf:10478 a skos:Concept ;
    skos:definition "Fiber derived from the stalk of the species Cannabis sativa. Fibers range from 1-2 m in length and are yellow to brown in color. They have a high cellulose content with little lignin. Hemp is lustrous, strong, and durable with good resistance to water, salts, light, and insects; used for cordage, fish lines, sailcloth, canvas, burlap, packing, and as a fiber for paper or for plastic filler (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Hanf"@de,
        "κάνναβη"@el,
        "hemp (fiber)"@en,
        "cáñamo"@es,
        "chanvre"@fr,
        "קנבוס"@he,
        "canapa"@it,
        "hennep (vezel)"@nl,
        "cânhamo"@pt,
        "konoplja"@sr,
        "hampa"@sv .

euf:10479 a skos:Concept ;
    skos:altLabel "paklinnen (vezel)"@nl ;
    skos:definition "Bast fiber derived from either of two East Indian plants (Corchorus olitorius and C. capsularis). The pale brown fibers are soft, lustrous, and coarse, ranging in length from 4 to 10 feet. The brittle fibers are used to produce a thread called hessian. Jute becomes so weak when wet that a thin twine can be broken by hand. It turns brown and degrades with time, sunlight, water, acids, alkalis, and bleach. Jute has been used since prehistoric times. It is used to make sackcloth, burlap cloth, gunnysacks, twine, paper, and carpet backing. It was also used to make brown paper in Europe in the mid-19th century (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Jute"@de,
        "γιούτα"@el,
        "jute (fiber)"@en,
        "yute"@es,
        "jute"@fr,
        "יוטה"@he,
        "juta"@it,
        "jute (vezel)"@nl,
        "juta"@pt,
        "juta"@sr,
        "jute"@sv .

euf:10480 a skos:Concept ;
    skos:definition "Bast fiber obtained from the stems of several varieties of the species Boehmeria nivea, native to tropical Asia but cultivated in China, Japan, Europe, South America, and the United States. The Ramie has been used in China for paper and fabric since prehistoric times. Its use spread through Europe in the Middle Ages. It is white or green in color, depending upon the variety. It is soft, fine, and durable fiber that is very lustrous and dyes well, used for twine, fishnets, sewing thread, and fabric for clothing, summer suits, dresses, canvas, tablecloths, and upholstery. Ramie has also been used to produce strong paper for linings, banknotes, and cigarettes (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Ramie"@de,
        "ραμί"@el,
        "ramie (fiber)"@en,
        "ramio"@es,
        "ramie"@fr,
        "סיבים מצמח הרמי"@he,
        "ramié"@it,
        "ramee (vezel)"@nl,
        "rami"@pt,
        "ramija"@sr,
        "rami"@sv .

euf:10481 a skos:Concept ;
    skos:altLabel "Kokosfaser"@de,
        "coir"@en,
        "coir fiber"@en,
        "סיבים מדשא סיני"@he ;
    skos:definition "Stiff, coarse, brown fibers derived from the outer bark of the fruit of the coconut palm, Cocos nucifera, used in making brushes, mats, cord, and coarse cloth. Coir is native to India and southeast Asia where it has been used since ancient times. It was introduced to Europe by Marco Polo in the 13th century (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kokosnussfaser"@de,
        "ίνες καρύδας"@el,
