    skos:altLabel "smocked"@en ;
    skos:definition "Refers to the process applied to a garment or other piece of fabric, comprising gathering tucks and working the tucks with a simple or decorative stitch (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "smocking (process)"@en,
        "nido de abejas (proceso)"@es,
        "smokken (handwerkprocedé)"@nl .

euf:11286 a skos:Concept ;
    skos:altLabel "stamped (marked)"@en,
        "estampado"@es,
        "gestempeld"@nl,
        "stempeldruk"@nl ;
    skos:definition "Marking the surface of an object by applying pressure with a tool, for example, transferring an ink mark to paper or embossing soft clay; also, applying preprinted labels such as postage stamps that substitute for official stamped marks. In bookbinding, distinguished from blocking , in which pressure is applied by a machine (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "stamping (marking)"@en,
        "estampación (marca)"@es,
        "estampage"@fr,
        "stempelen"@nl .

euf:11287 a skos:Concept ;
    skos:altLabel "blind stamped"@en,
        "blind-stamped"@en,
        "blind-stamping"@en,
        "impresión en frío"@es ;
    skos:definition "Impressing an image into a surface using a tool that is cut intaglio with a complete design, resulting in a relief image. In bookbinding, distinguished from blind blocking in which a machine is used instead of a hand tool (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "blind stamping"@en,
        "impresión en blanco"@es,
        "blinddruk"@nl .

