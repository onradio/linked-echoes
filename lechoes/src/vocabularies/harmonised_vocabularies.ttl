euf:10014 a skos:Concept ;
    skos:altLabel "Kleid"@de,
        "τήβεννος"@el,
        "robes"@en,
        "gewaden"@nl,
        "toga"@nl,
        "toga's"@nl,
        "kaftan"@sv,
        "rock"@sv ;
    skos:definition "Long, loose garments, which tend to be of one piece and to open down the front, cut with flowing lines; worn for ordinary wear by men and women during the Middle Ages and until the modern period, especially in Asian and African countries. Also, similar garments often of elegant style worn for ceremonial or official occasions or as a symbol of office or profession. Also, term used generally from the 18th century through the early 20th century for fashionable women's dress of varying form (AAT +)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Robe"@de,
        "κελεμπία"@el,
        "robe"@en,
        "toga"@es,
        "toge"@fr,
        "חלוק"@he,
        "toga"@it,
        "gewaad"@nl,
        "robe"@pt,
        "odora"@sr,
        "robe"@sv .

