    skos:inScheme lev:aat ;
    skos:prefLabel "maithuna"@en .

aat:300446408 a skos:Concept ;
    skos:definition "In Indian architecture, a constituent molding of a principal architectural member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anukāya"@en .

aat:300446409 a skos:Concept ;
    skos:definition "In Indian architecture, a coping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uṣṇīṣa"@en .

aat:300446410 a skos:Concept ;
