mimo:4215 a skos:Concept ;
    skos:altLabel "Bili"@zh,
        "Hichi-riki"@zh,
        "Hitschiriki"@zh,
        "Raita"@zh ;
    skos:definition "The hichiriki (篳篥) is a double reed Japanese fue (flute) used as one of two main melodic instruments in Japanese gagaku music. It is one of the \"sacred\" instruments and is often heard at Shinto weddings in Japan. Its sound is often described as haunting. According to scholars, the hichiriki emerged after the 12th century when the popularity of the Chinese melodies in Japan called tōgaku waned."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Hichiriki"@ca,
        "Hichiriki"@de,
        "Hichiriki"@en,
