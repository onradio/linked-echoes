aat:300446258 a skos:Concept ;
    skos:definition "In Indian architecture, a support in the form of a yakṣa figure supporting or feigning to support moldings of the superstructure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhāraputraka"@en .

aat:300446260 a skos:Concept ;
    skos:definition "In Indian architecture, an attendant, door-guardian figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pratihāra"@en .

aat:300446261 a skos:Concept ;
    skos:definition "In Indian architecture, a attic pillar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uccālaka"@en .

aat:300446262 a skos:Concept ;
    skos:definition "In Indian architecture, an audience hall, a hall for visitors and pilgrims in front of a temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "āsthāna-maṇḍapa"@en .

aat:300446263 a skos:Concept ;
    skos:definition "In Indian architecture, an aureole motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prabhāmaṇḍala"@en .

aat:300446264 a skos:Concept ;
    skos:definition "In Indian architecture, an auspicious couple motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mithuna"@en .

aat:300446265 a skos:Concept ;
    skos:definition "In Indian architecture, an auspicious jar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maṅgala-ghaṭa"@en .

aat:300446266 a skos:Concept ;
    skos:definition "In Indian architecture, in a wall division, an auxiliary offset section that is flanking the central offset wall division. An example is the wall-offset flanking the ratha (bhadra) in the Kaliṅga-style temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anuratha"@en .

aat:300446267 a skos:Concept ;
    skos:definition "In Indian architecture and art, an axe motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paraśu"@en .

aat:300446269 a skos:Concept ;
    skos:definition "In Indian architecture, an opening at the central offset of a temple or closed hall, such as a window or balcony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhadravalokana"@en .

aat:300446270 a skos:Concept ;
    skos:definition "In Indian architecture, a balustrade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pakṣaśilā"@en .

aat:300446271 a skos:Concept ;
    skos:definition "In Indian architecture, a bamboo-sheath/nodes; outer nodal sheath of curvilinear spire, usually showing karṇāṇḍakas/bhūmi-āmalakas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vēṇukōśa"@en .

aat:300446272 a skos:Concept ;
    skos:definition "The flower of the banana plant or plantain motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kadalipuṣpa"@en .

aat:300446273 a skos:Concept ;
    skos:definition "Flat surfaces with parallel sides, of more length than breadth, running across or around an object."@en ;
