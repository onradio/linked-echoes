    skos:inScheme lev:aat ;
    skos:prefLabel "nakulakas"@en .

aat:300446900 a skos:Concept ;
    skos:definition "In Indian culture, a monk's robe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saṅghāṭī"@en .

aat:300446901 a skos:Concept ;
    skos:definition "In Indian architecture, a monster with ram-head motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mēṣavyāla"@en .

aat:300446903 a skos:Concept ;
