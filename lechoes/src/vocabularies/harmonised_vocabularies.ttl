mimo:4792 a skos:Concept ;
    skos:altLabel "Gousli"@zh,
        "Nanga"@zh ;
    skos:definition "Kusle (Meadow Mari: кӱсле, Northwestern Mari: кӹсле or кӹслӓ) or karsh (Meadow and Northwestern Mari: кӓрш) is a Mari plucked string instrument (chordophone). It has 12-20 strings and is shaped like a semi-circle. The instrument is played in the lap, with both hands, and was played on some occasions such as ritual sacrifices, and to accompany dancing. Kusle is described as resembling the Russian gusli or the Finnish kantele."@en ;
    skos:inScheme lev:mimo ;
