    skos:inScheme lev:aat ;
    skos:prefLabel "sabhāmaṇḍapa"@en .

aat:300446958 a skos:Concept ;
    skos:definition "In Indian architecture, the opening at the central offset, such as a balcony or window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhadragavākṣa"@en .

