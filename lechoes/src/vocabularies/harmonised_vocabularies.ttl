mimo:2224 a skos:Concept ;
    skos:definition "The Telharmonium (also known as the Dynamophone) was an early electrical organ, developed by Thaddeus Cahill c. 1896 and patented in 1897. The electrical signal from the Telharmonium was transmitted over wires; it was heard on the receiving end by means of \"horn\" speakers. Like the later Hammond organ, the Telharmonium used tonewheels to generate musical sounds as electrical signals by additive synthesis. It is considered to be the first electromechanical musical instrument."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Telharmonium"@ca,
        "Telharmonium"@de,
        "Telharmonium"@en,
        "Telharmonium"@es,
        "Telharmonium"@fr,
        "Telharmonium"@it,
        "Telharmonium"@nl,
        "Telharmonium"@pl,
        "Telharmonium"@sv,
        "电传簧风琴"@zh .

mimo:2225 a skos:Concept ;
    skos:definition "The theremin (/ˈθɛrəmɪn/; originally known as the ætherphone/etherphone, thereminophone or termenvox/thereminvox) is an electronic musical instrument controlled without physical contact by the performer (who is known as a thereminist). It is named after its inventor, Leon Theremin, who patented the device in 1928."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Theremin"@ca,
        "Theremin"@de,
