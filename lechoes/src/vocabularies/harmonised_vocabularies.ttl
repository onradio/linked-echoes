        "boucle de ceinture"@fr,
        "אבזם"@he,
        "riemgesp"@nl,
        "Тока"@sr,
        "Bältesspänne"@sv .

euf:11336 a skos:Concept ;
    skos:altLabel "sweat shirts"@en,
        "sweatshirt"@en ;
    skos:definition "Loose-fitting garments for the upper body, often long-sleeved and collarless, of a soft, absorbent fabric such as cotton jersey, with ribbing at the collar, cuffs, and waistband. Made in pullover or cardigan style and sometimes hooded; often worn with sweat pants to form a sweat suit (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Sweatshirt"@de,
        "sweat shirt"@en,
        "Sudadera"@es,
        "sweat-shirt"@fr,
        "felpa"@it,
        "sweater"@nl .

