    skos:prefLabel "ardhacandra"@en .

aat:300446905 a skos:Concept ;
    skos:definition "In Indian architecture, a mortar-based pillar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ulukhalapāda"@en .

aat:300446906 a skos:Concept ;
    skos:definition "In Hinduism, mother-goddesses, seven in number."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mātṛkās"@en .

aat:300446908 a skos:Concept ;
    skos:definition "In Indian architecture, a moulded course."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paḍai"@en .

aat:300446909 a skos:Concept ;
    skos:definition "In Indian architecture, a moulded parapet; elevational set of mouldings separating jaṅghā from śikhara; baraṇḍa (Oriyā); elevational member separating wall frieze from the superstructure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "varaṇḍa"@en .

aat:300446910 a skos:Concept ;
    skos:definition "In Indian art and architecture, an animal vehicle, an animal or bird mount that carries a deity."@en ;
    skos:inScheme lev:aat ;
