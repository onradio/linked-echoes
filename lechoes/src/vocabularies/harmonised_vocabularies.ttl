    skos:prefLabel "gōpānasī"@en .

aat:300446377 a skos:Concept ;
    skos:definition "In Indian architecture, a circular temple (in basal configuration)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vṛttasaṁsthānaka"@en .

aat:300446378 a skos:Concept ;
