aat:300446916 a skos:Concept ;
    skos:definition "In Indian art or architecture, the motif of a nāga held as weapon or attribute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nāgāyudha"@en .

aat:300446917 a skos:Concept ;
    skos:definition "In Indian architecture, a nāga-based column-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nāgapāda"@en .

aat:300446920 a skos:Concept ;
    skos:definition "In Indian architecture, a Nandi-pavilion; Nandi-maṇḍapa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vṛṣa-maṇḍapa"@en .

aat:300446921 a skos:Concept ;
    skos:definition "In Indian architecture, a narrative episode (carved on decorative bands)."@en ;
    skos:inScheme lev:aat ;
