mimo:3245 a skos:Concept ;
    skos:altLabel "Guitare-luth"@fr ;
    skos:definition "A lute guitar or German lute (German: Gitarrenlaute, Deutsche Laute or Wandervogellaute, less commonly a lutar (modern Turkish), gui-lute or gittar) is a stringed musical instrument, common in Germany from around 1850. The instrument has a regular six-stringed guitar setup on a lute bowl, however there are many theorboed variants with up to 11 strings. (see de:Deutsche Basslaute) The instrument is associated with the Wandervogel countercultural movement in Germany in the first half of the 20th century."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Guitarra-llaüt"@ca,
        "Gitarrenlaute"@de,
        "Lute-guitar"@en,
        "Guitarra-laúd"@es,
        "Luth-guitare"@fr,
        "Chitarra-liuto"@it,
        "Luitgitaar"@nl,
        "Gitara lutniowa"@pl,
        "Lutgitarr"@sv,
        "琉特-吉他"@zh .

mimo:3247 a skos:Concept ;
    skos:definition "A musical instrument of the chordophone family, the lyre-guitar was a type of guitar shaped to look like a lyre, popular as a fad-instrument in the late 1800s. It had six single courses, with a fretboard located between two curved arms recalling the shape of the ancient Greek kithara. It was tuned and played like the conventional guitar. The lyre-guitar nearly always had a built-in pedestal allowing it to stand upright when not in use."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Guitarra-lira"@ca,
        "Lyragitarre"@de,
        "Lyre guitar"@en,
        "Guitarra-lira"@es,
        "Lyre guitare"@fr,
        "Lira-chitarra"@it,
        "Liergitaar"@nl,
        "Gitara-lira"@pl,
        "Lyrgitarr"@sv,
        "里尔吉他"@zh .

mimo:3248 a skos:Concept ;
    skos:definition "The machete (Portuguese: machete de braga) is a small stringed instrument from Madeira, Portugal. It has a double bulged body, traditionally made of wood, with a small rib and has four metallic strings, which depending on the region, may be attached by wooden pegs. Its slightly larger cousin, the machete de rajão, has five metal strings. Nowadays, it is not uncommon for the instrument to be made out of linden or poplar. Historians believe the machete was introduced in Madeira from Braga as a braguinha and subsequently brought to Hawaii by Portuguese immigrants in the late 19th century as a possible predecessor of the ukulele."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Machete"@ca,
        "Machete"@de,
        "Machete"@en,
        "Machete"@es,
        "Machete"@fr,
        "Machete"@it,
        "Machete"@nl,
        "Machete"@pl,
        "Machete"@sv,
        "马谢特"@zh .

mimo:3249 a skos:Concept ;
    skos:definition "The Portuguese guitar or Portuguese guitarra (Portuguese: guitarra portuguesa, pronounced [ɡiˈtaʁɐ puɾtuˈɣezɐ]) is a plucked string instrument with twelve steel strings, strung in six courses of two strings. It is one of the few musical instruments that still uses watch-key or Preston tuners. It is iconically associated with the musical genre known as Fado, and is now an icon for anything Portuguese."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Guitarra portuguesa"@ca,
        "Portugiesische Gitarre"@de,
        "Portuguese guitar"@en,
        "Guitarra portuguesa"@es,
        "Guitare portugaise"@fr,
        "Chitarra portoghese"@it,
        "Portugese gitaaar"@nl,
        "Gitara portugalska"@pl,
        "Portugisisk gitarr"@sv,
        "葡萄牙吉他"@zh .

mimo:3250 a skos:Concept ;
    skos:altLabel "Saw-dorang"@zh,
        "Ukelele"@zh ;
    skos:definition "The ukulele (/ˌjuːkəˈleɪli/ YOO-kə-LAY-lee; from Hawaiian: ʻukulele [ˈʔukuˈlɛlɛ], approximately OO-koo-LEH-leh), also called Uke, is a member of the lute family of instruments of Portuguese origin and popularized in Hawaii. It generally employs four nylon strings. The tone and volume of the instrument vary with size and construction. Ukuleles commonly come in four sizes: soprano, concert, tenor, and baritone."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Ukelele"@ca,
        "Ukulele"@de,
        "Ukulele"@en,
        "Ukelele"@es,
        "Ukulele"@fr,
        "Ukulele"@it,
        "Ukulele"@nl,
        "Ukulele"@pl,
        "Ukulele"@sv,
        "尤克里里"@zh .

mimo:3252 a skos:Concept ;
    skos:definition "The vihuela (Spanish pronunciation: [biˈwela]) is a 15th-century fretted plucked Spanish string instrument, shaped like a guitar (figure-of-eight form offering strength and portability) but tuned like a lute. It was used in 15th- and 16th-century Spain as the equivalent of the lute in Italy and has a large resultant repertory. There were usually five or six doubled strings."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Viola de mà"@ca,
        "Vihuela"@de,
        "Vihuela"@en,
        "Vihuela"@es,
        "Vihuela"@fr,
        "Vihuela"@it,
        "Vihuela"@nl,
        "Vihuela"@pl,
        "Vihuela"@sv,
        "比尤埃拉"@zh .

mimo:3254 a skos:Concept ;
    skos:definition "stringed instrument from West Africa"@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Arpes-llaüt"@ca,
        "Harfenlauten / Koras"@de,
        "Harp lutes / koras"@en,
        "Arpas-laúd"@es,
