    skos:prefLabel "textile working processes and techniques"@en,
        "procesos y técnicas de elaboración de textiles"@es,
        "textielbewerkingsprocedés en -technieken"@nl .

euf:11226 a skos:Concept ;
    skos:altLabel "knotted"@en,
        "geknoopt"@nl ;
    skos:definition "Describes the act of interlacing or tying linear material to form knots, which in succession can produce decorative patterns (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "knotting"@en,
        "anudado"@es,
        "nouage"@fr,
        "knopen"@nl .

euf:11227 a skos:Concept ;
    skos:altLabel "sewn (needleworking technique)"@en,
        "genaaid"@nl ;
    skos:definition "Refers to the process of joining, attaching, repairing, enclosing, securing, or decorating cloth, leather, or other flexible materials with thread, cord, or other filament by means of a needle or awl. Its meaning overlaps with stitching (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Nähen"@de,
        "ράψιμο"@el,
        "sewing (needleworking technique)"@en,
        "costura"@es,
        "couture"@fr,
        "תפירה"@he,
        "cucito"@it,
        "naaien (naaldwerkprocedé)"@nl,
        "costura"@pt,
        "Шивење"@sr,
        "sömnad"@sv .

euf:11228 a skos:Concept ;
    skos:altLabel "stitched (generic process)"@en,
        "gestikt"@nl ;
    skos:definition "Refers to the process of creating stitches, which are the portions of thread left in fabric or another material by the in and out movement of a threaded needle through the thickness or surface of the material, or the loops of thread created on a needle in knitting or other needlework. Stitching is used for fastening, joining, closing, uniting, mending, or creating ornamentation. Its meaning overlaps with sewing (needleworking technique) (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "stitching (generic process)"@en,
        "stikken (procedé)"@nl .

euf:11229 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "textile materials by process or technique"@en,
        "materiales textiles por proceso o técnica"@es,
        "textiles selon le processus ou la technique de fabrication"@fr,
        "textielmateriaal naar procedé of techniek"@nl .

euf:11230 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "textile weaving processes and techniques"@en,
        "procesos y técnicas del tejido"@es,
        "weefprocedés en -technieken (textiel)"@nl .

euf:11231 a skos:Concept ;
    skos:altLabel "vlakweefsel"@nl ;
    skos:definition "Weaving process in which no pile, hand-knotting, or hand-tufting is used, typically with reference to rugs, towels, or other textiles that typically may be expected to have a pile (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "flat-woven"@en,
        "tejido liso"@es,
        "vlakweven"@nl .

euf:11232 a skos:Concept ;
    skos:altLabel "kaartgeweven"@nl ;
    skos:definition "Weaving by means of warp twining on a tablet loom. Because the number of warp threads is limited by the number of tablets that can conveniently be operated, this method is normally used for narrow bands (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Brettchenweben"@de,
        "tablet weaving"@en,
        "tejido de cartones"@es,
        "tissage au carton"@fr,
        "tessitura a tavolette"@it,
        "kaartweven"@nl,
        "tecido por cartões"@pt,
        "brickvävning"@sv .

euf:11233 a skos:Concept ;
    skos:altLabel "kettingtwijngebonden"@nl ;
    skos:definition "Textile weaving technique in which two or more ends of the warp twist around each other as they interlace with the weft (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "warp twining"@en,
        "trenzado doble"@es,
        "kettingtwijnbinding"@nl .

euf:11234 a skos:Concept ;
    skos:altLabel "omwikkeld ingeslagen"@nl ;
    skos:definition "Progressive encircling or wrapping of warp ends by the weft. If the weft, in addition to encircling one or more ends, passes through a loop of its own part, forming a knot, prefer knotting (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "weft wrapping"@en,
        "trama envolvente"@es,
        "omwikkelde inslag"@nl .

euf:11235 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "textile weaving techniques by patterning"@en,
        "técnicas de tejido: diseños"@es,
        "weeftechnieken: patroonvorming (textiel)"@nl .

euf:11236 a skos:Concept ;
    skos:definition "Textile weaving technique in which a pattern is formed or the ground enriched by the use of more than one series of warp ends; the patterning is done using either a supplementary or complementary warp (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "warp patterning"@en,
        "efecto de urdimbre"@es,
        "schering en inslag"@nl .

euf:11237 a skos:Concept ;
    skos:altLabel "ingeslagen patroon"@nl ;
    skos:definition "Textile weaving technique in which a pattern is formed or the ground enriched by the use of more than one series of weft strands; the patterning is done using either a supplementary or complementary weft (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "schussgemustert"@de,
        "weft patterning"@en,
        "efecto de trama"@es,
        "lancé"@fr,
        "inslagpatroon"@nl,
        "trama lassada"@pt,
        "lanserad"@sv .

euf:11238 a skos:Concept ;
    skos:altLabel "gebrocheerd"@nl ;
    skos:definition "Weft patterning technique of weaving raised patterns on a woven textile. For the process of stitching decorative designs into cloth, leather, or paper by hand or machine, use embroidering (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "broschieren"@de,
        "brocading"@en,
        "brochado"@es,
        "brocher"@fr,
        "broccare"@it,
        "brocheren"@nl,
        "espolinado"@pt,
        "broschera"@sv .

euf:11240 a skos:Concept ;
    skos:altLabel "Schottenkaro"@de,
        "plaid"@de,
        "tartan (pattern)"@en,
        "plaid"@fr,
        "tartan (patroon)"@nl ;
    skos:definition "The characteristic pattern known from plaid textiles, consisting of bars or stripes of various colors crossing each other at right angles over a contrasting background color, whether or not the pattern exists on a textile or another material. Plaid patterns were known from ancient times in many cultures (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Tartan"@de,
        "σκοτσέζικο καρό"@el,
        "plaid (pattern)"@en,
        "escocés"@es,
        "damier"@fr,
        "scozzese"@it,
        "Schotse ruit"@nl,
        "škotska šara"@sr,
        "skotskrutig"@sv .

euf:11241 a skos:Concept ;
    skos:altLabel "silvered"@en,
        "verzilverd"@nl ;
    skos:definition "The act or process of covering with silver (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Versilbern"@de,
        "silvering"@en,
        "plateado"@es,
        "argenture"@fr,
        "verzilveren"@nl .

euf:11242 a skos:Concept ;
    skos:altLabel "chromising"@en,
        "chromized"@en,
        "verchroomd"@nl ;
    skos:definition "Covering object with layer of chrome (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Chromieren"@de,
        "chromizing"@en,
        "Chromisation"@fr,
        "chromeren"@nl .

euf:11243 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "painting and painting techniques"@en,
        "pinturas y técnicas de pintura"@es,
        "schilderen en schildertechnieken"@nl .

euf:11244 a skos:Concept ;
    skos:altLabel "drucken"@de,
        "printed"@en,
        "copiado"@es,
        "impresión"@es,
        "tirage"@fr,
        "tiratura"@it,
        "drukken"@nl,
        "gedrukt"@nl ;
    skos:definition "Various means of reproducing identical copies of graphic matter in a fixed form. Processes by which an image, pictorial or textual, is transferred, usually to paper or cloth, most often by means of a plate, block, stone, or screen. Use also for the making of photographic prints and, with computers, for the production of a paper copy of stored data. For the production of prints in a fine arts context, prefer printmaking (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Druckverfahren"@de,
        "printing (process)"@en,
        "proceso de impresión"@es,
        "impression (printing)"@fr,
        "תהליך הדפסה"@he,
        "stampatura"@it,
        "drukprocedé"@nl,
        "processo de impressão"@pt,
        "tryckning"@sv .

euf:11245 a skos:Concept ;
    skos:altLabel "screen printed"@en,
        "rasterdruk (drukproces)"@nl,
        "rastergedrukt"@nl,
        "zeefdruk"@nl ;
    skos:definition "Stencil technique of printing in which ink or dye is forced through a mesh, traditionally silk, on which a design has been formed by stopping out certain areas (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Siebdruck"@de,
        "Μεταξοτυπία"@el,
        "screen printing"@en,
        "serigrafía"@es,
        "sérigraphie"@fr,
        "הדפס-רשת"@he,
        "serigrafia"@it,
        "zeefdrukkunst"@nl,
        "serigrafia"@pt,
        "ситоштампа"@sr,
        "serigrafi"@sv .

euf:11246 a skos:Concept ;
    skos:altLabel "getekend"@nl ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "zeichnen und Zeichentechniken"@de,
        "σχέδιο και τεχνικές σχεδίασης"@el,
        "drawing and drawing techniques"@en,
        "dibujo y técnicas de dibujo"@es,
        "dessin et techniques de dessin"@fr,
        "ציור וטכניקות ציור"@he,
        "disegno e tecniche di disegno"@it,
        "tekenen en tekentechnieken"@nl,
        "desenho e técnicas de desenho"@pt,
        "crtaṇje i tehnike crtaṇja"@sr,
        "ritning och rittekniker"@sv .

euf:11247 a skos:Concept ;
    skos:altLabel "French quilting"@en,
        "doorstikt borduurwerk"@nl ;
    skos:definition "Used originally to refer specifically to stuffed and corded quilted textile made in Provence in the 17th century. In later years has come to refer to any stuffed and corded quilted textile, and also to matelassé textile with woven patterns, resembling hand-quilted textile (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "marseilles"@en,
        "marsellés"@es,
        "Zaans stikwerk"@nl .

euf:11248 a skos:Concept ;
    skos:altLabel "glued"@en,
        "gelijmd"@nl ;
    skos:definition "The action of joining or fastening with an adhesive viscous or sticky substance (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kleben"@de,
        "gluing"@en,
        "pegado"@es,
        "adhérer"@fr,
        "rispettare"@it,
        "lijmen"@nl,
        "limning"@sv .

euf:11249 a skos:Concept ;
    skos:altLabel "lakenstof"@nl ;
    skos:definition "Dense, fine, plain woven black cloth with a plain or twill weave. The raw yardage is creased or folded double, with its two lists brought together, as for cloth over 54 inches wide. Historically made of wool, broadcloth is used chiefly in the construction of menswear (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Walkstoffe"@de,
        "διπλόφαρδο"@el,
        "broadcloth"@en,
        "Velarte"@es,
        "morceau de tissu en laine"@fr,
        "pezzo di tessuto di lana"@it,
        "laken (wollen stof)"@nl,
        "tecido de lã"@pt,
        "Сукно"@sr,
        "kläde"@sv .

euf:11250 a skos:Concept ;
    skos:altLabel "bouclé (weft pile weave)"@en,
        "bouclé weave"@en,
        "tejido con bucles"@es ;
    skos:definition "Woven textile material with main or supplementary weft pulled up to form loops on the face (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bouclé"@de,
        "μπουκλέ"@el,
        "weft loop weave"@en,
        "anillado por trama"@es,
        "tissu bouclette"@fr,
        "bouclé"@it,
        "boucléstof"@nl,
        "bouclé"@pt,
        "bouclé"@sv .

euf:11251 a skos:Concept ;
    skos:definition "Fabric formed in a satin weave usually from silk or a manufactured fiber. It has a lustrous face and dull, crepe back. Charmeuse is most often used for lingerie, evening dresses, blouses, and linings (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Charmeuse satin"@de,
        "charmeuse"@en,
        "charmeuse"@nl,
        "charmeuse"@sv .

euf:11252 a skos:Concept ;
    skos:definition "Any woven figured textile produced on a Jacquard loom (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Jacquardgewebe"@de,
        "jacquard"@en,
        "tela jacquard"@es,
        "maglia Jacquard"@it,
        "jacquardweefsel"@nl .

euf:11253 a skos:Concept ;
    skos:altLabel "serge"@nl ;
    skos:definition "Durable twill, of worsted or with the warp of worsted and the weft of another wool yarn, with a clear finish and a flat diagonal rib; often used for tailored garments such as suits, coats, and dresses (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Serge"@de,
        "serge"@en,
        "tejido asargado"@es,
        "serge"@it,
        "saai"@nl,
        "sarja"@pt,
        "sars"@sv .

euf:11254 a skos:Concept ;
    skos:definition "Sheer, lightweight plain-woven textile, originally of linen now also of fine combed cotton yarn, filled with starch or sizing. often used for handkerchiefs, aprons, and curtains (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "lawn (textile)"@en,
        "batista (técnica de tejido)"@es,
        "linon"@fr,
        "lawn (textiel naar weeftechniek)"@nl .

euf:11255 a skos:Concept ;
    skos:altLabel "engraved (action)"@en,
        "gegraveerd"@nl,
        "inkerven"@nl ;
    skos:definition "Creating marks on the surface of a hard material, such as metal or glass, by incising with a sharp tool, when the designs or images created are for their own sake and not to be printed from (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gravieren"@de,
        "engraving"@en,
        "grabado"@es,
        "engraving"@fr,
        "graveren"@nl .

euf:11256 a skos:Concept ;
    skos:altLabel "perforated"@en,
        "perforado"@es,
        "geperforeerd"@nl ;
    skos:definition "The making of holes through an object; may be done purposefully, either when the object is made or later, or may be the result of natural processes. Having a hole, as a result of the drilling process (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "perforating"@en,
        "perforamiento"@es,
        "perforeren"@nl .

euf:11257 a skos:Concept ;
    skos:altLabel "braided"@en,
        "plaited"@en,
        "plaiting"@en,
        "gevlochten"@nl ;
    skos:definition "Technique in which strands of pliable material, often three or four strands, are intertwined so as to form a plait, band, or rope. An example is in textile work, where flat over-and-under oblique interlacing is achieved using the undifferentiated elements of a single set of strands, characterized by the oblique crossings of the elements and their common directional trend. Other examples include in the making of leather items, basketmaking, and in styling of hair (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Flechten"@de,
        "braiding"@en,
        "trenzado"@es,
        "vlechten"@nl,
        "trançado"@pt .

euf:11258 a skos:Concept ;
    skos:altLabel "woven"@en,
        "tejeduría"@es,
        "geweven"@nl ;
    skos:definition "Generally, the process of interlacing strands or strips of various materials, such as cane, textile, or twigs, to make materials or objects such as wicker, cloth, baskets, or wreaths. Specifically used for the process of making textile on a loom or other weaving device by interlacing warp and weft in a particular order (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Weben"@de,
        "ύφανση"@el,
        "weaving"@en,
        "tejido (proceso)"@es,
        "tissage"@fr,
        "אריגה"@he,
        "tessitura"@it,
        "weven"@nl,
        "tecelagem"@pt,
        "ткање"@sr,
        "vävning"@sv .

euf:11259 a skos:Concept ;
    skos:definition "Fabric of wool or wool blend with one glossy side, originating in Flanders, ca. 18th century. Calamanco traditionally is woven with a checker in the warp so that it is seen on the glossy side only (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "calamanco"@en,
        "calamaco"@es,
        "calmande"@fr,
        "kalamink"@nl .

euf:11260 a skos:Concept ;
    skos:altLabel "lacquered"@en,
        "laquear"@es,
        "gelakt"@nl ;
    skos:definition "Coating the surface of something, such as a piece of furnishing or small object, with lacquer, often creating designs or pictures with it (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "lacquering"@en,
        "lacado"@es,
        "lakken"@nl .

euf:11261 a skos:Concept ;
    skos:altLabel "indigo blue"@en ;
    skos:definition "Range of deep reddish blue colors resembling the color of indigo colorant, which is a vat dye obtained from indigo plants or artificially created (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "indigo"@de,
        "indigo"@en,
        "añil"@es,
        "indigo"@fr,
        "אינדיגו"@he,
        "indaco"@it,
        "indigo"@nl,
        "anil"@pt,
        "Indigo"@sv .

euf:11263 a skos:Concept ;
    skos:altLabel "soldered"@en,
        "gesoldeerd"@nl ;
    skos:definition "The process of joining two pieces of metal by inserting solder between them and applying heat, sometimes but not necessarily softening or melting the surfaces to be joined; usually carried out within a temperature range of 183 to 310 degrees Celsius, with an upper limit of 750 degrees Celsius. For the similar process carried out at temperatures ranging between 750 and 900 degrees Celsius, use brazing. For the process of joining two pieces of metal that necessarily involves softening or melting the surfaces to be joined but not necessarily the insertion of filler metal, use welding (AAT).&nbsp;"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Löten"@de,
        "Κόλληση"@el,
        "soldering"@en,
        "soldar"@es,
        "soudure"@fr,
        "הלחמה"@he,
        "saldare"@it,
        "solderen"@nl,
        "solda"@pt,
        "лемљење"@sr,
        "lödning"@sv .

euf:11264 a skos:Concept ;
    skos:altLabel "forged (metal formed)"@en,
        "gesmeed"@nl ;
    skos:definition "Forming the shape of a metal object by heating and hammering (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schmieden"@de,
        "Σφυρηλάτηση"@el,
        "forging (metal forming)"@en,
        "forjado (conformación de metales)"@es,
        "forgeage"@fr,
        "חישול"@he,
        "forgiatura"@it,
        "smeden (metaalvorming)"@nl,
        "forjamento"@pt,
        "smide"@sv .

euf:11265 a skos:Concept ;
    skos:altLabel "laminated"@en,
        "gelamineerd"@nl ;
    skos:definition "The uniting superposed layers of one or more materials, typically the fusing of thin sheets of plastic to the surfaces of paper or cardboard by means of heat and pressure (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kaschierung"@de,
        "laminating"@en,
        "laminado"@es,
        "למינציה"@he,
        "laminatura"@it,
        "lamineren"@nl .

euf:11266 a skos:Concept ;
    skos:altLabel "sawed"@en,
        "gezaagd"@nl ;
    skos:definition "The action of cutting something by drawing a band or plate having a cutting edge of continuous teeth back and forth over the material to be cut (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Sägen"@de,
        "sawing"@en,
        "aserrado"@es,
        "Sciage"@fr,
        "zagen"@nl .

euf:11267 a skos:Concept ;
    skos:altLabel "colored (process)"@en,
        "coloured (process)"@en,
        "colouring (process)"@en,
        "gekleurd"@nl ;
    skos:definition "The process of adding color, or changing or altering the color of something, whether by penetrating, coating, or by electronic means (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Färben"@de,
        "χρωματισμός"@el,
        "coloring (process)"@en,
        "coloración"@es,
        "coloriage"@fr,
        "ציור"@he,
        "colorazione"@it,
        "kleuren (procedé)"@nl,
        "colorir"@pt,
        "bojenje"@sr,
        "färgläggning"@sv .

euf:11269 a skos:Concept ;
    skos:definition "Process of rubbing a surface to make it smooth or shiny (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Polieren"@de,
        "polishing"@en,
        "pulido"@es,
        "polissage"@fr,
        "ליטוש"@he,
        "lucidatura"@it,
        "polijsten"@nl,
        "polimento"@pt,
        "polering"@sv .

euf:11270 a skos:Concept ;
    skos:definition "Use to describe artifacts fabricated primarily by machine, usually to distinguish from those made by hand (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "machine-made"@en,
        "fabricado con máquina"@es,
        "fabriqué à la machine"@fr,
        "machinaal"@nl .

euf:11272 a skos:Concept ;
    skos:altLabel "opgerold"@nl ;
    skos:definition "The process of wrapping a flat, flexible work or material around a cylinder or onto itself for the purpose of storage or transport. Examples include the following: the rolling of scrolls around a rod or onto themselves; the rolling of drawn, painted, printed, or inscribed works on parchment, paper, or canvas; the rolling of textiles, film, or other flexible works or materials (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "rolling (preparation for storage ans transporting)"@en,
        "oprollen"@nl .

euf:11273 a skos:Concept ;
    skos:altLabel "snipped"@en,
        "geknipt"@nl ;
    skos:definition "The action of cutting, clipping, or dividing something with scissors or a similar tool (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "snipping"@en,
        "tijereteado"@es,
        "knippen"@nl .

euf:11274 a skos:Concept ;
    skos:altLabel "drilled (process)"@en,
        "geboord (procedé)"@nl ;
    skos:definition "Refers to the making of holes in metal, wood, or other materials, and for making holes in the earth, as for drilling a well or for oil (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bohren"@de,
        "drilling (process)"@en,
        "taladrar"@es,
        "perçage"@fr,
        "קידוח"@he,
        "Perforazione"@it,
        "boren (procedé)"@nl,
        "Furação"@pt,
        "Bušenje"@sr,
        "borrning"@sv .

euf:11275 a skos:Concept ;
    skos:altLabel "anodized"@en,
        "geanodiseerd"@nl ;
    skos:definition "Process in which the surface of a metal is coated with a protective or decorative layer through electrolytic action (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Anodisieren"@de,
        "anodizing"@en,
        "anodizado"@es,
        "anodisation"@fr,
        "אלגון"@he,
        "anodizzazione"@it,
        "anodiseren"@nl,
        "anodização"@pt,
        "eloxering"@sv .

euf:11276 a skos:Concept ;
    skos:altLabel "die-cut"@en,
        "gestanst"@nl ;
    skos:definition "Cutting, as metal or paper, with dies (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "die cutting"@en,
        "troquelado"@es,
        "fustella"@it,
        "stansen (snijden)"@nl .

euf:11277 a skos:Concept ;
    skos:altLabel "ground (subtractive process)"@en,
        "molienda"@es,
        "rectificadora"@es,
        "aanzetten (slijpen)"@nl,
        "geslepen"@nl,
        "malen (slijpen)"@nl ;
    skos:definition "Pulverizing, polishing, wearing down, or sharpening by friction (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schleifen"@de,
        "grinding"@en,
        "pulverizado"@es,
        "rectification"@fr,
        "rettifica"@it,
        "slijpen"@nl,
        "retífica"@pt,
        "slipning"@sv .

euf:11278 a skos:Concept ;
    skos:altLabel "hammered (metal finishing)"@en,
        "martilleado"@es,
        "gehamerd"@nl ;
    skos:definition "Refers to the process of striking metal with a hammer or other instrument in order to create a vessel or other shape, or to create decoration. The oldest technique may have been to create a thin disk of metal by hammering it into a hollow carved in a block of wood. A vessel may be slowly raised by being struck on the outside surface using a specially shaped hammer and anvil. Embossing or repoussé work use hammering to create a design or pattern in a metal object, usually by hammering from the back of the piece (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Hämmern"@de,
        "hammering (metal finishing)"@en,
        "martilleo"@es,
        "martellinatura"@it,
        "hameren"@nl .

euf:11279 a skos:Concept ;
    skos:altLabel "welded"@en ;
    skos:definition "Refers to the process of joining two pieces of metal by softening or melting both surfaces to be joined by the application of heat, with or without inserting filler metal and with or without the application of pressure. For the metal joining process that necessarily involves the insertion of solder but not necessarily the softening or melting of the surfaces to be joined, see soldering for the process carried out at temperatures below 750 degrees Celsius, or brazing for the similar process carried out at temperatures ranging between 750 and 900 degrees Celsius (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schweißen"@de,
        "Συγκόλληση"@el,
        "welding"@en,
        "soldadura"@es,
        "soudage"@fr,
        "ריתוך"@he,
        "saldatura"@it,
        "lassen"@nl,
        "soldagem"@pt,
        "заваривање"@sr,
        "svetsning"@sv .

euf:11280 a skos:Concept ;
    skos:altLabel "brazed"@en,
        "hard soldering"@en,
        "hard-soldering"@en,
        "soldadura fuerte"@es,
        "hardgesoldeerd"@nl ;
    skos:definition "Refers to the process of joining two pieces of metal by inserting filler metal of very high melting point, such as hard solder, between them and applying heat, at temperatures ranging between 750 and 900 degrees Celsius; sometimes but not necessarily involves softening or melting the surfaces to be joined. For the similar process carried out at temperatures below 750 degrees Celsius, see soldering. For the process of joining two pieces of metal that necessarily involves softening or melting the surfaces to be joined but not necessarily the insertion of filler metal, see welding (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Hartlöten"@de,
        "brazing"@en,
        "broncesoldar"@es,
        "brasage"@fr,
        "הלחמה קשה"@he,
        "brasatura"@it,
        "hardsolderen"@nl,
        "hårdlödning"@sv .

euf:11281 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "metal assembling processes and techniques"@en,
        "metaalassemblageprocedés en -technieken"@nl .

euf:11282 a skos:Concept ;
    skos:altLabel "chased (metalwork)"@en,
        "gedreven"@nl ;
    skos:definition "The process of adding detail or ornament on metal by indenting with a hammer and tools without a cutting edge (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "chasing (metalworking)"@en,
        "cincelado"@es,
        "cesellatura"@it,
        "drijven"@nl .

euf:11283 a skos:Concept ;
    skos:altLabel "filed"@en,
        "gevijld"@nl ;
    skos:definition "The action of shaving, forming, or reducing something with a hardened, usually metallic, tool with cutting ridges (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Feilen"@de,
        "filing"@en,
        "limadura"@es,
        "vijlen"@nl .

euf:11284 a skos:Concept ;
    skos:altLabel "enamel (proces)"@en,
        "enameled"@en,
        "esmaltar"@es,
        "émaillage"@fr,
        "geëmailleerd"@nl ;
    skos:definition "The process of applying a vitreous coating to metal, ceramic, glass, or other surfaces by fusion using heat in a kiln or furnace, with the result of creating a smooth, hard surface (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Emaillieren"@de,
        "enameling"@en,
        "esmaltado"@es,
        "émailler"@fr,
        "smaltare"@it,
        "emailleren"@nl,
        "esmaltar"@pt,
        "emaljera"@sv .

