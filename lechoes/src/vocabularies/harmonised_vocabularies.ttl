euf:10946 a skos:Concept ;
    skos:altLabel "carved"@en,
        "beeldsnijden (procedé)"@nl,
        "gesneden"@nl ;
    skos:definition "The act of shaping, marking, or decorating wood, stone, or another material by cutting or incising, typically using tools such as chisels and other blades. It refers to this process as it is applied to small-scale objects or to objects that are not considered art. Carving may also be considered a sculpture technique that is employed in the creation of art (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "geschnitzt"@de,
        "σκαλιστό"@el,
