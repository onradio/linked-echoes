mimo:3006 a skos:Concept ;
    skos:definition "The txalaparta (Basque pronunciation: [tʃaˈlapaɾta] or [tʃalaˈpaɾta]) is a specialized Basque music device of wood or stone. In some regions of the Basque Country, zalaparta (with [s̻]) means \"racket\", while in others (in Navarre) txalaparta has been attested as meaning the trot of the horse, a sense closely related to the sound of the instrument."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Txalaparta"@ca,
        "Txalaparta"@de,
        "Txalaparta"@en,
        "Txalaparta"@es,
        "Txalaparta"@fr,
        "Txalaparta"@it,
        "Txalaparta"@nl,
        "Txalaparta"@pl,
        "Txalaparta"@sv,
        "Txalaparta"@zh .

mimo:3007 a skos:Concept ;
    skos:altLabel "Eoliphone"@fr,
        "Éoliphone"@fr ;
    skos:definition "The wind machine (also called an aeoliphone or aelophon) is a friction idiophone used to produce the sound of wind for orchestral compositions and musical theater productions."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Màquina de vent"@ca,
        "Windmaschine"@de,
        "Wind machine"@en,
        "Máquina de viento"@es,
