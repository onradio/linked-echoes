    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "cellulose triacetate"@en,
        "triacetato de celulosa"@es,
        "triacétate de cellulose"@fr,
        "triacetato di cellulosa"@it,
        "cellulosetriacetaat"@nl,
        "Triacetat"@sv .

euf:11118 a skos:Concept ;
    skos:definition "A fluid medium used for drawings or tracings. An opaque, usually black, pigment is mixed with a vehicle such as water to produce a fluid which can be applied with a pen or brush. Through the end of the 19th century, ink was supplied dried in stick or block form which was ground and mixed with water as needed. At the beginning of this century prepared ink became popular (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Tinte"@de,
        "μελάνη"@el,
        "ink"@en,
        "tinta"@es,
        "encre"@fr,
        "דיו"@he,
        "inchiostro"@it,
        "inkt"@nl,
        "tinta"@pt,
        "тинта"@sr,
        "bläck"@sv .

euf:11119 a skos:Concept ;
    skos:definition "Proprietary name for an acrylic fiber used in textiles, especially for upholstery fabric. Registered as trademark by the German company Bayer in 1954 (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Dralon (R)"@de,
        "Dralon (R)"@el,
        "Dralon (R)"@en,
