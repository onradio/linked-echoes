    skos:altLabel "Lila"@de,
        "Violett"@de,
        "roxo"@pt ;
    skos:definition "Hue name for the colors intermediate between red and blue, originally the colors derived from a crimson mollusk dye (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
