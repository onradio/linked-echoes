    skos:definition "A necklace having a single pearl-strand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ēkāvalī"@en .

aat:300446932 a skos:Concept ;
    skos:definition "In Indian architecture, a niche at the central offset."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhadra-khattaka"@en .

aat:300446933 a skos:Concept ;
    skos:definition "In Indian architecture, a niche at the central-most face of the bhadra."@en ;
