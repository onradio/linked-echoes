euf:10013 a skos:Concept ;
    skos:altLabel "redingotes"@en,
        "redingote (japon)"@nl,
        "redingote-kleden (japon)"@nl,
        "redingote-kleed"@nl,
        "redingotes (japonnen)"@nl,
        "robes redingotes"@nl,
        "casaco redingote"@pt ;
    skos:definition "Dresses open in front to show an underskirt or with a front gore of contrasting material, with collar and lapels and long sleeves. Bodice may be double-breasted and high-waisted; worn especially during the 1820s through the 1860s (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Redingote"@de,
