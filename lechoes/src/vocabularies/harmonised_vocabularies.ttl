mimo:3868 a skos:Concept ;
    skos:altLabel "Krummer Zink"@de ;
    skos:definition "The cornett, cornetto, or zink is an early wind instrument that dates from the Medieval, Renaissance and Baroque periods, popular from 1500 to 1650. It was used in what are now called alta capellas or wind ensembles. It is not to be confused with the modern cornet."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Corneta"@ca,
        "Zink"@de,
        "Cornett"@en,
