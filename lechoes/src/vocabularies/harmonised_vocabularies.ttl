euf:10400 a skos:Concept ;
    skos:altLabel "Farben"@de,
        "Muster"@de ;
    skos:definition "Refers to individual hues or tints, particularly the chromatic colors in the spectrum and the achromatic colors or neutrals. With reference to color in theory and the science of perception, see color (perceived attribute). (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Farbe"@de,
        "χρώματα"@el,
        "colours"@en,
        "colores"@es,
        "couleurs"@fr,
        "צבעים"@he,
        "colori"@it,
        "kleuren"@nl,
        "cores"@pt,
        "boje"@sr,
        "färger"@sv .

euf:10401 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of blackish colors. More specifically, black is an achromatic color of maximum darkness, referring to objects having little or no hue owing to the absorption of almost all light in the visible spectrum. In the context of pigments, black is theoretically the mixture of all colors. In the context of colors of light, black is the absence of light (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Schwarz"@de,
        "μαύρο"@el,
        "black"@en,
        "negro"@es,
        "noir"@fr,
        "שחור"@he,
        "nero"@it,
        "zwart"@nl,
        "preto"@pt,
        "црна"@sr,
        "svart"@sv .

euf:10402 a skos:Concept ;
    skos:definition "Hue name for one of the three primary additive colors; that portion of the spectrum lying between green and violet, with a wavelength of about 420 to 490 nanometers, which is the shortest wavelength range of the three primary colors. The term may refer to any of this group of colors that vary in lightness and saturation. An example of blue color in nature is that of a clear sky during the day (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Blau"@de,
        "μπλε"@el,
        "blue"@en,
        "azul"@es,
        "bleu"@fr,
        "כחול"@he,
        "blu"@it,
        "blauw"@nl,
        "azul"@pt,
        "плава"@sr,
        "blå"@sv .

euf:10403 a skos:Concept ;
    skos:definition "Hue name for any dull reddish-yellowish or orangish color of low brightness and saturation, resembling the color of wood or earth. Brown is a low luminance color that is typically produced by adding black or their complementary colors to red, orange, or yellow paint. It is considered an earth tone and has an unlimited numbers of shades (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Braun"@de,
        "καφέ"@el,
        "brown"@en,
        "marrón"@es,
        "brun"@fr,
        "חום"@he,
        "bruno"@it,
        "bruin"@nl,
        "castanho"@pt,
        "смеђа"@sr,
        "brun"@sv .

euf:10404 a skos:Concept ;
    skos:definition "Hue name for the color representing that portion of the spectrum that is intermediate between blue and yellow, with wavelengths between 520 and 570 nanometers. The term may refer to any of this group of colors that vary in lightness and saturation. An example of green color in nature is that of growing grass. It is a secondary pigment color (made by combining yellow and blue) and one of the three additive primary colors (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "grün"@de,
        "πράσινο"@el,
        "green"@en,
        "verde"@es,
        "vert"@fr,
        "ירוק"@he,
        "verde"@it,
        "groen"@nl,
        "verde"@pt,
        "зелена"@sr,
        "grön"@sv .

euf:10405 a skos:Concept ;
    skos:definition "Hue name for any color intermediate between black and white, or composed of a mixture of black and white with little or no positive hue (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Grau"@de,
        "γκρι"@el,
        "grey"@en,
        "gris"@es,
        "gris"@fr,
        "אפור"@he,
        "grigio"@it,
        "grijs"@nl,
        "cinza"@pt,
        "сива"@sr,
        "grå"@sv .

euf:10406 a skos:Concept ;
    skos:altLabel "metaalkleur"@nl ;
    skos:definition "When used with a color term, refers to a lustrous appearance, resembling the sheen of a metal surface (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Metallic"@de,
        "μεταλλικό χρώμα"@el,
        "metallic"@en,
        "metalizado"@es,
        "métallique"@fr,
        "מתכתי"@he,
        "metallico"@it,
        "metallic"@nl,
        "metalizado"@pt,
        "metalik"@sr,
        "metallfärgad"@sv .

euf:10407 a skos:Concept ;
    skos:altLabel "golden"@de,
        "doré"@fr ;
    skos:definition "A range of yellowish colors, typically with undertones of red or brown, resembling the color of the lustrous metal, gold (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gold"@de,
        "Χρυσό"@el,
