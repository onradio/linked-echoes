        "τούβλο"@el,
        "brick"@en,
        "ladrillo"@es,
        "brique"@fr,
        "לבנה"@he,
        "mattone"@it,
        "baksteen"@nl,
        "tijolo"@pt,
        "опека"@sr,
        "murtegel"@sv .

euf:11184 a skos:Concept ;
    skos:definition "The wood of a fast-growing tropical bombaceous tree that is the lightest and softest wood used commercially. The white to tan-color, soft wood has a straight grain, coarse texture and is relatively strong. Balsa wood is easily carved and often used for model airplanes and toys. Balsa is also used as a substitute for cork in insulation, flats, life preservers, and buoys (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Balsaholz"@de,
        "balsa (wood)"@en,
        "madera de balsa"@es,
        "balsahout"@nl,
        "balsa"@pt .

euf:11185 a skos:Concept ;
    skos:definition "Copper-nickel-zinc alloy, typically 20% zinc, 18% nickel, and the balance copper, used as a base metal for plated silverware, for springs and contacts in electrical equipment, and for corrosion-resistant objects (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Neusilber"@de,
        "Νικέλιος άργυρος"@el,
        "German silver"@en,
        "plata alemana"@es,
        "maillechort"@fr,
        "אלפקה"@he,
        "alpacca"@it,
        "Berlijns zilver"@nl,
        "alpaca"@pt,
        "Алпака"@sr,
        "nysilver"@sv .

euf:11186 a skos:Concept ;
    skos:definition "A hard, strong construction material comprising a mixture of sand, gravel, crushed rock, or other aggregate, held together, typically by a hardened paste of cement and/or lime. Several types of aggregate are used such as crushed stone, slag, cinders or gravel. Ancient Romans developed pozzolan cement about the 3rd century BCE. Modern concretes use various cements such as portland or hydraulic. Concrete is durable and relatively inexpensive, used for foundations, bridges, dams, walls, and highways. Concrete is strong in compression but weak in tension so it is often reinforced with steel bars or wire netting. Once a concrete mixture is stirred with water and poured into a mold, it is allowed to cure slowly over about a week. Stresses, such as vibration, freezing, and rapid drying, will diminish the strength and durability of the concrete. As it ages, concrete is subject to erosion, spalling, and pollution. Poor mixing can cause erosion. Spalling can be due to freeze-thaw cycles of moisture and ice, salt crystallization, or corrosion of steel reinforcements. Acid rain can deplete the natural alkaline reserve of fresh concrete (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Beton"@de,
        "σκυρόδεμα"@el,
        "concrete"@en,
        "concreto"@es,
        "béton"@fr,
        "בטון"@he,
        "calcestruzzo"@it,
        "beton"@nl,
        "betão"@pt,
        "бетон"@sr,
        "betong"@sv .

euf:11187 a skos:Concept ;
    skos:definition "Refers to sheets of gold that have been hammered or rolled very thin (typically around 0.1 micrometer, or 4 millionths of an inch, thick). In art, gold leaf has been applied to paintings, sculptures, manuscripts, and decorative arts since around 1500 BCE. In the 1920s, the process of creating gold leaf was successfully automated (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Blattgold"@de,
        "λεπτό φύλλο χρυσού"@el,
        "gold leaf"@en,
        "pan de oro"@es,
        "feuille d'or"@fr,
        "עלי זהב"@he,
        "foglia oro"@it,
        "bladgoud"@nl,
        "folha de ouro"@pt,
        "златни листић"@sr,
        "bladguld"@sv .

euf:11188 a skos:Concept ;
    skos:altLabel "crewel yarn"@en,
        "crewel-wool"@en,
        "cruel wool"@en ;
    skos:definition "Fine, loosely twisted, two-ply, worsted yarn used in embroidering (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "crewel wool"@en,
        "hilo de bordar"@es,
        "borduurwol"@nl .

euf:11189 a skos:Concept ;
    skos:definition "Glossy transparent material made from regenerated cellulose, typically in the form of thin sheets, usually moisture-proofed and sometimes dyed; impervious to dry gases, grease, and bacteria, and used as packaging or wrapping for food and other merchandise, envelope windows, and bags for dialysis (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Cellulosehydrat"@de,
        "Κελλοφάνη"@el,
        "cellophane"@en,
        "celofán"@es,
        "cellophane"@fr,
        "צלופן"@he,
        "cellophane"@it,
        "cellofaan"@nl,
        "celofane"@pt,
        "Целофан"@sr,
        "cellofan"@sv .

euf:11190 a skos:Concept ;
    skos:definition "Any of several finely powdered inorganic materials that can be mixed with water then dried to form a solid, durable mass, such as plaster, lime, pozzolan cement, and portland cement. It is used in construction as an ingredient of mortar and concrete (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Zement"@de,
        "τσιμέντο"@el,
        "cement"@en,
        "cemento"@es,
        "ciment"@fr,
        "צמנט"@he,
        "cemento"@it,
        "cement"@nl,
        "cimento"@pt,
        "цемент"@sr,
        "cement"@sv .

euf:11191 a skos:Concept ;
    skos:definition "A carbon ink made from burning tung oil with a low oxygen component. Originally in the form of a solid, imported to Europe as compressed sticks. Also, fluid consisting of the pigment suspended in a medium such as water combined with a glutinous binder (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Chinese ink"@en,
        "tinta china"@es,
        "encre de Chine"@fr,
        "Chinese inkt"@nl .

euf:11192 a skos:Concept ;
    skos:definition "Single filaments of fiber, groups of such filaments twisted tightly together, or filamentous lengths formed by spinning and twisting short fibers into a continuous strand (AAT). Thread is intended for sewing, embroidering or quilting fabrics. Use yarn for material used for knitting, crocheting and weaving."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Faden"@de,
        "thread"@en,
        "hilo"@es,
        "fil"@fr,
        "filo"@it,
        "draad"@nl,
        "linha"@pt,
        "нит"@sr,
        "tråd"@sv .

euf:11193 a skos:Concept ;
    skos:definition "Integument of a large animal such as a cow or buffalo separated from the body with or without hair, whether green, dry, tanned, or dressed. For the integument of a small animal, use skin. For tanned hide, use leather (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Felle"@de,
        "hide"@en,
        "piel"@es,
        "peau"@fr,
        "pelle"@it,
        "dierenhuid"@nl,
        "curtume"@pt,
        "skinn"@sv .

euf:11194 a skos:Concept ;
    skos:definition "Animal material that has been preserved or has undergone a specialized treatment (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "verarbeitetes tierisches Material"@de,
        "processed animal material"@en,
        "material animal procesado"@es,
        "bewerkt dierlijk materiaal"@nl .

euf:11195 a skos:Concept ;
    skos:definition "Fine-quality calf or lamb parchment used for writing, illuminations, or binding books. The terms vellum and parchment are sometimes confused and used interchangeably (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
