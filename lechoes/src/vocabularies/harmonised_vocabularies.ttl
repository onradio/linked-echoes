mimo:3800 a skos:Concept ;
    skos:altLabel "Kortholt"@zh,
        "Neyanban"@zh,
        "Phagotus"@zh,
        "Sordone"@zh ;
    skos:definition "The kortholt is a musical instrument of the woodwind family, used in the Renaissance period. The name comes from Low Saxon and means short (kort) piece of wood (holt). This name is mentioned in the work Syntagma musicum by Michael Praetorius, who is the main source for information about this instrument. The name refers to the characteristic low pitch that belies the short length of the instrument, and could be applied more generically to any wind instrument which was deeper in pitch than expected from its length."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Kortholt"@ca,
        "Kortholt"@de,
        "Courtaut"@en,
        "Kortholt"@es,
        "Courtaut"@fr,
        "Courtaut"@it,
        "Courtaut"@nl,
        "Courtaut"@pl,
