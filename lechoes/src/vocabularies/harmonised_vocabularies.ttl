mimo:2950 a skos:Concept ;
    skos:altLabel "Kankobele"@zh,
        "Kisanzi"@zh,
        "Lamellophone"@zh,
        "Pien ch'ing"@zh,
        "Pien-ch'ing"@zh,
        "Piänking"@zh,
        "Shibianqing"@zh,
        "Zanza"@zh ;
    skos:definition "The bianqing (Chinese: 编磬) is a traditional Chinese percussion instrument consisting of a set of L-shaped flat stone chimes known as qing, played melodically. The chimes were hung in a wooden frame and struck with a mallet. Along with the bronze bells called bianzhong, they were an important instrument in China's ritual and court music going back to ancient times."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Bianqing"@ca,
        "Bianqing"@de,
        "Bianqing"@en,
        "Bianqing"@es,
        "Bianqing"@fr,
        "Bianqing"@it,
        "Bianqing"@nl,
