    skos:inScheme lev:aat ;
    skos:prefLabel "olive gray"@en .

aat:300128371 a skos:Concept ;
    skos:definition "Positive transparencies in mounts suitable for projection, usually 35mm film in a mount of 2 by 2 inches. An image on film or glass, usually positive, intended to be viewed by means of light passing through the image and base using a viewer or projector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slides"@en .

aat:300128374 a skos:Concept ;
    skos:definition "Slides having images composed of gray tones, black, and clear areas; may include one hue as a result of process, toning, or discoloration."@en ;
    skos:inScheme lev:aat ;
