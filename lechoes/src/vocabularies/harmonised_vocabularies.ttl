euf:10943 a skos:Concept ;
    skos:altLabel "mercerization"@en,
        "gemerceriseerd"@nl ;
    skos:definition "Treatment of cotton yarn or fabric by immersion in a caustic solution of sodium hydroxide or other chemical base. Fibers so treated swell permanently, and the cotton is made stronger and more lustrous. Named after Alexander Mercer (1791-1866), who perfected the process (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Merzerisierung"@de,
        "μερσεριζέ"@el,
        "mercerizing"@en,
