        "stencildrukken"@nl,
        "estêncil (processo)"@pt,
        "šablon štampanja"@sr,
        "stencilutskrift"@sv .

euf:10424 a skos:Concept ;
    skos:altLabel "cat suit"@en,
        "cat suits"@en,
        "cat-suit"@en,
        "cat-suits"@en,
        "catsuits"@en,
        "catsuit"@es,
        "catsuits"@nl ;
    skos:definition "One-piece, tight-fitting main garments that extend from neck to ankles or feet, usually made of knitted material; designed for everyday wear rather than for physical activities; dating from the second half of the 20th century. Distinguished from leotards, which are designed for physical activities such as by acrobats and dancers (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Catsuit"@de,
        "catsuit"@el,
        "catsuit"@en,
        "malla (prenda principal)"@es,
        "combinaison moulante"@fr,
