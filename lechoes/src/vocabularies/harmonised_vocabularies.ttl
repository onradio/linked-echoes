mimo:4461 a skos:Concept ;
    skos:altLabel "Kontrabaßtuba"@de ;
    skos:definition "The contrabass bugle (usually shortened to contra or simply called the marching tuba) is the lowest-pitched brass instrument in the drum and bugle corps and marching band hornline. It is essentially the drum corps' counterpart to the marching band's sousaphone: the lowest-pitched member of the hornline, and a replacement for the concert tuba on the marching field."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Bugle contrabaix"@ca,
        "Kontrabasstuba"@de,
        "Contrabass bugle"@en,
        "Bugle contrabajo"@es,
        "Clairon contrebasse"@fr,
        "Flicorno contrabbasso"@it,
        "Contrabasbugel"@nl,
        "Buglehorn kontrabasowy"@pl,
        "Kontrabas signalhorn"@sv,
        "倍低音军号"@zh .

