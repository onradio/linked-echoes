euf:10597 a skos:Concept ;
    skos:altLabel "plastic (material)"@en,
        "plastic (materials)"@en,
        "pasta"@es ;
    skos:definition "A general term for any of a large and varied class of natural or synthetic organic materials that can be molded, extruded, or cast when soft or liquid, and then set into a rigid or slightly elastic form. Natural plastics include tree resins, beeswax, gutta-percha, horn, and clay. Synthetic plastics were first made in the 19th century. Plastics are used widely in manufacturing (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Plastik"@de,
        "πλαστικό"@el,
        "plastic"@en,
        "plástico"@es,
        "plastique"@fr,
        "פלסטיק"@he,
        "plastica"@it,
        "plastic"@nl,
        "plastika"@sr,
        "plast"@sv .

euf:10598 a skos:Concept ;
    skos:altLabel "Celluloid"@de,
        "Zellhorn"@de ;
    skos:definition "A tough, highly flammable but not usually explosive, synthetic thermoplastic composed essentially of cellulose nitrate and camphor or another plasticizer. It was originally a trademark of Hoechst Celanese. It was marketed as a substitute for ivory, horn, amber, tortoiseshell for use in piano keys, dolls, buttons, combs, brushes, mirrors, collars, dental plates, and other small items. Tough, transparent sheets and strips of celluloid were also used for photographic and motion picture films as well as animation cels. Celluloid film was cast from a solution of cellulose nitrate with wood alcohol (methanol), amyl nitrate, camphor and fusel oil (amyl alcohol) (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Zelluloid"@de,
        "σελουλόιντ"@el,
        "celluloid"@en,
        "celuloide"@es,
        "celluloïd"@fr,
        "צלולואיד"@he,
        "celluloide"@it,
        "celluloid"@nl,
        "celuloide"@pt,
        "celuloid"@sr,
        "celluloid"@sv .

euf:10599 a skos:Concept ;
    skos:definition "Any solid semi-inorganic polymers based on siloxanes, obtained by the action of concentrated hydrochloric acid on calcium silicide. Silicones were first discovered by F.S. Kipping in England in 1904, but were not commercially produced as polymers until 1943 by Dow Corning and 1946 by General Electric. They were called silicones because their empirical formula (R2SiO) is similar to that for ketones (R2CO). Silicones can be liquids, gels, and elastomers as well as solid thermoplastic or thermosetting resins. In general, they have excellent heat and chemical resistance and are water repellent. Silicones are used as adhesives, lubricants, protective coatings, release agents, paints, rubbers, coolants, implants, and insulation (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Silikon"@de,
        "σιλικόνη"@el,
        "silicone"@en,
        "silicona"@es,
        "silicone"@fr,
        "סיליקון"@he,
        "silicone"@it,
        "silicone"@nl,
        "silicone"@pt,
        "silikon"@sr,
        "silikon"@sv .

euf:10600 a skos:Concept ;
    skos:altLabel "polyether"@nl ;
    skos:definition "Light spongy rubber made by mechanically whipping air into the rubber latex prior to curing. It is used for mattresses, cushions, and insulation. Foam rubber turns yellow and becomes powdery when exposed to sunlight (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Moosgummi"@de,
        "αφρώδες ελαστικό"@el,
        "foam rubber"@en,
        "gomaespuma"@es,
        "caoutchouc mousse"@fr,
        "גומאויר"@he,
        "gommapiuma"@it,
        "schuimrubber"@nl,
        "poliuretanska pena"@sr,
        "polyetenskum"@sv .

euf:10601 a skos:Concept ;
