aat:300404549 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2899 to 2800 (or 2900 to 2801) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-ninth century BCE"@en .

aat:300404550 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 1 to 999 (or 1 to 1000)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first millennium"@en .

aat:300404551 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 1000 to 1999 (or 1001 to 2000)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second millennium"@en .

aat:300404552 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 2000 to 2999 (or 2001 to 3000)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "third millennium"@en .

aat:300404553 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 1999 to 1000 (or 2000 to 1001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second millennium BCE"@en .

aat:300404554 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 999 to 1 (or 2000 to 1) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first millennium BCE"@en .

aat:300404555 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 2999 to 2000 (or 3000 to 2001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "third millennium BCE"@en .

aat:300404556 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 3999 to 3000 (or 4000 to 3001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourth millennium BCE"@en .

aat:300404557 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 4999 to 4000 (or 5000 to 4001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifth millennium BCE"@en .

aat:300404558 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 5999 to 5000 (or 6000 to 5001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixth millennium BCE"@en .

aat:300404559 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 6999 to 6000 (or 7000 to 6001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seventh millennium BCE"@en .

aat:300404560 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 7999 to 7000 (or 8000 to 7001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighth millennium BCE"@en .

aat:300404561 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 8999 to 8000 (or 9000 to 8001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ninth millennium BCE"@en .

aat:300404562 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 9999 to 9000 (or 10,000 to 9001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenth millennium BCE"@en .

aat:300404563 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 10,999 to 10,000 (or 11,000 to 10,001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eleventh millennium BCE"@en .

aat:300404564 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 11,999 to 11,000 (or 12,000 to 11,001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twelfth millennium BCE"@en .

aat:300404565 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 12,999 to 12,000 (or 13,000 to 12,001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thirteenth millennium BCE"@en .

aat:300404566 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 13,999 to 13,000 (or 14,000 to 13,001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourteenth millennium BCE"@en .

aat:300404567 a skos:Concept ;
    skos:definition "Millennium in the proleptic Gregorian calendar including the years 14,999 to 14,000 (or 15,000 to 14,001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifteenth millennium BCE"@en .

aat:300404568 a skos:Concept ;
    skos:definition "Dating system based on the seasonal year of approximately 365 1/4 days, the time it takes the earth to revolve once around the sun. The Egyptians appear to have been the first to develop a solar calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar calendar"@en .

aat:300404569 a skos:Concept ;
    skos:definition "Dating system based on a year consisting of synodic months, which are complete cycles of phases of the Moon. In every solar year (or year of the seasons), there are about 12.37 synodic months. Therefore, if a lunar-year calendar is to be kept in step with the seasonal year, a periodic intercalation (addition) of days is necessary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunar calendar"@en .

aat:300404570 a skos:Concept ;
    skos:definition "Dating system based on the mutual relations of the sun and moon, or taking account of their combined action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunisolar calendar"@en .

aat:300404571 a skos:Concept ;
    skos:definition "Dating system based on the orbit of the moon and with reference to the apparent passage of the stars across the sky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunar-sidereal calendar"@en .

aat:300404573 a skos:Concept ;
    skos:definition "Conceptual systems for reckoning the passage of time in terms of days and years, often also with months or other such divisions. For processes by which age is determined and translated to estimated dates of creation or another event, use \"dating (measuring processes).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dating systems"@en .

aat:300404576 a skos:Concept ;
    skos:definition "Art and cultural works produced by the original inhabitants of an area, as contrasted to works produced by descendants of colonists to the area. A primary usage of the term refers to cultures who pre-existed European colonialism in the Americas, Africa, and Oceania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigenous art"@en .

aat:300404577 a skos:Concept ;
    skos:definition "Classification process or scheme that allows or exhibits linkages from one smaller context to multiple categories rather than to a single category. An example is in indexing a group of works or a complex work; as a whole, the group may be so diverse that it may be appropriately classified under multiple classification headings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed classification"@en .

aat:300404578 a skos:Concept ;
    skos:definition "Genre of works made of twigs, rushes, thin strips of wood, or other flexible material woven together; includes baskets, other vessels, and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketry"@en .

aat:300404579 a skos:Concept ;
    skos:definition "The physical universe beyond the earth's atmosphere, consisting of near vacuum with small amounts of gas and dust. Usage often excludes celestial objects, but includes the expanse in which celestial objects are situated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space"@en .

aat:300404580 a skos:Concept ;
    skos:definition "The natural world or physical surroundings in general, either as a whole or within a particular geographical area, particularly as affected by human activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environment"@en .

aat:300404581 a skos:Concept ;
    skos:definition "Functions concerning the industry of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food service functions"@en .

aat:300404582 a skos:Concept ;
    skos:definition "Having to do with the care for the general health of a person or community, particularly when provided by an organized health service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health care"@en .

aat:300404583 a skos:Concept ;
    skos:definition "The provision, serving, or preparation of food, particularly regarding the industry concerned with this."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food service"@en .

aat:300404584 a skos:Concept ;
    skos:definition "Object genre including a wide variety of items used in a domestic environment, excluding large furniture. Can include draperies, rugs, decorative items, small furnishings, wallcoverings, and many other types of things, both decorative and functional."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "household accessories"@en .

aat:300404585 a skos:Concept ;
    skos:definition "Object genre including equipment, tools, vessels, apparatus, utensils, instruments, apparel, small furnishings, and other things employed in any trade or used in executing a task or work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "implements"@en .

aat:300404586 a skos:Concept ;
    skos:definition "Visual works created using multiple media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed media works"@en .

aat:300404587 a skos:Concept ;
    skos:definition "Object genre including various types of things that are a smaller or reduced version of an original, such as a likeness or representation on a small scale or a small-scale model."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniatures"@en .

aat:300404588 a skos:Concept ;
    skos:definition "Genre of written works published or otherwise available in printed form, usually on paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printed materials"@en .

aat:300404589 a skos:Concept ;
    skos:definition "Object genre comprising items and equipment worn, carried, or otherwise used for an individual's needs, convenience, or fashion. Includes, but not limited to, costume accessors, sports equipment, and armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal accessories"@en .

aat:300404590 a skos:Concept ;
    skos:definition "Equipment used for writing, typically but not always reserved for pens and other equipment for writing in longhand rather than by mechanical means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing equipment"@en .

aat:300404591 a skos:Concept ;
    skos:definition "Object genre including items, equipment, accessories, and other things that are utilitarian in purpose rather than purely decorative. Objects having a primary purpose of being useful and used, rather than purely decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utilitarian objects"@en .

aat:300404592 a skos:Concept ;
    skos:definition "General term for various articles, cosmetics, or products used in washing, dressing, and hygiene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toiletries"@en .

aat:300404593 a skos:Concept ;
    skos:definition "Information indicator used when a work is about multiple subjects, rather than a single coherent subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "various subjects"@en .

aat:300404594 a skos:Concept ;
    skos:definition "Information indicator used in reference to a work other than the work being cataloged or discussed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "other works"@en .

aat:300404596 a skos:Concept ;
    skos:definition "Refers to an Italian painting movement of the 1950s, co-founded by Enrico Baj, Sergio Dangelo and Gianni Bertini to promote a style of gestural painting relevant to the post-War nuclear age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arte nucleare"@en .

aat:300404597 a skos:Concept ;
    skos:definition "Cultures, styles, and period in Chinese history dating 304 to 439, when the political order of northern China fractured into a series of short-lived sovereign states founded by ethnic Xiongnu, Xianbei, Di, Jie, Qiang, and Dingling rulers who took on Chinese dynastic names. The period ended with the unification of northern China by the Northern Wei in the early 5th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sixteen Kingdoms"@en .

aat:300404598 a skos:Concept ;
    skos:definition "Culture, style, and period a state of the Sixteen Kingdoms, flourished 386-403, during the Jin Dynasty in China; founded by the Lü family of the Di ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Liang"@en .

aat:300404599 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 407-431; founded by the Tiefu tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xia"@en .

aat:300404600 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 303/304-347; ruled by the Li family of the Ba ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cheng Han"@en .

aat:300404601 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 304-329; a Southern Xiongnu state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Former Zhao"@en .

aat:300404602 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 319-351; founded by the Shi family of the Jie ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Zhao"@en .

aat:300404603 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 320-376; founded by Han Chinese Zhang family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Former Liang"@en .

aat:300404604 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 400-421; founded by Han Chinese Li family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Liang"@en .

aat:300404605 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 400-421; founded by the Xiongnu Juqu family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Liang"@en .

aat:300404606 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 397-414; founded by the Tufa family of Xianbei ethnicity, considered relatives of the Tuoba imperial house of Northern Wei."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern Liang"@en .

aat:300404607 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 351-394; founded by Fu Jian, of the Di people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Former Qin"@en .

aat:300404608 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 384-417; founded by people of Qiang ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Qin"@en .

aat:300404609 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 385-400 and 409-431; founded by people of Xianbei ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Qin"@en .

aat:300404610 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 384-407/409; a Murong–Xianbei state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Yan"@en .

aat:300404611 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 407/409-436; a Han Chinese state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Yan"@en .

aat:300404612 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 398-410; founded by people of of Xianbei ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern Yan"@en .

aat:300404613 a skos:Concept ;
    skos:definition "Culture, style, and period of a state of the Sixteen Kingdoms, flourished 337-370; a state of Xianbei ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Former Yan"@en .

aat:300404614 a skos:Concept ;
    skos:definition "Refers to the style, culture, and period of the later years of imperial China's Tang dynasty; 836-907."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Tang"@en .

aat:300404615 a skos:Concept ;
    skos:definition "Refers to the style, culture, and period of the middle years of imperial China's Tang dynasty; roughly 766-835."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Tang"@en .

aat:300404616 a skos:Concept ;
    skos:definition "Refers to the style, culture, and period of certain years of imperial China's Tang dynasty, especially noted for art and poetry; 713-765."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Tang"@en .

aat:300404617 a skos:Concept ;
    skos:definition "Refers to the style, culture, and period of the early years of imperial China's Tang dynasty; 618-712."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Tang"@en .

aat:300404618 a skos:Concept ;
    skos:definition "In Mahayana Buddhism, pure abodes or celestial realms of a buddha or bodhisattva; used for East Asian Buddhism, Taoism, and Bon. For realms both pure and mixed, use \"buddha fields.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pure land"@en .

aat:300404619 a skos:Concept ;
    skos:definition "In Buddhism, realms of individual bodhisattvas who have attained awakening; may have varying spiritual climates or degrees of perfection, either pure or mixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buddha field"@en .

aat:300404620 a skos:Concept ;
    skos:definition "Numeric, alphanumeric, or other identifying codes assigned when an art object, book, or other item is described or listed in a catalog, usually a published catalog. An example is an exhibition catalog. The numbers are typically not marked on the object itself. For numbers given to objects when they are acquired by a repository, prefer \"accession numbers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalog numbers"@en .

aat:300404621 a skos:Concept ;
    skos:definition "Numeric, alphanumeric, or other identifying codes of various types assigned to an art object, book, other item, or group of works by the repository that holds that item or group. Any item or group in a repository may have multiple types of repository numbers. For numbers specifically assigned at the time of accession by a repository, prefer \"accession numbers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repository numbers"@en .

aat:300404622 a skos:Concept ;
    skos:definition "Numeric, alphanumeric, or other identifying codes assigned to an art object, book, or other item by the creator or producer of the work. The number is usually inscribed or otherwise marked on the work. For numbers assigned at the time of accession by an owner or repository, prefer \"accession numbers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creation numbers"@en .

aat:300404623 a skos:Concept ;
    skos:definition "Refers to practitioners or exponents of pataphysics. The term was coined by Alfred Jarry in late-19th century works of fiction, but continues to be used to describe those who study or practice Jarry's science of imaginary solutions, and by extension, Jarry's life and work in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pataphysicians"@en .

aat:300404624 a skos:Concept ;
    skos:definition "Refers to a philosophical or critical concept that supposes that humanity's attempt to find meaning are doomed due to the chaotic and inexplicable nature of the universe in which we live. The concept was thought to have been embodied in the Theatre of the Absurd, a dramatic genre of the 1950s and 1960s, exemplified in the work of Samuel Beckett and Eugène Ionesco, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "the Absurd"@en .

aat:300404625 a skos:Concept ;
    skos:definition "A philosophical movement or attitude associated with Albert Camus that posits that humanity's search for meaning is futile in a chaotic, senseless universe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absurdism"@en .

aat:300404626 a skos:Concept ;
    skos:definition "Numeric, alphanumeric, or other codes assigned to a thing, concept, person, or other entity in order identify it and distinguish it from other similar entities. Often a sequence of integers or characters arbitrarily devised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identification numbers"@en .

aat:300404627 a skos:Concept ;
    skos:definition "Numbers or codes assigned to an individual person, used to identify the person and disambiguate him or her from other people. An example is a number used to validate electronic transactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal identification numbers"@en .

aat:300404628 a skos:Concept ;
    skos:definition "Distinguishing identification numbers or codes assigned to either a plot of land or a batch of items, such as at an auction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lot numbers"@en .

aat:300404629 a skos:Concept ;
    skos:definition "Strings of characters or numbers used to identify individual electronic resources online."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uniform resource identifiers"@en .

aat:300404630 a skos:Concept ;
    skos:definition "Unique resource locators that, in addition to identifying a resource, provide the address of the internet document according to one of a variety of protocols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uniform resource locators"@en .

aat:300404631 a skos:Concept ;
    skos:definition "Alphabet used for Sanskrit, Hindi, and other Indian languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Devanagari"@en .

aat:300404632 a skos:Concept ;
    skos:definition "General term for various combinations of ground, powdery pigment and aqueous binder that are used in drawing and dry painting, delivered via a crayon or stick. Pastel as a material is soft and blendable. For the crayons or sticks containing the pigment and binder, use \"pastels (crayons).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastel"@en .

aat:300404633 a skos:Concept ;
    skos:definition "The technique of using a metal rod, usually in a holder, to write or draw on a surface, often paper, parchment, or wood that has been covered by a ground. Ivory is another common support. As the point moves across the surface, it leaves behind a thin layer of the metal, which quickly oxidizes. For example, lines from silver points becomes the brownish grey of tarnished silver and lines from lead points becomes very dark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalpoint"@en .

aat:300404634 a skos:Concept ;
    skos:definition "Technique using a silver wire or rod to draw on a prepared surface, usually paper or parchment; when a silver mark is made on the ground, the metal particles tarnish to form a black mark of silver sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silverpoint"@en .

aat:300404635 a skos:Concept ;
    skos:definition "Drawings made using as medium a metal wire or rod, usually in a holder, to make marks on a prepared support of paper, parchment, or wood support, or on ivory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalpoint drawings"@en .

aat:300404636 a skos:Concept ;
    skos:definition "Drawing implements comprising a wire, rod, or piece of gold in a holder, used to draw lines on a prepared surface, such as paper or parchment. When oxidized, the line darkens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold points"@en .

aat:300404637 a skos:Concept ;
    skos:definition "Works created with ink and diluted ink applied with a brush, usually on paper. They are variously classified as paintings or as drawings. Examples of highly developed ink wash paintings are found in Chinese and Japanese tradition. Usage may overlap with \"pen and wash drawings,\" which however involve drawing with a pen, not only brush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink wash paintings"@en .

aat:300404638 a skos:Concept ;
    skos:definition "Technique of applying diluted ink with a paint brush to create images, which may be classified as paintings or drawings and are often monochromatic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink wash"@en .

aat:300404639 a skos:Concept ;
    skos:definition "The relative disposition and way of arrangement of the various parts of the body of a human, or sometimes of an animal. Includes the position and carriage of the limbs, hands, head, or the body as a whole, often as indicating a particular quality or feeling. Examples of displays of body position include in the visual arts, dance, and ritual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body position"@en .

aat:300404640 a skos:Concept ;
    skos:definition "The complete physical forms of humans and other animals. Includes the outer appearance and constitution, as well as internal features, such as organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodies"@en .

aat:300404641 a skos:Concept ;
    skos:definition "Hand gesture indicating discourse or discussion, such as preaching the dharma. The tips of the index finger and thumb form a circle, with other fingers pointed upward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitarka mudra"@en .

aat:300404642 a skos:Concept ;
    skos:definition "Hand gesture indicating respect and salutation. The two hands are held near the chest with palms touching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anjali mudra"@en .

aat:300404643 a skos:Concept ;
    skos:definition "Hand gesture indicating teaching, the turning the wheel. Using both hands held at chest level, the hands touch each other in any of several ways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dharmacakra mudra"@en .

aat:300404644 a skos:Concept ;
    skos:definition "Hand gesture indicating touching the earth; used for seated figures, usually the Sakyamuni Buddha in his victory of Mara. The right hand, palm inward and extending downward, touches or gestures in the direction of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhumisparsa mudra"@en .

aat:300404645 a skos:Concept ;
    skos:definition "Hand gesture indicating the union of the five knowledges of the jina Buddhas into a single enlightenment. The index finger of the left hand is enclosed by the five fingers of the right hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodhyangi mudra"@en .

aat:300404646 a skos:Concept ;
    skos:definition "Hand gesture indicating a threat, warning, and wrath. Pose comprises a raised index finger in a menacing attitude, with other fingers locked in a fist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarjani mudra"@en .

aat:300404647 a skos:Concept ;
    skos:definition "Hand gesture meaning the syllable \"hum.\" The hands and wrists are crossed in front of the chest; the right hand holds a vajra and the left holds a ghanta, symbolizing the union of male and female, skill and wisdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vajrahunkara mudra"@en .

aat:300404648 a skos:Concept ;
    skos:definition "A boon-giving hand-gesture, representing bestowing of gifts. The hand is extended downward with the palm outward, as if offering something to a devotee; an object of offering may be held in the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "varada mudra"@en .

aat:300404649 a skos:Concept ;
    skos:definition "Hand gesture representing explanation, exposition, or discourse. The hand is presented with palm outward, the fingers upward, and the thumb and index finger forming a circle. A hand-gesture of exposition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vyakhyana mudra"@en .

aat:300404650 a skos:Concept ;
    skos:definition "Proper nouns comprising a word or phrase that constitutes the individual designation by which a particular person or thing is known, referred to, or addressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "names"@en .

aat:300404651 a skos:Concept ;
    skos:definition "In the context of personal names, particularly in western culture, a first name is the name given to a person at birth or an early period of life, historically at baptism and historically chosen to signify or honor a saint, an earlier family member, or a personal characteristic. In modern western usage, a first name is combined with a family name or other names to distinguish between multiple people having the same first name. In other traditions, such as Islamic tradition, the first name may be a religious name or another sort of name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first names"@en .

aat:300404652 a skos:Concept ;
    skos:definition "In the context of modern western personal names, the names that are hereditary and common to all members of a family, placed at the end of a string of names for an individual; used with a first name to distinguish an individual from others with the same first name. In other cultural traditions, last names may not be hereditary family names or they may not be used at all. Before last names became common in western tradition, personal names were qualified with the addition of epithets, place names, ancestors' names, or terms for professions; these were added to a first name on an individual basis, not necesssarily hereditary for a family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "last names"@en .

aat:300404654 a skos:Concept ;
    skos:definition "In the context of personal names, particularly in western culture, names that are positioned between a first name and a last name, possibly comprising an additional familiar name or a maternal family name. In other traditions, such as Islamic tradition, the middle name may be the primary personal name (analogous to the first name in western tradition) or another sort of name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle names"@en .

aat:300404655 a skos:Concept ;
    skos:definition "Proper names of geographic locations, such as a nations, empires, towns, villages, hills, or lakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place names"@en .

aat:300404656 a skos:Concept ;
    skos:definition "Names or appellations that are given to a person, animal, or place as a familiar or humorous replacement for, or addition to, the proper name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nicknames"@en .

aat:300404657 a skos:Concept ;
    skos:definition "General term for false or ficticious names or appellations used instead of personal names, place names, and other names. When adopted for personal names, pseudonyms may be used to conceal the real identity of the person, for example, as used by authors and artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudonyms"@en .

aat:300404658 a skos:Concept ;
    skos:definition "Names, or words or phrases used as names, that are descriptive or connotative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appellations"@en .

aat:300404659 a skos:Concept ;
    skos:definition "Sets or group of initial letters used as an abbreviation for a name or expression and pronounced as a single word."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acronyms"@en .

aat:300404660 a skos:Concept ;
    skos:definition "Sets or group of initial letters used as an abbreviation for a name or expression, for which each letter is pronounced separately. For initials pronounced as syllables or single word, use \"acronyms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initialisms"@en .

aat:300404661 a skos:Concept ;
    skos:definition "Appellations indicating honor or nobility, attaching to an individual or family rank, function, office, attainment, or the possession of or association with certain lands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titles"@en .

aat:300404662 a skos:Concept ;
    skos:definition "Appellations, words, or phrases that follow a personal name. For example words or numerals denoting family relationships, usually between members having the same first name, such as the senior and junior of two indicated persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suffixes"@en .

aat:300404663 a skos:Concept ;
    skos:definition "Nicknames indicating a diminutive or affectionate reference. In English, often made with the addition of a \"y\" or \"ie.\" An example would be \"Annie\" used for \"Ann.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypocorisms"@en .

aat:300404664 a skos:Concept ;
    skos:definition "Alternative names for a person, corporate body, place, or thing; possibly but not necessarily false or assumed names; they may be simply variant forms of proper names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aliases"@en .

aat:300404665 a skos:Concept ;
    skos:definition "The condition of providing access and being unblocked. Typically relating to an object or environment that has both an open and closed state, such as a book, box, vessel, garment, gate, window, room, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open"@en .

aat:300404666 a skos:Concept ;
    skos:definition "The condition or status of prohibiting access and being blocked. Typically relating to an object or environment that has both an open and closed state, such as a book, box, vessel, garment, gate, window, room, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed"@en .

aat:300404668 a skos:Concept ;
    skos:definition "Information that is formatted, stored, and linked in a way to allow efficient retrieval. It is often used in conjunction with or distinguished from \"display information.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexing information"@en .

aat:300404669 a skos:Concept ;
    skos:definition "Information that is formatted and presented in a form that is easily legible and understood by users, often allowing expressions of uncertainty and nuance. Display information is often used in conjunction with \"indexing information.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display information"@en .

aat:300404670 a skos:Concept ;
    skos:definition "Terms or names that are designated among all synonyms or lexical variants for a concept, to be used as the default term or name in displays and other situations; distinguished from \"nonpreferred terms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preferred terms"@en .

aat:300404671 a skos:Concept ;
    skos:definition "Multiple-word terms or names that are arranged in the form used in speech or written text. Examples are Christopher Wren and flying buttresses. Distinguished from inverted terms or names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural order terms"@en .

aat:300404672 a skos:Concept ;
    skos:definition "Multiple-word terms or names that are arranged in the form used in back-of-book indexing or other similar situations. Examples are Wren, Christopher and buttresses, flying. Distinguished from natural order terms or names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inverted terms"@en .

aat:300404673 a skos:Concept ;
    skos:definition "Culture and style that developed beginning in the early-14th-century among the ruling elites of successor states of the Mongol Empire; retained Mongol political and legal institutions, but adopted Turkic languages and religions such as Buddhism and Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turko-Mongol"@en .

aat:300404674 a skos:Concept ;
    skos:definition "Technique or painting on paper, ceramics, or another surface, where the design is created through application of a temporary protective layer of paint, wax, or another material. The surface is then coated with ink, glaze, or another material. When the work is fired or washed, heat or the action of water removes the excess coating, and protective layer has allowed the underlying colors or design to remain pristine; uncovered areas have absorbed the color of the coating. For resist work done on textiles, use \"resist dyeing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resist painting"@en .

aat:300404675 a skos:Concept ;
    skos:definition "Works created by using a resist material, such as tempera, gouache, waxy crayon, or another material, to create a design on a support, usually heavy watercolor paper. The design is covered with ink, allowed to dry, and the ink is washed off. In areas where the underlying material was omitted or thinly applied, the black ink pervades; in areas where the underlying material was more thickly applied, its color and texture remain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink resist paintings"@en .

aat:300404676 a skos:Concept ;
    skos:definition "Drawings using ink as the primary medium and pen as the primary implement, usually on paper but may be on another support. Such drawings have a distinctive, linear appearance. For drawings that use pen and ink as well as washes, prefer \"pen and wash drawings.\" For drawings or paintings using ink applied with brushes, use \"ink wash paintings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen and ink drawings"@en .

aat:300404677 a skos:Concept ;
    skos:definition "In Japanese culture, names used by artists in place of their given names. One artist could have multiple gō; for example, Hokusai used 30 such names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gō"@en .

aat:300404678 a skos:Concept ;
    skos:definition "Regarding personal names, assumed names used by authors rather than their real names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen names"@en .

aat:300404679 a skos:Concept ;
    skos:definition "Regarding personal names, assumed names used by actors and other performers rather than their real names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stage names"@en .

aat:300404680 a skos:Concept ;
    skos:definition "Regarding personal names, assumed names under which people engage in combat or, by extension, in some other analogous activity or enterprise such as spying or courtship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noms de guerre"@en .

aat:300404681 a skos:Concept ;
    skos:definition "Regarding personal names, names given to a person at birth or soon thereafter; used to distinguish the person's original name from later assumed names or name changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth names"@en .

aat:300404682 a skos:Concept ;
    skos:definition "Regarding personal names, last names held by a woman prior to marriage, at which time she may adopt her husband's last name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maiden names"@en .

aat:300404683 a skos:Concept ;
    skos:definition "Personal names that include last names acquired by a person, usually a woman, through marriage; distinguished from \"maiden names.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "married names"@en .

aat:300404684 a skos:Concept ;
    skos:definition "Regarding personal names, names not having particular religious signficance, used to distinguish such names from names assigned to a person for religious reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secular names"@en .

aat:300404685 a skos:Concept ;
    skos:definition "Personal names acquired by a person when assuming religious orders or otherwise assigned to the person for religious reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious names"@en .

aat:300404686 a skos:Concept ;
    skos:definition "Names for people, places, or things that are used in or sanctioned by the person or corporate body for use in official contexts, or that has been sanctioned by an official body or in official documentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "official names"@en .

aat:300404687 a skos:Concept ;
    skos:definition "Names for people, places, or things that are commonly used, but not necessarily the official version of the name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common names"@en .

aat:300404688 a skos:Concept ;
    skos:definition "Names for people, places, or things that are the fullest version of the name. For personal names, includes the first name, one or more middle names, one or more family names and last names, suffixes, and honorifics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full names"@en .

aat:300404689 a skos:Concept ;
    skos:definition "Buddhist monks' names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hōmyō"@en .

aat:300404690 a skos:Concept ;
    skos:definition "Ritual weapons of Hinduism and Buddhism. A symbol of indestructibility and power often depicted as a ritual scepter or club and as an attribute of guardian deities. A vajra is in the form of a club having a head on both ends or on one end; the head is either ribbed to form a sphere or pointed to stab. The term means thunderbolt and diamond, symbolizing the indestructibility of diamond and the irresistible force of the thunderbolt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vajras"@en .

aat:300404691 a skos:Concept ;
    skos:definition "Ghantas, ritual handbells, having a vajra ritual scepter or club at the other end of the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vajra-ghantas"@en .

aat:300404692 a skos:Concept ;
    skos:definition "Celestial courtesans, beautiful female beings in Hindu and Buddhist religion. Often depicted as ethereal, flying, or cloud-borne female deities; for example, they may be depicted scattering flowers above preaching scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apsarasas"@en .

aat:300404693 a skos:Concept ;
    skos:definition "A semivernacular medieval Chinese literary genre often featuring Buddhist content; the term means \"transformation text.\" The genre developed as a popularization of Buddhist doctrine through storytelling, pictorial representation, and performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bianwen"@en .

aat:300404694 a skos:Concept ;
    skos:definition "Visual compositions incorporating content from a particular Buddhist text, usually taken from descriptions in sutras having to do with transformative experiences. Examples include birth in a Buddhist paradise, the intervention of bodhisattvas in human affairs, and images of hell. These are ritual works, not only illustrative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bianxiang"@en .

aat:300404695 a skos:Concept ;
    skos:definition "Genre of ancient and medieval texts comprising short mnemonic rules, sayings, principles, or observations, often expanded upon by means of a commentary. Known in Hinduism, Buddhism, and Jainism; in Buddhism, sutras are typically discourses or sermons believed to have been delivered or authorized by the Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sutras"@en .

aat:300404696 a skos:Concept ;
    skos:definition "Literary genre based on the Biblical New Testament, comprising the stories and body of religious doctrine described as having been taught by Jesus and apostles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gospels"@en .

aat:300404697 a skos:Concept ;
    skos:definition "Literary genre taking the form of letters, usually of a literary, formal, or public nature. Examples are the epistles in the Biblical New Testament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epistles"@en .

aat:300404698 a skos:Concept ;
    skos:definition "In Buddhism, teachers regarded as having attained full awakening or enlightenment; beings who have achieved complete, perfect comprehension of ultimate reality, thus exiting the cycle of samsara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buddhas"@en .

aat:300404699 a skos:Concept ;
    skos:definition "In Buddhism and Hinduism, incantations of sacred Sanskrit or pseudo-Sanskrit syllables or phrases that are used as protective devices and to support concentration; they reference short summaries of the essential doctrine contained in a much longer sacred text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhāraṇīs"@en .

aat:300404700 a skos:Concept ;
    skos:definition "In Hinduism and Buddhism, sacred utterances of a syllable, word, or verse that is considered to possess mystical or spiritual efficacy. Mantras may be spoken aloud or sounded internally in thoughts, either repeated continuously for some time or just sounded once. Most mantras are without any apparent verbal meaning, but they are thought to have a profound underlying significance and are in effect distillations of spiritual wisdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantras"@en .

aat:300404702 a skos:Concept ;
    skos:definition "The chain of causation that drives all phenomena, in which virtuous actions lead to future happiness and evil acts the opposite. The sum of a person's actions in one of his successive states of existence, regarded as determining his fate in the next. Among symbols for karma is the endless knot. Karma is a key concept in Hinduism, Buddhism, Jainism, Sikhism, and Taoism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karma"@en .

aat:300404703 a skos:Concept ;
    skos:definition "In Hindu and Buddhist mythology, guardians. In Hinduism, guardians of the four cardinal directions. In Buddhism, the four heavenly kings and other protector spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lokapālas"@en .

aat:300404704 a skos:Concept ;
    skos:definition "Identifying numeric or alpha codes found, usually on the spine, of a manuscript, book or other volume, giving the location where the item can be found in the library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelf marks"@en .

aat:300404705 a skos:Concept ;
    skos:definition "In theology, the quality derived through actions that entitles the doer to reward. For example, in Buddhism, merit is gained through virtuous acts leading to rewards in this life or future rebirths; in Christianity, merit from good works may result in spiritual rewards from God in the afterlife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merit"@en .

aat:300404706 a skos:Concept ;
    skos:definition "In Buddhism, the final nirvana or nirvana-after-death, which occurs upon the death of the body or ultimate departure from the conventional realm of a person who is an awakened being, having attained nirvana during his or her lifetime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parinirvāṇa"@en .

aat:300404707 a skos:Concept ;
    skos:definition "In Buddhism, objects or images considered \"auspicious images,\" for example, an image of the Buddha that had a miraculous appearance or characteristics considered to be a sign of divine favor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruixiang"@en .

aat:300404708 a skos:Concept ;
    skos:definition "Hairstyle in which the hair is allowed to grow long without combing, and otherwise encourged to form into matted locks over the head. An example is seen with Rastafarians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dreadlocks"@en .

aat:300404709 a skos:Concept ;
    skos:definition "Hairstyles incorporating plaited, interwoven, or entwined strands of hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braids"@en .

aat:300404710 a skos:Concept ;
    skos:definition "Hairstyles incorporating a large coil or mass of hair wound around itself or a form and positioned on the nape of the neck or back of the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chignons"@en .

aat:300404711 a skos:Concept ;
    skos:definition "Hairstyles in which the hair is gathered and fastened at one point on the back of the head, or on either side of the head, but otherwise unfastened, so that it hangs down to somewhat resemble a horse's tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ponytails"@en .

aat:300404712 a skos:Concept ;
    skos:definition "Physical mark identifying a buddha, conventionally depicted as a cranial bump and said to possess magical properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uṣṇīsạ"@en .

aat:300404713 a skos:Concept ;
    skos:definition "Hairstyles in which long hair is gathered and wound into a knob of hair on the crown of the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topknots"@en .

aat:300404714 a skos:Concept ;
    skos:definition "The literary Indo-Aryan language of Buddhist canonical books and of the later Theravada Buddhist chronicles, commentaries, and other literature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pali"@en .

aat:300404715 a skos:Concept ;
    skos:definition "In architecture and engineering, the divisions, parts, extent, distances, or spaces between supporting elements; for example between the abutments of an arch, the supports of a beam, the piers of a bridge, or the walls carrying a roof or dome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spans"@en .

aat:300404716 a skos:Concept ;
    skos:definition "In Buddhism, a ūrṇā is a tuft of hair, conventionally depicted as a bump or jewel, in the middle of the forehead; one of the physical marks identifying a buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ūrṇā"@en .

aat:300404717 a skos:Concept ;
    skos:definition "The forehead is the part of the face extending upward from the eyebrows to the natural line of the hair in humans; also the corresponding part of the face in animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foreheads"@en .

aat:300404718 a skos:Concept ;
    skos:definition "Names or appellations used to reference people who have died. Prime examples are honorary names given to a person after death in East Asia, particularly as given to royalty, nobles, and some others, used rather than the original personal name after death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posthumous names"@en .

aat:300404719 a skos:Concept ;
    skos:definition "Names given for use in, or with reference to, a temple. In East Asian tradition, temple names usually comprise two characers, given after death to royalty and some others, referencing the great temple where royalty gathered to worship their ancestors. In contrast to \"posthumous names\" in this tradition, temple names are simple. In the protestant Morman church, members are assigned a new \"temple name\" in the Morman Temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temple names"@en .

aat:300404720 a skos:Concept ;
    skos:definition "Culture, nationality, and style of the proto-Mongols historically residing in current eastern Mongolia, Inner Mongolia, and Northeast China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xianbei"@en .

aat:300404721 a skos:Concept ;
    skos:definition "The socialogical concept of sacrificing of oneself or one's own needs; the giving up of one's own interests, happiness, desires, and even life, for the sake of duty or the welfare of others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-sacrifice"@en .

aat:300404722 a skos:Concept ;
    skos:definition "The action or state of achieving a state of greater knowledge, understanding, or insight. For example, in Buddhism, it is the state of spiritual insight or awareness which frees a person from the cycle of suffering and rebirth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enlightenment"@en .

aat:300404723 a skos:Concept ;
    skos:definition "Manmade drilled, bored, or dug subterranean artificial water channels for the purposes of navigation and boating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canal tunnels"@en .

aat:300404724 a skos:Concept ;
    skos:definition "Green pigment prepared as a mixture of blue and yellow, often indigo and orpiment, and used as an alternative to verdigris by Medieval painters and for illuminated manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vergaut"@en .

aat:300404725 a skos:Concept ;
    skos:definition "Physical artifacts transmitted intergenerationally in a society and invested with significance in that society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tangible cultural heritage"@en .

aat:300404726 a skos:Concept ;
    skos:definition "Named for the Baths of Zeuxippus in Constantinople (Turkey) where it was first identified in 1927, this sgraffito-decorated, lead-glazed pottery from the late 12th and early 13th centuries can be identified by its shiny pale green, yellow, or cream lead glaze and its white, thick slip, which covers most of the inside and the upper part of the outside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zeuxippus ware"@en .

aat:300404727 a skos:Concept ;
    skos:definition "Practices, representations, expressions, knowledge, skills – as well as the instruments, objects, artifacts and cultural spaces associated therewith – that communities, groups and, in some cases, individuals recognize as part of their cultural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intangible cultural heritage"@en .

aat:300404728 a skos:Concept ;
    skos:definition "People who specialize in making tintyptes, which are variants of the wet collodion process producing a direct positive image on a thin sheet of lacquered metal (usually iron, never tin)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tintypists"@en .

aat:300404729 a skos:Concept ;
    skos:definition "Any people or corporate bodies, occasionally also animals or inanimate things, that cause, own, oversee, or are otherwise responsible for a thing, person, animal, condition, status, or action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "responsible parties"@en .

aat:300404730 a skos:Concept ;
    skos:definition "A green mineral named in 1801 by D. de Fallizen for the Atacama Desert in Chile. It occurs naturally as copper oxychloride in oxidation zones of copper deposits in North America, Europe, Asia, and Australia, or as chloride corrosion on copper and bronze. The mineral has been used as a pigment on sculpture, manuscripts, maps, and frescoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atacamite"@en .

aat:300404731 a skos:Concept ;
    skos:definition "A pigment ranging in color from muted green to a blackish green that has been found on sculptures, manuscripts, and frescoes. It derives from a green mineral composed of copper oxychloride occurring naturally in oxidation zones of copper deposits or as chloride corrosion on copper and bronze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atacamite"@en .

aat:300404732 a skos:Concept ;
    skos:definition "Status of recognition and protection for a structure, area, or thing. An example is the status assigned by the U.S. National Register of Historic Places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic status"@en .

aat:300404733 a skos:Concept ;
    skos:definition "Large rugged masses comprising primarily hard mineral material or stone and forming a cliff, crag, or other natural feature on dry land or the seabed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocks"@en .

aat:300404734 a skos:Concept ;
    skos:definition "Breed hound that is trained and used for fox hunting; bred for a strong hunting instinct, energy, and keen sense of smell. There are variations of the breed in America and Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foxhounds"@en .

aat:300404735 a skos:Concept ;
    skos:definition "Breed hound that is trained and used for hare hunting; the breed resembles the foxhound, but is smaller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harriers"@en .

aat:300404736 a skos:Concept ;
    skos:definition "Arched roofs erected over platforms with a single pitch on each side of a central ridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbrella roofs"@en .

aat:300404737 a skos:Concept ;
    skos:definition "A crystalline or granular mineral consisting of a molybdate of lead and ranging in color from orange-yellow to olive green or darker. It can be used as a yellow pigment and in making molybdate red and orange pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wulfenite"@en .

aat:300404738 a skos:Concept ;
    skos:definition "A pigment ranging from orange-yellow to olive green, derived from the mineral of the same name, consisting of a molybdate of lead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wulfenite"@en .

aat:300404739 a skos:Concept ;
    skos:definition "People who possess capital assets, and typically invest the assets for profit in financial and business enterprises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capitalists"@en .

aat:300404740 a skos:Concept ;
    skos:definition "Style, particularly of architecture, incorporating classical elements and designs that developed in the Renaissance period in France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Renaissance"@en .

aat:300404741 a skos:Concept ;
    skos:definition "Refers to areas reserved for natural woodland, often in the context of urban growth or in landscape design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodland areas"@en .

aat:300404742 a skos:Concept ;
    skos:definition "State of partial undress in which the individual is without shoes or other foot coverings, in a circumstance where shoes may be expected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barefoot"@en .

aat:300404743 a skos:Concept ;
    skos:definition "Chinese clapperless bells, usually of bronze; includes bells used as percussion instruments in ancient China, such as those famously produced during the late Zhou dynasty (ca. 600-255 BCE). The term also denotes the religious bells used daily in Buddhist temples. Made of clay in Neolithic times, the zhong was crafted in bronze during the Shang dynasty (ca. 1600-1066 BCE). In performance the early zhong was either held by hand or placed on a base with its mouth upward and struck with a mallet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zhong"@en .

aat:300404744 a skos:Concept ;
    skos:definition "Thrones depicted in Buddhist art or used in Buddhism that are supported by lions or incorporating lions in the design; most often thrones upon which the Buddha is seated. An example is the seated Buddha in which eight lions positioned at the corners of the base or dais support his lotus throne; another example is the throne of the Dalai Lama of Tibet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lion thrones"@en .

aat:300404746 a skos:Concept ;
    skos:definition "A couplet is a pair of successive lines of verse, typically that are rhyming together and of the same length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couplets"@en .

aat:300404747 a skos:Concept ;
    skos:definition "The culture or style of the area around Madrid, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Madrilenian"@en .

aat:300404748 a skos:Concept ;
    skos:definition "The culture or style of the area around Seville, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sevillian"@en .

aat:300404749 a skos:Concept ;
    skos:definition "Genus of flowering plant native primarily to North and South America. The common sunflower is an annual herb with a rough hairy stem 1–4.5 metres (3–15 feet) high, broad, coarsely toothed, rough leaves 7.5–30 cm (3–12 inches) long, and heads of flowers 7.5–15 cm wide in wild specimens and often 30 cm or more in cultivated types. The disk flowers are brown, yellow, or purple; the ray flowers are yellow. The oval hairy leaves are arranged in spirals. The sunflower plant is valuable from an economic as well as from an ornamental point of view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Helianthus"@en .

aat:300404750 a skos:Concept ;
    skos:definition "A set of orders of architecture, typically reserved for the five orders of architecture known in ancient Greece and Rome, usually including Ionic, Doric, Corinthian, Composite, and Tuscan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classical orders"@en .

aat:300404751 a skos:Concept ;
    skos:definition "Façades and other exterior walls having an overall design, such as stripes or geometric patterns, comprising stones of contrasting colors. Examples are the distinctive polychrome façades that typify Tuscan architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polychrome façades"@en .

aat:300404752 a skos:Concept ;
    skos:definition "General term for western-made, high quality handmade paper with a warm ivory or yellowish color, and a smooth, slightly mottled surface. It was highly valued for printmaking. It is called \"japan\" because it was thought to resemble Japanese printmaking paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "japan paper"@en .

aat:300404753 a skos:Concept ;
    skos:definition "General term for the conceptual arrangement of a built work, as imagined in a horizontal section of the building; including the footprint, the arrangement of the passages, rooms, and openings, colonnades, walls, and partitions, at the level of the principal or ground floor. For drawings or other visual works that represent the conceptual floor plan, use \"floor plans (orthographic projections).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor plans"@en .

aat:300404754 a skos:Concept ;
    skos:definition "People who hoard wealth and are avaricious, grasping, stingy, and parsimonious; in the original meaning, such people live miserably in order to hoard wealth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misers"@en .

aat:300404755 a skos:Concept ;
    skos:definition "Distinctive masks of the Igbo people, worn by men to appease the spirits of beautiful girls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mmo masks"@en .

aat:300404756 a skos:Concept ;
    skos:definition "Entrances to the underworld as known in any of various religions and belief systems. The gates of hell may be either apprehended in a material sense to correspond to caves or other places on earth, or conceived of in only an abstract or spiritual sense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gates of hell"@en .

aat:300404757 a skos:Concept ;
    skos:definition "A type of x-ray fluorescence used for elemental analysis that involves exciting elements in a sample then diffracting the emitted radiation by using a device, such as a crystal or monochromator, in order to measure the intensity of x-rays with a specific wavelength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wavelength-dispersive x-ray fluorescence"@en .

aat:300404758 a skos:Concept ;
    skos:definition "A type of flat Japanese fan that does not fold, comprising a disc or other shape attached to a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uchiwas"@en .

aat:300404759 a skos:Concept ;
    skos:definition "Fans, either with or without a decorative paper or silk leaf, having a basic structure of tapering, flat strips, often wooden or bamboo, threaded together and also secured by a rivet or pivot at the base, allowing the fan to fold into a compact shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding fans"@en .

aat:300404760 a skos:Concept ;
    skos:definition "Attribute or physical configuration where sides or edges converge or meet, forming angular extremities or projections. Examples are the walls of a building, the sides of a box, the angular meeting of boundaries on a map, or the angular formation of a natural physical feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corners"@en .

aat:300404761 a skos:Concept ;
    skos:definition "The function of watching or guarding people, activities, or situations, usually having a connotation of spying on a suspected person or a prisoner, or observing in order to provide supervision for direction or control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveillance"@en .

aat:300404762 a skos:Concept ;
    skos:definition "The office and dignity of royalty, especially of a king or queen and their reign."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kingship"@en .

aat:300404763 a skos:Concept ;
    skos:definition "The status and dignity of deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "godship"@en .

aat:300404764 a skos:Concept ;
    skos:definition "The originating cause or substance of some material thing or physical agency, or the conceptual inspiration for a conceptual thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sources"@en .

aat:300404765 a skos:Concept ;
    skos:definition "General term for Native North American period and culture dating approximately 1000- 200 BCE, characterized by the continuation of traditions begun during the Late and Terminal Archaic periods, such as mound-building, burial complexes, inter-regional trade, reliance on wild and domesticated plants, and movements of small groups to exploit seasonally available resources. Production of pottery became more widespread in the following regions: Eastern Interior, the Southeast, and the Northeast; the Far Northeast, the Sub-Arctic, and a bit later, the Northwest and Plains regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Woodland"@en .

aat:300404766 a skos:Concept ;
    skos:definition "General term for Native North American period and culture dating approximately 200 BCE–500 CE, characterized by a shift of settlement to the interior of North America, an expansion of local and inter-regional trade, finer ceramics, and a shift to more elaborate burial practices for important people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Woodland"@en .

aat:300404767 a skos:Concept ;
    skos:definition "General term for Native North American period and culture dating approximately 500-1000 CE, characterized by an apparent dispersion of population, less trade, less emphasis on burial mounds, increased agricultural production, and advancement in bow and arrow technology that overtook the use of the spear and atlatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Woodland"@en .

aat:300404768 a skos:Concept ;
    skos:definition "Class of North American Native American projectile points known in three varieties, corner notched, stemmed, and serrated; first seen in the Early to Middle Archaic transition periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kirk points"@en .

aat:300404769 a skos:Concept ;
    skos:definition "The condition or quality of not depending on another, as applied to a political entity, other group, or an individual. Includes the exemption from external control or support, freedom from subjection, or from the influence of others, and individual liberty of thought or action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "independence"@en .

aat:300404770 a skos:Concept ;
    skos:definition "Arrangements of ropes, wires, chains, cables, hooks, and other fittings used to support and move components of a constructed thing. A primary example is \"nautical rigging,\" used for securing or supporting masts, yards, and for hoisting, lowering, or trimming the sails. Other examples include, but are not limited to, the wires or cables used to support the structure a hot-air balloon and distribute the load over its surface, the cables supporting the wings of a biplane, and the system of cables, hooks, chains used in hauling logs, and hooks and cables used in architectural construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigging"@en .

aat:300404771 a skos:Concept ;
    skos:definition "Portaits in any medium that focus on the head and face of the sitter, omitting all or most of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portrait heads"@en .

aat:300404772 a skos:Concept ;
    skos:definition "People who watch other people or situations secretly or in stealth, usually such people having this as a career or who are otherwise rewarded for the work. Examples are secret agents employed by a government in order to obtain information relating to military affairs or to collect other intelligence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spies"@en .

aat:300404773 a skos:Concept ;
    skos:definition "Distinctive ceremonial masks of the Chokwe people, in the form of an ideal of feminine beauty, including traditional scarification, but worn by men who also weare false breasts and a skirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pwo masks"@en .

aat:300404774 a skos:Concept ;
    skos:definition "Architectural order characterized especially by the use of rusticated columns and introduced by the French architect Delorme"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French order"@en .

aat:300404775 a skos:Concept ;
    skos:definition "Architectural order similar to the Ionic order, but differing in that the capital features a palmette motif rising between the two outer volutes, rather than being linked horizontally by a form at the top of the capital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aeolic order"@en .

aat:300404776 a skos:Concept ;
    skos:definition "Indication in texts, databases, tables, and lists when information for the instance at hand is applicable in a former iteration or earlier scholarship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former"@en .

aat:300404777 a skos:Concept ;
    skos:definition "Indication in texts, databases, tables, and lists when information for the instance at hand is possibly applicable, although not all facts or scholars agree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "possible"@en .

aat:300404778 a skos:Concept ;
    skos:definition "Gardens that employ one or more raised flat sections, either planted, paved, or gravelled, to allow efficient gardening on a sloping surface, to provide prospect overlooks, or for other reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrace gardens"@en .

aat:300404779 a skos:Concept ;
    skos:definition "Verbal or written communication from one person to another as a means of acquainting one of the people to a third person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "introductions"@en .

aat:300404781 a skos:Concept ;
    skos:definition "Refers to the movement or style evolving from Photorealism in the United States and Europe. Historically the term has often been used interchangeably with Photorealism. Hyperrealism may now be considered a separate idiom, particularly since the early 2000s. Hyperrealist works use photographic images as sources to make even more exacting renderings of subject matter. Hyperrealist painting and sculpture often incorporates narrative, emotive, or political content, unlike Photorealist works, which attempted to eschew subjectivity through precise rendering of the photographs themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hyperrealist"@en .

aat:300404782 a skos:Concept ;
    skos:definition "Buildings used for assemblies of Muslims to gather during Muharram."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imambaras"@en .

aat:300404784 a skos:Concept ;
    skos:definition "Mobile telephones that incorporate a digital cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera phones"@en .

aat:300404785 a skos:Concept ;
    skos:definition "Writing systems in which consonant-vowel sequences are written as a unit: each unit comprises a consonant letter with a secondary vowel notation. Examples of alphasyllabaries are the Brahmic scripts of South and Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphasyllabaries"@en .

aat:300404786 a skos:Concept ;
    skos:definition "Scripts developed in India or South Asia, typically associated with the Indian branch of the Indo-Iranian languages, Indo-Aryan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indic scripts"@en .

aat:300404787 a skos:Concept ;
    skos:definition "Style and culture that flourished in India or South Asia, often associated with those who spoke the Indian branch of the Indo-Iranian languages, Indo-Aryan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indic"@en .

aat:300404788 a skos:Concept ;
    skos:definition "Ancient alphasyllabic script, noted as one of the oldest writing systems used in South and Central Asia, dating approximately 3rd century BCE and earlier to 3rd century CE and later. Important examples of Brahmi inscriptions include edicts inscribed in stone in Northern Central India from 3rd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brahmi script"@en .

aat:300404789 a skos:Concept ;
    skos:definition "A group of writing systems that are descended from the Brahmi script of ancient India, and now used throughout South Asia, Southeast Asia, East Asia, and formerly in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brahmic scripts"@en .

aat:300404790 a skos:Concept ;
    skos:definition "A Middle Iranian language that was best known in the Sogdiana province."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sogdian"@en .

aat:300404791 a skos:Concept ;
    skos:definition "Writing system originally used for the Sogdian language and derived from the Syriac writing system. It is a consonantal writing system, in each symbol stands for a consonant, leaving the reader to supply the appropriate vowel. The script consists of 17 consonants, many of which have alternate forms for initial, middle, and final position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sogdian"@en .

aat:300404792 a skos:Concept ;
    skos:definition "Alphasyllabary script that was used for writing Sanskrit ca 600/1200; descended from the Gupta script, in turn developed from Brahmi script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siddhaṃ"@en .

aat:300404793 a skos:Concept ;
    skos:definition "An alphasyllabary script used for writing Sanskrit, as associated with the Gupta Empire of India; descended from Brahmi script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gupta script"@en .

aat:300404794 a skos:Concept ;
    skos:definition "The process or activity of writing, marking, or delineating words, a name, characters, or other designation, in or on something, usually with the intention that the inscription will be conspicuous or durable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inscribing"@en .

aat:300404795 a skos:Concept ;
    skos:definition "The process or activity of writing, marking, or delineating a date on something, usually indicating when the thing was created, and usually with the intention that the inscription will be conspicuous or durable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dating"@en .

aat:300404796 a skos:Concept ;
    skos:definition "People whose profession or activity is to curry, feed, and generally attend to animals; often those working with horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grooms"@en .

aat:300404797 a skos:Concept ;
    skos:definition "Clay used as a medium, typically dried but not intended to be fired. Examples include ancient clay tablets that were inscribed, dried, and then soaked in water for the purpose of reforming and reuse, and some clay surfaces used for wall paintings. For pottery in a state that is not yet fired, but firing is intended, use \"greenware.\" For bricks used as a building material but not fired, use \"soft brick\" or \"sun-dried brick.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unfired clay"@en .

aat:300404798 a skos:Concept ;
    skos:definition "The action or process of conveying or transporting over water, usually a small body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrying"@en .

aat:300404799 a skos:Concept ;
    skos:definition "Bohisattvas who serve as otherworldly guides of souls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guiding bodhisattvas"@en .

aat:300404800 a skos:Concept ;
    skos:definition "Circumstances, positions, or conditions that cause a person, group, or thing to be at risk, jeopardy, or danger, imminently exposed to the chance of injury, loss, death, or destruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perils"@en .

aat:300404801 a skos:Concept ;
    skos:definition "Circumstances, events, or conditions that are adverse, particularly those that are caused by, or are perceived to have been caused by, bad luck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misfortunes"@en .

aat:300404802 a skos:Concept ;
    skos:definition "Ceremonial weapon comprising a noose or lasso. In Hinduism and Buddhism, a supernatural weapon depicted in iconography and the attribute of certain deities such as Ganesha, Yama, and Varuna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pashas"@en .

aat:300404803 a skos:Concept ;
    skos:definition "The artistic device of repeating of a pattern, motif, or image multiple times in a composition of a single work, or in a series of works. May apply to the visual arts, as well as to music and literature. Examples in the visual arts include textile patterns and Buddhist printed scrolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repeated motif"@en .

aat:300404804 a skos:Concept ;
    skos:definition "Stencils made of a relatively thin material, usually paper, onto which a linear design is drawn or printed, and holes pricked along the outlines to allow transfer of the design by applying a powder, also called \"pounce,\" onto a surface beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounces"@en .

aat:300404805 a skos:Concept ;
    skos:definition "A technique for measuring x-ray fluorescence that involves exciting elements in a sample then diffracting the emitted radiation by using a device, such as a crystal or monochromator, in order to measure the intensity of x-rays with a specific wavelength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wavelength dispersive x-ray fluorescence spectrometry"@en .

aat:300404807 a skos:Concept ;
    skos:definition "A water-soluble white crystalline compound used predominantly as a fertilizer, as a fire retardant, or as a stone consolidant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diammonium phosphate"@en .

aat:300404809 a skos:Concept ;
    skos:definition "Family of flowering plant containing one genus, Paeonia, the peonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paeoniaceae"@en .

aat:300404810 a skos:Concept ;
    skos:definition "Family comprising around 6,000 species of usually colorful, usually medium-sized to large butterflies; distributed throughout most of the world. Most species have a small pair of forelegs and stand on only four legs, and in some species the forelegs are covered with brush-like hairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphalidae"@en .

aat:300404811 a skos:Concept ;
    skos:definition "According to many taxonomies, a subfamily of Nymphalidae butterflies that includes the morphos, the owl butterflies (Caligo), and related lineages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morphinae"@en .

aat:300404812 a skos:Concept ;
    skos:definition "According to many taxonomies, a tribe of the nymphalid butterfly subfamily Morphinae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morphini"@en .

aat:300404813 a skos:Concept ;
    skos:definition "Genus containing a large number of species of neotropical butterflies found mostly in South America, Mexico, and Central America. Many speices are distinguished by metallic, shimmering shades of blues and greens color on the dorsal side of the wings, with the ventral side brown with eyespots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morpho"@en .

aat:300404814 a skos:Concept ;
    skos:definition "Species of large, iridescent tropical butterfly of Central and South America; there are many subspecies. The males are more brightly colored than females, who also have blue on the dorsal wings, but have a much wider band of brown or dark coloration around the dorsal edges than the males."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morpho menelaus"@en .

aat:300404815 a skos:Concept ;
    skos:definition "Family containing around 1,450 species of moths; many are native to the tropics, but species are found globally. They are distinguished by being moderate to large in size, having rapid, sustained flying ability, narrow wings and streamlined abdomens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphingidae"@en .

aat:300404816 a skos:Concept ;
    skos:definition "Genus of moth having species found primarily in North and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eumorpha"@en .

aat:300404817 a skos:Concept ;
    skos:definition "Species of moth found widely in North, Central, and South America. There are several subspecies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eumorpha fasciatus"@en .

aat:300404818 a skos:Concept ;
    skos:definition "Actions or processes resulting in the change of form in an animal or its parts, during post-embryonic development. The term is used for the process of transformation from an immature form to a different adult form that many insects and other invertebrates, and some vertebrates (e.g., frogs), undergo in the course of maturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metamorphosis"@en .

aat:300404819 a skos:Concept ;
    skos:definition "Natural events, processes, and activities having to do with plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botanical events"@en .

aat:300404820 a skos:Concept ;
    skos:definition "In plants, the process or series of processes through which energy of light is absorbed by chlorophyll and utilized by the plants for the synthesis of complex organic compounds from carbon dioxide, with the accompanying oxidation of water to form oxygen. In animals, any of various similar processes by which the energy of light is converted to chemical energy for biosynthesis in bacteria, often involving alternative sources of carbon and not resulting in the generation of oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photosynthesis"@en .

aat:300404821 a skos:Concept ;
    skos:definition "Indication of multiple materials being used for a group, set, or other configuration of multiple works, including visual works, audio works, written works, or other types of works. For the indication of multiple materials being used on one single work, use \"mixed media.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiple materials"@en .

aat:300404822 a skos:Concept ;
    skos:definition "Objects used for exchange or purchase and having the shape of a weapon or that are weapons or parts of weapons, such as projectile points. Weapons used as currency are known from many historical periods globally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weapon currency"@en .

aat:300404823 a skos:Concept ;
    skos:definition "Currencies based on knives or knife-shaped objects as a means of purchasing or exchange. Examples are the obsidian knife currencies of Pre-Columbian America, the metal and stone knives used as currency in ancient Asia, and knife-shaped blades used as currency in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife currency"@en .

aat:300404824 a skos:Concept ;
    skos:definition "Usually restricted to usage in criminal law, the state or circumstance occurring when two or more parties agree or conspire to take some action, not necessarily for profit, but which makes all participants liable for an accident, crime, or debt arising out of the activity. Distinguished from \"joint venture (economic concept).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint enterprise"@en .

aat:300404826 a skos:Concept ;
    skos:definition "Discipline that studies the physical forces that affect the motion or equilibrium of material bodies, in modern usage including both statics and kinetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamics"@en .

aat:300404827 a skos:Concept ;
    skos:definition "In architecture, engineering, and other fields, the discipline that does structural analysis to study and predict the behavior of structures as subjected to dynamic actions, such as acceleration and loading. Dynamic loads include people, wind, waves, traffic, earthquakes, and blasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural dynamics"@en .

aat:300404828 a skos:Concept ;
    skos:definition "In geology, the discipline that studies and predicts the nature and operation of the forces by which the earth's surface are affected, as distinguished from the existing condition of the surface and the order and characteristics of the strata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological dynamics"@en .

aat:300404829 a skos:Concept ;
    skos:definition "Depictions in which the figure is cut off below the waist, usually mid-thigh or just below the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-quarter-length figures"@en .

aat:300404830 a skos:Concept ;
    skos:definition "Casting bottles designed and used to sprinkle fragrance, usually rosewater, in a room or for guests or others to sprinkle lightly on their fingers or elsewhere on their person. Important examples are rosewater bottles traditionally used in the Middle East to sprinkle rosewater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosewater bottles"@en .

aat:300404831 a skos:Concept ;
    skos:definition "Water distilled from roses or scented with essence of roses, used as a perfume, scenting a room, flavoring, in medicinal preparations, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosewater"@en .

aat:300404832 a skos:Concept ;
    skos:definition "Physical works, such as drawings and written documents, that were used in the planning or execution of a definable physical work or set of works; also includes the finished works. Alternatively, a project may be planned, but unexecuted. For the conceptual activities of planning or carrying out of proposed undertakings or creations, use projects (artistic concepts)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projects"@en .

aat:300404833 a skos:Concept ;
    skos:definition "Physical works, such as drawings and written documents, that were the result of a competition, particularly an artistic or architectural competition in which various applicants vie for a prize or for the assignment of a contract to create the finished work. For the event of the competition, use \"competitions (events).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "competitions"@en .

aat:300404834 a skos:Concept ;
    skos:definition "Function of the calling to remembrance, or preserving in memory, such as by solemn observance, public celebration, or other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorating"@en .

aat:300404835 a skos:Concept ;
    skos:definition "Figures depicted in a clearly seated position, often with the chair or other seating furniture visible; may depict the full figure seated, or from the lap upwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seated figures"@en .

aat:300404836 a skos:Concept ;
    skos:definition "Style of visual arts that intentionally imitates ancient objects or style. Most often used to refer to jewelry design, but may also be applied to paintings, sculpture, and occasionally to architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaeological Style"@en .

aat:300404837 a skos:Concept ;
    skos:definition "Landed properties, usually of considerable extent, which typically have a grand house and outbuildings, and which may, but not necessarily must, have certain land on which a crop is cultivated; may have tenants who operate the agricultural lands. For commercial agricultural lands, particularly those similar to plantations and located in European colonial areas, use \"estates (commercial agricultural holdings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estates"@en .

aat:300404838 a skos:Concept ;
    skos:definition "A crystalline compound of ammonia and phosphoric acid. It is water soluble and is used most often as a raw material in fertilizers. It is also used as a fire retardant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monoammonium phosphate"@en .

aat:300404839 a skos:Concept ;
    skos:definition "Buildings designed to be identical or closely resemble each other, often built in succession or at the same time, so that they may be constructed quickly and efficiently. Examples are suburban housing developments and factory-produced housing kits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serial buildings"@en .

aat:300404840 a skos:Concept ;
    skos:definition "Sites upon which one building is built, altered through major accretion to become a different building, or rebuilt as a different building over time, but still retaining the same function and often the same name. The term is often, but not exclusively, used for archaeological sites having this characteristic; refers to both the site and the sum of structures that have occupied the site over time. Examples include the Aztec Templo Mayor, which was rebuilt six times on the same site, and the Temple of Jerusalem, also rebuilt several times on the same site, and Stonehenge, altered through accretion over centuries. To refer in general to a site where a building is or was located, whether or not the building is under construction, use \"building sites.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebuilding sites"@en .

aat:300404841 a skos:Concept ;
    skos:definition "The action of celebrating, revelling, and conviviality, often accompanied by drinking alcohol; engaging in a festive occasion or party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merrymaking"@en .

aat:300404842 a skos:Concept ;
    skos:definition "Action of wasting one's moral and physical powers by undue or extreme indulgence in pleasure, through an intemperate, dissolute, or vicious mode of living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissipation"@en .

aat:300404843 a skos:Concept ;
    skos:definition "A colorless crystalline organic compound that is a product of protein metabolism in mammals. Urea can break hydrogen bonds and destabilize collagen. In conservation practice, this interaction reduces hardness and deformation in parchment, leather, and related materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urea"@en .

aat:300404844 a skos:Concept ;
    skos:definition "Helmets and helms, of various designs, intended for use in jousting rather than in battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tournament helms"@en .

aat:300404845 a skos:Concept ;
    skos:definition "Titles of courtesy, professional titles, military rank, adjectives, or other words used before a personal name. Examples are words to indicate gender, marital status, social position, or included for another purpose, such as the following words and abbreviations: Mr., Mrs., Miss, Ms., Dr., Sir, and Rev."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prefixes"@en .

aat:300404846 a skos:Concept ;
    skos:definition "Buildings housing state legislatures in the U.S. states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state capitols"@en .

aat:300404847 a skos:Concept ;
    skos:definition "Meals or social serving of refreshments at which tea is featured, usually a light, informal afternoon or evening meal, at which the usual beverage is tea, but sometimes cocoa, chocolate, coffee, or other substitute may be served. In modern usage in the UK, a light meal in the late afternoon, but locally in the northern UK and in Australia and New Zealand, a cooked evening meal; in Jamaica, tea is the first meal of the day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teas"@en .

aat:300404848 a skos:Concept ;
    skos:definition "People who gather together physical items into a larger assemblage or other whole. Examples include people who compile albums or other sets of works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compilers"@en .

aat:300404849 a skos:Concept ;
    skos:definition "Wood treated with chemicals to cause it to turn a deep black or blackish color. Examples include wood treated with chemicals, such as vinegar or tannin; does not include wood stained with a modern, commercial blackish stain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ebonized wood"@en .

aat:300404850 a skos:Concept ;
    skos:definition "Printmaking paper, with trademarked brand name by Rives Papers; made with 100% cotton and no optical brightening agents. It is bright white in color, smooth, soft, and pliable, having an absorbent wove surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rives BFK (TM)"@en .

aat:300404851 a skos:Concept ;
    skos:definition "Celadon stoneware produced in kilns in the town of Longquan (province of Zhejiang), China, from the Song to the mid-Qing dynasties (roughly from the 11th to the 18th century)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Longquan ware"@en .

aat:300404853 a skos:Concept ;
    skos:definition "Species of vulture that ranges from southern Mexico to Argentina, where they soar singly or in pairs over tropical forests. Noted for distinctive color: the head and neck are red, yellow, and bluish; the eyes are white with red eye-rings; the body is buff above and white below; and the neck fringe is gray. Wingspan is about 2 metres; the body is about 80 cm (31 inches) long."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarcoramphus papa"@en .

aat:300404854 a skos:Concept ;
    skos:definition "Roads, paths, walkways, or trackways formed by laying tree trunks or split logs close together transversely, with the rounded surface upwards; a common usage of such roads is to cross a swamp or muddy area with vehicles. For walkways or cart paths that are slightly raised, made of cut timbers, used to cross a swamp or bog, and often in an archaeological context, use \"timber trackways.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corduroy roads"@en .

aat:300404855 a skos:Concept ;
    skos:definition "Walkways, tracks, or cart paths made of timbers seated on risers to form a raised surface; usually used to provide crossing of a bog or peatland. Known in the archaeological record for over 6,000 years. For constructions comprising boards or timbers, but used for walking along a beach, in either archaeological or modern contexts, use \"boardwalks.\" For roads or walkways, usually for vehicles and made of half timbers or logs rather than cut timber, use \"corduroy roads.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timber trackways"@en .

aat:300404856 a skos:Concept ;
    skos:definition "In modern casual, common usage, any structures along a body of water intended to support people or their activities, such as boarding a boat or unloading cargo. Examples include piers and wharves. Distinguished from \"docks (waterfront spaces),\" which are spaces where ships dock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "docks"@en .

aat:300404857 a skos:Concept ;
    skos:definition "Representations in any medium of identified people, where the representation does not necessarily reflect the actual appearance of the person. Conjectural portraits may be based on an estimation of what the person looked like, for example, based on a written description of their appearance. Alternatively, a conjectural portrait may be a representation that is purely imaginary, but intended nonetheless to depict or stand for the person in the context of the art work. For estimated portraits based on forensic or archaeological evidence, reconstructing the appearance of the person based on the skull or other remains, or by using DNA, prefer \"forensic facial reconstructions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conjectural portraits"@en .

aat:300404858 a skos:Concept ;
    skos:definition "Estimated portraits of identified or anonymous individuals based on forensic or archaeological evidence, for example, reconstructing the appearance of the person based on the skull or other remains, or by using DNA."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forensic facial reconstructions"@en .

aat:300404859 a skos:Concept ;
    skos:definition "Representations of a particular identified animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal portraits"@en .

aat:300404860 a skos:Concept ;
    skos:definition "Representations of an identified individual made in a simplified, altered, or exaggerated manner. For portraits that are stylized for a humorous or ludicrous effect, prefer \"caricatures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylized portraits"@en .

aat:300404861 a skos:Concept ;
    skos:definition "Aquatint process in which a salt solution is used to lift the ground, and exposes the image areas so the plate can be etched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt-lift"@en .

aat:300404862 a skos:Concept ;
    skos:definition "Rights deemed by a society to be possessed by all humans, typicaly a set of entitlements held to be critical by virtue of being human."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human rights"@en .

aat:300404863 a skos:Concept ;
    skos:definition "Females whose job or activity is to milk cows or sometimes goats, usually employed in a dairy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milkmaids"@en .

aat:300404864 a skos:Concept ;
    skos:definition "People of either sex whose job or activity is to milk cows or sometimes goats, usually employed in a dairy. Usually used for male milkers; females typically called by the narrower term, \"milkmaids.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milkers"@en .

aat:300404865 a skos:Concept ;
    skos:definition "Mercenary soldiers of a certain class in the German and other continental armies in the 16th and 17th centuries. The term originally applied to the serfs brought into the field by the nobles within the territories of the Empire, in contradistinction to the Swiss mercenaries. In time this distinction became obsolete, and the designation connoted a soldier armed with a particular kind of equipment, of which a lance was part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lansquenets"@en .

aat:300404866 a skos:Concept ;
    skos:definition "Married women of mature years, usually with connotation of social rank, dignity, and propriety; often, but not ecessarily , associated with the mother of a large family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matrons"@en .

aat:300404868 a skos:Concept ;
    skos:definition "Fireworks or other visual works using fire or explosives as a medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incendiary art"@en .

aat:300404869 a skos:Concept ;
    skos:definition "Scaffoldings or other supporting structures, decorative or purely functional, for bearing fireworks during a fireworks display or from which fireworks are shot off into the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireworks structures"@en .

aat:300404870 a skos:Concept ;
    skos:definition "Beverage made in Mexico and some parts of Central America from the fermented sap of the agave or maguey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulque"@en .

aat:300404871 a skos:Concept ;
    skos:definition "Assemblies of cardinals who have come together for the election of a Pope. In its present form, the conclave dates from the end of the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conclaves"@en .

aat:300404872 a skos:Concept ;
    skos:definition "Taxes or imposts paid to a prince or state, by another prince or state or by vassals, in homage, acknowledgement of submission, or as the price of peace, security, and protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tributes"@en .

aat:300404873 a skos:Concept ;
    skos:definition "Processions associated with a funeral or memorial event, often but not always with the coffin accompanying the participants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral processions"@en .

aat:300404874 a skos:Concept ;
    skos:definition "An enzyme that catalyzes the dismutation of superoxide into oxygen or hydrogen peroxide. It works as an antioxidant, and has also been used to catalyze the peroxidation of various compounds and as a scavenger of carbon radicals in carbonized silk fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superoxide dismutase"@en .

aat:300404875 a skos:Concept ;
    skos:definition "Celebrated on October 7, in commemoration the victory of the combined Christian fleet against the Ottoman fleet in 1571."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feast of the Holy Rosary"@en .

aat:300404876 a skos:Concept ;
    skos:definition "Works having the form of a scroll and depicting a wide panoramic view, such as of a map, city, landscape, military battle, other historical event, or narrative. Examples include Chinese panoramic scroll paintings and prints of cityscapes popular in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panoramic scrolls"@en .

aat:300404877 a skos:Concept ;
    skos:definition "Displays of lights intended to be seen primarily at night, incorporating candles, lamps, electric lights, or other types of lights. Illuminations display lights in a decorative way, arranged in artistic designs, and usually in token of festivity or rejoicing. For displays primarily featuring fireworks, use \"fireworks (visual works)\"; however, fireworks may be incorporated as a feature of larger illuminations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illuminations"@en .

aat:300404878 a skos:Concept ;
    skos:definition "Oaths, written or verbal, concerning a renunciation of a belief, office, status, or the like. Included are oaths to depart from a realm, a repudiation of a religious, political, or other principle, or a rejection or disavowal of a claim or claimant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abjurations"@en .

aat:300404879 a skos:Concept ;
    skos:definition "Originally from a funerary fire of bones, typical usage came to refer to large fires kindled in the open air for a celebration, display, or amusement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonfires"@en .

aat:300404880 a skos:Concept ;
    skos:definition "Substances, usually taken internally or applied topically, having the primary purpose of curing or alleviating symptoms of illness or injury."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicines"@en .

aat:300404881 a skos:Concept ;
    skos:definition "White crystalline compound, acetylsalicylic acid, most often used as a medicine, as an analgesic and antipyretic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aspirin"@en .

aat:300404882 a skos:Concept ;
    skos:definition "Medicinal concoction of varying ingredients, usually a fermentation of herbs and other ingredients. It was used as an antidote to poison and bites of venomous serpents. First known by the Greeks in the 1st century CE; widely adopted in the ancient world in Europe, China, and India through trade along the the Silk Road."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theriac"@en .

aat:300404883 a skos:Concept ;
    skos:definition "Medicinal concoction of varying ingredients and preparations, formerly believed to be a universal antidote to poison or a panacea. According to legend, was first formulated by Mithradates VI Eupator of Pontus in the 1st century BCE; one of the most highly sought-after drugs in the Middle Ages and Renaissance periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mithridate"@en .

aat:300404884 a skos:Concept ;
    skos:definition "A genre of animated film or television entertainment distinctively Japanese or in Japanese-style, characterized by a visual style involving stylized action sequences and usually featuring characters with distinctive large, staring eyes, and typically having a having themes of science-fiction, fantasy, violence, or sexually explicit material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anime"@en .

aat:300404885 a skos:Concept ;
    skos:definition "People responsible for spreading out or dispersing products, such as a film, book, or other work, available in a certain situation or venue. For those who place work on the market for sale or distribution to the public, use \"publishers.\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distributors"@en .

aat:300404887 a skos:Concept ;
    skos:definition "Prints of a film provided to a movie theater or other venue for exhibition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "release prints"@en .

aat:300404888 a skos:Concept ;
    skos:definition "Single light, contact printed copies of film made from an unedited roll of original camera negative immediately after processing and screened to the cast and crew, used to review \"dailies (motion pictures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rush prints"@en .

aat:300404889 a skos:Concept ;
    skos:definition "Cutting copies of a film, comprising copies of a camera negative roll; used for editing before the negative itself is conformed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work prints"@en .

aat:300404890 a skos:Concept ;
    skos:definition "Projection prints that are of very high quality and made for screening at special events, such as gala premieres. Usually printed directly from the composited camera negative onto a higher quality of print stock than is usual for mass-production release prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "show prints"@en .

aat:300404891 a skos:Concept ;
    skos:definition "Beads that are created from natural shells, usually having a hole drilled in the shell to allow stringing. May also include beads having shells as a material, carved or ground down so as to not resemble shells when completed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell beads"@en .

aat:300404892 a skos:Concept ;
    skos:definition "An ancient Roman half-timber construction technique involving either wattle work or timber with a concrete or rubble filler, sometimes plastered over. This style of construction has been found at sites such as Pompeii and Herculaneum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus craticium"@en .

aat:300404893 a skos:Concept ;
    skos:definition "The world as considered the dwelling place of of living creatures, the surface of the planet; contrasted with sky, heaven, hell, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth"@en .

aat:300404894 a skos:Concept ;
    skos:definition "Steel-stringed acoustic or semi-acoustic guitars, having a full body and a distinctive arched top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archtop guitars"@en .

aat:300404895 a skos:Concept ;
    skos:definition "Sundials that first appeared in ancient Rome, used to tell time by utilizing the moving shadow of the sun cast upon a marked surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solaria"@en .

aat:300404896 a skos:Concept ;
    skos:definition "Interior spaces, usually in dwellings, designed to allow entry of sunshine through large windows. For ancient sunporches or modern sun lounges in hospitals, use “solariums (building spaces).”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun rooms"@en .

aat:300404897 a skos:Concept ;
    skos:definition "Sun rooms, usually located at the back of a dwelling, equipped with a bar or other furnishings to allow preparation of beverages and entertaining of guests. Traditionally, Florida rooms have tile floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Florida rooms"@en .

aat:300404898 a skos:Concept ;
    skos:definition "Emission of light produced when hot matter releases parts of its thermal vibration energy as photons. Examples are seen in burning wood and molten metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incandescence"@en .

aat:300404899 a skos:Concept ;
    skos:definition "Status or condition of having been designed for viewing or use from both sides; examples are in reference to a relatively flat or two dimensional object, such as a work on paper or a textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double sided"@en .

aat:300404900 a skos:Concept ;
    skos:definition "Genre of objects having the form of a broad shallow container, with a flat bottom, concave sides, and nearly level rim, made of earthenware, glass, metal, wood, plastic, bone, or other materials, used for food, cosmetics, storage, transmission equipment, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dishes"@en .

aat:300404901 a skos:Concept ;
    skos:definition "A very thin, matte tissue paper composed of kozo and mitsumata fibers. Its manufacture is based on Japanese principles of hand papermaking, and is a product of Gangolf Ulbricht in Germany. It is most often used for the restoration or conservation of paper objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berlin tissue"@en .

aat:300404903 a skos:Concept ;
    skos:definition "Title cards, showing expositional or dialogue text, inserted between action sequences in a film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intertitles"@en .

aat:300404906 a skos:Concept ;
    skos:definition "A very thin, matte tissue made using traditional Japanese techniques and composed of kozo and mitsumata fibers. Originally developed by Franklin Mowery in the 1980s, the material is now produced in Berlin by the manufacturer Gangolf Ulbricht. It is used primarily as a material for the restoration or conservation of paper objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gossamer tissue"@en .

aat:300404907 a skos:Concept ;
    skos:definition "Sedimentary deposits which contain large amounts of preserved fossils. Paleontologists divide them into two subtypes: Konservat-Lagerstätten and Konzentrat-Lagerstätten. The latter relates to desposits of fossils that are concentrated by sedimentological processes which do not preserve details (such as organs), and the former refers to deposits containing a large concentration of fossils that are exceptionally well-preserved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lagerstätten"@en .

aat:300404908 a skos:Concept ;
    skos:definition "The state or condition in which a thing, process, or knowledge has become outdated or fallen into disuse. Examples include when machinery, consumer goods, a ritual, etc. has ceased to be relevant due to technological advances, changes in demand, common practices, new research, or for other reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obsolescence"@en .

aat:300404909 a skos:Concept ;
    skos:definition "Creative works in the medium of casein paint, which is water-based, matte paint made with pigment in a binder comprising a phosphoprotein of milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casein paintings"@en .

aat:300404910 a skos:Concept ;
    skos:definition "The art or practice of producing creative works with casein paint, which is water-based, matte paint made with pigment in a binder comprising a phosphoprotein of milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casein painting"@en .

aat:300404911 a skos:Concept ;
    skos:definition "The state, quality, or condition of being primarily factual, evidential, realistic, or othewise based on real events or circumstances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary"@en .

aat:300404912 a skos:Concept ;
    skos:definition "A moderately sized organized armed resistance to an established ruler or government; for larger scale armed resistance, use \"revolution.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebellions"@en .

aat:300404914 a skos:Concept ;
    skos:definition "Shape, usually two-dimensional rectangular or three-dimensional cuboid, having a rounded top, somewhat resembling a dome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dome topped"@en .

aat:300404915 a skos:Concept ;
    skos:definition "Generic term for goldsmiths in Nahua culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlahuaque"@en .

aat:300404916 a skos:Concept ;
    skos:definition "Flexible packaging, closed at one end and with a removable cap at the other, usually made of metal or plastic, for storing and dispensing artist's colors such as oil paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint tubes"@en .

aat:300404917 a skos:Concept ;
    skos:definition "Any of various telephonic devices enhanced with computer technology; specifically mobile phones capable of operating computer applications. These now usually feature touch-screen interfaces, cameras, and the ability to access the Internet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smartphones"@en .

aat:300404918 a skos:Concept ;
    skos:definition "Captions that transcribe or translate the dialogue spoken in a motion picture. These usually appear at the bottom of the screen image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subtitles"@en .

aat:300404919 a skos:Concept ;
    skos:definition "Gold casters, literally \"those who blow gold\" in Nahua culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlapitzqueh"@en .

aat:300404920 a skos:Concept ;
    skos:definition "A general term for lapidary artists in Nahua culture, literally, \"those who cut things.\" Tlatecque would work precious and semi-precious stones into jewelry and also cut stone mosaics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlatecque"@en .

aat:300404921 a skos:Concept ;
    skos:definition "Goldbeaters in Nahua culture who hammered gold into sheets and then modified it with embossing, engracing, cutting, and perforating. Literally, \"those who beat gold.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlatzotzonque"@en .

aat:300404922 a skos:Concept ;
    skos:definition "The activity of using using rope fixed at a higher point to make a controlled descent of a vertical drop, such as a rock face or tall building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rappelling"@en .

aat:300404923 a skos:Concept ;
    skos:definition "Those who use or create rope access or rappelling mechanisms, particularly for the inspection, maintenance, and repair of built works or features at high access locations. For example, rope access technicians may work with engineers, architects, geologists, or conservation professionals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rope access technicians"@en .

aat:300404924 a skos:Concept ;
    skos:definition "Process or technique of using or creating mechanisms using ropes to allow access to high locations, particularly for the inspection, maintenance, and repair of built works or features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rope access"@en .

aat:300404925 a skos:Concept ;
    skos:definition "The art or process of casting gold in Nahuatl culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlapitzcayotl"@en .

aat:300404926 a skos:Concept ;
    skos:definition "The art of turquoise mosaic work in Nahua culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xiuhzaloliztli"@en .

aat:300404927 a skos:Concept ;
    skos:definition "A broad term for art, artistry, artisanry, or craft in Nahua culture. This includes traditions of writing, painting, featherworking, metalworking, and stone-cutting viewed by the Nahuas as inherited from the ancient Toltec civilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toltecayotl"@en .

aat:300404928 a skos:Concept ;
    skos:definition "A broad term for any technicians, craftsmen, artists or artisans in Nahua culture who practice a skill knowledgeably."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toltecah"@en .

aat:300404929 a skos:Concept ;
    skos:definition "Long, flexible, iridescent green tail plumes of the resplendant quetzal (Pharomachrus mocinno). These feathers held extremely high value in Nahua societies and were used in luxurious costumes, including back devices and headdresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quetzalli"@en .

aat:300404930 a skos:Concept ;
    skos:definition "Ancient Egyptian sculptures depicting a standing or kneeling male figure proffering a divine effigy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theophorous statues"@en .

aat:300404931 a skos:Concept ;
    skos:definition "Ancient Egyptian sculptures depicting a standing or kneeling male figure proffering a naos, which is a small room of shrine for a deity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naophorous statues"@en .

aat:300404932 a skos:Concept ;
    skos:definition "Ancient Egyptian sculptures depicting a standing or kneeling male figure proffering an inscribed stele."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stelophorous statues"@en .

aat:300404933 a skos:Concept ;
    skos:definition "Likenesses, portraits, or images, especially sculptured or low relief representations, that stand for the person or animal represented. Examples are sculptures of deities and certain images of rulers on coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "effigies"@en .

aat:300404934 a skos:Concept ;
    skos:definition "Gold or silver. This term was oftern modified with \"coztic,\" yellow, to mean gold, or \"iztac,\" white, to mean silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlatl"@en .

aat:300404935 a skos:Concept ;
    skos:definition "An adhesive and sealant made from orchid bulbs, used in feather mosaics, painting, mosaic work, and other artforms in Nahua culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tzauctli"@en .

aat:300404936 a skos:Concept ;
    skos:definition "Round shields featuring various designs used in military action and ceremonies of Nahua peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimalli"@en .

aat:300404937 a skos:Concept ;
    skos:definition "Insignia of warriors in Nahua culture reflecting the person's rank and experience in battle. Generally used to refer to the feathered suits that encased the body, arms, and legs, however, the term also applies to various accoutrements including headdresses, large emblems carried on a frame worn on the back, as well as banners and shields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlahuiztli"@en .

aat:300404938 a skos:Concept ;
    skos:definition "Diadems of turquoise mosaic worn by Nahuas tlahtohqueh (rulers)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xiuhhuitzolli"@en .

aat:300404939 a skos:Concept ;
    skos:definition "Refers to God, divinity, or a deity in Nahua culture. A term generally translated as \"god\" or \"deity\" usually referring to members of the Nahua pantheon. Caught in a constant process of movement, these forces or powers are associated with different areas of action, predispositions and shared or exclusive prerogatives. As a prefix, the root of the term, teo-, enters into the composition of a number of words designating substances, plants, birds or instruments whose translation is often complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teotl"@en .

aat:300404940 a skos:Concept ;
    skos:definition "Representatives (people as well as objects) that embodied teteoh (Nahua deities)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teixiptlahuan"@en .

aat:300404941 a skos:Concept ;
    skos:definition "In the social organization of Nahua culture, a city-state or political entity with a shared ethnic identitity and other ideological and economic characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altepemeh"@en .

aat:300404942 a skos:Concept ;
    skos:definition "Rulers in Nahua culture, literally, “those who speak.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlahtohqueh"@en .

aat:300404943 a skos:Concept ;
    skos:definition "Collectively refers to the non-noble people in Nahua culture. Frequently associated with commoners, vassals, or peasants from the colonial period forward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macehualtin"@en .

aat:300404944 a skos:Concept ;
    skos:definition "In Nahua society, persons belonging to the noble class who performed state functions and ruled the macehualtin, or common people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipiltin"@en .

aat:300410243 a skos:Concept ;
    skos:definition "Events involving multiple people reaching agreement or working together for an evil or unlawful purpose, such as treason, sedition, murder, or other serious wrong doing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conspiracies"@en .

aat:300410244 a skos:Concept ;
    skos:definition "Lowering in quality or vigor in commercial trade, financial markets, and industrial activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recession"@en .

aat:300410245 a skos:Concept ;
    skos:definition "Severe and prolonged lowering in quality or vigor in commercial trade, financial markets, and industrial activity; more intense and prolonged than an economic recession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depression"@en .

aat:300410246 a skos:Concept ;
    skos:definition "Narrow exterior pedestrian passageways or alleys between buildings, where the passageways lead from the street to the dwelling houses, outhouses, stables, a common stair, courtyard, or other common area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closes"@en .

aat:300410247 a skos:Concept ;
    skos:definition "The body or main structure of a constructed work, such as ships or built works, to which surface materials or fixtures are applied. For the body or framework of furniture, prefer \"carcases (furniture components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carcasses"@en .

aat:300410248 a skos:Concept ;
    skos:definition "A species of bird in the Trogon family that lives in the lush vegetation of rainforest zones of Central America. They prefer to carve their nests from decaying trees or stumps. They are vibrantly colored and the males exhibit iridescent tail plumes that can be three feet long during mating season. These plumes were prized by Maya and Aztec cultures, as the resplendant quetzal was closely associated with the deity Quetzalcoatl. This species is the national symbol of Guatemala."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pharomachrus mocinno"@en .

aat:300410249 a skos:Concept ;
    skos:definition "Art works that are made, partially or entirely, of edible materials. Included are works considered fine art as well as works intended for display at meals or feasts. For the art and practice of preparing and cooking foods, prefer \"culinary art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edible art"@en .

aat:300410250 a skos:Concept ;
    skos:definition "Edible art of grand scale, including elaborate ephemeral architecture, sculpture, and floats made of food, particularly but not exclusively those that were designed for court and civic celebrations in early modern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edible monuments"@en .

aat:300410251 a skos:Concept ;
    skos:definition "Prints made in which negative space is cut away from the surface of a flat stone, leaving an image in relief, which is then inked. Paper is applied to the surface to create the print. This technique may be unique to a community of Inuit printmakers in Northern Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stonecuts"@en .

aat:300410252 a skos:Concept ;
    skos:definition "A relief printmaking process derived from woodcut, but using stone blocks as the plates into which a design is carved. This technique may be exclusive to Inuit printmakers living in the Cape Dorset area, an Inuit hamlet located on Dorset Island near Foxe Peninsula at the southern tip of Baffin Island in the Qikiqtaaluk Region of Nunavut, Canada. Stone is used here as it is a more plentiful resource than wood in the Arctic. Use of the process only dates from the early 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stonecut"@en .

aat:300410253 a skos:Concept ;
    skos:definition "Events or processes resulting in a species or multiple species dying out and having no living representatives. Extinctions may be natural events or the result of human activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extinctions"@en .

aat:300410254 a skos:Concept ;
    skos:definition "Technique in which paint is applied directly to textiles with only a thin gesso preparation; it was popular in Spain and its colonies during certain periods. The paintings made with this technique lent themselves to being rolled and transported with little damage to the paint layer. For the similar glue-based technique preferred in northern Europe and Italy, prefer \"tüchlein (technique).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarga"@en .

aat:300410255 a skos:Concept ;
    skos:definition "Works in which paint is applied on a textile support with only a thin glue preparation or no preparation; the painting surface remains flexible, and the works are often rolled and portable. These works were popular in Germany, the Netherlands, and Italy. For similar works on textiles having a thin gesso preparation, popular in Spain and its colonies, prefer \"sargas (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tüchleins"@en .

aat:300410257 a skos:Concept ;
    skos:definition "Culture of the tribal Tibeto-Burman ethnic group inhabiting parts of northeastern Myanmar (Burma) and contiguous areas of India (Arunachal Pradesh and Nagaland) and China (Yunnan)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kachin"@en .

aat:300410258 a skos:Concept ;
    skos:definition "Culture of the tribal hill people of the Shan region and adjacent areas of eastern Myanmar (Burma), as well as southwestern Yunnan province of China. Some Palaung groups are organized in patrilineal lineages similar to those of the Kachin, their neighbours to the north; elsewhere their organization is more like that of the Shan. Shan-type Buddhism coexists with various local cults based on ancestor worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palaung"@en .

aat:300410260 a skos:Concept ;
    skos:definition "Culture of the Southeast Asian people who live primarily in eastern and northwestern Myanmar (Burma) and also in Yunnan province, China. The Shan are the largest minority group in Myanmar. The Shan are Theravada Buddhists and have their own written language and literature. Most live on the Shan Plateau, which is seamed by low mountains and masses of broken, forested hills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shan"@en .

aat:300410261 a skos:Concept ;
    skos:definition "Oil paint that is designed to thinned and cleaned up with water by using an oil medium in which one end of the molecule has been altered to bind loosely to water molecules, as in a solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water miscible oil paint"@en .

aat:300410262 a skos:Concept ;
    skos:definition "Complexes of buildings comprising the permanent establishment of a Christian missionary post or station. Buildings may include the central church, structures for the housing of the friars or other personnell, kitchen, storage, barns, surrounding grounds, and possibly other buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missions"@en .

aat:300410264 a skos:Concept ;
    skos:definition "The dead bodies of humans or other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corpses"@en .

aat:300410265 a skos:Concept ;
    skos:definition "General non-taxonomic and historical term referring to the virus thought to cause AIDS. Since 1991, HIV was no longer considered an official species name; instead, two species were designated HIV-1 and HIV-2. The geographical, biological, and chronological origins of the viruses have been debated since the discovery of AIDS as an emerging disease in 1981."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "HIV"@en .

aat:300410266 a skos:Concept ;
    skos:definition "In literary works or performing arts, the people or other characters who have the primary roles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protagonists"@en .

aat:300410267 a skos:Concept ;
    skos:definition "Those who have roles in a story or drama. For performing artists playing roles, prefer \"actors (performing artists).\" For the lead characters in a story or main actors in performing arts, prefer \"protagonists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "characters"@en .

aat:300410268 a skos:Concept ;
    skos:definition "Lighting devices that incorporate an array of LEDs within a bulb-shaped enclosure, usually made of glass. These are used for general lighting applications, in most cases as a replacement for incandescent light sources, as they offer more efficient energy performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "LED bulbs"@en .

aat:300410270 a skos:Concept ;
    skos:definition "A broad genre of visual communication placed on surfaces, usually in urban environments; term reserved for works that are considered art or artistic, rather than casual notations or scribbles, which are called \"graffiti.\" Examples of graffiti art include works expressed in a signature form, in either a stylized monogram or as large colorful murals. Examples may include works that are not in graphic media or are not created directly on the surface, but created and then applied to the surface. Graffiti art has occasionally been created as paintings on moveable supports. Contemporary graffiti art emerged in the mid-1970s in New York City, rendered in spray paint on subway train cars and walls. Originally graffiti art was illegal, applied to unauthorized public space or property by individuals or groups, though now it may also appear as commissioned work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graffiti art"@en .

aat:300410271 a skos:Concept ;
    skos:definition "Graffiti art works produced with spray paint, that spell out the artist's name in rounded letters. Usually these are rendered in two colors, one for the body and another for a contrasting outline. These are intended to cover as much surface area as possible in the shortest amount of time without regard to style or technical proficiency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throw-ups"@en .

aat:300410272 a skos:Concept ;
    skos:definition "Works of graffiti art that are large, colorful, and stylistically elaborate and that require a greater amount of time and expertise to create."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pieces"@en .

aat:300410273 a skos:Concept ;
    skos:definition "In the context of graffiti, bombing denotes prolific and repeated renderings of a single 'tag' in a given physical area in order to attract recognition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombing"@en .

aat:300410274 a skos:Concept ;
    skos:definition "In the context of graffiti art, large 'pieces' that cover entire train cars from top to bottom and end to end, including the windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whole cars"@en .

aat:300410275 a skos:Concept ;
    skos:definition "Graffiti works by an individual artist or crew that extend from the top to the bottom of a subway car but not its full length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top-to-bottoms"@en .

aat:300410276 a skos:Concept ;
    skos:definition "Refers to the act of rendering large, colorful, and stylistically elaborate works of graffiti art that require a greater amount of time and expertise to create, and that dominate an entire surface area such as the wall of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piecing"@en .

aat:300410277 a skos:Concept ;
    skos:definition "A genre of graffiti art with interlocking, highly stylized and often cryptic lettering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wildstyle"@en .

aat:300410278 a skos:Concept ;
    skos:definition "Graffiti pieces that are regarded as being of exceptional quality, as judged by other graffiti artists. To ‘burn’ is to outdo the work of others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burners"@en .

aat:300410279 a skos:Concept ;
    skos:definition "Graffiti works that cover subway cars from one end to the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end to ends"@en .

aat:300410281 a skos:Concept ;
    skos:definition "Larger and more involved graffiti art 'pieces' that involve several artists working together. These are achieved legally, where permission has been granted or the work commissioned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "productions"@en .

aat:300410282 a skos:Concept ;
    skos:definition "Trees symbolic of freedom or liberty, especially those in revolutions of 18th century Europe, modeled on the historic elm, Tree of Liberty, in Boston, Massachusetts dating to the time of the American Revolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liberty trees"@en .

aat:300410283 a skos:Concept ;
    skos:definition "Term used to describe archaeological deposits consisting of the refuse from food preparation, particularly the shells of marine animals discarded after the removal of the edible portion. Shell middens are found throughout the world in many different cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell middens"@en .

aat:300410284 a skos:Concept ;
    skos:definition "Stylized forms of graffiti using names or initials as markers. These are considered the most basic form of graffiti art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tags"@en .

aat:300410285 a skos:Concept ;
    skos:definition "The state of a person or situation of being morally depraved, bad, wicked, or vicious. The antithesis of \"good.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evil"@en .

aat:300410286 a skos:Concept ;
    skos:definition "The state of a person or situation distinguished by admirable or commendable qualities, worthy, estimable, fine, charitable, kind, avoiding bad behavior. The antithesis of \"evil.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "good"@en .

aat:300410287 a skos:Concept ;
    skos:definition "Moral strength or courage, unyielding courage, endurance of pain or adversity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortitude"@en .

aat:300410288 a skos:Concept ;
    skos:definition "The quality or condition of having strong moral principles, integrity, good character, honesty, and decency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "probity"@en .

aat:300410289 a skos:Concept ;
    skos:definition "The disciplines of philosophy, logic, and cognate subjects, particularly as included in the course of study for a degree in the ancient school of Literae Humaniores. Often seen as counterparts to the \"arts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sciences"@en .

aat:300410290 a skos:Concept ;
    skos:definition "The first month of the year in the Julian and Gregorian calendars, containing 31 days and falling before February. It was named after Janus, the Roman god of all beginnings. January replaced March as the first month of the Roman year no later than 153 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "January"@en .

aat:300410291 a skos:Concept ;
    skos:definition "The second month of the year in the Julian and Gregorian calendars, containing 28 days (or 29 in a leap year) and falling between January and March. It was named after Februalia, the Roman festival of purification. Originally, February was the last month of the Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "February"@en .

aat:300410292 a skos:Concept ;
    skos:definition "The third month of the year in the Julian and Gregorian calendars, containing 31 days and falling between February and April. It was named after Mars, the Roman god of war. Originally, March was the first month of the Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "March"@en .

aat:300410293 a skos:Concept ;
    skos:definition "The fourth month of the year in the Julian and Gregorian calendars, containing 30 days and falling between March and May. Its name probably derives from the Latin aperire (“to open”), a possible reference to plant buds opening at this time of year in Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "April"@en .

aat:300410294 a skos:Concept ;
    skos:definition "The fifth month of the year in the Julian and Gregorian calendar, containing 31 days and falling between April and June. It was named after Maia, a Roman fertility goddess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "May"@en .

aat:300410295 a skos:Concept ;
    skos:definition "The sixth month of the year in the Julian and Gregorian calendars, containing 30 days and falling between May and July. It was named after Juno, the Roman goddess of childbirth and fertility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "June"@en .

aat:300410296 a skos:Concept ;
    skos:definition "The seventh month of the year in the Julian and Gregorian calendars, containing 31 days and falling between June and August. It was named after Julius Caesar in 44 bce. Its original name was Quintilis, Latin for the “fifth month,” indicating its position in the early Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "July"@en .

aat:300410297 a skos:Concept ;
    skos:definition "The eighth month of the year in the Julian and Gregorian calendars, containing 31 days and falling between July and September. It was named for the first Roman emperor, Augustus Caesar, in 8 bce. Its original name was Sextilus, Latin for “sixth month,” indicating its position in the early Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "August"@en .

aat:300410298 a skos:Concept ;
    skos:definition "The ninth month of the year in the Julian and Gregorian calendars, containing 30 days and falling between August and October. Its name is derived from septem, Latin for “seven,” an indication of its position in the early Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "September"@en .

aat:300410299 a skos:Concept ;
    skos:definition "The tenth month of the year in the Julian and Gregorian calendar, containing 31 days and falling between September and November. Its name is derived from octo, Latin for “eight,” an indication of its position in the early Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "October"@en .

aat:300410300 a skos:Concept ;
    skos:definition "The eleventh month of the year in the Julian and Gregorian calendars, containing 30 days and falling between October and December. Its name is derived from novem, Latin for “nine,” an indication of its position in the early Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "November"@en .

aat:300410301 a skos:Concept ;
    skos:definition "The twelfth and final month of the year in the Julian and Gregorian calendars, containing 31 days and falling after November. Its name is derived from decem, Latin for “ten,” indicating its position in the early Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "December"@en .

aat:300410304 a skos:Concept ;
    skos:definition "The day following Sunday and preceding Tuesday, traditionally regarded as the second day of the week, but now frequently considered the first day of the week. Named as Moon’s-day on the Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monday"@en .

aat:300410305 a skos:Concept ;
    skos:definition "The day following Monday and preceding Wednesday, traditionally regarded as the third day of the week, but now frequently considered as the second. In English and other language, named from Tiu, or Tiw, the Anglo-Saxon name for the Norse god of war, one of the sons of Odin, or Woden. In Romance languages, named for the Roman Mars’s-day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuesday"@en .

aat:300410306 a skos:Concept ;
    skos:definition "The day following Tuesday and preceding Thursday, traditionally regarded as the fourth day of the week, but now frequently considered as the third. In English and other languages, named for Woden, the Norse supreme deity. In Romance languages, named for the Roman Mercury’s-day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wednesday"@en .

aat:300410307 a skos:Concept ;
    skos:definition "The day following Wednesday and preceding Friday, traditionally regarded as the fifth day of the week, but now frequently considered as the fourth. In English and other languages, named for Thor, the Norse god of thunder. In Romance langauges, named for the Roman Jupiter’s-day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thursday"@en .

aat:300410308 a skos:Concept ;
    skos:definition "The day following Thursday and preceding Saturday, traditionally regarded as the sixth day of the week, but now frequently considered as the fifth, and also as the last day of the working week in western culture. In English and other languages, named for Frigg, the wife of the Norse god Odin, representing love and beauty. In Romance languages, named for the Roman Venus’-day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Friday"@en .

aat:300410309 a skos:Concept ;
    skos:definition "The day following Friday and preceding Sunday, traditionally regarded as the seventh day of the week, but now frequently considered as the sixth, and, together with Sunday, forming the weekend. Name refers to the Roman Saturn’s-day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saturday"@en .

aat:300410310 a skos:Concept ;
    skos:definition "The day following Saturday and preceding Monday, observed by Christians as a day of rest and religious worship, traditionally regarded as the first day of the week, and usually considered (together with Saturday) as forming part of the weekend. In English and other languages, the name refers to the Roman Sun’s-day. In Romance languages, name refers to the Lord's day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sunday"@en .

aat:300410312 a skos:Concept ;
    skos:definition "Form of rule in which power is maintained by a tyrant, who holds vast or absolute power, and exercises power oppressively, cruelly, or unjustly. For forms of rule in which power is absolute and the element of arbitrariness is present, prefer \"despotism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tyranny"@en .

aat:300410313 a skos:Concept ;
    skos:definition "A mid-1940s precursor of Abstract Expressionism that itself was a transitional synthesis of various forms of abstraction with Surrealist automatism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abstract Surrealist"@en .

aat:300410314 a skos:Concept ;
    skos:definition "Girls or young women employed to look after infants or very young children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursemaids"@en .

aat:300410315 a skos:Concept ;
    skos:definition "Supernatural beings not subject to death, as applied to mythological deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immortals"@en .

aat:300410316 a skos:Concept ;
    skos:definition "Chance or luck, when regarded as a cause of events and changes in human affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortune"@en .

aat:300410317 a skos:Concept ;
    skos:definition "Films made using animation techniques, including the process of making still images appear to move, such as the technique of photographing drawings or objects in progressive stages of performing an action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animated film"@en .

aat:300410318 a skos:Concept ;
    skos:definition "Literature, including novels, poetry, and other forms, that provides guidance and instruction, often having a moral overtone and told through stories and examples. For more formal modern instructional manuals regarding practical undertakings, prefer \"guidelines\" or \"manuals (instructional materials).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instructional literature"@en .

aat:300410319 a skos:Concept ;
    skos:definition "Of a text, editing into a shortened, concise form, often by omitting the less important passages of the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abridging"@en .

aat:300410320 a skos:Concept ;
    skos:definition "Publishing a story, novel, or other work as a serial, in parts over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serialising"@en .

aat:300410321 a skos:Concept ;
    skos:definition "Expurgatin a novel or other writing by omitting or modifying words or passages considered indelicate or offensive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowdlerising"@en .

aat:300410322 a skos:Concept ;
    skos:definition "Wood trays used to hold moveable type. These are 32 inches long, 17 inches wide and two inches deep and are divided into compartments of various sizes to accommodate letters that occur more or less frequently. California job cases are arranged such that capital letters are at the right and lower-case are at the left. Special characters such as dollar signs or parentheses are in the top row."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "California job cases"@en .

aat:300410323 a skos:Concept ;
    skos:definition "The personal state of pleasurable contentment of mind, typically including contentment with or resignation to one's circumstances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "happiness"@en .

aat:300410324 a skos:Concept ;
    skos:definition "Novels written by using the device of a series of letters, diary entries, newspaper clippings, or other documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epistolary novels"@en .

aat:300410325 a skos:Concept ;
    skos:definition "Shallow trays made to hold moveable type for hand-type setting. These are divided into compartments for each letter in a font of type, and typically are laid out with capitals to the right and lower-case characters to the left."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "job cases"@en .

aat:300410326 a skos:Concept ;
    skos:definition "Proclamations or orders concerning a law, decree, or other authoritative command, usually having the force of law. Edicts are the proclamations, as distinguished from the formal, finalized laws, decrees, ordinances, etc. that are referenced by the edicts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edicts"@en .

aat:300410327 a skos:Concept ;
    skos:definition "Financial institutions for the custody of money received from, or on behalf of, customers, with the essential duty of payment of the orders given on it by the customers. Banks' profits arise mainly from the investment of the money left unused by the customers. Banks typically pay interest on deposits, and offer other financial services including loans, and currency exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banks"@en .

aat:300410328 a skos:Concept ;
    skos:definition "Shallow wood trays intended to store moveable type. These are divided into compartments to store the various characters in a font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type cases"@en .

aat:300410329 a skos:Concept ;
    skos:definition "Aisles that flank the length of the naves of religious or secular buildings, and that are often lower and smaller than the central aisle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side aisles"@en .

aat:300410330 a skos:Concept ;
    skos:definition "Viruses that have DNA (deoxyribonucleic acid) as genetic material and replicate using a DNA-dependent DNA polymerase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DNA Viruses"@en .

aat:300410331 a skos:Concept ;
    skos:definition "Viruses in which the genetic information is stored in the form of RNA (ribonucleic acid) as opposed to DNA."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "RNA Viruses"@en .

aat:300410332 a skos:Concept ;
    skos:definition "Circulation spaces that run the center length of religious or secular buildings that have oblong plans. Central aisles often bisect rows of pews or seating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "central aisles"@en .

aat:300410333 a skos:Concept ;
    skos:definition "Traditional maxims of a religious teacher or sage. An example of usage is with reference to the sayings of Jesus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logia"@en .

aat:300410334 a skos:Concept ;
    skos:definition "Drawings created by using pencils containing lead, graphite, or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencil drawings"@en .

aat:300410335 a skos:Concept ;
    skos:definition "General term for a solid marking substance in the form of a slender rod, which is then enclosed in a cylinder of wood, metal, or plastic to form a \"pencil (drawing and writing equipment).\" Common examples of materials used in \"pencils (drawing and writing equipment)\" are graphite, lead, and pigmented wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencil"@en .

aat:300410336 a skos:Concept ;
    skos:definition "Visual works, or parts of works, where the image or design is made from pieces of veneer, which comprises thin sheets of decorative material such as wood, ivory, tortoiseshell or brass. Usually found on furniture, wall paneling, and other interior locations. For more complex and sophisticated designs created from veneer, prefer \"marquetry (visual work).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veneering"@en .

aat:300410337 a skos:Concept ;
    skos:definition "Visual works, or parts of works, where the image or design is made with small pieces of specially shaped wood, ivory, or other materials, often incorporated into a suface of decorative veneer in furniture or interior surfaces. Distinguished from \"inlays (decorations),\" where decorative pieces are set into a solid ground; in marquetry work, the entire surface is veneered. For less complex designs made of veneer, prefer \"veneering (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marquetry"@en .

aat:300410338 a skos:Concept ;
    skos:definition "Genre of objects comprising narrow, flexible strips, as of cloth, paper, plastic, or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapes"@en .

aat:300410339 a skos:Concept ;
    skos:definition "Fabric with open spaces between the yarn or wire. A mesh fabric may be knit, woven, or knotted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mesh fabric"@en .

aat:300410340 a skos:Concept ;
    skos:definition "A primarily African-American movement in literature, music, and visual art that focuses on themes from science fiction or an imagined future, and that also incorporates elements of black history and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afrofuturist"@en .

aat:300410341 a skos:Concept ;
    skos:definition "Long, straight, slender, and more or less cylindrical objects of medium or large size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poles"@en .

aat:300410342 a skos:Concept ;
    skos:definition "Ceramic tile having a decorative pattern that is not applied by glaze, but by using multiple color clays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encaustic tile"@en .

aat:300410343 a skos:Concept ;
    skos:definition "Visual works comprising tiles or having tiles applied as the primary medium. For works in which an individual tile is a support for a design or image, use \"art tiles (visual works).\" Tile works may incorporate decorated tiles or they may comprise tile that is not decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile work"@en .

aat:300410344 a skos:Concept ;
    skos:definition "Visual works for which tile is the support, such as painting, or for which tile is the medium into which a relief is pressed or carved, or encaustic design is created. For visual works comprising multiple tiles, whether or not individual tiles are decorated, use \"tile works (visual works).\" For tile as a material in roofing, etc., use \"tile (material)\" or a more specific narrower context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiles"@en .

aat:300410345 a skos:Concept ;
    skos:definition "People who drive large horse-drawn carriages for the conveyance of passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coachmen"@en .

aat:300410346 a skos:Concept ;
    skos:definition "Objects made of brick, particularly those having a design or image impressed, carved, or painted upon them. For brick used in construction and having a purpose basically utilitarian rather than decorative, prefer \"brick (clay material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bricks"@en .

aat:300410347 a skos:Concept ;
    skos:definition "Genus containing around 70 species of flowering shrubs and small trees native to regions of Africa, the Americas, southern Asia, and Australasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dodonaea"@en .

aat:300410350 a skos:Concept ;
    skos:definition "Paintings for which canvas is the support, typically using canvas stretched over stretcher bars or another secondary support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canvas paintings"@en .

aat:300410351 a skos:Concept ;
    skos:definition "Building plan, often a basilica, having a cenral nave and transcept in a T-shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian cross plan"@en .

aat:300410352 a skos:Concept ;
    skos:definition "Style associated with the Cistercians, incorporating the tenets of Bernard of Clairvaux and representing a transition between Romanesque and Gothic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cistercian Gothic"@en .

aat:300410353 a skos:Concept ;
    skos:definition "Small areas of enclosed land, most often adjacent to a dwelling, used for cultivation of plants or as pasture for animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crofts"@en .

aat:300410354 a skos:Concept ;
    skos:definition "Operas in which the subject matter and characters are usually treated light-heartedly and humorously, the ending is happy or conciliatory, and a large part of the dialogue is spoken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comic operas"@en .

aat:300410355 a skos:Concept ;
    skos:definition "People who alter or amend a text to make it suitable for another purpose. An example of an adapter is one who adapts an earlier text to better agree with a philosophy other than that intended by the original. Other examples are those who adapt a written work for another medium, such as film, broadcasting, or stage production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adapters"@en .

aat:300410356 a skos:Concept ;
    skos:definition "Written works or works derived from written works, where the second work is an alteration or amendment a text to make it suitable for another purpose. An example of an adaptation is a version of an earlier text made to better agree with a philosophy other than that intended by the original. Other examples are written works adapted for another medium, such as film, broadcasting, or stage production. For visual works adapted from another work, use \"adaptations (derivative objects).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adaptations"@en .

aat:300410357 a skos:Concept ;
    skos:definition "Related to the style or culture of the area of modern Arezzo of central Italy, including both ancient and modern periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arretine"@en .

aat:300410358 a skos:Concept ;
    skos:definition "People who create and transmit literature, whether orally or in writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composers"@en .

aat:300410359 a skos:Concept ;
    skos:definition "Sanskrit poems of the kavya literary style; mahakavyas are short epics characterized by elaborate figures of speech. In its classical form, a mahakavya consists of a variable number of comparatively short cantos, each composed in a meter appropriate to its particular subject matter, which is taken from the epic tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahakavyas"@en .

aat:300410360 a skos:Concept ;
    skos:definition "Brief narrative poems in dactylic hexameter of ancient Greece, imitated by Romans and others. Usually dealing with mythological and romantic themes. They are characterized by lively description, miniaturistic attitude, scholarly allusion, and an elevated tone similar to that of the elegy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epyllia"@en .

aat:300410361 a skos:Concept ;
    skos:definition "Genre of highly stylized Sanskrit literarature employed in the court epics of India from the early centuries CE. Characterized by an elaborate poetics of figures of speech, among which the metaphor and simile predominate. Other characteristics of the style are hyperbole, the careful use of language to achieve a particular effect, a sometimes ostentatious display of erudition, and an adroit use of varied and complicated meters. Topics are usually traditional subjects and themes derived from early popular epics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kavya"@en .

aat:300410362 a skos:Concept ;
    skos:definition "Those who pass along or reveal information originating in another source or from another person or deity. An example is in religion, where a human may be said to have transmitted a message from a divine source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmitters"@en .

aat:300410363 a skos:Concept ;
    skos:definition "Metal covers for icons, made of numerous thin pieces. The riza usually covers only certain parts of the icons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rizas"@en .

aat:300410364 a skos:Concept ;
    skos:definition "Type of metal cover for icons, typically one layer of metal ornamented, often set with jewels; oklads cover most of the depicted figure. It may also contain chambers to hold individual relics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oklads"@en .

aat:300410365 a skos:Concept ;
    skos:definition "Compositions of tunes, melodies, or other pieces of music or song in which a single melodic line predominates, and which has little or no distinctive accompaniment; if a song, may have simple or unobtrusive accompaniment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airs"@en .

aat:300410366 a skos:Concept ;
    skos:definition "Nations, parties, or leaders in armed conflict or waging war, particularly when recognized by the law of nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belligerents"@en .

aat:300410367 a skos:Concept ;
    skos:definition "Events comprising the gaining of territory, subjugation of a country or people, or other acquistion by force of arms or war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conquests"@en .

aat:300410368 a skos:Concept ;
    skos:definition "Marriage in which one or both parties are deceased. The custom is or was practiced in several cultures, including in the Sudan, China, France, and elsewhere. The custom often concerns property or inheritance rights of a deceased male."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghost marriage"@en .

aat:300410370 a skos:Concept ;
    skos:definition "Basic organizational units of the comic. Often arranged sequentially, with an individual panel depicting a singular moment in the story. Panels may also be arranged in tabular fashion and vary in size to break up visual monotony and vary narrative emphasis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panels"@en .

aat:300410371 a skos:Concept ;
    skos:definition "In animation, planning tools for synchronizing action and sound. Prior to the digital era, dope sheets were most commonly pieces of ruled paper, with each row representing one frame. Information about the section and scene, the animator's name, and total footage is recorded at the top of the sheet; camera instructions are typically listed to the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dope sheets"@en .

aat:300410372 a skos:Concept ;
    skos:definition "A preparation of powdered plant material, most often, but not always tobacco, for inhaling through the nostrils, or sometimes taken orally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuff"@en .

aat:300410373 a skos:Concept ;
    skos:definition "Beverages comprising primarily water into which carbon dioxide gas under pressure has been dissolved, either naturally or artificially. Soda may contain flavorings or other additives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soda"@en .

aat:300410374 a skos:Concept ;
    skos:definition "Devices comprising a tube or pipe, often bent with one end placed in a container or reservoir of liquid, such as a bottle or basin, and the other end outside it at a lower level. The aim is to convey liquid upwards from the container and out from the lower end of the pipe or tube. The liquid is conveyed through differences in atmospheric pressure on the liquid in the upper container that pushes it into the tube as gravity pulls downwards the liquid in the lower length of tubing; another force that accounts for the rise of the liquid up the tube has been attributed to the cohesiveness or tensile strength of the moving liquid rather than to atmospheric pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siphons"@en .

aat:300410375 a skos:Concept ;
    skos:definition "Photographic self-portraits typically captured with a smartphone, instantaneously uploaded and distributed via a social media network."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selfies"@en .

aat:300410376 a skos:Concept ;
    skos:definition "Graffiti art comprising images, usually on paper, affixed to surfaces using a wheat flour mixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheatpasting"@en .

aat:300410377 a skos:Concept ;
    skos:definition "Works in public space comprising knitted or crocheted adornments, usually installed without institutional oversight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yarn bombing"@en .

aat:300410378 a skos:Concept ;
    skos:definition "Metal repoussé icon cover, often serving as an icon frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basmas"@en .

aat:300410379 a skos:Concept ;
    skos:definition "Organized oppositions to authority; risings in arms or open resistance against established authority or governmental restraints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurrections"@en .

aat:300410380 a skos:Concept ;
    skos:definition "The dominions of a tsar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tsardoms"@en .

aat:300410381 a skos:Concept ;
    skos:definition "Ecclesiastical tribunals for the investigation, discovery, and suppression of heresy. First organized in the 13th century under Pope Innocent III."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inquisitions"@en .

aat:300410382 a skos:Concept ;
    skos:definition "Species of gram-negative, rod-shaped coccobacillus that can infect humans via the oriental rat flea, causing infection that takes three main forms: pneumonic, septicemic, and bubonic plagues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yersinia pestis"@en .

aat:300410383 a skos:Concept ;
    skos:definition "Effects, usually pre-set algorithms, that are applied to a digital image to create variations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filters"@en .

aat:300410384 a skos:Concept ;
    skos:definition "Words or phrases preceded by a hash symbol to identify and categorize messages about a particular subject. Created on and primarily used on social media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hashtags"@en .

aat:300410385 a skos:Concept ;
    skos:definition "Measurement for describing the resolution of a printed image, referring to the number of dots that can be printed per linear inch on a support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dots per inch"@en .

aat:300410386 a skos:Concept ;
    skos:definition "Image format designed for digital photographs. The EXIF file format captures technical information about both the camera and photographic conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "EXIF"@en .

aat:300410387 a skos:Concept ;
    skos:definition "Huichol artworks, most often employing yarn, representing the spiritual world or acting as a portal to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nierakate"@en .

aat:300410388 a skos:Concept ;
    skos:definition "Medical conditions or diseases that are not transmissible between people or other species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noncommunicable disease"@en .

aat:300410389 a skos:Concept ;
    skos:definition "In film photography, the use of chemicals intended for developing one kind of film (e.g. color) and applying them to another (e.g. negative), and vice versa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross processes"@en .

aat:300410390 a skos:Concept ;
    skos:definition "The most common form of an acute infectious disease caused by Yersina pestis that affects humans, wild rodents, and their ectoparasites. This condition persists due to its firm entrenchment in sylvatic rodent-flea ecosystems throughout the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bubonic plague"@en .

aat:300410391 a skos:Concept ;
    skos:definition "The resolution of electronic imaging devices such as computer monitors, digital cameras, televisions, or scanners, expressed as the number of pixels per linear inch. Pixels per centimeter also describes the resolution of image files."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pixels per inch"@en .

aat:300410392 a skos:Concept ;
    skos:definition "A measure of digital resolution as determined by the number of bits used to render each pixel or sample. Higher bit depths indicate a higher tonal range or fidelity. Bit depth for color defines the amount of color available to each of the pixels in digital image processing and display. This is derived from the number of bits used to define color within a digital image as determined by its file format. Audio bit depth is defined by the amount of bits in a sample in digital audio, which directly corresponds to the resolution of the sample and the dynamic range of the resulting sound produced or recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bit depth"@en .

aat:300410393 a skos:Concept ;
    skos:definition "General term for acute viral infection of the upper or lower respiratory tract that is marked by fever, chills, and a generalized feeling of weakness and pain in the muscles, together with varying degrees of soreness in the head and abdomen. May be caused by any of several closely related viruses in the family Orthomyxoviridae (a group of RNA viruses)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "influenza"@en .

aat:300410394 a skos:Concept ;
    skos:definition "An acquired defect of cellular immunity associated with infection by species of human immunodeficiency viruses. Criteria as defined by the CDC in 1993 include a CD4-positive T-lymphocyte count under 200 cells/microliter or less than 14% of total lymphocytes, and increased susceptibility to opportunistic infections and malignant neoplasms. Clinical manifestations also include emaciation and dementia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "AIDS"@en .

aat:300410395 a skos:Concept ;
    skos:definition "Family of RNA viruses containing four genera, some of which are noted for causing influenza in humans. Orthomyxoviridae have enveloped virions (virus particles) that measure between 80 and 120 nm (1 nm = 10−9 metre) in diameter. The nucleocapsid, which consists of a protein shell, or capsid, and contains the viral nucleic acids, has helical symmetry. The orthomyxovirus genome contains eight segments of single-stranded negative-sense RNA (ribonucleic acid), and an endogenous RNA polymerase is present for the transcription of the negative-sense strand into a positive-sense strand to enable protein synthesis. The lipoprotein envelope of the virion contains two glycoproteins, designated hemagglutinin (major antigen) and neuraminidase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orthomyxoviridae"@en .

aat:300410396 a skos:Concept ;
    skos:definition "Term formerly used to describe and differentiate any of a group of prokaryotic true bacteria from the archaebacteria. Today, true bacteria form the domain Bacteria. Bacteria are genetically and morphologically distinct from organisms classified in the other two domains of life, Archaea (formerly the Archaebacteria) and Eukarya (the eukaryotes)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eubacteria"@en .

aat:300410397 a skos:Concept ;
    skos:definition "Genus containing ovoid- or rod-shaped bacteria of the family Enterobacteriaceae. Yersinia are gram-negative bacteria and are described as facultative anaerobes, which means that they are capable of surviving in both aerobic and anaerobic environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yersinia"@en .

aat:300410398 a skos:Concept ;
    skos:definition "Family of gram-negative, facultatively anaerobic, rod-shaped bacteria that do not form endospores. Its organisms are distributed worldwide with some being saprophytes and others being plant and animal parasites. Many species are of considerable economic importance due to their pathogenic effects on agriculture and livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Enterobacteriaceae"@en .

aat:300410399 a skos:Concept ;
    skos:definition "Order of gram-negative bacteria containing one family, Enterobacteriaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Enterobacteriales"@en .

aat:300410400 a skos:Concept ;
    skos:definition "A group of the proteobacteria comprised of facultatively anaerobic and fermentative gram-negative bacteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gammaproteobacteria"@en .

aat:300410401 a skos:Concept ;
    skos:definition "A phylum of bacteria consisting of the purple bacteria and their relatives which form a branch of the eubacterial tree. This group of predominantly gram-negative bacteria is classified based on homology of equivalent nucleotide sequences of 16S ribosomal RNA or by hybridization of ribosomal RNA or DNA with 16S and 23S ribosomal RNA."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proteobacteria"@en .

aat:300410429 a skos:Concept ;
    skos:definition "The act of soliciting ideas and labor from a group of people outside one's organization or institution. This primarily online exchange draws on collective knowledge to accomplish a task, and the work is typically undertaken for free or for minimal payment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowdsourcing"@en .

aat:300410430 a skos:Concept ;
    skos:definition "Digital content, often humorous, and the viral spread of its various iterations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memes"@en .

aat:300410431 a skos:Concept ;
    skos:definition "Percussive instruments originating from Mali and Guinea. Held between the legs of the musician and struck on top, djembes can be used as leading instruments or to accompany others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "djembes"@en .

aat:300410432 a skos:Concept ;
    skos:definition "The number of data bits transmitted per unit of time, usually measured as bits per second."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bit rate"@en .

aat:300410433 a skos:Concept ;
    skos:definition "The number of signal changes occurring per second. Although distinct from bit rate, the two terms are often used interchangeably."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baud rate"@en .

aat:300410434 a skos:Concept ;
    skos:definition "Whisks, typically consisting of birch twigs, used in traditional Finnish saunas to gently stimulate the skin and muscles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vihta"@en .

aat:300410435 a skos:Concept ;
    skos:definition "Violence and intimidation, either open or clandestine, employed by governments or factions within governments against citizens, other government factions, or against foreign governments or groups. An example is the Reign of Terror, a government by intimidation as directed and carried out by the French Revolutionary government during the Revolution of 1789-1794."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "establishment terrorism"@en .

aat:300410436 a skos:Concept ;
    skos:definition "Violence and intimidation by revolutionaries seeking the complete abolition of a national regime or political system, and its replacement with new structures. Modern instances of such activity include campaigns in the Russian revolution and by the Italian Red Brigades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolutionary terrorism"@en .

aat:300410437 a skos:Concept ;
    skos:definition "Violence and intimidation by revolutionaries seeking to modify the existing sociopolitical structure, but not to overthrow an existing regime. Examples include some animal-rights campaigns and the ANC's campaign to end apartheid in South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subrevolutionary terrorism"@en .

aat:300410438 a skos:Concept ;
    skos:definition "Rectangular pieces of fabric wrapped from the back of the head and either tied or tucked behind the head so as to expose the face. Head wraps in the United States have been associated with slavery and servitude of African American women. In recent years some women have reclaimed the garment to assert their heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "head wraps"@en .

aat:300410439 a skos:Concept ;
    skos:definition "Long, loose-fitting sheer shirts worn by men in the Philippines and considered to be part of the national costume. Traditionally made from pineapple fiber, jusi (a combination of pineapple fiber and silk), or banana fabric; particularly notable for the embroidery on the front of the garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barong Tagalog"@en .

aat:300410440 a skos:Concept ;
    skos:definition "Legal and theological scholars of Islam, often clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ulema"@en .

aat:300410441 a skos:Concept ;
    skos:definition "Islamic legal scholars solicited by judges to weigh in on cases. Although non-binding, the muftis' reponse is considered authoritative and upheld in most instances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muftis"@en .

aat:300410442 a skos:Concept ;
    skos:definition "Long dresses with butterfly sleeves, considered part of the national costume for women in the Philippines, and made of jusi or polyester organza. Unlike the barong Tagalog worn by males, terno are worn mostly during special occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terno"@en .

aat:300410443 a skos:Concept ;
    skos:definition "Documents, usually Greco-Roman and often inscribed on lead tablets, requesting that the gods, other spirits, or deceased persons cause another person to be affected negatively, typically asking that they be cursed with illness or misfortune."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curse tablets"@en .

aat:300410445 a skos:Concept ;
    skos:definition "Computer software designed specifically for use on handheld mobile devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobile apps"@en .

aat:300410446 a skos:Concept ;
    skos:definition "Computer software stored on a server and typically accessible via a web browser."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web apps"@en .

aat:300410447 a skos:Concept ;
    skos:definition "Shapeshifting fox-like creatures considered to be the messengers of Inari, the Shinto deity of rice and grains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitsune"@en .

aat:300410448 a skos:Concept ;
    skos:definition "Mythological canines that resemble raccoons. In Japanese folkore, tanukis are tricksters and sources of amusement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanuki"@en .

aat:300410449 a skos:Concept ;
    skos:definition "In the Nahuatl language, refers to the loose and boxy, often colorfully embroidered blouse worn by Indigenous women of Mesoamerica. Traditionallly formed from a single rectangular piece of cloth with a slit in the center for the head, folded in half and sewn up the sides leaving openings for the arms. Associated with the skirt called cueitl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huipils"@en .

aat:300410450 a skos:Concept ;
    skos:definition "Keyboards that can be worn around the body, especially popular in the 1980s. Handles are similar to the necks of guitars and feature controls for pitch, modulation, and volume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keytars"@en .

aat:300410451 a skos:Concept ;
    skos:definition "Small, five-stringed guitars with convex-curved bodies and vaulted backs. Predominant in mariachi music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vihuelas"@en .

aat:300410452 a skos:Concept ;
    skos:definition "Small-bodied guitars with six strings and bodies deeper than the standard acoustic guitar. Requintos are especially popular in Mexico and mariachi music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "requintos"@en .

aat:300410453 a skos:Concept ;
    skos:definition "12-stringed rhythm-bass instruments with deeper acoustic boxes and shorter necks than the traditional 12-string guitar. Common in tejano and conjunto music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bajo sexto"@en .

aat:300410454 a skos:Concept ;
    skos:definition "Version of the bajo sexto with 10, instead of 12, strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bajo quinto"@en .

aat:300410456 a skos:Concept ;
    skos:definition "Flags, banners, figures, or other objects that are an identifying symbol or rallying-point, and that are designed for or used in processions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional standards"@en .

aat:300410457 a skos:Concept ;
    skos:definition "Process, typically taking place according to customary or legal principle, by which one person, or sometimes multiple people or a state, succeeds another in the occupation or possession of a throne, land, or estate. The act or fact of succession typically binds the successor legally to the rights and liabilities of the predecessor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "successions"@en .

aat:300410458 a skos:Concept ;
    skos:definition "Military ranges reserved primarily or entirely to the firing of artillery, which include firearms generally having a bore of over one inch in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artillery ranges"@en .

aat:300410459 a skos:Concept ;
    skos:definition "Cloaks in the shape of a semicircle, with a part tossed over the head. Although chadors have front openings, they are worn closed. Chadors are in greatest use among Muslim women who wish to reflect Islamic modesty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chadors"@en .

aat:300410460 a skos:Concept ;
    skos:definition "A plain-weave textile with different colors for its warp and weft; one of these is usually white. Chambray is noted for its durability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chambray"@en .

aat:300410461 a skos:Concept ;
    skos:definition "Sumptuous outergarments worn during the Renaisssance by upper-class men. Often with puffed or full sleeves, chamarres are folded back and fastened at the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamarres"@en .

aat:300410462 a skos:Concept ;
    skos:definition "Traditional costume of Korea, normally consisting of trousers or a skirt and an outer jacket or a coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanbok"@en .

aat:300410463 a skos:Concept ;
    skos:definition "Open ruffs, embroidered or lace, popularized by women of the Medici family. The collars are wired or stiffened to curve from the back of the head to the throat, giving it a fan-like appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medici collars"@en .

aat:300410464 a skos:Concept ;
    skos:definition "Coronet-like headbands worn in ancient Greece. Unlike diadems, stephanes are not usually associated with rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stephanes"@en .

aat:300410465 a skos:Concept ;
    skos:definition "Wide headbands worn by women in ancient Rome to bind the hair in a neat fashion and to suggest modesty. Vittae can be plain or adorned with jewels to signify wealth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vittae"@en .

aat:300410467 a skos:Concept ;
    skos:definition "Ankle-length tunics worn by women in ancient Egypt; fringed at the hem and usually held with a girdle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalasiris"@en .

aat:300410468 a skos:Concept ;
    skos:definition "Veils worn by women in ancient Greece. Covering the back and shoulder, when required kredemnons may also conceal the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kredemnons"@en .

aat:300410469 a skos:Concept ;
    skos:definition "The process or state of sinking to a weaker or inferior condition, a gradual loss of power, decay, diminution, or deterioration of a state, person, corporate body, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decline"@en .

aat:300410471 a skos:Concept ;
    skos:definition "Embroidery, popular during the Renaissance, that uses black or red silk thread to design stylized patterns on garments for both women and men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackwork"@en .

aat:300410472 a skos:Concept ;
    skos:definition "On shoes, leather strips typically found between the sole and the upper. Phased out by the end of the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rands"@en .

aat:300410473 a skos:Concept ;
    skos:definition "Heelless slippers, of Arab-Islam origin, often pointed at the toes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "babouches"@en .

aat:300410474 a skos:Concept ;
    skos:definition "Written or spoken language that is eloquent, elegant, or ornate, particularly when expressed in terms calculated to persuade. In usage, may be intended as depreciative, referring to language characterized by artificial, insincere, or ostentatious expression; inflated or empty verbiage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhetoric"@en .

aat:300410475 a skos:Concept ;
    skos:definition "Activity or process of moving to and inhabiting an area as colonists or new-comers; the act of peopling or colonizing an area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settlement"@en .

aat:300410476 a skos:Concept ;
    skos:definition "Violent attacks against civilians as part of a systematic effort to create a general climate of fear in a population, usually for political, religious, or social ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrorist attacks"@en .

aat:300410477 a skos:Concept ;
    skos:definition "People who commit unlawful killings of human beings with malice aforethought."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "murderers"@en .

aat:300410478 a skos:Concept ;
    skos:definition "People involved in the systematic use of terror, violence, and intimidation to achieve an end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrorists"@en .

aat:300410479 a skos:Concept ;
    skos:definition "In comics, the process of tracing over pencilled work to add definition to the illustration. Traditionally undertaken with pens, brushes, and ink, inking is now largely accomplished with digital drawing tablets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inking"@en .

aat:300410480 a skos:Concept ;
    skos:definition "Sandals used indoors in ancient Rome, typically made from one piece of leather and fastened by laces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbatinae"@en .

aat:300410481 a skos:Concept ;
    skos:definition "Plaited straw slippers worn by women in ancient Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peribarides"@en .

aat:300410482 a skos:Concept ;
    skos:definition "Wooden clogs from the Philippines, cut to resemble the shape of feet, and painted on the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bakyas"@en .

aat:300410483 a skos:Concept ;
    skos:definition "Sleeved coats, sometimes made of leather. Persian in origin and worn there by males of high social status, in ancient Greece kandys are reserved for women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kandys"@en .

aat:300410484 a skos:Concept ;
    skos:definition "Patterned cloaks worn by women and men from Thrace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zeiras"@en .

aat:300410485 a skos:Concept ;
    skos:definition "Cloth bands functioning as brassieres in ancient Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strophia"@en .

aat:300410486 a skos:Concept ;
    skos:definition "Typical European publication format for collections of comics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albums"@en .

aat:300410489 a skos:Concept ;
    skos:definition "Wooden slit drums with two keys, and shaped like logs or barrels, used by the Aztecs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teponaztlis"@en .

aat:300410490 a skos:Concept ;
    skos:definition "Tall wooden drums used by Aztecs. Instead of using mallets, players strike the tops of the huéhuetls with their fingers or hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huéhuetls"@en .

aat:300410491 a skos:Concept ;
    skos:definition "Tortoiseshell drums used by Aztecs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "áyotls"@en .

aat:300410492 a skos:Concept ;
    skos:definition "Small brass or copper pots with long handles, used to make coffee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ibriks"@en .

aat:300410493 a skos:Concept ;
    skos:definition "Dishes used during meals in medieval times to discard food fragments and other waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voiders"@en .

aat:300410494 a skos:Concept ;
    skos:definition "Plastic or metal objects inserted in 45 rpm 7-inch records to convert the wider spindle hole to LP-size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "45 rpm adapters"@en .

aat:300410495 a skos:Concept ;
    skos:definition "In architecture, the general arrangement or distribution of moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modinature"@en .

aat:300410496 a skos:Concept ;
    skos:definition "Rails or panels stretching from the lintel to the sill of doors, dividing the doorframe into two parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "replumi"@en .

aat:300410497 a skos:Concept ;
    skos:definition "Walkways, typically behind the parapets, along the tops of defensive fortications such as those found in castles or as part of city walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vamures"@en .

aat:300410498 a skos:Concept ;
    skos:definition "Refers to the method of molding individual clay rings above each other to build a ceramic vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring-building"@en .

aat:300410499 a skos:Concept ;
    skos:definition "Reflections of a light source captured in a subject's eyes in a photograph, painting, film, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catchlights"@en .

aat:300410500 a skos:Concept ;
    skos:definition "Documents prepared primarily to confirm a government's action or perspective that was previously expressed orally. Informal in nature, aide-mémoires do not contain the markings of more formal documents; only the date of execution is visible at the end of the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aide-mémoires"@en .

aat:300410501 a skos:Concept ;
    skos:definition "Robots and robotic systems with the appearance and/or behavior similar to that of humans. To refer to machines with human parts, use \"cyborgs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "androids"@en .

aat:300410502 a skos:Concept ;
    skos:definition "Cybernetic organisms, often depicted in science fiction works as humans with machine parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyborgs"@en .

aat:300410503 a skos:Concept ;
    skos:definition "Works of any medium that are planned or designed, but not constructed or made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unrealized works"@en .

aat:300410504 a skos:Concept ;
    skos:definition "Sudden outbreaks of a disease in people, animals, or plant populations in a region where the disease was not previously recognized or where a rapid increase in the number of new cases of a previous existing endemic disease occurs in the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epidemics"@en .

aat:300410505 a skos:Concept ;
    skos:definition "Epidemics of infectious disease that are extremely widespread, for example have spread to many countries, often to more than one continent, usually affecting a large number of victims."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pandemics"@en .

aat:300410506 a skos:Concept ;
    skos:definition "Boards with a dark, usually black or green, surface for writing or drawing with chalk or a similar material. Examples of use include as a teaching aid in classrooms, and in shops, restaurants, or elsewhere for displays, usually words, that may be easily altered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackboards"@en .

aat:300410508 a skos:Concept ;
    skos:definition "Lacquer mixed with powdered cinnabar, applied in thick coats, often carved to produce the traditional red lacquerware in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red lacquer"@en .

aat:300410509 a skos:Concept ;
    skos:definition "Distinctive lacquerware made with lacquer mixed with powdered red cinnabar, applied in thick coats and carved to produce boxes, jars, figures, panels, beads, and other objects, particularly in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red lacquerware"@en .

aat:300410510 a skos:Concept ;
    skos:definition "Visual works or parts of works, in any medium, having subject matter that provides a visual representation of a story. Stories may be based on literary works, myths and religion, historical events, or any story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrative art"@en .

aat:300410511 a skos:Concept ;
    skos:definition "In China, wood block prints produced during the Lunar New Year as traditional domestic decoration. Prints typically summon good fortune and may also be pedagogical in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nían hùa"@en .

aat:300410532 a skos:Concept ;
    skos:definition "Regional or indigenous Latin American large serving pans or pots, made of stone or ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huidis"@en .

aat:300410628 a skos:Concept ;
    skos:definition "In indigenous American cultures, containers that are very small versions of containers of normal size; for ritual use, where the small item stands for the normal-sized object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniaturas"@en .

aat:300410645 a skos:Concept ;
    skos:definition "Regional or indigenous Latin American ceramic vessels, usually Incan, having a pointed base, globular or cylindrical walls, and a long, narrow neck; often have handles. They are named after, but distinguished from, Greek vessels \"aryballoi,\" which may have similar shapes. distinctively shaped Inca vessel is a symbol of the Inca Empire. Arybalos are found in every territory that the Inca conquered, with regional variations in decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arybalos"@en .

aat:300410672 a skos:Concept ;
    skos:definition "Regional or indigenous Latin American containers used to ferment the type of chicha that is obtained from a variety of pumpkin called guada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guadas"@en .

aat:300410676 a skos:Concept ;
    skos:definition "Regional or indigenous Latin American containers made of gourds or small pumpkins, used is to carry quicklime for coca use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iscupurus"@en .

aat:300410796 a skos:Concept ;
    skos:definition "Containers of a particular type, usually made of reeds and leather; found in Latin American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tawelas"@en .

aat:300410866 a skos:Concept ;
    skos:definition "Woven or knitted caps that are relatively simple in structure, without a rim or visor; are often colorful, comprising woven designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorros"@en .

aat:300410909 a skos:Concept ;
    skos:definition "Woolen garment comprising a rectangular panel, usually tucked in at the belt and wrapped in various ways around the hips and between the thighs; may be worn by males in southern South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chirpas"@en .

aat:300411107 a skos:Concept ;
    skos:definition "Culture of the most numerous group of Indians in South America, inhabiting the Central Valley of Chile, south of the Biobío River. A smaller group lives in Neuquén provincia, west-central Argentina. Historically, the Mapuche were one of three groups of Araucanians as identified by Spanish ethnographers -- Picunche, Mapuche, Huillich. All Araucanians now identify themselves as Mapuche. In the pre-Spanish period, the Mapuche lived in scattered farming villages throughout the Central Valley. Each settlement had a cacique, or chief, whose authority did not generally extend beyond his own village. The Mapuche cultivated corn (maize), beans, squash, potatoes, chili peppers, and other vegetables and fished, hunted, and kept guinea pigs for meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mapuche"@en .

aat:300411168 a skos:Concept ;
    skos:definition "Style and culture of the regional Andean tribe, the Cajamarca (or Caxamarca) that flourished in northern Peru during the first millennium AD, and the birthplace of the Cajamarca pottery style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cajamarca"@en .

aat:300411239 a skos:Concept ;
    skos:definition "Culture at Chiripa dating from 1000-800 BCE, based on calibrated radiocarbon dates from 1992 and 1996 excavations. This phase is marked by a growth in population and an early example of communal architecture in the Lake Titicaca Basin, a semi-subterranean plaza or court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Chiripa"@en .

aat:300411241 a skos:Concept ;
    skos:definition "Pre-Columbian culture and period of the Central Andes, marked by the expansion of irrigation on the coast and and development of a lake-agricultural-livestock economy; focused on southern shore of Lake Titicaca, and population center at Chiripa, Bolivia. The culture is temporally located between the between the Initial period and Early Horizon period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiripa"@en .

aat:300411283 a skos:Concept ;
    skos:definition "Refers to the expressionistic style inspired by children's art characteristic of a group formed in 1948 by artists from Copenhagen, Brussels, and Amsterdam. The formalized group is often referred to as a movement, though technically it is a corporate body made up of founding members, rather than a generalized movement with unaffiliated members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CoBrA"@en .

aat:300411286 a skos:Concept ;
    skos:definition "A style inspired by American Impressionists and unique to Pennsylvania and surrounding areas.The Pennsylvania Impressionists painted the natural beauty of the local countryside around the turn of the century. These artists focused less on optics and ephemeral light effects than their French counterparts but utilized similar brushwork to express an immediacy and expressive urgency in their depictions of nature. The Pennsylvania Impressionist artists were united by their connections to the vibrant New Hope area of Pennsylvania. In the early 20th century artists of diverse backgrounds were attracted to Bucks County for its rural landscape and proximity to Philadelphia. Many artists studied and taught with one another at the Pennsylvania Academy of the Fine Arts and the Philadelphia School of Design for Women (now the Moore College of Art and Design)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pennsylvania Impressionist"@en .

aat:300411288 a skos:Concept ;
    skos:definition "Describes a photographic movement identified in an exhibition organized by William Jenkins at the International Museum of Photography at George Eastman House, Rochester, NY (Dec 1975–Feb 1976). Included were ten photographers: Robert Adams, Lewis Baltz, Bernd Becher and Hilla Becher, Joe Deal, Frank Gohlke, Nicholas Nixon , John Schott, Stephen Shore, and Henry Wessel Jr. Jenkins posited that these photographers observed the American landscape with a clinical objectivity rather than a Romantic or Symbolist sensibility that had marked earlier representations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Topographics"@en .

aat:300411302 a skos:Concept ;
    skos:definition "Whistles or other simple instruments used to imitate the sound of a particular animal, such as a bird or a deer; often designed for hunters or bird watchers to attract animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calls"@en .

aat:300411303 a skos:Concept ;
    skos:definition "Whistles or other simple instruments for imitating the song of birds, in order to attract or decoy them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird calls"@en .

aat:300411304 a skos:Concept ;
    skos:definition "Whistles or other simple instruments for imitating the call of deer, in order to attract or decoy them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deer calls"@en .

aat:300411306 a skos:Concept ;
    skos:definition "Trade name of a type of thermosetting resin, manufactured by Monsanto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Opalon (TM)"@en .

aat:300411307 a skos:Concept ;
    skos:definition "Groupings into which items are divided to be sold at an auction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auction lots"@en .

aat:300411308 a skos:Concept ;
    skos:definition "Groupings into which items are divided to be sold or for another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lots"@en .

aat:300411309 a skos:Concept ;
    skos:definition "Objects of any material, such as pieces of wood, bone, paper, straws, etc., used in methods of random selection to secure a decision. Examples of use include in resolving disputes, dividing goods, choosing people for an office or duty, or choosing a course of action. The use of the objects may be seen to appeal to chance or to a divine agent believed to be involved in the results of chance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lots"@en .

aat:300411310 a skos:Concept ;
    skos:definition "The practice or function of casting lots in order to decide something or to forecast the future, or the implementation of divination performed in some other way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sortilege"@en .

aat:300411311 a skos:Concept ;
    skos:definition "The act or function of using lots, which are bits of wood, paper, or another material, to make decisions based on random selection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casting lots"@en .

aat:300411312 a skos:Concept ;
    skos:definition "Large-scale color transparency created by Kodak in the 1970s, typically used in lightboxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Duratrans (TM)"@en .

aat:300411313 a skos:Concept ;
    skos:definition "Designation used for painters in 14th- through 18th-century northern and southern Europe who specialized in decorative work or minor works rather than painting the main subjects of primary paintings. It was defined within the painters' guild of St. Luke; it also included house painters and varnishers. Coarse painters were considered of lower status than \"artist painters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coarse painters"@en .

aat:300411314 a skos:Concept ;
    skos:definition "Designation used for painters in 14th- through 18th-century northern and southern Europe who painted the main subjects of art works, distinguished from \"coarse painters,\" who specialized in decorative work. The categories were defined within the painters' guild of St. Luke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist painters"@en .

aat:300411315 a skos:Concept ;
    skos:definition "Fiberboard that is typically made of wood fibers left over from processing of hard woods or soft woods; distinguished from medium-density fiberboard and low-density fiberboard by density of fiber and strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-density fiberboard"@en .

aat:300411316 a skos:Concept ;
    skos:definition "Boards made of wood, but from flakes or chips of wood rather than from full lengths of lumber. Composition wood boards are usually classified by fiber size (largest to smallest): waferboard, oriented strandboard, flakeboard, particleboard, and fiberboard, which may be made of cellulose fibers other than wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition wood board"@en .

aat:300411317 a skos:Concept ;
    skos:definition "A type of layered composite wood board made from wood wafers bonded together with a waterproof phenolic resin. Waferboard first appeared in the 1950s. It comprises thin, sliced wood chips or strands prepared in thin mats; three to five of the mats are cemented together to form the final board. It is used in the construction of houses and inexpensive furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waferboard"@en .

aat:300411319 a skos:Concept ;
    skos:definition "A type of layered composite wood board made from the shavings and flakes of wood that are generated at saw mills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flakeboard"@en .

aat:300411320 a skos:Concept ;
    skos:definition "General term for a heavy type of paper that is at least 0.012 inches thick. Some paperboards are made from thick paper pulp castings that are milled or pressed into a hard, stiff sheet, while others are made from several laminated sheets of paper adhered together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paperboard"@en .

aat:300411321 a skos:Concept ;
    skos:definition "Paper of a weight that is thicker and stiffer than writing or printing paper, but thinner and more flexible than paperboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card stock"@en .

aat:300411322 a skos:Concept ;
    skos:definition "Fiberboard that is typically made of wood dust or fibers, or other cellulose left over from the processing of other products; distinguished from medium-density fiberboard and high-density fiberboard by density of fiber and strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-density fiberboard"@en .

aat:300411323 a skos:Concept ;
    skos:definition "Fiberboards, generally made of wood fibers, used in building construction and furniture-making. The standard size for fiber building boards is 4 x 8 feet; they are generally classified as low-density, medium-density, or high-density."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiber building board"@en .

aat:300411324 a skos:Concept ;
    skos:definition "Trademarked variety of fiberboards made from bagasse (sugar cane waste) or mineral fibers. Examples include insulating tiles and boards. Celotex products were treated to resist fungi, termites, and water. The boards had a rough, weblike surface that accepted paint well, but they became brittle and friable with age. Low-density Celotex boards were used in the 1930s for heat and sound insulation in such buildings as the White House, Washington D.C. and Rockefeller Center in New York City."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celotex (TM)"@en .

aat:300411325 a skos:Concept ;
    skos:definition "Trademarked variety of pulp composite wallboard made from wood pulp or waste paper. It became a popular interior finish wallboard because the boards were available in many types of finishes, such as pebble-surfaced, and could be painted or decorated with stenciled designs instead of wallpaper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beaverboard (TM)"@en .

aat:300411326 a skos:Concept ;
    skos:definition "Imitation of silk georgette. The crêpe-like texture is produced by shrinking some sections of the fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotton georgette"@en .

aat:300411327 a skos:Concept ;
    skos:definition "Pieces of textiles of any length, distinguished by having a width that is the full measure of the weft, which are the threads extending across the width of the loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loom widths"@en .

aat:300411328 a skos:Concept ;
    skos:definition "Ottoman textile material incorporating metal‑wrapped thread into a lampas, or multiweave fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kemha"@en .

aat:300411329 a skos:Concept ;
    skos:definition "Ottoman compound-weave fabric woven with silver and gold metallic threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seraser"@en .

aat:300411330 a skos:Concept ;
    skos:definition "Ottoman fabric comprising voided silk velvet woven with gold, gilded silver, and silver metallic threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "çatma"@en .

aat:300411331 a skos:Concept ;
    skos:definition "Distinctive cantir-type containers originating in the Mapuche culture, having two openings, often of terracotta, and often in the form of animals. The vessels may be used for liquids; occasionally also to make music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metahues"@en .

aat:300411332 a skos:Concept ;
    skos:definition "Sculptures, either relief sculptures or in-the-round, that are ceramic and have a vitreous glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazed sculpture"@en .

aat:300411333 a skos:Concept ;
    skos:definition "Family of small flying insects, similar in appearance to the mosquito, common in lake environments; they have transparent larvae called \"glassworms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chaoboridae"@en .

aat:300411334 a skos:Concept ;
    skos:definition "Common term for the transparent larvae of members of the Chaoboridae family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassworms"@en .

aat:300411335 a skos:Concept ;
    skos:definition "Activities and planning for surviving and coping with emergencies, such as storms, floods, earthquakes, civil unrest, and other such disruptive events. Examples of preparedness activities include the acquisition of emergency food, water, and first aid supplies, forming a plan for contacting family members during an emergency, etc. For larger scale planning and preparedness activities of communities and governments, prefer \"disaster planning,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency preparedness"@en .

aat:300411336 a skos:Concept ;
    skos:definition "The process of making replicas or copies of art images, art objects, decorative arts, built works, or other valued images or objects, made without intent to deceive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproduction"@en .

aat:300411337 a skos:Concept ;
    skos:definition "Thermoplastic resin, used for its strength and durability. Due to its high level of weather resistance, ETFE is frequently used in construction and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethylene tetrafluoroethylene"@en .

aat:300411338 a skos:Concept ;
    skos:definition "Material comprising the leaves of any of several species of trees in the family Theaceae, used for many purposes by humans. Examples include tea leaves used to create a beverage or food, as a dye, as a cleanser, as an adsorbent, as an absorbent of moisture or odor, and in interpretive divination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea leaf"@en .

aat:300411339 a skos:Concept ;
    skos:definition "Class of marine invertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Echiura"@en .

aat:300411340 a skos:Concept ;
    skos:definition "Method of divination in which the diviner creates a pattern to interpret rather than looking for omens in nature or other existing phenomena or things. Examples of interpretive divination include casting lots and reading tea leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interpretive divination"@en .

aat:300411341 a skos:Concept ;
    skos:definition "General term for materials comprising fibers or other components that are created by weaving. Includes, but not limited to, woven textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woven material"@en .

aat:300411343 a skos:Concept ;
    skos:definition "Metalworking tools formed as an angle with conical points intended to enlarge drilled or punched holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angular reamers"@en .

aat:300411344 a skos:Concept ;
    skos:definition "Tape recorders designed to record and play back tape housed in cassettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassette recorders"@en .

aat:300411346 a skos:Concept ;
    skos:definition "Rooms for pedagogical use that do not conform to a typical school instruction structure. Use 'classrooms' for similar rooms that are located in schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instruction rooms"@en .

aat:300411347 a skos:Concept ;
    skos:definition "Devices to weigh letters or packages to determine the postage due."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter balances"@en .

aat:300411348 a skos:Concept ;
    skos:definition "Plates for consuming food, equipped with a reservoir in or under the plate that could be filled with hot water, used to keep the food warm for a prolonged period. Historically these have been made entirely of porcelain, combinations of porcelain and metals, and now plastic. They are often but not exclusively found in care-giving environments such as hospitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot water plates"@en .

aat:300411349 a skos:Concept ;
    skos:definition "Subsidiary built waterways for redirecting the water of a river or canal, provided with an adjustable gate or gates by which the volume of water is regulated or controlled. These are commonly used for low discharges; use \"sluices\" for structures that regulate higher discharges of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outlet sluices"@en .

aat:300411352 a skos:Concept ;
    skos:definition "Nuts from any of about 15 species of shrubs and trees constituting the genus Corylus in the birch family (Betulaceae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hazelnuts"@en .

aat:300411353 a skos:Concept ;
    skos:definition "Shallow, usually circular dishes that display decorative motifs or images applied in glaze. Most often these are intended purely as decorative items rather than as utilitarian objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative plates"@en .

aat:300411355 a skos:Concept ;
    skos:definition "Edible seeds of the legume plant, Arachis Hypogaea; classified as a grain legume and also as an oil crop, because peanut oil is a primary product. Peanut pods develop and ripen underground, which is unusual for crop legumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peanuts"@en .

aat:300411356 a skos:Concept ;
    skos:definition "Grapes that are partially dried in sunlight or by artificial means. Uses include eating as is, as an ingredient in cooking, and in the production of wine"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raisins"@en .

aat:300411357 a skos:Concept ;
    skos:definition "Atars in the form of a table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar tables"@en .

aat:300411358 a skos:Concept ;
    skos:definition "Visual works in which landscapes depicting mountains are the primary focus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain landscapes"@en .

aat:300411360 a skos:Concept ;
    skos:definition "Steel rods with ridged or abrasive surfaces, fixed with handles, and used for maintaining the edges on knife blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honing steels"@en .

aat:300411361 a skos:Concept ;
    skos:definition "Cylindrical rods in which nibs or penpoints are inserted, and that form the handle of a dip pen. These may be made from a variety of materials, including wood, metal, or plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen holders"@en .

aat:300411362 a skos:Concept ;
    skos:definition "Optical devices, often hand-held, typically lighted and used to look at slides or other frames of film. For devices that project images from slides, prefer \"slide projectors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slide viewers"@en .

aat:300411363 a skos:Concept ;
    skos:definition "Places, either sites or structures, set aside by a community, ruler, etc. for delivering corporal punishment or executions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "places of punishment"@en .

aat:300411364 a skos:Concept ;
    skos:definition "Instruments designed for the purpose of administering a liquid or gaseous substance into the rectum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enema syringes"@en .

aat:300411365 a skos:Concept ;
    skos:definition "Industrial facilities dedicated to the large-scale production of food products prepared by moistening, kneading, and baking flour or meal into bread or similar products. For buildings or parts of buildings where bread and other baked goods are prepared, and that may include a space for the retail sale of baked goods, use \"bakeries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread factories"@en .

aat:300411366 a skos:Concept ;
    skos:definition "A form of folk dress intended to be worn by congregants during formal worship in church. For costume worn by officiates of religious ceremonies, use \"liturgical costume.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church costume"@en .

aat:300411367 a skos:Concept ;
    skos:definition "Regional dress expresses geographic identity, and can also indicate social, marital, and/or religious status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional dress"@en .

aat:300411369 a skos:Concept ;
    skos:definition "Navigational instruments designed by the Englishman John Davis in 1594. This instrument measures the height of the sun by the projection of a shadow. In this case the observer stands with their back to the sun, hence the English name 'backstaff'. Instead of the cross of the Jacob's staff, the Davis quadrant features two arcs to which sliding vanes are mounted. By taking the horizon as the starting point, the observer can measure the shadow of the vane on the first arc using that of the second arc. The Davis quadrant was originally made of wood with ebony or ivory quadrants.Brass or steel predominanted after about 1775."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Davis quadrants"@en .

aat:300411370 a skos:Concept ;
    skos:definition "Constructions on the upper decks of sailboats or motorboats, often equipped with a door and windows, which serve to accommodate crewmembers or passengers or ship material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deck cabins"@en .

aat:300411371 a skos:Concept ;
    skos:definition "Cinemas that present independent films with artistic rather than commercial appeal including foreign or experimental films, or revivals of older releases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art house cinemas"@en .

aat:300411372 a skos:Concept ;
    skos:definition "Windmill used to power the pumping of water from a polder, which is low-lying land reclaimed from the sea, to a drainage network."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polder mills"@en .

aat:300411374 a skos:Concept ;
    skos:definition "Lighted signals mounted on tall poles used to indicate the presence of waterways or channels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole beacons"@en .

aat:300411376 a skos:Concept ;
    skos:definition "Subterranean spaces of larger structures where raw milk is put to separate from the cream layer. For dedicated structures designated for similar purposes use \"milk houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk cellars"@en .

aat:300411377 a skos:Concept ;
    skos:definition "Rooms or larger areas devoted to the storage or display of fine art prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print rooms"@en .

aat:300411378 a skos:Concept ;
    skos:definition "Walls or fences that are placed in a garden or orchard to protect fruit trees from wind and weather. Of varied design, they generally provide a microclimate that preserves warmth after the sun has set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit walls"@en .

aat:300411379 a skos:Concept ;
    skos:definition "Freestanding exterior walls that curve back and forth regularly along their length. Typically made of brick, the zig-zag or serpentine configuration does not have buttresses, thus differing from the superficially similar \"garland wall\"; the strength of the serpentine walls derives from the wavy configuration, allowing them to be only one brick thick. This Dutch form was introduced in Britain in the 17th cedntury when Dutch engineers drained the fen country; it was taken up elsewhere in Europe and North America. Often used to enclose gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentine walls"@en .

aat:300411381 a skos:Concept ;
    skos:definition "Cellars that are accessible from wharves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wharf cellars"@en .

aat:300411382 a skos:Concept ;
    skos:definition "Protective layers of fabric with closures that slip over duvets to protect them during use, and that often have decorative qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duvet covers"@en .

aat:300411383 a skos:Concept ;
    skos:definition "Windows that extend to the ground or nearly to the ground. For floor-length wall openings consisting entirely or mostly of glass panels and hinged on one side so they may function as either doors or windows, use \"French doors\" if they are single doors or \"French windows\" if they are a pair of units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fenêtres à terre"@en .

aat:300411384 a skos:Concept ;
    skos:definition "Sanatoriums devoted to the treatment of tuberculosis, usually dating to the 19th and early 20th centuries. The facilities were typically located in a rural environment, with large windows and sunning porches, large enough to house dozens or hundreds of patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuberculosis sanatoriums"@en .

aat:300411385 a skos:Concept ;
    skos:definition "A handball game with play similar to American handball and with scoring resembling tennis. It originates in the Northern Dutch province of Friesland. The game is played on a rectangular grass court by two teams with three players each. A hard leather ball is served from a box to a receiving zone. When the ball falls from a rally the spot is marked by a small wood block called a kaats, from which the game derives its name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Frisian handball"@en .

aat:300411388 a skos:Concept ;
    skos:definition "Large buildings that that are intended as markets and warehouses for cloth. These spaces originated in the Middle Ages and evolved into spaces where brokers and dealers arranged international sales of wool and finished cloth, and local merchants bought and sold wool, thread, and cloth in varied stages of production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth halls"@en .

aat:300411389 a skos:Concept ;
    skos:definition "Buildings with oasts where madder was dried and pulverized to obtain the reddish-purple dye obtained from the plant's roots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madder mills"@en .

aat:300411390 a skos:Concept ;
    skos:definition "Nautical pulley blocks having projections at the bottom of their shells to prevent the rope that is rove through them from becoming jammed between the block and the yard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder blocks"@en .

aat:300411391 a skos:Concept ;
    skos:definition "Portrait to the knee, as opposed to a bust or full-length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knee-length portraits"@en .

aat:300411392 a skos:Concept ;
    skos:definition "Barrier on waterways such as rivers, lakes or at the seashore that incorporate sluices for controlling water levels to prevent flooding or to harness water power. For hydraulic structures that connect higher and lower sections of artificial waterways for transferring watercraft from one level to another, use 'locks.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "control locks"@en .

aat:300411393 a skos:Concept ;
    skos:definition "Silver, ceramic or glass drinking vessels, customarily used in the Netherlands during the 17th 18th century to toast pregnant women. When the cup is filled, the figure of an infant appears from a chamber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hansje in de kelders"@en .

aat:300411394 a skos:Concept ;
    skos:definition "Wood molds in which the dough for gingerbread or speculaas cookies is formed. The dough is pressed into the mold, forming the entire biscuit, unlike similar molds that are meant to be repeatedly pressed into the dough in series."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speculaas molds"@en .

aat:300411395 a skos:Concept ;
    skos:definition "Mechanical traps of various sizes consisting of serrated jaws triggered with a spring, designed to catch prey by the leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gin traps"@en .

aat:300411396 a skos:Concept ;
    skos:definition "Photographic prints in which bromoil print matrices are used to transfer the image to another support. Normally the matrix would reveal the final image of a bromoil print. Bromoil transfer prints have the ability to be rendered on any support, not just the specially prepared silver gelatin paper of the matrix as in a bromoil print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bromoil transfer prints"@en .

aat:300411397 a skos:Concept ;
    skos:definition "A table-top game, or sport, that is loosely based on association football. A vast number of different table types exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table football"@en .

aat:300411398 a skos:Concept ;
    skos:definition "Dense, fine, plain woven black cloth with a plain or twill weave. The raw yardage is creased or folded double, with its two lists brought together, as for cloth over 54 inches wide. Historically made of wool, broadcloth is used chiefly in the construction of menswear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadcloth"@en .

aat:300411399 a skos:Concept ;
    skos:definition "Artificial water courses in recreation areas that may include varied elements simulating rapids, caves, waterfalls, or chutes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water rides"@en .

aat:300411400 a skos:Concept ;
    skos:definition "Gables having an underlying triangular or rectangle form with curved sides; so-named because they resemble the cross-section of a bell or a 17th-century mantle clock. If the gable is surmounted by a pediment, it is often called a \"Dutch gable.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell gables"@en .

aat:300411401 a skos:Concept ;
    skos:definition "Traditional one side edged swords of various tribes in Indonesia. Initially intended as a cleaver, and later used as a weapon. Dutch troops in Indonesia also called their modified cutlasses by this name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "klewangs"@en .

aat:300411402 a skos:Concept ;
    skos:definition "General term for clothing designed for and worn by babies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby wear"@en .

aat:300411403 a skos:Concept ;
    skos:definition "Floating objects in fixed positions used by ships or boats for mooring in deep water. Their design incorporates a weight fixed in the bottom of a body of water that acts as an anchor holding the buoy in its position. These are often used in areas near coral reefs to save the reef from damage by the use of ships anchors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mooring buoys"@en .

aat:300411404 a skos:Concept ;
    skos:definition "Structures or devices used to allow the transportation of a boat, goods, etc. over land between navigable bodies or stretches of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portages"@en .

aat:300411405 a skos:Concept ;
    skos:definition "General term for clothing designed for or worn by young females."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girls' wear"@en .

aat:300411406 a skos:Concept ;
    skos:definition "Process in which organisms or specimens are submerged in an aqueous formaldehyde solution, stabilized with methanol, containing 37 per cent by weight of formaldehyde."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formalin preservation"@en .

aat:300411407 a skos:Concept ;
    skos:definition "Collections of drums or other percussion instruments, usually cymbals, arranged to be played by a single player."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drum kits"@en .

aat:300411408 a skos:Concept ;
    skos:definition "Ice skates for competitive speed skating designed with short boots having no ankle support attached to a long, straight blade with an essentially flat bottom. Made to be thin and light, the top part of these blades are often hollow. Speed skates may have asymmetric blade placement on the right or left boot, or have provisions for customized blade placement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speed skates"@en .

aat:300411410 a skos:Concept ;
    skos:definition "Tubes that are temporarily placed in the body to absorb bodily fluids, to administer drugs, or to enlarge passages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catheters"@en .

aat:300411411 a skos:Concept ;
    skos:definition "Broad-brimmed felt hats with strings on opposing sides bearing a formation of 15 tassels each. Red galeros are worn by cardinals in the Roman Catholic Church, while other colors may signify clergy of other ranks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galeros"@en .

aat:300411413 a skos:Concept ;
    skos:definition "Window having a long rectangular shape and comprising a two-light frame, with a shutered lower half topped by a glazed half."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kloosterkozijns"@en .

aat:300411414 a skos:Concept ;
    skos:definition "Window shutters that can be folded sideways with hinged articulations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding shutters"@en .

aat:300411415 a skos:Concept ;
    skos:definition "Locations where transportation vehicles, such as buses, trains, wagons, or the like, are stored or deposited; sometimes comprises a covered structure, but may be a yard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depots"@en .

aat:300411416 a skos:Concept ;
    skos:definition "Barrier posts, generally permanent and of a sturdy material such as stone, concrete, or metal, placed between the street and the pedestrian sidewalk, or at another place intended to prevent passage The posts are generally waist high or lower; and may be joined by chains or cords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavement posts"@en .

aat:300411417 a skos:Concept ;
    skos:definition "General term for clothing designed for or worn by young males."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boys' wear"@en .

aat:300411418 a skos:Concept ;
    skos:definition "Buildings housing facilities that provide electrical power to transportation systems. For buildings that gather or distribute electricity to businesses and homes, use \"power plant buildings (utilities buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrification buildings"@en .

aat:300411419 a skos:Concept ;
    skos:definition "Rooms or spaces on boats or in factories where machinery is housed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engine rooms"@en .

aat:300411420 a skos:Concept ;
    skos:definition "Protruding angles of bastions or other fortifications, where the faces (i.e. the angle sides directed towards the attacker) converge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salients"@en .

aat:300411421 a skos:Concept ;
    skos:definition "Rooms or buildings for worship: oratories, that are attached to places of residence for a community living under religious vows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monastery chapels"@en .

aat:300411422 a skos:Concept ;
    skos:definition "Refers to relatively small buildings or sheds housing the tools for firefighting. Fire hoses, buckets, and ladders may be stored in fire hose houses. Examples are historical structures that were part of a neighborhood system of firefighting in which responsibility was placed on the individual districts of a city. For more modern structures, housing fire engines and often quarters for firemen, use \"fire stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire hose houses"@en .

aat:300411423 a skos:Concept ;
    skos:definition "Forts having a polygonal shape, which varied according to the site and requirements. Although they existed by the middle ages, prime examples of polygonal forts were those constructed resist the fire of rifled artillery and heavy mortars in the late 18th through 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polygonal forts"@en .

aat:300411424 a skos:Concept ;
    skos:definition "Places outside urban areas, most particularly outside the walls of a city, where the bodies of executed criminals were put on display as a visible deterrent to crime or disobedience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallows fields"@en .

aat:300411425 a skos:Concept ;
    skos:definition "Areas, often sheltered, located beside a railway track at a station and raised to a level convenient for passengers and freight to be loaded on and off the train, tram, or other similar conveyance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railway platforms"@en .

aat:300411426 a skos:Concept ;
    skos:definition "Buildings housing businesses that deal in hose and frame-knitted or woven underclothing generally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosiery shops"@en .

aat:300411427 a skos:Concept ;
    skos:definition "Buildings where a provost, who is a high-ranking administrative officer in an ecclesiastical or academic institution, resides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provost's houses"@en .

aat:300411428 a skos:Concept ;
    skos:definition "Stiff silk yarn dyed in the gum state consisting of two or three threads united without preliminary twisting, and generally used to weave crepes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marabout silk"@en .

aat:300411429 a skos:Concept ;
    skos:definition "Devices that include the full display of armorial bearings of a family or clan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "family arms"@en .

aat:300411430 a skos:Concept ;
    skos:definition "Institutions in which a discipline of theatrical dance using precise and highly formalized set steps and techniques is taught."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballet schools"@en .

aat:300411431 a skos:Concept ;
    skos:definition "Lights placed so that they mark the limits of the shore. For buildings or other substantial structures housing lights on or near the shore or nautical hazards, prefer \"lighthouses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shore lights"@en .

aat:300411432 a skos:Concept ;
    skos:definition "Holes drilled into the earth as exploratory wells or more generally in the service of construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bore-holes"@en .

aat:300411433 a skos:Concept ;
    skos:definition "Covering masses like ramparts made of fascines and earth, raised to protect soldiers from the fire of the enemy. In more formal fortifications, this may refer to the corner angle of a bastion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epaulements"@en .

aat:300411434 a skos:Concept ;
    skos:definition "Artificial mounds used as a lower rampart, located in front of the main rampart of a fortification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faussebrayes"@en .

aat:300411435 a skos:Concept ;
    skos:definition "Preliminary zones located in direct connection to large bodies of water that feed into secondary channels, locks, or other service areas for watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outer ports"@en .

aat:300411436 a skos:Concept ;
    skos:definition "Vertical, often wooden, structures to help align water borne vessels as they approach a lock or a bridge. Guidewalls guide the vessel into the lock chamber or between the piers of the bridge. These also provide a place for the vessels to tie-off while awaiting entry to a lock chamber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guidewalls"@en .

aat:300411437 a skos:Concept ;
    skos:definition "Special type of roofing tile made with perforations to permit the passage of air and sometimes light. Ventilating tiles are typically set into a span of regular roof tiles; they usually have a raised, curving profile in which the ventilation holes are situated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ventilating tile"@en .

aat:300411438 a skos:Concept ;
    skos:definition "Benches located on the stoop of a residence or other building in an urban environment; usually of modest size and fixed in place. For benches, swings, chairs, and other furniture on the porch of a residence, use \"porch furniture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoop benches"@en .

aat:300411439 a skos:Concept ;
    skos:definition "Fortifications constructed with salient and re-entering angles for obtaining an oblique, as well as a direct fire, and to afford shelter from an enfilade fire of the enemy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indented batteries"@en .

aat:300411440 a skos:Concept ;
    skos:definition "Bars or counters in clubs, shops, or elsewhere where wine is kept or sold, usually a licensed establishment specializing in the serving of wine, often accompanied by food offerings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine bars"@en .

aat:300411441 a skos:Concept ;
    skos:definition "Natural dikes composed primarily of peat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peat dikes"@en .

aat:300411442 a skos:Concept ;
    skos:definition "Prints on paper from impressions of a reverse design created on a printing plate, usually copper, into which the design has been punched or struck directly with an engraving tool such as a smith's punch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punched engravings"@en .

aat:300411443 a skos:Concept ;
    skos:definition "Plaques bearing text or an image in relief, or both, in memory of one or more persons, an event, a former use of the place, or some other thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative plaques"@en .

aat:300411445 a skos:Concept ;
    skos:definition "Railroad signal towers that are of modest size and house-like in form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad signal houses"@en .

aat:300411446 a skos:Concept ;
    skos:definition "Halls for ingress at a destination or transportation hub for watercraft, trains, or aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrival terminals"@en .

aat:300411447 a skos:Concept ;
    skos:definition "Maintenance equipment designed for the use of firefighters to hang firehoses to dry and drain after use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hose towers"@en .

aat:300411448 a skos:Concept ;
    skos:definition "Almshouses built surrounding a courtyard. Unique to the Netherlands, these are intended as housing for the elderly, primarily single women, and are administered as charitable institutions originally financed as legacies by wealthy individuals, or founded by municipal authorities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hofjes"@en .

aat:300411449 a skos:Concept ;
    skos:definition "Buildings that may be adapted to many types of events such as concerts, meetings, or sporting events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multi-purpose halls"@en .

aat:300411450 a skos:Concept ;
    skos:definition "Intermediate stopping places along lightrail tram routes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tram stations"@en .

aat:300411451 a skos:Concept ;
    skos:definition "Structures for storing hay, with roofs that can be raised or lowered for protection from the elements. Some are set on skids to be moved wherever they are needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hay barracks"@en .

aat:300411452 a skos:Concept ;
    skos:definition "A regentenstuk (Dutch, literally \"regents piece\") is a type of group portrait that was popular in the Dutch Republic during the 17th and 18th centuries. These depicted the board of regents of a charitable organization or guild, depicted as an ensemble, most often meant to be publicly displayed in boardrooms or guildhalls. Early versions of these included iconography related to the function of organization represented, though later examples often lack these elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regents' portraits"@en .

aat:300411453 a skos:Concept ;
    skos:definition "Paintings that are applied directly to the ceiling of a chamber or hall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling paintings"@en .

aat:300411454 a skos:Concept ;
    skos:definition "Sluices for flooding low farm lands, for defense purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inundation sluices"@en .

aat:300411455 a skos:Concept ;
    skos:definition "Tower-like structures comprising scaffolding or having enclosed walls, used to support and house a hoisting apparatus in shaft mining and other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoist towers"@en .

aat:300411456 a skos:Concept ;
    skos:definition "Clocks that designate periods of time audibly by using a striking mechanism on a bell or gong. If the sounds are musical, prefer \"chiming clocks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking clocks"@en .

aat:300411457 a skos:Concept ;
    skos:definition "Refers to distinctive, rural fortified dwellings of relatively modest size; particularly, but not exclusively, those dating from the 13th century and later in northern Europe. These \"stone houses\" were typically owned by local minor lords or land holders; they were usually made of stone. Do not use this term to indicate common houses made of the material stone; instead, use material = \"stone (worked rock)\" plus work type = \"house.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone houses"@en .

aat:300411458 a skos:Concept ;
    skos:definition "Objects consisting of decorative fobs or objects fastened to a key ring with a chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key chains"@en .

aat:300411459 a skos:Concept ;
    skos:definition "Continuous, concatenated or otherwise related defenses, usually with obstacles such as inundations, trenches, ramparts, ditches, barbed wire, minefields or tank obstacles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lines"@en .

aat:300411460 a skos:Concept ;
    skos:definition "Series of defenses covered by flooding. This type of defense was practiced in the Netherlands with its many waterways and polders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inundation lines"@en .

aat:300411461 a skos:Concept ;
    skos:definition "Covers or shutters fitted in grooves to slide open and closed over a relatively small window or similar opening, such as on a ship or wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding hatches"@en .

aat:300411462 a skos:Concept ;
    skos:definition "A romanticized architectural style of the latter part of the 19th and early 20th century inspired by chalets in Switzerland. The style spread to other parts of Europe and North America. Unlike the Swiss buildings, which were always made of wood, chalet style buildings are often of brick or other construction, with wood detailing. Elements of the style include overhanging roofs, elaborately decorated carvings, decorative trusses, and wood shutters with cut-outs. Elements of the style are most often found in the construction of domestic single-family homes, but also mansions, hotel buildings, and other commercial structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swiss chalet style"@en .

aat:300411463 a skos:Concept ;
    skos:definition "Gables having a triangular form with a rectangular protrusion at the apex; so-named because the form resembles a cross-section of an inverted funnel or spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spout gables"@en .

aat:300411464 a skos:Concept ;
    skos:definition "Roofs that are circular in plan and that rise to terminate in a point, the whole forming a regular cone in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conical roofs"@en .

aat:300411465 a skos:Concept ;
    skos:definition "Stoves designed and used primarily for cooking and baking, rather than only for heating a space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cook stoves"@en .

aat:300411466 a skos:Concept ;
    skos:definition "Dams oriented in the direction of the flow of a river, as protection for hollow river banks or of bridge piers, or for limiting the river's normal width."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "off-bankline revetments"@en .

aat:300411467 a skos:Concept ;
    skos:definition "Flat-bottomed boats with a straight falling stern and a short forecastle. These are known to be used as fishing vessels on the Schelde River from the thirteenth to the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eemers"@en .

aat:300411468 a skos:Concept ;
    skos:definition "Rooms that are a few steps higher than the front of the house or from the other rooms on the same floor. The original form is typically Dutch, seen in the Netherlands, Belgium, and in locations where the Dutch colonized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opkamers"@en .

aat:300411469 a skos:Concept ;
    skos:definition "Decorative vases or urns used to decorate gardens. These are created in a variety of materials including marble, ceramics, stone, or iron, and may exhibit applied decoration including handles, leaf motifs, or masks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden vases"@en .

aat:300411471 a skos:Concept ;
    skos:definition "Small portable stoves designed to contain hot coals and used to warm the feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot stoves"@en .

aat:300411472 a skos:Concept ;
    skos:definition "A ball sport invented in Holland ca.1901 with similarities to netball and basketball. Intended as a mixed-gender sport, two teams of 8 members must field four female and four male players. The objective is to throw a ball through a bottomless basket that is mounted on a 3.5 m (11.5 feet) high pole. Players are allowed to run only when they are not in possession of the ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "korfball"@en .

aat:300411474 a skos:Concept ;
    skos:definition "Photographs created specifically to promote products or services to the public. These are often commissioned or produced by advertising agencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising photographs"@en .

aat:300411475 a skos:Concept ;
    skos:definition "Signaling apparatuses consisting of an upright post with one or more arms that can be moved in a vertical plane, different positions of the arm or arms representing different letters or messages. Semaphores were often placed on towers in lines across the landscape, sending messages for distances prior to the invention of the telegraph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semaphores"@en .

aat:300411477 a skos:Concept ;
    skos:definition "Low dikes around polders, which are areas of low-lying land reclaimed from the sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polder dikes"@en .

aat:300411478 a skos:Concept ;
    skos:definition "Parts of bastions that connect the curtain to the face and that are in defense of the opposite face, and the passage of the ditch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flanks"@en .

aat:300411479 a skos:Concept ;
    skos:definition "Tower constructions that operate a vertical-lift bridge over a water passage, equipped with counterweights to lift the bridge, deck or gate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lift bridge towers"@en .

aat:300411480 a skos:Concept ;
    skos:definition "Narrow strips of land planted with perennials, typically included in a formal garden to provide color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbaceous borders"@en .

aat:300411481 a skos:Concept ;
    skos:definition "Distinctive bridge-like structures placed in a dike system, with openings or passages that may be opened and closed to regulate the flow of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorlaatbrugs"@en .

aat:300411482 a skos:Concept ;
    skos:definition "Subsidiary chapels opening off the nave or side aisles of basilican churches. For chapels opening off the apse, prefer \"apse chapels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side chapels"@en .

aat:300411483 a skos:Concept ;
    skos:definition "Smaller doors within larger doors or gates, designed to allow passage without opening the larger door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wicket doors"@en .

aat:300411484 a skos:Concept ;
    skos:definition "Mills designed to grind trass, a kind of rock which when ground is used for making mortar or hydraulic cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trass mills"@en .

aat:300411485 a skos:Concept ;
    skos:definition "Openings, breaches, or excavations through walls or ramparts, used as gates, passages, or flood barriers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupures"@en .

aat:300411486 a skos:Concept ;
    skos:definition "Rooms or offices where medical and paramedical professions, particularly those of general practitioners, are practiced, patients examined, and treatment prescribed. Originally, these may have been in private houses, now most often they are offices in urban districts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surgeries"@en .

aat:300411487 a skos:Concept ;
    skos:definition "Part of the outworks of a fortress, built in front of the glacis, consisting of two converging faces forming a salient angle, forming an arrowhead shape.Similar to a redan, but with faces forming an acute angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flèches"@en .

aat:300411488 a skos:Concept ;
    skos:definition "Open, bounded areas adjacent to coops or hen houses designated for the exercise and feeding of hens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicken runs"@en .

aat:300411489 a skos:Concept ;
    skos:definition "A continuous ribbon or band of loose, untwisted fiber that is used to spin yarn. A sliver is created by carding or combing fiber and drawing it into parallel strips that are then ready for drawing, roving, or slubbing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliver"@en .

aat:300411491 a skos:Concept ;
    skos:definition "Distinctive fortified towers associated with civic buildings in northern Europe. Examples are towers at town halls or market halls, often housing bells and a clock, in Belgium and northern France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belforts"@en .

aat:300411492 a skos:Concept ;
    skos:definition "The gaper or \"yawner\" is a typically Dutch shop sign in the form of a head carved in wood or stone. The head is almost always a sylized depiction of a Moorish man with his mouth open to receive medicine. These were displayed to indicate the location of a pharmacy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gapers"@en .

aat:300411493 a skos:Concept ;
    skos:definition "Cylindrical outdoor sidewalk structures used as supports for printed advertising for theatrical and other entertainments. The invention is attributed to Gabriel Morris ca. 1868 in the city of Paris, though earlier advertising pillars were erected in Berlin in the 1850s, created by printer Ernst Litfass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morris columns"@en .

aat:300411494 a skos:Concept ;
    skos:definition "Windmills in which the cap and sails are rotated to accommodate wind direction. For windmills that rotate the entire body of the structure, use \"post mills.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap winders"@en .

aat:300411495 a skos:Concept ;
    skos:definition "Small defensive fortifications used as a gun emplacement or observation point; used in battle situations and routinely to command control of a site. Examples are pillboxes made of concrete that were used in battlefield defensive systems during World War I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillboxes"@en .

aat:300411496 a skos:Concept ;
    skos:definition "Scaffolds, frames, or open sheds in which restive horses or donkeys are secured while being shod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traves"@en .

aat:300411498 a skos:Concept ;
    skos:definition "Poles, masts, or structures mounted with one or more electric lamps of high wattage. Generally permanently fixed for use in stadiums, light towers also exist as mobile units used in the construction industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light towers"@en .

aat:300411499 a skos:Concept ;
    skos:definition "Entrance spaces of historic Dutch houses or farms that provide a transition from the exterior to the interior of a house. Most span the entire front width of a house, and serve as both a reception point and connection between the street, entry, stairs, and private inner rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voorhuises"@en .

aat:300411500 a skos:Concept ;
    skos:definition "Gables having a triangular profile that is broken, usually at only one point on each side, with a step-shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder gables"@en .

aat:300411501 a skos:Concept ;
    skos:definition "Poles or posts made of various materials used to indicate an obstruction or to regulate traffic, usually mounted on median strips or refuge islands of a roadway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic bollards"@en .

aat:300411503 a skos:Concept ;
    skos:definition "Complexes or plots of land where bees are raised in apiaries and where their products collected for livelihood or commerce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bee farms"@en .

aat:300411504 a skos:Concept ;
    skos:definition "Massive and squat semi-circular towers in fortifications, precursors of \"bastions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roundels"@en .

aat:300411505 a skos:Concept ;
    skos:definition "Systems of bars laid at road level designed to prevent cattle and game from entering or leaving a designated area, while allowing the passage of other traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle guards"@en .

aat:300411506 a skos:Concept ;
    skos:definition "Railway yards that employ lead tracks on small rises over which an engine pushes single cars, or blocks of coupled cars, where they roll by gravity onto destination tracks where the cars are sorted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hump yards"@en .

aat:300411507 a skos:Concept ;
    skos:definition "Societies for rhetoric, poetry and stagecraft organised as guilds in the Netherlands from the 15th century, and that were connected to civic leadership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chambers of retoric"@en .

aat:300411508 a skos:Concept ;
    skos:definition "Secondary trenches in the bottom of a moat or ditch, serving as a drain, and as an extra obstacle to possible attackers or to keep the ditch ice-free."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cunettes"@en .

aat:300411509 a skos:Concept ;
    skos:definition "Freestanding exterior walls, generally of brick, having buttresses joined by curved walls, forming a scallop-shaped footprint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garland walls"@en .

aat:300411511 a skos:Concept ;
    skos:definition "Nautical equipment used to change the direction of a rope, clew, or halyard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leading blocks"@en .

aat:300411512 a skos:Concept ;
    skos:definition "Walls, usually of concrete, built as fortifications specifically to prevent the progress of armored combat vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anti-tank walls"@en .

aat:300411513 a skos:Concept ;
    skos:definition "Geometrically planted, pruned, low-growing boxwood shrubs sometimes on a base of colored earth, rubble, shells or lawn, interspersed with space for other garden elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parterres de broderie"@en .

aat:300411514 a skos:Concept ;
    skos:definition "Circular expansions at the corners of bastions, used to cover artillery deployed on the flank of the bastion from enemy fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orillons"@en .

aat:300411515 a skos:Concept ;
    skos:definition "Memorials mounted to a wall or pillar of a church consisting of a framed stone or wooden slab bearing an epitaph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grafbords"@en .

aat:300411516 a skos:Concept ;
    skos:definition "Objects that are used for breeding, caring for, and study of animals kept on a farm for use or profit, especially cattle, sheep, and pigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livestock equipment"@en .

aat:300411517 a skos:Concept ;
    skos:definition "Tower-like structures placed atop dams or fortification walls to block passage across the wall or dam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monks"@en .

aat:300411519 a skos:Concept ;
    skos:definition "Triangular outworks situated in the moats of fortifications, and that resemble bastions with a crescent-shaped gorge, constructed to protect a bastion or curtain. The term is often used interchangeably with 'ravelins'. Historically there may have been distinguishing characteristics between ravelins and demi-lunes in the Italian school of fortification design, but in the modern era these terms are most often used synonymously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demi-lunes"@en .

aat:300411520 a skos:Concept ;
    skos:definition "Open areas, often in a larger compound reserved for woodworkers, historically often sited near other trade- or craftsmen such as blacksmiths' shops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpenters' yards"@en .

aat:300411521 a skos:Concept ;
    skos:definition "Batteries flanking a part of a fortification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flank batteries"@en .

aat:300411522 a skos:Concept ;
    skos:definition "Rustic buildings built as follies, usually as part of an estate, from rough materials, intended to appear as the habitations of hermits. These are rarely intended to be permanent dwelling and are distinguished from the habitations of true hermits, ascetics, or recluses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hermitages"@en .

aat:300411523 a skos:Concept ;
    skos:definition "Buildings occupied by the office of a chancellor and where charters and other documents are prepared or issued."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chancelleries"@en .

aat:300411524 a skos:Concept ;
    skos:definition "Dams built into walls across the ditches of a fortification, with a sluice gate than can regulate the height of water in the ditch at will."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batardeaus"@en .

aat:300411525 a skos:Concept ;
    skos:definition "Chambers in outer fortification elements with openings for the firing of artillery. These are designed to be difficult to see and hard to strike from the forecourt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traditor casemates"@en .

aat:300411527 a skos:Concept ;
    skos:definition "Historical term for tribunals in the Netherlands that were in use from the Middle Ages until the Ancien Régime, and that administered grievances before lawmaking and a judiciary were formalized into separate entities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vierschaars"@en .

aat:300411528 a skos:Concept ;
    skos:definition "Marital coats of arms that unite those of the husband with that of his wife under the husband's crest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alliance coats of arms"@en .

aat:300411529 a skos:Concept ;
    skos:definition "Plaster or stone tablets set into the outer walls of buildings and carved with images depicting the profession of inhabitants or text to identify the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gable stones"@en .

aat:300411530 a skos:Concept ;
    skos:definition "Facilities intended as places to recover from illness or to promote healthful living in general. These are often, but not exclusively, located in natural landscapes outside the precints of cities. The residents of these colonies may be considered patients or active participants in a community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health colonies"@en .

aat:300411531 a skos:Concept ;
    skos:definition "The moats surrounding the main ramparts of fortifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "main moats"@en .

aat:300411532 a skos:Concept ;
    skos:definition "In a fortification, ditches or moats located between the ravelins and the counterscarps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ravelin ditches"@en .

aat:300411534 a skos:Concept ;
    skos:definition "Broad, flat-bottomed boats with bulging sides, used for coasting and fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing pinks"@en .

aat:300411535 a skos:Concept ;
    skos:definition "Small ice sleds that accommodate one seated person, and that are propelled with hand-held iron-tipped prods or poles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prikslees"@en .

aat:300411536 a skos:Concept ;
    skos:definition "Young people attending elementary school or of an age to attend elementary school, typically including those from age 5 to 13."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schoolchildren"@en .

aat:300411537 a skos:Concept ;
    skos:definition "Traps or fykes of varied construction; typically provided with conical funnels leading to a chamber in which eels are trapped and retrieved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eel traps"@en .

aat:300411538 a skos:Concept ;
    skos:definition "A hardwood of the species Quercus ilex, or holm oak, an evergreen tree native to the Mediterranean Basin. The trees are often managed as coppice forest, mainly for the production of firewood. Holm oak wood is of light to medium brown color and has a fairly coarse grain. Due to its density and rot resistance it has been used in boatbuilding. The wood is harder and tougher than that of the English oak and the sessile oak, and has a distinctive odor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holm oak"@en .

aat:300411539 a skos:Concept ;
    skos:definition "Clocks that are powered by electricity, or that are synchronized with a mother clock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric clocks"@en .

aat:300411540 a skos:Concept ;
    skos:definition "Hammers used by farriers to shoe horses. Most often these feature compact solid metal heads with a flattened face on one end of the head for driving nails, and curved forked tines on the other end for pulling out nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoeing hammers"@en .

aat:300411542 a skos:Concept ;
    skos:definition "Pearly excrescence of irregular shape found on the shell of a pearl oyster; may have one flattened side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blister pearl"@en .

aat:300411543 a skos:Concept ;
    skos:definition "Paper made without the use of industrial machinery. Paper of this type is often provided with a watermark and frequently exhibits a rough or deckled edge as a by-product of its manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handmade paper"@en .

aat:300411544 a skos:Concept ;
    skos:definition "Cases attached to belts or harnesses that support the poles of flags or banners while being carried in procession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flag-holsters"@en .

aat:300411545 a skos:Concept ;
    skos:definition "Boletes with red tubes and pores, a red-dotted yellow stem and blue staining flesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neoboletus luridiformis"@en .

aat:300411546 a skos:Concept ;
    skos:definition "Type of ferry known in the Netherlands, operating on rails at the bottom of a canal or other shallow body of water. Comprises a platform on wheels elevated above the water level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veerwagens"@en .

aat:300411548 a skos:Concept ;
    skos:definition "Metal grills, gratings, fences, and other similar works used in architectural contexts; often ornamental and usually functional."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural metalwork"@en .

aat:300411549 a skos:Concept ;
    skos:definition "Those whose profession is that of the extraction of the essence, or essential oil of any substance by the evaporation and condensation of its liquid solution, most commonly to obtain alcoholic spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distillers"@en .

aat:300411550 a skos:Concept ;
    skos:definition "Dutch clinker-built watercraft with a well and an open hold. Its rigging consisted of a mainsail and a jib."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beyerlandse boots"@en .

aat:300411551 a skos:Concept ;
    skos:definition "Those licensed and appointed to steer ships while arriving or departing a port, or through local waters until those ships reach their destination or open sea. The license issued to maritime pilots is specific to particular areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maritime pilots"@en .

aat:300411552 a skos:Concept ;
    skos:definition "The action of using a pole to propel a waterborne vessel by pushing against the bottom of a waterway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poling"@en .

aat:300411553 a skos:Concept ;
    skos:definition "Inland waterway vessels, typically flat bottomed and designed to carry cargo; generally towed by animals or people for certain parts of the journey, although modern versions may be fitted with motors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canal barges"@en .

aat:300411554 a skos:Concept ;
    skos:definition "Ship-board official bodies empowered to punish minor infringements or more serious cases of naval law, and to make important decisions regarding the ship's activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship's councils"@en .

aat:300411555 a skos:Concept ;
    skos:definition "The action of heaving down a ship to one side with tackles, pulling up the keel from under the water, usually for cleaning, caulking, or repairing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "careening"@en .

aat:300411557 a skos:Concept ;
    skos:definition "To abuse or use wrongly someone or something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mistreating"@en .

aat:300411558 a skos:Concept ;
    skos:definition "Areas in the sea where oysters are cultivated for human consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster farms"@en .

aat:300411559 a skos:Concept ;
    skos:definition "Gemstone, comprising the skeletons of corals, typically those having red color and found in the Red Sea and Mediterranean, such as Corallium rubrum; prized from times of antiquity for ornamental purposes, and often classed among precious stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red coral"@en .

aat:300411560 a skos:Concept ;
    skos:definition "Paper made from chemical wood pulp, which is pulp in which lignin has been removed from the wood, making the cellulose less likely to yellow and embrittle with aging. For paper that contains no free acids, use \"acid-free paper.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood-free paper"@en .

aat:300411561 a skos:Concept ;
    skos:definition "Refers to very thin hammered or rolled copper sheets (typically about 0.1 micrometers) used for decoration or finishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper leaf"@en .

aat:300411562 a skos:Concept ;
    skos:definition "Interior wall decorations created from specially tooled, varnished, and colored panels of gilt leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilt leather hangings"@en .

aat:300411563 a skos:Concept ;
    skos:definition "Stucco ceilings consist of a layer of plaster or other mortar arranged on a ceiling or vault as a decorative whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stucco ceilings"@en .

aat:300411564 a skos:Concept ;
    skos:definition "Windmills with fixed caps that are placed on a central vertically oriented pole axis and can be revolved in their entirety to face the prevailing winds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post mills"@en .

aat:300411565 a skos:Concept ;
    skos:definition "Windmills in which the caps are turned by a winch inside the cap itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inside winders"@en .

aat:300411566 a skos:Concept ;
    skos:definition "Post mills having a shorter central post, and developed specifically as sawmills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paltroks"@en .

aat:300411567 a skos:Concept ;
    skos:definition "Windmills having the form of a masonry tower, atop which are positioned a rotating cap and the sails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower mills"@en .

aat:300411568 a skos:Concept ;
    skos:definition "Windmills, often tower mills or smock mills in form, distinguished by having an exterior platform or gallery wrapped around the circumference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallery mills"@en .

aat:300411569 a skos:Concept ;
    skos:definition "Water mills that function by water flowing into buckets on a wheel from the top, causing it to rotate in the same direction as the water flows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overshot mills"@en .

aat:300411570 a skos:Concept ;
    skos:definition "Teaspoon-like utensils with rounded scoops at one or both ends of a handle. These are used for scooping the pulp out of melons, potatoes, or other fruits and vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melon ballers"@en .

aat:300411571 a skos:Concept ;
    skos:definition "Racks used to dry objects on, especially washed kitchenware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dish racks"@en .

aat:300411572 a skos:Concept ;
    skos:definition "Instruments used to determine the amount of albumin or soluble protein in liquids, especially urine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albuminometers"@en .

aat:300411573 a skos:Concept ;
    skos:definition "Cables that extend from watercraft to devices designed to bury themselves in the beds of waterways in order to restrict movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor cables"@en .

aat:300411574 a skos:Concept ;
    skos:definition "Scissor-like clamps with tapered ends that are often curved. These are used during surgery to temporarily close off blood vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artery clamps"@en .

aat:300411575 a skos:Concept ;
    skos:definition "Small shovels of varied design used to shovel ash from domestic hearths, fireplaces, or coal stoves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ash shovels"@en .

aat:300411576 a skos:Concept ;
    skos:definition "Cathers provided with a small balloon to enlarge passages or openings as in a blood vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon catheters"@en .

aat:300411577 a skos:Concept ;
    skos:definition "Small triangular flags in paper or fabric, illustrated with a saint, the church or chapel where the saint is venerated, and occasionally scenes from the life of the saint, or events occurring at the church or chapel. These were typically sold as souvenirs of the pilgrimage itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrimage pennants"@en .

aat:300411578 a skos:Concept ;
    skos:definition "Wooden boxes with slots where cutlery of various sizes is stored. These often bore decoration, and the more elaborate examples may exhibit exterior carving, marquetry, or inlays, and interiors lined with silk or velvet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutlery boxes"@en .

aat:300411579 a skos:Concept ;
    skos:definition "Instruments designed to measure the force of the pulse; used to measure blood pressure. These consist of an inflatable rubber cuff, which is wrapped around the upper arm and is connected to an apparatus that records pressure, usually in terms of the height of a column of mercury or on a dial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sphygmomanometers"@en .

aat:300411580 a skos:Concept ;
    skos:definition "Tools used by shoe makers to add lustre to leather. These consist of relatively large beak-shaped, iron heads attached to a wooden heft. The head, which is hot and is covered in wax or another polishing material, is rubbed over the surface of the leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazing irons"@en .

aat:300411581 a skos:Concept ;
    skos:definition "Books for the visually impaired that are printed using a system of embossed printing, perfected by Braille in 1834."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Braille books"@en .

aat:300411582 a skos:Concept ;
    skos:definition "Belts that are intended to be worn through loops sewn to a pair of trousers to secure them to the waist of the wearer. These may be made from a variety of materials, and usually are secured with an adjustable buckle or some other fastener."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trouser belts"@en .

aat:300411583 a skos:Concept ;
    skos:definition "Machines used for sifting, especially flour. These consist of revolving sieves or spinning cloth screens, which are housed in enclosures. The screens have varied mesh sizes, from fine to coarse. The flour enters the bolter at the end with the finest screen, where the lightest part of the flour is separated out. Gravity carries the remaining flour, separating out the finer endosperm from the germ and bran of the wheat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolters"@en .

aat:300411584 a skos:Concept ;
    skos:definition "Gas burners used in laboratory work in which gas and air can be combined variably to control the heat output. These are named for Robert Bunsen, a German chemist who developed it ca. 1855, in partnership with Peter Desdega."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bunsen burners"@en .

aat:300411585 a skos:Concept ;
    skos:definition "Hollow tubes that are inserted into the body for the purpose of examination, taking fluid samples, to administer medicine or to influence the function of an organ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cannulas"@en .

aat:300411586 a skos:Concept ;
    skos:definition "Bottles of a distinctive shape, used to hold champagne or other sparkling wines. These have deep punts that prevent the bottle from shattering during the second fermentation of the contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "champagne bottles"@en .

aat:300411587 a skos:Concept ;
    skos:definition "Devices of varied design used to compress cork stoppers and insert them into the necks of bottles. These normally also vacuum the air from the bottle as the cork is inserted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corking machines"@en .

aat:300411588 a skos:Concept ;
    skos:definition "Spoons intended to commemorate the birth of a child, typically given as gifts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth spoons"@en .

aat:300411589 a skos:Concept ;
    skos:definition "Tools comprising metal blades mounted on handles, used to scrape bark from trees or logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barking axes"@en .

aat:300411590 a skos:Concept ;
    skos:definition "Shoemakers' knives used to even the heel of a clog on the inside. It consists of a long, double-edged blade curved upwards at the end and a straight wooden handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heel knives"@en .

aat:300411592 a skos:Concept ;
    skos:definition "A shuffleboard game consisting of a portable or fixed board or table on which disks are propelled to the far end to pass through slots, or come to rest on scoring areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sjoelen"@en .

aat:300411593 a skos:Concept ;
    skos:definition "Saints chosen or regarded as a protector of or intercessor for a person, place, occupation, etc., which normally carry the name of the saint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patron saints"@en .

aat:300411594 a skos:Concept ;
    skos:definition "The action of tightly wrapping a newborn child in cloth bands or other swaddling clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swaddling"@en .

aat:300411595 a skos:Concept ;
    skos:definition "Members of a profession that emerged during the Middle Ages when the practice of surgery was not taught in universities. Barbers were called in by physicians in cases where razors or blood letting was deemed necessary. The organization of the United Company of Barber Surgeons of London in 1540 began the evolution toward qualifications for those who performed operations. This guild was the precursor of the Royal College of Surgeons of England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barber surgeons"@en .

aat:300411596 a skos:Concept ;
    skos:definition "Open boxes or troughs in stables, barns, stalls or pens, that contain hay, grass or other fodder for farm animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mangers"@en .

aat:300411597 a skos:Concept ;
    skos:definition "A monochrome painting technique that employs two or three values of a single color to create an image that varies from very light to very dark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camaieu"@en .

aat:300411598 a skos:Concept ;
    skos:definition "Having the shape or consisting of three round projecting parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trilobate"@en .

aat:300411600 a skos:Concept ;
    skos:definition "Posts that delimit the borders of general areas, zones, or regions including properties, municipalities, or provinces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boundary posts"@en .

aat:300411601 a skos:Concept ;
    skos:definition "Elaborate needle-knotted lace, often with three-dimensional flower motifs used as edging on garments and textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oya"@en .

aat:300411603 a skos:Concept ;
    skos:definition "Enclosures composed of vertical posts and horizontal connecting members used to enclose all or part of a garden space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden fences"@en .

aat:300411605 a skos:Concept ;
    skos:definition "Suits, generally intended for men, worn on formal occasions and at ceremonial events. Contemporary versions consist of a tuxedo-like suit with a tail coat, a starched shirt and collar, a white vest, white bow tie and black trousers with single or double stripe of satin running the length of the leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tailsuits"@en .

aat:300411606 a skos:Concept ;
    skos:definition "Tapered wooden pins or pegs that are fixed through both components of a mortise and tenon joint to lock and tighten the join."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortise pins"@en .

aat:300411607 a skos:Concept ;
    skos:definition "Images painted as glazed and fired ceramic tiles that when assembled create a unified depiction of a scene, figures, or panels of unified decorative motifs. These may be fixed to walls or be intended as moveable works, sometimes framed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile tableaux"@en .

aat:300411609 a skos:Concept ;
    skos:definition "Hats made of plaited or woven straw and having a wide brim to protect the wearer from the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straw hats"@en .

aat:300411610 a skos:Concept ;
    skos:definition "Fabric of wool or wool blend with one glossy side, originating in Flanders, ca. 18th century. Calamanco traditionally is woven with a checker in the warp so that it is seen on the glossy side only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calamanco"@en .

aat:300411611 a skos:Concept ;
    skos:definition "Peat excavated by dredging, this is often a mixture of different types of peat, and has a higher efficiency than dry cut peat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dredge peat"@en .

aat:300411612 a skos:Concept ;
    skos:definition "Waterproof floor covering material composed of layers of bitumen-impregnated felt cardboard, and provided with a printed decorative wear-resistant top layer. Sold in rolls, balatum had its greatest popularity in the middle of the 20th century as an alternative to true linoleum, as it was inexpensive and easy to apply. It was eventually replaced by vinyl products. Originally a brand name, it was manufactured beginning in 1924 at the Papeteries de Genval. The term often appears uncapitalized as a common noun to refer to any linoleum-like floor covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balatum"@en .

aat:300411613 a skos:Concept ;
    skos:definition "Conventionalized representations or motifs of staffs with a snake twined around them that are used as symbols of medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staffs of Asclepius"@en .

aat:300411614 a skos:Concept ;
    skos:definition "Interaction, communication, artifacts, and customs related to written texts. This includes reading, but also buying, lending, giving and owning books (both read or unread), the attitude of individuals, groups and society as a whole towards the reading of books, literacy, acquiring reading, reading behavior, reading habits, reading clubs, library patronage and other aspects. Reading culture is researched with the help of egodocuments such as diaries, literary criticism, research on traces of reading such as marginalia and underscorings, and iconographic analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading culture"@en .

aat:300411615 a skos:Concept ;
    skos:definition "The right or condition of permanent and absolute tenure of land or property with freedom to dispose of it at will; examples include freehold in fee simple, fee-tail, or for term of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freehold"@en .

aat:300411616 a skos:Concept ;
    skos:definition "The right or condition of vsible power or control over real or other property, defined by the intention to use or to hold it against others, typically as distinct from, or at least not synonymous with, lawful ownership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "possession"@en .

aat:300411617 a skos:Concept ;
    skos:definition "The right to own a particular property, where that ownership is regularly evidenced and capable of recognition and enforcement in a court of law. The law typically considers the legal title as resting in the last party to whom it was transmitted by descent or by purchase through a regularly connected chain of transmission from the original source of title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal title"@en .

aat:300411618 a skos:Concept ;
    skos:definition "The right to obtain full ownership of a real or other property, contrasted with or used in conjunction with legal title. Equitable title may exist without legal title, often having judged to have unwritten ownership interest or right of use which exists despite another party having legal title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equitable title"@en .

aat:300411619 a skos:Concept ;
    skos:definition "Non-standardized term used for black pigments with a bluish cast, particularly in the 17th and 18th centuries; many pigments were called \"blue black,\" including ivory black, bone black, vine black, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue black"@en .

aat:300411620 a skos:Concept ;
    skos:definition "Non-standardized name for various organic black pigments, including vine black, cork black, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish black"@en .

aat:300411621 a skos:Concept ;
    skos:definition "Non-standardized name for various organic black pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German black"@en .

aat:300411624 a skos:Concept ;
    skos:definition "General name for numerous prepared foods traditionally based on maize, known in Spain and many Latin American cultures. Some varieties of mazamorra are today not made with maize."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mazamorra"@en .

aat:300411625 a skos:Concept ;
    skos:definition "Cloaks or long coats of a distinctive type worn by soldiers or horsemen in the 16th-17th centuries; examples are coats worn by musketeers and gardes du corps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassocks"@en .

aat:300411626 a skos:Concept ;
    skos:definition "Suit coats designed to be worn in the morning, patricularly a cutaway coat with long tails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morning coats"@en .

aat:300411627 a skos:Concept ;
    skos:definition "Style of men's suit consisting of either a matching ensemble composed of a single-breasted cutaway coat, vest and trousers, or a black single-breasted cutaway coat paired with striped trousers and a complementary vest. Morning suits were originally adopted by men in the early-19th century for wear during the morning hours when they would go riding. It gained popularity near the end of the century for morning and daytime business activities in addition to riding, supplanting the frock coat. Edward VII (1842-1910) popularized the acceptability of the morning suit for daytime formal occasions, which it has maintained to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morning suits"@en .

aat:300411628 a skos:Concept ;
    skos:definition "Men's coats designed to be worn for shooting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shooting coats"@en .

aat:300411630 a skos:Concept ;
    skos:definition "General term for stationary or portable devices of many designs, intended for female urination; when in public places, may be concealed behind a screen or door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urinettes"@en .

aat:300411631 a skos:Concept ;
    skos:definition "Urinals designed to accommodate the male anatomy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "male urinals"@en .

aat:300411632 a skos:Concept ;
    skos:definition "Small decorative cases for carrying visiting cards, which were small cards bearing the name, and sometimes the address of a person or married couple for presentation; prime examples date from 19th-century western nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visiting card cases"@en .

aat:300411633 a skos:Concept ;
    skos:definition "Family of flowering plants. Recently is universally recognized by classifications, including APG II system, which places it in the order Ranunculales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lardizabalaceae"@en .

aat:300411634 a skos:Concept ;
    skos:definition "Genus having one extant species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boquila"@en .

aat:300411635 a skos:Concept ;
    skos:definition "Species of plant native to temperate forests of central and southern Chile and Argentina; known for leaves that can mimic leaves of various other nearby species of plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boquila trifoliolata"@en .

aat:300411636 a skos:Concept ;
    skos:definition "Two-sided shape that is convex on both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biconvex"@en .

aat:300411637 a skos:Concept ;
    skos:definition "A fermented liquor made from maize and other plants by the indigenous peoples of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicha"@en .

aat:300411639 a skos:Concept ;
    skos:definition "General term for businesses and people having occupations related to health and medicine. In a given region or community, the term may be by law reserved for a doctor of medicine or osteopathy, podiatrist, dentist, chiropractor, clinical psychologist, optometrist, nurse practitioner, nurse-midwife, clinical social worker who is authorized to practice medicine, or other defined specialists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health care providers"@en .

aat:300411640 a skos:Concept ;
    skos:definition "Genre including physical objects that are that are meant to be perceived primarily through the sense of sight, are of high quality, requiring refined skill in creation, and typically using the media of painting, drawing, or sculpture. It may also refer to architecture and design. Although there is overlap, fine art is generally distinguished from other art forms based on the media, extent of skill, and the level of formal training required. It is distinct from \"decorative art\" in that the fine arts are art in which the aesthetic or intellectual expression is more prominent than the utilitarian purpose. It is distinct from \"crafts,\" which are handiworks of media such as ceramics, glass, needlework, or any medium other than painting, drawing, sculpture, or architecture. It is also distinct from \"commercial art,\" which is created to serve commerce such as in advertisements or illustration. Avoid using \"fine art\" in a broader sense, to include the arts of poetry, music, and filmmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine art"@en .

aat:300411641 a skos:Concept ;
    skos:definition "Genre including works that are primarily utilitarian in form or function, but that have aesthetic value provided by the design, decoration, or embellishment. They may include ceramics, furniture, textiles, glass, leather, metalwork, arms and armor, clocks, and jewelry, and other household or utilitarian objects. They are distinct from \"fine arts,\" which were traditionally considered to require more extensive training and were restricted to the media of painting, sculpture, drawing, and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative art"@en .

aat:300411642 a skos:Concept ;
    skos:definition "Genre including physical objects that are meant to be perceived primarily through the sense of sight, were created by the use of skill and imagination, and possess an aesthetic that is valued and of a quality and type that would be collected by art museums or private collectors, including drawings, painting, sculpture, architecture, and decorative arts. Performance art is considered a visual art, but the performing arts and literature are not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual art"@en .

aat:300411643 a skos:Concept ;
    skos:definition "Individuals, known in several cultures, who perform the ritual duties of a priest as well as accompanying troops or taking part in war. Examples are in the Aztec culture, where warrior priests carried sacred idols and conducted human sacrifices on the battlefield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warrior priests"@en .

aat:300411644 a skos:Concept ;
    skos:definition "Large circular discs or trumpet-like objects that are placed in or on the ear. Examples are Precolumbian works that may be part of or a type of earspool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earflares"@en .

aat:300411645 a skos:Concept ;
    skos:definition "Precolumbian works comprising textile panels to which feathers are stitched. The panels typically have a woven heading tape, and most also include braided cords that hang from the narrow sides. Although the cords suggest that these works were meant to be secured to a structure, their function is not agreed upon by scholars. Examples of feather panels are blue and yellow Wari works made from macaws' dorsal and ventral side feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather panels"@en .

aat:300411646 a skos:Concept ;
    skos:definition "The process of making works primarily of feathers; usually feathers are either adhered to a solid support or tied individually to a woven support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "featherworking"@en .

aat:300411647 a skos:Concept ;
    skos:definition "Material made from the hair of camelids, especially South American camelids such as llama and alpaca. For fiber made from camels, use \"camel hair.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camelid hair"@en .

aat:300411648 a skos:Concept ;
    skos:definition "Plaques designed to be worn on a belt or as part of belt assemblage; may be decorative and functional. Examples are found in many cultures, including Chinese cultures and Precolumbian cultures, such as used for Maya rulers. Usage sometimes overlaps with \"belt plates,\" although items made of stone are typically called \"belt plaques\"; for items dated to the 18th-century and later, usually metal, worn on belts to signify military rank or affiliation, always use \"belt plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt plaques"@en .

aat:300411649 a skos:Concept ;
    skos:definition "General term for ornaments of various types worn at or on a belt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt ornaments"@en .

aat:300411650 a skos:Concept ;
    skos:definition "Ledger-style documents that record tribute given by individuals or communities to a ruler, religious institution, government, or other entity. Examples are found in many ancient cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribute records"@en .

aat:300411651 a skos:Concept ;
    skos:definition "General term for all personal equipment, tools, and accessories having to do with individual use of tobacco or smoking herbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco accessories"@en .

aat:300411652 a skos:Concept ;
    skos:definition "Material comprising the leaves, stalks, or other plant parts used for smoking, generally exculding tobacco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoking herbs"@en .

aat:300411653 a skos:Concept ;
    skos:definition "Poems and linguistic experiments in sound symbolism and language invented by Russian Futurist poets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zaum poetry"@en .

aat:300411654 a skos:Concept ;
    skos:definition "Finished models that are intended to visualize, sell, or exhibit an architectural design or built work to a client, the public, or another audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation models"@en .

aat:300411655 a skos:Concept ;
    skos:definition "Models that illustrate the construction process or construction phases of a built work or ship; an example would be a model illustrating support systems that will be hidden by walls and roofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction models"@en .

aat:300411656 a skos:Concept ;
    skos:definition "Models that illustrate a design of a built work, ship, or other object in section, as if the work were cut transversely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectional models"@en .

aat:300411657 a skos:Concept ;
    skos:definition "Models that provide a rough idea of the form of the building or urban space, including massing, distribution, and arrangement of volumes and spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conceptual models"@en .

aat:300411658 a skos:Concept ;
    skos:definition "Models used during the design and refinement process, typically of relatively finished quality, but allowing for changes and experimentation in the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "working models"@en .

aat:300411659 a skos:Concept ;
    skos:definition "Models that describe the structural design of a built work, without including the full form; used to work out and illustrate issues having to do with structure and space for architects and engineers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural models"@en .

aat:300411660 a skos:Concept ;
    skos:definition "Models that illustrate the design of the interior space of a built work; focusing on form, space, and function; may also include colors, materials, lighting, and furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior design models"@en .

aat:300411661 a skos:Concept ;
    skos:definition "Models made using software, used to distinguish them from models in physical form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virtual models"@en .

aat:300411662 a skos:Concept ;
    skos:definition "Animations depicting a built work or urban space, as if the viewer were floating or flying through the space. Such works are used for architectural models and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural fly-throughs"@en .

aat:300411663 a skos:Concept ;
    skos:definition "Works that present the illusion of movement and that may be created by a number of techniques including successive drawings, photographing positions of puppets or models, or using computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animations"@en .

aat:300411664 a skos:Concept ;
    skos:definition "Computer-animated simulations of what would be seen if one were to float or fly through a particular environment or object, either real or imaginary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly-throughs"@en .

aat:300411665 a skos:Concept ;
    skos:definition "Exhibitions that are presented in physical galleries or other indoor spaces, as distinguished from online exhibitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "in-gallery exhibitions"@en .

aat:300411666 a skos:Concept ;
    skos:definition "Exhibitions that are presented online rather than in physical galleries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "online exhibitions"@en .

aat:300411667 a skos:Concept ;
    skos:definition "Scissors, which comprise a pair of pivoted blades attached to handles, designed for cutting lengths of fabric. For smaller scissors used for cutting thread, clipping seams, and other tasks, use \"sewing scissors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing shears"@en .

aat:300411668 a skos:Concept ;
    skos:definition "Small scissors having a form specialized for cutting appliqués and other small, negative shapes; often has one round-backed blade against a short, straight blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appliqué scissors"@en .

aat:300411669 a skos:Concept ;
    skos:definition "Belgian art movement in painting that is associated with the group ‘Vie et Lumière’ formed around the artist Emile Claus in 1904. Typical are works with light-infused impressionist Flemish landscapes, often depicting the countryside in the surroundings of the river ‘Leie’."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luminist"@en .

aat:300411670 a skos:Concept ;
    skos:definition "Groups of items to be used for sewing and typically gathered in a box, basket, tin, or other container. May include thread, needles, thimbles, scissors, and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing kits"@en .

aat:300411671 a skos:Concept ;
    skos:definition "Needles having very sharp, fine tips, used for sewing most woven fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sharp-point needles"@en .

aat:300411672 a skos:Concept ;
    skos:definition "The activity or process of assigning titles or names to works, including movable works and built works; may also be used for the process of giving names or titles to films, written works, music, dance, or other creative works or compilations of works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titling"@en .

aat:300411673 a skos:Concept ;
    skos:definition "Sharp, slender modified hairs projecting from the body of an animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needles"@en .

aat:300411674 a skos:Concept ;
    skos:definition "Linear, usually pointed leaves, usually of a coniferous tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needles"@en .

aat:300411675 a skos:Concept ;
    skos:definition "Relative worth of a thing, idea, place, or person based on esteem and judged in terms of importance, usefulness, or desirability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "value"@en .

aat:300411676 a skos:Concept ;
    skos:definition "A theoretical tenet for conserving cultural heritage. The theory maintains that what is old acquires a value of its own due to age, therefore the signs of age, such as patina, should be retained and not corrected or hidden. Based on the philosophy of Viennese art historian Alois Riegl (1858-1905)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alterswert"@en .

aat:300411677 a skos:Concept ;
    skos:definition "Concept concerning efforts to preserve and protect the artistic, historical, and natural heritage of a given region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heimatschutz"@en .

aat:300411678 a skos:Concept ;
    skos:definition "Type of short sock that covers only the sole and heel of the foot, not extending above the ankle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footies"@en .

aat:300411680 a skos:Concept ;
    skos:definition "Shoes meant to be worn submerged in water or in otherwise wet environments. These are often made of materials that are water-resistant or water-proof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water shoes"@en .

aat:300411681 a skos:Concept ;
    skos:definition "Footwear of varied design in which the upper extends above the ankle joint and that covers the leg up to the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knee-high boots"@en .

aat:300411682 a skos:Concept ;
    skos:definition "Footwear of any design in which the upper extends above the ankle joint and that covers the leg up mid-calf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calf-high boots"@en .

aat:300411683 a skos:Concept ;
    skos:definition "Footwear with uppers that extend above the ankle joint, and that have closures that involve lacing through eyelets, grommets, or other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace-up boots"@en .

aat:300411684 a skos:Concept ;
    skos:definition "Boots, generally of ankle height with a lace closure, designed to walk or hike in outdoor settings or uneven terrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hiking boots"@en .

aat:300411685 a skos:Concept ;
    skos:definition "Women's shoes with open backs that are held on by a strap behind the heel of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slingbacks"@en .

aat:300411686 a skos:Concept ;
    skos:definition "Shoes with no obvious method of fastening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step-in shoes"@en .

aat:300411687 a skos:Concept ;
    skos:definition "Footwear in which the uppers extend below the ankle joint, and that fastened to the foot with laces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace-up shoes"@en .

aat:300411688 a skos:Concept ;
    skos:definition "Lightweight footwear, usually strappy, for women; in English, typically reserved for historical usage or when referencing such sandals used in or produced in Germany, the Netherlands, or France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandalettes"@en .

aat:300411689 a skos:Concept ;
    skos:definition "Low-heeled shoes with closed toes and one or more straps around the ankle or instep. Commonly these are made of patent leather and were originally designed as footwear for girls. The name is derived from a character in the 20th century comic strip Buster Brown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mary Janes"@en .

aat:300411690 a skos:Concept ;
    skos:definition "Shoes with a strap around the ankle or instep, with an extra strap that comes out of the vamp (as to form a 'T') with the strap around the ankle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "t-bar shoes"@en .

aat:300411691 a skos:Concept ;
    skos:definition "Pins worn on the chest usually to hold a neck-cloth or scarf in place. Of varied design and materials but often decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breast pins"@en .

aat:300411692 a skos:Concept ;
    skos:definition "Devices made to contain real or artificial flowers that are attached to the clothes of the wearer. Sometimes these are fitted with a receptacle for water to keep real flowers fresh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corsage holders"@en .

aat:300411693 a skos:Concept ;
    skos:definition "Ear ornaments in the form of studs, frequently with decorative elements, worn through a hole pierced in the lobe of the ear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ear studs"@en .

aat:300411694 a skos:Concept ;
    skos:definition "Decorative or ceremonial objects that surround or are affixed to the neck; these may also cover the shoulders and bust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck ornaments"@en .

aat:300411695 a skos:Concept ;
    skos:definition "Necklaces made of strung beads or crocheted or stitched using beads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead necklaces"@en .

aat:300411697 a skos:Concept ;
    skos:definition "Ornamental bands worn on the lower arm that are constructed with individual links or rings passing through one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain bracelets"@en .

aat:300411698 a skos:Concept ;
    skos:definition "Applied clothing accessories that may be made of rope, ribbon or fabric. These consist of knots with two loops and two ends, fixed into decorative elements attached to clothing or other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bows"@en .

aat:300411699 a skos:Concept ;
    skos:definition "Small muffs or fingerless mittens that cover the wrist and part of the hand. Most often these are knitted or crocheted. For handwear with finger holes, use 'mitts (fingerless handwear)'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muffetees"@en .

aat:300411700 a skos:Concept ;
    skos:definition "Gloves intended for use while operating an automobile, and that may enhance grip on the wheel while driving. They can be made of a variety of materials including leather, rubber, and woven textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driving gloves"@en .

aat:300411701 a skos:Concept ;
    skos:definition "Veils, made of tulle or other sheer materials, made to be worn as a fixed or removeable hat accessory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat veils"@en .

aat:300411702 a skos:Concept ;
    skos:definition "Headwear that is designed to protect the heads of small children that are learning to walk from injury caused by falls. Of varied design historically, some are quilted or padded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pudding caps"@en .

aat:300411703 a skos:Concept ;
    skos:definition "Millinery pieces that cover only a small part of the head, the front edge beginning above the hairline, and resting on the crown. Originally developed by Lilly Daché ca. 1940, these may be embellished with a variety of decorative elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-hats"@en .

aat:300411704 a skos:Concept ;
    skos:definition "Headwear of varied design, often in the form of a scullcap formed from a knitted tube shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knit caps"@en .

aat:300411705 a skos:Concept ;
    skos:definition "Caps worn underneath other headwear, often plain, and not intended to be seen, but some exhibiting embroidered or jewelled borders. These have been made in a variety of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "under caps"@en .

aat:300411706 a skos:Concept ;
    skos:definition "\"New fathers\" indoor cap, usually decorated and plumed. Traditionally worn in the Netherlands for nine to ten days after the birth of a child. No equivalent in English language or culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kraamherenmutsen"@en .

aat:300411707 a skos:Concept ;
    skos:definition "Casques intended for the protection of those flying aircraft. These were initially made of leather, were fitted to the head and had earflaps that were connected via a chin strap. Some were lined with fleecy material. More historically recent models are made from a variety of materials including fiberglass and plastic, and are more typically formed into a round dome encasing the entire head of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aviator's helmets"@en .

aat:300411708 a skos:Concept ;
    skos:definition "Hoods that are components of cloaks or cowls, particularly of Capuchin monks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capuches"@en .

aat:300411709 a skos:Concept ;
    skos:definition "Spectacles of any kind that end in a point on the upper outside rim. Initially popular for women in the 1950s and 1960s, the shape goes in and out of fashion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butterfly glasses"@en .

aat:300411710 a skos:Concept ;
    skos:definition "Ornaments or badges made from ribbon or silky material arranged to resemble a rose and worn on clothing to signal membership in an organization, or as the symbol of an award."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosettes"@en .

aat:300411711 a skos:Concept ;
    skos:definition "Neckwear that resembles a short chemisette, meant to cover a woman's neck and chest. Often white, and made in a variety of fabrics. For headwear that envelops the head, chin, sides of the face, and neck, and retained as headwear by nuns, use 'wimples'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guimpes"@en .

aat:300411712 a skos:Concept ;
    skos:definition "Collars that may be fixed components of coats or dresses, or detachable elements of an ensemble. These may extend past the shoulders and cover the upper arms, and are of varied design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cape collars"@en .

aat:300411713 a skos:Concept ;
    skos:definition "Neckwear in the form of broad tubes or loops that fit over the wearer's head and neck, worn as a scarf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowl scarves"@en .

aat:300411714 a skos:Concept ;
    skos:definition "Neckwear consisting of two white, downward-hanging bands of fabric. These are typically worn as part of the professional regalia of lawyers, judges, and university professors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bands"@en .

aat:300411715 a skos:Concept ;
    skos:definition "Pre-knotted ties that are attached around the neck with a strap, or to a shirt's collarband by a metal clip. These can be either bow-ties or long neckties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pre-tied ties"@en .

aat:300411716 a skos:Concept ;
    skos:definition "Decorative devices intended to shape or knot a scarf in order to keep it in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarf-rings"@en .

aat:300411717 a skos:Concept ;
    skos:definition "Small handkerchiefs kept in the pocket of a formal jacket as a decorative accessory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket squares"@en .

aat:300411718 a skos:Concept ;
    skos:definition "Parasols with articulated handles that allow the shade to tilt at an angle. These were designed for use on carriage rides, and were popularized by Queen Victoria in the 1840s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage parasols"@en .

aat:300411719 a skos:Concept ;
    skos:definition "Objects that can function both as muffs and as receptacles for personal items. Often these are designed as handbags with an opening in the back in which the hands can be inserted, or conversely, muffs with an appended pouch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muff bags"@en .

aat:300411720 a skos:Concept ;
    skos:definition "Hand-held personal fans printed with information advertising companies or products, usually distributed for free as promotional items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising fans"@en .

aat:300411721 a skos:Concept ;
    skos:definition "Knitted or crocheted bags popular from the 19th century. They are often tube-like and narrower in the middle, with rounded or squared ends. Miser’s purses were usually gender-specific in the first half of the 19th century. Short purses 4 to 6 inches in length were for women and long purses 7 to 10 inches long for men. By the mid-19th century, all were the larger size to accommodate larger coins. They would triple in length by the early 20th century. They are most typically opened via a slit in the middle, held together by rings. Often they are embellished with beadwork motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miser's purses"@en .

aat:300411722 a skos:Concept ;
    skos:definition "Sleeveless padded or quilted jacket, worn outdoors, often with a zipper in the center front and filled with down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body warmers"@en .

aat:300411723 a skos:Concept ;
    skos:definition "Distinctive shawls, usually woolen, produced in Kashmir, India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kashmir shawls"@en .

aat:300411724 a skos:Concept ;
    skos:definition "Short, loose-fitting jackets that cover the upper body, often with fitted waists. Used as leisure and sports clothing by men and women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blousons"@en .

aat:300411725 a skos:Concept ;
    skos:definition "Lightweight, short jackets that are zipped up the front, sometimes with closefitting waistband and cuffs to protect against the wind. These are worn as sports and leisure wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "windbreakers"@en .

aat:300411726 a skos:Concept ;
    skos:definition "Short dresses with hemlines that extend to mid-thigh; fashionable from the 1960s onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minidresses"@en .

aat:300411727 a skos:Concept ;
    skos:definition "Late 18th-century womenswear comprising two parts: an outer robe with a bodice cut in one piece and and overskirt that parted to reveal a matching or coordinated petticoat. The bodice lacked center back pleats, distinguishing it from a \"robe à la française or open robe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robes à l'anglaise"@en .

aat:300411728 a skos:Concept ;
    skos:definition "Dresses with a strap encircling the neck, used to support the garment. Popular in the 1930s and revived in the 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halter dresses"@en .

aat:300411730 a skos:Concept ;
    skos:definition "Generally two-piece tailored women's suits, with a formal jacket and matching skirt of the same material. These have evolved from the end of the 19th century, when they were worn for walking or other types of leisure. From the 20th century skirt suits have become common professional womenswear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skirt suits"@en .

aat:300411731 a skos:Concept ;
    skos:definition "Dress suits for men, worn at formal dinners, evening weddings, dances, receptions, and other ceremonial events.These consist of a dress coat with tails, a waistcoat, a starched shirt with upstanding collar, a bow tie and a black pair of pants with the outer seam trimmed with satiny material. As a dress code, also referred to as 'white tie' or 'cravate blanche', in contrast with 'black tie'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full evening dress"@en .

aat:300411732 a skos:Concept ;
    skos:definition "Common attire for European gentlemen of the late 17th and early 18th century, derived from French court dress. Formed by a combination of coat, vest and breeches. The silhouette, tailoring, and materials changed slowly over the course of decades. Around 1760 the coat skirt lost its fullness, and tapered to the rear into tails. Sleeves narrowed, and ornamentation became more restrained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "habits à la française"@en .

aat:300411733 a skos:Concept ;
    skos:definition "Sleeveless garments usually worn over a blouse or a shirt, and that have no placket or fastenings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeveless pullovers"@en .

aat:300411734 a skos:Concept ;
    skos:definition "Shirts worn for formal or semiformal occasions usually with a stiff or pleated front fastened with studs. often heavily starched and pleated in the front. The forms of such shirts have changed over time, and once featured detachable collars and cuffs. Evening shirts formed part of full evening dress. The cuffs are most often held closed with cuff links."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening shirts"@en .

aat:300411735 a skos:Concept ;
    skos:definition "Traditional Indonesian womenswear in the form of a light jacket or blouse, to be worn with a sarong. Often made in white or sheer material and embellished with embroidery. Depending on the region of origin, a kabaya can be long or short, open at the front or closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kebayas"@en .

aat:300411736 a skos:Concept ;
    skos:definition "General term for clothing worn on the upper part of the body, above the waist, excluding outerwear and underwear. Typically not used in reference to men's clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tops"@en .

aat:300411737 a skos:Concept ;
    skos:definition "Skirts constructed of a long panel of fabric that wraps around the body, and fastens at the hip or back, often with buttons or ties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrap skirts"@en .

aat:300411738 a skos:Concept ;
    skos:definition "Close-fitting straight-cut skirts, usually with the hemline at or below the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencil skirts"@en .

aat:300411739 a skos:Concept ;
    skos:definition "Skirts made by cutting a waistline hole in the center of a circular piece of fabric, or assembled from triangular pieces, or gores, to create a full, wide shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular skirts"@en .

aat:300411740 a skos:Concept ;
    skos:definition "Originally a pair of pants for men, made in different lengths throughout history, which closed in the front with a flap the wearer can button to the waistband. Developed from the braguette, or codpiece, around 1600. Common garment for men around 1800."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop-front pants"@en .

aat:300411741 a skos:Concept ;
    skos:definition "Pants that puff at the ankles, due to the fabric gathered in banded cuffs or at the seam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puffed pants"@en .

aat:300411742 a skos:Concept ;
    skos:definition "A type of full, baggy knickerbocker, typically worn for field sports, especially golf. The name connotes the length of the pants leg that extends 4 inches below the knee. These were popularized in the 1920s and remained in fashion until the late 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plus fours"@en .

aat:300411743 a skos:Concept ;
    skos:definition "Padded rolls or cushions worn around the hips as women's undergarments to accentuate the fullness of skirts, gowns, petticoats or jackets. Sources attribute their use to both the Elizabethan period and the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bum rolls"@en .

aat:300411744 a skos:Concept ;
    skos:definition "Apron-shaped garment components that may be worn with dresses that open at the front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabliers"@en .

aat:300411745 a skos:Concept ;
    skos:definition "Originally a collective term for all the articles of linen, lace, etc. in a woman's wardrobe or trousseau. Now used for women's underwear and nightclothes, particularly high-end women's underwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lingerie"@en .

aat:300411746 a skos:Concept ;
    skos:definition "Metal or plastic clips in the form of a partial circle, worn around the ankles, to protect the trousers from tangling in the cycle chain while riding a bicycle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicycle clips"@en .

aat:300411747 a skos:Concept ;
    skos:definition "Models or mock-ups of garments, most often made from muslin, and used for fittings or for making copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toiles"@en .

aat:300411748 a skos:Concept ;
    skos:definition "Clothing in a reduced format meant as collectors items, or as practical projects in sewing and home economics courses. For small clothes specifically intended to clothe dolls, use \"doll's clothing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature clothing"@en .

aat:300411750 a skos:Concept ;
    skos:definition "General term for clothing designed for or suitable for either males or females."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unisex clothing"@en .

aat:300411751 a skos:Concept ;
    skos:definition "Miniature versions of clothing meant to be worn by figural toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doll's clothing"@en .

aat:300411753 a skos:Concept ;
    skos:definition "Uniforms for servants, of various historical design, informed by the employer's tastes and job requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servant's uniforms"@en .

aat:300411754 a skos:Concept ;
    skos:definition "Clothing designed for or used for the winter season, particularly clothing offering protection in cold temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter clothing"@en .

aat:300411755 a skos:Concept ;
    skos:definition "Womenswear designed to be worn during pregnancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maternity clothes"@en .

aat:300411756 a skos:Concept ;
    skos:definition "Clothing designed for or worn while working, differing in style depending upon the job, such as manual labor, crafts, or office work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work clothes"@en .

aat:300411757 a skos:Concept ;
    skos:definition "Clothes designed for or used for hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting clothing"@en .

aat:300411758 a skos:Concept ;
    skos:definition "Clothing designed and used for casual situations, as distinct from sleepwear or formal wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casual wear"@en .

aat:300411759 a skos:Concept ;
    skos:definition "Clothing designed for, or used for, dance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dancewear"@en .

aat:300411760 a skos:Concept ;
    skos:definition "Clothing designed or used for the activity of walking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking clothes"@en .

aat:300411761 a skos:Concept ;
    skos:definition "Reform dress was a reaction to the perceptions of discomfort surrounding women's clothing at the end of the 19th century. These movements campaigned in different countries to ban the corset, garters, tight bodices, and the train. Dress reformers championed garments that do not restrain the body, but let it move freely, during both work and leisure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reform dress"@en .

aat:300411762 a skos:Concept ;
    skos:definition "Clothing designed or worn for a wedding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding clothes"@en .

aat:300411763 a skos:Concept ;
    skos:definition "Clothing designed for riding non-motorized cycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cycling clothing"@en .

aat:300411764 a skos:Concept ;
    skos:definition "Clothing designed for playing tennis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tennis clothes"@en .

aat:300411765 a skos:Concept ;
    skos:definition "Riding habits for women, in fashion from the early 18th century, used specifically for riding sidesaddle. Variously described as tailored masculinized ensembles that may include long skirts that cover riding pants, fitted jackets, top hats, and gloves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amazones"@en .

aat:300411766 a skos:Concept ;
    skos:definition "Mode of dress for a fashionable women in the 19th and 20th centuries; dinner dress is less formal than evening wear, ensembles often include sleeves, or open decolletage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinner dress"@en .

aat:300411768 a skos:Concept ;
    skos:definition "Upstanding collars originally derived from Chinese costume that do not roll over. Structurally, these are essentially bare collar stands with no fall. Shapes and method of attachment may vary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stand-up collars"@en .

aat:300411769 a skos:Concept ;
    skos:definition "Parts of a garment that cover the front half of the girth of the body, often comprising a panel or series of panels of material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fronts"@en .

aat:300411770 a skos:Concept ;
    skos:definition "Long formal trains, made of luxurious materials that were compulsory wear for women at royal court from the beginning of the 19th century. Worn with a court dresses, these may be attached from the waist, or with straps around the shoulders, or both. The decoration of court trains was controlled by protocol according to the station of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court trains"@en .

aat:300411771 a skos:Concept ;
    skos:definition "Parts of a garment that cover the rear half of the girth of the body, often comprising a panel or series of panels of material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backs"@en .

aat:300411772 a skos:Concept ;
    skos:definition "The built-up or elevated parts of the soles of shoes or boots, that support the heel of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heels"@en .

aat:300411773 a skos:Concept ;
    skos:definition "Long sleeves with a series of puffs that diminish in size from the shoulder to the wrist. The style was popular in Paris under the First Empire, ca.1804-1814, and was named for the Egyptian cavalry of Mamelukes led by Napoleon I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mameluke sleeves"@en .

aat:300411774 a skos:Concept ;
    skos:definition "Chairs designed for use at the beach, having a hood for protection from the sun and wind. May be made of wicker, wood and cloth, or other materials. Originally made of wicker in the 19th century, based on wicker armchair furniture with covered high rising hoods that had been created by basketmakers for centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strandkorbs"@en .

aat:300411775 a skos:Concept ;
    skos:definition "Term that was appropriated first by the Surrealists from physiology and psychiatry, and later applied to spontaneous writing, drawing, and painting. Automatism in the visual arts includes techniques in other movements as well, such as Abstract Expressionism and others, referring generally to manual creation techniques involving chance or psychological experiences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automatism"@en .

aat:300411776 a skos:Concept ;
    skos:definition "Family containing 4 genera and jover 240 species of flowering trees and shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Erythroxylaceae"@en .

aat:300411777 a skos:Concept ;
    skos:definition "Genus of tropical flowering plants, including around 200 species, several of which are sources of the drug cocaine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Erythroxylum"@en .

aat:300411778 a skos:Concept ;
    skos:definition "General term for any of four varieties of plants of the genus Erythroxylum that are indigenous to western South America and cultivated in Africa, South America, Southeast Asia, and Taiwan. The leaves are used with powdered lime, as a masticatory, appeaser of hunger, and stimulant of the nervous system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coca"@en .

aat:300411779 a skos:Concept ;
    skos:definition "Substance comprising a white, crystalline alkaloid that is obtained from the leaves and young twigs of the coca plant. Used as a local anesthetic and as a stimulant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocaine"@en .

aat:300411780 a skos:Concept ;
    skos:definition "Written, digital, spoken, or signed representations of the attributes or qualities of something or someone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "descriptions"@en .

aat:300411781 a skos:Concept ;
    skos:definition "Canoes, often outrigger canoes, of various designs and sizes, used by Polynesian peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waka"@en .

aat:300411782 a skos:Concept ;
    skos:definition "Culture and nationality of descendants of people of Castillian or other Spanish ancestry who were born in the area of California under Spanish or Mexican control, from 1769 through the 19th century, prior to the region's cession to the United States of America in 1848."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Californio"@en .

aat:300411783 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Alabama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alabamian"@en .

aat:300411784 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Alaska."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alaskan"@en .

aat:300411785 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. territory of American Samoa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American Samoan"@en .

aat:300411786 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of of the U.S. state of Arizona."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arizonan"@en .

aat:300411787 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Arkansa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arkansan"@en .

aat:300411788 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Californian"@en .

aat:300411789 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Colorado."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coloradan"@en .

aat:300411790 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Connecticut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Connecticuter"@en .

aat:300411791 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Delaware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Delawarean"@en .

aat:300411792 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. District of Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Washingtonian"@en .

aat:300411793 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Florida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Floridian"@en .

aat:300411794 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Georgia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Georgian"@en .

aat:300411795 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Hawaii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hawaiian"@en .

aat:300411796 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Idaho."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Idahoan"@en .

aat:300411797 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Illinois."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Illinoisan"@en .

aat:300411798 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Indiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hoosier"@en .

aat:300411799 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Iowa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iowan"@en .

aat:300411800 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Kansas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kansan"@en .

aat:300411801 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Kentucky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kentuckian"@en .

aat:300411802 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Louisiania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Louisianian"@en .

aat:300411803 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Maine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mainer"@en .

aat:300411804 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Maryland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marylander"@en .

aat:300411805 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Massachusetts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Massachusettsan"@en .

aat:300411806 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Michigan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Michiganian"@en .

aat:300411807 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Minnesota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minnesotan"@en .

aat:300411808 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Mississippi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mississippian"@en .

aat:300411809 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Missouri."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Missourian"@en .

aat:300411810 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Montana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Montanan"@en .

aat:300411811 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Nebraska."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nebraskan"@en .

aat:300411812 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Nevada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nevadan"@en .

aat:300411813 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of New Hampshire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Hampshirite"@en .

aat:300411814 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of New Jersey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Jerseyan"@en .

aat:300411815 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of New Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Mexican"@en .

aat:300411816 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of New York."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Yorker"@en .

aat:300411817 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of North Carolina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North Carolinian"@en .

aat:300411818 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of North Dakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North Dakotan"@en .

aat:300411819 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of f the U.S. state of Ohio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ohioan"@en .

aat:300411820 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Oklahoma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oklahoman"@en .

aat:300411821 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Oregon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oregonian"@en .

aat:300411822 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Pennsylvania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pennsylvanian"@en .

aat:300411823 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Rhode Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhode Islander"@en .

aat:300411824 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of South Carolina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Carolinian"@en .

aat:300411825 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of South Dakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Dakotan"@en .

aat:300411826 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Tennessee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tennessean"@en .

aat:300411827 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Texas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Texan"@en .

aat:300411828 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Utah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Utahn"@en .

aat:300411829 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Vermont."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vermonter"@en .

aat:300411830 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Wisconsin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wisconsinite"@en .

aat:300411831 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Wyoming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wyomingite"@en .

aat:300411832 a skos:Concept ;
    skos:definition "Culture or condition of citizenship or residency of the U.S. state of Washington."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Washingtonian"@en .

aat:300411833 a skos:Concept ;
    skos:definition "Culture or residency of the Midwest, which is the north-central USA, including the states of Ohio, Indiana, Illinois, Michigan, Wisconsin, Iowa, Minnesota, and usually Missouri, Kansas, Nebraska, Kentucky, and the Dakotas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Midwestern"@en .

aat:300411834 a skos:Concept ;
    skos:definition "Culture or residency of the Southwest USA, which typically includes the states of Arizona, New Mexico, Oklahoma and Texas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southwestern"@en .

aat:300411835 a skos:Concept ;
    skos:definition "The state or condition associated with male, female, neutral, or other social or cultural distinctions and differences, rather than strictly biological ones. Although gender may be based on sex, for biological and physiological traits that distinguish the males and females of a species, prefer \"sex (biological characteristic).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender"@en .

aat:300411836 a skos:Concept ;
    skos:definition "Having chracteristics, qualities, attributes, or actions associated with the male sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masculine"@en .

aat:300411837 a skos:Concept ;
    skos:definition "Having chracteristics, qualities, attributes, or actions associated with the female sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feminine"@en .

aat:300411838 a skos:Concept ;
    skos:definition "Categories to which words or lexical units are traditionally assigned according to their grammatical and semantic functions in language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parts of speech"@en .

aat:300411839 a skos:Concept ;
    skos:definition "In language, words or lexical units used as the name or designation of a person, place, or thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nouns"@en .

aat:300411840 a skos:Concept ;
    skos:definition "In language, the words or lexical units by which an assertion is made, or that serve to connect a subject with a predicate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verbs"@en .

aat:300411841 a skos:Concept ;
    skos:definition "In language, the non-finite parts of a verb, used either in compound verb forms with an auxiliary verb expressing tense and voice, or as an adjective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "participles"@en .

aat:300411842 a skos:Concept ;
    skos:definition "In language, a small set of words that give definiteness or indefiniteness and specificness or genericness to the application of a noun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "articles"@en .

aat:300411843 a skos:Concept ;
    skos:definition "In language, words that can function as a noun phrase when used by itself themselves or to someone or something mentioned elsewhere in the discourse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pronouns"@en .

aat:300411844 a skos:Concept ;
    skos:definition "In language, indeclinable words or particles governing (and usually preceding) a noun, pronoun, etc., and expressing a relation between it and another word."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prepositions"@en .

aat:300411845 a skos:Concept ;
    skos:definition "In language, words or lexical units that modify the meaning of a verb, adjective, or another adverb, expressing manner, place, time, or degree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adverbs"@en .

aat:300411846 a skos:Concept ;
    skos:definition "In language, uninflected words used to connect clauses or sentences, or to coordinate words in the same clause."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conjunctions"@en .

aat:300411847 a skos:Concept ;
    skos:definition "Classes in Indo-European languages and certain other languages, into which nouns and pronouns are distinguished by different inflections which require other words to be in agreement with them. The types of classes typically are masculine, feminine, neuter, and common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grammatical gender"@en .

aat:300411848 a skos:Concept ;
    skos:definition "Devices, often having a basic shape similar to a boat-shaped weaver's shuttle, but used to carry thread as a spool; used for sewing, knotting, tatting, and embroidery. May be highly decorative and of precious materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shuttles"@en .

aat:300411849 a skos:Concept ;
    skos:definition "Variety of the Dutch language used in the Netherlands for public and official purposes, including instruction in schools and universities. Standard Dutch is characterized grammatically by the loss of case endings in the noun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Standard Dutch"@en .

aat:300411850 a skos:Concept ;
    skos:definition "A progenitor of the modern Dutch language as it was spoken from about 1150 to about 1550, itself a collection of dialects including Flemish, Brabantic, Hollandic, and Limburgic. Middle Dutch derives from Low Franconian, the speech of the Western Franks, which was restructured through contact with speakers of North Sea Germanic along the coast (Flanders, Holland) about 700 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Dutch"@en .

aat:300411851 a skos:Concept ;
    skos:definition "Refers to a group of dialects for which there was no standard literary language, but was spoken until about 1100 in the highlands of southern Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old High German"@en .

aat:300411852 a skos:Concept ;
    skos:definition "The variety of German language that developed after ca. 1100 CE, based on the upper German dialects Alemannic and Bavarian that had begun to arise in the southernmost part of Germany. Middle High German was the language of an extensive literature that includes the early 13th-century epic \"Nibelungenlied.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle High German"@en .

aat:300411853 a skos:Concept ;
    skos:definition "Refers to several varieties of Spanish spoken in Chile, having pronunciation, grammar, vocabulary, and slang that is distinct from standard Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chilean Spanish"@en .

aat:300411854 a skos:Concept ;
    skos:definition "Refers to several varieties of Spanish spoken in Bolivia, which may be divided into two main groups: varieties of the Andes and of the lowlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolivian Spanish"@en .

aat:300411855 a skos:Concept ;
    skos:definition "Albumen paper was a widely used photographic printing material from about 1850-1890, when it was superseded by silver gelatin paper. Invented by Louis Desiré Blanquart and presented to the French Academy of Sciences in 1850. Manually coated sheet by sheet with egg white combined with a small amount of salt, when dried, the coated paper was sensitized by the user by floating on a silver nitrate solution. After exposure to sunlight under a negative, the image would be gold-toned and fixed with sodium thiosulphate. The last commercial production of albumen paper is believed to have been in 1929."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albumen paper"@en .

aat:300411856 a skos:Concept ;
    skos:definition "A copper alloy containing copper (89%), aluminum (5%), zinc (5%), and tin (1%)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nordic gold"@en .

aat:300411857 a skos:Concept ;
    skos:definition "Refers to the forms of non-Classical, nonstandard Latin from which originated the Romance group of languages. Aside from the numerous inscriptions found throughout the empire, there are many longer texts in Vulgar Latin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vulgar Latin"@en .

aat:300411858 a skos:Concept ;
    skos:definition "The form of the Latin language recognized as standard by writers of the late Roman Republic and the Roman Empire. It is distinguished from the nonstandard Vulgar Latin, from which Romance languages developed. Latin of the Classical period had six regularly used cases in the declension of nouns and adjectives (nominative, vocative, genitive, dative, accusative, ablative), with traces of a locative case in some declensional classes of nouns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Classical Latin"@en .

aat:300411859 a skos:Concept ;
    skos:definition "Refers to several vernacular Romance dialects spoken in the northern and western portions of the historical region of León, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leonese"@en .

aat:300411860 a skos:Concept ;
    skos:definition "Refers to a group of related Romance dialects of the West Iberian branch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Astur-Leonese"@en .

aat:300411863 a skos:Concept ;
    skos:definition "The characteristic pattern known from plaid textiles, consisting of bars or stripes of various colors crossing each other at right angles over a contrasting background color, whether or not the pattern exists on a textile or another material. Plaid patterns were known from ancient times in many cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaid"@en .

aat:300411867 a skos:Concept ;
    skos:definition "Now extinct, Anatolian languages were spoken during the 1st and 2nd millennia BCE in what is presently Asian Turkey and northern Syria. The best-known Anatolian language is Hittite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian"@en .

aat:300411868 a skos:Concept ;
    skos:definition "Now extinct languages that were spoken in the Tarim Basin (in present-day northwestern China) during the 1st millennium CE. Two distinct languages are known, labeled A (East Tocharian, or Turfanian) and B (West Tocharian, or Kuchean)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tocharian"@en .

aat:300411869 a skos:Concept ;
    skos:definition "Baltic and Slavic languages are here groped into a single branch due to the exclusively shared features; developed in the early Common Era with Baltic and Slavic tribes occupying a large area of eastern Europe, including much of present-day Poland and the states of Belarus, Ukraine, and westernmost Russia. The earliest Slavic texts, written in a dialect called Old Church Slavonic, date from the 9th century CE; the oldest substantial material in Baltic dates to the end of the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balto-Slavic"@en .

aat:300411870 a skos:Concept ;
    skos:definition "Group of related languages derived from Vulgar Latin within historical times. The major languages of the family include French, Italian, Spanish, Portuguese, and Romanian, Catalan, Occitan and Rhaetian dialects, Sardinian, and Dalmatian, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romance"@en .

aat:300411871 a skos:Concept ;
    skos:definition "In some classifications, a large branch of the Romance languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italo-Western"@en .

aat:300411872 a skos:Concept ;
    skos:definition "Group of related Romance languages, including Spanish, Asturian-Leonese, Aragonese, Catalan, Portuguese, French, Franco-Provençal, Gascon, Provençal, Gallo-Wallon, Romansh, and Ladin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Romance"@en .

aat:300411873 a skos:Concept ;
    skos:definition "A stable medium of exchange based on the cocoa bean used in Pre-Columbian Central America, and that continued after contact with the Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocoa bean money"@en .

aat:300411874 a skos:Concept ;
    skos:definition "The shell of the hawksbill sea turtle, which is a critically endangered sea turtle, used for decorative purposes. When processed, a type of tortoiseshell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hawksbill shell"@en .

aat:300411875 a skos:Concept ;
    skos:definition "Group of related Romance languages that developed on the Iberian Peninsula, comprising modern Spain, Portugal, Gibraltar and Andorra, and in southern France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ibero-Romance"@en .

aat:300411876 a skos:Concept ;
    skos:definition "Branch of Romance languages that includes Castilian, Astur-Leonese, and modern descendants of Galician-Portuguese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Iberian"@en .

aat:300411877 a skos:Concept ;
    skos:definition "Languages that include Castilian Spanish and its closest relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castilian"@en .

aat:300411878 a skos:Concept ;
    skos:definition "Paper made on a machine that allows pulp to flow onto a moving and vibrating mesh or belt, thus forming a continuous strip that may be dried and pressed before being wound onto a roll for storage. Machine-made paper may exhibit laid lines, chain lines, and watermarks that mimic those of handmade paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine-made paper"@en .

aat:300411879 a skos:Concept ;
    skos:definition "Coins that honor people, places, events, or institutions. These coins may be legal tender, but are generally not minted for circulation and are typically produced in limited quantity and are made available for a limited time. Distinguished from medals as coins have a stated face value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative coins"@en .

aat:300411880 a skos:Concept ;
    skos:definition "Suborder containing most living tortoises and turtles; the name means \"hidden neck,\" and they differ from members of Pleurodira (side-neck turtles) who fold their neck under the edge of the shell, but cannot withdraw the head. In addition to differences in the neck, skulls vary in size and shape between the two groups, though all are made up of the same bony elements. The pleurodiran and cryptodiran turtles differ fundamentally in lower jaw architecture and musculature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cryptodira"@en .

aat:300411881 a skos:Concept ;
    skos:definition "Family of sea turtles containing 5 extant genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cheloniidae"@en .

aat:300411882 a skos:Concept ;
    skos:definition "Genus containing only one extant species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eretmochelys"@en .

aat:300411883 a skos:Concept ;
    skos:definition "Species of sea turtle, critically endangered; was primary source of the material tortoise shell for hundreds of years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eretmochelys imbricata"@en .

aat:300411884 a skos:Concept ;
    skos:definition "Early form of Spanish that was spoken on the Iberian Peninsula from the 10th century until early 15th century; modern Spanish differs in having had a consonantal readjustment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Spanish"@en .

aat:300411885 a skos:Concept ;
    skos:definition "Flexible slender branches, stems, or twigs used for tying, binding, or weaving, especially in wickerwork, basketry, or to construct furniture such as chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "withies"@en .

aat:300411886 a skos:Concept ;
    skos:definition "Refers to Spanish spoken in Colombia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colombian Spanish"@en .

aat:300411887 a skos:Concept ;
    skos:definition "Refers to Spanish spoken in areas of Argentina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Argentine Spanish"@en .

aat:300411888 a skos:Concept ;
    skos:definition "Refers to varieties of Spanish spoken in Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peruvian Spanish"@en .

aat:300411889 a skos:Concept ;
    skos:definition "Refers to varieties of Spanish spoken in Mexico and in some parts of the United States and Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mexican Spanish"@en .

aat:300411890 a skos:Concept ;
    skos:definition "Refers to the Caribbean language variety of Spanish spoken in Cuba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cuban Spanish"@en .

aat:300411891 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in Puerto Rico, largely derived from Canarian Spanish and Andalusian Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Puerto Rican Spanish"@en .

aat:300411892 a skos:Concept ;
    skos:definition "Multistemmed shrub typically found in wet environments near ponds or streams. It may grow from 10 to 20 feet high, and has long branches with green or gray bark and long, narrow leaves. Native range extends from Europe to Asia, but is cultivated widely. The tough pliant branches are commonly used in basketwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix viminalis"@en .

aat:300411893 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in Costa Rica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Costa Rican Spanish"@en .

aat:300411894 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in the Dominican Republic; and among the Dominican diaspora."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dominican Spanish"@en .

aat:300411895 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in Guatemala. Many words have Nahuatl, Mayan, or other native origins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guatemalan Spanish"@en .

aat:300411896 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in Honduras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Honduran Spanish"@en .

aat:300411898 a skos:Concept ;
    skos:definition "Flexible slender branches, stems, or twigs of willow, specifically Salix viminalis, or common osier, used for tying, binding, or weaving, especially in basketry, or to construct furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "osiers"@en .

aat:300411899 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in Nicaragua; it is influenced by indigenous languages and creole dialects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nicaraguan Spanish"@en .

aat:300411900 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in Paraguay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paraguayan Spanish"@en .

aat:300411901 a skos:Concept ;
    skos:definition "Wood of the Citrus limon, or lemon tree. A hardwood with fine grain that can be carved into small tools or objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon wood"@en .

aat:300411902 a skos:Concept ;
    skos:definition "Refers to the variety of Spanish spoken in the Antilles; it is largely of Andalusian derivation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antillean Spanish"@en .

aat:300411903 a skos:Concept ;
    skos:definition "Used to distinguish the variety of Spanish spoken in Spain, on the Iberian Peninsula, from other forms spoken elsewhere. To refer specifically to formal varieties of Spanish as spoken in Spain, use \"Castilian Spanish.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European Spanish"@en .

aat:300411904 a skos:Concept ;
    skos:definition "Refers to the varieties of Spanish spoken in the Americas. Pronunciation and other characteristics vary from country to country, and from region to region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin American Spanish"@en .

aat:300411905 a skos:Concept ;
    skos:definition "The variety of Spanish spoken on the island of Mallorca; the other language spoken there is the Mallorquí variety of Balearic Catalan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mallorcan Spanish"@en .

aat:300411906 a skos:Concept ;
    skos:definition "The variety of Balearic Catalan spoken on the island of Mallorca, along with Mallorcan Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mallorquí"@en .

aat:300411907 a skos:Concept ;
    skos:definition "The varieties of Catalan spoken on the Balearic Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balearic"@en .

aat:300411908 a skos:Concept ;
    skos:definition "Variety of Spanish spoken in the Philippines; it includes characteristics of European Spanish and Latin American Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Philippine Spanish"@en .

aat:300411909 a skos:Concept ;
    skos:definition "Variety of Spanish spoken in Morocco; it includes elements of Arabic and French."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moroccan Spanish"@en .

aat:300411910 a skos:Concept ;
    skos:definition "The variety of Spanish spoken in Basque Country; not to be confused with the Basque language, which is not related to Spanish and is not a Romance language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basque Country Spanish"@en .

aat:300411911 a skos:Concept ;
    skos:definition "The variety of Spanish spoken in Catalonia; not to be confused with the Catalan language, which is not Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Catalonian Spanish"@en .

aat:300411912 a skos:Concept ;
    skos:definition "Collections, usually but not necessarily held by a public institution, that are made available for access by members of the public. The earliest recorded instance of a public body receiving a private art collection occurs in the 16th century, when the Grimani family gave their collection to the Venetian republic. For collections in private hands that are not available to the public, use \"private collections.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public collections"@en .

aat:300411914 a skos:Concept ;
    skos:definition "Language family comprising two closely related Papuan languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amto-Musan"@en .

aat:300411915 a skos:Concept ;
    skos:definition "Family of languages spoken in western Brazil and Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arauan"@en .

aat:300411916 a skos:Concept ;
    skos:definition "Small language family of central Chile and neighboring areas of Argentina; some scholars classify the languages as divergent dialects of a single language isolate, rather than members of a family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Araucanian"@en .

aat:300411917 a skos:Concept ;
    skos:definition "Language family that developed among ancient indigenous peoples in South America, with branches in Central America, the Greater Antilles in the Caribbean and the Atlantic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arawakan"@en .

aat:300411919 a skos:Concept ;
    skos:definition "Language family containing two poorly documented indigenous South American languages, both of which are nearly extinct and appear to be only distantly related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arutani-Sape"@en .

aat:300411920 a skos:Concept ;
    skos:definition "Large language family of continental Southeast Asia, in isolated areas of India, Bangladesh, Nepal, and the southern border of China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austro-Asiatic"@en .

aat:300411921 a skos:Concept ;
    skos:definition "Large language family found dispersed throughout Maritime Southeast Asia, Madagascar, and Pacific Ocean islands, with a few members on continental Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austronesian"@en .

aat:300411922 a skos:Concept ;
    skos:definition "Dialect cluster spoken in Indonesian Papua Province."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bayono-Awbono"@en .

aat:300411923 a skos:Concept ;
    skos:definition "Language and dialects that developed when English sailors were stranded on Pitcairn Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English-Tahitian Cant"@en .

aat:300411924 a skos:Concept ;
    skos:definition "Family of indigenous South American languages, containing Carib language and related languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cariban"@en .

aat:300411925 a skos:Concept ;
    skos:definition "Group of languages spoken by indigenous people of Argentina and Chile, in Tierra del Fuego and Patagonia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chon"@en .

aat:300411926 a skos:Concept ;
    skos:definition "Language family of northeastern Siberia, where traditionally the speakers are indigenous hunter-gatherers and reindeer herders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chukotko-Kamchatkan"@en .

aat:300411927 a skos:Concept ;
    skos:definition "Languages that have developed from the mixing of two or more parent languages, where the combined new language has become the first language of a community. Creole languages often arise as the result of contact between the language of a dominant group (historically often a European colonizer) and that (or those) of a subordinate group (often the colonized people, or an enslaved population). For languages developed from two or more languages, but where grammar and vocabulary is simplified and the language used only in temporary contact situations, prefer \"pidgins (language, general).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creoles"@en .

aat:300411929 a skos:Concept ;
    skos:definition "Family of languages spoken in Greenland, Canada, Alaska (United States), and eastern Siberia (Russia), by the Eskimo and Aleut peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eskimo-Aleut"@en .

aat:300411930 a skos:Concept ;
    skos:definition "Language family comprising around 12 Papuan languages along the eastern coast of Geelvink Bay in Indonesian Papua. Formerly a larger family \"Geelvink-Bay\" was accepted, although since 2005, certain members of the larger family have been moved to other lines, and the remaining family is now called \"East Geelvink-Bay.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Geelvink-Bay"@en .

aat:300411931 a skos:Concept ;
    skos:definition "Language family of the savannah areas of the Orinoco River region in eastern Colombia and southwestern Venezuela."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guahiban"@en .

aat:300411932 a skos:Concept ;
    skos:definition "Native North American language family comprising the Muskogean languages and a few extinct language isolates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gulf"@en .

aat:300411933 a skos:Concept ;
    skos:definition "Small language family of indigenous Harakmbet people of Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Harakmbet"@en .

aat:300411934 a skos:Concept ;
    skos:definition "Family of languages spoken by indigenous Native Americans in New Mexico, Kansas, Oklahoma, and Texas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kiowa-Tanoan"@en .

aat:300411935 a skos:Concept ;
    skos:definition "Small language family spoken by people in northern Papua New Guinea; the validity of this family is disputed among scholars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwomtari-Baibai"@en .

aat:300411936 a skos:Concept ;
    skos:definition "Small language family spoken in central New Guinea, along the left bank of the May River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Left May"@en .

aat:300411938 a skos:Concept ;
    skos:definition "Language family comprising languages spoken near the mouth of the Mamberamo River, along the northern coast of Papua province, Indonesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Mamberamo"@en .

aat:300411939 a skos:Concept ;
    skos:definition "Family of distantly related languages in northern Argentina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lule-Vilela"@en .

aat:300411940 a skos:Concept ;
    skos:definition "Language group including families in Brazil and parts of Argentina, Paraguay, and Bolivia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macro-Ge"@en .

aat:300411941 a skos:Concept ;
    skos:definition "Language family consisting of other families, spoken in Argentina, Brazil, Paraguay, and Bolivia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mataco-Guaicuru"@en .

aat:300411942 a skos:Concept ;
    skos:definition "Language family comprising living languages spoken on the Isthmus of Tehuantepec, Mexico, and surrounding areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mixe-Zoque"@en .

aat:300411944 a skos:Concept ;
    skos:definition "Language of South America, having several dialects; not clearly related to any other South American languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mosetenan"@en .

aat:300411945 a skos:Concept ;
    skos:definition "Group of two well established language families spoken in the Caucasus, chiefly in the north."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North Caucasian"@en .

aat:300411946 a skos:Concept ;
    skos:definition "Family of South American indigenous languages spoken in the upper Amazon basin in eastern Peru and parts of Bolivia and Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panoan"@en .

aat:300411948 a skos:Concept ;
    skos:definition "Language family of the Sepik and Ramu river basins of northern Papua New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sepik-Ramu"@en .

aat:300411950 a skos:Concept ;
    skos:definition "Large family of more than 400 languages spoken in East Asia, Southeast Asia, and South Asia; includes both the Chinese and the Tibeto-Burman languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sino-Tibetan"@en .

aat:300411951 a skos:Concept ;
    skos:definition "Small language family of tonal languages spoken primarily along the coast of Sandaun Province in Papua New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sko"@en .

aat:300411952 a skos:Concept ;
    skos:definition "Family of languages that are spoken south of the chief range of the Caucasus mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kartvelian"@en .

aat:300411953 a skos:Concept ;
    skos:definition "Language family of related Central American indigenous languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Subtiaba-Tlapanec"@en .

aat:300411954 a skos:Concept ;
    skos:definition "Language family of Southeast Asia, with the Tai languages as the core."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tai-Kadai"@en .

aat:300411955 a skos:Concept ;
    skos:definition "Small language family spoken in the Mexican state of Michoacán; In some classifications, it is considered a language isolate with dialects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarascan"@en .

aat:300411956 a skos:Concept ;
    skos:definition "Language family of the northern Papua New Guinea coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torricelli"@en .

aat:300411957 a skos:Concept ;
    skos:definition "Language family of east central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Totonacan"@en .

aat:300411958 a skos:Concept ;
    skos:definition "Large family of Papuan languages spoken in New Guinea and neighboring islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trans-New Guinea"@en .

aat:300411959 a skos:Concept ;
    skos:definition "Language family of Colombia, Brazil, Ecuador, and Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tucanoan"@en .

aat:300411961 a skos:Concept ;
    skos:definition "Language family of southwestern Bolivia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uru-Chipaya"@en .

aat:300411962 a skos:Concept ;
    skos:definition "Language family of Papuan languages spoken in far western New Guinea and the island of Halmahera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Papuan"@en .

aat:300411963 a skos:Concept ;
    skos:definition "Language family of southern Colombia and northern Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Witotoan"@en .

aat:300411964 a skos:Concept ;
    skos:definition "Language family spoken on the western part of the Brazil-Venezuela border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yanomam"@en .

aat:300411965 a skos:Concept ;
    skos:definition "Language family spoken on the Yenisei River in western Siberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yeniseian"@en .

aat:300411966 a skos:Concept ;
    skos:definition "Language family spoken in scattered areas of Colombia, Ecuador, and Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zaparoan"@en .

aat:300411967 a skos:Concept ;
    skos:definition "Groups of languages bound by geographic location, but containing members of different language families that have developed some common characteristics through geographical proximity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprachbunds"@en .

aat:300411969 a skos:Concept ;
    skos:definition "Forms or varieties of a given language that are peculiar to a specific region and differ from the standard or literary form of the language regarding vocabulary, pronunciation, idiom, or other characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dialects"@en .

aat:300411970 a skos:Concept ;
    skos:definition "Peculiar invented or developed languages or jargon of a narrow group, such as the cants used by gipsies, pitcairn islanders, thieves, professional beggars, urban neighborhoods, etc.; often having the connotation of secrecy, with the intention that only those within the group are able to understand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cants"@en .

aat:300411973 a skos:Concept ;
    skos:definition "Language family spoken on Japanese and other islands; developed from common ancestral language, Proto-Japonic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japonic"@en .

aat:300411974 a skos:Concept ;
    skos:definition "Language family of north central California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yukian"@en .

aat:300411975 a skos:Concept ;
    skos:definition "Languages that are still in use, but are at risk of falling out of use because speakers are dying out or shifting to speaking another language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endangered languages"@en .

aat:300411976 a skos:Concept ;
    skos:definition "Languages that are no longer spoken by native speakers. While the term may have overlapping usage with \"extinct languages,\" an extinct language typically is limited to languages having no descendents. For example, Latin is a dead language but not extinct, because it has several descendent languages and is read and even spoken by scholars and in the Vatican."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dead languages"@en .

aat:300411977 a skos:Concept ;
    skos:definition "Languages containing lexical and other features from two or more languages, characteristically with simplified grammar and a smaller vocabulary than the languages from which the pidgin language is derived. Pidgins have no native speakers, as the populations that use them during occasional trade contacts. The term originally referred to languages that developed out of sporadic and limited contacts between Europeans and non-Europeans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pidgins"@en .

aat:300411978 a skos:Concept ;
    skos:definition "Means of communication using facial expressions and bodily movements, especially of the hands and arms, as opposed to acoustically conveyed sound patterns. Used when spoken communication is impossible or not desirable, for example between speakers of mutually unintelligible languages or when one or more parties is deaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sign languages"@en .

aat:300411979 a skos:Concept ;
    skos:definition "Languages used as a means of communication between populations speaking vernaculars that are not mutually intelligible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lingua francas"@en .

aat:300411980 a skos:Concept ;
    skos:definition "Languages made up of a mixture of elements from two or more languages, usually when one has been substantially influenced by another language. An example is English having been influenced by Norman French."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed languages"@en .

aat:300411981 a skos:Concept ;
    skos:definition "Technical or specialized parlances of a specific social or occupational group that others outside the group cannot understand well. The term originally indicated unstable rudimentary hybrid languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jargon"@en .

aat:300411982 a skos:Concept ;
    skos:definition "Groups of languages deriving from a single ancestor or parent language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "language families"@en .

aat:300411983 a skos:Concept ;
    skos:definition "Rods or slips of wood designed for personal reading, used for following words on a page; may be highly decorative and of a type used in the Early Christian and Medieval periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astels"@en .

aat:300411984 a skos:Concept ;
    skos:definition "Relatively small rods used as pointers, usually handheld, for following the words or text while reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading pointers"@en .

aat:300411985 a skos:Concept ;
    skos:definition "Pointers used by readers of the Torah in the synagogue to follow the text, typically having the form of a rod terminating in a hand with an outstretched index finger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yads"@en .

aat:300411986 a skos:Concept ;
    skos:definition "People belonging to or working for a Christian church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecclesiastics"@en .

aat:300411987 a skos:Concept ;
    skos:definition "Ecclesiastics or lay people whose duty is to read the scriptures during services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lectors"@en .

aat:300411988 a skos:Concept ;
    skos:definition "Ecclesiastics or lay attendants who carry a cross in a procession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crucifers"@en .

aat:300411989 a skos:Concept ;
    skos:definition "Ecclesiastics or lay attendants who carry burning incense in religious ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thurifers"@en .

aat:300411990 a skos:Concept ;
    skos:definition "Ecclesiastics or lay attendants who carry candles in religious processions or on other occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle bearers"@en .

aat:300411991 a skos:Concept ;
    skos:definition "The oral manifestation of languages; language produced by articulate sounds, as opposed to a written language. Many languages have no written form and so are only spoken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoken languages"@en .

aat:300411992 a skos:Concept ;
    skos:definition "Written representations of spoken or gestural languages by using a writing system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "written languages"@en .

aat:300411993 a skos:Concept ;
    skos:definition "Systems of money, usually those in general use in a particular country. For the paper bills, coins, or other monetary items as objects, use \"money(objects).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "currencies"@en .

aat:300411994 a skos:Concept ;
    skos:definition "The standard unit of currency of the United States of America, containing 100 cents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "United States dollar"@en .

aat:300411995 a skos:Concept ;
    skos:definition "Money manufactured from paper and originating in multiple places around the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international paper money"@en .

aat:300411996 a skos:Concept ;
    skos:definition "The standard unit of currency of the Eurozone, comprising member states of the European Union."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Euro"@en .

aat:300411997 a skos:Concept ;
    skos:definition "The standard unit of currency of Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese yen"@en .

aat:300411998 a skos:Concept ;
    skos:definition "The standard unit of currency of the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pound sterling"@en .

aat:300411999 a skos:Concept ;
    skos:definition "The standard unit of currency of Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australian dollar"@en .

aat:300412000 a skos:Concept ;
    skos:definition "The standard unit of currency of Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canadian dollar"@en .

aat:300412001 a skos:Concept ;
    skos:definition "The standard unit of currency of Switzerland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swiss franc"@en .

aat:300412002 a skos:Concept ;
    skos:definition "The standard unit of currency of China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese yuan"@en .

aat:300412003 a skos:Concept ;
    skos:definition "The standard unit of currency of Sweden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swedish krona"@en .

aat:300412004 a skos:Concept ;
    skos:definition "The standard unit of currency of New Zealand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Zealand dollar"@en .

aat:300412005 a skos:Concept ;
    skos:definition "The standard unit of currency of Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mexican peso"@en .

aat:300412006 a skos:Concept ;
    skos:definition "The standard unit of currency of Singapore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Singapore dollar"@en .

aat:300412007 a skos:Concept ;
    skos:definition "The standard unit of currency of Hong Kong."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hong Kong dollar"@en .

aat:300412008 a skos:Concept ;
    skos:definition "The standard unit of currency of Norway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norwegian krone"@en .

aat:300412009 a skos:Concept ;
    skos:definition "The standard unit of currency of South Korea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Korean won"@en .

aat:300412010 a skos:Concept ;
    skos:definition "The standard unit of currency of Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkish lira"@en .

aat:300412011 a skos:Concept ;
    skos:definition "The standard unit of currency of Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian ruble"@en .

aat:300412012 a skos:Concept ;
    skos:definition "The standard unit of currency of India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian rupee"@en .

aat:300412013 a skos:Concept ;
    skos:definition "The standard unit of currency of Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brazilian real"@en .

aat:300412014 a skos:Concept ;
    skos:definition "The standard unit of currency of South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South African rand"@en .

aat:300412015 a skos:Concept ;
    skos:definition "The standard unit of currency of Italy prior to adoption of the Euro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian lira"@en .

aat:300412016 a skos:Concept ;
    skos:definition "The standard unit of currency of France prior to adoption of the Euro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French franc"@en .

aat:300412017 a skos:Concept ;
    skos:definition "The standard unit of currency of Germany prior to adoption of the Euro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Deutsche Mark"@en .

aat:300412018 a skos:Concept ;
    skos:definition "The standard unit of currency of Belgium prior to adoption of the Euro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgian franc"@en .

aat:300412019 a skos:Concept ;
    skos:definition "The standard unit of currency of the Netherlands prior to adoption of the Euro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch guilder"@en .

aat:300412020 a skos:Concept ;
    skos:definition "The standard unit of currency of Spain prior to adoption of the Euro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish peseta"@en .

aat:300412021 a skos:Concept ;
    skos:definition "Historical standard unit of currency of Florence, Italy, represented by a gold coin struck from 1252 to 1533, having 72 grains of nominally pure or 'fine' gold (3.5 grams, 0.1125 troy ounce). Since Florentine banks were international enterprises, the Florentine florin was the dominant currency of Western Europe for large-scale transactions for many years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Florentine florin"@en .

aat:300412022 a skos:Concept ;
    skos:definition "The standard unit of currency of modern Greece prior to adoption of the Euro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek drachma"@en .

aat:300412023 a skos:Concept ;
    skos:definition "Any of the various parts that make up the construction of footwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe components"@en .

aat:300412024 a skos:Concept ;
    skos:definition "Buddhist priests of Mongolia and the Tibetan territories of southwestern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamas"@en .

aat:300412025 a skos:Concept ;
    skos:definition "Chief Buddhist priests of the Tibetan territories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dalai lamas"@en .

aat:300412026 a skos:Concept ;
    skos:definition "The clergy of Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhist clergy"@en .

aat:300412027 a skos:Concept ;
    skos:definition "In Buddhism, dedicated mendicants or religious devotees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhikkus"@en .

aat:300412028 a skos:Concept ;
    skos:definition "Formal specifications of the duties and responsibilities related to occupations or positions of employment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "job descriptions"@en .

aat:300412029 a skos:Concept ;
    skos:definition "Historic territories, colonies, or dependencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former territories/colonies/dependent states"@en .

aat:300412030 a skos:Concept ;
    skos:definition "Species of South American evergreen shrub and tree of the holly family, having leaves that are used for an infusion beverage that is high in caffeine content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ilex paraguariensis"@en .

aat:300412031 a skos:Concept ;
    skos:definition "Beverage comprising a bitter infusion made from yerba mate leaves, consumed as a stimulant; it is greenish in color, containing caffeine and tannin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maté"@en .

aat:300412032 a skos:Concept ;
    skos:definition "Leaves of the Ilex paraguariensis that have been prepared to make the beverage of the same name, which is a bitter infusion containing caffeine and tannin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maté"@en .

aat:300412033 a skos:Concept ;
    skos:definition "Family of rodents native to southwestern South America, comprising 9 genera and 13 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Octodontidae"@en .

aat:300412034 a skos:Concept ;
    skos:definition "Genus of South American rodent containing one extant species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spalacopus"@en .

aat:300412035 a skos:Concept ;
    skos:definition "Species of rodent endemic to a wide variety of habitats in central Chile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spalacopus cyanus"@en .

aat:300412036 a skos:Concept ;
    skos:definition "In ancient and modern nonliterate religions, dieties who are eternally fruitful sources of everything. The most archaic form of the earth mother transcends all specificity and sexuality. In later agricultural traditions, she is simply the earth and its fertility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth mothers"@en .

aat:300412037 a skos:Concept ;
    skos:definition "Feminine deities and maternal symbols of creativity, birth, fertility, sexual union, nurturing, and the cycle of growth. The term may be applied to figures as diverse as the Stone Age so-called \"Venuses\" and the Catholic Virgin Mary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mother goddesses"@en .

aat:300412038 a skos:Concept ;
    skos:definition "Deities, usually masculine, responsible for the creation of earth and the cosmos. Often coupled with earth mothers or mother goddesses, who may be responsible for human, animal, and plant fertility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creator gods"@en .

aat:300412039 a skos:Concept ;
    skos:definition "Japanese phrase translated as “grainy, blurry, and out-of-focus.” This refers to a style of photography popularized in Japan in the late 1960s, associated with Provoke magazine, and most particularly with the work of Daido Moriyama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "are, bure, boke"@en .

aat:300412040 a skos:Concept ;
    skos:definition "An ordered and harmonious system that comprises the world or universe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmos"@en .

aat:300412041 a skos:Concept ;
    skos:definition "The state or realm of existence, particularly of the physical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "world"@en .

aat:300412042 a skos:Concept ;
    skos:definition "The creation of images, usually of a part of the earth, obtained from satellites equipped with cameras or other imaging equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite imaging"@en .

aat:300412043 a skos:Concept ;
    skos:definition "Digital distortion that occurs when a sampling frequency is too low, as in jagged stair-stepping in curved lines or transitions in images. In sound, aliasing occurs when the sampling rate drops below 40 kilohertz (Khz)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aliasing"@en .

aat:300412044 a skos:Concept ;
    skos:definition "Process by which a continuous tone digital image is applied to receiver materials via thermal transfer of cyan, yellow, and magenta dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dye diffusion thermal transfer printing"@en .

aat:300412045 a skos:Concept ;
    skos:definition "The ratio of the distance between highest and lowest values of a quantity. This is most often applied to recorded sound and light signals in audio recording and photographic contexts. It determines the range of intensity that may be reliably transmitted through any particular system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamic range"@en .

aat:300412046 a skos:Concept ;
    skos:definition "Memory components of computers held on chips that retain data and instructions in a quickly accessible state that bypasses the usage of the computer's CPU."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DRAM"@en .

aat:300412047 a skos:Concept ;
    skos:definition "Instruction sets or programs that are stored in ROM or programmable modules in devices such mobile phones, digital cameras, remote controls, or electronic musical instruments to control their functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firmware"@en .

aat:300412048 a skos:Concept ;
    skos:definition "Computer interfaces in which software, files, or other data are represented by visual display with graphical symbols, icons, or menu items. These can be manipulated to allow functions to be performed without the use of a command language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "GUIs"@en .

aat:300412049 a skos:Concept ;
    skos:definition "Diagrams consisting of adjacent graphs that represent variables and quantities for statistics and data representation. In digital photography, histograms represent the tabulation of the number of exposed pixels for each gray level of a digital color image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "histograms"@en .

aat:300412051 a skos:Concept ;
    skos:definition "In electronic imaging and digital photography, indexed color is the reference color mapping for 8-bit or less computer monitors, in order to reduce images to their smallest file sizes, allowing for quick download and easy display of images on web pages. An 8-bit monitor indexes 256 unique color codes for each pixel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexed color"@en .

aat:300412052 a skos:Concept ;
    skos:definition "The action or method of inserting intermediate elements in a series, in that the quality of the new elements is ascertained by the known elements surrounding it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interpolation"@en .

aat:300412053 a skos:Concept ;
    skos:definition "Designated places, may be settled but not necessarily so, where people gather to exchange goods or produce. Emporia that are not settlements are often found in rural or in historical contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emporia"@en .

aat:300412057 a skos:Concept ;
    skos:definition "Refers to the resolution capability of electronic imaging devices such as computer monitors, digital cameras, televisions, or scanners, expressed as the number of pixels per linear distance (pixels per inch or pixels per centimeter). Pixel density can also describe the resolution of image files."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pixel density"@en .

aat:300412058 a skos:Concept ;
    skos:definition "The resolution of electronic imaging devices such as computer monitors, digital cameras, televisions, or scanners, expressed as the number of pixels per linear centimeter. Pixels per centimeter also describes the resolution of image files."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pixels per centimeter"@en .

aat:300412059 a skos:Concept ;
    skos:definition "Literature, stories, and oral traditions having to do with the beginnings of a culture, civilization, peoples, land, deity, hero, or other entity; often associated with religious beliefs or mythology. Origins stories are most often literary or legendary; they are typically not historical, in that they are not documented and not considered true by those outside the culture or belief system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "origins stories"@en .

aat:300412063 a skos:Concept ;
    skos:definition "Places, whether inhabited or not, that serve as a focal point of worship, gathering, or other activity of a particular cult."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cult centers"@en .

aat:300412066 a skos:Concept ;
    skos:definition "Spiritual places in the Inca religion. Included are Pre-Columbian Inca tombs or temples, usually a truncated pyramid of stone, and often of immense size. Huacas could also be caves, springs, special rocks, and man-made shrines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huacas"@en .

aat:300412067 a skos:Concept ;
    skos:definition "Genus containing nearly 1,000 species of shrubs, herbaceous perennials, and annuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salvia"@en .

aat:300412068 a skos:Concept ;
    skos:definition "People, almost always male, who are revered in a society for their profound wisdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sages"@en .

aat:300412069 a skos:Concept ;
    skos:definition "Characters known from legend and stories, whether or not there is a counterpart in recorded history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legendary characters"@en .

aat:300412070 a skos:Concept ;
    skos:definition "Units of length, now obsolete, used in several European countries. In England, one ell corresponded to approximately 45 inches. In Scotland, 37.2 inches. The Flemish ell corresponded to 27 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ells"@en .

aat:300412071 a skos:Concept ;
    skos:definition "A wind blowing from the north."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "north wind"@en .

aat:300412072 a skos:Concept ;
    skos:definition "General term for beings who inhabit the spiritual or otherworldly realms, or who inhabit the physical world but have powers and abilities of the supernatural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supernatural beings"@en .

aat:300412073 a skos:Concept ;
    skos:definition "A wind blowing from the south."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "south wind"@en .

aat:300412074 a skos:Concept ;
    skos:definition "A wind blowing from the west."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "west wind"@en .

aat:300412075 a skos:Concept ;
    skos:definition "A wind blowing from the east."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "east wind"@en .

aat:300412076 a skos:Concept ;
    skos:definition "Measurement for internet connection speeds; preceded by a numerical value, denotes the download and upload speeds of digital data passing through a data transmission system, one megabit being equal to one million bits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbps"@en .

aat:300412077 a skos:Concept ;
    skos:definition "A measurement unit of frequency, equal to 1000 megahertz (MHz). Used most often in reference to computer processing speeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gigahertz"@en .

aat:300412078 a skos:Concept ;
    skos:definition "Unit of frequency representing one million cycles per second (hertz). It is used mostly to measure the transmission speed of electronic devices such as personal computers, particularly CPU speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megahertz"@en .

aat:300412079 a skos:Concept ;
    skos:definition "The standard or base unit of frequency in the international System of Units defined as one cycle per second."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hertz"@en .

aat:300412080 a skos:Concept ;
    skos:definition "Units of measurement of electrical current in the International System of Units, and defined as the intensity of the constant current which, when maintained in two parallel straight conductors of infinite length and of negligible cross section placed one metre apart in a vacuum, produced between them a force equal to 2 × 10−7 M.K.S. units of force per metre length. Defined by the International Weights and Measures Congress in 1948. It replaced the international ampere which had been defined in 1908."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amperes"@en .

aat:300412081 a skos:Concept ;
    skos:definition "In computer graphics, dots that form an image such as in bitmapped graphics that correspond to an orthagonal grid of scanned lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rasters"@en .

aat:300412082 a skos:Concept ;
    skos:definition "The action of removing the hair from the head or face with a razor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving"@en .

aat:300412084 a skos:Concept ;
    skos:definition "Infinite time, which has neither beginning nor end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eternity"@en .

aat:300412085 a skos:Concept ;
    skos:definition "The culture and style of people of African descent living in or coming from the Caribbean, particularly the West Indies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afro-Caribbean"@en .

aat:300412086 a skos:Concept ;
    skos:definition "Those who practice trickery and cheating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tricksters"@en .

aat:300412087 a skos:Concept ;
    skos:definition "The rate or recurrence of a repeating vibration, cycle, or wave passing a fixed point in unit time. In physics, frequency is expressed in hertz units, as one cycle per second, or Hz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frequency"@en .

aat:300412089 a skos:Concept ;
    skos:definition "Unit of frequency representing one thousand cycles per second (hertz). It is used mostly to measure the transmission speed of electronic devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kilohertz"@en .

aat:300412090 a skos:Concept ;
    skos:definition "The style and culture of the confederacy of tribes that spoke Aramaic (a North Semitic language) and, between the 11th and 8th century BCE, occupied Aram, a large region in northern Syria. In the same period some of these tribes seized large tracts of Mesopotamia. The first mention of the Aramaeans occurs in inscriptions of the Assyrian king Tiglath-pileser I (1115-1077 BCE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aramaean"@en .

aat:300412092 a skos:Concept ;
    skos:definition "Professional photographs created for advertising, communication, display, instruction, or other industrial uses. Typically commercial photography appears in catalogs, brochures, manuals, press releases, and advertisements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial photographs"@en .

aat:300412093 a skos:Concept ;
    skos:definition "The activity of creating photographs to promote products or services to the public. This is often commissioned or produced by advertising agencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising photography"@en .

aat:300412094 a skos:Concept ;
    skos:definition "The activity of creating photographs for advertising, communication, display, instruction, or other industrial uses. Typically commercial photography is undertaken for catalogs, brochures, manuals, press releases, and advertisements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial photography"@en .

aat:300412096 a skos:Concept ;
    skos:definition "The worth of a thing based on estimating or fixing the monetary value. Valuation is not tied only to the market value of the thing; it may record the cost or price paid for the thing, or calculate intangibles such as scarcity, popularity, and the likelihood of value increasing. For the records of valuation, use \"appraisals (financial records).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valuation"@en .

aat:300412097 a skos:Concept ;
    skos:definition "The concept that a spiritual being or deity may take human or other physical form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incarnation"@en .

aat:300412098 a skos:Concept ;
    skos:definition "As a doctrinal concept, the form or means of existence that may be taken by a spirit or deity; a single spirit or deity may have multiple manifestations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manifestation"@en .

aat:300412099 a skos:Concept ;
    skos:definition "Actions or displays of daring, courage, valor, or fortitude."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bravery"@en .

aat:300412100 a skos:Concept ;
    skos:definition "Actions or displays of lack of courage to face danger; faint-heartedness, or pusillanimity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowardice"@en .

aat:300412101 a skos:Concept ;
    skos:definition "Activity, status, or expression of thankfulness or gratitude for a blessing or good fortune."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thanksgiving"@en .

aat:300412102 a skos:Concept ;
    skos:definition "The activity of announcing, proclaiming, or declaring in an official or public manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annunciation"@en .

aat:300412103 a skos:Concept ;
    skos:definition "Material that causes illness or death when absorbed, inhaled, or ingested by a living organism; particularly when the substance is able to kill by rapid action and when taken in small quantity. For a toxic material secreted by an animal and injected into a victim, use \"venom.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poison"@en .

aat:300412105 a skos:Concept ;
    skos:definition "Carbon prints created by the superimposition of three monochromatic carbon prints in register. Each of these register prints is in a subtractive primary color, exposed from color separations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color carbon prints"@en .

aat:300412106 a skos:Concept ;
    skos:definition "Carbon printing process that creates prints by superimposition of three monochromatic carbon plates in register. Each of these register plates is in a subtractive primary color, exposed from color separations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color carbon process"@en .

aat:300412107 a skos:Concept ;
    skos:definition "Characters featured or depicted in religious or mythological works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious characters"@en .

aat:300412108 a skos:Concept ;
    skos:definition "Of, relating to, or characteristic of the teachings of rabbis that constitute the Talmud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbinical"@en .

aat:300412109 a skos:Concept ;
    skos:definition "Flexible, sterile tubes that pass throught the urethra and into the bladder to drain urine. These feature two separate channels, one to drain liquid, and one to keep the catheter in place through the use of a balloon filled with sterile water. This type of catheter was developed by the urologist Frederic E.B. Foley in the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Foley catheters"@en .

aat:300412110 a skos:Concept ;
    skos:definition "Angels of the highest rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archangels"@en .

aat:300412111 a skos:Concept ;
    skos:definition "The activity or function of restoring a person or animal to health, to aid in treatment of wounds, recovery from sickness, or otherwise curing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "healing"@en .

aat:300412112 a skos:Concept ;
    skos:definition "Places that are known in legend, myth, or religion, but generally not believed to correspond to a real place. For inhabited places that are documented and believed to have existed, but the location is unknown, use \"lost settlements.\" For places known to be drawn from fantasy or imagination, use \"imaginary places.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legendary places"@en .

aat:300412113 a skos:Concept ;
    skos:definition "Deities associated with, or personifications of, the planets, sun or other stars, or the moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planetary gods"@en .

aat:300412114 a skos:Concept ;
    skos:definition "The culture and nationality of ancient Troy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trojan"@en .

aat:300412115 a skos:Concept ;
    skos:definition "Representations, realistic or stylized, of a penis, usually erect; often seen as a symbol of the generative power in nature, venerated in various religions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phalluses"@en .

aat:300412116 a skos:Concept ;
    skos:definition "Concept concerning the ability to recognize and follow the most suitable or sensible course of action, utilizing good sense, discretion, circumspection, caution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prudence"@en .

aat:300412117 a skos:Concept ;
    skos:definition "Actions of resisting, opposing, or withstanding someone or something, including organized or covert opposition to an invading, occupying, or ruling power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistance"@en .

aat:300412118 a skos:Concept ;
    skos:definition "Mythical creatures that are part animal and part human, or combine elements of two or more animal forms; frequently of great size and ferocious appearance. May also apply to any imaginary creatures that are large, ugly, and frightening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monsters"@en .

aat:300412119 a skos:Concept ;
    skos:definition "Style or culture having aspects of ancient Egyptian and Greek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greco-Egyptian"@en .

aat:300412120 a skos:Concept ;
    skos:definition "In Ancient Greece and Rome, wood-gods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sileni"@en .

aat:300412121 a skos:Concept ;
    skos:definition "Style and culture of the island of Curaçao, a Dutch constituency, in the Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Curacçaoan"@en .

aat:300412122 a skos:Concept ;
    skos:definition "Formal poetry expressing personal emotions or feelings; in Ancient Greek literature, defined by its musical accompaniment on the lyre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyric poetry"@en .

aat:300412123 a skos:Concept ;
    skos:definition "Stylized wooden masks covering the face of participants in gigaku, a type of Japanese dance drama. Gigaku masks are the first known masks used in Japan and among the world’s oldest extant masks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gigaku masks"@en .

aat:300412124 a skos:Concept ;
    skos:definition "Masks used to cover the face of actors in plays or other performances; often stylized, having exagerated features, and standard in the depiction of emotions or of stock characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theatrical masks"@en .

aat:300412125 a skos:Concept ;
    skos:definition "Masks used by actors in Ancient Greek and Roman theater, having many standard variations, representing serious or tragic facial expressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tragic masks"@en .

aat:300412126 a skos:Concept ;
    skos:definition "Masks used by actors in Ancient Greek and Roman theater, having many standard variations, representing comical or silly expressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comic masks"@en .

aat:300412127 a skos:Concept ;
    skos:definition "Staffs, often having a hook at one end, for managing sheep, goats, and herds of other relatively small livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shepherd's staffs"@en .

aat:300412128 a skos:Concept ;
    skos:definition "The quality, faculty, or aptitude for creating unique solutions to problems, or of inventng new things, language, art, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inventiveness"@en .

aat:300412129 a skos:Concept ;
    skos:definition "Events concerning the conceiving of offspring in the womb; when a person or other animal begins life through the impregnation of a mother. The moment when egg and sperm are joined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conceptions"@en .

aat:300412130 a skos:Concept ;
    skos:definition "Flat-panel video displays for computers and other such devices that utilize ionized gas, or plasma, to illuminate pixels on the screen which emits a bright light that reflects focused color and images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasma display panels"@en .

aat:300412131 a skos:Concept ;
    skos:definition "Proprietary name for a type of television camera tube similar to a vidicon, but in which the photoconductive layer of the signal plate is of lead monoxide; noted for their ability to form images in low light. The plumbicon allowed the development of the color television camera.These have been used in cameras intended for surveillance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plumbicons (TM)"@en .

aat:300412132 a skos:Concept ;
    skos:definition "Formats and systems endorsed by the NTSC, which sets the television and video standards for the United States. The standard television signal set by the NTSC is composite video, which is compiled of red, blue, and green signals. The NTSC standard TV image has 525 horizontal lines per frame. Alternate standards include HDTV (high-definition television), as well as Phase Alternate Line (PAL) or Sequential Couleur avec Memoire (SECAM) primarily adopted in other areas of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "NTSC system"@en .

aat:300412133 a skos:Concept ;
    skos:definition "The process of determining the the dimensions of an image to be reproduced in another size, retaining the proportions of the original. In electronic imaging, scaling is accomplished through applying percentages to the original proportions, where 100 percent represents the original image measurements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaling"@en .

aat:300412134 a skos:Concept ;
    skos:definition "In computing, standard input/output communications ports used to control peripherals such as modems. They convey data one bit at a time in sequence, making them slower than parallel ports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serial ports"@en .

aat:300412135 a skos:Concept ;
    skos:definition "Standard input/output communications ports to control peripherals on the Macintosh platform. Peripherals may include hard drives, printers, flash drives, and other such communication devices. The SCSI allows fast communication between devices and now allows for multiple peripherals to be used in a single port."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "SCSI"@en .

aat:300412136 a skos:Concept ;
    skos:definition "An image sharpening technique introduced in Germany in the 1930s that increases the perceived acutance of photographic images. This is achieved through the use of an intermediate positive that is slightly blurred coupled with the original negative. When light is projected through the in-register negative and positive, some information is cancelled from the negative. The original photomechanical process has been reproduced in digital image processing to achieve a similar effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unsharp masking"@en .

aat:300412137 a skos:Concept ;
    skos:definition "The function or activity of making considered decisions or to arriving at conclusions or opinions, particularly when the conclusions are resonable and based on available information, employing critical faculty; discernment, and discrimination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judging"@en .

aat:300412138 a skos:Concept ;
    skos:definition "Direct positive paper produces black-and-white positive prints directly without relying on the film negative in the print's production. It is coated with a silver gelatin emulsion for reversible emulsion and has been used primarily for pinhole photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct positive paper"@en .

aat:300412139 a skos:Concept ;
    skos:definition "Dances of a particular type from the Republic of Congo and nearby areas, probably originally associated with initiation rites. Today the dance has become popularized and secularized, forming part of the Congolese folkloric traditions and performed on state and other national festival occasions. The dancers wear or hold kebe-kebe masks or heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kebe-kebe"@en .

aat:300412140 a skos:Concept ;
    skos:definition "A combination of favorable circumstances or events occurring by chance; success, prosperity, or advantage apparently brought about by chance rather than through one's own actions or abilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "good luck"@en .

aat:300412141 a skos:Concept ;
    skos:definition "A combination of adverse circumstances or events occurring by chance; a person's apparent tendency to have ill fortune; misfortune."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bad luck"@en .

aat:300412142 a skos:Concept ;
    skos:definition "As a doctrinal concept, the origination of created beings from a deity or spirit in a way that imbues the new being with some of the essence of the deity or spirit; as distinct from act of creation out of nothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emanation"@en .

aat:300412143 a skos:Concept ;
    skos:definition "Persons who maintain theological or religious opinions that vary from an orthodox doctrine, particularly that of the Christian Church, but also by extension any religious system, considered as established."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heretics"@en .

aat:300412144 a skos:Concept ;
    skos:definition "Persons whose actions or attributes are characterized, influenced, or prompted by excessive or mistaken enthusiasm especially in religious contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanatics"@en .

aat:300412145 a skos:Concept ;
    skos:definition "Persons who are extremely rigorous in the practice of self-denial, whether by seclusion or by abstinence from creature comforts, usually as a result of religious practice.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ascetics"@en .

aat:300412146 a skos:Concept ;
    skos:definition "Persons who are excessively or fanatically devoted to a cause or ideal, especially a religious or political one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zealots"@en .

aat:300412147 a skos:Concept ;
    skos:definition "Persons who obey or are guided by the opinions or teaching of another; an adherent, disciple, pupil, or devotee frequently used with religious or philosophic connotations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "followers"@en .

aat:300412148 a skos:Concept ;
    skos:definition "Activities involving an expression of sorrow for sin or wrongdoing, self-mortification, or the undergoing of some penalty as as a token of repentance and as a means of satisfaction for sin. Penance may be imposed by ecclesiastical or other authority or voluntarily undertaken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penance"@en .

aat:300412149 a skos:Concept ;
    skos:definition "Deities or supernatural powers who are protectors, guardians, or patrons who watch over a particular person, place, or thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tutelaries"@en .

aat:300412150 a skos:Concept ;
    skos:definition "Deities, often among the most powerful deities, whose primary role is to act as guardian or protector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guardian deities"@en .

aat:300412155 a skos:Concept ;
    skos:definition "Research into the evolution of the book and its variants (pamphlets, newspapers, broadsheets) in all aspects of its production, dissemination and consumption in relation to literary, political, economical, social and religious history. The history of the book includes subjects such as the production of manuscripts in medieval scriptoria, authorship, printing techniques, economic aspects of printing and publishing, design, printshops and publishing houses, trade, ownership and reading culture, typography, typesetting and printing techniques, and book collecting and connoisseurship. Use \" literary history\" Use “literary history” for the study of literary trends and movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book history"@en .

aat:300412156 a skos:Concept ;
    skos:definition "Confederation of tribes, primarily aggressive seafarers, who invaded eastern Anatolia, Syria, Palestine, Cyprus, and Egypt toward the end of the Bronze Age, in the 13th and 12th centuries BCE. They may be associated with the Philistines, among other groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sea Peoples"@en .

aat:300412157 a skos:Concept ;
    skos:definition "Currency issued by the French revolutionary government between 1789 and 1796, in the form of paper money and based on the security of the state lands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assignat"@en .

aat:300412158 a skos:Concept ;
    skos:definition "Austrian unit of currency 1925-2002, with a lapse during WWII. It was replaced by the Euro as the country’s sole currency in 2002."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austrian Shilling"@en .

aat:300412159 a skos:Concept ;
    skos:definition "Unit of French currency of varying value, known from the Middle Ages until the French Revolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "écu"@en .

aat:300412160 a skos:Concept ;
    skos:definition "Unit of German currency of varying value minted as gold coins by several German states from 1354."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German florin"@en .

aat:300412161 a skos:Concept ;
    skos:definition "Florentine gold coins struck from 1252 until the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiorini d'oro"@en .

aat:300412162 a skos:Concept ;
    skos:definition "General term for a number of historical gold coins of Germany and the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gulden"@en .

aat:300412163 a skos:Concept ;
    skos:definition "Unit of English currency, issued as a gold coin first struck in 1663."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guinea"@en .

aat:300412164 a skos:Concept ;
    skos:definition "General term for the principal monetary unit of Denmark and of Norway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "krone"@en .

aat:300412165 a skos:Concept ;
    skos:definition "General term for any of a number of monetary in use in France between the 8th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livre"@en .

aat:300412166 a skos:Concept ;
    skos:definition "General term for units of currency based on gold coins of France issued in the reign of Louis XIII and subsequently till the time of Louis XVI."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louis"@en .

aat:300412167 a skos:Concept ;
    skos:definition "General term for units of currency based on English silver or cupronickel coins valued at twelve pence and minted from the mid-16th century until 1970."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shilling"@en .

aat:300412168 a skos:Concept ;
    skos:definition "General term for units of currency based on various large silver coins of Central Europe minted from the late 15th to the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thaler"@en .

aat:300412169 a skos:Concept ;
    skos:definition "From 1924 to 1948, used as the official designation of the German currency. Later historical use chiefly refers to this official designation during this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reichsmark"@en .

aat:300412170 a skos:Concept ;
    skos:definition "General term for unit of currency of various values, used from the late 16th to the mid-19th centuries in various European countries, particularly in the Netherlands, the Holy Roman Empire, the Austrian Empire, Sweden, Denmark, and Scotland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reichsthaler"@en .

aat:300412171 a skos:Concept ;
    skos:definition "General term for unit of currency of various values, used in Germany and Austria before the establishment of the present monetary systems; based on a small silver coin that equaled a portion of a thaler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groschen"@en .

aat:300412172 a skos:Concept ;
    skos:definition "General term for unit of currency of various values, historically used in the Netherlands and Belgium; based on a small coin, originally silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stiver"@en .

aat:300412173 a skos:Concept ;
    skos:definition "People who play any of several related roles in public distribution or sale of property. An example of a commissaire-priseur is a ministerial officer who appraises movable property and sells it at public auctions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissaires-priseurs"@en .

aat:300412174 a skos:Concept ;
    skos:definition "People active in public distribution or sale of property as the official recorders of the transaction and prices paid. In certain cases, this person may have worked with the \"commissaires-priseurs,\" or may have been in charge of recording as well as valuing the works for sale, adjudicating, and bringing down the hammer for the sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huissiers-priseurs"@en .

aat:300412175 a skos:Concept ;
    skos:definition "The activity or sport of riding a bicycle or any cycle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cycling"@en .

aat:300412177 a skos:Concept ;
    skos:definition "Numbers that firms such as commercial art dealers or galleries may assign to objects when taking them in to stock. These are typically written or affixed on the objects themselves, and can be used to associate particular objects with entries in a stock or sales book. These numbers are not necessarily unique, and objects may have multiple stock numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock numbers"@en .

aat:300412179 a skos:Concept ;
    skos:definition "Buildings that house organizations or businesses that present independent films with artistic rather than commercial appeal including foreign or experimental films, or revivals of older releases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art house cinemas"@en .

aat:300412186 a skos:Concept ;
    skos:definition "The action of performing or executing work or labor, particularly as one's paid employment,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "working"@en .

aat:300412187 a skos:Concept ;
    skos:definition "Styles and periods of art and architecture during the late Renaissance; flourished at the royal palace at Fontainebleau. Describes work in a variety of media, including painting, sculpture, stuccowork and printmaking produced from the 1530s to the first decade of the 17th century, primarily in France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "School of Fontainebleau"@en .

aat:300412188 a skos:Concept ;
    skos:definition "Files or sets of files, which may contain text, images, video or audio recordings, or other types of information. Data is copied from the main source, whether the internet or computer, and transferred to a peripheral device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downloads"@en .

aat:300412189 a skos:Concept ;
    skos:definition "Standardized ideogrammatic symbols used to represent concepts, emotional states, or other information wordlessly and succinctly in electronic communications such as text messages, e-mail, and social media. Originally Japanese, from e: “picture, drawing” and moji “letter, character.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emoji"@en .

aat:300412190 a skos:Concept ;
    skos:definition "General term for several currencies used in Denmark until 1875."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Danish rigsdaler"@en .

aat:300417191 a skos:Concept ;
    skos:definition "Sparkling wine named for the region of Champagne in northeastern France where it is traditionally produced. The term is frequently applied generically to other sparkling wines, with restrictions, outside France. In the United States, sparkling wines made in a similar manner are designated by place of origin, as in New York state champagne, or elsewhere as “champagne-style.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "champagne"@en .

aat:300417192 a skos:Concept ;
    skos:definition "General term for a popular type of paper that is blue in color and historically was used primarily as artists' drawing paper and for some other uses; first documented in 1389 in Europe. The dyes used to create the blue or purplish color vary by place of manufacture. The term is often reserved for Western drawing papers produced prior to the introduction of aniline dyes in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue paper"@en .

aat:300417193 a skos:Concept ;
    skos:definition "Words or phrases, often descriptive or evocative, used to identify or provide reference to a work, including physical works, performances, literary works, and conceptual works. May apply to individual items or works, or to groups or series of items, in any medium. Titles may also be initials, numbers, or symbols. Examples are titles or names of works of art and architecture. For numeric or alphanumeric IDs or codes for uniquely identifying a work, prefer \"identification numbers.\" To refer specifically to titles printed or inscribed on a book or other object, such as on the title page, prefer \"titles (partial documents).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titles"@en .

aat:300417194 a skos:Concept ;
    skos:definition "Titles or names that have been translated into a language other than the original language, or expressed in a writing system other than the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "translated titles"@en .

aat:300417195 a skos:Concept ;
    skos:definition "In book cataloging, a parallel title is the title proper of an edition in a language or script other than that of the original title. For example, if the original Chinese title is translated into English for cataloging purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel titles"@en .

aat:300417196 a skos:Concept ;
    skos:definition "In book cataloging, the title proper is the primary name of a bibliographic item, including any alternative title but not parallel titles and other title information. The title proper is entered in the title and statement of responsibility area of the bibliographic description. The title proper is usually found on the chief source of information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titles proper"@en .

aat:300417197 a skos:Concept ;
    skos:definition "In book cataloging, a uniform title is the distinctive title selected for cataloging purposes to represent a work issued under more than one title, usually in more than one expression or manifestation. For example, uniform titles are commonly used to catalog sacred texts and liturgical and musical works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uniform titles"@en .

aat:300417198 a skos:Concept ;
    skos:definition "Compound titles for a work that contain reference to both the part and the whole, or to two parts in a single title. In library cataloging, a collective title may be the title proper of a bibliographic item containing several works by one or more authors issued in a single volume or uniform set of volumes, each with its own title distinct from that of the whole. Also refers to the title assigned by a bibliographic cataloger to a group of separately published materials cataloged collectively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collective titles"@en .

aat:300417199 a skos:Concept ;
    skos:definition "Titles that describe what a work is of or about. In art cataloging, descriptive titles are intended to adequately describe what the work is or what the iconography depicted in the work represents. In retrieval, it is designed to be used with other information about the work to uniquely distinguish it from other works in the same results list."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "descriptive titles"@en .

aat:300417200 a skos:Concept ;
    skos:definition "Titles preferred by the repository of a work. For example, in cataloging works of art, the title assigned by the repository that houses the work is often given preference over other titles for the same work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repository titles"@en .

aat:300417201 a skos:Concept ;
    skos:definition "In cataloging works of art, architecture, music, and other creative works, the titles assigned to the work by the creator or creators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist's titles"@en .

aat:300417202 a skos:Concept ;
    skos:definition "Titles or names of works that are written, stamped, or printed on the work. For works of art, it may include any part of an inscription that is clearly intended by the creator or publisher to serve as a title or that the cataloging institution wishes to record as a title. For manuscript or book cataloging, it is the title on the title page or found elsewhere in the book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inscribed titles"@en .

aat:300417203 a skos:Concept ;
    skos:definition "Titles by which a work of art, structure, book, or other such entity was known in the past, but by which it is no longer known or which is considered otherwise outdated. For former designations of people, coprorate bodies, or places, prefer \"former names (names).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former titles"@en .

aat:300417204 a skos:Concept ;
    skos:definition "Titles or names that were originally assigned to a work or assigned soon after its creation. It may refer to a former title or to a title that has been translated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "original titles"@en .

aat:300417205 a skos:Concept ;
    skos:definition "Titles or names that have been supplied by the cataloger in cases where supporting information or description of a work lacks a title. Constructed titles may be derived from other text in or on the work or invented as a descriptive title or name by the cataloger. In book cataloging, an example is when a title proper is not included on a title page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constructed titles"@en .

aat:300417206 a skos:Concept ;
    skos:definition "Titles or names that have been used to refer to the work in publications. For works of art and architecture, examples are titles or names in catalogs or journal articles that are not necessarily a title by which the work is normally known. For books, the term may be used to distinguish the final published title from an original unpublished or working title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "published titles"@en .

aat:300417207 a skos:Concept ;
    skos:definition "For art cataloging, titles or names by which the work has been known in exhibitions, particularly when different from titles by which the work is normally known. This term does not refer to the names of exhibitions themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition titles"@en .

aat:300417208 a skos:Concept ;
    skos:definition "Titles that are shortened versions of another title, designed for convenience to identify the work in certain brief displays, such as for captions, wall labels, in an entry in Web navigation displays, or in text. In book cataloging, called the short title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brief titles"@en .

aat:300417209 a skos:Concept ;
    skos:definition "Titles that are the most complete or longest versions of the title, as distinguished from shorter versions of the title. In legal writing, called the long title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full titles"@en .

aat:300417210 a skos:Concept ;
    skos:definition "Shortened versions of a name or title, using abbreviations instead of spelling out words. Applied only to titles or names using abbreviations to a significant extent, typically not when a single word is abbreviated. For personal names, use abbreviated names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbreviated titles"@en .

aat:300417211 a skos:Concept ;
    skos:definition "Series of numbers, key letters, words, or symbols used for identification of an entity, often in place of a name or title or used to stand for a longer word or concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "code numbers"@en .

aat:300417212 a skos:Concept ;
    skos:definition "In book cataloging, titles comprising the title proper along with any other information, such as general material designation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "title statements"@en .

aat:300417214 a skos:Concept ;
    skos:definition "Titles applied to series, which are groups of separately created works or separately published materials that comprise a conceptual grouping and were created or released in succession by the same author, artist, studio, or publisher and intended to be seen together or in succession as a cycle of works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "series titles"@en .

aat:300417215 a skos:Concept ;
    skos:definition "Titles applied to collections, which are accumulated groups of objects or materials having a focal characteristic and that have been brought together by an individual or organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collection titles"@en .

aat:300417216 a skos:Concept ;
    skos:definition "Titles applied to archival groups, which are aggregates of items that share a common provenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "group titles"@en .

aat:300417217 a skos:Concept ;
    skos:definition "Titles applied to sub-groups, which are aggregates of items forming a sub-group within an archival group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sub-group titles"@en .

aat:300417218 a skos:Concept ;
    skos:definition "Titles or names that are used for a work or other entity in popular culture, but are not the official or repository title or name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popular titles"@en .

aat:300417219 a skos:Concept ;
    skos:definition "Names or titles given to products, techniques, or concepts by the inventor, maker, or distributor and legally belonging to the inventor, maker, or distributor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brand names"@en .

aat:300417220 a skos:Concept ;
    skos:definition "Single distinct meaningful elements of speech or writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "words"@en .

aat:300417221 a skos:Concept ;
    skos:definition "Small groups or collocations of words expressing a single notion, or entering with some degree of unity into the structure of a sentence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phrases"@en .

aat:300417222 a skos:Concept ;
    skos:definition "Series of words in connected speech or writing, forming the grammatically complete expression of a single thought."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sentences"@en .

aat:300417223 a skos:Concept ;
    skos:definition "A distinct passage or section of a text, usually composed of several sentences, dealing with a particular point, a short episode in a narrative, a single piece of direct speech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paragraphs"@en .

aat:300417224 a skos:Concept ;
    skos:definition "Expressions of words by letters that are incorrect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misspellings"@en .

aat:300417225 a skos:Concept ;
    skos:definition "Titles applied to a volumes, which are objects comprising sheets of paper, vellum, papyrus, or another material that are bound together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volume titles"@en .

aat:300417226 a skos:Concept ;
    skos:definition "In book cataloging, the second part of a title proper that consists of two parts, each a title in itself, connected by the word \"or\" or its equivalent in another language (example: The Female Quixote, or, The Adventures of Arabella). Distinguished from \"alternate titles\" and \"subtitles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alternative titles"@en .

aat:300417227 a skos:Concept ;
    skos:definition "Titles that vary from the primary title. Distinguished from \"alternative titles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alternate titles"@en .

aat:300417228 a skos:Concept ;
    skos:definition "Titles used temporarily while a more permanent title is devised. An example is the title provided by an author at the time a manuscript is submitted to the publisher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "working titles"@en .

aat:300417229 a skos:Concept ;
    skos:definition "Titles or abbreviated titles of a book, or section of a book, repeated in uniform style at the head or foot of each page or verso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running titles"@en .

aat:300417230 a skos:Concept ;
    skos:definition "Titles stamped or lettered on the spine of a bound volume by the binder, as distinct from the cover title on the publisher's edition and the title printed on the title page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binder's titles"@en .

aat:300417231 a skos:Concept ;
    skos:definition "Titles written or impressed on the spine of a volume, sometimes a shortened form of the title appearing on the cover. Distinguished from \"binder's titles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spine titles"@en .

aat:300417232 a skos:Concept ;
    skos:definition "Titles that appear at the beginning of a chapter in a book or other publication, usually bearing some relation to the content of the division of the work. Chapters may simply be numbered or given a number and a title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapter titles"@en .

aat:300417233 a skos:Concept ;
    skos:definition "Titles printed or impressed on the cover of a publication as issued by the publisher, which may be a shortened form of the title proper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cover titles"@en .

aat:300417234 a skos:Concept ;
    skos:definition "The titles impressed on the outside of the front cover of a book, or written or printed on a label pasted to the cover, sometimes a shortened version of the title proper printed on the title page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side titles"@en .

aat:300417235 a skos:Concept ;
    skos:definition "Titles of a book as printed, in full or in brief, on the recto of a leaf preceding the title page; usually in a smaller font size than the font in which the title proper is printed on the title page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half titles"@en .

aat:300417236 a skos:Concept ;
    skos:definition "Titles of books printed on the recto of the leaf preceding the first page of the text of a major division of the book, sometimes with the number of the division."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divisional titles"@en .

aat:300417237 a skos:Concept ;
    skos:definition "Expressions of words with letters, in wrting or verbally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spellings"@en .

aat:300417238 a skos:Concept ;
    skos:definition "Surnames composed of two or more proper names, usually joined by a hyphen, preposition, or conjunction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compound surnames"@en .

aat:300417239 a skos:Concept ;
    skos:definition "Names or titles formed by joining two or more other names or titles. Names or titles may be joined with a hyphen, conjunction, preposition, or parentheses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compound names"@en .

aat:300417240 a skos:Concept ;
    skos:definition "Prices that are established for certain goods or services and cannot be negotiated. Examples are fixed prices for a certain meal on a restaurant menu, prices set at a bazaar where it is otherwise customary to haggle a lower price, or prices for a market commodity that are set rather than flutuating based on demand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed prices"@en .

aat:300417241 a skos:Concept ;
    skos:definition "The prices asked for or set by a seller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asking prices"@en .

aat:300417242 a skos:Concept ;
    skos:definition "The initial prices of commodities. An example is the price at which the bidding at an auction is started."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starting prices"@en .

aat:300417243 a skos:Concept ;
    skos:definition "The amounts stipulated, usually by the vendor, as the lowest acceptable price for an item being sold at auction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reserve prices"@en .

aat:300417244 a skos:Concept ;
    skos:definition "Prices estimated to be achieved for something prior to the sale. An example is the price that an auction house estimates in advance of the auction or the price estimated by a broker to be achieved for a stock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estimated prices"@en .

aat:300417245 a skos:Concept ;
    skos:definition "The prices set when a period of competitive selling is over, traditionally indicated by the banging of a gavel. Examples are the price realized for shares closed at the hammer on a stock exchange or the last price of bidding for an item or lot at an auction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer prices"@en .

aat:300417246 a skos:Concept ;
    skos:definition "Prices at which something is sold, usually referring to a price that has been reduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sale prices"@en .

aat:300417247 a skos:Concept ;
    skos:definition "Prices fixed for an article in the printed list issued by the maker, or by the general body of makers of the particular class of goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "list prices"@en .

aat:300417248 a skos:Concept ;
    skos:definition "Current prices asked for a product, commodity, or service in a particular market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market prices"@en .

aat:300417249 a skos:Concept ;
    skos:definition "Prices arising from a situation in which supply and demand are matched and prices stable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equilibrium prices"@en .

aat:300417250 a skos:Concept ;
    skos:definition "The estimation of the price or value of property for the purposes of insurance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurance valuation"@en .

aat:300417251 a skos:Concept ;
    skos:definition "Mushroom-forming; parenthesomes imperforate or perforate (spore caps have openings); includes subclasses Agaricomycetidae and Phallomycetidae; contains 17 orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agaricomycetes"@en .

aat:300417252 a skos:Concept ;
    skos:definition "Agencies, bodies, or organizations that authorize or commission a publication, and under whose name the work is entered in catalog records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate authors"@en .

aat:300417253 a skos:Concept ;
    skos:definition "Producers of film, television, or another work, who supervise other producers; they may be involved with other activities such as funding. They may own the rights to the screenplay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executive producers"@en .

aat:300417254 a skos:Concept ;
    skos:definition "Actors in a play, film, television broadcast, performance art, or other performance who relate part of the plot to the audience or who speak a commentary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrators"@en .

aat:300417255 a skos:Concept ;
    skos:definition "The process or function of augmenting, revising, or otherwise bringing material up-to-date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "updating"@en .

aat:300417256 a skos:Concept ;
    skos:definition "The process or function of introducing new material or augmenting existing material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adding"@en .

aat:300417257 a skos:Concept ;
    skos:definition "The process or function of introducing new material; usage may overlap with \"adding.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creating"@en .

aat:300417258 a skos:Concept ;
    skos:definition "The process or function of subtracting material or records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deleting"@en .

aat:300417259 a skos:Concept ;
    skos:definition "The process or function of inserting material, typically used for material or data that was typed by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entering"@en .

aat:300417260 a skos:Concept ;
    skos:definition "The process or function of copying material or data to a computer drive, the cloud, or otherwise to a safe, more permanent location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saving"@en .

aat:300417261 a skos:Concept ;
    skos:definition "The process or function of copying or taking material or data from one place for use in another; for example, copying data out of a database for reconfiguration in a publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extracting"@en .

aat:300417262 a skos:Concept ;
    skos:definition "The process or function of copying or otherwise inserting data or material, such as files or a data, from one location into a database or other location by using automated methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loading"@en .

aat:300417263 a skos:Concept ;
    skos:definition "Extinct species of the genus Homo, probably an ancestor of modern humans (Homo sapiens). H. erectus most likely originated in Africa, although development in Eurasia is believed possible. The species seems to have dispersed quickly, starting about 1.9 million years ago (mya) near the middle of the Pleistocene Epoch, moving through the African tropics, Europe, South Asia, and Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homo erectus"@en .

aat:300417264 a skos:Concept ;
    skos:definition "Traditional signs displayed by Japanese merchants from the 17th-20th centuries to call attention to their shops and that graphically depict the products or services offered within. These are created from a variety of materials including wood, bamboo, iron, paper, fabric, or stone, and sometimes rely on visual puns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kanban"@en .

aat:300417265 a skos:Concept ;
    skos:definition "Popular risings against authority or for some common purpose, usually not as organized as an insurrection and may involve marches, riots, damaging of property, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil unrest"@en .

aat:300417266 a skos:Concept ;
    skos:definition "Decorative leather material produced by covering pieces of uniformly-sized vegetable-tanned leather with leaves of silver or tin foil and orange and yellow varnish that imparted a golden hue. Three-dimensional designs were added using stamps or embossing molds. Further color was added using paints and glazes. This material was then joined to create wall coverings, wall hangings, or screens. Gilt leather was also used as upholstery and book bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilt leather"@en .

aat:300417267 a skos:Concept ;
    skos:definition "Sociological concept having to do with behavior that embodies politeness in manners, considerateness in intercourse with others, and sometimes, courtly elegance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtesy"@en .

aat:300417268 a skos:Concept ;
    skos:definition "Texts associated with exhibitions or other displays in museum galleries, usually displayed on the walls or in handouts. Gallery texts typically give the context of the works in the context of importance or history. For the short texts displayed with the work, listing title, artist, date, etc., prefer \"tombstones (documents).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallery texts"@en .

aat:300417269 a skos:Concept ;
    skos:definition "The action or state of deceiving, concealing of the truth in order to mislead, fraud, cheating, or false dealing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deceit"@en .

aat:300417270 a skos:Concept ;
    skos:definition "The action or state of disharmony or disagreement between people, mutual antagonism, dissension, contention, or strife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discord"@en .

aat:300417271 a skos:Concept ;
    skos:definition "Actions and status of a dvinity's retributive justice by which the destiny of people or other creatures is decided, typically according to their merits and demerits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divine judgment"@en .

aat:300417272 a skos:Concept ;
    skos:definition "The action or state of being two-sided or double-dealing in action or conduct, of acting in two ways at different times, either openly or secretly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duplicity"@en .

aat:300417273 a skos:Concept ;
    skos:definition "Action or state of something having been incorrectly done through ignorance or inadvertence; a mistake, miscalculation, or bad judgment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "error"@en .

aat:300417274 a skos:Concept ;
    skos:definition "Action or condition of being much talked about, chiefly in a good sense. Reputation derived from great achievements, celebrity, honor, renown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fame"@en .

aat:300417275 a skos:Concept ;
    skos:definition "Physical manifestation of combustion, characterized by flames and the production of heat, light, and typically smoke; caused by the ignition and burning of flammable material in the presence of oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire"@en .

aat:300417276 a skos:Concept ;
    skos:definition "The quality or condition of feeling or expressing appreciation of kindness received, involving a feeling of goodwill towards the benefactor and a desire to do something in return; gratefulness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gratitude"@en .

aat:300417277 a skos:Concept ;
    skos:definition "The branch of knowledge that deals with events or conditions before written or recorded history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistory"@en .

aat:300417278 a skos:Concept ;
    skos:definition "The quality or state exhibited by soundness of moral principle, uprightness, honesty, sincerity, and uncorrupted virtue, particularly regarding truth and fair dealing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integrity"@en .

aat:300417279 a skos:Concept ;
    skos:definition "The painful emotion arising from the consciousness of something dishonoring, ridiculous, or indecorous in one's own conduct or circumstances of being in a situation which offends one's sense of modesty or decency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shame"@en .

aat:300417280 a skos:Concept ;
    skos:definition "Concept about the practice or habit of restraining oneself in provocation, passion, desire, and exercising rational self-restraint and moderation in action, expression, particularly self-control, restraint, or forbearance when provoked to anger or impatience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperance"@en .

aat:300417281 a skos:Concept ;
    skos:definition "Objects, architecture, plants, creatures, achievements, or natural occurrences that are considered extraordinary and marvelous by a given culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wonders"@en .

aat:300417282 a skos:Concept ;
    skos:definition "Heritage science refers to all applications of science for the general study of cultural heritage, tangible and intangible; a cross disciplinary research domain including humanities and sciences, such as the natural, social, and formal sciences. In particular, heritage science focuses on issues such as promoting access to cultural heritage, its interpretation, conservation, and management."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heritage science"@en .

aat:300417283 a skos:Concept ;
    skos:definition "Detailed descriptions or outlines for a pedagogical session, developed by the instructor to guide student learning. Usually includes objective(s), instructional components or methods, and assessment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lesson plans"@en .

aat:300417284 a skos:Concept ;
    skos:definition "Cabinets of drawers designed to store unbound maps, prints, posters, drawings, or any other large-format flat documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat file cabinets"@en .

aat:300417285 a skos:Concept ;
    skos:definition "Brownish-black crystals or powder, insoluble in water, synthesized by the oxidation of amorphous Cr(OH)3 with oxygen. Developed as rod-like particles for thin film deposition as magnetic recording material, and as a catalyst. Chromium dioxide is no longer widely used because of high production costs and toxicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromium dioxide"@en .

aat:300417287 a skos:Concept ;
    skos:definition "A range of biaxially drawn films made from polyethelene terephthalate polymer, created by extruding the polymer through a slot die, then drawing it in two directions at right angles to orient the molecules in the plane of the film, then held under tension and heat set. Polyester film has great strength, dimensional stability, and resistance to chemicals, and has been used in a variety of industrial applications, as a base for motion picture film, videotape, and audio tape, and archival housing for documents, laminate, and many other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyester film"@en .

aat:300417288 a skos:Concept ;
    skos:definition "Land tenures of a particular kind that came into use in the 8th century. By a benefice, a lord leased an estate to a freeman on easy terms; the lease normally came to an end on the death of the lord or of the tenant, though holders of benefices often succeeded in turning them into hereditary holdings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benefices"@en .

aat:300417289 a skos:Concept ;
    skos:definition "In Indian Philosophy, a spiritual and ascetic discipline having the goal of spiritual purification and self-understanding leading to union with the divine (samadhi). It is one of the six orthodox systems of Indian philosophy, and a system of meditative discipline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yoga"@en .

aat:300417290 a skos:Concept ;
    skos:definition "Broad tradition that stresses the importance of the spiritual, mystical, and transcendental aspects of religion and philosophy; revealing inner or secret meanings. Prime examples include ancient Greek mysteries and certain schools of Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "esotericism"@en .

aat:300417291 a skos:Concept ;
    skos:definition "Numerous texts dealing with the esoteric practices of some Indian sects. In Hindu tradition, Tantras cover theology, yoga, construction of temples and images, religious practices, spells, rituals, and symbols. Buddhist Tantras cover philosophy, symbols, guidance for complex rituals, and application of sacred powers for mundane purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tantras"@en .

aat:300417292 a skos:Concept ;
    skos:definition "Visual works created using materials that are considered to be precious or rare, such as gold, gemstones, ivory, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luxury arts"@en .

aat:300417293 a skos:Concept ;
    skos:definition "Masks worn over the mouth and sometimes the nose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouth masks"@en .

aat:300417294 a skos:Concept ;
    skos:definition "General term for ornaments worn on any part of the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face ornaments"@en .

aat:300417295 a skos:Concept ;
    skos:definition "Style and culture of the Mexica people who were part of the Aztec Triple Alliance and whose capital was at Tenochtitlan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mexica"@en .

aat:300417296 a skos:Concept ;
    skos:definition "Style and culture of the Acolhua people who were part of the Aztec Triple Alliance and whose capital was at Tetzcoco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acolhua"@en .

aat:300417297 a skos:Concept ;
    skos:definition "Style and culture of the Tepanec people who were part of the Aztec Triple Alliance and whose capital was at Tlacopan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tepanec"@en .

aat:300417298 a skos:Concept ;
    skos:definition "Technique in paintings or the painting of sculptures in which gold leaf is applied to depicted costume or other textiles, or other details, in order to intensify the visual effect. The technique is seen in Byzantine, Medieval, and early European Renaissance paintings, but reached its zenith in Spanish colonial art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brocateado"@en .

aat:300417299 a skos:Concept ;
    skos:definition "Genus containing around 20 species of small understory trees native to the tropical forests of Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theobroma"@en .

aat:300417300 a skos:Concept ;
    skos:definition "Species of tree native to tropical America, from which cocoa and chocolate are prepared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theobroma cacao"@en .

aat:300417301 a skos:Concept ;
    skos:definition "Elongated, seed-bearing fruits formed from a single carpel that splits along the sides on ripening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pods"@en .

aat:300417302 a skos:Concept ;
    skos:definition "Fruits of a tree native to tropical America, the seeds of which are used to prepare cocoa and chocolate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cacao"@en .

aat:300417303 a skos:Concept ;
    skos:definition "Relatively small rooms in jails or prisons, used to confine one or more inmates; may be enclosed with bars or otherwise fortified against escape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prison cells"@en .

aat:300417304 a skos:Concept ;
    skos:definition "Deities associated with, or personifications of, the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun gods"@en .

aat:300417305 a skos:Concept ;
    skos:definition "The action or an act of cutting down a tree or trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felling"@en .

aat:300417306 a skos:Concept ;
    skos:definition "Inordinate desire of acquiring and hoarding wealth, greediness of gain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avarice"@en .

aat:300417307 a skos:Concept ;
    skos:definition "The vice of excessive eating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gluttony"@en .

aat:300417308 a skos:Concept ;
    skos:definition "An order of Agaricomycetes containing over 1300 species of diverse fruiting body types. Most members are saprobic, primarily found on the wood of fallen trees or in the soil at the base of trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boletales"@en .

aat:300417309 a skos:Concept ;
    skos:definition "Large genus of flowering plants containing over 400 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stachys"@en .

aat:300417310 a skos:Concept ;
    skos:definition "Species of perennial grassland herb; noted in Classical literature as used for medicinal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stachys officinalis"@en .

aat:300417311 a skos:Concept ;
    skos:definition "Walking with long or extended steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striding"@en .

aat:300417312 a skos:Concept ;
    skos:definition "Describes audio sound recording materials comprised of magnetic particles embedded in a binder layer on polyester, acetate, paper, or PVC bases, wound onto tape reels for storage and playback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open reel audiotapes"@en .

aat:300417313 a skos:Concept ;
    skos:definition "Visual works in any medium that depict a landscape that appear to represent scenes in the real world, only slightly idealized, if at all."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naturalistic landscapes"@en .

aat:300417314 a skos:Concept ;
    skos:definition "Visual works in any medium that depict a landscape as a highly idealized version of nature and natural forms with references to Classical mythology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arcadian landscapes"@en .

aat:300417315 a skos:Concept ;
    skos:definition "Costume of any kind, made primarily or entirely of fur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fur garments"@en .

aat:300417316 a skos:Concept ;
    skos:definition "Dougong refers to a unit consisting of a number of mortised bearing blocks (dou 斗), arms (gong 栱), tie-beams (fang 枋) and inclined beams (ang 昂). They are often used under the eaves, on beams, or on the tops of pillars.The first use of the term dougong as a compound word can be traced to the Sui dynasty translation of the Yaoshi rulai benyuan jing (Dharmagupta trans. 616 CE, Taishō 449): “The city-gate towers, walls and parapets, doors and windows, halls and pavilions, pillars and beams, blocks and bracket arms (dougong 斗拱), surrounding like a net, are all composed of the seven jewels.” After the Sui dynasty, dougong gradually became a set technical term and can be found in a number of different textual sources. The earliest known material evidence for dougong is the dragon-phoenix table-base excavated from the Warring States Period Zhongshan royal necropolis in Pingshan, Hebei province (ca. 310 BCE; ZHONG Xiaoqing, 2010：113-119). From the Han dynasty onward we have many extant examples of dougong in the visual record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dǒugǒng"@en .

aat:300417317 a skos:Concept ;
    skos:definition "Complexes of built works surrounding the palace or palaces of a ruler. An example is the Forbidden City in Beijing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palace complexes"@en .

aat:300417318 a skos:Concept ;
    skos:definition "Pictorial or photographic representations that focus on built works as taken from a distance far enough away to display the full work or most of the built work in its surrounding context. For views of entire cities, use \"cityscapes (representations).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural views"@en .

aat:300417319 a skos:Concept ;
    skos:definition "General term for any of four or more species of moths in genus Morpho having blue wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blue Morpho"@en .

aat:300417320 a skos:Concept ;
    skos:definition "General term for flying insects with colorful wings in Papilionoidea (superfamily), Nymphalidae (family), or Hedyloidea (superfamily)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butterflies"@en .

aat:300417321 a skos:Concept ;
    skos:definition "Objects or materials concerning characteristics of American civilization or culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Americana"@en .

aat:300417322 a skos:Concept ;
    skos:definition "State of wistful yearning to return to a former place or time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nostalgia"@en .

aat:300417323 a skos:Concept ;
    skos:definition "Acts of coming upon another, assailing, attacking, or otherwise unexpectedly or without warning undertaking an action upon another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surprises"@en .

aat:300417324 a skos:Concept ;
    skos:definition "The state or condition of being in agreement, accordance, being consistent and congruous, as related to another person, animal, nature, or other thing or condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmony"@en .

aat:300417325 a skos:Concept ;
    skos:definition "The state or fact of the continuance of anything after the end of other like things within the same context, as after some event. The persistence of a living thing, custom, or observance, after the circumstances or conditions in which it originated or which gave significance to it have ceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "survival"@en .

aat:300417326 a skos:Concept ;
    skos:definition "Genre of works that includes the man-made scenic environment, planned outdoor green spaces, often with accompanying structures and roadways, outdoor public areas, landmarks, and structures with the aim of creating a natural setting for human structures and settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape architecture"@en .

aat:300417327 a skos:Concept ;
    skos:definition "Visible impressions, markings, tracks, or traces on a surface, produced by natural phenomena, by man or another living creature, or by other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marks"@en .

aat:300417328 a skos:Concept ;
    skos:definition "Visual works in any medium that depict a landscape that based on natural forms but highly idealized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idealized landscapes"@en .

aat:300417329 a skos:Concept ;
    skos:definition "Possessions or assets wthat confer prestige or are acquired as a symbol of high social standing or wealth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "status symbols"@en .

aat:300417330 a skos:Concept ;
    skos:definition "The act of springing into the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jumping"@en .

aat:300417331 a skos:Concept ;
    skos:definition "Substantial bell towers associated with a church or public building, or rooms in the bell tower where the bells are hung or the ringers stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belfries"@en .

aat:300417332 a skos:Concept ;
    skos:definition "Wooden structures in the form of towers or sheds, often movable, originally used to besiege a fortification or to shelter the besiegers; also, similar sheds used to shelter livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belfries"@en .

aat:300417333 a skos:Concept ;
    skos:definition "Structures, such as sheds or more permanent structures, extending from the side of a building and having a sloping roof, usually intended to provide shelter; also, independently standing structures of similar design, having a sloping roof, and providing shelter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penthouses"@en .

aat:300417335 a skos:Concept ;
    skos:definition "The dried or partially dried fruit of the plum tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prunes"@en .

aat:300417336 a skos:Concept ;
    skos:definition "Genus containing around 70 species of annual and perennial flowering plants native to South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arachis"@en .

aat:300417337 a skos:Concept ;
    skos:definition "Species of flowering plant native to tropical South America, but cultivated widely for its edible seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arachis hypogaea"@en .

aat:300417338 a skos:Concept ;
    skos:definition "Structures designed and used for drying products, such as fruit, vegetables, meat, fish, tobacco, paper, bricks, or any number of other products. Typical features include slats or vents for ease of air flow and a hearth used for a drying fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drying houses"@en .

aat:300417339 a skos:Concept ;
    skos:definition "Wagons, originally horse- or mule-drawn and later motorized, usually square-box in shape with a detachable top or trap-door at the rear which may be used as a luggage rack. Used for passengers or cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depot wagons"@en .

aat:300417340 a skos:Concept ;
    skos:definition "The function or method of signalling using flags to convey a code or using an apparatus, such as flag-like devices mounted on a tower. Semaphore conveys messages by a code whereby the arms are placed successively in certain positions in a vertical plane relative to the body, often with a flag in each hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semaphore"@en .

aat:300417341 a skos:Concept ;
    skos:definition "The action of making or transmitting signals, which are gestures or things that convey meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signaling"@en .

aat:300417342 a skos:Concept ;
    skos:definition "Gestures, actions, sounds, visual stimuli, or objects acting as the prompt for a particular action or a sign to convey warning, direction, or other information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signals"@en .

aat:300417343 a skos:Concept ;
    skos:definition "Small windows or other openings, sometimes closed by grilles, forming places of communication; typically placed in another window or opening. Examples are windows in banks for cashiers or tellers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wicket windows"@en .

aat:300417344 a skos:Concept ;
    skos:definition "Pairs of tall casement windows closing against each other with no frame between them, allowing access to the outside or to another room. For single tall window-like doors, use \"French doors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French windows"@en .

aat:300417345 a skos:Concept ;
    skos:definition "Double windows of Dutch origin; windows are divided in four sections, with the lower halves covered by shutters or doors and the upper halves glazed. A related design is seen in \"kloosterkozijns,\" resembling one-half of the kruiskozijn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kruiskozijns"@en .

aat:300417346 a skos:Concept ;
    skos:definition "Masonry bonds in which every course consists of patterns of two stretchers followed by one header."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monk bonds"@en .

aat:300417347 a skos:Concept ;
    skos:definition "Subsidiary chapels opening off the apse of churches. For chapels opening off the nave or side aisles, prefer \"side chapels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apse chapels"@en .

aat:300417348 a skos:Concept ;
    skos:definition "Subsidiary chapels opening off the center of the apse of churches, on an axis down the center of the plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axial chapels"@en .

aat:300417349 a skos:Concept ;
    skos:definition "Subsidiary chapels opening off the transept of a cruciform-plan church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transept chapels"@en .

aat:300417350 a skos:Concept ;
    skos:definition "Subsidiary chapels opening off the rounded apse of a church, having a footprint resembling petals or rays extending from the rounded apse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiating chapels"@en .

aat:300417351 a skos:Concept ;
    skos:definition "A type of underground mining employing vertical shafts driven from the earth's surface. It is used for coal, iron, and other dense mineral deposits that are deep underground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaft mining"@en .

aat:300417352 a skos:Concept ;
    skos:definition "Mines comprising vertical shafts driven from the earth's surface; examples include mines for coal, iron, and other dense mineral deposits that are deep underground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaft mines"@en .

aat:300417353 a skos:Concept ;
    skos:definition "Windmills that stand on artificial rises instead of being elevated on brickwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elevated mills"@en .

aat:300417354 a skos:Concept ;
    skos:definition "Wheels with mounted sails that rotate in a horizontal plane, around a vertical axis. The design is of ancient Asian origin, originally used for pumping water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical windwheels"@en .

aat:300417355 a skos:Concept ;
    skos:definition "Ferries designed to take railway passengers or freight across bodies of water. In one design, the large ferry is equipped with tracks, upon which railway cars may board the ferry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "train ferries"@en .

aat:300417356 a skos:Concept ;
    skos:definition "Land formations that were the site of, often having forms caused by, extinct waterfalls. For examples, a telltale horseshoe-shaped cliff may indicate that an ancient waterfall caused the form. An example is thought by many experts to exist in the Channeled Scabland of the Columbia Plateau region in eastern Washington state, formed when a huge glacial lake emptied and scoured the landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry waterfalls"@en .

aat:300417357 a skos:Concept ;
    skos:definition "Gables having a triangular form, like a pediment; the term is often used to distinguish the simpler triangular form from more complex gable forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triangular gables"@en .

aat:300417358 a skos:Concept ;
    skos:definition "Gables having an overall tall, rectangular form; may be capped with a broken pediment or other form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck gables"@en .

aat:300417360 a skos:Concept ;
    skos:definition "Structures that house signals of various types, usually in service of transportation systems; examples include such structures on seashores, canals, or along railroad lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signal houses"@en .

aat:300417361 a skos:Concept ;
    skos:definition "Covers or doors, often half-doors or gates, that close relatively small windows or doors, which are also called \"hatches (openings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatches"@en .

aat:300417362 a skos:Concept ;
    skos:definition "Subclass comprising three orders, Alcyonacea, Helioporacea, and Pennatulacea, of water-based organisims with around 3,000 species. Polyps have 8 pinnately branched tentacles, 8 mesenteries, and a single siphonoglyph. Nearly all colonial with internal skeletons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alcyonaria"@en .

aat:300417363 a skos:Concept ;
    skos:definition "Small to massive colonial forms of coral. Lower parts of polyps fused into a fleshy mass; oral ends protrude. Internal skeleton of isolated calcareous spicules. Primarily tropical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alcyonacea"@en .

aat:300417364 a skos:Concept ;
    skos:definition "A family of corals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coralliidae"@en .

aat:300417365 a skos:Concept ;
    skos:definition "Genus of corals having separate male and female colonies, and from the few reports of reproduction, it is believed that fertilization is internal, and therefore depends on free-swimming sperm from male colonies reaching the polyps of female colonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corallium"@en .

aat:300417366 a skos:Concept ;
    skos:definition "Species of coral that lives in the Mediterranean Sea and adjacent Eastern Atlantic Ocean on subtidal hard substrates. Corallium rubrum is a long-lived gorgonian coral that has been commercially harvested since ancient times for its red axial calcitic skeleton and which, at present, is thought to be in decline because of overexploitation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corallium rubrum"@en .

aat:300417367 a skos:Concept ;
    skos:definition "Announcements of exhibitions in the form of printed matter, and most commonly formatted as a postcard to be mailed. These may also appear as small pamphlets, posters, or other more elaborate objects such as balloons. Often an image of exhibited material is included, as well as the exhibition title or artist's name, and information regarding the exhibition venue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition announcements"@en .

aat:300417368 a skos:Concept ;
    skos:definition "In Britain, Europe, and European colonies, a great house is the grand dwelling of a landed proprietor, usually the largest or principal house in the district."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great houses"@en .

aat:300417369 a skos:Concept ;
    skos:definition "Paste-resist dyeing technique for textiles associated with Japanese folk art tradition. The resist is a rice-flour paste usually applied through a stencil to create a pattern or design. The dye is absorbed anywhere that the resist is not applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "katazome"@en .

aat:300417370 a skos:Concept ;
    skos:definition "A planographic printing technique first developed as a means for creating inexpensive offset prints. It was subsequently adopted as an artist's printmaking technique mimicing traditional lithography based on the resistance of oil and water. Images can be created on specially made polyester plates by direct drawing with waterproof materials or printing the plate on a laser printer. The imaged plate is then washed with a wetting solution and charged with an oil-based ink. These are then run though a lithographic or etching press in the conventional way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyester plate lithography"@en .

aat:300417371 a skos:Concept ;
    skos:definition "Relating to, or comprising more than two distinct differentiated peoples based on socially defined characteristics. This term is applied both to groups of people or to individuals. Multiracial people may have different opinions about which terms are considered derogatory or acceptable, depending on region, country or personal preference. The term may be perceived as homogenizing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiracial"@en .

aat:300417372 a skos:Concept ;
    skos:definition "Comprising or involving more than one people that shares identity, distinctiveness, or significance based on linguistic group, religious belief, nationality, cultural tradition, and sometimes perceived physiological characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiethnic"@en .

aat:300417373 a skos:Concept ;
    skos:definition "Categorization designating a group or individual comprised of more than one distinct differentiated people based on socially defined characteristics, ethnicity, language, or culture. People of mixed race may have differing opinions about which terms are considered derogatory or acceptable, depending on region, country, or personal preference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biracial"@en .

aat:300417374 a skos:Concept ;
    skos:definition "Burial chambers, chapels, or oratories within tomb spaces such as catacombs or crypts attached to churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cubicula"@en .

aat:300417375 a skos:Concept ;
    skos:definition "Festivals held primarily for musical performances, for example featuring performances by various different musicians, bands, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music festivals"@en .

aat:300417376 a skos:Concept ;
    skos:definition "Soft food product made with gelatin derived from animal collagen, pectin, or other substances, often with the juice or flavor of fruit added. This is prepared by by boiling and subsequent cooling, and displays a characteristic elastic consistency and translucence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jelly"@en .

aat:300417377 a skos:Concept ;
    skos:definition "A rate, number or proportion considered in its quantitative relation to the whole; usually a quantity or amount reckoned as so many hundredth parts of another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percentage"@en .

aat:300417378 a skos:Concept ;
    skos:definition "People or institutions that share in the ownership of an object, land, or other entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "co-owners"@en .

aat:300417379 a skos:Concept ;
    skos:definition "Photographs created with a digital camera, which is a cameras that acquires still or motion pictures via an electronic sensor and stores them as digital information on a memory device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital photographs"@en .

aat:300417380 a skos:Concept ;
    skos:definition "Photographs or other images that are converted to digital form through scanning or another mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digitized images"@en .

aat:300417381 a skos:Concept ;
    skos:definition "Family of bivalves having one genus. Although similar in appearance and some behaviors, they are not closely related to true oysters (family Ostreidae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spondylidae"@en .

aat:300417382 a skos:Concept ;
    skos:definition "Genus of bivalve mollusks, characterized by foliaceous spines. They are used for edible meat and for their decorative shells. Although some common names include the word \"oyster,\" they are not closely related to true oysters (in the family Ostreidae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spondylus"@en .

aat:300417383 a skos:Concept ;
    skos:definition "Species of bivalve mollusk; noted for having decorative and symbolic value for Pre-Columbian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spondylus calcifer"@en .

aat:300417384 a skos:Concept ;
    skos:definition "Species of bivalve mollusk; noted for having decorative and symbolic value for Pre-Columbian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spondylus princeps"@en .

aat:300417385 a skos:Concept ;
    skos:definition "General term for organized societies or states as a political entities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polities"@en .

aat:300417386 a skos:Concept ;
    skos:definition "Keyboard instruments that physically resemble conventional aerophone organs but that create sound through the administration of flame enclosed in glass tubes. Invented by Frédéric Kastner ca. 1873."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrophones"@en .

aat:300417387 a skos:Concept ;
    skos:definition "Listings of items, goods, or raw materials that are available, usually kept on the premises, of a shop or other establishment. Stock lists may be kept locally or published. Examples are stock lists of prints by print dealers and print publishers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock lists"@en .

aat:300417388 a skos:Concept ;
    skos:definition "In a financial stock exchange, detailed lists of the stocks available on a particular exchange and their issuers, often including values for a particular date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock lists"@en .

aat:300417390 a skos:Concept ;
    skos:definition "Tantra was a Buddhist and Hindu spiritual tradition that emerged in the fifth century CE. In the 1960s Tantric art was rediscovered in India and the west. This led to a revival of Neo-Tantric painting that utilizes imagery found in Tantric art. The traditional sexual and symbolic imagery is combined with the use of colour fields, figurative forms, impressions of three-dimensional space, and symmetry to create a modern style similar to Western abstraction that also draws from traditional Indian religious idioms. Contemporary artists have continued working in this style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Tantric Art"@en .

aat:300417391 a skos:Concept ;
    skos:definition "Refers to the modern art movement that emerged in the 1960s at Madras, the present-day Chennai in South India. Within a larger context of post-independence search for identity, the Madras School of Arts and Crafts played a pivotal role in this regional art movement. Led by the School’s principal K.C.S. Paniker and teacher S.Dhanapal, the Madras Art Movement sought to rethink strategies for deploying traditional regional art forms while maintaining modern sensibility and expressions. The artist-teachers along with students creatively interacted with the vernacular art of the region. The city Madras became an artistic center attracting artists from the southern states of India, where artists drew inspiration from the cultural traditions of their native regions, such as folk and tribal culture, and interpreted them with techniques and tools that were modern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Madras Art Movement"@en .

aat:300417392 a skos:Concept ;
    skos:definition "The term, specific to the discussion of Indian art and culture, relates to issues about the continuity of traditions. It was felt that the British administration and educational system in India were undermining the art and craft system in the country, which had had a continuity of development. Soon after independence, a number of government institutions and museums dedicated to rural arts and crafts emerged in India. Modern artists in the urban contexts also invested considerable attention to the contexts, techniques, and forms of traditional art practices. This engagement brought new questions on how to define tradition in the 20th century; how to reconcile the relationship between modern and traditional art; how to support a sustainable environment for traditional arts; and how these disappearing art forms might be preserved. Artists in Baroda were particularly interested in these questions, which translated into various institutional initiatives, Fine Art Fairs, research projects, and artist exchanges and workshops with artisans from rural contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Living Traditions"@en .

aat:300417393 a skos:Concept ;
    skos:definition "An artistic phenomenon in China mainly happening in 1985 and 1986 and lasting in some form until the ‘China/Avant-Garde: China Modern Art Exhibition’ in 1989. Young artists across China formed numerous artistic groups and organised various exhibitions of experimental art, including a considerable amount of performance art. They shared a concern for the individual in the context of Chinese society, a belief in freedom of creative expression, and a commitment to conceptual and formal renewal. ’85 New Wave is widely considered a significant breakthrough in modern Chinese art history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "'85 New Wave"@en .

aat:300417394 a skos:Concept ;
    skos:definition "Dansaekhwa translates to ‘monochrome painting.' It refers to a loose constellation of mostly large abstract paintings done in white, black, brown, and other neutral colors made by [South] Korean artists from the 1960s to 1970s. Dansaekhwa artists used various methods to create their paintings, such as pushing paint, soaking canvas, dragging pencils, and ripping paper. While the style has been often linked with Western and Japanese modes of minimalism and abstraction, the associated artists emphasized their connection to Korean traditional arts and colours and a spiritual return to nature through the creation of infinite space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dansaekhwa"@en .

aat:300417395 a skos:Concept ;
    skos:definition "A postwar art movement in South Korea beginning in the late 1950s and ending around 1965. Led by the young artists of Contemporary Artists Association (Hyeondae Misul Hyeohoe), the movement aimed to break away from the then dominating representational art style associated with the National Art exhibition system (Kukjeon), and to seek openness in form and attitude. Korean Informel paintings were abstract in style, early works were characterised by aggressive brushwork and thick textures, while later works had a tendency towards quiet order. Focusing primarily on painting, the movement also had influence on sculpture, which became more aggressive and dramatic in texture, reminiscent of Informel painting’s brushstrokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Korean Informel Movement"@en .

aat:300417396 a skos:Concept ;
    skos:definition "A movement beginning in Japan in 1918 and continuing well into the late 1960s. Called Sōsaku Hanga, which translates as ‘creative prints’. The movement was informed by the desire to break away from the past style of printmaking, especially the ukiyo-e woodblock print that was traditionally produced by multiple specialised craftsmen, including painters (who created the original designs), carvers (who produced the woodblocks), and printers (who made final prints). Influenced by German Expressionism and Art Nouveau, the movement embraced the modernist conception of printmakers as individual artists who would undertake all the steps of printmaking by themselves. Stylistically, the artists exposed the marks left by carving and made use of layering of colour to create formally innovative and expressive works. In the postwar period, these prints became popular abroad and led to increased interest in Japanese printmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Creative Print Movement"@en .

aat:300417397 a skos:Concept ;
    skos:definition "A term coined by art critic Li Xianting to refer to an art style that prevailed in China in the mid-1990s and peaked in the 1999 exhibition ‘Centennial Rainbow: Gaudy Art’. Under the influence of American pop art and earlier Chinese art trends Political Pop and Cynical Realism, Gaudy Art appropriated the language of pop and folk culture in contemporary Chinese society to parody the parasitical but meaningless reproduction of cultural signifiers and traditional motifs. But unlike Political Pop and Cynical Realism where the political predicament was still a concern, Gaudy Art derived its motiving force more from enticements of consumer culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gaudy Art"@en .

aat:300417398 a skos:Concept ;
    skos:definition "An art movement organised in Indonesia in 1975 by a group of students, who were either from the fine art department of Institut Teknologi Bandung, Bandung or the art academy of Sekolah Tinggi Seni Rupa Indonesia, Yogyakarta. Gerakan Seni Rupa Baru can be translated into ‘New Arts Movement’. In response to the prevalence of decorative style and the blind embrace of Western abstract art, their manifesto called for rethinking the concept of art and revitalising Indonesian art through a critical revision of its visual art history. They held that social issues are more important subjects than personal sentiments of an individual artist and that idea matters more than skill. They also sought to break the division between ‘high art’ and ‘low art’, explore new visual possibilities and resume communication with the audience. During several group exhibitions from 1975 to 1979, their experimental works received wide coverage and mixed response. Gerakan Seni Rupa Baru is widely credited as the vanguard of Indonesian contemporary art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gerakan Seni Rupa Baru"@en .

aat:300417399 a skos:Concept ;
    skos:definition "The movement associated with the Gutai Art Association: a collective of vanguard artists founded in Ashiya in Japan 1954 and disbanded in 1972 after the death of its leader Yoshihara Jirō. Gutai in Japanese means ‘embodiment’ or ‘concreteness’. The group’s primary goal was to seek an “international common ground” of new art that would transcend modernist painting. Gutai’s experimentalism encompassed both painting (gestural abstraction in the 1950s and hard-eged abstraction in the 1960s) as well as such innovative forms as performance art (on the stage and for the press), installation art (both indoors and outdoors), land art, sound art, intermedia art, and conceptualism, among others, through which the group prefigured what to come in the 1960s. Gutai was known internationally from the late 1950s, and its legacy and reception underwent multiple periods of revival and discussion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gutai"@en .

aat:300417400 a skos:Concept ;
    skos:definition "An art trend prevalent in Guangdong Province, China during the first half of the 20th century. Lingnan, literally meaning ‘south of the mountains,' refers to an area including Guangdong and some other southern provinces of China. The key figures of the trend were the brothers Gao Qifeng and Gao Jianfu as well as Chen Shuren. In coordination with the popular ideas of reforming China with western ‘science and democracy,' the artists aimed to create a new Chinese art that defined the nation through a synthesis of East and West. Since many artists studied in Japan, they incorporated western realism as interpreted by Japanese nihonga painting into Chinese ink painting. After the Communist revolution of 1949, the trend diminished in People’s Republic of China but further developed in Hong Kong, Taiwan and some overseas Chinese centres in Southeast Asia and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lingnan School"@en .

aat:300417401 a skos:Concept ;
    skos:definition "An artistic movement in South Korea beginning in the 1980s and lasting until the 1990s. Minjung Art roughly translates as ‘people’s art’ although the meaning in Korean is more nuanced, implying a collective consciousness of action against the mainstream. The movement developed out of the wider Minjung movement in Korea that began in the 1960s, especially as a response to the military suppression of Gwangju Uprising in 1980 and as a reaction against institutional modernist art. Minjung Art generally aimed to connect with the masses through an emphasis on narrative and subject matter, and through a rejection of western modernism by incorporating traditional genres such as folk art, Buddhist art and woodcuts. Designed as social criticism, artists used satire and narrative to condemn the contemporary culture of South Korea and the west. However, the movement was somewhat divided with differing aims and ideologies and by the beginning of the 1990s, it gradually was absorbed by the mainstream as South Korea underwent democratization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minjung Art"@en .

aat:300417402 a skos:Concept ;
    skos:definition "An art movement that took place in Hong Kong and Taiwan in the 1960s and the 1970s. In the 1960s, Lui Shoukwan, pioneer of modern ink painting in Hong Kong, brought a modernist spirit into Chinese painting while adapting the techniques of earlier masters, which became a point of departure for many of his students. In the meantime, a group of young artists in Taiwan also started to innovate ink painting, blending traditional Chinese painting theories with modern Western art. In 1971, modern ink artists from Taiwan and Hong Kong co-organized a Chinese Ink Painting Exhibition that toured from Taiwan to Hong Kong. In the same year, Liu Kuo-sung, a seminal figure of modern ink painting in Taiwan, moved to Hong Kong and taught many students until his retirement in 1992. His students held exhibitions since 1975 and founded Hong Kong Modern Ink Painting Association in 1977, the latter of which continued to promote experimentation with ink art. After the opening up of China in the late 1970s, modern ink painting had a strong impact in the People’s Republic of China as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modern Ink Movement"@en .

aat:300417403 a skos:Concept ;
    skos:definition "An art movement spearheaded by Lu Xun in the 1930s that spread from Shanghai to other parts of China. With the belief in ‘art for the society,' Lu Xun actively promoted modern European and Soviet woodcut prints as well as organised woodcut classes, which inspired the establishment of numerous printmaking societies across China. In response to the Nationalist government’s failure to resist Japanese aggression, many of the prints were either anti-government, anti-Japanese, or overtly socialist. The expressive styles and versatile vocabulary brought a radically new look to the marginalized native medium and contributed to a movement that is unprecedented in scale and impact on the masses. During Japanese aggression in China from 1937 to 1945, many woodcut artists followed Mao Zedong’s idea of art as a political tool for mobilizing the working class and rural community. Although the nature and style of woodcuts transformed in this period, it is considered by some as the second phase of the Modern Woodcut Movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modern Woodcut Movement"@en .

aat:300417404 a skos:Concept ;
    skos:definition "A style of art in India developed by Abanindranath Tagore and his followers in the early 20th century that remained popular until the 1920s. Inspired by Mughal miniatures and Japanese ink wash painting, the Bengal school was created in response to European academic teaching as a way to revive Indian traditions and create a national art. Although the school of painting started in Bengal, assisted by followers of Tagore, it soon spread across India to become a national style by the early 1900s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bengal School"@en .

aat:300417405 a skos:Concept ;
    skos:definition "Art movement in Japan initiated by Lee Ufan and Sekine Nobuo in 1968 and continuing through 1973 in the narrower sense and throughout the 1970s and beyond in a broader sense. Mono-ha can be translated as ‘School of Things.' Although somewhat related to movements such as Arte Povera, Minimal Art, and Land Art, Mono-ha artists were primarily concerned with creating an art that reflected an Asian and Japanese worldview. Mono-ha pieces often utilised raw natural materials with minimal intrusion by the artist. They focused on the interrelation between objects and the environment, and on creating a system that generates an encounter between two objects. Although short-lived, the movement’s formal and theoretical innovations continued to spark interest and debate among artists and critics beyond its end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mono-ha"@en .

aat:300417406 a skos:Concept ;
    skos:definition "Mooi Indie, a Dutch term meaning ‘Beautiful Indies’, referred to a style of painting in Indonesia during the Dutch colonial period. Mooi Indie painters included mostly Dutch and other European painters living in Indonesia, as well as a small number of local Indonesian painters. Mooi Indie paintings were characterised by the depiction of beautiful landscapes in a naturalistic and romantic manner. The term began to be in use after artist Sindu Sudjojono’s writings during the late 1930s and early 1940s that attacked established ideas and values in the art world and particularly derided the Mooi Indie Style as merely beautiful without any social context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mooi Indie Style"@en .

aat:300417407 a skos:Concept ;
    skos:definition "‘Nanyang’ literally means ‘the seas south of China’ and refers to Southeast Asia as a whole. ‘Nanyang Style’ refers to paintings by a group of diasporic Chinese artists working in British Malaya (present-day Singapore and Malaysia) around the period of the 1930s to 1950s. It was attributed to the conscious efforts of these artists in search of an artistic and cultural identity defined in relation to the Chinese conception of the South Seas region. The key proponents of this style were associated with the Nanyang Academy of Fine Arts either as teachers or associates of teachers. Embodying an experimental and syncretic approach to pictorial representation, the works depicted local subject matter in a variety of styles from realism to post-impressionism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nanyang Style"@en .

aat:300417408 a skos:Concept ;
    skos:definition "An art movement that prevailed in Taiwan in the 1970s, roughly concurrent with the Nativist Movement in literature and other spheres that reflected on Taiwan’s local identity in the face of political crisis and rapid industrialization. Under the influence of publications such as Lion Art, many artists shifted their fascination with Western modern art in the previous decade to the local and the traditional. Four trends can be identified within the multifaceted movement. First, the naive style of suren artists (artists without formal training) such as Hung T’ung and Ju Ming earned high esteem. Second, typical scenes and objects of Taiwan became popular subjects, usually depicted in Nostalgic Realist or Super-realist style. Third, major artists from the period of the Japanese rule regained attention and recognition. Finally, there was a surge in the study of folk art and a growing concern about preserving traditional architecture and other forms of heritage. The movement marked a major shift in Taiwanese modern art history and is thought to have played a significant role in the formation of Taiwanese identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nativist Art"@en .

aat:300417409 a skos:Concept ;
    skos:definition "An artistic phenomenon in China from the mid 1980s to the late 1990s where some artists attempted to bring the spirit and aesthetics of traditional literati paintings back to life in the face of western influence on most contemporary art currents in China as well as the theoretical circles’ all-out assault on ‘tradition’. From 1989 to 1997, New Literati artists held annual exhibitions, each with a classical conceptual theme. While the phenomenon represented the desire to revive traditional civilization after it was ravaged by social and political change, few New Literati artists are considered to have surpassed older masters in terms of artistic achievements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Literati Painting"@en .

aat:300417410 a skos:Concept ;
    skos:definition "An artistic style that emerged towards the end of the 1960s in Malaysia. A group of young artists, who had returned from their art studies in the United Kingdom and the United States and were influenced by ‘hard-edged’ Constructivist and Minimalist ideas, put forward an idea that art-making could be rational and objective, based on ‘pure’ elements of art such as line, colour, texture and shape. This approach to art disregarded nature and external realities, as well as subjective emotions and sensations. In 1969 this group of artists held their first exhibition ‘The New Scene’, which was positioned as a response to the abstract expressionist tendencies dominating the Malaysian art scene at that time. Called the New Scene artists hereafter, the group continued to hold exhibitions, wrote manifestos and organized dialogues to promote their artistic ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Scene"@en .

aat:300417411 a skos:Concept ;
    skos:definition "A term coined by art critic Li Xianting to refer to an art trend in China in the late 1980s and early 1990s concurrent with the ‘Mao Fever’ as well as the growing presence of western consumerism in China. Adopting Pop Art techniques and a deconstructionist approach, Political Pop characteristically combined political symbols of the Mao era, most often Mao portraits, and symbols of Western consumerist culture to create a sense of irony and absurdity. Political Pop art reflects a complex social psychology in China, which was rooted in the ‘ Mao Complex’ and the struggle to overcome it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Political Pop"@en .

aat:300417412 a skos:Concept ;
    skos:definition "Tokyo Pop is a concept proposed by art historian Hiroko Ikegami in acknowledgement of a tendency inspired by American Pop Art. It began in 1963 when the news of New York Pop Art arrived in Tokyo, and continued through the mid-1970s. Inspired by this news, two sets of cultural practitioners, fine artists and graphic designers, combined the crisp industrial aesthetics and the interest in popular culture, both the contemporary American kinds and the traditional Japanese kinds, the latter including a range of graphic cultures such as ukiyo-e and vernacular and everyday designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tokyo Pop"@en .

aat:300417413 a skos:Concept ;
    skos:definition "A trend in post-revolutionary Soviet art in the 1920s and 1930s that promoted a fusion of artistic practice and industrial production. Productivists believed that in the socialist society there had been no need in art as an autonomous practice. Art was to deal with the pragmatic and utilitarian tasks such as design of objects, training of practical skills or organization of the living environment. For productivists an artist was akin a producer and an engineer. Though Productivism is often conceived as a movement associated with the particular theorists, artists and institutions (e.g. journals Lef and Noviy (New) Lef), it was rather a broader trend followed by many artists and art collectives across the USSR, including Central Asian republics. Institutional self-organization of numerous artistic collectives into “art-factories” in which the artistic production was organized as in an industrial plant was one of the most emblematic expressions of the productional view of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Productivist"@en .

aat:300417414 a skos:Concept ;
    skos:definition "A style of painting in India from the mid 19th to the beginning of the 20th century that emphasises Western techniques of realism under the influence of art academies established by the British Raj in key colonial cities such as Bombay and Calcutta. Due to increased patronage of art by the Indian elite and the rise of salon exhibitions, realistic oil painting was in high demand, especially portraiture and historical subjects, and remained popular until the development of the Bengal School."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Academic Realism"@en .

aat:300417415 a skos:Concept ;
    skos:definition "A term coined by art critic Li Xianting to refer to an art style in China, mainly focused in Beijing, in the late 1980s and early 1990s. The Cynical Realist artists were mainly born in the 1960s and thus experienced constant social, political and cultural turmoil. As the June Fourth Incident in 1989 declared the attempt to rebuild Chinese culture by introducing western modern art too idealistic, the artists felt disillusioned and discarded the metaphysical questioning and search for meaning prevalent in earlier art. With self-mockery, shamelessness, indifference and cynicism, they depicted themselves and the familiar, inconsequential, accidental and even absurd fragments of their surroundings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cynical Realism"@en .

aat:300417416 a skos:Concept ;
    skos:definition "An art trend that emerged in China in the early 1980s and focused on the depiction of the countryside and ethnic minorities. It was initiated by young artists, who had been ‘sent down’ to the countryside during the Cultural Revolution and looked back on the rugged life of the period with a degree of nostalgia. Sharing a humanist tendency with Scar Art, it sought to honour the ordinary heroes of daily life rather than the glorified characters of the Cultural Revolution. The ‘red, bright and shiny’ (hongguangliang) pictorial conventions of the Cultural Revolution were replaced in these paintings by the ‘small (small topics, particularly peasants), suffering (real suffering in a life of hardship and poverty) and old (the so-called backward society)’ (xiaokujiu) of the rural regions. The current peaked with the early works of Luo Zhongli and Chen Danqing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Soil Painting"@en .

aat:300417417 a skos:Concept ;
    skos:definition "An art trend in China, especially Sichuan Province, beginning in 1979 and lasting until the mid-1980s. Taking its name from the related literary tendency, Scar Art directly confronted the tragedy and emotional wounds of the Cultural Revolution, triggering wider reappraisal of the period as well as reflection on the role of art. Scar art marked the end of an era, where only positive representation of history and reality was considered appropriate, bringing art from a political tool back into a means of personal expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scar Art"@en .

aat:300417418 a skos:Concept ;
    skos:definition "Refers to a contemporary fine art trend in the Philippines beginning from the postwar period. It is first used to refer to a group of artists associated with the Philippine Art Gallery (1951-1969) who began to call themselves Neo-Realists in 1949. Realism in this case refers to how these artists used their subjective, internal vision of reality to create works of art. Neo-Realism was formed as a reaction to the perceived academic and sentimental status of art in the previous generation. In a sense it was a seminally representational style that was more open to various degrees of abstraction opened up through increasing familiarity with western modern art movements. Although initially facing disapproval from the public and the established art world, the ideologies and styles of the Neo-Realists soon became accepted and affected the development of Filipino art in the following decades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Realism"@en .

aat:300417419 a skos:Concept ;
    skos:definition "An aesthetic trend in the post-Stalinist Soviet Union (late 1950s – 1970s) often referred to as ‘the official art of the Khrushchev thaw’. The term was coined by the art critic Alexander Kamenski in 1969. Developed as a reaction to the Stalin era ‘colorful’ Socialist Realism, Severe Style emphasized simplified expressive outline and utilized a simple palette of muddied greys browns and earth tones. The style’s aesthetics was influenced by the early Soviet realism of the 1920s-1930s and medieval Russian icon and church fresco painting. On the conceptual level the artists of the ‘severe style’ strived to reveal the ‘unvarnished truthfulness’ of the rigorous reality. The most common subject matter of their paintings was people of labor (workers, builders, geologists, cultural workers). In Central Asia artists turned to the aesthetics of the Severe Style in late 1960s – 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Severe Style"@en .

aat:300417420 a skos:Concept ;
    skos:definition "A style of painting in Japan developed in the early 1950s and continued throughout the 1950s. In the beginning, it was strongly associated with the Japan Communist Party which aimed to galvanise public activism in reference to contemporary events and issues. The artists believed that “realism” should be achieved through the combination of an accurate depiction of events with the emotional reality of the experience. In this latter sense, Reportage painters had a significant interest in Surrealism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reportage Painting"@en .

aat:300417421 a skos:Concept ;
    skos:definition "An artistic movement in India that took place in Bengal between 1895 and 1910. Revivalism meant the rebirth or return to traditional Indian culture. Indigenous artistic styles and motifs with a focus on non-Western artistic values such as spirituality were emphasized. This movement was undertaken in opposition to Western style naturalism taught in the art academies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Revivalism"@en .

aat:300417422 a skos:Concept ;
    skos:definition "Refers to a painting genre during period of Japanese occupation in Taiwan. In Japanese, 'toyo' broadly refers to a geographical area that includes India, Taiwan, China, Korea and Japan while 'ga' means painting. The earliest official record of the term toyoga came with the Toyoga Section of the first ‘Taiwan Fine Arts Exhibition’ held in 1927. While borrowing from a broad sweep of expressive forms, from Japanese nihonga and nanga to Chinese style ink painting, toyoga in general also incorporates native Taiwanese elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toyoga"@en .

aat:300417423 a skos:Concept ;
    skos:definition "Culture of the modern region of Lombardy, in Italy; distiguished from the Migration period German culture of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lombard"@en .

aat:300417424 a skos:Concept ;
    skos:definition "The state or action of taking or maintaining possession, controlling, or inhabiting something, such as a structure or land area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupation"@en .

aat:300417425 a skos:Concept ;
    skos:definition "Hand gestures that developed in Naples and are used elsewhere in Italy; often accompanied by facial expressions, used alone or with spoken language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neapolitan gesture"@en .

aat:300417426 a skos:Concept ;
    skos:definition "Ethical wisdom, knowledge, or qualities, as evidenced in behavior conforming to moral law or accepted moral standards, particularly in relation to sexual matters or personal qualities judged to be good."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morality"@en .

aat:300417427 a skos:Concept ;
    skos:definition "The genus containing of two extant species of elephant in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Loxodonta"@en .

aat:300417428 a skos:Concept ;
    skos:definition "The larger of two species of elephants existing in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Loxodonta africana"@en .

aat:300417429 a skos:Concept ;
    skos:definition "The smaller of two species of elephants existing in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Loxodonta cyclotis"@en .

aat:300417435 a skos:Concept ;
    skos:definition "Unique and persistent identifiers for digital objects, compliant with the Handle System developed by the Corporation for National Research Initiatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handles"@en .

aat:300417444 a skos:Concept ;
    skos:definition "Phonograph recordings made by cutting or embossing grooves into semi-soft materials that could be played back multiple times. These allowed for home, field, or broadcast recordings. Often referred to as “instantaneous discs,\" they are known to have been made in other forms such as cylindrical belts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instantaneous recordings"@en .

aat:300417445 a skos:Concept ;
    skos:definition "Lacquer discs were the most common type of instantaneous recordings. These consisted of a coated substrate with grooves cut into the coating, allowing for playback. The format replaced wax matrices used for recording and mastering in the mid-1930s and was the dominant format for making original, or master, recordings before the advent of magnetic tape. Lacquer discs are often incorrectly referred to as acetate discs, or acetates, though they are composed of a nitrocellulose lacquer layer applied to an aluminum, glass, or steel base. The thin lacquer layer on new discs was soft enough to be inscribed with grooves by a cutting stylus and resilient enough to survive several playbacks and were used to record radio programs, field recordings, and other live events. Those made by radio networks and others for professional purposes were often 16 inches in diameter, while those recorded for personal purposes were more often 7 to 12 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacquer discs"@en .

aat:300417446 a skos:Concept ;
    skos:definition "Cartridge-based 1/4-inch analog audiotape format. The 8-track cartridge is a magnetic tape-based recorded sound format that was used exclusively for commercial releases. The tape is composed of magnetic particles or pigment, binder, and a polyester base. It was a popular format from the mid-1960s through the early 1980s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "8-track cartridges"@en .

aat:300417447 a skos:Concept ;
    skos:definition "Codes or numbers used for identification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identification numbers and codes"@en .

aat:300417448 a skos:Concept ;
    skos:definition "Genus containing around 50 species of evergreen trees and shrubs, native to tropical and subtropical areas around the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alstonia"@en .

aat:300417449 a skos:Concept ;
    skos:definition "Species of evergreen tree native to Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alstonia congensis"@en .

aat:300417450 a skos:Concept ;
    skos:definition "Appearances or outward aspects of things or situations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "views"@en .

aat:300417451 a skos:Concept ;
    skos:definition "Views seen through an opening, for example, as seen through avenue of trees or other long, narrow opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vistas"@en .

aat:300417452 a skos:Concept ;
    skos:definition "Books that are illustrated by mounting original photographs on the printed page, dating to after the invention of photography in the late 1830s but before photomechanical illustrations became the standard for print media later in the 1800s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photography incunabula"@en .

aat:300417455 a skos:Concept ;
    skos:definition "Cylinder desks, that is writing desks with a cover that rolls up into the desk top, that are designed for ladies; they are distinguished by often having a relatively delicate design and a wide space to accommodate ladies' skirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' cylinder writing tables"@en .

aat:300417456 a skos:Concept ;
    skos:definition "Visual works having a size that is very large, solid, and imposing; having a size that is significantly larger than normal or customary for the type of work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumental works"@en .

aat:300417457 a skos:Concept ;
    skos:definition "Qualitative and quantitative element analysis made by applying X-ray to the sample and then analysing the re-emitted element characteristic fluorescent X-ray. Examples of use are in chemical, electronic, food, and refinery industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "energy dispersive x-ray spectrometry"@en .

aat:300417458 a skos:Concept ;
    skos:definition "Concepts having to do with the discipline and practice of conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation concepts"@en .

aat:300417459 a skos:Concept ;
    skos:definition "The source or quarter of origin or derivation. For the history of the ownership and transmission of an object, including previous locations of a work, use \"provenance (history of ownership).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provenance"@en .

aat:300417460 a skos:Concept ;
    skos:definition "Art from any period in which the idea represented is considered more important than the finished product; examples may include satire and parody. For the style and movement that began in the 1960s, use \"Conceptual\" style and movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conceptual art"@en .

aat:300417461 a skos:Concept ;
    skos:definition "Studies, drawings, illustrations, or other representations used to convey an idea for use in visual works such as animation, films, video games, comic books, or other media. The term was originally coined by Disney in the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concept art"@en .

aat:300417462 a skos:Concept ;
    skos:definition "The non-living bodies of animals, and sometimes of humans, with an emphasis on the structure of the body rather than death or corruption. With butchers, it refers the whole trunk of a slaughtered animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carcasses"@en .

aat:300417463 a skos:Concept ;
    skos:definition "The human ability to perceive specific or meaningful images in random or ambiguous visual patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pareidolia"@en .

aat:300417464 a skos:Concept ;
    skos:definition "Propositions that state nothing beyond what is implied in any of the expressed terms. By extension, any true statements or ideas that are considered to be self-evident, often restricted to truth that is of minor importance; statements so obviously true as not to require or deserve discussion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truisms"@en .

aat:300417465 a skos:Concept ;
    skos:definition "Documents or records that have been written out in a fair, large, or legal character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engrossments"@en .

aat:300417466 a skos:Concept ;
    skos:definition "Requests or agreements issued to a manufacturer or supplier to produce a specific quantity of items or materials within a certain timeframe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "production orders"@en .

aat:300417467 a skos:Concept ;
    skos:definition "Records stating the price of a commodity, stock, or service, as estimated or promised by a supplier or contractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quotations"@en .

aat:300417468 a skos:Concept ;
    skos:definition "The sum of activities and status having to do with the home and household."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domesticity"@en .

aat:300417469 a skos:Concept ;
    skos:definition "Of people or animals, the state or attribute of being savagely cruel or destructive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferocity"@en .

aat:300417470 a skos:Concept ;
    skos:definition "Of people or animals, the state or attribute of being quick to attack or otherwise take the offensive position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aggressiveness"@en .

aat:300417471 a skos:Concept ;
    skos:definition "In a hierarchy, an ancestor is any record that is broader context for the record at hand, including parents, grandparents, and all other broader contexts at higher levels; any node in the succession of parent nodes on a path all the way up to the root."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancestors"@en .

aat:300417472 a skos:Concept ;
    skos:definition "In a hierarchy, a descendent is any record that is a narrower context for the record at hand, including children, grandchildren, and all other narrower contexts at lower levels; any node in the succession of parent nodes on a path all the way down to the tips (leaves) of the hierarchies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "descendants"@en .

aat:300417473 a skos:Concept ;
    skos:definition "In a thersaurus, a so-called \"related term\" is a concept that is associatively (not hierarchically) linked to another concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "related terms"@en .

aat:300417474 a skos:Concept ;
    skos:definition "In a thersaurus, a so-called \"broader term\" is a record to which another record or multiple records are subordinate in a hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broader terms"@en .

aat:300417475 a skos:Concept ;
    skos:definition "In a thersaurus, a so-called \"narrower term\" is a record to which another record or multiple records are superordinate in a hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrower terms"@en .

aat:300417476 a skos:Concept ;
    skos:definition "In a thesaurus, a descriptor is the term recommended to represent the concept in displays and indexing. In the AAT, terms in each language may have one descriptor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "descriptors"@en .

aat:300417477 a skos:Concept ;
    skos:definition "In a thesaurus, an alternate descriptor is a variant form of term that is the descriptor; usually a singular form or a different part of speech than the descriptor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alternate descriptors"@en .

aat:300417478 a skos:Concept ;
    skos:definition "In a thesaurus, a used for term is a term that is not a descriptor and not an alternate descriptor, but which is none-the-less a synonym for the descriptor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "used for terms"@en .

aat:300417479 a skos:Concept ;
    skos:definition "In a thersaurus, a sibling is a record that shares the same immediate broader context (one level higher) as other records. Siblings are subordinate to the same broader concept and are at the same hierarchical level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siblings"@en .

aat:300417480 a skos:Concept ;
    skos:definition "Tusche in semi-solid paste form used to make washes of various densities in lithography or silkscreen processes. It is known for producing desirable reticulation effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste tusche"@en .

aat:300417481 a skos:Concept ;
    skos:definition "Printmaking technique in which the plate is painted directly with acid, so that the artist is drawing with acid rather than ink; the acid is washed off when the desired effect had been achieved. Technique is typically used with etching, rather than as the sole technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavis"@en .

aat:300417482 a skos:Concept ;
    skos:definition "A photographic paper used for developing or printing out black and white prints; developed in the 1880s, and still used for this type of chemically-based printing process. The paper is coated with a gelatin emulsion containing a silver bromide salt. The sensitivity of the paper allows photographers to make contact prints and enlargements from positives or negatives with artificial light. The prints may fade, yellow, or develop a dark iridescent appearance with age if not properly processed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver gelatin paper"@en .

aat:300417483 a skos:Concept ;
    skos:definition "Subspecies of lion that became regionally extinct in the 20th century; some individuals of this subspecies have been proven through DNA analysis to survive in zoos. Distinguished, among other characteristics, by the males' thick, extensive, dark mane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera leo leo"@en .

aat:300417484 a skos:Concept ;
    skos:definition "Subspecies of lion closely related to North African lions and West African lions. Today they survive in the wild only in India's state of Gujarat; listed as Endangered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera leo persica"@en .

aat:300417492 a skos:Concept ;
    skos:definition "Subspecies native to North and Central America; extinct 10,000 y.a."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera leo atrox"@en .

aat:300417493 a skos:Concept ;
    skos:definition "Small explosive shells that were designed to be rolled down the rampart of a fortification to harass the besieging enemy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rampart grenades"@en .

aat:300417494 a skos:Concept ;
    skos:definition "Specialized soldiers who were physically the most powerful and used to lead the charge on a battlefield or in the storming of a fortificaitons in siege warfare. Originally, as the name implies, grenadiers were the troops who threw grenades in battle; although in later usage, refers to the strongest, largest soldiers who led the charge, whether or not grenades were employed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grenadiers"@en .

aat:300417495 a skos:Concept ;
    skos:definition "Revolutions opposed to a previous revolution or reversing its results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterrevolutions"@en .

aat:300417496 a skos:Concept ;
    skos:definition "Hand tools used for making holes in sheet materials, particularly leather. These consist of dual jaws, one fitted with a hollow punch and the other a flat die against which the punch presses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch pliers"@en .

aat:300417497 a skos:Concept ;
    skos:definition "Weave structure having only one set of warp and weft pathway types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simple weave"@en .

aat:300417498 a skos:Concept ;
    skos:definition "Textile in which wefts float over or under groups of warps in a logical sequence that creates a pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern weave"@en .

aat:300417499 a skos:Concept ;
    skos:definition "Textile having a weave structure that involves more than two sets of elements. Examples would be one or more warp sets, plus two or more weft sets, which are manipulated through different pathways to create a pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compound weave"@en .

aat:300417500 a skos:Concept ;
    skos:definition "Vessels, having a relatively stout shape, sometimes called \"jars\" or \"bottles\"; distinguished by having a double-branch/single-spout form that resembles a riding saddle stirrup. The form was known in Precolumbian art for 2,500 years. It has been suggested that the peculiar spout was used to prevent evaporation of the liquids contained in the vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stirrup-spout vessels"@en .

aat:300417501 a skos:Concept ;
    skos:definition "Human behavior that involves making the spontaneous sounds and movements of the face and body usual in expressing joy, mirth, or amusement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laughing"@en .

aat:300417502 a skos:Concept ;
    skos:definition "Human behavior that involves positioning the features or face a look expressive of pleasure or amusement, amused disdain, or scorn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smiling"@en .

aat:300417503 a skos:Concept ;
    skos:definition "Family containing 28 genera of herbaceous flowering plants. The family has been variously circumscribed, and some classifications include over 50 genera. In any case, although worldwide in distribution, most species grow in temperate and colder regions of the Northern Hemisphere, and many are Arctic or Alpine. These annual or perennial herbs have simple leaves, often with a toothed margin; their flowers are borne in groups on leafless stalks and have a tube with spreading lobes, the stamens being attached to the tube. The fruits are capsules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Primulaceae"@en .

aat:300417504 a skos:Concept ;
    skos:definition "Genus of primarily herbaceous flowering plants, valued for their ornamental flowers. Included are common wildflowers and others that have been extensively cultivated and hybridised for hundreds of years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Primula"@en .

aat:300417505 a skos:Concept ;
    skos:definition "Species of flowering plant native to western and southern Europe. Distinguished by having broad leaves and short leafless stems, each bearing a solitary pale yellow flower; pink and reddish varieties are found in nature and in cultivation. Numerous cultivars were popular in the 19th and 20th centuries in garden planting. The primrose is one of the earliest spring flowers in much of Europe, thus the common name is derived from medieval Latin \"prima rosa,\" meaning \"first rose,\" although the plant is not closely related to the rose family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Primula vulgaris"@en .

aat:300417506 a skos:Concept ;
    skos:definition "Family containing around 10 genera and around 160 species of trees and shrubs, found in the Northern Hemisphere in warm temperate and subtropical regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Styracaceae"@en .

aat:300417507 a skos:Concept ;
    skos:definition "Species of small to medium tree endemic to China. Used for wood and in folk medicine. Listed as a threatened species, now confined to Hainan Island, known only from stands of coppiced individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia odorifera"@en .

aat:300417508 a skos:Concept ;
    skos:definition "Wood of rosewood tree native to China, known for use in good quality furniture from the late Ming and early Qing dynasties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fragrant rosewood"@en .

aat:300417509 a skos:Concept ;
    skos:definition "Tabua are pierced and braided whales teeth, originally taken from the lower jaw of sperm whales found stranded on Fijian beaches. As whale strandings were relatively rare, so were whale teeth more valued as a result. Tabua are considered by Fijians as a kavakaturanga or ‘chiefly thing’. They are not worn but are presented at important ceremonies, including weddings, births and funerals. Ceremonial tabua have holes drilled through the tip and the butt, and a braided sennit cord is attached. To make tabua, the whale teeth are polished and sometimes rubbed with coconut oil and turmeric to darken them. In some cases the teeth are smoked in a small tent-like structure covered in bark cloth to turn them a rich tobacco colour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabua"@en .

aat:300417510 a skos:Concept ;
    skos:definition "In music, the tuning of intervals to achieve acoustic purity by having the simplest mathematical ratios."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "just intonation"@en .

aat:300417511 a skos:Concept ;
    skos:definition "Genre of visual arts in which figurative subjects or other forms are simplified or changed in their representation so that they do not portray a recognizable person, object, thing, etc.; may reference an idea, quality, or state rather than a concrete object. For the process of formulating general concepts by abstracting common properties of instances, prefer \"abstraction.\" For 20th-century art styles that were a reaction against the traditional European conception of art as the imitation of nature, use \"Abstract (fine arts style).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abstract"@en .

aat:300417512 a skos:Concept ;
    skos:definition "Technique in which a design is impressed into a soft surface, such as unfired clay, by using a mold or other implement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impressed relief"@en .

aat:300417513 a skos:Concept ;
    skos:definition "East Asian vases of a particular shape, being relatively tall with a narrow base, a wide body, and a short neck with narrow opening. Originated as stoneware vessels during the Tang dynasty (618-907) and used for wine; later made of ceramic and used for the display of branches of plum tree blossoms. May be lidded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meiping"@en .

aat:300417514 a skos:Concept ;
    skos:definition "Hand tools fitted with a blade used to thin leather or skins, often at the edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skivers"@en .

aat:300417515 a skos:Concept ;
    skos:definition "Businesses which hold sales, often public, where items such as artworks are sold to the highest bidders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auction houses"@en .

aat:300417516 a skos:Concept ;
    skos:definition "The activity of reaping, gathering, and sometimes storing an agricultural crop, such as corn another ripe crop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harvesting"@en .

aat:300417517 a skos:Concept ;
    skos:definition "People who reap or gather crops, either as part of their occupation as farmers or as seasonal workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harvesters"@en .

aat:300417518 a skos:Concept ;
    skos:definition "Activities, either traditional or ceremonial specific to a given culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural events"@en .

aat:300417519 a skos:Concept ;
    skos:definition "Annual European Alpine event, comprising the herding of cattle and other animals from the summer pastures to lower latitudes; takes place in late September or early October."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Almabtrieb"@en .

aat:300417520 a skos:Concept ;
    skos:definition "The activities of moving and tending of sheep, cattle, reindeer, or other domesticated herd animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herding"@en .

aat:300417521 a skos:Concept ;
    skos:definition "The herding cattle over a significant distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle driving"@en .

aat:300417522 a skos:Concept ;
    skos:definition "The activity of cutting branches or twigs from a woody plant, such as a vine, tree, or shrub in order to regulate growth and promote flowering or fruit production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pruning"@en .

aat:300417523 a skos:Concept ;
    skos:definition "The activity of cutting and drying grass for hay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haymaking"@en .

aat:300417524 a skos:Concept ;
    skos:definition "A type of glass that will reflect and transmit different wavelengths of light, thus visually appearing as different colors in reflected and transmitted light; that is, the color differs when the light is reflected off the object and shining through the object. Since glass is not crystalline, the dichroic effect is achieved by coating thin layers of various chemicals on the surface of clear glass. Examples of the chemicals are: zinc sulfate, magnesium fluoride, gold, copper, nickel, cobalt oxide, iron oxide, chromic oxide, or titanium dioxide. Examples of dichroic glass objects are those developed by Roman glassmakers, where dichroic glass was prized for its resemblance to natural stones, both in its color and luminescence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dichroic glass"@en .

aat:300417525 a skos:Concept ;
    skos:definition "Private houses where members of a particular religious organization or group meet to pray. Types of house churches include \"domus ecclesiae\" of the early Christians, protestant worship places in China, and any other meeting places of modern sects or religious organizations whose ceremonies and activities take place in the houses of its members, rather than in a purpose-built church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house churches"@en .

aat:300417526 a skos:Concept ;
    skos:definition "A gradation technique used in woodblock printmaking, particularly as mastered by Japanese printmakers. Bokashi is notable in the work of Hokusai and Hiroshige, and is used most frequently in depicting the sky or water and to heighten the illusioni of space. There are multiple variations of the technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bokashi"@en .

aat:300417527 a skos:Concept ;
    skos:definition "Used to flag terms in a data base, data model, or data extraction where the term and associated qualifier (gloss) are expressed as a single unit, often with the qualifier in parentheses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terms-with-qualifier"@en .

aat:300417528 a skos:Concept ;
    skos:definition "Used to flag terms in a data base, data model, or data extraction where the term may or may not have a qualifier (gloss) associated with it, but the qualifier is not included; in cases where there is a qualifier associated with the term, it is important to note that the qualifier is not included in the given iteration of the data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terms-without-qualifier"@en .

aat:300417529 a skos:Concept ;
    skos:definition "In the context of thesaurus construction, a qualifier is a word or phrase used to distinguish a term in a vocabulary from otherwise identical or similar terms that have different meanings. A qualifier is separated from the term, usually by parentheses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qualifiers"@en .

aat:300417530 a skos:Concept ;
    skos:definition "In situations where one artist is copying or basing a work on another artist's work, the artist of the original work is referred to as the \"original artist.\" An example of usage is when a printmaker engraves an image on a plate based on the original artist's painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "original artists"@en .

aat:300417531 a skos:Concept ;
    skos:definition "The compilation of works of art, crafts, natural history, science, etc., along with associated research, materials, ideas, texts, and other intellectual property gathered around a particular theme and intended for public display. For the public display of such works as an event, prefer \"exhibitions (events).\" For published catalogs documenting the exhibition and related texts, prefer \"exhibition catalogs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition"@en .

aat:300417532 a skos:Concept ;
    skos:definition "Document folding method comprising a pleated series of alternating folds to create three or more panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accordion folding"@en .

aat:300417533 a skos:Concept ;
    skos:definition "Manuscripts distinguished by having a support formed of a long strip created by feathering together individual deer hides or pieces of maguey (agave) or bark (amate) paper to form a smooth continuous surface and coated with a white gesso. The strip is folded back and forth to create individual pages on which the figures and symbols are painted. In prime examples, made by Pre-Columbian American cultures"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screenfolds"@en .

aat:300417534 a skos:Concept ;
    skos:definition "Princes of Germany who were entitled to elect the Holy Roman Emperor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prince-electors"@en .

aat:300417535 a skos:Concept ;
    skos:definition "General term for bodies of electors or voters, that is, those qualified for or participating in an election."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electorates"@en .

aat:300417536 a skos:Concept ;
    skos:definition "In the United States presidential election, people who are chosen by each state, usually through an election by individual voters, to represent citizens of the state in casting a vote for leaders; this system is contrasted to an election determined by direct popular vote."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "United States electors"@en .

aat:300417537 a skos:Concept ;
    skos:definition "Organizations working for political purposes or goals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political organizations"@en .

aat:300417538 a skos:Concept ;
    skos:definition "Groups of electors in a political system, by whom leaders are chosen for a particular office. Examples are the electoral college of United States presidential elections and the electoral college of cardinals who elect a pope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electoral colleges"@en .

aat:300417539 a skos:Concept ;
    skos:definition "Cardinals of the Catholic church who gather to elect a pope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardinal electors"@en .

aat:300417540 a skos:Concept ;
    skos:definition "The religion of certain groups that separated from the Roman Catholic Church over papal authority and certain doctrines. The formation of the Old Catholic communion of Germans, Austrians, and Swiss began in 1870 at a public meeting held in Nuremberg. They accept certain Roman Catholic doctrine, but reject other doctrines and practices; they are not in communion with the pope in Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Catholicism"@en .

aat:300417541 a skos:Concept ;
    skos:definition "Suitable for, applicable to, or common to both males and females, not specifying gender."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender-neutral"@en .

aat:300417542 a skos:Concept ;
    skos:definition "State, condition, or behavior in which a person's identity corresponds to his or her biological sex at birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cisgender"@en .

aat:300417543 a skos:Concept ;
    skos:definition "Refers to gender identities that are not exclusively male or female‍, held by persons who gender-identify outside the male/female binary. This term may be used in addition to other gender identities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonbinary gender identity"@en .

aat:300417544 a skos:Concept ;
    skos:definition "Typified by or having some characteristics proper to the other sex, or having both male and female characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intersexual"@en .

aat:300417545 a skos:Concept ;
    skos:definition "Parts of looms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loom components"@en .

aat:300417547 a skos:Concept ;
    skos:definition "Japanese events involving a picnic meal and enjoyment outdoors, usually taking place during the annual appearance of cherry blossoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanami"@en .

aat:300417548 a skos:Concept ;
    skos:definition "General term for intials that incorporate ornament or other decoration, in contrast to the simpler forms of other letters on a page. May refer to manuscripts or in reference to printed texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorated initials"@en .

aat:300417549 a skos:Concept ;
    skos:definition "Extravagant book bindings incorporating precious materials, such as silver, gold, ivory, or gems, often in plates or other forms added over the more usual leather or other book binding material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treasure bindings"@en .

aat:300417550 a skos:Concept ;
    skos:definition "General term for the whole teaching staff of a college, university, or school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faculty"@en .

aat:300417551 a skos:Concept ;
    skos:definition "General term for those who create television programs, including directors, producers, writers, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television program makers"@en .

aat:300417552 a skos:Concept ;
    skos:definition "People whose job or position includes keeping track of the funds or treasure of a person, group, or organization. Originally referred to a person entrusted with the receipt, care, and disbursement of the revenues of a king, noble, or other dignitary, of a state, city, or church. In modern usage, usually one who is responsible for the funds of a public body, corporation, association, society, or club."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treasurers"@en .

aat:300417553 a skos:Concept ;
    skos:definition "Those who write dramas, dramatic poetry, or plays. For those who specialize particularly in writing plays, prefer \"playwright.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dramatists"@en .

aat:300417554 a skos:Concept ;
    skos:definition "Genre comprising the portrayal of fictional or non-fictional events meant to be delivered through the performance of written dialog or actions, staged by actors before an audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drama"@en .

aat:300417555 a skos:Concept ;
    skos:definition "People who are expert in or students of medieval history, art, culture, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medievalists"@en .

aat:300417557 a skos:Concept ;
    skos:definition "People who are expert in or students of the history, art, culture, etc. of the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle East specialists"@en .

aat:300417558 a skos:Concept ;
    skos:definition "People who are expert in or students of Asian history, art, culture, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asianists"@en .

aat:300417559 a skos:Concept ;
    skos:definition "People who provides professional services to improve the appearance of the face, nails, hair, body hair, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beauticians"@en .

aat:300417560 a skos:Concept ;
    skos:definition "Those who are expert in the branch of biology that deals with micro-organisms such as bacteria, viruses, and fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microbiologists"@en .

aat:300417561 a skos:Concept ;
    skos:definition "Photographers who specialize in depicting war and related subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "war photographers"@en .

aat:300417562 a skos:Concept ;
    skos:definition "Experts in the science of natural and artificial stones, including gems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gemologists"@en .

aat:300417563 a skos:Concept ;
    skos:definition "Performing artists, particularly those whose art furnishes amusement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entertainers"@en .

aat:300417565 a skos:Concept ;
    skos:definition "People employed in an official capacity, often by a city or governmental agency, as experts to certify the safety and compliance of built works in the jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building inspectors"@en .

aat:300417566 a skos:Concept ;
    skos:definition "Organized examination and evaluation of built works, usually by a qualified professional. May involve a visual inspection along with testing various aspects of the building using equipment and technologies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building inspection"@en .

aat:300417567 a skos:Concept ;
    skos:definition "People who are expert in the history of filmmaking and critical analysis of motion pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film historians"@en .

aat:300417568 a skos:Concept ;
    skos:definition "Professionals who are expert in the science and technology needed to the extract minerals and other materials from the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mining engineers"@en .

aat:300417569 a skos:Concept ;
    skos:definition "Authors who specialize in writing for an audience of children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children’s authors"@en .

aat:300417570 a skos:Concept ;
    skos:definition "Authors who specialize in writing about traveling and travel destinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel writers"@en .

aat:300417571 a skos:Concept ;
    skos:definition "Authors who specialize in writing manuals, descriptions, reports, proposals, or other technical documentation, usually highly specialized or concerned with practical applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical writers"@en .

aat:300417572 a skos:Concept ;
    skos:definition "Ambassadors or other diplomatic representatives of the pope, vested with both political and ecclesiastical powers and accredited to the court or government of a sovereign nation, or assigned to a definite territory; primary duty is safeguarding the interests of the Holy See."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuncios"@en .

aat:300417573 a skos:Concept ;
    skos:definition "People who oversee, coordinate, and otherwise projects, generally as a professional position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "project managers"@en .

aat:300417574 a skos:Concept ;
    skos:definition "People who are the top-level administrators for an administrative department."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "department heads"@en .

aat:300417575 a skos:Concept ;
    skos:definition "Managers whose responsibility is to direct and manage advertising campaigns or other outreach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising directors"@en .

aat:300417576 a skos:Concept ;
    skos:definition "Experts in the science of communication studied through the interpretation of signs and symbols as they operate in language and other fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semioticians"@en .

aat:300417577 a skos:Concept ;
    skos:definition "General term for the creation and conceptual arrangements of music into works to be performed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical compositions"@en .

aat:300417579 a skos:Concept ;
    skos:definition "Discipline involving the study of the theoretical aspects of music and its notation, typically as opposed to actual performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music theory"@en .

aat:300417580 a skos:Concept ;
    skos:definition "Discipline involving the study of singing and other vocal expressions, including performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocal arts"@en .

aat:300417581 a skos:Concept ;
    skos:definition "Discipline involving the study of dancing and movement, including performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance"@en .

aat:300417583 a skos:Concept ;
    skos:definition "Dramatic performances enacted with puppets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puppet shows"@en .

aat:300417584 a skos:Concept ;
    skos:definition "The discipline of combining vocal or instrumental sounds to produce beauty of form, harmony, melody, rhythm, expressive content, etc.; musical composition, performance, analysis, etc., as a subject of study; the occupation or profession of musicians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music"@en .

aat:300417585 a skos:Concept ;
    skos:definition "General term for the genre of works, written or oral, that are the result or product of literary activity. Included are written works considered collectively; a body of literary works produced in a particular country or period, or of a particular genre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literature"@en .

aat:300417586 a skos:Concept ;
    skos:definition "General term for the broad genre of objects, environments, or experiences (as in performance art) that are visual in nature, were created by the use of skill and imagination, and possess an aesthetic that is valued and of a quality and type that would be collected by art museums. It may refer to the study or practice of the fine arts or the fine and decorative arts together. For the discipline of art including reference to expertise of art, use \"art (discipline).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art"@en .

aat:300417587 a skos:Concept ;
    skos:definition "Dramatic musical compositions in which singing forms an essential part, chiefly consisting of recitatives, arias, and choruses, with orchestral accompaniment, usually documented by a libretto and musical score."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operas"@en .

aat:300417588 a skos:Concept ;
    skos:definition "Theatrical dances in which a formal academic dance technique of the \"danse d’école\" is combined with other artistic elements such as music, costume, and stage scenery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballets"@en .

aat:300417589 a skos:Concept ;
    skos:definition "Compositions comprising a musical farce with songs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burlettas"@en .

aat:300417590 a skos:Concept ;
    skos:definition "Relatively short musical pieces, ranging from light instrumental compositions, to entertainments performed between the acts of a play, to elaborate comic pieces performed between the acts of 17th- and 18th-century serious operas, usually for soprano and bass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermezzos"@en .

aat:300417591 a skos:Concept ;
    skos:definition "Italian comic operas, with dialogue in recitative and characters drawn from everyday life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operas buffas"@en .

aat:300417592 a skos:Concept ;
    skos:definition "Serious or tragic operas, particularly those with elaborate arias that were prevalent in the 18th centurey and usually based on a classical or mythological subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operas serias"@en .

aat:300417593 a skos:Concept ;
    skos:definition "French operas in which spoken dialogue alternates with self-contained musical numbers. The earliest examples of opéra-comique were satiric comedies with interpolated songs, but the form later developed into serious musical drama distinguished from other opera only by its spoken dialogue. The opéra-comique developed in the early 18th century out of the comédies de vaudeville, farcical entertainments performed at fairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opéras comiques"@en .

aat:300417594 a skos:Concept ;
    skos:definition "Short, originally one-act, operas, usually on a light or humorous theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operettas"@en .

aat:300417595 a skos:Concept ;
    skos:definition "Addresses or discourses having a more or less formal character and composed for the purpose of delivering the content orally to an audience or assembly. For texts that record the speech, use \"speeches (documents).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speeches"@en .

aat:300417596 a skos:Concept ;
    skos:definition "The state or condition when nothing is audible; absence of all sound or noise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silence"@en .

aat:300417597 a skos:Concept ;
    skos:definition "Chants that are monophonic, or unison, and accompany the Latin mass and canonical hours of the Ambrosian rite. The word Ambrosian is derived from St. Ambrose, bishop of Milan (374-397)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ambrosian chants"@en .

aat:300417598 a skos:Concept ;
    skos:definition "Liturgical chants used originally in Church of England services for singing unmetrical texts such as psalms and canticles, and characterized by a short repeating melody for each verse, with the first note extended to accommodate a varying number of syllables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglican chants"@en .

aat:300417599 a skos:Concept ;
    skos:definition "Liturgical songs of the Armenian Apostolic Church and the religious poetry that serves as its texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian chants"@en .

aat:300417600 a skos:Concept ;
    skos:definition "Latin liturgical chant from southern Italy in use from the 7th century until the 11th, when it was suppressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beneventan chants"@en .

aat:300417601 a skos:Concept ;
    skos:definition "Chants of musical verse or incantation known in various versions throughout the Buddhist world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhist chants"@en .

aat:300417602 a skos:Concept ;
    skos:definition "Liturgical chants that are monophonic, or unison, used in the Greek Orthodox church during the Byzantine Empire (330–1453) and down to the 16th century; in modern Greece the term refers to ecclesiastical music of any period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Byzantine chants"@en .

aat:300417603 a skos:Concept ;
    skos:definition "Liturgical chants of the Chaldean rite, historically associated with the Assyrian Church of the East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chaldean chants"@en .

aat:300417604 a skos:Concept ;
    skos:definition "Traditional chants of the Maori culture of New Zealand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maori chants"@en .

aat:300417605 a skos:Concept ;
    skos:definition "Liturgical music of the descendants of ancient Egyptians who converted to Christianity prior to the Islāmic conquest of Egypt in the 7th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coptic chants"@en .

aat:300417606 a skos:Concept ;
    skos:definition "Monophonic liturgical music in use in the Ethiopian national church; chants are sung in the Geez (Ethiopic) language. Although the liturgy of this church is eclectic with particularly strong influence from the Egyptian Coptic Church, the chant repertory is almost exclusively of indigenous Ethiopian heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ethiopian chants"@en .

aat:300417607 a skos:Concept ;
    skos:definition "Chants and movements of indigenous Hawaiians, that once honored the gods, or akua, then transferred after the arrival of Christian missionaries to rituals honoring the surviving ancestral gods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hawaiian chants"@en .

aat:300417608 a skos:Concept ;
    skos:definition "Chants and mantras of Hindu tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindu chants"@en .

aat:300417609 a skos:Concept ;
    skos:definition "Chants based in ancient Hebrew music, following well-established modal patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jewish chants"@en .

aat:300417610 a skos:Concept ;
    skos:definition "Liturgical chants forming one of the principal branches of Christian chant in the West during the Middle Ages. It was sung on the Iberian peninsula, but its influence extended beyond Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mozarabic chants"@en .

aat:300417611 a skos:Concept ;
    skos:definition "General term for the vocal music of the various Syrian Christian churches, including Eastern Orthodox churches such as the Jacobites and Nestorians, and the Eastern churches in union with Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syrian chants"@en .

aat:300417612 a skos:Concept ;
    skos:definition "Religious chants based on the use of divine words and phrases, that were conveyed to the Prophet Muhammad by the archangel Gabriel or at times directly by God."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sufi chants"@en .

aat:300417613 a skos:Concept ;
    skos:definition "Chants of the Navajo culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Navajo chants"@en .

aat:300417614 a skos:Concept ;
    skos:definition "The official monophonic unison chants, originally unaccompanied, of Christian liturgies. Music was developed for voice, based on a system of modes and performed in free rhythm corresponding at least in part to the accentuation of the words, though often with considerable elaboration of the melody. In usuage, often applied chiefly to the music of the Western Church, particularly chants of the 4th-century St. Ambrose and in the 6th-century by St. Gregory the Great."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plainsong"@en .

aat:300417615 a skos:Concept ;
    skos:definition "Genre of performing art that expresses or conveys action, character, or emotion without words, and using only gestures, facial expression, and movement. In Classical times, works of mime were simple, usually farcical dramas characterized by mimicry and the ludicrous representation of familiar types of character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mime"@en .

aat:300417617 a skos:Concept ;
    skos:definition "Genre of unconventional musical works that combine elements of music, drama, and sometimes dance in new ways that result in works distinct from traditional forms. Works of music theater are often small in scale and primarily dating to the 20th century or later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music theater"@en .

aat:300417618 a skos:Concept ;
    skos:definition "Performing art focusing on sleight of hand or tricks involving various types of illusion for purposes of entertainment. For the occult science that claims to use charms, spells, and supernatural power, use \"magic (occult science).\" The performing art may make superficial reference to the occult science in its performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illusion"@en .

aat:300417619 a skos:Concept ;
    skos:definition "Genre of performing art focused on poetry or another composition intended to be spoken aloud before an an audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoken word"@en .

aat:300417620 a skos:Concept ;
    skos:definition "The action of transferring property to another for custody with the expectation that the recipient will sell, rent, or loan this property to a third party, for the mutual benefit of the consignor and consignee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consigning"@en .

aat:300417621 a skos:Concept ;
    skos:definition "General term for language expressed in writing, as opposed to language presented in spoken form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "written word"@en .

aat:300417622 a skos:Concept ;
    skos:definition "General term for systems used to visually represent music through written words or standard notations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical notation"@en .

aat:300417623 a skos:Concept ;
    skos:definition "General term for systems used to visually represent dance through written words, symbols, numerical codes, drawings, or various other standard notations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance notation"@en .

aat:300417624 a skos:Concept ;
    skos:definition "Individual sales or loans of property in which a consignor transmits goods to a consignee, who then loans, rents, or sells these goods to a third party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consignments"@en .

aat:300417626 a skos:Concept ;
    skos:definition "The body of traditional beliefs, legends, customs, music, arts, material culture, etc. that is shared by a culture or group of people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folklore"@en .

aat:300417627 a skos:Concept ;
    skos:definition "One who consigns or dispatches goods to another, to be sold, rented, or loaned to third parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consignors"@en .

aat:300417628 a skos:Concept ;
    skos:definition "Persons or organizations to whom goods are consigned by consignors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consignees"@en .

aat:300417629 a skos:Concept ;
    skos:definition "The body of mythical stories or traditional beliefs belonging to a particular religious or cultural tradition; usage often differs from standard religions only in that the belief system is no longer extant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mythologies"@en .

aat:300417630 a skos:Concept ;
    skos:definition "Solemn blessings bestowed by the pope or his delegates, usually including patriarchs, primates, archbishops, and bishops. In locations where these prelates are unavailable, the delegate may be a local priest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apostolic blessings"@en .

aat:300417631 a skos:Concept ;
    skos:definition "Persons who organize auction sales and prepare catalogs, rooms, and advertisements, but do not conduct the sale itself. Experts historically would announce a description of each lot as it was offered, and worked in tandem with commissaires-priseurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experts"@en .

aat:300417632 a skos:Concept ;
    skos:definition "Art in which people are socially or physically engaged directly in an artwork, allowing them to become creative participants in a work or action, to the extent that they may be considered co-authors, though usually anonymous. This type of work is considered incomplete without the interaction of viewers or audience. For technological works that require physical manipulation, or that are directed by formal instructions given by the artist, use \"interactive art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "participatory art"@en .

aat:300417633 a skos:Concept ;
    skos:definition "The standing or position of affairs, according to the law, of a person, site, object, conceptual work, other thing, or activity. Included with status are often designated and defined various privileges, protections, obligations, restrictions, or powers. Examples could include the status of a building as private property, or the status of a person as citizen of a given nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal status"@en .

aat:300417634 a skos:Concept ;
    skos:definition "The legal or practical methods or means by which property of some sort is bought, acquired, or transferred. An example is the means by which an art object entered the collection of a particular museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methods of acquisition"@en .

aat:300417635 a skos:Concept ;
    skos:definition "Exceptionally intelligent or talented people, particularly those having an intelligence quotient greater than 140 on the Lewis Terman scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geniuses"@en .

aat:300417637 a skos:Concept ;
    skos:definition "General term for the method of acquiring property through transference by one person or institution to another person or institution, voluntarily and without any payment required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift"@en .

aat:300417638 a skos:Concept ;
    skos:definition "Method of acquiring funds or property through transference of ownership from one party to another as a free gift."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "donation"@en .

aat:300417639 a skos:Concept ;
    skos:definition "Method of acquiring property by request from the creator or producer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commission"@en .

aat:300417640 a skos:Concept ;
    skos:definition "Method of acquiring property, usually indirectly by using money or income that has been provided by a benefactor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endowment"@en .

aat:300417641 a skos:Concept ;
    skos:definition "Method of acquiring property by transference or bestowal following the death of a benefactor, by means of the last will or other method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bequest"@en .

aat:300417642 a skos:Concept ;
    skos:definition "Method of acquiring property by payment of funds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purchase"@en .

aat:300417643 a skos:Concept ;
    skos:definition "Method of acquiring property through bidding at an auction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auction"@en .

aat:300417644 a skos:Concept ;
    skos:definition "Method of acquiring property by legally conferring existing ownership to another person or institution; it does not necessarily involve benefactors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transfer"@en .

aat:300417645 a skos:Concept ;
    skos:definition "Method of acquiring property for temporary use, with or without the payment of interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loan"@en .

aat:300417646 a skos:Concept ;
    skos:definition "Method of acquiring property for use over an extended period of time, but without transferring ownership to the second party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long-term loan"@en .

aat:300417647 a skos:Concept ;
    skos:definition "Properties or funds with which a society, institution, etc. has been bestowed by a benefactor; usually limited to assets donated to and for the perpetual benefit of a non-profit institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endowments"@en .

aat:300417648 a skos:Concept ;
    skos:definition "A thing or money, the use of which by another party is allowed for a time, on the understanding that it shall be returned or an equivalent given; often let out at interest, meaning payment must be made for the use of the thing or money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loans"@en .

aat:300417649 a skos:Concept ;
    skos:definition "Method of acquiring property for temporary use under terms by which the party in possession of the property will pay a regular fee for having control of or occupying the property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rental"@en .

aat:300417650 a skos:Concept ;
    skos:definition "Method of acquiring property with the expectation that the recipient will sell, rent, or loan this property to a third party, for the mutual benefit of the consignor and consignee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consignment"@en .

aat:300417651 a skos:Concept ;
    skos:definition "The legal, physical, historical, or other state or condition of property, usually with reference to physical objects or sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "status of property"@en .

aat:300417652 a skos:Concept ;
    skos:definition "In cataloging art and cultural heritage, refers to the method of acquiring property directly from the creator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collection of artist"@en .

aat:300417653 a skos:Concept ;
    skos:definition "In cataloging art and cultural heritage, refers to the first known owner of the work, when the method of acquisition is unknown or not applicable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "original owner"@en .

aat:300417654 a skos:Concept ;
    skos:definition "Refers to the property having been collected at an archeological site or other site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field collected"@en .

aat:300417655 a skos:Concept ;
    skos:definition "The status or condition of a thing or site for which the location is unknown or which no longer exists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost"@en .

aat:300417656 a skos:Concept ;
    skos:definition "The status or condition of a thing or site having been obliterated or ravaged to such a state as to be rendered useless or reduced to rubble. For lesser states of severe damage of architecture or sites, prefer \"ruined.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "destroyed"@en .

aat:300417657 a skos:Concept ;
    skos:definition "The status or condition of property having been obtained by theft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stolen"@en .

aat:300417658 a skos:Concept ;
    skos:definition "The status or condition of property having been taken or forfeited by a governmental or other entity in power or having authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confiscated"@en .

aat:300417659 a skos:Concept ;
    skos:definition "The status or condition of property having been damaged or carried off as booty in time of war or unrest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "looted"@en .

aat:300417660 a skos:Concept ;
    skos:definition "Property owned by an individual person or group and kept for their exclusive use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private property"@en .

aat:300417661 a skos:Concept ;
    skos:definition "Discipline specializing in garden projects that are most often sited at a residence. Garden design is generally of smaller scale than landscape design, and may have defined boundaries.The practice differs from landscape architecture in the level of accreditation of the practitioner. For the discipline that requires licensed architects to design the use of outdoor space and the land, and that may include site planning, urban planning, park and recreation planning, garden design and historic preservation, use 'landscape architecture.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden design"@en .

aat:300417662 a skos:Concept ;
    skos:definition "Property owned by a state or other governmental body but dedicated to use by the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public property"@en .

aat:300417663 a skos:Concept ;
    skos:definition "Property that is insured for a specific amount."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scheduled property"@en .

aat:300417664 a skos:Concept ;
    skos:definition "Property having an officially registered title, title plan, and other pertinent documents, which are held by an official agency, such as in a governmental land registry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registered property"@en .

aat:300417665 a skos:Concept ;
    skos:definition "Artifacts, institutions, persons, literature, and other entities regarded as emblematic and valuable in representing a nation's cultural heritage and identity. The identification of such works may be codified in law or statute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national treasures"@en .

aat:300417666 a skos:Concept ;
    skos:definition "Small, decorative handbags, usually without handles, but often with an attached chain, intended as accessories for women's formal evening wear. They are typically constructed as small rigid metal boxes that hold only a few essential cosmetic items, and may have elaborate shapes, beading, metalwork or other forms of surface embellishment. The term was coined by the jeweler Charles Arpels in 1930 to describe objects of his design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minaudieres"@en .

aat:300417667 a skos:Concept ;
    skos:definition "Marks printed or impressed on a surface, in wax, or otherwise applied to a material by \"seals (artifacts),\" which are devices bearing a design, emblem, a letter, name, or words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seals"@en .

aat:300417668 a skos:Concept ;
    skos:definition "Watercraft of various pre-Columbian South American civilizations constructed from woven reeds of the Totora bullrush. The form and size may vary, including small fishing boats and large transporting vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balsas"@en .

aat:300417669 a skos:Concept ;
    skos:definition "Subspecies of giant bullrush native to areas of South America and some Pacific islands; known for its use in making boats and other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schoenoplectus californicus ssp. tatora"@en .

aat:300417670 a skos:Concept ;
    skos:definition "Mesoamerican solid rubber balls used in ballgames, burned as sacrifices, buried as votive offerings, and for other purposes; first appeared before 1600 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ōllamaloni"@en .

aat:300417671 a skos:Concept ;
    skos:definition "Precolumbian Mesoamerican ritual ball game. The game was played on a court shaped like a capital I with serifs and oriented north–south or east–west; it represented the heavens. Players, wearing heavy padding, used elbows, knees, and hips to knock a solid rubber ball into the opponent’s end of the court. A version of the game is still played today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ollama"@en .

aat:300417672 a skos:Concept ;
    skos:definition "Dispersions of a people from their original homeland. Examples are the diaspora of Jewish people from Israel and the disapora of African people from Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diasporas"@en .

aat:300417673 a skos:Concept ;
    skos:definition "Populations who have spread or become dispersed beyond their traditional homeland or point of origin, by either voluntary or forced means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaspora"@en .

aat:300417674 a skos:Concept ;
    skos:definition "Culture of the body of people who were displaced from their African homeland, and their descendants. Examples include those who traveled in ancient migrations and those who were involuntarily transported due to slavery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African diaspora"@en .

aat:300417675 a skos:Concept ;
    skos:definition "Refers to the culture with roots in the Middle Eastern peoples associated with monotheistic religion of Judaism. Usage does not necessarily refer to religion. Refers to the style, and culture of people of the Jewish faith."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jewish"@en .

aat:300417676 a skos:Concept ;
    skos:definition "The culture of the body of Jews living outside the land of Israel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jewish diaspora"@en .

aat:300417677 a skos:Concept ;
    skos:definition "People who prepare feathers for some purpose, or who create works made of or employing feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather workers"@en .

aat:300417678 a skos:Concept ;
    skos:definition "Farming in which large planting areas are located on raised platforms or raised fields, allowing farmers to better regulate or avoid flooding. Examples are the raised field agriculture of some Pre-Columbian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raised field agriculture"@en .

aat:300417679 a skos:Concept ;
    skos:definition "The practice and activity of breeding, raising, feeding, and tending animals, especially but not exclusively domestic farm animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal husbandry"@en .

aat:300417680 a skos:Concept ;
    skos:definition "Form of farming in which nearly all of the crops or livestock raised are used to maintain the farmer and the farmer’s family, leaving little, if any, surplus for sale or trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subsistence farming"@en .

aat:300417681 a skos:Concept ;
    skos:definition "Form of farming in which crops are grown reliant upon the varying residual moisture in delta areas and other floodplains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floodplain agriculture"@en .

aat:300417682 a skos:Concept ;
    skos:definition "Form of farming in that takes place on hillsides and other upland areas, used for the raising of crops or rearing sheep, cattle, or other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hill farming"@en .

aat:300417683 a skos:Concept ;
    skos:definition "Form of farming that relies upon flooded soils to cultivate a crop, usually rice. This form of farming conserves soil's organic matter and nitrogen from biological sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice farming"@en .

aat:300417684 a skos:Concept ;
    skos:definition "Form of farming that uses steps or terraces on an upland area, to maximize arable land area by creating horizontal, flat plots for crops. A prime example of the practice was in Pre-Columbian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrace farming"@en .

aat:300417685 a skos:Concept ;
    skos:definition "The quality or state of being worthy, honored, or noble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dignity"@en .

aat:300417686 a skos:Concept ;
    skos:definition "Refers to the quality or expression of discrimination, partiality, or high regard given to a person or thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "respect"@en .

aat:300417687 a skos:Concept ;
    skos:definition "Culture of an indigenous Pre-Columbian people who were a hunting society and a subdivision of the Ona of the Patagonian region of southern Argentina and Chile, including the Tierra del Fuego islands. Now virtually extinct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Selk'nam"@en .

aat:300417688 a skos:Concept ;
    skos:definition "Cloaks or capes made of animal skins or pelts; usually implies a cloak that is not a luxury item, for example, not made of mink pelts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin cloaks"@en .

aat:300417689 a skos:Concept ;
    skos:definition "Cloaks worn by the Aboriginal people of certain areas of Australia, made from the skins of Australian possums (members of Phalangeriformes), sometimes together with other small pelts such as from flying squirrels, sewn together; the cloaks were used as a garment to cover the back and shoulders, as a blanket, and as a sling for carrying infants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "possum-skin cloaks"@en .

aat:300417690 a skos:Concept ;
    skos:definition "Family containing 70 or more species of marsupial mammals in 12 genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Didelphidae"@en .

aat:300417691 a skos:Concept ;
    skos:definition "Suborder of arboreal marsupial mammals containing around 70 species native to Australia, New Guinea, and Sulawesi, and introduced to New Zealand and China. Although the common name is similar to that of an order of American marsupials, the animals are not closely related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phalangeriformes"@en .

aat:300417692 a skos:Concept ;
    skos:definition "Family of nocturnal marsupial mammals native to Australia, New Guinea, and parts of Indonesia; according to some classifications, the family includes 6 genera containing 28 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phalangeridae"@en .

aat:300417693 a skos:Concept ;
    skos:definition "Books containing rulings, rules, or regulations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rule books"@en .

aat:300417694 a skos:Concept ;
    skos:definition "Rules, regulations, and principles, usually documented, that a particular country or community has established and recognizes as regulating the actions of its members and that may be enforced by the imposition of penalties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laws"@en .

aat:300417695 a skos:Concept ;
    skos:definition "Laws that regulate expenditure, typically with a view to restraining what is perceived by the lawmakers or society as excess in food, dress, equipage, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sumptuary laws"@en .

aat:300417696 a skos:Concept ;
    skos:definition "Standards, codes, laws, rules, and principles that are considered proper, correct, or consonant with justice, and related uses regarding what is permitted and forbidden in a particular country, society, or community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rights"@en .

aat:300417697 a skos:Concept ;
    skos:definition "Rights possessed by women, typically as considered to be equal with those of men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "women's rights"@en .

aat:300417699 a skos:Concept ;
    skos:definition "Ritual killings of humans as an offering to deities or other supernatural forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human sacrifices"@en .

aat:300417700 a skos:Concept ;
    skos:definition "Objects, food, or other materials that are considered sacrifices or oblations, presented to a god, saint, sacred place, etc., as an act of worship, devotion, or homage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offerings"@en .

aat:300417701 a skos:Concept ;
    skos:definition "Objects that are in the possession of one party, and transferred to another party without the expectation or receipt of an equivalent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gifts"@en .

aat:300417702 a skos:Concept ;
    skos:definition "Gifts that are placed in or near graves to pay homage or as offerings to the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave gifts"@en .

aat:300417703 a skos:Concept ;
    skos:definition "Objects that are believed to have an origin in the supernatural world, not the natural world, or that may be used to contact the spirit world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit objects"@en .

aat:300417704 a skos:Concept ;
    skos:definition "In Chinese culture, certain objects placed in tombs for the use of the deceased or as the vessels for spirits. Included are figurines of people and animals, buildings and tools, and replicas of objects in life made of precious materials, such as jewels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mingqi"@en .

aat:300417705 a skos:Concept ;
    skos:definition "Objects or other gifts given to a person or place, or exchanged between two parties, as a sign of esteem and honor. May involve ritual and ceremony; in historical contexts, may involve slaves or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribute gifts"@en .

aat:300417706 a skos:Concept ;
    skos:definition "Recreational parks that are open to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public parks"@en .

aat:300417707 a skos:Concept ;
    skos:definition "Relatively large areas intended for enjoyment and amusement, distinguished by woods and other features, such as architectural fantasies and riding trails. For smaller areas having a similar purpose but with an enclosing wall and focusing on flowers, shrubs, mazes, fruit trees, pedestrian paths, etc., prefer \"pleasure gardens.\" Later pleasure parks may include separate areas for different amusements, forerunners of \"amusement parks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleasure parks"@en .

aat:300417708 a skos:Concept ;
    skos:definition "Tracts of land set aside for the propagation of wild animals for hunting. Early hunting parks in Europe and Asia were wooded, but later parks in European colonies in Africa may include savanna or other types of land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting parks"@en .

aat:300417709 a skos:Concept ;
    skos:definition "Hunts arranged for royalty or other rulers. Prime examples were ritual hunts in Europe and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal hunts"@en .

aat:300417710 a skos:Concept ;
    skos:definition "Material derived from the shells of certain turtles and tortoises, sometimes utilizing the entire shell. Differs from the material \"tortoise shell\" in the way it is prepared and its finished appearance; also often derived from different species than is \"tortoise shell.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turtle shell"@en .

aat:300417711 a skos:Concept ;
    skos:definition "Systems of procedures or processes for interpreting and enforcing the law, elaborating the rights and responsibilities involved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal systems"@en .

aat:300417712 a skos:Concept ;
    skos:definition "Systems of ethical and moral codes taught by religious traditions. Types of religious law include Jewish halakha, Christian canon law, Islamic sharia, and Hindu law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious law"@en .

aat:300417713 a skos:Concept ;
    skos:definition "Systems of law derived from English law based on custom and judicial precedent rather than statutes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common law"@en .

aat:300417714 a skos:Concept ;
    skos:definition "Decorative or ceremonial plates or panels worn over the breast. Examples are breastplates of Pre-Columbian cultures. For breastplates used as armor, prefer \"breastplates (body armor).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breastplates"@en .

aat:300417715 a skos:Concept ;
    skos:definition "Breast ornaments worn by Jewish high priests. Traditionally comprising a folded piece of embroidered linen worn on the breast, and adorned with twelve precious stones, representing the twelve tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "priestly breastplates"@en .

aat:300417716 a skos:Concept ;
    skos:definition "The process of converting or adapting a thing or material for a different purpose or for use in a different way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repurposing"@en .

aat:300417717 a skos:Concept ;
    skos:definition "Material comprising the dentin of walrus tusks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walrus ivory"@en .

aat:300417718 a skos:Concept ;
    skos:definition "Material comprising the dentin of whale teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whale ivory"@en .

aat:300417719 a skos:Concept ;
    skos:definition "Material comprising the bone of whales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whale bone"@en .

aat:300417720 a skos:Concept ;
    skos:definition "Material derived from the tusks of mature African or Asian elephants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elephant ivory"@en .

aat:300417721 a skos:Concept ;
    skos:definition "Masks placed over the face of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary masks"@en .

aat:300417723 a skos:Concept ;
    skos:definition "Large packages consisting of cloth or leather wrapped around a human cadaver or sacrificial animal and other objects. Prime examples are funerary bundles of the indigenous cultures of the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary bundles"@en .

aat:300417724 a skos:Concept ;
    skos:definition "Funerary bundles of the indigenous cultures of the Andes, containing the mummified remains of sacrificial victims or other people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummy bundles"@en .

aat:300417725 a skos:Concept ;
    skos:definition "Special ceremonial cloths, often decoratively woven or embroidered, used to wrap funerary bundles of the indigenous cultures of Mexico, Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bundle cloths"@en .

aat:300417726 a skos:Concept ;
    skos:definition "Collections of things bound or otherwise fastened or bound together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bundles"@en .

aat:300417727 a skos:Concept ;
    skos:definition "Canvas to which primer, which is a white ground or other coating that imparts a uniform texture and absorbency, has not been applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unprimed canvas"@en .

aat:300417728 a skos:Concept ;
    skos:definition "Canvas to which size, a glutinous materials used for filling the pores in surfaces, has not been applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unsized canvas"@en .

aat:300417729 a skos:Concept ;
    skos:definition "Even-weave textile of long, strong cotton or linen fibers, used as a needlepoint foundation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlepoint canvas"@en .

aat:300417730 a skos:Concept ;
    skos:definition "Fine guage mesh of thread, plastic, or another material, used as a needlepoint foundation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlepoint mesh"@en .

aat:300417731 a skos:Concept ;
    skos:definition "General term for chemically reactive silane compounds, used as sealers and consolidants for concrete and sandstones, introduced in the 1980s. They are used alone or in combination with acrylic resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkoxysilane"@en .

aat:300417732 a skos:Concept ;
    skos:definition "Special clothing worn by royalty, in part intended to designate their position and stature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal costume"@en .

aat:300417733 a skos:Concept ;
    skos:definition "Special clothing used for performances of dance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance costume"@en .

aat:300417734 a skos:Concept ;
    skos:definition "General term for animals, real or legendary, having a long, sinuous form; often, but not always, animals that are snakes (Serpentes suborder) or have a form like snakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpents"@en .

aat:300417735 a skos:Concept ;
    skos:definition "Nahua elites or lords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tecuhtli"@en .

aat:300417737 a skos:Concept ;
    skos:definition "Religion of the Aztec culture. It was based on earlier belief systems, filtered down from the Olmecs, Teotihuacan, Monte Alban, Mayan, and fellow Nahuatl-speaking Toltec peoples; was typically Mesoamerican in terms of cosmology, the emphasis on the sun, and even particular deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aztec religion"@en .

aat:300417738 a skos:Concept ;
    skos:definition "Books or similar documents that recount and depict nuptial festivities and events, chiefly of royalty, nobility, or famous persons, and which may also include literary works offered to the principals, such as epithalamia or the Italian \"per le nozze.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding books"@en .

aat:300417740 a skos:Concept ;
    skos:definition "Used to distinguish photographs that are created from the original negative or other master image, as distinguished from reproductive copies of original photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "original photographs"@en .

aat:300417741 a skos:Concept ;
    skos:definition "Bookbindings decorated with painting, often along with gilding or other decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painted leather bindings"@en .

aat:300417742 a skos:Concept ;
    skos:definition "Process of analysis done by transversing the scanned subject by a detector or an electromagnetic beam; scanning is done to determine the nature, qualities, measurements, etc. of an object, living subject, area, or other thing; the analysis may involve the recording of information derived from the scanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scanning"@en .

aat:300417743 a skos:Concept ;
    skos:definition "The general method used to sample or scan a surface using laser technology. Controlled deflection of laser beams to perform analysis or provide insight. Uses are many, including in laser printers, in laser shows, stereolithography machines, barcode scanners, in rapid prototyping, in machines for material processing, in laser engraving machines, in ophtalmological laser systems, and in many other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser scanning"@en .

aat:300417744 a skos:Concept ;
    skos:definition "Process of scanning a three-dimensional real-world object or environment to analyze and collect data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "3-D laser scanning"@en .

aat:300417745 a skos:Concept ;
    skos:definition "Spectral analysis of electromagnetic radiation reflected from a surface as a means of investigating the properties of surface material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflectance spectroscopy"@en .

aat:300417746 a skos:Concept ;
    skos:definition "Plant family including more than 2,000 species, grouped into around 175 genera, although classification is much debated. Most species are native to the New World, found the length of North and South America. It is debated whether or not they are true cacti, but some species may possibly be found in East Africa, Madagascar, and Sri Lanka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cactaceae"@en .

aat:300417747 a skos:Concept ;
    skos:definition "Genus of extremely slow growing, spineless, button-like cacti native to Texas and Mexico; the various species grow low to the ground and they often form groups with numerous, crowded shoots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lophophora"@en .

aat:300417748 a skos:Concept ;
    skos:definition "Species of small, spineless cactus native to Texas and Mexico. Peyote contains the hallucinogen mescaline. The plant is ingested for its psychoactive properties, having a long history of ritualistic and medicinal use by indigenous North Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lophophora williamsii"@en .

aat:300417749 a skos:Concept ;
    skos:definition "Written treatises presenting the author’s scholarly investigation or original research on a specialized subject. Examples are treatises submitted for an advanced academic degree or historical European treatises written by the praeses or primary professor and defended by the respondent or degree candidate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic dissertations"@en .

aat:300417750 a skos:Concept ;
    skos:definition "Body of laws that are derived from canon law and civil law, administered by ecclesiastical courts. Ecclesiastical laws govern the rules and doctrine of a specific church. Examples are the laws of the Anglican church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecclesiastical laws"@en .

aat:300417752 a skos:Concept ;
    skos:definition "Humorous poems, often bawdy, consisting of five lines, three long and two short, with an a/a/b/b/a rhyme scheme and typically a rigid meter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limericks"@en .

aat:300417753 a skos:Concept ;
    skos:definition "Nuptial poems or songs in praise of the bride and bridegroom, and praying for their prosperity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epithalamia"@en .

aat:300417754 a skos:Concept ;
    skos:definition "In the singular form, title assumed by Adolf Hitler in 1934 as head of the German Reich."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "führers"@en .

aat:300417755 a skos:Concept ;
    skos:definition "Poetry in honor of a married couple and marriage; by traditional convention, composed and delivered at a wedding celebration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epithalamic poetry"@en .

aat:300417756 a skos:Concept ;
    skos:definition "Bookbindings that use leather, generally either as the primary cover or to wrap a board cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leather bindings"@en .

aat:300417757 a skos:Concept ;
    skos:definition "Books won or offered as a prize; usually special books of very high quality and having content thematically related to the event or accomplishment for which the prize was awarded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prize books"@en .

aat:300417758 a skos:Concept ;
    skos:definition "Exhibitions featuring works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art exhibitions"@en .

aat:300417759 a skos:Concept ;
    skos:definition "Covers, usually made of paper, used to cover sheet music; the golden age of sheet music cover designs began ca. 1820, following the invention of lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet music covers"@en .

aat:300417760 a skos:Concept ;
    skos:definition "Literature comprising stories, often children's stories, told in rhyming verse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stories in rhyme"@en .

aat:300417761 a skos:Concept ;
    skos:definition "Bookbindings that use cloth, generally wrapping a board cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth bindings"@en .

aat:300417762 a skos:Concept ;
    skos:definition "Sales involving works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art sales"@en .

aat:300417763 a skos:Concept ;
    skos:definition "Literature comprising stories having a strong sexual content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erotic stories"@en .

aat:300417765 a skos:Concept ;
    skos:definition "Stories and tales for children, usually fiction or fantastical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's stories"@en .

aat:300417766 a skos:Concept ;
    skos:definition "Genre of motion pictures, television, and radio shows characterized by a setting in the American West during the time of western expansion, usually the 1850s through the early 1900s. May also apply to certain films with similar themes but set in Australia, Argentina, or other places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "western"@en .

aat:300417767 a skos:Concept ;
    skos:definition "Literature written by travelers, typically describing interesting or exotic places, the inhabitants, and adventures; often illustrated. The genre differs from \"travel guidebooks\" in not necessarily advising about lodging, food, and sights to see."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travelers’ writings"@en .

aat:300417768 a skos:Concept ;
    skos:definition "Books containing short biblical passages with illustrations; may be in rebus form. The type flourished in Germany and elsewhere in the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hieroglyphic bibles"@en .

aat:300417769 a skos:Concept ;
    skos:definition "General term for documents of any type that are illustrated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illustrated works"@en .

aat:300417770 a skos:Concept ;
    skos:definition "Formal addresses or speeches given at a funeral or otherwise in honor of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral orations"@en .

aat:300417771 a skos:Concept ;
    skos:definition "Religious discourses delivered by the celebrant at a funeral or otherwise in honor of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral sermons"@en .

aat:300417773 a skos:Concept ;
    skos:definition "Narratives structured in the form of dialogues consisting of the imagined speech of real people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imaginary conversations"@en .

aat:300417774 a skos:Concept ;
    skos:definition "Books in which to draw, with pages that are wholly blank or instructional, with designs to be copied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing books"@en .

aat:300417775 a skos:Concept ;
    skos:definition "Plays produced for schools, colleges, universities, or any educational institution, for any academic grade or level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school plays"@en .

aat:300417776 a skos:Concept ;
    skos:definition "Books in which to write, with pages that are wholly blank or instructional, providing instruction in handwriting or penmanship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing books"@en .

aat:300417777 a skos:Concept ;
    skos:definition "Catalogs in the form of comprehensive or selected lists issued by a library or group of libraries of the books, periodicals, maps, and other materials in their collections, arranged in systematic order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library catalogs"@en .

aat:300417778 a skos:Concept ;
    skos:definition "Color printing in which colors are laid down separately in multiple steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiple-pass color printing"@en .

aat:300417779 a skos:Concept ;
    skos:definition "Color printing in which colors are laid down in one step."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-pass color printing"@en .

aat:300417780 a skos:Concept ;
    skos:definition "Poetry composed and delivered in honor of a person, extolling the person's character or accomplishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laudatory poetry"@en .

aat:300417781 a skos:Concept ;
    skos:definition "Bookbindings having raised letters or designs on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossed bindings"@en .

aat:300417782 a skos:Concept ;
    skos:definition "Literature that is a burlesque imitation of the heroic style, employing the imitation of a heroic character, manner, or actions, usually for humorous effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mock heroic literature"@en .

aat:300417783 a skos:Concept ;
    skos:definition "Literature having to do with plants and botany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botanical literature"@en .

aat:300417784 a skos:Concept ;
    skos:definition "Books or similar documents that recount, describe, and depict a coronation and associated festivities and events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronation books"@en .

aat:300417785 a skos:Concept ;
    skos:definition "Artist books made by certain Russian and other avant-garde artists, dating to the first third of the 20th century, marked by innovations in graphic design combined with experimentation in poetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avant-garde books"@en .

aat:300417786 a skos:Concept ;
    skos:definition "Ancient Greek sacred cult songs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek hymns"@en .

aat:300417787 a skos:Concept ;
    skos:definition "Short written or oral narrative accounts composed for the entertainment of the listener or reader; usually refer to imaginary events, but may sometimes refer to real events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stories"@en .

aat:300417788 a skos:Concept ;
    skos:definition "Narratives of a detached incident, or of a single event, told as being in itself interesting or striking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anecdotes"@en .

aat:300417789 a skos:Concept ;
    skos:definition "Cloth bindings made by the publisher, usually uniform bindings distinctive to that edition; as distinguished from cloth bindings added in a later restoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publishers' cloth bindings"@en .

aat:300417790 a skos:Concept ;
    skos:definition "Documents containing accounts of the meetings and papers presented at a conference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conference proceedings"@en .

aat:300417791 a skos:Concept ;
    skos:definition "Literature about natural objects, beings, and phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural history literature"@en .

aat:300417792 a skos:Concept ;
    skos:definition "Stories that focus on or deal primarily with animals, plants, natural features, or natural phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nature stories"@en .

aat:300417793 a skos:Concept ;
    skos:definition "Narratives, usually told in first person, relating the life events or experiences of the narrator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal narratives"@en .

aat:300417794 a skos:Concept ;
    skos:definition "Literary works that are presented as the work of an author by whom they are not written, with the intention to deceive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary forgeries"@en .

aat:300417795 a skos:Concept ;
    skos:definition "Bibliographies comprising citations for works about a given person, or containing biographical information about the author or authors in the bibliography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bio-bibliographies"@en .

aat:300417796 a skos:Concept ;
    skos:definition "Plays intended to be acted by children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's plays"@en .

aat:300417797 a skos:Concept ;
    skos:definition "Books or similar documents that recount and depict tournament festivities and events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tournament books"@en .

aat:300417798 a skos:Concept ;
    skos:definition "Plays in which the dialogue is written in verse lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verse drama"@en .

aat:300417799 a skos:Concept ;
    skos:definition "Advertising materials for those selling books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booksellers' advertisements"@en .

aat:300417801 a skos:Concept ;
    skos:definition "Plays written chiefly to amuse the audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comedy plays"@en .

aat:300417802 a skos:Concept ;
    skos:definition "Advertising materials for those publishing books or prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publishers' advertisements"@en .

aat:300417803 a skos:Concept ;
    skos:definition "Book edition in which prints, engravings, letters, or other documents are added after publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extra-illustrated books"@en .

aat:300417804 a skos:Concept ;
    skos:definition "Poetry intended for children, to be read by children or to children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's poetry"@en .

aat:300417806 a skos:Concept ;
    skos:definition "Poetry intended to be funny or cause mirth in the reader. Poetry that is primarily funny or displaying humor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humorous poetry"@en .

aat:300417807 a skos:Concept ;
    skos:definition "Books of designs or plans for architecture or architectural details, circulated or published to enable widespread copying; in addition to illustrations, may describe techniques and working methods for construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural pattern books"@en .

aat:300417808 a skos:Concept ;
    skos:definition "Textile works with figural or other representational subjects depicted. An ancient art form; some of the earliest references to this type of visual works are in Iliad and the Odyssey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woven pictures"@en .

aat:300417809 a skos:Concept ;
    skos:definition "Books or other gatherings of orations and other speeches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "books of speeches"@en .

aat:300417810 a skos:Concept ;
    skos:definition "General term for cartographic works made by human observation and surveying, prior to the invention of complex scientific cartographic equipment in the 19th century and later. Ancient maps are documented by the 7th century BCE; star maps dating to 14,500 BCE are found on the walls of the Lascaux caves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "early maps"@en .

aat:300417811 a skos:Concept ;
    skos:definition "Publications containing titles and useful facts about books and other publications; usually annuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary almanacs"@en .

aat:300417812 a skos:Concept ;
    skos:definition "Literature intended for the general audience, rather than for specialists and not having the goal to attain critical acclaim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popular literature"@en .

aat:300417813 a skos:Concept ;
    skos:definition "Refers to works in any medium intended for use by or the appreciation of a general audience, as opposed to works intended for the appreciation or use of specialists, experts, or critics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popular works"@en .

aat:300417814 a skos:Concept ;
    skos:definition "Cloth book bindings that have an illustration or other image applied to or in the fabric of the binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial cloth bindings"@en .

aat:300417815 a skos:Concept ;
    skos:definition "Individual copies of books or other publications, including prints, made for presentation by the author, usually a gift."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authors’ presentation copies"@en .

aat:300417816 a skos:Concept ;
    skos:definition "Literature genre that has a religious subject or spiritual theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious poetry"@en .

aat:300417817 a skos:Concept ;
    skos:definition "Literature having a religious subject or spirtual theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious literature"@en .

aat:300417818 a skos:Concept ;
    skos:definition "Decorations designed or used for festivals, which are any gala occasions devoted to community observances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festival decorations"@en .

aat:300417819 a skos:Concept ;
    skos:definition "Catalogs listing items in a collection or highlights of a collection in a museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museum catalogs"@en .

aat:300417820 a skos:Concept ;
    skos:definition "Literature genre in which the plot could not happen in real life; may include themes of magic or witchcraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fantasy fiction"@en .

aat:300417821 a skos:Concept ;
    skos:definition "Poems with a religious subject or spiritual theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious poems"@en .

aat:300417822 a skos:Concept ;
    skos:definition "Texts of speeches to be delivered in an academic environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic addresses"@en .

aat:300417823 a skos:Concept ;
    skos:definition "In the context of libraries and publishing, refers to imprints indicating that the work was printed in Europe rather than in the United States or elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transatlantic imprints"@en .

aat:300417824 a skos:Concept ;
    skos:definition "Literary genre that emphasizes interior characterization, including the motives and circumstances that lead to plot actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychological fiction"@en .

aat:300417825 a skos:Concept ;
    skos:definition "Poetry of ancient Rome, based on ancient Greek models. Early examples are plays in verse dating to the 3rd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin poetry"@en .

aat:300417826 a skos:Concept ;
    skos:definition "Guides, usually printed, to the motion pictures or other features composing a motion picture theater presentation. These often include the credits of a motion picture, as well as coming attractions and other advertising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion picture theater programs"@en .

aat:300417827 a skos:Concept ;
    skos:definition "Indigenous Mexican effigy braziers that functioned as receptacles for copal incense that, when burned, produced a thick, musky smoke that rose through openings in the figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xantiles"@en .

aat:300417828 a skos:Concept ;
    skos:definition "Pre-Columbian ritual libation vessels, comprising two chambers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pacchas"@en .

aat:300417829 a skos:Concept ;
    skos:definition "Social gatherings of guests invited to a dinner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinner parties"@en .

aat:300417830 a skos:Concept ;
    skos:definition "Shape comprising the open surface generated by revolving a hyperbola about either of its axes. If the tranverse axis of the surface lies along the x axis and its centre lies at the origin and if a, b, and c are the principal semi-axes, then the general equation of the surface is expressed as x2/a2 ± y2/b2 − z2/c2 = 1."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyperboloid"@en .

aat:300417831 a skos:Concept ;
    skos:definition "Attribute of something reaching the floor, often drapery or clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor-length"@en .

aat:300417832 a skos:Concept ;
    skos:definition "Quality or condition of being impure or of containing something foul or unclean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impurity"@en .

aat:300417833 a skos:Concept ;
    skos:definition "The state or quality of being morally or spiritually pure, sinless, or free from ritual pollution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purity"@en .

aat:300417834 a skos:Concept ;
    skos:definition "A palindrome is a word or a sequence of words that reads, letter for letter, the same backwards as forwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palindromes"@en .

aat:300417835 a skos:Concept ;
    skos:definition "Crisp, thin wafers containing or intended to contain ice cream; usually conical or having a truncated cone-like shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice cream cones"@en .

aat:300417836 a skos:Concept ;
    skos:definition "General term for sexual activity or behavior of any type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sex"@en .

aat:300417837 a skos:Concept ;
    skos:definition "Sexual activity in which the male organ of a partner is sucked or licked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fellatio"@en .

aat:300417838 a skos:Concept ;
    skos:definition "Females who succeed or are designated to succeed to property or rank, either by will or law, upon the death of the former possessor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heiresses"@en .

aat:300417839 a skos:Concept ;
    skos:definition "Shape comprising a solid of which all the plane sections through one of the axes are ellipses, and all other sections ellipses or circles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ellipsoid"@en .

aat:300417840 a skos:Concept ;
    skos:definition "Those engaged in the art and craft of designing type, typefaces, or fonts. For those who use type to arrange compositions to print from, use \"typographers.\" Typographers may also act as type designers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type designers"@en .

aat:300417841 a skos:Concept ;
    skos:definition "The practice of designing type, typefaces, or fonts. For the process of using type in the production of printed or reading matter, use \"typography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type design"@en .

aat:300417842 a skos:Concept ;
    skos:definition "Genre of performing arts involving light popular songs, commonly of a satirical or topical nature, often together with a play or stage performance of a light and amusing character, often with other entertainments such a juggling, mime, etc. Particularly popular in the USA from the mid-1890s until the early 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaudeville"@en .

aat:300417843 a skos:Concept ;
    skos:definition "The action of restoring or giving back something to its rightful owner, or of making reparation for a loss previously inflicted; restoration of a thing lost, taken, or damaged. In the context of cultural property, this refers to returning cultural property to an individual, whereas \"repatriation\" refers to returning cultural property to a country or culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restitution"@en .

aat:300417844 a skos:Concept ;
    skos:definition "Suborder based on morphological features, containing iguanas, chameleons, agamids, and New World lizards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iguania"@en .

aat:300417845 a skos:Concept ;
    skos:definition "Family containing American Arboreal Lizards, Chuckwallas, Iguanas, and Iguanids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iguanidae"@en .

aat:300417846 a skos:Concept ;
    skos:definition "Genus containing herbivorous lizards that are native to tropical areas of Mexico, Central America, South America, and the Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iguana"@en .

aat:300417847 a skos:Concept ;
    skos:definition "General term for visual works that do not exist in the physical world, such as digital art works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virtual works"@en .

aat:300417848 a skos:Concept ;
    skos:definition "Proprietary name for an acrylic fiber used in textiles, especially for upholstery fabric. Registered as trademark by the German company Bayer in 1954."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dralon (R)"@en .

aat:300417849 a skos:Concept ;
    skos:definition "Any of various fleshy fruiting bodies of fungi consisting of a stalk and a cap. Forms deviating from the standard morphology usually have more specific names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mushrooms"@en .

aat:300417850 a skos:Concept ;
    skos:definition "Built works transmitted inter-generationally within a society and that are invested with significance in that society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural heritage"@en .

aat:300417851 a skos:Concept ;
    skos:definition "Fiber spun from the longest, degummable fibers of the waste of the silk cocoon. It is not as lustrous as reeled silk, which is a continuous fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schappe silk"@en .

aat:300417852 a skos:Concept ;
    skos:definition "Waste silk; spun from the shortest fibers of the waste leftover after making the slightly more valuable schappe silk. The fibers measure 3 to 5 centimeters. This shows less luster than the unspun filament of the cocoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bourette silk"@en .

aat:300417853 a skos:Concept ;
    skos:definition "A heavy ribbed or corded fabric made from a mixture of silk or cotton and other fibers including wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ottoman"@en .

aat:300417854 a skos:Concept ;
    skos:definition "Soft, thin woven, and usually unbleached fabric woven from uneven threads of raw silk, cotton, or artificial fibers. It is often piece-dyed or printed. The term, of Chinese origin, means 'woven at home'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pongee"@en .

aat:300417855 a skos:Concept ;
    skos:definition "Plain-woven fabric of any fiber or blend, with crosswise ribs that typically gives a corded surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poplin"@en .

aat:300417856 a skos:Concept ;
    skos:definition "Woven fabrics with ribbed or corded effects in either the warp or filling direction. Warp faced rib weave has a fine warp covering a thicker weft. In weft faced rib weave, a thin weft completely covers a thicker warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rib weave"@en .

aat:300417857 a skos:Concept ;
    skos:definition "Fabric in satin weave with a glossy surface similar to satin, but made with spun yarn rather than filament. Calendering is used to enhance its shiny surface. It is commonly used for lining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sateen"@en .

aat:300417858 a skos:Concept ;
    skos:definition "Thin, lightweight, sheer, or semi-transparent fabric usually made of cotton, silk, wool, or other synthetic fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voile"@en .

aat:300417859 a skos:Concept ;
    skos:definition "The spinnable fibers resulting from processing silk; damaged cocoons, waste caused by searching for the beginning of a continuous filament while reeling silk, or the inner section of a cocoon out of which moths have been allowed to escape. When spun, this yarn is less lustrous than filament silk yarn. It is mostly used as warp or weft in a fabric, or for products such as ribbon and sewing thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waste silk"@en .

aat:300417860 a skos:Concept ;
    skos:definition "Shoes intended as streetwear for women or girls that have a deep instep opening, and that are derived stylistically from ballet slippers. These feature a sturdier leather or plastic sole and typically have no heel or a very low one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballet flats"@en .

aat:300417861 a skos:Concept ;
    skos:definition "Hats of varied form, usually tall, round, and pleated, of starched fabric or paper, worn by chefs. Different heights may indicate rank within a kitchen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chef's toques"@en .

aat:300417862 a skos:Concept ;
    skos:definition "Clothing worn by Catholic boys and girls during the ceremony and often integral day of their first Communion. The outfits are from the 1830s very similar to wedding clothes: light-colored dresses and accessories for girls and a suit or uniform for boys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first communion clothing"@en .

aat:300417864 a skos:Concept ;
    skos:definition "Overcoats made from animal or artificial fur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fur coats"@en .

aat:300417866 a skos:Concept ;
    skos:definition "Wraparound garments first worn by the indigenous people of French Polynesia and the Cook Islands, and later adopted in other South Pacific islands including Hawaii and in other cultures (popularized as beachwear). Originally bark cloth, these are now usually a single straight piece of brightly patterned printed cotton cloth resembling Malaysian sarongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pareus"@en .

aat:300417867 a skos:Concept ;
    skos:definition "The undersurfaces of shoes that elevate the foot at approximately the same height over their entire length. These may be solid or constructed from discontinuous components such as stilts or wedges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform soles"@en .

aat:300417868 a skos:Concept ;
    skos:definition "Dobby weave is an allover figured fabric made on looms having a dobby attachment, with narrow strips of wood instead of Jacquard cards. Dobby weaves are limited to simple, small geometric figures, with the design repeated frequently, and are fairly inexpensive to produce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dobby weave"@en .

aat:300417869 a skos:Concept ;
    skos:definition "Describes the fashionable world of dressmakers and dressmaking establishments collectively, including all that contributes to it culturally. For the practice and industry of dressmaking associated with these houses, use \"couture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haute couture"@en .

aat:300417870 a skos:Concept ;
    skos:definition "A synthetic fabric with a thick, soft pile, used for outer clothing and blankets. Originally developed in 1979 by Malden Mills, a Massachusetts textile maker. Made from polyethylene terephthalate (PET), it has been adopted as an alternative to wool in applications that require warmth. It can be made from fibers recycled from plastic PET bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyester fleece"@en .

aat:300417871 a skos:Concept ;
    skos:definition "An artificial fiber, which was originally developed in Germany by J.P. Bemberg in 1901. For this type of artificial silk, previous to the filamenting process, the cellulose is dissolved in an ammoniacal copper solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupro"@en .

aat:300417872 a skos:Concept ;
    skos:definition "Fabric formed in a satin weave usually from silk or a manufactured fiber. It has a lustrous face and dull, crepe back. Charmeuse is most often used for lingerie, evening dresses, blouses, and linings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charmeuse"@en .

aat:300417873 a skos:Concept ;
    skos:definition "Fabric with a surface in a raised, rimpled, or blister-like texture. This effect is created either through the weaving or knitting process, or, in the case of a double weave, the different reaction of each of the layers to the finishing treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloqué"@en .

aat:300417874 a skos:Concept ;
    skos:definition "The skin and wool of newborn or fetal Caracul (Karakul) sheep, which display tight, glossy curls. Most often used for coats, hats, or trim. It may appear in black, grey, brown, or white, and is sometimes dyed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrakhan"@en .

aat:300417875 a skos:Concept ;
    skos:definition "Clothing meant for travelling. Particularly in reference to clothing from the 19th century onwards; the clothing typically reflects what is suitable for a particular means of transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel clothing"@en .

aat:300417876 a skos:Concept ;
    skos:definition "Shoes that are an element of Greek folk dress. The tip of the shoe is formed as an upstanding point, on top of which a pompom is attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tsarouchia"@en .

aat:300417877 a skos:Concept ;
    skos:definition "Dresses constructed so that panels cross over each other and can be fastened. These are of varied design and may be in any length and have a variety of sleeve types and necklines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrap dresses"@en .

aat:300417878 a skos:Concept ;
    skos:definition "Long-handled tools used in harvesting hops. Tendrils of the hop vines that wind around horizontal wires are cut off with the S-shaped blade which is welded or screwed at right angles to a prong ending in a hook. The hook protrudes above the leaf, or blade. Designs of this tool may vary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hopkappers"@en .

aat:300417879 a skos:Concept ;
    skos:definition "Hand tools for pulling poles from the ground consisting of two serrated jaws that rotate around a spindle, the two halves connected to each other with a chain. In hop growing, pole extraction pliers are used in combination with a lever to pull stakes from the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole extraction pliers"@en .

aat:300417880 a skos:Concept ;
    skos:definition "Irregular, rough silk reeled from double cocoons or cocoons spun side-by-side that have interlocked. The surface can be recognized by the irregular relief caused by the uneven width of the yarns, and this quality makes it difficult to distinguish from wild silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dupion"@en .

aat:300417881 a skos:Concept ;
    skos:definition "Fabric surfaces with a soft, napped quality, similar to the skin of a peach, created by brushing the face of a dense twill or satin weave. This surface may be found on fabrics in silk, cotton, or other artificial fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peau de pêche"@en .

aat:300417882 a skos:Concept ;
    skos:definition "A white or other colored crêpe made of artificial or raw silk fiber in plain weave with normal chain and weft of alternately two right and two left twisted yarns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crêpe de Chine"@en .

aat:300417883 a skos:Concept ;
    skos:definition "A semi-transparent artificial fiber or natural silk fabric woven in plain weave with undeterred chain and weft threads, alternately two right and two left twisted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crêpe georgette"@en .

aat:300417884 a skos:Concept ;
    skos:definition "Plain knit fabric formed with knit and purl sides, usually referring to fine machine-knitted fabric generally. This type of knit was originally a staple industry of the British isle of Jersey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jersey"@en .

aat:300417885 a skos:Concept ;
    skos:definition "A twill or pile fabric with a raised nap on both sides. Originally made of wool, it is most often now made of cotton or other synthetic fibers, and often used as a light-absorbent cloth in theater or film productions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duvetyne"@en .

aat:300417886 a skos:Concept ;
    skos:definition "Main garments of varying length that extend from the waist or hip and cover a part of the lower body, and that feature a series of folds set into them either by pressing or stitching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleated skirts"@en .

aat:300417887 a skos:Concept ;
    skos:definition "Calf-length boots made of water-resistant materials such as rubber, designed to protect the wearer from rain and mud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rain boots"@en .

aat:300417888 a skos:Concept ;
    skos:definition "Uniforms for school children, which are often made mandatory. School uniform designs vary, but may consist of a jacket and a skirt or a pair of pants, a collared shirt and a type of neckwear. Originally these may have been inspired by formal wear, military, or marine uniforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school uniforms"@en .

aat:300417889 a skos:Concept ;
    skos:definition "Women's dress shoes or pumps with very narrow high heels, which became fashionable from the 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilettos"@en .

aat:300417891 a skos:Concept ;
    skos:definition "Two-piece swimsuits consisting of a bikini bottom and a top part in the style of a tank top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tankinis"@en .

aat:300417892 a skos:Concept ;
    skos:definition "Latin as used since the late 14th century by authors emulating classical rather than medieval models from the beginning of Italian Humanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neo-Latin"@en .

aat:300417893 a skos:Concept ;
    skos:definition "Exhibition curators are the creative leaders that conceptualize and mount exhibitions, and are distinguished from curators in general, who manage collections in museums, galleries, libraries, and other repositories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition curators"@en .

aat:300417894 a skos:Concept ;
    skos:definition "Boys or girls' suits inspired by French or British marine-uniforms: blouses or jackets and trousers or skirts in white and blue, adorned with stripes in the contrasting color. The upper-body garment is also characterized by a flat collar that forms a rectangle down the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailor suits"@en .

aat:300417895 a skos:Concept ;
    skos:definition "Garments consisting of a cache-sexe and a narrow elasticated strip extending between the legs and buttocks to meet a waistband, and worn especially as an item of swimwear. For similar garments which leave the buttocks entirely uncovered, use 'G-strings'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thongs"@en .

aat:300417896 a skos:Concept ;
    skos:definition "Professional cooks, specifically head cooks in restaurants, hotels, or other food service organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chefs"@en .

aat:300417897 a skos:Concept ;
    skos:definition "In certain large mosques, raised platforms where the müezzin, the assistant of the imam, repeats the call to prayer at the start of each service, reads from the Koran, kneels to respond to the imam's prayers, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "müezzin mahfilis"@en .

aat:300417898 a skos:Concept ;
    skos:definition "In Islam, public criers who proclaim the regular hours of ritual prayer from the minaret or the roof of a mosque, recite in services, or perform other speaking duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "müezzins"@en .

aat:300417899 a skos:Concept ;
    skos:definition "Describes the practice, craft, and business of fashionable custom-made women's clothing, especially in Paris where a couture house is registered as such with the Chambre syndicale de la couture parisienne. This practice originated in Paris in the course of the 19th century, and is characterized by the utilization of high quality materials, and half-yearly or quarterly collections of original designs of garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couture"@en .

aat:300417900 a skos:Concept ;
    skos:definition "Ornamental geometric pattern in Persian and Islamic art, comprising a knot-pattern having many symmetrical axes, with star-shaped knots surrounded by geometric figures of various types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girih"@en .

aat:300417901 a skos:Concept ;
    skos:definition "A rounded script developed in the 13th century used mainly in southern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotunda"@en .

aat:300417902 a skos:Concept ;
    skos:definition "Italian black letter script that is more rounded than in northern centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian rotunda"@en .

aat:300417903 a skos:Concept ;
    skos:definition "The activity and function of teaching animals specific responses to specific conditions or stimuli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal training"@en .

aat:300417904 a skos:Concept ;
    skos:definition "Works designed as a volume, but which remain without binding, or with only a paper binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unbound volumes"@en .

aat:300417906 a skos:Concept ;
    skos:definition "Pavement mosaic technique utilizing stone slab fragments, most commonly marble of different colors, cut in irregular shapes and placed side by side without creating any geometric or figurative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus segmentatum"@en .

aat:300417907 a skos:Concept ;
    skos:definition "Mosaic paving technique in which stone tesserae of different colors, all of the same size and rectangular shape, are placed to create the visual impression of a basket weave pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus pseudo-figlinum"@en .

aat:300417909 a skos:Concept ;
    skos:definition "Islamic architectural masonry style in which alternating light and dark courses of stone are a design element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablaq"@en .

aat:300417910 a skos:Concept ;
    skos:definition "Floor mosaic technique characterized by the insertion of irregular fragmented slabs of polychrome marbles and stones in a monochrome opus tessellatum field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus scutulatum"@en .

aat:300417911 a skos:Concept ;
    skos:definition "Arcades or porticoes in Islamic architecture. Riwaqs serve as transitions between interior and exterior spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riwaqs"@en .

aat:300417912 a skos:Concept ;
    skos:definition "Pavement mosaic technique using ceramic elements, usually of the same size and rectangular shape, arranged in a herringbone pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus spicatum"@en .

aat:300417913 a skos:Concept ;
    skos:definition "Mechanical contrivances that are the result of devising, inventing, or artistic endeavor, and that have a particular purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devices"@en .

aat:300417914 a skos:Concept ;
    skos:definition "Skull racks or similar constructions used in Mesoamerica to display the heads or skulls of sacrificed human victims, or platforms carved with human skulls to resemble such a rack. Tzompantlis were usually placed near temples or ballcourts. Those displaying real skulls comprised a wooden framework supporting skulls skewered on horizontal poles run through holes drilled through the temples. Tzompantlis took a variety of forms and seem to have served several functions: altars and venues for ritual; displays of Aztec prowess; and to terrorize subjugated populations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tzompantlis"@en .

aat:300417915 a skos:Concept ;
    skos:definition "Wood finishing and decoration technique, creating a faux marble or stone effect, often used to make intarsia scenes or patterns with small chips or pieces of variously colored wood. The technique was made popular in 16th-17th-century German furniture making, although it is seen in later furniture as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spänemarmorierung"@en .

aat:300417916 a skos:Concept ;
    skos:definition "Wood that has been affected by water and fungus, often causing it to be brittle, short-grained, and easily broken. Spalted wood often has a greenish color. It is valued as an unusual material if the wood is still in a good enough state to be workable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spalted wood"@en .

aat:300417917 a skos:Concept ;
    skos:definition "Words or phrases, often in Latin, inserted in the inscription of an artwork to designate the activity performed by the creator, such as the role of the artist or designer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glosses for inscriptions"@en .

aat:300417918 a skos:Concept ;
    skos:definition "Meaning \"painted,\" indicates the person whose role was painter of a work. May be applied to a place name as well, meaning painted in a given location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinxit"@en .

aat:300417919 a skos:Concept ;
    skos:definition "Meaning \"directed,\" indicates the master in charge of the artistic endeavor, not necessarily the hands-on creator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direxit"@en .

aat:300417920 a skos:Concept ;
    skos:definition "Meaning \"made [it],\" indicates the creator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fecit"@en .

aat:300417921 a skos:Concept ;
    skos:definition "Meaning \"printed [it],\" in printmaking, indicates the one who physically pulled the print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impressit"@en .

aat:300417922 a skos:Concept ;
    skos:definition "Meaning \"wrote [it],\" in printmaking indicates the one who physically wrote the lettering or passage. May be used for works other than prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scripsit"@en .

aat:300417923 a skos:Concept ;
    skos:definition "Meaning \"carved [it],\" in printmaking indicates the one who engraved the plate or carved the wood block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpsit"@en .

aat:300417924 a skos:Concept ;
    skos:definition "Meaning \"delineated [it],\" in printmaking and other art works, indicates the one who drew the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "delineavit"@en .

aat:300417925 a skos:Concept ;
    skos:definition "Meaning \"composed [it],\" in printmaking and other art works, indicates the one who designed the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composuit"@en .

aat:300417926 a skos:Concept ;
    skos:definition "Meaning \"from the original,\" in printmaking and other art works, indicates the original work from which the work at hand was copied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ex archetypis"@en .

aat:300417927 a skos:Concept ;
    skos:definition "Meaning \"designed [it],\" in painting and other art works, indicates the one who created the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "designavit"@en .

aat:300417928 a skos:Concept ;
    skos:definition "Meaning \"invented [it],\" in painting and other art works, indicates the master designer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invenit"@en .

aat:300417929 a skos:Concept ;
    skos:definition "Meaning \"drew [it],\" in painting and other art works, indicates the one who designed the work; may refer to the design of figures, but not necessarily so."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figuravit"@en .

aat:300417930 a skos:Concept ;
    skos:definition "Meaning \"at the abode of,\" in publishing refers to the publishing house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appresso"@en .

aat:300417931 a skos:Concept ;
    skos:definition "Meaning \"released [by],\" in publishing refers to the publisher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excudit"@en .

aat:300417932 a skos:Concept ;
    skos:definition "Meaning \"out of the workshop [of],\" in publishing refers to the workshop from which the work was published."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ex officina"@en .

aat:300417933 a skos:Concept ;
    skos:definition "Animation technique that implements a courvoisier set-up, or grouping, in which figures are trimmed to their edges, glued to a background typically composed of wood veneer, patterns, or hand-painted watercolors, and covered by a protective top cel. The technique was developed by the Courvoisier Galleries in the late 1930s and early 1940s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courvoisier"@en .

aat:300417934 a skos:Concept ;
    skos:definition "Describes those who convert sounds into replayable form for reproduction or broadcast, formerly using mechanical means or magnetic tape, and now digital media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound recordists"@en .

aat:300417935 a skos:Concept ;
    skos:definition "The art or science of directing the movements of a boat, ship, vessel, aircraft, or spacecraft, involving the determination of position and course by the use of instruments, electronic aids, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navigation"@en .

aat:300417936 a skos:Concept ;
    skos:definition "Glass ware made of glass having a decorative mesh pattern or patterns of fine glass threads embedded inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reticello ware"@en .

aat:300417937 a skos:Concept ;
    skos:definition "General term for glass that is not \"lead glass,\" that is not containing a high proportion of lead oxide. Used primarily in cases where the reader may assume lead glass if not otherwise alerted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonlead glass"@en .

aat:300417938 a skos:Concept ;
    skos:definition "General term for any glass used as a material that is not \"blown glass,\" that is not shaped by blowing air through a blowpipe into a glob of molten glass. The term is used in situations where it may be assumed that the glass normally would be blown, but is not; also used to refer to glass as a raw material prior to being blown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unblown glass"@en .

aat:300417939 a skos:Concept ;
    skos:definition "Metalwork or metal decoration done entirely of fine wire, typically to ornament gold and silver or as openwork made of wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filigree work"@en .

aat:300417940 a skos:Concept ;
    skos:definition "Filigree glass having canes that were twisted to form spiral patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vetro a retorti"@en .

aat:300417941 a skos:Concept ;
    skos:definition "Filigree glass having canes that form parallel lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vetro a fili"@en .

aat:300417942 a skos:Concept ;
    skos:definition "Glassware in which fine lines appear embedded in the clear or transluscent glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filigree glassware"@en .

aat:300417944 a skos:Concept ;
    skos:definition "Type of watermark known in many variations, comprising a fleur-de-lys in a shield, in use from 1600 through to the 19th century in papers made in Strasburg, Basle, Germany, the Netherlands, Britain, Scandinavia, Russia, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strasburg lily"@en .

aat:300417945 a skos:Concept ;
    skos:definition "Type of watermark, known in many variations, comprising a head in profile wearng a fool's cap and collar. Known from as early as 1580; found in paper from many European nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fool's cap"@en .

aat:300417946 a skos:Concept ;
    skos:definition "Caps of fantastic shape, often garnished with bells, formerly worn by court fools or jesters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fool's caps"@en .

aat:300417947 a skos:Concept ;
    skos:definition "Icicle-like formations of calcium carbonate, depending from the roof or sides of a cavern and produced by the dropping of waters which have percolated through, and partially dissolved, the overlying limestone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stalactites"@en .

aat:300417948 a skos:Concept ;
    skos:definition "Rock pinnacles, pillars, or columns of rock having fantastical shapes, formed by erosion or other natural agency. Hoodoos generally form within sedimentary rock and volcanic rock formations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoodoos"@en .

aat:300417949 a skos:Concept ;
    skos:definition "Natural features forming a peak, a pointed or projecting rock, or an outcrop of rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinnacles"@en .

aat:300417950 a skos:Concept ;
    skos:definition "Works of sculpture representing a person's head, shoulders, and some part of the torso. For such figures in any media, use \"busts (general, figures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "busts"@en .

aat:300417951 a skos:Concept ;
    skos:definition "A registered trademark for a paper produced by the ARJOMARI company that comprised competing paper mills, ARches, JOhannot, MArais and RIves, merged; it existed 1956-1991."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arjomari paper (R)"@en .

aat:300417952 a skos:Concept ;
    skos:definition "Flat copper plates on which are inscribed permanent records of royal gifts and property transactions. A royal seal is often affixed. Known in India, dating from the 4th century and later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tamrashasanas"@en .

aat:300417953 a skos:Concept ;
    skos:definition "Prints of little value, designed to attract purchasers by being sold cheaply; examples are illustrated broadsides on themes of popular appeal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catchpenny prints"@en .

aat:300417954 a skos:Concept ;
    skos:definition "Seals stamped on books and prints indicating that the work has been approved by a censor for publication. Prime examples are censor's seals on Japanese prints dating from the 18th-19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "censor's seals"@en .

aat:300417955 a skos:Concept ;
    skos:definition "Cinematic film with accompanying recorded sound. It may have synchronized sound, or sound technologically coupled to the image. The term is used to distinguish such films from silent films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound films"@en .

aat:300417956 a skos:Concept ;
    skos:definition "Early sound films that included synchronized dialogue; usage is usually reserved for films dating from the 1920s through early 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talking pictures"@en .

aat:300417958 a skos:Concept ;
    skos:definition "Motion pictures produced in black-and-white, as contrasted to color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-and-white films"@en .

aat:300417959 a skos:Concept ;
    skos:definition "Vessels in which metals or other materials are melted and mixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melting pots"@en .

aat:300417960 a skos:Concept ;
    skos:definition "Windows made with stained glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stained-glass windows"@en .

aat:300417961 a skos:Concept ;
    skos:definition "Any of various kinds of popular music typically having a strong rhythm and featuring a horn section. Originally and principally associated with African-American performers, particularly a style prominent during the late 1940s and 1950s derived from or influenced by the blues and jazz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhythm and blues"@en .

aat:300417962 a skos:Concept ;
    skos:definition "Documentaries or other forms of film that profile an individual or individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "profile"@en .

aat:300417963 a skos:Concept ;
    skos:definition "Documentaries or other forms of film that illustrate the processes by which something is made or done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "process"@en .

aat:300417964 a skos:Concept ;
    skos:definition "Restraining structures incorporating a barrier that is raised or pushed aside at the start of a race, to ensure a simultaneous start for all competitors or to ensure consistent timing of each competitor. Examples are used in horse racing, foot races, downhill skiing, and other sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starting gates"@en .

aat:300417965 a skos:Concept ;
    skos:definition "Animals that have four feet and walk using four legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrupeds"@en .

aat:300417966 a skos:Concept ;
    skos:definition "Animals that walk on two feet, usually having two other limbs terminating in hands or having wings.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bipeds"@en .

aat:300417967 a skos:Concept ;
    skos:definition "Drugs or other substances that cause hallucinations, which are apparent perceptions, usually by sight or hearing, of an external object or activity when no such object or activity is actually present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hallucinogens"@en .

aat:300417968 a skos:Concept ;
    skos:definition "Peruvian sacrificial ceremonial axes or knives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumi"@en .

aat:300417969 a skos:Concept ;
    skos:definition "Nahua symbol having a curl shape or spiral shape, representing the cross-section of a Strombus gigas or Turbinella angulata conch shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ehecacozcatl"@en .

aat:300417970 a skos:Concept ;
    skos:definition "General term for ceremonial costume worn by kings, pelates, sacrificial victims, or other people for religious or other ceremonial or ritual purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestments"@en .

aat:300417971 a skos:Concept ;
    skos:definition "Aztec vestments comprising articulated pieces of iridescent shell sewn in a pattern on a textile support. Derived from Nahuatl for \"joined mother -of-pearl.\" Many examples are made from the Pacific mollusk Pinctada mazatlanica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epnepaniuhqui"@en .

aat:300417972 a skos:Concept ;
    skos:definition "Round dots of uniform size repeated at regular intervals so as to form a pattern, usually designated as a pattern for fabric, or otherwise applied to planographic surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polka dots"@en .

aat:300417973 a skos:Concept ;
    skos:definition "Usage extended from the original Greek or the Latin \"palimpsēstus,\" which refers to parchment that has been reused to inscribe a second text, see \"palimpsests (manuscripts)\"; as the general object genre, the meaning is extended to refer to other objects, such as brass plates or stained glass that have been erased or turned over to be re-inscribed or re-painted on the reverse, or structures characterized by superimposed features produced at two or more distinct periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palimpsests"@en .

aat:300417974 a skos:Concept ;
    skos:definition "The process of recording moving visual images on videotape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video recording"@en .

aat:300417975 a skos:Concept ;
    skos:definition "Process by which a work made of paper is given a significant low or high relief profile by molding the surface when the paper is in pulp form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper pulp relief"@en .

aat:300417976 a skos:Concept ;
    skos:definition "An auspicious state, typically with reference to the life of a person, resulting from favorable outcomes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "good fortune"@en .

aat:300417977 a skos:Concept ;
    skos:definition "The action or condition of preserving someone or something from harm, danger, or damage, or providing guardianship, care, patronage, shelter, or defense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protection"@en .

aat:300417978 a skos:Concept ;
    skos:definition "General term for a variety of artistic or communicative types of media used in a given work or works. Typically reserved for modern works. For works that are of a single type but use multiple materials, prefer \"mixed media.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multimedia"@en .

aat:300417979 a skos:Concept ;
    skos:definition "Portraits in which the likeness of the sitter is generally maintained but the features and other attributes are presented in a way considered more beautiful, younger, stronger, or otherwise better than warranted by the sitter's actual appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idealized portraits"@en .

aat:300417980 a skos:Concept ;
    skos:definition "Japanese bridge often found in decorative gardens made from eight narrow wooden planks arranged on supports to form a zigzag pattern. The term is used for all similar Japanese bridges, even if they have greater or fewer planks. The tradition of such bridges comes from the poem Ise Monogatari (The Tales of Ise) in which the story's protagonist and his companions stop to rest at a famous iris marsh traversed by an eight-planked bridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yatsuhashi"@en .

aat:300417981 a skos:Concept ;
    skos:definition "Inscriptions that are written vertically rather than horizontally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columnar inscriptions"@en .

aat:300417982 a skos:Concept ;
    skos:definition "Style of writing in Ancient Greek or Roman inscriptions or other texts where the writing is arranged vertically rather than horizontally; may include one or more characters per each horizontal position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kionedon"@en .

aat:300417983 a skos:Concept ;
    skos:definition "Style of writing in inscriptions or other texts in which the arrangement of the lettering is such that letters are placed in a grid pattern, with the letters of each line vertically aligned with those of the preceding and following lines. Typically used in reference to ancient Greek and Roman inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoichedon"@en .

aat:300417984 a skos:Concept ;
    skos:definition "Style of writing in inscriptions or other texts in which lines are written from right to left and from left to right in alternate lines. From the Greek boustrophēdon, meaning literally “to turn like oxen” (in plowing)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boustrophedon"@en .

aat:300417986 a skos:Concept ;
    skos:definition "Style of writing of inscriptions or other texts in which only capital letters are used, in reference to the ancient Latin alphabet of capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrata"@en .

aat:300417987 a skos:Concept ;
    skos:definition "Weights sewn or fastened to the bottom of the large sleeves to make them hang well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeve weights"@en .

aat:300417989 a skos:Concept ;
    skos:definition "People who play games as a profession or pastime. For people who play athletic games, usually prefer \"athletes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "game players"@en .

aat:300417990 a skos:Concept ;
    skos:definition "People who takes part in a game, pastime, or sport, often reserved for those who play games for stakes or who play computer games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gamers"@en .

aat:300417991 a skos:Concept ;
    skos:definition "People who takes part in the game of checkers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkers players"@en .

aat:300417992 a skos:Concept ;
    skos:definition "People who take part in the game of chess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chess players"@en .

aat:300417993 a skos:Concept ;
    skos:definition "People who take part in card games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card players"@en .

aat:300417994 a skos:Concept ;
    skos:definition "Lids, usually plastic, made to cover disposable hot liquid cups, whether used for coffee or other hot drinks. Usually having an opening for drinking and a vent to allow steam to escape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee cup lids"@en .

aat:300417995 a skos:Concept ;
    skos:definition "Covers that encircle the body of disposable hot drink cups in order to protect the hand from the heat generated by the hot liquid through the cup. The term is used whether or not the hot liquid is coffee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee cup sleeves"@en .

aat:300417996 a skos:Concept ;
    skos:definition "Cups made of paper, often made leak-proof by a coating of plastic or wax; typically intended for one use. First documented in imperial China by 2nd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper cups"@en .

aat:300417997 a skos:Concept ;
    skos:definition "Paper cups that were first used in ancient China; for serving of tea, often colorful and decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chih pei"@en .

aat:300417998 a skos:Concept ;
    skos:definition "Cups intended for one use and then to be thrown away. Materials are typically paper or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disposable cups"@en .

aat:300417999 a skos:Concept ;
    skos:definition "Cups, usually disposable, designed for hot liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot drink cups"@en .

aat:300418000 a skos:Concept ;
    skos:definition "Cups, usually disposable, designed for cold liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold drink cups"@en .

aat:300418001 a skos:Concept ;
    skos:definition "Lids, usually plastic, made to cover disposable cold drink cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold drink lids"@en .

aat:300418002 a skos:Concept ;
    skos:definition "Object genre for any close-fitting protective covers or cases, particularly objects that are closed around all sides except for a slit or opening at one or two edges or sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeves"@en .

aat:300418003 a skos:Concept ;
    skos:definition "Armors designed for use in a joust, which is a competition in which two contestants are mounted on horses and armed with lances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jousting armors"@en .

aat:300418004 a skos:Concept ;
    skos:definition "Armors designed as costumes, rather than having a significant protective function. Prime examples were designed for pageants in pseudoclassical dress, which were popular in Europe, 15th through 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume armors"@en .

aat:300418005 a skos:Concept ;
    skos:definition "Finials used in Islamic architecture, typically found atop a minaret, dome, or minber, usually tipped with a crescent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alems"@en .

aat:300418006 a skos:Concept ;
    skos:definition "Family of trees and perennial herbs or lianas, with 46–50 genera and 891 species. The family occurs worldwide, although rarely in really cold areas, and is especially common in tropical Africa and Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thymelaeaceae"@en .

aat:300418007 a skos:Concept ;
    skos:definition "General term for modern construction techniques used for buildings of nine or more stories, usually with elevators, employing structural systems to carry both vertical gravity loads and lateral loads caused by wind and earthquakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-rise construction"@en .

aat:300418008 a skos:Concept ;
    skos:definition "Building technique in which structural elements, roofing, or other loads are suspended from cables, ropes, or chains attached to natural or constructed supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspension construction"@en .

aat:300418009 a skos:Concept ;
    skos:definition "Bridges that employ trusses, which are structural members comprising straight pieces of metal or timber forming a series of triangles lying in a single plane, thus making the structure unlikely to be distorted by stress. Wooden truss bridges, in the form of covered bridges, were common in the United States from the 1870s to the 1930s; carefully fitted timbers were combined with iron rods for tension. Later, railroad bridges and other bridges were constructed of cast iron and wrought iron, which were eventually succeeded by steel in truss bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss bridges"@en .

aat:300418010 a skos:Concept ;
    skos:definition "Bridges having load-bearing superstructures employing both trusses and arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss arch bridges"@en .

aat:300418011 a skos:Concept ;
    skos:definition "Building technique in which structural elements comprise girders of open framework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss construction"@en .

aat:300418012 a skos:Concept ;
    skos:definition "Building technique in which major structural elements are arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch construction"@en .

aat:300418013 a skos:Concept ;
    skos:definition "Building technique in which major structural elements are trusses and arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss arch construction"@en .

aat:300418014 a skos:Concept ;
    skos:definition "Two-wheeled vehicles for the transport of felled trees, usually pulled by tractors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logging wheels"@en .

aat:300418016 a skos:Concept ;
    skos:definition "Cards on which thread or yarn is wound for sale and for use, usually made from cardboard and decorated with advertising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread cards"@en .

aat:300418017 a skos:Concept ;
    skos:definition "Of a person, or his or her feelings: estranged, excluded, or turned away (from a person or thing); experiencing a feeling of estrangement or isolation. Also in extended use: (of a period, place, etc.) characterized by or inducing such feelings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alienation"@en .

aat:300418018 a skos:Concept ;
    skos:definition "Carts having three rather than two wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-wheeled carts"@en .

aat:300418019 a skos:Concept ;
    skos:definition "The reception and accommodation of guests, visitors, or strangers in a generous and welcoming manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospitality"@en .

aat:300418020 a skos:Concept ;
    skos:definition "Persons who cut steel letter punches for type founders in the first stage of making metal type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punchcutters"@en .

aat:300418021 a skos:Concept ;
    skos:definition "Cutting types from steel shanks, used for punching matrices with which foundry types are cast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punchcutting"@en .

aat:300418022 a skos:Concept ;
    skos:definition "Thematic large-scaled maps of cities or neighborhoods or environs within them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city maps"@en .

aat:300418023 a skos:Concept ;
    skos:definition "The study and applications of principles in physics for the construction of buildings. The physical elements of these principles may include light, heat, moisture, air, and sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building physics"@en .

aat:300418024 a skos:Concept ;
    skos:definition "Culinary hand tools for cutting and dividing dough, blade along one edge and a wooden or rolled metal handle along the opposite edge. Used to cut, pick up and portion dough and to clean the kneading surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough cutters"@en .

aat:300418025 a skos:Concept ;
    skos:definition "Hand-propelled vehicles consisting of a vertical frame incorporating a handle, and a horizontal projecting edge, platform, or toe plate perpendicular or angled to the vertical frame, at or near its lower part. The projecting edge slides under loads for the purpose of lifting or moving. Distinguished from handcarts, which have four wheels mounted to a level platform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand trucks"@en .

aat:300418026 a skos:Concept ;
    skos:definition "The reading of text in printed proof to find and mark errors for correction. Proofreading happens before or during the final press run, and is mostly meant to correct compositor’s errors and errors in layout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proofreading"@en .

aat:300418027 a skos:Concept ;
    skos:definition "Persons who read text in proof in order to find and mark errors for correction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proofreaders"@en .

aat:300418028 a skos:Concept ;
    skos:definition "Portraits that depict two or more sitters that share kinship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "family portraits"@en .

aat:300418029 a skos:Concept ;
    skos:definition "The supporting structures and other parts that are underneath the body of vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undercarriages"@en .

aat:300418030 a skos:Concept ;
    skos:definition "The visible fronts of drawers, on which drawer pulls may be mounted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawer fronts"@en .

aat:300418031 a skos:Concept ;
    skos:definition "Manual or electrically driven appliances used for cutting bread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread slicers"@en .

aat:300418032 a skos:Concept ;
    skos:definition "Hand tools intended to mix and divide dough. These usually appear as tools carved from wood with a shovel-like end and handles of various lengths, though they can be made of any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough paddles"@en .

aat:300418033 a skos:Concept ;
    skos:definition "Hinged doors that cover the mouths of ovens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oven doors"@en .

aat:300418034 a skos:Concept ;
    skos:definition "Equipment of varied design used for lifting heavy sacks. Commonly stretcher-like objects of parallel bars spanned by a support of some kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sack lifters"@en .

aat:300418035 a skos:Concept ;
    skos:definition "Trailed multi-wheeled vehicles with long beds designed to haul lumber or timber from one place to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logging wagons"@en .

aat:300418036 a skos:Concept ;
    skos:definition "Covered market spaces where meat is sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat halls"@en .

aat:300418037 a skos:Concept ;
    skos:definition "A clear liquor distilled from malted grain mash and flavored with juniper berries. This term is used to designate the spirit manufactured in the Netherlands and Belgium as distinct from the British and American versions of this, called 'gin.' Only liquors produced in the countries of Belgium, the Netherlands, and some districts in France and Germany may carry the name 'jenever', 'genièvre' or 'genever.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genever"@en .

aat:300418039 a skos:Concept ;
    skos:definition "Vehicle for transport of people and goods, adapted to be drawn by dogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog carts"@en .

aat:300418040 a skos:Concept ;
    skos:definition "Covered market spaces where fish is sold as a food product, either wholesale, at auction near ports, or piecemeal as part of a market complex in a town or city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish halls"@en .

aat:300418041 a skos:Concept ;
    skos:definition "Wheeled vehicles adapted to carry and distribute containers for milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk carts"@en .

aat:300418042 a skos:Concept ;
    skos:definition "Styles and culture related to the colonial Dutch East Indies, now Indonesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch East Indian"@en .

aat:300418043 a skos:Concept ;
    skos:definition "People who design ornaments such as bracelets, necklaces, and rings, of precious or semiprecious materials worn or carried on the person for adornment. For those that manufacture these objects, use 'jewelers.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry designers"@en .

aat:300418044 a skos:Concept ;
    skos:definition "Jar designed or used for storage of tobacco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco jars"@en .

aat:300418045 a skos:Concept ;
    skos:definition "Persons who are offered membership in an association as a sign of distinction, because of their merits, and usually without obligations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honorary members"@en .

aat:300418046 a skos:Concept ;
    skos:definition "Copies made on a particular early projection photocopier created in the first decade of the 1900s by the Commercial Camera Company, which became the Photostat Corporation. The \"Photostat\" name, was originally a trademark of the company, later became genericized, and was often used to refer to similar machines produced by the Rectigraph Company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Photostats (TM)"@en .

aat:300418047 a skos:Concept ;
    skos:definition "An early projection photocopier created in the decade of the 1900s by the Commercial Camera Company, which became the Photostat Corporation. The \"Photostat\" name, was originally a trademark of the company, later became genericized, and was often used to refer to similar machines produced by the Rectigraph Company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Photostat Machines (TM)"@en .

aat:300418048 a skos:Concept ;
    skos:definition "Process of using a particular early projection photocopier to create copies of documents or other items. The original Photostate Machine was created in the decade of the 1900s by the Commercial Camera Company, which became the Photostat Corporation. The \"Photostat\" name, was originally a trademark of the company, later became genericized, and was often used to refer to similar machines produced by the Rectigraph Company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photostating"@en .

aat:300418049 a skos:Concept ;
    skos:definition "Documents comprising texts that are relatively short in length, sometimes but not always abbreviated versions of longer texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brief texts"@en .

aat:300418050 a skos:Concept ;
    skos:definition "Documents comprising a text corpus, database, or other source that is generally complete and of substantial length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full texts"@en .

aat:300418051 a skos:Concept ;
    skos:definition "Additions to visual works, comprising canted or other wise extending outer pieces, usually but not always surrounding primarily rectangular objects such frames, altarpieces, fire backs, architectural elements, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust guards"@en .

aat:300418052 a skos:Concept ;
    skos:definition "Built works that have been damaged, lost, or destroyed, then built or heavily restored at a later time according to the same design, usually but not always on the original site. Includes built works that have been physically reconstructed, as well as the subject matter of drawings, models, or other media illustrating a surmised reconstruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reconstructed architecture"@en .

aat:300418053 a skos:Concept ;
    skos:definition "Reliquaries having a transparent barrier protecting the relic, or otherwise allowing direct viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phylacteries"@en .

aat:300418054 a skos:Concept ;
    skos:definition "Computer generated renderings of architectural structures that give the viewer the sensation of walking through a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural walkthroughs"@en .

aat:300418055 a skos:Concept ;
    skos:definition "Computer generated renderings of architectural structures that are interactive with the viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interactive architectural walkthroughs"@en .

aat:300418056 a skos:Concept ;
    skos:definition "Visual works that were computer-aided in creation, depicting architecture, landscape design, cities, transportation infrastructure, engineering projects, automobiles, computer chips, or other objects of any size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-aided designs"@en .

aat:300419259 a skos:Concept ;
    skos:definition "Sculptural works that may be worn on the human body. These are usually meant to be activated or completed by the movement of a wearer in performance situations, though they are frequently exhibited as static objects. Costume or apparel works are often referred to as wearable art, though a distinction should be made between streetwear, costume, and 'wearable art,' here scoped as sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wearable art"@en .

aat:300419260 a skos:Concept ;
    skos:definition "People who create architectural drawings or other images using CAD (computer-aided design)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CAD drafters"@en .

aat:300419261 a skos:Concept ;
    skos:definition "People who create building information models, often architects or engineers, or working for architects or engineers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BIM modelers"@en .

aat:300419262 a skos:Concept ;
    skos:definition "Sets of visual works comprising digital descriptions for various aspects of a work of architecture or other works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building information models"@en .

aat:300419263 a skos:Concept ;
    skos:definition "General term for processes for reproducing architectural drawings and other documents used by architects, engineers, designers, surveyors, and others involved in designing and constructing built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural reprography"@en .

aat:300419264 a skos:Concept ;
    skos:definition "General term for visual works produced by any number of reproduction methods, for use in construction, engineering, and other fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural reprographics"@en .

aat:300419265 a skos:Concept ;
    skos:definition "Animated films in which a viewer travels through and around architecture and related environments. May refer to a stand-alone film focused exclusively on architecture, or footage included in a larger film. For computer-generated programs rather than films, in which the viewer is moving through an architectural space and surroundings, whether or not the user can interact with the space, use \"architectural walkthroughs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural animations"@en .

aat:300419266 a skos:Concept ;
    skos:definition "In the Catholic church, churches having been bestowed an honorific by canon lawyers and liturgists, the character of which may vary. Basilicas in this sense are divided into two classes, the greater or patriarchal, and the lesser basilicas. For built works having a basilican floor plan, use \"basilicas (works by form).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basilicas"@en .

aat:300419267 a skos:Concept ;
    skos:definition "Sheets of film material made of various types of plastic and used for drafting, in use since the 1940s, but emerging as preferred supports from the 1980s through the 2000s. Drafting films will have a matte finish on one or both sides, which gives the surface teeth to accept media or emulsion. Like other translucent supports, drafting film may be used alternately for original drawings or as a reproductive intermediate. Reproductions are typically run through a diazo machine. Stability will largely depend on composition. Acetate was used for drafting film primarily from 1939, with a decrease in usage in the 1960s. Polyester or Mylar (TM) was used from around 1950, becoming very popular after 1970."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic drafting film"@en .

aat:300419269 a skos:Concept ;
    skos:definition "Gold found in quartz deposits. As a material, may refer to decorative stones or gemstones comprising quartz having small bits of gold embedded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz gold"@en .

aat:300419270 a skos:Concept ;
    skos:definition "The process of combining photographic images, or photographs along with other materials or images, such as architectural drawings, usually arranged into a somewhat unified image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomontage"@en .

aat:300419271 a skos:Concept ;
    skos:definition "Thin facings of wood, generally made from mahogany, oak, walnut, or cedar. The panels are about 2-3 mm thick, often used to cover the surface of furniture or another object constructed of coarser and cheaper wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood veneer"@en .

aat:300419272 a skos:Concept ;
    skos:definition "Identification numbers or alphanumeric codes assigned to, and usually posted on, buildings or plots located on a thoroughfare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street numbers"@en .

aat:300419273 a skos:Concept ;
    skos:definition "Designations for streets, highways, roads, or other thoroughfares, either proper names or numeric indicators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thoroughfare names"@en .

aat:300419274 a skos:Concept ;
    skos:definition "Numeric or alphanumeric codes included in mailing addresses to facilitate the sorting and delivery of mail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postcodes"@en .

aat:300419275 a skos:Concept ;
    skos:definition "General term for names or other designations for political and geographic administrative entities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administrative designations"@en .

aat:300419276 a skos:Concept ;
    skos:definition "Those who hold other human beings as property in forced servitude, whether by capture, purchase, or birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slave owners"@en .

aat:300419277 a skos:Concept ;
    skos:definition "A nontarnishing alloy typically used for making jewelry, which exhibits the natural color of gold. It is composed of copper (90%), aluminum (7.5%) and gold (2.5%)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuremberg gold"@en .

aat:300419278 a skos:Concept ;
    skos:definition "Towers intended to afford views of the surrounding area, typically for the purpose of the enjoyment of views rather than for defense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "observation towers"@en .

aat:300419279 a skos:Concept ;
    skos:definition "Simple form of bridge in which each span is comproised of several parallel beams spanning between two supports, with the deck laid directly on the beams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beam bridges"@en .

aat:300419280 a skos:Concept ;
    skos:definition "The process of producing color woodblock prints, usually through combining a series of blocks in precise registration that have been inked with individual hues and pressed onto one support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color woodcut"@en .

aat:300419281 a skos:Concept ;
    skos:definition "Arch bridges in which the outwardly directed horizontal forces are borne as tension by means of a cord tied to the arch ends, rather than by the ground or the bridge foundations. Because of the typically curved shape of the arches, it was also known as a bowstring arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tied-arch bridges"@en .

aat:300419282 a skos:Concept ;
    skos:definition "General term for the period and styles of Islamic culture from ca. 610 CE through around the 9th century.,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Islamic"@en .

aat:300419283 a skos:Concept ;
    skos:definition "Arch bridges in which the deck or roadway is placed above the arch and thereby is left open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open-spandrel arch bridges"@en .

aat:300419284 a skos:Concept ;
    skos:definition "Cantilever bridges in which beams or girders support each end equally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balanced cantilever bridges"@en .

aat:300419285 a skos:Concept ;
    skos:definition "Bridges similar to tied arch bridges, but with diagonal members that allow it to span as both girder and arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow-string girder bridges"@en .

aat:300419286 a skos:Concept ;
    skos:definition "The circumstances, activities, and experiences that routinely constitute a person’s or group's existence, particularly as embodied in conventions of thought or behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daily life"@en .

aat:300419287 a skos:Concept ;
    skos:definition "Thrones or seats incorporating lotus motifs, found in Hindu, Buddhist, and other traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lotus thrones"@en .

aat:300419288 a skos:Concept ;
    skos:definition "Seated, cross-legged posture in which each foot is placed sole upwards on the thigh of the opposite leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padmasana"@en .

aat:300419289 a skos:Concept ;
    skos:definition "Immobile bodily postures, seen in Buddhist, Hindu and other traditions and in the practice of yoga."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asana"@en .

aat:300419290 a skos:Concept ;
    skos:definition "Animals with distinctive shaggy white hair and backward curving horns. Mountain goats are native to mountainous regions of northwestern North America from southeastern Alaska south to the Columbia River in Washington; east into Idaho and western Montana; and north to southern Yukon. They are part of the antelope family, rather than true goats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain goats"@en .

aat:300419291 a skos:Concept ;
    skos:definition "Any of various devices for separating liquid oil and water from olives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive presses"@en .

aat:300419292 a skos:Concept ;
    skos:definition "Traditional Mexican cut-paper works. Multiple works may be attached to ropes and hung as banners. Used for Day of the Dead, Independence Day, and other festivals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papel picado"@en .

aat:300419293 a skos:Concept ;
    skos:definition "Hair of the mountain goat (Oreamnos americanus), which has been used by indigenous people of the Northwestern United States to weave textiles, often combined with other fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain goat hair"@en .

aat:300419295 a skos:Concept ;
    skos:definition "Places where medicines may be prepared on-site, dispensed, and or sold. Pharmacies are often sited within modern drugstores that sell a variety of products, though they may also exist outside of this context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharmacies"@en .

aat:300419296 a skos:Concept ;
    skos:definition "Historically, those who prepared and sold drugs for medicinal purposes, this business being conducted by a druggist or pharmacist since ca. 1800. From about 1700 apothecaries began to act as general medical practitioners. Modern apothecaries hold this status legally in some places by examination and licence, but in popular usage the term is archaic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apothecaries"@en .

aat:300419297 a skos:Concept ;
    skos:definition "Shops in which apothecaries plied their trade, preparing and dispensing medicinal substances, as well as sundry items including confections, candles, spices, or cordials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apothecary's shops"@en .

aat:300419298 a skos:Concept ;
    skos:definition "Order of free-living flatworms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tricladida"@en .

aat:300419299 a skos:Concept ;
    skos:definition "Class of flatworms that includes all parasitic flatworms (clade Neodermata) and most free-living species that were previously grouped in the now obsolete class Turbellaria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhabditophora"@en .

aat:300419300 a skos:Concept ;
    skos:definition "Former taxonomic class, formerly contained various free-moving flatworms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turbellaria"@en .

aat:300419301 a skos:Concept ;
    skos:definition "Family of freshwater flatworms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Planariidae"@en .

aat:300419302 a skos:Concept ;
    skos:definition "Walls having the primary purpose of serving to that separate, keep apart, demarcate, or serve as deterrents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrier walls"@en .

aat:300419303 a skos:Concept ;
    skos:definition "Periods of existence or duration; may apply to animate or inanimate things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifespans"@en .

aat:300419304 a skos:Concept ;
    skos:definition "Scrolls on which the Pentateuch is inscribed by hand in Hebrew. These are composed of many sheets of parchment or vellum sewn together and mounted on wooden rollers. They are carefully prepared by qualified scribes, or sofers, and are used for public readings during services on Sabbaths, Mondays, Thursdays, and religious festivals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torah scrolls"@en .

aat:300419305 a skos:Concept ;
    skos:definition "The condition of being unimpaired, complete, or undivided. The concept denotes material wholeness and may be applied to objects or built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integrity"@en .

aat:300419306 a skos:Concept ;
    skos:definition "Gold in the form of or reduced to powder or in fine flake form used as a pigment, or for the preparation of coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold powder"@en .

aat:300419307 a skos:Concept ;
    skos:definition "Genus containing wild and domestic cattle. Most species are grazers and ruminants with a four-chambered stomach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bos"@en .

aat:300419308 a skos:Concept ;
    skos:definition "Bovid species equiped for living at high altitude, having large lungs, a high red blood cell count, and higher concentration of hemoglobin than most other bovids. Domesticated populations differ from the wild species, Bos mutus, in having shorter legs, broader hooves, more varied pelage coloration, and weaker horns which sometimes can be absent altogether. was probably domesticated in Tibet but has been introduced wherever there are people at elevations of 4,000-6,000 metres (14,000–20,000 feet), mainly in China but also in Central Asia, Mongolia, and Nepal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bos grunniens"@en .

aat:300419309 a skos:Concept ;
    skos:definition "Wild bovid species that has black pelage, long hair, and otherwise adapted for living at high altitude. Domesticated populations differ from the wild species in having shorter legs and other characteristics. Wild and domestic yaks can freely interbreed, although they are still generally classified as different species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bos mutus"@en .

aat:300419310 a skos:Concept ;
    skos:definition "General term for both wild and domestic species of yak."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yaks"@en .

aat:300419311 a skos:Concept ;
    skos:definition "An intoxicating drink holding a prominent place in Vedic ritual and religion.The plant from which the drink was derived is not certain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soma"@en .

aat:300419312 a skos:Concept ;
    skos:definition "Genus of plants native chiefly to the east coast of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asclepias"@en .

aat:300419313 a skos:Concept ;
    skos:definition "Traditional system of Indian medicine, including traditional preventive and curative health care; widely practiced in parts of Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayurveda"@en .

aat:300419314 a skos:Concept ;
    skos:definition "One of four genres of text that together constitute each of the Vedas, the sacred scriptures of most Hindu traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upanishads"@en .

aat:300419315 a skos:Concept ;
    skos:definition "The process of removing historical restorations. A common reason is that the old restorations are now considered bad practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "derestoration"@en .

aat:300419316 a skos:Concept ;
    skos:definition "An ancient Italic people and culture of what is now southwestern Italy. This tribe, called Bruttii and Brittii in Latin inscriptions, occupied an area coextensive with modern Calabria from the 4th century BCE onwards. Earlier inhabitants in this region included the Oenotrians and Chones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bruttii"@en .

aat:300419317 a skos:Concept ;
    skos:definition "Exudate of pine trees, used for a variety of purposes, including as a sealant, incense, and in ancient Egypt, for embalming and preserving human bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pine resin"@en .

aat:300419318 a skos:Concept ;
    skos:definition "General term referring to destinations designated for data storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data repositories"@en .

aat:300419319 a skos:Concept ;
    skos:definition "Mechanism for managing and storing digital content in order to manage and preserve it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital repositories"@en .

aat:300419320 a skos:Concept ;
    skos:definition "Marks made on the hide of a living animal to identify its owner; usually made by freezing or searing with hot irons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livestock brands"@en .

aat:300419321 a skos:Concept ;
    skos:definition "Registers of brand designs belonging to various livestock owners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livestock brand registries"@en .

aat:300419322 a skos:Concept ;
    skos:definition "Registers of the watermark designs of various paper makers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watermark registries"@en .

aat:300419323 a skos:Concept ;
    skos:definition "Radiography using x-rays. In this process, the object to be recorded is placed between an x-ray tube and the film; the film registers the differential absorption of the x rays by the object’s internal structure as a projection shadowgraph. Among the many uses are for medical purposes and as an examination technique for easel paintings, for examining the substrate structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-radiography"@en .

aat:300419324 a skos:Concept ;
    skos:definition "A radiographic technique that uses a plane beta source to produce an image on a radiographic film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beta radiography"@en .

aat:300419325 a skos:Concept ;
    skos:definition "Radiographic images made with x-rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-radiographs"@en .

aat:300419326 a skos:Concept ;
    skos:definition "Radiographic images made by using a plane beta source to produce an image on a radiographic film. Examples are images of watermarks taken with beta radiography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beta radiographs"@en .

aat:300419327 a skos:Concept ;
    skos:definition "A radiographic technique that uses secondary electrons emitted from a thin lead foil (100 to 250 micrometers) to produce an image of the examined object on a radiographic film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron transmission radiography"@en .

aat:300419328 a skos:Concept ;
    skos:definition "Intentional and systematic methods designed to bring about the extermination of a racial, polical, or cultural group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genocide"@en .

aat:300419329 a skos:Concept ;
    skos:definition "Displays that transmit and reflect visible information from a computer or device to a human viewer. There are varying forms of flat-panel displays due to changes in technology or innovation, such as the liquid crystal display (LCD) or the plasma display. These displays may be found on a variety of portable computers, from televisions to digital watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-panel displays"@en .

aat:300419330 a skos:Concept ;
    skos:definition "Order of marine gastropod mollusks (sea snails)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neogastropoda"@en .

aat:300419331 a skos:Concept ;
    skos:definition "Family of marine gastropod mollusks (sea snails)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turbinellidae"@en .

aat:300419332 a skos:Concept ;
    skos:definition "Genus of very large marine gastropod mollusks (sea snails, having an operculum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turbinella"@en .

aat:300419333 a skos:Concept ;
    skos:definition "Genus of very large marine gastropod mollusks (sea snails), having an operculum (aperture cover). Found in the western Atlantic Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turbinella angulata"@en .

aat:300419334 a skos:Concept ;
    skos:definition "Taxonomic subclass of marine bivalve molluscs (saltwater clams)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heterodonta"@en .

aat:300419335 a skos:Concept ;
    skos:definition "Order of bivalve molluscs; most are saltwater molluscs, although some are freshwater molluscs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Veneroida"@en .

aat:300419336 a skos:Concept ;
    skos:definition "Species of marine bivalve mollusc, a member of the pearl oysters. It is found in shallow tropical waters on the Pacific coast of Central America; its shell was highly valued by Precolumbian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinctada mazatlanica"@en .

aat:300419337 a skos:Concept ;
    skos:definition "Genus of marine bivalve mollusks (saltwater oysters)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinctada"@en .

aat:300419338 a skos:Concept ;
    skos:definition "Family of medium-sized to large marine bivalve mollusks (saltwater clams). Some members of this family are noted for producing pearls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pteriidae"@en .

aat:300419339 a skos:Concept ;
    skos:definition "Order of large and medium-sized marine bivalve mollusks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pterioida"@en .

aat:300419340 a skos:Concept ;
    skos:definition "Chinese works comprising slabs of stone carved and engraved with figurative images or decorative patterns, associated with tombs. The designs on the stones were traditionally copied by rubbings and dispersed to a wider audience. This plastic and graphic art form developed in the Han Dynasty (206 BCE-220 BCE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial stones"@en .

aat:300419341 a skos:Concept ;
    skos:definition "Ports on computers that allow data to stream in multiple channels. They incorporate multiple lines that correspond to cables that enable a division of instructions that can be performed simultaneously. Parallel ports allow faster data communication and transference between the computer and any peripherals, such as printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel ports"@en .

aat:300419342 a skos:Concept ;
    skos:definition "Pavilions or porches placed on the terminals or front of the building, not part of the main body of the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avant-corps"@en .

aat:300419343 a skos:Concept ;
    skos:definition "Façades that comprise a pavilion, usually an entryway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "façade pavilions"@en .

aat:300419344 a skos:Concept ;
    skos:definition "Large, stately, or ornamental tents or tent-like coverings, usually rising to a central point rather than a ridge. Originally referred to tents used on military campaigns or at jousts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavilions"@en .

aat:300419345 a skos:Concept ;
    skos:definition "Administrative and governing entities of tribes, whether or not the entities enjoy the privileges and immunities of external sovereign status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribal entities"@en .

aat:300419346 a skos:Concept ;
    skos:definition "Rubbings made from monumental, memorial brass plaques found in churches; created by using ink, colored wax, or another material to transfer an image on paper. Creating and collecting brass rubbings was a popular hobby in Britain from 17th-19th centuries, although the term may refer to any rubbing made from a brass plaque in any time period or culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brass rubbings"@en .

aat:300419347 a skos:Concept ;
    skos:definition "Rubbings made from inscribed, engraved, or low-relief stones, usually using ink on paper that has been placed over the stone. Rubbings of tombstones, other inscriptions, or pictorial reliefs has long been popular in Asia as a way to disseminate texts or images, although the term may be used for any works made by this technique elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone rubbings"@en .

aat:300419348 a skos:Concept ;
    skos:definition "Stones used for rubbing or otherwise applying friction to another surface. Examples of use are for smoothing tiles or other surfaces, sanding or burnishing surfaces, treating animal skins, or processing grain or pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbing stones"@en .

aat:300419349 a skos:Concept ;
    skos:definition "Describes the period, style, or culture of Maʿīn, an ancient kingdom of southern Arabia from the 4th to the 2nd century BCE. This was primarily a trading culture that monopolized trade routes and may be associated with the ʿĀmir people to the north of the Minaean capital of Qarnaw (now Maʿīn), which is at the eastern end of the Wadi Al-Jawf and on the western border of the Ṣayhad sands. The Minaeans had a second site surrounded by still extant walls at Yathill, south of Qarnaw, and trading places at Dedān and in the Qatabānian and Hadramite capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minaean"@en .

aat:300419350 a skos:Concept ;
    skos:definition "Bags designed to hold coins or counters when gambling or gaming. The best known style was used in 17th -century Europe, usually made of worked leather or luxury fabrics and having a drawstring closure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaming purses"@en .

aat:300419352 a skos:Concept ;
    skos:definition "An evergreen tree native to southern China, and cultivated elsewhere in southern and eastern Asia. It is prized for its aromatic bark, which is commonly used as the spice cinnamon, though it is not true cinnamon, and as an environmentally-friendly insecticide in the context of conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cinnamomum cassia"@en .

aat:300419353 a skos:Concept ;
    skos:definition "Elements that hold data or program instructions in reserve for subsequent retreival in computational systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memory components"@en .

aat:300419354 a skos:Concept ;
    skos:definition "Landscape and view painters who specialized in \"vedute,\" which are largely factual topographical views, especially 18th-century Italian paintings, drawings, or prints of cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vedutisti"@en .

aat:300419355 a skos:Concept ;
    skos:definition "Books containing written or printed music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music books"@en .

aat:300419356 a skos:Concept ;
    skos:definition "Sheet music that has been bound. The sheets may have been assembled and bound for a variety of reasons, including professional musicians’ volumes, music bound for publishers, music stores, or door to door sales, or as keepsakes, assembled primarily by women of the middle- and upper-classes during their formative years of musical training. For volumes of music that were created as bound volumes, use \"music books.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bound sheet music"@en .

aat:300419357 a skos:Concept ;
    skos:definition "Korean gates used to mark the entrance to sacred sites such as royal tombs; having a light design comprising red columns and simple wooden rods arranged vertically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hongsalmuns"@en .

aat:300419358 a skos:Concept ;
    skos:definition "Gates serving a largely ceremonial purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial gates"@en .

aat:300419359 a skos:Concept ;
    skos:definition "The act of transmitting a file from a remote computer or device to another. The file may be downloaded from an Internet web page or from a separate device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downloading"@en .

aat:300419360 a skos:Concept ;
    skos:definition "Raw data is the unprocessed information collected through a means of recording, including numbers, characters, or images. In computers, this information is represented through binary notation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw data"@en .

aat:300419361 a skos:Concept ;
    skos:definition "Tamarix, also known as salt cedar, is a deciduous, flowering shrub that historically has been used for windbreaks, ornamentals, and erosion control. Tamarix is highly invasive and affects water drainage systems in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tamarix"@en .

aat:300419362 a skos:Concept ;
    skos:definition "A family of dicotyledonous trees and shrubs with scale leaves and tiny flower. They are typically planted for ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tamaricaceae"@en .

aat:300419363 a skos:Concept ;
    skos:definition "Martes foina, more commonly known as stone martens or beech martens, are found across Europe, and Central Asia. They are weasel-like carnivores that are more generally found in deciduous forests or on rocky hillsides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Martes foina"@en .

aat:300419365 a skos:Concept ;
    skos:definition "Style of sculpture dating ca. 4,000-2,000 BCE in Anatolia, characterized by figures that have flat bodies, schematic features, detailed with light engraving and painting. Examples are highly stylized standing nude females with flipper-like arms and a bulbous head. The type is named after the village in Turkey where the first examples were found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kilia type"@en .

aat:300419366 a skos:Concept ;
    skos:definition "The boundry in which information is passed, usually between the system and its environment. It can be used to link the computer with peripherals or between the computer and a human user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interfaces"@en .

aat:300419367 a skos:Concept ;
    skos:definition "The tools and commands that connects the user to a computer or device. It allows the user to control operations and input commands or data. The design for the user interface can range from graphic to command-driven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "user interfaces"@en .

aat:300419368 a skos:Concept ;
    skos:definition "A technique that has been used for species identification and quantitation of yeast populations in foods and beverages. In a conservation context, it is used to identify biodeteriogens on cultural heritage assets such as wall paintings and textiles, as well as paper and stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denaturing gradient gel electrophoresis"@en .

aat:300419369 a skos:Concept ;
    skos:definition "The interaction between the user and computer or device using commands in the shell to access the operating system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "command-line interfaces"@en .

aat:300419370 a skos:Concept ;
    skos:definition "Coffins made of cast iron, particularly those that were manufactured in the early through mid-19th century in the United States, used to transport and preserve corpses. Usage declined after effective embalming became prevalent. The primary manufacturer was Almond Dunbar Fisk in Providence, Rhode Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron coffins"@en .

aat:300419371 a skos:Concept ;
    skos:definition "Coffins of various designs, primarily dating to 18th-19th centuries, catering to the general fear of premature burial. Features may include windows to allow the living to view the corpse or mechanisms to allow a buried person to escape from the coffin or alert others should they recover consciousness, including bells and locks workable from inside the coffin, and ladders to allow the buried to ascend from the grave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety coffins"@en .

aat:300419372 a skos:Concept ;
    skos:definition "Copper or one of its alloys in the form of or reduced to powder or in fine flake form used as a pigment, or for the preparation of coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brass powder"@en .

aat:300419373 a skos:Concept ;
    skos:definition "Gardens designed to require little or no watering, typically containing ornamental rocks and stones, or plants that thrive in dry conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry gardens"@en .

aat:300419374 a skos:Concept ;
    skos:definition "Gardens, originally in Japan, comprising an outdoor space in which natural materials such as rocks, gravel, sand are arranged in lines and patterns, creating a serene environment designed to assist meditation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zen gardens"@en .

aat:300419375 a skos:Concept ;
    skos:definition "An essential oil obtained from the bulb and stem of the garlic plant. This has many uses, including as a nontoxic biocide against fungal degradation of paper artifacts in conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil of garlic"@en .

aat:300419376 a skos:Concept ;
    skos:definition "An essential oil derived from steaming the leaves of the Australian tea tree. Tea tree oil is believed to have antibacterial properties and is used as a topical treatment for a variety of skin conditions. It is commonly found in skin products including soaps and lotions. In a conservation context it has been used to control fungi, bacteria, and other biodeteriogens on paper objects and in collection care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea tree oil"@en .

aat:300419377 a skos:Concept ;
    skos:definition "An essential oil derived from plants in the genus Thymus, used variously as a component of medicine, flavoring, perfumes and cosmetics, and in a conservation context it has been used to control fungi, bacteria, and other biodeteriogens on paper objects and in collection care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thyme essential oil"@en .

aat:300419378 a skos:Concept ;
    skos:definition "Tables or other platforms in temples and churches upon which offerings to divinities are set. Not specific to geographic location, religious culture, or historical period: there are Ptolemaic, Shinto Buddhist, Vaishnav, Christian and Jewish offering tables. Examples are the blocks of sculpted stone or wood, intended to be placed in front of the false doors or statues of Egyptian tombs. These held food, drink, or other offerings to the dead and deities. For similar objects used specifically for liquid offerings, use 'libation tables.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering tables"@en .

aat:300419379 a skos:Concept ;
    skos:definition "Biologically mediated deterioration that includes molecular changes to a material such that characteristic properties of the material are no longer evident. For loss of utilitarian or physical characteristics of a material caused by bacteria or other microorganisms, use 'biodeterioration.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biodegradation"@en .

aat:300419380 a skos:Concept ;
    skos:definition "Lightweight composite panels consisting of two sheets of aluminum bonded to a polyethylene, polyurethane, or other core, and cut to standard measurements. These have been used as exterior cladding as well as for interior surface applications, and signage. Aluminum composite panels are increasingly used in museum storage and exhibition applications as a non-VOC-emitting material, safe to use around all museum object materials. For the material that aluminum panels are formed from use \"aluminum composite material.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum composite panels"@en .

aat:300419381 a skos:Concept ;
    skos:definition "Lightweight composite material consisting of two sheets of aluminum bonded to a core of polyethylene, polyurethane, or other material. This is typically used as milled panels for exterior cladding, interior surface applications, and signage. Aluminum composite material is increasingly used in museum storage and exhibition applications as a non-VOC-emitting material, safe for use around all museum objects. For the panels that aluminum composite material forms, use \"aluminum composite panels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum composite material"@en .

aat:300419382 a skos:Concept ;
    skos:definition "A subjective term for graffiti, signage, billboards, advertising, power lines, or other built structures that are perceived to negatively affect the visual environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual pollution"@en .

aat:300419383 a skos:Concept ;
    skos:definition "Sub-discipline in archaeological practice that focuses on inter- and intragroup conflicts, including battlefield study and excavation, sites of genocide, and the deliberate destruction of built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conflict archaeology"@en .

aat:300419384 a skos:Concept ;
    skos:definition "Unmanned underwater robots used for survey missions such as detecting and mapping submerged wrecks, rocks, and obstructions (with the use of sensors) that can be a hazard to navigation for commercial and recreational vessels. They complete these missions without operator control. For similar devices controlled by an operator remotely, use 'remote submersibles.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous underwater vehicles"@en .

aat:300419385 a skos:Concept ;
    skos:definition "The study of the ancient civilization, language, history, and antiquities of Assyria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assyriology"@en .

aat:300419386 a skos:Concept ;
    skos:definition "Natural satellites that orbit a moon and themselves are large enough to be considered a moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moonmoons"@en .

aat:300419387 a skos:Concept ;
    skos:definition "Style that reflects the cross-cultural influence between England and the Netherlands in art, architecture, or culture, primarily from the 15th through the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Netherlandish"@en .

aat:300419388 a skos:Concept ;
    skos:definition "Variety of shale that contains abundant organic matter, pyrite, and sometimes carbonate nodules or layers and, in some locations, concentrations of copper, nickel, uranium, and vanadium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black shale"@en .

aat:300419389 a skos:Concept ;
    skos:definition "Fiber created by heating crushed basalt and drawing the molten material into filament. It has been used as a strengthening agent in the construction industry, aerospace, for fire and environmental protection, and for automotive and vessel manufacture. It is recognized for a variety of properties including resistance to temperature fluctuations, acids and alkalis, and radiation. It exhibits good wave adsorption and is also used as an element in sound insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basalt fiber"@en .

aat:300419390 a skos:Concept ;
    skos:definition "Technologies, processes or measures implemented to protect computers, networks, and data from unauthorized access, vulnerabilities and attacks administered via the Internet or in other ways. Cybersecurity is most commonly intended to protect against viruses or fraud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cybersecurity"@en .

aat:300419391 a skos:Concept ;
    skos:definition "Business enterprises that provide and oversee the physical and technical means allowing the creation or manifestation of a thing or event. Examples are production companies for the creation of film, television, radio, performing arts, new media art, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "production companies"@en .

aat:300419392 a skos:Concept ;
    skos:definition "Any set of data, facts, instructions, or other information that are broad in scope and discussion, rather than specific and detailed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general information"@en .

aat:300419393 a skos:Concept ;
    skos:definition "Programs written to disrupt or damage computers or other electronic devices. Malware may include viruses, worms, spyware, or trojans, and typically infects personal computers through e-mail, Web sites, or periferal hardware devices. Malware may be used to take over PCs to create shadow networks to deliver spam or perform denial of service attacks on Web sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malware"@en .

aat:300419394 a skos:Concept ;
    skos:definition "Branch of mechanics dealing with the properties and behavior of liquids and gases and the ways in which they respond to and exert forces. Study of fluids in motion, or fluid dynamics, makes up the larger part of fluid mechanics, and branches of fluid dynamics include hydrodynamics and aerodynamics. Hydrodynamics is often used synonymously with fluid dynamics"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluid mechanics"@en .

aat:300419395 a skos:Concept ;
    skos:definition "Blocks of data created in a distributed ledger technology that was originally designed for cryptocurrency, but now being used in a wider range of implemenations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blockchain"@en .

aat:300419396 a skos:Concept ;
    skos:definition "Digital currencies operating independently of central banks, using encryption techniques to regulate the generation of units of currency and verify the transfer of funds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryptocurrencies"@en .

aat:300419397 a skos:Concept ;
    skos:definition "Cryptocurrency comprising a digital payment system that has its own unit of account. It was devised in 2009 by an entity known as 'Satoshi Nakamoto,' which is presumed to be a pseudonym for one or more unknown persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bitcoin"@en .

aat:300419398 a skos:Concept ;
    skos:definition "Chains comprising transverse blocks or cylinder units, joined by side links and held in place by pins. The blocks engage a driving wheel with teeth. An example of a block chain is used to rotate bicycle wheels and on other mechanical devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block chains"@en .

aat:300419399 a skos:Concept ;
    skos:definition "Chains comprising simple loops joined to loops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loop-in-loop chains"@en .

aat:300419400 a skos:Concept ;
    skos:definition "Rooms made specially secure for the custody of people or things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strong rooms"@en .

aat:300419401 a skos:Concept ;
    skos:definition "Rooms, usually above ground, intended for the protection of people from danger, such as from storms or violence. For below ground spaces for protection from tornadoes and other wind events, use \"storm cellars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safe rooms"@en .

aat:300419402 a skos:Concept ;
    skos:definition "A type of decoration on Dutch and German glassware and ceramics popular in the 17th and 18th centuries. This was created with a sepia enamel that had been used in stained glass techniques, and adapted to various wares either alone or in combination with other enamels or gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schwarzlot"@en .

aat:300419403 a skos:Concept ;
    skos:definition "Sedimentary conglomerate of calcareous sand and chalk formed in intertidal zones of beaches in tropical and other areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beachrock"@en .

aat:300419404 a skos:Concept ;
    skos:definition "Subdiscipline of fluid mechanics that predicts the behaviour of fluids and of the effects of fluid motion past objects by numerical methods rather than model experiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computational fluid dynamics"@en .

aat:300419405 a skos:Concept ;
    skos:definition "Including, participated in by, involving, or affecting, all, or nearly all, the parts of a specified or implied whole; completely or approximately universal within implied limits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general"@en .

aat:300419406 a skos:Concept ;
    skos:definition "Belonging to or affecting only a part of something; not universal; not applicable to all of a given class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particular"@en .

aat:300419407 a skos:Concept ;
    skos:definition "Art works created with rubber stamps, vegetable stamps, or other types of stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamp art"@en .

aat:300419408 a skos:Concept ;
    skos:definition "Stamp art made specifically with rubber stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubber stamp art"@en .

aat:300419409 a skos:Concept ;
    skos:definition "An archaeological culture of the 2nd and 5th centuries CE in a wide area of Eastern Europe, deemed to be multiethnic mix of Sarmatian, Slavic, Gothic, and Geto-Dacian populations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chernyakhov"@en .

aat:300419410 a skos:Concept ;
    skos:definition "In the context of Buddhism, revolving cylindrical boxes inscribed with or containing a mantra, used as aids to meditation, each revolution considered to be equivalent to the recital of the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer wheels"@en .

aat:300419411 a skos:Concept ;
    skos:definition "Students in educational institutions for the third level of (usually compulsory) education for children, entered after elementary school and middle or junior high school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high school students"@en .

aat:300419412 a skos:Concept ;
    skos:definition "Students in educational institutions teaching at a level intermediate between elementary school and high school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junior high school students"@en .

aat:300419413 a skos:Concept ;
    skos:definition "Students in educational institutions providing the first stage of compulsory education, generally extending from grade 1 through grades 6 or 8 and teaching the rudiments of learning; may house a kindergarten."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elementary school students"@en .

aat:300419414 a skos:Concept ;
    skos:definition "Students in institutions of higher learning that provide general or liberal arts education leading to degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "college students"@en .

aat:300419415 a skos:Concept ;
    skos:definition "An architectural idiom appearing from the late 19th century, but more particularly 1910-1930, seen in the construction of shophouses of Malaysia and Singapore. It is a mix of European aesthetic traditions, especially Georgian, with Chinese and Malay patterns, which may combine Chinese friezes, pintu pagar half-doors, imported glazed tile, Palladian fan lights, and Doric columns with fretwork and grilles more common in a Southeast Asian context. Facades in this style are noted for their vivid color schemes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese Baroque"@en .

aat:300419416 a skos:Concept ;
    skos:definition "Combined residential and commercial structures built with a shop that opens on to the ground floor pavement with a second or third storey generally used as a residence for the proprietor. Examples are found in Singapore, Malaysia, and China, but the form exists elsewhere, often in \"Chinatown\" developments in American cities, referring back to the original source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shophouses"@en .

aat:300419417 a skos:Concept ;
    skos:definition "A family of flowering plants comprising about 2000 species in the eudicot order of Malpighiales. Found in the tropical to warm temperate regions, many in the south temperate zone, and a few ranging as far north as the middle of the north temperate zone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phyllanthaceae"@en .

aat:300419418 a skos:Concept ;
    skos:definition "A deciduous tree of the family Phyllanthaceae. A few of its uses include its edible fruit, as a “green,\" nontoxic antioxidant, a rust removing agent of akaganeite from steel, and as a mordant for textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phyllanthus emblica"@en .

aat:300419419 a skos:Concept ;
    skos:definition "Vascular plant genus in the flowering plant family Phyllanthaceae, with diverse growth forms including herbs, shrubs, climbers,etc. Most all exhibit phyllanthoid branching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phyllanthus"@en .

aat:300419420 a skos:Concept ;
    skos:definition "Measurement for how much of a file is downloaded/uploaded per second. Distinguished from megaits per second, which refers to Internet connection speeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MBps"@en .

aat:300419421 a skos:Concept ;
    skos:definition "Small television camera tubes of a particular kind, in which the image is formed on a transparent electrode coated with photoconductive material, the video signal being obtained from the variation in the current flowing to or from this as it is scanned by a beam of (usually low-speed) electrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vidicons"@en .

aat:300419422 a skos:Concept ;
    skos:definition "Vacuum tubes that contain one or more electron guns and a phosphorescent screen; used to display images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathode ray tubes"@en .

aat:300419423 a skos:Concept ;
    skos:definition "Vacuum tubes for television cameras, using a photosensitive surface located in the image plane, of the television camera object lens; having a storage surface on which electronic charge is accumulated, and a scanning electron beam that discharges the target to produce the amplitude modulated video signal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television camera tubes"@en .

aat:300419424 a skos:Concept ;
    skos:definition "Clothing for the upper body, usually as womenswear. The front is made of two parts whose crossing forms a V-shape decolletage. The two parts can be attached at the waist in several ways; usually straps or buttons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrap blouses"@en .

aat:300419425 a skos:Concept ;
    skos:definition "Perlon is a type of polyamide created by the German company Bayer-Faser in the 1940s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Perlon (R)"@en .

aat:300419426 a skos:Concept ;
    skos:definition "Feathers, mostly obtained from the wings and tail of the marabou, a large stork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marabou"@en .

aat:300419427 a skos:Concept ;
    skos:definition "A type of wood ceiling primarily found in Islamic, Spanish, or Moorish architecture. The structure is a series of girders with perpendicular beams, which are often carved, painted, or otherwise stylized. This type of ceiling, with variations, appears in Spanish colonial sites in the Americas as well as in Europe and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alfarje"@en .

aat:300419428 a skos:Concept ;
    skos:definition "Game that developed in the 19th century as a game of skill, using a cue ball for each player and a red striker ball. The object of the game is to use your cue ball to push the striker ball into your opponent’s cue ball. A billiards table does not have pockets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billiards"@en .

aat:300419429 a skos:Concept ;
    skos:definition "Game that developed as a common man's game from billiards, that was considered a gentlemen's game of skill. Pool is played with a 15 balls and a cue ball on a table with six pockets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pool"@en .

aat:300419430 a skos:Concept ;
    skos:definition "Deterioration caused by agents present in a material itself. This may be the a result of short-lived, temporary, or impermanent materials, or the structural nature of a material. This fault or defect may lead to natural deterioration or make an object more susceptible to external agents of deterioration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inherent vice"@en .

aat:300419431 a skos:Concept ;
    skos:definition "Models created by stereolithography, which is a form of 3-D printing technology. Examples include models based on data from computer scans, e.g., as used to create replacement parts in restoration of art works or to create anatomical models for medical or paleontological purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereolithographic models"@en .

aat:300419432 a skos:Concept ;
    skos:definition "Suborder within the order Carnivora consisting of cat-like carnivorans, including cats, hyenas, mongooses, civets, and related taxa. Feliformia stands in contrast to the other suborder of Carnivora, Caniformia, dog-like carnivorans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feliformia"@en .

aat:300419433 a skos:Concept ;
    skos:definition "Suborder within the order Carnivora consisting of dog-like carnivorans, including dogs, bears, racoons, mustelids, pinnipeds, and related taxa. Feliformia stands in contrast to the other suborder of Carnivora, Feliformia, cat-like carnivorans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caniformia"@en .

aat:300419434 a skos:Concept ;
    skos:definition "The study of generally microscopic fossils, regardless of the group to which they belong. Examples of specimens include ostracods, foraminifera, and pollen grains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micropaleontology"@en .

aat:300419435 a skos:Concept ;
    skos:definition "The study of invertebrate animal fossils, such as mollusks, echinoderms, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invertebrate paleontology"@en .

aat:300419436 a skos:Concept ;
    skos:definition "The study of vertebrate fossils, from primitive fishes to mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertebrate paleontology"@en .

aat:300419437 a skos:Concept ;
    skos:definition "Long, showy feathers of the peacock, male of the Pavo genus. In art, used for decoration, as a material, and as a design motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peacock feathers"@en .

aat:300419438 a skos:Concept ;
    skos:definition "Language isolate unrelated to any other languages; spoken by people of the Mapuche culture of central Chile and Argentina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mapuche"@en .

aat:300419439 a skos:Concept ;
    skos:definition "A silvery-white metallic element of the lanthanide series, atomic no. 60, which was discovered as a component (with praseodymium) of the supposed element didymium and is used in mischmetal and some other alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neodymium"@en .

aat:300419440 a skos:Concept ;
    skos:definition "Style of painting that was primarily employed by a loosely associated group of late 19th-century Italian artists seeking a distinctly Italian avant-garde style. It uses hatching, dashes, or patches of colors to visually achieve a luminous optical effect, rather than physically mixing colors of paint. At close viewing, a Divisionist canvas is a mass of contrasting marks; at a distance, the colors are intended to visually enhance each other and produce an effect of shimmering luminosity. The style that specifically uses dots of color is usually called \"Pointillist\" in modern usage. While French painters using this or a similar style may be called \"Neo-Impressionist,\" for Italian painters, it is common to call them \"Divisionist.\" The Italian artists' style was considered both autonomous from their other European counterparts and pioneering of Modernism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Divisionist"@en .

aat:300419441 a skos:Concept ;
    skos:definition "Style of painting resulting from the technique of pointillism, which uses dots or short dashes of unmixed color to create images. Some scholars make a distinction between pointilism as a technique only, not using the term to designate the style per se of the Pointillist painters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pointillist"@en .

aat:300419442 a skos:Concept ;
    skos:definition "Refers to the general technique of separation of color using marks of any kind in painting or printmaking, particularly in the works of Italian artists. The term was invented by Paul Signac to describe the technique of Neo-Impressionist separation of color into dots or patches applied directly to the canvas, intended to produce maximum brilliance, avoiding muddiness caused by physically mixing colors. While divisionism may be used as a synonym for \"pointillism,\" in modern usage the term \"pointillism\" often refers specifically to the technique using dots or very short dashes in a more controlled manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divisionism"@en .

aat:300419444 a skos:Concept ;
    skos:definition "Informal term referring to the most common variety of the French language spoken in France, Andorra, and Monaco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Standard French"@en .

aat:300419445 a skos:Concept ;
    skos:definition "Refers to dialects of the French language generally spoken in Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canadian French"@en .

aat:300419446 a skos:Concept ;
    skos:definition "The materials or formula of ingredients from which paper is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnishes"@en .

aat:300419447 a skos:Concept ;
    skos:definition "Remote underwater free-swimming vessels distinct from remote control vehicles that operate in the air or on land. ROVs are unoccupied, and are tethered to operators that maneuver them from vessels, floating platforms, or on land. They are common in deep water industries, underwater archaeology, and marine biology. They are linked to a host by buoyant tethers or load-carrying umbilical cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remotely operated vehicles"@en .

aat:300419448 a skos:Concept ;
    skos:definition "Underwater vehicles that maneuver without humans on board. These exist in two types: remotely operated underwater vehicles (ROVs), which are tethered to and controlled by a remote operator, and autonomous underwater vehicles (AUVs), which maneuver independently of direct operator input."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unmanned underwater vehicles"@en .

aat:300419449 a skos:Concept ;
    skos:definition "Objects of varied form used to remove dust from surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dusters"@en .

aat:300419450 a skos:Concept ;
    skos:definition "Pieces of woven material intended as tools to remove dust from surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust cloths"@en .

aat:300419451 a skos:Concept ;
    skos:definition "Any liquid that may be ingested for assuaging thirst, or as nourishment. For prepared or flavored liquids drunk as refreshment, or for pleasure, including alcoholic drinks, but excluding plain water, use 'beverages,' though these concepts overlap in meaning and usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinks"@en .

aat:300419452 a skos:Concept ;
    skos:definition "A set of shared application programming interface (API’s) specifications that allows for the parsing and sharing of digital images and presentation metadata across the Web."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "IIIF"@en .

aat:300419453 a skos:Concept ;
    skos:definition "APIs or application programming interfaces are sets of standards, communication protocols, and tools for building software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "APIs"@en .

aat:300419454 a skos:Concept ;
    skos:definition "General term used to reference various components of a body, usually restricted to the human body. Included may be external parts or internal parts, such as organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body parts"@en .

aat:300419455 a skos:Concept ;
    skos:definition "Spaces where carved stone works or fragments of works of archaeological interest are displayed or stored. Lapidaria are usually part of larger museums dedicated to historical or archaeological objects, and may contain architectural elements, reliefs, sarcophagi, statues, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapidaria"@en .

aat:300419456 a skos:Concept ;
    skos:definition "Masks designed to cover only, or primarily, the eyes for fashion, disguise, ritual, or another purpose. For articles used to cover the eyes for the purpose of blocking light for sleep, use \"eye masks (blindfolds).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye masks"@en .

aat:300419457 a skos:Concept ;
    skos:definition "Fundamental or general truths, propositions, statements, or tenets forming the basis of a system of belief or action, forming a primary assumption forming the basis of a chain of reasoning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "principles"@en .

aat:300419458 a skos:Concept ;
    skos:definition "Domain-specific language used in programming and designed for managing data held in a relational database management system, or for stream processing in a relational data stream management system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "SQL"@en .

aat:300419459 a skos:Concept ;
    skos:definition "Languages used in communicating with, querying, or programming computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer languages"@en .

aat:300419460 a skos:Concept ;
    skos:definition "The state or characteristic of having a low degree of distinctness, lacking sharp focus or fine detail. For example, used in reference to a visual output, such as from a camera, television, computer screen, or printer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low resolution"@en .

aat:300419461 a skos:Concept ;
    skos:definition "Tree that is cultivated throughout the Old World tropics, notably in India and Southeast Asia. Used as a source of timber and medicinal oils and resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Azadirachta indica"@en .

aat:300419462 a skos:Concept ;
    skos:definition "Genus containing two recognized species of trees in the mahogany family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Azadirachta"@en .

aat:300419463 a skos:Concept ;
    skos:definition "Brand name of acrylic copolymer resins; subsumed in \"Paraloid®\" in 1997, to consolidate the disparate North American and European names used for the same products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acryloid (TM)"@en .

aat:300419464 a skos:Concept ;
    skos:definition "Plans that outline the significance of a heritage asset, such as a church or other built work, and that outline the course of its conservation and management. Plans set out in the CMP include its significance for future use, along with a description of repairs or alterations. The compilation of a CMP involves the collaboration of various professions and stakeholders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation management plans"@en .

aat:300419467 a skos:Concept ;
    skos:definition "Chemical element that, when pure, is a pale-yellow, toxic gas. Fluorine occurs naturally in the form of mineral fluorite, cryolite, and fluorapatite. Fluorine is the most electronegative and reactive element known. Henri Moissan of France received a Nobel Prize for first isolating fluorine in 1886."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorine"@en .

aat:300419472 a skos:Concept ;
    skos:definition "Compounds containing calcium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium compounds"@en .

aat:300419473 a skos:Concept ;
    skos:definition "Temporary fortifications, parapets, or galleries of wood erected on the battlements of fortresses, historically erected in the anticipation of a seige."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brattices"@en .

aat:300419474 a skos:Concept ;
    skos:definition "Acrylic in the form of transparent or translucent solid sheets. Prepared by cast polymerization or extrusion; acrylic sheets are lightweight, tough, and colorless with excellent clarity and outdoor weather resistance. Compared to glass, acrylic is lighter and shatter-resistant, but more susceptible to scratching and transmission of UV. Acrylic has the unique ability to carry light around corners. Originally introduced as 'organic glass' in 1931."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic sheet"@en .

aat:300419475 a skos:Concept ;
    skos:definition "The process of fastening, affixing, or connecting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attaching"@en .

aat:300419476 a skos:Concept ;
    skos:definition "Compilation of data in one particular arrangement of data or characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formatting"@en .

aat:300419477 a skos:Concept ;
    skos:definition "A series of silicon hydride compounds, analogous to paraffin hydrocarbons, and having the general formula (Si)n(H2)n+2. Silanes are inherently unstable but have the unique ability to bind organic polymers to inorganic substrates. They have been used in the consolidation of masonry, adobe, and stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silane"@en .

aat:300419478 a skos:Concept ;
    skos:definition "Those engaged in the creation of decorative veneers pieced together from wood, or other materials of varied shades or colors, especially on the surfaces of furniture, cabinetry, or decorative works. The result is a surface covered with decorative motifs, figures, or pictorial images. For artists creating similar works that may be of any material, including glass, use \"intarsia artists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marqueteurs"@en .

aat:300419480 a skos:Concept ;
    skos:definition "Optics using lenses comprising arrays of small hollow glass tubes that guide the x-rays to one small point. The array is tapered so that one end of the capillaries points at the x-ray source and the other at the sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polycapillary optics"@en .

aat:300419481 a skos:Concept ;
    skos:definition "Lenses comprising arrays of small hollow glass tubes that guide x-rays to one small point. The array is tapered so that one end of the capillaries points at the x-ray source and the other at the sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polycapillary lenses"@en .

aat:300419482 a skos:Concept ;
    skos:definition "Branch of optics that uses x-rays instead of visible light, concerned with focusing and otherwise manipulating x-rays beams for use in analysis. Since x-rays are strongly absorbed by solid matter, the optics used in the visible and near-infrared portions of the electromagnetic spectrum cannot be used to focus or reflect the radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray optics"@en .

aat:300419483 a skos:Concept ;
    skos:definition "The theory or doctrine that society can be organized according to a cooperative model, a system based on non-profit credit and voluntary association for the exchange of services. Mutualism originated in the the writing of Pierre-Joseph Proudhon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutualism"@en .

aat:300419484 a skos:Concept ;
    skos:definition "Structures underneath aircraft that are designed to support the aircraft on the ground and to absorb the shock of landing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landing gear"@en .

aat:300419485 a skos:Concept ;
    skos:definition "Locks set into a cavity, hole, or recess of a door or window frame and requiring a special faceted or slotted shank key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortise rack bolts"@en .

aat:300419486 a skos:Concept ;
    skos:definition "Devices for changing the diverging light or other radiation from a point source into a parallel beam. This collimation of the light is required to make specialized measurements in spectroscopy and in geometric and physical optics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collimators"@en .

aat:300419487 a skos:Concept ;
    skos:definition "Glass that is translucent due to having undergone sandblasting or acid etching, producing a pitted surface on one side that scatters the light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frosted glass"@en .

aat:300419489 a skos:Concept ;
    skos:definition "Glass that is coated with a highly reflective metallic coating, often used for mirrors and decorative effects. Glass mirrors with a metallized backing were first constructed in Venice in the 16th century using an amalgam of tinfoil and mercury. In 1836, a German chemist, J. von Liebig, developed a method to coat the glass with a silver salt then reduce it to metallic silver. For glass used to reflect solar radiation in windows, use \"reflective glass.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallized glass"@en .

aat:300419490 a skos:Concept ;
    skos:definition "The maintenance policy applied to buildings or sites to uphold their structural integrity, yet preserve their ruined appearance. May also be applied to objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrested decay"@en .

aat:300419491 a skos:Concept ;
    skos:definition "Microbially mediated stabilization of degraded or weakened areas of works, usually of stone, that are affected by chemical, physical, or biological weathering phenomena. In situ cementation of ornamental materials occurs via microbially induced biomineralization. Bioconsolidation may occur naturally on surfaces where microorganisms aid in the formation of cementing phases such as oxalates and carbonates, and biofilms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioconsolidation"@en .

aat:300419492 a skos:Concept ;
    skos:definition "Class of moss having two orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphagnopsida"@en .

aat:300419493 a skos:Concept ;
    skos:definition "An order of moss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphagnopsida"@en .

aat:300419494 a skos:Concept ;
    skos:definition "A family of moss with only one living genus Sphagnum"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphagnaceae"@en .

aat:300419495 a skos:Concept ;
    skos:definition "Genus containing 150-350 living species of mosses. The taxonomy of Sphagnum species remains controversial, with various botanists accepting quite different numbers of species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphagnum"@en .

aat:300419940 a skos:Concept ;
    skos:definition "Works made with and existing in the context of networked systems, meant to be accessed via network protocols. This term is not used to refer to reproductions of art made in other media that is represented on Web sites or online media. 'Web art' is considered a separate concept, as net art may use protocols other than the World Wide Web. Some argue that net art is independent of technology, and is defined only as work that uses systems or social situations as the medium, but the majority of these works exist in the context of computer networking systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "net art"@en .

aat:300419941 a skos:Concept ;
    skos:definition "Describes a process of weathering in which the outer shell of rock becomes more resistant to erosion than its interior. Case hardening occurs by strengthening the exterior shell of the rock or by weakening of the rock's interior. In materials such as sandstone a greater accumulation of cements holding individual grains together at the surface causes shell strengthening. Case hardening in crystalline rock takes place when bonds are broken in the interior through chemical weathering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case hardening"@en .

aat:300419942 a skos:Concept ;
    skos:definition "Skirts formed by attaching elaborately treated and dried flax blades to a woven waistband or belt. These are now chiefly worn during ceremonial occasions or performances by Maori men and women. The flax used to make these is stripped to the fiber in regular sections, then boiled and dried so that it whitens and rolls into tubes. These treated pieces are dyed black, the exposed fiber taking up the dye, creating contrasting motifs in the finished piupiu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piupiu"@en .

aat:300419943 a skos:Concept ;
    skos:definition "In Peru and other areas of Latin American, cups of faience or organic materials, used especially in the colonial era to serve hot chocolate or other hot beverages. Chocolate drink was consumed by the Mayans as early as 150 BCE, and in the following centuries it became a popular beverage among many indigenous groups. To create a Western-style form of the traditional mate cup, Spanish colonists improvised by using gourds, coconuts, wood, and other organic materials already in use, to which they added European-style bases, handles, and rims made of silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jícaras de chocolate"@en .

aat:300419944 a skos:Concept ;
    skos:definition "Accessories comprlsing a saucer or small platter with a ring on the surface to hold in place a cup of hot chocolate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mancerinas"@en .

aat:300419945 a skos:Concept ;
    skos:definition "Genus containing six species native to southern North America, the Caribbean, Central America northern South America, West Africa and South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crescentia"@en .

aat:300419946 a skos:Concept ;
    skos:definition "Tree that grows in parts of Africa, Central and South America, the West Indies, and extreme southern Florida. It is used as an ornamental, for traditional systems of medicine, and for its fruits that are used as vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crescentia cujete"@en .

aat:300419948 a skos:Concept ;
    skos:definition "Order of flowering plants containing seven families, 129 genera, and 2,295 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cucurbitales"@en .

aat:300419949 a skos:Concept ;
    skos:definition "Gourd family of flowering plants, containing 98 genera and about 975 species of food and ornamental plants. Members of the family are annual or perennial herbs native to temperate and tropical areas and include cucumbers, gourds, melons, squashes, and pumpkins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cucurbitaceae"@en .

aat:300419950 a skos:Concept ;
    skos:definition "Genus of gourd-bearing vines, containing six species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lagenaria"@en .

aat:300419951 a skos:Concept ;
    skos:definition "Genus of gourd-bearing vines, containing six species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lagenaria siceraria"@en .

aat:300419952 a skos:Concept ;
    skos:definition "Carpets or rugs made using knots, in the most common method of creating pile carpets; knots are formed by tying yarn around two warp strands to form a knot on the surface of the textile. After each row of knots is created, one or more strands of weft are passed through the warp strands. Then the knots and the weft strands are beaten with a comb securing the knots in place. The number of knots per square inch determines the appearance and texture of the rug."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knotted-pile carpets"@en .

aat:300419955 a skos:Concept ;
    skos:definition "Places at which material such as wool, ore, coal, or crushed stone is separated from impurities or dust by washing in water or other liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washeries"@en .

aat:300419957 a skos:Concept ;
    skos:definition "Structurally distinct forms in which a chemical element may occur. Some chemical elements may exist in two or more different forms, in the same physical state. Allotropes are different structural modifications of an element; the atoms of the element are bonded together in a different manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allotropes"@en .

aat:300419958 a skos:Concept ;
    skos:definition "Forms of the chemical element oxygen that are different from each other but exist in the same physical state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxygen allotropes"@en .

aat:300419961 a skos:Concept ;
    skos:definition "Places at which coal is separated from impurities or dust by washing in water or other liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal washeries"@en .

aat:300419962 a skos:Concept ;
    skos:definition "Growing out of Constructionism, Structurism is the style and movement that emphasizes the underlying structural forms and processes found in nature, particularly as illustrated in the painted reliefs developed by the U.S. artist and theorist Charles Biederman (1906-2004)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Structurist"@en .

aat:300419963 a skos:Concept ;
    skos:definition "Phonograph records that are made from flexible materials, usually vinyl sheets, though variations have been paper-backed. The most well-known version was introduced commercially in the US in 1962 as the Eva-Tone Soundsheet, in Europe as Lyntone Recordings. Flexible records using materials other than vinyl predating Soundsheets include Marconi Velvet Tone records of 1906, made of a paper-based core laminated between two sheets of celluloid, the Hit Of The Week label in the US, and the Durium label in the UK, which made flexible records with a cardboard backing. From the 1950s in the Soviet Union, discarded X-ray film was used to engrave recordings to distribute music outside official channels. Vinyl flexi discs were used to bind sound recordings within printed publications. From 1980 to 1982, Flexipop! magazine in the UK included colored flexi discs with each issue. Versions of the flexi disc concept have been included as elements of product packaging such as cereal boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flexi discs"@en .

aat:300419964 a skos:Concept ;
    skos:definition "Gardens devoted to the remembrance of someone or a tragic event, such as war; typically intended as a tribute to the deceased and a place of peace and comfort to the living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorial gardens"@en .

aat:300419966 a skos:Concept ;
    skos:definition "Order of comb jellies, distinguished by having spherical or oval bodies and branched, retractable tentacles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cydippida"@en .

aat:300419967 a skos:Concept ;
    skos:definition "Family of comb jellies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pleurobrachidae"@en .

aat:300419968 a skos:Concept ;
    skos:definition "Genus of comb jellies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hormiphora"@en .

aat:300419969 a skos:Concept ;
    skos:definition "Genus of comb jellies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pleurobrachia"@en .

aat:300419970 a skos:Concept ;
    skos:definition "Tools or equipment for working fibers, generally restricted to fibers other than textile fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiberworking tools"@en .

aat:300419974 a skos:Concept ;
    skos:definition "Materials that are used for smoking, often processed or made into a certain forms, such as cigars or cigarettes that are contain or are made of tobacco. Smoking materials are typically used for recreation or for medicinal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoking materials"@en .

aat:300419975 a skos:Concept ;
    skos:definition "Compact rolls of tobacco leaves for smoking, one end being taken in the mouth while the other is lit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigars"@en .

aat:300419976 a skos:Concept ;
    skos:definition "Cylinders, smaller than cigars, made of finely-cut tobacco for smoking rolled up in thin paper, tobacco-leaf, or maize-husk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigarettes"@en .

aat:300419977 a skos:Concept ;
    skos:definition "General term for artificial plant matter, including flowers, foliage, and fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial flora"@en .

aat:300419979 a skos:Concept ;
    skos:definition "General term for all glassware and equipment used in laboratories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labware"@en .

aat:300419980 a skos:Concept ;
    skos:definition "Instruments, tools, and equipment used to care for teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental instruments"@en .

aat:300419983 a skos:Concept ;
    skos:definition "Artificially produced radioactive element in Group VIb of the periodic table, atomic number 106; first created in 1974. Named after the American nuclear chemist Glenn T. Seaborg. It can be created in a laboratory but is not found in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seaborgium"@en .

aat:300419984 a skos:Concept ;
    skos:definition "Areas in which armed hostilities are actively taking place, as when factions are waging war or civil war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conflict zones"@en .

aat:300419985 a skos:Concept ;
    skos:definition "The process of lining by adding a new or additional lining material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relining"@en .

aat:300419986 a skos:Concept ;
    skos:definition "Shapes made of fabric or paper, in modern times often tissue paper, used as guides to cut out sections of fabric that can be stitched together into finished works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing patterns"@en .

aat:300419987 a skos:Concept ;
    skos:definition "Large baskets, bags, or boxes, often used in pairs, used for transporting objects. These may be carried by a beast of burden; on a person's shoulders or by hand, or mounted on bicycles or automotive vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panniers"@en .

aat:300419988 a skos:Concept ;
    skos:definition "Industrial building facilities in which chocolate, or chocolate confectionery, is produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocolate factories"@en .

aat:300419989 a skos:Concept ;
    skos:definition "Thread made from single strands of raw silk twisted together, folded against itself, and twisted again in the opposing direction. Usually used as warp threads in fine woven fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organzine"@en .

aat:300419990 a skos:Concept ;
    skos:definition "Man-made landscapes that are the result of a process of industrial decline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned landscapes"@en .

aat:300419991 a skos:Concept ;
    skos:definition "A photogrammetric range imaging technique that utilizes a series of two-dimensional images to estimate the three-dimensional structure of a scene or object. SfM can produce point cloud based 3-D models similar to LiDAR. High resolution digital surface models can be generated with ordinary consumer-grade digital cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Structure from Motion"@en .

aat:300419992 a skos:Concept ;
    skos:definition "Headings of subsections in a work, such as an outline, Web site, or book, newspaper, article, or other written text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subheadings"@en .

aat:300419993 a skos:Concept ;
    skos:definition "Objects created by 3-D printing, whether reproductions or original works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "3-D printed objects"@en .

aat:300419994 a skos:Concept ;
    skos:definition "Systems in which plants grow on a vertical surface such as a building facade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical gardens"@en .

aat:300419995 a skos:Concept ;
    skos:definition "Paper that is treated and embossed to simulate the appearance of true parchment derived from the skin of animals. Vegetable parchment is a tough translucent paper made from slightly beaten chemical wood pulp and/or cotton fibers. The fiber sheet is immersed in acid baths of diminishing strength to render it semi-transparent. Vegetable parchment is resistant to grease and solvents and has high wet strength. It may be coated on one side with silica to produce a smooth, nonabsorbent printing surface, often used for offset lithography or silk-screen printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable parchment"@en .

aat:300419996 a skos:Concept ;
    skos:definition "Serial publications produced by artists or their supporters. Examples are those popular in the 1960s through the 1980s as alternatives to the mainstream art press and commercial gallery system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' periodicals"@en .

aat:300419997 a skos:Concept ;
    skos:definition "Common name for any of numerous terrestrial slow-moving pulmonate gastropods or land-snails in which the shell is rudimentary or entirely absent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slugs"@en .

aat:300419998 a skos:Concept ;
    skos:definition "The action of selling by auction, which is a public sale in which each bidder offers an increase upon the price offered by the preceding bidder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auctioning"@en .

aat:300420000 a skos:Concept ;
    skos:definition "Status of property transferred by sale to a new owner in an auction, which is a public sale of property to the highest bidder, as by successive increased bids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sold at auction"@en .

aat:300420001 a skos:Concept ;
    skos:definition "Status of property that was presented for sale, but not necessarily sold, in an auction, which is a public sale of property to the highest bidder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offered at auction"@en .

aat:300420002 a skos:Concept ;
    skos:definition "Status of property that was described for sale, but not necessarily offered or sold, in an auction, which is a public sale of property to the highest bidder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cataloged for auction"@en .

aat:300420003 a skos:Concept ;
    skos:definition "The practice of obtaining funding for a project or venture by soliciting contributions from a large number of people especially using social media and the Internet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowdfunding"@en .

aat:300420004 a skos:Concept ;
    skos:definition "A class of enigmatic neolithic monuments that are comprised of parallel banks with ditches at their outside edges. These may have squared or curved ends terminated with additional external mounds, and are found running across land, often for long distances. They represent some of the oldest prehistoric monumental structures of the islands of Britain and Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cursus monuments"@en .

aat:300420005 a skos:Concept ;
    skos:definition "Paintings on animal hide, usually American bison or elk. Prime examples represent the traditional Plains Indian artistic practice of painting on either tanned or raw animal hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hide paintings"@en .

aat:300420006 a skos:Concept ;
    skos:definition "Artists who specialize in paintings on animal hide, usually American bison or elk; term is usually used for First Nations or Native American artists, including those of the traditional Plains Indian artistic tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hide painters"@en .

aat:300420007 a skos:Concept ;
    skos:definition "Hunting of game or other animals by pursuit. Usually the hunting animals are greyhounds or other sight hounds, who catch the prey by speed, using sight rather than scent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coursing"@en .

aat:300420008 a skos:Concept ;
    skos:definition "Capitals of the architectural style associated with the fifth of the traditional five classical orders of architecture, that also include Doric, Ionic, Corinthian, and Tuscan. It is characterized by the merging of Ionic and Corinthian stylistic elements in the capital, where the Ionic volute and the Corinthian acanthus leaves are combined to create a more lavish whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Composite capitals"@en .

aat:300420009 a skos:Concept ;
    skos:definition "Capitals characteristic of the Classical Ionic style, having volutes as a prominent feature; the style is also characterized by richly carved moldings and columns with bases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionic capitals"@en .

aat:300420010 a skos:Concept ;
    skos:definition "Capitals of the Classical architectural Doric order, which is characterized by columns generally without bases, relatively simple capitals, and a frieze composed of alternating triglyphs and metopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Doric capitals"@en .

aat:300420011 a skos:Concept ;
    skos:definition "Unadorned cushion capitals, characteristic of the Tuscan order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuscan capitals"@en .

aat:300420012 a skos:Concept ;
    skos:definition "Skilled masons who design buildings or oversee their construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master masons"@en .

aat:300420013 a skos:Concept ;
    skos:definition "Architects retained and supported by a monarch, having an official position in the court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal architects"@en .

aat:300420014 a skos:Concept ;
    skos:definition "Light-sensitve polymers that change structurally with exposure to radiation such as ultraviolet light or heat. These materials may appear in various forms including films or liquids, which have applications as printing plates, in photoresists, stereolithographic printing, imaging circuit boards, and the manufacture of paints or enamels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photopolymers"@en .

aat:300420015 a skos:Concept ;
    skos:definition "Those who engrave copper, usually artists who engrave copper plates for printmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper engravers"@en .

aat:300420016 a skos:Concept ;
    skos:definition "Artists who created art conforming to the official standards and principles of taste of European and American art academies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic artists"@en .

aat:300420017 a skos:Concept ;
    skos:definition "Painters who created art conforming to the official standards and principles of taste of European and American art academies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic painters"@en .

aat:300420018 a skos:Concept ;
    skos:definition "Sculptors who created art conforming to the official standards and principles of taste of European and American art academies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic sculptors"@en .

aat:300420019 a skos:Concept ;
    skos:definition "Printmakers who created art conforming to the official standards and principles of taste of European and American art academies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic printmakers"@en .

aat:300420020 a skos:Concept ;
    skos:definition "Those who specialize in making altars, which are elevated platforms or constructions upon which religious sacrifice is offered or other spiritual or religious activities carried out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar makers"@en .

aat:300420021 a skos:Concept ;
    skos:definition "Tools for determining the alcohol content of a solution of alcohol and water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcohol testers"@en .

aat:300420026 a skos:Concept ;
    skos:definition "Visual signaling devices used primarily in military applications, and most particularly between ships in close range. These constitute a bright, focused lamp that incorporates the ability to create intermittent bursts of light. These were used to transmit coded messages without the use of radio to remain undetected by enemies. Named for its inventor A.C.W. Aldis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aldis lamps"@en .

aat:300420029 a skos:Concept ;
    skos:definition "Devices used by bakers to determine the expansize properties of gluten in flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aleurometers"@en .

aat:300420032 a skos:Concept ;
    skos:definition "Pivoted sighting devices or pointers that can be aligned against a circular scale of degrees and is typically a component of an astrolabe, plane table, or similar instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alidades"@en .

aat:300420042 a skos:Concept ;
    skos:definition "Containers of various sizes and designs built to gather donations for charity or for religious organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alms boxes"@en .

aat:300420055 a skos:Concept ;
    skos:definition "Chairs used in religious settings; examples include chairs built to hold spirit houses and small altars or bishop’s chairs used in Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar chairs"@en .

aat:300420064 a skos:Concept ;
    skos:definition "Brass instruments in the saxophone family with a range that are analogous to the alto voice, and are tuned to E flat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alto saxophones"@en .

aat:300420067 a skos:Concept ;
    skos:definition "Instruments used to transfer amalgam alloy to a tooth cavity; comprising a hollow working end at an angle to the long axis of the instrument through which amalgam is expelled by a plunger mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental amalgam carriers"@en .

aat:300420069 a skos:Concept ;
    skos:definition "Hand instruments with a flat serrated tip or face used for compressing amalgam or gold foil into a tooth cavity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental amalgam condensers"@en .

aat:300420070 a skos:Concept ;
    skos:definition "Cups in which dental compounds are mixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental amalgam cups"@en .

aat:300420075 a skos:Concept ;
    skos:definition "Machines or devices used to mix components for a dental amalgam, which is a mixture of mercury with silver, tin, copper, and other trace metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental amalgamators"@en .

aat:300420082 a skos:Concept ;
    skos:definition "Early devices, originally invented by Ferdinand Carre in 1860, which created a limited amount of ice based on ammonia’s affinity for water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonia absorption apparatuses"@en .

aat:300420084 a skos:Concept ;
    skos:definition "Instruments designed to measure the percentage of ammonia in an aqueous solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammoniameters"@en .

aat:300420098 a skos:Concept ;
    skos:definition "Structural devices that are lightweight carriers into which a subcaliber projectile is centered to permit firing the projectile in a larger caliber weapon. The sabot fills the bore of the weapon from which the projectile is fired and is normally discarded a short distance from the muzzle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabots"@en .

aat:300420104 a skos:Concept ;
    skos:definition "In medicine, hermetically sealed, small, bulbous glass vessels used to hold a solution, such as for especially hypodermic injection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ampules"@en .

aat:300420111 a skos:Concept ;
    skos:definition "Vehicles or structures that comprise or are part of amusement rides, usually constructed to contain the rider."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amusement ride vehicles"@en .

aat:300420115 a skos:Concept ;
    skos:definition "Computers that perform computations by manipulating certain continuous physical variables (such as time and voltage) that are analogs of the quantities being subjected to computations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analog computers"@en .

aat:300420117 a skos:Concept ;
    skos:definition "Data processors that operate on continuously variable data rather than digital input."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analog data processors"@en .

aat:300420120 a skos:Concept ;
    skos:definition "Devices, dating from the 19th century, that were used in place of dissecting knives; operators would breathe into the blowpipes to inflate and scrutinize parts. The pipes were outfitted with valves that would prevent the backflow of unwanted air or bacteria into the pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anatomical blowpipes"@en .

aat:300420152 a skos:Concept ;
    skos:definition "Blankets made or used for covering horses, dogs, or other animals"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal blankets"@en .

aat:300420160 a skos:Concept ;
    skos:definition "Spaces or pieces of land surrounded by a fence, wall or other barrier, used for restraining or displaying animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal enclosures"@en .

aat:300420186 a skos:Concept ;
    skos:definition "Biospecimens that are taken from humans or animals, that are used for research or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal specimens"@en .

aat:300420207 a skos:Concept ;
    skos:definition "Devices for heating or thermostatically controlling wax, foil, or other metals or alloys, in order to increase ductility, decrease hardness, or otherwise treat the material for dental use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental annealers"@en .

aat:300420208 a skos:Concept ;
    skos:definition "Furnaces used to apply heat to change a material’s strength and hardness, relieve internal stresses, and provide increased ductility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annealing furnaces"@en .

aat:300420209 a skos:Concept ;
    skos:definition "Pieces of formal stationery designed to announce a date marking a notable event, such as a marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anniversary announcements"@en .

aat:300420215 a skos:Concept ;
    skos:definition "Bells, especially those used in hotels and attached to signal boards, that ring when attendance is needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annunciator bells"@en .

aat:300420233 a skos:Concept ;
    skos:definition "Instruments designed to measure carbonic acid in a mixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthrocometers"@en .

aat:300420237 a skos:Concept ;
    skos:definition "Antidrag wires oppose the drag wires running from an inboard aft location on an aircraft to an outboard forward point in its bay. These anti-drag wires oppose forces in the reverse to the direction of flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antidrag wires"@en .

aat:300420239 a skos:Concept ;
    skos:definition "Wires in the plane of the outer cover of an aircraft for locally reinforcing this cover in that part of the airship and reducing fluttering in flight die to air pressure or other factors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiflutter wires"@en .

aat:300420241 a skos:Concept ;
    skos:definition "Self-propelled long-distance weapons that are directed either by remote control or automatically, to detonate like devices in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimissile missiles"@en .

aat:300420263 a skos:Concept ;
    skos:definition "Wooden paddles used to stir apple butter to ensure proper consistency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apple butter paddles"@en .

aat:300420264 a skos:Concept ;
    skos:definition "Utensils of varied design for agitating cooking apples in the process of making apple butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apple butter stirrers"@en .

aat:300420265 a skos:Concept ;
    skos:definition "Mills used to grind apples for the making of cider."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apple mills"@en .

aat:300420266 a skos:Concept ;
    skos:definition "Devices used for roasting whole apples, typically one to be placed in front of a fire, and comprising a tin frame, shelf, and reflective canopy to heat the side of the apples not facing the fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apple roasters"@en .

aat:300420267 a skos:Concept ;
    skos:definition "Devices used to sort apples by weight, shape, or color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apple sorters"@en .

aat:300420275 a skos:Concept ;
    skos:definition "Used for measuring moisture content in solid materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquameters"@en .

aat:300420287 a skos:Concept ;
    skos:definition "Screw-shaped surfaces mounted inside a pipe, used for raising water. These are among the earliest form of hydraulic machine used for lifting water from a low-lying body of water onto another surface, often for irrigation. In a contemporary context, Archimedean screw pumps are widely used in wastewater treatment plants and for dewatering low-lying regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archimedean screws"@en .

aat:300420298 a skos:Concept ;
    skos:definition "Instruments used to draw the arc of a circle without using a central point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcographs"@en .

aat:300420305 a skos:Concept ;
    skos:definition "Instruments that measure the amount of silver salt in a solution by means of finding the specific gravity or by photoelectrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argentometers"@en .

aat:300420320 a skos:Concept ;
    skos:definition "In the context of the modern military, projectile containers that hold an explosive for the makeup of bombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armament shells"@en .

aat:300420324 a skos:Concept ;
    skos:definition "Tools, equipment, and supplies originally created to be used for hunting, target-shooting, warfare, or self-protection. This class includes firearms, artillery, bladed weapons, and striking weapons. It does not include structures designed for housing troops or supplies and objects designed for transporting troops or supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armaments"@en .

aat:300420339 a skos:Concept ;
    skos:definition "Protective armoured plates inserted into a carrier or bulletproof vest, that can be used stand-alone, or in conjunction with other armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor plates"@en .

aat:300420362 a skos:Concept ;
    skos:definition "Paper or paper-like diagnostic tool used in dentistry to highlight occlusal contacts and the distribution of occlusal forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental articulating paper"@en .

aat:300420369 a skos:Concept ;
    skos:definition "Three-dimensional constructed objects that are meant to mimic various fruits. Often made of glass, plaster, or clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial fruit"@en .

aat:300420370 a skos:Concept ;
    skos:definition "Devices contructed by by human skill, in imitation of or substitute for the terminal part of the human arm beyond the wrist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial hands"@en .

aat:300420371 a skos:Concept ;
    skos:definition "Gyroscopic flight instruments designed to indicate the spacial attitude of aircraft in respect to the true horizon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial horizons"@en .

aat:300420375 a skos:Concept ;
    skos:definition "Three-dimensional constructed objects made to mimic the appearance of plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial plants"@en .

aat:300420393 a skos:Concept ;
    skos:definition "Large containers, made of wood or other durable material, used by traveling painters to store essential supplies such as palletes, brushes, pallete knives, and tubes of paint. Often fitted with many compartments and drawers of various sizes for organizing tools, and partioned off at one end to accomodate long-handled brushes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist's boxes"@en .

aat:300420401 a skos:Concept ;
    skos:definition "Metal implements comprised of a long handle culminating in a blade or scoop for the removal of ash from fireplaces or wood stoves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ash scrapers"@en .

aat:300420414 a skos:Concept ;
    skos:definition "Shingle material comprising asphalt, which is a bituminous substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphalt shingle"@en .

aat:300420417 a skos:Concept ;
    skos:definition "Accessories for machinery comprised of a blade that smooths, guides and spreads asphalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphalt spreaders"@en .

aat:300420431 a skos:Concept ;
    skos:definition "Astronomical instruments invented by M. Weighelius, a mathematics professor at the University of Jena in Upper Saxony in the 17th century, which allowed multiple people to view the same telescopic image at the same time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrodictums"@en .

aat:300420435 a skos:Concept ;
    skos:definition "Generally, instruments used for measuring the specifics of celestial bodies, such as diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrometers"@en .

aat:300420438 a skos:Concept ;
    skos:definition "Containers that are used to protect and transport astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical instrument cases"@en .

aat:300420439 a skos:Concept ;
    skos:definition "Mirrors used in the place of lenses in astronomical instruments; they may be large, they do not absorb radiation, and are often aspheric to reduce aberrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical mirrors"@en .

aat:300420440 a skos:Concept ;
    skos:definition "Quadrants used to measure the angles of celestial bodies from their zeniths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical quadrants"@en .

aat:300420443 a skos:Concept ;
    skos:definition "Telescopes specifically used for viewing celestial bodies (such as stars, planets, and the sun), as well as the universe and phenomena beyond the earth's atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical telescopes"@en .

aat:300420444 a skos:Concept ;
    skos:definition "Instruments used to measure the luminance of stars when compared with standard, artificial stars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astropatrotometers"@en .

aat:300420445 a skos:Concept ;
    skos:definition "Historically, instruments with two inscribed cones used for observing the stars. In contemporary use, the term may refer to any astronomical telescope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astroscopes"@en .

aat:300420451 a skos:Concept ;
    skos:definition "Instruments for effecting the partial separation of gases or vapours of unequal diffusibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmolysers"@en .

aat:300420460 a skos:Concept ;
    skos:definition "Amplifiers that increase the power levels of audio equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio power amplifiers"@en .

aat:300420463 a skos:Concept ;
    skos:definition "Devices that are designed to record onto read-only compact discs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compact disc recorders"@en .

aat:300420464 a skos:Concept ;
    skos:definition "Containers used for the protection and transport of audio equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio equipment cases"@en .

aat:300420466 a skos:Concept ;
    skos:definition "Devices that mask audio frequencies through a variety of means, usually by outputting frequencies that mimic the tones intended to be obscured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio maskers"@en .

aat:300420468 a skos:Concept ;
    skos:definition "Devices that are designed to receive two or more separate audio signals from sources such as microphones or instruments, and combine them into one output."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixers"@en .

aat:300420469 a skos:Concept ;
    skos:definition "Electronic devices for generating oscillatory electric currents, or for generating electromagnetic waves by means of such currents, particularly in the audible frequency range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio oscillators"@en .

aat:300420470 a skos:Concept ;
    skos:definition "Devices that play audio, whether on removeable media or integral drives that hold digital information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio players"@en .

aat:300420473 a skos:Concept ;
    skos:definition "Sets of pouches, sleeves, or other protective wraps bound together for the storage of sound recordings: most commonly laquer or vinyl discs, and sometimes magnetic tapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio recording albums"@en .

aat:300420474 a skos:Concept ;
    skos:definition "Containers used for the transport and protection of audio recordings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio recording cases"@en .

aat:300420479 a skos:Concept ;
    skos:definition "Devices that can erase audiotape for re-use, often with the ability to erase tape in bulk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio tape erasers"@en .

aat:300420481 a skos:Concept ;
    skos:definition "Devices that record sound onto thin, magnetized wire, and can later reproduce those recordings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire recorders"@en .

aat:300420483 a skos:Concept ;
    skos:definition "Devices that specifically play back tape housed in cassettes, and do not have a record function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiocassette players"@en .

aat:300420484 a skos:Concept ;
    skos:definition "Magnetic tape recorders that use tape wound on spools housed in cassettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiocassette recorders"@en .

aat:300420487 a skos:Concept ;
    skos:definition "Sets of pouches, sleeves, or other protective wraps bound together for the storage of sound recordings in the form of magnetic tapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiotape albums"@en .

aat:300420488 a skos:Concept ;
    skos:definition "Containers used for the transport and protection of audiotape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiotape cases"@en .

aat:300420491 a skos:Concept ;
    skos:definition "Conveyor devices that use a screw or auger mechanism to move grain or similar materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auger elevators"@en .

aat:300420516 a skos:Concept ;
    skos:definition "Instruments that measure rates of plant growth; they consist of levers with two arms (long and short), which are attached to plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxanometers"@en .

aat:300420523 a skos:Concept ;
    skos:definition "Documents or objects conferred as a reward for merit. These are normally of symbolic or commemorative value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awards"@en .

aat:300420524 a skos:Concept ;
    skos:definition "Pieces of printed matter that formally declare the bestowal of a symbol of merit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "award announcements"@en .

aat:300420525 a skos:Concept ;
    skos:definition "Ornaments given to commemorate events or as a reward for merit, taking the shape of a designed element attached to a pin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "award pins"@en .

aat:300420526 a skos:Concept ;
    skos:definition "Ornamental tablets bestowed to an individual or group as a token of achievement. These are usually inscribed with details of the award."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "award plaques"@en .

aat:300420541 a skos:Concept ;
    skos:definition "Instruments used in conjunction with compasses to take bearings of distant objects, such as the sun, stars, or celestial bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azimuth instruments"@en .

aat:300420542 a skos:Concept ;
    skos:definition "Devices that measure and compute the amount of acid in milk which is calculated by pouring alkali of a known strength into a measured sample of milk until the color of the milk changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "babcock testers"@en .

aat:300420556 a skos:Concept ;
    skos:definition "Automated open-width devices specifically designed to apply a finishing solution or material coating to the backside of a fabric, enhancing its appearance, functionality, and/or stability. As variants of the padding machine, these devices include large rollers that treat wet fabric in batches using a roller coating technique, and are typically utilized for continuous fabric processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backfilling machines"@en .

aat:300420557 a skos:Concept ;
    skos:definition "Sets for the game known as Backgammon, including the game board, along with the pieces for each player, and dice. These are often stored in a folding case that forms the board itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backgammon sets"@en .

aat:300420575 a skos:Concept ;
    skos:definition "Bookbinding machines that apply a coating of glue to the back of the book, and additional adhesives to the strips either over the entire surface, the center portion to secure the back of the book, or over the edges which are to be secured to the end papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backstripping machines"@en .

aat:300420578 a skos:Concept ;
    skos:definition "Handheld tools that end in small, wire loops. These tools are sterilized, then used to streak bacterial samples in Petri dishes, or to transfer microorganisms between test tubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inoculation loops"@en .

aat:300420579 a skos:Concept ;
    skos:definition "Instruments, dating from the late 19th century, used for the examination of microscopic bacteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bacterioscopes"@en .

aat:300420586 a skos:Concept ;
    skos:definition "Machines that automatically close bags or sacks, typically of animal feed, seed, or fertilizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bag closing machines"@en .

aat:300420589 a skos:Concept ;
    skos:definition "Auxiliary stands or supports for holding a bag or sack upright and open, to facilitate filling with any material such as grain, or laundry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bag holders"@en .

aat:300420590 a skos:Concept ;
    skos:definition "Machines that close bags, typically of grain and flour, by means of sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bag sewing machines"@en .

aat:300420591 a skos:Concept ;
    skos:definition "Machines, into which bags or sacks are fed, typically consisting of a throat for receiving the upper end of the bag, and additional devices for bunching, tying, and releasing the bag from the machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bag tying machines"@en .

aat:300420629 a skos:Concept ;
    skos:definition "Automated machines, typically comprising various lattices and rollers, used to separate and loosen the fibres of raw cotton bales before they are mixed into yarn, cloth, or other usable fabric. After being manually fed through the machine's conveyors, the bales encounter multiple sets of rapidly rotating rollers which reduce them to a more malleable state for mixing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bale breakers"@en .

aat:300420630 a skos:Concept ;
    skos:definition "Devices for conveying bales of hay or other bales into a loft or barn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bale elevators"@en .

aat:300420638 a skos:Concept ;
    skos:definition "Molds that measure or verifies the diameter of bullets or the size of bullets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball molds"@en .

aat:300420639 a skos:Concept ;
    skos:definition "Pools, usually lined with soft padding, filled with small balls. Common feature at playgrounds or childrens' activity centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball pits"@en .

aat:300420645 a skos:Concept ;
    skos:definition "Mechanized devices, comprising a system of automated pullies and carrier rolls, used to wind strings of yarn into tight balls. These machines are built in various sizes depending on the desired size of the yarn ball, and are often arranged with a double screw to produce two yarn balls simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballers"@en .

aat:300420646 a skos:Concept ;
    skos:definition "Conventional costumes worn by ballerinas, composed of fine tarlatan or other light-weight materials that often expose the dancers' knees. Traditionally consists of a tutu, bodice, basque or peplum, and waistband."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballet dresses"@en .

aat:300420652 a skos:Concept ;
    skos:definition "Long-distance self-propelled weapons that deliver explosive materials to a target. These are rocket-powered only in the initial phase of flight, then follow an unpowered trajectory that arcs upward before descending to a target. Ballistic missiles can carry either nuclear or conventional warheads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballistic missiles"@en .

aat:300420658 a skos:Concept ;
    skos:definition "Containers used to collect voting ballots. Often made of cloth, plastic, or other flexible material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballot bags"@en .

aat:300420661 a skos:Concept ;
    skos:definition "Containers used to collect voting ballots, made of any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballot containers"@en .

aat:300420676 a skos:Concept ;
    skos:definition "Loud pipe organs that were created to imitate the sound of a live band, including percussion instruments. Often used in the context of carousels and fairgrounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "band organs"@en .

aat:300420690 a skos:Concept ;
    skos:definition "Equipment used to apply loops of material around paper or other printed materials to hold them together. Materials used range from metal to plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banding machines"@en .

aat:300420698 a skos:Concept ;
    skos:definition "Large wagons, often built high for visibility, and sometimes ornate, that are capable of carrying a band of musicians in a procession, such as in a circus parade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandwagons"@en .

aat:300420721 a skos:Concept ;
    skos:definition "Shallow bowls or dishes used to scoop and pour water over the recipient's head at a baptism. Often in the shape of a sea shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal dishes"@en .

aat:300420723 a skos:Concept ;
    skos:definition "Clothing worn by participants in baptismal ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal garments"@en .

aat:300420725 a skos:Concept ;
    skos:definition "Coats worn by infant participants in baptismal ceremonies. Usually made with white or pastel fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal jackets"@en .

aat:300420726 a skos:Concept ;
    skos:definition "Containers designed to hold liquids used for baptism ceremonies. Vessels vary in shape, size, and decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal vessels"@en .

aat:300420734 a skos:Concept ;
    skos:definition "Forks comprising a long shaft and ending in two prongs, used to turn meat on a barbecue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbecue forks"@en .

aat:300420737 a skos:Concept ;
    skos:definition "Structures made of barbed wire along the limits of a field, park, yard, or other areas, designed to mark boundary lines and control access."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbed wire fences"@en .

aat:300420747 a skos:Concept ;
    skos:definition "Devices used to print barcodes that are then adhered to other items, usually by heat transfer printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barcode printers"@en .

aat:300420755 a skos:Concept ;
    skos:definition "Brass instruments in the saxophone family with a range that roughly analogous to the baritone voice. They have tapered bores, and are single-reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baritone saxophones"@en .

aat:300420778 a skos:Concept ;
    skos:definition "Containers used to hold soldiers' personal effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrack bags"@en .

aat:300420786 a skos:Concept ;
    skos:definition "Machines that automatically fill and pack barrels, typically with grain, feed, or flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel packers"@en .

aat:300420792 a skos:Concept ;
    skos:definition "Lengths of gridded wire used elements of fences or other barriers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrier wire"@en .

aat:300420793 a skos:Concept ;
    skos:definition "Full-length black robes worn as court attire by barristers or advocates in the UK and some Commonwealth countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrister's gowns"@en .

aat:300420794 a skos:Concept ;
    skos:definition "Neckwear consisting of two rectangular pieces of white cloth falling from the collar and tied to the back of the neck used by barristers, lawyers, judges or any court officials in the UK or parts of the Commonwealth as part of full court attire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrister's tabs"@en .

aat:300420795 a skos:Concept ;
    skos:definition "Headpieces worn by barristers in the UK and commonwealth countries as part of court attire. These are traditionally made from horsehair and are styled distinctively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrister's wigs"@en .

aat:300420796 a skos:Concept ;
    skos:definition "Long, sleeveless flannel garments for infants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrowcoats"@en .

aat:300420803 a skos:Concept ;
    skos:definition "Fragments of broken earthenware or glassware that were once part of the support of a vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base sherds"@en .

aat:300420826 a skos:Concept ;
    skos:definition "Equipment used for playing the sport of basketball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketball gear"@en .

aat:300420827 a skos:Concept ;
    skos:definition "Horizontal circular metal hoop supporting a net through which players try to throw a ball in the sport of basketball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketball hoops"@en .

aat:300420828 a skos:Concept ;
    skos:definition "Mesh attached to basketball hoops, used to slow the passage of the basketball through it when scoring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketball nets"@en .

aat:300420829 a skos:Concept ;
    skos:definition "Upright standards that support the backboard, hoop, and net used in the sport of basketball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketball poles"@en .

aat:300420830 a skos:Concept ;
    skos:definition "Shoes designed to be worn for optimal play in the sport of basketball. These often reach over the ankle to provide additional support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketball shoes"@en .

aat:300420838 a skos:Concept ;
    skos:definition "Instruments similar in style to standard guitars, with four strings that generally mimic the attributes of the acoustic double bass. Bass guitars are usually amplified and solid-bodied, although hollow-bodied versions exist (as well as five- and six-stringed versions). The instrument became widely recognized when the Fender company in 1951 produced the “Fender Bass” for the mass market. The electric bass guitar has since become widely used among jazz and rock-and-roll ensembles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bass guitars"@en .

aat:300420852 a skos:Concept ;
    skos:definition "Machines designed to help align sheets in preparation for cutting, punching, drilling, or binding. They are also used for aligning checks, mailers and invoices for folding and inserting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batcher-jogger machines"@en .

aat:300420854 a skos:Concept ;
    skos:definition "Devices, often used in microbiology and medicine, that keep containers of specimens or solutions in a temperature regulated environment, either immersed in water, or held above water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baths"@en .

aat:300420859 a skos:Concept ;
    skos:definition "Floor coverings for use in a bathroom that prevents accumulation of water on the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bath mats"@en .

aat:300420861 a skos:Concept ;
    skos:definition "Objects designed to fit over the hand that are made of slightly abrasive textile materials, used for the purpose of exfoliation while bathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bath mitts"@en .

aat:300420864 a skos:Concept ;
    skos:definition "Toys for babies and toddlers that are water resistant and used for playing in the bath tub."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bath toys"@en .

aat:300420879 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising a chute, packing belt, vibrating plate, and compression roll, used to compress unprocessed fibers and form them into continuous matted sheets. These machines are designed to produce a consistent weight of fiber material required for subsequent carding processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batt making machines"@en .

aat:300420881 a skos:Concept ;
    skos:definition "Wire whips, typically wide at the top and coming to a rounded point at the bottom, designed to give maximum lift to a batter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batter beaters"@en .

aat:300420882 a skos:Concept ;
    skos:definition "Bowls used to make batter, such as for bread or pancakes, typically deep in form and having a spout and handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batter bowls"@en .

aat:300420883 a skos:Concept ;
    skos:definition "Containers for holding batter, typically made of earthenware and designed to be set near a fire for rising. For containers designed to hold batter for mixing, use \"batter bowls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batter pitchers"@en .

aat:300420910 a skos:Concept ;
    skos:definition "Bulleted breech caps are a variety of .22 caliber rimfire ammunition. The original design of 1845 was a percussion cap without a well-defined head loaded with a .22 caliber ball designed for use in Flobert rifles for low velocity indoor target shooting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BB caps"@en .

aat:300420915 a skos:Concept ;
    skos:definition "Large pieces of woven fabric, often terrycloth, meant to be used at beachside as a mat for laying in the sand and for drying off after swimming. These often come in vibrant colors or patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach towels"@en .

aat:300420923 a skos:Concept ;
    skos:definition "Screens formed by a set of strings threaded with beads, usually hung in a doorway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaded curtains"@en .

aat:300420961 a skos:Concept ;
    skos:definition "Devices used for closing or sealing a bottle, typically made of metal and fitting tightly over the mouth of a glass or plastic bottle, held in place by crimped edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle caps"@en .

aat:300420962 a skos:Concept ;
    skos:definition "Machines, either manually or electrically operated, designed to tightly seal bottles, typically for carbonated beverages such as beer or soft drinks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle cappers"@en .

aat:300420963 a skos:Concept ;
    skos:definition "Devices, hand-held or secured to a work bench, typically consisting of a lever, that when pressed down, firmly inserts a cork into a bottle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle corkers"@en .

aat:300420964 a skos:Concept ;
    skos:definition "Mechanical devices comprising a stationary filling tank and connecting nozzles adapted to receive and discharge liquid into bottles.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle fillers"@en .

aat:300420966 a skos:Concept ;
    skos:definition "Devices consisting of a wire hook or loop suspended from a knob, turned by a clockwork mechanism encased in a frame, and used to rotate one or more pieces of meat over a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle jacks"@en .

aat:300420968 a skos:Concept ;
    skos:definition "Racks designed to hold a bottle, typically at an angle, and placed on a table for serving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle serving racks"@en .

aat:300420969 a skos:Concept ;
    skos:definition "Box-like devices into which bottles are placed and then steamed in order to sterilize them for safe use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle sterilizers"@en .

aat:300420971 a skos:Concept ;
    skos:definition "Racks comprising a frame with compartments for storing bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle storage racks"@en .

aat:300420972 a skos:Concept ;
    skos:definition "Box-like devices used to warm bottles, typically for baby food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle warmers"@en .

aat:300420973 a skos:Concept ;
    skos:definition "Automatic machines, typically in the form of an assembly line, that fill, cap, and label bottles for distribution, sale, and, use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottling machines"@en .

aat:300420986 a skos:Concept ;
    skos:definition "Fixtures that mark points along boundaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boundary markers"@en .

aat:300421006 a skos:Concept ;
    skos:definition "Gameset containing skittles and balls for bowling. Dimensions and materials vary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowling games"@en .

aat:300421015 a skos:Concept ;
    skos:definition "Rosin intended for rubbing on the strings of musical instruments, such as violins, which would produce little to no sound without its application. Stickier, darker rosins are preferable for cellos and basses, while gold and amber rosins are preferred for violins and violas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowstring rosin"@en .

aat:300421034 a skos:Concept ;
    skos:definition "Padded coverings for the hands of boxers in the form of gloves with a single undivided section for the fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxing gloves"@en .

aat:300421046 a skos:Concept ;
    skos:definition "Mechanized devices designed to interweave three or more strands of yarn, wire, or other material to create complex braided structures such as rope, reinforced hose, power cords, and lace. While these devices can take many forms, they commonly comprise a central column and/or rotating disk around which carriers and bobbins are arranged. The device's carriers and bobbins move in a circular pattern, interlacing the strands of material. Though commonly used in the textile industry, these devices have various additional applications in the medical, aerospace, automotive, and electronics industries, amongst others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braiding machines"@en .

aat:300421047 a skos:Concept ;
    skos:definition "Leather thongs used to restrain the wings of birds to prevent them from bating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brails"@en .

aat:300421049 a skos:Concept ;
    skos:definition "Devices that are capable of stamping raised braille alphabet figures onto paper or other supports for use by people who are blind or visually impaired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braille embossers"@en .

aat:300421050 a skos:Concept ;
    skos:definition "Tablets with two distinct sides joined by hinges, variously made of plastic or metal. One side holds paper and the other contains shallow holes that form the basic six dots of a braille cell. Individuals use a stylus to poke the paper to form raised braille text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braille slates"@en .

aat:300421052 a skos:Concept ;
    skos:definition "Devices for removing, by means of agitators and sieves, the flour that may cling to bran after it has passed the bolting-mill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bran dusters"@en .

aat:300421053 a skos:Concept ;
    skos:definition "Grinders used to mill and process bran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bran grinders"@en .

aat:300421067 a skos:Concept ;
    skos:definition "Napkins used in bread baskets to keep bread or rolls warm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread basket napkins"@en .

aat:300421069 a skos:Concept ;
    skos:definition "Casks used aboard ships, designed specifically to store bread during long ocean voyages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread casks"@en .

aat:300421095 a skos:Concept ;
    skos:definition "Storage vessels in which oxygen is kept under pressure in a gas cylinder. These are used for a variety of purposes in medical or exploratory contexts such as mountain climbing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxygen tanks"@en .

aat:300421100 a skos:Concept ;
    skos:definition "Artillery having its rifling in the barrel and is loaded from the breech at the rear of the gun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breech-loading artillery"@en .

aat:300421119 a skos:Concept ;
    skos:definition "Drinking vessels used primarily in wedding ceremonies; may contain liquid, plant matter, or foodstuffs based on the protocol being observed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brides' cups"@en .

aat:300421122 a skos:Concept ;
    skos:definition "Garments worn by wedding participants invited by the bride, generally consisting of a bodice and skirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridesmaid dresses"@en .

aat:300421136 a skos:Concept ;
    skos:definition "Handles or holders used to hold a fine, tapered metal instrument applied in endodontic treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental broach holders"@en .

aat:300421149 a skos:Concept ;
    skos:definition "Poultry houses where broilers are raised, which are chickens raised for meat rather than for egg-laying. In large commercial facilities, the birds are often raised in close confinement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broiler houses"@en .

aat:300421152 a skos:Concept ;
    skos:definition "Hair or bristle brushes used to apply ink to the tanned gelatin in the matrix or print in the bromoil process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bromoil brushes"@en .

aat:300421166 a skos:Concept ;
    skos:definition "Software programs used to access and interact with websites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "browsers"@en .

aat:300421168 a skos:Concept ;
    skos:definition "Devices designed to clear unwanted vegetation from a landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brush cutters"@en .

aat:300421169 a skos:Concept ;
    skos:definition "Devices, typically made of clay, wire, stone, or wood, designed to store a plurality of paint brushes and prevent wet brushes from untentionally dripping on or contaminating a painting. Often cylindrical in shape or designed with multiple undulations that secure the brushes in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brush holders"@en .

aat:300421172 a skos:Concept ;
    skos:definition "Machines used to rub rice grains smooth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brush machines"@en .

aat:300421178 a skos:Concept ;
    skos:definition "Short, puffy skirts that flare out from a narrow waistband and taper at the hem. First popularized in the 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bubble skirts"@en .

aat:300421179 a skos:Concept ;
    skos:definition "Toys that can be used to make soap bubbles, either manually or automatically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bubble toys"@en .

aat:300421200 a skos:Concept ;
    skos:definition "Disks of hard felt or other fiber materials meant to be mounted on a revolving driver such as a drill for the purposes of polishing or buffing a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffing wheels"@en .

aat:300421207 a skos:Concept ;
    skos:definition "Mills using buhrstones for grinding grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buhr mills"@en .

aat:300421208 a skos:Concept ;
    skos:definition "Plates, usually metal, fixed to a manufactured item and displaying information about the item. May be used for train locomotives, other vehicles, marine vessels, bridges, other works of engineering, stoves, other appliances, and other things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "builder's plates"@en .

aat:300421221 a skos:Concept ;
    skos:definition "Mechanized devices, equipped with air-jet chambers, used to increase the thickness and volume of yarns or fibers, thus creating air spaces in the fibers for increased abosrbancy, ventilation, warmth, and softness. To initiate the air entanglement process, of which these devices are a primary example, yarns or fibres are fed through machine guides and over feed rollers into the air-jet chambers, where they are subsequently entrapped and subjected to air at high pressures. The air movement causes the fibers to interlock and tangle, increasing the thickness of the fibers or yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulking machines"@en .

aat:300421239 a skos:Concept ;
    skos:definition "Handheld megaphones that contain combined microphones and loudspeakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullhorns"@en .

aat:300421244 a skos:Concept ;
    skos:definition "Small electrically-powered vehicles, usually brightly colored, with rubber padding on all sides. Amusement park attraction; riders maneuver their vehicle to either bump other riders or avoid them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bumper cars"@en .

aat:300421263 a skos:Concept ;
    skos:definition "General term for baskets made by Native North Americans across the United States used to carry personal items or foodstuffs. Made of varying woven plant fibers and come in variable shapes and sizes. Examples include baskets made by Apache women notable for attached hanging decorations or white oak baskets and tumplines made by Cherokee women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burden baskets"@en .

aat:300421264 a skos:Concept ;
    skos:definition "Lengths of narrow textile materials used to cover the tops of bureaus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureau scarves"@en .

aat:300421273 a skos:Concept ;
    skos:definition "Chambers, usually subterranean, containing deceased remains and other related funerary items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial vaults"@en .

aat:300421276 a skos:Concept ;
    skos:definition "Mechanized devices designed to remove knots, loose or long threads, foreign matter, and other defects from the surface of woolen cloth before it is fulled. These devices comprise a feeder that guides open-width and taut fabric into the machine; rotary brushes for removing long threads from the fabric; and a series of hook-like needles that penetrate the fabric, surface knots, and remaining defects for subsequent shearing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burling machines"@en .

aat:300421287 a skos:Concept ;
    skos:definition "Mechanized devices used to measure the burst strength of, or force required to break or rupture, fabric materials. To measure a fabric's burst strength, these devices first utilize clamps to hold fabric samples in place. The devices then subject the samples to hydrostatic pressure via an elastic or rubber diaphragm, which automatically inflates and expands toward the sample thus applying increasing physical stress to the fabric until it ruptures. Typically, both sides of a fabric sample are measured using a burst tester; the results of both sides are averaged to calculate the fabric's overall burst strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burst testers"@en .

aat:300421288 a skos:Concept ;
    skos:definition "Machines that separate continuous feed business forms or stationary (such as checks or currency notes) into single sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bursters"@en .

aat:300421306 a skos:Concept ;
    skos:definition "Undergarments that consist of a stiff structure or a padding whose shape allows it to fit over the breasts. It generally fastens at the back and may occasionally be adjustable at the front. Used to make the breasts appear larger, and to improve the bust line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bust improvers"@en .

aat:300421316 a skos:Concept ;
    skos:definition "Skewers used to hold the carcasses of animals or other such pieces of meat while being butchered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butchering skewers"@en .

aat:300421317 a skos:Concept ;
    skos:definition "Tools used in the process of butchering meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butchering tools"@en .

aat:300421333 a skos:Concept ;
    skos:definition "Machines used to wrap cut portions of butter. For flat-headed wooden devices used to pack butter into storage containers, use \"butter tamps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter packers"@en .

aat:300421334 a skos:Concept ;
    skos:definition "Pairs of wooden paddles, typically grooved or cross-hatched, used to work butter into shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter paddles"@en .

aat:300421336 a skos:Concept ;
    skos:definition "Devices typically made of wood, but also of plastic, equipped with a lever or flat-bottomed stamper, used to press butter into a uniform shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter presses"@en .

aat:300421337 a skos:Concept ;
    skos:definition "Scales used to weigh butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter scales"@en .

aat:300421342 a skos:Concept ;
    skos:definition "Two-edged, scoop-like tools with a long handle, typically made of silver or nickel, inserted into a tub of butter in order to take a sample for tasting or examination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter triers"@en .

aat:300421346 a skos:Concept ;
    skos:definition "Shallow, flat-bottomed, wooden vessels with sloped sides, used to contain the pressed butter for further processing with a butter paddle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter-working bowls"@en .

aat:300421349 a skos:Concept ;
    skos:definition "Mechanized devices, comprising a series of rollers equipped with wavy ridges or protruding knobs called buttons, designed to lessen the stiffness of and soften excess starch in textile materials. Originally designed to increase the pliability of silk goods, these devices can be used to soften many types of stiffened textile materials after they have been exposed to finishing and drying processes. As textile materials are passed through the rollers, friction exerted by the fabric prompts the rollers to rotate and expose the fabric's surface to the protruding buttons. In order to achieve the desired softness and pliability, fabrics can be passed through these devices multiple times if desired; the more a stiffened fabric comes into contact with this device's buttons, the softer the fabric's surface will be."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "button breakers"@en .

aat:300421352 a skos:Concept ;
    skos:definition "Boards made of wood or other materials affixed between buttons and the fabric they are attached to protect the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "button polishing boards"@en .

aat:300421354 a skos:Concept ;
    skos:definition "Small tools, typically operated by hand or as an attachment to sewing machine foot peddles, designed to ensure regular spacing and sizing of manually-applied buttons onto sewn textile materials. These tools are marked with a set of templates and size labels, allowing the user to accurately measure both the distance between and size of the buttonholes according to desired specifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttonhole guides"@en .

aat:300421392 a skos:Concept ;
    skos:definition "Trays, typically made of metal or plastic, designed to hold food, service utensils, and vessels while dining in a cafeteria. Also, compartmentalized trays designed to hold individual portions of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cafeteria trays"@en .

aat:300421399 a skos:Concept ;
    skos:definition "Round, square or rectangular containers equipped with a lid, and often handles, and used to store cakes and keep them fresh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake boxes"@en .

aat:300421402 a skos:Concept ;
    skos:definition "Stencils, placed on the top layer of cakes, over which a decorating material, such as powdered sugar or powdered chocolate is sprinkled in order to make a decorative pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake decorating stencils"@en .

aat:300421403 a skos:Concept ;
    skos:definition "Hollow cones of metal or plastic, with smooth or notched tips inserted onto the end of a pastry bag, used to make decorative patterns with icing or frosting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake decorating tips"@en .

aat:300421404 a skos:Concept ;
    skos:definition "Small sculptures used for embellishing baked goods. Variously made of organic (sugar) or inorganic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake decorations"@en .

aat:300421405 a skos:Concept ;
    skos:definition "Dowels, inserted into cakes, used to support their structure in order to build multiple stacked tiers, as in the construction of wedding cakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake dowels"@en .

aat:300421406 a skos:Concept ;
    skos:definition "Utensils designed for eating pastries or other desserts. These normally have three or four tines, sometimes with the leftmost tine being wider to help cut into the pastry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake forks"@en .

aat:300421415 a skos:Concept ;
    skos:definition "Small stick-like devices inserted into a cake during baking in order to determine its doneness, which is determined if the tester comes out clean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake testers"@en .

aat:300421416 a skos:Concept ;
    skos:definition "Wide, sometimes circular- shaped spatulas, typically with an off-set blade, designed to turn or flip cakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake turners"@en .

aat:300421419 a skos:Concept ;
    skos:definition "Machines and devices that perform arithmetical operations, often more complex than can be performed on adding machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calculating machines"@en .

aat:300421420 a skos:Concept ;
    skos:definition "Rods, sometimes marked with numerals, used for making calculations in ancient East Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calculating rods"@en .

aat:300421422 a skos:Concept ;
    skos:definition "Light carriages with low wheels, having a removable folding hood or top. In Canada, a two-wheeled, one-seated vehicle, usually without a cover, with a seat for the driver on the splashboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caleches"@en .

aat:300421435 a skos:Concept ;
    skos:definition "Handheld devices that extrude caulking material from a disposable tube mounted on the gun itself. Squeezing the handle forces material from the tube, usually through a narrow tip on the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caulking guns"@en .

aat:300421437 a skos:Concept ;
    skos:definition "Buttons that cause a corresponding bell to ring, usually used for summoning people or calling elevators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "call buttons"@en .

aat:300421443 a skos:Concept ;
    skos:definition "Whistles that are attached to barrel-operated, steam calliopes. The volume of calliope whistles dictates their pitch. Calliope whistles may also be detached from the instruments, and historically were sometimes placed on trains or ships as steam whistles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calliope whistles"@en .

aat:300421448 a skos:Concept ;
    skos:definition "Snares that catch the feet of animals in hunting or trapping, or in the context of warfare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caltrops"@en .

aat:300421455 a skos:Concept ;
    skos:definition "Auxiliary devices that hold battery cells for use in photography. Typically this refers to historical devices used to power strobes for analog flash photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera battery cases"@en .

aat:300421457 a skos:Concept ;
    skos:definition "Electronic storage media used especially in digital cameras and mobile phones in the form of small, removable flash memory drives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memory cards"@en .

aat:300421459 a skos:Concept ;
    skos:definition "Hard-sided cases usually equipped with handles or straps, and that most often incorporate interior compartments for storing and transporting cameras. For similar soft-sided containers use camera bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera cases"@en .

aat:300421461 a skos:Concept ;
    skos:definition "Devices used in conjunction with photographic cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera equipment"@en .

aat:300421462 a skos:Concept ;
    skos:definition "Filters that are attached to camera lenses to correct for the quality of ambient light or for other artistic purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera filters"@en .

aat:300421465 a skos:Concept ;
    skos:definition "Devices used to mount cameras to keep them steady during exposure, having a single pole or foot, usually extendable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera monopods"@en .

aat:300421474 a skos:Concept ;
    skos:definition "Promotional objects issued during the course of an electoral campaign that promote a cause or individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign badges"@en .

aat:300421475 a skos:Concept ;
    skos:definition "Promotional objects issued during the course of an electoral campaign that promote a cause or individual. These are designed to be affixed to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign buttons"@en .

aat:300421480 a skos:Concept ;
    skos:definition "Devices used to sort coffee and food beans by color into quality grades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bean sorters"@en .

aat:300421481 a skos:Concept ;
    skos:definition "Small bags filled with beans, used especially in children's games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beanbags"@en .

aat:300421485 a skos:Concept ;
    skos:definition "Traps designed to catch wild animals, originally bears, with a distinctive pair of metal jaws with jagged teeth, which snap shut around the leg when a trigger is stepped on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bear traps"@en .

aat:300421486 a skos:Concept ;
    skos:definition "Manually or electrically operated devices with small overlapping teeth that can cut hair very close to the skin to shape beard growth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beard trimmers"@en .

aat:300421497 a skos:Concept ;
    skos:definition "Coverings for mattresses that are intended to protect it from moisture or pests, and that remain under the fitted sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed casings"@en .

aat:300421501 a skos:Concept ;
    skos:definition "Strips of textile or other material that hold bed curtains out of the way when they are not needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed curtain tiebacks"@en .

aat:300421503 a skos:Concept ;
    skos:definition "Textile covers intended to be draped or fastened to headboards or the beadsted at the head of the bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed headcloths"@en .

aat:300421505 a skos:Concept ;
    skos:definition "Protective coverings on which a mattress or bedroll can be laid, for protection or comfort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed mats"@en .

aat:300421517 a skos:Concept ;
    skos:definition "Fasteners that hold bedsheets or covers in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedding clips"@en .

aat:300421532 a skos:Concept ;
    skos:definition "Devices used by beekeepers for driving smoke into a hive to stupefy the bees while the honeycomb is being removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bee smokers"@en .

aat:300421537 a skos:Concept ;
    skos:definition "Coolers specifically designed to store beer at the perfect temperature for serving and pouring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer coolers"@en .

aat:300421539 a skos:Concept ;
    skos:definition "Pressurized kegs, made of a wide variety of materials, including wood, plastic, and aluminum, and now made predominantly of stainless steel, used for storing, transporting, and dispensing beer. Although standard beer kegs featured the curved sides mimicking barrel staves, most contemporary beer kegs are straight-sided cylindrical containers.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer kegs"@en .

aat:300421541 a skos:Concept ;
    skos:definition "Valves used for controlling the flow of beer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer taps"@en .

aat:300421544 a skos:Concept ;
    skos:definition "High-speed mechanized devices used to tighten the weave of linen materials and produce the fabrics' characteristic sheen and lustre. These devices are comprised of a heavy frame supporting a large quantity of hardwood faller stamps, metalweights, mallets, or hammers that are operated by cams attached to a horizontal shaft. The linen is typically dampened then wound on an iron cylinder directly beneath the hammering devices, which rapidly pound the fabric to prepare it for washing, calendising, and/or dyeing. These devices constitute the last major step in the linen manufacture process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beetle machines"@en .

aat:300421547 a skos:Concept ;
    skos:definition "Personal objects, usually worn or carried, that express an individual's thoughts, opinions, convictions, allegiances, interests, or attitudes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belief symbols"@en .

aat:300421552 a skos:Concept ;
    skos:definition "Circular-shaped skirts that are slightly gathered or pleated at the waistline and often supported with crinoline petticoats to maintain their flared shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell skirts"@en .

aat:300421558 a skos:Concept ;
    skos:definition "Frames for the support of an instrument constructed to furnish a strong blast of air for stoking fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellows stands"@en .

aat:300421565 a skos:Concept ;
    skos:definition "Containers or pouches for the storage and organization of belts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt caddies"@en .

aat:300421568 a skos:Concept ;
    skos:definition "Primitive devices used to weave narrow, ribbon-like articles such as sashes, belts, garters, and hair bands no wider than 18 inches. Designed to be operated from a seated position on the floor, these devices typically consist of two parallel sticks or rods that support the warp, one being attached to a tree or post and the other to the weaver's belt. The warp is wound in a spiral between the rods and is held taut as the weaver leans against the belt. This is the primary type of weaving device used by the Indigenous peoples of the Americas prior to the mid-17th century, and is still utilized today by the Navajo and Pueblo peoples, amongst others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt looms"@en .

aat:300421569 a skos:Concept ;
    skos:definition "Exercise machines consisting generally of two parts: an elastic or fabric band and a motor to induce vibrations in the band. Built to simulate massaging the body. Invented in the early 20th century, with usage particularly popular in the early to mid-20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt massagers"@en .

aat:300421595 a skos:Concept ;
    skos:definition "Japanese or Japanese-style boxes comprised of individual compartments, and used to store or transport packed meals, typically lunches or a picnic. Named after a Chinese dialect word meaning ‘convenient,’ bento boxes can vary in style and material from the simple to the very ornate, the more decorative type often made of wood or painted lacquer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bento boxes"@en .

aat:300421615 a skos:Concept ;
    skos:definition "Small, hand-operated carts equipped with beverages and other items, such as glasses and napkins, used for serving, most typically on airline flights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beverage carts"@en .

aat:300421616 a skos:Concept ;
    skos:definition "Culinary accessories in the form of charms, placed on a glass, and typically used for personal identification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beverage charms"@en .

aat:300421622 a skos:Concept ;
    skos:definition "Containers in which cocktails or other mixed drinks are blended by shaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beverage shakers"@en .

aat:300421623 a skos:Concept ;
    skos:definition "Strainers that hold back solid materials such as fruit or ice from the liquid, typically used after a drink has been stirred or shaken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocktail strainers"@en .

aat:300421625 a skos:Concept ;
    skos:definition "Electrical devices in the form of a small hot plate, used to warm cups of liquid, and designed to be portable for travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beverage warmers"@en .

aat:300421626 a skos:Concept ;
    skos:definition "Fabric that has been cut on the bias into strips and folded to form a finished edge along a seam. This material is available commercially or may be home-made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bias tape"@en .

aat:300421639 a skos:Concept ;
    skos:definition "Lighting devices designed to be affixed to a bicycle when riding in dark locations. These may be powered by batteries, a dynamo attached to a wheel, or historically by burning fuel in a lantern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicycle lamps"@en .

aat:300421643 a skos:Concept ;
    skos:definition "Tailored costumes, made of durable material such as linen or wool, worn by cyclists predominately in the late 19th century. Typically comprised of a matching set of garments including trousers or a skirt, a short button-up jacket, bloomers, leggings, and a cap,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicycle suits"@en .

aat:300421646 a skos:Concept ;
    skos:definition "Guitars with twelve strings in six courses, most commonly found in acoustic iterations, but also exist as electric guitars. The instrument likely emerged in the last decades of the 19th century and was probably inspired by other double-course instruments, such as the mandolin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "12-string guitars"@en .

aat:300421650 a skos:Concept ;
    skos:definition "Eyeglasses that enable the illusion of depth to be produced by two-dimensional images. These originally used color filters: one red and one blue or green over each eye, corresponding to interlaced images in the same colors, to create the illusion in monochromatic images. Later developments for color film have used polarization techniques to create the effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "3D eyeglasses"@en .

aat:300421667 a skos:Concept ;
    skos:definition "Traditional sash-like pieces of academic costime, typically worn over the gown during a commencement ceremony. These signify the wearer's academic degree and the institution that awarded it, with distinct colors and designs representing varied disciplines and universities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic hoods"@en .

aat:300421668 a skos:Concept ;
    skos:definition "Symbolic and ornamental elements of academic costume worn on a mortarboard, typically made of braided thread that signifies the completion of a degree or academic achievement. Color often reflects a field of study or degree level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic tassels"@en .

aat:300421672 a skos:Concept ;
    skos:definition "Containers built to hold ancillary items for equipment or personal adornment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessory boxes"@en .

aat:300421679 a skos:Concept ;
    skos:definition "Official documents that indicate an award of distinction, such as achieving an academic diploma or an award."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "achievement certificates"@en .

aat:300421681 a skos:Concept ;
    skos:definition "Refracting telescopes that utilize achromatic lenses, which prevent chromatic aberration (inability to focus, and the refracting of light into its constituent colors)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "achromatic telescopes"@en .

aat:300421683 a skos:Concept ;
    skos:definition "Acidmeters, ranging from small hand-held devices to larger stationary devices designed to sit on a work bench, used test the pH levels in cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acidity testers"@en .

aat:300421686 a skos:Concept ;
    skos:definition "Modems that connect to telephone systems and convert digital data into sound signals, which are then transmitted through telephone lines. Historically, for acoustic couplers to connect to telephone systems, telephone handsets would rest in soundproof enclosures which have loudspeakers and microphones that are close to the earpieces and mouthpieces of the phone handsets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustic couplers"@en .

aat:300421687 a skos:Concept ;
    skos:definition "Electronic devices that are specifically attached to acoustic instruments, such as acoustic guitars, to amplify sound vibrations, for passing the signal through to an amplifier or for recording purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustic pickups"@en .

aat:300421691 a skos:Concept ;
    skos:definition "Devices used to measure the acoustic oscillation of the eye to detect and treat glaucoma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustical tonometers"@en .

aat:300421696 a skos:Concept ;
    skos:definition "Books intended for children, which contain interactive content such as games, puzzles, quizzes, pictures to color and other elements that involve writing or drawing in the book itself. Specific types of activity books include colouring books and puzzle books. A book is normally referred to as an activity book if it combines a variety of interactive elements and does not fall into one of these more specific categories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "activity books"@en .

aat:300421700 a skos:Concept ;
    skos:definition "Photographic accessories in the form of circular mounts that allow the attachment of filters, lenses, or other pieces of equipment to a camera body or to a lens itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adapter rings"@en .

aat:300421702 a skos:Concept ;
    skos:definition "Mechanical or electromechanical calculating machines, usually key-operated, used to perform addition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adding machines"@en .

aat:300421703 a skos:Concept ;
    skos:definition "Spools of plastic material used to facilitate the printing process for adding machines, printing calculations on paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adding machine ribbons"@en .

aat:300421711 a skos:Concept ;
    skos:definition "Paper sheets used in adhesive notepads, generally small and square in shape, sometimes brightly colored. Bound to each other by an adhesive on one side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesive note paper"@en .

aat:300421712 a skos:Concept ;
    skos:definition "Bundles of small, square paper held together by an adhesive binding at one side. Used for note-taking or other informal writing; each sheet is pulled off after being written on to be discarded or adhered to another surface. Post-It (R) is a registered trade mark for a commonly used product that exemplifies this concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesive notepads"@en .

aat:300421717 a skos:Concept ;
    skos:definition "Draftperson's triangles that include an adjustable arm to eliminate a need of multiple triangles with fixed angles. A protractor placed between the adjustable arm and the place where it is hinged assesses the angle of the clamped triangle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable triangles"@en .

aat:300421718 a skos:Concept ;
    skos:definition "Pilot-adjustable propellers that may change blade pitch during flight. The blade angle can thus be adjusted to its optimum value for the phase of flight, be it takeoff, climb or cruise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable-pitch propellers"@en .

aat:300421731 a skos:Concept ;
    skos:definition "Mass communication materials or means that call public attention to a product, service, or event and to elicit a specific response, particularly to acquire, use, or participate in the product, service, or event that is being advertised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising media"@en .

aat:300421734 a skos:Concept ;
    skos:definition "Promotional media that appears as a physical object such as a lettered or pictographic display on flat or dimensional structure or board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising signs"@en .

aat:300421738 a skos:Concept ;
    skos:definition "Safety indicators styled as signs or panels marking pipe- or transmission lines and ropeways along flight paths usually on or near an airfield. These carry information, usually numbers, intended to read from the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial marker panels"@en .

aat:300421739 a skos:Concept ;
    skos:definition "Explosive devices designed to be dropped from the air into water or onto land which detonate when activated by something passing over or near it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial mines"@en .

aat:300421741 a skos:Concept ;
    skos:definition "Self-propelled submarine missiles that carry explosives and are launched from a torpedo bomber aircraft into water, where the weapon propels itself to the target."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial torpedoes"@en .

aat:300421744 a skos:Concept ;
    skos:definition "Rectangular boards with low feet used for step aerobic exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerobics steps"@en .

aat:300421747 a skos:Concept ;
    skos:definition "Objects or components originally created as accessories used in the transportation of people or goods above the face of the earth. Included are objects created to be parts of aircraft or spacecraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerospace transportation accessories"@en .

aat:300421766 a skos:Concept ;
    skos:definition "Lights on an aiming post that serve as an aiming point during night survey or in night firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aiming post lights"@en .

aat:300421772 a skos:Concept ;
    skos:definition "Devices or systems that present a user with the impression of operating aircraft, excluding space flight. These create an illusion of manned flight, applications of flight controls, the effects of other aircraft, and environmental factors such as air density, velocity, turbulence, wind, cloud cover, precipitation, for example. These are used for training, aircraft design and research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air flight simulators"@en .

aat:300421780 a skos:Concept ;
    skos:definition "Portable inflatable bladders that are used as temporary bedding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air mattresses"@en .

aat:300421782 a skos:Concept ;
    skos:definition "Portable inflatable bladders that are used as temporary head support while sleeping or resting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air pillows"@en .

aat:300421797 a skos:Concept ;
    skos:definition "Lines that secure aircraft to a mooring point while on the ground in the event of wind or other weather conditions that could threaten the aircraft's stability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft mooring lines"@en .

aat:300421798 a skos:Concept ;
    skos:definition "Mechanical devices with a central hub and radiating blades on aircraft that provide thrust by spinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft propellers"@en .

aat:300421810 a skos:Concept ;
    skos:definition "Terminals that service arriving and departing travelers as well as air freight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airport terminals"@en .

aat:300421812 a skos:Concept ;
    skos:definition "Gauges that measure the forward speed of an aircraft in any of several units, knots being the most common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airspeed indicators"@en .

aat:300421813 a skos:Concept ;
    skos:definition "Explosive devices lacking propulsion of their own that are intended to be launched from an airborne vehicle to hit targets that are also airborne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-to-air bombs"@en .

aat:300421814 a skos:Concept ;
    skos:definition "Self-propelled explosive devices that are intended to be launched from an airborne vehicle to hit targets that are also airborne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-to-air missiles"@en .

aat:300421815 a skos:Concept ;
    skos:definition "Explosive devices lacking propulsion of their own that are intended to be launched from an airborne vehicle to hit targets that are at ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-to-surface bombs"@en .

aat:300421816 a skos:Concept ;
    skos:definition "Self-propelled explosive devices that are launched from aircraft to hit targets that are on ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-to-surface missiles"@en .

aat:300421817 a skos:Concept ;
    skos:definition "Explosive devices that are intended to be launched from an airborne vehicle to hit targets that are in bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-to-underwater bombs"@en .

aat:300421818 a skos:Concept ;
    skos:definition "Self-propelled explosive devices that are intended to be launched from an airborne vehicle to hit targets that beneath bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-to-underwater missiles"@en .

aat:300421819 a skos:Concept ;
    skos:definition "Self-propelled explosive devices that are intended to be launched from an airborne vehicle to hit targets that are on the surface of bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-to-water missiles"@en .

aat:300421822 a skos:Concept ;
    skos:definition "Indicators, often married to sound-making devices, that light as a visual warning or alert as triggered by some stimuli. Often these are red but may appear in any color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alarm lamps"@en .

aat:300421829 a skos:Concept ;
    skos:definition "Cookstoves fueled by alcohol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcohol cookstoves"@en .

aat:300421852 a skos:Concept ;
    skos:definition "Small hard balls used in cue sports, originally made of varied materials including ivory, now made of polyester or resin. These come in a variety of colors and a few sizes determined by the games that they are intented for."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billiard balls"@en .

aat:300421859 a skos:Concept ;
    skos:definition "Machines that perform the mechanical operations involved in creating and providing billing records or invoices, such as calculations, typing, and duplication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billing machines"@en .

aat:300421864 a skos:Concept ;
    skos:definition "Fasteners consisting of two metal levers attached to a spring-like clip. Users press on the levers to widen the gap in the base to attach them to papers or other thin items, then secure the levers to the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binder clips"@en .

aat:300421865 a skos:Concept ;
    skos:definition "Die cut in brass, typically in a design or letters of the alphabet, used by a bookbinder's finisher in lettering book covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binder's die"@en .

aat:300421866 a skos:Concept ;
    skos:definition "Tables used in bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bindery tables"@en .

aat:300421867 a skos:Concept ;
    skos:definition "Strips of protective material that cover the raw borders, seams, or edges of textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binding"@en .

aat:300421868 a skos:Concept ;
    skos:definition "Stiff, strong cardboard used to form the boards that form book covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binder's board"@en .

aat:300421869 a skos:Concept ;
    skos:definition "Machines used in the process of bookbinding, which include those that implement gluing, stamping, ruling, cutting, other functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinder's machines"@en .

aat:300421870 a skos:Concept ;
    skos:definition "Long needles having oval eyes and blunt points, used to sew books together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinding needles"@en .

aat:300421876 a skos:Concept ;
    skos:definition "Multiplayer games where each player has a form or card with numbers. The numbers can be crossed out or indicated when the number drawn by the game master is on this form. There are also variants with colors and figures instead of numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bingo games"@en .

aat:300421879 a skos:Concept ;
    skos:definition "Boxes on the deck of a ship near the helm, in which compasses are kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binnacles"@en .

aat:300421886 a skos:Concept ;
    skos:definition "Devices with chambers and controlled temperatures used for the cultivation of microorganisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological incubators"@en .

aat:300421887 a skos:Concept ;
    skos:definition "Use for biological instruments that lack other descriptive or generic names or if the specific name of the instrument is unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological instruments"@en .

aat:300421888 a skos:Concept ;
    skos:definition "Containers for the protection and transport of biological instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological instrument cases"@en .

aat:300421889 a skos:Concept ;
    skos:definition "Containers used for the protection and transport of biological specimens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological specimen containers"@en .

aat:300421897 a skos:Concept ;
    skos:definition "Samples of material from humans, animals, or plants, that are used for research or storage. Biospecimens may include samples of DNA, RNA, blood, urine, protein, tissue, or cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biospecimens"@en .

aat:300421903 a skos:Concept ;
    skos:definition "Small spits used to roasting birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird spits"@en .

aat:300421917 a skos:Concept ;
    skos:definition "Devices, usually made of rubber, used to maintain the mouth open during prolonged treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bite blocks"@en .

aat:300421919 a skos:Concept ;
    skos:definition "Removable dental appliances that provide a flat biting surface that covers the functional surfaces of the teeth; used to prevent the direct contact of the tooth surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bite plates"@en .

aat:300421920 a skos:Concept ;
    skos:definition "Autoclavable denture rim formers, comprising a specially designed hot plate used to reduce the length of upper and lower bite rims."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bite rim formers"@en .

aat:300421921 a skos:Concept ;
    skos:definition "Posts mounted in pairs on the decks of a ship, for fastening mooring lines, cables, or ropes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitts"@en .

aat:300421938 a skos:Concept ;
    skos:definition "Instruments for measuring the blanching power of chloride of lime and potash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanchimeters"@en .

aat:300421958 a skos:Concept ;
    skos:definition "Mechanized devices used to treat textile substrates with chemical bleaching agents, including chlorine, sodium hypochlorite, and hydrogen peroxide, thus removing any natural coloring matter responsible for diminishing the fabrics' whiteness. Fabrics are first fed through a guide roller and immersed in the bleaching solution by an immersion roller before being squeezed out and, oftentimes, steamed. These devices are typically comprised of three kiers, or vats, into which the substrates are fed and treated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleaching machines"@en .

aat:300421964 a skos:Concept ;
    skos:definition "Feeders designed to dispense a blend of grain, cereals, and poultry feeds, free flowing in any desired proportion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blending feeders"@en .

aat:300421965 a skos:Concept ;
    skos:definition "Groups of mechanized devices, which use a series of rollers to mix various grades of cotton fibers together into a uniform blend."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blending machines"@en .

aat:300421968 a skos:Concept ;
    skos:definition "Brackets, bracket covers, or other hardware used to install blinds"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind fittings"@en .

aat:300422013 a skos:Concept ;
    skos:definition "Machines devised to make diazo prints of technical drawings or other images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blueprint machines"@en .

aat:300422029 a skos:Concept ;
    skos:definition "Documents that confirm that the bearer is authorized to board a commercial conveyance such as passenger aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boarding passes"@en .

aat:300422053 a skos:Concept ;
    skos:definition "Metal frames on which multiple bobbins, or cylindrical spindles for winding yarn or thread, are fitted and wound parallel to one another. These frames often incorporate manual or automated yarn tension devices arranged between each bobbin fixing shaft, which help standardize the yarn's directional path and tension to overcome friction and facilitate subsequent yarn processing and warping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bobbin creels"@en .

aat:300422061 a skos:Concept ;
    skos:definition "Cases, often elaborate or decorative, meant to hold bodkins: needle-like objects used for lacing up garments. Decorative bodkins and bodkin cases were popular personal items in the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodkin cases"@en .

aat:300422065 a skos:Concept ;
    skos:definition "Long oblong cushions used to support the full length of a sleeper's body while lying on their side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body pillows"@en .

aat:300422067 a skos:Concept ;
    skos:definition "Tight-fitting undergarments designed to smooth and shape the body"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body shapers"@en .

aat:300422068 a skos:Concept ;
    skos:definition "Fragments of broken earthenware or glassware that were once part of the body of a vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body sherds"@en .

aat:300422070 a skos:Concept ;
    skos:definition "Short, stiff, boards used for surfing; riders typically lay on top of the board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodyboards"@en .

aat:300422082 a skos:Concept ;
    skos:definition "Small ornaments clipped to bolo ties, both to keep the tie in place around the wearer and as decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolo slides"@en .

aat:300422087 a skos:Concept ;
    skos:definition "Decorative covers for bolsters, often with an added flange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolster shams"@en .

aat:300422099 a skos:Concept ;
    skos:definition "Devices used to suspend and release mines or torpedoes from aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bomb shackles"@en .

aat:300422102 a skos:Concept ;
    skos:definition "Baggy pleated trousers tapered at the shins, common to both gaucho and African traditions. Customarily worn by South American cowboys when carrying out agricultural or other outdoor work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombachas"@en .

aat:300422110 a skos:Concept ;
    skos:definition "Mechanized devices used to bond multiple fabrics together and produce reinforced nonwoven fabric. These devices vary greatly and include stich-bonding machines and seamless bonding machines. The former utilize warp-knitting to stich-bond base materials like yarn layers, non-woven fabrics, or base material webs. The latter use adhesive tape that is heated and melted to bond fabrics together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonding machines"@en .

aat:300422113 a skos:Concept ;
    skos:definition "Culinary machines used to cut up small bones or vegetable matter, used in the preparation of food for poulty and other livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone-cutters"@en .

aat:300422117 a skos:Concept ;
    skos:definition "Tools used to smooth glued surfaces or fold and layer printed material. Made from bone or plastic and comes in two forms; a straight, rectangular tool or a curved tool ending at a point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone folders"@en .

aat:300422125 a skos:Concept ;
    skos:definition "Articles that overlie soft hats of the type usually tied under the chin and having a front brim, with the effect of protecting, enclosing, decorating, or hiding them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonnet covers"@en .

aat:300422128 a skos:Concept ;
    skos:definition "Fasteners attached to books to either hold them closed or for ornamentation. Often made of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book fittings"@en .

aat:300422133 a skos:Concept ;
    skos:definition "Bookbinding machines, typically hydraulic, into which books are fed for the purpose of binding their components together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book smashing machines"@en .

aat:300422134 a skos:Concept ;
    skos:definition "Bookbinding machines equipped with a curved needle adapted to swing in an arc down into and up out of the folded edges of a book for the purpose of stitching books together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book stitching machines"@en .

aat:300422135 a skos:Concept ;
    skos:definition "Machines, equipped with a guilotine-like blade or blades, used to trim the edges of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book trimming machines"@en .

aat:300422136 a skos:Concept ;
    skos:definition "Bookbinding tools used to make holes in the spinefolds of books in order for them to be sewn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinder's bodkins"@en .

aat:300422137 a skos:Concept ;
    skos:definition "Clamps used to hold books in place while being bound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinding clamps"@en .

aat:300422142 a skos:Concept ;
    skos:definition "Wheeled hand-drawn vehicles with built-in shelves that are used to transport books, usually in a library context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookcarts"@en .

aat:300422146 a skos:Concept ;
    skos:definition "Machines, usually key-operated, that provide and keep records of expenditures and receipts, and perform computations and calculations in that context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookkeeping machines"@en .

aat:300422175 a skos:Concept ;
    skos:definition "Pitchers used during the Eucharistic service to contain the sacramental wine, which will be poured into the chalice and consecrated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion pitchers"@en .

aat:300422178 a skos:Concept ;
    skos:definition "Spoons used to dispense the consecrated wine, at the Eucharist or in other dispensations of the communion. Commonly used in Eastern Orthodox Christian ceremonies, and formerly in the Western church as well. The purpose of the spoon was to prevent spillage of the consecrated wine. It is known from ancient times, when methods of sharing the wine included spoon, straw, and tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion spoons"@en .

aat:300422181 a skos:Concept ;
    skos:definition "Containers used for administering materials part of communion ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion vessels"@en .

aat:300422185 a skos:Concept ;
    skos:definition "Cases that are used to protect or transport compact discs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compact disc cases"@en .

aat:300422188 a skos:Concept ;
    skos:definition "Analog devices used to compare different transcriptions of the same information to verify the accuracy of the data, to verify arithmetic functions, or to verify storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comparators"@en .

aat:300422200 a skos:Concept ;
    skos:definition "Notebooks commonly used in educational contexts. These normally come in a standardized format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition books"@en .

aat:300422210 a skos:Concept ;
    skos:definition "Cases that are used to protect and transport computer equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer equipment cases"@en .

aat:300422217 a skos:Concept ;
    skos:definition "Anvils having a concave work surface. Examples are anvils used in laying out, chasing, or flattening wire, or to support eyelets and rivets when being set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concave anvils"@en .

aat:300422222 a skos:Concept ;
    skos:definition "Circular, silver ornaments applied to belts, riding tack, jewelry, and clothing; often decorated with stamped inlay and semi-precious stones such as turquoise. Originated in the mid-1800s amongst Navajo (Diné) and Pueblo silversmiths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conchos"@en .

aat:300422223 a skos:Concept ;
    skos:definition "Instruments used to measure shells and the angles of their spires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conchometers"@en .

aat:300422233 a skos:Concept ;
    skos:definition "Perforated cylinders that utilize a pneumatic conveying process to extract airborne fibers, such as dust and dirt, from cotton lint and other non-woven fabrics. Also used to compress a web of fibers into long strips of parallel fibers, thus converting the web to a sliver or roving. These devices generally contain two chambers in between which is a spinning barrel. The flow of material and air enters the vacuum chamber, which is then pushed to the next chamber by the barrel at atmospheric pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condensers"@en .

aat:300422245 a skos:Concept ;
    skos:definition "Devices designed to wrap loose yarn onto a cylindrical or conical bobbin in preparation for weaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cone winders"@en .

aat:300422251 a skos:Concept ;
    skos:definition "Small pieces of paper, usually multicolored and sometimes cut in various shapes, ceremonially thrown at various events, such as weddings or parades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confetti"@en .

aat:300422253 a skos:Concept ;
    skos:definition "Garments worn by young girls during confirmation ceremonies performed in various Christian faiths. Often white or lightly-hued fabrics are used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confirmation dresses"@en .

aat:300422255 a skos:Concept ;
    skos:definition "Devices that take conformations of things, especially human heads for hat-fitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conformateurs"@en .

aat:300422256 a skos:Concept ;
    skos:definition "Greeting cards that offer an expression in a complimentary way gratification at their success, fortune, or happiness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "congratulatory cards"@en .

aat:300422261 a skos:Concept ;
    skos:definition "Instruments used by draftsmen to render cone shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conographs"@en .

aat:300422263 a skos:Concept ;
    skos:definition "Phonographs that are designed to fit inside a specially designed cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "console phonographs"@en .

aat:300422277 a skos:Concept ;
    skos:definition "Circular, lidded containers made to hold contact lenses, often made of plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contact lens cases"@en .

aat:300422290 a skos:Concept ;
    skos:definition "Pliers used to enhance crown form contours to improve gingival margins, customizing orthodontic bands, or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental contouring pliers"@en .

aat:300422295 a skos:Concept ;
    skos:definition "Panties that offer body-shaping and smoothing benefits resulting from elasticated material, aside from being worn as standard underwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "control panties"@en .

aat:300422297 a skos:Concept ;
    skos:definition "High-impact ammunition designed to stay in one piece on contact expanding about 1.5X to 2X caliber. The limited expansion reduces area friction, intended for use in hunting large game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "controlled expansion bullets"@en .

aat:300422301 a skos:Concept ;
    skos:definition "Ovens having a fan that circulates hot air uniformly and continuously around."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convection ovens"@en .

aat:300422312 a skos:Concept ;
    skos:definition "Molds, into which cookie dough is placed, in order to make a decorative shape or design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cookie molds"@en .

aat:300422316 a skos:Concept ;
    skos:definition "Disposable containers, made of food-safe paper, used to cook food in ovens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking bags"@en .

aat:300422321 a skos:Concept ;
    skos:definition "Long handled three-tined forks used for cooking meats or poultry and or other kitchen uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking forks"@en .

aat:300422322 a skos:Concept ;
    skos:definition "Any of a number of cooking utensils made of iron, such as a waffle iron, designed to enable the user to place food in or over a heat source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking irons"@en .

aat:300422323 a skos:Concept ;
    skos:definition "Blocks of stone that may be heated in order to cook food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking slabs"@en .

aat:300422324 a skos:Concept ;
    skos:definition "Large, flat stones used to cook food over a heat source, in a manner similar to a griddle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking stones"@en .

aat:300422329 a skos:Concept ;
    skos:definition "Insulated box-like chests designed to contain ice and used to cool and preserve food or other perishable items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coolers"@en .

aat:300422331 a skos:Concept ;
    skos:definition "Storage tanks, typically made of concrete and found on dairy farms, used to refridgerate and preserve milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooling tanks"@en .

aat:300422333 a skos:Concept ;
    skos:definition "Vats, used to hold cans of cream, and surrounded by a water bath in order to cool it to the temperature of the water and prevent it from freezing in colder climates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooling vats"@en .

aat:300422335 a skos:Concept ;
    skos:definition "Axes used for chopping or “listing” barrel staves to a rough shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's axes"@en .

aat:300422336 a skos:Concept ;
    skos:definition "Instruments or machine constructed to furnish blasts of air to maintain controlled fire used in the trade of barrell manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's bellows"@en .

aat:300422337 a skos:Concept ;
    skos:definition "Workbenches used in the trade of barrel-making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's benches"@en .

aat:300422338 a skos:Concept ;
    skos:definition "Irons used to mark a barrel with the emblem of the maker, akin to a branding iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's burning irons"@en .

aat:300422339 a skos:Concept ;
    skos:definition "Open fire baskets used to bend staves during the construction of wooden barrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's cressets"@en .

aat:300422340 a skos:Concept ;
    skos:definition "Double-handled blades for shaving wood in the shaping of staves in the construction of barrels, usually shaped in a scoop for shaping curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's downshaves"@en .

aat:300422341 a skos:Concept ;
    skos:definition "A variety of double handled blades used in the construction of barrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's drawknives"@en .

aat:300422342 a skos:Concept ;
    skos:definition "Wedge-shaped tools used for cleaving and riving staves. These have a handle in the plane of the blade, set at right angles to the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's froes"@en .

aat:300422343 a skos:Concept ;
    skos:definition "Hammers used with the a driver to drive hoops tightly down onto the cone shape of a barrel in coopering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's hammers"@en .

aat:300422344 a skos:Concept ;
    skos:definition "Cooper's tools which, by sudden impact or by continuous pressure, is used for piercing, or perforating, as for creating or enlarging an existing hole for a rivet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooper's punches"@en .

aat:300422360 a skos:Concept ;
    skos:definition "Devices used to remove corks from bottles. It typically consists of a body affixed to a surface, and a lever that inserts a prong into the cork. When the lever is pulled back, the cork is extracted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cork extractors"@en .

aat:300422361 a skos:Concept ;
    skos:definition "Devices, either hand held or hydraulic, typically consisting of a bottle holder and a cork driver, that when a compressor is shifted, a cork is inserted in the bottle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cork machines"@en .

aat:300422372 a skos:Concept ;
    skos:definition "Utensils used when eating corn on the cob, allowing the user to keep hands away from the hot ear of corn. Corn or cob holders, as they are called, typically consist of a holder with a heat resistant, knobbed end that has two protruding shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn holders"@en .

aat:300422376 a skos:Concept ;
    skos:definition "Mills used for grinding corn into grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn mills"@en .

aat:300422380 a skos:Concept ;
    skos:definition "Rasp-like devices used to scrape the kernels off ears of corn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn scrapers"@en .

aat:300422406 a skos:Concept ;
    skos:definition "Circular, disc-like attachments placed into telescopes which block the light of the sun to allow for observation of the sun's corona. Historically the term was used for a 19th century instrument that was part telescope and part camera, which allowed for observation of the sun's corona."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronagraphs"@en .

aat:300422414 a skos:Concept ;
    skos:definition "Strings used to lace up corsets, able to tighten them in place or to loosen them to aid in their removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corset laces"@en .

aat:300422430 a skos:Concept ;
    skos:definition "Ancient instruments originally designed by Huguenot inventor and pastor Jacques Besson in 1567. Cosmolabes resembled astrolabes, used to measure distances between celestial bodies. However, they could also be, according to Besson’s design, used in navigation, cartography, surveying, and when not in use could be folded into a reading desk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmolabes"@en .

aat:300422431 a skos:Concept ;
    skos:definition "Instruments, in the form of glass globes, which depicted the position of the earth in relation to the fixed stars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmospheres"@en .

aat:300422439 a skos:Concept ;
    skos:definition "Confectionary machines consisting of a spinning head enclosing a small sugar reserve bowl into which a charge of granulated, colored sugar is poured. Heaters near the rim of the head melt the sugar, which is squeezed out through tiny holes by centrifugal force. The sugar then re-solidifies in the air and is spun around a paper cone into cotton like threads"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotton candy machines"@en .

aat:300422440 a skos:Concept ;
    skos:definition "Mechanized devices that utilitize a pneumatic conveying process to compress webs of cotton fibers into a sliver or roving, as well as to remove dirt or dust from the cotton lint. The devices project a current of cotton laden air against screens made of mesh fine enough to prevent the passage of small fibers. Extraneous matter is extracted from the materials without the loss of valuable fibers, while a suction fan allows for the transport and cohesion of the fibers. Fiber webs are also cut into ribbons by condenser bands, which are then rubbed into round strands of fibres or roving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotton condensers"@en .

aat:300422461 a skos:Concept ;
    skos:definition "Kitchen appliances consisting of a container with a fixed propellerlike blade at the bottom which rotates at different speeds to chop, mix, purée, or whip foods, and that have bases designed to rest on a fixed stable surface such as a kitchen countertop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countertop blenders"@en .

aat:300422462 a skos:Concept ;
    skos:definition "Devices, often automated, that are used to count biological agents (such as counting bacteria colonies in cultures)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counting apparatuses"@en .

aat:300422466 a skos:Concept ;
    skos:definition "Decorated sticks that record coups attained by Plains Indian warriors. These are carried to touch armed enemies as a way to demonstrate bravery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coup sticks"@en .

aat:300422468 a skos:Concept ;
    skos:definition "Contrivances for connecting one thing to another mechanically in series, either permanently, or temporarily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couplings"@en .

aat:300422473 a skos:Concept ;
    skos:definition "Containers made to hold coupons or ration books, generally taking the form of a flat, rectangular envelope or bag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupon cases"@en .

aat:300422476 a skos:Concept ;
    skos:definition "Printed cards intended to be exchanged between people to express romantic interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courting cards"@en .

aat:300422497 a skos:Concept ;
    skos:definition "Mechanized devices that use fixed quantities of wet heat to smooth, relax, and fix the strain on undyed woven material so as to avoid severe creasing and felting at the subsequent dyeing stage. These devices are also sometimes used to smooth and level dyed fabric. Dyed or undyed woven materials are wound dry and level on the device's rotating cylindrical roller that is partially imersed in hot water for a specificed amount of time. The device then subjects the steamed fabric to cold water, before reversing the fabric and completing the process on the backside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crabbing machines"@en .

aat:300422508 a skos:Concept ;
    skos:definition "Objects or sets of objects and supplies used for crafts, which may include pencils, shears, glue, and various forms of paper, often brightly colored. Used by children for hobby activities that involves making things skillfully with the hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craft toys"@en .

aat:300422512 a skos:Concept ;
    skos:definition "Devices used during the process of harvesting cranberries to separate firm, saleable cranberries from poor quality soft cranberries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cranberry sorters"@en .

aat:300422517 a skos:Concept ;
    skos:definition "Promotional objects issued during the course of an electoral campaign that promote a cause or individual. These are designed to be pinned to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign pins"@en .

aat:300422518 a skos:Concept ;
    skos:definition "Pieces or lengths of fine fabric, such as silk or satin forming a narrow strip or band that are imprinted with images or text that advocate for a political cause or person in the context of an election, usually pinned or otherwise affixed to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign ribbons"@en .

aat:300422524 a skos:Concept ;
    skos:definition "Instruments for measuring the length of curved or straight lines on maps or plans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campylometers"@en .

aat:300422526 a skos:Concept ;
    skos:definition "Devices, typically in the form of a hydraulic press, outfitted with a cradle for holding lids known as can blanks, and a lever, which when pressed down, seals the cans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "can capping machines"@en .

aat:300422529 a skos:Concept ;
    skos:definition "Stamps used to indicate that a item has been used, or is no longer valid, such as a postage stamp or check."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cancellation stamps"@en .

aat:300422552 a skos:Concept ;
    skos:definition "Boards for preparing shaping, or decorating sweets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candy boards"@en .

aat:300422554 a skos:Concept ;
    skos:definition "Sharp knives or hatchets used to cut candy into suitable pieces; typically used for hard candy or taffy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candy hatchets"@en .

aat:300422555 a skos:Concept ;
    skos:definition "Slabs, typically of marble, placed onto a countertop and used to cut and shape candy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candy making slabs"@en .

aat:300422557 a skos:Concept ;
    skos:definition "Devices, outfitted with shaping molds, into which candy is inserted, and when a crank is turned or lever is pressed, a formed candy is created. For molds into which candy is typically poured to form a shape, use \"candy molds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candy presses"@en .

aat:300422558 a skos:Concept ;
    skos:definition "Thermometers used to make candy, and determine the correct stage in cooking sugar syrups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candy thermometers"@en .

aat:300422561 a skos:Concept ;
    skos:definition "Mills used for extracting the juice out of sugar cane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cane mills"@en .

aat:300422568 a skos:Concept ;
    skos:definition "Solid fuel, typically jellied, denatured alcohol, sold in small individual cans, and used to as a heating source in such food service equipment such as chafing dishes, coffee urns, and camping stoves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canned fuels"@en .

aat:300422569 a skos:Concept ;
    skos:definition "Devices used to can fresh produce, meat, etc. in order to preserve it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canners"@en .

aat:300422571 a skos:Concept ;
    skos:definition "Autoclaves used specifically for canning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canning autoclaves"@en .

aat:300422572 a skos:Concept ;
    skos:definition "Wide-mouthed funnels, typically of metal or plastic used to fit into jars, and used duing the canning process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canning funnels"@en .

aat:300422573 a skos:Concept ;
    skos:definition "Racks, used to raise jars off the bottom of pots during the cooking process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canning racks"@en .

aat:300422574 a skos:Concept ;
    skos:definition "Type of food packaging made from a laminate or flexible plastic and metal foils, that allows for the sterilization of a wide variety of food and drink by means of aseptic processing. It is used as alternative to traditional industrial canning methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canning retorts"@en .

aat:300422575 a skos:Concept ;
    skos:definition "Tools used for canning, typically consisting of a canning funnel, ladle, and jar lifter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canning tools"@en .

aat:300422585 a skos:Concept ;
    skos:definition "Paddles designed for moving a canoe on a body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canoe paddles"@en .

aat:300422592 a skos:Concept ;
    skos:definition "Covers, designed to fit around canteens, and typically including a strap, so the canteen can be worn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canteen covers"@en .

aat:300422618 a skos:Concept ;
    skos:definition "Coffee making devices similar to espresso machines, but equipped with a spout for steaming milk to make cappuccinos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cappuccino machines"@en .

aat:300422623 a skos:Concept ;
    skos:definition "Unpowered round or pear-shaped airtight vessels designed to rise into the air when inflated with hot air or a gas, and which are tethered to the ground or another vehicle such as a ship. These may be manned or unmanned, and most usually used for observation, historically in a military context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "captive balloons"@en .

aat:300422629 a skos:Concept ;
    skos:definition "A toy car is a toy in the form of a car that is specially made for children to play with. They are rarely scaled and show less detail. Toy cars can come in a variety of sizes and materials, from wood to plastic. For small cars that are true to life and with great detail, use miniature cars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "car toys"@en .

aat:300422633 a skos:Concept ;
    skos:definition "Stands, often three-legged and made of a decorative metal, equipped with a candle or other fuel source so as to keep a carafe of liquid warm. Also, simple riser-like stands for holding and displaying carafes, such as in a restaurant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carafe stands"@en .

aat:300422639 a skos:Concept ;
    skos:definition "Instruments designed for the estimation of phenol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbolimeters"@en .

aat:300422644 a skos:Concept ;
    skos:definition "Instruments that determine the composition of gases contained in carbonic oxide, hydrogen, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carburometers"@en .

aat:300422649 a skos:Concept ;
    skos:definition "Volumes designed to keep and display collectible cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card albums"@en .

aat:300422657 a skos:Concept ;
    skos:definition "Devices that utilize emery-covered rollers, amongst other types of rollers, to clean and sharpen the wire teeth of the card clothing fitted to a carding machine. These devices are designed to restore sharpness and height uniformity to worn wire teeth, as well as to remove any waste stuck between the teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card grinders"@en .

aat:300422660 a skos:Concept ;
    skos:definition "Mechanized devices designed to perforate the punch cards used in Jacquard looms to facilitate the automatic weaving of specified patterns and designs in cloth. Each row of perforated holes in the punch cards corresponds to a row of textile pattern used to control the weaving process. These devices, along with the Jacquard loom's punch-card technology, influenced the development of modern computer programming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card punching machines"@en .

aat:300422663 a skos:Concept ;
    skos:definition "Devices that prepare multiple punched cards from a punched card source, copying all or part of the data from the sourced punch cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card reproducers"@en .

aat:300422666 a skos:Concept ;
    skos:definition "Devices that place punch cards into pockets based on the hole patterns punched into the cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card sorters"@en .

aat:300422671 a skos:Concept ;
    skos:definition "Four-legged bench, typically made of wood and asymmetrically built with one side raised higher than the other, designed to facilitate the manual textile carding process. One textile card, or sharp surface fitted with wires, is slipped into a slot on the bench's raised side, while the second card is manually manipulated by a user straddling the bench. The user is forced to change the grip on the lower card as they work the fibers between the two cards. A wooden drum is often attached to the bench's lower side, around which the smoothened wool gathers after it encounters the cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carding benches"@en .

aat:300422672 a skos:Concept ;
    skos:definition "Specialized combs, typically made of wood, comprising a flat surface covered by iron nails, wire teeth, or other sharp objects designed to manually disentangible the fibres from textile materials prior to spinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carding combs"@en .

aat:300422674 a skos:Concept ;
    skos:definition "Devices that convert data and other information found on punch cards directly to magnetic tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card-to-tape converters"@en .

aat:300422676 a skos:Concept ;
    skos:definition "Lengths of metal or other material that are bent back in a crook, or fashioned with a sharp angle, mounted in a handle for catching hold, dragging, or manipulating suspended objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cargo hooks"@en .

aat:300422677 a skos:Concept ;
    skos:definition "Parachutes designed specifically to deliver goods and machinery via drop from airborne vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cargo parachutes"@en .

aat:300422683 a skos:Concept ;
    skos:definition "Figurative animal sculptures, often brightly colored and decorated with ornamental saddles and bridles; used in carousel amusement park rides. Includes a seat and a pole affixing the sculpture to the top and base of the carousel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carousel animals"@en .

aat:300422698 a skos:Concept ;
    skos:definition "Hand-held, sharp, and hollow instruments used in the production of wool rugs, wherein the wool passes through a canvas backing to create a tufted surface. These instruments, typically comprising a hollow shank, wooden handle, and needle eye, are used to push woolen fibers through the backing fabric; when the needle is removed, a length of tuft in continuous loops is left on the surface of the backing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpet needles"@en .

aat:300422699 a skos:Concept ;
    skos:definition "Material that is intended to fit under carpets to add a cushion of support, or to prevent slippage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpet pads"@en .

aat:300422721 a skos:Concept ;
    skos:definition "Direct-current amplifiers in which the signal is passed through a low-pass filter, then used to modulate a carrier signal so it may be amplified as an alternating-current signal. The amplified DC output is obtained by rectifying and filtering the carrier signal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrier amplifiers"@en .

aat:300422722 a skos:Concept ;
    skos:definition "Any of various light, two- or four-wheeled open or covered carriages, normally intended for a single person, and typically drawn by a single horse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrioles"@en .

aat:300422726 a skos:Concept ;
    skos:definition "Bags used to transport personal items on the body, usually with handles or straps to facilitate this."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrying bags"@en .

aat:300422727 a skos:Concept ;
    skos:definition "Containers made of woven plant material of varying shape. Some examples contain lids or hoops for carrying poles. Made to carry various personal materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrying baskets"@en .

aat:300422728 a skos:Concept ;
    skos:definition "Small bags, often with multiple compartments designed to carry small personal items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrying pouches"@en .

aat:300422729 a skos:Concept ;
    skos:definition "Cords used to loop around materials to secure them in place for easy transport. Examples include tumplines and straps for bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrying straps"@en .

aat:300422738 a skos:Concept ;
    skos:definition "Packaging machines that form cartons, inserts a product inside, and folds and seals the carton closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartoning machines"@en .

aat:300422769 a skos:Concept ;
    skos:definition "Bookbinding machines used for making the cases or covers of books, which typically includes the embossing of the book's title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casemaking machines"@en .

aat:300422780 a skos:Concept ;
    skos:definition "Small knife-like scrapers used to clean meat casings in prepariton for making susages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casing scrapers"@en .

aat:300422782 a skos:Concept ;
    skos:definition "Bookbinding machines into which books are fed for the casing-in or pasting of a book into its cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casing-in machines"@en .

aat:300422785 a skos:Concept ;
    skos:definition "Cradle-shaped stands, typically made of wood, used to support casks of wine or beer for either serving or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cask stands"@en .

aat:300422787 a skos:Concept ;
    skos:definition "Modified Gregorian telescopes that contain Cassegrain reflectors, designed to reflect and focus light toward their primary light-gathering mirrors. Designed in 1672 by French priest Laurent Cassegrain, the improvement was rediscovered in the late 18th century as it was proven to reduce spherical aberration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cassegrain telescopes"@en .

aat:300422789 a skos:Concept ;
    skos:definition "Tray-like supports with handles used for serving and transporting dishes such as casseroles. Also frame-like holders, often of a decorative metal, used for more formal serving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casserole holders"@en .

aat:300422800 a skos:Concept ;
    skos:definition "Receptacles generally made of stone, metal, or wood, sculpted or shaped into a pattern, and equipped with risers. Used to contain molten metal and give it a shape while it solidifies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casting molds"@en .

aat:300422812 a skos:Concept ;
    skos:definition "Devices which decompose a material or gas in a catalytic reaction such as odors, volatile organic compounds, and automobile exhaust and suppressing their emission, particularly VOC gasses containing volatile organic compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalytic apparatuses"@en .

aat:300422821 a skos:Concept ;
    skos:definition "General term for any built works or other things classified as being of the built environment, whether extant or not, constructed or not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "built environment objects"@en .

aat:300422848 a skos:Concept ;
    skos:definition "Handheld devices that deliver an electric shock, designed to be administered to the flanks of cattle to startle them into movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle prods"@en .

aat:300422910 a skos:Concept ;
    skos:definition "Instruments used to render perspective drawings. These consist of three rulers joined together in a Y-shape so that a central ruler, along which lines are to be drawn, may be orientated correctly by adjusting the position of the legs that rest against two nails placed on the drawing board. As the device pivots, the main bar changes slope, resulting in drawn lines that orient to a vanishing point that would be otherwise difficult to obtain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centrolineads"@en .

aat:300422914 a skos:Concept ;
    skos:definition "Utensils resembling soup spoons that are designated for eating breakfast cereals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cereal spoons"@en .

aat:300422915 a skos:Concept ;
    skos:definition "Items of ceremonial costume worn below the waist and behind the wearer. The use of this term is usually applied to objects of Native cultures of the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial bustles"@en .

aat:300422918 a skos:Concept ;
    skos:definition "Shaken instruments used for religious or ceremonial practices. Widely used across religious traditions; some examples include Native North American and African religious ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial rattles"@en .

aat:300422926 a skos:Concept ;
    skos:definition "Pieces of material removed from punched cards during the punching process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chads"@en .

aat:300422931 a skos:Concept ;
    skos:definition "Hooks used for cargo transport that have a pin or bolt mounted through two tines so that it may be attached to a chain or line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain hooks"@en .

aat:300422940 a skos:Concept ;
    skos:definition "Coverings, either decorative or protective for arm supports on chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair arm covers"@en .

aat:300422942 a skos:Concept ;
    skos:definition "Pieces of material, often plastic, that rest on the surface of a floor that are meant to ease the movement of rolling chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair mats"@en .

aat:300422945 a skos:Concept ;
    skos:definition "Decorative or protective coverings for the seats of chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair seat covers"@en .

aat:300422946 a skos:Concept ;
    skos:definition "Lightweight textile coverings that are casually draped or laid over chairs, primarily as decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chair throws"@en .

aat:300422952 a skos:Concept ;
    skos:definition "Containers made to carry and store chalices used for eucharistic ceremonies. Some are shaped in the form of a chalice while others are square in form. Made of varying material, including leather, wood, and plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalice cases"@en .

aat:300422959 a skos:Concept ;
    skos:definition "Large boards having a surface upon which one may write or draw with chalk. The color may be black, green, or another color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalkboards"@en .

aat:300422986 a skos:Concept ;
    skos:definition "Apparatuses used for heating, usually of cast iron, designed to burn charcoal efficiently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal heating stoves"@en .

aat:300422992 a skos:Concept ;
    skos:definition "Objects worn about the person to avert evil or ensure prosperity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charms"@en .

aat:300423000 a skos:Concept ;
    skos:definition "Rectangular dividers, often made of card stock or plastic, used to separate and organize documents such as medical charts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chart dividers"@en .

aat:300423011 a skos:Concept ;
    skos:definition "Crescent-shaped pieces of steel used as a blade used in cigar making to cut a wrapper leaf to size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chavetas"@en .

aat:300423012 a skos:Concept ;
    skos:definition "Devices that emboss bank or personal checks for identification purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "check embossers"@en .

aat:300423015 a skos:Concept ;
    skos:definition "Rectangular containers made to hold checkbooks, variously made of fabric or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkbook covers"@en .

aat:300423021 a skos:Concept ;
    skos:definition "Devices used to carry whole cheeses from the pasture to market. One type of cheese carrier is made of wood and consists of a platform to hold the cheeses, which rests on carved legs attached to two arms, called 'horns'. To carry it, the ‘horns' are placed on the shoulders, with the platform resting on the head. Other types of cheese carriers consist of a platform to hold the cheeses, suspended by cords carried in the hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese carriers"@en .

aat:300423028 a skos:Concept ;
    skos:definition "Device used in cheese- making for breaking cheeses in into smaller pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese saws"@en .

aat:300423033 a skos:Concept ;
    skos:definition "Tools used to remove a sample of a cheese wheel to test the taste, aroma, texture, and color for maturity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese testers"@en .

aat:300423035 a skos:Concept ;
    skos:definition "Small, hand-held devices resembling an apple corer, used to extract a small plug sample from the center of the cheese wheel, in order for it to be evaluated for taste and texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese triers"@en .

aat:300423036 a skos:Concept ;
    skos:definition "Vats, typically round in shape and made of steel, in which cheese curd is formed and cut or broken in cheese making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese vats"@en .

aat:300423038 a skos:Concept ;
    skos:definition "Loosely woven gauze-like cotton cloth, used primarily in cheese making, but also used for a wide variety of cooking techniques, such as making small sachets for herbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheesecloth"@en .

aat:300423041 a skos:Concept ;
    skos:definition "Scientific instruments for identifying minerals by sublimation or to measure the buoyant force that a body experiences when placed in a fluid, essentially to determine its suspended weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apophorometers"@en .

aat:300423043 a skos:Concept ;
    skos:definition "Refers to chemical instruments that lack another descriptive or generic name or if the specific name of the instrument is unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical instruments"@en .

aat:300423044 a skos:Concept ;
    skos:definition "Refers to any container specifically designed for protecting and/or transporting chemical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical instrument cases"@en .

aat:300423047 a skos:Concept ;
    skos:definition "Collections of objects that together form the means of performing chemical tests. Inclusive of the equipment and the container in which it is kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical test kits"@en .

aat:300423048 a skos:Concept ;
    skos:definition "Tools, equipment, and supplies originally created for the sampling, observation, measurement, or recording of specific chemical properties in specialized applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical testing devices"@en .

aat:300423053 a skos:Concept ;
    skos:definition "Sets of objects with which children may discover chemistry by performing experiments with supplied materials and labware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemistry sets"@en .

aat:300423060 a skos:Concept ;
    skos:definition "Large chest-like freezers with a hinged lid that opens from the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chest freezers"@en .

aat:300423061 a skos:Concept ;
    skos:definition "General term for various objects worn to protect the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chest guards"@en .

aat:300423069 a skos:Concept ;
    skos:definition "Cooking devices consisting of a pan or box-like container with a lid attatched to a long handle, used to roast chestnut over a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chestnut roasters"@en .

aat:300423075 a skos:Concept ;
    skos:definition "Relatively small shelters for chickens, usually chickens raised for laying eggs, who are brought into the shelter for safety overnight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicken coops"@en .

aat:300423078 a skos:Concept ;
    skos:definition "Devices of various styles for carrying a baby or small child; an example is a carrier designed to be worn over the shoulders with the baby supported on one's back, hips, or chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby carriers"@en .

aat:300423085 a skos:Concept ;
    skos:definition "Refrigeration systems that lower the temperature of a building, or of machinery, industrial spaces, and process fluids by removing heat from the system and transferring it somewhere else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiller systems"@en .

aat:300423095 a skos:Concept ;
    skos:definition "Rests designed for a musician's chin to balance musical instruments such as the violin or viola while playing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chin rests"@en .

aat:300423097 a skos:Concept ;
    skos:definition "Perforated metal conical strainer used to remove seeds and other coarse matter from soft foods. The china cap is similar to the chinois, but has much larger holes, and creates a coarser-textured product. Both the chinois and the china cap often are used with a cone-shaped pestle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "china caps"@en .

aat:300423098 a skos:Concept ;
    skos:definition "Mechanized devices designed to produce the napped and textured finish of fabrics designed to mimic the characteristics of chinchilla fur. These devices typically include a table roughly equal to the width of the chinchilla fabric. The fabric, often fine wool, is laid on the table parallel to a vibrating plate, which moves rapidly across the fabric's surface to produce the chinchilla's characteristic naps and tufts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinchilla machines"@en .

aat:300423101 a skos:Concept ;
    skos:definition "Perforated metal conical strainer with extremely fine mesh used to strain custards, purees, soups, and sauces. It can also be used to dust food with a fine layer of powdered ingredient. The chinois is similar to the china cap, but creates a much smoother product. Both the chinois and the China cap often are used with a cone-shaped pestle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinois"@en .

aat:300423102 a skos:Concept ;
    skos:definition "Fitness equipment consisting of a horizontal bar with two supports attaching it to a wall or doorway. Used for lifting exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chin-up bars"@en .

aat:300423107 a skos:Concept ;
    skos:definition "Blocks or wedges of wood or other material used to secure or steady an object, or to prop or keep something in position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocks"@en .

aat:300423119 a skos:Concept ;
    skos:definition "Boxes, typically made of wood, used to contain food stuffs, such as vegetables or ice, while being chopped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopping boxes"@en .

aat:300423126 a skos:Concept ;
    skos:definition "Bottles containing holy water or oil used in the christening or baptismal ceremony; may be inscribed with a commemoration of the occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening bottles"@en .

aat:300423133 a skos:Concept ;
    skos:definition "Reflecting telescopes used for studying the scintillations of stars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromatoscopes"@en .

aat:300423140 a skos:Concept ;
    skos:definition "Portable containers typically used by campers for storing a variety of equipment associated with a camp kitchen, such as cooking pots, pans, plates, utensils, and cleaning items.. When packed up, it looks like a large box, and when unpacked, the front and sides fold down to reveal its contents arranged into specifically designed compartments, shelves, drawers, and racks. In the contexting of scouting, chuck boxes are also known as patrol boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chuck boxes"@en .

aat:300423141 a skos:Concept ;
    skos:definition "Tools that are made for the purpose of tightening or loosening the jaws of a clamp for cylindrical objects on a tool or machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chuck keys"@en .

aat:300423149 a skos:Concept ;
    skos:definition "Devices used to agitate cream in a churn, with the purpose of separating the fat from the cream to produce butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "churn dashers"@en .

aat:300423151 a skos:Concept ;
    skos:definition "Platforms on which milk churns are places for collection by cart or truck, once a common roadside site found in the dairy farming areas of Britain. While some were simple contructions made of wood, the majority were built from stone or concrete blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk churn stands"@en .

aat:300423153 a skos:Concept ;
    skos:definition "Instruments for measuring liquids that consist of a piston moving in a liquid filled tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chyometers"@en .

aat:300423155 a skos:Concept ;
    skos:definition "Cases designed to hold a ciborium, which is a vessel used to hold the hosts for distribution in the Eucharist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciborium cases"@en .

aat:300423159 a skos:Concept ;
    skos:definition "Tools used in the process of fermenting fresh apples into an alcoholic cider beverage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cider making tools"@en .

aat:300423162 a skos:Concept ;
    skos:definition "Paper strips that surround the bodies of individual cigars that carry the imprint of the cigar maker. These are used as a means of promoting the maker's brand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar bands"@en .

aat:300423168 a skos:Concept ;
    skos:definition "Airtight containers intended to keep cigars fresh before smoking. These come in a variety of forms from cylinders for individual cigars to small cases for multiples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar containers"@en .

aat:300423180 a skos:Concept ;
    skos:definition "Ribbons, often made of silk, historically used to bundle cigars in groups. These are usually imprinted with a brand name, and have been traded as collectibles since the late 1800s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar ribbons"@en .

aat:300423181 a skos:Concept ;
    skos:definition "Mechanical devices in various forms used to uniformly roll the binder leaf evenly around the filler tobacco of a cigar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar rollers"@en .

aat:300423189 a skos:Concept ;
    skos:definition "Strips of fabric and elastic used as an accessory to one's outfit, usually worn around the waist. Sometimes decorated with beads, buttons, or ribbon. Cinch belts were particularly popular in the United States in the 1950s, replacing garter belts as a way to create a defined waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinch belts"@en .

aat:300423195 a skos:Concept ;
    skos:definition "Devices made to create and decode ciphers; some examples include typewriter-based machines using electrical rotors to scramble messages one character at a time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cipher machines"@en .

aat:300423227 a skos:Concept ;
    skos:definition "Instruments designed to demonstrate visibly the harmonic overtones of all musical notes, by means of a device utilizing gas jet flames and revolving mirrors. This device was presented at the Paris Universal Exhibition of 1867 by Rudolph Koenig."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clang analyzers"@en .

aat:300423232 a skos:Concept ;
    skos:definition "An instrument consisting of either one short wooden stick partially split in half or two sticks, sometimes hollowed out and bound or linked together at one end by a leather thong or cord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clapper sticks"@en .

aat:300423234 a skos:Concept ;
    skos:definition "Long-handled spoons made from ca. 1880's through about 1910. The original use is disputed, thought to either stir claret, or retrieve fruit from claret pitchers or to place fruit on dishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claret spoons"@en .

aat:300423240 a skos:Concept ;
    skos:definition "Rings worn by students and alumni of an educational institution that commemorate the final academic year and/or graduation, generally for a high school, college, or university. These often feature a gem held in a metal setting in which a year and school is displayed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "class rings"@en .

aat:300423266 a skos:Concept ;
    skos:definition "U-shaped fasteners, with a pin or bolt passing through holes in the two prongs, allowing for it to be bolted on to another object to form a loop to which tackle may be attached. Clevises are used in a variety of applications including for farming, sailing, automotive, aircraft and construction industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clevises"@en .

aat:300423273 a skos:Concept ;
    skos:definition "Mesh made from knotted material, hung between posts or from a frame. Made for playgrounds or other recreational areas, allowing users to climb from one area to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climbing nets"@en .

aat:300423285 a skos:Concept ;
    skos:definition "Devices, usually in the form of rotating discs that are attached to plants, which are used to study tropisms, such as light and gravity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinostats"@en .

aat:300423287 a skos:Concept ;
    skos:definition "Ringless binders that hold sheaves of documents via a spring-or clamp device built into the spine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clip binders"@en .

aat:300423289 a skos:Concept ;
    skos:definition "Microphones that are meant to clip on ties or lapels, designed for film and television production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavaliers"@en .

aat:300423291 a skos:Concept ;
    skos:definition "Boards of wood or other material bearing a spring-clip at one end for holding papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clipboards"@en .

aat:300423300 a skos:Concept ;
    skos:definition "Keys used to wind clockwork mechanisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock keys"@en .

aat:300423301 a skos:Concept ;
    skos:definition "Mechanized devices used for measuring and winding a desired length of yarn, usually a skein. These devices comprise a spoked wheel with gears attached to a pointer with a face resembling that of a clock. The user manually twists the wheel to wind the yarn and, when a skein of yarn has been wound, the pointer makes a popping or clicking sound to alert the user that the desired length has been attained. The nursery rhyme \"Pop Goes the Weasel\" is widely thought to refer to the clock reel's popping sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock reels"@en .

aat:300423309 a skos:Concept ;
    skos:definition "Hand-held instruments, typically characterized by a pointed mental tip and a thick wooden handle, used to make small holes and sew seems in heavy-duty fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth awls"@en .

aat:300423311 a skos:Concept ;
    skos:definition "Lengths of woven or knitted cloth, typically measuring approximately 40 to 100 yards long, folded or rolled on a cylindrical or rectangular core. Often stored in an upright position on shelves or racks and wrapped in plastic or other protective material to prevent damage, these fabric rolls are used to create myriad textile products. They can be made of cotton, silk, wool, or synthetic fibers, depending on desired use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolts"@en .

aat:300423312 a skos:Concept ;
    skos:definition "Hydrostatic devices, comprising iron plates and a pressing board, used to give woolen and worsted cloth a smooth and lustrous finish. Once arranged in regular folds on the device's pressing board, the cloth is sandwiched between hot plates with applied pressure until the plates cool. Cold iron or hollow plates are used in conjuction with the hot plates to moderate the temperature and prevent the heat from scorching the cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth presses"@en .

aat:300423314 a skos:Concept ;
    skos:definition "Mechanized devices, comprising a series of rollers supported by an asymetrical frame, used to stretch, smooth, and lengthen tubular knit goods or cloth materials. The device's frame is typically constructed to be wider at one end, gradually decreasing in width towards the other end, so that one roller is at a higher elevation than the rest. The cloth or knit goods are spread over the frame and the rollers, sometimes equipped with bristles, are rotated in unison; when the rotating rollers come in contact with the fabric, their pressure pushes the cloth outward from its center to its edges. The fabric is ultimately stretched to a width equal to the widest part of the frame, which can be adjusted depending on desired stretch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth stretchers"@en .

aat:300423320 a skos:Concept ;
    skos:definition "Shapes made of fabric or paper, in modern times often tissue paper, used as guides to cut out sections of fabric that can be stitched together into articles of clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothes patterns"@en .

aat:300423324 a skos:Concept ;
    skos:definition "Mechanical devices that mount two rollers in close proximity to a crank and gear, through which wet textiles are passed to squeeze out excess moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothes wringers"@en .

aat:300423325 a skos:Concept ;
    skos:definition "A clothes line is any type of rope, cord, or twine that has been stretched between two points, outside or indoors, above the level of the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clotheslines"@en .

aat:300423334 a skos:Concept ;
    skos:definition "Fastenings that hold together parts of garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing clasps"@en .

aat:300423335 a skos:Concept ;
    skos:definition "General term for fasteners used on garments, often used to hold ends of clothing such as scarves or furs together. Others are used as decorative accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing clips"@en .

aat:300423339 a skos:Concept ;
    skos:definition "Components of garments, such as shirts, nightgowns, or dresses, consisting of a neck and shoulder piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing yokes"@en .

aat:300423341 a skos:Concept ;
    skos:definition "Glass, plastic, or gelatin light filters that accentuate the appearance of clouds in the sky. These may be tinted in a variety of ways to achieve a particular effect depending on the type of camera or film used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloud filters"@en .

aat:300423353 a skos:Concept ;
    skos:definition "Lightweight, open-front, four-wheeled horse-drawn carriages intended for families, particular to the United States, and obsolete after the mid-19th century. These had long bodies with seating for multiple passengers, and were suspended on straps or springs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coachees"@en .

aat:300423354 a skos:Concept ;
    skos:definition "Devices that measure the coagulation time of blood samples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coagulometers"@en .

aat:300423358 a skos:Concept ;
    skos:definition "Cookstoves fueled by coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal cookstoves"@en .

aat:300423362 a skos:Concept ;
    skos:definition "Apparatuses used for heating, usually of cast iron, designed to burn coal efficiently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal heating stoves"@en .

aat:300423364 a skos:Concept ;
    skos:definition "Sharp implements used to break coal into pieces for burning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal picks"@en .

aat:300423365 a skos:Concept ;
    skos:definition "Metal scoops of varied size used to gather or transport coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal shovels"@en .

aat:300423369 a skos:Concept ;
    skos:definition "Vehicles whose primary method of propulsion is gravity; usually comprised of four wheels and an enclosed seating area. Originally made of wood, cars are now fashioned out of a variety of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaster cars"@en .

aat:300423370 a skos:Concept ;
    skos:definition "Containers to hold coasters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaster holders"@en .

aat:300423406 a skos:Concept ;
    skos:definition "Canisters, made of a variety of materials, but typically of tin or ceramic, designed to hold coffee and maintain its freshness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee canisters"@en .

aat:300423408 a skos:Concept ;
    skos:definition "Filters, typicallly made of paper, but also made of metal, used in coffee brewing to separate the coffee grounds from the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee filters"@en .

aat:300423411 a skos:Concept ;
    skos:definition "Cylindrical drinking vessels with a generous capacity that rest on a flat base with a single handle, used to drink coffee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee mugs"@en .

aat:300423412 a skos:Concept ;
    skos:definition "Coffee brewing device containing a plunger made of fine mesh with which the grounds are pushed to the bottom of a carafe when the coffee is ready to be poured. It is known by a wide variety of names including French press, cafetiére, cafetière à piston, and coffee plunger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee presses"@en .

aat:300423414 a skos:Concept ;
    skos:definition "Mechanized coffee roasters, typically electric, into which coffee beans are placed and slowly roasted. For hand-held devices used to roast coffee over an open fire, use \"coffee roasters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee roasting machines"@en .

aat:300423415 a skos:Concept ;
    skos:definition "Short-handled scoops intended for coffee, typically sized to hold a specific measure, in order to brew coffee consistantly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee scoops"@en .

aat:300423423 a skos:Concept ;
    skos:definition "Cushioned headrests for the deceased in a coffin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffin pillows"@en .

aat:300423432 a skos:Concept ;
    skos:definition "Flat, thin containers, usually made of paper or plastic, with circle-shaped indentations to hold coins. Used for both storage and display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coin folders"@en .

aat:300423446 a skos:Concept ;
    skos:definition "Bags used to keep detachable collars in after they have been cleaned. Used to describe historical objects as removeable collars are no longer a common element of haberdashery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar bags"@en .

aat:300423447 a skos:Concept ;
    skos:definition "Small round boxes that store detachable collars for men's shirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar boxes"@en .

aat:300423449 a skos:Concept ;
    skos:definition "Accessories worn on the collars of garments; usually clips are attached to each end of the collar, holding the fabric ends closer together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar clips"@en .

aat:300423452 a skos:Concept ;
    skos:definition "Accessories fastened to the collars of garments by means of a pin. Some collar pins are singular, while others consist of two or more elements attached to each side of a collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar pins"@en .

aat:300423453 a skos:Concept ;
    skos:definition "Accessories used to lengthen the collars of garments. Can take varying forms; some consist of a button with a fabric loop which are inserted into the top buttonhole of a garment, while others are rectangular inserts which are buttoned along the inside of collars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar spreaders"@en .

aat:300423454 a skos:Concept ;
    skos:definition "Small plastic or metal tabs inserted underneath collar tabs to keep them from curling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar stays"@en .

aat:300423455 a skos:Concept ;
    skos:definition "Bookbinding machines used to coallate pages to ensure that all sheets are present and in the correct order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collating machines"@en .

aat:300423464 a skos:Concept ;
    skos:definition "Filters that correct for color temperature or cast for film or digital cameras and photographic enlargers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color correction filters"@en .

aat:300423481 a skos:Concept ;
    skos:definition "Main outerwear garments that cover the body above and below the waist and are bifurcated. For a similar undergarment, use \"combinations (underwear).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination garments"@en .

aat:300423494 a skos:Concept ;
    skos:definition "Devices, ranging from simple sheet pans to electrical machines, used for coating sweets (comfit), with chocolate, nuts, or sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comfit pans"@en .

aat:300423502 a skos:Concept ;
    skos:definition "Illustrated cards that celebrate an event or person of note."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative cards"@en .

aat:300423503 a skos:Concept ;
    skos:definition "Cases that hold commemorative objects, and that sometimes are themselves considered commemorative objects themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative cases"@en .

aat:300423504 a skos:Concept ;
    skos:definition "Ceremonial certificates that mark an event such as a birth, but that are not considered official documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative certificates"@en .

aat:300423506 a skos:Concept ;
    skos:definition "Ceremonial keys that are not considered functional but that have a purely symbolic charater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative keys"@en .

aat:300423508 a skos:Concept ;
    skos:definition "Plates, usually of ceramic, that are emblazoned with an image of an event, place or person of note. These are generally meant to be collected or hung as decoration rather than as functional items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative plates"@en .

aat:300423509 a skos:Concept ;
    skos:definition "Ribbons that commemorate service or events, meant to be worn as a symbol rather than a designation of rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative ribbons"@en .

aat:300423510 a skos:Concept ;
    skos:definition "Stones that commemorate political, cultural, and artistic days, acts, individuals, or events at the local, regional, or international level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative stones"@en .

aat:300423511 a skos:Concept ;
    skos:definition "Coin-like tokens not intended as legal tender that celebrate notable people or events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative tokens"@en .

aat:300423516 a skos:Concept ;
    skos:definition "Dissecting tools used to hold structures such as nerves or vessels, while dissecting with probes or needles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissecting forceps"@en .

aat:300423517 a skos:Concept ;
    skos:definition "Sets of instruments used for dissecting, usually including dissecting forceps, dissecting scissors, dissecting needles, and scalpels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissecting kits"@en .

aat:300423518 a skos:Concept ;
    skos:definition "Dissecting tools, usually about six inches long and inserted into wooden handles, that are used to separate and explore specimens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissecting needles"@en .

aat:300423519 a skos:Concept ;
    skos:definition "Scissors specifically used for blunt dissection, transection, and cutting during the dissection process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissecting scissors"@en .

aat:300423520 a skos:Concept ;
    skos:definition "Sets or kits or implements used for dissecting biological specimens. These contents of these vary, but usually include scissors, forceps, and scalpels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissecting sets"@en .

aat:300423521 a skos:Concept ;
    skos:definition "Instruments used specifically for dissection of animals or plants for the purpose of scientific examination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissecting tools"@en .

aat:300423526 a skos:Concept ;
    skos:definition "Signs or posts used to indicate the distance to or between a specific point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distance markers"@en .

aat:300423528 a skos:Concept ;
    skos:definition "Devices used to vaporize substances by means of heat, and then condense the vapour by exposing it to cold, obtaining the substance or one of its constituents in a state of concentration or purity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distilling apparatuses"@en .

aat:300423530 a skos:Concept ;
    skos:definition "Overhead receivers, accumulators, reflux drums, and condensers including ejector-condensers used to receive and collect condensed liquid material from a distillation unit and from which the condensed liquid is pumped to larger storage tanks or other process units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distilling receivers"@en .

aat:300423533 a skos:Concept ;
    skos:definition "Spirit duplicators that employ a manual printing method devised in 1923 involving a 2-ply master sheet as a plate. One layer of the master may be typed or drawn on, and the second layer is coated with wax and colorant. Marks made to the first sheet are transferred to its rear, coated side. The sheet with the transferred wax image is then attached to a drum on the machine that revolves over paper, gradually transferring the wax onto a paper support by means of a solvent. Approximately 40 copies or prints can be made in this way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ditto machines"@en .

aat:300423536 a skos:Concept ;
    skos:definition "Headgear used to protect and to provide a steady supply of oxygen for the user. Used for both shallow-water and deep-water diving. Early examples from the 19th century were commonly made of metal and featured several portholes for viewing, covering the entire head. Contemporary helmets are made of various materials (metal, plastic, fiberglass, etc.) and provide a single transparent viewer to aid sight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divers' helmets"@en .

aat:300423541 a skos:Concept ;
    skos:definition "Rectangular small cards placed in between documents, used to label collections of papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divider cards"@en .

aat:300423544 a skos:Concept ;
    skos:definition "Flat, horizontal platforms used for water sports. Located near the rims of pools or other bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diving boards"@en .

aat:300423546 a skos:Concept ;
    skos:definition "Equipment comprising of a visor or goggles and a mask covering the nose; held in place by a headband. Used for diving, usually in conjunction with a breathing tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diving masks"@en .

aat:300423547 a skos:Concept ;
    skos:definition "Footwear used by divers to protect their feet. Generally made of waterproof materials; earlier examples were made of metal and leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diving shoes"@en .

aat:300423550 a skos:Concept ;
    skos:definition "Devices, both mechanized and manual, used to weave geometric and regular pattern sequences at a rapid rate by utilizing a dobby mechanism to control the warp threads. Similar to, but distinct from, Jacquard looms, these floor looms comprise a series of lattices into which pegs are inserted to facilitate the lifting of heald shafts in accordance with pre-established patterns. While Jacquard looms lift individual warp threads, dobby looms incorporate dobby mechanisms to simultaneously lift shafts or sets of shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dobby looms"@en .

aat:300423554 a skos:Concept ;
    skos:definition "Containers made to store documents, taking various forms. Some examples include boxes with lids while others take the form of bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "document cases"@en .

aat:300423559 a skos:Concept ;
    skos:definition "Rigid tubes with removeable caps at the ends used to store or transport large documents such as maps, blueprints, or any large format document that may be rolled up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "document tubes"@en .

aat:300423578 a skos:Concept ;
    skos:definition "Small beds for baby dolls, often with rockers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doll cradles"@en .

aat:300423579 a skos:Concept ;
    skos:definition "Small versions of furniture as accessories for dolls. They are larger than dollhouse furniture and show more finishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doll furniture"@en .

aat:300423586 a skos:Concept ;
    skos:definition "Furnishings for dollhouses such as furniture and decorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollhouse furnishings"@en .

aat:300423589 a skos:Concept ;
    skos:definition "Prehistoric structures consisting of a large flat or flattish unhewn stone resting horizontally on three or more stones set upright."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolmens"@en .

aat:300423660 a skos:Concept ;
    skos:definition "Metal implements consisting of a blade bent at a right angle extending from a handle. Used to clean off dough from a dough trough or to cut it into smaller portions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough scrapers"@en .

aat:300423663 a skos:Concept ;
    skos:definition "Tools used to form uncooked dough or batter into doughnut-shaped rings prior to baking or frying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doughnut molds"@en .

aat:300423677 a skos:Concept ;
    skos:definition "Drafting tools with two adjustible arms: one fixed with a drawing implement, normally a sharpened piece of graphite, the other with a pivot post with which the center of a circle is defined on a drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting compasses"@en .

aat:300423678 a skos:Concept ;
    skos:definition "Tools used for rendering mechanical drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting instruments"@en .

aat:300423679 a skos:Concept ;
    skos:definition "Cases that hold a variety of drafting instruments, usually compasses of varied sizes, pencil points, and inking pens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting instrument cases"@en .

aat:300423681 a skos:Concept ;
    skos:definition "Hand-held instruments for drafting in ink or other fluids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting pens"@en .

aat:300423682 a skos:Concept ;
    skos:definition "Sets of drafting instruments that usually include compasses, ruling pens, nibs, graphite points, etc., usually held in a carrying case with a compartment for each item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting sets"@en .

aat:300423687 a skos:Concept ;
    skos:definition "Flat guides of metal, plastic, or other materials, with shaped edges or openings in the surface, used as a gauges for outlining predetermined shapes, letters, or curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting templates"@en .

aat:300423688 a skos:Concept ;
    skos:definition "Flat templates, usually made of transparent plastic, in the shape of a triangle, cut into specific angles, most commonly with 90 and 45 degree angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting triangles"@en .

aat:300423710 a skos:Concept ;
    skos:definition "Leatherworking knives, consisting of a blade with a handle at each end, used for shaving or scraping the leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draw knives"@en .

aat:300423711 a skos:Concept ;
    skos:definition "Devices, both mechanized and manual, that use various cords or leashes held in place by a narrow perforated comber-board or draw loom harness to weave intricately figured fabrics in adherance with pre-designed patterns. Preceeding the invention of the Jacquard loom, these devices can be dated to the sixth century and are of Asiatic origin. While their cords were once manually operated by drawboys seated on top of the looms, they were eventually designed to be automatically controlled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draw looms"@en .

aat:300423718 a skos:Concept ;
    skos:definition "Boards or multipurpose tables, usually relatively small in size, on which paper or canvas can be placed for drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing boards"@en .

aat:300423719 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising a series of two to four rollers, used to attenuate, straighten, comb, and combine the loose and inconsistent slivers produced through the carding process. As slivers are passed through the frames' rollers, which spin at increasingly rapid speeds, their individual fibers are made parallel and uniform for future usage. These devices are specifically designed to carry out drawing, doubling, and drafting processes. The device's original invention is credited to Lewis Paul and John Wyatt who developed the first drawing frame in the 1730s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing frames"@en .

aat:300423724 a skos:Concept ;
    skos:definition "Toys and tools with which children can draw creatively. Examples are (magnetic) drawing boards and spirographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing toys"@en .

aat:300423725 a skos:Concept ;
    skos:definition "Automated devices used to facilitate the initiation of new fabric designs onto a loom by threading yarns from new warps through the eyes of the loom's heddles and the dents of its reeds. By reducing the labor time required to carry out the drawing-in process, which consists of both drafting and denting tasks, these devices allow more frequent re-drawings or establishment of new design patterns in fabrics. H.D. Coleman is credited with inventing the first automated drawing-in machine in 1904 based on the principle of manual warping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing-in machines"@en .

aat:300423736 a skos:Concept ;
    skos:definition "Accessories worn on dresses or other garments and fastened with a clip placed on each side of the collar or on the bodice to create pleats in the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress clips"@en .

aat:300423741 a skos:Concept ;
    skos:definition "Costume components that are attached to the back of dresses. Generally take the form of extended skirts or gowns that trail behind the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress trains"@en .

aat:300423747 a skos:Concept ;
    skos:definition "Set of hair care items, usually including a brush, comb, and hand mirror. For a larger set also containing jars, boxes, candlesticks, and other items, use \"toilet sets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dresser sets"@en .

aat:300423750 a skos:Concept ;
    skos:definition "Dressing garments in the form of capes, long with slits for the arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing capes"@en .

aat:300423755 a skos:Concept ;
    skos:definition "Large supports of varied design used for dressing game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing hoists"@en .

aat:300423756 a skos:Concept ;
    skos:definition "Loose garments, hip to thigh length, worn by men when dressing or lounging at home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing jackets"@en .

aat:300423763 a skos:Concept ;
    skos:definition "Hand-held tools comprising two long, sharp stainless steel blades, one of which is bent at an angle and one of which is rounded, mounted to two different-sized finger rings. These tools are specifically designed to cut long swaths of fabric, oftentimes straight from the bolt; they are most often utilized to craft dresses or other types of clothing. The bent-angle blade, which is controlled by the user's thumb, helps to keep the fabric flat on the cutting surface for more precise cuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressmaker's shears"@en .

aat:300423764 a skos:Concept ;
    skos:definition "Clothing and attributes that children and adults wear to dress up as another character, figure, animal or person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress-up costume"@en .

aat:300423765 a skos:Concept ;
    skos:definition "Flight instruments used for measuring the angle of drift of an aircraft. These have sight wires that rotate until objects on the ground appear to travel parallel with it so that from the position of the wire the drift angle may then be read directly from a calibration chart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drift indicators"@en .

aat:300423776 a skos:Concept ;
    skos:definition "Keys used to loosen and tighten the chuck holding the bit on a drill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drill chucks"@en .

aat:300423785 a skos:Concept ;
    skos:definition "Devices designed to mix drinks within a glass, usually featuring a shaft mounted with an agitator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drink mixers"@en .

aat:300423812 a skos:Concept ;
    skos:definition "Cones of fabric with hoops at the larger end, used as brakes or drags for air- and spacecraft, or similar vehicles or equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drogues"@en .

aat:300423816 a skos:Concept ;
    skos:definition "Large sheets, made of paper, plastic, cloth, or other absorbant material, which are typically spread on or near a painter's workstation to protect the area from unwanted paint drippings or splatter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop cloths"@en .

aat:300423827 a skos:Concept ;
    skos:definition "Devices for removal of magnetic iron metals from inert materials such as foodstuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drum magnets"@en .

aat:300423828 a skos:Concept ;
    skos:definition "Stands onto which drums are placed; many, such as snare drum stands, have adjustable cradles or baskets where the drums rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drum stands"@en .

aat:300423833 a skos:Concept ;
    skos:definition "Mechanical presses that incorporate a heating element that are used to mount drawings, prints, photographs, or other paper-based work to a stiff backing by using a special mounting tissue as an adhesive. The heating element melts the mounting tissue between the print and backing to create a permanent adhesion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry mount presses"@en .

aat:300423835 a skos:Concept ;
    skos:definition "Initially, the term referred to sheets of glass coated with collodion subsequently sensitized and dried. In 1871 Richard Leach Maddox discovered that an emulsion of gelatin containing a sensitive silver salt could be exposed to the action of light in a dry state. This provided a leap forward in photographic media as it simplified the process of taking photographs, avoiding the necessity of plates being prepared immediately before exposure, and processed immediately after."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry plates"@en .

aat:300423869 a skos:Concept ;
    skos:definition "Tall conical paper hats made to be worn by schoolchildren as a form of public humiliation for misbehavior or mistakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dunce caps"@en .

aat:300423874 a skos:Concept ;
    skos:definition "Machines that make prints using a matrix such as a stencil or with a spirit-imbibed sheet that allow ink to bleed through onto a support. The master or matrix is mounted onto a drum containing the ink, which is pushed through the it onto a support, usually paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duplicators"@en .

aat:300423890 a skos:Concept ;
    skos:definition "Cylindrical vessels, typically made of metal such as lead, copper, or iron, used to facilitate the application of color to textile materials. The fabrics to be dyed are placed in the vessel and wet thoroughly with warm water before the colored dye is applied to create a dye bath. These vessels are often large in size to allow fibre bundles to be stock dyed, and are sometimes fitted with racks on which textile materials are hung while submerged in the dye bath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dyeing kettles"@en .

aat:300423912 a skos:Concept ;
    skos:definition "Sound-amplifying devices or speakers worn or held against the ear in order to compensate for impaired hearing, to listen to telephone or radio communication, to listen to music, or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earphones"@en .

aat:300423935 a skos:Concept ;
    skos:definition "Headgear worn by members of a priestly class, not necessarily as part of an array of vestments, but sometimes as indication of rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecclesiastical hats"@en .

aat:300423941 a skos:Concept ;
    skos:definition "Instruments which forecast solar and lunar eclipses across the globe. Two types exist; one invented by Scottish astronomer and mathematician James Ferguson, which incorporates a globe, and the Bibliothèqe Nationale has an example in their collection made by Ole Rømer (1644-1710), which is styled like a planetarium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eclipsareons"@en .

aat:300423942 a skos:Concept ;
    skos:definition "Excavated pieces of evidence consisting of natural remains, rather than an object of human workmanship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecofacts"@en .

aat:300423950 a skos:Concept ;
    skos:definition "Leatherworking tools for rounding off the sharp edges of thick leathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge shaves"@en .

aat:300423954 a skos:Concept ;
    skos:definition "Data cards with notches punched along their edges, representing data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge-notched cards"@en .

aat:300423960 a skos:Concept ;
    skos:definition "Devices for electrical or electronic musical instruments that, when activated, often via a footswitch, add auditory effects to a signal. These are most commonly intended for performing with electric guitars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "effects pedals"@en .

aat:300423963 a skos:Concept ;
    skos:definition "Pumps that enable taking water from a source and depositing it into one or many receptacles based on timing, flow, or other measured parameters such as rainfall, water quality, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "effluent samplers"@en .

aat:300423964 a skos:Concept ;
    skos:definition "Devices for shining a light through eggs to allow an observer to determine the egg's quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg candlers"@en .

aat:300423965 a skos:Concept ;
    skos:definition "Receptacles used for transporting eggs, usually designed to help protect the delicate eggs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg carriers"@en .

aat:300423970 a skos:Concept ;
    skos:definition "Pressurized tools used to create circular perforations in an eggshell to remove interior material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg punches"@en .

aat:300423975 a skos:Concept ;
    skos:definition "Devices used to time the cooking of an egg. May come in a variety of forms, including that of a small hourglass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg timers"@en .

aat:300423976 a skos:Concept ;
    skos:definition "Scissors with toothed blades used to cut the top off of an egg cooked in its shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg toppers"@en .

aat:300423978 a skos:Concept ;
    skos:definition "Any of a number of devices used to clean eggs to ready them for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg washers"@en .

aat:300423981 a skos:Concept ;
    skos:definition "Consumer audio players that specifically play 8-track tapes housed in cartridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eight-track players"@en .

aat:300423984 a skos:Concept ;
    skos:definition "Emergency escape seats for propelling an occupant out and away from an airplane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ejection seats"@en .

aat:300423986 a skos:Concept ;
    skos:definition "Devices for determining the amount of oil contained in any substance, or for the degree of purity of an oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elacometers"@en .

aat:300423988 a skos:Concept ;
    skos:definition "String or rope-like material composed of several strands of twisted or woven fiber that has the capability of being stretched, and that will resume its previous shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elastic cord"@en .

aat:300423995 a skos:Concept ;
    skos:definition "Devices that use electricity to open cans with a rotating blade that cuts around the edge of the can's lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric can openers"@en .

aat:300423998 a skos:Concept ;
    skos:definition "Cookstoves fueled by electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric cookstoves"@en .

aat:300424005 a skos:Concept ;
    skos:definition "Devices with a flat or grated surface, heated via electricity, for cooking food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric grills"@en .

aat:300424008 a skos:Concept ;
    skos:definition "Devices that convert electrical current into heat via an element called an electrical resistor. These are of various design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric heaters"@en .

aat:300424015 a skos:Concept ;
    skos:definition "Enclosed chambers, heated by electricity, for baking food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric ovens"@en .

aat:300424016 a skos:Concept ;
    skos:definition "Heated compartments for warming plates prior to food service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric plate warmers"@en .

aat:300424017 a skos:Concept ;
    skos:definition "Devices that use an electric heating element to pop corn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric poppers"@en .

aat:300424020 a skos:Concept ;
    skos:definition "Electric food mixers that are designed such that the beaters are mounted in a stand that can accomodate a bowl, leaving the user's hands free."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric stand mixers"@en .

aat:300424030 a skos:Concept ;
    skos:definition "Lidded, cylindrical, steel containers, similar to milk cans, used for holding, cooling, and transporting cream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream cans"@en .

aat:300424036 a skos:Concept ;
    skos:definition "Whisks used to agitate cream until it thickens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream whips"@en .

aat:300424058 a skos:Concept ;
    skos:definition "Coverlets of two layers of cloth filled with padding such as down or batting held in place by ties or stitched designs, made in an appropriate size for a child's crib."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crib quilts"@en .

aat:300424059 a skos:Concept ;
    skos:definition "Toys for babies and toddlers specially made to hang in or above a crib. They usually have a suspension system like a mobile or play arch, or can be attached around the edge like a play spiral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crib toys"@en .

aat:300424067 a skos:Concept ;
    skos:definition "Devices used to measure the natural waviness of yarn, which results from the interlacing of the materials' warp and weft. Consisting of two clamps, one fixed in place and the other moveable, these devices fasten yarn in place while exerting tension onto the textile material until it is straightened out. Using the device's tension scale, the user can effectively measure the crimp-free length of the yarn. This measurement is subtracted from the length of the crimped yarn, and the percentage of this difference is expressed as the crimp percentage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crimp testers"@en .

aat:300424073 a skos:Concept ;
    skos:definition "Containers, often made of soft canvas and comprised of multiple fold-out pockets, designed to store loose crochet hooks and other related tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crochet hook cases"@en .

aat:300424099 a skos:Concept ;
    skos:definition "Dart-like projectiles intended to be launched by crossbows. These are generally shorter and have greater weight than arrows shot from bows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crossbow bolts"@en .

aat:300424114 a skos:Concept ;
    skos:definition "Gauges used to measure the size and shape of a tooth or a dental crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental crown gauges"@en .

aat:300424115 a skos:Concept ;
    skos:definition "Presses that were historically used to form hollow metal shells used by a dentist as temporary crowns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental crown presses"@en .

aat:300424118 a skos:Concept ;
    skos:definition "Hand-held tools that were historically used to slit the axial surface of a dental crown to facilitate its removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental crown slitters"@en .

aat:300424137 a skos:Concept ;
    skos:definition "Solid spheres made of transparent quartz crystal or glass. Examples are those used variously by fortune tellers, clairvoyants, and in certain faiths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystal balls"@en .

aat:300424142 a skos:Concept ;
    skos:definition "Rectangular bands, often made of cloth or metal, made to hold cuffs of garments in place. At each end is a button or metal pin to attach the band to the cuff's buttonhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuff holders"@en .

aat:300424151 a skos:Concept ;
    skos:definition "Instruments used to measure the temperature in culinary applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary thermometers"@en .

aat:300424158 a skos:Concept ;
    skos:definition "Apparatuses for culturing cells and samples in sterile environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culture apparatuses"@en .

aat:300424167 a skos:Concept ;
    skos:definition "Devices that distribute individual cups to users from a stored stock of cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup dispensers"@en .

aat:300424168 a skos:Concept ;
    skos:definition "Containers for transporting cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup holders"@en .

aat:300424180 a skos:Concept ;
    skos:definition "Devices used in cheese-making to break up large curds into smaller pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd mills"@en .

aat:300424181 a skos:Concept ;
    skos:definition "Tools used for stirring curds in the process of cheese-making, consisting of a toothed, rake-like bar and a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd rakes"@en .

aat:300424182 a skos:Concept ;
    skos:definition "Implements used in cheese-making to scoop curds out of a curd mill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd scoops"@en .

aat:300424183 a skos:Concept ;
    skos:definition "Large, strainer-like receptacles used for separating curd from whey in the process of cheese-making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd sinks"@en .

aat:300424185 a skos:Concept ;
    skos:definition "Cheese-making implements used for stirring curd, which may take a variety of forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd stirrers"@en .

aat:300424203 a skos:Concept ;
    skos:definition "Any of a variety of hooks, rings, clips, etc. used to hang or secure curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain fasteners"@en .

aat:300424207 a skos:Concept ;
    skos:definition "Ornaments which terminate the ends of rods that support curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain rod finials"@en .

aat:300424209 a skos:Concept ;
    skos:definition "Small pieces of heavy material, often lead, that are inserted into the hems of curtains to keep them hanging straight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain weights"@en .

aat:300424213 a skos:Concept ;
    skos:definition "Sleeves of textile or other material such as plastic, into which upholstered cushions are inserted for protection from soil or wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cushion covers"@en .

aat:300424219 a skos:Concept ;
    skos:definition "Frames with dark slides used to hold flexible photosensitized cut film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut film holders"@en .

aat:300424222 a skos:Concept ;
    skos:definition "Manicure tools used for removing of the dead skin that adheres to the base of fingernails during the nail growth process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuticle knives"@en .

aat:300424225 a skos:Concept ;
    skos:definition "Tools used to shape mixtures of ground meat and other ingredients into \"cutlets\" resembling drumsticks, ham shanks, pork chops, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutlet molds"@en .

aat:300424236 a skos:Concept ;
    skos:definition "Instruments used for measuring the magnitude of the blueness of the sky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyanometers"@en .

aat:300424242 a skos:Concept ;
    skos:definition "Devices that consist of a number of points arranged to revolve about a plane which also rotates in the same direction but a different speed. These are rotated by a crank, and by varying the position of the centers around which the points and plane revolve, and corresponding speeds of rotation, figures such as circles, ovoids, triangles and nephroid forms can be described. The points can be fixed with markers or cutting tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cycloidographs"@en .

aat:300424253 a skos:Concept ;
    skos:definition "Drafting and drawing instruments for copying or tracing the contour of solid objects, such as sculpture profiles and moldings; invented in 1841 by Robert Willis, Cambridge University."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cymographs"@en .

aat:300424262 a skos:Concept ;
    skos:definition "Containers for holding liquid dairy products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dairy cans"@en .

aat:300424263 a skos:Concept ;
    skos:definition "Refrigerators for the purpose of keeping milk and dairy products cool and safe for consumption, usually at a temperature between 32 and 35 degrees Fahrenheit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dairy coolers"@en .

aat:300424265 a skos:Concept ;
    skos:definition "Scales made for weighing dairy products, typically designed to withstand the moisture found in a dairy and having platforms that accomodate large quantities of milk cans, butter, or cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dairy scales"@en .

aat:300424270 a skos:Concept ;
    skos:definition "Items of costume worn below the waist and behind the wearer, specifically while performing sacred or ceremonial dances. The use of this term is most often applied to objects of Native cultures of the Americas, and these are most frequently constructed primarily of feathers arranged in a circular or fanned manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance bustles"@en .

aat:300424274 a skos:Concept ;
    skos:definition "Long poles, often wooden, made for use in ceremonial dances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance staffs"@en .

aat:300424276 a skos:Concept ;
    skos:definition "Spits equipped with an adjustable hook or group of hooks suspended by a cord, the winding and unwinding of which provides the turning movement, assisted by two fly weights at the top of a metal stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dangle-spits"@en .

aat:300424280 a skos:Concept ;
    skos:definition "Devices used to secure photographic paper as it is being exposed to light in a darkroom or elsewhere. Often these have movable elements that accommodate varied sizes of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darkroom easels"@en .

aat:300424281 a skos:Concept ;
    skos:definition "Thermometers designed for use in photographic darkrooms. These come in various forms, but usually have marks indicating optimal temperatures for developer, and are meant to be submerged in liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darkroom thermometers"@en .

aat:300424282 a skos:Concept ;
    skos:definition "Timing devices used in darkroom work, designed so that safelights and enlargers may be plugged into them to time exposures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darkroom timers"@en .

aat:300424283 a skos:Concept ;
    skos:definition "Tongs for photographic darkroom work that are intended to move paper or film from one chemical to another without touching with the hand. These are normally obtained in sets of three to keep within the trays for developer, stop, and fixer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darkroom tongs"@en .

aat:300424284 a skos:Concept ;
    skos:definition "Shallow trays made of various materials including plastic or enameled metal used to hold photographic chemicals, most often developer, stop, and fixer for processing sensitized paper or film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darkroom trays"@en .

aat:300424285 a skos:Concept ;
    skos:definition "Small planks or boards on which material is mended with thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darning boards"@en .

aat:300424289 a skos:Concept ;
    skos:definition "Sets consisting of a dart board and darts or arrows. The game is played by throwing the darts at the dart board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dart games"@en .

aat:300424294 a skos:Concept ;
    skos:definition "General term for types of computer cables or bound optical fibres, which are used to transmit data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data cables"@en .

aat:300424295 a skos:Concept ;
    skos:definition "Cards that contain manually or mechanically recorded data; used historically with information processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data cards"@en .

aat:300424297 a skos:Concept ;
    skos:definition "Devices whose purpose it is to convert data. May include devices for early computing and data processing, including card-to-tape converters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data converters"@en .

aat:300424301 a skos:Concept ;
    skos:definition "Panels with numerous electrical sockets that are used for cables that transmit data, both incoming and outgoing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data patch panels"@en .

aat:300424306 a skos:Concept ;
    skos:definition "Data entry devices used to produce punched cards, which enabled the input of data into early computers. These consisted of a keyboard and a mechanism to punch holes in cards in corresponding positions, representing alphanumeric symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data punches"@en .

aat:300424308 a skos:Concept ;
    skos:definition "Devices that receive electronic data packets and routes them to the appropriate computer systems or networks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "routers"@en .

aat:300424310 a skos:Concept ;
    skos:definition "Software that is used to search, retrieve, and manipulate structured sets of data held in computer storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "database software"@en .

aat:300424313 a skos:Concept ;
    skos:definition "Tools used to affix dates to surfaces using ink and a rubber medium. The rubber stamps are often on a rotating wheel to allow for a variety of dates to stamped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "date stamps"@en .

aat:300424320 a skos:Concept ;
    skos:definition "Informal garments made of breathable material, designed to allow their wearers unhindered leg mobility. Typical attire for walking, working, or engaging in other daytime activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day dresses"@en .

aat:300424323 a skos:Concept ;
    skos:definition "Color correction filters used to compensate for the temperature of the prevailing light for photography. These filters adjust the orange-yellow quality of tungsten lighting to match the blue of daylight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daylight filters"@en .

aat:300424327 a skos:Concept ;
    skos:definition "Nautical devices for the standing and running rigging of traditional sailing ships consisting of circular, laterally flattened wooden blocks with a groove around the circumference, pierced with holes through which a lanyard is reeved, used for tightening or extending shrouds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deadeyes"@en .

aat:300424332 a skos:Concept ;
    skos:definition "Folkloric objects associated with Appalachia. These are rounded clumps found inside feather pillows that are created by feathers that have formed into a halo shape. Death crowns mark the passing of a loved one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "death crowns"@en .

aat:300424344 a skos:Concept ;
    skos:definition "Ceramic, silver, or enamel plates, usually engraved, attached to decanters via chain loops. Used to identify the contents of a decanter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decanter labels"@en .

aat:300424348 a skos:Concept ;
    skos:definition "Mechanized devices designed to facilitate maximum shrink-resistance in woolen cloth by exposing the material to a steam atmosphere under controlled pressure. These devices are comprised of hot cylindrical drums around which the woolen cloth is continuously wound with minimum tension while being rotated and sprayed with atomized steam or hot water. Through this process, these devices ensure that the woolen materials experience maximum shrinkage thus preventing further shrinkage during subsequent processing and wearing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decating machines"@en .

aat:300424362 a skos:Concept ;
    skos:definition "Devices that decode data; may also be devices with any number of input lines that carry signals and output lines with up to one carrying a signal, creating a one-to-one correspondence between output and input signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decoders"@en .

aat:300424365 a skos:Concept ;
    skos:definition "Vessels used primarily for ornamental purposes, made of varied material such as glass or ceramic and often decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative bowls"@en .

aat:300424367 a skos:Concept ;
    skos:definition "Figurative dolls used for ornamental purposes, not for play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative dolls"@en .

aat:300424369 a skos:Concept ;
    skos:definition "Cylindrical, flat-bottomed vessels that are used for ornamental purposes, not for drinking. Made of various materials, often with decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative mugs"@en .

aat:300424379 a skos:Concept ;
    skos:definition "Instruments for measuring the temperature of oil or another fat heated for the purpose of deep-frying foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep frying thermometers"@en .

aat:300424387 a skos:Concept ;
    skos:definition "Implements used for removing meat from the bone to which it is attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defleshers"@en .

aat:300424393 a skos:Concept ;
    skos:definition "Laboratory baths that are used to dehydrate specimens or tissues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dehydrating baths"@en .

aat:300424408 a skos:Concept ;
    skos:definition "General term for accessories and instruments used for dental procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental accessories"@en .

aat:300424409 a skos:Concept ;
    skos:definition "Trays used to hold instruments required by a dentist during procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental accessory trays"@en .

aat:300424410 a skos:Concept ;
    skos:definition "Anvils used to form and shape dental appliances or to make dental tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental anvils"@en .

aat:300424411 a skos:Concept ;
    skos:definition "Instruments in the form of a brush or other shape used to apply etchants, sealants, bonding agents, hemostatic agents, or other materials to teeth or dental work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental applicators"@en .

aat:300424412 a skos:Concept ;
    skos:definition "Instruments that allow the dentist to simulate the relationship of the temporomandibular joint with the jaws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental articulators"@en .

aat:300424413 a skos:Concept ;
    skos:definition "Bands or small rings attached to teeth and used to secure or adjust during orthodontics, or otherwise to position dental work in the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental bands"@en .

aat:300424414 a skos:Concept ;
    skos:definition "Bibs placed below the chin during dental procedures to protect the patient's clothing and to maintain a sterile barrier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental bibs"@en .

aat:300424415 a skos:Concept ;
    skos:definition "Surgical blades specially made for dental procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental blades"@en .

aat:300424416 a skos:Concept ;
    skos:definition "Devices of various designs that are applied to the teeth, used in orthodontics to align and straighten teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental braces"@en .

aat:300424417 a skos:Concept ;
    skos:definition "Brackets used on a fixed orthodontic appliance to secure wires and archwires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental brackets"@en .

aat:300424418 a skos:Concept ;
    skos:definition "Devices used in the mouth to replace lost natural teeth by means of substitutes attached to and held in position by some fo the remaining teeth or roots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental bridges"@en .

aat:300424419 a skos:Concept ;
    skos:definition "Small, wire-like instruments used for cleaning out a root canal, for removing the devitalized pulp, or other purposes; the instrument may be smooth or barbed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental broaches"@en .

aat:300424420 a skos:Concept ;
    skos:definition "Cutting instruments designed to fit in a dental handpiece; may be made from hardened steel, stainless steel, tungsten carbide, or coated with diamond particles, may have straight or parallel surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental burs"@en .

aat:300424421 a skos:Concept ;
    skos:definition "Handpieces designed to hold a dental bur, which is a cutting device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental bur holders"@en .

aat:300424422 a skos:Concept ;
    skos:definition "Instruments for finishng an amalgam for filling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental burnishers"@en .

aat:300424424 a skos:Concept ;
    skos:definition "Dental instruments having a sharp-edged working end, specialized for removing excess materia, contouring surfaces, and carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental carvers"@en .

aat:300424425 a skos:Concept ;
    skos:definition "Cases designed to organize and carry dental instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental cases"@en .

aat:300424426 a skos:Concept ;
    skos:definition "Casts made for dental work, particularly dental molds or dental models, forming a positive reproduction of a patient's teeth obtained from a dental impression; may also refer to other casts, such as historically to casts made for gold fillings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental casts"@en .

aat:300424427 a skos:Concept ;
    skos:definition "Machines or devices for mixing casting materials for dental casts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental casting mixers"@en .

aat:300424428 a skos:Concept ;
    skos:definition "Matrix for shaping materials for a dental cast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental casting molds"@en .

aat:300424429 a skos:Concept ;
    skos:definition "Hand instruments designed for cleaving bone or enamel; typically bevelled on one side only; the shank may be straight or angled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental chisels"@en .

aat:300424430 a skos:Concept ;
    skos:definition "Dental surgical clamping devices used to achieve compression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental clamps"@en .

aat:300424431 a skos:Concept ;
    skos:definition "Air compressors designed to run dental devices; produces high-quality, high-pressure air, which runs through specialized lines.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental compressors"@en .

aat:300424432 a skos:Concept ;
    skos:definition "Tooth-shaped caps that restore a decayed, broken, weak, or worn-down tooth; the caps are placed over a natural tooth or part of a tooth, to replace the crown of the tooth, which is the exposed portion of the tooth above the gum line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental crowns"@en .

aat:300424433 a skos:Concept ;
    skos:definition "Cups used for rinsing the mouth in a dental office or at home when brushing teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental cups"@en .

aat:300424434 a skos:Concept ;
    skos:definition "Dental equipment incorporating a bulb or lamp that is used for polymerization of light-cure resin-based composites, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental curing lights"@en .

aat:300424435 a skos:Concept ;
    skos:definition "Appliances comprising a thin sheet of rubber, pierced by a dental dam punch to allow the crowns of one or more teeth to protrude, with the purpose to provide moisture control, operator visibility, and hygienic conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental dams"@en .

aat:300424436 a skos:Concept ;
    skos:definition "Devices designed to reduce the presence of fluids and dehydrate the mouth for a dental procedure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental dehydrators"@en .

aat:300424437 a skos:Concept ;
    skos:definition "Devices used to organize and distribute dental materials, including cotton rolls, cotton balls, or other small items used during dental procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental dispensers"@en .

aat:300424438 a skos:Concept ;
    skos:definition "Rotary instruments used to remove tooth substance, particularly in the treatment of caries. Historically, the drill was hand-operated or pedal-driven. Modern dental drills operate by an electric motor; they consist of a dental handpiece that may be fitted with variously shaped burs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental drills"@en .

aat:300424439 a skos:Concept ;
    skos:definition "Instruments used in dental extractions to loosen teeth prior to forceps extraction; they may be used to remove roots or impacted teeth, when teeth are badly compromised, or when teeth are malpositioned and cannot be reached with forceps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental elevators"@en .

aat:300424440 a skos:Concept ;
    skos:definition "General term referring to the combination of all the electric, pneumatic, and other power sources used to operate the dentist's tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental engines"@en .

aat:300424441 a skos:Concept ;
    skos:definition "Organizers, tubs, cases, and other containers or spaces for holding and storing dental equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental equipment holders"@en .

aat:300424442 a skos:Concept ;
    skos:definition "Equipment including a motor and a variety of handpieces and tips, using air and suction to dry and clean the mouth of saliva and debris during dental procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental evacuators"@en .

aat:300424443 a skos:Concept ;
    skos:definition "Specialized instruments designed to remove carious dentin from the tooth surface. Typically is a double-ended instrument with an angled working-end, shaped to access the problematic parts of the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental excavators"@en .

aat:300424444 a skos:Concept ;
    skos:definition "Diagnostic tools, typically having a hook on one end for caries detection and a an angled probe on the other end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental explorers"@en .

aat:300424446 a skos:Concept ;
    skos:definition "Files used in dental work, including files used by hand or rotary files mounted in a dental handpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental files"@en .

aat:300424450 a skos:Concept ;
    skos:definition "Thread-like material often coated with wax or other substances that is designed to be drawn between the teeth for cleaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental floss"@en .

aat:300424454 a skos:Concept ;
    skos:definition "Dental equipment for holding a dental bur or file. Usually made of corrosion-resistant materials to allow sterilization; may be high-speed or low-speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental handpieces"@en .

aat:300424473 a skos:Concept ;
    skos:definition "Artificial replacements for teeth, whether or not they are permanently anchored in the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental prostheses"@en .

aat:300424495 a skos:Concept ;
    skos:definition "Semicircle-shaped, lidded containers, often made of plastic or other lightweight materials, made to contain dentures when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denture cases"@en .

aat:300424500 a skos:Concept ;
    skos:definition "Conveyance components that are comprised of a sloping channel culminated in a slot for the placement of objects or materials that are then deposited to a receptacle for collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deposit chutes"@en .

aat:300424514 a skos:Concept ;
    skos:definition "Table surface covers used to protect a table or desktop, originally used also to absorb wet ink from writing materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desk blotters"@en .

aat:300424516 a skos:Concept ;
    skos:definition "Pads of leather, plastic, or other materials that rest on the surface of a desk to protect it from marring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desk covers"@en .

aat:300424518 a skos:Concept ;
    skos:definition "Storage containers made to hold various office supplies, often kept on desks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desk organizers"@en .

aat:300424519 a skos:Concept ;
    skos:definition "Flat mats placed on desks or other writing surfaces, both to protect the surface and to facilitate writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desk pads"@en .

aat:300424523 a skos:Concept ;
    skos:definition "Calculators that are specifically designed to fit into an office environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desktop calculators"@en .

aat:300424524 a skos:Concept ;
    skos:definition "Microcomputers (or minicomputers) that are specifically designed to fit into an office environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desktop computers"@en .

aat:300424538 a skos:Concept ;
    skos:definition "Component of a complete round of ammunition or use in detonating an explosive charge, that ignites the propellant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detonation primers"@en .

aat:300424540 a skos:Concept ;
    skos:definition "Chemical agents used to develop latent images in photosensitive materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developer"@en .

aat:300424541 a skos:Concept ;
    skos:definition "Chemistry in dry granulated form for developing sensitized photographic materials. Generally this is mixed with water to create an aqueous solution, or very rarely used in its dry state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developing powder"@en .

aat:300424544 a skos:Concept ;
    skos:definition "Small cards, often made of cardboard or paper, with religious graphics or text located on one side. Pre-19th century cards often used watercolor or paint while those created during and after the 1800s used printed imagery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional cards"@en .

aat:300424546 a skos:Concept ;
    skos:definition "Games in which wins or losses depend on the motor dexterity of the player."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dexterity games"@en .

aat:300424547 a skos:Concept ;
    skos:definition "Games in which hands or fingers manipulate objects, often one or more balls or rings in a cavity, a recess, or around a stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dexterity puzzles"@en .

aat:300424548 a skos:Concept ;
    skos:definition "Toys and games that require dexterity and practice. Dexterity toys often involve a physical activity, such as hula hooping, juggling, and jumping rope or can involve precision and aiming such as shooting games, marbles and throwing games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dexterity toys"@en .

aat:300424553 a skos:Concept ;
    skos:definition "Software used to increase system reliability by performing analyses that find and often correct hardware or software faults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagnostic software"@en .

aat:300424558 a skos:Concept ;
    skos:definition "Waterproof outer layers that are worn over an absorbent cloth diaper. These usually have the appearance of brief-style underwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaper covers"@en .

aat:300424573 a skos:Concept ;
    skos:definition "Various models of machines that are used for the recording of human speech for transcription purposes (such as Dictaphones)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictating machines"@en .

aat:300424574 a skos:Concept ;
    skos:definition "Devices used to shave off thin layers of wax from wax cylinders that have been previously used in dictating machines, so that they may be re-used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictating machine shavers"@en .

aat:300424580 a skos:Concept ;
    skos:definition "Machines that cut metal or paper dies; they may be flat-bed die cutters, where dies are cut with a reciprocating motion, or rotary die cutters where dies have circular shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "die cutting machines"@en .

aat:300424588 a skos:Concept ;
    skos:definition "Calculating machines, now historic, that were able to produce tables of values for arithmetic functions. The machine was designed by English inventor and engineer Charles Babbage in 1822, and a working model was built in 1853 by George and Edward Scheutz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "difference engines"@en .

aat:300424590 a skos:Concept ;
    skos:definition "Analog computers, comprised of mechanical components, that were designed to solve differential equations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "differential analyzers"@en .

aat:300424591 a skos:Concept ;
    skos:definition "Devices for measuring rates of diffusion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffusiometers"@en .

aat:300424601 a skos:Concept ;
    skos:definition "Data processors that operate on digital input rather than continuously variable data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital data processors"@en .

aat:300424606 a skos:Concept ;
    skos:definition "Cases specifically used to protect and transport digital videodiscs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital videodisc cases"@en .

aat:300424608 a skos:Concept ;
    skos:definition "Timepieces, often worn on the wrist, which display information in the form of individual numerical digits rather than using hands or pointers on a dial, typically by means of an LED or liquid crystal display, or by any other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital watches"@en .

aat:300424609 a skos:Concept ;
    skos:definition "Devices that convert digital input signals to analog output signals, with the resulting output signals representing the same information contained in the input signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital-to-analog converters"@en .

aat:300424626 a skos:Concept ;
    skos:definition "Bells that are rung at a specific time to announce dinner, historically used on ships, in hotels, or in homes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinner bells"@en .

aat:300424628 a skos:Concept ;
    skos:definition "Horns that are used to announce mealtimes, usually on farms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinner horns"@en .

aat:300424639 a skos:Concept ;
    skos:definition "Instruments used to determine the meridian transits of celestial bodies by joining two reflected images from triangular prisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dipleidoscopes"@en .

aat:300424647 a skos:Concept ;
    skos:definition "Amplifiers in which small electrical currents and voltages are amplified before they can operate devices, where the current flows in one direction, rather than with alternating current in which the direction of the flow of electrons switches back and forth at regular intervals or cycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct current amplifiers"@en .

aat:300424661 a skos:Concept ;
    skos:definition "Wheeled carts with trays or receptacles for transporting dishes of food for service, or for transporting clean or dirty dishes during the course of kitchen work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dish carts"@en .

aat:300424678 a skos:Concept ;
    skos:definition "Devices used to separate crop seeds by size. Used for sorting mixed seeds of different sizes or to separate broken or low-quality seeds from high-quality seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disk separators"@en .

aat:300424679 a skos:Concept ;
    skos:definition "Sleeves that protect computer disks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disk sleeves"@en .

aat:300424681 a skos:Concept ;
    skos:definition "Cases specifically used to protect and transport floppy disks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diskette cases"@en .

aat:300424695 a skos:Concept ;
    skos:definition "Tables intended for the display of merchandise in a commercial or marketplace setting or of elements of a private collection in a domestic setting. These may have multiple tiers, or glass tops over compartments for storage or view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display tables"@en .

aat:300424699 a skos:Concept ;
    skos:definition "Handwear made to be discarded after use, such as in medical or preservation contexts. Commonly made of nitrile or latex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disposable gloves"@en .

aat:300424702 a skos:Concept ;
    skos:definition "Cotton-filled mattresses used on the floor or in a frame as a beds, couches, or chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "futons"@en .

aat:300424719 a skos:Concept ;
    skos:definition "Iron hooks or spars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaffs"@en .

aat:300424722 a skos:Concept ;
    skos:definition "Instruments use to determine the fat content of milk by measuring their specific gravity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galactometers"@en .

aat:300424723 a skos:Concept ;
    skos:definition "Refracting telescopes named after the telescope Galileo first constructed in 1609. Galilean telescopes are each designed with one convergent and one concave, or divergent, lens, with the divergent lens acting as the ocular lens, and the convergent lens as the objective lens that creates the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galilean telescopes"@en .

aat:300424731 a skos:Concept ;
    skos:definition "Cavity resonators designed such that a nozzle with an annular slit is located at the exit of the nozzle near a cavity a short distance away. Air blown through the slit passes over a circular knife edge at the near end of the cavity. A micrometer is used to adjust the depth of the cavity and another adjusts the distance between the slit and knife edge. The device makes it possible to generate ultrasound in air over a wide range of frequencies. Named for Sir Francis Galton who invented it in the mid 1800s to test human and animal hearing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galton whistles"@en .

aat:300424739 a skos:Concept ;
    skos:definition "Butchers' tools consisting of curved rods of wood or iron used to support a carcass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gambrels"@en .

aat:300424760 a skos:Concept ;
    skos:definition "Software used to play computer and video games; the software may be locally installed or applications played via the internet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaming software"@en .

aat:300424765 a skos:Concept ;
    skos:definition "Devices that punch identical data into decks of punch cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gang punches"@en .

aat:300424779 a skos:Concept ;
    skos:definition "General term for landscaping, structures, water features, and other built works in a garden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden features"@en .

aat:300424807 a skos:Concept ;
    skos:definition "Interior components of garments stitched inside clothing to provide support and warmth, or simply as a finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garment linings"@en .

aat:300424811 a skos:Concept ;
    skos:definition "Mechanized processing machines designed to convert textile waste or cheap raw materials into usable fibers for yarn spinning and other textile applications. Strongly resembling carding machines, these devices are made of large metal cylinders with fine spiral grooves cut into their surfaces; rigid blades are wound into the groves. Carding elements, such as wire teeth or rollers, can also be mounted to the surface of the cylinders in lieu of the grooves and blades. As the cylinders rotate, raw or scrap materials are fed into the device. The carding elements or blades on the rotating cylinders work to open, separate, and align the materials' fibers, removing impurities and creating a uniform batt of fibers. These devices provide a sustainable solution for recycling textile waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garnett machines"@en .

aat:300424820 a skos:Concept ;
    skos:definition "Devices that measure the concentration or quality of specific gaseous compounds within a mixture of multiple gases, to register qualitatively the proportions of gas within a system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas analyzers"@en .

aat:300424822 a skos:Concept ;
    skos:definition "Cookstoves fueled by gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas cookstoves"@en .

aat:300424826 a skos:Concept ;
    skos:definition "Cooking devices consisting of a rack or grille positioned over a gas flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas grills"@en .

aat:300424827 a skos:Concept ;
    skos:definition "Various contrivances for imparting heat that burn natural gas, propane, or other types of gas as fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas heaters"@en .

aat:300424860 a skos:Concept ;
    skos:definition "Calf-length fashion pants with flared legs, inspired by the traditional garments worn by the cowboys of the South American pampas. For the baggy pants worn by South American cowboys, see \"bombachas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauchos"@en .

aat:300424865 a skos:Concept ;
    skos:definition "Circular, flat-sided bases, often made of wood; used in conjunction with gavels to communicate particular actions or to gather attention; accomplished by striking the gavel block with the mallet. Examples of use include court proceedings or auctions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gavel blocks"@en .

aat:300424876 a skos:Concept ;
    skos:definition "Roller ball or ball-point writing implements that use an ink that suspends pigment in a water-based gel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gel pens"@en .

aat:300424877 a skos:Concept ;
    skos:definition "Hollow, decoratively shaped forms into which warm gelatin is poured to cool to create a gelatin dessert in the same shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin molds"@en .

aat:300424883 a skos:Concept ;
    skos:definition "Black gowns worn by ministers of the Protestant church. These are loose fitting garments with bell sleeves, sometimes embellished with velvet to indicate academic achievement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geneva gowns"@en .

aat:300424886 a skos:Concept ;
    skos:definition "Globes that are both celestial and terrestrial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geodescopes"@en .

aat:300424891 a skos:Concept ;
    skos:definition "Three-dimensional polyhedra meant to illustrate or demonstrate mathematical or geometric principles, or as models for drawing exercises. These are normally in sets containing various solids such as cones, spheres, cubes, cylinders, triangular pyramids, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometric models"@en .

aat:300424892 a skos:Concept ;
    skos:definition "This instrument functions as a seismograph. It consists of a cast-iron ring suspended by a lead weight, which is fastened with a single bolt through two metal disks and rubber tubes that must be connected to stethoscope earpieces to hear sounds transmitted through the earth. The geophone needs to be placed on the ground to receive the energy transmitted as wave motion through the earth. It then transforms the seismic waves of the ground into sound waves, which can be heard through the earpieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geophones"@en .

aat:300424895 a skos:Concept ;
    skos:definition "Boxes where seeds are sprouted to determine the amount of seeds able to grow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "germination boxes"@en .

aat:300424896 a skos:Concept ;
    skos:definition "Devices in which seeds are sprouted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "germinators"@en .

aat:300424897 a skos:Concept ;
    skos:definition "Greeting cards that express concern and well wishes for the health of the recipient."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "get well cards"@en .

aat:300424901 a skos:Concept ;
    skos:definition "Containers of varying material (often paper or plastic) used to hold gifts. Usually have handles and are large enough to obscure the gift inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift bags"@en .

aat:300424902 a skos:Concept ;
    skos:definition "Ribbons, made of fabric, paper, or plastic, used to decorate gifts and gift containers. Tied in knots with two loops and two ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift bows"@en .

aat:300424903 a skos:Concept ;
    skos:definition "Containers made and used to hold gifts. Sometimes decorated with ribbons, bows, or other elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift boxes"@en .

aat:300424905 a skos:Concept ;
    skos:definition "Labels attached to gifts providing information about the receiver and the giver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift tags"@en .

aat:300424907 a skos:Concept ;
    skos:definition "Strips of fabric or colored plastic used to decorate gifts, usually wrapped around the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift wrap ribbon"@en .

aat:300424910 a skos:Concept ;
    skos:definition "Mechanized finishing devices designed to raise the nap of woven fabrics by brushing the surface of the fabrics with teasel heads. To automate the teasing process, these devices comprise a large quantity of prickly teasles fastened to iron frames and attached to two drums. The drums rotate as woolen fabrics are fed between them, drawing out the ends of the fibers and producing a fuzzy finish to the fabric's surface. The teasing process accomplished by these devices represents one of the final processes in woolen cloth production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gigging machines"@en .

aat:300424914 a skos:Concept ;
    skos:definition "Mechanized devices designed to arrange worsted wool fibers in parallel order, eliminate minor impurities in the wool, and ensure that the fibers are blended uniformly. While these devices can come in many forms, they are typically composed of a pair of feed rollers and a series of moving pins or combs which act upon the wool in a combing action. The wool is first feed onto the feed rollers and is then carried through the pins and combs, which arrange and blend the fibers at rapid speeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gill boxes"@en .

aat:300424916 a skos:Concept ;
    skos:definition "Devices which use a penetration test to measure the difference between initial and final setting times of cements and mortars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gillmore needles"@en .

aat:300424977 a skos:Concept ;
    skos:definition "Bookbinding machines used to glue various portions of a book together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gluing machines"@en .

aat:300425007 a skos:Concept ;
    skos:definition "Percussion beaters specifically used to strike gongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gong mallets"@en .

aat:300425013 a skos:Concept ;
    skos:definition "Pendants made of shell, stone, or metal, often having pierced holes that allow them to be strung on cords and hung from the neck. These may be found in Native American cultures where they are symbols of status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorget pendants"@en .

aat:300425015 a skos:Concept ;
    skos:definition "Mechanized devices, originally patened in 1826 by John Goulding, used as part of the carding process to produce a continuous wool roving. These devices utilize a ring doffer and revolving tubes to separate carded wool into strips and twist the strips enough to ensure that the fibers adhere in a tubular form. These condensers benefit the carding process by both eliminating the need to piece together individual lengths of carded fibers and producing more uniform, higher quality roving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goulding condensers"@en .

aat:300425024 a skos:Concept ;
    skos:definition "Dental hygiene devices, usually battery operated, fitted with a vibrating or oscillating brush for cleaning teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric toothbrushes"@en .

aat:300425025 a skos:Concept ;
    skos:definition "Typewriters, the movement of which is governed by electrical power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric typewriters"@en .

aat:300425056 a skos:Concept ;
    skos:definition "A class of electronic devices that alter the sound of a musical instrument or another electronic audio source through audio signal processing. These are most commonly used either in recording or performance contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic effects devices"@en .

aat:300425059 a skos:Concept ;
    skos:definition "Electronic instruments in the form of keyboards that either play a limited number of sounds, often those that mimic acoustic pianos or similar instruments, or that make no sound themselves, but are intended to trigger other devices through control voltage, MIDI, or other means. For electronic instruments that shape or form a great variety of sound wholly from electronic signals, either from analog circuitry or through digital means, and that may or may not have an integral keyboard, use 'synthesizers.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic keyboards"@en .

aat:300425061 a skos:Concept ;
    skos:definition "Hand-held electronic devices, usually in the form of a tablet computer that allow the user to access text files for long-form reading such as periodicals or entire books. The formatting of text often conforms to the paradigm of a physical book, though there are varied methods of presentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "e-readers"@en .

aat:300425062 a skos:Concept ;
    skos:definition "Timepieces, usually worn on the wrist, that are powered with a \"resonance drive,\" in which a tiny tuning fork driven electrically provides the motive power. First produced in 1953, the resonance drive type, properly called an electronic watch maintains accuracy since it operates at a frequency higher than that customarily used with balance-type watches. When the battery is too weak to operate the tuning fork, the watch simply stops, without deterioration. Power is provided by miniature high-energy-density batteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic watches"@en .

aat:300425063 a skos:Concept ;
    skos:definition "Instruments for detecting an electrical charge on an object, and that indicate its magnitude based on the mutual attraction or repulsion of metal leaves or plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroscopes"@en .

aat:300425064 a skos:Concept ;
    skos:definition "Machines for the production of electrical discharge at high voltage. These commonly consist of an insulated hollow conducting sphere that accumulates in its interior the charge continuously conveyed from a source of direct current by a belt of flexible nonconducting material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrostatic generators"@en .

aat:300425073 a skos:Concept ;
    skos:definition "Equipment used for low-impact cardiovascular exercises. Consists of a base where two rotating platforms are attached and a handlebar; users use their feet to move the platforms and the handlebar for balance or added arm exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elliptical machines"@en .

aat:300425074 a skos:Concept ;
    skos:definition "Software used to send and receive email; this includes software that may be locally installed on hard drives, or may run through web browsers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "email software"@en .

aat:300425079 a skos:Concept ;
    skos:definition "Laboratory baths that are used to enclose specimens or tissues in a mass using an embedding medium, such as paraffin wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embedding baths"@en .

aat:300425080 a skos:Concept ;
    skos:definition "Hand-held implements used for carrying hot embers, usually comprised of a handle attached to a lidded dish, box, or other type of vessel made of brass or other metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ember carriers"@en .

aat:300425082 a skos:Concept ;
    skos:definition "Devices that with a mould or stamp create concave or convex areas in a surface, often paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossers"@en .

aat:300425083 a skos:Concept ;
    skos:definition "Textile finishing devices, comprising two or more metal rollers, designed to embed figure effects, patterns, or designs onto the surface of a fabric. The embossing effect occurs as fabric materials are fed between the device's upper engraved steel roll and lower composition roll, the latter of which is inscribed with a negative pattern of the upper roll design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossing calenders"@en .

aat:300425084 a skos:Concept ;
    skos:definition "Media, usually made of metal, incised with images or writing. Used to create prints by pressing the plate into the surface, leaving a relief of the incised image or writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossing plates"@en .

aat:300425088 a skos:Concept ;
    skos:definition "Holding devices or structures, typically made of wood, plastic, metal, or other similarly durable materials, designed to keep fabric taut and secure for embroidery and other needleworking tasks. These devices often comprise sets of laterally moveable bars, on which strips of webbing are nailed and to which the work is sewn, as well as sets of stationary bars with holes pierced at regular intervals for receiving pegs, clamps, or pins to keep the parts in place. These devices are often used in conjunction with fixed stands or trestles to hold them upright for easy use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidery frames"@en .

aat:300425089 a skos:Concept ;
    skos:definition "Two circles of wood, metal or plastic that fit one inside the other, and that can be tightened with fabric stretched over the inner hoop to keep it taught while being worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidery hoops"@en .

aat:300425090 a skos:Concept ;
    skos:definition "Machines that are intended to produce decorative patterns on textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidery machines"@en .

aat:300425091 a skos:Concept ;
    skos:definition "Embroidery needles have sharp tips and larger eyes than regular sewing needles, so the eye can accommodate embroidery threads. The sharp tips help the needle penetrate tightly woven embroidery fabrics, as well as felt. They are also sometimes referred to as crewel needles as they are used for crewel embroidery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidery needles"@en .

aat:300425092 a skos:Concept ;
    skos:definition "Hand-held tools designed to facilitate detailed stitching of embroidery floss, thin yarn, ribbon or other fine threaded materials, often for embellishment purposes. These tools comprise a perforated metal tip and a hollow channel through which the thread or yarn runs, mounted on a handle for easy gripping. Due to its sharp needle, this tool effectively pierces most tight-weave fabrics. After piercing thread or yarn through tight-weave fabric backing material, the tool's perforated tip leaves a loop of thread remaining on the backside of the fabric to create aesthetic patterns and designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidery punches"@en .

aat:300425097 a skos:Concept ;
    skos:definition "Slender pieces of board covered with emery, a coarse variety of corundum, used as an abrasive file most commonly for fingernails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emery board"@en .

aat:300425101 a skos:Concept ;
    skos:definition "Devices that encode data; in early computing, refers to devices that have input lines (one of which carries signals), and output lines (any of which may carry signals)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encoders"@en .

aat:300425102 a skos:Concept ;
    skos:definition "Typewriters whereby computer operators can monitor system and program operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encoding typewriters"@en .

aat:300425121 a skos:Concept ;
    skos:definition "Blocks of material that are carved or incised with designs; these designs are later impressed onto paper or other mediums to create a reverse of the carved image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engraving blocks"@en .

aat:300425136 a skos:Concept ;
    skos:definition "Lidded containers made to store epaulets; some are deep, rectangular boxes while others are formed in a bow-tie shape so that the epaulets can lay flat when stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epaulet cases"@en .

aat:300425140 a skos:Concept ;
    skos:definition "Telescopes that are mounted with one axis pointed toward the celestial pole, and the second axis parallel to the earth’s equator, allowing the telescopes to follow a celestial body by moving along the polar axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equatorial telescopes"@en .

aat:300425161 a skos:Concept ;
    skos:definition "Utensils used to prepare printing surfaces by incising designs on the matrix surface. Also used to subtract tones and layers from photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etching knives"@en .

aat:300425163 a skos:Concept ;
    skos:definition "Surfaces used as supports for etching; users place their work on the tables for stability while working."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etching tables"@en .

aat:300425175 a skos:Concept ;
    skos:definition "Coverings for the hand, worn as formal wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening gloves"@en .

aat:300425177 a skos:Concept ;
    skos:definition "Sets of two or more garments, made from worsted, broadcloth, or other high-quality material, commonly worn for formal functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening suits"@en .

aat:300425193 a skos:Concept ;
    skos:definition "Balls used for exercise routines, usually made of plastic or other flexible material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exercise balls"@en .

aat:300425194 a skos:Concept ;
    skos:definition "General term for equipment used for various kinds of health exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exercise machines"@en .

aat:300425195 a skos:Concept ;
    skos:definition "Rectangular, padded floor coverings used to provide a barrier between the floor and the user; used for exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exercise mats"@en .

aat:300425196 a skos:Concept ;
    skos:definition "Exercise equipment comprised of at minimum one pulley, one rope, and handles attached to each end of the rope; some contain two or more pulley systems. Pulleys are located at a point above the user, such as a doorway or a bar on an excercise machine. The user then pulls on the equipments' handles to engage in exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exercise pulleys"@en .

aat:300425199 a skos:Concept ;
    skos:definition "Equipment used for physical exercise, consisting of a flat, horizontal platform with a rotating band or two flat, rotating steps to create a continous path for the user to walk on. Some also include handles to provide stability for the user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exercise treadmills"@en .

aat:300425229 a skos:Concept ;
    skos:definition "Lengths of linked chain or beads or other material, designed to be fastened to the arms of eyeglasses so that they may be worn around the neck when not being used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyeglass chains"@en .

aat:300425230 a skos:Concept ;
    skos:definition "Objects or textiles specifically designed to clean eyeglasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyeglass cleaners"@en .

aat:300425233 a skos:Concept ;
    skos:definition "Manually or electrically powered devices that punch small round holes in leather or cloth, and that set a reinforcing ring insert for laces, string, rope, rings, or the like to pass through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyelet machines"@en .

aat:300425235 a skos:Concept ;
    skos:definition "Makeup used to emphasize the contour of the eyes, coming in many forms, most commonly a pencil or a brushed-on liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyeliner"@en .

aat:300425237 a skos:Concept ;
    skos:definition "Cosmetic creams or powders that come in various colors that are applied to the eyelids or brows to accent the eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyeshadow"@en .

aat:300425238 a skos:Concept ;
    skos:definition "Printing blocks, often made of wood, with one face cut into the shape of the desired motif; used for creating printed fabric. The cut surface is layered with ink and then pressed onto fabric to create the print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric blocks"@en .

aat:300425239 a skos:Concept ;
    skos:definition "Hand-held tools, typically comprising one or more rotary blades or other types of blades, used to trim manufactured fibers, yarn, pile loops, or other textile materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric cutters"@en .

aat:300425240 a skos:Concept ;
    skos:definition "Mats or boards on which textiles are laid for cutting. Often these have self-healing surfaces that allow the use of rotary cutters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric cutting boards"@en .

aat:300425241 a skos:Concept ;
    skos:definition "Writing utensils containing permanent color dyes, paints, or inks, used to transfer notations, designs, or markings onto fabric materials. The color dyes employed by these tools are especially designed to mantain their color over time after the dye has dried, without significant fading during wash or wear. Also refers to a class of measuring tools or devices used to trace or illustrate textile alteration patterns with onto fabrics, typically with ink or chalk, in preparation for subsequent alteration activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric markers"@en .

aat:300425242 a skos:Concept ;
    skos:definition "Specialized tools designed to create holes or apertures in textile materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric piercing tools"@en .

aat:300425243 a skos:Concept ;
    skos:definition "Specialized tools, comprising two plates between which fabric is inserted as well as a single punch element, designed to clamp and perforate a variety of textile materials. Typically operated manually, these tools often feature punch elements that allow for variable and adjustable punch sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric punches"@en .

aat:300425244 a skos:Concept ;
    skos:definition "Hand-held tools, typically comprising two blades made of lightweight stainless steel or aluminum mounted on identical finger rings, designed to easily cut through fabric freehand. Unlike paper scissors, which are often equipped with dull blades, these scissors are equipped with sharpened blades so as to make long, crisp cuts in textile materials that span the entire length of the blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric scissors"@en .

aat:300425245 a skos:Concept ;
    skos:definition "Hand-held tools, typically comprising two stainless steel blades longer than 6 inches mounted on different-sized finger rings, designed to cut straight, accurate lines in a variety of fabric materials. Unlike fabric scissors, which are equipped with equally-sized finger rings, these shears have a smaller, rounded finger ring for the thumb and a larger elliptical bow for the fingers. This design allows for the user to exert more control over the fabric and ensure that the fabric remains flat while cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric shears"@en .

aat:300425247 a skos:Concept ;
    skos:definition "Equipment used to evaluate the quality of textile products prior to their being released to the market. Such equipment is important to assure regulatory compliance and assess the performance of textile materials, as well as to provide insight into the physical or structural properties of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric testers"@en .

aat:300425250 a skos:Concept ;
    skos:definition "Ceramic vessels decorated with exaggerated facial features, usually on one face of the jug but multiple faces have also been used. Originated in the American South in the mid-19th century amongst enslaved and freed African potters. The production of face jugs continued into the 20th century with the development of African American potteries and with white potters adding face jugs to their offerings. Several potteries in southern U.S. states such as Georgia continue to make face jugs in the 21st century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face jugs"@en .

aat:300425252 a skos:Concept ;
    skos:definition "In dentistry, instruments for transferring the jaw relationship of a patient to an articulator, in order to allow reproduction of the lateral and protrusive movements of the lower jaw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face-bows"@en .

aat:300425256 a skos:Concept ;
    skos:definition "Bells used to mark the beginning or end of work days at a factory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory bells"@en .

aat:300425258 a skos:Concept ;
    skos:definition "Whistles used to mark the beginning or end of work days at a factory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory whistles"@en .

aat:300425259 a skos:Concept ;
    skos:definition "Accelerated aging testing devices designed to measure a fabric's color fastness or resistance to color fading caused by exposure to strong light, ultraviolet rays, or other damaging external light sources. These devices expose dyed textile samples to a carbon arc, which emits an intense actinic light that mimics the effects of natural light, for extended periods of time. Although the device's actinic light does not directly duplicate the effect of natural light exposure, it is the most effective indicator of a textile material's light stability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fadeometers"@en .

aat:300425263 a skos:Concept ;
    skos:definition "Wires used on members or structures whose primary function is to produce a smooth outline and to reduce drag, specifically on aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fairing wires"@en .

aat:300425264 a skos:Concept ;
    skos:definition "Fittings or devices in the form of blocks, rings, or strips of plank on a vessel or vehicle that guide a rope or line running through it, to prevent snagging or chafing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fairleads"@en .

aat:300425278 a skos:Concept ;
    skos:definition "Electric heaters that incorporate a fan to blow air past the heating element to distribute warm air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan heaters"@en .

aat:300425304 a skos:Concept ;
    skos:definition "Military uniforms for soldiers worn when they are performing labor, training, or engaging in combat. These are typically durable, include utilitarian details such as multiple pockets, and are designed to withstand rough use. The term derives from \"fatigue duty:\" non-military labor assigned to soldiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fatigues"@en .

aat:300425311 a skos:Concept ;
    skos:definition "Fabric cases filled with feathers used either alone as a bed or on a bedstead, or box spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather mattresses"@en .

aat:300425312 a skos:Concept ;
    skos:definition "Fabric cases filled with feathers used as a support while reclining, resting, or sleeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather pillows"@en .

aat:300425330 a skos:Concept ;
    skos:definition "Mechanized devices designed to measure, mix, and homogenize a compound of one or more products, including but not limited to various types of flours, textile materials, and seeds. These devices typically comprise oval or semi-circular chambers inside of which a rotating reel is housed. As the products to be blended are feed into the chamber, the reel's rotation works to mix the various ingredients to form a uniform and amalgamated product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feeder blenders"@en .

aat:300425338 a skos:Concept ;
    skos:definition "Mechanized devices designed to process and condense large quantities of wool or other fiberous materials into felt material at high speeds. To automate the work of needle felting, the device exposes fiberous materials to a needle board or multineedle holder into which a large number of barbed needles are fixed. The needles rapidly move up and down so that they poke the fiberous materials and catch the scales of the fibers. This needling action interlocks and tangles the fibers to form a compacted felt fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felting machines"@en .

aat:300425344 a skos:Concept ;
    skos:definition "Type of pliers used to repair and maintain hard wire fencing. These have features such as cutters to cut through hard wire, and gripping jaws to bend and manipulate wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fence pliers"@en .

aat:300425346 a skos:Concept ;
    skos:definition "Heavy-guage wire U-shaped fasteners used to secure wire fencing to fence posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fence staples"@en .

aat:300425347 a skos:Concept ;
    skos:definition "Any of a variety of equipment used to install or build lengths of wire fencing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fence tools"@en .

aat:300425348 a skos:Concept ;
    skos:definition "Levered devices used to pull wire taut when constructing fencing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fence wire stretchers"@en .

aat:300425349 a skos:Concept ;
    skos:definition "Devices that dispense or unroll tension wire for fencing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fence wire stringers"@en .

aat:300425359 a skos:Concept ;
    skos:definition "Thin sheets of metal coated with dark lacquer or enamel and a photographic emulsion, used to create a ferrotypes, aka tintypes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrotype plates"@en .

aat:300425371 a skos:Concept ;
    skos:definition "Devices that utilize the vibroscope method, based on the principle of string vibration, to measure the linear density of textile fibers as determined by the tension and length of fibers vibrating at resonance. By measuring the natural vibration frequency of fibers to determine the amount of fibers present in a cross-section of yarn, these devices are additionally able to evaluate the fiber's porosity and filtration resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiber fineness testers"@en .

aat:300425372 a skos:Concept ;
    skos:definition "Devices, both mechanized and manual, used to separate and partially clean baled cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiber pickers"@en .

aat:300425392 a skos:Concept ;
    skos:definition "Artillery with rifle bore designed to have cross-country or road mobility for use in the battlefield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field rifles"@en .

aat:300425396 a skos:Concept ;
    skos:definition "Tubes, often made of tin, with two diaphragms of pierced tin where several fifes can be stored; the cases have lids which lock the fifes in place, and early examples are decorated with the insignias of military regimens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fife cases"@en .

aat:300425405 a skos:Concept ;
    skos:definition "Sheets or cards, usually with tabs, used for keeping files organized in file containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "file dividers"@en .

aat:300425409 a skos:Concept ;
    skos:definition "Anvils designed to allow specialized working of files and rasps; features may include areas to support V-shaped and tapered points of files."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filecutter's anvils"@en .

aat:300425415 a skos:Concept ;
    skos:definition "Knives with slender, flexible blades used to fillet fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillet knives"@en .

aat:300425417 a skos:Concept ;
    skos:definition "Accessory devices that attach to camera bodies that employ photographic film. Some cameras operate with these as an integral part of the mechanism, while others use them as an add-on part that allows the use of varied formats or types of film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film backs"@en .

aat:300425418 a skos:Concept ;
    skos:definition "Containers usually with two interlocking halves that are designed to hold reels of film, most often motion picture film, but also bulk film intended for use in still photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film cans"@en .

aat:300425419 a skos:Concept ;
    skos:definition "Cylindrical containers with corresponding lids used for holding film, particularly that wound onto cassettes for 35mm still photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film canisters"@en .

aat:300425420 a skos:Concept ;
    skos:definition "Light-tight bags designed with holes for the insertion of the user’s arms to manipulate photo-sensitive materials without the use of a darkroom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film changing bags"@en .

aat:300425421 a skos:Concept ;
    skos:definition "Any portable receptacles or compartments for holding photosensitive film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film containers"@en .

aat:300425423 a skos:Concept ;
    skos:definition "Physical devices designed for editing analog motion picture film. These comprise cranked rewind reels for winding the film, an integrated cutting device, and a backlit screen for viewing the image as it winds through the viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film editors"@en .

aat:300425424 a skos:Concept ;
    skos:definition "Frames, usually of metal, designed to hold sheets of film as they are immersed in a tank of developing solution, used so that the surface of the film does not come into contact with any other surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film hangers"@en .

aat:300425426 a skos:Concept ;
    skos:definition "Sharp blades used to slice off the exposed part of a length film for processing, to avoid processing an entire roll of film, for testing or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film knives"@en .

aat:300425427 a skos:Concept ;
    skos:definition "Containers or detachable receptacles that may be used on analog cameras to hold photographic film, enabling exposed film to be switched out quickly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film magazines"@en .

aat:300425434 a skos:Concept ;
    skos:definition "Devices that attach to projectors that allow continuous strips of film to be projected, rather than individual slides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filmstrip adapters"@en .

aat:300425435 a skos:Concept ;
    skos:definition "Devices for still-image instructional multimedia that use rolls of reversal film and a separate soundtrack with commentary on the visual material on the filmstrip. These are designed to advance images one frame at a time with cues provided by the soundtrack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filmstrip projectors"@en .

aat:300425436 a skos:Concept ;
    skos:definition "Magnifying devices designed for individual direct viewing of backlighted filmstrips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filmstrip viewers"@en .

aat:300425444 a skos:Concept ;
    skos:definition "A class of instruments than can measure the quality or fact of being very small in diameter or thickness, often of fibers or particulate matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fineness testers"@en .

aat:300425457 a skos:Concept ;
    skos:definition "Hand sewing tools used to weave loose ends of yarn back into a hand-knitted item when completing a knitting work. These are long needles with two ends that taper to a semi-point at each end, which also include a single eye with a beveled edge that extends through the length of the needle. Due to their design features, these sewing tools can make use of shorter lengths of yarn more easily than conventional needles, and can finish large knitted items or items with multiple colors more rapidly than conventional needles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finishing needles"@en .

aat:300425466 a skos:Concept ;
    skos:definition "Official indicators of a firefighter's service, used as identification at fire scenes, and a mandated part of a firefighter's uniform. They usually indicate identification numbers, and the company of the firefighter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire badges"@en .

aat:300425484 a skos:Concept ;
    skos:definition "Decorative emblems worn by firefighters on their uniforms to identify their affiliation with a specific company or firehouse. These are usually embroidered with symbols such as ladders, flames, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire patches"@en .

aat:300425485 a skos:Concept ;
    skos:definition "Small emblems that are meant to be worn on the uniforms of firefighters that signify various aspects of service such as rank, years of service, etc. These may be customized to identify specific fire departments, mottos, or achievements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire pins"@en .

aat:300425488 a skos:Concept ;
    skos:definition "Devices designed to assess the ignition resistance of textile fabrics against heat and flames. To evaluate the flammability of textile fabrics, these devices measure the fabrics' combustion rates according to time when exposed to a small flame directed at the textile samples from various angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire resistance testers"@en .

aat:300425494 a skos:Concept ;
    skos:definition "Horns, first introduced in 1749 in New York, used by fire department officers in order to amplify their voices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire trumpets"@en .

aat:300425495 a skos:Concept ;
    skos:definition "Uniforms designed to be worn by firefighters while performing their duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire uniforms"@en .

aat:300425506 a skos:Concept ;
    skos:definition "Devices used for detecting the explosive gas methane in the context of mining operations. A firedamp detector is hung at the mining face or in other work areas to monitor methane levels and sound an alarm when they reach a dangerous concentration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firedamp detectors"@en .

aat:300425514 a skos:Concept ;
    skos:definition "Implements used in or around a fireplace to kindle, stoke, maintain, or otherwise tend to a fire and its remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace accessories"@en .

aat:300425515 a skos:Concept ;
    skos:definition "Utensils that are intended to sweep ashes from in or around fireplaces, often designed as part of a set of fireplace tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace brooms"@en .

aat:300425518 a skos:Concept ;
    skos:definition "Metal devices attached to a fireplace to suspend a hook from a generally moveable arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace cranes"@en .

aat:300425522 a skos:Concept ;
    skos:definition "Pronged instruments designed as tools to stoke or tend fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace forks"@en .

aat:300425523 a skos:Concept ;
    skos:definition "Fireplace components formed of frameworks of metal bars, intended as supports for flammable materials, used in place of, or with, andirons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace grates"@en .

aat:300425524 a skos:Concept ;
    skos:definition "Metal, often cast-iron inserts designed to fit fireplace openings. Some are made to provide an alternative to wood burning, with gas, electricity, coal, or other fuel. Others burn wood but increase heat efficiency. Historically these have appeared in a variety of forms, often ornamental."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace inserts"@en .

aat:300425527 a skos:Concept ;
    skos:definition "Shovels for placing coal or other fuel on a fire, or for removing debris from the hearth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace shovels"@en .

aat:300425531 a skos:Concept ;
    skos:definition "Devices designed to be attached to a wall to support the implements in firesets such as pokers, tongs, shovels, and brooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireset brackets"@en .

aat:300425532 a skos:Concept ;
    skos:definition "Freestanding supports for implements in firesets, frequently designed as a tray mounted with a vertical rod terminated by an open ring, or hooks, used to contain the handles of tools such as shovels, pokers, tongs, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireset stands"@en .

aat:300425538 a skos:Concept ;
    skos:definition "Small casks containing a quarter of a barrel or half a kilderkin for liquids, fish, butter, or other foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firkins"@en .

aat:300425557 a skos:Concept ;
    skos:definition "Pronged utensils for turning fish cooking by the heat of a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish roasters"@en .

aat:300425558 a skos:Concept ;
    skos:definition "Shingles, usually wooden or asphalt, having rounded edges, so that when arranged in rows the pattern resembles fish scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish scale shingle"@en .

aat:300425559 a skos:Concept ;
    skos:definition "Tools for scraping scales off of a fish. They may be formed as either a serrated blade or a rasp attached to a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish scalers"@en .

aat:300425562 a skos:Concept ;
    skos:definition "Chambers used for preserving fish by exposing them to smoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish smokers"@en .

aat:300425580 a skos:Concept ;
    skos:definition "Kites used in the activity of fishing, in which the kite supports a drop line attached to a lure or bait. The kite is flown over the surface of a body of water, and the bait floats near the waterline until taken by a fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing kites"@en .

aat:300425603 a skos:Concept ;
    skos:definition "Tools consisting of a metal head with a ball peen attached to a wooden handle. Used to forge and fit a horseshoe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fitting hammers"@en .

aat:300425606 a skos:Concept ;
    skos:definition "The simplest of propeller designs, associated with light, piston engine aircraft. The angle of attack of fixed pitch propellers is set at installation and cannot be changed during aircraft operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed-pitch propellers"@en .

aat:300425610 a skos:Concept ;
    skos:definition "Harnesses designed to hold flags in front of the wearer's body; consisting of at minimum one strap worn over the shoulder and one strap around the waist, with socket attached to the waist strap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flag belts"@en .

aat:300425612 a skos:Concept ;
    skos:definition "Boxes or cabinets used to store flags for quick retrieval, particularly on seagoing vessels. These often have a nest of smaller pockets for signal flags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flag lockers"@en .

aat:300425617 a skos:Concept ;
    skos:definition "Stands with centrally-placed socket to hold a flag in an upright or slanted position, made of various materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flagpole holders"@en .

aat:300425622 a skos:Concept ;
    skos:definition "Tools of bone or other materials used to press off flakes of stone in making stone implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flakers"@en .

aat:300425633 a skos:Concept ;
    skos:definition "Mechanical or electronic equipment used to create sudden, brief, and bright illumination for use in photography in situations where there is insufficient illumination or to freeze action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash devices"@en .

aat:300425635 a skos:Concept ;
    skos:definition "Historical devices of varied design, but usually with a handheld tray intended to hold magnesium flash powder that would be ignited at the moment of exposure of a photographic plate. These were used before the advent of flash bulbs and later electronic flash devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash powder holders"@en .

aat:300425637 a skos:Concept ;
    skos:definition "Electronic devices that trigger electronic flashes remotely. These may be connected to the flash units via wire or wireless means, usually radio frequency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash triggers"@en .

aat:300425638 a skos:Concept ;
    skos:definition "Single-use bulbs that give a single bright burst of light, triggered by a camera, and synched to the shutter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flashbulbs"@en .

aat:300425639 a skos:Concept ;
    skos:definition "Devices that may be attached to a camera to hold and operate flashbulbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flashguns"@en .

aat:300425661 a skos:Concept ;
    skos:definition "Containers with compartments for organizing flatware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flatware trays"@en .

aat:300425663 a skos:Concept ;
    skos:definition "Tool with hinged top for breaking the wooden core of flax stems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flax breakers"@en .

aat:300425679 a skos:Concept ;
    skos:definition "Devices in aircraft which record the relevant technical details of each flight, in order to assist investigation in the event of an accident."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flight recorders"@en .

aat:300425680 a skos:Concept ;
    skos:definition "Devices or systems that present a user with the impression of operating aircraft. These create an illusion of manned flight, applications of flight controls, the effects of other aircraft, and environmental factors such as air density, velocity, turbulence, wind, cloud cover, precipitation, for example. Flight simulators are used for training, aircraft design and research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flight simulators"@en .

aat:300425682 a skos:Concept ;
    skos:definition "Cut pieces of hard, non-porous material, originally rock, that can take a sharp edge. Frequently these are made of flint stone, but can also be any kind of chert, quartz, agate, jasper or chalcedony. These are used to produce sparks by friction against a iron striker or firesteel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flints"@en .

aat:300425697 a skos:Concept ;
    skos:definition "Devices that provide a measure of the consistency of bituminous materials, including asphalts and tar products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "float test apparatuses"@en .

aat:300425700 a skos:Concept ;
    skos:definition "Mechanized devices that utilize electrostatic applicators to adhere small fibers, or flocks, to a fabric's surface in order to create a soft, velvet-like finish. These devices facilitate the flocking process by electrically charging the flock particles causing them to attach to the fabric surface in an upright position, and then propelling and anchoring the particles into the adhesive at right angles. Through this process, these devices ensure that the flock application is both durable and permanent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flocking machines"@en .

aat:300425714 a skos:Concept ;
    skos:definition "Powered machines designed to wax and buff floor finishes. These usually consist of a handle mounted to a revolving element that spins a removeable pad to either apply wax or dry polish a floor surface, as needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor polishers"@en .

aat:300425725 a skos:Concept ;
    skos:definition "Plastic or metal support made to strengthen flower stems in floral arrangements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floral picks"@en .

aat:300425726 a skos:Concept ;
    skos:definition "Arrangements of foliage used for decoration, events, or personal ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floral pieces"@en .

aat:300425731 a skos:Concept ;
    skos:definition "Receptacles for storing flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour bins"@en .

aat:300425732 a skos:Concept ;
    skos:definition "Devices for mixing together flour of different grades of quality to achieve a uniform grade ready for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour blenders"@en .

aat:300425733 a skos:Concept ;
    skos:definition "Receptacles for storing flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour buckets"@en .

aat:300425734 a skos:Concept ;
    skos:definition "Covered containers for storing flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour canisters"@en .

aat:300425735 a skos:Concept ;
    skos:definition "Devices with two grooved plates between which grains of wheat can be ground into flour via the action of a crank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour mills"@en .

aat:300425737 a skos:Concept ;
    skos:definition "Kitchen utensils used to sprinkle flour, consisting of a usually cylindrical container with a perforated lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour shakers"@en .

aat:300425739 a skos:Concept ;
    skos:definition "Revolving reels or agitators used in the process of making freshly milled flour appear whiter by oxidizing the surface of flour grains. Flour-bleaching agitators carry flour through air charged with nitrogen peroxide gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour-bleaching agitators"@en .

aat:300425740 a skos:Concept ;
    skos:definition "Devices that create an electric current through which a stream of air is passed in order to electrify it. Used to age and bleach flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour-bleaching electrifiers"@en .

aat:300425741 a skos:Concept ;
    skos:definition "Devices that feed flour as it comes off the line at a mill, where bleaching and oxidizing chemicals are added in order to hasten the whitening process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour-bleaching feeders"@en .

aat:300425744 a skos:Concept ;
    skos:definition "Devices used to determine the consistency of concrete or mortar in its flow state, or to identify moisture content of solids. These consist of a flat surface that can be raised and dropped and a conical mold for shaping test specimens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flow tables"@en .

aat:300425748 a skos:Concept ;
    skos:definition "Textiles consisting of appliqued fabrics to create various images or patterns. Particularly created by Hmong women for bedspreads, quilts, and clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower cloths"@en .

aat:300425770 a skos:Concept ;
    skos:definition "Small, usually metal fans typically consisting of a base with a shaft to which two arms, with a blade at each end, are attached, and which is operated by a clockwork mechanism. Used to keep flies away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly fans"@en .

aat:300425778 a skos:Concept ;
    skos:definition "Gliding toys or sporting items that are generally made of injection molded plastic and roughly 8 to 10 inches (20 to 25 cm) in diameter. These have an aerodynamic profile in cross-section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying disks"@en .

aat:300425781 a skos:Concept ;
    skos:definition "Heavy-rimmed wheels used for regulating the speed of machinery via inertia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flywheels"@en .

aat:300425786 a skos:Concept ;
    skos:definition "Foam pads, sometimes in a case of fabric used either alone as a resting or sleeping surface, or supported on a bedstead, or box spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foam mattresses"@en .

aat:300425787 a skos:Concept ;
    skos:definition "Fabric cases filled with foam material used to support the head or other parts of the body while reclining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foam pillows"@en .

aat:300425790 a skos:Concept ;
    skos:definition "Removable or fixed camera backs that incorporate a ground glass (or plastic) screen on which an image projected from a lens is brought into focus. This is then removed, or a film holder is inserted in front of this to make an exposure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "focusing backs"@en .

aat:300425791 a skos:Concept ;
    skos:definition "Hoods mounted around ground glass focusing screens of certain cameras that block ambient light from falling across the screen, allowing for a clearer view. These may be fixed or removeable, but are frequently designed to fold flat when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "focusing hoods"@en .

aat:300425792 a skos:Concept ;
    skos:definition "Magnifying devices intended to be used with photographic equipment, particularly on the ground glass of large format view cameras to achieve critical focus. These are also typically used to view exposed film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "focusing loupes"@en .

aat:300425801 a skos:Concept ;
    skos:definition "Utensils used to create folds in paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding knives"@en .

aat:300425808 a skos:Concept ;
    skos:definition "Tables of various designs whereby the table top may be folded partially or entirely from the support, or where the legs may be folded under the table top; folding is done for ease of storage or otherwise to make the profile smaller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding tables"@en .

aat:300425812 a skos:Concept ;
    skos:definition "Specialized utensils designed for immersing and retrieving morsels of food from a fondue pot or fountain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fondue forks"@en .

aat:300425813 a skos:Concept ;
    skos:definition "Metal vessels in which a mixture of melted cheese and other ingredients is kept warm over a heater or flame. These are used communally, as users dip bread into the pot with a fork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fondue pots"@en .

aat:300425814 a skos:Concept ;
    skos:definition "Mechanisms that use rotating helical screw blades used to move or dislodge materials for food processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food augers"@en .

aat:300425818 a skos:Concept ;
    skos:definition "Storage containers for food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food caddies"@en .

aat:300425819 a skos:Concept ;
    skos:definition "Containers designed to transport food for individual or small group consumption, particularly for informal meals such as a lunch, or to eat outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food carriers"@en .

aat:300425820 a skos:Concept ;
    skos:definition "Vessels of a cylindrical form, often of wood, wider in the middle, and of greater length than breadth, formed of curved staves bound together by hoops, and used to store foodstuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food casks"@en .

aat:300425823 a skos:Concept ;
    skos:definition "Implements used to shelter or enclose food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food covers"@en .

aat:300425826 a skos:Concept ;
    skos:definition "Kitchen appliances for drying food, typically consisting of a heater, a fan, and several perforated trays which allow the circulation of warm air around the food to be dried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food dehydrators"@en .

aat:300425833 a skos:Concept ;
    skos:definition "Devices used to keep hot food at temperature via infrared radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food heat lamps"@en .

aat:300425838 a skos:Concept ;
    skos:definition "Receptacles made of metal, porcelain, wood, or stone with a cup-shaped cavity in which ingredients for cooking can be ground or pulverized with a pestle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food mortars"@en .

aat:300425840 a skos:Concept ;
    skos:definition "Devices that insert or pack food into packaging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food packing machines"@en .

aat:300425841 a skos:Concept ;
    skos:definition "Wooden implements used to stir large quantities of liquids consisting of a flat blade on a long handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food paddles"@en .

aat:300425842 a skos:Concept ;
    skos:definition "Implements consisting of a handle with an enlarged, rounded end used along with a mortar to grind or pulverize food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food pestles"@en .

aat:300425852 a skos:Concept ;
    skos:definition "Reservoirs for processing food items, usually for salting or marinating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food processing tanks"@en .

aat:300425853 a skos:Concept ;
    skos:definition "Wooden buckets, typically with a drainage or bung hole in the bottom, used to pickle food in brine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food processing vats"@en .

aat:300425856 a skos:Concept ;
    skos:definition "Utensils for sampling food as it is being prepared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food samples"@en .

aat:300425857 a skos:Concept ;
    skos:definition "Utensils used to transfer food items from one container to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food scoops"@en .

aat:300425858 a skos:Concept ;
    skos:definition "Domed screens placed over dishes of food to protect them from insects and debris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food screens"@en .

aat:300425861 a skos:Concept ;
    skos:definition "Wheeled vehicles used to assist with food service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food service carts"@en .

aat:300425866 a skos:Concept ;
    skos:definition "Flat boards with raised rims used to carry and display small items used in food service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food service trays"@en .

aat:300425868 a skos:Concept ;
    skos:definition "Machines designed to automatically cut a variety of foods into slices of variable thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food slicers"@en .

aat:300425869 a skos:Concept ;
    skos:definition "Chambers used for preserving food by exposing it to smoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smokers"@en .

aat:300425873 a skos:Concept ;
    skos:definition "Flat-bottomed, round or truncated conical, wicker container equipped with handles used to store dry food ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage baskets"@en .

aat:300425875 a skos:Concept ;
    skos:definition "Vessels made to hold liquid foods, usually shallow and round."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage bowls"@en .

aat:300425882 a skos:Concept ;
    skos:definition "Objects that are laid over, or overspreads food products to keep them protected or fresh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage covers"@en .

aat:300425883 a skos:Concept ;
    skos:definition "Cylindrical, ceramic receptacles used to store food, usually with a fitted lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage crocks"@en .

aat:300425884 a skos:Concept ;
    skos:definition "Furniture with shelves for storing food for ready use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage cupboards"@en .

aat:300425890 a skos:Concept ;
    skos:definition "A receptacle, often rectangular or cylindrical, for storing large quantities of liquid foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage tanks"@en .

aat:300425891 a skos:Concept ;
    skos:definition "Receptacles that are typically wider than high, for storing food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage tubs"@en .

aat:300425892 a skos:Concept ;
    skos:definition "Vessels, usually large, used for storing food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food storage vats"@en .

aat:300425893 a skos:Concept ;
    skos:definition "Devices or surfaces that are designed to keep food or drinks warm over a period of time, usually as a prelude to being served, as at a buffet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food warmers"@en .

aat:300425895 a skos:Concept ;
    skos:definition "Sheets of thin plastic used to cover food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food wrap"@en .

aat:300425922 a skos:Concept ;
    skos:definition "Devices of wood, metal, or plastic inserted into footwear to maintain their shape when they are not being worn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footwear trees"@en .

aat:300425951 a skos:Concept ;
    skos:definition "Toys or sets of objects designed for a form of play in which divination is performed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortune telling toys"@en .

aat:300425953 a skos:Concept ;
    skos:definition "Refers to a woman's corset, or corset-like undergarments that shape the body by a variety of means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundation garments"@en .

aat:300425977 a skos:Concept ;
    skos:definition "Symbolic garments worn by members of a fraternal organization, most commonly the Freemasons. These may be embellished with decorative symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal aprons"@en .

aat:300425978 a skos:Concept ;
    skos:definition "Pin-backed buttons of varied materials that signify membership in a fraternal organization. These display symbols or emblems that identify the member's affiliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal buttons"@en .

aat:300425979 a skos:Concept ;
    skos:definition "Headgear of varied design worn by members of a fraternal organization. These display symbols or emblems that identify the member's affiliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal hats"@en .

aat:300425981 a skos:Concept ;
    skos:definition "Handled vessels used in association with a fraternal organization, or secret society. These display symbols or emblems of the organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal mugs"@en .

aat:300425982 a skos:Concept ;
    skos:definition "Wooden paddles, most often bearing Greek letters and symbols signifying a fraternity or sorority, commonly given to new members of the society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal paddles"@en .

aat:300425983 a skos:Concept ;
    skos:definition "Embroidered emblems or insignia worn by members of a fraternal organization to signify membership, affiliation, or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal patches"@en .

aat:300425984 a skos:Concept ;
    skos:definition "Articles of jewelry designed to be suspended, such as from a necklace, brooch, or earrings that symbolize membership in a fraternal organization. These feature emblems affiliated with the organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal pendants"@en .

aat:300425985 a skos:Concept ;
    skos:definition "Small buttons or badges meant to be affixed to clothing that indicates membership of the wearer in a fraternal organization. These display emblems unique to the organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal pins"@en .

aat:300425986 a skos:Concept ;
    skos:definition "Ribbons bestowed upon and worn by members of fraternal organizations to indicate membership or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal ribbons"@en .

aat:300425987 a skos:Concept ;
    skos:definition "Finger rings that signify membership in a fraternal organization by displaying symbols or emblems that identify the member's affiliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal rings"@en .

aat:300425988 a skos:Concept ;
    skos:definition "Detachable buttons with a shank or eye on the back that are inserted through one or more eyelets or buttonholes in a garment that display insignia or emblems of a fraternal organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal studs"@en .

aat:300425989 a skos:Concept ;
    skos:definition "Symbolic tools used in ceremonies of fraternal organizations, particularly the Freemasons. These may be engraved with symbols and text indicating ownership or lodge number."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternal trowels"@en .

aat:300425991 a skos:Concept ;
    skos:definition "Lighter-than-air aircraft that can be made to ascend by the use of ballast and to descend by the release of gas but which cannot be guided in flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free balloons"@en .

aat:300425994 a skos:Concept ;
    skos:definition "Plastic bags with a self-sealing opening made of a thick plastic suitable for storing food in a freezer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freezer bags"@en .

aat:300425995 a skos:Concept ;
    skos:definition "Flat storage trays or receptacles for placing food in a freezer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freezer pans"@en .

aat:300426000 a skos:Concept ;
    skos:definition "Devices used to cut large quantities of potatoes into a shape appropriate for making french fries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "french fry cutters"@en .

aat:300426006 a skos:Concept ;
    skos:definition "Instruments that produce sound by rubbing aluminum rods instead of plucking strings, and which can be played vertically or horizontally. An original version was invented by John Calhoun Deagan and called an “aluminum harp.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction harps"@en .

aat:300426009 a skos:Concept ;
    skos:definition "Devices that initiate the firing of muzzle-loading cannons. Comprised of a copper tube filled with powder attached to the vent of the cannon with its tip in the powder charge. On this tube a short tube containing a friction composition. Lying in the composition was the roughened end of a wire slider, The other end of the slider was twisted into a loop for hooking to the gunner's lanyard. Pulling on the lanyard caused the slider to ignite the composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction primers"@en .

aat:300426014 a skos:Concept ;
    skos:definition "Frisbee is a trademark of the toy company Wham-O, but the name is used for all similar flying discs. Frisbees are usually made of plastic, have a diameter of about 20 to 30 cm. They are designed to fly aerodynamically and spin when thrown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frisbees (TM)"@en .

aat:300426021 a skos:Concept ;
    skos:definition "Heavy-duty four wheeled construction machines mounted with a scoop that excavate, load and transport loose materials such as sand, gravel, or dirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "front end loaders"@en .

aat:300426028 a skos:Concept ;
    skos:definition "Corkscrew-like tools used to break up dried fruit packed in casks or or receptacles"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit augers"@en .

aat:300426035 a skos:Concept ;
    skos:definition "Machines used to sort produce into grades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit graders"@en .

aat:300426041 a skos:Concept ;
    skos:definition "Devices for removing the stones or pits from fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit pitters"@en .

aat:300426043 a skos:Concept ;
    skos:definition "Devices used to extract juice from firm fruits, usually consisting of an auger set in a receptacle with a hand-turned crank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit presses"@en .

aat:300426045 a skos:Concept ;
    skos:definition "Devices used to cut fruit into slices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit slicers"@en .

aat:300426054 a skos:Concept ;
    skos:definition "Vessels for the storage and distribution of volatile liquid fuel. These often have nozzles incorporated for pouring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuel containers"@en .

aat:300426057 a skos:Concept ;
    skos:definition "Tools for making a groove in a metal surface, typically having a linear rounded end, like a blunt chisel, and used in a pair as a top fuller and bottom fuller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fullers"@en .

aat:300426058 a skos:Concept ;
    skos:definition "Long-bladed shears for removing the nap from the surface of woolen textile surfaces after the process of fulling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuller's shears"@en .

aat:300426059 a skos:Concept ;
    skos:definition "Mechanized devices designed to increase the thickness, compactness, and consistency of woolen fibers by subjecting woolen cloth to moisture, heat, friction, and pressure. Woolen cloth is first submerged in a vessel where it is treated with liquid; the wet cloth is then removed from the vessel by means of cylindrical rollers which agigate and beat the cloth before transferring it to a fulling box to be shrunk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fulling machines"@en .

aat:300426061 a skos:Concept ;
    skos:definition "Large containers or casks into which woven cloth is immersed and washed, tanned, or beat for the purposes of cleansing and/or thickening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fulling vats"@en .

aat:300426062 a skos:Concept ;
    skos:definition "Printed matter that formally declares the occurance of a funeral, with attendant details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral announcements"@en .

aat:300426068 a skos:Concept ;
    skos:definition "Stands constructed to hold caskets or other funerary remains; examples include table-like structures consisting of a base and flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary stands"@en .

aat:300426073 a skos:Concept ;
    skos:definition "Funnels with stoppers used in candy making. The funnel is filled with warm, liquid candy, and the operator uses the stopper to dispense the appropriate amount of candy into a mold or onto a flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funnel droppers"@en .

aat:300426074 a skos:Concept ;
    skos:definition "Cone-shaped objects used to amplify or concentrate sound waves, used in a variety of applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funnel horns"@en .

aat:300426077 a skos:Concept ;
    skos:definition "Devices used to clean ducts or other parts of furnaces used for heating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnace cleaners"@en .

aat:300426078 a skos:Concept ;
    skos:definition "Coverings for objects that facilitate human activity and provide for physical needs of people in or around a building generally by offering comfort, convenience, or protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnishing covers"@en .

aat:300426079 a skos:Concept ;
    skos:definition "General term for decorative materials added to furniture, such as braids or tassels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnishing trims"@en .

aat:300426081 a skos:Concept ;
    skos:definition "Clamps of various designs that may be adjusted to fit different parts and sizes of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture clamps"@en .

aat:300426082 a skos:Concept ;
    skos:definition "Coverings for movable or fixed objects for sitting, reclining, or storage, such as chairs, beds, tables, cabinets, etc., in a dwelling, business, or public space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture coverings"@en .

aat:300426084 a skos:Concept ;
    skos:definition "Mats that fit under pieces of furniture that protect the surface that they are resting on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture mats"@en .

aat:300426085 a skos:Concept ;
    skos:definition "Decorative elements added to furniture components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture ornaments"@en .

aat:300426087 a skos:Concept ;
    skos:definition "Long narrow strips of textile material that rest on the surface of furniture items for decoration or protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture runners"@en .

aat:300426088 a skos:Concept ;
    skos:definition "Very narrow strips of decorative textiles that are meant to rest on the surface of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture scarves"@en .

aat:300426094 a skos:Concept ;
    skos:definition "Large basins used in processing pig carcasses. The carcass is submerged in the basin, which is filled with boiling water, in order to loosen the bristles to make them easier to remove in later steps of processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hog scalders"@en .

aat:300426095 a skos:Concept ;
    skos:definition "Implements used to scrape the small hairs off hog hides which removes some bacteria and gets the hide ready for the next step in meat processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hog scrapers"@en .

aat:300426100 a skos:Concept ;
    skos:definition "Devices for securing or grasping bulky or heavy articles while being lifted or lowered, generally in the form of a belt, rope, or chain formed into a loop and fitted with hooks and tackle that can attach to a hoist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoist slings"@en .

aat:300426101 a skos:Concept ;
    skos:definition "Devices designed to lift and lower heavy objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoisting apparatuses"@en .

aat:300426102 a skos:Concept ;
    skos:definition "Devices for applying hand power to lift objects by means of a screw or lever, or by hydraulic power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoisting jacks"@en .

aat:300426107 a skos:Concept ;
    skos:definition "Greeting cards that are exchanged on the occasion of days or events of religious or other significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holiday cards"@en .

aat:300426131 a skos:Concept ;
    skos:definition "Containers made to hold water dedicated for sacred uses, made of various materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy water bottles"@en .

aat:300426133 a skos:Concept ;
    skos:definition "General term for containers made to hold water consecrated by a priest or other religious figure. Examples include holy water fonts located outside of Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy water vessels"@en .

aat:300426136 a skos:Concept ;
    skos:definition "General term for exercise equipment built for use in the home, as opposed to equipment made for fitness center or gymnasium use. They are often comprised of several different fitness machines in one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home gyms"@en .

aat:300426137 a skos:Concept ;
    skos:definition "Small buildings that contain equipment and tools and in which goods are manufactured or repaired within the context of a private domicile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home workshops"@en .

aat:300426138 a skos:Concept ;
    skos:definition "Specialized kitchen utensils used to dispense viscous liquid such as honey or syrup from a container. These are usually made of wood or plastic, and have a handle terminated with a concentrically-grooved bulb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honey dippers"@en .

aat:300426139 a skos:Concept ;
    skos:definition "Vessels to contain honey, usually glass, ceramic, or wooden, usually lidded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honey dishes"@en .

aat:300426140 a skos:Concept ;
    skos:definition "Devices that extract honey from honeycomb, usually by centrifugal action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honey extractors"@en .

aat:300426164 a skos:Concept ;
    skos:definition "Fasteners that consist of two components that are attached to opposing surfaces to be fastened. One component features tiny hooks; the second features smaller loops. When the two are pressed together the hooks catch in the loops and the two pieces bind temporarily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hook and loop fasteners"@en .

aat:300426171 a skos:Concept ;
    skos:definition "Underskirts fashioned from cloth attached to a series of elongated, concentric hoops made of whalebone or cane. Typically worn under a petticoat and/or gown to create a dome-shaped, small-waisted silhouette. Popular women's fashion in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoop skirts"@en .

aat:300426177 a skos:Concept ;
    skos:definition "PVC or vinyl balls mounted with one or two handles, intended as toys on which children can bounce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hop balls"@en .

aat:300426183 a skos:Concept ;
    skos:definition "Toys with which children can play hopscotch. Sets can include tiles and a marker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hopscotch sets"@en .

aat:300426208 a skos:Concept ;
    skos:definition "Devices that tell the time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horometers"@en .

aat:300426220 a skos:Concept ;
    skos:definition "Cutting devices operated manually or electrically intended for grooming horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse shears"@en .

aat:300426230 a skos:Concept ;
    skos:definition "Fabric cases filled with horsehair used either alone as a bed or on a bedstead, or box spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horsehair mattresses"@en .

aat:300426248 a skos:Concept ;
    skos:definition "Protective outer garments worn by patients at a hospital, either in preparation for surgery or as a loose general purpose garment worn usually during an extended stay, to facilitate examinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospital gowns"@en .

aat:300426254 a skos:Concept ;
    skos:definition "A class of devices in which a solvent is continuiously boiled in the bottom of a receptacle and condensed at the top, the material to be extracted is held above the main mass in a filter suspended in a wire frame, where it remains in an atmosphere of solvent vapor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot extraction apparatuses"@en .

aat:300426256 a skos:Concept ;
    skos:definition "Flat pieces of material, often with decorative elements, which are placed on surfaces as protection from hot objects; most often vessels containing food. These may be considered a type of trivet, but are not intended to be used over a flame for cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot pads"@en .

aat:300426286 a skos:Concept ;
    skos:definition "Vehicles that are supported and propelled by a cushion of air ejected downwards against a surface close below it, and that may travel over any relatively smooth surface such as a body of water or flat land without direct contact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hovercraft"@en .

aat:300426297 a skos:Concept ;
    skos:definition "Centrifuges used to train and prepare astronauts for the acceleration forces in spaceflight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human centrifuges"@en .

aat:300426300 a skos:Concept ;
    skos:definition "Carrying devices or frames carried across a person's shoulders that consist of a length of material, usually wood, sometimes shaped to accommodate the neck and shoulders of the user, though this is often a simple rod. Suspended from this support are two buckets that can transport liquid or other materials by one person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human yokes"@en .

aat:300426307 a skos:Concept ;
    skos:definition "Large bags to keep small game that has been shot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting bags"@en .

aat:300426310 a skos:Concept ;
    skos:definition "Button-down, collared outer garments worn by hunters for convenience and warmth. These traditionally featured poacher's pockets for storing small game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting jackets"@en .

aat:300426331 a skos:Concept ;
    skos:definition "Computers that utilize both analog and digital representations of data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hybrid computers"@en .

aat:300426333 a skos:Concept ;
    skos:definition "Lifting or hoisting devices for moving objects that operate by force created by pressure on a liquid inside a cylinder that moves a piston upward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic lifts"@en .

aat:300426344 a skos:Concept ;
    skos:definition "Devices or sets that allow measurement and comparison of levels of hydrogen in a material or solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogenation comparators"@en .

aat:300426346 a skos:Concept ;
    skos:definition "Instruments for obtaining specimens of water from rivers, lakes, or oceans, and from any specific depth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrophores"@en .

aat:300426370 a skos:Concept ;
    skos:definition "Devices used to mix malts and milkshakes, usually designed with a base that mounts a paddle at the end of a long shaft that can be immersed in a tall mixing vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice cream mixers"@en .

aat:300426390 a skos:Concept ;
    skos:definition "Shovel-like tools used to retrieve ice from a large container."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice scoops"@en .

aat:300426405 a skos:Concept ;
    skos:definition "Objects that are worn by individuals that are meant to indicate authorization or confirmation of personal identity within a predermined locale or context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identification badges"@en .

aat:300426410 a skos:Concept ;
    skos:definition "Broad category of flat inscribed objects of varied material such as metal, plastic, or ceramic that indicate verification or confirmation of identity. These may be fixed or moveable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identification plates"@en .

aat:300426417 a skos:Concept ;
    skos:definition "Cone-shaped clear vessels marked with graduations used to measure the settleable solids in a specific volume, often a liter of water. These are usually used in multiples so that samples can be compared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Imhoff cones"@en .

aat:300426418 a skos:Concept ;
    skos:definition "Racks designed to support one or more Imhoff cones, which typically have no foot for support, and make comparative analysis easier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Imhoff cone supports"@en .

aat:300426425 a skos:Concept ;
    skos:definition "Slabs of stone or metal, on which printed material or stereotype plates are arranged before printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imposing tables"@en .

aat:300426426 a skos:Concept ;
    skos:definition "Novelties consisting of one or more items sealed inside a glass bottle. The earliest examples date from the 18th century and featured miniature ships inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impossible bottles"@en .

aat:300426430 a skos:Concept ;
    skos:definition "In the context of dentistry, tools for making an impression of the upper and lower jaw in preparation for a plaster mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental impression trays"@en .

aat:300426441 a skos:Concept ;
    skos:definition "Trowels made for incense, used for scooping, burning, or cleaning. Examples are ritual objects in the Jewish religion, recorded as having been used in the Temple of Jerusalem to clean the lamps of the menorah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense shovels"@en .

aat:300426442 a skos:Concept ;
    skos:definition "Utensils used to ladle incense into censures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense spoons"@en .

aat:300426444 a skos:Concept ;
    skos:definition "Utensils used to handle or burn incense, particularly large pieces or cubes of incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense tongs"@en .

aat:300426445 a skos:Concept ;
    skos:definition "General term for utensils used in handling or burning incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense tools"@en .

aat:300426461 a skos:Concept ;
    skos:definition "Instruments for determining the strength of an indigo solution by volumetric analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigometers"@en .

aat:300426467 a skos:Concept ;
    skos:definition "Robotic applications that work with detailed precision in controlled environments, such as manufacturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial robots"@en .

aat:300426473 a skos:Concept ;
    skos:definition "Toys made of plastic or other materials that are designed to be inflated with air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inflatable toys"@en .

aat:300426482 a skos:Concept ;
    skos:definition "Reservoirs used to store and supply ink as part of a pen assembly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink cartridges"@en .

aat:300426485 a skos:Concept ;
    skos:definition "Hollow tubes often made of plastic or rubber, filled with ink. Used to transfer ink onto printing surfaces or in utensils that use ink as a drawing medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink tubes"@en .

aat:300426497 a skos:Concept ;
    skos:definition "Needles that are used to introduce cells or organisms into a culture medium for growth or observation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inoculating needles"@en .

aat:300426507 a skos:Concept ;
    skos:definition "Identifying objects that are worn to indicate a person's affiliation, rank, office, name, or similar information. these may display insignias or symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia badges"@en .

aat:300426508 a skos:Concept ;
    skos:definition "Objects that bear insignia that are worn by individuals to identify an affiliation with a group such as a branch of the military, fraternal organization, or law enforcement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia buttons"@en .

aat:300426509 a skos:Concept ;
    skos:definition "Textile objects intended to be affixed to clothing or uniforms that indicate affiliation or rank within an organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia patches"@en .

aat:300426510 a skos:Concept ;
    skos:definition "Ornamental objects that are attached loosely to clothing or are suspended from a chain that bear insignia identifying membership or affiliation with a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia pendants"@en .

aat:300426511 a skos:Concept ;
    skos:definition "Ornamental objects that are secured by clothing or to another object with a pin that bear insignia identifying membership or affiliation with a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia pins"@en .

aat:300426512 a skos:Concept ;
    skos:definition "Flat ornamental objects that are inscribed with insignia identifying membership or affiliation with a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia plaques"@en .

aat:300426513 a skos:Concept ;
    skos:definition "Small plates of metal or other material that are affixed to belts, helmets, or other articles of clothing or uniform that bear insignia identifying the wearer as a member of a particular group, particularly the military."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia plates"@en .

aat:300426514 a skos:Concept ;
    skos:definition "Ornamental textiles that are attached to clothing that bear insignia identifying membership or affiliation with a group such as a fraternal organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia ribbons"@en .

aat:300426515 a skos:Concept ;
    skos:definition "Items of personal jewelry worn on the fingers that bear insignia identifying membership or affiliation with a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia rings"@en .

aat:300426516 a skos:Concept ;
    skos:definition "Shields displaying various motifs, as may be used by warriors for identification or allegiance, or for ceremonial purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insignia shields"@en .

aat:300426519 a skos:Concept ;
    skos:definition "Pins with words or images displayed on them that provide some mental or spiritual influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inspirational pins"@en .

aat:300426529 a skos:Concept ;
    skos:definition "Visual teaching aids for demonstrating some aspect of education or instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instructional models"@en .

aat:300426537 a skos:Concept ;
    skos:definition "Devices that surround a beverage vessel and that provide insulation to keep a liquid hot or cold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insulated beverage holders"@en .

aat:300426545 a skos:Concept ;
    skos:definition "Devices that indicate the total amount or average value of a quantity; in analog computing these may be devices whose output functions are proportional to the integral of their input functions, with respect to specific variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integrators"@en .

aat:300426555 a skos:Concept ;
    skos:definition "Handled cups with spouts attached to the bowl used to feed invalids too weak or ill to sit in an upright position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invalid cups"@en .

aat:300426566 a skos:Concept ;
    skos:definition "Light two-wheeled open horse-drawn vehicles used especially in Ireland with lengthwise seats, usually to accommodate four persons, formerly more, placed face-to-face or back to back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jaunting cars"@en .

aat:300426567 a skos:Concept ;
    skos:definition "Toy versions of a four-wheeled vehicle propelled by pumping a handlebar and steered with the feet on the front wheels. Colloquially known as an “Irish Mail,” the donor used this as a toy in his youth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irish mail"@en .

aat:300426569 a skos:Concept ;
    skos:definition "Machines used to clean and gut fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron butchers"@en .

aat:300426580 a skos:Concept ;
    skos:definition "Plates on which heated irons may rest when not being used so as not to damage surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironing trivets"@en .

aat:300426594 a skos:Concept ;
    skos:definition "Rising shed looms that use jacks, or lifting devices, attached to pivots and controlled by treadles to raise numerous shafts individually without affecting the size of the shed. These looms typically comprise four or more shafts, each of which are controlled by two jacks that are activated when a user pushes the treadle with their foot. After the treadle is pushed, one end of the jack is raised while the other end is lowered thus causing the shaft to rise. Unlike other looms, however, some of the shafts cannot be controlled by the weaver because they are not tied to a treadle; these shafts are often weighted so that they can remain lowered against the pull of the warp. While jack looms are both portable and popular for novice weavers, their weighted shafts can cause limitations for certain weaving tasks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jack looms"@en .

aat:300426608 a skos:Concept ;
    skos:definition "Small cards, often rectangular in shape and made of wood, into which a series of holes are punched corresponding to a row of textile pattern. These cards are designed to control the operation of Jacquard looms by dictating the movement of the loom's needle in accordance with the predesigned pattern. Laced together by rope into long rows, the cards are fed onto the Jacquard loom's perforated, cylindrical feeder, which moves them towards the needle board until they come in contact with the needle. Joseph Marie Jacquard is credited with inventing these cards, and the Jacquard looms they control, in 1801. These cards not only increased the efficiency of the weaving process, but are also considered to have laid the foundation for modern computer programming technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacquard cards"@en .

aat:300426626 a skos:Concept ;
    skos:definition "Air-tight lids with rubber gaskets designed to screw on glass jars for home canning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jar lid seals"@en .

aat:300426627 a skos:Concept ;
    skos:definition "Tongs used to handle hot jars and lids during the process of home canning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jar lifters"@en .

aat:300426631 a skos:Concept ;
    skos:definition "Manual or machine-operated accessories for construction that level and grade rough surfaces, especially where there is existing sod or vegetation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grading rakes"@en .

aat:300426632 a skos:Concept ;
    skos:definition "Devices that separate grains such as oats by grade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grading separators"@en .

aat:300426635 a skos:Concept ;
    skos:definition "Printed matter that formally declares the occurance of the award or acceptance of an academic degree or diploma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graduation announcements"@en .

aat:300426636 a skos:Concept ;
    skos:definition "Instruments for dividing straight or curved lines into smaller regular sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graduators"@en .

aat:300426644 a skos:Concept ;
    skos:definition "Noisemakers, usually comprised of a handle and a rectangular wooden rattle. Used as part of Purim celebrations; during the reading of the ‘Scroll of Esther,’ children are encouraged to rattle gragers each time Haman, the chief minister of the Persian King Ahasuerus, is named. This act is symbolically meant to drown out his plot against Persian Jews."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gragers"@en .

aat:300426646 a skos:Concept ;
    skos:definition "Receptacles made of flexible material used for holding grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain bags"@en .

aat:300426647 a skos:Concept ;
    skos:definition "Devices used to hold and fill grain bags, consisting of a tube- or funnel-like top to which a bag can be attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain bag holders"@en .

aat:300426655 a skos:Concept ;
    skos:definition "Mechanical devices used to clean and remove foreign objects from grain, such wheat, corn, barley, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain cleaners"@en .

aat:300426656 a skos:Concept ;
    skos:definition "Devices that treat grain for the maximum extraction of flour, and that may cool and air out grain in order to help preserve it, or introduce water and heat to separate constituent parts of the grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain conditioners"@en .

aat:300426662 a skos:Concept ;
    skos:definition "Machines used to grind grains into flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain mills"@en .

aat:300426663 a skos:Concept ;
    skos:definition "Receptacles of a hard material with a cup-shaped cavity in which grains are pounded or ground with a pestle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain mortars"@en .

aat:300426666 a skos:Concept ;
    skos:definition "Devices used for weighing grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain scales"@en .

aat:300426667 a skos:Concept ;
    skos:definition "Machines for separating grains from their husks, using a current of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain scourers"@en .

aat:300426675 a skos:Concept ;
    skos:definition "Hog-bristle tools, typically made of rubber or metal, used to create the illusion of a wood grain pattern when drawn through wet glaze or top coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graining brushes"@en .

aat:300426678 a skos:Concept ;
    skos:definition "Tools, consisting of wooden or metal rollers mounted on spindles and attached to frames and handles, used to produce the illusion of natural wood grain. Typically, an imitation wood grain pattern is cut or stamped on a leather or rubber band, which is then wrapped around the roller, fed with color, and applied to a surface by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graining rollers"@en .

aat:300426686 a skos:Concept ;
    skos:definition "Instruments, dating from the early 20th century, used for measuring grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granometers"@en .

aat:300426689 a skos:Concept ;
    skos:definition "Knives with blades designed to separate the pith and flesh of grapefruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grapefruit knives"@en .

aat:300426696 a skos:Concept ;
    skos:definition "Software used to create computer graphics, or edit and otherwise manipulate existing graphics; examples include raster graphics software, which is used to edit two-dimensional images; vector graphics software, which is used as a drawing tool to create graphic layouts; and 3-d graphics software which creates simulations based on given viewpoints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphics software"@en .

aat:300426700 a skos:Concept ;
    skos:definition "Devices that contain magnifying lenses arranged for viewing engravings, photographs, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphoscopes"@en .

aat:300426703 a skos:Concept ;
    skos:definition "Refers to a variety of of mechanical claws for grasping and moving logs or timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grapples"@en .

aat:300426705 a skos:Concept ;
    skos:definition "Instruments with iron claws, resembling anchors, intended to be thrown while attached to a rope for the purpose of seizing and holding an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grappling hooks"@en .

aat:300426711 a skos:Concept ;
    skos:definition "Cast iron grates that fit in the bottom of a coal or wood-burning heating stove to allow air to flow into the fire and ashes to pass down to the ash pan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grate shakers"@en .

aat:300426719 a skos:Concept ;
    skos:definition "Vessels designed to separate gravy or another liquid from solid fat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravy separators"@en .

aat:300426722 a skos:Concept ;
    skos:definition "Containers typically made of metal, and often cylindrical in form intended to hold grease for cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grease cans"@en .

aat:300426729 a skos:Concept ;
    skos:definition "Mesh implements for cleaning cooking oil or separating food particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grease strainers"@en .

aat:300426742 a skos:Concept ;
    skos:definition "Fitted coverings that protect standalone cooking grills from dust and dirt when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grill covers"@en .

aat:300426751 a skos:Concept ;
    skos:definition "Mechanical devices of varied design that are used to grip or clutch an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grippers"@en .

aat:300426753 a skos:Concept ;
    skos:definition "In mining, gratings of iron bars with interstices between that allow finer material to fall through while larger stones are screened off."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grizzlies"@en .

aat:300426757 a skos:Concept ;
    skos:definition "Punches for cutting holes in fabric to set grommets in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grommet punches"@en .

aat:300426763 a skos:Concept ;
    skos:definition "Sheets of impermiable material meant to be layed on the ground as a base for a portable mattress or other sleeping mat, usually in the context of sleeping outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground cloths"@en .

aat:300426784 a skos:Concept ;
    skos:definition "Projectiles provided with means for altering their direction after being launched, either by remote control or as directed by equipment carried in the weapon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guided missiles"@en .

aat:300426792 a skos:Concept ;
    skos:definition "Objects that are pressed against the strings of a guitar while playing. Typically these are worn on a finger of the fretting hand, creating a glissando effect without touching the frets. Guitar slides can be professionally made, or they can be household objects, such as bottlenecks. They appear in many forms, and differ based on the type of guitar used or the style of the player."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guitar slides"@en .

aat:300426807 a skos:Concept ;
    skos:definition "Components of shotgun shells that are used to separate the shot from the powder, contain the shotgun shot, and provide a seal that prevents gas from blowing through the shot rather than propelling the shot out of the shotgun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun wads"@en .

aat:300426821 a skos:Concept ;
    skos:definition "Sacks of coarse material usually made from jute fiber intended for bulk storage and transport of goods such as fruits and vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunny sacks"@en .

aat:300426824 a skos:Concept ;
    skos:definition "Wheeled stretchers, trollies, or cots used to transport patients in an ambulance or hospital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gurneys"@en .

aat:300426829 a skos:Concept ;
    skos:definition "Ropes or wires used to guide and steady anything which is being hoisted in the air; or to secure or steady objects to prevent them shifting position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guys"@en .

aat:300426841 a skos:Concept ;
    skos:definition "Instruments designed to demonstrate the mothion of rotating bodies, consisting essentially of a rotating wheel mounted in a ring, with its axis free to turn in any direction. With modifications or in conjunction with other equipment, these may be used as navigational devices, or to stabilize ships and mono-rail vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gyroscopes"@en .

aat:300426849 a skos:Concept ;
    skos:definition "Trumpets, usually historic, that were used to amplify the voice, particularly aboard ships during the 19th century. They were used specifically for communication between ships, or to issue orders to the crew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hailing trumpets"@en .

aat:300426850 a skos:Concept ;
    skos:definition "Objects originally created as ornaments for hair, as implements for securing a hairstyle, or as artificial substitutes for hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair adornments"@en .

aat:300426851 a skos:Concept ;
    skos:definition "Ornamental hairpins or sticks used to hold hair in place, or simply for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair bodkins"@en .

aat:300426852 a skos:Concept ;
    skos:definition "Hair accessories made of rope, ribbon, or fabric. Made of knots with two loops and two ends. Sometimes affixed to clips, headbands, or pins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair bows"@en .

aat:300426856 a skos:Concept ;
    skos:definition "Ornaments worn in hair, often decorated with varied materials or shaped in different forms. Attached by two grips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair clips"@en .

aat:300426863 a skos:Concept ;
    skos:definition "Artifical or naturally-derived hair attached to the wearer's own hair to create a thicker or longer appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair extensions"@en .

aat:300426871 a skos:Concept ;
    skos:definition "Long, rectangular pieces of fabric used as hair accessories, often tied in a bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair ribbons"@en .

aat:300426875 a skos:Concept ;
    skos:definition "Fabric cord, ribbon, or rope worn as a decorative hair ornament; sometimes decorated with added features such as fabric flowers, bows, beadwork, or colored fabric. Usually has the decorative element placed in the middle or at the ends of the fabric, with the rest of the item secured to hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair ties"@en .

aat:300426877 a skos:Concept ;
    skos:definition "Decorative headgear, usually incorporating flowers, leaves, or artificial flora, in the shape of a ring worn on or around the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair wreaths"@en .

aat:300426878 a skos:Concept ;
    skos:definition "Small containers made of fabric, often decorated with a ribbon encircling the top opening. Made to contain hair and the end of wigs to keep them from damaging clothing worn by the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairbags"@en .

aat:300426885 a skos:Concept ;
    skos:definition "Containers made to store hairpins, often rectangular in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairpin boxes"@en .

aat:300426886 a skos:Concept ;
    skos:definition "Containers made to store hairpins, often rectangular or cylindrical in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairpin cases"@en .

aat:300426887 a skos:Concept ;
    skos:definition "Receptacles that store hairpins when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairpin containers"@en .

aat:300426888 a skos:Concept ;
    skos:definition "Small vessels for use at a dressing table, of varied shape, with a lid with an opening for depositing hairpins after use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairpin receivers"@en .

aat:300426889 a skos:Concept ;
    skos:definition "Long, rectangular hairpins used to hold up and decorate hairstyles. Often decorated, either with figurative elements or with incised details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairsticks"@en .

aat:300426891 a skos:Concept ;
    skos:definition "Wreaths made of human hair that are commemorative of a loved one. These are usually a product of the Victorian era, and would be displayed in glass cases as decorative objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairwork wreaths"@en .

aat:300426914 a skos:Concept ;
    skos:definition "Sets for board games for 2 to 6 participants that is played on a square or hexagonal (star-shaped) playing field with a set of marbles. The variant with a hexagonal (star-shaped) playing field is called Chinese checkers or sternhalma. Halma boards often feature both boards on the front and back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese checkers sets"@en .

aat:300426916 a skos:Concept ;
    skos:definition "Instruments for measuring the forms and angles of salts and crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halometers"@en .

aat:300426920 a skos:Concept ;
    skos:definition "Bladed tools for carving cooked ham."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ham knives"@en .

aat:300426925 a skos:Concept ;
    skos:definition "Mechanical devices that use high-speed hammers to grind dry corn and other grains to create feed for livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer mills"@en .

aat:300426934 a skos:Concept ;
    skos:definition "Manual wool carders used in the spinning of cotton, wool, and other natural fibers. These hand-held devices are typically made of sharp wire or steel teeth adhered to layered leather and mounted on rectangular wooden frames a thin handles. To carry out the manual carding process, users hold a card in each hand with the teeth pointing towards each other. Wool or other fibers are placed between both cards, which are dragged lightly over the wool to disentangle and smooth the fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand cards"@en .

aat:300426936 a skos:Concept ;
    skos:definition "Hand-held devices, comprised of long metal teeth mounted on a thin rectangular wooden base with a handle, used straighten and make uniform natural fibers. Typically, a user would employ two combs, one of which was fixed to a post by an iron rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand combs"@en .

aat:300426942 a skos:Concept ;
    skos:definition "Hand held, flat objects used to produce a flow of air, usually for the purpose of cooling oneself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand fans"@en .

aat:300426945 a skos:Concept ;
    skos:definition "Fitness equipment made to improve hand strength; consists of two handles held together by thick wire. Users squeeze the handles together when exercising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand grippers"@en .

aat:300426958 a skos:Concept ;
    skos:definition "Devices consisting of a cylindrical metal container equipped with a plunger-like insert and a nozzle. Used for spraying or misting plants with water, pesticides or fertilizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand sprayers"@en .

aat:300426959 a skos:Concept ;
    skos:definition "Small towels or cloths used to dry hands after washing them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand towels"@en .

aat:300426966 a skos:Concept ;
    skos:definition "Wheels located on the side of a sewing machine, designed to manually control the movement of the machine's take-up lever and needle bar, as well as move the fabric in the sewing machine from front to back. Used as an alternative to a sewing machine's foot pedal, these wheels offer more precise regulation of the needle, better ensuring that it will not break or get stuck in the fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand wheels"@en .

aat:300426979 a skos:Concept ;
    skos:definition "Broadly, any computer that may be portable; these include personal digital assistants (PDAs), tablets, and smartphones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handheld computers"@en .

aat:300426981 a skos:Concept ;
    skos:definition "Flash devices for photography that are designed to be held in the hand or mounted on a bracket rather than on the camera itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handheld flashes"@en .

aat:300426986 a skos:Concept ;
    skos:definition "Accessories used to hold handkerchiefs for personal use; some examples take the form of a chain with a ring for the handkerchief to be looped and knotted through. Others take the form of a rectangular wallet, with the handkerchief stored inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handkerchief holders"@en .

aat:300426996 a skos:Concept ;
    skos:definition "Bars used as levers, often made of wood and tipped with iron; typically used on board a ship for maneuvring heavy objects such as artillery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handspikes"@en .

aat:300426998 a skos:Concept ;
    skos:definition "Stones used to mill grain into flour. The handstone is held by the operator and used to crush the grain against a larger, stationary stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handstones"@en .

aat:300427008 a skos:Concept ;
    skos:definition "Loops tied at the end of rope usually knotted so that the loop tightens as pressure is exerted upon it with the weight of a person being executed by hanging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangman's nooses"@en .

aat:300427011 a skos:Concept ;
    skos:definition "Long iron hooks, often used in pairs, designed to secure cloth to a cropping board or padded bench in order for the cloth's nap to be sheared. Used in the finishing process of fulled cloth, these hooks are comprised of sharp barbs that attach to cloth and hold it taut over a board or bench, stabilizing the cloth for subsequent fabrication activities. Often, these hooks are secured with a central block on their lengh, which acts as a grip to facilitate manual attachment or removal. Though its name has changed over the centuries, a version of this tool has been utilized in the textile production process since the medieval period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harbicks"@en .

aat:300427018 a skos:Concept ;
    skos:definition "Loose, billowy skirts gathered at the waist and hem, resembling garments traditionally worn by the inhabitants of a harem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harem skirts"@en .

aat:300427019 a skos:Concept ;
    skos:definition "Devices that analyze periodic functions to find their harmonic components. Early examples measured the harmonic components of sound waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmonic analyzers"@en .

aat:300427021 a skos:Concept ;
    skos:definition "Instruments for measuring the harmonic relation of sounds, or musical notes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmonometers"@en .

aat:300427050 a skos:Concept ;
    skos:definition "Small brushes with soft, often long bristles of camel hair, straw, or other natural fibers set into round, elliptical, or curved bases of wood, metal, ivory, or other material. These often have a long stem-like handles. Used to revive the pile of velvet and felt hats or to brush lint and dust away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat brushes"@en .

aat:300427051 a skos:Concept ;
    skos:definition "Accessories used to protect hats from rain and other elements, usually made of plastic or other flexible materials. Covers the hat entirely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat covers"@en .

aat:300427052 a skos:Concept ;
    skos:definition "Molds or dies onto which a partly formed hat is pressed in order to shape it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat molds"@en .

aat:300427053 a skos:Concept ;
    skos:definition "Feathers, bunches of feathers, or other like materials such as horsehair used to ornament hats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat plumes"@en .

aat:300427055 a skos:Concept ;
    skos:definition "Ribbons decorating hats, as hat bands, bows, or in other decorative arrangements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat ribbons"@en .

aat:300427068 a skos:Concept ;
    skos:definition "Containers made to store hatpins; generally in the form of a hollow cylinder or rectangular box with holes in the top to hold the pins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatpin holders"@en .

aat:300427074 a skos:Concept ;
    skos:definition "Large ropes or small cables midway between the size of a cable or a tow-line, and 5 to10 inches in circumference; used in warping and mooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hawsers"@en .

aat:300427117 a skos:Concept ;
    skos:definition "Articles that overlie articles worn on the head with the effect of protecting, enclosing, decorating, or hiding them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headwear covers"@en .

aat:300427118 a skos:Concept ;
    skos:definition "Accessories added to headwear for decorative or ceremonial purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headwear ornaments"@en .

aat:300427129 a skos:Concept ;
    skos:definition "Metal tripods for use in large open hearths that suspend pots or other cooking vessels over the fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearth tripods"@en .

aat:300427134 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising overfeeding, heating, cooling, press roller, and folding components, designed to expose dyed fabrics to controlled heat and pressure in order to improve the fabrics' dimensional stability. Utilized on wetted and elongated fabrics, these devices apply steam or hot air to materials to restore their original shape and geometrics by releasing any internal stress introduced to the fabric by the dyeing process. Commonly used as part of the fabrics' post-treatment process, the devices induce a series of physical and chemical changes to relax, realign, and permanently set the fabrics in their desired configurations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat setting machines"@en .

aat:300427135 a skos:Concept ;
    skos:definition "Barriers of ablative material to protect a spacecraft from heat on its entry into an atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat shields"@en .

aat:300427136 a skos:Concept ;
    skos:definition "Various contrivances for imparting heat, usually in enclosed spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heaters"@en .

aat:300427138 a skos:Concept ;
    skos:definition "Fittings, attachments, or auxiliary objects related to devices that impart heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating equipment accessories"@en .

aat:300427141 a skos:Concept ;
    skos:definition "Closed boxes or vessels of earthenware or metal, which may be portable or fixed, in which heat is produced by combustion of fuel or electrically, for use in warming spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating stoves"@en .

aat:300427143 a skos:Concept ;
    skos:definition "Massive helmets, reaching to the shoulders, worn in the 12th and 13th centuries, sometimes a smaller close-fitting ones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heaumes"@en .

aat:300427144 a skos:Concept ;
    skos:definition "Wooden bars or staffs, sometimes tapered at the ends, employed as an apparatus for heaving or lifting, as a lever."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heavers"@en .

aat:300427162 a skos:Concept ;
    skos:definition "Instruments that were historically used for measuring the diameter of the sun. In later use, heliometers were used to determine the angular distance between stars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliometers"@en .

aat:300427163 a skos:Concept ;
    skos:definition "Instruments, including some telescopes, with dark glass or reflectors for use in safely observing the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helioscopes"@en .

aat:300427164 a skos:Concept ;
    skos:definition "Devices outfitted with mirrors which, when turned clockwise, direct the sun’s light in a particular direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliostats"@en .

aat:300427166 a skos:Concept ;
    skos:definition "Boxes covered in black paper where plants are placed; slits are cut into the box, the incoming light from which causes observable heliotropic bending or movement of plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliotropic chambers"@en .

aat:300427170 a skos:Concept ;
    skos:definition "Covers, usually of textile material, in a variety of forms, for use on military helmets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet covers"@en .

aat:300427171 a skos:Concept ;
    skos:definition "Soft, supportive lining placed inside headgear to protect the wearer from injury."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet cushions"@en .

aat:300427177 a skos:Concept ;
    skos:definition "Tools comprising a metal ruler or hem guide on which various widths are marked, as well as a bulb with marking power, designed to mark, measure, and press up even hems on a variety of garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hem markers"@en .

aat:300427178 a skos:Concept ;
    skos:definition "Devices used to estimate the number of corpuscles in given volumes of blood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemocytometers"@en .

aat:300427180 a skos:Concept ;
    skos:definition "Devices used to measure the amount of hemoglobin in given volumes of blood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemoglobinometers"@en .

aat:300427184 a skos:Concept ;
    skos:definition "Machines designed to sew blind stitches or other finishing stitches for the hems of garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemstitching machines"@en .

aat:300427187 a skos:Concept ;
    skos:definition "Racks of mesh for laying out herbs to dry for use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herb drying racks"@en .

aat:300427188 a skos:Concept ;
    skos:definition "Devices for reducing dried herbs to small particles for use in cookery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herb grinders"@en .

aat:300427199 a skos:Concept ;
    skos:definition "Tall wooden chest of drawers, generally with seven or more drawers, divided in two sections resting on each other, the bottom one being slightly wider and resting on legs. Used to store clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high chests"@en .

aat:300427200 a skos:Concept ;
    skos:definition "Devices for determining phosphates in boiler water consisting of a slide with incremental or gradiated standard measurements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high phosphate slide comparators"@en .

aat:300427209 a skos:Concept ;
    skos:definition "Tailored costumes, made of durable and light-weight materials, worn predominately in the early 20th century by those engaging in outdoor activities Typically comprised of a matching set of garments including breeches, blazers, and sport shirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hiking suits"@en .

aat:300427218 a skos:Concept ;
    skos:definition "Surviving objects having interest by reason of their age or association with the past."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic relics"@en .

aat:300427231 a skos:Concept ;
    skos:definition "Skaters' gloves worn in the game of ice Hockey to help prevent player's hands from being injured or burned from the ice. Padding and a shell thumb is provided as protection from hockey pucks and sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hockey gloves"@en .

aat:300427242 a skos:Concept ;
    skos:definition "Fitted material cases that go on a mattress for protection under sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mattress covers"@en .

aat:300427251 a skos:Concept ;
    skos:definition "Long-handles utensils with a deep scoop used for serving mayonnaise or other condiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mayonnaise ladles"@en .

aat:300427252 a skos:Concept ;
    skos:definition "Devices consisting of a rotary beater and a vessel intended for making mayonnaise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mayonnaise mixers"@en .

aat:300427261 a skos:Concept ;
    skos:definition "Glasses with graduated markings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring glasses"@en .

aat:300427263 a skos:Concept ;
    skos:definition "Small cup used as a measure in mixing cocktails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring jiggers"@en .

aat:300427266 a skos:Concept ;
    skos:definition "Mechanical devices with multiple blades designed to finely chop or grind meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat choppers"@en .

aat:300427267 a skos:Concept ;
    skos:definition "Preparation tables, usually with a cutting surface of wood or other material for cutting or chopping meat products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat cutting tables"@en .

aat:300427270 a skos:Concept ;
    skos:definition "Bars that support hooks for hanging meats for a variety of purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat hanging bars"@en .

aat:300427271 a skos:Concept ;
    skos:definition "Large hooks used to suspend meat carcasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat hooks"@en .

aat:300427273 a skos:Concept ;
    skos:definition "Utensils that consist of a steel tank mounted with mixing paddles attached to a crank, used for preparing meat for sausages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat mixers"@en .

aat:300427274 a skos:Concept ;
    skos:definition "Devices for extracting liquids from meat via compression, consisting of plates that can be mechanically pressed together and an attached receptacle for collecting the juice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat presses"@en .

aat:300427276 a skos:Concept ;
    skos:definition "Shallow troughs used for curing meat with salt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat salting troughs"@en .

aat:300427277 a skos:Concept ;
    skos:definition "Tools with serrated blades used in the process of butchering meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat saws"@en .

aat:300427278 a skos:Concept ;
    skos:definition "Devices for weighing meat, usually to price a portion for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat scales"@en .

aat:300427279 a skos:Concept ;
    skos:definition "Metal implements used in hearth cooking to reflect the heat of the fire towards a piece of roasting meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat screens"@en .

aat:300427280 a skos:Concept ;
    skos:definition "Tools used to slice meats, sausages, cheeses or other products. These may be manually or electrically operated, and have adjustments for the thickness of slices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat slicers"@en .

aat:300427281 a skos:Concept ;
    skos:definition "Chambers used for preserving meat by exposing them to smoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat smokers"@en .

aat:300427282 a skos:Concept ;
    skos:definition "Thermometers designed to be inserted into meat during cooking in order to measure its internal temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat thermometers"@en .

aat:300427285 a skos:Concept ;
    skos:definition "Modular devices for heavy-duty earth-moving machines used for gripping and handling bulk materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical buckets"@en .

aat:300427286 a skos:Concept ;
    skos:definition "Machine simulating the experience of riding a bull; a motor is used to manipulate the item. The bull facsimile usually depicts the head and upper body. Riders sit on the top of the bull and attempt to stay on the item for as long as possible. Usually a soft mat is placed around the machine to break riders' falls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical bulls"@en .

aat:300427290 a skos:Concept ;
    skos:definition "Figurative toys or animal toys with a mechanism or a mechanical device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical figures"@en .

aat:300427298 a skos:Concept ;
    skos:definition "Watches that use a clockwork mechanism to measure time with a mainspring which gets wound and holds force which then goes on to power the balance wheel. The gear train transmits the force and also calculates the swings totaling the seconds, minutes and hours."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical watches"@en .

aat:300427337 a skos:Concept ;
    skos:definition "Collections of significant items wrapped in animal hide or other materials, which hold cultural or ceremonial importance for Indigenous peoples, particularly in the Plains region of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine bundles"@en .

aat:300427339 a skos:Concept ;
    skos:definition "Small portable cases or pouches that are designed to accommodate a variety of medicines for travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine cases"@en .

aat:300427346 a skos:Concept ;
    skos:definition "Printed matter that formally declares the occurance of an assembly for a common purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meeting announcements"@en .

aat:300427351 a skos:Concept ;
    skos:definition "Instruments that contain a combination of colored glasses that transmit only red light, used for viewing colored flame to detect the presence of potassium or other substances, by the red light that they emit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melanoscopes"@en .

aat:300427353 a skos:Concept ;
    skos:definition "A brand and type of electronic musical keyboard instrument developed by Harry Chamberlin in conjunction with a London-based manufacturer, which incorporated a selection of electromagnetic tape samples, as looped recordings played by pressing the keys of a keyboard. The prototype, the Mellotron Mark II, was available in 1964, and was used by numerous pop and rock groups, such as the Beatles and the Moody Blues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mellotrons"@en .

aat:300427359 a skos:Concept ;
    skos:definition "Objects that are worn by individuals that are meant to indicate membership within a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membership badges"@en .

aat:300427362 a skos:Concept ;
    skos:definition "Documents that ratify or identify the belonging of an individual to an official group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membership certificates"@en .

aat:300427367 a skos:Concept ;
    skos:definition "Ornamental textiles that are attached to clothing that bear insignia identifying membership or affiliation with a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membership ribbons"@en .

aat:300427372 a skos:Concept ;
    skos:definition "Games where concentration and remembering certain patterns or figures are required to win the game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memory games"@en .

aat:300427374 a skos:Concept ;
    skos:definition "Fusible tape activated by high heat, usually from a hand-iron, that allows for adhering textiles together, often for hems without the use of stitching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mending tape"@en .

aat:300427380 a skos:Concept ;
    skos:definition "Devices used to hold menu cards upright and visible to diners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menu holders"@en .

aat:300427381 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising an automated range of stenter chains for tension control, designed to facilitate the application of a caustic soda chemical treatment on cotton fabrics to prepare the fabrics for subsequent dying and chemical finishes. By providing a temperature and tension controlled surface upon which the wet textile process of mercanization is carried out, these devices give fabrics a lustrey finish, increased tensile strength, and greater absorptive properties, creating a foundation for finishing treatments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercerizing machines"@en .

aat:300427389 a skos:Concept ;
    skos:definition "Historical term for telescopes, each equipped with a graduated circle, by which the right ascension and declination of stars can be observed in transit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meridian circles"@en .

aat:300427391 a skos:Concept ;
    skos:definition "Embroidered badges awarded for completion or proficiency in a particular subject, activity, craft, or other event associated with a formal organization. These are normally worn on a recipient's clothing or uniform, or on a sash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merit badges"@en .

aat:300427392 a skos:Concept ;
    skos:definition "Equipment for children's playgrounds or other venues, comprising a flat disk suspended on a pole in the middle, with bars for hand-holds and support; the devices spin using manual rotary motion supplied by a child or adult pushing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roundabouts"@en .

aat:300427395 a skos:Concept ;
    skos:definition "Large boxes with compartments for containing rations of food, tobacco, or beverages; used by troops on the march."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mess chests"@en .

aat:300427403 a skos:Concept ;
    skos:definition "Devices used to determine the oxygen consumption of animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metabolism apparatuses"@en .

aat:300427409 a skos:Concept ;
    skos:definition "Burnishers intended for metalworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal burnishers"@en .

aat:300427482 a skos:Concept ;
    skos:definition "Historic instruments for making observations of celestial objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteoroscopes"@en .

aat:300427485 a skos:Concept ;
    skos:definition "Vessels of Celtic tradition, particularly Irish, used for drinking mead, often communally.These often have squared sides and handles, and may be made of wood or ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methers"@en .

aat:300427492 a skos:Concept ;
    skos:definition "Utensils consisting of a crescent-shaped blade with a handle at each end; the blade is rocked to chop ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezzalunas"@en .

aat:300427493 a skos:Concept ;
    skos:definition "Devices used to achieve duration and very controlled temperatures for heating of materials, or for other purposes for analysis in a laboratory context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro combustion apparatuses"@en .

aat:300427498 a skos:Concept ;
    skos:definition "Equipment consisting of a film transport mechanism, an optical projection and enlarging system, and a translucent screen. It was designed to handle roll film on reels and can be equipped with motorized drives or operated manually. Additionally, the readers include on/off and focus controls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfilm readers"@en .

aat:300427502 a skos:Concept ;
    skos:definition "Gauges that are used for measuring changes in air pressure, velocity, or flow. These can measure extremely small differences in pressure of both gas and liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micromanometers"@en .

aat:300427510 a skos:Concept ;
    skos:definition "Blades that are used to prepare specimens for viewing under microscopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microscopic section cutters"@en .

aat:300427515 a skos:Concept ;
    skos:definition "Devices for removing impurities from and grinding middlings (larger pieces of grain left over from the process of grinding grain into flour)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middlings mills"@en .

aat:300427516 a skos:Concept ;
    skos:definition "Devices that use a current of air to remove bran from middlings (pieces of grain left over from the process of milling grain into flour)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middlings purifiers"@en .

aat:300427541 a skos:Concept ;
    skos:definition "Containers used to transport milk bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk bottle carriers"@en .

aat:300427542 a skos:Concept ;
    skos:definition "Devices used to clean milk bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk bottle washers"@en .

aat:300427544 a skos:Concept ;
    skos:definition "Devices for sterilizing milk cans using steam and boiling water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk can washers"@en .

aat:300427545 a skos:Concept ;
    skos:definition "Machines or devices that are components of a milk cooling tank that removes heat from milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk condensers"@en .

aat:300427546 a skos:Concept ;
    skos:definition "Devices used to keep milk cool in order to keep it from spoiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk coolers"@en .

aat:300427547 a skos:Concept ;
    skos:definition "Devices used to remove some portion of the water content from liquid milk by boiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk evaporators"@en .

aat:300427548 a skos:Concept ;
    skos:definition "Devices used to heat milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk heaters"@en .

aat:300427549 a skos:Concept ;
    skos:definition "Devices used to homogenize milk by forcing milk through a small opening at high pressure. This reduces the size of the fat globules found in the milk, preventing them from clumping and allowing the fat to remain evenly distributed throughout the milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk homogenizers"@en .

aat:300427551 a skos:Concept ;
    skos:definition "Shallow, flat vessels used to separate cream from milk. The milk is allowed to rest in the pan until the cream rises to the top, at which point it may be skimmed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk pans"@en .

aat:300427552 a skos:Concept ;
    skos:definition "Devices used to heat raw milk and hold it at temperature for a certain period of time in order to destroy microorganisms, making it safer to consume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk pasteurizers"@en .

aat:300427554 a skos:Concept ;
    skos:definition "Devices used to pump milk from one vessel (such as a tank) to another in a dairy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk pumps"@en .

aat:300427555 a skos:Concept ;
    skos:definition "Devices used to gather a representative sample of a large quantity of milk in order to subject the sample to testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk samplers"@en .

aat:300427556 a skos:Concept ;
    skos:definition "Scales used to weigh milk. They often take the form of spring scales with a hook from which a bucket of milk can be hung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk scales"@en .

aat:300427557 a skos:Concept ;
    skos:definition "Devices used to measure the amount of dirt or other contaminants in a given quantity of milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk sediment testers"@en .

aat:300427558 a skos:Concept ;
    skos:definition "Devices used to stir fresh milk in order to quickly cool the \"animal heat\" (residual heat from the body of the cow from which the milk was obtained)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk stirrers"@en .

aat:300427561 a skos:Concept ;
    skos:definition "Thermometers used to measure the temperature of milk during pasteurization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk thermometers"@en .

aat:300427563 a skos:Concept ;
    skos:definition "Tubes inserted into the udder of a cow in order to withdraw milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk tubes"@en .

aat:300427564 a skos:Concept ;
    skos:definition "Devices of various designs used to automatically milk cows via physical and vacuum pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milking machines"@en .

aat:300427565 a skos:Concept ;
    skos:definition "Cylindrical, flat-bottomed wood or metal containers, equipped with a moveable bail handle and sometimes a handle at the side. Used to collect milk from barn animals like cows and goats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milking pails"@en .

aat:300427567 a skos:Concept ;
    skos:definition "Small pails, usually wooden, with one long stave used as a handle, used as a milking pail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milking piggins"@en .

aat:300427569 a skos:Concept ;
    skos:definition "Devices used to test the purity of milk, providing information on quantities of chalk, lime, or water found in the tested milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milkometers"@en .

aat:300427575 a skos:Concept ;
    skos:definition "Devices used in the process of grain cleaning to separate out impurities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milling separators"@en .

aat:300427608 a skos:Concept ;
    skos:definition "Small-scale models of rooms with related furniture and ornaments; usually they are collectibles made for recreation or display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature rooms"@en .

aat:300427617 a skos:Concept ;
    skos:definition "Devices used to assist with opening sealed lidded jars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jar wrenches"@en .

aat:300427631 a skos:Concept ;
    skos:definition "Utensils specially designed to retrieve and spread jelly or other foodstuffs from a jar. These are designed to reach the bottom surface of a vessel, having a curved edge, often culminating in a point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jelly knives"@en .

aat:300427634 a skos:Concept ;
    skos:definition "Cloth bags used to strain cooked fruit, separating pulp from juice, in the process of making jelly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jelly strainers"@en .

aat:300427645 a skos:Concept ;
    skos:definition "Medium sized compartmentalized boxes designed to store various items of jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry cases"@en .

aat:300427652 a skos:Concept ;
    skos:definition "Devices of various forms that mechanically maintain a correct positional relationship between a piece of work and a tool, or for positioning parts of an object during assembly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jigs"@en .

aat:300427660 a skos:Concept ;
    skos:definition "Cloth garments of a particular type, decorated with metal cones or beads. These cones are usually sewn in rows on the skirt of the dress, but can also appear across the entire garment. Used as part of powwow and medicine dances, originating with Anishinaabe/Ojibwe Native communities in the late 19th to early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jingle dresses"@en .

aat:300427686 a skos:Concept ;
    skos:definition "Things used in the sport or entertainment of tossing and catching or manipulating objects in the air and/or keeping them in constant motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juggler's props"@en .

aat:300427687 a skos:Concept ;
    skos:definition "Spherical objects that may be made of a variety of materials, and that may be either solid or filled with particulate matter, especially made for throwing and catching in the air for recreation or for spectator entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juggling balls"@en .

aat:300427688 a skos:Concept ;
    skos:definition "Props used by jugglers that appear in a variety of materials, generally with a bulbous body transitioning into a narrow handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juggling clubs"@en .

aat:300427691 a skos:Concept ;
    skos:definition "Annular objects specially made for throwing and catching in choreographed movements. They are created in varied sizes, colors, and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juggling rings"@en .

aat:300427697 a skos:Concept ;
    skos:definition "Speakers, or speaker systems, that are connected to jukeboxes, either built-in or as satellites of the main cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jukebox speakers"@en .

aat:300427698 a skos:Concept ;
    skos:definition "Bladed tools designed to cut vegetables into thin strips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "julienne cutters"@en .

aat:300427711 a skos:Concept ;
    skos:definition "Devices used to draw lots or generate random numbers; for example, picking members for a jury. A common form is an octagonal container suspended from two posts; attached handle allows the container to rotate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jury wheels"@en .

aat:300427714 a skos:Concept ;
    skos:definition "Devices used to perform Kahn tests which determine the reactions for the diagnoses of syphilis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kahn test apparatuses"@en .

aat:300427729 a skos:Concept ;
    skos:definition "Cookstoves fueled by kerosene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerosene cookstoves"@en .

aat:300427730 a skos:Concept ;
    skos:definition "Devices that burn kerosene as fuel to create heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerosene heaters"@en .

aat:300427741 a skos:Concept ;
    skos:definition "Large locking cabinets that store many keys securely for a building or institution. These usually have a range of hooks on which the keys are hung in order for ease of retrieval."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key cabinets"@en .

aat:300427745 a skos:Concept ;
    skos:definition "Objects like carabiners that allow quick addition, removal, and storage of keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key clips"@en .

aat:300427748 a skos:Concept ;
    skos:definition "Small locking receptacles that provide secure storage for keys that need to be made available to multiple people. These are usually secured by a combination lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key guards"@en .

aat:300427756 a skos:Concept ;
    skos:definition "Keyboard-activated devices that punch holes in punch cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keypunches"@en .

aat:300427757 a skos:Concept ;
    skos:definition "Plastic sheets that fit over keyboards' keys which identify the keys' functions when using software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyboard templates"@en .

aat:300427774 a skos:Concept ;
    skos:definition "Brick made from ceramic refractory material that can withstand extremely high temperatures required for kiln firings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiln brick"@en .

aat:300427783 a skos:Concept ;
    skos:definition "Candleholders used during Kwanzaa celebrations; term is derived from a Swahili word meaning \"candleholder.\" Holds seven candles to represent the Seven Principles which are celebrated during each day of the Kwanzaa holiday. Examples include \"Imani\" (faith) and \"Umoja\" (unity)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinaras"@en .

aat:300427785 a skos:Concept ;
    skos:definition "Small pieces of dry split wood made to be easily ignitible, used to initiate larger fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kindling wood"@en .

aat:300427786 a skos:Concept ;
    skos:definition "Cameras used to photograph television broadcasts onto motion picture film media, used before the advent of videotape. Kinescope cameras were mounted before a video monitor, and synchronized to the monitor's scanning rate. The format could be either 16mm or 35mm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinescope cameras"@en .

aat:300427787 a skos:Concept ;
    skos:definition "Equipment developed and used in the early 19th century to synchronize images and sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinetophones"@en .

aat:300427788 a skos:Concept ;
    skos:definition "Equpment developed and used in the late 19th century as a home film projector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinetoscopes"@en .

aat:300427794 a skos:Concept ;
    skos:definition "Kitchen tools consisting of a cone ending in a spout, used to pour liquids or small grains into containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen funnels"@en .

aat:300427795 a skos:Concept ;
    skos:definition "Structures used for cooking and other food preparation, located separately from the living quarters in order to protect the main house from the smells of cooking and the danger of fire. Examples are found in North America, dating from the 18th century and later. There may be sleeping quarters for servants or enslaved persons incorporated in the house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen houses"@en .

aat:300427797 a skos:Concept ;
    skos:definition "Tools consisting of a blade fixed to a handle. Used to prepare food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen knives"@en .

aat:300427798 a skos:Concept ;
    skos:definition "Cases or coverings into which the blade of a kitchen knife is thrust when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen knife sheaths"@en .

aat:300427803 a skos:Concept ;
    skos:definition "Utensils consisting of a wide, shallow perforated bowl extending from a long handle. Used to remove foam and other undesirable substances floating on the surface of a liquid or to remove food from a liquid cooking medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen skimmers"@en .

aat:300427806 a skos:Concept ;
    skos:definition "Any of a variety of handheld devices with a part made from a fine mesh of metal wire, or textile, though which food or other material may be passed to puree it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen strainers"@en .

aat:300427808 a skos:Concept ;
    skos:definition "Devices that count down cooking time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen timers"@en .

aat:300427812 a skos:Concept ;
    skos:definition "Devices that propel unpowered aircraft aloft by creating lift force and velocity sufficient to keep them airborne on their own."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kite launchers"@en .

aat:300427813 a skos:Concept ;
    skos:definition "Any of various devices that incorporate a rotatable component by means of which a cord, line, or cable, can be released or rewound as required to tether unpowered aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kite reels"@en .

aat:300427814 a skos:Concept ;
    skos:definition "White cotton or linen robes worn by orthodox Jews on certain holy days; also used as a shroud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kittels"@en .

aat:300427816 a skos:Concept ;
    skos:definition "Suspended stones that are struck to make sound, specifically used in the kivas of Pueblo Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiva bells"@en .

aat:300427822 a skos:Concept ;
    skos:definition "Fasteners used to secure breeches to the wearer, with the buckles holding straps usually around the middle of the leg. Particularly worn in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knee buckles"@en .

aat:300427823 a skos:Concept ;
    skos:definition "Protective coverings for the knees used when working or crawling at floor level, or when kneeling for support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knee pads"@en .

aat:300427833 a skos:Concept ;
    skos:definition "Boxes or trays for holding knives, often divided into two or more compartments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife boxes"@en .

aat:300427837 a skos:Concept ;
    skos:definition "Blocks of wood with slots for holding knives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife racks"@en .

aat:300427841 a skos:Concept ;
    skos:definition "Boards used for cleaning and polishing knives, typically with an abrasive powder or other abrasive material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knifeboards"@en .

aat:300427843 a skos:Concept ;
    skos:definition "Small frames or spools around which yarn is wound to facilitate knitting projects requiring regular color changes. These frames are often made of plastic, wood, cardboard or other everyday materials. They are equipped with hooks or clamps designed to secure and organize yarn color changes by minimizing tangles and eliminating the need for multiple balls of yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting bobbins"@en .

aat:300427846 a skos:Concept ;
    skos:definition "Containers, often made of soft canvas and comprised of multiple fold-out or rollup pockets, designed with various compartments to store loose knitting needles and other related tools. In the late 19th and early 20th centuries, these containers often took the form of thin, cylindrical tubes made of silver, wood, or other hard materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting needle cases"@en .

aat:300427847 a skos:Concept ;
    skos:definition "Small ruler-like tools with graduated holes, often indicating both metric and imperial sizes, designed to identify the size of knitting needles and crochet hooks. These tools are especially useful for identifying the size of double-pointed needles, interchangeable needles, vintage needles, or other types of needles that are not labled for size. Unmarked needles are inserted into the gauge's various holes until the most similarly sized gauge hole is found and the needle's measurements are determined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting needle gauges"@en .

aat:300427858 a skos:Concept ;
    skos:definition "Small machines, both mechanized and hand-held, designed to rapidly and precisely tie a weaver's knot to faciliate the manufacture of woven and knitted goods. To secure the knots, these devices tie the warp yarns from a new beam onto the warp yarns from another warp on a loom. Traditionally, the operator holds the stand-alone knotter machine in their left hand with their thumb on its trigger; this trigger prompts the machine's guide fingers to move in a rotary action, which both creates a knot and trims the woven materials' loose ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knotters"@en .

aat:300427867 a skos:Concept ;
    skos:definition "Paddle-shaped wooden tools used to pack sauerkraut into jars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kraut mashers"@en .

aat:300427881 a skos:Concept ;
    skos:definition "Devices intended for use in a laboratory environment primarily in reading levels of a liquid in a capillary tube to determine surface tension, or for determining the changes in the liquid level during a chemical reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratory cathetometers"@en .

aat:300427885 a skos:Concept ;
    skos:definition "Devices or sets used to test and compare materials, often liquids, against a standardized scale of color, gradations, or other criteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratory comparators"@en .

aat:300427886 a skos:Concept ;
    skos:definition "Laboratory apparatuses of glass used to condense vapors to turn them into liquids by cooling them down. These may be single- or double-walled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratory condensers"@en .

aat:300427897 a skos:Concept ;
    skos:definition "Devices used to create tones and tone combinations in the service of acoustic or psychological research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratory organs"@en .

aat:300427918 a skos:Concept ;
    skos:definition "Small pillows or cushions, commonly designed to rest on a user's knee, utilized as a stable surface to facilitate the fabrication of handmade bobbin lace. After outlining a lace design onto the pillow/cushion with pins, the user draws and interlaces thread around the pins using the pillow/cushion as support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacemaker's cushions"@en .

aat:300427927 a skos:Concept ;
    skos:definition "Instruments that measure the amount of butter in milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lactobutyrometers"@en .

aat:300427930 a skos:Concept ;
    skos:definition "Materials, including wood planks or other materials that cover a boiler, an arch, or a wall to shore up or protect a surrounding area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lagging"@en .

aat:300427932 a skos:Concept ;
    skos:definition "Machines that use heat and pressure to permanently sandwich paper documents between thin plastic sheets to protect them from tearing, moisture, or other degradation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laminators"@en .

aat:300427939 a skos:Concept ;
    skos:definition "Protective coverings for lighting devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamp covers"@en .

aat:300427944 a skos:Concept ;
    skos:definition "Collar-like devices with vents that fit over the top of a lamp chimney or a collapsible circular wire rack with two or more prongs protruding from the center fixing it to the top of a lamp chimney. Used to support various objects, such as curling tongs, and liquids to be heated by a lamp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamp heaters"@en .

aat:300427981 a skos:Concept ;
    skos:definition "Cases for protecting and transporting laptop computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laptop cases"@en .

aat:300427982 a skos:Concept ;
    skos:definition "Containers for holding lard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard cans"@en .

aat:300427983 a skos:Concept ;
    skos:definition "Devices that use cold water to cool lard after the process of rendering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard coolers"@en .

aat:300427985 a skos:Concept ;
    skos:definition "Large oar-like implements used to stir kettles of rendering lard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard paddles"@en .

aat:300427986 a skos:Concept ;
    skos:definition "Presses for rendering lard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard presses"@en .

aat:300427988 a skos:Concept ;
    skos:definition "Metal vessels used to heat lard in order to render it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard rendering kettles"@en .

aat:300427989 a skos:Concept ;
    skos:definition "Devices for cooling hot lard, consisting of a rotating metal cylinder cooled by water or brine. Hot lard is poured on the surface of the cylinder and scraped off once cool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard rolls"@en .

aat:300427990 a skos:Concept ;
    skos:definition "Large vats in which rendered lard is allowed to separate from any water left over from the rendering process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard settling tanks"@en .

aat:300427992 a skos:Concept ;
    skos:definition "Implements used to agitate lard during the process of rendering lard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard stirrers"@en .

aat:300427993 a skos:Concept ;
    skos:definition "Long needles used to push strips of solid fat into lean cuts of meat prior to roasting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larding needles"@en .

aat:300428011 a skos:Concept ;
    skos:definition "Clamps used to hold an object with radial symmetry, especially cylinders. In a lathe, it holds a rotating workpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lathe chucks"@en .

aat:300428038 a skos:Concept ;
    skos:definition "Objects that are worn by individuals that are meant to indicate authorization or confirmation of personal identity within a law enforcement organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law enforcement badges"@en .

aat:300428039 a skos:Concept ;
    skos:definition "Small discs or knobs designed to be attached to clothing, and that bears the insignia of a law enforcemnent agency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law enforcement buttons"@en .

aat:300428040 a skos:Concept ;
    skos:definition "Pieces of textile material that bear the insignia of a law enforcement agency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law enforcement patches"@en .

aat:300428041 a skos:Concept ;
    skos:definition "Information artifacts meant to be attached to clothing or personal items that have the form of a small flat surface with images displayed on the surface, and which are backed with a pin as a fastener."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law enforcement pins"@en .

aat:300428042 a skos:Concept ;
    skos:definition "Standardized attire worn by members of a law enforcement agency when engaged in their duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law enforcement uniforms"@en .

aat:300428054 a skos:Concept ;
    skos:definition "Rotating stand used to serve condiments or food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lazy susans"@en .

aat:300428123 a skos:Concept ;
    skos:definition "Lawful documents that outline incentives to fulfill an obligation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal bonds"@en .

aat:300428125 a skos:Concept ;
    skos:definition "Costume worn by members of a court of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal costume"@en .

aat:300428128 a skos:Concept ;
    skos:definition "Ruled writing tablets of gathered paper, often yellow, that conventionally measure 8.5 by 14 inches, though other sizes exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal pads"@en .

aat:300428143 a skos:Concept ;
    skos:definition "Pieces of rigid material with central holes cut into them through which lenses may be mounted and attached to large format view or process cameras, enlargers, or other optical devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lens boards"@en .

aat:300428144 a skos:Concept ;
    skos:definition "Brushes with soft bristles, often of camel hair or sable that are used to clean dust from the surface of a lens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lens brushes"@en .

aat:300428148 a skos:Concept ;
    skos:definition "Very thin, lint-free, fibrous material designed specifically for cleaning the delicate surface of lenses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lens tissues"@en .

aat:300428154 a skos:Concept ;
    skos:definition "Small cases, boxes, or racks designed with compartments to hold correspondence, documents, or other papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter holders"@en .

aat:300428157 a skos:Concept ;
    skos:definition "Marking tools comprising thin pieces of material, such as metal, paper, cardboard, or stencil film, into which the shapes of letters are cut so that paint or ink applied to the surface of the stencil tool will produce the image of that letter on a second surface through the cut-outs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter stencils"@en .

aat:300428159 a skos:Concept ;
    skos:definition "Templates made of a variety of materials with engraved or cut-out images of letters that are used to create uniform characters by following the guide directly with a writing implement or through the use of a pantograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettering guides"@en .

aat:300428162 a skos:Concept ;
    skos:definition "Printing presses that produce prints by repeated direct impression of an inked, raised surface against paper. The matrix is composed from movable type set into the bed or chase of a press and locked and inked, then the paper is brought into contact against it to transfer the ink from the type, which creates an impression on the paper. Letterpresses have many forms, but variations have been in use from their invention by Gutenberg in the 15th century through the 19th century, and remained in wide use for books and other uses until the advent of offset printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterpresses"@en .

aat:300428175 a skos:Concept ;
    skos:definition "Bowls used to contain liquids used for libations at religious ceremonies. Examples include paterae used in Ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation bowls"@en .

aat:300428176 a skos:Concept ;
    skos:definition "Cups used to contain liquids used for libations at religious ceremonies; vary in shape and size but generally have a low foot-ring and a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation cups"@en .

aat:300428177 a skos:Concept ;
    skos:definition "Jugs used to contain liquids used for libations at religious ceremonies. Variously shaped, but usually are tall, wide-bottomed vessels with a handle and spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation jugs"@en .

aat:300428178 a skos:Concept ;
    skos:definition "Rectangular basins used to contain liquids used for libations at religious ceremonies. Often made of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation tanks"@en .

aat:300428179 a skos:Concept ;
    skos:definition "Vases used to hold liquids used as libations at rituals of various cultures. Examples are found in Ancient Greece, Ancient Egypt, and elsewhere in the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation vases"@en .

aat:300428191 a skos:Concept ;
    skos:definition "Jackets intended to keep people afloat in the water in emergency situations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life jackets"@en .

aat:300428218 a skos:Concept ;
    skos:definition "Objects originally created to provide illumination. This class includes lighting accessories such as candlesnuffers and wick trimmers, general purpose portable lighting devices such as kerosene lanterns, and specialized fixtures such as streetlamps and theater lighting devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting equipment"@en .

aat:300428222 a skos:Concept ;
    skos:definition "Lighting device components that obscure or diffuse the source of light in a lamp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting shades"@en .

aat:300428226 a skos:Concept ;
    skos:definition "Stones of a particular type, used in ceremony or ritual; usually comprising fulgerite, which is a natural tube, clump, or mass of vitrified sand caused by lightning strike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lightning stones"@en .

aat:300428242 a skos:Concept ;
    skos:definition "Historically, specially treated cases of linen in which a charge of powder and shot for firearms is made up. These were developed in 1852 by American inventor Christian Sharps as part of his Sharps rifle. The added strength of the linen cartridge was an improvement on paper cartridges. The rear of the linen cartridge had flash paper attached for ignition. The linen used was treated with starch for stiffness and other chemicals to make the linen more combustible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linen cartridges"@en .

aat:300428244 a skos:Concept ;
    skos:definition "Small microscopes used for counting the threads in linen fabrics. These devices typically comprise a square or round opening through which the threads can be magnified and viewed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linen provers"@en .

aat:300428245 a skos:Concept ;
    skos:definition "Small, mushroom-shaped tools made of glass, designed to be operated manually like an iron to smooth, polish, and press linen materials, most notably starched collars and cuffs. As the precursor to metal irons, this tool did not require heat for use; instead, it was used cold and its rounded edges were rubbed over damp fabrics before and after they were washed to achieve the intendend smoothing and polishing effects. The tools were often used together with small ironing boards made of whalebone or other organic materials. Uitilized as early as the Viking period, these tools were equipped with handles in the 16th century to facilitate use. They were produced and used well into the 19th century before being replaced by flat irons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linen smoothers"@en .

aat:300428248 a skos:Concept ;
    skos:definition "Containers, usually made of cloth, made to store lingerie. Sometimes decorated with embroidery or lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lingerie bags"@en .

aat:300428249 a skos:Concept ;
    skos:definition "Summer garments made of sheer cotton, muslin, linen or other lightweight material, typically worn outdoors for warm weather. Often white, off-white, or pastel in color and heavily decorated with embriodery, lace, ruffles, appliqué, and ribbons. Popular in Europe and North America throughout the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lingerie dresses"@en .

aat:300428250 a skos:Concept ;
    skos:definition "Stays, made of plastic or metal, meant to hold brassieres and other upper undergarments in place by pinning the straps to the outer garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lingerie guards"@en .

aat:300428257 a skos:Concept ;
    skos:definition "Sheet goods of true linoleum or vinyl imprinted with decorative patterns that emulate the look of a rug."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linoleum rugs"@en .

aat:300428269 a skos:Concept ;
    skos:definition "Boxes, usually made of wood, made to store liquor. Often containing various compartments to hold singular bottles, secured with a lock. Commonly used in the 19th century to store liquor for medical and personal use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquor chests"@en .

aat:300428273 a skos:Concept ;
    skos:definition "Textual works that are nondramatic, published or nonpublished. Computer programs and databases also are considered literary works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary works"@en .

aat:300428276 a skos:Concept ;
    skos:definition "Sheets of material, usually aluminum or polyester, that have been treated so that they may be used for printing processes that rely on the priciple of the immiscibility of oil and water, especially commercial offset lithography. For limestone blocks prepared as plates for fine art lithography, use \"lithographic stones.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic plates"@en .

aat:300428282 a skos:Concept ;
    skos:definition "Medium used to create designs during lithography; when applied to chemically-treated stone plates, the wax produces areas that do not hold water, allowing the retention of oil-based inks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic wax"@en .

aat:300428287 a skos:Concept ;
    skos:definition "Instruments for the measurement of the specific gravity of liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litrameters"@en .

aat:300428298 a skos:Concept ;
    skos:definition "Simple structures for sheltering or housing livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livestock sheds"@en .

aat:300428334 a skos:Concept ;
    skos:definition "Buildings or establishments in which rooms are rented, usually for short-term stays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodging facilities"@en .

aat:300428337 a skos:Concept ;
    skos:definition "Receptacles, usually resembling an open-ended, U-shaped trough that is made of metal, canvas, or other materials and that is equipped with a handle and is used to hold and carry logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log carriers"@en .

aat:300428343 a skos:Concept ;
    skos:definition "Simple sleds used to transport logs, stones, sticks, or other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log sleds"@en .

aat:300428350 a skos:Concept ;
    skos:definition "Scales for measuring chemical equivalents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logometers"@en .

aat:300428355 a skos:Concept ;
    skos:definition "Undergarments that reach from the waist to the ankles, usually worn to keep the wearer warm in cold weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long underpants"@en .

aat:300428365 a skos:Concept ;
    skos:definition "Mechanized devices designed to remove superfluous moisture from fabrics by passing fabric materials through the device's rollers in vertical loops without tension, and exposing the materials to hot air. These devices typically comprise a series of rollers, a continuously moving conveyor belt, a series of large drums, and fans blowing hot air. The characterizing feature of these devices is the fact that it carries fabric materials vertically, not horizonally, through the rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loop dryers"@en .

aat:300428368 a skos:Concept ;
    skos:definition "Mechanized devices, comprising pull levers or pedals; a large rotating dial; and a series of looping points (needles), designed to smoothly fuse two parts of a knitted garment or stocking together in a flat and invisible seam. By piercing each garment parts' looping line, or line of stitches along which the seams must be set by the looping machine, the device allows users to precisely trim any surplus stock away from the loops before executing the seam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "looping machines"@en .

aat:300428373 a skos:Concept ;
    skos:definition "Metal accessories attached to lorgnettes for ornamentaion, sometimes embellished with semi-precious stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lorgnette chains"@en .

aat:300428394 a skos:Concept ;
    skos:definition "Straps used to keep multiple pieces of luggage together as a unit, or to secure a piece of baggage to prevent its opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luggage carriers"@en .

aat:300428400 a skos:Concept ;
    skos:definition "Rolling metal carts, usually used in commercial contexts that provide a method of transporting large, unweildy materials like plywood. These usually have rails to keep things upright, and are designed to accommodate a variety of materials such as drywall and pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumber carts"@en .

aat:300428408 a skos:Concept ;
    skos:definition "Small bags that are intended to carry food for an individual's lunch. These may be paper or reusable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunch bags"@en .

aat:300428409 a skos:Concept ;
    skos:definition "Basket-like objects intended to carry foodstuffs for an individual's lunch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunch baskets"@en .

aat:300428420 a skos:Concept ;
    skos:definition "Cannons of a particular type, invented in 1877, designed to project a rope from the shore to a stranded ship to facilitate salvaging and rescue operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyle guns"@en .

aat:300428439 a skos:Concept ;
    skos:definition "Lenses designed to be mounted in a helicoid device that have the ability to focus very close to a desired subject, usually defined as the ability to focus at a ratio of 1:1, or life sized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macro lenses"@en .

aat:300428442 a skos:Concept ;
    skos:definition "Print advertising that is designed to be viewed within the pages of magazines or journals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magazine advertisements"@en .

aat:300428444 a skos:Concept ;
    skos:definition "Film that is pre-loaded in a light-tight chamber, or magazine, prior to exposure. This often refers motion picture film, but is used for a variety of film formats, including still and instant film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magazine film"@en .

aat:300428447 a skos:Concept ;
    skos:definition "Self-contained sets of supplies that children can use to learn tricks, illusions, or sleight-of-hand. These may include items of dress such as magic wands, or capes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magic sets"@en .

aat:300428453 a skos:Concept ;
    skos:definition "Automatic typewriters that utilize magnetic cards about the size of punch cards (as opposed to punched paper), and are linked to computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic card typewriters"@en .

aat:300428455 a skos:Concept ;
    skos:definition "Automatic typewriters that utilize magnetic disks as opposed to punched paper, and are linked to computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic disk typewriters"@en .

aat:300428456 a skos:Concept ;
    skos:definition "Revolving cylinders found in computers that have magnetized surfaces where data is stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic drums"@en .

aat:300428462 a skos:Concept ;
    skos:definition "Automatic typewriters, first introduced in the early 1960s, that utilize magnetic tape cartridges as opposed to punched paper, and are linked to computers. This allowed data to be recorded on tape, re-typed, and corrected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic tape typewriters"@en .

aat:300428468 a skos:Concept ;
    skos:definition "Magnetometers that record the direction and strength of the earth’s magnetic field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetographs"@en .

aat:300428472 a skos:Concept ;
    skos:definition "Sets of 144 domino-like pieces or tiles marked in suits, counters, and dice, used to play the tile game of Chinese origin, mah jongg.Mahjong is a tile-based game that was developed during the Qing dynasty in China and has spread throughout the world since the early 20th century. It is commonly played by four players. The game and its regional variants are widely played throughout Eastern and South Eastern Asia and have also become popular in Western countries. The game is played with a set of 144 tiles based on Chinese characters and symbols, although some regional variations may omit some tiles or add unique ones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mah-jongg sets"@en .

aat:300428476 a skos:Concept ;
    skos:definition "Handcarts, often wire-framed in which mail and packages are carried for delivery, usually in an office environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail carts"@en .

aat:300428478 a skos:Concept ;
    skos:definition "Publicly accessible receptacles into which flat mail such as letters is deposited for retreival by mail delivery personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail collection boxes"@en .

aat:300428479 a skos:Concept ;
    skos:definition "Receptacles or formed or flexible coverings designed to hold, store, or ship letters, packages, etc., delivered to or intended for particular addresses or individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail containers"@en .

aat:300428504 a skos:Concept ;
    skos:definition "Mancala is a generic name for a family of two-player turn-based strategy board games played with small stones, beans, or seeds and rows of holes or pits in the earth, a board or other playing surface. The objective is usually to capture all or some set of the opponent's pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mancala sets"@en .

aat:300428505 a skos:Concept ;
    skos:definition "Ornamental trimmings around the lower sections of sleeves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manchettes"@en .

aat:300428508 a skos:Concept ;
    skos:definition "Utensils designed to thinly slice vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandoline slicers"@en .

aat:300428513 a skos:Concept ;
    skos:definition "Historical military engines used for throwing stones and other missiles, including incendiaries; consists of a lever arm held and released under tension in a wooden frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mangonels"@en .

aat:300428539 a skos:Concept ;
    skos:definition "Mechanical typewriters that operate via movement produced entirely by the operator without electrical power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manual typewriters"@en .

aat:300428549 a skos:Concept ;
    skos:definition "Molds used to shape maple sugar, usually wood; may consist of either a single, one-sided mold, or two held together with dowels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maple sugar molds"@en .

aat:300428557 a skos:Concept ;
    skos:definition "Syringe-like tools used to force liquid seasoning into raw meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marinade injectors"@en .

aat:300428575 a skos:Concept ;
    skos:definition "Indelible, often wax or oil-based writing materials used primarily for writing onto shipping containers, packing, or for other industrial uses, rather than in a fine art context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marking crayons"@en .

aat:300428584 a skos:Concept ;
    skos:definition "Pointed iron or wooden tools used in nautical contexts for rope splicing and other functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marlinspikes"@en .

aat:300428585 a skos:Concept ;
    skos:definition "Cases or coverings into which pointed iron or wooden tools used in nautical contexts for rope splicing and other functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marlinspike sheaths"@en .

aat:300428588 a skos:Concept ;
    skos:definition "Bowls used to commemorate marriage ceremonies. Sometimes also used for ceremonial cleansing during the event, holding water so participants can wash hands, symbolizing union."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage bowls"@en .

aat:300428597 a skos:Concept ;
    skos:definition "A cosmetic preparation for darkening, lengthening, and thickening the eyelashes and (occasionally) the eyebrows, usually applied with a small brush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mascara"@en .

aat:300428617 a skos:Concept ;
    skos:definition "Charts of listings indicating the time and location of the mass and eucharist in a given area; often posted in special stands or housings outside the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass boards"@en .

aat:300428627 a skos:Concept ;
    skos:definition "Wedges or fittings, usually of wood or hard rubber, that are insterted between the front of a mast and the front of the mast gate to fill the available space on a ship’s mast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mast chocks"@en .

aat:300428636 a skos:Concept ;
    skos:definition "Re-useable small receptacles of varied design that keep matches dry and stored for use, often used in military or outdoor contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "match cases"@en .

aat:300428645 a skos:Concept ;
    skos:definition "Small quantities of material kept as specimens to be referred to in a controlled environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "material samples"@en .

aat:300428647 a skos:Concept ;
    skos:definition "Shirts made for expectant mothers, typically fashioned from loose fitting or stretchy material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maternity shirts"@en .

aat:300428648 a skos:Concept ;
    skos:definition "Undergarments for the lower body that have a great degree of flexibility to allow for the changing body shapes of pregnant women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maternity underpants"@en .

aat:300428669 a skos:Concept ;
    skos:definition "Set comprising a board with letters, numbers, or other signs around its edge, at which a planchette (movable pointer, upturned glass, etc.) points supposedly in answer to questions from users; used by attenders at a seance. Popular from the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ouija sets"@en .

aat:300428686 a skos:Concept ;
    skos:definition "Disposable bags used to contain meat while it roasts in an oven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oven bags"@en .

aat:300428687 a skos:Concept ;
    skos:definition "Heat-resistant gloves used to safely handle hot cookware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oven mitts"@en .

aat:300428689 a skos:Concept ;
    skos:definition "Thermometers designed to read temperatures within an oven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oven thermometers"@en .

aat:300428697 a skos:Concept ;
    skos:definition "Devices for testing the amount of expansion undergone by a batch of ice cream during the freezing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overrun testers"@en .

aat:300428705 a skos:Concept ;
    skos:definition "Two-wheeled vehicles drawn by an ox or oxen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxcarts"@en .

aat:300428715 a skos:Concept ;
    skos:definition "Devices made of two sets of wire grates, hinged at one end, with a handle; used to broil oysters over a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster broilers"@en .

aat:300428725 a skos:Concept ;
    skos:definition "Mechanized devices designed to change the synthetic tow, or coarse fibers that have been removed during textile processing, into sheets of fibers cut into predetermined lengths. These devices then transform the cut fibers into slivers to be used in subsequent drawing processes. Ideal for blending disparate types of synthetic and natural fibers, the devices were popularized in the English, French, and American textile industries due to their effeciency and ability to by-pass opening, picking, carding, gilling, and combing processes. Introduced to the textile industry in 1949, these devices fueled the application of tow-to-top conservion systems throughout the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pacific converters"@en .

aat:300428726 a skos:Concept ;
    skos:definition "Rubber or plastic teats made for babies or small children to suck on for comfort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pacifiers"@en .

aat:300428727 a skos:Concept ;
    skos:definition "Fob-like objects that attach to a baby's clothes with a clip, to prevent the pacifier from being lost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pacifier clips"@en .

aat:300428728 a skos:Concept ;
    skos:definition "Bags or containers of varied form designed to carry objects by one person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packs"@en .

aat:300428733 a skos:Concept ;
    skos:definition "Machines that automate the various parts of the process of packaging a product for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packaging machines"@en .

aat:300428734 a skos:Concept ;
    skos:definition "Adhesive tape intended for sealing, wrapping, enclosing, and bundling to prepare items for handling, storage, or shipping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packaging tape"@en .

aat:300428736 a skos:Concept ;
    skos:definition "Medium-sized vessels travelling at regular intervals between two ports, originally for the conveyance of mail, later also for goods and passengers; used particularly in Europe and North America in the 18th and 19th centuries. They could be ocean-going or used on rivers and canals. Merchant vessels plying regularly along fixed routes, especially on rivers or along coasts, to carry mail but also for cargo or passenger transport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packet ships"@en .

aat:300428739 a skos:Concept ;
    skos:definition "Documents that itemize and describe the detailed contents of shipped packages, containers, or pallets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packing slips"@en .

aat:300428740 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising vibration-withstanding frames, tension controls, single or double padded (nip) rollers, fabric guiders, and a dye trough, designed to facilitate the continuous textile dyeing process by infusing fabrics with chemcial dying solutions. Fabrics are passed into a chemical dyeing solution under the device's submerged roller and subsequently squeezed to remove excees solution. These devices are specifically designed to allow for even coloration of fabrics, maximum dyestuff yield, minumum rest liquor, and shade reproducibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pad machines"@en .

aat:300428744 a skos:Concept ;
    skos:definition "A game that occupies a single player who uses a small wood paddle to repeatedly hit a small rubber ball that is attached to the paddle itself by an elasticated string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paddle-ball"@en .

aat:300428757 a skos:Concept ;
    skos:definition "Prayer sticks, usually made of wood, completed with painted designs and bundles of feathers attached to one end. Used in Hopi religious ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pahos"@en .

aat:300428760 a skos:Concept ;
    skos:definition "Containers for storing solid paints or pigments, such as watercolors or tubes of liquid paint, that typically contain one or more small pans for mixing and blending paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint boxes"@en .

aat:300428762 a skos:Concept ;
    skos:definition "Self-contained painting kits that allow users to gradually reveal a pre-designed picture on a canvas or board by applying specific paint colors to the canvas's corresponding numbered sections. Often cheaply purchased at drug or art supply stores, these boxed sets became a popular leisure activity for middle-class Americans beginning in the early to mid-1950s. The original invention is credited to Dan Robbins and Max Klein of the Palmer Paint plant in Detriot, Michigan, who began marketing the kits in 1951. The inspiration for the invention is said to originate from Leonardo, who assigned numbered portions of his paintings to his apprentices for easy completion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint by numbers sets"@en .

aat:300428763 a skos:Concept ;
    skos:definition "Cylindrical containers, often made of plastic or metal, used to package ready-mixed paints, varnishes, lacquers, stains, and other industrial or retail products. Typically resealable and temperature tolerant to facilitate the paint product's reusability and preservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint cans"@en .

aat:300428764 a skos:Concept ;
    skos:definition "Steel tools with curved ends designed to pry open a paint can's pressed-in lid. Sometimes also used to scrape excess paint from hard-to-reach places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint can keys"@en .

aat:300428765 a skos:Concept ;
    skos:definition "Mechanised tools, composed of two or more parallel rollers that rotate toward eachother at high speeds, used to crush colored pigments or paste into a homogenous consistency for the manufacture of paint products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint grinders"@en .

aat:300428767 a skos:Concept ;
    skos:definition "Sponge or foam-backed fabric materials, usually cut in the shape of a square or rectangle and mounted on a handle, designed to apply paint to a surface. Once dipped in paint, these tools can be used like paint brushes to evenly coat surfaces through rapid wiping motions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint pads"@en .

aat:300428769 a skos:Concept ;
    skos:definition "Small, club-shaped tools with rounded ends, used to grind or pound the colored pigments required to make paint. Frequently used in conjunction with a mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint pestles"@en .

aat:300428772 a skos:Concept ;
    skos:definition "Boxed kits containing a range of pre-selected paint colors, typically designed for novice painters who want to mix myriad hues with minimal expenditure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint sets"@en .

aat:300428773 a skos:Concept ;
    skos:definition "Mechanical tools designed to blend different paint colors or components by propelling paint cans in a rapid, oscillatory motion. Typically composed of a paint can clamp, used to secure the can in position, and a motor, these devices were initially intended to replace manual paint stirrers. For the small, hand-held tools designed to manually mix paint components, use \"paint stirrers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint shakers"@en .

aat:300428774 a skos:Concept ;
    skos:definition "Tools, typically made of polyester, polyurethane, vegetable cellulose or other porous material, used as a mode of controlled paint application. Due to their absorbant and malleable nature, these tools create varied results depending on the viscocity of paint used and the pressure applied by the user. Specifically utilized to produce a range of organic paint effects and subtle color variations, as well as to smooth and blend visible brush strokes. Also commonly utilized as effective tools for paint cleanup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint sponges"@en .

aat:300428776 a skos:Concept ;
    skos:definition "Small, hand-held tools used to manually agitate paint components in a can or container. Specifically designed with the objective of mixing the liquid contents that rise to the top of the can with the pasty contents that accumulate at the bottom to create a homogenous paint consistency. While sometimes taking the form of stiff metal blades with holes or slots that reduce the resistance of the stirring movement, these tools are often cheaply made of wood or plastic. For the mechanical tools designed to blend paint colors or components, use \"paint shakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint stirrers"@en .

aat:300428777 a skos:Concept ;
    skos:definition "Solid nonmetallic mineral matter which, when ground, produces powder that can be used as paint pigment. If large quantities of paint are required, the stones are typically crushed using a paint pestle and mortar. For smaller quantities of paint, however, the stones can be dipped in water and rubbed in a paint dish from which the resulting pigment is captured by a paint brush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint stones"@en .

aat:300428778 a skos:Concept ;
    skos:definition "Containers, commonly made of aluminum or plastic, designed to both facilitate the even application of paint onto a commercial paintroller and hold unused paint during the painting process. Such containers comprise a centralized paint well or reservoir into which the paint may be added, as well as roller ramps to engage the roller, one or more side walls fitted with end wipers to remove excess paint, a drainage spout, and four outboard legs to support the device while in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint trays"@en .

aat:300428785 a skos:Concept ;
    skos:definition "Cloth sacks made to store pajamas when not in use, generally for children. Often in the form of animals or cartoon characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pajama bags"@en .

aat:300428789 a skos:Concept ;
    skos:definition "Long, wide-legged fashion pants that flare outward from the midriff to the floor. Often fashioned from lightweight, breathable materials such as silk or crêpe. Popularized by Coco Chanel in the 1930s. For calf-length fashion pants with wide legs, use \"guachos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palazzo pants"@en .

aat:300428803 a skos:Concept ;
    skos:definition "Tools consisting of an absorbent material, such as lamp wicking, fastened to a handle, used to apply oil or grease to baking pans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pan greasers"@en .

aat:300428820 a skos:Concept ;
    skos:definition "Loops of fabric or leather worn around on the outside of pant legs to protect the fabric from wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pant guards"@en .

aat:300428827 a skos:Concept ;
    skos:definition "Storage containers of bent wood, most common to the 19th century to store dry items like sugar, cereals, and spices in the pantry. These are now considered decorative objects. Often these incorporated handles and could be used to transport products to and from a market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantry boxes"@en .

aat:300428839 a skos:Concept ;
    skos:definition "A type of small arms ammunition made from paper that contained shot, wadding, and powder, used before the evolution of metallic cartridges. Construction of gun cartidges from paper evolved to include linen and later metal and other materials with more strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper cartridges"@en .

aat:300428847 a skos:Concept ;
    skos:definition "Objects that hold pieces of paper together or affixed to another surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper fasteners"@en .

aat:300428849 a skos:Concept ;
    skos:definition "Equipment used to fold printed material together into bound sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper folding machines"@en .

aat:300428850 a skos:Concept ;
    skos:definition "Equipment used to measure and cut paper or printed material into specific formats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper guillotines"@en .

aat:300428861 a skos:Concept ;
    skos:definition "Small, usually hand-held devices that insert wire staples into two or more sheets to fasten them together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper staplers"@en .

aat:300428863 a skos:Concept ;
    skos:definition "Typewriters that read punched paper tape, decode the punched data, and then print corresponding texts in human-readable form. Used especially in early information and data processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper tape typewriters"@en .

aat:300428877 a skos:Concept ;
    skos:definition "Large kite-like contrivances with wide textile canopies that are attached to a pilot by a harness in order to allow flight after jumping from or being hauled to a height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paragliders"@en .

aat:300428879 a skos:Concept ;
    skos:definition "Cables that are used to connect devices and transmit data through computers’ parallel ports. Parallel cables have 25 wires, all of which can synchronously transmit information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel cables"@en .

aat:300428885 a skos:Concept ;
    skos:definition "Ropes or cable arrangements formed like a sling, used to raise or lower heavy objects vertically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parbuckles"@en .

aat:300428913 a skos:Concept ;
    skos:definition "Various materials used for celebrations, such as weddings or birthday parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "party accessories"@en .

aat:300428914 a skos:Concept ;
    skos:definition "Noisemaker used during celebrations; usually made of paper or plastic, with a hard mouthpiece and flexible tube which is curled when not blown into. When used, the tube fills with air and unfurls, creating a noise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "party blowers"@en .

aat:300428916 a skos:Concept ;
    skos:definition "Conical hats, usually brightly colored or patterned, worn at celebrations. Usually made of paper or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "party hats"@en .

aat:300428924 a skos:Concept ;
    skos:definition "Tall glass beakers marked with rings measures for a drinking game popular in Germany in the 16th and 17th centuries in which participants drink only enough to reach the next marking on the beaker before passing it to the next drinker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passglasses"@en .

aat:300428930 a skos:Concept ;
    skos:definition "Articles of furniture, comprising a flat surface made of wood or another sturdy material reinforced by fold-out metal legs, used to support strips of wallpaper while they are being covered in paste before being applied to a wall. To flatten the wallpaper and keep it from unwanted curling during the pasting process, its ends are typically tucked under a string tied loosely around the table's fold-out legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pasting tables"@en .

aat:300428937 a skos:Concept ;
    skos:definition "Tools consisting of large, flat squares of metal, sharpened on the edge opposite the handle. Used to divide bread and pastry dough or scrape dough off of a working surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry knives"@en .

aat:300428938 a skos:Concept ;
    skos:definition "Hollow vessels into which pastry may be pressed in order to give it the form of the vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry molds"@en .

aat:300428945 a skos:Concept ;
    skos:definition "Small-scale representations of inventions or goods, often made for the purpose of demonstrating the intended appearance and function of the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patent models"@en .

aat:300428954 a skos:Concept ;
    skos:definition "Specialized stencils or diagrams illustrating the arrangement or placement of pattern pieces on fabrics. To facilitate pattern marking, these stencils are superimposed onto fabric materials and subsequently arranged and traced directly on the fabric. Typically used to ensure precise cutting and tailoring procedures, these stencils assist the user in reducing fabric waste and, in turn, increasing pattern yield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern markers"@en .

aat:300428955 a skos:Concept ;
    skos:definition "Thin paper used to create patterns for cutting textiles into pieces in the construction of garments or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern tracing paper"@en .

aat:300428963 a skos:Concept ;
    skos:definition "Concussive machinery or equipment designed to set, compact or level pavers in construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paver's rammers"@en .

aat:300428965 a skos:Concept ;
    skos:definition "Edged equipment used manually or by means of a mechanical device that spread and level paving materials of various types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paving spreaders"@en .

aat:300428973 a skos:Concept ;
    skos:definition "Machines used to separate the hulls from peas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pea hullers"@en .

aat:300428976 a skos:Concept ;
    skos:definition "Medals cast to commemorate peacekeeping commitments between different parties or to celebrate individual or group societal achievements. An example are peace medals given by the United States government to Native North American leaders to cement peace treaty negotiations, a practice common during the 1600s to late 1800s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peace medals"@en .

aat:300429010 a skos:Concept ;
    skos:definition "Skirts that are cut to be full at the waist and over the hips, but narrow at the hem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peg-top skirts"@en .

aat:300429013 a skos:Concept ;
    skos:definition "Instruments consisting of one or two beak-like prongs hinged to a shaft, formerly used for extracting teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental pelicans"@en .

aat:300429019 a skos:Concept ;
    skos:definition "Rugs that are made from the hide of an animal or a synthetic material resembling such."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pelt rugs"@en .

aat:300429059 a skos:Concept ;
    skos:definition "Percussion beaters consisting of wires or other flexible material attached to a handle, used to strike or excite drums and cymbals for a softer sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion brushes"@en .

aat:300429077 a skos:Concept ;
    skos:definition "Bottles fitted with a pump or bulb that can deliver liquids such as scent in the form of a fine spray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfume atomizers"@en .

aat:300429102 a skos:Concept ;
    skos:definition "Objects originally created to communicate a particular personal belief, opinion, achievement, status, rank, occupation, membership, office, or identity. This class includes articles of adornment or clothing worn primarily for their symbolism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal symbols"@en .

aat:300429105 a skos:Concept ;
    skos:definition "Parachutes designed to slow the descent of persons falling from aircraft, specifically in a military context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personnel parachutes"@en .

aat:300429116 a skos:Concept ;
    skos:definition "Relatively small, portable bags or cages used to transport small animals such as domestic cats, lap dogs, miniature pigs, ferrets, chickens. etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pet carriers"@en .

aat:300429136 a skos:Concept ;
    skos:definition "Writing or visual messages carved into rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petrographs"@en .

aat:300429165 a skos:Concept ;
    skos:definition "A type of dagger originally originally one with which the coup de grâce was given."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misericordes"@en .

aat:300429182 a skos:Concept ;
    skos:definition "Implements with a round or oval bowl affixed to a handle, used to stir food or transfer it between vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixing spoons"@en .

aat:300429193 a skos:Concept ;
    skos:definition "Kits for making scale models of buildings or vehicles. They consist of loose parts that must be assembled or glued together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model kits"@en .

aat:300429204 a skos:Concept ;
    skos:definition "Devices usually of ceramic consisting of a well for water in which a wheel is mounted to revolve that wets surfaces brought into contact with it. Used chiefly to moisten tape for drafting or for adhesive stamps for postage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moisteners"@en .

aat:300429207 a skos:Concept ;
    skos:definition "Implements consisting of a perforated scoop attached to a handle, used to skim impurities off of boiling molasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molasses skimmers"@en .

aat:300429219 a skos:Concept ;
    skos:definition "Screws encased in metal sleeves that will expand in predrilled holes to support objects mounted on a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molly bolts"@en .

aat:300429226 a skos:Concept ;
    skos:definition "Curved, thin pieces of metal used to hold banknotes together. Sometimes engraved with decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "money clips"@en .

aat:300429241 a skos:Concept ;
    skos:definition "Containers used to store monstrances, which are vessels used to display the eucharistic host (consecrated bread)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monstrance cases"@en .

aat:300429247 a skos:Concept ;
    skos:definition "Dials with gnomons used for showing the hours of the night by moonlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moondials"@en .

aat:300429258 a skos:Concept ;
    skos:definition "Woven, wide-mouthed baskets used along with a pestle in the manner of a mortar, to grind corn and other grains. These baskets were created and used by Native American tribes in the western United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortar baskets"@en .

aat:300429260 a skos:Concept ;
    skos:definition "Ammunition rounds, or bombs, shot from man-portable, muzzle-loaded cannons, or mortars. These are made in a variety of forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortar shells"@en .

aat:300429277 a skos:Concept ;
    skos:definition "Photographic film formulated and formatted for use in motion picture cameras, or to make prints from camera-original film used in motion picture cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion picture film"@en .

aat:300429293 a skos:Concept ;
    skos:definition "Mechanical drives that automatically advance the film take-up in cameras. These may appear as integral to a camera or as detachable accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motorized film drives"@en .

aat:300429301 a skos:Concept ;
    skos:definition "Loops or bands of fabric, usually colored black, worn around the upper arm to commemorate one or more deceased individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning armbands"@en .

aat:300429302 a skos:Concept ;
    skos:definition "Accessories worn to commemorate a deceased person or group of individuals. Examples include armbands worn around the upper arm or pins and ribbons worn on the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning badges"@en .

aat:300429303 a skos:Concept ;
    skos:definition "Cards used to memorialize deceased persons or groups of individuals, often with printed sentiments, illustrations, or photographed portraits of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning cards"@en .

aat:300429306 a skos:Concept ;
    skos:definition "Refers to any of a variety of pieces of mourning jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning ornaments"@en .

aat:300429311 a skos:Concept ;
    skos:definition "Flat pads on which computer mice are used, producing corresponding movement of pointers on monitor screens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouse pads"@en .

aat:300429317 a skos:Concept ;
    skos:definition "Printed matter that formally declares the occurance of a move of physical location of an individual or corporate body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving announcements"@en .

aat:300429318 a skos:Concept ;
    skos:definition "Large pieces of woven fabric that are padded or quilted, and that are used to protect objects from damage while they are being transported."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving blankets"@en .

aat:300429340 a skos:Concept ;
    skos:definition "Red cloths attached to a stick, used by a matador during the faena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muletas"@en .

aat:300429344 a skos:Concept ;
    skos:definition "Implements made of iron with a long handle and a paddle-like end. Used to heat wine or other liquids by placing the iron in a kitchen hearth until hot, then plunging the iron into the liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mulling irons"@en .

aat:300429347 a skos:Concept ;
    skos:definition "Software that combines more than one primary function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multifunction software"@en .

aat:300429352 a skos:Concept ;
    skos:definition "Devices that merge information from multiple input channels into a single output channel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiplexers"@en .

aat:300429359 a skos:Concept ;
    skos:definition "Benches intended for use by the players of musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music benches"@en .

aat:300429362 a skos:Concept ;
    skos:definition "Spool-shaped cylinders that rotate within music boxes. The cylinders have protruding pins in locations that correspond to the locations of notes on the “combs” of steel prongs, thus plucking the notes on the combs, which also correspond to specific, timed pieces of music played while the cylinders rotate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music box cylinders"@en .

aat:300429363 a skos:Concept ;
    skos:definition "Flat metal discs, shaped like phonograph records, which have pins partially punched out of them and bent at right angles. They are used in disc-playing music boxes which became popular from the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music box discs"@en .

aat:300429366 a skos:Concept ;
    skos:definition "Long clips that hold sheet music and scores in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music clips"@en .

aat:300429367 a skos:Concept ;
    skos:definition "Promotional print media intended to highlight a music concert, recording, or artist. These often combine text and images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music posters"@en .

aat:300429369 a skos:Concept ;
    skos:definition "Rolls of paper meant to be used as scores for mechanical instruments such as player pianos and fairground organs. Perforations are made on the paper which allows the mechanical keys of the instruments to create sound via air flow though the perforations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music rolls"@en .

aat:300429371 a skos:Concept ;
    skos:definition "Seats, usually chairs or benches, that are specifically intended for use of the players of musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music seats"@en .

aat:300429374 a skos:Concept ;
    skos:definition "Objects that facilitate the production of musical sound by manual or mechanical/electronic means, but do not themselves generate such sound. Included in this subclass are musical instrument components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical accessories"@en .

aat:300429383 a skos:Concept ;
    skos:definition "Containers specifically crafted to store, transport, or protect musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical instrument cases"@en .

aat:300429385 a skos:Concept ;
    skos:definition "Supports specifically for use while playing musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical instrument rests"@en .

aat:300429391 a skos:Concept ;
    skos:definition "Toys with which children can make music as a form of play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical toys"@en .

aat:300429396 a skos:Concept ;
    skos:definition "Balls or pellets, usually of lead, used as projectiles in muzzle-loaded long guns known as muskets. Musket cartridges consisted of black powder, and a ball, wrapped in paper. This was then torn open and manually pushed into the barrel of the musket for firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musket balls"@en .

aat:300429398 a skos:Concept ;
    skos:definition "Supports with Y-shaped branches on one end, on which long-barrelled firearms could be steadied while shooting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musket rests"@en .

aat:300429416 a skos:Concept ;
    skos:definition "Early type of artillery, commonly used before breech-loading weapons became common. Projectiles and powder charge are loaded via the muzzle, rammed down the barrel, and then fired at the target."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muzzle-loading artillery"@en .

aat:300429436 a skos:Concept ;
    skos:definition "Specialized anvils having a shape and design to allow making of nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nailmaker's anvils"@en .

aat:300429444 a skos:Concept ;
    skos:definition "Small cloth pouches used to store and protect napkins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napkin cases"@en .

aat:300429445 a skos:Concept ;
    skos:definition "Devices used to dispense single napkins, usually intended for self-service for restaurant patrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napkin dispensers"@en .

aat:300429446 a skos:Concept ;
    skos:definition "Dispensers of varied design that hold square pieces of cloth or paper used to clean hands while eating. These are typically provided on tables in restaurants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napkin holders"@en .

aat:300429449 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising a series of revolving rollers covered with steel napper wires or teasels, designed to raise the naps or pile fibers on a fabric's surface to create a velvety, soft finish. As fabric is passed through the device's cylinders, its loose surface fibers come into contact with the napper wires or teasels; these sharp mechanisms lift the fibers from the fabric's weft yarns to the its surface to form naps. This process, which increases the fabric's warmth, is often applied to woollens, cottons, spun silks, and spun rayons, amongst other knitted or woven materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napping gigs"@en .

aat:300429474 a skos:Concept ;
    skos:definition "Optical instruments of various form used to view distant objects, particularly in the context of nautical navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navigational telescopes"@en .

aat:300429481 a skos:Concept ;
    skos:definition "Accessories worn around the neck, made of fabric and in varying lengths and sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck scarves"@en .

aat:300429489 a skos:Concept ;
    skos:definition "Boxes, bags, or other receptacles designed to contain and transport neckties for safe keeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "necktie cases"@en .

aat:300429493 a skos:Concept ;
    skos:definition "Objects used to hold needles for security or storage, often made of textile or leather. For cases used to store needles, often made of bone or metal, use \"needle cases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle holders"@en .

aat:300429494 a skos:Concept ;
    skos:definition "Devices used to hone the points of slender pointed instruments for drawing thread through cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle sharpeners"@en .

aat:300429500 a skos:Concept ;
    skos:definition "Receptacles made of flexible material closed in on all sides except at the top, that are intended for storing tools and materials for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework bags"@en .

aat:300429502 a skos:Concept ;
    skos:definition "Small receptacles, usually cylindrical or rectangular, usually with lid, typically intended to contain tools and materials for needlwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework boxes"@en .

aat:300429504 a skos:Concept ;
    skos:definition "Usually hard-sided enclosing containers of varied design that are used for storing materials and tools for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework cases"@en .

aat:300429505 a skos:Concept ;
    skos:definition "Describes clamps of varied materials or design, used to secure needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework clamps"@en .

aat:300429506 a skos:Concept ;
    skos:definition "Describes a variety of receptacles designed to store materials and tools used for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework containers"@en .

aat:300429507 a skos:Concept ;
    skos:definition "Holding devices or structures, typically made of wood, plastic, metal, or other similarly durable materials, designed to keep fabric taut and secure for needleworking tasks. These devices often comprise sets of laterally moveable bars, on which strips of webbing are nailed and to which the work is sewn, as well as sets of stationary bars with holes pierced at regular intervals for receiving pegs, clamps, or pins to keep the parts in place. These devices are often used in conjunction with fixed stands or trestles to hold them upright for easy use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework frames"@en .

aat:300429508 a skos:Concept ;
    skos:definition "Contrivances used for holding, containing, or supporting materials or tools related to the practice of needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework holders"@en .

aat:300429509 a skos:Concept ;
    skos:definition "Devices comprised usually of two pieces of wood, metal or plastic that fit one inside the other, and that can be tightened with fabric stretched over the inner hoop to keep it taught while being worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework hoops"@en .

aat:300429510 a skos:Concept ;
    skos:definition "Collections of tools and materials that are kept together in a receptacle for a variety of needlework practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework kits"@en .

aat:300429511 a skos:Concept ;
    skos:definition "A broad designation of mechanical and/or electrically powered devices used to decorate or assemble textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework machines"@en .

aat:300429512 a skos:Concept ;
    skos:definition "Prefabricated models or designs used as guides for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework patterns"@en .

aat:300429513 a skos:Concept ;
    skos:definition "Frameworks that incorporate rails, bars, or pegs, in or on which tools or materials of needlework may be placed or suspended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework racks"@en .

aat:300429514 a skos:Concept ;
    skos:definition "Devices that put fabric under tension so that it can be worked with thread, usually for a variety of decorative techniques including embroidery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework stretchers"@en .

aat:300429515 a skos:Concept ;
    skos:definition "Utensils in the form of a flat board with a raised rim, or a shallow box without a lid, made of a variety of materials in various sizes and shapes that hold materials and tools for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework trays"@en .

aat:300429516 a skos:Concept ;
    skos:definition "General term for the tools, equipment, and supplies created for the processes and techniques involving needle and thread, including sewing, quilting, embriodery, and knitting. Also encompasses various objects and devices used in gathering, hooking, and pleating activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needleworking equipment"@en .

aat:300429521 a skos:Concept ;
    skos:definition "Devices used to measure the average number of neps, or small entanglements/knots of fibres, in a fiber mass, as well as the average size of the neps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nep testers"@en .

aat:300429523 a skos:Concept ;
    skos:definition "Series of tubes used for comparison of solutions based on color and turbidity. These are often used to create calibration solutions of increasing concentrations, and so function as a comparative scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nessler tube comparators"@en .

aat:300429529 a skos:Concept ;
    skos:definition "Toy consisting of a set of wooden dolls of decreasing size placed one inside another. A set of matryoshkas consists of a wooden figure, which separates at the middle, top from bottom, to reveal a smaller figure of the same sort inside, which has, in turn, another figure inside of it, and so on.The smallest, innermost doll is typically a baby turned from a single piece of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nesting dolls"@en .

aat:300429536 a skos:Concept ;
    skos:definition "Hand-held tools, typically made of bone, ivory, steel, or wood, used to weave and repair mesh nets. Though these tools vary in appearance, they often include a smooth, well-rounded stick with a uniform thickness throughout its length. This allows for equally-sized loops to be knotted around the stick in the production of mesh. The size of the tool determines the size of mesh materials produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "net gauges"@en .

aat:300429538 a skos:Concept ;
    skos:definition "Small, long needles, equipped with pincers at each end, used to produce nets, filet-lace, and similar mesh-like materials. Netting thread is wound lengthwise on the needle between the two pincers, which increase the user's control of the thread before it is wrapped around the net gauge, thus lessensing potential tangling or knots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "netting needles"@en .

aat:300429541 a skos:Concept ;
    skos:definition "Devices, in computing and data processing, that can read data travelling around a network."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "network analyzers"@en .

aat:300429542 a skos:Concept ;
    skos:definition "Data cables that are connected to networked computer systems and interfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "network cables"@en .

aat:300429552 a skos:Concept ;
    skos:definition "Print advertising that is designed to be viewed within the pages of daily newspapers or journals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newspaper advertisements"@en .

aat:300429553 a skos:Concept ;
    skos:definition "Sacks, usually made of canvas or other fabric, used to carry newspapers when being delivered or sold. Sometimes the sides are emblazoned with a particular newspaper's title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newspaper carriers' bags"@en .

aat:300429554 a skos:Concept ;
    skos:definition "Pieces of text cut out of newspapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newspaper clippings"@en .

aat:300429575 a skos:Concept ;
    skos:definition "Rings, usually of metal worn in a piercing on the nipple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nipple rings"@en .

aat:300429578 a skos:Concept ;
    skos:definition "Devices for determining the amount of nitrogen or some of its compounds in any substance subjected to analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrometers"@en .

aat:300429586 a skos:Concept ;
    skos:definition "Devices to press noodle dough into thin sheets, then cut the sheets into noodles. Two rollers press out and cut the dough with a wringer-like action, controlled by a hand crank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noodle cutters"@en .

aat:300429593 a skos:Concept ;
    skos:definition "Ornamental plugs for the nose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nose plugs"@en .

aat:300429595 a skos:Concept ;
    skos:definition "Piercings worn on the nose, usually on the side of the nostril. Vary in shape and material, often small in size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nose studs"@en .

aat:300429597 a skos:Concept ;
    skos:definition "Conical containers, usually made of metal, made to hold small floral arrangements. Worn by individuals attached to a buttonhole or lapel for ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nosegay holders"@en .

aat:300429598 a skos:Concept ;
    skos:definition "Clip to hold the nostrils closed, usually used when swimming or otherwise in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noseplugs"@en .

aat:300429600 a skos:Concept ;
    skos:definition "Stamps, usually self-inking, which are used to notoarize documents and provide a notary's credentials for authentication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notary stamps"@en .

aat:300429603 a skos:Concept ;
    skos:definition "Heavyweight pieces of paper, which may be folded or unfolded, that are intended for writing brief messages for correspondence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notecards"@en .

aat:300429604 a skos:Concept ;
    skos:definition "Blocks of blank or ruled paper bound together for the purposes of notetaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notepads"@en .

aat:300429605 a skos:Concept ;
    skos:definition "A broad category of small wares, especially cheap, useful articles, specifically for haberdashery or sewing; buttons, hooks, ribbon, and thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notions"@en .

aat:300429616 a skos:Concept ;
    skos:definition "Tools used to imprint symbols or numbers on materials; for example, placing symbols to prevent the alteration of numbers after printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numbering machines"@en .

aat:300429617 a skos:Concept ;
    skos:definition "Devices that apply numbering in sequence to documents. These are usually self-inking for continuous operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numbering stamps"@en .

aat:300429618 a skos:Concept ;
    skos:definition "Costume indicative or characteristic of the calling or vocation of a religious community of women, especially a cloistered one, living under vows of poverty, chastity, and obedience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nun's habits"@en .

aat:300429623 a skos:Concept ;
    skos:definition "Specialized brassieres that provide support to women who are nursing and that permit breastfeeding without the need to be removed by including flaps on the cup which can be opened with one hand to expose the nipple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing brassieres"@en .

aat:300429627 a skos:Concept ;
    skos:definition "Cloth pieces worn under garments, commonly brassieres, to cover and support nipples. Particularly worn by people nursing children. Usually circular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing pads"@en .

aat:300429631 a skos:Concept ;
    skos:definition "Devices that remove hulls from nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nut hullers"@en .

aat:300429632 a skos:Concept ;
    skos:definition "Apparatuses consisting of a hopper with a crank handle operated grinding mechanism at the bottom, the whole fixed to a lidded receptacle or a base equipped with a clamping device. Used to grind nuts finely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nut mills"@en .

aat:300429633 a skos:Concept ;
    skos:definition "Utensils shaped like a deep spoon used for picking up a quantity of a pellet-like foods such as nuts, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nut scoops"@en .

aat:300429634 a skos:Concept ;
    skos:definition "Mechanical devices for removing the shells from nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nut shellers"@en .

aat:300429638 a skos:Concept ;
    skos:definition "Scales that are programmed to provide caloric and other qualities for a variety of foods based on weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nutritional scales"@en .

aat:300429639 a skos:Concept ;
    skos:definition "Stones with nut-sized pits or depressions, used to crack nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nutting stones"@en .

aat:300429642 a skos:Concept ;
    skos:definition "Devices on the gunwales of boats, usually U-shaped, for holding an oar in place and forming a fulcrum for the oar in rowing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oarlocks"@en .

aat:300429648 a skos:Concept ;
    skos:definition "Prisms located in the lenses of refracting telescopes, which enable images to be seen as spectra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "objective prisms"@en .

aat:300429674 a skos:Concept ;
    skos:definition "Instruments used to measure the percentage of alcohol contained in wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oenoemeters"@en .

aat:300429676 a skos:Concept ;
    skos:definition "Containers made of woven materials used to hold offerings for religious ceremonies, varying in design. Examples include the Ancient Greek kaunon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering baskets"@en .

aat:300429677 a skos:Concept ;
    skos:definition "Bowls or lidded bowls used to hold offerings for religious ceremonies. Made of varying material, including wood or brass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering bowls"@en .

aat:300429678 a skos:Concept ;
    skos:definition "General term for vessels or boxes used to hold offerings for religious ceremonies, appearing in various forms and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering containers"@en .

aat:300429679 a skos:Concept ;
    skos:definition "Dishes passed around a congregation, used to hold offerings. Made of various materials. For flatter, plate-like containers, use \"offering plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering dishes"@en .

aat:300429680 a skos:Concept ;
    skos:definition "Plates passed around a congregation to collect money or other offerings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering plates"@en .

aat:300429681 a skos:Concept ;
    skos:definition "Flat boards, sometimes with a low rim, used to hold offerings for religious ceremonies. Some feature a base raising the board off the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering trays"@en .

aat:300429685 a skos:Concept ;
    skos:definition "Rubber mats used to transfer images from metal or other surfaces to the printed substrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset blankets"@en .

aat:300429686 a skos:Concept ;
    skos:definition "Flat pieces of metal, usually made of zinc or aluminum, used in offset printing. Plates are treated with a photosensitive substance and then exposed to light to create a printing surface. Used as the first printing surface which transfers the image to a rubber medium; the image is then transfered from the rubber to the final substrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset plates"@en .

aat:300429689 a skos:Concept ;
    skos:definition "Spatulas with a bent blade. The bend in the blade allows the user to grasp the handle safely while using the blade on hot surfaces or delicate foods, such as frosting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset spatulas"@en .

aat:300429696 a skos:Concept ;
    skos:definition "Devices that burn flammable oils as fuel to create heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil heaters"@en .

aat:300429697 a skos:Concept ;
    skos:definition "Space heating stoves that burn flammable oil as fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil heating stoves"@en .

aat:300429698 a skos:Concept ;
    skos:definition "Cans or pitchers used in the kitchen to collect or distribute cooking oils or grease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil keepers"@en .

aat:300429710 a skos:Concept ;
    skos:definition "Hydrometers adapted for determining the relative densities of oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oleometers"@en .

aat:300429722 a skos:Concept ;
    skos:definition "Implements used in the harvesting of onions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onion rakes"@en .

aat:300429727 a skos:Concept ;
    skos:definition "Instruments that give visual representation of sounds, consisting of tubes closed at one end by a taught membrane with a small mirror attached to its centre, which vibrates in response to sound entering the tube at the open end, causing a spot of light reflected by the mirror on to a screen to vibrate with varying amplitude and frequency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opeidoscopes"@en .

aat:300429758 a skos:Concept ;
    skos:definition "Knives designed to separate orange or other citrus segments from the pith, or knives for peeling oranges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange knives"@en .

aat:300429763 a skos:Concept ;
    skos:definition "Telescopes that orbit around a celestial body (namely Earth) to capture and collect light from deep space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orbiting telescopes"@en .

aat:300429768 a skos:Concept ;
    skos:definition "An early form of bicycle that was driven directly by pedaling cranks on the front wheel axle, rather than with a chain drive. The front and rear wheels were disproportionate in size to increase the distance covered for each turn of the cranks, and the rider sat almost directly over the large front wheel. Spokes allowed wheels ranging from 40 to 60 inches in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordinary bicycles"@en .

aat:300429779 a skos:Concept ;
    skos:definition "General term for keyboard instruments operated by the player’s hands and feet, in which pressurized air produces notes. Includes pipe organs, reed organs, and electronic organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organs"@en .

aat:300429780 a skos:Concept ;
    skos:definition "Benches intended for use by the player or an organ, sometimes made en suite with the instrument with which it is sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ benches"@en .

aat:300429785 a skos:Concept ;
    skos:definition "Objects routinely used by organizations, businesses, governments, or other corporate bodies in codified formal proceedings or ritual events. These objects sometimes serve to symbolize civic or corporate identities. This subclass does not include objects used to associate individuals with corporate bodies; these are organized under Personal Symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organizational objects"@en .

aat:300429793 a skos:Concept ;
    skos:definition "Intertwined cord or rope fashioned into particular designs. Often used on garments or around objects such as vases for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornamental knots"@en .

aat:300429794 a skos:Concept ;
    skos:definition "Machine designed to fly by means of artificial flapping wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornithopters"@en .

aat:300429810 a skos:Concept ;
    skos:definition "Devices in which the variations in a fluctuating electrical quantity appear temporarily as a visible wave form on a display screen. These plot the relationship between these variations, with the horizontal axis normally being a function of time and the vertical axis the voltage generated by an input signal. The German physicist Ferdinand Braun developed the first cathode-ray oscilloscope in 1897. In general, these are considered the same instrument as an oscilloscope, except that the oscillograph may be capable of creating a permanent record of measurements, while the oscilloscope provides only visual feedback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oscilloscopes"@en .

aat:300429811 a skos:Concept ;
    skos:definition "Instruments that measure osmosis in various liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "osmometers"@en .

aat:300429812 a skos:Concept ;
    skos:definition "Instruments for detecting and measuring odors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "osmoscopes"@en .

aat:300429814 a skos:Concept ;
    skos:definition "Containers meant to hold phonograph records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record cases"@en .

aat:300429815 a skos:Concept ;
    skos:definition "Cleaners, either in liquid or brush form, used to remove dust from phonograph records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record cleaners"@en .

aat:300429819 a skos:Concept ;
    skos:definition "Rollers with moistened cloth that are used on the surfaces of phonograph records to remove both dust and static electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record preeners"@en .

aat:300429821 a skos:Concept ;
    skos:definition "Paper sleeves that house phonograph records dating from the late 19th century and originally meant for 78 rpm discs. These are often decorative, square paper sleeves, usually with center-cut holes that reveal the label on the disc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record sleeves"@en .

aat:300429839 a skos:Concept ;
    skos:definition "Flat tools with smoothed curves at both ends, typically made of metal, wood, or plastic, designed to pull warp threads through the reed of a loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed hooks"@en .

aat:300429847 a skos:Concept ;
    skos:definition "Tape players where magnetic tape is carried on two separate reels mounted on spindles, wound from one reel to the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reel-to-reel tape players"@en .

aat:300429848 a skos:Concept ;
    skos:definition "Tape recorders where magnetic tape is carried on two separate reels mounted on spindles, wound from one reel to the other across the playback, recording, and erase heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reel-to-reel tape recorders"@en .

aat:300429849 a skos:Concept ;
    skos:definition "Correspondence that is intended to pass on to a third party information concerning another, as a referral for consultation or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "referral letters"@en .

aat:300429851 a skos:Concept ;
    skos:definition "Telescopes that use mirrors to collect and focus light rays. In reflecting telescopes, the primary mirror is usually spherical or parabolic in shape and inverts the light at the prime focus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflecting telescopes"@en .

aat:300429858 a skos:Concept ;
    skos:definition "Telescopes that use multiple glass lenses which refract light; the objective lenses are the first lenses through which light passes, and the eyepiece lenses are located behind the focal plane, allowing for viewing of the magnified images. Today, refracting telescopes are used for viewing objects in the solar system that are closer to Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refracting telescopes"@en .

aat:300429884 a skos:Concept ;
    skos:definition "General term for candlesticks used primarly in a religious or ceremonial context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious candlesticks"@en .

aat:300429885 a skos:Concept ;
    skos:definition "General term for objects comprising or containing the image or represenation of a saint or other holy figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious figures"@en .

aat:300429886 a skos:Concept ;
    skos:definition "General term for lamps used in ceremonial or religious contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious lamps"@en .

aat:300429889 a skos:Concept ;
    skos:definition "General term for plaques intended for religious contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious plaques"@en .

aat:300429891 a skos:Concept ;
    skos:definition "Flags, banners, figures, or other objects used as symbolic representations during religious ceremonies. Examples include standards carried during religious processions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious standards"@en .

aat:300429893 a skos:Concept ;
    skos:definition "General term for symbols having a religious context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious symbols"@en .

aat:300429899 a skos:Concept ;
    skos:definition "Devices designed to control equipment from a distance, usually by means of radio or infrared signals. Most often refers to those used for operating domestic appliances such as television receivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remote controls"@en .

aat:300429917 a skos:Concept ;
    skos:definition "Lifeboats used to assist a vessel in distress and to rescue crew and passengers, rather than having been shipboard lifeboats lowered from the vessel in distress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rescue lifeboats"@en .

aat:300429928 a skos:Concept ;
    skos:definition "Acoustic guitars, often made of aluminum, that produce sound through resonators rather than through the sound box. From the late 1920s, resonator guitars were popularized for their volume, and began to regularly appear in bluegrass ensembles. They are often referred to generally as dobro guitars, although the Dobro company’s resonator guitar is a specific type with a single resonator, and designed differently than those resonator guitars made by National, for example, which have three resonator cones (called “tricone”)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resonator guitars"@en .

aat:300429945 a skos:Concept ;
    skos:definition "Containers, often of glass, with a bulb and long downward-curving neck used for distilling liquids and other chemical operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retorts"@en .

aat:300429946 a skos:Concept ;
    skos:definition "Scientific equipment to which chemical or other laboratory equipment can be fixed when in use, typically consisting of a heavy base supporting a vertical metal rod to which clamps can be attached to hold test tubes or burettes for experiments in titration or for filtering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retort holders"@en .

aat:300429950 a skos:Concept ;
    skos:definition "Mechanical or electronic devices designed to artificially induce the long-term sound propagation of enclosures, i.e.: echo and reverberation, usually to create effects for sound recording."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverberators"@en .

aat:300429960 a skos:Concept ;
    skos:definition "Device that measures the flow of viscous liquids in response to applied force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rheometers"@en .

aat:300429972 a skos:Concept ;
    skos:definition "Devices used to steam rice, usually electric with a timing capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice cookers"@en .

aat:300429973 a skos:Concept ;
    skos:definition "Decoratively shaped hollow vessels into which rice (or other foods) may be pressed in order to take on its shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice molds"@en .

aat:300429976 a skos:Concept ;
    skos:definition "Light two-wheeled hooded vehicles having springs and two shafts, drawn by one or more men. First used in Japan ca. 1870, but now common in other parts of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rickshaws"@en .

aat:300429999 a skos:Concept ;
    skos:definition "Workbenches used the prepare or fabricate the ropes, chains, wires, and associated fittings used to support and operate a sea vessel's masts, sails, derricks, booms, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigger's benches"@en .

aat:300430000 a skos:Concept ;
    skos:definition "Devices used for holding loops/eyes in the end of cables while clamping or splicing them. Otherwise known as a triangle vise or splicing vise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigger's clamps"@en .

aat:300430005 a skos:Concept ;
    skos:definition "Airships that are held aloft by an envelope of gas that is supported by an internal framework rather than the pressure of the gas itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigid airships"@en .

aat:300430006 a skos:Concept ;
    skos:definition "Devices with firm, rigid frames equipped with slot-hole configurations through which yarn is threaded to create a warp. Considered one of the simplest styles of looms to use, these devices are known for their combined heddle, beater, and reed elements within one riddle heddle reed component, which is used to both raise and lower warp threads and beat weft yarn into place. To facilitate hand weaving, the device's riddle heddle reed is placed alternately in the up and down positions to create the sheds through which the shuttles are passed. When the heddle is in the up position, the threads in the holes are raised; when it is in the down position, the threads in the slots are raised. As compared to other types of looms, these devices are notably smaller and more portable. Though they are designed to produce plain weaves, these looms can also be manipulated to create more complex patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigid heddle looms"@en .

aat:300430011 a skos:Concept ;
    skos:definition "Shallow bowls made to store rings when not in use. Some examples include cylindrical protrusions to hang rings on as well as being placed in the dish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring dishes"@en .

aat:300430013 a skos:Concept ;
    skos:definition "Mechanized devices, comprising a double-sided frame equipped with a long row of spindles carried by ring rails, designed to convert pure roving into yarn and strengthen the yarn by twisting the roving in a simultaneous and continious process. After receiving roving from an intermediary simplex machine or fly frame, these devices expose the roving to a drafting process through which it is transformed to a desired thickness. The drafted roving is then twisted and wound onto a ring bobbin for packaging. The most commonly used devices in the yarn manufacturing process, these frames are small, accessible, and simpler to use than other methods of cotton spinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring frames"@en .

aat:300430015 a skos:Concept ;
    skos:definition "Hollow forms of a circular or tubular shape into which food may be poured or pressed in order to shape it into a decorative ring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring molds"@en .

aat:300430016 a skos:Concept ;
    skos:definition "Small cushions used to carry and present rings used for marriage ceremonies. Usually made of fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring pillows"@en .

aat:300430018 a skos:Concept ;
    skos:definition "Stones that emit ringing tones when struck. This refers to those that are found as a geological anomaly in the landscape; for those that are found and used specifically in a musical context, use 'rock gongs,' though often there is no distinction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ringing stones"@en .

aat:300430023 a skos:Concept ;
    skos:definition "Devices with raised iron pins through which fibers such as flax and hemp are drawn to strip them of sheaths, dirt, seed bulbs, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ripples"@en .

aat:300430027 a skos:Concept ;
    skos:definition "Objects that symbolically represents a flail, which is an implement having stout handle at the end of which are attached ropes or chains for whipping. Examples include flails used by Ancient Egyptians during religious and funerary ceremonies, often consisting of a staff with three rods attached by a ring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ritual flails"@en .

aat:300430045 a skos:Concept ;
    skos:definition "Forklike utensils, often used in pairs, which penetrate large pieces of meat to turn while cooking, or to prepare for serving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roast lifters"@en .

aat:300430046 a skos:Concept ;
    skos:definition "Mechanical devices used to turn spits or hooks in order to evenly roast meat over a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roasting jacks"@en .

aat:300430057 a skos:Concept ;
    skos:definition "Personal propulsion devices that are worn by an individual to fly short distances using low rocket power derived from non-combusting gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocket belts"@en .

aat:300430061 a skos:Concept ;
    skos:definition "Horizontal, curved boards used to exercise muscles used for balancing one's body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocking boards"@en .

aat:300430064 a skos:Concept ;
    skos:definition "Wall hardware that projects at ninety degrees and that supports members for supporting curtains or other hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rod brackets"@en .

aat:300430073 a skos:Concept ;
    skos:definition "Devices used in conjunction or as part of grain mills to automatically regulate the flow of grain into a mill, generally consisting of a receptacle into which grain is placed and a rotating cylinder that moves the grain into the next portion of the mill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll feeders"@en .

aat:300430075 a skos:Concept ;
    skos:definition "Devices in which rolls of photographic film wound on spools are secured and attached to a camera or other image-recording device to be exposed and advanced frame-by-frame. These normally include removable dark-slides to reveal the film before exposure, or to protect the film while removing the film holder from the camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll film holders"@en .

aat:300430082 a skos:Concept ;
    skos:definition "Devices that grind grain by use of rotating cylinders, or rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller mills"@en .

aat:300430090 a skos:Concept ;
    skos:definition "Flexible tubes that can be placed on a rolling pin for the purpose of applying a pattern to rolled-out dough or to prevent dough from sticking to the rolling pin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling pin covers"@en .

aat:300430091 a skos:Concept ;
    skos:definition "Brackets used to hold a rolling pin, a cylindrical implement used to roll out dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling pin stands"@en .

aat:300430093 a skos:Concept ;
    skos:definition "Devices used to clean grain consisting of a cylinder covered in mesh or with perforations. Grain passes through the cylinder as it rolls and foreign matter, such as dirt, is trapped in the mesh or perforations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling screens"@en .

aat:300430099 a skos:Concept ;
    skos:definition "Inverted buckets or pieces of solid wood with loops attached and on which children can walk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "romper stompers"@en .

aat:300430105 a skos:Concept ;
    skos:definition "Equipment designed to provide a level surface on pitched roofs while installing or repairing roofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing platforms"@en .

aat:300430119 a skos:Concept ;
    skos:definition "Mechanized devices, comprising a series of rotating stranders and a take-up package mounted on a rotating frame, designed to produce three- or four-strand ropes out of synthetic, natural, and other types of fibers. To produce the rope, fiber strands are fed into the device's rotating stranders which are then fed into the take-up package which carries out a two-for-one twisting action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ropemaking machines"@en .

aat:300430120 a skos:Concept ;
    skos:definition "Instruments employed in fabricating rope by hand, consisting of a slender rounded rod that tapers towards each end, which is made to revolve and twist fiber into rope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ropemaking spindles"@en .

aat:300430123 a skos:Concept ;
    skos:definition "Devices consisting of an iron shaft ending in a decoratively shaped form. The form is covered with batter, and then the iron is quickly plunged into hot oil, creating a fried pastry in a decorative shape, sometimes called a rosette."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosette irons"@en .

aat:300430142 a skos:Concept ;
    skos:definition "Bookbinding machines equipped with blades used to create round corners to the edges of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round cornering machines"@en .

aat:300430155 a skos:Concept ;
    skos:definition "Mechanized devices designed to draw out, attentuate, and twist wool, cotton, or other types of sliver in preparation for subsequent spinning processes. Historically fueled by leather belts transferring power from a mill's steam engine, these devices drastically expedite the roving process in a factory-based textile manufacturing system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roving frames"@en .

aat:300430177 a skos:Concept ;
    skos:definition "Devices made to visualize electric and sound waves for demonstration and research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonelescopes"@en .

aat:300430178 a skos:Concept ;
    skos:definition "Acoustic research instruments that focus the vibrations of a given sound wave onto a diaphragm from which they are transmitted graphically onto a moving film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonodeiks"@en .

aat:300430182 a skos:Concept ;
    skos:definition "Containers specifically used for the protection and transportation of phonographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph cases"@en .

aat:300430183 a skos:Concept ;
    skos:definition "Components of phonographs that wind a mechanism governing the movement of the turntable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph cranks"@en .

aat:300430185 a skos:Concept ;
    skos:definition "Historically, foil that is used as a recording surface and wrapped around cylinders during the recording process. Phonograph foil was used prior to the invention of wax cylinders, where vibrations were cut directly into the wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph foil"@en .

aat:300430186 a skos:Concept ;
    skos:definition "Cone- or trumpet-shaped accessories attached to early gramophone players and phonographs, that collect and amplify the sound reproduced, or the sound that is to be recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph horns"@en .

aat:300430187 a skos:Concept ;
    skos:definition "Keys that fit into the winding sockets of phonographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winding keys"@en .

aat:300430188 a skos:Concept ;
    skos:definition "Spindles found on cylinder phonographs, around which cylindrical records (usually made of wax) are made to revolve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph mandrels"@en .

aat:300430190 a skos:Concept ;
    skos:definition "Tools used to cut, shave, or sharpen needles that were used with early phonographs and gramophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph needle cutters"@en .

aat:300430193 a skos:Concept ;
    skos:definition "Devices used to manually wind early phonographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonograph winders"@en .

aat:300430194 a skos:Concept ;
    skos:definition "Instruments that measure the force or directionality of sound waves. Invented by Edison to measure the human voice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonometers"@en .

aat:300430195 a skos:Concept ;
    skos:definition "Instruments for projecting images of sound waves directly on a screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phono-projectoscopes"@en .

aat:300430196 a skos:Concept ;
    skos:definition "Historical instruments created by Etienne-Gaspard Robertson ca. 1810 for imitating the sound of the human voice, housed in an automaton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonorganons"@en .

aat:300430197 a skos:Concept ;
    skos:definition "Any of various devices by means of which sound vibrations are converted into a visible form for analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonoscopes"@en .

aat:300430198 a skos:Concept ;
    skos:definition "Instruments that measure the duration of phosphorescence in varied materials or substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphoroscopes"@en .

aat:300430211 a skos:Concept ;
    skos:definition "Objects in a variety of forms designed to hold photographs for presentation or storage. These range from simple folders that incorporate a passe-partout to more elaborate frame-like constructions, or bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photograph holders"@en .

aat:300430212 a skos:Concept ;
    skos:definition "Cutting tools consisting of a rotary blade mounted in a handle to enable cutting compound curves into photographic prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photograph trimmers"@en .

aat:300430213 a skos:Concept ;
    skos:definition "Devices used to steady the head of photographic sitters when long exposures are necessary for formal portraits, to prevent blurring the image. These have been rendered mostly obsolete as photographic technologies have advanced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographer's headrests"@en .

aat:300430214 a skos:Concept ;
    skos:definition "Ancillary devices, equipment, parts, and supplies used in the practice of making photographs, and that play an auxiliary role or facilitating the production of photographic images, including maintenance equipment and studio equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic accessories"@en .

aat:300430215 a skos:Concept ;
    skos:definition "Backdrops intended specifically to appear behind the subjects of photographs. These may be elaborately painted, or simply fields of texture or color, and appear in a variety of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic backdrops"@en .

aat:300430216 a skos:Concept ;
    skos:definition "Instruments that measure the optical density of areas of photographic film or paper, for color saturation and to calibrate print equipment, and generally to make adjustments for quality control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic densitometers"@en .

aat:300430217 a skos:Concept ;
    skos:definition "Containers specially designed to protect and transport one or more items of photographic equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic equipment cases"@en .

aat:300430219 a skos:Concept ;
    skos:definition "Any opaque material used to block light or chemistry from exposing photosensitized material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic masks"@en .

aat:300430223 a skos:Concept ;
    skos:definition "Frames used to hold inflexible photosensitized plates made of glass, rigid plastic, metal, or other materials. These are components used in medium and large format cameras for dry or wet plate photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic plate holders"@en .

aat:300430227 a skos:Concept ;
    skos:definition "Telescopes used for photographing the sun, developed in the mid-19th century in Europe. The first photoheliograph was developed by astronomer Warren de la Rue and constructed in London by Andrew Ross, and was completed in 1856."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoheliographs"@en .

aat:300430231 a skos:Concept ;
    skos:definition "Instruments for transmitting sound by means of light, especially those invented by Alexander Graham Bell and Sumner Tainter in 1880."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photophones"@en .

aat:300430233 a skos:Concept ;
    skos:definition "Instruments that measure the rate of photosynthesis in plants, specifically by measuring the volume of gas produced by aquatic plants in varying temperatures and with varying levels of light intensity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photosynthometers"@en .

aat:300430239 a skos:Concept ;
    skos:definition "Long narrow strips of decorative fabric intended for the surface of pianos that incidentally provide protection to the piano surface from objects resting on it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano scarves"@en .

aat:300430240 a skos:Concept ;
    skos:definition "Stools for a pianist to sit on, usually adjustable and often with a space inside for storing music"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano stools"@en .

aat:300430245 a skos:Concept ;
    skos:definition "Long poles made of varied materials used for reaching, hooking and pulling. These are tipped with sharp metal spikes or hooks, and are variously used in boating, construction, firefighting, and other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pick poles"@en .

aat:300430271 a skos:Concept ;
    skos:definition "Any of various hardware that can be used to keep framed works of art or similar objects secured on walls in the event of shock or unintentional movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture hangers"@en .

aat:300430274 a skos:Concept ;
    skos:definition "Protective boards or other heavy paper with an opening or openings cut in order to reveal photographs. These typically comprise two pieces, the bottom piece supports the print while the top piece has a window through which the photograph may be viewed. The boards may be hinged together to form a protective folder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture mats"@en .

aat:300430278 a skos:Concept ;
    skos:definition "Funnel-shaped tools used to support and vent pie crusts during cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pie funnels"@en .

aat:300430281 a skos:Concept ;
    skos:definition "Wire racks used to support and store cooling pies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pie racks"@en .

aat:300430298 a skos:Concept ;
    skos:definition "Specialized looms designed to facilitate the weaving of pile or plush fabrics, such as velvet, terry towel, chenille, and pile carpets, which have tufts or loops of fibres that stand up from the base fabric. These looms consist of a Jacquard-type power loom with an attachment that introduces wires at intervals to create false wefts around which warps are bound. The threads of each warp are thus lifted at different times so that they pass over the wires to form a row of standing loops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile fabric looms"@en .

aat:300430307 a skos:Concept ;
    skos:definition "Lidded containers made to store medication until a particular time, set using a dial. These are often circular in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pill timers"@en .

aat:300430313 a skos:Concept ;
    skos:definition "Punishment devices consisting of a wooden frame mounted on a post with holes or rings for restraining the head and hands of persons to be subjected to public ridicule or assault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillories"@en .

aat:300430315 a skos:Concept ;
    skos:definition "Cases of usally textile material that cover a pillow for protection, used beneath a standard pillowcase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillow covers"@en .

aat:300430316 a skos:Concept ;
    skos:definition "Mechanized devices designed to use compressed air hoses to blow polyester and similar filling materials into pillows, quilts, and other products. These devices typically operate on a continuous cycle, allowing them to stuff large quantities of pillows or other products consecutively without stopping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillow machines"@en .

aat:300430322 a skos:Concept ;
    skos:definition "Enclosed receptacles used for the storage of small, thin, rigid pieces of metal with sharp points used in needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pin boxes"@en .

aat:300430323 a skos:Concept ;
    skos:definition "Usually hard-sided containers with hinged lids and a handle used for storing pins for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pin cases"@en .

aat:300430325 a skos:Concept ;
    skos:definition "Utensils in the form of a flat board with a raised rim, or a shallow box without a lid, made of a variety of materials in various sizes and shapes that hold pins for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pin trays"@en .

aat:300430331 a skos:Concept ;
    skos:definition "Panels with sets of electrical sockets that are connected to groups of wires, allowing electrical connections when conducting pins are inserted into the sockets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinboards"@en .

aat:300430344 a skos:Concept ;
    skos:definition "Mechanized devices designed to rapidly cut scalloped, notched, or zig-zagged edges into fabric seems for decorative purposes or to prevent fraying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinking machines"@en .

aat:300430351 a skos:Concept ;
    skos:definition "Children's toy made from a fan of paper or plastic curls attached to the shaft of a wooden or plastic stick with a pin. The fan or wheel rotates when blown by the wind or by a person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinwheels"@en .

aat:300430352 a skos:Concept ;
    skos:definition "Instruments used to estimate the purity of milk by comparing its color to a provided color chart that represents the colors of cream, normal milk, diluted milk, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pioscopes"@en .

aat:300430358 a skos:Concept ;
    skos:definition "Receptacles of any size, typically with four rectangular sides and a lid, used to store pipes for smoking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe boxes"@en .

aat:300430361 a skos:Concept ;
    skos:definition "Receptacles, often cylindrical, and with or without lids that are intended to hold pipe cleaners or other tools for smoking pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe cleaner holders"@en .

aat:300430382 a skos:Concept ;
    skos:definition "Metal balls used as ammunition in early cap and ball pistols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pistol balls"@en .

aat:300430395 a skos:Concept ;
    skos:definition "Implements used to cut pizza, usually a rolling wheel-shaped blade on a handle or a mezzaluna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pizza cutters"@en .

aat:300430396 a skos:Concept ;
    skos:definition "Large, spatula-like tools used to slide pizzas or other foods into a hot oven and to retrieve them when done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pizza peels"@en .

aat:300430400 a skos:Concept ;
    skos:definition "Food service accessories used to hold a name card to indicate table seating arrangements. Often takes the form of a decorative loop or clip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "placecard holders"@en .

aat:300430410 a skos:Concept ;
    skos:definition "Projectors for use in planetaria which are comprised of complex systems of motor drives, fibre optics, and lenses, meant to display elements of the Solar System and the Milky Way in their precise, current locations among the stars, and to reproduce celestial movement in the future, as well as in the past."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planetarium projectors"@en .

aat:300430417 a skos:Concept ;
    skos:definition "Machines that separate and grade grain by tumbling it through mesh sieves of different sizes. Used in the process of flour milling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plansifters"@en .

aat:300430419 a skos:Concept ;
    skos:definition "Devices that are used to extract the moisture from plant specimens while retaining their biological integrity, and that yield examples that can be mounted on herbarium paper. Plant presses usually consist of wooden, box-like frames, cardboard ventilators, blotter paper, and folded paper (such as newspaper)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant presses"@en .

aat:300430421 a skos:Concept ;
    skos:definition "Biospecimens that are taken from plants, used for research or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant specimens"@en .

aat:300430437 a skos:Concept ;
    skos:definition "In athletic endeavors such as fencing, shields or pads worn to protect the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastrons"@en .

aat:300430441 a skos:Concept ;
    skos:definition "Devices that dispense plates, usually in cafeterias or self-service food establishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate dispensers"@en .

aat:300430442 a skos:Concept ;
    skos:definition "Tools used to measure the thickness of printing plates, such as electrotyping plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate gauges"@en .

aat:300430443 a skos:Concept ;
    skos:definition "Armor formed from plate metal that fits the hands and upper arms, and formed so that parts are articulated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate gauntlets"@en .

aat:300430445 a skos:Concept ;
    skos:definition "Historical type of personal helmet armor made from bronze, iron, or steel plate, that encased the head entirely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate helmets"@en .

aat:300430446 a skos:Concept ;
    skos:definition "Devices consisting of wire loops on a handle used to lift hot plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate lifters"@en .

aat:300430459 a skos:Concept ;
    skos:definition "Shoes, boots, or sandals with an unusually thick sole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform shoes"@en .

aat:300430463 a skos:Concept ;
    skos:definition "Round, perforated plates, usually ceramic or metal, for serving food with excess liquid or juices. Designed to be set over a larger dish to allow liquid to drain away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platter liners"@en .

aat:300430468 a skos:Concept ;
    skos:definition "Toy versions of kitchens intended for children's play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play kitchens"@en .

aat:300430470 a skos:Concept ;
    skos:definition "Malleable non-drying, re-usable material for children to knead and play with."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play putty"@en .

aat:300430472 a skos:Concept ;
    skos:definition "Constructed units, often temporary or demountable, designed for children to play in or on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play structures"@en .

aat:300430473 a skos:Concept ;
    skos:definition "Small tents for children to play in. These usually consist of textile materials and are available in different shapes, such as an Indian tipi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play tents"@en .

aat:300430474 a skos:Concept ;
    skos:definition "Tunnels of varied design, often collapsible, intended as play structures for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play tunnels"@en .

aat:300430484 a skos:Concept ;
    skos:definition "Mechanized devices, comprising a series rollers and gears/ blades, designed to produce uniform and precise folds in fabric. Once fed into the device, the fabric is first folded and pressed in a controlled manner using pressure from the gears or blades. The resulting pleats are then typically fixed in place by heat exposure as the fabric passes through a set of rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleating machines"@en .

aat:300430520 a skos:Concept ;
    skos:definition "Laboratory apparatuses used for collecting samples of pure gases such as hydrogen, oxygen, and nitrogen. These are of varied size and made from glass, metal, or plastics, and depend on the transfer of gas from one vessel through water contained in another. The original concept was developed by Reverend Stephen Hales ca. 1727."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pneumatic troughs"@en .

aat:300430537 a skos:Concept ;
    skos:definition "Stone tools used, along with a poi board, to beat taro root into a staple Hawaiian dish known as poi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poi pounders"@en .

aat:300430540 a skos:Concept ;
    skos:definition "Devices used to drive points into wood frames for mounting glass in windows or for framing fine art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point drivers"@en .

aat:300430552 a skos:Concept ;
    skos:definition "Directional filters that when positioned at a certain angle pass only light polarized in the direction perpendicular to reflected light, which is absorbed. This absorption diminishes glare reflected from reflective surfaces such as glass or water, or suppress atmospheric glare in the light of the sky. The rotational orientation of the filter is adjusted for the preferred effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polarizing filters"@en .

aat:300430558 a skos:Concept ;
    skos:definition "Levered devices that hoist posts or poles from where they've been set. These may be purely mechanical, or hydraulically powered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole pullers"@en .

aat:300430570 a skos:Concept ;
    skos:definition "Fine-grained abrasive commercially available in the form of blocks, bricks, or rods of solidified or semi-solid abrasive paste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polishing blocks"@en .

aat:300430578 a skos:Concept ;
    skos:definition "Badges that advocate for a political cause or person, usually pinned or otherwise affixed to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political badges"@en .

aat:300430579 a skos:Concept ;
    skos:definition "Inflatable, air-tight bags of rubber, plastic, paper, silk, or similar lightweight material, of varying shapes and sizes that are imprinted with slogans or names of candidates or measures that are up for election; used as promotional items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political balloons"@en .

aat:300430580 a skos:Concept ;
    skos:definition "Small flat plaques imprinted with images or text that advocate for a campaign for a cause or person, usually pinned or otherwise affixed to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political buttons"@en .

aat:300430581 a skos:Concept ;
    skos:definition "Small pocketable cards that are imprinted with the names of candidates, slogans or other promotional details for elections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political cards"@en .

aat:300430582 a skos:Concept ;
    skos:definition "Printed matter or handbills that promote candidates for public office, platforms, referendums, or other campaigns to potential voters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political fliers"@en .

aat:300430583 a skos:Concept ;
    skos:definition "Coin-shaped metal objects that are worn to communicate opinions about political causes, issues, or candidates for office. These may have an attached loop, hole, or pin for suspension from clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political medals"@en .

aat:300430584 a skos:Concept ;
    skos:definition "Small objects backed with a pin, displaying images or text that advocate for a cause or person, usually affixed to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political pins"@en .

aat:300430586 a skos:Concept ;
    skos:definition "Pieces or lengths of fine fabric, such as silk or satin forming a narrow strip or band that are imprinted with images or text that advocate for a political cause or person, usually pinned or otherwise affixed to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political ribbons"@en .

aat:300430587 a skos:Concept ;
    skos:definition "Objects that are worn to communicate opinions about political causes, issues, or candidates for office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political symbols"@en .

aat:300430596 a skos:Concept ;
    skos:definition "Tools used to handle the pulpy matter remaining after a substance has been pressed to extract oil or juice, such as in cider, beer, or wine making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pomace rakes"@en .

aat:300430598 a skos:Concept ;
    skos:definition "Vaulting horses fitted with pommels, which are knob-like projections rising from the surface; may also be fitted with two graspable arch-like handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pommel horses"@en .

aat:300430606 a skos:Concept ;
    skos:definition "Skirts, usually made from felt, falling to the knee or just below, with a nipped waist and full silhouette. These were popular in the United States during the early 1950s. So-called because they often included an appliqué of a poodle, though variations of the applied image were common, and were often personalized. The original invention is credited to Julie Lynn Charlot, who sold pre-made skirts as well as patterns for home construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poodle skirts"@en .

aat:300430609 a skos:Concept ;
    skos:definition "Watercraft, largely made of inflatable material such as plastic. Standard form is a horizontal platform, but many variations exist in shape and size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pool rafts"@en .

aat:300430613 a skos:Concept ;
    skos:definition "Machines designed to cook and dispense popcorn, consisting of a kettle that applies heat to popcorn kernels, usually via steam or heated oil, and some form of receptacle for containing and dispensing the popped kernels. Early popcorn machines in the United States were on horse-drawn carts and designed for street vending."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popcorn machines"@en .

aat:300430624 a skos:Concept ;
    skos:definition "Small cookstoves that can be powered by a variety of fuels, meant be used for outdoor activities, such a camping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable cookstoves"@en .

aat:300430630 a skos:Concept ;
    skos:definition "Phonographs that can be easily carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable phonographs"@en .

aat:300430632 a skos:Concept ;
    skos:definition "Small versions of refrigerators, containers which maintain cool temperatures to preserve food, designed to be portable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable refrigerators"@en .

aat:300430657 a skos:Concept ;
    skos:definition "Tools with helical blades that are turned mechanically or by hand and used to dig holes of varied diameter, for setting fence and sign posts, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post hole augers"@en .

aat:300430666 a skos:Concept ;
    skos:definition "Scales designed to weigh parcels in preparation for calculating shipping costs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postal scales"@en .

aat:300430669 a skos:Concept ;
    skos:definition "Equipment designed to project colored paper cards. Its historical significance in the development of projection machines lies in the use of paper positives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postcard projectors"@en .

aat:300430672 a skos:Concept ;
    skos:definition "Instruments that measure spinal curvature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posturometers"@en .

aat:300430674 a skos:Concept ;
    skos:definition "Devices with two or more arms that terminate in hooks designed to lift a hot pot out of the hearth by its handles or lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pot lifters"@en .

aat:300430675 a skos:Concept ;
    skos:definition "Patches of soft metal used to repair leaky pots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pot menders"@en .

aat:300430676 a skos:Concept ;
    skos:definition "Frames used to hang kitchen utensils, such as pots and pans; often wall- or ceiling-mounted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pot racks"@en .

aat:300430685 a skos:Concept ;
    skos:definition "Structure for the storage of harvested potatoes or sweet potatoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potato houses"@en .

aat:300430690 a skos:Concept ;
    skos:definition "Devices used to sort potatoes by size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potato sorters"@en .

aat:300430694 a skos:Concept ;
    skos:definition "Instruments that measure the rates at which plants absorb water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potometers"@en .

aat:300430718 a skos:Concept ;
    skos:definition "Knives designed specifically to kill poultry, having a special shape suited to cutting a vein found at the back of the neck of fowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poultry killing knives"@en .

aat:300430728 a skos:Concept ;
    skos:definition "Toys where young children knock rods or balls through a cavity, causing them to fall out again."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounding toys"@en .

aat:300430744 a skos:Concept ;
    skos:definition "Electric cables that can handle significant alternating electrical current, that connect to devices requiring electricity to function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power cables"@en .

aat:300430759 a skos:Concept ;
    skos:definition "Double-reed instruments used as practice instruments by musicians before eventually playing the Scottish Highland bagpipes. They have a narrow bore and a less stiff reed than traditional bagpipe chanters, thus their sound is about one octave lower."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "practice chanters"@en .

aat:300430766 a skos:Concept ;
    skos:definition "Cards upon which prayers are inscribed or written."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer cards"@en .

aat:300430768 a skos:Concept ;
    skos:definition "Rolled textual objects, variously made of plant fibers or animal skin, upon which are written prayers or petitions to the deity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer scrolls"@en .

aat:300430780 a skos:Concept ;
    skos:definition "Glass receptacles with airtight lids used in the process of home canning to store and preserve food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preserving jars"@en .

aat:300430787 a skos:Concept ;
    skos:definition "Foliage pressed flat between or inside a stable medium, such as glass or resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressed flora"@en .

aat:300430797 a skos:Concept ;
    skos:definition "Airships that are held aloft via a volume of gas held in an envelope without a structural skeleton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure-rigid airships"@en .

aat:300430814 a skos:Concept ;
    skos:definition "Printed matter intended as promotional material for goods, services, or brands that typically appears in newspapers, journals, magazines or other serial publications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print advertisements"@en .

aat:300430815 a skos:Concept ;
    skos:definition "Spring-loaded clips for holding photographic prints for temporary assessment, usually designed with wide surface areas to clamp larger pieces of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print clips"@en .

aat:300430817 a skos:Concept ;
    skos:definition "Devices resembling brayers used to roll the dry surface of prints onto mounts to adhere them smoothly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print rollers"@en .

aat:300430819 a skos:Concept ;
    skos:definition "Tanks designed to wash fix or hypo chemicals out of developed photographic prints. These have provisions for ingress of fresh water and the egress of water containing fix solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print washers"@en .

aat:300430823 a skos:Concept ;
    skos:definition "Tools used to secure type pieces by hitting them into place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printer's mallets"@en .

aat:300430824 a skos:Concept ;
    skos:definition "Tools used to lift newly printed sheets from a press to transfer somewhere else, usually a drying rack. These are usually small metal tong-like implements. The purpose is to minimize contact with the printer's hands and clean printed paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printer's peels"@en .

aat:300430825 a skos:Concept ;
    skos:definition "Blocks of wood used to set type; mallets are used to strike the planers onto type blocks to level and set them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printer's planers"@en .

aat:300430829 a skos:Concept ;
    skos:definition "Devices used to punch patterned holes in printing tape representing information or text; that information is then printed onto the desired surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing perforators"@en .

aat:300430836 a skos:Concept ;
    skos:definition "Burnishers used primarily to work with etching plates to efface previously etched areas, and also to treat the edges of the plate. These come in a variety of shapes for differing purposes, straight, curved, ball-tipped, or twisted with an alternate needle point end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printmaking burnishers"@en .

aat:300430847 a skos:Concept ;
    skos:definition "Coin-like cast or stamped metal objects with decorative designs awarded for competition or merit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prize medal"@en .

aat:300430848 a skos:Concept ;
    skos:definition "Pieces or lengths of fine fabric, such as silk or satin forming a narrow strip or band, awarded for competition or merit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prize ribbon"@en .

aat:300430856 a skos:Concept ;
    skos:definition "Bladed tools designed to cut fruits and vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "produce knives"@en .

aat:300430859 a skos:Concept ;
    skos:definition "Models describing or illustrating what a product or service consists of or looks like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "product models"@en .

aat:300430871 a skos:Concept ;
    skos:definition "Inflatable, air-tight bags of rubber, plastic, paper, silk, or similar lightweight material, of varying shapes and sizes that are imprinted with text or images that advertise goods, services, or brands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional balloons"@en .

aat:300430872 a skos:Concept ;
    skos:definition "Long strips of cloth bearing slogans or images that are meant to be hung in public places, which advertise goods, services, or brands,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional banners"@en .

aat:300430873 a skos:Concept ;
    skos:definition "Badges designed to be affixed to clothing that carry text or images intended to promote goods, services, artists, brands, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional buttons"@en .

aat:300430874 a skos:Concept ;
    skos:definition "Displays made of flexible material that are emblazoned with text or images that advertise goods, services, brands, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional flags"@en .

aat:300430875 a skos:Concept ;
    skos:definition "Objects of a variety of form that are marked with text or images meant to promote goods, services, brands, etc., and are normally given away as a form of advertising. These may be utilitarian items such as pens, fans, hats, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional novelties"@en .

aat:300430876 a skos:Concept ;
    skos:definition "Triangular flags having a triangular shape, and often made from stiffened felt that are printed with text, logos, or images meant to advertise or advocate for something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional pennants"@en .

aat:300430877 a skos:Concept ;
    skos:definition "Small objects meant to be affixed to clothing with an attached pin that advocate, advertise, or otherwise promote something such as a brand, musician, goods, or services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional pins"@en .

aat:300430878 a skos:Concept ;
    skos:definition "Short strips of of often satin-finished ribbon emblazoned with text or images that promote a person, brand, cause, etc. These normally are worn on clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional ribbons"@en .

aat:300430882 a skos:Concept ;
    skos:definition "Devices or barriers used principally for protection against sexually transmitted diseases rather than for contraceptive purposes. This most often refers specifically to condoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prophylactics"@en .

aat:300430887 a skos:Concept ;
    skos:definition "Artificial body parts or features worn as a medical necessity or as theatrical make-up or for special effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prostheses"@en .

aat:300430889 a skos:Concept ;
    skos:definition "Brief-like undergarments meant to protect against the effects of incontinence. These are usually disposable and have absorbant qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protective underpants"@en .

aat:300430894 a skos:Concept ;
    skos:definition "Short squat guns or cannons used to test the strength of coarser blasting powders, used mainly 18th-19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proving mortars"@en .

aat:300430902 a skos:Concept ;
    skos:definition "Implements used in the process of cutting branches or twigs from trees, shrubs, or vines in order to promote flowering and fruit production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pruning tools"@en .

aat:300430905 a skos:Concept ;
    skos:definition "Instruments that allow changing the directionality of sound for analysis of the localization of sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudophones"@en .

aat:300430916 a skos:Concept ;
    skos:definition "Sacks in which puddings are cooked. They consist of tightly-woven pieces of cloth into which ingredients for a pudding may be poured or placed. The corners of the cloth are then brought together and tied with a string to form a bag, which is then suspended by a stick into boiling water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pudding bags"@en .

aat:300430918 a skos:Concept ;
    skos:definition "Hollow forms, often elaborately shaped, into which ingredients for a pudding may be poured or pressed before cooking in order to shape the pudding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pudding molds"@en .

aat:300430950 a skos:Concept ;
    skos:definition "Reciprocating pumps used for drawing up liquid, especially crude oil from deep wells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumpjacks"@en .

aat:300430961 a skos:Concept ;
    skos:definition "Refers to work created by thread embroidered through punched holes in paper supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punched paper embroidery"@en .

aat:300430966 a skos:Concept ;
    skos:definition "Single-horse drawn sleighs or sledges for transport over snow that have box-like bodies, and are typically used for carrying light loads, or a single passenger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pungs"@en .

aat:300430967 a skos:Concept ;
    skos:definition "Instruments or equipment used to punish or restrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punishment devices"@en .

aat:300430998 a skos:Concept ;
    skos:definition "Heated pointed implements used in the art of decorating wood, leather, or other materials by burning designs on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrography pens"@en .

aat:300430999 a skos:Concept ;
    skos:definition "Devices that attach to pyrography pens that afford a variety of mark-making on wood, leather or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrography points"@en .

aat:300431001 a skos:Concept ;
    skos:definition "Tools used in the art of decorative wood-burning, or pyrography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrography tools"@en .

aat:300431024 a skos:Concept ;
    skos:definition "Timepieces in which a quartz crystal is employed as a tiny tuning fork that maintains a specific vibration by means of an electrical current, which is then translated into regular electric pulses, one per second."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz watches"@en .

aat:300431033 a skos:Concept ;
    skos:definition "Devices used to transfer filling yarn from spools and cones to light, tapered tubes (quills or bobbins) made of wood, cardboard, fiber, or metal for use in weaving cloth. These devices comprise a large wheel with a peg or handle on one of the spokes to facilitate rapid manual turning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quillers"@en .

aat:300431038 a skos:Concept ;
    skos:definition "Prefabricated models or designs for the construction of quilts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilt patterns"@en .

aat:300431040 a skos:Concept ;
    skos:definition "Devices of varied design used to secure fabric to a frame as it is being worked into a quilt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilting frame clamps"@en .

aat:300431041 a skos:Concept ;
    skos:definition "Devices similar to an embroidery hoop, but usually of a larger size. These are in two parts; a solid ring and a slightly larger split ring which may be expanded around the thicker layers of a quilt. These may be circular or rectangular in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilting hoops"@en .

aat:300431042 a skos:Concept ;
    skos:definition "Devices resembling sewing machines that may have larger support surfaces and 'throat' areas to accommodate larger pieces of fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilting machines"@en .

aat:300431043 a skos:Concept ;
    skos:definition "Instruments used to demonstrate the interference of sound, consisting of two U-tubes, one sliding into the other, with a Galton's whistle at one intersection of the tubes and a sensitive flame at the other. Air passes through the two bends of the tube to meet at the flame, and the flicker is analyzed against a scale on one of the tubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quincke's tubes"@en .

aat:300431057 a skos:Concept ;
    skos:definition "Miniature race tracks on which toy cars or other toy vehicles can drive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racetrack sets"@en .

aat:300431071 a skos:Concept ;
    skos:definition "Heaters that generate heat using radiation, usually infrared. Radiant heat heats objects not the air, and are more effective in outdoor environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiant heaters"@en .

aat:300431082 a skos:Concept ;
    skos:definition "Arrays of radio antennae arranged to simulate telescopes with large apertures, and used for astronomical observations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio interferometers"@en .

aat:300431155 a skos:Concept ;
    skos:definition "Variants of air-breathing jet engines that do not include a rotary compressor; relying instead on the engine's forward motion to compress the incoming air. These do not function at zero airspeed and cannot be used to power aircraft through all phases of flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramjet engines"@en .

aat:300431164 a skos:Concept ;
    skos:definition "Shuttleless looms that utilize thin metal shafts, or rapiers, to carry single picks of weft through the warp shed from stationary supply cones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rapier looms"@en .

aat:300431167 a skos:Concept ;
    skos:definition "Mechanisms that contain bars or wheels with inclined teeth in which pawls are dropped, so motion is imparted, and thus motion can be governed in one direction by hand tools such as wrenches or screwdrivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratchets"@en .

aat:300431172 a skos:Concept ;
    skos:definition "Instruments which measure and indicate the rate of climb or descent of an aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rate-of-climb indicators"@en .

aat:300431179 a skos:Concept ;
    skos:definition "Devices used to help shape uniformly-sized ravioli, a type of filled pasta. Ravioli presses consist of a tray with evenly-spaced divots separated by raised cutting edges. A sheet of pasta dough is laid across the tray and the divots filled with ingredients before being topped with another sheet of dough, which is then pressed with a rolling pin, cutting and shaping the ravioli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ravioli presses"@en .

aat:300431202 a skos:Concept ;
    skos:definition "Books or pads that gather receipts for payments made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "receipt books"@en .

aat:300431205 a skos:Concept ;
    skos:definition "Machines that pass grain over a series of sieves in order to clean it. Used in the process of milling flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "receiving separators"@en .

aat:300431215 a skos:Concept ;
    skos:definition "Any artillery launchers that are designed to eliminate recoil by allowing part of the propelling blast to escape to the rear of the weapon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recoilless guns"@en .

aat:300431216 a skos:Concept ;
    skos:definition "Antitank lightweight artillery units or man-portable launchers that are designed to eliminate recoil by allowing part of the propelling blast to escape to the rear of the weapon. These may only be used at short range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recoilless rifles"@en .

aat:300431218 a skos:Concept ;
    skos:definition "Fixed-wing airplanes that perform observation and collection of data such as measurements, photography, etc., usually in the context of military intelligence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reconnaissance airplanes"@en .

aat:300431219 a skos:Concept ;
    skos:definition "Devices placed on turntables that allow records with different spindle hole sizes to be played; particularly those adapters that allow 45 rpm records to be played, which have larger spindle holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record adapters"@en .

aat:300431220 a skos:Concept ;
    skos:definition "Sets of pouches, sleeves, or other protective wraps bound together for the storage of laquer or vinyl discs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record albums"@en .

aat:300431221 a skos:Concept ;
    skos:definition "Books that record facts or events, often for legal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record books"@en .

aat:300431222 a skos:Concept ;
    skos:definition "Brushes that are specifically made to remove dust and static from phonograph records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record brushes"@en .

aat:300431243 a skos:Concept ;
    skos:definition "Small, and sometimes pre-moistened pieces of material used for personal hygeine, particularly for washing hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towelettes"@en .

aat:300431250 a skos:Concept ;
    skos:definition "Toy figures in the shape of an animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy animals"@en .

aat:300431262 a skos:Concept ;
    skos:definition "Heavier-than-air objects designed to float on the wind, and that are intended for play or pleasure, particularly for use by children. These have a light structure of wood, cane, or plastic that is covered with a membrane of thin material that catches the wind, and is held at the end of a string or line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy kites"@en .

aat:300431264 a skos:Concept ;
    skos:definition "Small buckets, often with a colorful print or image, intended for children's play. Older types have been made in metal, while contemporary versions tend to be made from plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy pails"@en .

aat:300431267 a skos:Concept ;
    skos:definition "Small shovels intended for children's play, usually in the sand. These may be made in a variety of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy shovels"@en .

aat:300431269 a skos:Concept ;
    skos:definition "Miniature scale railroad steam engines, which are usually a part of sets of other railroad cars and accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy steam engines"@en .

aat:300431272 a skos:Concept ;
    skos:definition "Toy versions of a whistle with which children play music or make sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy whistles"@en .

aat:300431307 a skos:Concept ;
    skos:definition "Small printed sheets that advertise a trade or service, meant to be delivered by hand or posted for general consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade fliers"@en .

aat:300431310 a skos:Concept ;
    skos:definition "Signs that indicate a trade by rendering a particular shape or symbol that is unique to the trade, or is an agreed upon non-textual indicator of a particular trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade symbols"@en .

aat:300431326 a skos:Concept ;
    skos:definition "Garments for toddler-age children that are intended to ease the transition from diapers to toilet training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "training pants"@en .

aat:300431369 a skos:Concept ;
    skos:definition "Time-keeping devices designed for travel. These are often compact and have a folding or clamshell design so that they can be closed and stowed safely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel clocks"@en .

aat:300431373 a skos:Concept ;
    skos:definition "Blacksmith's or craftsman's tools used for measuring circumferences, normally of wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travelers"@en .

aat:300431375 a skos:Concept ;
    skos:definition "Containers made to store personal materials and toiletry items; generally small in size to allow for easy carrying and travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling cases"@en .

aat:300431382 a skos:Concept ;
    skos:definition "Rolling units used for collecting or storing food service trays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tray carts"@en .

aat:300431419 a skos:Concept ;
    skos:definition "Ornamental clips made to hold sashes or scarves around the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash holders"@en .

aat:300431423 a skos:Concept ;
    skos:definition "Containers used to carry personal gear. Some examples are suspended by a long strap worn over the shoulder, while others are worn on the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satchels"@en .

aat:300431434 a skos:Concept ;
    skos:definition "Objects for hanging or resting kitchen pans in to store them when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saucepan racks"@en .

aat:300431439 a skos:Concept ;
    skos:definition "Acoustic devices composed of a toothed spinning wheels that create tones if a blade or plectrum is held against them. Tones varying due to the speed or size of the wheel. Invented by French physicist Félix Savart. His invention was later adapted as a component of the tone wheel organ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Savart wheels"@en .

aat:300431476 a skos:Concept ;
    skos:definition "Ornaments, made of varying materials, made to hold scarves in place around the wearer. Usually ring-shaped, which allows the scarf to be pulled through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarf slides"@en .

aat:300431486 a skos:Concept ;
    skos:definition "Telescopes that have both reflecting and refracting elements to produce magnified images. Schmidt telescopes were invented by Bernhard Schmidt of the Bergedorf Observatory in Hamburg, in 1930. Each Schmidt telescope has a spherical primary mirror which then passes light through a spherical corrective lens, thus eliminating spherical aberrations from the mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schmidt cameras"@en .

aat:300431489 a skos:Concept ;
    skos:definition "Bells rung in schools to signal the beginnings and ends of school days, as well as the start of lessons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school bells"@en .

aat:300431491 a skos:Concept ;
    skos:definition "Articles of furniture that differ greatly in details of construction, but which most often incorporate a seat and a surface for writing or reading into one object, and that are intended for those attending classroom instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school desks"@en .

aat:300431496 a skos:Concept ;
    skos:definition "Sets of various items, such as instruments, tools, hardware and other components, usually in a scaled-down size and sometimes requiring assembly. It includes instructions. Used to teach children how apply knowledge about the science fields, usually by performing various experiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science kits"@en .

aat:300431498 a skos:Concept ;
    skos:definition "Projecting equipment that consists of a lens, an objective, and an illumination source that varies depending on the location where the apparatus will be used. The light source can be an oil lamp, acetylene, gas, limelight, incandescent light, arc lamp, or electric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sciopticons"@en .

aat:300431501 a skos:Concept ;
    skos:definition "Enclosing containers of varied design used for storing hinged cutting tools for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scissors cases"@en .

aat:300431507 a skos:Concept ;
    skos:definition "Long-handled nets used to retrieve fish from water while fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scoop nets"@en .

aat:300431510 a skos:Concept ;
    skos:definition "Mechanized devices designed to measure a dyed fabric sample's sublimation color fastness, or degree of discoloration, fading, or stain when exposed to heat sources. To measure sublimation fastness, these devices comprise two electric heated plates between which a dyed fabric sample is placed for a fixed period of time. When the sample is removed from the device, it is compared with a gray scale to appraise the grade of color dyeing sublimation-endurance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scorch testers"@en .

aat:300431522 a skos:Concept ;
    skos:definition "Components of scouring machines, typically made of cast iron and equipped with a perforated bottom and sequeeze rollers, designed to wash shorn wool to remove unwanted contaminents. Specifically, these bowls are filled with a mixture of water, detergent, and sodium carbonate or another alkali acting as a detergent builder to achieve grease emulsification. Typical scouring machines incporate two to four bowls, on top of which wool is fed by sets of harrows as a saturated mat. As both water and the wool are fed into each bowl at the same time, in the same direction, the wool fibers are agitated and dirt or grease is freed from the surface of the wool. In conjunction with a heating component and a series of rinsing bowls, these bowls then utilize squeeze rollers to remove persistent grease from the wool materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scouring bowls"@en .

aat:300431524 a skos:Concept ;
    skos:definition "Automated feeders comprising a series of scouring bowls and squeeze heads, which carry wool materials from one bowl to the next to facilitate the grease emulsification and scouring processes. These feeders are typically linked to an incline dryer and woolgrease recovery system within a larger scouring machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scouring trains"@en .

aat:300431531 a skos:Concept ;
    skos:definition "Devices that agitate and combine meat scraps into a material that is then formed into loaves, to create a product called 'scrapple' for cooking and eating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrapple stirrers"@en .

aat:300431565 a skos:Concept ;
    skos:definition "Circular ties made to hold hair in place. Usually made of bunched fabric, often colorful."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrunchies"@en .

aat:300431567 a skos:Concept ;
    skos:definition "Equipment used to assist divers with breathing when underwater by regulating the pressure of one's oxygen; usually consists of several tubes, a valve, and a pressure regulator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scuba regulators"@en .

aat:300431568 a skos:Concept ;
    skos:definition "Containers, usually made of metal, used to hold gases necessary for breathing when conducting underwater activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scuba tanks"@en .

aat:300431572 a skos:Concept ;
    skos:definition "Toys that children use for modeling clay and other malleable materials as well as supplies such as modeling tools or molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpting toys"@en .

aat:300431606 a skos:Concept ;
    skos:definition "Small containers made to hold knickknacks, coming in various shapes and sizes. Examples include baskets made by Native American artisans for sale in the tourist trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trinket baskets"@en .

aat:300431607 a skos:Concept ;
    skos:definition "Containers, of varying sizes and materials, made to store knickknacks or other small items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trinket boxes"@en .

aat:300431609 a skos:Concept ;
    skos:definition "Flageolets that have an attached third pipe, sometimes a bass pipe, enabling players to create three-note chords. Purported to have been invented by William Bainbridge of London, ca. 1820."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triple flageolets"@en .

aat:300431615 a skos:Concept ;
    skos:definition "Games that test the players' knowledge of a variety of subjects. Often these are comprised of sets of cards with questions and answers printed on them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trivia games"@en .

aat:300431635 a skos:Concept ;
    skos:definition "Shaped skirts that are fitted over the hips and thighs with a flared hem hitting below the knee. First popularized at the turn of the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trumpet skirts"@en .

aat:300431648 a skos:Concept ;
    skos:definition "Tools for tying poultry in preparation for cooking. These are usually made from steel, have a sharp end and an end with an eye. They are made in various lengths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trussing needles"@en .

aat:300431669 a skos:Concept ;
    skos:definition "Manual or mechanized devices, comprising rows of pulsating needle-like devices operating along a series of rollers, designed to manufacture carpet or other upholstory products by inserting loose pile yarn into a pre-woven carrier/backing material, thus creating a patterned or looped surface. As yarn is individually fed to each of the needles in the needle row, an additional set of tufting needles is inserted into the backing cloth; before the former row of needles retracts, loopers pick up the yarn in a repeated process that creates a series of loops on the surface of the carrier material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tufting machines"@en .

aat:300431672 a skos:Concept ;
    skos:definition "Single draft-animal drawn farm carts designed to tilt backwards to dump loads, typically having two broad wheels and a wide flat platform. Carts of this type could be used to carry corpses, refuse, or dung. During the French Revolution, this type of cart was frequently the conveyance used to transport prisoners to the guillotine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumbrels"@en .

aat:300431676 a skos:Concept ;
    skos:definition "Cones, usually metal or wood, used to tune organ flue-pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuning cones"@en .

aat:300431722 a skos:Concept ;
    skos:definition "A strong woven fabric tape made in a herringbone twill weave that is used most often as button or seam reinforcement in the construction of garments, though other uses may include binding edges or as ties or closures. It may be made from a variety of natural and artificial fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twill tape"@en .

aat:300431729 a skos:Concept ;
    skos:definition "The most common type of drill bit used for making holes in materials, such as wood, plastic or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twist bits"@en .

aat:300431730 a skos:Concept ;
    skos:definition "Devices used to measure the exact level of twist, or the spiral arrangement of fibers around the axis of yarn, inside a spun yarn sample. To calculate this measurement, these devices work to remove the twist by mechanically rotating a yarn sample held between two moveable clamps with a defined tension rate. The number of rotations needed to untwist the yarn's fibers are then calculated. The higher the twist measurement, the stronger the yarn is determined to be."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twist testers"@en .

aat:300431731 a skos:Concept ;
    skos:definition "Fasteners made of one or more metal wires encased in paper or plastic, used for closing or securing something, such as a plastic bag, by twisting the ends together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twist ties"@en .

aat:300431732 a skos:Concept ;
    skos:definition "Mechanized devices designed to evenly bind textile fibers together in a continuous thread by winding and wrapping threads in one direction around a series of bobbins, spindles, and/or spools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twisters"@en .

aat:300431733 a skos:Concept ;
    skos:definition "Mechanized devices designed to carry strands of yarn on delivery rollers/feeders around one or more grooved spindles or bobbins in one direction to form a continuously twisted strand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twisting frames"@en .

aat:300431754 a skos:Concept ;
    skos:definition "Devices used on the beds of sewing machines that act as a guide for fabric as it is run through the machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seam guides"@en .

aat:300431755 a skos:Concept ;
    skos:definition "Hand-held tools, typically comprising a hardwood or plastic rolling device mounted to a handle, used to flatten, press, or obscure the seams between connected strips of material. Commonly utilized, for example, by wallpaper hangers, tailors, seamstresses, quilters, and leather workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seam rollers"@en .

aat:300431758 a skos:Concept ;
    skos:definition "Long garments, usually white, worn by individuals performing séance rituals. Some robes also consist of a hood and face mask to cover the wearer completely. Associated with the Spiritualist movement in the United States (1850s-1890s) whose adherents believed in the presence of spirits and the ability to talk to the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "séance robes"@en .

aat:300431771 a skos:Concept ;
    skos:definition "Instruments intended to divide lines into equal parts, measuring angles and polygons within a circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectographs"@en .

aat:300431778 a skos:Concept ;
    skos:definition "Software that, on a broad level, protects computer networks, personal computers, and other devices such as smartphones, from intrusion by outsiders. Some examples of this protection might be antivirus software, firewall software, encryption software, or VPN software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "security software"@en .

aat:300431781 a skos:Concept ;
    skos:definition "Ceremonial plates for the Jewish holiday of Passover Seder ceremony; may be made of varying materials (metal, ceramic, or plastic) . Plates hold symbolic foods; some feature divots or small depressions for this purpose, while others have flat surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seder plates"@en .

aat:300431782 a skos:Concept ;
    skos:definition "Devices that measure for total sediment in residual fluids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sediment testers"@en .

aat:300431786 a skos:Concept ;
    skos:definition "Machines that use rollers to express oils from oil-containing seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seed crushers"@en .

aat:300431788 a skos:Concept ;
    skos:definition "Machines that remove the outer covering of seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seed hullers"@en .

aat:300431791 a skos:Concept ;
    skos:definition "Visual works constructed from assemblages of seeds and grains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seed pictures"@en .

aat:300431801 a skos:Concept ;
    skos:definition "Filters that purify liquid specimens by passing the liquid through Seitz discs, composed of asbestos filters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seitz filters"@en .

aat:300431802 a skos:Concept ;
    skos:definition "Instruments used for reflecting the light of the moon; similar in function to heliotropes, except with larger mirrors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selenotropes"@en .

aat:300431803 a skos:Concept ;
    skos:definition "Film that can be developed in chemistry that is integral to the media itself. There are various means to achieve this, but generally, after exposure, chemicals are released across the surface of light-sensitized film where development and fixing takes place. See also 'diffusion transfer prints.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-developing film"@en .

aat:300431804 a skos:Concept ;
    skos:definition "Devices in the form of telescopic rods onto which a camera or smartphone is mounted to allow the user to photograph themselves from a greater distance than arm's length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selfie sticks"@en .

aat:300431812 a skos:Concept ;
    skos:definition "Hand-held devices consisting of square flags on two short poles used in a semaphore system for conveying information at a distance by means of visual signals. The flags are held in any of eight possible positions to signal letters of the alphabet and numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semaphore flags"@en .

aat:300431813 a skos:Concept ;
    skos:definition "Lamps used to illuminate colored roundels on a semaphore signal at night."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semaphore lamps"@en .

aat:300431825 a skos:Concept ;
    skos:definition "Cables that are usually used to connect devices (such as printers or mice) through computers’ serial ports and by using serial communication, or the transmission of data one bit at a time. Serial cables have nine wires, although multiple types of serial connectors exist, including 9-pin connectors and 25-pin connectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serial cables"@en .

aat:300431832 a skos:Concept ;
    skos:definition "Filters that remove fibrin or other particles from specimens of blood serum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serum filters"@en .

aat:300431834 a skos:Concept ;
    skos:definition "Bells used to summon attendants (such as in hotels), or to give alarms or notices of varying kinds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "call bells"@en .

aat:300431839 a skos:Concept ;
    skos:definition "Official banners authorized by the United States Department of Defense for families who have members serving in the Armed Forces. These have a white field, red border and blue and/or gold stars representing each family member in service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service flags"@en .

aat:300431840 a skos:Concept ;
    skos:definition "Service records are collections of electronic or printed material that provides documentation of a person's activities and accomplishments while serving as a member of an organization, often within a government body or the military."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service records"@en .

aat:300431853 a skos:Concept ;
    skos:definition "Any long-handled ladles for serving food, of varied design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving ladles"@en .

aat:300431854 a skos:Concept ;
    skos:definition "Hand-held wooden tools, comprising a cylindrical head with a semi-circular groove cut along its length attached to a thin handle, designed to pass serving (typically spunyarn or twine) around a rope. To facilitate serving, a method of protecting rope ends from damage by wrapping them in yarn or twine, the rope is fitted into the tool's groove and the yarn/twine is wound tightly around its head and handle. As the tool is rotated around the rope, the serving material is fed in such a way that allows it to be kept taut thus ensuring maximum tightness. Resembling a mallet, this tool is most often used by ship crews to manage rope while sailing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving mallets"@en .

aat:300431862 a skos:Concept ;
    skos:definition "Cases that contain utensils used in food service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving utensil cases"@en .

aat:300431882 a skos:Concept ;
    skos:definition "Flanged bobbins that fit into bobbin cases inside lockstitch sewing machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing bobbins"@en .

aat:300431892 a skos:Concept ;
    skos:definition "Cylindrical devices on which thread is wound for the practice of sewing or needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing spools"@en .

aat:300431893 a skos:Concept ;
    skos:definition "Work tables specifically used for sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing tables"@en .

aat:300431911 a skos:Concept ;
    skos:definition "Types of carpet or area rugs having deep, plush pile and long, fluffy fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shag rugs"@en .

aat:300431912 a skos:Concept ;
    skos:definition "Basic wooden shingle made from split logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shake shingle"@en .

aat:300431913 a skos:Concept ;
    skos:definition "Devices that shake test tube cultures and specimens, often for the purpose of aeration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaking apparatuses"@en .

aat:300431927 a skos:Concept ;
    skos:definition "Mechanized devices designed to expedite mass fabric production by tying each warp yarn on the existing loom beam to the associated yarn on the replacement loom beam. By automating the loom beam replacement process, these devices eliminate the need for a new warp beam to be drawn-in when the pattern is not changing. Portable tying-in devices were widely introduced in 1910, replacing previously popular stationary machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tying-in machines"@en .

aat:300431942 a skos:Concept ;
    skos:definition "Strips of woven ribbon or other material that is either impregnated with ink or coated in a transferable medium, used to offset pigment to paper in various devices for impact printing. These are part of standard designs for manual or electric typewriters. Typewriter ribbon most commonly comes wound onto spools or reels, but may also be found in cassettes or other forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriter ribbons"@en .

aat:300431949 a skos:Concept ;
    skos:definition "Bowed psalteries, intended to be played flat, and manufactured from the 1920s through the 1960s as a combination of the traits of violins and ukuleles. Ukelins had two sets of strings: one set of sixteen melody strings tuned to C, and four sets of four strings each, tuned to four-note chords. The chord strings were plucked with one hand, and the melody strings were played with a bow by the other. They were initially produced by the Phonoharp Company of East Boston, Massachusetts, and sold by door-to-door salesmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ukelins"@en .

aat:300431955 a skos:Concept ;
    skos:definition "Full skirts fitted snuggly to the waist with numerous gores that gradually flare towards the hem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbrella skirts"@en .

aat:300431957 a skos:Concept ;
    skos:definition "Portable and collapsable frames, typically made of wood, designed to help wind/unwind skeins of yarn during the hand-spinning and weaving processes. This type of swift is equipped with various umbrella-like ribs that expand and/or fold in to accomodate variously sized yarn skeins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbrella swifts"@en .

aat:300431959 a skos:Concept ;
    skos:definition "Tools used in beekeeping. These have long metal blades, most often with wooden handles, and are used for the removal of the wax cover over a frame of honey prior to extraction. The blade is heated either electrically or via another heat source such as hot water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncapping knives"@en .

aat:300431973 a skos:Concept ;
    skos:definition "Self-propelled airborne explosive devices that are intended to be launched from a source under the the surface of a body of water to hit targets that are on terrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater-to-surface missiles"@en .

aat:300431978 a skos:Concept ;
    skos:definition "Works that cannot be, or have not yet been, identified as to the object type and other information. Term may be applied to movable works or built works. The term is most often used for works currently known or in collections, but for which the purpose of the work is not known and thus work type is not known. For works known by name in literature or otherwise doscumented, but not firmly associated with the corresponding physical work, use \"unidentified named works.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unidentified works"@en .

aat:300431984 a skos:Concept ;
    skos:definition "Form-fitting, one-piece combination garments made of stretchable fabric that covers the body from neck to feet, comprising elements of both a leotard and tights in one article of clothing. Worn, for example, by gymnists and dancers. For one-piece, skin-tight combination garments that leave the wearer's legs either fully or partially exposed, use \"leotards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unitards"@en .

aat:300431991 a skos:Concept ;
    skos:definition "Handheld pneumatic tools designed to fasten textiles to the frames of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery staplers"@en .

aat:300431992 a skos:Concept ;
    skos:definition "Tacks with very sharp points and flat or decorative heads used for upholstery or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery tacks"@en .

aat:300431993 a skos:Concept ;
    skos:definition "Refrigeration units that have a vertical orientation for a tall storage space, sometimes with shelves for organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upright freezers"@en .

aat:300432007 a skos:Concept ;
    skos:definition "Cables that supply both data and power to computers and peripherals (printers and mice, for example) via Universal Serial Bus connections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "USB cables"@en .

aat:300432008 a skos:Concept ;
    skos:definition "Objects for hanging or containing kitchen utensils while not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utensil racks"@en .

aat:300432010 a skos:Concept ;
    skos:definition "Devices used to introduce fluid to the uterus of a human or animal subject during medical procedures. These most often consist of a tube, catheter, and bag for fluid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uterine irrigators"@en .

aat:300432019 a skos:Concept ;
    skos:definition "Specialized software that helps maintain computers and manage files. Examples may be diagnostic software, set-up assistants, security software, and system backup software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility software"@en .

aat:300432034 a skos:Concept ;
    skos:definition "Gynecological tools used by doctors during pelvic exams. Made of metal or plastic, and hinged and shaped like a duck's bill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaginal specula"@en .

aat:300432039 a skos:Concept ;
    skos:definition "Piston-valved aerophones with a wide conical bore, usually coiled, and with a cupped mouthpiece. For bugles with keys that lent a full chromatic scale, use \"keyed bugles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valve bugles"@en .

aat:300432040 a skos:Concept ;
    skos:definition "Describes early French cornets, developed from ca. 1825, which were instruments that evolved from French posthorns, each featuring one single coil and two valves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valve cornets"@en .

aat:300432043 a skos:Concept ;
    skos:definition "Technically, any trumpet fixed with valves for keyed playing, specifically modern Western band, concert, and orchestral trumpets, having a wide mouthpiece, a narrow bore, valves, and a medium-sized bell throat and bell flare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valve trumpets"@en .

aat:300432047 a skos:Concept ;
    skos:definition "Devices, now historic, used to determine the volume of carbon dioxide and oxygen molecules in blood samples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Van Slyke apparatuses"@en .

aat:300432054 a skos:Concept ;
    skos:definition "Containers, usually used by botanists, for transporting recently gathered specimens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vascula"@en .

aat:300432061 a skos:Concept ;
    skos:definition "Receptacles for storing raw vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable bins"@en .

aat:300432064 a skos:Concept ;
    skos:definition "Handheld utensils with a metal slotted sharpened blade used for peeling vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable peelers"@en .

aat:300432098 a skos:Concept ;
    skos:definition "Small bags or cases containing the accoutrements of shaving facial or body hair, usually intended for travel. These normally contain a razor, some form of shaving cream, a brush, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving kits"@en .

aat:300432119 a skos:Concept ;
    skos:definition "Sheds to shelter sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheep sheds"@en .

aat:300432124 a skos:Concept ;
    skos:definition "Frames with darkslides used to hold flexible photosensitized sheet film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet film holders"@en .

aat:300432172 a skos:Concept ;
    skos:definition "Covers of documents, made of paper or other materials, and often with padding of some kind to protect contents while being shipped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipping envelopes"@en .

aat:300432184 a skos:Concept ;
    skos:definition "Transparent cases, usually of glass and brass that provide a source of light for use on seagoing vessels. Traditionally these would contain a liquid fuel and flammable wick, and were used for a variety of purposes including signaling or ambient lighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship's lanterns"@en .

aat:300432201 a skos:Concept ;
    skos:definition "Fasteners, made of various materials, used to hold shirts in place on the wearer or to group together loose fabric of a shirt. Clips do not pierce the fabric but instead have a loop or bar to weave the shirt through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirt clips"@en .

aat:300432202 a skos:Concept ;
    skos:definition "Lightweight outerwear garments with full or partial front openings, loosely sized to fit easily over other garments or layers. Typically constructed with features made to resemble shirts, such as turndown collars, button or zipper fasteners, and cuffs. Often feature unshaped hem finishes and are not designed to be tucked in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirt jackets"@en .

aat:300432204 a skos:Concept ;
    skos:definition "Removable fasteners usually of metal and often inset with precious stones, or other material. These are passed through eyelets in a shirt in order to fasten the shirt front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirt studs"@en .

aat:300432206 a skos:Concept ;
    skos:definition "Any of varied devices that absorb mechanical shocks, sudden impulses or dampen vibrations, especially on vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shock absorbers"@en .

aat:300432209 a skos:Concept ;
    skos:definition "Ornaments applied to shoes, made of varying material such as fabric or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe bows"@en .

aat:300432212 a skos:Concept ;
    skos:definition "Fasteners attached to shoes, used for both decoration and to secure shoes to the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe buckles"@en .

aat:300432216 a skos:Concept ;
    skos:definition "Ornaments fastened to the tops of shoes by means of a clip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe clips"@en .

aat:300432217 a skos:Concept ;
    skos:definition "Enclosures, often made of plastic or recyclable material, fitted around shoes to protect them from outside wear. Also used to keep shoes from tracking material into other spaces, such as infectious materials in medical contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe covers"@en .

aat:300432222 a skos:Concept ;
    skos:definition "Decorative elements applied to shoes, vary in size, form, and material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe ornaments"@en .

aat:300432257 a skos:Concept ;
    skos:definition "Perforated or louvered covers for air ducts. A register differs from a grille in that a damper is included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ventilator grilles"@en .

aat:300432259 a skos:Concept ;
    skos:definition "Mechanical devices, usually in the context of punch cards or tape data, that check the correctness of data by comparing against additional sets of the same data, or original sets of data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verifiers"@en .

aat:300432277 a skos:Concept ;
    skos:definition "Instruments developed for counting the frequency of vibrations of tuning forks, and later used to make vibrations visible in materials such as textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vibroscopes"@en .

aat:300432295 a skos:Concept ;
    skos:definition "Type of siding made from vinyl, often replicating the visual qualities of other materials such as stone or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl siding"@en .

aat:300432301 a skos:Concept ;
    skos:definition "Flexible sticks of wood, usually with lengths of horsehair between the two ends, used specifically to play violins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violin bows"@en .

aat:300432315 a skos:Concept ;
    skos:definition "Tools, equipment, and supplies that play a direct role in the generation or display of visual symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual communication devices"@en .

aat:300432318 a skos:Concept ;
    skos:definition "Equipment that generates transient or permanent visible signals, allowing them to be read at both short and long distances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual signaling devices"@en .

aat:300432321 a skos:Concept ;
    skos:definition "Artillery with multiple single-shot barrels that fire sequentially or simultaneously, though they lack automatic firing such as with machine guns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volley guns"@en .

aat:300432328 a skos:Concept ;
    skos:definition "Devices that measure or monitor changes in volume in a substance or solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volume change indicators"@en .

aat:300432333 a skos:Concept ;
    skos:definition "Small enclosures or structures, often temporary, used for casting votes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voting booths"@en .

aat:300432334 a skos:Concept ;
    skos:definition "General term for devices used to cast votes, varying in size and design. Relies upon computerized screens and/or computerized ballot counting to record votes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voting devices"@en .

aat:300432335 a skos:Concept ;
    skos:definition "Machines or other devices used to cast votes, varying in size and design. Relies upon mechanical components to record votes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voting machines"@en .

aat:300432336 a skos:Concept ;
    skos:definition "Objects used for voting, comprising small clay or glass balls; to vote, in one utilization, marbles are placed into a particular slot or hole in specially-made ballot boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voting marbles"@en .

aat:300432343 a skos:Concept ;
    skos:definition "Horns, made of plastic though earlier models were metal, used as noisemakers at sporting events especially in South Africa. They may have originated with certain horns used in African villages to summon people for meetings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vuvuzelas"@en .

aat:300432346 a skos:Concept ;
    skos:definition "Artificial bodies of water made for swimming, either sunken into the ground or made using hard or inflatable plastic containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wading pools"@en .

aat:300432349 a skos:Concept ;
    skos:definition "Presses or irons used to press and cook thin wafers from grain flour and water, often with patterns to impart decorative designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wafer presses"@en .

aat:300432358 a skos:Concept ;
    skos:definition "Large non-pneumatic wheels most often made of wood, iron, steel or other materials that are attached to the axels of wagons or other horse-drawn conveyances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wagon wheels"@en .

aat:300432365 a skos:Concept ;
    skos:definition "Long-sleeved, single- or double-breasted fitted jackets worn as the standard service attire for waiters. Typically cropped at the waist or thighs and fashioned from duck cloth or other durable fabrics that are white or black in color. Sometimes decorated with braids or other ornamentations and may be worn with an apron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waiter's jackets"@en .

aat:300432368 a skos:Concept ;
    skos:definition "Freezers designed to be walked into, such as those found in butcher shops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walk-in freezers"@en .

aat:300432373 a skos:Concept ;
    skos:definition "Skirts designed to clear the floor evenly in the front and back, cut approximately 5 inches from the ground to lessen the garment's weight and allow the wearer increased leg mobility. Often worn for practical and comfort purposes when walking, hiking, or traveling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking skirts"@en .

aat:300432379 a skos:Concept ;
    skos:definition "General term for projecting support devices (brackets) attached to a wall, usually an interior wall; examples are used stands or supports for a lamp, ornaments, or shelving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall brackets"@en .

aat:300432392 a skos:Concept ;
    skos:definition "Anvils on which a shoe may be held in place while a shoemaker performs work. These have varied form, some resembling an upended foot on an arm and others having two or three arms conjoined, ending in varied shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoemaker's anvils"@en .

aat:300432409 a skos:Concept ;
    skos:definition "Booths, stalls, rooms, houses, or small buildings for the retail sale of merchandise or services. Originally referred to spaces where the goods were made or prepared for sale and also sold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shops"@en .

aat:300432430 a skos:Concept ;
    skos:definition "A type of rimmed, cylindrical ammunition used specifically in shotguns, which are filled with metal shot, or pellets, powder, and primer. The case is usually of paper or plastic fitted into a brass base that contains the primer cup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shotgun shells"@en .

aat:300432435 a skos:Concept ;
    skos:definition "Objects worn on the shoulders, usually as part of a uniform that indicate membership or rank within a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder insignia"@en .

aat:300432440 a skos:Concept ;
    skos:definition "Supportive rests, most often used by violin and viola players, which allow freedom for the bowing arm when playing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder rests"@en .

aat:300432457 a skos:Concept ;
    skos:definition "Devices used to clean shrimp before cooking and eating them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrimp cleaners"@en .

aat:300432458 a skos:Concept ;
    skos:definition "Tools used to prepare shrimp for eating by removing a vein."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrimp deveiners"@en .

aat:300432460 a skos:Concept ;
    skos:definition "Mechanized devices designed to measure the shrinkage and relaxation rates of fabrics, including cotton, wool, linen, and silk, after they have been machine washed. These devices typically comprise mechanisms, such as tumblers and mechanical agitators, that simulate the forces exerted on fabrics during machine washing or drying. After being placed in the device and subjected to repeated movements, rotations, and frictions, the fabric samples are measured for resulting dimensional changes. The samples' pre- and post-test dimensions are then compared to calculate the shrinkage percentage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrinkage testers"@en .

aat:300432461 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising a steam box, water bath, cloth feeder, series of rollers, and drying mechanism, designed to manipulate the fabric structure of textiles to facilitate controlled shrinkage or stretching, thus stabilizing textile dimensions. To facilitate the shrinkage process, cloth is fed into the device's steam box where it is submerged in a water bath. Once exposed to heat and moisture, the cloth is then rid of excess water and fed to a conveyor belt on which various sets of rotating rollers, moving at decreasingly rapid rates, regulate the direction and tension of the materials for precise shrinking or stretching tasks. In addition to allowing precise adjustments in fabric dimensions, these devices also improve fabric texture and elasticity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrinking machines"@en .

aat:300432472 a skos:Concept ;
    skos:definition "Modern looms designed to draw the weft from a stationary supply through the warp yarn by means of projectiles, rapiers, or water/air jets, rather than traditional shuttles. Without the use of shuttles, these looms do not utilize the pirn winding process thus reducing manufacturing costs and auxiliary operations while increasing filling insertion speeds. Patened in 1928 by Rudolf Rossman, the shuttleless loom plays an important role in adjusting fabric structures, reducing fabric defets, improving fabric quality, and reducing machinery noises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shuttleless looms"@en .

aat:300432492 a skos:Concept ;
    skos:definition "Flat mirrors, often mounted to telescopes, which are rotated to compensate for the daily rotation of the celestial sky, therefore directing light from celestial objects under observation to the same position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siderostats"@en .

aat:300432493 a skos:Concept ;
    skos:definition "Saddles on which a rider sits with both legs to one side of the horse, designed originally for female riders in skirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sidesaddles"@en .

aat:300432499 a skos:Concept ;
    skos:definition "Machines used to clean grain using a strong current of air and screens that remove dirt and other unwanted objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sieve bolters"@en .

aat:300432501 a skos:Concept ;
    skos:definition "Wide, tray-shaped vessels made of woven fibers. The fibers are woven with gaps to allow small objects to fall through the basket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sifter baskets"@en .

aat:300432519 a skos:Concept ;
    skos:definition "Devices that automatically affix signatures to documents such as checks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signature machines"@en .

aat:300432533 a skos:Concept ;
    skos:definition "Mechanized warp knitting devices, typically comprising a series of guide and drafting rollers, synthetic rubber aprons, a pressure arm, a roving bobbin, and a sliver can, designed to minimize sliver weight and width to a suitable size for subsequent yarn spinning and manufacture processes. Slivers are first fed to the device in large cans and subsequently exposed to weight and tension through a series of rollers before being passed through flyers which create a twist in the fiber strands; slivers are thus converted to thin roving, which is then fed into a ring frame for futher processing. Used as an intermediate step between the draw and ring frames, these devices strengthen the roving and prevent breakage during future processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simplex machines"@en .

aat:300432534 a skos:Concept ;
    skos:definition "Devices, processing systems, or software that represents certain features of the behavior of a physical or abstract system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simulators"@en .

aat:300432564 a skos:Concept ;
    skos:definition "Printing surfaces, usually rectangular in shape and made of wood, used to print designs onto wallpaper. The surface is first engraved with the design, covered with ink, and then pressed into the printing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper blocks"@en .

aat:300432566 a skos:Concept ;
    skos:definition "Tools of any form that mount blades and are intended to slice wallpaper evenly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper cutters"@en .

aat:300432567 a skos:Concept ;
    skos:definition "Straight-handled tools that have a knife blade attached, and that may be retractable, used to cut pieces of wallpaper for hanging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper knives"@en .

aat:300432569 a skos:Concept ;
    skos:definition "Tools for joining seams of wallpaper that are comprised of a free-spinning wheel mounted on a handle. They may come in various widths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper rollers"@en .

aat:300432570 a skos:Concept ;
    skos:definition "Cutting tools consisting of two bevel-edged cutting blades and handles, specially designed to cut both lengths of wallpaper before their application and overlay wallpaper directly off the wall during the application process. The blades are longer in length and straighter than those of standard cutting tools to facilitate even trimming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper scissors"@en .

aat:300432571 a skos:Concept ;
    skos:definition "Hand-held tools, typically rectanglular, trapezoidal, or triangular in shape and made of plastic, used to flatten any lumps of paste that have accumulated under freshly mounted wallpaper and ensure that the wallpaper rests leveled on the surface to which it is applied. These tools may also take the form of a brush, with short bristles mounted on a rubber or wooden handle, to offer increased flexibility in smoothing wallpaper creases or bubbles. Can also be used as a cutting edge, for example, to remove excess wallpaper at skirting boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper smoothers"@en .

aat:300432572 a skos:Concept ;
    skos:definition "Brushes used to smooth wallpaper as it is applied to a wall to secure the adhesive, and eliminate pockets of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper smoothing brushes"@en .

aat:300432573 a skos:Concept ;
    skos:definition "Hand-held electric devices, comprised of a water tank, a steam generator, a water pump, and an open-faced steam plate or pan, used to loosen wallpaper from a surface to ease the wallpaper removal process. Once steam is produced in the water tank, it passes through a narrow bore tube to the plate which is then applied directly to the wallpaper; as the steam from the device comes into contact with the wall, it saturates and begins dissolving the paper for stripping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper steamers"@en .

aat:300432574 a skos:Concept ;
    skos:definition "General term for tools and equipment used for wallpaper hanging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpapering tools"@en .

aat:300432587 a skos:Concept ;
    skos:definition "Devices that are often part of a larger oven used to keep food warming at lower temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warming ovens"@en .

aat:300432588 a skos:Concept ;
    skos:definition "Devices that heat plates to a desired temperature to keep food warm until being served."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warming plates"@en .

aat:300432589 a skos:Concept ;
    skos:definition "Rotatable rollers horizontally attached to the back end of a loom on which warp threads are wound, ensuring that they are evently spaced, in preparation for weaving. These rollers, and the warp threads they hold, are manually tightened or slackened by means of a wheel controlling the tension of the beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp beams"@en .

aat:300432590 a skos:Concept ;
    skos:definition "Mechanized devices designed to mantain yarn at a uniform degree of tension while it is being unwound from the warp beam for the purpose of sizing and dressing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp dressers"@en .

aat:300432591 a skos:Concept ;
    skos:definition "Devices, typically comprising a metal rotating framework with measured dimensions, used for both measuring the warp required to weave textile materials and marking the beginning/end of the warp thread to facilitate the weaving process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warping bars"@en .

aat:300432604 a skos:Concept ;
    skos:definition "Cleaning devices consisting of hardwood boards with corrugated surfaces or covered with corrugated zinc, against which material is agitated while wet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washboards"@en .

aat:300432605 a skos:Concept ;
    skos:definition "Small pieces of cloth used for washing one's face and body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washcloths"@en .

aat:300432609 a skos:Concept ;
    skos:definition "Devices used to measure the ability of textiles not to fade or change color after washing or dry cleaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washfastness testers"@en .

aat:300432612 a skos:Concept ;
    skos:definition "Vessels used in the Jewish ritual cleansing of hands, often before meals or after meals. Some cups feature two handles to allow each hand to be washed separately, while others have no handles at all."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washing cups"@en .

aat:300432617 a skos:Concept ;
    skos:definition "Shallow plates or dishes that are intended for the deposit of food waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waste dishes"@en .

aat:300432623 a skos:Concept ;
    skos:definition "Supports made to secure watches, usually made of metal. Some examples have a fastener or clip at the end to attach them to one's clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watch chains"@en .

aat:300432631 a skos:Concept ;
    skos:definition "Portable mechanical clocks used by security guards in their patrol routines. Commonly these used keys for manual punching of a number to a strip of paper within with times pre-printed on it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watchclocks"@en .

aat:300432633 a skos:Concept ;
    skos:definition "Collections of objects used to analyze the contents or purity of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water analysis kits"@en .

aat:300432641 a skos:Concept ;
    skos:definition "Strong light casks used for transporting and dispensing drinking-water, often in the context of ships at sea or where potable is not otherwise available."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water casks"@en .

aat:300432646 a skos:Concept ;
    skos:definition "Devices that filter undesirable elements from drinking water. These come in various forms, often tall, cylindrical ceramic containers, fitted with a filter on the inside and consisting of a porous wall, sometimes lined with a charcoal or sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water filters"@en .

aat:300432654 a skos:Concept ;
    skos:definition "Jars used to draw or carry water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water jars"@en .

aat:300432664 a skos:Concept ;
    skos:definition "Mechanical or electromechanical devices designed to raise, evacuate, or move water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water pumps"@en .

aat:300432665 a skos:Concept ;
    skos:definition "General term for equipment or items used for water-based amusements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water recreation devices"@en .

aat:300432667 a skos:Concept ;
    skos:definition "Small, triangular flags, usually brightly colored, attached to water skis so that the skis and user are clearly visible to other parties. Often used as a safety measure in case of a downed skier,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water ski flags"@en .

aat:300432668 a skos:Concept ;
    skos:definition "Ropes that connect water skiis to the boat towing them; usually includes a handle for the skiier to hold onto the towline while moving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water ski towlines"@en .

aat:300432672 a skos:Concept ;
    skos:definition "Devices for monitoring the equilibrium of water, and that can supply an index useful in controlling anti-corrosion treatment. This is in respect to its degree of CaCO3 saturation. If a water has a negative Langelier Saturation Index (LSI) value, it is under-saturated with respect to calcium carbonate and is potentially corrosive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water stability indicators"@en .

aat:300432680 a skos:Concept ;
    skos:definition "Inflatable floats, usually made of plastic, with one worn on each arm. Made to help swimmers stay afloat. Particularly used by individuals learning to swim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water wings"@en .

aat:300432698 a skos:Concept ;
    skos:definition "Vertical wheels by which motion is communicated to the rudder of a waterborne vessel, through the medium of a tiller-rope or other device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watercraft steering wheels"@en .

aat:300432704 a skos:Concept ;
    skos:definition "Looms designed to use high pressure jets of water as the primary method of inserting the weft yarn into the warp shed to efficiently produce water-resistant, synthetic textile materials like Nylon and polyester filament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-jet looms"@en .

aat:300432727 a skos:Concept ;
    skos:definition "Objects originally created as distinct elements associated with sites, buildings, or parts of larger structures. Rather than functioning simply as parts of larger structures, site features are independent entities that complement other structures. This class includes such objects as birdbaths, flagpoles, gates, and fences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site features"@en .

aat:300432739 a skos:Concept ;
    skos:definition "Form-fitting one-piece costumes worn as the standard competitive wear for female skaters. Typically consists of a short skirt attached at the waist to a tight bodice and a pair of trunks that are partially revealed under the skirt. Often designed to complement the intended aesthetic or theme of the skater's performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skating dresses"@en .

aat:300432747 a skos:Concept ;
    skos:definition "Devices comprising large revolving frameworks or wheels used for winding and measuring yarn into hanks of a standard size. These devices typically rotate for a set number of revolutions, depending on the wheel's size, ensuring consistently sized hanks. Large, adjustable, and rotating frames that can be mounted horizontally or vertically, and are designed to wind warp threads. These devices ensure that the warps are of a consistent length and tension prior to being put on the loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrap reels"@en .

aat:300432755 a skos:Concept ;
    skos:definition "Metal hangers with slender arms on which skewers for cooking may be hung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skewer holders"@en .

aat:300432762 a skos:Concept ;
    skos:definition "Exercise equipment built to simulate the movements made during skiing; often used in physical therapy and in rehabilitation for elderly individuals. Consists of a platform on a raised, curved track and a handlebar. Users stand on the platform and use their legs to move back and forth across the track."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski machines"@en .

aat:300432770 a skos:Concept ;
    skos:definition "A class of compact, heavy-duty machinery with lift arms that attach to a modular buckets, scoops, or levelers for construction purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skid loaders"@en .

aat:300432775 a skos:Concept ;
    skos:definition "Components of cream separators. These bowls rotate rapidly to help separate cream from skim milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skimming bowls"@en .

aat:300432778 a skos:Concept ;
    skos:definition "Pencils specifically for marking the skin, usually used by medical professionals during physical examinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin marking pencils"@en .

aat:300432800 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising a yarn creel, a yarn guidance system, and a sizing delivery system, designed to apply a sizing agent to warp yarn in order to add strength/stiffness and reduce absorbency of the textile material. To facilitate the sizing process, yarn is wound on section beams and fed through the device's sizing delivery system, comprising a size box containing the sizing agent. After soaking in the agent and passing through the device's squeeze rolls, which rid the yarn of execess chemicals, the yarn is dried in the device's drying cans using hot air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slashers"@en .

aat:300432808 a skos:Concept ;
    skos:definition "Anvils used in roofing, with specialized slater's axes or hammers, to trim slate tiles to size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slater's anvils"@en .

aat:300432813 a skos:Concept ;
    skos:definition "Cutting tools that consist of a relatively heavy edged, squarish head fixed to a handle that are intended for the slaughtering of animals for their meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slaughtering axes"@en .

aat:300432814 a skos:Concept ;
    skos:definition "Low narrow tables, usually of wood, intended for slaughtering or butchering animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slaughtering benches"@en .

aat:300432815 a skos:Concept ;
    skos:definition "Concussive instruments used to stun animals in the course of slaughtering and butchering them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slaughtering hammers"@en .

aat:300432816 a skos:Concept ;
    skos:definition "Instrument placed around the neck, used to restrict the freedom of enslaved men and women and prevent escape attempts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slave collars"@en .

aat:300432828 a skos:Concept ;
    skos:definition "Pads that are generally used on a floor surface to provide a modicum of protection against a hard surface for sleeping, resting, or reclining. These may be constructed in various ways, often with foam, or air inflation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeping mats"@en .

aat:300432844 a skos:Concept ;
    skos:definition "Puzzles that challenge the user to slide (frequently flat) pieces along certain routes (usually on a board) to establish a certain end-configuration. The pieces to be moved may consist of simple shapes, or they may be imprinted with colors, patterns, sections of a larger picture like a jigsaw puzzle, numbers, or letters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slide puzzles"@en .

aat:300432847 a skos:Concept ;
    skos:definition "Receptacles with slotted intervals that hold individual mounted slides together in a group for storage, with some designed to be a component of a projector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slide trays"@en .

aat:300432849 a skos:Concept ;
    skos:definition "Trumpets with a slide mechanism, much like the slide trombone which was developed later. Slide trumpets were popular during the Renaissance and Baroque periods, as well as in England during the 17th-19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slide trumpets"@en .

aat:300432859 a skos:Concept ;
    skos:definition "Containers consisting of a bag backed with a diagonal strap, usually worn sideways around the torso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sling bags"@en .

aat:300432860 a skos:Concept ;
    skos:definition "Inert projectiles used in corded sling weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sling bullets"@en .

aat:300432870 a skos:Concept ;
    skos:definition "Containers made to store womens' slippers for safekeeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipper cases"@en .

aat:300432877 a skos:Concept ;
    skos:definition "Mechanized devices designed to measure the variations in a sliver's mass by compressing the sliver through a pair of rollers. In measuring the sliver's mass, these devices are built to analyze the degree of evenness characterizing a sliver's structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliver testers"@en .

aat:300432882 a skos:Concept ;
    skos:definition "Surfaces, supported by a series of bars and posts, on which weavers sit while working at a loom. These benches are often ergonomically designed to be slightly tilted so that the weaver sits with their hips higher than their knees, thus shifting the workload to their thighs for increased comfort through the duration of the weaving process. Though the benches are sometimes built into the looms themselves, most are separate from and placed in front of the loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaver's benches"@en .

aat:300432883 a skos:Concept ;
    skos:definition "Long, flat pieces of wood, ivory, iron or other durable materials, typically carved to a short point at the top and sometimes equipped with an arrowhead-like tip, used to beat the weft and secure it into place. When the batten is passed behind the warp, the entire set of warp strands is separated and prepared to receive the woof. This device is commonly associated with warp-weighted looms, traditional upright looms, backstrap looms, and several bone weaving tools. Traditionally carved with illustrations of creation myths, divination, marriages, conquest, and royal descent, these devices have long been used by Indigenous peoples in the Americas who imbued them with diestic, ritual, and spiritual meanings. The devices have also been discovered in the cemetaries and other archaeological remains of the Anglo-Saxons, dating to the early Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaving battens"@en .

aat:300432885 a skos:Concept ;
    skos:definition "Hand-held devices, typically comprising small teeth mounted on wide wooden, plastic, or metal heads, designed to facilitate the weaving process by emphasizing the weftfaced structure of textile materials and regulating the yarn's density."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaving combs"@en .

aat:300432886 a skos:Concept ;
    skos:definition "Adjustable bars or rods, equipped with teeth at both ends, designed to be inserted into the weaving at the selvedges to adjust the width of the woven cloth and ensure that the cloth remains stretched to the proper width through the course of the weaving process. To prevent the narrowing of fabric and maintain control over the fabric's contractions, these tools keep the fabric stretched by applying tension along the filling direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temples"@en .

aat:300432887 a skos:Concept ;
    skos:definition "Spindle-shaped loom components, typically made of wood, metal, or plastic, used to transport crosswise weft threads through the lengthwise warp threads to facilitate the introduction of a new series of threads into the woven fabric. This tool is designed to compactly store the weft threads as they are passed back and forth, either manually or mechanically, through the shed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaving shuttles"@en .

aat:300432888 a skos:Concept ;
    skos:definition "Square sheets or cards with perforations in the corners through which bundles of warp threads are passed and manipulated to weave narrow, decorative bands of wool, linen, silk, or other types of thread. These tablets were first used in Europe during the early Celtic Iron Age, with early examples found in present-day Austria, Germany, and France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaving tablets"@en .

aat:300432893 a skos:Concept ;
    skos:definition "Arrangements of flowers, ribbon, or other materials, carried by the bride in wedding ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding bouquets"@en .

aat:300432895 a skos:Concept ;
    skos:definition "General term for objects used in preparation for or during wedding ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding objects"@en .

aat:300432898 a skos:Concept ;
    skos:definition "Ring-shaped hair accessories worn by brides during wedding ceremonies; often made of florals (imitation or real), ribbon, and other fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding wreaths"@en .

aat:300432910 a skos:Concept ;
    skos:definition "Belts worn for support during weight lifting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight belts"@en .

aat:300432911 a skos:Concept ;
    skos:definition "Fitness equipment that uses a system of pulleys and weights to provide upper-body exercise. Types and amounts of weights can vary to increase or decrease the intensity of the exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight machines"@en .

aat:300432912 a skos:Concept ;
    skos:definition "Stands with one or more horizontal bars used to hold exercise weights when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight racks"@en .

aat:300432913 a skos:Concept ;
    skos:definition "Horizontal, long seats with a firm cushion. Used in conjunction with weight machines for users to sit down on while exercising or as a singular bench, with individuals laying down on the seat while lifting weights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight training benches"@en .

aat:300432935 a skos:Concept ;
    skos:definition "Plates used in the wet collodion process that are coated with soluble iodide and a solution of collodion, or cellulose nitrate. In a darkroom the plate is immersed in a solution of silver nitrate to form silver iodide. The plate, still wet, is exposed in the camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet plates"@en .

aat:300432951 a skos:Concept ;
    skos:definition "Devices or systems of devices that distribute water and heat uniformly to wheat kernels when being processed, allowing the maximum extraction of flour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheat conditioners"@en .

aat:300432952 a skos:Concept ;
    skos:definition "Machines that utilize water to wash wheat to separate sand or grit or reduce contamination from pesticides or bacteria, in preparation for milling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheat washers"@en .

aat:300432955 a skos:Concept ;
    skos:definition "Objects of wood, metal, or other materials, usually wedge-shaped, that can be inserted beneath a wheel to keep it from rolling out of place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel chocks"@en .

aat:300432957 a skos:Concept ;
    skos:definition "The central solid parts of wheels from which spokes radiate, or that support a mounted tire, and which rotate on or with an axle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel hubs"@en .

aat:300432984 a skos:Concept ;
    skos:definition "Small, carved items or designs usually made from a single block of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whimsies"@en .

aat:300432995 a skos:Concept ;
    skos:definition "Large wooden containers bound by wood or metal hoops used for maturing whiskey. Different woods and treatments are used in these to impart a variety of flavors, as well as the re-use of the cask."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiskey casks"@en .

aat:300433000 a skos:Concept ;
    skos:definition "Large boards with a white surface for writing or drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiteboards"@en .

aat:300433010 a skos:Concept ;
    skos:definition "Lidded containers made to store wigs when not in use. Some examples are cylindrical to accommodate wigs and wig forms, while others are rectangular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wig cases"@en .

aat:300433030 a skos:Concept ;
    skos:definition "Clamps designed for testing filaments, wires, ropes, cables, or straps. The material to be tested is wrapped around a guide wheel before being clamped in a jaw. The guide wheel reduces the pinching of the specimen, reducing risk of breakage during tensile testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winding clamps"@en .

aat:300433036 a skos:Concept ;
    skos:definition "Objects originally created to cover or adorn a window, door, or doorway. This class does not include relatively permanent structural parts of buildings such as canopies, exterior shutters, and window sashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window & door coverings"@en .

aat:300433043 a skos:Concept ;
    skos:definition "Lengths of material, usually cloth, hung at a window; often hung in pairs at either side of the window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window curtains"@en .

aat:300433052 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising a wooden frame, a sloping apron or feeding cloth, and a series of drawing and winding mechanisms, designed to lightly twist and further reduce the thickness of cardings or slubbings. The resulting product is thus strengthened to better withstand subsequent spinning processes. Developed as an offshot of the spinning jenny, these devices have the capacity to draw out entire rows of carding or slubbing simultaneously due to the presence of 30 to 50 spindles on which drawn out cardings/slubbings can be wound onto bobbins. However, due to the labor intensive nature associated with operating these devices, they were largely superceded by more techologically advanced wollen condensers in the 1850s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slubbing billies"@en .

aat:300433053 a skos:Concept ;
    skos:definition "Mechanized devices that utilize multiple sets of rollers to straighten, draw out, and add a small amount of twist to cotton fibers prior to spinning, thus transforming slivers into slubbing. This is the first machine that the sliver is exposed to after leaving the drawing frame. In order to produce slubbing, cans containing slivers are placed in the rear of the device and, after passing through the device's rollers, are carried on a revolving spindle and ultimately wound onto a bobbin. Slivers can pass through these devices multiple times, depending on the desired refinement of the cotton thread. The process carried out by this device resembles the drawing process, through which the sliver is incrimentally transformed into smaller and smaller dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slubbing frames"@en .

aat:300433055 a skos:Concept ;
    skos:definition "Tools used to cut the leads and slugs in letterpress printing. Usually consisting of a single handle attached to a blade and a platform to measure and hold up printed material before being cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slug cutters"@en .

aat:300433070 a skos:Concept ;
    skos:definition "Devices used in hearth-cooking, consisting of vanes on a shaft attached to a spit. Updraft from the hearth fire turns the vanes, which then rotates the spit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smokejacks"@en .

aat:300433087 a skos:Concept ;
    skos:definition "Machines used to remove smut, a fungous blight, from grain, in the process of cleaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smutters"@en .

aat:300433097 a skos:Concept ;
    skos:definition "Devices of varied design that install snap fasteners in a piece of fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snapsetters"@en .

aat:300433107 a skos:Concept ;
    skos:definition "Devices that grate ice into shavings via a perforated cylinder turned by mechanical action. Blocks of ice are pressed against the cylinder, shaving the ice when turned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sno-cone machines"@en .

aat:300433110 a skos:Concept ;
    skos:definition "A short breathing tube used by swimmers and divers, often used in conjunction with a diving mask or physically attached to a diving mask."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snorkels"@en .

aat:300433118 a skos:Concept ;
    skos:definition "Toys in the form of a transparent globe, often made of glass or plastic, containing a liquid and particles simulating snowfall when shaken. Often contains small figures inside to create particular scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow globes"@en .

aat:300433124 a skos:Concept ;
    skos:definition "Concave, circular-shaped sleds, usually made of metal or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow saucers"@en .

aat:300433163 a skos:Concept ;
    skos:definition "Objects worn as a non-political social statement of greeting, opinion, or support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social symbol"@en .

aat:300433178 a skos:Concept ;
    skos:definition "Tall glasses, usually conical, footed beakers of clear glass, intended for serving milkshakes or sodas in ice-cream shops or soda fountains, and in many restaurants. These are common in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soda fountain glasses"@en .

aat:300433183 a skos:Concept ;
    skos:definition "Lightweight textile coverings that are casually draped or laid over sofas, primarily as decoration but often also for warmth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sofa throws"@en .

aat:300433193 a skos:Concept ;
    skos:definition "Barriers of varied form that attached to windows, or to the outside of them, usually of metal, but sometimes of other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window grilles"@en .

aat:300433198 a skos:Concept ;
    skos:definition "Refrigerators that have glass doors installed to allow the user to see the contents without opening it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window refrigerators"@en .

aat:300433208 a skos:Concept ;
    skos:definition "Containers usually woven from straw or other plant material in which a bottle of wine is seated to carry or pour from."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine bottle baskets"@en .

aat:300433209 a skos:Concept ;
    skos:definition "Types of barrels used in winemaking to vary the qualities of wine as it ferments. These are usually made of oak"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine casks"@en .

aat:300433212 a skos:Concept ;
    skos:definition "Rings made of various materials, most commonly metal lined with felt, which are fitted around the necks of wine bottles to absorb splashing or drips that may occur while pouring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine collars"@en .

aat:300433215 a skos:Concept ;
    skos:definition "Metal utensils with round or conical receptacles and long narrow nozzles; sometimes with a partially fluted spout. Used to aerate wine as it is being poured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine funnels"@en .

aat:300433219 a skos:Concept ;
    skos:definition "Racks comprising a frame with compartments for holding bottles of wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine racks"@en .

aat:300433221 a skos:Concept ;
    skos:definition "Metal or glass instruments resembling syringes, consisting of a tube, which may be graduated, and cone-shaped at one end, with lateral handles used to suck up a small amount of wine from a cask to taste it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine thieves"@en .

aat:300433227 a skos:Concept ;
    skos:definition "General term for devices used for winnowing, which is separating grain from the lighter chaff or other refuse matter, by using a current of air, agitation, gravity, or other means to make the separation. Devices may range from a simple woven basket to a mechanized device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winnowers"@en .

aat:300433229 a skos:Concept ;
    skos:definition "General term for various manual devices used to separate grain from the chaff by use of a screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winnowing screens"@en .

aat:300433245 a skos:Concept ;
    skos:definition "Bottles, usually made of glass or stoneware, made to protect individuals and locations from witchcraft. Contain various combinations of pins, nails, plant material, bodily fluids, and or human organic materials (nail clippings, hair, etc.) After preparation, bottles were placed inside building foundations or concealed in outdoor locations such as churchyards. Commonly practiced in England in the 17th century, though some examples have been found in the United States dating from the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "witch bottles"@en .

aat:300433250 a skos:Concept ;
    skos:definition "Long-handled utensils used when stir-frying in a wok to add liquids, moving ingredients, or for serving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wok ladles"@en .

aat:300433251 a skos:Concept ;
    skos:definition "Ladle-like culinary tools with pierced or screened bowls to allow liquid to drain through while retaining larger solids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wok skimmers"@en .

aat:300433252 a skos:Concept ;
    skos:definition "Long-handled spatulas designed for wok stir-frying that enable maneuvering the curve of the wok. These have a thin curved lip and a wide head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wok spatulas"@en .

aat:300433258 a skos:Concept ;
    skos:definition "Cookstoves fueled by wood, typically made of cast iron or sheet steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood cookstoves"@en .

aat:300433259 a skos:Concept ;
    skos:definition "General term for various devices used to cut wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood cutters"@en .

aat:300433262 a skos:Concept ;
    skos:definition "Heaters that burn wood as fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood heaters"@en .

aat:300433263 a skos:Concept ;
    skos:definition "Closed boxes or vessels of earthenware or most commonly metal, which may be portable or fixed, in which heat is produced by combustion of wood for use in heating applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood heating stoves"@en .

aat:300433278 a skos:Concept ;
    skos:definition "Workbenches intended for shaping and building with wood. These often incorporate vices or other appurtenances for holding pieces of material while it is worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking benches"@en .

aat:300433307 a skos:Concept ;
    skos:definition "Games where words have to be formed with letters. They are played for entertainment, can also be used for educational purposes. Some word games are simply played with pen and paper, others with adapted game material, and some popular television programs consist of word games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "word games"@en .

aat:300433308 a skos:Concept ;
    skos:definition "Software that allows users to create and manipulate text-based documents (although graphics may be incorporated). Features of word processing software include the ability to change font and size, spell-checking, and organizing text in columns or lists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "word processing software"@en .

aat:300433310 a skos:Concept ;
    skos:definition "Hand coverings worn for work tasks, protecting the wearer. An example are rubber work gloves worn by fishermen to protect from water and sharp tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work gloves"@en .

aat:300433311 a skos:Concept ;
    skos:definition "Administrative records that describe tasks or jobs assigned to people or a company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work orders"@en .

aat:300433316 a skos:Concept ;
    skos:definition "Portable raised level surfaces on which people or things can be supported, to provide an elevated surface from which a particular activity or operation may be conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "working platforms"@en .

aat:300433333 a skos:Concept ;
    skos:definition "Tight-fitting combination garments worn as the standard uniform for competitive wrestlers. Typically made of nylon, lycra, spandex, or other smooth fabrics that cover the torso and thighs while leaving the arms exposed. The form-fitting nature of this garment is designed so that officials can easily detect a wrestler's bodily contact with the mat when awarding points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrestling singlets"@en .

aat:300433335 a skos:Concept ;
    skos:definition "Decorative items, usually composed of flowers that are meant to be affixed to the wrist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrist corsages"@en .

aat:300433347 a skos:Concept ;
    skos:definition "Tools, equipment, and supplies that play a direct and essential role in the creation or transmission of written messages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing devices"@en .

aat:300433356 a skos:Concept ;
    skos:definition "Hand-held board-like objects used for writing or drawing, either written upon directly or used as a support for paper or another material. For artifacts rather than equipment, particularly artifacts upon which something has been written, use \"writing tablets (information artifacts).\" For larger boards for writing, use \"writing boards (writing equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing tablets"@en .

aat:300433366 a skos:Concept ;
    skos:definition "Percussion hammers specifically intended for use with xylophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xylophone hammers"@en .

aat:300433374 a skos:Concept ;
    skos:definition "Printed or lettered objects that are intended to be posted in open spaces, particularly yards in public places or on private property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yard signs"@en .

aat:300433379 a skos:Concept ;
    skos:definition "Devices designed to support a skein of yarn while it is being unwound during use and/or wound into a ball for future use. These devices traditionally comprised a circular board nailed to a piece of oak to be handled manually, but are now electric and equipped with automated pre-selection counters for setting the desired yarn length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yarn reels"@en .

aat:300433380 a skos:Concept ;
    skos:definition "Devices typically equipped with handles that, when manually turned, are designed to twist loose yarn into a center-pull ball or skein. Many such devices also measure the yarn to a desired length based on the number of manual handle rotations performed by the spinner. Some yarn winders are also mechanized, bypassing the need for manual handle turning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yarn winders"@en .

aat:300433386 a skos:Concept ;
    skos:definition "Devices that use the solar power to heat a chamber to the temperatures required to cook food. These devices may vary in construction and methods used to concentrate the solar power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar ovens"@en .

aat:300433390 a skos:Concept ;
    skos:definition "Devices that use the heat of the sun to distill water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar stills"@en .

aat:300433391 a skos:Concept ;
    skos:definition "Telescopes, either reflecting or refracting, specifically made for observation of the features of the sun, including sunspots or prominences. They are often used in conjunction with coronographs or spectroheliographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar telescopes"@en .

aat:300433406 a skos:Concept ;
    skos:definition "Solid spherical projectiles lacking explosive charge that are launched from guns of any size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid shot"@en .

aat:300433410 a skos:Concept ;
    skos:definition "Pages containing words to be sung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "song sheets"@en .

aat:300433412 a skos:Concept ;
    skos:definition "Any of various devices used to study or illustrate musical intervals or the relationship between a vibrating string and the sound it produces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sonometers"@en .

aat:300433414 a skos:Concept ;
    skos:definition "Brass instruments in the saxophone family with a range that is analogous to the soprano voice. They are single reed, and are the highest pitched instruments in the saxophone family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soprano saxophones"@en .

aat:300433415 a skos:Concept ;
    skos:definition "Devices by which molasses is processed from sorghum cane, which is stripped of leaves and fed through the rollers of the mill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sorghum mills"@en .

aat:300433418 a skos:Concept ;
    skos:definition "Any of various types of receptacle used for sorting loose items, components, or foodstuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sorting bins"@en .

aat:300433421 a skos:Concept ;
    skos:definition "Instruments for probing parts of the body. These are usually long and slender and have a slightly enlarged end. Similar in structure and purpose as a catheter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sounds"@en .

aat:300433422 a skos:Concept ;
    skos:definition "Devices that increase the physical vibrations of sound, whether by mechanical or electronic means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound amplifiers"@en .

aat:300433424 a skos:Concept ;
    skos:definition "Devices constructed for the study of the localization of sound. These consist of a spherical cage constructed of circular wire components that divide it into eight equal parts. This is suspended by two lateral poles and is large enough to accommodate a seated adult with the upper part of the body inside of the cage. The blindfolded participant is exposed to sounds and indicates from which quadrant it appears to be emanating from. Used as a study or laboratory device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound cages"@en .

aat:300433429 a skos:Concept ;
    skos:definition "Electronic devices that connect to other sound-generating devices on which the sound controller sends signals as to pitch, modulation, attack, decay, or other event parameters designated by the sound controller itself, or in combination with the device triggered. This is usually accomplished through MIDI, but control voltage may also be implemented. Though sound controllers are most often modelled on keyboards, they may appear in any form, resembling guitars, wind instruments, or any form that allows interface with a remote sound generator or synthesizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound controllers"@en .

aat:300433430 a skos:Concept ;
    skos:definition "Devices that create specific imitative sounds, or simulate an environment of sounds, such as a battlefield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound effect simulators"@en .

aat:300433431 a skos:Concept ;
    skos:definition "Any of various devices that create audible sound waves, usually electronically and/or digitally. These may incorporate oscillators, modulators, or amplifiers or all of these combined to create a synthesis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound generators"@en .

aat:300433432 a skos:Concept ;
    skos:definition "Devices that analyze the presence or volume of auditory signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound measurers"@en .

aat:300433433 a skos:Concept ;
    skos:definition "Devices comprised of one or two pendant bobs suspended from a steel piller that strike a block affixed to the base. A graduated arc emerges from block that marks the arc of the pendulum. This measures the instensity of sound in relation to speed and distance of the pedulum strike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound pendulums"@en .

aat:300433434 a skos:Concept ;
    skos:definition "Devices constructed for the study of the localization of sound. These consist of a spherical cage constructed of circular wire components that divide it into eight equal parts. This is suspended by two lateral poles and is large enough to accommodate a seated adult with the upper part of the body inside of the cage. The blindfolded participant is exposed to sounds and indicates from which quadrant it appears to be emanating from. Used as a study or laboratory device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound perimeters"@en .

aat:300433435 a skos:Concept ;
    skos:definition "Devices that mechanically or electronically receive sound to be processed, amplified, or passively listened to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound receivers"@en .

aat:300433436 a skos:Concept ;
    skos:definition "Devices for recording audio signals on any media such as disc, tape, or film, usually by electronic means. This may be extended to include purely mechanical historical recording methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound recorders"@en .

aat:300433437 a skos:Concept ;
    skos:definition "Devices for creating optical sound tracks photographically on film using light and a gate that responds to amplification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound reproducers"@en .

aat:300433439 a skos:Concept ;
    skos:definition "Visual records or representations of sound created using Fourier analysis, particularly speech, with colors or densities corresponding to time, frequency, and energy comprised in the sound. Created by a sound spectrograph. Sound specrography was developed at Bell Laboratories in the 1940s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound spectrograms"@en .

aat:300433441 a skos:Concept ;
    skos:definition "Devices used in noise reaction experiments in which a ball is released from an adjustable height and falls upon a rubber block and thence either makes or breaks a contact that generates a sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound stimulators"@en .

aat:300433442 a skos:Concept ;
    skos:definition "Electronic toys that play pre-programmed words, sounds or music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound toys"@en .

aat:300433443 a skos:Concept ;
    skos:definition "Telecommunications devices that produce radio frequency alternating current via an antenna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound transmitters"@en .

aat:300433445 a skos:Concept ;
    skos:definition "Devices used in aquatic navigation that measure distance to solid objects by echo-location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sounding devices"@en .

aat:300433449 a skos:Concept ;
    skos:definition "Devices used to determine soundness of cement by measuring its expansion when heated in an atmosphere of steam or boiling water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soundness testers"@en .

aat:300433458 a skos:Concept ;
    skos:definition "Small, usually rectangular pieces of stiff paper or similar material that carry illustrations and/or text as mementos or souvenirs of a particular occasion, exposition, or location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "souvenir cards"@en .

aat:300433459 a skos:Concept ;
    skos:definition "Decorative utensils consisting of a straight handle with an enlarged and hollowed end-piece that are designed as mementos of a notable person, place, or event, rather than as functional objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "souvenir spoons"@en .

aat:300433461 a skos:Concept ;
    skos:definition "Devices or systems that present a user with the impression of operating spacecraft. These create an illusion of manned flight, applications of flight controls, the effects of other aircraft, and environmental factors. These simulators are used for training, design and research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space flight simulators"@en .

aat:300433485 a skos:Concept ;
    skos:definition "Pipes through which conversation can be conducted, such as between different rooms of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speaking tubes"@en .

aat:300433489 a skos:Concept ;
    skos:definition "Customized software, often proprietary and used solely within a business, and not for sale as a product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specialty software"@en .

aat:300433499 a skos:Concept ;
    skos:definition "Instruments which capture images of the sun by using only particular wavelengths of light, specifically Balmer emission lines of hydrogen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectroheliographs"@en .

aat:300433512 a skos:Concept ;
    skos:definition "Models of the skies used for teaching nautical astronomy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spheroscopes"@en .

aat:300433518 a skos:Concept ;
    skos:definition "Instruments with sharp-edged perforations that rasps small particles off of whole spices for culinary use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice graters"@en .

aat:300433521 a skos:Concept ;
    skos:definition "Frames used to support and organize spices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice racks"@en .

aat:300433522 a skos:Concept ;
    skos:definition "Devices for weighing out spices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice scales"@en .

aat:300433541 a skos:Concept ;
    skos:definition "Thimble-sized dies, caps, or plates equipped with myriad small holes through which a plastic melt base material or polymer spinning solution is forced, thus enabling the extrusion of long filaments for spinning into yarn and other man-made fibers. Akin to a shower head through which water is forced by pressure, these devices likewise utilize pressure to force the solution through its many circular or oval-shaped openings. Each hole on the die forms a single filament; the combined filaments produced by the totality of holes form filament yarn. Typically made of stainless steel or platinum, these devices can comprise myriad sizes and shapes depending upon the resulting filament's desired appearance and surface area. However, these devices are conventionally circular in shape and produce fibers that are round in cross section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinnerets"@en .

aat:300433542 a skos:Concept ;
    skos:definition "The general term for a range of mechanized devices equipped with long rows of spindles designed to spin and twist cotton fibers into yarn. Lancashire entrepreneur Richard Arkwright is credited with inventing the first spinning frame in 1767, contributing to the Industrial Revolution-era transition to factory-based textile manufacturing. Historically leveraging water power, these machines made it possible to mass produce strong yarn and reduced the need to spin cotton by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning frames"@en .

aat:300433543 a skos:Concept ;
    skos:definition "Machines equipped with many spindles designed to simultaneously draw out, twist, and wind (or spin) multiple spindles of fibers to form yarn. A modification of the spinning jenny, these machines were equipped with spindles mounted on an enlarged moving portion of the machine, rather than on a stationary frame. The modern spinning machine is often considered to be a power-driven instantiation of these manually-operated devices. The first reference to this device is thought to be in approximately 1802, when James Scholfield installed the spinning machine in his North Andover textile mill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning jacks"@en .

aat:300433545 a skos:Concept ;
    skos:definition "Spinning plates are those specially made for a kind of juggling, specifically by spinning the plates on the end of a thin dowel. These plates often have a central well at the bottom that allows them to spin on a central point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning plates"@en .

aat:300433549 a skos:Concept ;
    skos:definition "Instruments for revealing radium emanations visible to the naked eye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinthariscopes"@en .

aat:300433568 a skos:Concept ;
    skos:definition "Buildings on the grounds of a zoo, including those used for displaying animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoo buildings"@en .

aat:300433570 a skos:Concept ;
    skos:definition "Modified forms of zoetropes used to project a series of images of animals or other subjects in order to display movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoopraxiscopes"@en .

aat:300433572 a skos:Concept ;
    skos:definition "Devices that measure fermentation in liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zymosismeters"@en .

aat:300433576 a skos:Concept ;
    skos:definition "Boards of a ouija set, having letters, numbers, or other signs around its edge, upon which the planchette is moved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ouija boards"@en .

aat:300433577 a skos:Concept ;
    skos:definition "Small devices consisting of a glass container filled with spirit alcohol and a wick used for heating small vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit burners"@en .

aat:300433585 a skos:Concept ;
    skos:definition "Receptacles intended to receive the expectoration of tobacco chewers. These may appear in a variety of forms and materials, but the term is frequently applied to circular bent wood containers made the Shaker religious community specifically for this purpose. These resemble other types of Shaker nesting boxes with the addition of wood or metal reinforcing rims, and lack fitted lids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spit boxes"@en .

aat:300433586 a skos:Concept ;
    skos:definition "Containers intended to receive expectorated material, usually for the use of tobacco chewers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spit containers"@en .

aat:300433587 a skos:Concept ;
    skos:definition "Spring-loaded mechanical devices designed to rotate a spit over a fire in order to evenly roast meats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spit engines"@en .

aat:300433588 a skos:Concept ;
    skos:definition "Frames, of a variety of designs, used to store a set of spits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spit racks"@en .

aat:300433590 a skos:Concept ;
    skos:definition "Tools consisting of a circular sheet of mesh with a handle, designed to be placed over a pot or a pan to prevent hot oil or other liquids from splashing out of the pan without trapping steam or heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splatter screens"@en .

aat:300433612 a skos:Concept ;
    skos:definition "Usually hard-sided containers with lids used for storing spools for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spool cases"@en .

aat:300433613 a skos:Concept ;
    skos:definition "Contrivances used for holding or supporting spools for thread for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spool holders"@en .

aat:300433614 a skos:Concept ;
    skos:definition "Frameworks that incorporate rails, bars, or pegs, in or on which spools for thread used in needlework may be placed or suspended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spool racks"@en .

aat:300433615 a skos:Concept ;
    skos:definition "Devices either manually or electrically operated that wind thread onto spools for needlework or sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spool winders"@en .

aat:300433616 a skos:Concept ;
    skos:definition "Devices used to transfer yarn from bobbins to spools, or cylindrical tubes with rims at each end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoolers"@en .

aat:300433622 a skos:Concept ;
    skos:definition "Small dishes on which spoons or other cooking utensils may be placed during cooking to keep the cooktop or other surface clean. May be designed to hang on the side of a pot or placed flat on a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoon rests"@en .

aat:300433634 a skos:Concept ;
    skos:definition "Patterned jackets that coordinate with trousers made from unlike material, or that may have the same pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sportcoats"@en .

aat:300433642 a skos:Concept ;
    skos:definition "Devices that punch one hole at a time into punch cards (or other data media)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spot punches"@en .

aat:300433645 a skos:Concept ;
    skos:definition "Small-calibre rifles used as ranging devices for other artillery pieces, such as on artillery and antitank rocket launchers. If the spotting rifle manages to hit the target, it is assumed that the attached artillery or launcher will also."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spotting rifles"@en .

aat:300433654 a skos:Concept ;
    skos:definition "Wooden boards used by entomologists for setting insect specimens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spreading boards"@en .

aat:300433655 a skos:Concept ;
    skos:definition "Electronic documents in which data is arranged in rows and columns in a grid, and that can be manipulated to create calculations using formulas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spreadsheets"@en .

aat:300433656 a skos:Concept ;
    skos:definition "Software used for creating and editing spreadsheets, the electronic documents with columns and rows for organizing and analyzing data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spreadsheet software"@en .

aat:300433661 a skos:Concept ;
    skos:definition "Mattresses that are constructed with padded material with interior springs for support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring mattresses"@en .

aat:300433668 a skos:Concept ;
    skos:definition "Toys in which jumping or springing of players, usually children, is central. These toys are generally designed to propel the user vertically or horizontally using springs or inflatable tensile-structured objects such as air-filled membranes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring toys"@en .

aat:300433680 a skos:Concept ;
    skos:definition "Spade-like tools for digging or excavating, having a narrow chisel-shaped blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spuds"@en .

aat:300433699 a skos:Concept ;
    skos:definition "Toy figures, usually from vinyl or rubber that make a squeak when they are pressed, often intended for young children or pets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squeakers"@en .

aat:300433700 a skos:Concept ;
    skos:definition "Scraping implements, usually consisting of a straight-edged blade of rubber or similar material, attached to the end of a long handle, for removing water or other material from a surface, such as window glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squeegees"@en .

aat:300433710 a skos:Concept ;
    skos:definition "Toys where rings, blocks or other figures may be stacked on top of one other, often from large to small sizes consecutively. In this way babies and toddlers learn to stack and count."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacking toys"@en .

aat:300433723 a skos:Concept ;
    skos:definition "Devices that assist in staining, increasing visibility and contrast in microscopic samples for scientific analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staining apparatuses"@en .

aat:300433737 a skos:Concept ;
    skos:definition "Mechanical devices that pull sticks or posts from the ground or other surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stake pullers"@en .

aat:300433751 a skos:Concept ;
    skos:definition "Mortars with a flattened end used for processing grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamp mortars"@en .

aat:300433771 a skos:Concept ;
    skos:definition "Guns designed to fire blanks, used to signal the starts of races."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starter pistols"@en .

aat:300433779 a skos:Concept ;
    skos:definition "Exercise equipment consisting of a single wheel propelled by the user using two pedals while straddling a frame. The wheel and all elements are attached to a base, preventing locomotion. Handlebars are also sometimes present to provide support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stationary bicycles"@en .

aat:300433795 a skos:Concept ;
    skos:definition "Powered devices for cooking with steam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam cookers"@en .

aat:300433806 a skos:Concept ;
    skos:definition "Devices used to keep food warm during service in a cafeteria or other similar establishment, consisting of a tank of water, heated by some form of heating element, into which shallow pans of food may be placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam tables"@en .

aat:300433813 a skos:Concept ;
    skos:definition "Whistles that produce sound from jets of steam, and which are generally attached to a steam boiler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam whistles"@en .

aat:300433837 a skos:Concept ;
    skos:definition "Exercise equipment used to provide aerobic exercise and endurance training. Generally consists of two parallel platforms attached to a base, with handlebars for stability. Users step on the platforms to simulate the motion of walking up stairs. Some machines use a staircase that moves in a continuous path."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step machines"@en .

aat:300433852 a skos:Concept ;
    skos:definition "Instruments used to study human sensitivity to changes in pitch. Originally invented by William Stern in 1897 for psychological research. These consist of a brass resonator tube that is supplied with a flow of air across its top end while an interior piston may be raised or lowered, or in some cases mercury introduced, changing the volume of the chamber, thus altering the pitch of the tone of the resonator. A circular scale attached to the front indicates the audible resonance frequency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tone variators"@en .

aat:300433854 a skos:Concept ;
    skos:definition "Instruments for measuring and determining the configuration of and measuring angles of the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stethogoniometers"@en .

aat:300433857 a skos:Concept ;
    skos:definition "Woven silk pictures, made particularly during the 19th and early 20th centuries. First manufactured by Thomas Stevens' textile factory in Coventry, England, lending his name to the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stevengraphs"@en .

aat:300433859 a skos:Concept ;
    skos:definition "Electrical kitchen appliances intended to whip, chop, or froth food products. These are are designed so that they may be held in the hand and immersed directly into a pan or bowl. The chopping blade is mounted at the end of a shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stick blenders"@en .

aat:300433865 a skos:Concept ;
    skos:definition "Knives used to kill hogs by severing an artery and allowing the animal to bleed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sticking knives"@en .

aat:300433870 a skos:Concept ;
    skos:definition "Apparatuses for distillation, consisting essentially of a closed vessel (alembic, retort, or boiler) in which the substance to be distilled is subjected to the action of heat, and of arrangements for the condensation of the vapor produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stills"@en .

aat:300433871 a skos:Concept ;
    skos:definition "Banks that do not have mechanical components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "still banks"@en .

aat:300433879 a skos:Concept ;
    skos:definition "Hand tools used for mending or creating sails. Sail twine is wrapped around the shaft of the heaver several times, and the handle is turned accordingly to tension stitching or seizing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stitch heavers"@en .

aat:300433884 a skos:Concept ;
    skos:definition "Heavy-duty stitching machines designed to stitch or staple books using rolls of wire, and in bulk, as well as stitching other products. These are often used by binderies, print shops and high volume production facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire stitching machines"@en .

aat:300433917 a skos:Concept ;
    skos:definition "Decorative or protective covers for backless seating furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stool covers"@en .

aat:300433929 a skos:Concept ;
    skos:definition "Belts that are designed to store and carry small objects for the wearer while active."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage belts"@en .

aat:300433930 a skos:Concept ;
    skos:definition "Any of various types of receptacle used for storing loose items, components, or foodstuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage bins"@en .

aat:300433932 a skos:Concept ;
    skos:definition "Large cases for storing objects or other goods or materials to protect or prevent damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage crates"@en .

aat:300433933 a skos:Concept ;
    skos:definition "Cylindrical containers that store liquids or other materials, usually in large capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage drums"@en .

aat:300433934 a skos:Concept ;
    skos:definition "Casks, tuns, or other vessels used for storing water, beer, or other liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage vats"@en .

aat:300433942 a skos:Concept ;
    skos:definition "Embroidered textiles depicting narrative scenes. Examples include cloths woven by Hmong women depicting war and refugee scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "story cloths"@en .

aat:300433945 a skos:Concept ;
    skos:definition "Boards that fit over the range of a stove to create a working or protective surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove boards"@en .

aat:300433947 a skos:Concept ;
    skos:definition "Frames of metal bars for holding fuel in stoves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove grates"@en .

aat:300433951 a skos:Concept ;
    skos:definition "Square or rectangular panels typically made of tin or cast iron or consisting of a wooden base that has a tin cover, used to protect the floor area underneath a stove."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove pads"@en .

aat:300433955 a skos:Concept ;
    skos:definition "Elements or components that raise a stove from the surface of a floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove supports"@en .

aat:300433956 a skos:Concept ;
    skos:definition "Accessory items for use with heating or cooking stoves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove tools"@en .

aat:300433957 a skos:Concept ;
    skos:definition "Pipes of large diameter usually of sheet steel used as a chimney or to connect a stove with a flue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stovepipes"@en .

aat:300433958 a skos:Concept ;
    skos:definition "Moveable plates in stovepipes that control the flow of air to fire. A wide-open damper will increase the amount of air reaching the fire and improve combustion, or closed will starve the fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stovepipe dampers"@en .

aat:300433959 a skos:Concept ;
    skos:definition "Popcorn poppers that are meant to be used manually on an open flame on a range, usually fitted with a crank mechanism to keep the kernels from burning on the bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stovetop poppers"@en .

aat:300433982 a skos:Concept ;
    skos:definition "Containers or devices that give out individual straws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straw dispensers"@en .

aat:300433985 a skos:Concept ;
    skos:definition "Tweezer-like tools, often with indentations or holes in the rounded tips, used to remove the green leaves from the tops of strawberries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strawberry hullers"@en .

aat:300433997 a skos:Concept ;
    skos:definition "Driven rollers or wheels, typically tubular in shape and mounted to rotating spindles, around which the filaments of textile fibers are drawn during the manufacturing process. These devices may be heated and are often tapered at one end. The name, godet, refers to a triangular piece of material inserted in a garment to create a flared shape; its application to these textile devices is thought to have originated from the rollers' tapered geometery. Historically made from glass, the rollers are oftentimes components of larger spinning machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "godet wheels"@en .

aat:300434014 a skos:Concept ;
    skos:definition "Tools used in offset printing, consisting of an illuminated flat surface with a light source built in or underneath. Used to treat photosensitive plates to prepare them for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stripping tables"@en .

aat:300434016 a skos:Concept ;
    skos:definition "Devices used to teach the deaf to regulate vocal tones. These incorporated a spinning disk on which fifteen rings of alternating black and white spaces were displayed, the white spaces on the inner ring numbering 8, and on the outer ring 32, with intervals between. The numbers of the white spaces correspond to the vibrations of a diatonic scale. Alternating rings would appear as the user spoke, activating the flicker of a flame, causing a strobe effect as visual feedback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strobilions"@en .

aat:300434018 a skos:Concept ;
    skos:definition "Photographic electronic flash devices that have the facility to ignite repeatedly in sequence to make multiple exposures on while the shutter of a camera remains open, allowing the capture of motion in one frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stroboscopic flashes"@en .

aat:300434028 a skos:Concept ;
    skos:definition "Small lidded boxes made to hold clothing studs used for personal adornment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stud cases"@en .

aat:300434030 a skos:Concept ;
    skos:definition "Handheld devices used to locate framing studs beneath a wall surface, usually drywall. These operate via electrical or magnetic action to detect changes in density, or the presence of fasteners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stud finders"@en .

aat:300434035 a skos:Concept ;
    skos:definition "Passive devices used in photographic studios to control and direct light through reflection. These often incorporate adjustable screens and some kind of moveable support or stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studio reflectors"@en .

aat:300434036 a skos:Concept ;
    skos:definition "Fabric toys in the form of animals, real or imagined, that are filled with a soft material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuffed animals"@en .

aat:300434038 a skos:Concept ;
    skos:definition "Mechanized devices consisting of a confined box chamber, which may be heated, cooled, or exposed to a steam injection, designed to crimp, fold, bulk, and bend the individual fibers of a tow, converted tow, sliver, or similar assemblage of filaments. To facilitate this method of texturing, these devices are attached to a series of either feed rollers or fluid jets onto which textile fibers are packed or compressed; these rollers then force the fibers into the stuffer box chamber where they are exposed temperature changes while being pressed into a zig-zag pattern. Though this device was originally created for crimping carpets, it was eventually adapted to the textile industry by Joseph Bancroft & Sons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuffer boxes"@en .

aat:300434040 a skos:Concept ;
    skos:definition "Mechanized devices designed to fill pillows, cushions, stuffed animals, or other textile objects with opened fibre or crushed material such as latex, foam, or viscoelastic. These devices typically utilize suction turbines or compressed air to facilitate the stuffing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuffing machines"@en .

aat:300434048 a skos:Concept ;
    skos:definition "Small medicated sticks that help to stop the bleeding of small cuts in the skin, as from shaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "styptic pencils"@en .

aat:300434070 a skos:Concept ;
    skos:definition "Mechanized devices designed to pass fabrics through either one or two sandpaper-covered or emery rollers in order to raise the short fibers on the fabric's surface, thus producing a soft nap finish on the fabric similiar to suede. Factors dictating the sueding process, including the speed and direction of the rollers, coarseness of the sandpaper, and pressure between the fabric and the rollers, can be individually manipulated using this device to precisely determine the appearance and feel of the fabric's suede finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sueding machines"@en .

aat:300434072 a skos:Concept ;
    skos:definition "Implements used to break up hardened sugar consisting of a rod with a handle on one end and prongs or blades on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar augers"@en .

aat:300434078 a skos:Concept ;
    skos:definition "Small box or container, usually made of metal, designed to store sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar canisters"@en .

aat:300434081 a skos:Concept ;
    skos:definition "Devices used to reduce the liquid content of sweet sap or juice, such as the juice of sugar cane, until concentrated into a dense syrup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar evaporators"@en .

aat:300434082 a skos:Concept ;
    skos:definition "Special utensils of wood or metal, often with ornate forms, and particularly associated with Berber or Tuareg peoples, used to break or cut up pieces of sugar to sweeten tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar hammers"@en .

aat:300434084 a skos:Concept ;
    skos:definition "Forms into which liquid sugar may be poured to allow it to cool and crystallize into a particular shape. May take a variety of forms, including that of a cone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar molds"@en .

aat:300434093 a skos:Concept ;
    skos:definition "Single or double-breasted outer garments used to cover the upper body and designed to coordinate with matching pants and/or other articles of clothing to complete a suit. Often embellished with several pockets and worn over a waistcoat and/or dress shirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suit coats"@en .

aat:300434099 a skos:Concept ;
    skos:definition "Card punches that can be connected to tabulators or similar devices, and used to enter or punch data calculated by the connected devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summary punches"@en .

aat:300434119 a skos:Concept ;
    skos:definition "Wide straps that run over the back and under the belly of a horse or other animal to keep blankets or packs in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surcingles"@en .

aat:300434124 a skos:Concept ;
    skos:definition "Self-propelled airborne explosive devices that are intended to be launched from the ground to hit targets that are airborne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface-to-air missiles"@en .

aat:300434125 a skos:Concept ;
    skos:definition "Self-propelled airborne explosive devices that are intended to be launched from the ground to hit targets that are also on the surface of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface-to-surface missiles"@en .

aat:300434128 a skos:Concept ;
    skos:definition "Portable milking machines for dairy cattle, consisting of four metal tubes attached to a bucket. The tubes, attached to a pulsator, mimic the squeezing action of nursing or hand milking. Herbert McCornack of New Jersey invented the surge bucket milker in 1922."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surge milkers"@en .

aat:300434144 a skos:Concept ;
    skos:definition "Surgical instruments of varied design used to cut tissue, bandages, stitches, and for other purposes. Usually these are made of stainless steel but some are made from plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surgical scissors"@en .

aat:300434189 a skos:Concept ;
    skos:definition "Ornamental fastening that secures one half of a sweater or jacket to the other, usually through a buttonhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweater clips"@en .

aat:300434201 a skos:Concept ;
    skos:definition "Triangular, flexible appendages built to improve underwater movement, worn on the feet and sometimes also attached to the ankles with a single loop. Usually made of rubber. Commercial swim fins were first patented by Owen Churchill (1896-1985) in the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swim fins"@en .

aat:300434202 a skos:Concept ;
    skos:definition "Protective eye coverings used for underwater activities; generally made of rubber or other flexible material with plastic lenses. Earlier models used glass eye coverings. Worn around the head, secured by means of a flexible band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swim goggles"@en .

aat:300434204 a skos:Concept ;
    skos:definition "Fishing lures that are designed to imitate the underwater swimming motions of bait used to attract fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swimbait"@en .

aat:300434215 a skos:Concept ;
    skos:definition "Mounting rings often with carabiners attached that connect to lines that allow flags to turn on a pole without getting tangled in changing winds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swivels"@en .

aat:300434217 a skos:Concept ;
    skos:definition "Small caliber cannons mounted swiveling stands or bases which allows for a large arc of movement. Most often used on ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swivel guns"@en .

aat:300434218 a skos:Concept ;
    skos:definition "Hooks mounted to rings so that the orientation of the hook may change or revolve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swivel hooks"@en .

aat:300434232 a skos:Concept ;
    skos:definition "Printed or handmade greeting cards expressing condolence on a bereavement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sympathy cards"@en .

aat:300434235 a skos:Concept ;
    skos:definition "Cords that provide a link between a camera trigger and an electronic flash. These may be found terminated in a variety of jack types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sync cords"@en .

aat:300434237 a skos:Concept ;
    skos:definition "Devices used to cause multiple clocks or other timekeeping units to coincide in time, or to operate simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synchronizers"@en .

aat:300434240 a skos:Concept ;
    skos:definition "Cylindrical instruments, most often consisting of a tube mounting a piston, or a tube with a rubber bulb attached, used to draw in liquid, and to eject it in a stream or jet for making injections, taking samples, cleansing, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syringes"@en .

aat:300434243 a skos:Concept ;
    skos:definition "Tools for dispensing maple syrup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syrup dippers"@en .

aat:300434261 a skos:Concept ;
    skos:definition "Removable mats found in a variety of fabrics, shapes, and patterns that are generally embroidered. Used under vases or dishes to protect the table from wear, or for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table mats"@en .

aat:300434262 a skos:Concept ;
    skos:definition "Products meant to protect primarily wooden table surfaces from damage caused by spills, heat, scratches, and sunlight exposure. These may be used beneath tablecloths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table pads"@en .

aat:300434264 a skos:Concept ;
    skos:definition "Long narrow strips of cloth placed along a table for decoration or to protect the surface when placing objects upon it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table runners"@en .

aat:300434266 a skos:Concept ;
    skos:definition "Long narrow strips of usually decorative fabric that are meant to be draped over the length of tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table scarves"@en .

aat:300434268 a skos:Concept ;
    skos:definition "Spherical, hollow polymer balls fabricated specifically for the sport of table tennis or ping-pong. They have a diameter of 1.57 inches (40 mm) and circumference of 4.94 inches (125.6 mm)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table tennis balls"@en .

aat:300434269 a skos:Concept ;
    skos:definition "Any equipment or clothing used to play the game of table tennis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table tennis gear"@en .

aat:300434270 a skos:Concept ;
    skos:definition "Nets used in the game of table tennis that divide the table into two halves, suspended from two poles attached to the table at a regulation height of 15.25 centimetres."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table tennis nets"@en .

aat:300434271 a skos:Concept ;
    skos:definition "Paddles made from laminated wood covered with rubber on one or two sides. The official Internation Table Tennis Federation term is \"racket,\" but in the the US \"paddle\" is generally preferred. In European and Asian countries, \"bat\" may be used. There is no regulation size or shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table tennis paddles"@en .

aat:300434272 a skos:Concept ;
    skos:definition "Sets of objects used for playing table tennis or ping-pong. Sets usually consist of paddles, balls, and a detachable net that can be stretched over the center of a table. The set may also include a foldable table, usually with wheels, that enables easy storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table tennis sets"@en .

aat:300434273 a skos:Concept ;
    skos:definition "Tables on which the game of table tennis or ping-pong is played. These are 9 feet or 2.74 meters long by 5 feet or 1.525 meters in width. The playing surface is at a height of 2.5 feet or 76 centimeters. These may be made from a variety of materials, and may be either portable or fixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table tennis tables"@en .

aat:300434274 a skos:Concept ;
    skos:definition "Light textile throws used as decor on tabletops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table throws"@en .

aat:300434280 a skos:Concept ;
    skos:definition "Small, portable devices that use warps threaded through the holes of perforated tablets to create decorative bands. The device's tablets rotate as the warp is threaded, creating patterned sheds through which the weft thread is passed. These looms were commonly used during the Roman and Byzantine eras, but originated in Egypt around the 1st millennium BC."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablet looms"@en .

aat:300434288 a skos:Concept ;
    skos:definition "Calculating machines that tally or compile data entered on punch cards. The first models were designed and produced by American inventor Herman Hollerith in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabulating machines"@en .

aat:300434289 a skos:Concept ;
    skos:definition "Instrument for exposing visual stimuli used in the study of visual attention."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tachistoscopes"@en .

aat:300434307 a skos:Concept ;
    skos:definition "Mechanical devices that pull and aerate a soft candy base to make taffy. The machine has two or four arms that stretch and fold the material, giving it a satin look and mixing it with additives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taffy pulling machines"@en .

aat:300434315 a skos:Concept ;
    skos:definition "Hard chalk or soapstone used to make eradicable marks on fabric for tailoring or cutting fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tailor's chalk"@en .

aat:300434318 a skos:Concept ;
    skos:definition "L-shaped rulers with measurement divisions engraved or printed on them used for achieving angles and straight lines when constructing garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tailor's squares"@en .

aat:300434323 a skos:Concept ;
    skos:definition "Thin, wooden staffs, often carved with iconographic figures and sometimes decorated with feathers, beadwork, or other ornamentation. Particularly used by Native North Americans to organize ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talking sticks"@en .

aat:300434328 a skos:Concept ;
    skos:definition "Devices, mechanical or electronic, that are used to incrementally count something. They are often hand-operated and pocket-sized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tally counters"@en .

aat:300434333 a skos:Concept ;
    skos:definition "Plucked, stringed lutes of the Balkans, which resemble a mandolin in shape. The alto version of the instrument is known as the brac, and the tenor is the celo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tamburitzas"@en .

aat:300434341 a skos:Concept ;
    skos:definition "Objects containing sacred Jewish scriptures. The term Tanakh is an acronym based on the primary letters of the work's three major components: the Torah or Pentateuch, the Nevi'im (meaning Prophets), and the Ketuvim (meaning Writings). The Tanakh is also the source for the Old Testament, a component of the Christian Bible. Has been reproduced in the format of oral histories, scrolls, codices, and books. Some codices and scrolls, from the 11th century CE and earlier, are illuminated with scrollwork, geometric designs, and micrography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanakhs"@en .

aat:300434354 a skos:Concept ;
    skos:definition "Devices for pressing refuse meat and other offal from slaughterhouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tankage presses"@en .

aat:300434360 a skos:Concept ;
    skos:definition "Horizontal platforms surrounded by ultraviolet light-emitting bulbs that cause the appearance of a suntan on human skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanning beds"@en .

aat:300434361 a skos:Concept ;
    skos:definition "Vertical stalls that are fixed with ultraviolet light-emitting bulbs or a means to spray chemicals that simulate a deep suntan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanning booths"@en .

aat:300434362 a skos:Concept ;
    skos:definition "Equipment or apparatuses that involve ultraviolet radiation or chemical means to produce a cosmetic tan on skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanning devices"@en .

aat:300434363 a skos:Concept ;
    skos:definition "Electric devices designed to emit ultraviolet light for the purpose of suntanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanning lamps"@en .

aat:300434368 a skos:Concept ;
    skos:definition "Lingerie shorts popular from the 1920s. Originally made for dancing, but more popularly worn as an undergarment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tap pants"@en .

aat:300434372 a skos:Concept ;
    skos:definition "Mechanized devices that use tape strips to both divide the wide fiber web from a woolen card into a series of strips and rub the strips into slubs or slivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape condensers"@en .

aat:300434375 a skos:Concept ;
    skos:definition "Contrivances used for holding or supporting rolls of tape used for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape holders"@en .

aat:300434376 a skos:Concept ;
    skos:definition "Portable, human-operated devices used to weave narrow strips of fabric, roughly an inch wide, called tapes. These devices are typically made of wood and often comprise a paddle-shaped board equipped with alternating slots and holds (a rigid heddle) sometimes, but not always, attached to a box or frame. Designed to be held between the user's knees during operation, these devices required that the warp be stretched by the user's one hand to determine the correct degree of tension while the weft be picked with the user's other hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape looms"@en .

aat:300434378 a skos:Concept ;
    skos:definition "Machines that reproduce recorded content from magnetic tape. Most often this content is audio recordings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape players"@en .

aat:300434379 a skos:Concept ;
    skos:definition "Devices that read information that has been recorded by sequences of perforations or magnetized areas on computer tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape readers"@en .

aat:300434381 a skos:Concept ;
    skos:definition "Computing devices that can play or read tape, but do not punch or record onto tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape reproducers"@en .

aat:300434403 a skos:Concept ;
    skos:definition "Coverings, originally sheets of canvas coated or impregnated with tar to repel moisture, used to protect objects beneath them. The term is often applied to other kinds of waterproof cloth, made from polyurethane or polyethylene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarpaulins"@en .

aat:300434410 a skos:Concept ;
    skos:definition "Small flat instruments used to create a kind of knotted lace from thread, which is wound around an element of the shuttle. These may be made of metal, wood, plastic, or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tatting shuttles"@en .

aat:300434423 a skos:Concept ;
    skos:definition "Small bowls into which tea bags are deposited after steeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea bag dishes"@en .

aat:300434427 a skos:Concept ;
    skos:definition "Canisters, made of a variety of materials, but typically of tin or ceramic, designed to hold tea and maintain its freshness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea canisters"@en .

aat:300434440 a skos:Concept ;
    skos:definition "Mechanical, automated devices that instruct pupils with teaching programs. Most models allow progression based on correct answers to questions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teaching machines"@en .

aat:300434448 a skos:Concept ;
    skos:definition "Small glass vessels, usually with a neck that narrows towards the bottle’s opening. Commonly found in ancient Greek, Egyptian, and Roman archaeological sites, especially tombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tear bottles"@en .

aat:300434451 a skos:Concept ;
    skos:definition "Devices, comprising a fixed jaw, moveable jaw, pointer, and pendulum, designed to measure the degree to which lightweight fabrics and resin-finished cloth can both withstand the effects of tearing and resist further propagation of a tear after it has been initiated. To measure a fabric's tearing strength, a small rectangular fabric sample is placed between the device's fixed and moveable jaws where it is torn rapidly by the motion of a falling pendulum. The energy loss during tearing is then assessed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tear testers"@en .

aat:300434453 a skos:Concept ;
    skos:definition "Hand-held tools, typically comprising a series of teasel seed pods mounted onto a wooden frame and handle, used to brush the surface of woven cloth in order to raise the naps of the wool. Beginning in the 1860s, growing textile manufacturing mills began to replace these tools with automated napping gigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teasel crosses"@en .

aat:300434466 a skos:Concept ;
    skos:definition "Objects such as teething rings designed for a baby to bite on during teething."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teething toys"@en .

aat:300434486 a skos:Concept ;
    skos:definition "Instruments that combine the functions of microscopes and telescopes (now rarely used)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telengiscopes"@en .

aat:300434499 a skos:Concept ;
    skos:definition "Instruments that combine the functions of telescopes and polariscopes (now rarely used)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telepolariscopes"@en .

aat:300434505 a skos:Concept ;
    skos:definition "Instruments that combine the functions of telescopes and spectroscopes (now rarely used)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telespectroscopes"@en .

aat:300434522 a skos:Concept ;
    skos:definition "Objects originally created to enable people to control the temperature of their immediate environment according to their needs. This class does not include devices to control temperature for purposes other than human comfort, as is the case with bake ovens and kilns. Nor does it include relatively permanent structural parts of a building, such as fireplaces or flues or whole-structure systems for environmental control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperature control equipment"@en .

aat:300434527 a skos:Concept ;
    skos:definition "Vases, commonly made of porcelain or ceramic, made to decorate religious altars. Examples include Yuan-period porcelain vases used for Buddhist altars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temple vases"@en .

aat:300434528 a skos:Concept ;
    skos:definition "Designs applied to the skin by means of transferring temporary ink or dye from a decal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temporary tattoos"@en .

aat:300434539 a skos:Concept ;
    skos:definition "Implements used for striking the ball in the sport of tennis. Consisting of a handle that supports a more or less circular or oval frame, traditionally of wood but more recently of lightweight metal, etc.; across the frame is strung a taut latticework of fine cord, catgut, or artificial fibre, and (shuttlecock, etc.) in various sports"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tennis rackets"@en .

aat:300434545 a skos:Concept ;
    skos:definition "Cylindrical, wooden drums that are similar to snare drums, but do not have snares. They typically measure 35cm in height and 45cm in diameter. Tenor drums have historically been associated with military and marching bands, though they sometimes appear in classical orchestrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenor drums"@en .

aat:300434546 a skos:Concept ;
    skos:definition "Smaller acoustic guitars, introduced in the 1920s, that have four strings and are tuned like tenor banjos, an extremely popular instrument of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenor guitars"@en .

aat:300434548 a skos:Concept ;
    skos:definition "Brass instruments in the saxophone family with a range that is analogous to the tenor voice. They have tapered bores and are single reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenor saxophones"@en .

aat:300434557 a skos:Concept ;
    skos:definition "Devices designed to dry and stretch wet woven cloth to a desired width under tension. These devices have been used since the 14th century, during which time they comprised large wooden frames equipped with an array of equidistantly mounted tenterhooks on which wet cloth was fastened and held taut. Mechanized devices now exist, however, characterized by pairs of continuous traveling chains fitted with hooks on horizontal tracks. The chains diverge as they pull the fabric forward through the device, stretching the fabric on all edges. After traveling half the length of the mechanized frame, fabric is exposed to water through the device's spray pipe components and subsequently carried through a heated chamber component to dry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenter frames"@en .

aat:300434558 a skos:Concept ;
    skos:definition "Small metal spikes or hooks designed to secure and stretch the edges of wet woven cloth as it dries after being exposed to fabrication processes such as washing, beating, and fulling, amongst others. Hundreds of these hooks are positioned in close rows around a wooden tenter frame to hold the fabric taut and prevent the damp piece of cloth from shrinking and warping out of shape during the drying process. Widely used in Europe beginning in the 15th century, this term's meaning later evolved and was abstracted in the 16th century to mean the expansion of one's consciousness and uncertainty about one's future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenterhooks"@en .

aat:300434564 a skos:Concept ;
    skos:definition "Electrical transformers that use high-frequency alternating current to increase voltage, invented by Nikola Tesla ca.1891. The voltage levels allow the electricity to travel through the air as arcs resembling lightning. Though Tesla coils produce high voltage, the high frequency of the current make these arcs generally safe for human interaction, and have been used in popular exhibitions. These were also important to the development of radio technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tesla coils"@en .

aat:300434566 a skos:Concept ;
    skos:definition "Heating devices used for evaluating the fire resistance of materials and objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "test furnaces"@en .

aat:300434567 a skos:Concept ;
    skos:definition "Devices that calculate or tabulate test scores. An early example was IBM’s “Test Scoring Machine” developed in 1928, which used the electrical conductivity of graphite pencil marks to interpret correct and incorrect answers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "test scoring devices"@en .

aat:300434569 a skos:Concept ;
    skos:definition "Stands which hold, store, transport, or display the cylinders of thin transparent glass that hold liquids under test in laboratories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "test tube rack"@en .

aat:300434580 a skos:Concept ;
    skos:definition "Mechanized devices designed to expose textile surfaces to a stiff-bristeled brush thus creating a soft, uniform surface finish and removing dust or impurities accumulated during previous steps of thetextile manufacturing process. Though this device is commonly used as a surface finishing tool in textile production, its application is also relevant for the fabrication of wood, metal, and other similar materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile brushing machines"@en .

aat:300434582 a skos:Concept ;
    skos:definition "Mechanized devices designed to apply a layer of textile strength carrier, such as polyurethane, polyvinyl chloride, acryclic resins, natural or synthetic rubber paste, or similar chemical solutions, to one or both sides of a textile substrate. Unlike traditional chemical finishes, during which chemical treatments infiltrate the substrate's fibers, the coating facilitated by these devices produces a chemical layer in the spaces between the fibers; this coating produces a new chemical structure to strengthen textile materials and promote increased corrosion, thermal, and abrasion resistance. Depending on the type of substrate being coated, these devices can incorporate interroller pressure, knife-spread, dip, spray, powder, extrusion, or UV-cured coating technologies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coating machines"@en .

aat:300434583 a skos:Concept ;
    skos:definition "Hand-held devices fitted with a series of metal teeth, which are designed to eliminate neps and impurities in fibers, as well as to ensure that fibers lay parallel to one another. While these devices can take many forms, they are typically utilized to create cleaner, finer, stronger, and more lustrous fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile combs"@en .

aat:300434584 a skos:Concept ;
    skos:definition "Mechanized devices designed to utilize thermal techniques to produce non-linear, wavy, and zig-zagged ridges in man-made fibers. Taking advantage of the thermoplasticity of fibrous materials, these devices typically set fibers at a temperature near their softening point while simultaneously subjecting them to bending and twisting actions before lowering their temperature using cooling technologies. Because fibers are commonly heat stretched prior to crimping, they experience considerable thermoshrinkage when crimped using these devices. The primary function of crimping machines is to provide bulk to fibers, resulting in increased softness and resistance to wear and abrasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crimping machines"@en .

aat:300434585 a skos:Concept ;
    skos:definition "General term for the mechanical equipment used to remove superfluous moisture content from fabrics or garments, comprising a broad range of devices utilizing a range of drying methods. Most typically, this equipment uses hot air to evaporate the fabric's liquid content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile dryers"@en .

aat:300434586 a skos:Concept ;
    skos:definition "Large containers or casks in which textile materials are soaked in reducing baths, which utilize reducing agents like sodium hydrosulfite to convert water-insoluble vat dyes into a soluble form, as a means of altering the color of fibers for aesthetic purposes. When textile materials are exposed to dyes in these containers for prolonged periods of time, their individual fibers are impregnated with the dye color; the dyes, now infused in the fibers, are then oxidized back to their original insoluble forms for increased color brilliance and light fastness. First used in medieval Europe, these containers derived their names from the large vats once used in the reduction of indigo plants through fermentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile dyeing vats"@en .

aat:300434587 a skos:Concept ;
    skos:definition "Devices that fasten or hold together separate parts of objects made from textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile fasteners"@en .

aat:300434588 a skos:Concept ;
    skos:definition "Mechanized devices designed to automate the process of folding open textiles, garments, and fabrics in half and harvesting fabric rolls and boards, thus facilitating subsequent storage procedures. Typically, the device's conveyor belt system carries the textiles through various folding rods and mechanisms, resulting in uniform folds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding machines"@en .

aat:300434589 a skos:Concept ;
    skos:definition "General term for the mechanical equipment used to manufacture textiles and fabrics, comprising a broad range of devices that are essential to various phases of the production process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile machines"@en .

aat:300434593 a skos:Concept ;
    skos:definition "A type of notion used either to repair a piece of fabric or garment, or that may be purely decorative, or both. These may be embroidered, come backed with adhesive, or intended to be sewn onto a support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile patches"@en .

aat:300434596 a skos:Concept ;
    skos:definition "Mechanized devices, typically comprising a shearing unit made of steel blades spirally mounted on a roller and a flat ledger blade, designed to remove excess surface fibers from fabrics and trim raised naps to a uniform height. To facilitate the shearing process, the device's spiral rollers rotate against the flat ledger blade to selectively cut naps at various lengths, operating in a similar way to scissors. As the fabric moves through the device's blades, its surface becomes smooth and consistent as excess fibers are trimmed. In addition to enhancing the fabric's appearance, this device can also be used to create myriad effects in fabrics such as pile variation, texture contrast, pattern shearing, and improved print definition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shearing machines"@en .

aat:300434597 a skos:Concept ;
    skos:definition "Mechanized devices designed to uniformly and gradually stretch cotton goods and other textile fabrics that have contracted through the course of bleaching, dyeing, printing, and other textile fabrication processes. Specifically, these devices carry out a textile finishing process that prepares materials for the market by laying their warp and woof yarns in parallel poisitions. The machines typically comprise a series of large rubber-covered stretching pulleys mounted on a driving shaft, a traveling belt, and two pairs of corrugated wheels. As fabric is fed into the device, it is held under the pulleys by the pressure of a traveling belt acting against the lower half of each pulley; when the wheels move the pulleys, the fabric is likewise pulled to achieve to the user's desired width."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretching machines"@en .

aat:300434598 a skos:Concept ;
    skos:definition "Collectively used for decorative or additional material serving to finish, decorate, or complete textiles of any kind, including garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile trim"@en .

aat:300434599 a skos:Concept ;
    skos:definition "General term for a variety of storage devices designed to hold textilemaking tools and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textilemaking tool case"@en .

aat:300434602 a skos:Concept ;
    skos:definition "Mechanized devices designed to modify the physical form of synthetic textile materials by introducing twists, loops, coils, or crinkles into the fiber's filaments, thus improving textile appearance, increasing warmth and absorbency, and lessening pilling. Because there are myriad texturing methods, these devices vary slightly. While some utilize friction disks or spindles and heat to twist fibers, others utilize air streams and high pressure to facilitate the texturing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "texturing machines"@en .

aat:300434606 a skos:Concept ;
    skos:definition "Traditional Arab robes or over-garments worn throughout the Arabian Peninsula, made of loose wool, cotton, polyester, or other material covering the body to the ankles. Typically long-sleeved and white in color, but the garment's specific style varies between regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thawbs"@en .

aat:300434609 a skos:Concept ;
    skos:definition "Large printed sheets used to promote a theatrical production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theater posters"@en .

aat:300434639 a skos:Concept ;
    skos:definition "Enclosing containers of varied design, used for storing thimbles for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thimble cases"@en .

aat:300434640 a skos:Concept ;
    skos:definition "Contrivances used for holding or supporting thimbles for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thimble holders"@en .

aat:300434651 a skos:Concept ;
    skos:definition "Enclosing containers of varied design that are used for storing thread for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread cases"@en .

aat:300434652 a skos:Concept ;
    skos:definition "Magnifying tools, comprising a rotatable magnifying lens mounted a fixed distance above a platform on which textile materials can be examined, designed to count woven fabric threads within a given space or texture. To measure the thread count of a fabric sample, these optical devices work to enlarge the user's view of the fabric's warp and weft threads so the fabric quality can be more easily determined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread counters"@en .

aat:300434658 a skos:Concept ;
    skos:definition "Any of various devices that wind thread into a bundle or onto a support for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread winders"@en .

aat:300434662 a skos:Concept ;
    skos:definition "Equipment or machines that are used to separate grain from the straw by beating with a flail, or otherwise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "threshers"@en .

aat:300434667 a skos:Concept ;
    skos:definition "Mechanized spinning machines, typically comprising a roving, a pair of drawing-rollers and spindles, a fly, a tube, and a series of drums, designed to produce yarn from cotton fibers and then wind the yarn onto bobbins. The simplest of all spinning machines, these devices are commonly used to spin English worsted yarn, amongst other types of smooth yarn from which sewing thread and durable warps are produced. The design of these spinning machines is a modification of Richard Arkwright's water-frame. The charactetistic feature of these devices is the fact that they are equipped with rows of spindles and their constituent parts on each side, so that the machine is two-sided; the parts on both sides of the machine are connected and simultaneously operated by bands from a tin cylinder lying horizontally under the machine. Unlike the water-frame, which uses a water wheel as a motor, the throstle frame employs a steam engine to facilitate the mass production of large quantitities of yarn. The device dates from the early 19th century and derives its name, throstle, from the humming sound the machine makes while running."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throstle frames"@en .

aat:300434671 a skos:Concept ;
    skos:definition "Textile coverings for small pillows placed on a chair, couch, or other furniture, primarily for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throw pillow covers"@en .

aat:300434676 a skos:Concept ;
    skos:definition "Manual or mechanized devices designed to twist raw silk filaments into a unified thread to be used for weaving. While these devices vary, they typically comprise a twisting frame that rotates a series of spindles which twist skeins of raw silk and winds them onto bobbins. The first evidence of these devices can be traced back to either 1272 -1276 CE in Lucca, Italy or 1313 in China, though the devices could have been in use much earlier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing machines"@en .

aat:300434693 a skos:Concept ;
    skos:definition "Tic-tac-toe is a simple two player game. It can be played on a sheet of paper, or with objects. The game is played on 3 by 3 fields, which are all empty at the start. One player puts a 'cross' (Xs) and the other player a 'circle' (Os). Whoever has three of their own characters in a row, which may be diagonal, vertical or horizontal, is the winner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tic-tac-toe"@en .

aat:300434694 a skos:Concept ;
    skos:definition "Tiddlywinks is a game where round chips or discs called \"winks\" have to be shot into a bin, pot or scoreboard. This is done by pressing a chip on the edge of another chip so that it jumps into the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiddlywinks set"@en .

aat:300434702 a skos:Concept ;
    skos:definition "Hooks designed to hold the decorative strips or loops, as of cloth, cord, or metal, intended to hold a curtain or drapery back to one side, so that it is draped in a partially open position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tieback hooks"@en .

aat:300434703 a skos:Concept ;
    skos:definition "Rounded or spherical projections onto which curtain tiebacks can be affixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tieback knobs"@en .

aat:300434704 a skos:Concept ;
    skos:definition "Fasteners in the form of a loop, rather than a strip, that act as a tieback for curtains. These can be chained together to create extra length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tieback loops"@en .

aat:300434706 a skos:Concept ;
    skos:definition "Devices or vehicles used to transport and lift objects that are stacked, for moving loads from one location to another, usually in the context of warehouses, factories, or markets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiering machines"@en .

aat:300434729 a skos:Concept ;
    skos:definition "Balls that are mounted on vertical poles or rods, often surmounting towers, and that move downward at predermined times to provide precise signals from a distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time balls"@en .

aat:300434732 a skos:Concept ;
    skos:definition "Clocks that incorporate a device for recording times of arrival and departure of individuals, usually in the context of employment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time recording clocks"@en .

aat:300434738 a skos:Concept ;
    skos:definition "Structures specifically designed to contain and protect the movements of timepieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timepiece cases"@en .

aat:300434740 a skos:Concept ;
    skos:definition "Keys used to wind the movements of timepieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timepiece keys"@en .

aat:300434755 a skos:Concept ;
    skos:definition "Precision instruments, comprising two identical tubes placed side by side, designed to determine the color of a sample of any substance and record it in terms of an arbitrary unit. To determine the sample's exact color, the device's first tube is filled with the sample to be examined; tinted glasses, which are graduated on a scale of color density, are inserted in the second tube and manipulated by the user until the colors in both tubes exactly match. Based on the observed correspondence between the sample color and the tinted glasses, the user is able to determine the degree of impurity or purity for the given substance of a certain color. The tintometer's invention is credited to Joseph W. Lovibond, who obtained a patent for the device in 1886. Though Lovibond initially created the tintometer to control beer quality by matching each batch to a color standard, his invention has since been applied to the textile industry, amongst other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tintometers"@en .

aat:300434761 a skos:Concept ;
    skos:definition "Bookbinding machines that apply a layer of paste to the outer edges, or books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tipping machines"@en .

aat:300434771 a skos:Concept ;
    skos:definition "Manual or electrically operated air pumps that are designed to inflate tires, often with guages attached to measure pressure levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tire pumps"@en .

aat:300434776 a skos:Concept ;
    skos:definition "Soft, porous, disposable papers used for personal hygeine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tissues"@en .

aat:300434778 a skos:Concept ;
    skos:definition "Specimens of tissue taken for scientific analysis or testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tissue samples"@en .

aat:300434779 a skos:Concept ;
    skos:definition "Devices for noting the tithonic or chemical effect of rays of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tithonometers"@en .

aat:300434782 a skos:Concept ;
    skos:definition "Instruments used for measurement or analysis by the process of determining the concentration of a solution or its constituents by adding measured volumes of a reagent until a reaction just begins or ceases to occur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titrometers"@en .

aat:300434785 a skos:Concept ;
    skos:definition "Utensils, often of wood, consisting commonly of two pieces that are joined at one end or near one end by a pivot or spring, and that are used to retrieve hot toast from a toaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toast tongs"@en .

aat:300434787 a skos:Concept ;
    skos:definition "Small, electric appliances that combine the functions of a toaster and an oven. Typically these are used for toasting bread, reheating food, and small batch baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toaster ovens"@en .

aat:300434798 a skos:Concept ;
    skos:definition "Novelty textile inserts in tobacco product packaging made of a cotton flannel fabric and printed with designs.These were common promotional items from the late 19th century through the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco flannel"@en .

aat:300434803 a skos:Concept ;
    skos:definition "Small bags of varied material, usually with a drawstring opening used to store tobacco before use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco pouches"@en .

aat:300434804 a skos:Concept ;
    skos:definition "Small novelty promotional items of varied form given away with packaged tobacco products from the late 19th-early 20th century generally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco premiums"@en .

aat:300434808 a skos:Concept ;
    skos:definition "Popular novelties or premiums given away with commercial tobacco products in the late 19th-early 20th century made of a variety of fabrics that were polychrome printed with images and usually the name of the tobacco company. These came in various themes and formats"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco silk"@en .

aat:300434837 a skos:Concept ;
    skos:definition "Thin paper, usually in small sheets or on a roll, used for personal hygeine during defecation or urination; lavatory paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet paper"@en .

aat:300434842 a skos:Concept ;
    skos:definition "Covers for the rings of plastic or wood fitting the top of a toilet bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet seat covers"@en .

aat:300434846 a skos:Concept ;
    skos:definition "Containers made to store items for personal grooming and sanitation. Made in varying shape and size, but generally contain compartments for storing different toiletry items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toiletry bags"@en .

aat:300434863 a skos:Concept ;
    skos:definition "Instruments for measuring the frequencies of tones or exact pitch, as a set of graduated tuning forks. An advancement of Reed's tonometer, providing more tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tone difference apparatuses"@en .

aat:300434865 a skos:Concept ;
    skos:definition "Containers composed of toner and mechanical components used to print images within laser printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toner cartridges"@en .

aat:300434874 a skos:Concept ;
    skos:definition "Small ornamental piercings worn through the tongue, often made of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tongue studs"@en .

aat:300434878 a skos:Concept ;
    skos:definition "Devices designed to visualize audio waveforms, particularly the human voice. Vibrations were conducted through solid or liquid media, and either projected or photographed to view the result."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tonoscopes"@en .

aat:300434880 a skos:Concept ;
    skos:definition "Garments worn over main garments to both protect clothing and to store utensils when not being used. Generally contains a front pocket for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tool aprons"@en .

aat:300434881 a skos:Concept ;
    skos:definition "Belts used to secure utensils to the wearer to allow for temporary storage when working."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tool belts"@en .

aat:300434886 a skos:Concept ;
    skos:definition "Sets of tools, especially those kept for a particular purpose, usually in a special bag or box."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tool kits"@en .

aat:300434896 a skos:Concept ;
    skos:definition "Instruments of dentistry resembling pliers that are used to pull teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tooth extractors"@en .

aat:300434898 a skos:Concept ;
    skos:definition "Capsules that contain toothbrushes to keep them clean while traveling or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothbrush cases"@en .

aat:300434903 a skos:Concept ;
    skos:definition "Containers or devices that give out individual toothpicks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothpick dispensers"@en .

aat:300434910 a skos:Concept ;
    skos:definition "Three-dimensional models that demonstrate the shapes, features, and elevation of a part of the Earth's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topographic models"@en .

aat:300434911 a skos:Concept ;
    skos:definition "Devices comprised of acoustic receivers positioned at right angles to one another and attached to a shaft that is held by the user. The sound collected by these horns is conducted to ear-pieces through rubber hoses. Developed to discover the position of the source of sounds in space, as invented ca.1880, particularly for use on ships to locate the position of foghorns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topophones"@en .

aat:300434927 a skos:Concept ;
    skos:definition "Tools that flatten dough, or masa, into tortillas. These have two flat, round surfaces usually at least 8 inches in diameter that squeeze the dough between sheets of plastic, parchment paper, or corn leaves to prevent sticking and create uniform thickness and diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tortilla presses"@en .

aat:300434936 a skos:Concept ;
    skos:definition "Pleats or gathers of fabric used to trim a garment or soft furnishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruche"@en .

aat:300434946 a skos:Concept ;
    skos:definition "Machines for drawing or engraving equally spaced parallel straight lines on surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruling engines"@en .

aat:300434947 a skos:Concept ;
    skos:definition "Bookbinding machines, employing either ruling pens of ruling disks, that apply lines to the pages of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruling machines"@en .

aat:300434949 a skos:Concept ;
    skos:definition "Small barrels for storing and dispensing rum that have previously held rum, to enhance flavor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rum casks"@en .

aat:300434966 a skos:Concept ;
    skos:definition "A variant form of polariscope used for testing sugar solutions under polarized light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saccharimeters"@en .

aat:300434968 a skos:Concept ;
    skos:definition "Loose-fitting gowns or lounging robes made of lightweight fabric, being short, unwaisted, and usually narrowing at the hem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacks"@en .

aat:300434971 a skos:Concept ;
    skos:definition "Blades used for ritual sacrifice of living beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacrificial knives"@en .

aat:300435000 a skos:Concept ;
    skos:definition "Frameworks that incorporate rails, bars, or pegs, in or on which safety pins may be placed or suspended for access."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety pin racks"@en .

aat:300435002 a skos:Concept ;
    skos:definition "Razors that protect the user during shaving via a guard over the blade that prevents deep cuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety razors"@en .

aat:300435007 a skos:Concept ;
    skos:definition "Watercraft propelled by the wind, consisting of a horizontal platform for the rider and a single large sail. Riders use a bar attached to the sail to both maneuver the craft and to stay on the board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailboards"@en .

aat:300435014 a skos:Concept ;
    skos:definition "Hand tools used in the fabrication of sails used to smooth and flatten seams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker’s rubbers"@en .

aat:300435015 a skos:Concept ;
    skos:definition "Work surfaces for sailmakers that often include holes or pouches for tools and equipment, and a flat surface on which the sail material is worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's benches"@en .

aat:300435016 a skos:Concept ;
    skos:definition "Tools used in sailmaking used to hold the canvas taught while sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's bench-hooks"@en .

aat:300435017 a skos:Concept ;
    skos:definition "Collections of tools and materials that are kept together in a receptacle for use by sailmakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's kits"@en .

aat:300435018 a skos:Concept ;
    skos:definition "Specialized hand-held tools designed for use in boating and sailing activities. Historically, these tools comprised a single pointed steel blade mounted on a wooden handle. Sailor's traditionally used these tools to rub light seams, carry out various cutting and chopping tasks, and eat or prepare meals while on board a ship. Modern sailmaker's knives, however, are designed to be increasingly versatile; these tools now often take the form of folding-knifes, equipped with multiple blades and additional tools including shackle openers and marlin spikes, amongst others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's knives"@en .

aat:300435019 a skos:Concept ;
    skos:definition "Triangular-sectioned and heavy guage needles with softened edges traditionally used for hand-sewing sails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's needles"@en .

aat:300435021 a skos:Concept ;
    skos:definition "Awl-like devices used in the fabrication of sails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's prickers"@en .

aat:300435022 a skos:Concept ;
    skos:definition "Hand tools used to make holes in the fabrication of sails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailmaker's punches"@en .

aat:300435025 a skos:Concept ;
    skos:definition "Collages made of shells and other marine materials, arranged to make particular patterns or designs. Commonly made in the 19th century by artisans on Barbados and other Carribean islands for sale in the tourist trade. Many of these were bought by trans-Atlantic sailors as souvenirs for their families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailor's valentines"@en .

aat:300435028 a skos:Concept ;
    skos:definition "Small cups or shallow bowls used for drinking the Japanese fermented rice wine called sake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sake cups"@en .

aat:300435032 a skos:Concept ;
    skos:definition "Utensils, usually designed as a pair of large spoons or forklike objects intended to grasp and serve salads onto plates while dining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salad servers"@en .

aat:300435034 a skos:Concept ;
    skos:definition "Devices used to dry lettuce leaves and other fruits or vegetables using centrifugal force. These consist of colanders that fit inside a larger container with a lid; the lid contains a mechanism that turns the colander."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salad spinners"@en .

aat:300435035 a skos:Concept ;
    skos:definition "Tongs designed specifically for serving salads often designed to have one end that is a scoop and another that resembles a fork, some are pivoted to open and close."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salad tongs"@en .

aat:300435036 a skos:Concept ;
    skos:definition "Devices used to dry wet lettuce leaves, consisting of a wire vessel with handles. Lettuce leaves are placed inside the vessel and shaken to remove water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salad washers"@en .

aat:300435052 a skos:Concept ;
    skos:definition "Vessels in which brine is allowed to evaporate, leaving behind salt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt pans"@en .

aat:300435053 a skos:Concept ;
    skos:definition "Utensils, often of wood, with deep cylidrical hollows to hold granular foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt scoops"@en .

aat:300435085 a skos:Concept ;
    skos:definition "Mechanized devices designed to blend bales of cotton or other fibers by passing layers of fibers through the device horizontally and removing them perpendicularly to produce a resulting homogenized fiber blend."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich blenders"@en .

aat:300435087 a skos:Concept ;
    skos:definition "Tongs designed for serving sandwiches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich tongs"@en .

aat:300435090 a skos:Concept ;
    skos:definition "Tools consisting of a straight blade, with or without hollows, and a handle, used in culinary applications. Santoku knives differ from chef's knives in that the straight edge of the blade only allows for a vertical chopping motion, whereas chef's knives feature a curved blade that can be rocked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "santoku knives"@en .

aat:300435091 a skos:Concept ;
    skos:definition "Vessels, usually consisting either of metal or of wooden staves affixed by a hoop to a flat wooden bottom, designed to be used in conjunction with a sap spout to collect sugar sap from maple trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sap buckets"@en .

aat:300435092 a skos:Concept ;
    skos:definition "Shallow vessels used to concentrate the sap obtained from maple trees into a syrup. Sap is boiled in the pan until the sap reaches the desired concentration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sap pans"@en .

aat:300435093 a skos:Concept ;
    skos:definition "Pipes with a tapered end which are driven into sugar-maple trees in order to draw their sap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sap spouts"@en .

aat:300435100 a skos:Concept ;
    skos:definition "Male security guards or soldiers (usually officers) of the guards or household troops of a royal or noble household."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guardsmen"@en .

aat:300435101 a skos:Concept ;
    skos:definition "Drinking glasses having a wide, flared bowl and stout, hollow stem. The glasses have a distinctive green or yellow color caused by iron impurities in the sand used for glass production. They were first introduced in 15th-century Germany and the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berkemeyers"@en .

aat:300435102 a skos:Concept ;
    skos:definition "The activity of exiting a water conveyance, particularly to go on shore from a boat or ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disembarkation"@en .

aat:300435103 a skos:Concept ;
    skos:definition "The sport or activity involving chasing or hunting game using a trained bird of the family Falconidae, usually a hawk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falconry"@en .

aat:300435104 a skos:Concept ;
    skos:definition "Those who engage in hunting with falcons or practice hawking as a sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falconers"@en .

aat:300435105 a skos:Concept ;
    skos:definition "Extinct species or subspecies of archaic humans in the genus Homo; taxonomic status is pending. Name derives from a specimen that belonged to a juvenile female found in the Denisova Cave in the Altai Mountains in Siberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homo denisova"@en .

aat:300435106 a skos:Concept ;
    skos:definition "Landscapes featuring primarily flat expanses of land into the distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat landscapes"@en .

aat:300435107 a skos:Concept ;
    skos:definition "Landscapes featuring views of the land adjacent to the sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal landscapes"@en .

aat:300435108 a skos:Concept ;
    skos:definition "The parts, activities, and duties held in life and society by a person or entity; includes significant roles or characteristics of a person or a function or purpose of a corporate body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roles"@en .

aat:300435109 a skos:Concept ;
    skos:definition "Designations that represent significant aspects of an administrative place or physical geographic place, including its role, function, political anatomy, size, or physical characteristics; may include references to culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place types"@en .

aat:300435110 a skos:Concept ;
    skos:definition "Landscapes featuring areas adjacent to a river."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riverine landscapes"@en .

aat:300435111 a skos:Concept ;
    skos:definition "Landscapes featuring areas of trees or woodlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wooded landscapes"@en .

aat:300435113 a skos:Concept ;
    skos:definition "Females having sexual attraction or sexual relations with other women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lesbians"@en .

aat:300435114 a skos:Concept ;
    skos:definition "Males having sexual attraction or sexual relations with other men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "male homosexuals"@en .

aat:300435115 a skos:Concept ;
    skos:definition "People having sexual attraction or sexual relations with others of the same sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homosexuals"@en .

aat:300435116 a skos:Concept ;
    skos:definition "People having sexual attraction or sexual relations with people of the opposite sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heterosexuals"@en .

aat:300435117 a skos:Concept ;
    skos:definition "Castrated people of the male sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eunuchs"@en .

aat:300435118 a skos:Concept ;
    skos:definition "In India and elsewhere in South Asia, this term may describe people who are intersex, androgynous, transgender, or who have been born male, but adopt a female gender identity. Hijra people may be considered non-binary, that is neither male nor female, not associating themselves with a specific sexual orientation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hijras"@en .

aat:300435119 a skos:Concept ;
    skos:definition "Artists who specialize in making altarpieces, which are painted or carved image-bearing objects set upon an altar in a Christian church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altarpiece artists"@en .

aat:300435120 a skos:Concept ;
    skos:definition "Artists who specialize in sculpting altarpieces, which are objects set on the altar in a Christian church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altarpiece sculptors"@en .

aat:300435121 a skos:Concept ;
    skos:definition "Those who specialize in the carpentry and making of the structure of altarpieces, which are objects set upon the altar of a Christian church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altarpiece makers"@en .

aat:300435123 a skos:Concept ;
    skos:definition "Discipline and activity of designing ornaments such as bracelets, necklaces, and rings for personal adornment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry design"@en .

aat:300435124 a skos:Concept ;
    skos:definition "The master builders who supervise construction in a city, town, or district."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal master builders"@en .

aat:300435125 a skos:Concept ;
    skos:definition "Architects serving as the primary, overseeing architect for a government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state architects"@en .

aat:300435126 a skos:Concept ;
    skos:definition "Subgroup of the Uto-Aztecan languages, now considered a division of the Corachol-Aztecan subgroup of Southern Uto-Aztecan (also called Sonoran). The Nahuan languages include Pochutec and Nahua (made up of Pipil and Nahuatl). The Nahuatl language has many dialects and is spoken throughout Mexico; the Mexican government, Ethnologue, and Glottolog, recognize up to 30 varieties of modern Nahuatl as distinct languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nahuan"@en .

aat:300435127 a skos:Concept ;
    skos:definition "Those who oversee the design and creation of the sets, that is the physical surroundings in which the action takes place, for films, television, or theater. For the broader role of overseeing the sets as well as other visual aspects of a production, prefer \"scenographers\" for theater productions or \"production designers\" for film and television productions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "set designers"@en .

aat:300435128 a skos:Concept ;
    skos:definition "The discipline and practice of designing and creating the sets, that is the physical surroundings in which the action takes place, for films, television, or theater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "set design"@en .

aat:300435129 a skos:Concept ;
    skos:definition "Those who oversee the art departments on films and television productions, including the design of sets, costumes, lighting, and makeup. For those who oversee the design of sets, costumes, etc. in the theater, use \"scenographers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "production designers"@en .

aat:300435130 a skos:Concept ;
    skos:definition "The discipline and practice that concerns the art departments on films and television productions, including the design of sets, costumes, lighting, and makeup. For the discipline concerning the design of sets, costumes, etc. in the theater, use \"scenography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "production design"@en .

aat:300435131 a skos:Concept ;
    skos:definition "Painters who specialize in painting scenery, backdrops, and illusions for the stage. May be reserved for historical roles, from the Renaissance through the 18th century, when separate artists were responsible for three-dimensional props and for the mechanical devices used in the performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theatrical painters"@en .

aat:300435132 a skos:Concept ;
    skos:definition "Woodworkers or carpenters specializing in fine art or otherwise exhibiting craftmanship of particularly high quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine woodworkers"@en .

aat:300435133 a skos:Concept ;
    skos:definition "The practice and activity of woodworking that results in the creation of fine art or otherwise exhibits craftmanship of particularly high quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine woodworking"@en .

aat:300435134 a skos:Concept ;
    skos:definition "Those who write, invent, promote, investigate or propound a theory or theories about the visual arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art theorists"@en .

aat:300435135 a skos:Concept ;
    skos:definition "Printmakers who specialize in the subject matter of architecture and architectural components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural printmakers"@en .

aat:300435136 a skos:Concept ;
    skos:definition "Painters who specialize in landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape painters"@en .

aat:300435137 a skos:Concept ;
    skos:definition "Managers of building projects who oversee the construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction managers"@en .

aat:300435138 a skos:Concept ;
    skos:definition "Officials, usually architects, who superintend building operations for a city, state, or project; typically used in historical connotations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masters of the works"@en .

aat:300435139 a skos:Concept ;
    skos:definition "Trained workers who work with and commonly lead a construction crew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction foremen"@en .

aat:300435140 a skos:Concept ;
    skos:definition "Artists who create art of the media, quality, and stature considered to be fine art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine artists"@en .

aat:300435141 a skos:Concept ;
    skos:definition "Officials charged with attending fairs and markets to carry out any or all of the following duties: to regulate the standard of weights and measures, to punish misdemeanors, to collect market dues, and to inspect the items displayed at the market. Typically relevant in historical contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clerks of the market"@en .

aat:300435142 a skos:Concept ;
    skos:definition "People or corporate bodies who own or run manufacturing plants for making furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture manufacturers"@en .

aat:300435143 a skos:Concept ;
    skos:definition "Photographers whose work is primarily art, not primarily documentary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic artists"@en .

aat:300435144 a skos:Concept ;
    skos:definition "Art in the medium of photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic art"@en .

aat:300435146 a skos:Concept ;
    skos:definition "Artists who specialized in gilding and painting, particularly those skilled in applying gold leaf and paint to sculpture over a gesso ground. Typically used in historical references."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fassmalers"@en .

aat:300435148 a skos:Concept ;
    skos:definition "Those who design ceramic objects, often in a studio or manufactory, working separately from those who execute the design and create the cermic works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramics designers"@en .

aat:300435149 a skos:Concept ;
    skos:definition "Collectors who specialize in acquiring fine art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art collectors"@en .

aat:300435150 a skos:Concept ;
    skos:definition "Photographers who specialize in architecture as subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural photographers"@en .

aat:300435151 a skos:Concept ;
    skos:definition "Specialization of photography focused on architecture as subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural photography"@en .

aat:300435152 a skos:Concept ;
    skos:definition "Those who create art works in the medium of cut paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut-paper artists"@en .

aat:300435153 a skos:Concept ;
    skos:definition "Sculpture that is relatively small in size, often small enough to be held in the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small sculpture"@en .

aat:300435154 a skos:Concept ;
    skos:definition "Those who specialize in portraits in the medium of paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portrait painters"@en .

aat:300435155 a skos:Concept ;
    skos:definition "Those who specialize in creating miniatures in the medium of paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature painters"@en .

aat:300435156 a skos:Concept ;
    skos:definition "Artists who specialze in carving depictions, whether in relief or in the round."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image carvers"@en .

aat:300435157 a skos:Concept ;
    skos:definition "Artists who specialize in designing or making tapestries, particularly tapestries containing depictions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry artists"@en .

aat:300435158 a skos:Concept ;
    skos:definition "Artisans who make artificial flowers, often in the media of silk or ceramic. For those who paint two-dimensional images of flowers, prefer \"flower painter.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower makers"@en .

aat:300435159 a skos:Concept ;
    skos:definition "Isolated areas forming natural refuges for plants and animals, including humans; may also include such refuges that are artificially designated and legally protected. Examples of natural refugia are areas to which living creatures moved during ice ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refugia"@en .

aat:300435160 a skos:Concept ;
    skos:definition "Artists involved in mapmaking, primarily in the addition of color or painted decorative elements, such as vegetation and sea creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "map painters"@en .

aat:300435161 a skos:Concept ;
    skos:definition "Metalworkers specializing in casting bronze, which is an alloy of copper with trace amounts of tin or zinc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze casters"@en .

aat:300435162 a skos:Concept ;
    skos:definition "Artists specializing in decorative illumination of letters, pictorial broadsides, and other documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter painters"@en .

aat:300435163 a skos:Concept ;
    skos:definition "Printmakers who specialize in illustrating and decorating books with engravings or other prints, or otherwise using printmaking techniques to decorate books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book printmakers"@en .

aat:300435164 a skos:Concept ;
    skos:definition "Those who specialize in shaping iron by cutting, using specialized tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron cutters"@en .

aat:300435166 a skos:Concept ;
    skos:definition "Painters who specialize in creating embellishments, adornments, or ornamentation, often specifically those that are temporarily put up on a stage, or for a holiday or another special occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative painters"@en .

aat:300435167 a skos:Concept ;
    skos:definition "Modern art tendency attributed to Daniel Spoerri, who opened the Eat Art Gallery in Dusseldorf in 1970. The gallery was dedicated to works made from food materials, or that represented the acts of serving or consuming food. Artists associated with this movement initially were Dieter Roth, Joseph Beuys, Richard Lindner, Ben, and the Nouveaux Réalistes Arman, César and Niki de Saint Phalle, and Spoerri himself, whose \"snare paintings\" consisted in the fixed remains of meals, presented as tableaus. The term has been applied to contemporary artists working in a similar mode."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eat Art"@en .

aat:300435168 a skos:Concept ;
    skos:definition "Artists who specialize in works created with edible materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edible art artists"@en .

aat:300435169 a skos:Concept ;
    skos:definition "Sculptors who create works in iron metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron sculptors"@en .

aat:300435170 a skos:Concept ;
    skos:definition "Painters who work in enamel as medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enamel painters"@en .

aat:300435171 a skos:Concept ;
    skos:definition "Painters who specialize in painting decorations, scenes, or figures on façades, particularly in historical contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "façade painters"@en .

aat:300435172 a skos:Concept ;
    skos:definition "People having the historical rank overseeing the artillery, particularly in German and the Austro-Hungarian armies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "generals of the artillery"@en .

aat:300435173 a skos:Concept ;
    skos:definition "Painters who paint human figures, whether as the primary subject of the painting or as subsidiary elements of the composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figure painters"@en .

aat:300435174 a skos:Concept ;
    skos:definition "Modelers who specialize in creating models of aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft modelers"@en .

aat:300435175 a skos:Concept ;
    skos:definition "Architects or engineers who specialize in designing fortresses; typically used in historical contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortress architects"@en .

aat:300435176 a skos:Concept ;
    skos:definition "Those who cut in relief the blocks that will be used in printing, engraving, or stamping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blockcutters"@en .

aat:300435177 a skos:Concept ;
    skos:definition "Poetry that is combined with images to create a completed work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture poetry"@en .

aat:300435178 a skos:Concept ;
    skos:definition "Works that can be expressed in a number of different media, in keeping with the paradigm of \"transmediality.\" Transmedial art may combine multiple disciplines or new media including Web portals and content, digital archives, social networks, blogs, or online games. Works of this type often intend to confuse the roles of participant, creator, and observer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmedial art"@en .

aat:300435179 a skos:Concept ;
    skos:definition "People who make themselves available to be engaged for work on particular assignments or projects, rather than being engaged on a long-term or permanent basis by a single employer. In original usage, referred specifically to military adventurers who offered services to states or individuals for payment, rather than fighting for their own lord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freelancers"@en .

aat:300435180 a skos:Concept ;
    skos:definition "Founders, casters, or makers of barrels and other metal parts for guns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun founders"@en .

aat:300435181 a skos:Concept ;
    skos:definition "Those who melt and pour glass into a mold; founders also do fusing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass founders"@en .

aat:300435182 a skos:Concept ;
    skos:definition "Workers who melt and pour metal into a mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal founders"@en .

aat:300435183 a skos:Concept ;
    skos:definition "Artists who use the medium of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass artists"@en .

aat:300435184 a skos:Concept ;
    skos:definition "Manufactories or others who manufacture glass in various forms or items made of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass manufacturers"@en .

aat:300435185 a skos:Concept ;
    skos:definition "Those who engrave or etch designs or patterns on glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass engravers"@en .

aat:300435186 a skos:Concept ;
    skos:definition "Those whose occupation is to grind and smooth glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass grinders"@en .

aat:300435187 a skos:Concept ;
    skos:definition "Tools or machinery used to grind and smooth glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass grinders"@en .

aat:300435188 a skos:Concept ;
    skos:definition "Those who make casts in the medium of plaster; examples are in creating stuccowork and casting forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaster casters"@en .

aat:300435189 a skos:Concept ;
    skos:definition "General term for people who specialize in working with gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold workers"@en .

aat:300435190 a skos:Concept ;
    skos:definition "General term for people who specialize in working with silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver workers"@en .

aat:300435191 a skos:Concept ;
    skos:definition "General term for people who specialize in working with the metal iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron workers"@en .

aat:300435192 a skos:Concept ;
    skos:definition "Craftspeople who specialize in making belts, girdles, and other items worn around the waist, as well as straps and other belt-like items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt makers"@en .

aat:300435193 a skos:Concept ;
    skos:definition "People having the profession or task of inspecting residential and commercial buildings during various stages of construction and remodeling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building commissioners"@en .

aat:300435194 a skos:Concept ;
    skos:definition "Building commissioner working in a noble or royal court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court building commissioners"@en .

aat:300435195 a skos:Concept ;
    skos:definition "Building commissioner working for the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church building commissioners"@en .

aat:300435196 a skos:Concept ;
    skos:definition "Sculptors in the service of a noble or royal court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court sculptors"@en .

aat:300435197 a skos:Concept ;
    skos:definition "Painters serving the personal requests of a ruler or other important person. Generally used to distinguish from \"court painters\" or other painters associated with the same court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal painters"@en .

aat:300435198 a skos:Concept ;
    skos:definition "Painters in the service of a royal or noble court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court painters"@en .

aat:300435200 a skos:Concept ;
    skos:definition "Makers of fine furniture and other woodwork in the service of a noble or royal court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court cabinetmakers"@en .

aat:300435201 a skos:Concept ;
    skos:definition "Photographers who work for an industrial company, taking photographs for its use, possibly including photographs of the products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial photographers"@en .

aat:300435202 a skos:Concept ;
    skos:definition "Painters specializing in scenes of the hunt and hunters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunt painters"@en .

aat:300435203 a skos:Concept ;
    skos:definition "Painters who work in service of the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church painters"@en .

aat:300435204 a skos:Concept ;
    skos:definition "A term referring to an artmaking practice or trend coined in the early 1990s. Context Art highlights the interaction between artists and social situations, and the formal, social, and ideological conditions of the artist's production, in contrast to the functions of traditional art. The term \"Kontext-Kunst\" was introduced by the Austrian curator Peter Weibel in an exhibition of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Context Art"@en .

aat:300435205 a skos:Concept ;
    skos:definition "Artists who specialize in making concept art, which is art that conveys the plan or idea of a project, such as in animation, films, video games, comic books, or other media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concept artists"@en .

aat:300435206 a skos:Concept ;
    skos:definition "Sets, which are assemblages of scenery, props, and lighting and sound systems, that are designed or used for films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film sets"@en .

aat:300435207 a skos:Concept ;
    skos:definition "Those who specialize in applying paint and gilding to sculpted or carved works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture painters"@en .

aat:300435208 a skos:Concept ;
    skos:definition "Artists who work in the medium of enamel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enamel artists"@en .

aat:300435209 a skos:Concept ;
    skos:definition "General term for orgainized groups whose members are artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist groups"@en .

aat:300435210 a skos:Concept ;
    skos:definition "Organizations of artists who have come together due to common a common cause or interests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist associations"@en .

aat:300435211 a skos:Concept ;
    skos:definition "Artisans who cut out and produce metal elements, usually for architecture, such as fittings, lattices, and gates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artisan fitters"@en .

aat:300435212 a skos:Concept ;
    skos:definition "Describes phenomena that are not media-specific or can be realized in a large number of media, such as literature, art, film, or music. Transmedial phenomena can occur with narrative or conceptual content in the form of myths, legends, or cultural symbols that have become part of common discourse and lost their connection to any specific medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmediality"@en .

aat:300435213 a skos:Concept ;
    skos:definition "Works that merge already known art forms to inaugurate a new type. If a resulting art form gains currency and acquires a name, it becomes a new medium and is no longer intermedial art. For works that employ several distinct art forms, such as sculpture and music, see \"multimedia works.\" To indicate that works are composed of a variety of materials, see \"mixed media.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermedial art"@en .

aat:300435214 a skos:Concept ;
    skos:definition "Paper on which music is written, typically ruled with the musical stave of five or more lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music paper"@en .

aat:300435215 a skos:Concept ;
    skos:definition "Buildings that house businesses that sell art, whether the merchandise is actually displayed in the shop or stored elsewhere, with images used to communicate with the buyers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art stores"@en .

aat:300435216 a skos:Concept ;
    skos:definition "Those who create art works in the medium of embroidery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art embroiderers"@en .

aat:300435217 a skos:Concept ;
    skos:definition "Those who engrave in the medium of steel, often printmakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel engravers"@en .

aat:300435218 a skos:Concept ;
    skos:definition "Painters who specialize in painting marine scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine painters"@en .

aat:300435219 a skos:Concept ;
    skos:definition "Artists who makes linocuts, which are prints from linoleum plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linocutters"@en .

aat:300435220 a skos:Concept ;
    skos:definition "Weavers whose work is considered art, rather than plain weaving, and may include embroidery or other needlework as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art weavers"@en .

aat:300435221 a skos:Concept ;
    skos:definition "Identification numbers assigned by the government to identify a property for the purpose of property taxes and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "AIN"@en .

aat:300435222 a skos:Concept ;
    skos:definition "Those having the position or role of master overseeing other draftsmen and recognized as being superior in the art of draftsmanship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawing masters"@en .

aat:300435223 a skos:Concept ;
    skos:definition "Early cinema genre that relied on the technology of the camera or editing techniques such as split-screen, stop-motion, double-exposure, or substitution shots as special effects to create surprising or seemingly magical tranformations onscreen. The genre was begun in the 19th century by Georges Méliès, the French showmen Émile and Vincent Isola, the British magicians David Devant and John Nevil Maskelyne, and the American cinematographers Billy Bitzer and James Stuart Blackton. The term is reserved for a genre of early cinema distinct from contemporary films that may also employ special effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trick film"@en .

aat:300435224 a skos:Concept ;
    skos:definition "The hard wood-like endocarps of a stone-fruit or drupe, enclosed by the pulpy pericarp, and enclosing the seed or kernel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pits"@en .

aat:300435225 a skos:Concept ;
    skos:definition "The hard wood-like endocarp of a cherry, the fruit of a cherry tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherry pits"@en .

aat:300435226 a skos:Concept ;
    skos:definition "People, usually creators, whose name is unknown, but whose identification in association with their works is known only by their initials, usually seen in signatures in monogram."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monogrammists"@en .

aat:300435227 a skos:Concept ;
    skos:definition "Practice and discipline of designing furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture design"@en .

aat:300435228 a skos:Concept ;
    skos:definition "People who make illustrations for printed materials, including newspapers and magazines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press draftsmen"@en .

aat:300435229 a skos:Concept ;
    skos:definition "Artists who specialize in depicting scenes in space, planetary bodies, space settlements, space vehicles, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space artists"@en .

aat:300435230 a skos:Concept ;
    skos:definition "Metalsmiths, the term meaning literally \"red smith\" in German. It has long been assumed that the color red referred to the metal, but an alternate theory suggests it refers to the method of casting metals using red molding loam, as opposed to yellow sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rothschmieds"@en .

aat:300435231 a skos:Concept ;
    skos:definition "General term for people who work skilfully with iron or other metals, making items by forging and hammering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smiths"@en .

aat:300435232 a skos:Concept ;
    skos:definition "Jewelers who create works considered to be art works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry artists"@en .

aat:300435233 a skos:Concept ;
    skos:definition "A genre of artmaking practice that exhibits any of various performative or theatrical aspects, with or without the artist's physical presence. Generally considered to be temporal, works within this genre may also be object-oriented, but incorporate a sense of time, situation, process, bodily presence, or theatricality, and that break down barriers between the plastic arts and traditional forms of theater or spectacle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Performative Art"@en .

aat:300435234 a skos:Concept ;
    skos:definition "Sculptors who use metal as a material, usually creating by casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal sculptors"@en .

aat:300435235 a skos:Concept ;
    skos:definition "Sculptors who use stone as a material, usually creating by a subtractive method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone sculptors"@en .

aat:300435236 a skos:Concept ;
    skos:definition "A genre of art that may incorporate concepts and research from mathematics, the physical sciences, biology, kinetics, telecommunications, or digital systems including computer coding. Works may be fashioned from pieces of found data or from archived and manipulated information. The final form of an information art work may or may not be a physical object, but one that incorporates some form of data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information art"@en .

aat:300435237 a skos:Concept ;
    skos:definition "Artists who make found object sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "object artists"@en .

aat:300435238 a skos:Concept ;
    skos:definition "Those who specialize in creating embellishments, adornments, or ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorators"@en .

aat:300435239 a skos:Concept ;
    skos:definition "Engravers who create plates depicting other works, from which it is intended to print reproductions in relatively large numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductions engravers"@en .

aat:300435240 a skos:Concept ;
    skos:definition "Early cinema works that relied on the technology of the camera or editing techniques such as split-screen, stop-motion, double-exposure, or substitution shots as special effects to create surprising or seemingly magical tranformations onscreen. These works first appeared in the late 19th century, created by Georges Méliès, the French showmen Émile and Vincent Isola, the British magicians David Devant and John Nevil Maskelyne, and later by American cinematographers Billy Bitzer and James Stuart Blackton. The term is reserved for a genre of early cinema distinct from contemporary films that may also employ special effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trick films"@en .

aat:300435241 a skos:Concept ;
    skos:definition "Those who etch on stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone etchers"@en .

aat:300435243 a skos:Concept ;
    skos:definition "Practice and discipline of designing textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile design"@en .

aat:300435244 a skos:Concept ;
    skos:definition "Artists who work in terracotta, but who are not exclusively potters. Examples are artists who make traditional plaques, dolls, and other items in Bangladesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terracotta artists"@en .

aat:300435245 a skos:Concept ;
    skos:definition "Architects who work on projects for the community, usually as contrasted to military projects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil architects"@en .

aat:300435246 a skos:Concept ;
    skos:definition "Architects who work on projects for the military, usually as contrasted to projects for the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military architects"@en .

aat:300435247 a skos:Concept ;
    skos:definition "Hereditary names shared by members of the same family, as distinct from a given names for the individual. In modern western culture, family names are usually the same as the \"last names.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "family names"@en .

aat:300435248 a skos:Concept ;
    skos:definition "In China, Korea, and elsewhere in Asia, names given to members of the same generation to distinguish them from adjacent generations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "generational names"@en .

aat:300435249 a skos:Concept ;
    skos:definition "General designation for the ethnicity, styles, culture, and heritage of people of sub-Saharan African origin or descent in places outside Africa, or of members of any dark-skinned group of peoples, including those of Australian Aboriginal origin or descent. Exceptions for usage include when black people are the majority in a particular country, unless they are treated or considered as a separate group, as was the case in South Africa under apartheid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black"@en .

aat:300435250 a skos:Concept ;
    skos:definition "A genre of art-making practice involved with electronic media such as video, robotics, computer coding, and digital media in general. The term new media has been in use since the 1960s when it was applied to any non-traditional medium, initially video, which then was newly available to artists. With the rapid expansion of digital technologies, the term has come to refer to art that is by its nature electronic or digital and not merely made with with recent technological techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "new media"@en .

aat:300435252 a skos:Concept ;
    skos:definition "Pseudonyms adopted by members of the Bentvueghels group, also called Schildersbent; it was a 17th-18th century association of mainly Dutch and Flemish artists living in Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bent-names"@en .

aat:300435254 a skos:Concept ;
    skos:definition "Holiday in Mexico, honoring dead loved ones and making peace with the eventuality of death. Also observed to a lesser extent in other areas of Latin America and in the United States. The holiday is derived from the rituals of the pre-Hispanic peoples of Mexico. Led by the goddess Mictecacihuatl, known as “Lady of the Dead,” the celebration lasted a month. After Christianity was established in Mexico, this feast was merged with All Souls' Day and All Saints Day on the Catholic calendar, November 1 and 2. An example of celebration is for families to adorn grave sites or altars with candles, marigolds, and the favorite foods of deceased relatives. Today, the festivities are often characterized by black humor. Toys and food, including breads and candies, are created in the shape of symbols of death such as skulls and skeletons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Day of the Dead"@en .

aat:300435255 a skos:Concept ;
    skos:definition "Periods when large areas of Earth were covered with ice; glacial episodes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice ages"@en .

aat:300435256 a skos:Concept ;
    skos:definition "Periods when the climate of Earth was warmer than average."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warming periods"@en .

aat:300435257 a skos:Concept ;
    skos:definition "Heads of figures, painted in the manner of portraits but representing types or historical figures; a compromise between portraiture and history painting; often focusing on the psychological state of the sitter. The genre was developed by Rembrandt and others in 17th-century Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tronies"@en .

aat:300435258 a skos:Concept ;
    skos:definition "Portraits of the donors of a work, depicted in the work depicting a narrative or other scene. The donors may be depicted as themselves, or they may take on the character of one of the actors in the narrative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "donor portraits"@en .

aat:300435259 a skos:Concept ;
    skos:definition "Genus containing around 50 species of annual herbs; native to southwestern North America, tropical America, and South America, but cultivated elsewhere. Noted for feathery foliage and flowers in various shades of yellow, orange, and maroon. It was regarded as the flower of the dead in pre-Hispanic Mexico, and is still widely used in the Day of the Dead celebrations. A few species are cultivated in Nepal, India, and Thailand, used in garlands and decoration for weddings, festivals, and religious events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tagetes"@en .

aat:300435260 a skos:Concept ;
    skos:definition "Genus containing 15-20 species of herbaceous plants, found in temperate regions of Eurasia and North Africa. Some species are grown especially for ornamental purposes, or are used in herbal products and cosmetics. The composite flower heads, borne singly, consist of yellow or orange ray flowers and central disk flowers; they can be yellow, red, or purple in color. The petal-like ray flowers are edible and are sometimes used in salads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calendula"@en .

aat:300435261 a skos:Concept ;
    skos:definition "Distinctive Mexican folk art sculptures of fantastical creatures, usually brightly colored and imade of wood or papier-mâche. Although inspired by elements of earlier Mexican-Spanish and indigenous art, the style of these works is attributed Pedro Linares, active In the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alebrijes"@en .

aat:300435262 a skos:Concept ;
    skos:definition "Refers to hairless dogs in Mexico, whether modern dogs or as seen in more ancient depictions. The xoloitzcuintli (xolo) is a breed of Mexican dog having pink or gray skin and very little hair except for a topknot and fuzz on its long tail; dogs with short coats also appear in many litters. The history of the breed is under discussion by experts. Domesticated dogs entered North America from Siberia over 9,000 years ago; some pre-European-contact dogs had an appearance similar to the modern xolo and were considered sacred by the Mexica, Toltecs, Maya, and other groups. However, in modern xolos, little to none of the older, indigenous dogs' DNA remains; modern xolos were probably descended from hairless Chinese or African dogs that were introduced by Spanish traders to Mexico in the late 16th century. In Mexico the breed is referred to as the \"Chinese dog\"; however, DNA analysis did not find a close genetic relationship between the xolo and the Chinese Crested Dog, which has a similar appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xoloitzcuintlis"@en .

aat:300435263 a skos:Concept ;
    skos:definition "Genus of large scallops that often have attractive, strongly colored, thick shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nodipecten"@en .

aat:300435264 a skos:Concept ;
    skos:definition "Species of large scallop that is native to the Pacific and Gulf coasts of California, the Baja California Peninsula, Mexico, down to the western coast of Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nodipecten subnodosus"@en .

aat:300435265 a skos:Concept ;
    skos:definition "Family of flowering plants having around 175 genera and over 2,500 species, mostly herbs and subshrubs, distributed nearly worldwide. A number of species, including beets and quinoa, are important food crops, and several are cultivated as garden ornamentals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amaranthaceae"@en .

aat:300435266 a skos:Concept ;
    skos:definition "Genus of edible and ornamental plants in the amaranth family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celosia"@en .

aat:300435267 a skos:Concept ;
    skos:definition "Representations of the human skull or skeleton, particularly as associated with the Mexican festival of the Day of the Dead. The possible media include caricatures or satirical drawings, three-dimensional decorative skulls or skeleton figures, or items of confectionery shaped to resemble a human skull."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calaveras"@en .

aat:300435268 a skos:Concept ;
    skos:definition "Satirical poems that critique or poke fun at living people, including personal acquaintances or political figures. Examples are found in the novel Don Quixote by Miguel de Cervantes and in popular culture associated with the Day of the Dead celebrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary calaveras"@en .

aat:300435269 a skos:Concept ;
    skos:definition "Works made from sugar or chocolate in the shapes of skulls and skeletons, for the Day of the Dead celebrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calaveras de azucar"@en .

aat:300435270 a skos:Concept ;
    skos:definition "Sugared breads or buns, particularly such breads known in Mexico and among Hispanic Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pan dulce"@en .

aat:300435271 a skos:Concept ;
    skos:definition "Pan dulce that is traditionally baked in Mexico for the Day of the Dead celebration and formed or decorated appropriately, such as with a crucifix or bone-shaped decorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pan de muerto"@en .

aat:300435272 a skos:Concept ;
    skos:definition "Altars upon which offerings for the dead are displayed in Mexico and related cultures, in homes or cemeteries, particularly for Day of the Dead celebrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ofrendas"@en .

aat:300435273 a skos:Concept ;
    skos:definition "Works of folk art made from sugar and other ingredients, of distinctive types and known in Mexico and elsewhere in Latin America and the United States. These types of works originated in sugar figures made for religious celebrations in Italy; they spread to Spain and in the Spanish colonies were enriched with indigenous art styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alfeñiques"@en .

aat:300435274 a skos:Concept ;
    skos:definition "Polished plates of copper on which a design is engraved or etched for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper plates"@en .

aat:300435275 a skos:Concept ;
    skos:definition "Printing plates created by using photosensitive material in sheet form, usually on plastic or metal. One process by which the plate is made is by exposing it to UV light through a negative film of the text or image to be printed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photopolymer plates"@en .

aat:300435276 a skos:Concept ;
    skos:definition "Correspondence expressing condolence on a bereavement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of condolence"@en .

aat:300435277 a skos:Concept ;
    skos:definition "Portable files for holding and organizing documents that expand via accordion-style folded sides. These appear in a variety of styles and materials, some with hard covers, latches or locks. Common contemporary versions are often made entirely of paperboard or reinforced paper. These may include dividers with or without indexing tabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expanding files"@en .

aat:300435278 a skos:Concept ;
    skos:definition "General term for legendary or mythical animals that combine features of multiple known animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite animals"@en .

aat:300435279 a skos:Concept ;
    skos:definition "Photographs that are valuable due to their actual or prospective rarity, often photographs distinguished by an early creation date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rare photographs"@en .

aat:300435282 a skos:Concept ;
    skos:definition "Printing or printmaking process for reproducing images or designs by passing ink or paint onto a surface through holes cut in a plate or screen. Stencils were known in China as early as the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencil printing"@en .

aat:300435283 a skos:Concept ;
    skos:definition "Prints made by using stencil printing, which employs plates or screens having holes to allow ink or paint to be pushed through to form a design or image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencil prints"@en .

aat:300435284 a skos:Concept ;
    skos:definition "Prints made from dimensional plates comprising assembled metal scraps, wire, mesh, and the like; coined by artist Rolf Nesch to describe his prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal prints"@en .

aat:300435285 a skos:Concept ;
    skos:definition "Relief prints made from surfaces upon which textures or objects have been attached. For collagraph prints that combine intaglio and relief, use the broader term \"collagraphs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collage relief prints"@en .

aat:300435286 a skos:Concept ;
    skos:definition "Intaglio prints made from surfaces upon which shapes, textures, etc. have been glued or otherwise attached. For collagraph prints that combine intaglio and relief, use the broader term \"collagraphs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collage intaglio prints"@en .

aat:300435287 a skos:Concept ;
    skos:definition "Refers to African people living in Côte d’Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuya"@en .

aat:300435288 a skos:Concept ;
    skos:definition "Deities who are the principal or most powerful gods in the pantheon of a religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supreme gods"@en .

aat:300435289 a skos:Concept ;
    skos:definition "Deities who are associated with a place, whether a natural place or an inhabited place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place gods"@en .

aat:300435290 a skos:Concept ;
    skos:definition "An aromatic, clear and colorless liquid that consists of benzene bearing a single hydroxymethyl substituent. It is partially soluble in water (4 g/100 mL) and completely miscible in alcohols and diethyl ether. It is a useful solvent due to its polarity, low toxicity, and low vapor pressure, for dyes, gelatin, casein, cellulose acetate, waxes, and shellac. Other uses include mounting microscope slides, and as a reagent in the developing baths for photographic films. In conservation, benzyl alcohol has been added to gelled soaps as a wetting agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benzyl alcohol"@en .

aat:300435291 a skos:Concept ;
    skos:definition "Any of the techniques of chemical ionization which takes place at atmospheric pressure used to evaporate solvent and ionize the compounds injected for mass spectrometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmospheric pressure chemical ionization"@en .

aat:300435292 a skos:Concept ;
    skos:definition "Polymers created by combining two separate monomers from the acrylic group, styrene acrylic and vinyl acetate-acrylic, for example."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic copolymers"@en .

aat:300435293 a skos:Concept ;
    skos:definition "Fruits of any of several plants of the genus Cucurbita that typically have a thick orange rind and are cooked as vegetables or used in sweet dishes, such as a pie filling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumpkins"@en .

aat:300435294 a skos:Concept ;
    skos:definition "In botany, underground plant structures consisting of a solid thickened portion or outgrowth of a stem or rhizome, of a more or less rounded form, and bearing ‘eyes’ or buds from which new plants may arise; a familiar example is the potato."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubers"@en .

aat:300435295 a skos:Concept ;
    skos:definition "The edible roots of Daucus carota; these roots are large, tapering, and in cultivation are bright orange-red, fleshy, and sweet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrots"@en .

aat:300435296 a skos:Concept ;
    skos:definition "Fruits of the species Lagenaria siceraria, hollowed out used for bowls and utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calabashes"@en .

aat:300435297 a skos:Concept ;
    skos:definition "Genus of herbaceous vines native to the Andes and Mesoamerica, known for gourd-like fruits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cucurbita"@en .

aat:300435298 a skos:Concept ;
    skos:definition "In the APG IV system (2016) for the classification of flowering plants, denotes a clade (a monophyletic group), common examples of which include the forget-me-nots, nightshades, and potatoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asterids"@en .

aat:300435299 a skos:Concept ;
    skos:definition "Order of flowering plants, containing some 5,489 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apiales"@en .

aat:300435300 a skos:Concept ;
    skos:definition "Family of flowering plants comprising between 300 and 400 genera of plants distributed principally in the north temperate regions. Most members are aromatic herbs with alternate, feather-divided leaves that are sheathed at the base. The flowers are often arranged in a conspicuous umbel (a flat-topped cluster of flowers). Many species are poisonous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apiaceae"@en .

aat:300435301 a skos:Concept ;
    skos:definition "Genus containing around 25 species of herbaceous plants found worldwide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daucus"@en .

aat:300435302 a skos:Concept ;
    skos:definition "A species of white, flowering plant in the family Apiaceae, native to temperate regions of Europe and southwest Asia, and naturalized to North America and Australia. Cultivated for its edible root."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daucus carota"@en .

aat:300435303 a skos:Concept ;
    skos:definition "Hair from any of the animals in the family of bovidae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bovine hair"@en .

aat:300435304 a skos:Concept ;
    skos:definition "Genus containing around 60 species native to the north temperate zone, including varieties cultivated for table fruit, dried to produce raisins, or crushed to make grape juice or wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitis"@en .

aat:300435305 a skos:Concept ;
    skos:definition "Starchy edible tubers of the Solanum genus, particularly Solanum tuberosum, native to the Peruvian-Bolivian Andes and cultivated among the world’s main food crops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potatoes"@en .

aat:300435306 a skos:Concept ;
    skos:definition "Genus of around 2,300 species of flowering plants. The common name \"nightshade\" is often associated with poisonous species, though the genus also contains a number of economically important food crops, including tomato (Solanum lycopersicum), potato (S. tuberosum), and eggplant (S. melongena)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solanum"@en .

aat:300435307 a skos:Concept ;
    skos:definition "Species of annual plant grown for its starchy edible tubers. The potato is native to the Peruvian-Bolivian Andes and is cultivated as one of the world’s main food crops. Potatoes are thought to have been independently domesticated several times and were largely cultivated in South America by the Incas as early as 1,800 years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solanum tuberosum"@en .

aat:300435308 a skos:Concept ;
    skos:definition "The principle, power, or agency by which, according to certain philosophical and popular systems of belief, all events, or some events in particular, are unalterably predetermined from eternity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fate"@en .

aat:300435309 a skos:Concept ;
    skos:definition "Group of around 3,000 species of aerial predatory insects most commonly found near freshwater habitats throughout most of the world. Dragonfly species (Anisoptera) are characterized by long bodies with two narrow pairs of intricately veined, membranous wings that, while generally transparent, may have colored markings. Unlike damselflies (suborder Zygoptera), the front and rear wing pairs are shaped differently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anisoptera"@en .

aat:300435310 a skos:Concept ;
    skos:definition "Group of around 2,600 species of predatory, aerial insects found mainly near shallow, freshwater habitats. They are graceful fliers with slender bodies and long, filmy, net-veined wings. Damselflies are generally smaller, more delicate, and fly weakly in comparison with dragonflies (suborder Anisoptera)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zygoptera"@en .

aat:300435311 a skos:Concept ;
    skos:definition "A belief system, doctrines, or principles of a group active the late 16th and 17th centuries. It was a religious reform movement that sought to “purify” the Church of England of remnants of the Roman Catholic “popery” that the Puritans claimed had been retained after the religious settlement reached early in the reign of Queen Elizabeth I. Puritanism included varied and sometimes mutually inconsistent forms of belief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Puritanism"@en .

aat:300435312 a skos:Concept ;
    skos:definition "Implements having a flat elongated form with various modifications of shape and size, used for a variety of purposes, such as mixing, stirring, spreading, lifting, or examining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spatulas"@en .

aat:300435315 a skos:Concept ;
    skos:definition "Very large folders that go inside the drawers in flat file cabinets, where large items, usually on paper, can be stored in a horizontal position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat file folders"@en .

aat:300435316 a skos:Concept ;
    skos:definition "Use for references to people whose names are unknown, although other information about the person's biography may be surmised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anonymous people"@en .

aat:300435317 a skos:Concept ;
    skos:definition "People who serve alcoholic beverages at a bar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bartenders"@en .

aat:300435318 a skos:Concept ;
    skos:definition "A butler is the chief male servant in a large household; primary responsibilities may include managing the wine cellar, overseeing dining arrangements, supervising other servants, and greeting visitors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butlers"@en .

aat:300435319 a skos:Concept ;
    skos:definition "Doctrinal concept concerning the spiritual departure from earthly life or the deification of a person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apotheosis"@en .

aat:300435320 a skos:Concept ;
    skos:definition "Those who live in a village, usually reserved for working-class inhabitants rather than the gentry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villagers"@en .

aat:300435321 a skos:Concept ;
    skos:definition "The social class comprising people of gentle birth and breeding, immediately below the nobility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentry"@en .

aat:300435322 a skos:Concept ;
    skos:definition "Configurations or positions of heavenly bodies relative to one another, particularly as seen from planet earth and as interpreted or named by various cultures through time. For example, a constellation may include a number of fixed stars and planets grouped together within the outline of an imaginary figure traced on the face of the sky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constellations"@en .

aat:300435323 a skos:Concept ;
    skos:definition "Genus containing one extant species of small Australian parrot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphicus"@en .

aat:300435324 a skos:Concept ;
    skos:definition "Species of small, gray Australian parrot. It has a yellow head, red ear patches, and a heavy beak used to crack nuts. The species is bred as a pet globally, with several established color mutations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphicus hollandicus"@en .

aat:300435325 a skos:Concept ;
    skos:definition "Stacks or large piles of hay built in the open air; often of regular form. For stacks of wheat intended to keep the grain dry prior to threshing, prefer \"wheatstacks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haystacks"@en .

aat:300435326 a skos:Concept ;
    skos:definition "The state or fact of being responsible for an action or event, or of failing to have carried out a duty, or of causing a delinquency, offense, crime, or sin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guilt"@en .

aat:300435327 a skos:Concept ;
    skos:definition "The act of charging or claiming that a person, group of people, or institution are involved in lawbreaking or wrongdoing, or guilty of a fault, crime, or offense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accusing"@en .

aat:300435328 a skos:Concept ;
    skos:definition "Light three-wheeled, hooded vehicles that serve as taxis. Originally found in southern and eastern Asia, now popular elsewhere. The form grew out of the rickshaw, which was pulled by men on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedicabs"@en .

aat:300435329 a skos:Concept ;
    skos:definition "General term for various styles of dance from north India, chiefly performed by professional dancing girls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nautch"@en .

aat:300435330 a skos:Concept ;
    skos:definition "Dancers, usually young females, who perform any of various styles of dance from north India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nautch dancers"@en .

aat:300435332 a skos:Concept ;
    skos:definition "Those who practice sorcery, which includes magic, enchantment, witchcraft, or other occult arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sorcerers"@en .

aat:300435334 a skos:Concept ;
    skos:definition "General term for a person, group of people, places, things, or concepts that are invented for a particular reason, but not identified or accepted in reality. In the context of art, an \"invented entity\" could refer to multiple creators that are known by a single pseudonym for a collective project or work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invented entities"@en .

aat:300435335 a skos:Concept ;
    skos:definition "Assumed characters or roles serving as secondary or alternative personalities of the original person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alter egos"@en .

aat:300435336 a skos:Concept ;
    skos:definition "Characters or figurative masks that performing artists, such as actors, writers, or singers, take on in order to perform. The persona may have a different name from the actual person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personas"@en .

aat:300435337 a skos:Concept ;
    skos:definition "Any of various frozen or solidified forms of substances (including water) that are liquid, gaseous, or volatile under normal conditions on earth; the term is used particularly in astronomy for such materials, which are present in the nuclei of comets, in planets, and in other celestial objects.Often used with a modifying word specifying the substance, such as ammonia ice, methane ice, water ice, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice"@en .

aat:300435338 a skos:Concept ;
    skos:definition "Term used in government classification systems for various minorities in China and Vietnam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yao"@en .

aat:300435340 a skos:Concept ;
    skos:definition "Refers to the original movement of young Austrian artists led by Gustav Klimt, who broke with the Künstlerhaus in 1897."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wiener Secession"@en .

aat:300435341 a skos:Concept ;
    skos:definition "Culture and ethnicity of the aboriginal people inhabiting the forest districts of Sri Lanka prior to the 6th century BCE. They adopted Sinhala and now no longer speak their own language. Ethnically, they are allied to the indigenous jungle peoples of southern India and to early populations in Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vedda"@en .

aat:300435343 a skos:Concept ;
    skos:definition "All existing matter, space, time, and energy regarded collectively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "universe"@en .

aat:300435345 a skos:Concept ;
    skos:definition "Disease caused in humans by infection with the bacterium Mycobacterium tuberculosis; characterized by the formation of tubercles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuberculosis"@en .

aat:300435347 a skos:Concept ;
    skos:definition "Actions or processes that stop respiration of a human or other living creature by compression of the air-passage, especially by a sudden and violent compression of the windpipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strangulations"@en .

aat:300435348 a skos:Concept ;
    skos:definition "Mass noun for the fruits or seeds of plants of the Oryza genus, forming one of the most important food grains of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice"@en .

aat:300435350 a skos:Concept ;
    skos:definition "Priests in the Shintō religion of Japan. The main function of the shinshoku is to officiate at all shrine ceremonies on behalf of and at the request of worshippers. He is not expected to lecture, preach, or act as spiritual leader to his parishioners; rather, his main role is to ensure the continuance of a satisfactory relationship between the kami (god or sacred power) and the worshipper through offerings, evocation of the kami, and mediation of the deity’s blessing to the parishioners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shinshoku"@en .

aat:300435353 a skos:Concept ;
    skos:definition "The pome fruit of a tree (genus Pyrus, especially P. communis) that typically has a pale green or brownish skin, a firm juicy flesh, and an oblong shape in which a broad base end tapers upward to a narrow stem end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pears"@en .

aat:300435355 a skos:Concept ;
    skos:definition "The avoidance of the use of violence, especially as a principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonviolence"@en .

aat:300435356 a skos:Concept ;
    skos:definition "Revolts or rebellions of a substantial number of soldiers, sailors, prisoners, or others against those under whose authority they are expected to serve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutinies"@en .

aat:300435358 a skos:Concept ;
    skos:definition "Genus of perennial plants of Eurasia, containing over 250 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aconitum"@en .

aat:300435360 a skos:Concept ;
    skos:definition "In South Asia, people having a particular title of high rank, especially a prince."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maharajas"@en .

aat:300435364 a skos:Concept ;
    skos:definition "Culture of the indigenous peoples of Sikkim and West Bengal in north-eastern India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lepcha"@en .

aat:300435366 a skos:Concept ;
    skos:definition "Japanese palanquin of basketwork slung on a pole and carried on the shoulders of bearers; type of litters used as a means of human transportation by the non-samurai class in feudal Japan and into the Meiji period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kagos"@en .

aat:300435370 a skos:Concept ;
    skos:definition "Groups of associates that band together or gather frequently through a shared interest or purpose. The term is often used pejoritively to denote sets of people regarded as disreputable, or who are expressly involved in crime. Some gangs, but not all, are formalized, have leadership structures, rules, and use common identifying symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gangs"@en .

aat:300435377 a skos:Concept ;
    skos:definition "A community is a body of people who live in the same place, usually sharing a common cultural or ethnic identity; may also include a body of people who do not necessarily live in the same place, but share common interests or backgrounds, and typically meet or communicate regarding these interests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communities"@en .

aat:300435378 a skos:Concept ;
    skos:definition "The routine interactions and activities experienced together by members of a family; may apply to people who live together for an extended period of time, even though they are not related as family members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "family life"@en .

aat:300435380 a skos:Concept ;
    skos:definition "A schistose metamorphic rock containing a high content of magnesium. An example of magnesian schist is serpentine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesian schist"@en .

aat:300435382 a skos:Concept ;
    skos:definition "Skill and diligence in working, often involving intellect, cleverness, ingenuity, exertion, and effort; the quality or practice of applying hard work or assiduity in the performance of a task."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industry"@en .

aat:300435384 a skos:Concept ;
    skos:definition "General term for mechanical devices for separating grain from the chaff; may be hand-operated or use another source of power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winnowing machines"@en .

aat:300435385 a skos:Concept ;
    skos:definition "Supports, usually comprising pairs of legs in an X-shaped configuration with a crossbeam; often used to support a log while being sawed or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawbucks"@en .

aat:300435386 a skos:Concept ;
    skos:definition "The right, action, or eligibility to cast a vote or votes in an election; includes the collective right of a group of people, such as the subset of a nation's citizens eligible to vote in a political election."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suffrage"@en .

aat:300435387 a skos:Concept ;
    skos:definition "The right of women by law to vote in national or local elections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "women's suffrage"@en .

aat:300435388 a skos:Concept ;
    skos:definition "Large siege engines used by the ancient Roman army for propelling rocks at an enemy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onagers"@en .

aat:300435389 a skos:Concept ;
    skos:definition "Racks for holding or storing sheet music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music racks"@en .

aat:300435390 a skos:Concept ;
    skos:definition "Stands attached to a piano, plain or ornately carved, used to hold sheet music upright for the pianist to see."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music desks"@en .

aat:300435391 a skos:Concept ;
    skos:definition "Snare drums carried by a person, for military or other marching purposes, usually held and played at the side of the player by a strap across the torso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side drums"@en .

aat:300435392 a skos:Concept ;
    skos:definition "Devices for watering lawns, crops, or recreation fields, for fire control, or for another purpose, where a flow of water is passed through holes in the device to spread water over a wide area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprinklers"@en .

aat:300435393 a skos:Concept ;
    skos:definition "Watercraft constructed or used for entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleasure craft"@en .

aat:300435394 a skos:Concept ;
    skos:definition "Wheel-type, special-format stereoscopes that work with View-Master thin, circular cardboard disks containing several stereoscopic pairs of small transparent color photographs on film; werre manufactured by Sawyer's, Inc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "View-Masters (TM)"@en .

aat:300435395 a skos:Concept ;
    skos:definition "Racks of various designs used to hang clothing, linen, or other household fabrics for drying or airing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drying racks"@en .

aat:300435396 a skos:Concept ;
    skos:definition "Barometers of the type in which the column of liquid in the tube has above it a body of confined air or other gas (instead of a vacuum as in the mercurial barometer), so that the pressure of the atmosphere acts against the weight of the liquid and the elastic pressure of the gas; a thermometer is attached for correction of the readings according to the expansion or contraction of the gas with changes of temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sympiesometers"@en .

aat:300435397 a skos:Concept ;
    skos:definition "Apparatuses used to slice cheese, typically comprising a board and an attached knife or wire for cutting the cheese. One example comprises a guillotine-style metal blade equipped with a wooden handle attached to a wooden turnstyle cutting block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese guillotines"@en .

aat:300435398 a skos:Concept ;
    skos:definition "Instruments consisting of a flat brass bar with sights at the ends and a circular brass box in the middle, containing a magnetic needle, which plays over a graduated circle; the whole being supported on a staff or tripod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circumferentors"@en .

aat:300435399 a skos:Concept ;
    skos:definition "Polariscopes of a particular type; instruments for measuring the degree of polarization, determining the amount of rotation of the plane of polarization by a substance through which polarized light passes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polarimeters"@en .

aat:300435400 a skos:Concept ;
    skos:definition "Aparatuses of various designs for slicing, chopping, or cutting vegetables or fruit. An example consists of a flat, rectangular piece of wood with raised edges on the upper surface; equipped with an angled slot inset with a metal blade in the middle and sometimes a handle at one end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable cutters"@en .

aat:300435401 a skos:Concept ;
    skos:definition "Diodes with a cylindrical anode surrounding a coaxial cathode in which the flow of current is controlled by a magnetic field applied parallel to the axis; and now usually designed to produce microwaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetrons"@en .

aat:300435402 a skos:Concept ;
    skos:definition "Rain gauges capable of measuring very small amounts of precipitation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ombrometers"@en .

aat:300435403 a skos:Concept ;
    skos:definition "Guages to measure solid precipitation composed of white or translucent ice crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow guages"@en .

aat:300435404 a skos:Concept ;
    skos:definition "Devices for measuring rain or moisture, usually reserved for simple devices having a clear tube for collection of the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "udometers"@en .

aat:300435405 a skos:Concept ;
    skos:definition "Tongs designed for serving steaks or other cuts of meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steak tongs"@en .

aat:300435406 a skos:Concept ;
    skos:definition "Cutting tools used in the dairy for cheesemaking, to process curd."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd cutters"@en .

aat:300435407 a skos:Concept ;
    skos:definition "Fork-like tools used in the dairy in cheesemaking to process curd."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd forks"@en .

aat:300435408 a skos:Concept ;
    skos:definition "Women's light dressing garments or negligée."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peignoirs"@en .

aat:300435409 a skos:Concept ;
    skos:definition "Small, light, horse-drawn vehicles used for short journeys or leisure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runabout carriages"@en .

aat:300435411 a skos:Concept ;
    skos:definition "Boards upon which one writes directly, usually of a size larger than handheld. For smaller board-like objects for writing, use \"writing tablets (writing equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing boards"@en .

aat:300435413 a skos:Concept ;
    skos:definition "Divisions, notes, or other areas of information in cataloging or other information recording configurations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "categories of information"@en .

aat:300435414 a skos:Concept ;
    skos:definition "The transcription or description of the content of the inscription, mark, or text, which includes the material or medium in which the inscription, mark, or text was executed; its support if it is on a separate piece affixed to the object; the method by which the inscription, mark, or text was produced; and a brief description of the content or appearance of the inscription or mark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inscription description"@en .

aat:300435415 a skos:Concept ;
    skos:definition "Miscellaneous notes or comments pertinent to information in a record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remarks"@en .

aat:300435416 a skos:Concept ;
    skos:definition "A textual description of the work or other entity, including a discussion of issues related to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "descriptive note"@en .

aat:300435417 a skos:Concept ;
    skos:definition "Note recording the abstract, a short description of the work or other entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abstract note"@en .

aat:300435418 a skos:Concept ;
    skos:definition "For art information, a brief statement indicating how the work came into the current or an earlier collection or how it came to be on view at the repository."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credit line"@en .

aat:300435419 a skos:Concept ;
    skos:definition "List, note, or other recording of the bibliography for a work or other entity's documentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliography"@en .

aat:300435420 a skos:Concept ;
    skos:definition "An identification or description of the mark type or name; marks are applied to the material or work, not inherent in the material. In the context of art information, an example would be a porcelain mark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mark description"@en .

aat:300435421 a skos:Concept ;
    skos:definition "A description of watermarks, which are marks inherent in or applied to the material before it was fashioned into the work, including watermarks and stationers' stamps or marks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watermarks description"@en .

aat:300435422 a skos:Concept ;
    skos:definition "A description of the the individual's or corporate body's nationality, professional roles, and dates, or other biographical information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display biography"@en .

aat:300435423 a skos:Concept ;
    skos:definition "References to bibliographic sources, unpublished documents, or individual opinions that provides the basis for the information recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citations"@en .

aat:300435424 a skos:Concept ;
    skos:definition "A description including the title or name of the exhibition, its location, and other pertinent information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibitions description"@en .

aat:300435425 a skos:Concept ;
    skos:definition "Prose description of the overall physical condition, characteristics, and completeness of a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condition/examination description"@en .

aat:300435426 a skos:Concept ;
    skos:definition "An expression of the value of the work or entity, including currency and amount."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valuation note"@en .

aat:300435427 a skos:Concept ;
    skos:definition "A description or quotation regarding the merit or significance of a particular work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "critical comment"@en .

aat:300435428 a skos:Concept ;
    skos:definition "A description of the political, social, economic, or religious events or circumstances associated with the work over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical/cultural context"@en .

aat:300435429 a skos:Concept ;
    skos:definition "An indication of the substances or materials used in the creation of a work, as well as any implements, production or manufacturing techniques, processes, or methods incorporated in its fabrication, presented in a syntax suitable for display to the end-user and including any necessary indications of uncertainty, ambiguity, and nuance. For works on paper, descriptions of watermarks may also be included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "materials/technique description"@en .

aat:300435430 a skos:Concept ;
    skos:definition "Information about the dimensions, size, or scale of the work, presented in a syntax suitable for display to the end-user and including any necessary indications of uncertainty, ambiguity, and nuance. It may include the scale of the work. It may also include the number of the parts of a complex work, series, or collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimensions description"@en .

aat:300435431 a skos:Concept ;
    skos:definition "An indication of the tribe, band, ethnic group, linguistic group, cultural group, civilization, religious group, nation, country, city-state, continent, or general region from which the work originated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culture note"@en .

aat:300435432 a skos:Concept ;
    skos:definition "A prose description of the salient characteristics of a work in relation to a particular style, historical period, group, school, or movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "styles/periods description"@en .

aat:300435433 a skos:Concept ;
    skos:definition "The language of the catalog record or other information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "language"@en .

aat:300435434 a skos:Concept ;
    skos:definition "A formal statement of the copyright or licensing of a work, and/or any restrictions placed on it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copyright/licensing statement"@en .

aat:300435435 a skos:Concept ;
    skos:definition "A description of the specific edition to which a work belongs, whether expressed as a fractional number or as a name or expression of the context related to prior or later issuances ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edition description"@en .

aat:300435436 a skos:Concept ;
    skos:definition "A prose description of the process, manner, or style in which a thing is made, including the materials and workmanship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facture description"@en .

aat:300435437 a skos:Concept ;
    skos:definition "The process, manner, or style in which a thing is made, including the materials with which it is made and workmanship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facture"@en .

aat:300435438 a skos:Concept ;
    skos:definition "The prose description of the provenance or history of the owners or others in possession of a work of art or other property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provenance description"@en .

aat:300435439 a skos:Concept ;
    skos:definition "The prose description of the most recent acquistion of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acquisition description"@en .

aat:300435440 a skos:Concept ;
    skos:definition "A statement about the way the text is paginated, or the page range of the thing within a larger text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pagination description"@en .

aat:300435441 a skos:Concept ;
    skos:definition "A statement about the way the text is paginated, or the page range of the thing within a larger text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foliation description"@en .

aat:300435442 a skos:Concept ;
    skos:definition "An indication of the level of cataloging represented by the record, based on the physical form or intellectual content of the material, such as item, group, volume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalog level"@en .

aat:300435443 a skos:Concept ;
    skos:definition "The kind of object or work described, e.g., painting, book, cathedral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "object/work type"@en .

aat:300435444 a skos:Concept ;
    skos:definition "Indication of the placement of a work of art or architecture within a classification scheme that groups other, similar works together on the basis of similar characteristics"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classification"@en .

aat:300435445 a skos:Concept ;
    skos:definition "The titles or names given to a work of art, architecture, or group, as well as the type of title, and the dates when the title was valid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titles/names"@en .

aat:300435446 a skos:Concept ;
    skos:definition "Note containing the name, brief biographical information, and roles (if necessary) of the named or anonymous individuals or corporate bodies responsible for the design, production, manufacture, or alteration of the work, presented in a syntax suitable for display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creator description"@en .

aat:300435447 a skos:Concept ;
    skos:definition "A concise description of the date or range of dates associated with the creation, design, production, presentation, performance, construction, or alteration of the work or its components, presented in a syntax suitable for display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creation date description"@en .

aat:300435448 a skos:Concept ;
    skos:definition "A concise description of the location where the creation, design, or production of the work or its components took place, or the original location of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creation place description"@en .

aat:300435449 a skos:Concept ;
    skos:definition "A description of the current or last known location of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "current location description"@en .

aat:300435450 a skos:Concept ;
    skos:definition "A description of the subjects depicted in, on, or by the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject display"@en .

aat:300435451 a skos:Concept ;
    skos:definition "A description of the way the work of art is meant to be seen or has been displayed. For the arrangement of archival materials, prefer \"arrangement description.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orientation/arrangement description"@en .

aat:300435452 a skos:Concept ;
    skos:definition "Description of salient aspects of the physical appearance of the work and its decoration, including design elements and pattern names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical description"@en .

aat:300435453 a skos:Concept ;
    skos:definition "The art of folding paper into objects or designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper folding"@en .

aat:300435454 a skos:Concept ;
    skos:definition "The art of folding paper into objects or designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper cutting"@en .

aat:300435455 a skos:Concept ;
    skos:definition "Japanese art of paper cutting to create stencils, using awls, punches, and small knives. In the traditional Japanese craft of katagami, paper stencils are carved by master artisans for use in decorating textiles. Documented since at least the sixteenth century, the technique developed out of methods originally devised for embellishing leather armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "katagami"@en .

aat:300435456 a skos:Concept ;
    skos:definition "Works created by folding special paper, using a traditional Japanese art form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "origami"@en .

aat:300435457 a skos:Concept ;
    skos:definition "Paper stencils, created by a traditional Japanese method; used primarily to stencil on fabric, but the cut paper itself may be considered an art work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "katagami"@en .

aat:300435458 a skos:Concept ;
    skos:definition "Artists who specialize in creating art that incorporates movement, particularly mobiles or similar works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinetic artists"@en .

aat:300435459 a skos:Concept ;
    skos:definition "Creators who specialize in designing typeface, or who utilize typeface as a primary subject of their works; often associated with printing designers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typeface artists"@en .

aat:300435460 a skos:Concept ;
    skos:definition "Albums in which excerpted verse, drawings, pressed flowers, and other items were added; particularly such albums popular in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verse albums"@en .

aat:300435461 a skos:Concept ;
    skos:definition "Blank books in which two-dimensional souvenirs, photographs, sketches, hair ribbons, pressed flowers, silhouettes, cuttings from magazines, or other items are pasted for preservation, in remembrance of events or for other reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memory books"@en .

aat:300435462 a skos:Concept ;
    skos:definition "Indonesian religious structures based on an Indianized shrine with a pyramidal tower. This was the essential form on which virtually all the stone Indianizing architecture of Southeast Asia was originally based. The Javanese, like the Khmer, evolved an elaborate architecture of their own around the basic Indian prototype."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candis"@en .

aat:300435463 a skos:Concept ;
    skos:definition "DVD discs on which data can be stored and which is designed to be used as read-only memory. These have been used to distribute software applications that exceed the capacity of a CD-ROM disc. DVD-ROM discs are read in DVD-ROM and DVD-RAM drives in computers, but typically not in DVD drives connected to TVs and home theater systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DVD-ROMs"@en .

aat:300435464 a skos:Concept ;
    skos:definition "A type of composite material consisting of carbon fiber suspended in a polymer. The carbon fiber provides strength, while the polymer acts as cohesive matrix to hold the fibers. CFRP is manufactured as a variety of forms, with various techniques including filament winding, pultrusion, and hand lay-up processes. CFRP materials possess good rigidity, high strength, low density, corrosion resistance, vibration resistance, high ultimate strain, high fatigue resistance, and low thermal conductivity. They are bad conductors of electricity and are non-magnetic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon reinforced polymer"@en .

aat:300435468 a skos:Concept ;
    skos:definition "Genus of edible, herbivorous gastropod mollusks, having around 100 or more species, depending upon the classification system. The shell is valued for its iridescent nacre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haliotis"@en .

aat:300435469 a skos:Concept ;
    skos:definition "Material derived from any of three species of large New Zealand abalone with blue-green inner shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pāua"@en .

aat:300435470 a skos:Concept ;
    skos:definition "Family of birds from New Zealand. Although called \"crows,\" they are not corvids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Callaeatidae"@en .

aat:300435471 a skos:Concept ;
    skos:definition "Genus containing one species of recently extinct New Zealand bird. The last living birds were seen in the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heteralocha"@en .

aat:300435472 a skos:Concept ;
    skos:definition "Fine Maori cloaks having two or more taniko borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaitaka huaki"@en .

aat:300435473 a skos:Concept ;
    skos:definition "Fine Maori cloaks having taniko borders, but also vertical rows of pattern or color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaitaka paepaeroa"@en .

aat:300435474 a skos:Concept ;
    skos:definition "A unique Māori technique of twining; characterized by having two groups of threads – the aho (weft, or horizontal threads) and the whenu (warp, or vertical threads). The threads are usually made from muka (flax fibre). From a basic warp and weft base, the weaver builds a cloak, row by row, in a meticulous process that can take months or years to complete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whatu"@en .

aat:300435478 a skos:Concept ;
    skos:definition "Genus containing up to 2,000 species of shrubs, llanas, and herbs, the number varies depending upon the classification system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Piper"@en .

aat:300435479 a skos:Concept ;
    skos:definition "Maori baskets or bags woven with distinctive patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kete whakairo"@en .

aat:300435480 a skos:Concept ;
    skos:definition "Genus comprising up to 200 species of plants, many climbers; found throughout the tropics and subtropics of South Asia and the western Pacific Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Freycinetia"@en .

aat:300435481 a skos:Concept ;
    skos:definition "Carved heads without bodies in Maori art. The heads are often carved in a relatively realistic manner. They may be affixed to the gable of a house or a canoe. For carved heads that are less realistic, having fierce expression, bulbous eyes, etc., use \"koruru.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parata"@en .

aat:300435482 a skos:Concept ;
    skos:definition "Genus of shrubs and small trees, primarily endemic to Australia, New Zealand, and Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leptospermum"@en .

aat:300435483 a skos:Concept ;
    skos:definition "Long timber threshhold for a pātaka storehouse. By observing the carved ornamentation and decoration on a pataka threshhold, visitors to a tribe would be able to ascertain the chief’s capacity to provide for his people and, therefore, the tribe’s capacity and strength to protect and fend for itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paepae pataka"@en .

aat:300435487 a skos:Concept ;
    skos:definition "Genus of conifers distributed in Africa, Australia, Centeral and South America, and the South Pacific."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Podocarpus"@en .

aat:300435488 a skos:Concept ;
    skos:definition "Woven traps used to catch fish or eels. Hinaki would be baited and placed with the current in a river. The targeted fish would enter the inverted hole at one end and become trapped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinaki"@en .

aat:300435489 a skos:Concept ;
    skos:definition "Food material made by emulsifying vegetable oils or animal fats with water or milk, originally as a butter substitute, used as a spread and as a cooking fat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "margarine"@en .

aat:300435493 a skos:Concept ;
    skos:definition "Implements or machines for planting or for sowing seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planters"@en .

aat:300435498 a skos:Concept ;
    skos:definition "General term for places where pigs are kept or bred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piggeries"@en .

aat:300435499 a skos:Concept ;
    skos:definition "Pens in which pigs are enclosed or housed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigpens"@en .

aat:300435500 a skos:Concept ;
    skos:definition "First Nations and Native American confederation of five principal nations: the Mi'kmaq, Maliseet, Passamaquoddy, Abenaki, and Penobscot,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wabanaki"@en .

aat:300435501 a skos:Concept ;
    skos:definition "Historical unit of measurement in France and other places, prior to the adoption of the metric system in the late 18th century. Equal to 1/12 pouce, another historical French measurement. In modern systems, equal to 2.2558 mm or .0881 inch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lignes"@en .

aat:300435502 a skos:Concept ;
    skos:definition "Historical unit of measurement meaning a \"thumb\"; used in France and other places, prior to the adoption of the metric system in the late 18th century. French units of measurement were based on the Carolingian system, in turn were based on ancient Roman measures. Equal to 12 lignes in the old French measurement system. In modern systems, equal to around 27.07 mm or 1.066 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pouces"@en .

aat:300435503 a skos:Concept ;
    skos:definition "Historical unit of measurement in France and other places, prior to the adoption of the metric system in the late 18th century. French units of measurement were based on the Carolingian system, in turn were based on ancient Roman measures. Equal to around 32.48 cm or around 1.066 feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pieds"@en .

aat:300435504 a skos:Concept ;
    skos:definition "Culture of an Algonquian tribe that was historically considered to be a part of the Delaware, or Lenape, although they lived separately from the Delaware nation for most of their existence. Some scholars argue that the Munsee should not be considered Delaware because of some stark differences in dialect. The United States referred to the Munsees as a separate tribe in the Treaty of Fort Industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Munsee"@en .

aat:300435505 a skos:Concept ;
    skos:definition "Refers to the cultures of peoples indigenous to areas of the United States and Canada, the members of which are culturally related and include the Odawa, Saulteaux, Ojibwe, Potawatomi, Anishininew, and Algonquin peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anishinaabe"@en .

aat:300435506 a skos:Concept ;
    skos:definition "Culture of an Algonquian indigenous tribe in the Commonwealth of Virginia, located on land granted to the tribe by an act of the Virginia General Assembly in 1658."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mattaponi"@en .

aat:300435509 a skos:Concept ;
    skos:definition "In animal husbandry, buildings or enclosures for maintaining flocks of domestic fowl laying hens, usually chickens; may contain nests, lighting, roosting space, waterers, and feed troughs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laying houses"@en .

aat:300435512 a skos:Concept ;
    skos:definition "Brand name of reusable plastic zipper storage bags and containers; developed by Dow Chemical Company in 1968; manufactured by S. C. Johnson & Son."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ziploc (TM)"@en .

aat:300435514 a skos:Concept ;
    skos:definition "Earlier iterations of ironing boards that existed in table form, originally patented in 1858. Improved design occurred in the 1890s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironing tables"@en .

aat:300435520 a skos:Concept ;
    skos:definition "Instruments used for observing motion or measuring vibration frequency, by means of flashes of periodic, interrupted light from a stroboscopic lamp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stroboscopes"@en .

aat:300435524 a skos:Concept ;
    skos:definition "Gravity powered drop hammers with boards that are engaged by contrarotating friction rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board hammers"@en .

aat:300435525 a skos:Concept ;
    skos:definition "Bits with a flat cutting edge used for cutting metal (and other material) and large-hole boring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat bits"@en .

aat:300435527 a skos:Concept ;
    skos:definition "Tools, usually made of steel, used for sharpening knives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife sharpeners"@en .

aat:300435529 a skos:Concept ;
    skos:definition "Hammers that are fixed on an angle, usually used in forging, and operated by cam-wheels which alternately tilt the hammers upward and let them drop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilt hammers"@en .

aat:300435533 a skos:Concept ;
    skos:definition "Trombones that operate with a slide mechanism, as opposed to a valve mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slide trombones"@en .

aat:300435536 a skos:Concept ;
    skos:definition "To provide with headquarters in a specified location, to base an organization, group, etc. in a particular place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headquartering"@en .

aat:300435537 a skos:Concept ;
    skos:definition "Principal or central places of residence, meeting, or business; the centers of operations, the managerial and administrative centers of organizations, districts, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headquarters"@en .

aat:300435557 a skos:Concept ;
    skos:definition "General term for items or materials that were used as money, but were not representative of actual currencies. Examples are ingots of gold or copper, which were carried from place to place in Bronze Age Europe, the owner using a chisel to remove a bit of the metal to buy goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proto-currencies"@en .

aat:300435558 a skos:Concept ;
    skos:definition "The rate at which the position of something changes. It is a vector quantity, taking into account direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velocity"@en .

aat:300435562 a skos:Concept ;
    skos:definition "United States and British imperial customary units of speed comprising the number of statute miles traveled in one hour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miles per hour"@en .

aat:300435565 a skos:Concept ;
    skos:definition "Unit of speed and velocity, comprising distance in feet traveled or displaced, divided by the time in seconds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feet per second"@en .

aat:300435566 a skos:Concept ;
    skos:definition "A preparation or extract of the root of an aconite (genus Aconitum), used as a drug or as a poison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aconitum"@en .

aat:300435572 a skos:Concept ;
    skos:definition "Acts that are forbidden by law, or the omission of duties that are required by law, which make the offender liable to punishment by that law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crimes"@en .

aat:300435573 a skos:Concept ;
    skos:definition "The crime of a human being illegally killing one or more other human beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homicide"@en .

aat:300435575 a skos:Concept ;
    skos:definition "Genus containing 12 species of plants native to woodland and scrub in Europe and Asia, and widely cultivated in temperate areas globally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syringa"@en .

aat:300435576 a skos:Concept ;
    skos:definition "Family of flowering plants containing 3 genera and around 25 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bixaceae"@en .

aat:300435577 a skos:Concept ;
    skos:definition "Genus of plants native to Mexico, Central America, Caribbean, and South America, and naturalized in other places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bixa"@en .

aat:300435580 a skos:Concept ;
    skos:definition "Family of herbaceous, mainly perennial and bulbous flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amaryllidaceae"@en .

aat:300435583 a skos:Concept ;
    skos:definition "Family of flowering plants comprising 18 genera and 655 species, and concentrated in the temperate region of the New World. The family is characterized by flowers with parts mostly on the plan of four (four sepals, four petals, four or eight stamens), but there are some exceptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Onagraceae"@en .

aat:300435584 a skos:Concept ;
    skos:definition "Genus of onion- or garlic-scented bulbous herbs of the amaryllis family (Amaryllidaceae); species are found in most regions of the world except the tropics and New Zealand and Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Allium"@en .

aat:300435585 a skos:Concept ;
    skos:definition "Family containing around 52 genera and 700 species of flowering plants including perennial herbs, trees, vines, and succulents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Araliaceae"@en .

aat:300435586 a skos:Concept ;
    skos:definition "Genus containing around 400 species of annual or perennial (rarely biennial) flowering plants, distributed worldwide in temperate and alpine regions, especially in Europe and Asia, North and South America, and New Zealand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gentiana"@en .

aat:300435594 a skos:Concept ;
    skos:definition "The status of belonging or subject to no one political state or regime, without a political state or home base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stateless"@en .

aat:300435595 a skos:Concept ;
    skos:definition "Promises by one party to make a gift or gifts to another party at some future time. To be legally enforceable, a promised gift requires three elements: donative intent, delivery, and acceptance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promised gift"@en .

aat:300435599 a skos:Concept ;
    skos:definition "Gratuitous grants or transfers of property that have been promised, but as of yet are not delivered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promised gifts"@en .

aat:300435600 a skos:Concept ;
    skos:definition "Species of aromatic herb cultivated for its pungent leaves; native to the Mediterranean region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salvia officinalis"@en .

aat:300435602 a skos:Concept ;
    skos:definition "Genus of flowering plant native to Asia-Tropical, Africa, Pacific, Queensland and Asia-Temperate.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ventilago"@en .

aat:300435603 a skos:Concept ;
    skos:definition "Genus of monoecious herbs or undershrubs, native to Europe, Africa, and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chrozophora"@en .

aat:300435604 a skos:Concept ;
    skos:definition "Genus containing two species of large shrubs or small trees, native to the warm temperate northern hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cotinus"@en .

aat:300435605 a skos:Concept ;
    skos:definition "Family of flowering plants containing around 52 genera and more than 1,300 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zingiberaceae"@en .

aat:300435606 a skos:Concept ;
    skos:definition "Genus of around 100 species of flowering plants native to Southeast Asia, southern China, the Indian Subcontinent, New Guinea, and northern Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Curcuma"@en .

aat:300435607 a skos:Concept ;
    skos:definition "Genus containing around 20 species in the legume family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glycyrrhiza"@en .

aat:300435608 a skos:Concept ;
    skos:definition "Species of flowering plant native to southeastern Europe and adjacent parts of Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glycyrrhiza echinata"@en .

aat:300435609 a skos:Concept ;
    skos:definition "Regular occupations, professions, or businesses, especially skilled manual occupations involving manual labor or the buying and selling of goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trades"@en .

aat:300435610 a skos:Concept ;
    skos:definition "Pieces of work or activities concerning work done, emphasizing the activity rather than the profession, although jobs are done as part of one's regular profession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jobs"@en .

aat:300435611 a skos:Concept ;
    skos:definition "Occupations or professions seen as a way of life or course of action, which a person feels that it is his or her duty or destiny to follow or for which he or she feels particularly suited. Included are religious occupations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocations"@en .

aat:300435628 a skos:Concept ;
    skos:definition "Chairs, often reclining, for use outdoors in garden areas or on lawns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lawn chairs"@en .

aat:300435639 a skos:Concept ;
    skos:definition "A distinct type of load-bearing construction material consisting of an assemblage of masonry units generally made of stone, brick, or concrete blocks laid in a specific pattern and joined together with mortar and that does not contain any reinforcing elements, such as steel rods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unreinforced masonry"@en .

aat:300435653 a skos:Concept ;
    skos:definition "Makers of distinctive clothing worn and ornaments. Examples are Native American artists who make regalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regalia makers"@en .

aat:300435654 a skos:Concept ;
    skos:definition "Creators of an indegenous American art form using the bark of the birch tree. In one example, the artist will bite on small pieces of folded birch bark to form intricate designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birchbark artists"@en .

aat:300435655 a skos:Concept ;
    skos:definition "Ground utilizing gold leaf, upon which painting is applied. The ground is usually for a wooden panel or parchment support; gold leaf is applied directly to the underlying surface or on a primary ground support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold ground"@en .

aat:300435658 a skos:Concept ;
    skos:definition "Culture of a First Nations band government in the Canadian province of British Columbia; the only First Nations band within the boundaries of the City of Vancouver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musqueam"@en .

aat:300435659 a skos:Concept ;
    skos:definition "Style or culture of a Native North American tribe located in Washington State."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tulalip"@en .

aat:300435660 a skos:Concept ;
    skos:definition "Otoe and Missourias were known to live in the Nebraska region in the mid-19th century. Now located in Oklahoma; traditionally spoke Chiwere, of the Siouan language family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otoe-Missouria"@en .

aat:300435662 a skos:Concept ;
    skos:definition "Native American people of Louisiana; today the Houma people are recognized as \"The United Houma Nation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Houma"@en .

aat:300435679 a skos:Concept ;
    skos:definition "In the US, sites that are eligible for inclusion in the National Register because of their association with cultural practices or beliefs of a living community that are rooted in that community's history, and are important in maintaining the continuing cultural identity of the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traditional cultural properties"@en .

aat:300435684 a skos:Concept ;
    skos:definition "Dialect of Aramaic spoken in Palmyra until the 3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palmyrene"@en .

aat:300435686 a skos:Concept ;
    skos:definition "Strings of characters that uniquely identify a location on the internet or other network to which email can be sent; the email address is typically a point of contact for a particular individual or organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "email addresses"@en .

aat:300435687 a skos:Concept ;
    skos:definition "Addresses, not necessarily street addresses of the home or workplace, to which mail for a particular person, family, or corporate body is to be sent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mailing addresses"@en .

aat:300435688 a skos:Concept ;
    skos:definition "Identifying numbers assigned to a telephone or group of telephones; the numbers are dialled in order to make a connection to telephonic devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephone numbers"@en .

aat:300435689 a skos:Concept ;
    skos:definition "Phone numbers connected to a fax machine, fax service, or fax server, rather than to a voice telephonic device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fax numbers"@en .

aat:300435690 a skos:Concept ;
    skos:definition "Designations for locations, either physical or virtual, where a person, corporate body, physical object, Web site, or other thing may be contacted or found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "addresses"@en .

aat:300435691 a skos:Concept ;
    skos:definition "Theoretical models of systems in any discipline, constructed using a graphed network of relationships between concepts, used to represent a subject. These may be textual or physical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conceptual models"@en .

aat:300435692 a skos:Concept ;
    skos:definition "Machines designed to scan printed textual and graphic material and then transmit the information through the telephone network to similar machines, where facsimiles are reproduced close to the form of the original documents. Most office and home fax machines conform to the Group 3 standard, which was adopted in 1980 in order to ensure the compatibility of digital machines operating through public telephone systems worldwide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fax machines"@en .

aat:300435693 a skos:Concept ;
    skos:definition "Numbers that uniquely identify each computer on the internet. A computer’s IP address may be permanently assigned or supplied each time that it connects to the Internet by an internet service provider."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "IP addresses"@en .

aat:300435694 a skos:Concept ;
    skos:definition "Machines that knead and/or form dough or pastry into sheets of consistent thickness between horizontal steel rollers. These devices have been made in two forms: simple and return; the second is able to reverse the motion. The distance between rollers is reduced to bring the dough to a desired thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough brakes"@en .

aat:300435695 a skos:Concept ;
    skos:definition "Devices intended for compounding the ingredients of bread or cracker dough; used especially with reference to cylindrical containers with kneading paddles or blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough mixers"@en .

aat:300435698 a skos:Concept ;
    skos:definition "Style and culture that developed in Cyprus ca. 750–450 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypro-Archaic"@en .

aat:300435699 a skos:Concept ;
    skos:definition "Style and culture in Cyprus ca. 480-310 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypro-Classical"@en .

aat:300435700 a skos:Concept ;
    skos:definition "Style and culture of Cyprus dating ca. 1050-750 BCE; particularly used with reference to pottery style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypro-Geometric"@en .

aat:300435702 a skos:Concept ;
    skos:definition "Devices designed to dry leafy herbs and other plants, usually consisting of single or stacked trays with bottoms made of mesh or screen to allow for air flow. These are often designed to be suspended from a support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herb dryers"@en .

aat:300435704 a skos:Concept ;
    skos:definition "Numbers or codes that uniquely identify a record or entity within a given area of a system. Such numbers are typically system-generated; the values may comprise sequential numbers or codes algorithmically constructed. A goal may be to ensure uniqueness across multiple systems, such as UUID or GUID."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record identifiers"@en .

aat:300435706 a skos:Concept ;
    skos:definition "Currency of Austria and Liechtenstein between 1919 and 1925; from after the dissolution of the Austro-Hungarian Empire until the introduction of the Schilling and the Franken, respectively. Intended to replace the Austro-Hungarian Krone, it was prone to hyperinflation and was replaced by the Austrian Schilling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austrian Kronen"@en .

aat:300435707 a skos:Concept ;
    skos:definition "Currency of the Austro-Hungarian Empire between 1892 and 1919, when it was succeeded by the Austrian Krone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austro-Hungarian Kronen"@en .

aat:300435719 a skos:Concept ;
    skos:definition "Names that were used for an entity in the past, but are now no longer used; may include personal names, corporate body names, place names, or other names. For titles or names of works of art or architecture, prefer \"former titles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former names"@en .

aat:300435720 a skos:Concept ;
    skos:definition "Words or phrases used to add context or meaning to another word, phrase, item of data, or other information; usually comprises an adjective or adverb. For the data element used in thesaurus construction, use \"qualifiers (thesaurus indicators).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qualifiers"@en .

aat:300435721 a skos:Concept ;
    skos:definition "In cataloging and similar contexts, an indication that a fact or data is less than certain, but recognized as likely to be true. Indicates a level of certainty greater than \"possibly.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "probably"@en .

aat:300435722 a skos:Concept ;
    skos:definition "In cataloging and similar contexts, an indication that a fact or data is less than certain, but recognized as within the range of possibility. Indicates a level of certainty less than \"probably.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "possibly"@en .

aat:300435723 a skos:Concept ;
    skos:definition "In cataloging and similar contexts, an indication that a fact or data, usually a date, is less than certain, but recognized as within close proximity to the date as stated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circa"@en .

aat:300435733 a skos:Concept ;
    skos:definition "Designs constructed of curved, black lines and secondary thinner lines, characteristic of Northwest Coast Native North American works. May appear in sculpture, painting, or prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formlines"@en .

aat:300435734 a skos:Concept ;
    skos:definition "Style of design that is constructed from formlines, characteristic of Northwest Coast Native North American works. This style may appear in sculpture, painting, or prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formline style"@en .

aat:300435735 a skos:Concept ;
    skos:definition "Describes a mid 20th-century visual style developed by students and instructors at Bacone College in Muscogee, Oklahoma. This style may appear in painting, prints, and drawings and often features flat, two-dimensional subjects with bold, colorful outlines. Considered a successor to the Kiowa style of painting practiced by the Kiowa Six artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bacone style"@en .

aat:300435736 a skos:Concept ;
    skos:definition "Describes a style of painting popularized by a group of Kiowa artists in the early 20th century. Uses flat, two-dimensional figures with colorful outlines and little-to-no background imagery. Artists popularizing the style include Jack Hokeah, Monroe Tsatoke, Spencer Asah, James Auchiah, Stephen Mopope, and Lois Smoky Kaulaity. Considered the predecessor to Bacone style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kiowa style"@en .

aat:300435737 a skos:Concept ;
    skos:definition "Circular objects, often made of stone or clay, used in the game chunkey. Chunkey stones have been found in late Woodland, Mississippian, and historic Native North American mounds, towns, and burial sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chunkey stones"@en .

aat:300435738 a skos:Concept ;
    skos:definition "A game played by Late Woodland, Mississippian, and historic Native North American people; it is thought to have originated at the Cahokia site in Illinois. The game consists of a chunkey stone, rolled on the ground, a clay playing field, and a set of throwing sticks, which are thrown at the stone. Points are tallied based on the position of the sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chunkey"@en .

aat:300435739 a skos:Concept ;
    skos:definition "Beads, usually manufactured from conch shell or animal bone, commonly worn by Plains Native people from the 1800s to present. Used as components for breastplates, bracelets, and hair ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair pipes"@en .

aat:300435740 a skos:Concept ;
    skos:definition "Describes a type of dance that is often performed at powwows across North America. Unlike other powwow dances, intertribals are open to all dancers and powwow participants and vary in types of songs, drums, and regalia used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intertribals"@en .

aat:300435741 a skos:Concept ;
    skos:definition "Groups of stacked stones or boulders in a figural form, constructed by Inuit individuals. Inuksuit are constructed to act as waypoints, message centers, spiritual veneration, or as hunting decoys. The oldest inuksuit date from 2400 to 1800 years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inuksuit"@en .

aat:300435742 a skos:Concept ;
    skos:definition "Layered stitches used in Native North American bead and quillwork. Stitches are constructed of several beads or quills threaded together and then sewn into a row. Commonly used on animal hide and cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lane stitches"@en .

aat:300435743 a skos:Concept ;
    skos:definition "Stitches commonly used in Native North American beadwork. Formed by stringing successive rows of beads one at a time, usually around another object such as a fan or gourd rattle. Often used on beadwork for fans and rattles used in Native American Church ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peyote stitches"@en .

aat:300435744 a skos:Concept ;
    skos:definition "Spherical seed beads, often made of glass and usually no bigger than 1/8th inches in diameter. Commonly used in Native North American beadwork; were brought to North America by European traders in the 18th to 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pony beads"@en .

aat:300435745 a skos:Concept ;
    skos:definition "Long-sleeved shirts decorated with silk ribbons on the front and sleeves, commonly worn by Native North American men. Often worn at powwows and other important events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon shirts"@en .

aat:300435747 a skos:Concept ;
    skos:definition "Decorative metal cones, made from sheet metals, historically often from chewing tobacco lids, used on jingle dresses for both decoration and sonic accompaniment in traditional dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jingles"@en .

aat:300435748 a skos:Concept ;
    skos:definition "Describes a dance performed at powwows, originating in Anishinaabe/Ojibwe communities in the late 19th to early 20th centuries. The dance is now performed at powwow events across Native North America. Largely performed by young women wearing specialized regalia, the dance consists of bouncing footwork and careful turns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jingle dances"@en .

aat:300435749 a skos:Concept ;
    skos:definition "Defined as an energetic ceremonial dance performed at Native North American powwows by men. Possibly has origins in the Omaha Oska society dance and the Pawnee iruska dance. Dancers typically wear regalia with long fringes and feathered roaches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grass dances"@en .

aat:300435750 a skos:Concept ;
    skos:definition "Defines a ceremonial dance performed by Native North American women, usually at powwows. Colorful, fringed shawls are the focus of this fast-paced dance. Was popularized in the mid 20th century, as a counterpart to the male Fancy Dance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy shawl dances"@en .

aat:300438364 a skos:Concept ;
    skos:definition "Cloth or velvet bags usually richly decorated with beadwork, made distinctive by its bottom terminating in eight separate arms. Created by Métis and First Nations communities to carry ammunition, fire starters, and/or tobacco. Likely originated in the early 1800s amongst the Métis and spread to other Native North Americans across Canada and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire bags"@en .

aat:300438365 a skos:Concept ;
    skos:definition "Trade beads, often made of Czech glass, commonly used in Native North American beadwork. Usually no larger than 7 mm in diameter. Seed beads are still used in contemporary Native beadwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seed beads"@en .

aat:300438366 a skos:Concept ;
    skos:definition "The curved, tooth-like shell of the dentalium mollusk, native to waters around British Columbia. Used as jewelry and as decoration for Native North American clothing; prior to the 20th century, also used as currency amongst California and Northwest Coast Native people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dentalium"@en .

aat:300438368 a skos:Concept ;
    skos:definition "Bags made from an otter pelt, preserving the features of the animal as the bag's shape. The tail and paws of the otter pelt are often decorated with quillwork or beadwork. Used by Native North Americans that are part of the Midewiwin medicine society to hold medicinal plants and other ceremonial items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "otter bags"@en .

aat:300438369 a skos:Concept ;
    skos:definition "Blankets comprising a cloth or velvet covering with cloth ties on the underside made to cover the front and sides of a dog's body. Usually richly decorated in floral beadwork and cloth fringe, with bells placed along the center cut of the blanket. Used to protect sled dogs and to herald the sled's arrival. Originated with the Métis and later spread to Athabaskan communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog blankets"@en .

aat:300438370 a skos:Concept ;
    skos:definition "A method for lifting and removing large or fragile objects or groups of objects from archaeological excavations by surrounding them with rigid foam or other supporting materials. The block often incorporates some of the surrounding soil, which lends extra support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block lifting"@en .

aat:300438371 a skos:Concept ;
    skos:definition "Dance often performed at powwows by Native North Americans, consisting of manipulating several wooden or plastic hoops that encircle the dancer's body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoop dances"@en .

aat:300438372 a skos:Concept ;
    skos:definition "Treatment of items with similar preservation/conservation problems using standardized materials and techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass treatment"@en .

aat:300438373 a skos:Concept ;
    skos:definition "Organizations and associations dedicated to the preservation and conservation of cultural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation organizations"@en .

aat:300438374 a skos:Concept ;
    skos:definition "Blankets woven by Chilkat Tlingit communities, usually made of mountain goat wool and cedar bark. Blankets are usually comprised of black, white, yellow, and blue ovoid shapes. figures, and lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chilkat blankets"@en .

aat:300438375 a skos:Concept ;
    skos:definition "Elaborate shawls worn by Native North American women, decorated with beadwork, ribbonwork, fringes, and/or metal jingles. Used for the Fancy Shawl Dance performed at powwow gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy shawls"@en .

aat:300438376 a skos:Concept ;
    skos:definition "Figurative masks, made from gourds or wood such as buckeye. Used by Cherokees in the Booger Dance, the mask covers the entire face. Figures carved include European settlers, the devil, or other Native North American people. Animal fur and paint often embellish the features of the mask."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booger masks"@en .

aat:300438377 a skos:Concept ;
    skos:definition "Describes a masked dance performance conducted by Cherokee people, particularly in North Carolina Cherokee communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booger dances"@en .

aat:300438378 a skos:Concept ;
    skos:definition "Describes a series of dances performed at Native North American powwows. While the schedules and type of dances performed change based on the host nation, most powwows consist of a set of core dances: Traditional/Straight Dance, Grass Dance, Fancy Dance, Jingle Dress Dance, Fancy Shawl Dance, and intertribals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powwow dances"@en .

aat:300438379 a skos:Concept ;
    skos:definition "Social and ceremonial gatherings practiced across Native North American communities. While powwows vary across setting and community, most powwows consist of a Grand Entry, which introduces veterans, and a series of powwow-specific dances, such as the Grass Dance or Fancy Shawl Dance. Term is derived from the Eastern Algonquin word \"pahwayaw\" or \"pau wau\" for a gathering or ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powwows"@en .

aat:300438380 a skos:Concept ;
    skos:definition "Ceremonial headdresses commonly constructed from glass beads and dentalium, held together with rawhide or thread. Historically worn by high-status Alaska Native women and girls, especially in Yup'ik and Aluutiq communities. Consists of a beaded cap and a train of beads and/or dentalium. In contemporary society, Alaska Native women wear nacat at important ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nacat"@en .

aat:300438384 a skos:Concept ;
    skos:definition "Overshirts with hood and front pocket for one's hands, often made of cloth or animal skin and intestine. Worn and made by Alaska Native communities"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuspuks"@en .

aat:300438385 a skos:Concept ;
    skos:definition "Pictorial records of events kept by Lakota and other Plains Native tribes, usually on a yearly cycle. Primarily painted on buffalo hides. Some of the earliest winter counts date from the 1600s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter counts"@en .

aat:300438386 a skos:Concept ;
    skos:definition "Describes a type of dance characterized by elaborately decorated regalia, including feathered bustles and roaches, and fast-paced movements. Commonly performed at powwows by Native North American men. Popularized at powwow events in the 1960s, though has origins in 19th century Plains dances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy dances"@en .

aat:300438388 a skos:Concept ;
    skos:definition "Native North American dancers, usually male, that perform fancy dances at powwow events and other ceremonies. Dancers are defined by their elaborately colored and decorated regalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy dancers"@en .

aat:300438389 a skos:Concept ;
    skos:definition "Defined as a dance performed at Native North American powwows, primarily by men. The dance consists of movements and steps close to the ground to mimic hunting or tracking movements. Likely originated in the 19th century from the Omaha Dance performed by Omaha, Ponca, Kaw, Kiowa, and Pawnee communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traditional dances"@en .

aat:300438392 a skos:Concept ;
    skos:definition "Cotton or wool dresses worn by Southwest Native North American women, primarily Navajo and Pueblo (Hopi, Zuni) communities. Often richly embroidered along the hem of the dress. Used in ceremonies such as the Basket Dance and the Butterfly Dance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantas"@en .

aat:300438393 a skos:Concept ;
    skos:definition "Wooden, conical-shaped hats and visor, often made of bentwood and decorated with ivory carvings and feathers. Used to conceal one's head while hunting. Made and used by Yup'ik and other Alaska Natives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elqiat"@en .

aat:300438396 a skos:Concept ;
    skos:definition "Describes a dance performed by Southeastern Native North American communities during the Green Corn Ceremony, including the Cherokees, Creeks, and Seminoles. The dance was performed frequently up until the late 19th century, with revivals occurring in the contemporary period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green corn dances"@en .

aat:300438400 a skos:Concept ;
    skos:definition "Headdresses worn by Hopi young women and girls during the Butterfly Dance. Usually made of wood and decorated in vivid colors with designs representative of the wearer's clan and sometimes their dance partner's clan. Can also be seen carved on katsinam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kopatsoki"@en .

aat:300438424 a skos:Concept ;
    skos:definition "Ceremonial ball game played by Southeastern Native North American tribes. Players utilize two long, wooden rackets to either hit a single wooden post or pass through two posts with a ball; scoring and team size vary across communities. Has origins in the Mississippian period and continues to be played by Cherokee, Choctaw, and other Southeastern tribes in the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stickball"@en .

aat:300438425 a skos:Concept ;
    skos:definition "Defines a ceremonial dance performed by Southeastern Native North American tribes, including Cherokee, Chickasaw, Yuchi, and Creek (Mvskoke) communities. Often performed as part of the Green Corn Dance, but can also be interspersed throughout other ceremonies. Consists of dancers who follow a lead dancer in a circular motion around a fire. Dancers' motions are often accompanied by turtle shell shakers worn at the ankles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stomp dances"@en .

aat:300438426 a skos:Concept ;
    skos:definition "Decorated, trapezoidal pieces of copper made by Northwest Coast Native North American tribes. Usually formed into two curved rectangular pieces visually joined by a raised T-shaped border in the middle of the piece; some coppers have thin, rectangular additions on one side. Usually decorated with clan crests by incision or repoussé. Historically were created as markers of status or for giving through potlatch ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coppers"@en .

aat:300438427 a skos:Concept ;
    skos:definition "Baked foods made by lining shallow dishes with pastry and filling this with a sweet or savory filling. The filling is often finished with a pastry crust on top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pies"@en .

aat:300438428 a skos:Concept ;
    skos:definition "Children deprived by death of one or usually both parents. The term is sometimes extended to children who are abandoned or unsupported by living parents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orphans"@en .

aat:300438430 a skos:Concept ;
    skos:definition "The state of being under the influence of an alcoholic liquor to the extent that it affects self-control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drunkenness"@en .

aat:300438431 a skos:Concept ;
    skos:definition "In printmaking, proofs used for testing a particular state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state proofs"@en .

aat:300438432 a skos:Concept ;
    skos:definition "In printmaking, proofs pulled at various stages of the process, to test various aspects of the print during creation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "progress proofs"@en .

aat:300438433 a skos:Concept ;
    skos:definition "Indicators describing the status of the item described or of the record itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "status notes"@en .

aat:300438434 a skos:Concept ;
    skos:definition "Discrete sections or texts found or entered in an itemized work, such as an account book, record, database, dictionary, encyclopedia, catalogue, index, or other such work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entries"@en .

aat:300438435 a skos:Concept ;
    skos:definition "Cloth dresses typically worn by Native North American women from the Plateau region (including Yakama, Cayuse, and Umatilla communities, amongst others.) Derived from pre-contact buckskin dresses, wingdresses today are usually made from cotton fabric, sometimes decorated with florals. Sleeves are cut to drape over the arms, mimicking the form of a bird's wing. Usually worn for various ceremonies, such as the Fancy Shawl Dance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wingdresses"@en .

aat:300438436 a skos:Concept ;
    skos:definition "Long, cloth skirts, often ankle-length, decorated with brightly colored ribbons. Primarily worn by Native North American women as everyday wear and as ceremonial garments. Ribbons are usually sewn in parallel bands near the hem, either overlapping or with thin margins between each ribbon. Likely developed from ribbonwork created by Native women during the 18th-19th centuries with French trade silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon skirts"@en .

aat:300438437 a skos:Concept ;
    skos:definition "Ceremionial cloth coats, usually made of dark wool and decorated with iconographical beadwork on the front, back, and sleeves of the garment. Imagery often includes cedar trees, buffalo skulls, and horses, representing ceremonial objects used by followers of William Faw Faw, an Otoe-Missouria spiritual leader. Made and worn by Faw Faw adherents in the late 19th and early 20th centuries in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faw faw coats"@en .

aat:300438438 a skos:Concept ;
    skos:definition "Process of weaving using one's hands without the use of a loom, joining lengthwise and sideways threads together. One end of the strands are pinned to a stable surface by a bar or nail. Primarily practiced by Native North Americans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger weaving"@en .

aat:300438439 a skos:Concept ;
    skos:definition "Fingerwoven sashes worn by Métis and First Nations individuals. Also known as assumption sashes due to their production in L'Assomption, Québec in the 19th century. Patterning varies, but often features an arrowhead design using red, green, yellow, blue, and white colored yarns. Currently, the sash has become a symbol of Métis identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceintures fléchés"@en .

aat:300438440 a skos:Concept ;
    skos:definition "Decorative beaded objects made by Native North American women, particularly in Haudenosaunee communities. Popular with tourists from the 18th to early 20th centuries. Commonly came in the form of beaded pillows, pincushions, or wall ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whimsies"@en .

aat:300438441 a skos:Concept ;
    skos:definition "Containers that feature quillwork as a primary motif; created primarily by Native North Americans for personal use, for the tourist trade, and for art markets. Derived from pre-contact storage and personal containers. A prominent feature of Great Lakes Native art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quill boxes"@en .

aat:300438442 a skos:Concept ;
    skos:definition "Made of ivory or metal, sometimes embellished with incised decorations of animals such as bears or seagulls. Made by Yup'ik families for their female children. Using the knife to draw in various surfaces, Yup'ik girls retell important histories, share personal experiences, or sing songs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "story knives"@en .

aat:300438443 a skos:Concept ;
    skos:definition "Carrying cases used for storing and transporting tobacco and smoking pipes; commonly made and used by Plains Native North Americans. Due to tobacco's importance in many Native North American ceremonies, pipe bags are considered a spiritually charged object. Often held in one's left hand instead of being attached to the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe bags"@en .

aat:300438444 a skos:Concept ;
    skos:definition "Cloth covering attached to Native North American cradleboards, often decorated with floral or iconographic beadwork. Designed to hold babies to the cradleboard; moss is usually placed in the bottom of the bag to cushion the baby and act as a diaper. Name is derived from this moss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moss bags"@en .

aat:300438445 a skos:Concept ;
    skos:definition "Words used as a distinctive mark, such as a trademark. An example is the Getty square, designed by Saul Bass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wordmarks"@en .

aat:300438446 a skos:Concept ;
    skos:definition "Rattles, occurring in pairs and worn around the ankles; usually made of box-turtle shells but tin cans or milk cartons are also used. Affixed in dense clusters so the shells frequently shake and collide with each other. Worn by Southeast Native North Americans, such as the Chickasaw, Cherokee, and Yuchi, usually during stomp dances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell shakers"@en .

aat:300438447 a skos:Concept ;
    skos:definition "Style of painting characterized by its use of Anishinaabe iconography, x-ray views of animal and human anatomy, thick black outlines of figures, and the use of bright primary colors. Popularized by Norval Morriseau, an artist from the Sand Point Ojibwe reserve, who derived the style's visual language from his community's cultural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Woodlands School"@en .

aat:300438448 a skos:Concept ;
    skos:definition "Headdresses worn by Haudenosaunee men, consisting of a structure of wood and leather fitted to the head with a variety of feathers attached to the top. Haudenosaunee Confederacy members arrange these feathers differently to represent their specific community. For example, Seneca men have one feather pointing upwards from the rest of the assemblage. Sometimes a band of beads or wampum is also included across the brow of the headdress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gustoweh"@en .

aat:300438449 a skos:Concept ;
    skos:definition "Masks that contain one or more ancillary masks inside the former, usually through interior panels or separate halves. Wearers use strings and levers to open up these other masks when performing. Commonly made and performed by Native Northwest Coast communities at various events such as potlatches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transformation masks"@en .

aat:300438450 a skos:Concept ;
    skos:definition "Dances particular to one or more Native American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native American dances"@en .

aat:300438451 a skos:Concept ;
    skos:definition "Dance performed by the Chickasaw, Koasati, Yuchi, and other Southeastern Native North American tribes. Likely originated with the Chickasaw, the dance is often performed in conjunction with Green Corn Dances. In some cases, garfish teeth are used in a purification rite during the dance, while in other variations dancers carry garfish effigies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garfish dances"@en .

aat:300438452 a skos:Concept ;
    skos:definition "Containers, often made of animal hide or fabric such as yarn, used to carry materials necessary for religious ceremonies. Commonly used in Native North American traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine bags"@en .

aat:300438453 a skos:Concept ;
    skos:definition "System of belief of the Anishinaabe and other Great Lakes Native North American communities, commonly practiced in the pre-contact and historic periods. Declined in the 19th century by colonial pressures to convert to Christianity; resurged in the 20th century. The religion incorporates a structure of networked spiritual societies, initation rites, and community healing services. Ceremonies and rites are sourced from the spirit and culture hero Nanabozho."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Midewiwin"@en .

aat:300438456 a skos:Concept ;
    skos:definition "Religious movement originating from William Faw Faw (Waw-No-She) (c. 1854-1924), an Otoe-Missouria prophet; became popular amongst Native North Americans in Oklahoma in the late 19th century to the early 20th century. With a focus on returning back to Native lifeways, adherents would enact complex dances and ceremonies, as well as wearing heavily decorated regalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Faw Faw"@en .

aat:300438457 a skos:Concept ;
    skos:definition "Wooden containers, usually made of birch bark and sewn together with basswood bast, made to store maple sugar. Particularly made and used by Anishinaabe, Potawatomi, and other Great Lakes Native North American tribes. Sometimes decorated with quillwork, braided sweetgrass, or incised designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mococks"@en .

aat:300438458 a skos:Concept ;
    skos:definition "Containers, usually made of animal hide, made by Native North Americans to store tobacco. Often decorated with quillwork, beadwork, and sometimes pigment. Designs typically refer to cosmological or spiritual themes, as tobacco is a central aspect of many Native religious traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco bags"@en .

aat:300438459 a skos:Concept ;
    skos:definition "Cultural gathering practiced by Northwest Coast Native Americans that commemorates the lives of deceased clan members; historically has referred to any kind of potlach ceremony but in contemporary usage refers specifically to memorial services. Gift giving and speeches are a central feature of the event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ḵu.éexʼ"@en .

aat:300438460 a skos:Concept ;
    skos:definition "Spiritual clowns that perform during Puebloan ceremonies in the American Southwest; performers provide humor, personify important spirits, and teach cultural values through their dances. Often dressed in distinctive black-and-white striped clothing or bodypaint. Some kachina dolls take the form of koshares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koshares"@en .

aat:300438461 a skos:Concept ;
    skos:definition "Long-hemmed dresses worn by Crow (Apsáalooke) women and girls; made distinctive by the use of elk teeth decorating the upper half of the garment. Elk teeth are sewn in parallel rows across the collar and bodice, sometimes covering the arms and waist as well. Depending on the family's wealth or expertise in hunting, the more the dress is elaborately decorated. Worn as part of ceremonial regalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elk tooth dresses"@en .

aat:300438463 a skos:Concept ;
    skos:definition "Carving knives manufactured by Northeast Native Americans; has origins in pre-contact knives fashioned from beaver or porcupine teeth. After European contact, Native carvers used metal blades. Distinctive by their elaborately carved, curving handles, often terminating in a figurative form such as ferns or hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crooked knives"@en .

aat:300438464 a skos:Concept ;
    skos:definition "Shields made by Plains Native North Americans, especially in Lakota, Comanche, and Crow (Apsáalooke) communities. Commonly made of animal hide and decorated with painted religious iconography. Feathers, fur, and body parts of animals were also often sewn into the shield, relating to different spiritual practices and one's own personal identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine shields"@en .

aat:300438465 a skos:Concept ;
    skos:definition "Religious movement that spread across Plateau Native North Americans during the late 19th century to the early 20th century. Founded by Klickitat prophet Jake Hunt, also known as Titcam Nashat. Focused on returning pre-contact lifeways to the Klickitat and other Native participants, accomplished through specific dress requirements and ceremonies. Placed emphasis on Eagle spirit veneration, with eagle feathers featuring in religious regalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feather Religion"@en .

aat:300438466 a skos:Concept ;
    skos:definition "Religious movement beginning in the 19th century based in Plateau Native North American spiritual practices. Smohalla, a Wanapum prophet and leader, developed the faith after receiving visions on how to remove white settlers from the Columbia River area. Followers believed adherence to traditional practices and peaceful opposition to colonization would revert society back to their pre-contact lifeways. The Dreamer religion continues to be observed today, with revival of Native culture and protection of the environment as major themes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dreamer Religion"@en .

aat:300438467 a skos:Concept ;
    skos:definition "Method of transferring loaned property back to the original owner or custodian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "return of loan"@en .

aat:300438468 a skos:Concept ;
    skos:definition "Navajo textile, largely produced between the 1870s and early 1900s as Navajo weavers acquired newly available European weaving materials. Distinctive through its use of commerically dyed yarn, complex patterning, and vibrant colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyedazzlers"@en .

aat:300438469 a skos:Concept ;
    skos:definition "Wearing blankets manufactured by Navajo weavers and frequently traded with Plains Native North Americans and to a lesser extent Euro-American settlers. Defined by alternating horizontal bands of indigo, white, red, and black wool. The earliest first phase chief's blanket dates from 1750; blankets continued to be produced in this style until the 1860s. Not associated with rank; \"chief blanket\" refers to their value assigned by Navajo and Plains communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first-phase chief blankets"@en .

aat:300438470 a skos:Concept ;
    skos:definition "Navajo wearing blankets characterized by horizontal bands of indigo, red, black, and white wool and rectangular motifs often placed in the center and sides of the work. Produced by Navajo weavers from the 1850s to the 1870s. Not associated with rank; \"chief blanket\" refers to their value assigned by Navajo and Plains communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second-phase chief blankets"@en .

aat:300438471 a skos:Concept ;
    skos:definition "Navajo wearing blankets produced from in the mid-to-late 19th century. Declined in production because of the introduction of European aniline dyes and yarn at the end of the 19th century. Defined by terraced diamond designs and horizontal bands of indigo, red, black, and white yarn. Not associated with rank; \"chief blanket\" refers to their value assigned by Navajo and Plains communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "third-phase chief blankets"@en .

aat:300438472 a skos:Concept ;
    skos:definition "Philosophical concept central to Navajo aesthetics and culture. Advocates for individuals to be balanced and in harmony with other spiritual and material aspects of Navajo life (landscape, community, etc.) In Navajo material culture and art, beauty is achieved through this balance. This concept can be seen expressed in textiles and pottery through their balanced compositions and in sandpainting in its illustrations of interconnected, harmonious relationships between people, animals, spirits, and the land. Also is applied to contemporary art made by Navajo artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hózhó"@en .

aat:300438473 a skos:Concept ;
    skos:definition "Coiled baskets woven by Washoe Native North Americans, defined by a globular shape and tightly-coiled weave. Often made with willow, sedge, and other plant fibers. Well-known Washoe weaver Dat-So-La-Lee, also known as Louisa Keyser, (1835-1925) is often credited as repopularizing the degikup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "degikup"@en .

aat:300438474 a skos:Concept ;
    skos:definition "Cylindrical baskets used by Hupa Native North Americans in the Jump Dance ceremony (Xay-ch´idilye). Generally made of plant fibers such as maidenhair fern and spruce, formed into a long, cylindrical shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "na´wehch"@en .

aat:300438475 a skos:Concept ;
    skos:definition "Type of weave, primarily used in basketweaving, that consists of alternating splints of plant fiber. Starting at the base, the splints construct one full basket before bending downward to form another basket on the outside of the first."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doubleweaving"@en .

aat:300438476 a skos:Concept ;
    skos:definition "Baskets created with doubleweave techniques, where one basket is woven outside another separate basket. Typically made of plant fibers such as rivercane (Arundinaria gigantea); splints are often dyed to create varying patterns on the sides and lids of the basket. Manufactured by various Southeastern Native North American tribes, but the Cherokee are most well-known for their doubleweave basketry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doubleweave baskets"@en .

aat:300438477 a skos:Concept ;
    skos:definition "Material derived from the stalks of rivercane plants; while there are three species of rivercane, Arundinaria gigantea is most often used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rivercane"@en .

aat:300438478 a skos:Concept ;
    skos:definition "Containers made of birchbark wood, often decorated with quillwork, incised designs, or beadwork. Used for a variety of purposes, from souvenirs to household containers. Historically made by Native North Americans from the Northeast and Great Lakes and by First Nations communities in Canada; contemporary makers of boxes reside across North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birchbark boxes"@en .

aat:300438479 a skos:Concept ;
    skos:definition "Process of creating three-dimensional imagery by sewing bundles of caribou hair onto a backing surface, usually animal hide or cloth. Backing stitches are pulled tight to shape the hair and then knotted. Hairs are sometimes dyed to create particular images or patterns. Originally manufactured by pre-contact Athabaskan and other First Nations communities, caribou tufting is now practiced by M%00etis and First Nations tribes across northern Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caribou tufting"@en .

aat:300438480 a skos:Concept ;
    skos:definition "Parkas characterized by broad shoulders and case on the back meant to carry an infant; created and worn by Inuit communities in North America. Often decorated with beadwork and fringe detailing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuilli"@en .

aat:300438481 a skos:Concept ;
    skos:definition "Overcoats worn by Euro-Canadian settlers and Cree men during the 18th and early 19th centuries. Adapted from pre-contact animal hide coats worn by Cree tribes. Usually made from animal hide with painted decoration and quillwork ornameting the shoulders. Coats from Northern Cree communities include further painted decoration on the spine, hem, and front of the coat. Were usually anufactured by Cree women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misko takiy"@en .

aat:300438482 a skos:Concept ;
    skos:definition "As related to copyright, refers to the right to perform music or another form of performance in public. The right is usually held by the creator, including a composer or lyricist, and the publisher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performance rights"@en .

aat:300438483 a skos:Concept ;
    skos:definition "Acts of selling or making over some thing or service to another for a price; the exchange of a commodity for money or other valuable consideration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sales"@en .

aat:300438484 a skos:Concept ;
    skos:definition "Transfers of property by sale, in which the seller does not have the right to sell the property because it was stolen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sales of stolen goods"@en .

aat:300438485 a skos:Concept ;
    skos:definition "Events surrounding business, finance, and commerce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial events"@en .

aat:300438486 a skos:Concept ;
    skos:definition "Events having to do with the chronological sequence of custody, ownership, control, transfer, analysis, or disposition of physical or electronic things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain of custody events"@en .

aat:300438487 a skos:Concept ;
    skos:definition "Communal men's houses built and used by Yup'ik men for daily activities (eating, sleeping, bathing). Also used as a communal dance hall for masked dance performances; during these dances the house is open to all individuals. Usually contains a firepit for steam baths and benches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qasgit"@en .

aat:300438488 a skos:Concept ;
    skos:definition "Headdresses worn by Yup'ik communities, usually made out of animal hide and caribou hair. Consists of a headband with animal hair attached to one half of the band, forming a crown-like shape above the wearer's head. Sometimes the headband is decorated with beadwork, both on the band and hanging underneath, placed in front of the wearer's eyes. Worn as regalia for Yup'ik and intratribal dances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nasqurrutet"@en .

aat:300438489 a skos:Concept ;
    skos:definition "Spoons made by Native Northwest Coast Americans and First Nations tribes, especially in Tsimshian and Tlingit communities. Usually made of wood, the spoon resembles a paddle with a wide, cylindrical and slightly-curved scoop and a long handle. The scoop is often decorated with carved clan designs; less commonly the handle is also carved. Used to both make whipped soapberry foam and to consume it, usually at important feasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soapberry spoons"@en .

aat:300438490 a skos:Concept ;
    skos:definition "Hunting tools used by Alaska Native and Inuit communities. Consists of a carved wooden handle, usually in the shape of an animal's paw, terminating in several carved points imitating the appearance of claws. Often, claws of other animals such as seals are lashed to these points with fiber. Sometimes a bead or circular depression is placed in the middle of the paw shape, relating to pierced hand designs common in Alaska Native and Inuit material culture. Used to imitate the sounds of seals scratching the ice and attract the attention of seals when hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice scratchers"@en .

aat:300438491 a skos:Concept ;
    skos:definition "Describes type of pottery created by Hopi potters from the late 14th century up to the early 1600s. Production is associated with Hopi pueblos formed after 14th century migrations from scattered villages across northern Arizona and New Mexico to consolidated towns. Distinguished by the clay's golden yellow lustre after firing with large amounts of coal. Frequently decorated with black and red pigmented designs featuring birds, dragonflies, feathers, and abstract, curvilinear motifs. Production particularly associated with Hopi Mesa communities in Arizona, namely Sikyátki which gives the pottery its name. Often created for export to other Native communities, with sherds being found as far as Kansas. Decline in production occurs in tandem with Spanish colonization in the 17th century and with the abandonment of Sikyátki and Awatovi towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sikyátki style"@en .

aat:300438492 a skos:Concept ;
    skos:definition "Defines type of pottery popularized by Nampeyo (ca. 1860-1942) and other female Hopi-Tewa and Hopi potters in the late 19th century to early 20th century. Utilizes the same techniques and visual program as historical Sikyatki pottery from the 14th to 16th centuries: a golden-hued patina due to high temperature firing and black and red curvilinear designs often featuring birds and dragonflies. Nampeyo is often credited as being one of the first to revamp this style, but other Hopi-Tewa and Hopi women were likely involved as well. Potters used the Sikyatki visual framework as a base for new works that were often traded and sold to Native and non-Native audiences in the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sikyatki Revival style"@en .

aat:300438493 a skos:Concept ;
    skos:definition "Baskets made by Plateau Native North American communities, such as the Wasco and Wishram. Baskets usually have a cylindrical form with flexible rounded sides, constructed of plant fibers. Often have woven designs decorating all sides, ranging from geometric patterns to animal and human forms; less frequently, beadwork is used to create these designs. Used historically as a gathering basket, production of sally bags continues in the 21st century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sally bags"@en .

aat:300438494 a skos:Concept ;
    skos:definition "Baskets constructed of baleen that is coiled around an ivory base. Often includes a lid topped with a carved, ivory finial; these finials are usually figurative, taking the forms of various Arctic animals. The first baleen baskets were woven by Inuit men in the 1910s following tourist interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baleen baskets"@en .

aat:300438495 a skos:Concept ;
    skos:definition "Headdresses of a type worn by important figures in Tsimshian society, such as chiefs or leaders of carving societies. Consists of a wooden base with a carved frontlet, usually depicting clan crest figures, animal whiskers protruding from the top, and a train of ermine skins framing the back and sides of the headdress. Sometimes a space is carved in the frontlet to hold feathers, which would be used by chiefs to welcome indivduals during various ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amhalaayt"@en .

aat:300438496 a skos:Concept ;
    skos:definition "Woven textile weave developed by Navajo weavers in the 19th century, consisting of alternating triangular designs. Weave is placed diagonally with the weft doubling the amount of warp threads covered with each pass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedge weave"@en .

aat:300438497 a skos:Concept ;
    skos:definition "Sedentary, fishing-based society based in southern Florida, particularly around Key Marco. Flourished from ca. 1000 CE to the mid 1700s; European diseases and conflict led to the Calusa's collapse. Known for large temple mounds, canals, and shell carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calusa"@en .

aat:300438498 a skos:Concept ;
    skos:definition "Defines type of pottery distinctive for its golden hue, derived from high-temperature firing and low-iron content clay. Manufactured in the Hopi Mesas region from ca. 1300 CE to the late 1600s/early 1700s. Sometimes decorated with black and/or red pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jeddito Yellow Ware"@en .

aat:300438500 a skos:Concept ;
    skos:definition "Ceremonial social dance performed by unmarried Hopi women and their male clan relatives. Dances are sponsored by families or indivduals, celebrating life cycles and the place of women in Hopi society. As part of the dance, female dancers wear large wooden headdresses, or kopatsoki, and decorated mantas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Butterfly Dance"@en .

aat:300438501 a skos:Concept ;
    skos:definition "Style and culture of Native American people of southeastern North Carolina, descendants of the pre-Columbian Neusiok tribe. Fought alongside American colonists during the Revolutionary War. Achieved state recognition in 1917. Today, the Coharie Tribe is concentrated in Sampson and Harnett counties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coharie"@en .

aat:300438502 a skos:Concept ;
    skos:definition "Style and culture of Siouan people of North Carolina and Virginia. Historically located near the Blue Ridge Mountains prior to European contact, the Sappony moved to the Piedmont region of North Carolina and northern Virginia in the 1700s. Today, the tribe is state recognized by both North Carolina and Virginia, and are known as \"Sappony.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sappony"@en .

aat:300438503 a skos:Concept ;
    skos:definition "Style and culture associated with a Siouan-speaking Native American people of North Carolina. Originally known as the \"Waccon\" or \"Waccamassus\" by Euro-American settlers, the Waccamaw first resided in southern North Carolina and northern South Carolina. During the early 1700s, the Waccamaw moved to the Green Swamp area of North Carolina, where they reside today. State recognized in 1971."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Waccamaw Siouan"@en .

aat:300438504 a skos:Concept ;
    skos:definition "Style and culture of Iroquioan-speaking Native Americans in North Carolina and Virginia. Related to the Tuscarora and Nottoway; formerly referred to as the \"Maharineck\" or \"Mangoac\" by Euro-Americans and Algonquins in the 17th and 18th centuries. In 1986, were state-recognized as the \"Meherrin Indian Tribe.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Meherrin"@en .

aat:300438505 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe of North Carolina; origins stem from the Nansemond and Tutelo tribes, as well as Tuscarora and Saponi members. Name derives from the North Carolina counties Halifax and Warren, where most tribal members currently live."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haliwa-Saponi"@en .

aat:300438506 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe in central North Carolina. Descended primarily from Occaneechi communities that have lived in the area since European contact; Eno, Saponi, and other Siouan-speaking tribes also comprise modern Occaneechi identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Occaneechi"@en .

aat:300438507 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe in Virginia, originally part of the Powhatan paramountcy in the 17th century. Achieved state recognition in 1985, and is known today as the \"Nansemond Indian Nation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nansemond"@en .

aat:300438508 a skos:Concept ;
    skos:definition "A variation of XRF imaging that allows visualization of the distribution of elements in a flat, macroscopic sample, up to several square meters, in a non-destructive manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macro x-ray fluorescence"@en .

aat:300438509 a skos:Concept ;
    skos:definition "Style and culture of an Iroquoian-speaking Native American tribe in southern and coastal Virginia. Related to the Meherrin and Tuscarora communities in North Carolina and southern Virginia. Today the Nottoway are recognized as two different tribes, the \"Nottoway Indian Tribe\" and the \"Cheroenhaka (Nottoway) Indian Tribe.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nottoway"@en .

aat:300438510 a skos:Concept ;
    skos:definition "An interdisciplinary field that uses computers to extract useful information about the physical world from digital images or video, including meaningful descriptions of physical objects, to mimic the functions of human vision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer vision"@en .

aat:300438511 a skos:Concept ;
    skos:definition "The process of moving software or processing activities from one computer system to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information systems migration"@en .

aat:300438512 a skos:Concept ;
    skos:definition "Photogrammetry technique that uses multiple images taken at converging angles with a number of reference points common to all of the images. May be further processed using specialized image processing software to create a three-dimensional image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convergent photogrammetry"@en .

aat:300438513 a skos:Concept ;
    skos:definition "Equipment that allows a stream of high-pressurized water to be projected at particular speed and flow, typically used for cutting or cleaning purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water jets"@en .

aat:300438514 a skos:Concept ;
    skos:definition "The study of ancient or extant wood charcoal macroremains from archaeological sites, including researching the ways communities used the plants and trees around them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthracology"@en .

aat:300438515 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe in coastal Virginia. Historically allied with the Powhatan paramountcy (but not a constituent of its confederacy) and were one of the first tribes to meet European settlers. Today the Chickahominy exist as two separate tribes with their own distinct histories, the \"Chickahominy Tribe,\" and the \"Chickahominy Tribe Eastern Division.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chickahominy"@en .

aat:300438516 a skos:Concept ;
    skos:definition "Perspective used in certain landscapes in Chinese painting, characterized by having not only one point of view, but including several perspectives, often shifting from near to far vignettes. The philosophy of this perspective scheme is to achieve an \"angle of totality,\" by which the viewer can see all parts of the scene to best advantage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating perspective"@en .

aat:300438517 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe from coastal Virginia. Historically a member of the Powhatan paramountcy and ally to the Jamestown colonists. Today they are a state-recognized tribe known as the \"Patawomeck Indian Tribe of Virginia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Patawomeck"@en .

aat:300438518 a skos:Concept ;
    skos:definition "Style and culture of an Algonquian-speaking Native American tribe from New York, specifically Long Island. Were federally recognized in 2010 as the \"Shinnecock Indian Nation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shinnecock"@en .

aat:300438519 a skos:Concept ;
    skos:definition "Style and culture of an Algonquian-speaking Native American tribe located in Long Island, New York. Have also been referred to as the \"Poospatuck\" in reference to the reservation the Unkechaug live on (Poospatuck Reservation, NY)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unkechaug"@en .

aat:300438520 a skos:Concept ;
    skos:definition "Long, rectangular bands of woven fabric terminating in woven streamers or tassles, usually wrapped around the waist. Woven by using one's hands without the use of a loom, joining lengthwise and sideways threads together. Often used in Native North American and Métis regalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger woven sashes"@en .

aat:300438521 a skos:Concept ;
    skos:definition "Style or culture of a Native American tribe in Maryland, whose historical lands comprise the Chesapeake Bay area. Today they are known as two different state-recognized bands, the \"Piscataway-Conoy Tribe\" and the \"Piscataway Indian Nation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Piscataway"@en .

aat:300438522 a skos:Concept ;
    skos:definition "Style and culture of a Siouan-speaking Native American tribe originally living in coastal Texas and Mississippi. From the mid 1700s to mid 1800s, Biloxi bands dispersed into Tunica communities in under pressure from the Spanish, Americans, and the Republic of Texas. This community is federally recognized as the Tunica-Biloxi Tribe of Louisiana, gaining recognition in 1981. Some Biloxi moved further west into Texas, joining with the Alabama-Coushatta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Biloxi"@en .

aat:300438523 a skos:Concept ;
    skos:definition "Style and culture of a Natchezan Native American tribe from coastal Louisiana, primarily living around the Red River. In the early 1800s, most Avoyelles joined with the Tunica and Biloxi. Today, Avoyel descendants are recognized in the Tunica-Biloxi Tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Avoyel"@en .

aat:300438524 a skos:Concept ;
    skos:definition "Style and culture of a Siouan-speaking Native American tribe, residing near the Yazoo River's mouth in Mississippi; previously the Ofo lived in the Ohio River Valley, comprised of the present-day states of Ohio, Kentucky, and Indiana. French observers from the 1600s noted Iroquois violence as the reason for Ofo movement. During the 1700s, the Ofo joined with the Tunica, Biloxi, and the Avoyel. Today, Ofo descendants are represented in the Tunica-Biloxi Tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ofo"@en .

aat:300438525 a skos:Concept ;
    skos:definition "Style and culture of Native Americans living in the Hopi Mesas region in northern Arizona, particularly in Hano village on First Mesa. Distinct from Hopi and Tewa communities, Hopi-Tewa are descended from Tewa that fled the Rio Grande Pueblos during the 1680 Pueblo Revolt. The fleeing Tewa settled on First Mesa alongside the Hopi and continue to reside there today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hopi-Tewa"@en .

aat:300438526 a skos:Concept ;
    skos:definition "Style of beadwork and quillwork practiced by Great Lakes and Plains Native North Americans across the United States and Canada. Features floral and plant motifs, often seen on bandolier bags, clothing, and moccasins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodland style"@en .

aat:300438527 a skos:Concept ;
    skos:definition "High-energy particles arriving from outer space that are mainly protons (often referred to as hydrogen nuclei), but also include nuclei of heavier elements. When they arrive at Earth, they collide with the nuclei of atoms in the upper atmosphere, creating more particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmic rays"@en .

aat:300438528 a skos:Concept ;
    skos:definition "Chemical elements of hydrogen having the same atomic number but different mass. Three of them are naturally occuring: 1H (protium), 2H (deuterium), and 3H (tritium)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogen isotopes"@en .

aat:300438529 a skos:Concept ;
    skos:definition "Casting that uses a mixture of metal powders with a resin or gypsum base and carried out without heat, resulting in objects with the appearance of solid metal. Silicone molds are typically used for the casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold casting"@en .

aat:300438530 a skos:Concept ;
    skos:definition "The capacity or tendency for any material such as paper, metal, or plastic to show effects of past treatment or for returning to a former condition or shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic memory"@en .

aat:300438531 a skos:Concept ;
    skos:definition "Of or belonging to the prehistoric and protohistoric society that existed on the island of Minorca, one of the Balearic Islands. The denomination of \"Talayotic\" is related to one of the most typical elements of this culture, namely buildings in the form of a tower and known by the island's inhabitants as \"talayot\". Has also been used to discuss similar culture that existed on the neighboring island of Mallorca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Talayotic"@en .

aat:300438532 a skos:Concept ;
    skos:definition "A technology that provides rapid multi-parametric analysis of single cells in solution. Flow cytometers utilize lasers as light sources to produce both scattered and fluorescent light signals. Cell populations can be analyzed and/or purified based on their fluorescent or light scattering characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flow cytometry"@en .

aat:300438534 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe from southern Florida. Originally part of the Mvskoke (Creek) nation, the Miccosukee moved from Mvsoke territory in present-day Georgia and Alabama to Florida during the mid 1700s. Distinct from Seminole communities in both language and culture. In 1962, the Miccosukee were federally recognized and land designated for a reservation in southern Florida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miccosukee"@en .

aat:300438535 a skos:Concept ;
    skos:definition "Style and culture of a Coast Salishan First Nations tribe; their reserve is located near the city of Vancouver, British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsleil-Waututh"@en .

aat:300438538 a skos:Concept ;
    skos:definition "A form of damage to photographic prints, typically those with a gelatin layer, that occurs when a print is exposed to water or a high relative humidity while in contact with a smooth surface. The gelatin swells and reforms in the shape of the surface it is in contact with, causing the gloss of the print to be non-uniform. The term 'blocking' refers to the same cause, but that causes stacks of prints to adhere to each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrotyping"@en .

aat:300438539 a skos:Concept ;
    skos:definition "The action or fact of the adaptation of a global culture or something such as a product, application, or document to meet the language, cultural and other requirements of a specific locale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "localization"@en .

aat:300438541 a skos:Concept ;
    skos:definition "An ISO standard developed to measure and calibrate lightfastness and fading of colorants and other materials. It consists of a card that contains eight sections of blue-dyed wool cloth, each with a different lightfastness. The dyes fade at a known rate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blue Wool Standard"@en .

aat:300438542 a skos:Concept ;
    skos:definition "An enhanced technique of liquid chromatography that can be used to analyze particles that are smaller than 2-microns in size. Pumps used in UHPLC or UPLC systems operate above 6,000 PSI, which is typically the upper limit of conventional HPLCs. The technique was first patented in 2004 by Waters with the trademarked acronym “UPLC.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultra high performance liquid chromatography"@en .

aat:300438543 a skos:Concept ;
    skos:definition "Removing dirt, surface coatings, accretions, discolorations, or other undesired matter from a substrate using biological agents e.g. bacteria, enzymes, plant-based surfactants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biocleaning"@en .

aat:300438546 a skos:Concept ;
    skos:definition "Malalikid is held by the Amis people from July to August every year; it has different names and sets of practice from the north to the south. The festival is known as Malalikid in the north, Ilisin or Milisin in the middle region and Kilima’an or Malikoda in the south. The festival generally involves the welcoming, entertaining, feasting and bidding farewell to the ancestral spirits across regions, characterized by lengthy and majestic dancing and chanting. In recent years, the celebration is evolving in an urbanized context that expects festive glee combined with a tinge of historical authenticity – its cultural importance is thus confirmed as a moment foregrounding social identity, cultural symbols and the socio-ethical value of the age class system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malalikid"@en .

aat:300438547 a skos:Concept ;
    skos:definition "Maho is a festival dedicated to the ancestral spirits after the harvest of millet. The name of this festival varies from region to region, and people have different concepts on the nature and time of occurrence of the festival. When the crops of millet are stored, the chief would preside over a council to decide when to hold the festival; the preparation of marinated meat, millet rice cake and millet wine is then scheduled according to the date. On the day of Maho, members of the tribe gather to the venue for worship to observe a rite led by the chief to thank the ancestral spirits and pray for harvest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maho"@en .

aat:300438548 a skos:Concept ;
    skos:definition "The Paiwan’s festival of Maljeveq is held every five years and composed of two phases. At the first phase, people go through the preliminaries, invoke and offer gifts to the ancestral spirits and participate in activities such as setting up symbolic barricades to fend off evil spirits, piercing rattan balls pitched into the air in a contest, singing and dancing. The second phase takes place in the following year, in which ceremonies are held to bid farewell to evil spirits and ancestral spirits. Different tribes tend to interpret the origin of Maljeveq differently, while there are a number of objectives central to the festival: praying to ancestral spirits for good fortune, expressing sentiments that people hold dear to their life, holding the tribe together and reallocating positive augury among families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maljeveq"@en .

aat:300438549 a skos:Concept ;
    skos:definition "Malah tangia takes place in April and May every year and counts as the largest festival co-organized by the Bunun’s clans bearing different family names. When the millet tassels bend with weighty grains, men would go hunting in the mountains and women would start brewing wine in preparation for the upcoming rituals. In the early morning of malah tangia a family should fire their fusil if there is a boy born to the family recently. Then men would initiate the ritual with the fire-lighting mapatus, roast and distribute the game and use a plant called bauvan to tell the fortune. Post-prandial proceedings involve drizzling the remaining wine on the bones and fusil-firing as an invigorating act. Subsequently, men should gather in the leading family’s house through a fire-crossing ritual called daugkav sapuz to attend a party of valor known as malastapan. In malastapan attendants should announce their family name and enumerate the achievement in hunting and fighting over the last year. Sons of the attendants are brought to the party to participate in malah tangia in which they are to shoot arrows at a deer’s ear. Adults utilize the occasion to go through mapa-ip taiga and mapis-lai as a ritual to augment the spiritual power of their weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malah tangia"@en .

aat:300438551 a skos:Concept ;
    skos:definition "In the Pinuyumayan culture, end-of-year festivals involve a series of December rituals starting from Mangayangayaw (or Basibas) for boys coming of age, Mangayaw (or Amiyan) featuring hunting, then all the way to the new year celebration. The festivals underline the significance of connecting, border-crossing and purification. Mangayangayaw (“monkey-shooting”) is held for members of takuban who age from thirteen to eighteen years old. Every December, people refurbish the roof of the takuban, hold purification ritual at the house of ancestral spirits and security ritual (known as semalikid) at the border of the tribe’s territory. Afterward, people would set up a stage for Mangayangayaw. The boys who are about to attend Mangayangayaw should use the leaf of hardy banana to sweep their household as a purifying act (known as alabakabakay) at the ceremony’s eve. At the ceremony, their courage and determination shall be tested by shooting monkeys. At the hunting ritual, adults ranking higher than miyabetan (senior rank of the junior hall) enter the mountainous territory for ceremonial hunting and related rituals. With seniors chanting a hunting hymn known as pairairaw, young adults should stand guard over the hunting camp. At the end of the hunting ritual, which takes up a number of days, the hunting party returns by passing the tribe’s arch of triumph known as laluwanan and men will be crowned with garlands by women awaiting them. The senior members are to announce the end of mourning period for those who have been put on mourning. Subsequently, the end-of-year celebration will last numerous days with singing, dancing and evening puazangi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end-of-year festivals"@en .

aat:300438552 a skos:Concept ;
    skos:definition "In Hinduism and Buddhism, a type of profound meditation; the penultimate (seventh) stage of yoga."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhyana"@en .

aat:300438554 a skos:Concept ;
    skos:definition "Quilts, usually comprised of cotton or polyester fabrics, that features an eight-pointed star motif. This motif is frequently placed in the middle of the blanket, with a fabric border sometimes included around the quilt's edge. Commonly made by Plains Native Americans; traced to the late 1800s/early 1900s as a replacement for buffalo robes that were formerly constructed by Lakota and Dakota artisans. Used as powwow regalia, funerary clothing, and as gifts in give-away events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "star quilts"@en .

aat:300438555 a skos:Concept ;
    skos:definition "The location where a work was found, not necessarily the creation location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discovery location description"@en .

aat:300438556 a skos:Concept ;
    skos:definition "The action or condition of being present, usually in reference to a particular event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attendance"@en .

aat:300438557 a skos:Concept ;
    skos:definition "The action or condition of finding or meeting, with reference to a person, thing, or experience. May imply difficulties or opposition surrounding the meeting, but this is not necessarily the case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encountering"@en .

aat:300438558 a skos:Concept ;
    skos:definition "The action or function of communicating or conferring with another or others for the purpose of arranging or settling some matter by mutual agreement, such as the price for a sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negotiating"@en .

aat:300438559 a skos:Concept ;
    skos:definition "The status or attribute of living a long lifespan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longevity"@en .

aat:300438560 a skos:Concept ;
    skos:definition "Rukai’s festival of Kalabecengane takes place on 15 August every year. On the eve of the festival, every family prepares food such as taro and abay, a Rukai-style rice dumpling, and male members of the family will bring the food to the venue. In the small hours on Kalabecengane, all Rukai men should follow the chief to their hunting area, where the chief will launch a fortunetelling rite involving the baking of millet pastry. After the rite is over, the Rukai people are to enter the venue in full ceremonial dress. At the beginning of Kalabecengane, a group of men will report to the tribe from a higher standpoint and raise a smoke signal. Gifts and tributes will be presented to the family of the chief. Following the presentation is the singing and chanting of triumphant messages and group dancing. Daughters of every family are to play on swings. The harvest festival stresses the solidarity of the tribe and the identity of the Rukai traditional culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalabecengane"@en .

aat:300438561 a skos:Concept ;
    skos:definition "Mayasvi involves a number of rituals: welcoming the gods, homage to solidarity, bidding farewell to the gods, a procession in the streets to pray for safe travels and family worship. The date of Mayasvi is not set in stone; on the contrary, whether the Mayasvi is to be held is decided by the incumbent chief of hosa judging from the current circumstances. Occasions in favor of having a Mayasvi include: relief efforts after a major epidemic or battle involving injury and death in order to fend off misfortune, foreigners and noxious spirits; celebrations for warriors returning from headhunting or battles in honor of their valor; a renovation project for the kuba is proposed to ensure the good fortune of the tribe and the Tsou compatriots. Moreover, male babies are brought to Mayasvi to make their debut in the kuba; rites will be conducted for lads coming of age during Mayasvi as well. The most important message of Mayasvi is not only to inspire patriotism so that the Tsou people will protect the whole tribe on their lives and soul and pray for the favor of war god, but also to unify the social, ethical protocols and augment general morale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mayasvi"@en .

aat:300438562 a skos:Concept ;
    skos:definition "Pas-taai is held every two years, and the celebration is carried out by representatives from communities from north and the south. The proceedings involve three stages. At the first stage, knots of silver grass will be tied on a long string to mark the total number of days in which Pas-taai takes place, and a committee of chiefs will be held. The second stage of Pas-taai, being the body of the festival, involves resolution of disputes, acknowledging the ancestors, sets of dancing addressing to the advent and departure of the spirit of Short People, and finally a thanksgiving banquet. The Pas-taai celebration ends with the seeing of Short People’s spirits on the eastward stream. The festive and ceremonial proceedings unify community-tribes on both sides by binding everybody’s fate together in a single rite shared by all Saysiyat people. Pas-taai consummates a symbolic unification of the Saysiyat society across the boundaries of bloodlines and tribe borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pas-taai"@en .

aat:300438563 a skos:Concept ;
    skos:definition "Covered carts, huts, or tents, mounted on wheels by which they can be rolled into shallow water at the seaside or lake shore, for the purpose of allowing swimmers to enter the water modestly, without appearing in public in bathing suits. May be horse-driven or pushed by hand. Bathing machines were popular in 18th-19th-century Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathing machines"@en .

aat:300438564 a skos:Concept ;
    skos:definition "Mirayon (the “flying fish festival”) of the Tao people begins on the first day of the month of Paneb. It involves nocturnal fishing carried out by large boats manned by six up to ten people. Every male member who can walk independently in the Tao society should come to the beach to attend the fish-summoning ritual. The first flying fish caught in Mirayon should be treated with procedures as follows: in Mirayon, as crews of every boat live together in panlagan, a communal house used during the month of Paneb, the family of one of the crews whose house contains more than three doors is to be chosen to cook the fish in their hearth; and the flesh of the first-caught fish should be shared by all of the fishing crews and members of the family in charge of cooking the fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mirayon"@en .

aat:300438565 a skos:Concept ;
    skos:definition "A variant of XRF imaging that is based on the use of two x-ray lenses in a confocal configuration, enabling measurements of high spatial resolution in three directions, including depth (x, y, and z) in the micrometer range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confocal micro x-ray fluorescence"@en .

aat:300438566 a skos:Concept ;
    skos:definition "The condition of having elements that are different, varied, or unlike. Used often to describe organizational or social groups composed of different types of people with varying perspectives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diversity"@en .

aat:300438567 a skos:Concept ;
    skos:definition "Text and other symbols in the perforation areas on the sides of commercial photographic or motion picture films, typically showing frame numbers and other product information such as brand, type, and film speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge markings"@en .

aat:300438568 a skos:Concept ;
    skos:definition "Prayer beads used by Chinese Buddhists and Taoists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "su-chus"@en .

aat:300438569 a skos:Concept ;
    skos:definition "Japanese Buddhist prayer beads, typically 112 in number, divided by 2 large beads in equal-length parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jiu-dzus"@en .

aat:300438570 a skos:Concept ;
    skos:definition "Bowls used in many cultures for soliciting food or other alms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "begging bowls"@en .

aat:300438571 a skos:Concept ;
    skos:definition "Bowls used by Buddhist monks to collect alms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhist begging bowls"@en .

aat:300438572 a skos:Concept ;
    skos:definition "Fabulous beasts of composite form in Buddhist and other Japanese and Chinese art; in typical examples, they have the head of a dragon, body and legs of a stag or horse, tail of an ox or lion, single horn on the forehead, and parti-colored or scaly body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kirins"@en .

aat:300438573 a skos:Concept ;
    skos:definition "The world view and practice by which it is maintained that human remains and artifacts should be subject to laws of deterioration by natural processes, rather than being subject to intervention or preservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural decay"@en .

aat:300438574 a skos:Concept ;
    skos:definition "Publications in electronic formats, including magazines, books, Web sites, databases, and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic publications"@en .

aat:300438575 a skos:Concept ;
    skos:definition "Publishing content on the internet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "online publishing"@en .

aat:300438576 a skos:Concept ;
    skos:definition "Publications on the internet, including books, magazines, Web sites, databases, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "online publications"@en .

aat:300438577 a skos:Concept ;
    skos:definition "The action of managing or keeping something in good order for optimum efficiency or performance. In conservation, the care and maintenance of historic heritage sites and collections with an emphasis on preventive preservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housekeeping"@en .

aat:300438578 a skos:Concept ;
    skos:definition "Quantitative measure or expression thereof of the acidity or alkalinity/basicity of an aqueous solution, a medium containing a solution, an aqueous dispersion or emulsion, and even air or gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pH"@en .

aat:300438579 a skos:Concept ;
    skos:definition "A systematic approach to recording and presenting information that provides a summation of the cultural character, significance, and workings of a place. It encompasses a wide range of techniques and activities from community-based participatory data collection and management to sophisticated mapping using GIS (Geographic Information Systems)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural mapping"@en .

aat:300438580 a skos:Concept ;
    skos:definition "Persons who are paid or routinely employed to provide sexual services, or performances, as in the pornography industry, or as a prostitute. The term is often used to avoid or reduce negative connotations of such work, to indicate agency in the activity performed, or to evoke less charged service industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sex workers"@en .

aat:300438582 a skos:Concept ;
    skos:definition "Artists whose work incorporates concepts and research from mathematics, the physical sciences, biology, kinetics, telecommunications, or digital systems including computer coding. Works may be fashioned from pieces of found data or from archived and manipulated information. The final form of an information artist's work may or may not be a physical object, but one that incorporates some form of data. A genre of art that may incorporate concepts and research from mathematics, the physical sciences, biology, kinetics, telecommunications, or digital systems including computer coding. Works may be fashioned from pieces of found data or from archived and manipulated information. The final form of an information art work may or may not be a physical object, but one that incorporates some form of data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information artists"@en .

aat:300438583 a skos:Concept ;
    skos:definition "Style and culture of a Lushootseed-speaking Native nation. Their ancestral territories are the land in and around Seattle, Washington."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Duwamish"@en .

aat:300438584 a skos:Concept ;
    skos:definition "The study on the history of origin and evolvement of buildings, using varied research methods such as photography, study of literature and archives, iconographical, cartographical and in situ-research and the study of oral histories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building history research"@en .

aat:300438586 a skos:Concept ;
    skos:definition "The Celtic Revival was a variety of movements and trends in the 19th and 20th centuries that saw a renewed interest in aspects of Celtic culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic Revival"@en .

aat:300438588 a skos:Concept ;
    skos:definition "German Expressionism consisted of a number of related creative movements in Germany before the First World War that reached a peak in Berlin during the 1920s. These developments in Germany were part of a larger Expressionist movement in north and central European culture in fields such as architecture, dance, painting, and sculpture. Der Blaue Reiter was a group of artists who were part of German Expressionism. The term as it is applied to cinema may be considered a separate concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German Expressionist"@en .

aat:300438590 a skos:Concept ;
    skos:definition "Correspondence of sound between words or the endings of words, especially when these are used at the ends of lines of poetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhyme"@en .

aat:300438592 a skos:Concept ;
    skos:definition "The state, attitude, or position of rest, sleep, or tranquility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repose"@en .

aat:300438593 a skos:Concept ;
    skos:definition "Style or culture of a Lushootseed-speaking Native American nation, whose ancestral lands are located in central Puget Sound in Washington state. Their endonym derives from a Lushootseed phrase meaning \"people of the clear salt water.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suquamish"@en .

aat:300438594 a skos:Concept ;
    skos:definition "An exponent of photorealism; an artist working in a photorealist style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photorealists"@en .

aat:300438596 a skos:Concept ;
    skos:definition "Artists whose works can be expressed in a number of different media, in keeping with the paradigm of \"transmediality.\" Transmedia artists may combine multiple disciplines or new media including Web portals and content, digital archives, social networks, blogs, or online games. Artists of this type often intend to confuse the roles of participant, creator, and observer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmedia artists"@en .

aat:300438597 a skos:Concept ;
    skos:definition "Artists that create works with the technology of copying machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copy artists"@en .

aat:300438598 a skos:Concept ;
    skos:definition "Prints made from the photoglyphic engraving process, which was William Henry Fox Talbot's improved process for producing a printing plate from a photograph, that was patented in 1858."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoglyphic engravings"@en .

aat:300438599 a skos:Concept ;
    skos:definition "Status occurring when items are left unsold and remain the property of the owner at an auction because there are no bids on a lot, or the bidding did not reach the reserve price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bought in"@en .

aat:300438600 a skos:Concept ;
    skos:definition "Status of items that are removed from bidding prior to the auction or at the auction when there is a failure to reach sufficient bidding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "withdrawn"@en .

aat:300438601 a skos:Concept ;
    skos:definition "The random selections of names or numbers to decide the winners in a lottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lottery drawings"@en .

aat:300438603 a skos:Concept ;
    skos:definition "A listing of items that are offered in a lottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lottery catalogs"@en .

aat:300438606 a skos:Concept ;
    skos:definition "The act of officiating or presiding over a game, match, debate, or other competitive event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refereeing"@en .

aat:300438607 a skos:Concept ;
    skos:definition "The act of assigning points, grades, or scores for an activity or achievement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scoring"@en .

aat:300438608 a skos:Concept ;
    skos:definition "Liturgical shawls or sashes worn as a superhumeral over the shoulders, similar in form to a pallium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rationales"@en .

aat:300438609 a skos:Concept ;
    skos:definition "Prescriptions or detailed statements of ingredients and processes used to fabricate materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formulas"@en .

aat:300438610 a skos:Concept ;
    skos:definition "Mixtures prepared according to a particular formula to create materials or preparations for specific purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formulations"@en .

aat:300438611 a skos:Concept ;
    skos:definition "A technique used to visually determine the shrinkage temperature (Ts) of skin and leather, as an indicator of the collagen’s hydrothermal stability. A prepared sample is covered with distilled water, placed on a Kofler hotbench, then heated at the appropriate heating rate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro hot table technique"@en .

aat:300438612 a skos:Concept ;
    skos:definition "Gradient-heated devices used to determine the melting point of a substance designed by Ludwig Kofler, usually to be used with a microscope. These feature stainless steel surfaces which are electrically heated at one end, resulting in an approximately linear temperature gradient along the top surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kofler hot benches"@en .

aat:300438615 a skos:Concept ;
    skos:definition "Pieces of hard, glassy material formed of sand or other sediment fused by lightning; commonly elongated and hollow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fulgerites"@en .

aat:300438616 a skos:Concept ;
    skos:definition "Distinctive containers, usually made of animal hide and decorated with beadwork or quillwork. A major feature of Midewiwin ceremonies practiced by Ojibwe, Odawa, Santee, and other Great Lakes Native North American tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "midewayaanag"@en .

aat:300438617 a skos:Concept ;
    skos:definition "A numeric measurement used to quantify the tone of light being used for viewing, expressed in terms of the Kelvin scale (K). Typical values that can be assigned according to this scale are: a setting sun 2300 K; a typical incandescent lightbulb 2800–2900 K; a summer daylight sky 5500 K; a cloudy overcast sky 6500–8000 K."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color temperature"@en .

aat:300438618 a skos:Concept ;
    skos:definition "A plasma-based technique primarily used for local pre-treatment of different surfaces. With atmospheric plasma technology, gas is excited by means of a high voltage underatmospheric pressure, such that a plasma is ignited. The plasma is expelled by compressed air from the nozzle. The treatment performance can be affected in different ways by varying the process parameters such as treatment speed and distance from the substrate surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmospheric pressure plasma process"@en .

aat:300438619 a skos:Concept ;
    skos:definition "The remains of industrial culture which are of historical, technological, social, architectural or scientific value. These remains consist of buildings and machinery, workshops, mills and factories, mines and sites for processing and refining, warehouses and stores, places where energy is generated, transmitted and used, transport and all its infrastructure, as well as places used for social activities related to industry such as housing, religious worship or education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial heritage"@en .

aat:300438620 a skos:Concept ;
    skos:definition "Visual works that constitute deliberate pictures, diagrams, or other marks made directly on the surface of a wall using drawing tools and materials such as ink or graphite rather than paint.These most often dominate the entire surface of the wall. For paintings that are similar in execution, see \"mural paintings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall drawings"@en .

aat:300438621 a skos:Concept ;
    skos:definition "A thermally-induced physical separation process that utilizes heat to increase the volatility of contaminants such that they can be removed from a solid matrix. Options used to manage or treat the resulting contaminant-laden gas stream may consist of condensation, collection, or combustion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal desorption"@en .

aat:300438622 a skos:Concept ;
    skos:definition "A set of care guidelines or techniques used to minimize and prevent damage to collections due to pests. IPM encompasses aspects in a cultural institution's setting and encourages a less chemical-based approach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Integrated Pest Management"@en .

aat:300438623 a skos:Concept ;
    skos:definition "Arches comprising lobes or sub-arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multifoil arches"@en .

aat:300438624 a skos:Concept ;
    skos:definition "Structures or other places of adode that are more than merely temporary, and serve as the usual dwellings of people while at a certain place. In a legal sense, a person may have multiple residences, but only one \"domicile,\" which is their primary dwelling for legal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "residences"@en .

aat:300438625 a skos:Concept ;
    skos:definition "Structures or other places of adode; in a legal sense, a domicile is the primary dwelling of a person, their fixed or permanent location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domiciles"@en .

aat:300438626 a skos:Concept ;
    skos:definition "Structures or other places that are people's house or abode, the fixed residence of a family or household, or otherwise the physical seat of domestic life and interests. For the abstract concept of the center of an individual's domestic life, personal relationships, and interests, together with the feeling of comfort and satisfaction that it conveys, use \"home (concept).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homes"@en .

aat:300438627 a skos:Concept ;
    skos:definition "The act or process of placing documents in a cabinet, box, folder, or in a particular order digitally for preservation and easy reference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filing"@en .

aat:300438628 a skos:Concept ;
    skos:definition "A trademark for a two-part epoxy adhesive made with the diglycidyl ether of bisphenol A and triethylene diamine. Hxtal NYL-1 is a low viscosity, colorless, transparent resin that hardens to form a clearstrong bond. It has been used for glass and china repair. Hxtal may discolor in direct sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "HXTAL NYL-1 (TM)"@en .

aat:300438629 a skos:Concept ;
    skos:definition "Family of beetles containing many that possess a bioluminescent organ which is typically used by the male at night to produce a flashing light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lampyridae"@en .

aat:300438630 a skos:Concept ;
    skos:definition "Belts decorated with conchos, circular, silver ornaments often further decorated with stamped decoration or semi-precious stones. Originated in the mid-1800s by Navajo (Diné) and Pueblo silversmiths. Contemporary concho belts frequently contain a variety of semi-precious stones and are widely made by Southwest Native American artisans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concho belts"@en .

aat:300438631 a skos:Concept ;
    skos:definition "A method of chemical analysis in which a small sample of material is inserted into a pyrolysis unit before subsequently analyzed using the techniques of gas- chromatography and mass spectrometry in tandem. This method enables a reproducible characterisation of the macromolecular complexes found in virtually all materials in the natural environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrolysis-gas chromatography-mass spectrometry"@en .

aat:300438632 a skos:Concept ;
    skos:definition "Infrared spectroscopy having the range of 0.9 – 1.7μm, but can also be classified from 0.7 – 2.5μm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "short-wave infrared spectroscopy"@en .

aat:300438633 a skos:Concept ;
    skos:definition "Wood of the species Dyera costulata. Grows in Malaysia, Borneo, and other regions of Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jelutong"@en .

aat:300438636 a skos:Concept ;
    skos:definition "The first month of the French revolutionary calendar, introduced in 1793, extending from Sept. 22 to Oct. 21."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vendémiaire"@en .

aat:300438637 a skos:Concept ;
    skos:definition "The second month of the French revolutionary calendar (introduced in 1793), extending from 22 October to 20 November."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brumaire"@en .

aat:300438638 a skos:Concept ;
    skos:definition "The third month of the French revolutionary calendar (from Nov. 21 to Dec. 20)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Frimaire"@en .

aat:300438639 a skos:Concept ;
    skos:definition "The fourth month of the French revolutionary calendar (introduced in 1793), extending from 21 December to 19 January."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nivôse"@en .

aat:300438640 a skos:Concept ;
    skos:definition "The fifth month of the French revolutionary calendar (introduced in 1793), beginning on 20, 21, or 22 January and ending on 18, 19, or 20 February (depending on the year)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pluviose"@en .

aat:300438641 a skos:Concept ;
    skos:definition "The eighth month of the year in the French revolutionary calendar, introduced in 1793; it extended from April 20 to May 19."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Floreal"@en .

aat:300438642 a skos:Concept ;
    skos:definition "The ninth month of the French revolutionary calendar (introduced in 1793), lasting from 20 May to 18 June."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prairial"@en .

aat:300438643 a skos:Concept ;
    skos:definition "The tenth month of the French revolutionary calendar (introduced in 1793), lasting from 19 June to 18 July."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Messidor"@en .

aat:300438644 a skos:Concept ;
    skos:definition "The eleventh month of the French revolutionary calendar, extending (in 1794) from July 19 to August 17."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thermidor"@en .

aat:300438645 a skos:Concept ;
    skos:definition "The twelfth month of the French revolutionary calendar (from Aug. 18 to Sept. 16); the revolution which took place in that month in 1797."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fructidor"@en .

aat:300438646 a skos:Concept ;
    skos:definition "The sixth month of the French republican calendar, introduced in 1793, extending from 19 Feb. to 20 Mar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ventôse"@en .

aat:300438647 a skos:Concept ;
    skos:definition "The seventh month of the French revolutionary calendar (introduced in 1793), lasting from 21 March to 19 April."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Germinal"@en .

aat:300438648 a skos:Concept ;
    skos:definition "Handiwork table of a distinctive style, having four slender legs and a deep body set with several drawers; typically used for sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Martha Washington tables"@en .

aat:300438649 a skos:Concept ;
    skos:definition "Small, light work tables with one or two drawers, the lower of which forms a frame from which is suspended a bag for needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bag tables"@en .

aat:300438650 a skos:Concept ;
    skos:definition "Sturdy tables of relatively substantial size, used for various tasks, from kitchen work to carpentry or other heavy work. For table-like structures of waist height, typically used for heavy work while standing, prefer \"work benches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work tables"@en .

aat:300438651 a skos:Concept ;
    skos:definition "A branch of physics that deals with the properties and applications of photons especially as a medium for transmitting information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photonics"@en .

aat:300438652 a skos:Concept ;
    skos:definition "Particles between 1 and 100 nanometers (nm) in size with a surrounding interfacial layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanoparticles"@en .

aat:300438653 a skos:Concept ;
    skos:definition "Agricultural field systems of embanked field plots that are traditionally dated between the Late Bronze Age and the first two centuries of the Roman Period (ca. 1000 - ca. BC-AD 200). They are native to the north-west European sandy soils and abundantly present in the Netherlands, Belgian Kempian (Campine) plateau, Northwest Germany and Denmark. The term was used for the first time by O.G.S. Crawford and E.C. Curwen in 1923 to denote a particular group of prehistoric field division; it does not have an ethnic meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic fields"@en .

aat:300438654 a skos:Concept ;
    skos:definition "Metalworkers whose work is considered art or high crafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artisan metalworkers"@en .

aat:300438656 a skos:Concept ;
    skos:definition "Casting of sculptures or other items using an alloy of copper and tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze casting"@en .

aat:300438657 a skos:Concept ;
    skos:definition "People who specialize in cutting latticework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lattice cutters"@en .

aat:300438658 a skos:Concept ;
    skos:definition "People who specialize in creating images of coats of arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coat of arms artists"@en .

aat:300438659 a skos:Concept ;
    skos:definition "People who specialize in creating painted set designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "set painters"@en .

aat:300438660 a skos:Concept ;
    skos:definition "People who create costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume makers"@en .

aat:300438661 a skos:Concept ;
    skos:definition "People who pour molten metal for casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal pourers"@en .

aat:300438662 a skos:Concept ;
    skos:definition "People who specialize in painting and making banners and flags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banner makers"@en .

aat:300438663 a skos:Concept ;
    skos:definition "People who specialize in architectural drawings, plans, and similar documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural drafters"@en .

aat:300438664 a skos:Concept ;
    skos:definition "Painters who specialize in decorating façades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "façade painters"@en .

aat:300438665 a skos:Concept ;
    skos:definition "People who cut and carve the material fo crystal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystal cutters"@en .

aat:300438666 a skos:Concept ;
    skos:definition "Smiths whose work is of the quality of fine art or crafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist smiths"@en .

aat:300438667 a skos:Concept ;
    skos:definition "Paper artists who specialize in creating three-dimensional or low-relief works in the medium of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper sculptors"@en .

aat:300438668 a skos:Concept ;
    skos:definition "Carpenters who are of a level of master in skill, accomplishment, and responsibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master carpenters"@en .

aat:300438669 a skos:Concept ;
    skos:definition "General term for creators of visual arts that are three-dimensional objects, rather than two-dimensional."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic artists"@en .

aat:300438670 a skos:Concept ;
    skos:definition "Artists who specialize in the process of monotype, which consists of placing a painting of an image onto a plate and then laying a sheet of paper on top to create the print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monotypists"@en .

aat:300438671 a skos:Concept ;
    skos:definition "People who prepare the set for a film, theater production, etc. with props and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "set dressers"@en .

aat:300438673 a skos:Concept ;
    skos:definition "Small three-legged tables or stands; also, table-like stands for tea caddies. The term is of Anglo-Indian origin, originally from the Hindu word \"tepai\" for tripod. From ca. 1810, the term was used specifically for small tables used to support tea caddies or tea chests, whether or not the table had three legs. Teapoys were often fitted with various compartments for storing tea. The stand may be one with, or dettachable from, the tea chest or caddy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teapoys"@en .

aat:300438674 a skos:Concept ;
    skos:definition "Tables having an ornamental parapet or railing running along the edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleried tables"@en .

aat:300438675 a skos:Concept ;
    skos:definition "Table tops, usually relatively simple, that are placed upon pedestals, saw horses, or other supporting structures to form a table. They may be stored separately from the base, and assembled as needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table boards"@en .

aat:300438676 a skos:Concept ;
    skos:definition "Tables intended for use in dining at special occasions; may be large and elaborate in design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquet tables"@en .

aat:300438677 a skos:Concept ;
    skos:definition "Relatively small cases of cabinet-work made to hold wine bottles. They may be lined with lead or another water-impervious material, in order to hold cold water or ice. For larger pieces of case furniture used to hold wine or other alcohol, prefer \"cellaret sideboards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine cellarets"@en .

aat:300438678 a skos:Concept ;
    skos:definition "Pots or flagons for holding wine, often ceramic or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine pots"@en .

aat:300438679 a skos:Concept ;
    skos:definition "Relatively large vessels or basins used for chilling wine at the dinner table; usually ceramic or metal, often richly ornamented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine cisterns"@en .

aat:300438680 a skos:Concept ;
    skos:definition "Étagères and similar shelved stands intended to hold potted flowers, sometimes other small plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower étagères"@en .

aat:300438681 a skos:Concept ;
    skos:definition "Stands intended specfically to hold flowers, usually cut flowers. May be small table-top items or larger stands, used for decoration or for selling flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower stands"@en .

aat:300438682 a skos:Concept ;
    skos:definition "Small tables or tall stands intended to hold bouquets of flowers in decorative vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower tables"@en .

aat:300438683 a skos:Concept ;
    skos:definition "Dressing tables, usually relatively small, having an attached mirror and usually a matching seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vanities"@en .

aat:300438684 a skos:Concept ;
    skos:definition "Games, existing in several variations globally and through history, having in common that they are all played on a board with two rows of 12 vertical points, and dice are rolled to determine the movement of pieces. Backgammon is a modern western variety of these games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables"@en .

aat:300438685 a skos:Concept ;
    skos:definition "Game for two players played on a special board; players have fifteen markers each, which they move around the board according to rolls of the dice. It evolved from other \"tables\" games in France ca. 1500. While the boards are similar, tric-trac differs from backgammon in that racing is not such a significant part of the game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tric-trac"@en .

aat:300438686 a skos:Concept ;
    skos:definition "Ancient game played in Rome and Byzantine Empire, similar to modern backgammon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabula"@en .

aat:300438688 a skos:Concept ;
    skos:definition "Board game played in ancient Egypt and adjacent cultures, using game pieces and a gameboard grid of 30 squares arranged in three rows of ten."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senet"@en .

aat:300438689 a skos:Concept ;
    skos:definition "Boards marked to allow the playing of backgammon. The board may consist of two panels, usually united by a hinge, allowing for game pieces to move as determined by throws of the dice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backgammon boards"@en .

aat:300438690 a skos:Concept ;
    skos:definition "Tables having tops marked with a checkerboard pattern of 64 squares for the purpose of playing the game of checkers. Chess may also be played on the same board. Traditionally, checkerboards will comprise alternating black and red squares, although any contrasting colors may be used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checker tables"@en .

aat:300438691 a skos:Concept ;
    skos:definition "Boards that generally consist of two panels (usually hinged), used with game pieces that are moved as determined by throws of the dice. The boards typically have twelve holes along the base of each side, used for scoring. Similar to \"backgammon boards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tric-trac boards"@en .

aat:300438692 a skos:Concept ;
    skos:definition "Containers, usually decorative, for storing board gamesor other gaming pieces. The boards for the games may form part of a lid or other surface integral to the box."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "game boxes"@en .

aat:300438693 a skos:Concept ;
    skos:definition "Narrow tables, often with a mirror, generally situated near the front door of a home; may be in a hallway or vestibule, may be adjacent to a hat rack or coat rack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hall tables"@en .

aat:300438694 a skos:Concept ;
    skos:definition "Large tables situated in the main room or great hall of a manor house or other large, stately home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great tables"@en .

aat:300438695 a skos:Concept ;
    skos:definition "Unusally long tables used in larger homes, particularly in historical England and colonial America, for large dinner gatherings or other purposes. Typical examples were around three feet wide and 10 or 12 feet long."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long tables"@en .

aat:300438696 a skos:Concept ;
    skos:definition "Tables constructed so that the tabletop is set upon a base or stand constructed using mortise-and-tenon joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joined tables"@en .

aat:300438697 a skos:Concept ;
    skos:definition "Distinctive censers, suspended by chains, used for rituals and liturgies. A thurible usually comprises a metal receptacle, often with a pierced cover, containing combustible material to burn gums used as incense; swung by hand or hung on a stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thuribles"@en .

aat:300438698 a skos:Concept ;
    skos:definition "In ancient Rome, an incense box, usually made out of precious metal but also sometimes of wood or marble, used in sacrifices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acerras"@en .

aat:300438699 a skos:Concept ;
    skos:definition "In ancient Rome, a small, portable altar where perfumes were burnt, placed before the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acerras"@en .

aat:300438700 a skos:Concept ;
    skos:definition "Shoes of various styles made of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wooden shoes"@en .

aat:300438702 a skos:Concept ;
    skos:definition "Any of various devices or pieces of material used to reduce shock, friction, or damage due to the contact between two surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffers"@en .

aat:300438703 a skos:Concept ;
    skos:definition "A mineral that appears as yellowish, brownish, or ruby-red hexagonal crystals, consisting of a lead vanadate and chloride of the opatite group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vanadinite"@en .

aat:300438704 a skos:Concept ;
    skos:definition "Specialized monitoring devices that utilize a sex pheromone attractant to lure a particular insect to the trap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pheromone traps"@en .

aat:300438705 a skos:Concept ;
    skos:definition "Chemical additives that are part of the dyeing process that allow the dyeing to be carried out more effectively. These may include reducing agents for dyeing with vat dyes or that improve the level of dyeing, better fastness, or other aspects of the dyeing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dyeing auxiliaries"@en .

aat:300438706 a skos:Concept ;
    skos:definition "Lightweight infantryman's helmet, characterized by an almond-shaped bowl, a short brim, with a distinctive turned-back point at the apex. They are more similar to \"cabassets\" than \"morions.\" However, they were called \"Spanish morions,\" referring to their being preferred by Spanish troops, although usually manufactured in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish morions"@en .

aat:300438707 a skos:Concept ;
    skos:definition "Rooms or sheds for the storage of ale and wine. For rooms for storing wine that are fully or partially below ground, use \"wine cellars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitcher houses"@en .

aat:300438708 a skos:Concept ;
    skos:definition "Rooms or structures for storing and safekeeping bottles or barrels of wine; often climate-controlled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine vaults"@en .

aat:300438709 a skos:Concept ;
    skos:definition "Instruments pierced with a hole, used in pre-Columbian times for the purpose of \"seeing\". Literally, \"That by which one sees\". Attribute of several deities such as Tezcatlipoca and Xiuhteuctli. According to the sources, could have been made of gold, in mosaic of feathers. Sometimes compared to a mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlachiyaloni"@en .

aat:300438710 a skos:Concept ;
    skos:definition "Socio-political movement and critical theory asserting the collective rights and identities of Indigenous people, primarily in the United States and Canada. First formulated in the early 20th century with the development of Native-led political organizations like the National Congress of American Indians (NCAI) and the American Indian Movement (AIM)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pan-Indian movement"@en .

aat:300438711 a skos:Concept ;
    skos:definition "Spanish soldiers, particularly those operating as military sorce during the Spanish conquest of Mexico and Peru in the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conquistadors"@en .

aat:300438712 a skos:Concept ;
    skos:definition "A springtime festival celebrating the deities Huitzilopochtli and Tezcatlipoca after which the veintena (a period of twenty days in the Nahua calendar) is also named. A famous massacre occured during Toxcatl in the year Ome Tecpatl (Two Flint, or 1520) when a small force led by Spanish conquistadores attacked celebrants in the temple precinct of Tenochtitlan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toxcatl"@en .

aat:300438713 a skos:Concept ;
    skos:definition "A cement formulation used to adhere and waterproof stained glass or leaded glass in windows. It consists in a combination of calcium carbonate, Plaster of Paris and boiled linseed oil thinned with mineral turpentine and and colored with lamp black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leadlight cement"@en .

aat:300438714 a skos:Concept ;
    skos:definition "The environmental impact of greenhouse gases, specifically carbon dioxide, emitted by a process or activity, including an individual's actions or a product's manufacture and transport during a given period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon footprint"@en .

aat:300438716 a skos:Concept ;
    skos:definition "Language spoken in rural areas of San Luis Potosí and northern Veracruz; related to the Mayan languages spoken further south and east in Mexico and Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huastec"@en .

aat:300438718 a skos:Concept ;
    skos:definition "Mixtures of surfactants, cosurfactants, electrolytes, hydrocarbon, and water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micellar solution"@en .

aat:300438719 a skos:Concept ;
    skos:definition "An alkane that consists of pentane bearing two methyl substituents at position 2 and a single methyl substituent at position 4. It occurs as a byproduct of the manufacture, use, and disposal of products associated with the petroleum and gasoline industry. In conservation, it is used as a solvent for cleaning and as a component to protective coatings, among other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isooctane"@en .

aat:300438720 a skos:Concept ;
    skos:definition "Factories where strong sugarcane drink is made by the process of distilling; may also produce ethanol and sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugarcane distilleries"@en .

aat:300438721 a skos:Concept ;
    skos:definition "Buildings, usually run by a charity, where people who have no home can stay for a short time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night shelters"@en .

aat:300438723 a skos:Concept ;
    skos:definition "A compound belonging to the family of dicarboxylic acids and derivatives; organic compounds containing exactly two carboxylic acid groups of carbonic acid and ethanol with the formula OC(OCH2CH3)2, appearing as a colorless liquid with an inoffensive odor and a flash point of 77 degrees Fahrenheit. Insoluble and less dense than water, it will float on the surface. In conservation, it has been used as a solvent to remove adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diethyl carbonate"@en .

aat:300438724 a skos:Concept ;
    skos:definition "A colorless strong-smelling cyclic hydrocarbon obtained from petroleum or by hydrogenating benzene. The structure is an aliphatic cyclic hydrocarbon. It is a common solvent that is used in organic synthesis, particularly the production of nylon. It dissolves many types of materials such as cellulose ethers, fats, oils, and rubber. Cyclohexane is often used in varnish and paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclohexane"@en .

aat:300438725 a skos:Concept ;
    skos:definition "An aqueous solution of calcium carbonate dissolved in carbonic acid. Calcium bicarbonate has been used as a neutralization and alkalization agent in paper conservation. Chemical formula: Ca(HCO3)2."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium bicarbonate"@en .

aat:300438726 a skos:Concept ;
    skos:definition "The knowledge held in an organization by its employees including personal information that provides an understanding of the history and culture of the organization, especially undocumented anecdotes that explain the logic behind certain decisions or procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "institutional memory"@en .

aat:300438727 a skos:Concept ;
    skos:definition "Very thin biomaterials made of pure cellulose from various species of wood or plants, with a neutral pH. In conservation, it is used for various treatments including the conservation of paper-based objects made of translucent or transparent supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanocellulose films"@en .

aat:300438730 a skos:Concept ;
    skos:definition "Religious tradition formulated in ca. 700s CE Japan, comprising beliefs from Shinto, Shingon Buddhism, and Taoism. Developed by legendary Buddhist monk En no Gyōja (ca. 634-701), also known as En the Ascetic. Particularly focuses on completing challenging physical feats, such as reciting sutras under waterfalls or fasting, as well as seclusion from worldly desires in mountain and forest temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shugendō"@en .

aat:300438732 a skos:Concept ;
    skos:definition "Those who project images or operate a film projector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projectionists"@en .

aat:300438733 a skos:Concept ;
    skos:definition "People who polish surfaces, often a craftsperson in the production process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polishers"@en .

aat:300438734 a skos:Concept ;
    skos:definition "Having attributes or characteristics of two genders, particularly designating a person whose identity encompasses two genders. This term may be combined with other gender identities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigender"@en .

aat:300438735 a skos:Concept ;
    skos:definition "Designates the state of a person or persons that do not identify as belonging to any particular gender."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agender"@en .

aat:300438737 a skos:Concept ;
    skos:definition "The state or condition of identifying outside a male/female gender binary, specifically people who do not identify with a single fixed gender; having or expressing a fluid or unfixed gender identity or fluctuating between gender and expressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender-fluid"@en .

aat:300438738 a skos:Concept ;
    skos:definition "Describes the state of people who do not subscribe to conventional gender distinctions, but identify with neither, both, or a combination of male and female genders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genderqueer"@en .

aat:300438739 a skos:Concept ;
    skos:definition "Existing or occurring between the sexes; that which does not match a biological sex binary, or having or combining the characteristics of both sexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intersex"@en .

aat:300438740 a skos:Concept ;
    skos:definition "Embodying multiple genders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polygender"@en .

aat:300438741 a skos:Concept ;
    skos:definition "Describes the state or condition relating to anatomy that matches the biological sex binary, that is, not intersex. A dyadic state may be any gender identity, including transgender."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dyadic"@en .

aat:300438742 a skos:Concept ;
    skos:definition "The state of an individual being unsure of their own gender or sexual orientation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "questioning"@en .

aat:300438744 a skos:Concept ;
    skos:definition "A broad term used for a variety of non-binary sexual expressions of individual indigenous North American people. More specific terms are unique to language groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-spirit"@en .

aat:300438745 a skos:Concept ;
    skos:definition "Describes the external appearance of an individual's gender identity. This may be presented through manner, clothing or other physical manifestations, and which may or may not conform to common determinations of what is masculine or feminine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender expression"@en .

aat:300438746 a skos:Concept ;
    skos:definition "Describes a condition of hatred or fear of transgender people, and by extension discrimination based on those with transgender identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transphobia"@en .

aat:300438748 a skos:Concept ;
    skos:definition "Encompassing all kinds of sexuality; not limited or inhibited in sexual choice with regards to biological sex, gender identity, or sexual practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pansexual"@en .

aat:300438755 a skos:Concept ;
    skos:definition "The state of discomfort or discontent with the physical or social aspects of one's own sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender dysphoria"@en .

aat:300438756 a skos:Concept ;
    skos:definition "A type of intimate mixture in which is embedded polymeric molecules, resulting in high viscosity. Other materials, such as solvents or chelating agents, may be added to the dispersion to increase its efficacy. Its texture can be described as that of a peelable gel. In conservation, it has been used in the cleaning of paintings and removing adhesives as it leaves no residue. An example is an HPVD made of polyvinyl acetate (PVAc) molecules crosslinked with borax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "highly viscous polymeric dispersion"@en .

aat:300438757 a skos:Concept ;
    skos:definition "Flexible fiberglass or bamboo sticks used braced against a frame to provide clamping pressure, used in a traditional Japanese method that applies controlled pressure during the consolidation of objects or when adhering parts into position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shimbari"@en .

aat:300438758 a skos:Concept ;
    skos:definition "Denotes the attribute of a material or object being prepared or created in advance of an action or use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "premade"@en .

aat:300438759 a skos:Concept ;
    skos:definition "New Year of the Thao people happens every August in the Lunar calendar, and Lus’an is held in honor of apu (“the ancestral spirit”) during the period. If the tribe has a lotsu or pariqaz, the new year would assume a large-scale celebration lasting up to an entire month; if no, the small-scale celebration of the new year last from three to five days. Lus’an entails a series of religious observance, led by shinshi and leaders from different ulalaluan units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lus’an"@en .

aat:300438760 a skos:Concept ;
    skos:definition "Palilin is a Kavalan family worship of ancestors held by female seniors during the new year celebration. In the tribe of Paterongan, Palilin takes on two forms known as the Kavalan and Torbuwan.The Kavalan-style palilin takes place at midnight on a date selected from December 26 to 28, with offerings including rak (“wine”) and sukue (“new year pastry”). Three rounds of libation should be poured, and the sukue is to be broken into smaller pieces while the prayer is being said as an act of offering. If there is a family member or friend visiting the household, the visitor should be invited to make his or her share of offering known as paspaw. The Torbuwan –style palilin underscores fasting and abstaining from sex. Spring onion, garlic, fish and pork are prohibited during this period. Before the ritual, the hostess should butcher a cock with a loud voice without shedding its blood as the sacrifice; on the following day only seaweed and fruits are allowed for consumption before noon. The cock may be eaten after the ritual is over.The difference between the two styles reflects the migration and evolution that the Kavalan culture has gone through, while both styles highlight continuity and sharing of blessing and good health through celebrating the new year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palilin"@en .

aat:300438761 a skos:Concept ;
    skos:definition "Mgay Bari is a festival restored by contemporary Truku people upon a common agreement. Mgay Bari is set up to strengthen the cultural integrity of Truku with the influx of Christian faith, the loss of their tradition and the movement petitioning for official recognition, in hopes of reviving the traditional Truku culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mgay Bari"@en .

aat:300438762 a skos:Concept ;
    skos:definition "Palamal is a Sakizaya ritual that worships the Sakizaya ancestors and commemorates the historical trauma of Takubuwan Incident. In 1878, under the aegis of the policy of “opening up the mountains and civilizing the savages,” the Qing army entered eastern Taiwan and waged battles with the Sakizaya and Kavalan peoples who then dominated the Qilai plain in Hualien. During the invasion the Sakizaya chief Komod Pazik and his wife Icep Kanasaw were tortured to death and the Sakizaya people was set into a diaspora.In 2006, the Sakizaya people held a memorial ceremony at what used to be the site of Takubuwan tribe in Hualien city. “Fire,” as the ceremony pamphlet describes, “brought down the people, but also lit up the way out for the refugees.” The memorial thus held fire as its central theme and consecrated the chief and his wife as the lord and lady of fire who are the national heroes of Sakizaya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palamal"@en .

aat:300438763 a skos:Concept ;
    skos:definition "“Smratuc” refers to the sowing festival in Seediq. During the period in which the Seediq people live on hunting and crops, the sowing festival takes place in February and March each year, lasting for three days or so. On the third day of the rite, the whole tribe would be led by the priest to the venue for worship in which each family prays for harvest and prosperity. They would use a stick to stir the rice and millet spread in a trap made of stone slabs in the venue and pray for harvest and health for the family members at the same time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Smratuc"@en .

aat:300438764 a skos:Concept ;
    skos:definition "Miatungusu is a major festival of the Hla’alua people after the harvest of rice. It is traditionally held once every two to three years, now it is an annual event. The festival is devoted to takiarʉ (“the sacred shell”), a sacred being left by the kavurua people. The ritual includes welcoming the gods, initiation, hog sacrifice, wine offering to takiarʉ, expelling evil spirits and the distribution of game. It is believed that through pleasing the sacred shell harvest and prosperity can be brought to the Hla’alua people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miatungusu"@en .

aat:300438765 a skos:Concept ;
    skos:definition "The festival of Mikong is the Kanakanavu people’s celebration of millet harvest in honor of their millet god, tamu vinaʉ. Today, the festival is held in October on an annual basis. The festival takes place after the millet harvest, proceeding from family prayers, making rice cakes (“pepe”), presenting offerings to the millet god to bidding farewell to the millet god. Once the family ritual is over, each family is to bring their home-made pepe, wine and fish to cakʉrʉ (“tribal meeting place”) to attend tribal worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mikong"@en .

aat:300438766 a skos:Concept ;
    skos:definition "Pas-vake is part of the traditional Saisiyat agricultural ceremony. It takes place twice a year; the first festival comes after the sowing is over, addressing to the ancestral spirits that the task has been completed, and the second one happens after the harvest. The significance of Pas-vake is twofold: in religious terms the festival invites the ancestors to share the food with the living Saisiyat people through rituals and asks for the ancestors’ favor at the same time; for economic purposes Pas-vake is an occasion in which people supplicates for good fortune in farming and hunting. Pas-vake also confirms and consolidates the identity conferred by the Pas-vakean to its members as a way to come to terms with and symbolically transcend the difference of backgrounds and geographical origins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pas-vake"@en .

aat:300438767 a skos:Concept ;
    skos:definition "Sea or river worship in the Amis culture has two types: one is an annual ceremony and the other is a ritual collective fishing taking place before and after an event recognized as important by the members of the tribe. The annual ceremony happens every May, involving the collective fishing, offering and sharing the catch of men organized in age classes. It has a pedagogical significance and also serves as an occasion to pay tribute to the sea gods with gifts to pray for prosperity and safety.Collective fishing, known as Pakelang, enjoins people to fish together and share the catch to mark the end of major life events such as marriage, funeral, construction of new houses and farm work. The contact with water and the consumption of fish mark the return to daily norm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sea/river worship"@en .

aat:300438768 a skos:Concept ;
    skos:definition "Indohdohan celebrates the babies born to the tribe and is one of the traditional rites of passage in the Bunun culture. It takes place at full moon between the harvest festival (known as Cin-san) and the storage festival (known as An-daza). New born babies are introduced to the members of the tribe and a blessing necklace will be put on to their necks.The necklace is called matalunas and it is made of glass beads. It is among the inventory of things that the baby’s parents should prepare before Indohdohan; other objects include home-made millet wine and puh-da (“millet cake”). The mother will kill a rooster and put the necklace on babies according to the order of their birth time. The father will invite tauta-tagus to give blessing to the babies, and invited guests are to give a round of gallantry report known as mapulau. Finally there will be a party in which people share millet cakes. The necklace will be removed and carefully preserved by nightfall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indohdohan"@en .

aat:300438769 a skos:Concept ;
    skos:definition "Millet is the traditional staple of the Pinuyumayan people. Every July each tribe holds a harvest festival with different proceedings and denomination. In the tribe of Kapitol (Zhiben area), a pole known as talingel will be set up to mark the festival and the celebration involves wrestling (known as malalius) and street procession. Wrestling is also on the agenda of the tribes of Pinaski and Puyuma; the latter’s celebration, additionally, involves dancing and outings to Mount Dulan, Green Island and Orchard Island. In the Murivurivuk tribe at Chulu, the celebration entails drimiakulu (“swinging”) and dremadodas (“rattan ball piercing”)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Millet harvest festival"@en .

aat:300438770 a skos:Concept ;
    skos:definition "Qatapan used to be the celebratory singing and dancing after satapan (“head hunting”). Over the years its religious significance takes up a festive and performative turn. Qatapan is now regularly put on show in tribes, local chapels, Kavalan societies, campaign gatherings and national concert halls. Upon their return, the head-hunters dressed in straw cape and with a walking stick hang the heads on a long rod, circled by warriors and seniors chanting spaw and toasting. Legend has it that it will rain after the chanting to purge the people. The Japanese rule severely proscribed the Kavalan’s head hunting and the ritual was thus suspended. By the 1970s the nature of Qatapan shifted significantly as the Kavalan people tend to organize harvest festival together with the Amis as their long-established matrimonial kin. Even if the festival bears the same name, the head hunting hymn of spaw is no longer sung. With the campaign for recognition in the 1908s, the revival of the traditional ritual took up the form of circular dancing around a type of tree called Palaquium formosanum, and one of the hymns known as miomio has been adapted with modified lyrics as a precious cultural heritage constituent of the Kavalan identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qatapan"@en .

aat:300438771 a skos:Concept ;
    skos:definition "Malalikid is a major Sakizaya festival. Pre-ritual welcoming of the ancestral spirits such as minahanah practiced in the Maliyun tribe and padongi’ in the Sakur tribe is essential to the Salizaya way of worship. Other proceedings include visiting the mourning families and tribe forum foreground the importance of mapalaway i.e. the Salizaya priest. Another practice that distinguishes the Maliyun tribe in Ruisui Township from the Amis around Xiuguluan River is that they hold bihkac, a bird-catching ritual. In miliwliw, a ritual in which the Salizaya youth is summoned, shows how the social organization based on age class known as masaselal occupies a central place in collective mobilization in preparation for annual festivals.According to report of the Sakizaya scholar, Hong Qingyi (2008), members of the age class system are to gather rattan and butcher a hog to collect its liver and heart for ceremonial purposes. On the first day of the festival, men bring game and meet at dabek (men’s hall) for a purging dance; the welcoming of spirits and announcement take place in the morning on the following day, and all men are to have lunch with their age class fellows in a banquet. Guests are feasted on the third day with continuous singing and dancing. Finally, people go through pakelang (“collective fishing”) and group chat to reflect on the undertakings to mark the end of celebration and return to everyday life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malalikid"@en .

aat:300438772 a skos:Concept ;
    skos:definition "Cultures and styles of the Amis people lived in Taiwan. The Amis people refer to themselves in two ways: Pangcah meaning “we people” is used in regions north of Taitung, and Amis meaning “northerners” is used in the south. The denomination has to do with routes of migration and interaction among tribes. The Chinese term came to adapt Amis. The Amis territory stretches from the Qilai plain to the Hengchun peninsula, where the Amis people develop an agrarian culture intricately rooted in the low lands of Taiwan’s eastern valley and coastal plains. The Amis has the largest population of aboriginals in Taiwan.There are three subcategories of the Amis people based on geographical and cultural-linguistic differences: The Northern group of “Nanshi” Amis, the Middle group of “Xiuguluan” Amis and coastal Amis, and the Southern group of “Falangaw” Amis and Hengchun Amis.The property inheritance of the Amis is matrilineal and traditional matrimony follows the rule of mikadafo which marries Amis men into the brides’ homes. The Amis tribe is co-governed by clan chiefs, who assign responsibilities and tasks to male members of different age classes. The Harvest Festival, known as Malalikid, is the most important celebration which unifies traditional beliefs, social structure and tribal identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amis"@en .

aat:300438773 a skos:Concept ;
    skos:definition "Cultures and styles of the Atayal people lived in Taiwan. The Atayal people live primarily in the mountains of northern Taiwan, ranging from New Taipei City, Taoyuan City, Hsinchu County, Miaoli County, Nantou County and Nantou City. Though systematic and regional variations are found in different tribes, the concept and practice of gaga and rutux unify the Atayal people as a whole. Important festivals include the sowing festival, the harvest and the worship of ancestral spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Atayal"@en .

aat:300438774 a skos:Concept ;
    skos:definition "Cultures and styles of the Paiwan people lived in Taiwan. The Paiwan people primarily reside on the hills in Pingtung and Taitung. They used to be perceived as identical to the Rukai people. Paiwan contains two divisions, the Raval and the Butsul. The Paiwan society consists of a caste system ruled by aristocratic families, and the basic social unit is an “umaq” and its members. Maljeveq is Paiwan’s most renowned festival."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paiwan"@en .

aat:300438775 a skos:Concept ;
    skos:definition "Mountain Range in Taiwan, including Nantou, Kaohsiung, Hualien and Taitung, typical of mountain aboriginals.The Bunun society is a patrilineal hierarchy composed of big clans on the top, followed by middle clans, small clans and families. The interrelations between clans are clearly defined and there are rigid regulations imposed on incest.Traditional Bunun farming has developed sophisticated skills in rearing millet in highlands corresponding to a calendar with set rituals. The Bunun material culture emphasize function and simplicity, while the Bunun people value dynamic harmony between hanitu (“soul; spirit”) and is-ang (“heart”) as the ideal for personal development. This not only sets up the undertone of the Bunun religious life, but also motivates individual to achieve what the individual’s talents and recognition point toward, forming an egalitarian sense in the Bunun society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bunun"@en .

aat:300438776 a skos:Concept ;
    skos:definition "The Pinuyumayan social organization is characterized by the men’s hall system composed of different age class. Before coming of age, boys are required to enter junior’s hall known as takuban and they will enter adult’s hall known as palakuan when they are mature. A mature man is allowed to marry and should contribute to the tribe’s work force. The Pinuyumayan secular power is held by a number of families in corporation with religious leaders.The acknowledgement that the Pinuyumayan is a matrilineal society used to be a firm one, since the husbands are married into the brides’ house, the Pinuyumayan children belong to the maternal side and the Pinuyumayan daughters are heir to the family property. Traditional Pinuyumayan rituals can be conducted by psychics or priests. The psychic is able to purify the patient and deal with diseases, while the priest’s responsibility is to hold rituals to ensure collective protect. Both psychics and priests are important to personal rite of passage and annual festivals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinuyumayan"@en .

aat:300438777 a skos:Concept ;
    skos:definition "Cultures and styles of the Rukai people lived in Taiwan. The Rukai people primarily live in southern Taiwan, including mountainous regions in Pintung, Kaohsiung, and Taitung. They were regarded as identical to Paiwan under the Japanese rule, while the recognition of their ethnical uniqueness is conferred due to linguistic and cultural differences. The Rukai dialect clusters include: Wutai, Dawu, Taromak, Wanshan, Duona and Maolin. The Rukai society is ruled by aristocracy and the family is counted as the basic social unit. Each family entails a family house, a family name and its members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rukai"@en .

aat:300438778 a skos:Concept ;
    skos:definition "Cultures and styles of the Tsou people lived in Taiwan. The Tsou people primarily reside in Alishan Township, Chiayi County; some of them can also be found in Xinyi Township, Nantou County. The Tsou people are historically known as Cou, and they are famous for Mayasvi, a festival honoring the war god. There are two kinds of Tsou tribes, hosa and denohiyu; hosa ranks higher than denohiyu and the former possesses kuba (“main hall”) as the symbol of its power. The Tsou society is patriarchic and the basic social unit is family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsou"@en .

aat:300438779 a skos:Concept ;
    skos:definition "Cultures and styles of the Tao people lived in Taiwan. The Tao people take residence on Orchid Island off the coast of Taitung. They primarily live on the subsistence of fish and taro crops, which are core to the Tao material culture. The Tao society is marked by monogamy and bilateralism. Their major festivals revolve around the traditional economy such as the crops of millet and taro and the annual catch of flying fish. Miyaron (“flying fish festival”) is their most renowned celebration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tao"@en .

aat:300438780 a skos:Concept ;
    skos:definition "Cultures and styles of the Thao people lived in Taiwan. The Thao people primarily live in Yuchi Township and Shuili Township, Nantou County. Thao used to be categorized as one of the branches of the Tsou people. In 2001 it gained official recognition as an indigenous people. Thao’s social organization revolves around patriarchal clans and families, passing on hereditary roles from generation to generation. Tribal politics, economy and religious office follow the organization of clans as well. The major festival of the Thao people is the worship of ancestral spirits in August in the Lunar calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thao"@en .

aat:300438781 a skos:Concept ;
    skos:definition "Cultures and styles of the Kavalan people lived in Taiwan. The Kavalan people primarily live in Yilan. The word Kavalan derives from the place of the people’s landing form the sea. The word can also be traced to Kuvarawan (“people of the plain”) as opposed to Pusoram (“people of the mountains”). In the eighteenth century the Kavalan people was driven south to the Qilai plain in Hualien by agrarian settlers, and they were forced again to move to the coasts and the valley with the Qing invasion near the end of the nineteenth century. As a result of a long-term cohabitation of the Kavalan people with the Amis people, the Kavalan culture has borrowed some aspects from the Amis and the process involved a certain degree of mutual assimilation. Yet distinct Kavalan character can still be discerned from the Kavalan language and rituals, which serve as important markers of the Kavalan identity throughout the campaign."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kavalan"@en .

aat:300438782 a skos:Concept ;
    skos:definition "Cultures and styles of the Truku people lived in Taiwan. The Truku people primarily reside in the Xiulin Township and Wanrong Township in Hualien County. It used to be perceived as identical to the Atayal people because of the kinship between their language and culture. However, considerable difference exists in these fields, leading up to Truku’s official recognition in 2004. The everyday praxis of Truku culture centers on the utux belief and the regulations set up by gaya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Truku"@en .

aat:300438783 a skos:Concept ;
    skos:definition "Cultures and styles of the Sakizaya people lived in Taiwan. The Sakizaya people used to be perceived as identical to the Nanshi group of Amis and gained official recognition in 2007. The most Sakizaya people are living in the Qilai plain and the northern tip of the Huatung valley and Taiwan’s east coasts. Tribes with a denser population are located in the Guofu Village and the Townships of Beipu, Shuilien, Jichi, Maliyun and Shanxing in Hualien.In 1878 the Qing army attacked the tribes of Sakizaya and that of the Kavalan and the incident was known as the Takubuwan Incident. The Sakizaya bore the brunt of the strike and migrated to mingle with the Amis people who shared a cultural similarity with Sakizaya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sakizaya"@en .

aat:300438784 a skos:Concept ;
    skos:definition "Cultures and styles of the Seediq people lived in Taiwan. In 2008 Seediq was officially recognized as an ethnic group distinct from the Truku people. The Seediq people primarily live in Renai Township, Nantou County and Hualien County. The Seediq language is constituted by three dialect clusters: Tada, Tgdaya and Truku. The traditional life centers on gaya (waya) and the belief in utux, while their social protocol has evolved through the encounter with the modern state and Christianity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seediq"@en .

aat:300438785 a skos:Concept ;
    skos:definition "Cultures and styles of the Hla’alua people lived in Taiwan. The Hla’alua people was officially recognized as distinct from the Tsou people in 2014. As it consists of four tribes – Paiciana, Vilanganu, Hlihlala and Talicia – it used to be called by the Han Chinese as the “four-tribe huan.” Under the Japanese rule the Hla’alua people used to be perceived as a Tsou branch by the colonial official. They primarily live in Taoyuan District, Kaohsiung City. Patriarchic clans are core of the Hla’alua social organization, and their major festival is Miatungusu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hla’alua"@en .

aat:300438786 a skos:Concept ;
    skos:definition "Cultures and styles of the Kanakanavu people lived in Taiwan. The Kanakanavu people attained official recognition as distinct from the Tsou people in 2014. In the Qing dynasty the Han Chinese referred to the Kanakanavu people as kanavu-huan; and, the Japanese grouped them under the rubric of Tsou. The Kanakanavu people primarily live in Namaxia District, Kaohsiung City. The society is dominated by patriarchy, running the Mikong festival and the river festival as major celebrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kanakanavu"@en .

aat:300438789 a skos:Concept ;
    skos:definition "Cultures and styles of the Saisiyat people lived in Taiwan. The Saisiyat people primarily live in Wufeng Township, Hsinchu County; Nanzuang Township and Shitan Township, Miaoli County. The Saisiyat society is composed of patriarchy and clans bearing different sinraehoe’ (“family names”). These clans form into different sets of Pas-vakean as the basic religious unit with which the traditional Saisiyat rituals proceed. The Saisiyat culture is famous for Pas-taai (“Ritual to the Short People”)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saisiyat"@en .

aat:300438790 a skos:Concept ;
    skos:definition "Artists who specialize in art interventions, which are works or performances designed specifically to interact with an existing structure or situation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interventionist artists"@en .

aat:300438791 a skos:Concept ;
    skos:definition "A polysaccharide, gluten-free additive produced from a fermented bacterial secretion that is used in cosmetics and food as a thickener or stabilizer. In art conservation, it can be used to make oil-in-water emulsions for non-water-miscible solvents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xanthan gum"@en .

aat:300438792 a skos:Concept ;
    skos:definition "A compound that appears as a white powder prepared by treating acetic acid with calcium carbonate or lime. It is a water-soluble compound that has been used for aqueous and nonaqueous neutralization and alkalization of paper. However, during the neutralization process, calcium acetate is converted to calcium carbonate with the release of acetic acid. Any residual calcium acetate will continue to release acetic acid. Calcium acetate is used commercially as a mordant in dyeing and printing textiles, for liming rosin, for curing and tanning skins, and as a metallic soap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium acetate"@en .

aat:300438793 a skos:Concept ;
    skos:definition "Heating mats that provide an even and steady precision heat transfer from the lower/mild temperature range (20°C to 40°C) up to the more traditionally used higher range (40°C to 85°C). Equipped with advanced sensing and controls, its flexible materials allows it to be portable, customizable in size, and able to conform to textured 3D surfaces. Recent developments include the use of nanomaterials as developed by the European IMAT program."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mild heat transfer mats"@en .

aat:300438794 a skos:Concept ;
    skos:definition "Objects comprising upright wooden sticks with folded paper attached, forming a zigzag pattern on each side. The type of folding and paper varies based on the type of gohei and its related religious functions. Feature of Shinto practices; often placed in Shinto shrines or temples, either as an offering or as an indication of a deity's presence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gohei"@en .

aat:300438795 a skos:Concept ;
    skos:definition "Ropes made of rice straw, hemp, or other fibers woven together, often used for ritual purification of sites. Strung across torii or Shinto shrines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shimenawa"@en .

aat:300438796 a skos:Concept ;
    skos:definition "System of logograms or ideographs for writing Chinese in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanzi"@en .

aat:300438797 a skos:Concept ;
    skos:definition "General term for the system of symbols, developed in China; used for writing in several Asian languages, each of which can have distinct variations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese characters"@en .

aat:300438798 a skos:Concept ;
    skos:definition "Marks or symbols, particularly those that are incised or inscribed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glyphs"@en .

aat:300438799 a skos:Concept ;
    skos:definition "Classes of letters and other visual symbols that represent a phoneme or cluster of phonemes, which are unit of sound in a language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphemes"@en .

aat:300438800 a skos:Concept ;
    skos:definition "In linguistics, units of sound in a language that cannot be analysed into smaller linear units and that may distinguish one word from another. For example, element \"p\" in \"tap\" separates that word from \"tab\" and “tan.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonemes"@en .

aat:300438801 a skos:Concept ;
    skos:definition "In linguistics, phonetically distinct variants of a phoneme, usually distinguished from other variants by its position in the word or by its phonetic environment. Speakers of a language often have difficulty in hearing the phonetic differences between allophones of the same phoneme, because these differences do not serve to distinguish one word from another. In English, examples would be the \"t\" sounds in the words \"hit,\" \"tin,\" and \"little.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allophones"@en .

aat:300438802 a skos:Concept ;
    skos:definition "The process or action of using a brush to remove or apply something to a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brushing"@en .

aat:300438803 a skos:Concept ;
    skos:definition "A low-molecular weight urea-aldehyde resin for pigment dispersions, manufactured by BASF. It can be used in many types of coating formulations, including for varnishing and retouching. Depending on the application, it improves gloss, hardness, body, adhesion, and resistance to yellowing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laropal A81 (TM)"@en .

aat:300438804 a skos:Concept ;
    skos:definition "Describes conservation activities that are accessible by or visible to the public, usually in museums, archaeological sites, or other cultural heritage settings. As a form of public outreach, these activities are typically intended to promote education and raise awareness of heritage conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation in action"@en .

aat:300438805 a skos:Concept ;
    skos:definition "A nonwoven, low melt synthetic polyester, manufactured by Wonderflex, that softens and shrinks when heated, transforming into a rigid 3-D structure upon cooling that can be cut and sewn. In conservation, it has been used for constructing mannequins and mounts for textiles, costumes, and other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fosshape (TM)"@en .

aat:300438806 a skos:Concept ;
    skos:definition "Culture or style of the region of Moravia, in the current Czech Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moravian"@en .

aat:300438807 a skos:Concept ;
    skos:definition "Experts in sexual behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sexologists"@en .

aat:300438808 a skos:Concept ;
    skos:definition "Late Neolithic culture for which evidence is found in the historical Dobruja region, part of modern Romania and Bulgaria. It is named after the site at Baia-Hamangia, which was discovered in 1952. The status of this culture is unclear; it may represent an expansion of agricultural populations or a fusion with indigenous communities. Separate from evidence of settlements, cemeteries have been found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamangia"@en .

aat:300438809 a skos:Concept ;
    skos:definition "Cultures surmised from assemblages of artifacts that recur as to type, general date, and places of distribution, thus often held by scholars to represent the material culture remains of a particular past human society. Use of the term is debated. Some scholars note that particular types of material culture do not always relate directly to groups or societies. However, use of the term has increased in recent years in scholarly publications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological cultures"@en .

aat:300438810 a skos:Concept ;
    skos:definition "Artists who create publications consisting of comic drawings in the form of sequential juxtaposed panels, often accompanied by descriptive prose or written narrative, with dialog between characters often in the form of word ballons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comic book artists"@en .

aat:300438811 a skos:Concept ;
    skos:definition "Millstones made of the siliceous rock known as buhrstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buhrstones"@en .

aat:300438812 a skos:Concept ;
    skos:definition "People who make objects that are spherical representations of the earth or of celestial stars and constellations with its map on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globe makers"@en .

aat:300438813 a skos:Concept ;
    skos:definition "The culture and peoples occupying the section of Oceania south of the equator and north of latitude 47.00 S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australasian"@en .

aat:300438814 a skos:Concept ;
    skos:definition "Folded books comprising a series of accordion or concertina style pleats and attached at one or both ends to stiff covers. The name leporello most likely comes from the manservant Leporello in Mozart’s opera Don Giovanni, a famed rogue who keeps a tally of his conquests on a long accordion style list. In the late 19th century, leporello were common travel souvenirs consisting of depicted scenes or photographs of a region’s tourist attractions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accordion books"@en .

aat:300438816 a skos:Concept ;
    skos:definition "Any enzyme that breaks or degrades the long chainlike molecules of proteins into shorter fragments (peptides) and eventually into their components, amino acids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protease"@en .

aat:300438817 a skos:Concept ;
    skos:definition "A family of anionic polysaccharides that are obtained by alkaline extraction from some species of red seaweeds. There are three major types of carrageenan, which include iota-carrageenan (i-carrageenan), kappa-carrageenan (κ-carrageenan), and lambda-carrageenan (λ-carrageenan). In conservation, it is used as a hydrogel in paintings consolidation, among other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrageenan"@en .

aat:300438818 a skos:Concept ;
    skos:definition "Hats designed or used for the activity of hunting, which is chasing game or other wild animals, for sustenance, profit, or sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting hats"@en .

aat:300438819 a skos:Concept ;
    skos:definition "General term for structures or configurations of stones stacked upon each other, serving as landmarks, trail markers, monuments, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacked rocks"@en .

aat:300438820 a skos:Concept ;
    skos:definition "Genus including North American species of bamboo; some classifications also include various Asian species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arundinaria"@en .

aat:300438821 a skos:Concept ;
    skos:definition "Species of bamboo found in southern North America; may grow in large monotypic colonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arundinaria gigantea"@en .

aat:300438822 a skos:Concept ;
    skos:definition "The action of progressive removal of material from solid surfaces such as coral or rock, by the action of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioerosion"@en .

aat:300438823 a skos:Concept ;
    skos:definition "Handmade paper from the bark of the Tara Wing-Celtis (Pteroceltis tatarinowii) or Blue Sandalwood tree and rice straw. It was originally and continues to be produced in Jing County, now in Anhui Province in eastern China. The county was under the jurisdiction of Xuanzhou Prefecture in the Tang Dynasty (618-907), hence its name. The paper is known for its strong, smooth surface, its ability to absorb water and moisten ink, and fold repeatedly without breaking. It has been widely used in calligraphy, painting and book printing, and increasingly in conservation work. In the western world, it has at times been characterized as rice paper, although wood bark is traditionally its main ingredient with rice straw added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xuan paper"@en .

aat:300438824 a skos:Concept ;
    skos:definition "A mineral MgAl2(SO4)4.22H2O composed of a hydrous magnesium aluminum sulfate occurring in white to faintly colored fibrous masses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickeringite"@en .

aat:300438825 a skos:Concept ;
    skos:definition "Guar is a yellowish-white powder which is dispersible in hot or cold water, obtained from the seed of the guar plant Cyamopsis tetragonoloba grown commercially in India and the United States. The water-soluble portion (approx. 85% by wt.) is called guaran and consists of polysaccharides of mannose (63%) and galactose (35%) and about 5-7% wt. of protein. Aqueous solutions of guar have a neutral pH and may be turn into a gel by the addition of small amounts of Borax. Guar gum is used as dye solution thickeners in textile printing, for texture and stabilization in food products and as a strengthener in paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guar gum"@en .

aat:300438826 a skos:Concept ;
    skos:definition "An artificial sweetener made by a multi-step process that starts with ordinary table sugar (sucrose) and replaces three hydrogen-oxygen groups on the sugar molecule with three chlorine atoms. It was discovered in 1976 by researchers at Queen Elizabeth College, University of London, during a collaborative research program with UK sugar producer, Tate & Lyle, PLC. It is sold under the brand name Splenda (TM). In conservation, it has been used in the treatment of waterlogged wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sucralose"@en .

aat:300438828 a skos:Concept ;
    skos:definition "Double portraits or companion portraits that depict partners in marriage. When depicted accompanied by children or other kin, use 'family portraits'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage portraits"@en .

aat:300438829 a skos:Concept ;
    skos:definition "Visual works that depict marine scenes, specifically of harbors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harbor views"@en .

aat:300438830 a skos:Concept ;
    skos:definition "Works in which an artist is depicted by another artist. For works in which someone produces a likeness of himself or herself, use 'self-portraits.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' portraits"@en .

aat:300438831 a skos:Concept ;
    skos:definition "Visual works that depict one or more children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's portraits"@en .

aat:300438832 a skos:Concept ;
    skos:definition "Sculptural works that are carved from or applied to the elevation(s) of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facade sculptures"@en .

aat:300438833 a skos:Concept ;
    skos:definition "The sport of rowing, especially competitively in the context of a school, college, or team."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rowing"@en .

aat:300438834 a skos:Concept ;
    skos:definition "An interlacement of parts of a rope by twisting the ends about each other and then drawing tight the loops for the purpose of fastening them together or to another object or to prevent slippage. The goal is to fasten the ropes in a way they can easily be released again, without loosening themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knots"@en .

aat:300438835 a skos:Concept ;
    skos:definition "Describes shipping with inland navigation vessels for the transportation of goods and people on rivers, lakes and other inland waterways. Inland navigation vessels are used to transport cargo from and to sea-going ships, but also for conveyance of goods and passengers between places that are connected by inland waterways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inland navigation"@en .

aat:300438836 a skos:Concept ;
    skos:definition "A term historically applied in a general sense to the trade carried on between ports of the same country as distinguished from that carried on with foreign ports. Also called intercoastal navigation. According to the laws of some maritime nations, the term is also applied to the trade carried within the geographical limits of the foreign trade. The modern term \"short sea shipping\" refers to the movement of cargo and passengers mainly by sea along a coast, without crossing an ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal navigation"@en .

aat:300438837 a skos:Concept ;
    skos:definition "Relatively short and wide watercraft used for navigation of inland waterways in South-Holland, Zeeland, Brabant and the Scheldt/Rupel basin. A notable feature is the inward turned prow. These were mainly meant for cargo but occasionaly also for passenger travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hookers"@en .

aat:300438838 a skos:Concept ;
    skos:definition "Term used in maritime commerce to signify the damage or expenses resulting from the perils of marine navigation such as damage caused by storm, collision or cargo shifting. It also implies partial, as distinguished from total, loss. To be distinguished from 'general average' which refers to damage caused in shipsaving situations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "average"@en .

aat:300438839 a skos:Concept ;
    skos:definition "Dutch marine fishing vessel used on the North Sea, particularly for herring and coastal fishing. These were flat-bottomed and blunt at both ends, and were fitted with sails. A bomschuit could be moved to and from the shoreline using oxen during low tide to account for the lack of good harbors in the Netherlands. In common use from ca. 1700 until 1918 and originated from the 'pink' type of ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bomschuits"@en .

aat:300438840 a skos:Concept ;
    skos:definition "Parades consisting of floats, vehicles, boats, or participants that are decorated or covered with flowers. Floats are usually designed to illustrate a theme or represent a group, and are often judged in a competition following the parade itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower parades"@en .

aat:300438841 a skos:Concept ;
    skos:definition "Temporary decorations or pictorial works made either in interior or exterior spaces with colorfully arranged flowers or petals on the surface of the ground. Most often these are done in public squares or in churches as part of a festival, and may be of very large scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower carpets"@en .

aat:300438843 a skos:Concept ;
    skos:definition "Formal statements that recognize the unique and enduring relationships that exist between indigenous peoples and their traditional territories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land acknowledgement statements"@en .

aat:300438844 a skos:Concept ;
    skos:definition "Body of ministers responsible for the administration of a country or state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ministries"@en .

aat:300438992 a skos:Concept ;
    skos:definition "Saddlebags used for donkeys or mules, differing from saddlebags for horses in that the donkey or mule may not necessarily be ridden, so there is more accomodation for carrying objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "donkey saddlebags"@en .

aat:300439260 a skos:Concept ;
    skos:definition "Stills used to produce arak, which is an anise-flavored spirit popular in the Middle East and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arak stills"@en .

aat:300439376 a skos:Concept ;
    skos:definition "Doors protecting the window-like openings in grain storage buildings, attached by pins on each corner, allowing them to swing open. In African culture, granary doors are often decorated with fertility symbols, and images of people and animals, the lizard being a common motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granary doors"@en .

aat:300439389 a skos:Concept ;
    skos:definition "Kettles that boil water using electricity; specifically, electric kettles have within them heating elements that contain electrical resistance, such as coils, and the resistance turns the electrical energy flowing through the coils into heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric kettles"@en .

aat:300439400 a skos:Concept ;
    skos:definition "Small magnetic tape recorders that use tape wound on spools housed in cassettes, and that are meant to be easily transported. Most have a handle incorporated in their design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable cassette recorders"@en .

aat:300439415 a skos:Concept ;
    skos:definition "The topmost components of adzes, often made of bone, stone, or metal. Adze heads are attached to the shafts of the adze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adze heads"@en .

aat:300439631 a skos:Concept ;
    skos:definition "Cases or containers used to hold an amulet, which is an object believed to protect or bring good fortune."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amulet cases"@en .

aat:300439660 a skos:Concept ;
    skos:definition "Baskets created with lids that cover the opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lidded baskets"@en .

aat:300439889 a skos:Concept ;
    skos:definition "Valuable man-made objects often made of precious metals and gemstones. Any object of this sort used as an ornament or personal adornment set with stones or decorated with enamel and worn as an accessory of dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewels"@en .

aat:300440134 a skos:Concept ;
    skos:definition "Charts used display the alphabet, used for teaching and learning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphabet charts"@en .

aat:300440277 a skos:Concept ;
    skos:definition "Cases or covers, often of cloth and decorated, used to hold the afiqoman, which is a piece broken from the second of the three matsot, set before the leader of a Seder and put aside to be eaten at the end of the meal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "afiqoman cases"@en .

aat:300440349 a skos:Concept ;
    skos:definition "General term for poles, staffs, or pillars located at or incorporated in the altar, used in several religions globally. Examples are wooden poles surmounted by metal toppers, used in processions to the altar and then placed at the altar during a liturgy or ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar poles"@en .

aat:300440414 a skos:Concept ;
    skos:definition "Long, loose-fitting overgarments traditionally worn in the Middle East and Muslim countries eleswhere. They are often made of wool and cover the entire body from head to toe; one of the most popular pieces of modest fashion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abayahs"@en .

aat:300440467 a skos:Concept ;
    skos:definition "Collections of sound recordings that are packaged together in single units, regardless of format; records, cassettes, CDs or other digital formats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albums"@en .

aat:300440719 a skos:Concept ;
    skos:definition "Set of dialects of the Portuguese language used primarily in Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brazilian Portuguese"@en .

aat:300440720 a skos:Concept ;
    skos:definition "Used to distinguish the variety of Portuguese spoken in Portugal, on the Iberian Peninsula, from other forms spoken elsewhere. To refer specifically to formal varieties of Portuguese, use the appropriate specific variety such as \"Brazilian Portuguese.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European Portuguese"@en .

aat:300440721 a skos:Concept ;
    skos:definition "Variety of the Portuguese language used primarily in the nation of Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angola Portuguese"@en .

aat:300440722 a skos:Concept ;
    skos:definition "Variety of the Portuguese language used primarily in the nation of Cape Verde."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cape Verde Portuguese"@en .

aat:300440723 a skos:Concept ;
    skos:definition "Variety of the Portuguese language used primarily in the nation of Timor-Leste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Timor-Leste Portuguese"@en .

aat:300440724 a skos:Concept ;
    skos:definition "Variety of the Portuguese language used primarily in the nation of Guinea-Bissau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guinea-Bissau Portuguese"@en .

aat:300440725 a skos:Concept ;
    skos:definition "Variety of the Portuguese language used primarily in the nation of Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mozambique Portuguese"@en .

aat:300440726 a skos:Concept ;
    skos:definition "Variety of the Portuguese language used primarily in the nation of São Tomé and Príncipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "São Tomé and Príncipe Portuguese"@en .

aat:300440727 a skos:Concept ;
    skos:definition "Fishing vessels with covered hulls and upswept prows that are fitted with mizzen-masts and mainsails with a boom and lowering gaff. These were used in the South Holland islands in the 18th and 19th centuries. The hull was covered to provide for a livewell for keeping live fish and bait."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bezaanschuits"@en .

aat:300440728 a skos:Concept ;
    skos:definition "Belgian barges with a gaff rig, used as market ships and primarily intended for navigation on canals. The largest types are built with a helm port transom. The mast is rigged with a long gaff that carries the gaff sail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaff barges"@en .

aat:300440729 a skos:Concept ;
    skos:definition "Flat-bottomed fishing vessels that were used for oyster and mussel farming on Zeeland and South Holland streams until around 1950. Later also used as passenger transport. The ship had a drop-shaped flat hull and a straight bow and stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hengsts"@en .

aat:300440730 a skos:Concept ;
    skos:definition "Small, spherical stone fruits; pulpy drupes of certain species; or a sub-genus of Prunus (family Rosaceæ). The color of the flesh may vary from yellow and red to almost purple-red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherries"@en .

aat:300440731 a skos:Concept ;
    skos:definition "Writings in which important or memorable events, jubilating institutions or important people are commemorated by describing those events, institutions or persons or recording memories of them in order to save them for posterity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorial books"@en .

aat:300440732 a skos:Concept ;
    skos:definition "Watercraft of Frisian origin characterized by an open hull and rounded frame shape, sometimes built with a peak at the prow. The head of the rudder usually includes a decorative carving. Tjotters are adapted for navigating in shallow canals with bridges, and were originally used for fishing and transport of goods and people, but also for pleasure craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tjotters"@en .

aat:300440733 a skos:Concept ;
    skos:definition "Metal percussion instruments, often in bronze or brass, used on ships to give signals for the timing of watches, in case of fog, during anchoring maneuvers, or as a general alarm. Traditionally these have the name of the ship they are used on engraved or cast on their surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship's bells"@en .

aat:300440734 a skos:Concept ;
    skos:definition "Originally a type of messenger's badge that was an attribute of a messenger at Dutch government institutions that was intended to collect posted messages. Worn on the belt these appeared as a shield bearing the coat of arms of the body representing the messenger. These imparted privileges to the bearer, such as free transport. Over time, these evolved into often elaborately decorated badges worn by representatives of city governments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodebusses"@en .

aat:300440735 a skos:Concept ;
    skos:definition "Subfamily of small burrowing insectivorous mammals found throughout temperate Eurasia and North America. They usually have very poor vision, velvety fur, and short limbs with clawed toes adapted for digging the underground passages in which they live."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Talpinae"@en .

aat:300440736 a skos:Concept ;
    skos:definition "In traditional classifications, gulls are arranged in this subfamily, Larinae. Gulls comprise more than 40 species of long-winged, webfooted, heavily built seabirds of the gull and tern family Laridae, distributed all over the world. Adult gulls are mainly gray or white, with variable head markings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Larinae"@en .

aat:300440737 a skos:Concept ;
    skos:definition "Visual works where architecture is depicted in outdoor views and interiors and where the architecture is the predominant focus of the painting. In European art, architectural paintings exist as an independent genre developed in the 16th century in Flanders and the Netherlands, and reached its peak in 17th century Dutch painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural paintings"@en .

aat:300440738 a skos:Concept ;
    skos:definition "Edible rounded bulbs of Allium cepa, which consist of fleshy concentric leaf-bases. Onions have a strong pungent flavour and smell, and vary in color from white to yellow and dark red, and are used as a culinary vegetable throughout the world, eaten raw, cooked, or pickled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onions"@en .

aat:300440739 a skos:Concept ;
    skos:definition "Gothic architecture style typical of the Low Countries, surfacing in the first half of the 14th century at Saint Rumbold's Cathedral in the City of Mechelen. The style refers to classical French gothic style. Reputed architects disseminated the style and techniques to cities and towns of the Duchy of Brabant and beyond. According to more recent investigations the concept of \"Brabantine gothic\" should be looked at within a historiographic context: the concept could be an expression of the search for regional identities in the 20st century, rather than a disparate building style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brabantine Gothic"@en .

aat:300440740 a skos:Concept ;
    skos:definition "General term for any of six extant and one extinct pinniped species in five genera, belonging to the family of the Otariidae and occurring mainly on Pacific coasts. These large marine mammals have external ear flaps, long fore-flippers, and hind limbs that they can rotate forward for locomotion on land; males of most species have lion-like manes and constantly roar to defend their territory and harems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea lions"@en .

aat:300440741 a skos:Concept ;
    skos:definition "Large wading birds belonging to the family of the Ciconiidae and occurring in Sub-Saharan Africa. Mainly gray and white with a naked pinkish head and neck with an inflatable throat pouch. They survive on carrion, competing with vultures. The soft white downy feathers from the wings or tail of the marabou stork are frequently used for trimming on hats or other garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leptoptilos crumeniferus"@en .

aat:300440742 a skos:Concept ;
    skos:definition "The yellow citron fruit of the Citrus medica plant; used ritually in the Sukkot, or the Jewish Feast of Tabernacles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etrogim"@en .

aat:300440743 a skos:Concept ;
    skos:definition "Badges bearing a shield with the coat of arms of the body representing the messenger, for identification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "messenger's badges"@en .

aat:300440744 a skos:Concept ;
    skos:definition "Flemish vessels used in the estuary of the river Scheldt for fishing, particularly of shrimp. Typically these had their home port in Antwerp and are mentioned by the 18th century. They disappeared from shipping by 1920. These usually were no longer than ten meters and had a rounded keel with a curved, upright bow, with a hold extending from the prow to the the mast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antwerp knots"@en .

aat:300440745 a skos:Concept ;
    skos:definition "Vessels built or equipped to carry out salvage work: i.e. the retrieval of a sunken ship after the cargo has removed. Usually equipped with heavy duty pumps, lifting equipment, winches and cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salvage vessels"@en .

aat:300440746 a skos:Concept ;
    skos:definition "Large format maps painted on, or designed to be hung, on walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall maps"@en .

aat:300440747 a skos:Concept ;
    skos:definition "Those who steal, plunder, or sack a site or place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "looters"@en .

aat:300440748 a skos:Concept ;
    skos:definition "People who conduct meetings or ask questions of another person. Examples occur in journalism and in interviews for a job."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interviewers"@en .

aat:300440749 a skos:Concept ;
    skos:definition "People who are interviewed or questioned in meetings or in another situation. Examples occur in journalism and in interviews for a job."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interviewees"@en .

aat:300440750 a skos:Concept ;
    skos:definition "People who examine, revise, or give an opinion on a publication, exhibition, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reviewers"@en .

aat:300440751 a skos:Concept ;
    skos:definition "People who make a copies of a work in writing, or to copy out from an original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transcribers"@en .

aat:300440752 a skos:Concept ;
    skos:definition "The process of making a copy of a work in writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transcribing"@en .

aat:300440753 a skos:Concept ;
    skos:definition "People who make abridgements, summaries, or compilations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abridgers"@en .

aat:300440754 a skos:Concept ;
    skos:definition "People who divide, distribute, deliver, or bestow books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book dealers"@en .

aat:300440755 a skos:Concept ;
    skos:definition "Businesses involved in the sale of books and other publications, not necessarily involved with publishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookselling businesses"@en .

aat:300440756 a skos:Concept ;
    skos:definition "Businesses involved in the distribution of products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distributing businesses"@en .

aat:300440757 a skos:Concept ;
    skos:definition "People or organizations against whom a legal action, claim, or charge is brought; a party that is prosecuted or sued in a court or tribunal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defendants"@en .

aat:300440758 a skos:Concept ;
    skos:definition "People or organizations who are the party that brings a suit in a court of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaintiffs"@en .

aat:300440759 a skos:Concept ;
    skos:definition "People or organizations who receive others into a house or other venue, either actual or virtual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosts"@en .

aat:300440761 a skos:Concept ;
    skos:definition "Doors of protective cases for organs, which frequently display decorative elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ shutters"@en .

aat:300440762 a skos:Concept ;
    skos:definition "A green mineral occurring commonly in slender prisms or acicular crystals and composed of sulphate and chloride of copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "connellite"@en .

aat:300440763 a skos:Concept ;
    skos:definition "Any of various hardware or non-structural contrivances by which an object is hung from a wall or other surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangers"@en .

aat:300440764 a skos:Concept ;
    skos:definition "Any of a number of saturated alcohols having the formula C18H37OH. These are fatty alcohols that have an aliphatic tail of 13 to 21 carbon atoms. Stearyl alcohol is considered to be a fatty alcohol lipid molecule, exists as a solid and is considered to be practically insoluble in water and relatively neutral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stearyl alcohol"@en .

aat:300440765 a skos:Concept ;
    skos:definition "Waste products from the distillation process of essential oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrolates"@en .

aat:300440766 a skos:Concept ;
    skos:definition "Acrylic resin produced by the the polymerization of acrylamide (C3H5NO), a compound obtained by the hydration of acrylonitrile. Polyacrylamide does not have the toxic effects of acrylamide monomer and is hydrophilic. It can form aqueous solutions of very high concentration and because of their gel-like properties, has been used in the conservation of works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyacrylamide"@en .

aat:300440767 a skos:Concept ;
    skos:definition "Outbuildings used for cooking, particularly during hot summer months, when it was desirable to keep the heat of the stove and oven physically separated from the rest of the house and living quarters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer kitchens"@en .

aat:300440768 a skos:Concept ;
    skos:definition "Systematically arranged collections of pressed plant specimens that have been gathered in situ, then dried and pressed onto sheets of archival paper so that major morphological characteristics are visible. Notations are added with the date collected, proper scientic names, name of the collector, and any other observations. These are commonly filed in cases, or bound in volumes for ready reference, and are may be housed in repositories also called 'herbaria.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbaria"@en .

aat:300440769 a skos:Concept ;
    skos:definition "The action or motion in fact or approximation of propelling watercraft by means of oars. The action of rowing may be done in a boat or as an excercise by means of a machine designed as a simulacrum of oars in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rowing"@en .

aat:300440770 a skos:Concept ;
    skos:definition "Boxes for storing Buddhist sutra scrolls, often made of lacquered wood and highly decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sutra boxes"@en .

aat:300440771 a skos:Concept ;
    skos:definition "Hydrous ammonium oxalate (NH4)2C2O4.1H2O occurring as a crystalline salt in guano."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxammite"@en .

aat:300440772 a skos:Concept ;
    skos:definition "Any of a large class of usually red synthetic dyes, which are obtained typically by coupling of diazotized aromatic monoamines with aromatic diamines, or any of various mixtures of safranine salts used in dyeing and as biological stains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safranine"@en .

aat:300440773 a skos:Concept ;
    skos:definition "Technique of engraving on ivory dyed blue, green, or red. Practiced in China during the Tang dynasty, and introduced to Japan during the Nara period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bachiru"@en .

aat:300440775 a skos:Concept ;
    skos:definition "Style identified retroactively to describe works of the late 17th and 18th centuries. Considered a modification of the Baroque, and often appearing in autocratic monarchies of France and Britain, where the original excesses of the Baroque are lessened and elements of classical antiquity are re-established."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baroque Classicism"@en .

aat:300440776 a skos:Concept ;
    skos:definition "Style descriptor tied to the exhibiting society of 16 British painters active primarily between 1911 and 1914, who regularly attended the informal Saturday afternoon gatherings first established by Walter Sickert in 1907 in London. Although it only lasted two years, its name is used in a broader sense to characterize a particular strain of British painting from about 1905 to 1920."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camden Town Group"@en .

aat:300440777 a skos:Concept ;
    skos:definition "Describes a mid-17th century Dutch painting tendency in genre painting depicting domestic life, interiors, and street life of Delft. Carel Fabritius and Nicolaes Maes are seen as originators, continued in the 1650s by Pieter de Hooch and Johannes Vermeer and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Delft School"@en .

aat:300440778 a skos:Concept ;
    skos:definition "A tendency identified in New York in the early 1960s that was in direct defiance to the prevailing trend of Abstract Expressionism, and was concerned with combining figurative forms with a new non-traditionalist outlook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Contemporary Realism"@en .

aat:300440779 a skos:Concept ;
    skos:definition "The Gothic style of architecture and sculpture as practiced in France from 1140 until about 1500."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Gothic"@en .

aat:300440780 a skos:Concept ;
    skos:definition "Japanese aristocratic cultural era of the 15th century linked to the shōgun Ashikaga Yoshimasa, after he retired at 39 to his villa in the eastern hills of the capital city Kyoto. Higashiyama, or Eastern Mountain culture reflected the ideals and aesthetics of Zen Buddhism, hallmarks being the development of chadō (Japanese tea ceremony), ikebana (flower arranging), Noh drama, and sumi-e ink painting. What is commonly regarded as Japanese Zen aesthetics originated in this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Higashiyama culture"@en .

aat:300440781 a skos:Concept ;
    skos:definition "Refers to the style of a major school of Japanese sculptors of Buddhist images in the Early Kamakura period who used the character 'kei' in their names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kei School"@en .

aat:300440782 a skos:Concept ;
    skos:definition "Describes the style of a group of artists who were associates of Wilhelm Leibl between 1871 and 1873."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leibl-Kreis"@en .

aat:300440783 a skos:Concept ;
    skos:definition "The style or culture of the Marathi people, also rendered as Marathis or Maharashtrian, an ethnolinguistic group who speak Marathi, an Indo-Aryan language. They inhabit the state of Maharashtra as well as districts bordering the state, such as Belgaum of Karnataka and the state of Goa in western India as well as districts of southern Gujarat and parts of Madhya Pradesh. In the 17th century the Marathas, under Shivaji Maharaj, established the Maratha Empire, which is credited to a large extent for ending the Mughal rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maharashtrian"@en .

aat:300440784 a skos:Concept ;
    skos:definition "Describes the style of a group of young painters who met at the Académie Julian in the fall of 1888 to form a brotherhood called the “Nabis,” a Hebrew word meaning “prophets.” The group was spearheaded by Paul Sérusier. Nabi paintings often feature textured surfaces created by varied brushstrokes, and avoided the illusion of depth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nabi"@en .

aat:300440785 a skos:Concept ;
    skos:definition "Loosely refers to those painters who participated in the development of contemporary art beginning in the early 1940s and spanning the post-war period into the 1960s. The term is applied widely to disparate styles of work emerging during this period, but most specifically to innovations such as Abstract Expressionism and other forms of painterly abstraction. The phrase \"New York School\" is also applied to a group of postwar documentary-style photographers, but this should be considered a separate usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New York School"@en .

aat:300440786 a skos:Concept ;
    skos:definition "Style of Mannerism found in the visual arts north of the Alps in the 16th and early 17th centuries. Northern Mannerism in the early sixteenth century is characterized by thematic traits that derive from late Gothic art. Many of the early sixteenth-century Mannerists were based in Antwerp, with other centers in France, Germany, and the southern and northern Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Mannerist"@en .

aat:300440787 a skos:Concept ;
    skos:definition "Style of the 19th century provincial art movement in Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norwich School"@en .

aat:300440788 a skos:Concept ;
    skos:definition "Term coined to describe a variety of styles and movements post WWI that were influenced by expressionism but rejected the movement's aesthetic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post Expressionist"@en .

aat:300440789 a skos:Concept ;
    skos:definition "Describes to the style of Renaissance Venice beginning in the late 1400s, led by the brothers Giovanni and Gentile Bellini. The Venetian School painters employed the use of linear perspective and naturalistic figurative treatments of Renaissance art in Florence and Rome. Artists associated with the Venetian school are Giorgione (c. 1477–1510), Titian (c. 1489–1576), Tintoretto (1518–1594), Paolo Veronese (1528–1588) and Jacopo Bassano (1510–1592) and his sons. Venetian school painters contrasted with the Mannerism prevalent in the rest of Italy, and influenced the subsequent development of Western painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian School"@en .

aat:300440790 a skos:Concept ;
    skos:definition "Describes the style of the German group of painters and printmakers active from 1905 to 1913, who were closely associated with the development of Expressionism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Die Brücke"@en .

aat:300440791 a skos:Concept ;
    skos:definition "In Dutch history, regarded as the century from the conclusion of the Twelve Years’ Truce in 1609 until either the death of Prince William III in 1702 or the conclusion of the Peace of Utrecht in 1713. It was an era of political, economic, and cultural growth during which the Netherlands became one of the most powerful and influential in Europe and the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch Golden Age"@en .

aat:300443128 a skos:Concept ;
    skos:definition "General term to refer to the period or style of an area when it was recently colonized by a foreign power; usually refers to European colonization from the 16th-19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial"@en .

aat:300443134 a skos:Concept ;
    skos:definition "Style of architecture, interior design, furniture, or other works that evokes factories, machinery, or other elements of industry, particularly applicable when the work itself does not serve an industrial function. It is often nostalgic in sensibility, including elements of the turn-of-the-century industrial era or the mid-20th century factories, such as distressed wood, exposed bricks, building systems, industrial lighting fixtures, and exposed concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Industrial Style"@en .

aat:300443138 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the Jewish sect known as Karaites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karaite"@en .

aat:300443149 a skos:Concept ;
    skos:definition "Culture of the Arabic-speaking esoteric ethnoreligious group. The Druze faith incorporates elements of many others including Shia Islam, Gnosticism, Christianity, Zoroastrianism, Buddhism, Hinduism, etc. Druze people inhabit Syria, Lebanon, Israel, and Jordan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Druze"@en .

aat:300443176 a skos:Concept ;
    skos:definition "Refers to the style, period, or culture of the Arhab area in Yemen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arhab"@en .

aat:300443177 a skos:Concept ;
    skos:definition "Style or culture of the of the people of the city in southwestern Yemen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taiz"@en .

aat:300443185 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the Papua New Guinean people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iwam"@en .

aat:300443186 a skos:Concept ;
    skos:definition "Nationality, style, and culture of a poeple that habitate near the Sepik River on New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lumi"@en .

aat:300443210 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the Kerewaa, a Papuan people on the Gulf of Papua."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kerewa"@en .

aat:300443214 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Jewish people living in Baghdad, Iraq."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baghdadi Jews"@en .

aat:300443228 a skos:Concept ;
    skos:definition "Nationality, style, or culture of the region in the Democratic Republic of Congo, Central Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Teke-Tsaayi"@en .

aat:300443230 a skos:Concept ;
    skos:definition "Style and culture of the city of the largest city in Yemen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sanaa"@en .

aat:300443236 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the Nukuma language group of Papua New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nukuma"@en .

aat:300443358 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the Keiyo people that are part the larger Kalenjin ethnic group of Nilotic origin that inhabit an area near Eldoret, Kenya in the highlands of the former Keiyo District now part of the larger Elgeyo Marakwet County."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elgeyo"@en .

aat:300443370 a skos:Concept ;
    skos:definition "Describes the Kampa people of India who are part of the Telugu language group of South Asian peoples. The primary religion practiced by the Kampa is Hinduism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kampa"@en .

aat:300443390 a skos:Concept ;
    skos:definition "Style and culture of a community or group of formerly enslaved Africans and Amerindian peoples and their descendants who fled, resisted, or rebelled against enslavement and found freedom in remote regions near where they had been forcibly relocated. Many of these groups have survived in the Caribbean and the Americas. Note that this community of people did not originally refer to themselves as “Maroon,” though some of their contemporary descendants have adopted the term, while others may consider it pejorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maroon"@en .

aat:300443404 a skos:Concept ;
    skos:definition "Culture of Nazca society that developed during the Early Intermediate Period phase 1, 100 BCE-1 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Nazca"@en .

aat:300443417 a skos:Concept ;
    skos:definition "Nationality, style, or culture of the Congolese region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suku-M'Bala"@en .

aat:300443434 a skos:Concept ;
    skos:definition "Nationality, style, or culture of the Yoruba-Edo region of Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yoruba-Edo"@en .

aat:300443453 a skos:Concept ;
    skos:definition "Family of seabirds comprising the gulls (subfamily Larinae) and the terns (subfamily Sterninae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laridae"@en .

aat:300443454 a skos:Concept ;
    skos:definition "Family of moles and desmans,currently containing approximately 42 species grouped into 17 genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Talpidae"@en .

aat:300443455 a skos:Concept ;
    skos:definition "Genus containing two species of large, oceangoing earless seals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mirounga"@en .

aat:300443456 a skos:Concept ;
    skos:definition "Large, oceangoing earless seals ranges over the Pacific coast of the U.S., Canada, and Mexico. mainly on coastal islands off California and Baja California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mirounga angustirostris"@en .

aat:300443458 a skos:Concept ;
    skos:definition "Stone curbs or structures that surround the mouths of wells, often decorated with figural relief sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puteals"@en .

aat:300443459 a skos:Concept ;
    skos:definition "An apparatus for supporting the physical functions of infants that are born prematurely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infant incubators"@en .

aat:300443460 a skos:Concept ;
    skos:definition "The bones of ritually killed animals, carved with script and used in ancient China for divination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oracle bones"@en .

aat:300443461 a skos:Concept ;
    skos:definition "Sand devised to blot wet ink after writing, used until approximately the mid 1800s as an alternative to blotting paper. Applied from a small shaker pot or box to speed the drying process, the excess sand would then be shaken off."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blotting sand"@en .

aat:300443462 a skos:Concept ;
    skos:definition "Video cameras that are connected to or are integral to a computer so that its output may be viewed online."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "webcams"@en .

aat:300443463 a skos:Concept ;
    skos:definition "Designating the latter part of the last Quaternary glacial period, immediately preceding the current postglacial period, marked predominantly by the retreat of glaciers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Glacial"@en .

aat:300443464 a skos:Concept ;
    skos:definition "The condition of being firmly fixed in a surrounding mass of some solid material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embedding"@en .

aat:300443465 a skos:Concept ;
    skos:definition "The process of freeing a material or object from infusion of sulphur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desulfurizing"@en .

aat:300443467 a skos:Concept ;
    skos:definition "Fortress-monastery complexes in Bhutanese and Tibetan architectures. The dzong served as a stronghold against enemies in the past, and it now plays an important role as a combined administrative center and monastery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dzongs"@en .

aat:300443468 a skos:Concept ;
    skos:definition "A subtractive manufacturing process which typically employs computerized controls and machine tools to remove layers of material from a blank, and produces a custom-designed part. The basic process includes designing the CAD model, converting the CAD file to a CNC program, preparing the CNC machine, and executing the machining operation. It is suitable for a wide range of materials, including metals, plastics, wood, glass, foam, and composites, and encompasses different operations including mechanical, chemical, electrical, and thermal processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer numerical control machining"@en .

aat:300443469 a skos:Concept ;
    skos:definition "Programmable machines that are capable of autonomously performing the operations of CNC machining, for example CNC routers used for turning or cutting and CNC milling machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer numerical control machines"@en .

aat:300443470 a skos:Concept ;
    skos:definition "The sequence of steps involved in moving from the beginning to the end of a working process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workflow"@en .

aat:300443471 a skos:Concept ;
    skos:definition "Describes the style or culture of the tribe of probable Iranian origin that was prominent in Bactria and Transoxania in late antiquity. The first mention of the Chionites is by the 4th-century Greek historian Ammianus Marcellinus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chionite"@en .

aat:300443472 a skos:Concept ;
    skos:definition "“Green” surfactant obtained by the dehydration reaction between glucose hemiacetal hydroxyl and fatty alcohol hydroxyl in the presence of acid catalyst. Its raw materials are the vegetable oil and starch which are the natural renewable resource and low cost, and its biodegradability is very excellent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkyd polyglycoside"@en .

aat:300443473 a skos:Concept ;
    skos:definition "Any of various plant polysaccharides less complex than cellulose and easily hydrolyzable to monosaccharides and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemicellulose"@en .

aat:300443474 a skos:Concept ;
    skos:definition "Institutions comprising a community living under religious vows, particularly a community of monks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monasteries"@en .

aat:300443475 a skos:Concept ;
    skos:definition "Builders who specialize in, or who have a role as, reconstructing a destroyed or damaged work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reconstructors"@en .

aat:300443476 a skos:Concept ;
    skos:definition "Culture or style from the Hejaz region, in Saudi Arabia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hejaz"@en .

aat:300443477 a skos:Concept ;
    skos:definition "Culture of the of the Quraish tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qurayshi"@en .

aat:300443478 a skos:Concept ;
    skos:definition "Style that is specifically Czech, with folk elements; established in the 1920s by architects Gočár and Janák. The term is primarily used for architecture and applied arts created during the First Czechoslovak Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rondo-Cubist"@en .

aat:300443479 a skos:Concept ;
    skos:definition "A term used to describe that portion of all people, primarily in the United States, but perhaps used more widely, who are black, that is, dark-skinned peoples of Africa, Oceania, and Australia or their descendants, without regard to perceived actual skin tone. Indigenous refers to people of ethnic groups native to the Americas. People of color being a broad term for any non-Anglo-Saxon people.The term BIPOC is meant to be inclusive of those who are affected by racism, discrimination, or oppression based on ethnicity or race-based tropes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BIPOC"@en .

aat:300443480 a skos:Concept ;
    skos:definition "Used to describe those immigrant residents of a state or country who do not possess rights acquired through due legal process, or more specifically those not having the appropriate legal documents associated with their status. It includes people who entered the U.S. without inspection or permission from the government, and those who entered with a legal visa that is no longer valid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undocumented immigrants"@en .

aat:300443481 a skos:Concept ;
    skos:definition "A rubric that encompasses and recognizes differences that may include ideas about race, gender, religion, sexual orientation, ethnicity, nationality, class, language, disability, or political perspective, and how these differences relate to justice, impartiality, and fairness with the procedures, processes, and distribution of resources by institutions or systems, and outcomes that ensure that institutional structures are truly inclusive off all constituencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DEI"@en .

aat:300443482 a skos:Concept ;
    skos:definition "Family of salamanders containing two genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ambystomatidae"@en .

aat:300443483 a skos:Concept ;
    skos:definition "Genus containing species of salamanders endemic to North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ambystoma"@en .

aat:300443484 a skos:Concept ;
    skos:definition "Salamander of the family Ambystomatidae (order Caudata), notable for its permanent retention of larval features, such as external gills. It is found in lakes near Mexico City."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ambystoma mexicanum"@en .

aat:300443485 a skos:Concept ;
    skos:definition "Framed construction, in which the frame is constructed using iron members. The frame may be infilled with masonry or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron frame construction"@en .

aat:300443486 a skos:Concept ;
    skos:definition "Species that is the closest relative of Bombyx mandarina, the wild silk moth. The silkworm is the larva or caterpillar of a silk moth, used for silk fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bombyx mori"@en .

aat:300443487 a skos:Concept ;
    skos:definition "Wild species that was transformed to the domesticated form, B. mori, over many centuries, and the continuing artificial selection by humans to maximize the quantity, quality, and diversity of silk, as well as the creation of infection-resistant strains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bombyx mandarina"@en .

aat:300443488 a skos:Concept ;
    skos:definition "The making of silk as a material, from harvesting the cocoon of the silkworm, which can be reeled off, spun, and woven. The process began in China sometime before the middle of the 3rd millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silk-making"@en .

aat:300443489 a skos:Concept ;
    skos:definition "The activity and profession of raising bovine species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle raising"@en .

aat:300443490 a skos:Concept ;
    skos:definition "The activity and profession of breeding and raising horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse breeding"@en .

aat:300443491 a skos:Concept ;
    skos:definition "The activity and profession of breeding and raising sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheep raising"@en .

aat:300443492 a skos:Concept ;
    skos:definition "The activity and profession of breeding and raising chickens or other poultry"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poultry raising"@en .

aat:300443493 a skos:Concept ;
    skos:definition "Areas of countryside set aside for public recreation. In the United Kingdom, often situated close to urban developments and created under the provision of the Countryside Act 1968."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "country parks"@en .

aat:300443495 a skos:Concept ;
    skos:definition "Day Signs (tonalli in the Nahua calendar), units of duration, days (units of time) The days of the Nahua calendar were designated by twenty signs juxtaposed with a number from one to thirteen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day signs"@en .

aat:300443496 a skos:Concept ;
    skos:definition "Periods of pre-Columbian Mesoamerican calendars comprising 20 days, not coordinated with the lunar cycle. The term is most frequently used with respect to the 365-day Aztec calendar, the xiuhpohualli, although 20-day periods are also used in the 365-day Maya calendar (the Mayan tun), as well as by other Mesoamerican civilizations such as the Zapotec and Mixtec. A period of twenty-days in the xiuhpohualli or Nahua solar calendar. A period of twenty days in the xiuhpohualli or Nahua solar calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veintenas"@en .

aat:300443497 a skos:Concept ;
    skos:definition "People who are sent on a mission to gain information, or to gain adherents to, or promote the interests of a cause."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emissaries"@en .

aat:300443498 a skos:Concept ;
    skos:definition "Mesoamerican religious structures in central Mexico, usually a terraced pyramid surmounted by a temple; other types of structures such as tzompantli, cuauhxicalco, and calmecac. Literally, \"teotl (deity) house.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocalli"@en .

aat:300443499 a skos:Concept ;
    skos:definition "Artists who make themselves available to be engaged for work on particular assignments or projects, rather than being engaged on a long-term or permanent basis by a single employer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freelance artists"@en .

aat:300443500 a skos:Concept ;
    skos:definition "Bubbles that range in diameter from 0.1 micrometers to 10.0 micrometers. MNB technology has been used in bioremediation, water treatment, aquaculture and plant cultivation, and as cleaning technology in the field of conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro-nanobubbles"@en .

aat:300443501 a skos:Concept ;
    skos:definition "Pairs of towns, usually in different countries, that have established official links."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sister cities"@en .

aat:300443502 a skos:Concept ;
    skos:definition "The hard exoskeletal components composed of chitin that covers the wings of a beetle (Coleopter). Elytra provide protection from heat, wind, and moisture evaporation allowing beetles to live in adverse conditions, such as a desert environment. Beetle elytra often have bright jewel-tone colors and an iridescence due to the interference of light between the multiple layers of chitin. They have been used as applied decoration on textile and other cultural artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beetle elytra"@en .

aat:300443503 a skos:Concept ;
    skos:definition "The urban area understood as the result of a historic layering of cultural and natural values and attributes, extending beyond the notion of “historic center” or “ensemble” to include the broader urban context and its geographical setting, including social and cultural practices and values, economic processes, and the intangible dimensions of heritage as related to diversity and identity. The recommendation on the Historic Urban Landscape was adopted on 10 November 2011 by UNESCO’s General Conference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Historic Urban Landscape, the"@en .

aat:300443504 a skos:Concept ;
    skos:definition "A comprehensive and integrated strategy for the identification, assessment, conservation and management of historic urban landscapes within an overall sustainable development framework. The approach moves beyond the preservation of the physical environment, and focuses on the entire human environment with all of its tangible and intangible qualities. It seeks to increase the sustainability of planning and design interventions by taking into account the existing built environment, intangible heritage, cultural diversity, socio-economic and environmental factors along with local community values. The recommendation on the Historic Urban Landscape was adopted on 10 November 2011 by UNESCO’s General Conference. [derived from warrants #3 and #4]"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Historic Urban Landscape approach"@en .

aat:300443505 a skos:Concept ;
    skos:definition "The physical tops, or mouths of mine shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitheads"@en .

aat:300443506 a skos:Concept ;
    skos:definition "Narrow strips of wood or bamboo that typically carry a single column of brush-written text each, with space for several tens of complex ancient Chinese characters. For longer texts, many slips may be bound together in sequence with thread. Each strip of wood or bamboo is said to be as long as a chopstick and as wide as a pair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jiǎndú"@en .

aat:300443507 a skos:Concept ;
    skos:definition "Settlements enclosed by walls, particularly used for early settlements that have only rudimentary walls, but not heavy or sophisticated fortifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walled settlements"@en .

aat:300443508 a skos:Concept ;
    skos:definition "Spherical bodies or cavities of gas present in a liquid or formed in a substance such as glass as it solidifies from a liquid state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bubbles"@en .

aat:300443509 a skos:Concept ;
    skos:definition "Traditional Korean decorative coloring done on wooden buildings and structures, such as royal palaces and temples. Its usual function was to cover design defects and prevent cracks in wooden buildings, in addition to repelling pests and protecting from rain and wind. Since dancheong is based on yin and yang and the Five Elements Theory, blue is placed to the east, red south, yellow center, white west and black north, in addition to green. In South Korea, the color pigments with specific color index numbers are standardized by the state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dancheong"@en .

aat:300443510 a skos:Concept ;
    skos:definition "Craftsmen who practice “dancheong,” the traditional Korean decorative coloring done on wooden buildings and structures. In South Korea, they are considered living national treasures and classified as National Intangible Cultural Heritage 48 by the Cultural Heritage Administration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dancheongjang"@en .

aat:300443511 a skos:Concept ;
    skos:definition "Materials formed of the organic substance that appears as the elytra and integuments of insects and the carapaces of crustacea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chitinous material"@en .

aat:300443512 a skos:Concept ;
    skos:definition "Painted decorative coatings on surfaces and objects, including clothing, utensils, boats, and chariots, created using polychrome colorants. In Chapter 14 of the Yingzao fashi (1103), the craft of applying polychrome painted decoration on architectural surfaces (caihuazuo 彩畫作) is categorized as a specific division of architectural works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cǎihuà"@en .

aat:300443513 a skos:Concept ;
    skos:definition "An architectural term seen in the Yingzao fashi (1103), the Gongcheng zuofa (1734), and other texts that involve architectural descriptions, including the Sitaji (843-853) and the Tang Huiyao (961). It is generally agreed that in the Gongcheng zuofa the term refers to trough-shaped pits dug for narrow sections or strips of pounded-earth foundation. Interpretations of the term and its relevant plates in the Yingzao fashi are under debate. Scholars have suggested that it can refer to (1) the space enclosed by pillars, forehead rails (lan’e 闌額) and corbelling (puzuo 鋪作) (Cheng Mingda 1981; cf. Liang Sicheng 1944); (2) the axis between the pillar row and corbelling (puzuo) (He Jianzhong 2003; cf. Liang Sicheng 1983); (3) an elongated structural unit within the corbelling (puzuo) (Zhu Yongchun 2016); and (4) pillar rows and wall planes in general (Ren Sijie 2016)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cáo"@en .

aat:300443514 a skos:Concept ;
    skos:definition "Chiwei is a tile component used at both ends of a building’s roof ridge (zhengji 正脊). The term appears in the statutory documents of official histories where the types and grades of buildings that can use chiwei are regulated; thus, it would have been a marker of high status. Provisions for the size, manufacture, labor, and other regulations for the use of chiwei on different types of buildings are outlined in the Yingzao fashi, Chapter 13, 5a-b. The names of specific shapes include owl or hawk tails (chiwei 鴟尾), dragon tails (longwei 龍尾), and beast heads (shoutou 獸頭). Different names for this feature were also used over time, including sea-beast tails (chiwei 蚩尾), shrine tails (ciwei 祠尾), owl or hawk beaks (chiwen 鴟吻), central lips or jaws (zhengwen 正吻), and great lips or jaws (dawen 大吻). Before the mid-Tang dynasty, chiwei were usually simple tails arching inwards and decorated with fin or feather patterns on the outer edge. In the mid-Tang (ca. 790-820) we see the added pattern of a beast head with an open mouth, and the tail gradually transitioning into that of a fish. Beginning in the Yuan dynasty (1279-1368), the chiwei tail arched outwards instead of inwards. In the Ming (1368-1644) and Qing (1644-1911) dynasties, the beast's head opened its mouth around the ridge, the tail curved outward, and the ends (duanbu 端部) changed from bifurcated (fencha 分叉) to curled (juanqu 卷曲). Furthermore, dragons and swords were attached to the body of the beast and its shape was squared off. During the Ming and Qing dynasties, chiwei were commonly called chiwen 鴟吻, wenshou 吻獸, or zhengwen 正吻."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chīwěi"@en .

aat:300443515 a skos:Concept ;
    skos:definition "The “penetrating and interlocking framework” (chuandou 穿鬥) is one of the two main categories of Chinese timber-frame structures, the other being “interlocking and lifting beams” (擡梁 táiliáng). In the chuandou structural system, several layers of tie-beams are tenoned through the pillars to join them together and the pillars support the purlins directly without the use of a bracketing layer. Chuandou has a verbal connotation, referring to a particular procedure of construction. First, pillars of the truss-like framework perpendicular to the roof ridge are connected by the tenoning work of chuan, and then multiple frames of different bays are interlocked parallel to the roof ridge by the work of dou to form the whole timber-frame structure. The earliest known textual use of the term chuandou was in the work of architectural historians in the 1940s, who were learning the terminology of craftsmen in southwestern China. The term came to be used to describe the structural system of timber-frame domestic architecture in southern China. Other terms for this structural system include chuandou 穿逗, litie 立貼, and chuandou 串斗."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chuāndòu"@en .

aat:300443516 a skos:Concept ;
    skos:definition "Puzuo is a term primarily found in the Yingzao fashi (1103). Based on its use in this text, we can conclude that puzuo is a method whereby small components are layered one on top of another extending outward in corbelled steps, usually to support the weight of a roof or balcony. The number of puzuo is measured by the number of layers. In the Yingzao fashi the term puzuo also used to describe a structural unit formed by this practice, and in this situation it is similar to dougong 斗拱."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pūzuò"@en .

aat:300443517 a skos:Concept ;
    skos:definition "In traditional Chinese fortifications, die refers to the battlements built on the top of a city wall constructed to protect defenders from missile fire. This term already appears in the literature of the Pre-Qin period (e.g. “In the standards of city wall building, the wall should be [built to the] height of 30 feet, die should be added to the top, and the width should be ten feet 行城之法。高城三十尺。上加堞。廣十尺,” from Mozi, Chapter 14, Beiti). The element is also referred to as zhidie 雉堞, nütouqiang 女頭墻, and duokouqiang 垛口墻 in different traditional textual sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dié"@en .

aat:300443518 a skos:Concept ;
    skos:definition "\"丁\" cross beams\" or dīngfu run parallel to the roof ridge and form a \"T\" shape with cross beams perpendicular to the roof ridge. In traditional Chinese timber-frame architecture, the dingfu refers to cross beams used on the gable sides of a building with a hip and gable roof (jiuji 九脊 or xialiangtou 廈兩頭; later xieshan 歇山) or the \"hip\" side of a building with a hip roof (Song dynasty si'e 四阿 or Qing dynasty wudian 廡殿). In historical texts, we have only found this technical term used in the Yingzao fashi (e.g. Chapter 5, 7b). Modern architectural historians use this term to describe cross beams on the gable sides of buildings dating from the Tang to the early Ming dynasties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dīngfú"@en .

aat:300443519 a skos:Concept ;
    skos:definition "Dipan is an architectural term seen in Yingzao fashi (1103) and Luban yingzao zhengshi (1465-1505), but is also used in texts related to building activities such as Zhuzi yulei (1270), and Yangzhou huafang lu (18th cen.). Interpretations of the term and its relevant images in the Yingzao fashi are under debate. Some scholars suggest it concerns the plan of puzuo (corbelling) seen at a vertical position above the pillar top (Chen Mingda, 2010), either understood as reflected ceiling plan (Chen Mingda 1981), or the view looking downward from above (Zhu Yongchun 2016). Others interpret the term as a ground plan showing pillar positions and, in some cases, the layout of puzuo (Pan Guxi, He Jianzhong 2005). Recently Ren Sijie has shown how this term was likely directly related to the building foundation Ren Sijie 2016)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dìpán"@en .

aat:300443521 a skos:Concept ;
    skos:definition "One of the main categories of structural elements in Chinese traditional architecture; interchangeable with liang 梁. The essential features of a cross-beam are described in Yingzao fashi (1103) and Gongcheng zuofa (1734) as such: (1) the cross-beam is placed above the pillars; (2) at least one end is supported by a pillar directly or by a bracket (gong) on top of a pillar; (3) the other end can either be inserted into the body of a pillar or placed above another beam. Within extant historic buildings it is also possible to find cross-beams in which both ends are placed above another beam. With the exception of the T-beam 丁栿, a cross beam is usually located perpendicular to purlins. In Yingzao fashi, beams are usually described with the character “fu 栿,” and a beam between pillars is named after the number of rafters it spans, such as a 6-rafter-beam, or 8-rafter-beam; however, there are exceptions, including the pinpricking connector (zhaqian 剳牽), infant beam (rufu 乳栿), eaves cross beam (yanfu 檐栿), level cross beam (pingliang 平梁), and T-beam. Modern architectural historians use this term to describe architecture dating from the Tang (618-907) to early Ming (1368-1644). In Qing dynasty texts such as the Gongcheng zuofa, a cross beam is usually named after the number of purlins it spans, such a 5-purlin-beam or 7-purlin-beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fú"@en .

aat:300443522 a skos:Concept ;
    skos:definition "In the Yingzao fashi (1103) this term refers to squared beams (fang 方) carved with bracket-arms in low relief and layered within the wall plane above pillar tops. It can also refer to the entire composition of square beams and bracket-arms within the wall plane above pillar tops (Cheng Mingda 2010; Xu Yitao 2005). Also called “shadow bracket-arm(s)” (yinggong 影栱)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fúbìgǒng"@en .

aat:300443523 a skos:Concept ;
    skos:definition "Jiaozhu is a broad term referring to any pillar placed at the corner of a building. Usually, corner pillars refer to eaves pillars located at the corners of a timber frame structure. In Chapter 5 of the Yingzao fashi (1103), corner pillars are discussed in conjunction with pingzhu 平柱 (leveling pillars) in calculations of the changes in height necessary to achieve the appropriate upward curvature of the eaves toward the corners. In the Song dynasty Yingzao fashi as well as the Qing dynasty Digong zuofa and Gongcheng zuofa (1734), the term can also refer to short pillars located at the corners of a foundation (taiji 台基), which were usually made of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jiǎozhù"@en .

aat:300443524 a skos:Concept ;
    skos:definition "In traditional Chinese timber-frame architecture, the lan’e refers to horizontal elements positioned between and on top of pillars with both ends inserted into the pillars. Its upper surface is level with the top of the pillar. In premodern sources, the term appears to only be used in the Yingzao fashi (1103), Chapters 4 and 5. Modern architectural historians use this term to describe architectural elements that accord with the Yingzao fashi description in buildings dating from the Tang (618-907) to early Ming (1368-1644) dynasties. This term is also used by some modern architectural historians to describe long horizontal elements, sometimes supported by dougong 斗拱, located above or between eaves pillars, as can be seen in representations of buildings in stone cave temples, wall paintings, and sarcophagi dating before the Tang dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lāné"@en .

aat:300443525 a skos:Concept ;
    skos:definition "Cross beams, One of the main categories of structural elements in Chinese traditional architecture; interchangeable with fu 栿. According to the Yingzao fashi (1103), Chapter 5, 1a and the Gongcheng zuofa (1734), cross beams are placed above the pillars and at least one end is supported directly by a pillar or by a bracket on top of a pillar, while the other end could be inserted into the body of the a pillar or placed above another beam. In extant historic buildings it is also possible to find cross beams whose ends are placed above another beam. With the exception of the T-beam, a cross beam is usually located perpendicular to purlins. In the Yingzao fashi, beams are usually described with the character fu 栿, and a beam between pillars is named after the number of rafters it spans, such as a 6-rafter-beam, or 8-rafter-beam. But there are exceptions, including the zhaqian 剳牽 (lit. pin-pricking connector), rufu 乳栿 (lit. infant beam), yanfu 檐栿 (lit. eaves cross beam), pingliang 平梁 (lit. level cross beam), and 丁栿 dingfu (T-beam). Modern architectural historians use this terminology to describe architecture dating from the Tang to the early Ming dynasties. In Qing dynasty texts such as the Gongcheng zuofa, a cross beam is usually named after the number of purlins it spans, e.g. a 5-purlin beam, or a 7-purlin beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liáng"@en .

aat:300443526 a skos:Concept ;
    skos:definition "In traditional Chinese timber-frame architecture, leveling pillars are the two eaves pillars framing the central bay on the sides of the building parallel to the roof ridge. Leveling pillars are used as a standard height for calculating the height of other pillars across the façade, as they increase in height from the center towards the corners of the building, allowing for an upward curvature of the eaves (生起 shengqi). The term appears in the Yingzao fashi (1103) and in other official documents written by officials during the Song Dynasty (960-1279) to describe the architecture of mausolea. Modern architectural historians use this term to describe central-bay pillars on all sides of a building dating from the Tang (618-907) to early Ming (1368-1644) dynasties. In traditional Chinese timber-frame architecture, refers to two eaves pillars framing the central bay on the sides of the building parallel to the roof ridge (typically the front side). Leveling pillars are used as a standard height for calculating the height of other pillars across the façade, as they increase in height from the center towards the corners of the building, allowing for an upward curvature of the eaves (shengqi). The term appears in the Yingzao Fashi (1103, Siku quanshu edition., 5.4b) and also in documents written by officials during the Song Dynasty (960-1279) to describe the architecture of mausolea. Modern architectural historians use this term to describe central-bay pillars on all sides of a building dating from the Tang (618-907) to early Ming (1368-1644) dynasties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "píngzhù"@en .

aat:300443527 a skos:Concept ;
    skos:definition "Tailiang is one of the two main systems of traditional Chinese timber-frame structures. The term was coined by architecture historians in the 1940s in contrast to chuandou 穿鬥. “Tailiang” can also be called liangzhushi 梁柱式, jialiangshi 架梁式, dieliangshi 叠梁式, zhuliangshi 柱梁式 and is a system in which beams are as structurally important as pillars and posts in supporting purlins. Literally, “tailiang” means fitting beams on top of the pillars, and fitting posts on top of the beams. Consequently, in this system there are fewer pillars with the building interior. To further distinguish it from chuandou, tailiang is interpreted as a framing system in which beams are supported on top of the pillars, and purlins are extended across the beams. It is usually considered to be the standard timber-frame structure of traditional official buildings in northern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "táiliáng"@en .

aat:300443528 a skos:Concept ;
    skos:definition "In traditional Chinese fortifications, wengcheng refers to the enceinte built outside of gates in city walls. As explained in the Northern Song dynasty text the Wujing zongyao (1045), Chapter 12, City Wall Defenses (Shoucheng 守城), the shape can be square or round. The walls of the wengcheng are at the same height as, or slightly lower than, the main city walls. The battlements on wengcheng are connected to those on the main walls. There is often one gate in the wall of the wengcheng, but it does not align with the gate of the main city wall it is built to protect. The wengcheng in front of the more official gates, such as the main gate of a capital city wall, generally had separate gateways in their centers and sides. These would protect the gate of city wall from invaders, and allow inhabitants to defend from two directions: the top of the wengcheng (above the wengcheng gate) and the top of the city wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wèngchéng"@en .

aat:300443529 a skos:Concept ;
    skos:definition "Most architectural scholars agree that eaves tie beams (yan'e) refer to a structural element positioned atop the eaves pillars, which runs parallel to the roof ridge and spans at least three bays. The use of this element indicates a structural system where the roof is supported by a timber frame parallel to the roof ridge. This stands in contradistinction to the more commonly seen system where the timber-framing elements perpendicular to the roof ridge (support the roof. Scholars are in disagreement about whether the element referred to as the “eaves tie beam” must project from pillars at the corners of the building. The term is primarily used in the Yingzao fashi (1103). However many questions are still unsettled, including the precise definition of the yan’e as used in the Yingzao fashi, the relationship of the yan’e to the mei 楣 (an earlier term used to refer to a lintel), the relationship of the pillar top tie beam (lan’e 闌額), and to the “large-lintel style” (da’e shi 大額式) of structure commonly seen 13th-14th century architecture in Shanxi and Shaanxi, remain unsettled. They usually fall into one of two groups: (1) Scholars who believe that yan’e are lintels that extend through pillars at the corners of the building, following the description in the Yingzao fashi, Chapter 5, 4a. They look to the Linshui ting 臨水亭 of the Jidumiao 濟瀆廟 in Jiyuanxian, Henan, the main hall of the Guanwangmiao 關王廟大殿 in Dingxiangxian, Shanxi, and the Guanyinge 觀音閣 of Kaihuasi 開化寺, in Gaoping municipality, Shanxi as examples. (2) Scholars who emphasize the comment in the Yingzao fashi stating the dimensions of the yan’e regularly exceed those of other timbers used in this location argue that the large individual horizontal timbers on top of eaves pillars that extend the full breadth of the façade are yan’e. They look to the Yuan period Yuwang Hall 禹王殿 in Hancheng municipality, Shaanxi, and the main hall of the Guangsheng Lower Monastery 廣勝下寺大殿 in Hongtong, Shanxi, as examples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yán’é"@en .

aat:300443530 a skos:Concept ;
    skos:definition "First coined in the 1980s (Su Bai 1982, 141-142), yingzuo mugou is a modern term adopted by archaeologists and art historians referring to painted representations of timber architectural components in underground architecture (e.g. tombs and reliquary chambers beneath pagodas). The meaning of yingzuo here as a “painted representation of something” has departed from its original context in the Yingzao fashi. Similar appropriations appeared in 1950s (Su Bai 1957), such as in painted representations of door lintels (yingzuo men’e 影作門額), and painted representations of bracket-sets (yingzuo puzuo 影作鋪作)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yǐngzuò mùgòu"@en .

aat:300443531 a skos:Concept ;
    skos:definition "Seen in the Yingzao fashi (1103 CE), specifically in the text (Chapter 14) and plates (Chapter 34) concerning the polychrome painting works (caihuazuo 彩畫作), yingzuo refers to images of bracket-blocks (sometimes emerging from painted lotus blossoms) with a “neck” and two “feet” (sometimes decorated with floral motifs), painted on the wall surface above the forehead tie beams (eshangbi 額上壁 or gongyanbi 栱眼壁).In current art historical and archaeological scholarship, the term has a broader meaning that described in the Yingzao fashi, and is often used to describe painted representations of timber-framed architecture, such as that found in tombs, cave temples, and reliquary chambers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yǐngzuò"@en .

aat:300443533 a skos:Concept ;
    skos:definition "Angled timber member used in corbel bracket sets and placed perpendicular to the building plane. Can be descending (下昂 xia'ang), where the tip extends downward through the bracket set to the exterior of the building; or ascending (上昂 shang'ang), where it extends from the building plane upward, usually to support the interior building frame. Level timbers placed perpendicular to the building plane include huagong 華栱 and shuatou 耍頭. From the Song and Jin dynasties (10th-13th centuries), we see buildings where 華栱 huagong were made to look like xiaang 下昂 and shuatou 耍頭. These are sometimes called pretend ang (假昂 jia'ang), and slanted bracket arm-shaped shuatou (angxing shuatou 昂形耍頭)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "áng"@en .

aat:300443534 a skos:Concept ;
    skos:definition "Roofing tile of shallow concave shape; can serve as a gutter tile or a covering tile. Eaves tiles of this type have an overhanging lip to allow water to drip away from the bottom edge. These are categorized according to decorative treatment of the lip. Two types described in the Yingzao fashi (e.g. Chapter 13) are the chongchun banwa 重唇瓪瓦 and huatou banwa 華頭瓪瓦 (lit. flower/ornamented head plate tile). Although having the same pronunciation, from the Yuan dynasty onward this term was also written: \"板瓦\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bǎnwǎ"@en .

aat:300443535 a skos:Concept ;
    skos:definition "A type of concave or plate tile, one variety of roofing tile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chóngchún bǎnwǎ"@en .

aat:300443536 a skos:Concept ;
    skos:definition "A type of roofing tile. Term used in the Qing court architectural manual, the Gongcheng zuofa (1734), to describe the type of barrel tile (tongwa 筒瓦) which is used to cap the end of covering tiles at the eaves. A goutou is the barrel tile at the bottom of each tile row used to cap the ends (Liang 1981, 78). This term is commonly found in Ming and Qing dynasty texts. An earlier term for this element is \"wadang.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gōutóu"@en .

aat:300443537 a skos:Concept ;
    skos:definition "A type of ceramic roofing tile with a semi-circular (or greater) cross section. Usually used as a covering tile to prevent water from seeping between two rows of concave/gutter tiles (banwa 瓪瓦). Also written 㼧 (tong (lit. convex tile))."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tòngwǎ"@en .

aat:300443538 a skos:Concept ;
    skos:definition "A specific division of works that involves applying polychrome painting to architectural surfaces, categorized in the Yingzao fashi (1103). The Yingzao fashi details several schemes of polychrome painting works that can be largely divided into two types: (1) zhuangluan 裝銮 (lit. harness bells), which are images and/or patterns painted on components such as bracket-blocks, bracket-arms, cross-beams and pillars, as well as on wall surfaces; (2) shuaran 刷染 (lit. brushed-on colors), which entails less complicated designs and is limited to two or three colors used on the aforementioned surfaces as well as on doors, windows, balustrades (goulan 勾欄), pale fences (chazi 叉子) and other places not specified in the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cǎihuàzuò"@en .

aat:300443539 a skos:Concept ;
    skos:definition "As used in the in the Yingzao fashi (1103) to define a building component, the fang 方 is a structural timber whose cross-section measurement is based on a single standard modular unit (dancai) of the larger building. Its application is relatively flexible, and the term is often modified by the names of locations where it is used within the building. In the Qing dynasty the character fang 枋 encompasses the architectural use of the character 方."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fāng"@en .

aat:300443541 a skos:Concept ;
    skos:definition "Seen in the Yingzao fashi (1103 CE), referring to squared beams (fang 方) carved with bracket-arms in low relief, layered within the wall plane above pillar tops. Also called “superficial bracket arms” (fubigong)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yǐnggǒng"@en .

aat:300443548 a skos:Concept ;
    skos:definition "Any physically defined areas intended for or devoted to the display of organized, usually named, temporary public displays of works of art, crafts, natural history, science, or other items of cultural interest. Exhibition spaces may be enclosed, in defined outdoor areas, built for this purpose or claimed from structures used for other purposes previously, and may be considered either permanent or temporary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition spaces"@en .

aat:300443549 a skos:Concept ;
    skos:definition "Digital optical discs formatted to enable recording, rewriting and playback of high-definition video (HD), as well as storing large amounts of data. Discs in this format offer more than five times the storage capacity of previous DVDs and can hold up to 25GB on a single-layer disc and 50GB on a dual-layer disc. The name Blu-ray comes from the fact that the laser beam which reads the data from Blu-ray and Ultra HD Blu-ray Discs is blue, instead of the red beam used in DVDs and CDs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blu-ray discs"@en .

aat:300443550 a skos:Concept ;
    skos:definition "A surface layer intentionally produced by an artist or a specialized professional on a metallic artwork to mimic a natural patina with aesthetic or practical purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial patina"@en .

aat:300443551 a skos:Concept ;
    skos:definition "Application of an electric DC field for removal of the solubilized salt ions by electromigration. During the process, the concentrations of ions of salts will decrease as these ions concentrate around an electrode of opposite polarity. The electrodes are placed in or on the surface or on a poultice on a salt-infected material and the ions concentrate here. After the desalination the poultice is removed and thereby, the damaging ions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electro-desalination"@en .

aat:300443552 a skos:Concept ;
    skos:definition "The occupation of a habitat or territory by a biological community or of an ecological niche by a single population of a species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonization"@en .

aat:300443553 a skos:Concept ;
    skos:definition "A contemporary art form that adapts scientific methods and draws inspiration from the philosophical, societal, and environmental implications of recombinant genetics, molecular biology, and biotechnology. It features interdisciplinary relationships that blur distinctions between art and science. It may involve biological entities as media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioart"@en .

aat:300443554 a skos:Concept ;
    skos:definition "Condition of fabrication where the item is not ready-made, but is either custom made or made to order for the client."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bespoke"@en .

aat:300443555 a skos:Concept ;
    skos:definition "Fabrication attribute of items that are offered for sale in a complete and finished state, ready for use, as opposed to items that are custom-made or made-to-order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ready-made"@en .

aat:300443556 a skos:Concept ;
    skos:definition "Relatively large retail businesses selling many different kinds of articles, which are arranged in sections or deparments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "department stores"@en .

aat:300443557 a skos:Concept ;
    skos:definition "Artisans who specialize in making hilts for swords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hilt makers"@en .

aat:300443558 a skos:Concept ;
    skos:definition "A chemical vapor deposition process used to deposit a single thin layer (thickness less than 20 micrometer) or multiple thin layers of materials in a gas state (vapor) to a solid state over a substrate. In PECVD, deposition is achieved by introducing reactant gases between parallel electrodes—a grounded electrode and an RF (Radio Frequency)-energized electrode. The capacitive coupling between the electrodes excites the reactant gases into a plasma, which induces a chemical reaction and results in the reaction product being deposited on the substrate. In conservation, PECVD has been used for protection or surface modification of metallic artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasma-enhanced chemical vapor deposition"@en .

aat:300443559 a skos:Concept ;
    skos:definition "Changes in temperature, particularly in the context of collections care and collections environment and historic sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperature fluctuation"@en .

aat:300443560 a skos:Concept ;
    skos:definition "Heritage characterized by the continuity of the original function or the purpose for which it was originally established. Such heritage maintains the continuity of community connections, continues to evolve in the form of tangible and intangible expressions, and taken care through traditional or established means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living heritage"@en .

aat:300443561 a skos:Concept ;
    skos:definition "Bicarbonate salt of the ammonium ion. Often used in baking as a leavening agent and as a cleaning agent in conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium bicarbonate"@en .

aat:300443562 a skos:Concept ;
    skos:definition "To set something apart from others. In some contexts, to identify something and examine or deal with it separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isolation"@en .

aat:300443563 a skos:Concept ;
    skos:definition "To impose isolation on a person, object, or place. Also, a state, period, or place of isolation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarantining"@en .

aat:300443564 a skos:Concept ;
    skos:definition "General term for those who create marbled surfaces by imitating or suggesting the appearance or pattern of marble or another such stone, usually by hand painting on paper, wood, fresco, or other surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marblers"@en .

aat:300443565 a skos:Concept ;
    skos:definition "In a transaction, the ones who receive a thing, award, service, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recipients"@en .

aat:300443566 a skos:Concept ;
    skos:definition "Based chiefly on the Attic dialect, Koine was a fairly uniform Hellenistic Greek spoken and written from the 4th century BCE until the time of the Byzantine emperor Justinian in the mid-6th century CE. Used in Greece, Macedonia, and the parts of Africa and the Middle East. The divergences of the Koine from Classical norms gave rise in the 1st century to a purist movement known as Atticism, which had little effect on the everyday spoken language although it influenced the written language, causing it to have archaizing tendencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koine Greek"@en .

aat:300443567 a skos:Concept ;
    skos:definition "Analytical methods based on the measurement of the dielectric constant of a substance resulting from the orientation of particles (molecules or ions) that have a dipole moment in an electric field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dielectrometry"@en .

aat:300443568 a skos:Concept ;
    skos:definition "A diagnostic method based on electromagnetic measurement of the permittivity of the material under investigation, such as brick, plaster, and stone. The theoretical concept is based on the measurement of the dielectric contrast between water and the host material in the microwave frequency range, and is successful up to 2 cm in depth. In conservation, this method has been usefully employed for determining by non-invasiveway the moisture and salts content inside materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evanescent-field dielectrometry"@en .

aat:300443569 a skos:Concept ;
    skos:definition "Substances which absorb or release large amounts of so-called ‘latent’ heat when they go through a change in their physical state, i.e. from solid to liquid and vice versa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phase change material"@en .

aat:300443570 a skos:Concept ;
    skos:definition "To add color to a black-and-white film or other monochrome image by means of a computer or other methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colorization"@en .

aat:300443571 a skos:Concept ;
    skos:definition "A mineral Pb4Cu4Cl8(OH)8.H2O consisting of a basic lead-copper chloride occurring in deep blue tetragonal crystals. Used as a pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cumengeite"@en .

aat:300443572 a skos:Concept ;
    skos:definition "A semiconducting material that can be used as an additive for thermo conductive, superconductive, glass, ceramics and sensing materials. Copper oxides exist in two different forms: cupric oxide (CuO) and cuprous oxide (Cu2O), depending on the valence state of copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper oxide"@en .

aat:300443573 a skos:Concept ;
    skos:definition "Materials or substrates on which something is inscribed, such as paper or parchment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing materials"@en .

aat:300443574 a skos:Concept ;
    skos:definition "Traditionally in scholarship, Berber was classified as one language. In modern classifications, it is considered a group of languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berber"@en .

aat:300443577 a skos:Concept ;
    skos:definition "Language of the Muslim conquerors of Hindustan, being a form of Hindi with a large admixture of Arabic, Persian, and other foreign elements. Known as the lingua franca of northern India and Pakistan, with two variants Urdu and Hindi, which are official languages in Pakistan and India respectively. Hindustani began to develop during the 13th century CE in and around the Indian cities of Delhi and Meerut in response to the increasing linguistic diversity that resulted from Muslim hegemony. In the 19th century its use was widely promoted by the British, who initiated an effort at standardization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindustani"@en .

aat:300443578 a skos:Concept ;
    skos:definition "Afroasiatic languages spoken in northern Nigeria, southern Niger, southern Chad, Central African Republic, and northern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chadic"@en .

aat:300443579 a skos:Concept ;
    skos:definition "Indo-European languages spoken primarily by the Slavic peoples or their descendants"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Slavic"@en .

aat:300443580 a skos:Concept ;
    skos:definition "Varieties of Greek used in Eastern and early Western Christianity; often but not always Koine Greek."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liturgical Greek"@en .

aat:300443581 a skos:Concept ;
    skos:definition "Languages that include Tashelhit, Tarifit, Kabyle, Tamazight, and Tamahaq; may also include extinct languages such as the Guanche languages of the Canary Islands, Old Libyan (Numidian), and Old Mauretanian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berber dialects"@en .

aat:300443596 a skos:Concept ;
    skos:definition "The quality or state of being readable or decipherable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legibility"@en .

aat:300443603 a skos:Concept ;
    skos:definition "United Nations scheme for Romanization of geographical names from Arabic letters to the Latin alphabet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unified Arabic System"@en .

aat:300443610 a skos:Concept ;
    skos:definition "Areas comprising a portion of a harbor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sections of harbors"@en .

aat:300443611 a skos:Concept ;
    skos:definition "Anchorages located near shorelines that are less safe than harbors, but where ships may safely ride at anchor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roadsteads"@en .

aat:300443612 a skos:Concept ;
    skos:definition "Areas of land that are leased by governments for the purpose of economic development, such as for forestry or mining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concession areas"@en .

aat:300443613 a skos:Concept ;
    skos:definition "Areas where military exercises are performed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maneuver areas"@en .

aat:300443614 a skos:Concept ;
    skos:definition "Areas where peat is harvested."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peat cutting areas"@en .

aat:300443630 a skos:Concept ;
    skos:definition "The language of the Copts, developed from ancient Egyptian language. It now survives as the liturgical language of the Coptic Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coptic"@en .

aat:300443660 a skos:Concept ;
    skos:definition "Places where two or more rail routes join; may also be used to refer to places where two rail carriers exchange freight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad junctions"@en .

aat:300443661 a skos:Concept ;
    skos:definition "Sloping cut surfaces through hills or ridges caused by excavations for roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "road cuts"@en .

aat:300443662 a skos:Concept ;
    skos:definition "Curved or bent sections of roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "road bends"@en .

aat:300443763 a skos:Concept ;
    skos:definition "Facilities where agricultural products are baled; may also be used generally for facilities that bale any waste or refuse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baling stations"@en .

aat:300443764 a skos:Concept ;
    skos:definition "Places where multiple facilities are situated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facility centers"@en .

aat:300443765 a skos:Concept ;
    skos:definition "Depots where fuel is stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuel depots"@en .

aat:300443767 a skos:Concept ;
    skos:definition "Plants for separating gas from oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas-oil separator plants"@en .

aat:300443768 a skos:Concept ;
    skos:definition "Mills where oil is extracted from olives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive oil mills"@en .

aat:300443769 a skos:Concept ;
    skos:definition "Mines where chrome ore is extracted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome mines"@en .

aat:300443770 a skos:Concept ;
    skos:definition "Mines where nickel is produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickel mines"@en .

aat:300443771 a skos:Concept ;
    skos:definition "Mines used to extract minerals from stream bed deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "placer mines"@en .

aat:300443772 a skos:Concept ;
    skos:definition "Facilities that pump oil through pipelines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil pumping stations"@en .

aat:300443773 a skos:Concept ;
    skos:definition "Administrative centers for parks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "park headquarters"@en .

aat:300443774 a skos:Concept ;
    skos:definition "Breeding areas for colonies of birds or seals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rookeries"@en .

aat:300443775 a skos:Concept ;
    skos:definition "Places that provide seclusion for the purposes of rest and relaxation, or for prayer and meditation, especially for religious groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retreats"@en .

aat:300443781 a skos:Concept ;
    skos:definition "Tanks or artificial ponds used for immersing cattle in chemically treated water for the purpose of preventing disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle dipping tanks"@en .

aat:300443795 a skos:Concept ;
    skos:definition "Sections of oil pipelines where two or more pipelines join together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil pipeline junctions"@en .

aat:300443798 a skos:Concept ;
    skos:definition "Controlled access points to parks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "park gates"@en .

aat:300443799 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the Commonwealth of Dominica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dominican"@en .

aat:300443800 a skos:Concept ;
    skos:definition "A plant oil produced from the kernels of the argan tree (Argania spinosa L.) that is endemic to Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argan oil"@en .

aat:300443801 a skos:Concept ;
    skos:definition "Instruments developed by the Institute of Applied Physics of the CNR of Florence (Istituto di Fisica Applicata del CNR di Firenze) that are based on evanescent field dielectrometry (EFD). These instruments work in the microwave range (1-1.5 GHz), ar portable, and allow real-time non-invasive measurements of sub-surface moisture content and the detection of soluble salts (salinity index)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "SUSI instruments"@en .

aat:300443802 a skos:Concept ;
    skos:definition "The process of becoming gelatinous. In conservation this may refer to a chemical deterioration of parchment and leather tanned with condensed vegetable tannins, where collagen turns into water-soluble gelatin. This occurs as a reaction to substantial fluctuations in temperature and moisture or when parchment and such materials are stored under acidic condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatinization"@en .

aat:300443803 a skos:Concept ;
    skos:definition "Simple bronze conical tubes attached to the inside of a guitar’s sound hole that accentuates the instrument’s bass register and directs the sound towards the listener. It is a standard component of many guitars built in the 19th century, but has fallen from use in contemporary guitars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tornavozes"@en .

aat:300443804 a skos:Concept ;
    skos:definition "A mineral Mg3As2O8.8H2O consisting of hydrous magnesium arsenate occurring as crystals resembling gypsum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoernesite"@en .

aat:300443805 a skos:Concept ;
    skos:definition "Areas of undersea corrugations; now rarely used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrugados"@en .

aat:300443835 a skos:Concept ;
    skos:definition "Brazilian dry-climate general regions far from urban areas. These are inhabited by people such subsistence farmers, and are considered to have their own distinct cultural associations apart from the urban experience, equating to 'country' or 'rural' life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sertões"@en .

aat:300443839 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Chechen ethnic group, living primarily in the modern Russian republic of Chechnya in the North Caucasus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chechen"@en .

aat:300443840 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Mordvin people of the middle Volga region in modern western Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mordvin"@en .

aat:300443841 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Chuvash Republic and Chuvash people of modern Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chuvash"@en .

aat:300443842 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Bashkir people of modern day Russia, specifically the republic of Bashkortostan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bashkir"@en .

aat:300443843 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Kabardino-Balkariya republic of modern day Russia, located in the North Caucasus, which is comprised largely of the Kabardin and Balkar peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kabardino-Balkar"@en .

aat:300443844 a skos:Concept ;
    skos:definition "Refers to the style and culture of the former nation of Czechoslovakia (1918-1993)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Czechoslovakian"@en .

aat:300443845 a skos:Concept ;
    skos:definition "Organisms that feed upon wood, as an insect larva, or boring into and destroying wood, as a mollusc or crustacean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xylophages"@en .

aat:300443846 a skos:Concept ;
    skos:definition "Business specializing in planning of gardens, which are open spaces where flowers, shrubs, trees, vegetables, or fruits are grown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden design firms"@en .

aat:300443847 a skos:Concept ;
    skos:definition "Businesses that specialize in the design and arrangement of interior spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior design firms"@en .

aat:300443848 a skos:Concept ;
    skos:definition "Businesses that specialize in stages involved in bringing a product from concept or idea through market release and beyond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "product development firms"@en .

aat:300443849 a skos:Concept ;
    skos:definition "Artists specializing in a method of painting by means of an airbrush, which is a small, finely controllable mechanical paint sprayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airbrush artists"@en .

aat:300443850 a skos:Concept ;
    skos:definition "Facilities where vehicles that navigate through the air are manufactured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft factories"@en .

aat:300443851 a skos:Concept ;
    skos:definition "People or corporate bodies that sell antiques, which are artifacts created or produced in former periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antique dealers"@en .

aat:300443852 a skos:Concept ;
    skos:definition "Persons or corporate bodies who work on behalf of artists to sell their works, find commissions, or otherwise assist the artist in locating lucrative opportunities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art agents"@en .

aat:300443853 a skos:Concept ;
    skos:definition "People or businesses who represent collectors and investors in locating and purchasing art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art brokers"@en .

aat:300443854 a skos:Concept ;
    skos:definition "Business enterprises involved in the buying and selling of art works on behalf of artists or otherwise engaged in art sales between two parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art dealerships"@en .

aat:300443855 a skos:Concept ;
    skos:definition "Craftspeople who make hairwork, which are visual works incorporating human or animal hair as the medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairwork artists"@en .

aat:300443856 a skos:Concept ;
    skos:definition "Places or areas that are no longer occupied, modified, or inhabited by communities of human populations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former inhabited places"@en .

aat:300443857 a skos:Concept ;
    skos:definition "General term for administrative divisions, usually of a nation, that represent the fifth highest unit or level under the nation itself, typically under the fourth level subdivision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifth level subdivisions"@en .

aat:300443858 a skos:Concept ;
    skos:definition "Physical or virtual repositories comprising accumulated groups of objects or materials having a focal characteristic and that have been brought together by an individual or organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collections"@en .

aat:300443859 a skos:Concept ;
    skos:definition "Groups who work to promote or accomplish stated goals through projects or other activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initiatives"@en .

aat:300443860 a skos:Concept ;
    skos:definition "Groups who work to promote or accomplish stated goals, provide opportunities, or promote art and artists through projects or other activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arts initiatives"@en .

aat:300443861 a skos:Concept ;
    skos:definition "Distinctive dioramas as made by Cornelius Bavelaar father or son, or other dioramas in the same style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bavelaars"@en .

aat:300443862 a skos:Concept ;
    skos:definition "Artists who specialize in dioramas, which are sculptural or other three-dimensional works, often figural or views and enclosed in a case or niche."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diorama makers"@en .

aat:300443863 a skos:Concept ;
    skos:definition "Female unmarried or widowed members of religious, ascetic or philanthropic lay societies, devoted to religious life, but not bound by strict vows of a religious order, and who may marry. Beguines often lived in communities called beguinages. This way of life first appeared in Liège toward the end of the 12th century, and use of the term was established by the 1230s. By this time the movement had spread throughout the Low Countries, Germany, and northern France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beguines"@en .

aat:300443864 a skos:Concept ;
    skos:definition "Artists creating bioart, whose works incorporate biotechnological materials as artistic medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bio artists"@en .

aat:300443865 a skos:Concept ;
    skos:definition "People who acquire books and other bound materials in order to establish a collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book collectors"@en .

aat:300443866 a skos:Concept ;
    skos:definition "Retail establishments that sell books and other bound materials or recordings of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookstores"@en .

aat:300443867 a skos:Concept ;
    skos:definition "Enterprises that specialize in making carpets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpet manufactories"@en .

aat:300443868 a skos:Concept ;
    skos:definition "A method of relief printing in which chemicals are used to etch a metal plate on which a drawing has been made, or a similar process by which photographs are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemigraphy"@en .

aat:300443869 a skos:Concept ;
    skos:definition "Printmakers who do relief printing in which chemicals are used to etch a metal plate, ususally upon which a drawing has been made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemigraphers"@en .

aat:300443870 a skos:Concept ;
    skos:definition "Prints made by relief printing in which chemicals are used to etch a metal plate on which a drawing has been made; examples are illustrations, maps, or other designs printed from a plate prepared by a chemical process such as a zinc-etching process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemitypes"@en .

aat:300443871 a skos:Concept ;
    skos:definition "Craftsmen who specialize in making chests and other relatively simple case furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chest makers"@en .

aat:300443872 a skos:Concept ;
    skos:definition "Printmakers who create collotypes, which are prints made by a particular photomechanical process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collotypists"@en .

aat:300443873 a skos:Concept ;
    skos:definition "Organizations or departments providing training and work space for conservation professionals who study and treat works of art and architecture or other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation laboratories"@en .

aat:300443874 a skos:Concept ;
    skos:definition "Structures or other physical spaces where conservation work is carried out on art, architecture, or other works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation laboratories"@en .

aat:300443875 a skos:Concept ;
    skos:definition "Sculptors who specialize on works carved from or applied to surfaces of architectural members, usually exterior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural sculptors"@en .

aat:300443876 a skos:Concept ;
    skos:definition "Businesses that are qualified to give professional advice or services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consultancies"@en .

aat:300443877 a skos:Concept ;
    skos:definition "Engraving printmakers in the service of a royal or noble court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court engravers"@en .

aat:300443878 a skos:Concept ;
    skos:definition "Studios in which one or more masters create decorative arts works, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative arts studios"@en .

aat:300443879 a skos:Concept ;
    skos:definition "People who specialize in the engraving of dies for stamping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diesinkers"@en .

aat:300443881 a skos:Concept ;
    skos:definition "Personages holding high rank or office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dignitaries"@en .

aat:300443882 a skos:Concept ;
    skos:definition "Film or video makers who present fact and real situations and people rather than fiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary filmmakers"@en .

aat:300443883 a skos:Concept ;
    skos:definition "Painters who produce many works in quick succession for profit or otherwise to meet market demand, particularly as applied to Dutch painters in 17th-18th centuries. The term may carry overtones of works having mediocre quality or being of a duplicative nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dozijnschilders"@en .

aat:300443884 a skos:Concept ;
    skos:definition "Printmakers who specialize in drypoints, intaglio prints using a process whereby a sharp needle scratches the plate creating a burr."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drypointists"@en .

aat:300443885 a skos:Concept ;
    skos:definition "Artists who paint on faience, which is tin-glazed European earthenware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faience painters"@en .

aat:300443886 a skos:Concept ;
    skos:definition "Painters specializing in creating decoration and painted scenes on fans, which are hand-held personal accessories used to produce a current of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan painters"@en .

aat:300443887 a skos:Concept ;
    skos:definition "Experts in or students of the German language, literature, history, or culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Germanists"@en .

aat:300443888 a skos:Concept ;
    skos:definition "Painters specializing in grisaille, which is painting images in monochrome, usually gray tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grisaillists"@en .

aat:300443889 a skos:Concept ;
    skos:definition "People who specialize in making guilloche designs, which are complex patterns or ornaments of interlaced curving bands, made by hand or with a specialized machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guilloche artists"@en .

aat:300443890 a skos:Concept ;
    skos:definition "Businesses focused on selling, and often making, hats and other headgear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat shops"@en .

aat:300443891 a skos:Concept ;
    skos:definition "People who create icons, which are images that portray a sacred entity and that are themselves regarded as sacred. Iconographers intend to translate revealed scripture and divine truths into visual images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iconographers"@en .

aat:300443892 a skos:Concept ;
    skos:definition "People who touch up or edit images and illustrations, including photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image editors"@en .

aat:300443893 a skos:Concept ;
    skos:definition "Firms that specialize in the design of functional objects that can be mass-produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial design firms"@en .

aat:300443894 a skos:Concept ;
    skos:definition "Businesses that sell furniture, which is movable objects or equipment for sitting, reclining, or storage, such as chairs, beds, tables, and cabinets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture stores"@en .

aat:300443898 a skos:Concept ;
    skos:definition "People who sell, and may also make, hose, stockings, socks, and other frame-knitted or woven underclothing generally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosiers"@en .

aat:300443901 a skos:Concept ;
    skos:definition "People who sell or deal in tobacco, which is smoked, chewed, or otherwise ingested, and is derived from the leaf of any of several plants of the genus Nicotiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacconists"@en .

aat:300443903 a skos:Concept ;
    skos:definition "People who sell, and may also make, saddles, which are seats made over a frame and placed on a horse's or other animal's back for carrying riders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddlers"@en .

aat:300443908 a skos:Concept ;
    skos:definition "People who lend money at interest on the security of an article deposited in their possession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pawnbrokers"@en .

aat:300443911 a skos:Concept ;
    skos:definition "Proprietors or managers of operations in inns, which are relatively small buildings where travellers are provided with overnight accommodation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "innkeepers"@en .

aat:300443912 a skos:Concept ;
    skos:definition "Artists who specialize in works made with and existing in the context of networked systems and the internet, meant to be accessed online via network protocols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internet artists"@en .

aat:300443913 a skos:Concept ;
    skos:definition "People who sell jewelry, which comprises personal ornaments made of precious materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry merchants"@en .

aat:300443914 a skos:Concept ;
    skos:definition "Women identified by a particular honorific, historically designating the lowest rank of Dutch nobility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jonkvrouws"@en .

aat:300443915 a skos:Concept ;
    skos:definition "Men identified by a particular honorific, historically designating the lowest rank of Dutch nobility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jonkheers"@en .

aat:300443916 a skos:Concept ;
    skos:definition "People who perform a variety of work to maintain and develop landscaped areas; tasks may include planting and maintaining ornamental trees, shrubs, flowers, lawns, hardscapes, as well as litter and trash removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape gardeners"@en .

aat:300443918 a skos:Concept ;
    skos:definition "Artists who create works featuring light as an artistic medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light artists"@en .

aat:300443919 a skos:Concept ;
    skos:definition "Primarily referring to historical people, people who are scholars, skilled writers, or otherwise have a variety of literary or intellectual interests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people of letters"@en .

aat:300443920 a skos:Concept ;
    skos:definition "Ceramicists who specialize in majolica, which is tin-glazed earthenware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "majolicists"@en .

aat:300443921 a skos:Concept ;
    skos:definition "General term for earthenware having a white, shiny, opaque glaze comprising lead with tin oxide. On this white background are typically brightly colored patterns, scenes, or other decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin-glazed ware"@en .

aat:300443922 a skos:Concept ;
    skos:definition "Decorative ware, typically those produced in the19th-century, characterized by in thick lead glazes and loosely based on Italian 16th-century maiolica. It was first introduced at the Minton Ceramic Factory in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "majolica"@en .

aat:300443923 a skos:Concept ;
    skos:definition "People who make decorative trimmings, and often apply them, to costume, upholstery, or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimmers"@en .

aat:300443924 a skos:Concept ;
    skos:definition "Highly skilled printers who work very closely with artists to produce editions of the artists' work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master printers"@en .

aat:300443925 a skos:Concept ;
    skos:definition "Publishers of prints, which are pictorial works produced by transferring images by means of a matrix such as a plate, block, or screen, using any of various printing processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print publishers"@en .

aat:300443926 a skos:Concept ;
    skos:definition "People who sell prints, which are pictorial works produced by transferring images by means of a matrix such as a plate, block, or screen, using any of various printing processes. Printsellers often focus on selling engravings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printsellers"@en .

aat:300443927 a skos:Concept ;
    skos:definition "Domestic officers who are responsible for procuring or requisitioning provisions for the household, usually for a monarch or other high-ranking person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purveyors"@en .

aat:300443928 a skos:Concept ;
    skos:definition "People who specialize in pyrography, which is the process of producing designs or pictures (as on wood or leather) by burning or scorching with hot instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrographers"@en .

aat:300443929 a skos:Concept ;
    skos:definition "Art studios are groups comprising a master artist or architect and his or her assistants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art studios"@en .

aat:300443930 a skos:Concept ;
    skos:definition "Printmakers who create prints that depict other works, generally prints are in the media of litography, etching, or engraving, with prints intended to be published and distributed in relatively large numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductions printmakers"@en .

aat:300443931 a skos:Concept ;
    skos:definition "Photographs taken to reproduce another work, including another photograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductive photographs"@en .

aat:300443932 a skos:Concept ;
    skos:definition "Photographers who specialize in creating works that copy existing works, including other photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductive photographers"@en .

aat:300443933 a skos:Concept ;
    skos:definition "Etchers who create plates depicting other works, from which it is intended to print reproductions in relatively large numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductions etchers"@en .

aat:300443934 a skos:Concept ;
    skos:definition "Lithographers who create plates depicting other works, from which it is intended to print reproductions in relatively large numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductions lithographers"@en .

aat:300443935 a skos:Concept ;
    skos:definition "Businesses that specialize in calligraphic works, which are works composed primarily of beautiful, elegant letters or flourishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calligraphy businesses"@en .

aat:300443936 a skos:Concept ;
    skos:definition "Artists who specialize in Matter art, which is painting characterized by thick, crusted paint and the incorporation of discarded materials such as scraps of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matter painters"@en .

aat:300443937 a skos:Concept ;
    skos:definition "Artists who create or compile images, animation, video, audio, print, and digital media to create advertisements, television shows, websites, or other media productions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "media artists"@en .

aat:300443938 a skos:Concept ;
    skos:definition "Businesses that focus on processing or shaping products out of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking businesses"@en .

aat:300443939 a skos:Concept ;
    skos:definition "Architects overseeing the preparation of plans and specifications related to municipal structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal architects"@en .

aat:300443940 a skos:Concept ;
    skos:definition "Architects who specialize in the preservation and conservation of historic buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restoration architects"@en .

aat:300443941 a skos:Concept ;
    skos:definition "Specialists in offset printing, in which the image is transferred from a roller, plate, block, or stone to an intermediary, such as a rubber blanket or roller, then onto the paper or other final surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset printmakers"@en .

aat:300443942 a skos:Concept ;
    skos:definition "Highly trained experts who work with pearls, their main task being to peel away the multiple skins of a natural pearl layer by laye to uncover a series of tints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearl cutters"@en .

aat:300443943 a skos:Concept ;
    skos:definition "People who design websites, particularly with a focus on aesthetics, content, and ease of use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web designers"@en .

aat:300443944 a skos:Concept ;
    skos:definition "People who touch up or edit digital photographs or traditional photo-chemical photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photo editors"@en .

aat:300443945 a skos:Concept ;
    skos:definition "Artisans skilled in engraving on stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone engravers"@en .

aat:300443946 a skos:Concept ;
    skos:definition "Makers of mats, which are pieces of protective boards or other heavy paper, often ornamented, used to support and protect a two-dimensional art work in a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mat makers"@en .

aat:300443947 a skos:Concept ;
    skos:definition "Artisans who specialize in creating decorative borders, particulaly on framing mats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passe-partout makers"@en .

aat:300443948 a skos:Concept ;
    skos:definition "People or corporate bodies who make carpets, fabrics, costume, or other works made of textile materials, which are natural or synthetic fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile manufacturers"@en .

aat:300443949 a skos:Concept ;
    skos:definition "Artists, usually painters or photographers, who specialize in panoramas, which are pictorial representations with very broad horizontal ranges of view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panoramists"@en .

aat:300443950 a skos:Concept ;
    skos:definition "Painters who specialize in figures and other elements of paintings, which are not the primary subjects of the painting. For example, those who specialize in adding figures to a landscape painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staffage painters"@en .

aat:300443951 a skos:Concept ;
    skos:definition "Artists who specialize in painting designs or scenes on tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile painters"@en .

aat:300443952 a skos:Concept ;
    skos:definition "Artists who specialize in painting or stamping designs or scenes on wallpaper, which is decorative paper made primarily for attachment to walls and ceilings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wallpaper painters"@en .

aat:300443953 a skos:Concept ;
    skos:definition "Professionals who decorate or cover interior walls with wallpaper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paperhangers"@en .

aat:300443954 a skos:Concept ;
    skos:definition "Artists who draw using pencils, which are implements comprising rods of a marking substance, enclosed in wood, plastic, or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencilers"@en .

aat:300443955 a skos:Concept ;
    skos:definition "Artists who draw using pen and ink as media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen draftsmen"@en .

aat:300443956 a skos:Concept ;
    skos:definition "People who create or sell perfumes, which are liquids or pastes containing aromatic ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfumers"@en .

aat:300443957 a skos:Concept ;
    skos:definition "People regarded by others as an example to be imitated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "role models"@en .

aat:300443958 a skos:Concept ;
    skos:definition "People skilled or trained in physiotherapy, which is the treatment of injury, disease, or pain by physical methods, such as manipulation, massage, exercise, and application of heat or cold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physiotherapists"@en .

aat:300443959 a skos:Concept ;
    skos:definition "People who are in charge of classrooms and teach at a school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schoolmasters"@en .

aat:300443960 a skos:Concept ;
    skos:definition "People who set up machinery, equipment, or other items in preparation for a job or task."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "set-up people"@en .

aat:300443961 a skos:Concept ;
    skos:definition "Artists who make zincographs, which are engraved or etched designs on zinc, or prints from such designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zincographers"@en .

aat:300443962 a skos:Concept ;
    skos:definition "People or corporate bodies who make thin matted or felted sheets or webs of fiber formed and dried on a fine screen from a pulpy water suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper manufacturers"@en .

aat:300443963 a skos:Concept ;
    skos:definition "Retail businesses selling various articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stores"@en .

aat:300443964 a skos:Concept ;
    skos:definition "Administrative divisions that care for collections of library materials separated from the general collection because they are rare and valuable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special collections"@en .

aat:300443965 a skos:Concept ;
    skos:definition "Enterprises where scientific experiments or other research, testing, and investigations happen in a space equipped to facilitate these activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laboratories"@en .

aat:300443966 a skos:Concept ;
    skos:definition "Enterprises where scientific experiments and research take place, in in a space equipped to facilitate these activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science laboratories"@en .

aat:300443967 a skos:Concept ;
    skos:definition "Private orgainizations or other people who care for collections of art, library materials, or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private collections"@en .

aat:300443968 a skos:Concept ;
    skos:definition "Enterprises where operating a site or factory where iron is smelted, or where heavy iron goods are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironworks businesses"@en .

aat:300443969 a skos:Concept ;
    skos:definition "An organization or administrative division that oversees a particular activity or concern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centers"@en .

aat:300443970 a skos:Concept ;
    skos:definition "A building or complex of buildings devoted to a particular activity or concern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centers"@en .

aat:300443971 a skos:Concept ;
    skos:definition "Physical locations, such as a city or district, regarded as constituting a central point for trade or some other activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centers"@en .

aat:300443974 a skos:Concept ;
    skos:definition "People who work for another person or corporate body, particularly when employed for wages or a salary under an employment agreement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "employees"@en .

aat:300443975 a skos:Concept ;
    skos:definition "Retail businesses that sell merchandise or services, usually relatively small in scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shops"@en .

aat:300443978 a skos:Concept ;
    skos:definition "Material that causes illness or death when absorbed, inhaled, or ingested by a living organism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poisonous substance"@en .

aat:300443979 a skos:Concept ;
    skos:definition "Material that is secreted by a reptile or other animal and when injected, causes illness or death to the victim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "venom"@en .

aat:300443980 a skos:Concept ;
    skos:definition "Radioactive, soft, metallic chemical element, atomic number 88; a member of the group of the alkaline earth metals. It occurs in small amounts in pitchblende and other uranium ores. It undergoes spontaneous disintegration to form Radon gas and alpha rays. Bright white radium was formerly used to make luminous paints used in clock dials, doorknobs, and other glow-in-the-dark items prior to the 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radium"@en .

aat:300443981 a skos:Concept ;
    skos:definition "The extent of a continuous passage of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duration"@en .

aat:300443982 a skos:Concept ;
    skos:definition "The state or action of being subject to an external influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exposure"@en .

aat:300443983 a skos:Concept ;
    skos:definition "The greatest quantity, value, or magnitude attainable or attained within a set of like variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maximum"@en .

aat:300443984 a skos:Concept ;
    skos:definition "The least allowable or possible quantity, value, or degree attainable or attained within a set of like variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minimum"@en .

aat:300443985 a skos:Concept ;
    skos:definition "Changes in relative humidity, particularly in the context of collections care and collections environment and historic sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relative humidity fluctuation"@en .

aat:300443986 a skos:Concept ;
    skos:definition "Objective goals to be achieved, or quantities to be attained through action or development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "targets"@en .

aat:300443987 a skos:Concept ;
    skos:definition "The distance between successive peaks of a wave or wave-like formation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wavelength"@en .

aat:300443988 a skos:Concept ;
    skos:definition "Sections made by a plane cutting anything transversely, especially at right angles to the longest axis. In conservation, cross-sectional analysis is employed in a variety of contexts, including examining paint layers and fiber analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross sections"@en .

aat:300443989 a skos:Concept ;
    skos:definition "Dealing with or offering comparison between two or more different cultures or cultural areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross cultural"@en .

aat:300443990 a skos:Concept ;
    skos:definition "Objects produced by industrial technology. These may include such things as machinery, transport vehicles, or military equipment, and mass-produced consumer goods. These are often constructed of hybrid materials which may include metal and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial objects"@en .

aat:300443991 a skos:Concept ;
    skos:definition "Crude high-carbon iron ore that has been smelted and cast into ingots. This may be remelted and used as a source of material for cast-iron products, or may be further refined for use in producing steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pig iron"@en .

aat:300443992 a skos:Concept ;
    skos:definition "Method for analyzing the image of a textured object into a set of quantitative measurements revealing its qualities described by terms such as rough, smooth, silky, or bumpy as a function of the spatial variation in pixel intensities. The sample images can be obtained through various digital image processing methods, including diffraction-based analyses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quantitative texture analysis"@en .

aat:300443993 a skos:Concept ;
    skos:definition "The preparation of inorganic polymers or ceramics from solution through a transformation from liquid precursors to a sol and finally to a network structure called a ‘gel.’ Traditionally, the formation of a sol occurs through hydrolysis and condensation of metal alkoxide precursors, but a sol can be more generally defined as a colloidal suspension, which encompasses a wider range of systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sol-gel process"@en .

aat:300443994 a skos:Concept ;
    skos:definition "A registered trademark for a series of products made from a patented plastic barrier film. It is composed of a polymer matrix to which copper particles are bonded forming a reactive film that neutralizes all corrosive gases from passing through, neutralizes contaminants, blocks ozone and retards bacteria production. In conservation, can also be used to slow the degradation of cellulose acetate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corrosion Intercept (TM)"@en .

aat:300443995 a skos:Concept ;
    skos:definition "A system of marking locations using an electronic device or “marker,” which is buried at a site. Locators are used later to transmit a signal to the buried marker, which returns a signal that indicates the marker’s exact position. Originally developed for utility companies to quickly and accurately locate buried features such as power, water, gas, and fiber optic lines, the technology has potential for use in cultural resource management."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Electron Marker System"@en .

aat:300443996 a skos:Concept ;
    skos:definition "An earthy, yellowish or rusty brown mineral found in sulphide deposits and soil or formed by the corrosion of iron. The most typical sign of active corrosion of iron objects is surface loss due to the presence of akaganeite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "akaganeite"@en .

aat:300443997 a skos:Concept ;
    skos:definition "The use or of investigation with a stereomicroscope or binocular microscopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereomicroscopy"@en .

aat:300443998 a skos:Concept ;
    skos:definition "The interaction of persons or groups of persons representing various nations in the pursuit of a common goal or interest; international cooperative activities with or without the participation of governments"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international cooperation"@en .

aat:300443999 a skos:Concept ;
    skos:definition "Colorless liquid that polymerizes in light and that is used to make polyvinyl acetate. Used to make adhesives, paints, and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl acetate"@en .

aat:300444000 a skos:Concept ;
    skos:definition "Dresses of southern Chinese origin, typically having a high mandarin collar, a split skirt, and a fitted bodice with an asymmetrical closure extending from the neck to the right underarm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheongsams"@en .

aat:300444001 a skos:Concept ;
    skos:definition "A fossil resin similar to amber, but with little succinic acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gedanite"@en .

aat:300444002 a skos:Concept ;
    skos:definition "A major fiber-associated component of wheat bran and legumes responsible for the storage of phosphorus. In paper conservation, it has been used as a treatment for iron-catalyzed oxidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phytic acid"@en .

aat:300444003 a skos:Concept ;
    skos:definition "Plasma in which the temperature of the individual constituents differ from one-another. Electrons are at higher temperature (more than 10,000K) and neutral atoms are at room temperature. However, the density of the electrons in the plasma is very low compared to the density of the neutral atoms. Cold plasma technology offers an approach to decontaminating or restoring materials by removing oxides, chlorides, and other corrosive salts as well as rendering fungi and bacteria inert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold plasma"@en .

aat:300444004 a skos:Concept ;
    skos:definition "A solid organic compound that was one of the first alcohols to be isolated from fats. Used widely in lubricants, emulsifiers, insecticides, and detergents. In conservation, can be used as a reinforcing agent for waterlogged archaeological wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cetyl alcohol"@en .

aat:300444005 a skos:Concept ;
    skos:definition "Describes the ability of solid materials to resist damage by chemical reactivity or solvent action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical resistance"@en .

aat:300444006 a skos:Concept ;
    skos:definition "The process of reconstructing an existing object by starting with the final product and working through the design process in the opposite direction. It may involve disassembling and examining and analyzing the object or action in detail to discover the concepts involved in manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverse engineering"@en .

aat:300444007 a skos:Concept ;
    skos:definition "Legal entities that hold rights or oversee the aggregate of property or liabilities that a person leaves for their disposal at death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estates"@en .

aat:300444008 a skos:Concept ;
    skos:definition "A large-scale, prefabricated, solid engineered wood panel consisting of several layers of kiln-dried lumber boards stacked in alternating directions, bonded with structural adhesives and pressed to form a solid, straight, rectangular panel. Generally used to build walls and floors of wood houses, but they have mechanical characteristics that are suitable for strengthening ancient wood floors in restoration interventions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-laminated timber"@en .

aat:300444009 a skos:Concept ;
    skos:definition "A fine to very fine grain, highly porous and calcerous sandstone quarried in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giallo terra di Siena"@en .

aat:300444010 a skos:Concept ;
    skos:definition "Natural-coloured substances produced by living organisms, including microorganisms. It includes pigments that affect the coloration of plumage in birds and pigmentation of materials caused by biodeterioration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biopigment"@en .

aat:300444011 a skos:Concept ;
    skos:definition "Paper that has been treated with a drying oil. The oil dries producing a plastic-like flexible film that was often used for leather papers, packaging, and tracing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil-coated paper"@en .

aat:300444012 a skos:Concept ;
    skos:definition "Powdered hide usually specially prepared and standardized for use in the analysis of tannins and tanning materials. May also be used in leafcasting parchment orvellum objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hide powder"@en .

aat:300444013 a skos:Concept ;
    skos:definition "The last 100 years (from 800 to 900 CE) of the Classic Period of the Mesoamerican chronology, which is generally defined as the period from 300 to 900 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Terminal Classic"@en .

aat:300444014 a skos:Concept ;
    skos:definition "Meaning “seven colors”, a term used to describe a technique of painting on glazed tiles to create tile-work crafts that can be found in ornaments of many architectures and shrines of Iran and can be traced back to the Seljuk dynasty. It features black lines that delineate the tiles' design. The high maturing temperature of this line prevented the low-temperature coloured glazes run together during the firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haft rang"@en .

aat:300444015 a skos:Concept ;
    skos:definition "Period and culture of the ancient South Arabian kingdom that occupied what are now southern and southeastern Yemen and the present-day Sultanate of Oman. Hadramawt maintained its political independence until late in the 3rd century AD, when it was conquered by the kingdom of Saba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadramawt"@en .

aat:300444016 a skos:Concept ;
    skos:definition "A bright blue-green gel or light blue powder. Cupric hydroxide will decompose with time or heat to form black copper oxide. It is used as a source for copper salts and as a mordant in dyeing textiles. Copper hydroxide reacts with Ammonium hydroxide to form the cuprammonium that is capable of dissolving Cellulose. It is used in the manufacture of rayon. Copper hydroxide has also been reported as a component in marine corrosion crusts on copper alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper hydroxide"@en .

aat:300444017 a skos:Concept ;
    skos:definition "A machine-assisted treatment method of removing dust and biological contaminants from paper, photographic materials, and textiles. Contaminant removal is performed by frictionless application of an electrostatic foil. The technology allows removal of dust contaminants from both sides, even from delicate surfaces, while keeping existing drawing and writing materials or pigment layers intact. In the cleaning and hygiene industry, the term is often used interchangeably with electrostatic disinfecting, which sprays a negatively-charged disinfecting solution onto a contaminated surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrostatic cleaning"@en .

aat:300444018 a skos:Concept ;
    skos:definition "An inorganic sol-gel material developed as a consolidant for loose paint layers on stained glass windows. When added to glass or ceramics, SZA forms an irreversible bond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicon zirconium alkoxide"@en .

aat:300444019 a skos:Concept ;
    skos:definition "An environmentally benign (“green”) solvent with effectiveness comparable to petroleum-based solvents. It is formed by the esterification reaction of ethanol and lactic acid, which can be generated from biomass raw materials through fermentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethyl lactate"@en .

aat:300444020 a skos:Concept ;
    skos:definition "Colorless liquid solvent with an aromatic odor. Vinyl toluene is a usually sold as a mixture of isomers and is used to dissolve paints and varnishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl toluene"@en .

aat:300444021 a skos:Concept ;
    skos:definition "A reaction or reaction mechanism step in which a proton is removed from one species (the acid) and accepted by another species (the base)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proton transfer reaction"@en .

aat:300444022 a skos:Concept ;
    skos:definition "A method for dating fired clay objects, which is based on accurate measurement of the hydroxyl content of fired clays, as well as accurate determination of the chemical kinetics of rehydroxylation or chemical recombination of fired-clay ceramics with environmental moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rehydroxylation dating"@en .

aat:300444023 a skos:Concept ;
    skos:definition "An odorless red or black solid that makes up the pigment cinnabar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercuric sulfide"@en .

aat:300444024 a skos:Concept ;
    skos:definition "A purified, partially depolymerized cellulose prepared by treating alpha-cellulose, obtained as a pulp from fibrous plant material, with mineral acids. In conservation, it has been used as a stabilizer or reinforcing agent for adhesives"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microcrystalline cellulose"@en .

aat:300444025 a skos:Concept ;
    skos:definition "Loads applied to a structure or object from a blast wave, which is described by the combination of overpressure and either impulse or duration that causes catastrophic damage to the building both externally and internally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blast loads"@en .

aat:300444026 a skos:Concept ;
    skos:definition "A range of gesso products that is formulated with a combination of compressible, chemically inert fine grained mineral powder, a pH buffer, oxidation inhibitors, UV stabilizers, and BEVA resins. In conservation, it has been used as a filler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BEVA (R) Gesso"@en .

aat:300444027 a skos:Concept ;
    skos:definition "A crystalline, sulfur-containing amino acid that is formed from two molecules of the amino acid cysteine. Cystine can be converted to cysteine by reduction. Cystine is particularly abundant in skeletal and connective tissues and in hair, horn, and wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cystine"@en .

aat:300444028 a skos:Concept ;
    skos:definition "An artificial pigment made by heating lead and tin oxide together and is a reddish hue of lead-tin yellow (type I), which frequently occurs in European painting before the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead-tin orange"@en .

aat:300444029 a skos:Concept ;
    skos:definition "An organic compound made synthetically or obtained from peppermint or mint oils with flavoring and local anasthetic properties. In conservation, it has been used as a temporary consolidant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menthol"@en .

aat:300444030 a skos:Concept ;
    skos:definition "A deciduous broom of western Europe that is widely cultivated for its bright yellow or partly red flowers and that has become naturalized in North America. It has been used as textile dyestuff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cytisus scoparius"@en .

aat:300444031 a skos:Concept ;
    skos:definition "A fine grain white limestone quarried in Val Gallina near Verona, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra Gallina"@en .

aat:300444032 a skos:Concept ;
    skos:definition "Okinawan musical instruments whose name literally translates to \"three strings,\" typically covered with snakeskin. It was the precursor to the mainland Japanese shamisen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanshins"@en .

aat:300444034 a skos:Concept ;
    skos:definition "A fine-grained, medium hardness, calcitic white marble, sometimes with a slight golden hue was quarried at Iscehisar, ancient Dokimeion/Docimium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Docimium marble"@en .

aat:300444035 a skos:Concept ;
    skos:definition "Utensils of Precolumbian South America, most particularly Tiahuanaco culture. These were used for the inhalation of snuff prepared from the leaves, resin, and seeds of plants, most often with psychoactive properties, used to cure ailments, alleviate pain and hunger, to provide alertness, or to induce trances during rituals and religious ceremonies. These appear in the form of small rectangular tablets with shallow depressions for containing and administering the powder. Most of these are made of wood, with few being of stone or bone. Some display figurative carvings or other motifs covering their surface. Evidence suggests that snuff trays were a significant part of Pre-Colombian Tiahuanaco society specifically, though they are found elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuff trays"@en .

aat:300444036 a skos:Concept ;
    skos:definition "Produced by Markal, Paintstik is a solid paint marker in the form of a large cylindrical crayon, and is intended mainly for industrial mark-making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paintstik (TM)"@en .

aat:300444037 a skos:Concept ;
    skos:definition "Genus of flowering plant native to scrub and heathland in Europe, western Asia and North Africa, and is one of several genera in the tribe Genisteae which are commonly called brooms. These shrubs produce brightly colored, pea-like flowers that are often fragrant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cytisus"@en .

aat:300444039 a skos:Concept ;
    skos:definition "Advertising signage or structural objects which have been installed with electrical or other power for the purpose of illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illuminated advertisements"@en .

aat:300444040 a skos:Concept ;
    skos:definition "To draw or drag a something, often a vehicle, by another conveyance under power by a connecting member or hitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towing"@en .

aat:300444041 a skos:Concept ;
    skos:definition "A type of Dutch flat-bottomed, half decked, sloop-rigged fishing vessel, mainly found in the southern part of the former Zuiderzee. It is a commonly fished with trawls and silage nets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botters"@en .

aat:300444042 a skos:Concept ;
    skos:definition "The action of restoring a debilitated ship, parts thereof, or the cargo carried by it to harbor, dry dock, drilling rig, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine salvage"@en .

aat:300444043 a skos:Concept ;
    skos:definition "The clandestine transport of goods to avoid payment of duties, or transport of goods that are illegal, particularly across national, state, or district borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smuggling"@en .

aat:300444044 a skos:Concept ;
    skos:definition "Collective term for news-producing media and news organizations as well as the people who define and establish the news like reporters, editors, commentators and photographers or photojournalists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press"@en .

aat:300444045 a skos:Concept ;
    skos:definition "Companies that equip and operate ships, for sea or inland navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipping companies"@en .

aat:300444047 a skos:Concept ;
    skos:definition "Drugs, products, or agents that are consumed for pleasure, and that stimulate bodily functions, consciousness, elevate mood, feeling, or cognizance. These may be found in certain foods or plants, and include caffeine, nicotine, and amphetamines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stimulants"@en .

aat:300444048 a skos:Concept ;
    skos:definition "The practice of seaborne looting via private armed vessels holding a government commission known as a letter of marque that authorizes the capture of merchant shipping belonging to an enemy nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "privateering"@en .

aat:300444049 a skos:Concept ;
    skos:definition "Small loops that are components of belts on clothing that secure the loose end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt loops"@en .

aat:300444050 a skos:Concept ;
    skos:definition "Components of some belts, especially those that formed a part of early medieval dress: a counter plate was placed opposite the buckle. These were found on belts that would have included a buckle, and sometimes a rectangular back plate placed in the middle of the belt at the back for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter plates"@en .

aat:300444052 a skos:Concept ;
    skos:definition "Components of some belts, particularly those that formed part of medieval dress: plates that are attached to the buckle, often with decorative elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckle plates"@en .

aat:300444053 a skos:Concept ;
    skos:definition "Components of buckles: pins, often in metal, secured to the frame of the buckle, that passes through the holes in the belt in order to keep the belt secured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prongs"@en .

aat:300444054 a skos:Concept ;
    skos:definition "Buckle components: square, D-shaped or rounded components attached at one end of a belt, through which the tail of the belt is inserted and attached to the prong, or secured in some other way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckle frames"@en .

aat:300444055 a skos:Concept ;
    skos:definition "Small cases or pieces of luggage specifically designed to store toiletry items and make-up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "makeup cases"@en .

aat:300444056 a skos:Concept ;
    skos:definition "The action, process, or result of constructing artificial waterways to conduct water for drainage or irrigation, or for the navigation of boats or ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canalization"@en .

aat:300444057 a skos:Concept ;
    skos:definition "Lightweight garments intended for women as outerwear, prevalent in 19th century Europe. Originally the name for Regency era spencer jackets made of silk or kerseymere, specifically designed to be worn with an evening gown. These later evolved into shawl- or blouse-like garments with or without sleeves, often with lacework incorporated into the design. Many of these were made from muslin or cambric, but the style of varied in material and form. For cropped jackets from the Regency era worn by both men and women, use \"spencer jackets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canezous"@en .

aat:300444058 a skos:Concept ;
    skos:definition "Sleeveless knitted pullovers or buttoned garments worn over a shirt in the manner of a waistcoat or vest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweater vests"@en .

aat:300444059 a skos:Concept ;
    skos:definition "Describes ancient or Bronze Age forms of one-edged dagger, having long, heavy blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife-daggers"@en .

aat:300444060 a skos:Concept ;
    skos:definition "Type of traditional shawl or wrap worn by women, particularly in 19th century Netherlands, often held in place with silver clasps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faaljes"@en .

aat:300444061 a skos:Concept ;
    skos:definition "Double cruets, made to contain oil and vinegar, typically of glass with dual long-necked spouts facing opposite directions, and often designed as a single two-chambered vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guédoufles"@en .

aat:300444062 a skos:Concept ;
    skos:definition "Small bags that are incorporated in or designed to be attached to a belt and worn at the hip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt bags"@en .

aat:300444063 a skos:Concept ;
    skos:definition "Tabernacles in which consecrated bread for communion is kept in Eastern Orthodox and Catholic churches. This term is extended to portable versions for occasions outside lithurgical services, such as visiting the sick. These are frequently designed in the form of a church, but may appear in other guises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artophoria"@en .

aat:300444064 a skos:Concept ;
    skos:definition "Large unstructured shoulder bags with a crescent shape and a long strap worn over the shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hobo bags"@en .

aat:300444066 a skos:Concept ;
    skos:definition "A type of push dagger from the Indian subcontinent, characterised by an H-shaped hand grip that is perpendicular in relation to the blade. Ceremonial katars were also used in worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "katars"@en .

aat:300444067 a skos:Concept ;
    skos:definition "Short swords or daggers from the Caucasus, often with highly decorated handles, blades, and scabbards. The handle may be made of materials such as wood, ivory, or niello. In the Caucasus, daggers such as these were common multi-purpose personal items of Caucasian men that were used as weapons, cork screws, paper cutters, and dance accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kindjals"@en .

aat:300444068 a skos:Concept ;
    skos:definition "Metal fittings to protect the point of a leather sheath, in the form of a metal casing, often with a knob or a chape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scabbard drags"@en .

aat:300444069 a skos:Concept ;
    skos:definition "Large, wide-mouthed, unstructured bags intended for carrying swimwear and beach gear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach bags"@en .

aat:300444070 a skos:Concept ;
    skos:definition "The projecting shank, prong, fang, or tongue of a metal tool, weapon, or instrument, as a chisel, file, knife, or sword, by which it is secured to its handle, hilt, or grip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tangs"@en .

aat:300444071 a skos:Concept ;
    skos:definition "A type of dagger or sword popular throughout the Ottoman Empire distinguished by a single-edged blade that curves slightly inward and by a hilt with no guard and two flared wings at the pommel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yatagans"@en .

aat:300444072 a skos:Concept ;
    skos:definition "Short backswords, bayonets or choppers with a saw-back. Used by practically all armies during the 19th century, more often as a tool than as a weapon. Some fighting and survival knives are made as saw-backed knives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saw-backed knives"@en .

aat:300444073 a skos:Concept ;
    skos:definition "Earthenware pots common to Southeast Asia, particularly Cambodia, Thailand, and Vietnam. These are often decorative or formed in the shape of an animal and would be part of an ensemble of accessories related to the ritual of betel chewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime pots"@en .

aat:300444075 a skos:Concept ;
    skos:definition "Handbags that resemble a bucket in shape, often with a drawstring around the mouth to secure the contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucket bags"@en .

aat:300444076 a skos:Concept ;
    skos:definition "Funnel-shaped drinking vessels, of varied manufacture, often of ceramic material as well as glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornets"@en .

aat:300444077 a skos:Concept ;
    skos:definition "A type of long-handled battle axe of the Ottoman Empire, Persia, Armenia, India and surrounding regions and cultures having one or two broad crescent-shaped blades and thin handles measuring from three to seven feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabars"@en .

aat:300444078 a skos:Concept ;
    skos:definition "Ceramic vessels that have multiple spouts emerging from the body volume. Designs vary from pyramidal multi-piece stacking structures to smaller single-piece forms. These first appeared in the Netherlands in the 17th century and were decorated in the style of Delftware with its typical blue-on-white surface mimicing Chinese decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tulip vases"@en .

aat:300444079 a skos:Concept ;
    skos:definition "Rectangular ornaments or framing devices that contain an inscription or image, with triangular or semicircular winglike handles on two sides. These appear in a variety of contexts including mosaics, architecture, pottery, amulets, and sculpture, especially dedicatory or funerary inscriptions. They are based on objects of the same shape that were a popular form of Roman votive tablet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabulae ansatae"@en .

aat:300444080 a skos:Concept ;
    skos:definition "Small boxes, which may be made of varied materials, used to carry one or more seals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seal boxes"@en .

aat:300444081 a skos:Concept ;
    skos:definition "Multi-purpose medical instruments of Roman antiquity consisting of a long shaft with an olivary probe terminating one end and a spoon on the other. The spoon and the shaft are sometimes decorated. These were used for a variety of medical and cosmetic activities such as applying and measuring medicaments or the removal of medication from flasks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyathiscomeles"@en .

aat:300444082 a skos:Concept ;
    skos:definition "A traditional European heating system by which a stove is covered completely with glazed ceramic tiles. Tile stoves usually burn wood, and the radiant heat that occurs is absorbed by the tiles and is slowly and evenly diffused through the spaces in which they are installed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile stoves"@en .

aat:300444083 a skos:Concept ;
    skos:definition "Dutch cargo boats with full boughs, flat bottoms and shallow drafts, originally intended for the transport of goods on inland waterways and sometimes coastal shipping under sail, but now frequently fitted with engines and used as pleasurecraft or houseboats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tjalks"@en .

aat:300444084 a skos:Concept ;
    skos:definition "Footed bowls or shallow dishes of varied design used in Greek Orthodox or other Catholic churches to distribute bread that is blessed but not consecrated to those who cannot receive holy communion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antidoron bowls"@en .

aat:300444085 a skos:Concept ;
    skos:definition "Devotional art in the form of prints on parchment, paper or linen sold at sacred sites; often recognizable as such by a text or inscription referring to the place of pilgrimage. These are known in both European and Asian cultures. Woodblock prints of this type became popular in nineteenth century Japan as travel became more accessible, and prints from multiple temples were collected and adhered together on scrolls or screens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrimage prints"@en .

aat:300444086 a skos:Concept ;
    skos:definition "Sets of Catholic liturgical objects designed to fit in a case for traveling, including bottles for anointing oil and holy water, a chalice, crucifix, a stole, etc. These are used to perform mass outside the church or to perform rites for the seriously ill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass kits"@en .

aat:300444088 a skos:Concept ;
    skos:definition "Two-armed candlestick, with which the Orthodox community is blessed by the bishop during a pontifical liturgy. The two arms refer to the dual status of Christ, both human and divine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dikiria"@en .

aat:300444091 a skos:Concept ;
    skos:definition "Small spoons used to measure the water that dilutes the wine in the chalice during a Catholic mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalice spoons"@en .

aat:300444092 a skos:Concept ;
    skos:definition "Racks for the towels on which a priest dries his hands after washing them before celebrating Mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manuterge racks"@en .

aat:300444094 a skos:Concept ;
    skos:definition "Vessels containing the hot water, also called zeon, that is poured into the chalice of communion wine during some celebrations of Christian mass, particularly the Rite of Constantinople."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zeons"@en .

aat:300444095 a skos:Concept ;
    skos:definition "Trays, usually made of precious metal, on which the jugs or pitchers of zeon (hot water) is are held during some Eastern Christian services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zeon trays"@en .

aat:300444096 a skos:Concept ;
    skos:definition "Portable cases in which a priest carries articles such as anointing oils, etc. to administer the sacrament of the sick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sick call sets"@en .

aat:300444097 a skos:Concept ;
    skos:definition "Components of some belts, especially those that formed a part of early medieval dress: rectangular plates placed behind the buckle. These were found on belts that would have included a buckle, a counter plate that was placed opposite the buckle, and sometimes a rectangular back plate placed in the middle of the belt at the back for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back plates"@en .

aat:300444098 a skos:Concept ;
    skos:definition "Pieces of armor that cover or protect the neck of the human or animal wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck pieces"@en .

aat:300444099 a skos:Concept ;
    skos:definition "Light, versatile spears with iron heads and long shafts used by ancient Germanic peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frameas"@en .

aat:300444109 a skos:Concept ;
    skos:definition "Describes the culture and style of the Melkoi people, inhabitants of New Britain Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melkoi"@en .

aat:300444110 a skos:Concept ;
    skos:definition "Thin, often tapered pieces of material such as wood, metal, or stone that are used to fill space between things for support, leveling, or adjustment of fit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shims"@en .

aat:300444111 a skos:Concept ;
    skos:definition "A mineral Cu11Bi(AsO4)5(OH)10.6H2O consisting of green to whitish hydrous basic copper bismuth arsenate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixite"@en .

aat:300444112 a skos:Concept ;
    skos:definition "A crystalline salt SrCO3 occurring naturally as strontianite and used chiefly in fireworks, in iridescent glass, and in making other strontium compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strontium carbonate"@en .

aat:300444113 a skos:Concept ;
    skos:definition "A bleaching activator used in bleaching of paper, textiles and for the generation of Peracetic acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetraacetylethylenediamine"@en .

aat:300444114 a skos:Concept ;
    skos:definition "The process of projecting a tilted or oblique aerial photograph onto a plane that represents the horizontal-reference or map plane. The resulting photograph is equivalent to one that would have been obtained from the same exposure station with an untilted camera. Multiple-stage rectification may be employed to eliminate differential paper distortion photographically. It is commonly used in recent restoration projects, for heritage documentation and three-dimensional visualization of the object. The technique is a much faster method for obtaining the 3D model compared to single-image or stereoscopic photogrammetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogrammetric restitution"@en .

aat:300444115 a skos:Concept ;
    skos:definition "A zinc-hydroxy compound with chemical formula Zn5(OH)8Cl2 H2O. It is used to coat substrates normally infested by algae, such as concrete roofing tiles and other silicate-containing building materials, to prevent or minimize algal infestation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc hydroxychloride"@en .

aat:300444116 a skos:Concept ;
    skos:definition "Microscopes that have a digital camera attached instead of an eyepiece and display the digitally acquired image on a large monitor. In addition to observation, these can also have various extended functions such as dimension measurement, and recording of still images and moving images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital microscopes"@en .

aat:300444117 a skos:Concept ;
    skos:definition "The principle treatment document for cultural landscapes and the primary tool for their long-term management. Management and treatment decisions are based on the character of the land, its historical significance, and the anticipated challenges to preservation. Typically interdisciplinary in nature, the CLR can be used for maintenance, interpretation, and planning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural landscape reports"@en .

aat:300444118 a skos:Concept ;
    skos:definition "Element for describing the organization or filing sequence of the records, particularly in the context of archives. May be used to record the logical or physical groupings within a hierarchical structure and their relationships. This includes how the described materials have been subdivided into smaller units, e.g., record groups into series. May also indicate the filing sequence of the described materials, for example chronological or alphabetical arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrangement description"@en .

aat:300444119 a skos:Concept ;
    skos:definition "Element for identifying materials that have an association to the materials being described. May be used to identify associated materials in the same repository or elsewhere. These materials may be related by sphere of activity, subject matter, or other characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "related material"@en .

aat:300444120 a skos:Concept ;
    skos:definition "Identification of works of art or architecture related to the work being described; may include a description of the relationship between the works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "related works"@en .

aat:300444121 a skos:Concept ;
    skos:definition "Identification of iimages that depict the work of art or architecture being described."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "related visual documentation"@en .

aat:300444122 a skos:Concept ;
    skos:definition "Identification of citations to sources of textual information related to the work of art or architecture being described, including published bibliographic materials, Web sites, archival documents, unpublished manuscripts, and references to verbal opinions expressed by scholars or subject experts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "related textual references"@en .

aat:300444123 a skos:Concept ;
    skos:definition "Digital microscopes that combine three-dimensional image capture, image stitching, and modelling data. These scan an object through multiple focal planes and compiles this data into a three-dimensional image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "3D digital microscopes"@en .

aat:300444124 a skos:Concept ;
    skos:definition "A performance-based seismic analysis technique used to evaluate existing structures and estimate the inelastic response of a structure in an earthquake. The method compares the capacity of the structure (in the form of a pushover curve) with the demand on the structure (in the form of a response spectrum). The graphical intersection of the two curves approximates the response of the structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capacity spectrum method"@en .

aat:300444125 a skos:Concept ;
    skos:definition "A type of Roman Catholic chapel constructed in 16th century colonial Mexico, consisting of a chancel that opens to the atrium at ground level or raised to allow better visibility. Existing examples include the open chapels in Teposcolula and Calimaya. Recintos abiertos dedicados al culto, creadas en el siglo XVI, por frailes españoles en América, para dar solución al gran número de asistentes a las misas y a su vez mantener la modalidad de uso del espacio exterior sacro, habitual entre los indígenas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open chapels"@en .

aat:300444126 a skos:Concept ;
    skos:definition "Globes that illustrate geographical features through the use of modeling on their surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raised relief globes"@en .

aat:300444127 a skos:Concept ;
    skos:definition "A type of coated one-side paper in which the coating is an adhesive or glue, which can either be permanently sticky, or only become sticky with the application of moisture, heat, or other condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesive-coated paper"@en .

aat:300444128 a skos:Concept ;
    skos:definition "An antifungal agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clotrimazole"@en .

aat:300444129 a skos:Concept ;
    skos:definition "Devices consisting of a biological component (such as an enzyme or bacterium) that reacts with a target substance and an electrochemical or optical component that detects the resulting products or by-products and emits a signal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biosensors"@en .

aat:300444130 a skos:Concept ;
    skos:definition "The action of adjusting or adapting to a new temperature, climate, environment, or situation. In conservation, usually used in the context of object testing or treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acclimation"@en .

aat:300444131 a skos:Concept ;
    skos:definition "Formulations used to clean and protect furniture, especially wood. These may be made from a variety of materials, usually solvents and oils combined with wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture polish"@en .

aat:300444132 a skos:Concept ;
    skos:definition "Females of Greek antiquity who were reputed to possess powers of prophecy and divination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sibyls"@en .

aat:300444133 a skos:Concept ;
    skos:definition "In the Roman religion, numerous tutelary deities of cultivated fields and of households."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lares"@en .

aat:300444134 a skos:Concept ;
    skos:definition "The technique or process of using microscopes that have a digital camera attached instead of an eyepiece and display the digitally acquired image on a large monitor. This technique may include functions such as dimension measurement, and recording of still images and moving images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital microscopy"@en .

aat:300444135 a skos:Concept ;
    skos:definition "Transfer of tangible and intellectual property, expertise, learning and skills between groups. This has been used to describe the adoption of local or traditional techniques and materials by the modern conservation field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knowledge transfer"@en .

aat:300444136 a skos:Concept ;
    skos:definition "In Roman society, commoners, as opposed to privileged patricians; plebeans could be prominent citizens and wealthy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plebeans"@en .

aat:300444137 a skos:Concept ;
    skos:definition "Complexes of built works surrounding a temple or temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temple complexes"@en .

aat:300444138 a skos:Concept ;
    skos:definition "Buildings and complexes that house international expositions which feature exhibits on arts, agriculture, science, and industry, with participants from around the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "world's fairs"@en .

aat:300444139 a skos:Concept ;
    skos:definition "Any liquid polymerized siloxane with organic side chains. It has good weatherability (including resistant toward extreme temperatures), and is waterproof and environment friendly. Silicone oils are primarily used as lubricants, heat transfer oil or hydraulic fluids. In conservation, it has been used as a consolidant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicone oil"@en .

aat:300444140 a skos:Concept ;
    skos:definition "A nondestructive image-forming method of X-ray testing that yields images of object slices by a simple linear translation of the object relative to the tube-detector system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computed x-ray laminography"@en .

aat:300444141 a skos:Concept ;
    skos:definition "A biological treatment for copper alloys involving the conversion of existing corrosion patinas into more stable copper oxalates using the unique properties of carefully selected fungal strains. The cooper oxalate forms a protective layer that passivates the surface to prevent any exchange of copper ions and water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biopatina"@en .

aat:300444142 a skos:Concept ;
    skos:definition "The action or process of treating something as a commodity, rather than considering that thing's other intrinsic qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodification"@en .

aat:300444143 a skos:Concept ;
    skos:definition "A yellow dye made from the flowering stems of the yellow larkspur plant (Delphinium semibarbatum). Yellow larkspur was one of the main sources of yellow dye in central Asia before the adoption of synthetic dyes in these regions and was used in the silk and silk-and-cotton ikats of the Uzbeks, Tajiks, Turkmens and Jews."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larkspur"@en .

aat:300444144 a skos:Concept ;
    skos:definition "Buildings in which a military or public service is based in a given area, such as a fire station or a coastguard station. The building may include office spaces, congregating spaces, and sleeping quarters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "station houses"@en .

aat:300444145 a skos:Concept ;
    skos:definition "Structures that house and protect equipment needed operate substations or other facilities for electricity, water, or other utilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "control houses"@en .

aat:300444146 a skos:Concept ;
    skos:definition "Large structures covered by a roof and comprising a main interior space, without or with subordinate chambers attached. Examples include temples, palaces, courts, and aristocratic residences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halls"@en .

aat:300444147 a skos:Concept ;
    skos:definition "Buildings or open air structures housing facilities for patients or clients undergoing medical treatment by bathing and similar remedial agencies, usually with a large communal bathing area, or a series of cubicles or apartments arranged for bathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baths"@en .

aat:300444148 a skos:Concept ;
    skos:definition "Groupings of structures that may or may not be intended to function together. Examples could be sets of row houses built in coordinating or similar styles in the same area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural groups"@en .

aat:300444149 a skos:Concept ;
    skos:definition "Unique assets, comprised of a collection of metadata defining a digital object verified within a blockchain that certifies that these are unique and not interchangeable, and which provides a means of sale, authentication, and provenance. NFTs may be bought and sold, but have no tangible form of their own, and point to digital content such as photos, video, audio, games, or any other media that is storable digitally. Even though the content may be available freely in infinite duplicate, an NFT guarantees ownership of the work, but not necessarily copyright of the content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "non-fungible tokens"@en .

aat:300444150 a skos:Concept ;
    skos:definition "General term referring to doers of actions who are distinguished by being, in a given setting or data model, associated with other doers of actions, works, activities, places, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "associated agents"@en .

aat:300444151 a skos:Concept ;
    skos:definition "Buildings used for display or sale of art works or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleries"@en .

aat:300444152 a skos:Concept ;
    skos:definition "Enterprises, whether businesses or institutions, that focus on the display or sale of art works or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleries"@en .

aat:300444153 a skos:Concept ;
    skos:definition "Sites having a small population, including outlying districts of America and former Colonial territories, such as a small village or collection of houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settlements"@en .

aat:300444154 a skos:Concept ;
    skos:definition "The period and style of Herod the Great (ca 74-4 BCE), king of Judaea, or of his successors of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Herodian"@en .

aat:300444155 a skos:Concept ;
    skos:definition "Cultural expression that includes music and dance that originated in Recife, Pernambuco, Brazil. Usually, the dance movements are fast and acrobatic and the frevo dancers use colorful umbrellas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frevo"@en .

aat:300444157 a skos:Concept ;
    skos:definition "Popular literature from Northeastern Brazil. Usually, woodcuts illustrate cordel booklets, which are hung on a piece of string by vendors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cordel literature"@en .

aat:300444159 a skos:Concept ;
    skos:definition "Indigenous group originated from tupi-guarani tradition. These groups live in Brazil and neighboring regions such as French Guiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wajãpi"@en .

aat:300444161 a skos:Concept ;
    skos:definition "Constructed languages used to index, organize, or retrieve information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexing languages"@en .

aat:300444166 a skos:Concept ;
    skos:definition "Indianism is a current that started in Brazilian romantic literature (c.1836 - c.1881) and later in painting, in which Indian figures were idealized and represented as symbols of a nationality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indianism"@en .

aat:300444168 a skos:Concept ;
    skos:definition "Masonry applied as a continuous surface without seams or breaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous masonry"@en .

aat:300444169 a skos:Concept ;
    skos:definition "Technique of masonry construction where the stones or other masonry units are stacked without using mortar to hold them together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry stack"@en .

aat:300444172 a skos:Concept ;
    skos:definition "Sales statements associated with a provenance event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provenance sales statements"@en .

aat:300444173 a skos:Concept ;
    skos:definition "Any remarks associated specifically with a provenance event, as they appear in a collection record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provenance remarks"@en .

aat:300444174 a skos:Concept ;
    skos:definition "Statements associated with provenance events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provenance statements"@en .

aat:300444175 a skos:Concept ;
    skos:definition "Statement of the location associated with a provenance event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provenance location statement"@en .

aat:300444185 a skos:Concept ;
    skos:definition "Refers to the numbers Frits Lugt created in his widely used reference works on provenance research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lugt numbers"@en .

aat:300444188 a skos:Concept ;
    skos:definition "Hereditary succession to property, quality, or immaterial possession. When the inheritance is transferred by a legal document such as a will, regardless of familial relationship, use 'bequest.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inheritance"@en .

aat:300444190 a skos:Concept ;
    skos:definition "To get back or regain possession or restoration of something by judgment or law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recovered"@en .

aat:300444191 a skos:Concept ;
    skos:definition "Describes the location change of an object in a collection, usually that of a museum, from a safe place, or housing that is designed to take into account the unique needs of the object with a long range outlook for its health, to another, whether for temporary storage during a renovation or other practical reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rehoused"@en .

aat:300444192 a skos:Concept ;
    skos:definition "The conditon of being removed from view, separated, secreted, or set apart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sequestered"@en .

aat:300444193 a skos:Concept ;
    skos:definition "A type of dolomitic limestone found in southern Minnesota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kasota stone"@en .

aat:300444194 a skos:Concept ;
    skos:definition "Construction method where a structure or superstructure is built directly on the earth or slab, with no underground foundation to provide stability and support. Structures built upon piers or pilings may also be withouit foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "without foundation"@en .

aat:300444195 a skos:Concept ;
    skos:definition "Cement that has been poured into a form or structure rather than being the material from which construction blocks have been made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poured cement"@en .

aat:300444196 a skos:Concept ;
    skos:definition "Concrete that has been poured into a form or structure rather than being the material from which construction blocks have been made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poured concrete"@en .

aat:300444197 a skos:Concept ;
    skos:definition "Stone having a rough finish, unlike milled stone that has a smooth finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough cut stone"@en .

aat:300444198 a skos:Concept ;
    skos:definition "Building stone that has a smooth finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milled stone"@en .

aat:300444199 a skos:Concept ;
    skos:definition "Technique of constructing masonry walling made of stones laid up in regular horizontal rows or courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coursed stone"@en .

aat:300444200 a skos:Concept ;
    skos:definition "Technique of constructing masonry walling made of stones laid up in a random pattern, without regular horizontal rows or courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncoursed stone"@en .

aat:300444202 a skos:Concept ;
    skos:definition "Clay formed into blocks and typically used for building, distinguished by containing iron oxide and having a brownish red color in raw form or when fired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red brick"@en .

aat:300444203 a skos:Concept ;
    skos:definition "Clay in its original lump form, dug straight from the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "native clay"@en .

aat:300444204 a skos:Concept ;
    skos:definition "Clay formed into blocks and distinguished by having a white color when fired, usually made of Gault clay. Noted as a particularly hard, durable variety of brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white brick"@en .

aat:300444205 a skos:Concept ;
    skos:definition "Clay from the Gault Formation, deposited in a calm, deep water marine environment during the Lower Cretaceous Period. When raw, a stiff blue clay, when fired, white in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gault"@en .

aat:300444206 a skos:Concept ;
    skos:definition "Clay formed into blocks and distinguished by having a yellowish color when fired, due to the clay having a relatively high lime content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow brick"@en .

aat:300444207 a skos:Concept ;
    skos:definition "Mortar joints over which a metal jointer blade with a beaded extrusion has been run, causing a flush joint having a depressed line or channel running through the center of the joint. This style of joint is often seen in historical buildings, such as in American Colonial works. The lines in the mortar are generally wavy rather than perfectly straight, creating a slightly irregular effect resembling a grapevine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grapevine joints"@en .

aat:300444208 a skos:Concept ;
    skos:definition "Mortar joints that are angled in cross-section, recessed increasingly from the bottom to the top of the joint. The effect is a straight, inclined surface that catches the light and gives the brickwork a neat, ordered appearance"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weather joints"@en .

aat:300444210 a skos:Concept ;
    skos:definition "Limestone that is white, with a slight grayish tint, from deposits near Carthage, Missouri."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carthage limestone"@en .

aat:300444212 a skos:Concept ;
    skos:definition "A fine-grained, even-textured sandstone that is reddish-brown in color, quarried near East Longmeadow, Massachusetts. Used extensively for buildings in New England, United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Longmeadow sandstone"@en .

aat:300444214 a skos:Concept ;
    skos:definition "Granite quarried near Monson, Massachusetts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monson granite"@en .

aat:300444215 a skos:Concept ;
    skos:definition "Materials or construction comprising a lattice structure, used to fill voids, for example in architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lattice infill"@en .

aat:300444216 a skos:Concept ;
    skos:definition "Basements that occur under only part of the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partial basements"@en .

aat:300444217 a skos:Concept ;
    skos:definition "Roof shingle material made of concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete shingle"@en .

aat:300444218 a skos:Concept ;
    skos:definition "Roofing shingle material made of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood shingle"@en .

aat:300444219 a skos:Concept ;
    skos:definition "Siding made from aluminum coil stock, chemically coated and painted to resemble clapboard siding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum siding"@en .

aat:300444220 a skos:Concept ;
    skos:definition "Building blocks comprising extruded clay shapes having substantial depth that may be laid as other masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay blocks"@en .

aat:300444221 a skos:Concept ;
    skos:definition "A pyroclastic volcanic rock, either welded on deposition or subsequently lithified"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ignimbrite"@en .

aat:300444222 a skos:Concept ;
    skos:definition "Interior building process used to create dividing walls and ceilings; comprises of narrow strips of wood (laths) which are nailed horizontally across the wall studs or ceiling joists and then coated in plaster. It is derived from \"wattle and daub\" process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lath and stucco"@en .

aat:300444223 a skos:Concept ;
    skos:definition "Structural sheet of steel, shaped in alternating ridges and grooves; used as roofing, siding, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrugated steel"@en .

aat:300444224 a skos:Concept ;
    skos:definition "Masonry construction using several wythes (layers) of brick, and having header bricks to bind them them together. Distinct from more modern methods that use \"brick veneer.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid masonry"@en .

aat:300444225 a skos:Concept ;
    skos:definition "Masonry construction using a single non-structural external layer of masonry, typically brick or stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry veneer"@en .

aat:300444226 a skos:Concept ;
    skos:definition "Masonry construction using a single non-structural external layer of brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick veneer"@en .

aat:300444227 a skos:Concept ;
    skos:definition "Masonry construction using a single non-structural external layer of masonry, and having an air space behind the veneer. Distinct from veneer attached directly to the surface, \"adhered veneer.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchored veneer"@en .

aat:300444228 a skos:Concept ;
    skos:definition "Masonry construction using a single non-structural external layer of masonry attached directly to the surface behind. Distinct from veneer having an air space behind, \"anchored veneer.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhered veneer"@en .

aat:300444229 a skos:Concept ;
    skos:definition "Technique for face brick in which bricks are laid in a decorative pattern with a combination of horizontal, vertical, and diagonal elements. An example would be a basket-weave pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry brick"@en .

aat:300444230 a skos:Concept ;
    skos:definition "Fiber-reinforced plastic using glass fiber, produced so as to have the characteristic of allowing light to pass, rather than being opaque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "translucent fiberglass"@en .

aat:300444231 a skos:Concept ;
    skos:definition "Fiber-reinforced plastic using glass fiber, produced so as to have the characteristic of being opaque to the passage of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opaque fiberglass"@en .

aat:300444233 a skos:Concept ;
    skos:definition "Technique using thick joints of lime-rich mortar that serves as a flexible gasket when laying irregular bricks to the line, level, and overall gauge required for a wall or facade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tudor brick"@en .

aat:300444235 a skos:Concept ;
    skos:definition "Walls having a modified board and batten arrangement of horizontal and vertical surface boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shaker siding"@en .

aat:300444236 a skos:Concept ;
    skos:definition "Limestone quarried in the US state of Wisconsin, known for a wide color range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wisconsin limestone"@en .

aat:300444237 a skos:Concept ;
    skos:definition "Tiles made of asbestos fibers bonded with other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asbestos tile"@en .

aat:300444238 a skos:Concept ;
    skos:definition "Construction membrane used for roofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carlisle Membrane (TM)"@en .

aat:300444239 a skos:Concept ;
    skos:definition "Roofing shingles made of cedar wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cedar shingle"@en .

aat:300444240 a skos:Concept ;
    skos:definition "Semi-cylindrical roofing tiles, usually clay, that are laid in interlocking columns alternating with one column having the convex side facing up and the next column having the concave side facing up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel tile"@en .

aat:300444243 a skos:Concept ;
    skos:definition "Ceramic tiles made of terracotta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay tile"@en .

aat:300444244 a skos:Concept ;
    skos:definition "Composite material in which the separate materials are arranged in layers. An example is foam board, where smooth outer skins are adhered to an interior layer of fine-cell foam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich material"@en .

aat:300444245 a skos:Concept ;
    skos:definition "Materials that make up a roof where multiple materials are used instead of a single material, such as metal or wood. An example of a composition roof may include fiberglass, wood, and slate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition roofing"@en .

aat:300444246 a skos:Concept ;
    skos:definition "Shingles that are made from multiple materials, such as wood, laminate, paper products, and fiberglass, rather than a single material such as metal, slate, or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition shingle"@en .

aat:300444247 a skos:Concept ;
    skos:definition "Trademarked roofing systems of the Duro-Last company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Duro-Last (R)"@en .

aat:300444248 a skos:Concept ;
    skos:definition "Synthetic rubber made from ethylene, propylene, and a diene comonomer that enables crosslinking via sulfur vulcanization. Used in many applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethylene propylene diene monomer rubber"@en .

aat:300444249 a skos:Concept ;
    skos:definition "Tiles made of metal, generally copper, tin, aluminum, or stainless steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal tile"@en .

aat:300444250 a skos:Concept ;
    skos:definition "Lightweight building material composed of solid gypsum, used for building lightweight, fire-resistant, non-load bearing interior walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsum blocks"@en .

aat:300444251 a skos:Concept ;
    skos:definition "Lumber, often hardwoods, that differs from hand hewn beams in that, instead of using axes, rough sawn beams are made from circular saws or other mechanical tools to square the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough sawn lumber"@en .

aat:300444252 a skos:Concept ;
    skos:definition "Lumber, often softwoods, that differs from rough sawn beams in that, instead of using mechanical tolls, hand hewn beams are squared using axes and other hand tools, leaving distinctive axe marks on the beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand hewn lumber"@en .

aat:300444253 a skos:Concept ;
    skos:definition "Tile is classified as weighing over more than 5 pounds per square foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heavy tile"@en .

aat:300444254 a skos:Concept ;
    skos:definition "Tile is classified as measuring greater than 15 inches on any side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "large tile"@en .

aat:300444255 a skos:Concept ;
    skos:definition "Asphalt that is reddish in color, caused by red gravel, such as pink granite, used in the asphalt production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red asphalt"@en .

aat:300444256 a skos:Concept ;
    skos:definition "Tile having rounded edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rounded tile"@en .

aat:300444257 a skos:Concept ;
    skos:definition "Roofing shingles made of redwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redwood shingle"@en .

aat:300444258 a skos:Concept ;
    skos:definition "Lumber that was originally used in one construction or for one purpose, and then used again in another context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reused lumber"@en .

aat:300444259 a skos:Concept ;
    skos:definition "Roofing material comprising rolled sheets of mineral surfaced oil-based asphalt; known as thinner, less durable, and less expensive than asphalt shingles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolled roofing"@en .

aat:300444260 a skos:Concept ;
    skos:definition "Shingles made of slate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slate shingle"@en .

aat:300444261 a skos:Concept ;
    skos:definition "Slate having a pale green color, quarried in Vermont."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vermont green slate"@en .

aat:300444262 a skos:Concept ;
    skos:definition "Asphalt-based roofing having the benefits of old-style built-up roofing, but the convenience of single-ply roofing systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modified roofing"@en .

aat:300444263 a skos:Concept ;
    skos:definition "Siding made from wood boards placed directly one next to the other, in either a horizontal or vertical direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush board siding"@en .

aat:300444264 a skos:Concept ;
    skos:definition "Roofing systems using large quantities of gravel to hold in place a protective membrane, such as a rubber sheet; used for flat roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballasted roofing"@en .

aat:300444265 a skos:Concept ;
    skos:definition "Roofing that uses a concrete deck, often with adhered insulation panels or cast-in-place lightweight insulating concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete deck roofing"@en .

aat:300444266 a skos:Concept ;
    skos:definition "Tiles made of concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete tile"@en .

aat:300444267 a skos:Concept ;
    skos:definition "Tiles made of copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper tile"@en .

aat:300444268 a skos:Concept ;
    skos:definition "Shingles made of fiberglass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiberglass shingle"@en .

aat:300444269 a skos:Concept ;
    skos:definition "Artificial compilations of sheet music that has been collected by an individual and bound into a single volume. The most common examples of these date to the early-mid-19th century, created when the owner, often a woman, had a personal collection bound for posterity. Many scholars consider the peak of this activity to be 1830-1880, though volumes of manuscripts or printed material are known since at least the 16th century. Binder’s volumes were most common in the 19th century because of advances in printing technology and the rise of a middle class. Around 1880, publishers began offering printed collections of music that could serve the same purpose as an individual’s binder’s volume, initiating the obsolescence of this object genre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binder's volumes"@en .

aat:300444270 a skos:Concept ;
    skos:definition "Roofing comprising bitumens and felts, combined to form an impervious membrane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bituminous roofing"@en .

aat:300444271 a skos:Concept ;
    skos:definition "Roofing system using coal tar, considered an optimalbuilt-up roof membrane assembly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal tar roofing"@en .

aat:300444272 a skos:Concept ;
    skos:definition "Roof construction using membrane, and where the insulation layer lies above the weatherproofing, in contrast to traditional built-up roofing systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inverted roof membrane assembly"@en .

aat:300444273 a skos:Concept ;
    skos:definition "Roof construction where the waterproofing layer lies beneath the insulation instead of above it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inverted roof"@en .

aat:300444274 a skos:Concept ;
    skos:definition "Roofing systems that use metal sheets or tiles, used for longevity, corrosion resistance, water impermeability, and fire resistance. Metal roofs are noted for durability, and can last 50 years or more."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal roofing"@en .

aat:300444275 a skos:Concept ;
    skos:definition "Roofing system comprising a watertight membrane of EPDM (ethylene propylene diene terpolymer)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubber roofing"@en .

aat:300444276 a skos:Concept ;
    skos:definition "Roofing system that uses a waterproof membrane of synthetic rubber, thermoplastic such as PVC or similar material, or modified bitumen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membrane roofing"@en .

aat:300444277 a skos:Concept ;
    skos:definition "Construction method using as building materials blocks of soil held together by grass and the grass' roots. Blocks of sod were placed grass-side down to create thick walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sod construction"@en .

aat:300444278 a skos:Concept ;
    skos:definition "Roofing tiles that are flat, plate-like in shape, rather than barrel-shaped; usually made of concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat tile"@en .

aat:300444279 a skos:Concept ;
    skos:definition "Roofing comprising formed metal sheets with vertical ribs at the panel edges, installed by lapping and interlocking edges of adjacent panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing seam roofing"@en .

aat:300444280 a skos:Concept ;
    skos:definition "Roofing comprising formed sheets of corrugated metal, distinguished by alternating curved and wavy ribs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrugated metal roofing"@en .

aat:300444281 a skos:Concept ;
    skos:definition "Roofing construction"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss roofing"@en .

aat:300444283 a skos:Concept ;
    skos:definition "Thin boards, usually wooden, that span the trusses and support the rest of the roof. Typically oriented face-grain (strength axis) perpendicular to the roof framing, providing maximum stiffness and load capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roof sheathing"@en .

aat:300444284 a skos:Concept ;
    skos:definition "Sheathing that runs in both horizontal and vertical directions, to provide maximum support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-way sheathing"@en .

aat:300444285 a skos:Concept ;
    skos:definition "Brand name roofing systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Derbigum (TM)"@en .

aat:300444286 a skos:Concept ;
    skos:definition "Shingles that have overall flat edges, so the finished appearance of the roof is distinctly uniform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat tab shingle"@en .

aat:300444287 a skos:Concept ;
    skos:definition "Coating made of Portland cement, lime, sand, and water, used on the exterior of buildings. For plaster, see \"stucco (plaster).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard coat stucco"@en .

aat:300444288 a skos:Concept ;
    skos:definition "Shingles laid to produce uneven, wavy courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wave coursed shingle"@en .

aat:300444289 a skos:Concept ;
    skos:definition "Shingles made of oak."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oak shingle"@en .

aat:300444290 a skos:Concept ;
    skos:definition "Revival style recalling Dutch Renaissance architecture, flourished particularly in North American in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch Renaissance Revival"@en .

aat:300444291 a skos:Concept ;
    skos:definition "Period of the dynasty that ruled the province of Diyarbakir in northern Iraq (now Turkey) 1098-1232, and again 1104-1408."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Artuqid"@en .

aat:300444292 a skos:Concept ;
    skos:definition "Period of the dynasty that ruled in the Aydın-Izmir region in western Anatolia ca. 1308-1425."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aydinid"@en .

aat:300444293 a skos:Concept ;
    skos:definition "Refers generally to the period and styles of a number of Turkish principalities in Anatolia from the last years of Saljuq family rule at the end of the 13th century to the final incorporation of Anatolia in the Ottoman family state in the late 15th century. While some Beyliks achieved only a brief independence, others were quite durable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beylik"@en .

aat:300444294 a skos:Concept ;
    skos:definition "Referes to traditional bungalow home style native to Portland, Oregon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portland style"@en .

aat:300444295 a skos:Concept ;
    skos:definition "Art that has as its subject peasant life, usually in the media of painting, prints, or sculpture. For art that is created by local artists in local traditions, regardless of subject matter, use \"folk art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peasant art"@en .

aat:300444296 a skos:Concept ;
    skos:definition "Art produced by artisans trained and working within a local client economy according to local tastes, as opposed to \"academic art.\" It differs also from \"folk art,\" in that vernacular art is defined in terms of its creators (rather than the response of its viewers), and is not so much bound to the biographical details of an individual craftsman."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernacular art"@en .

aat:300444297 a skos:Concept ;
    skos:definition "Built works, particularly in a modern urban environment, that have emerged from anonymous creators, inspired by the desire to build things or to modify and personalize space. Spontaneous architecture is communal and social, often exploring non-traditional construction materials and with immediate technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spontaneous architecture"@en .

aat:300444298 a skos:Concept ;
    skos:definition "Built works produced by the original inhabitants of an area, as contrasted to works produced by descendents of colonists to the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigenous architecture"@en .

aat:300444299 a skos:Concept ;
    skos:definition "General term for humbler built works such as dwellings, places of worship, barns, and other everyday structures that are used by ordinary inhabitants of smaller settlements, designed and built without the assistance of formally schooled and professionally trained architects. Folk architecture is generally utilitarian and conservative, reflecting the specific needs, unique solutions, and customs of the local community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folk architecture"@en .

aat:300444300 a skos:Concept ;
    skos:definition "General term for built works, often local and of nonestablished style, where the architect is unknown and typically unknowable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anonymous architecture"@en .

aat:300444301 a skos:Concept ;
    skos:definition "Styles, periods, and cultures that cross boundaries of multiple nations and regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Global"@en .

aat:300444302 a skos:Concept ;
    skos:definition "Architectural styles inspired by Dutch architecture, primarily in North America, Europe, and areas of Dutch colonization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch Colonial Revival"@en .

aat:300444303 a skos:Concept ;
    skos:definition "Architectural and other art styles in the 19th century, inspired by the early portion of the Renaissance of the early to mid-15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Renaissance Revival"@en .

aat:300444304 a skos:Concept ;
    skos:definition "Phrygian culture and style dating to from ca. 950 to 8th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Phrygian"@en .

aat:300444305 a skos:Concept ;
    skos:definition "Architectural and other art styles in the 19th century, inspired by the the Renaissance in France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Renaissance Revival"@en .

aat:300444306 a skos:Concept ;
    skos:definition "Style of 19th-century architecture and other art that uses elements of Elizabethan and Gothic style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elizabethan Gothic Revival"@en .

aat:300444307 a skos:Concept ;
    skos:definition "Style of art in England during the Baroquer period, in England dating from the late 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English Baroque"@en .

aat:300444308 a skos:Concept ;
    skos:definition "Style of furniture and interior design in England in the 19th-century, inspired by homey designs of English countryside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Cottage Style"@en .

aat:300444309 a skos:Concept ;
    skos:definition "Style of interior architecture and design using elements of English country houses, including elegant furnishings combined with country-themed textiles and other details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Country House Style"@en .

aat:300444310 a skos:Concept ;
    skos:definition "American architectural style dating from about 1870 to 1970, that reuses elements of the earlier Federal style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Federal Revival"@en .

aat:300444311 a skos:Concept ;
    skos:definition "Style of architecture, interior design, or other works that evokes elements of plantation houses of the American south or of Hawaii or other island colonial settlements. Particulary appropriate when the work is not affiliated with a plantation, but only the style is appropriated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plantation house style"@en .

aat:300444312 a skos:Concept ;
    skos:definition "Architectural style that references the Spanish Renaissance, Spanish Colonial, Italian Renaissance, Venetian Gothic, French Colonial, Beaux-Arts, and Arabic Andalusian architecture. It focused heavily on the style of palaces and villas. It flourished in the United States from 1890s through 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mediterranean Revival"@en .

aat:300444313 a skos:Concept ;
    skos:definition "General term for the recent art made between the aftermath of World War II and the early years of the 21st century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Modernism"@en .

aat:300444315 a skos:Concept ;
    skos:definition "Style of masonry construction dating from 1930s forward in North America, distinguished by structures that are simple, largely unornamented, and constructed of readily available local masonry materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Masonry Vernacular"@en .

aat:300444316 a skos:Concept ;
    skos:definition "Style of architecture and the decorative arts employed by some artists in Spain and its colonies in the 19th century. It was based on the medieval work of Spanish mudajjan, denoting Muslims living under Christian rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mudéjar revival"@en .

aat:300444317 a skos:Concept ;
    skos:definition "Style of architecture and decorative arts that began in Britain in the 19th century, evolving into Victorian styles that incorporated Gothic elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medieval Revival"@en .

aat:300444318 a skos:Concept ;
    skos:definition "Period of the first of the Anatolian beyliks frontier principalities founded 1260/1290."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mentese"@en .

aat:300444319 a skos:Concept ;
    skos:definition "Architectural style of 19th-century North America that was inspired by earlier Quaker meeting houses of New England, characterized as boxy buildings with clapboard siding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New England Meeting House Style"@en .

aat:300444320 a skos:Concept ;
    skos:definition "Architectural style that developed in Istanbul in the 18th century, drawing upon European Baroque models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ottoman Baroque"@en .

aat:300444321 a skos:Concept ;
    skos:definition "General term for styles and periods from post-1945."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post-1945"@en .

aat:300444322 a skos:Concept ;
    skos:definition "Style of 19th-century architecture and other art that uses elements of the works of the Queen Anne period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Queen Anne Revival"@en .

aat:300444323 a skos:Concept ;
    skos:definition "Period of the dynasty that ruled during the Early Ottoman Empire in the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saruhanid"@en .

aat:300444324 a skos:Concept ;
    skos:definition "Architectural style of North America that uses elements of the Spanish Baroque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Baroque Revival"@en .

aat:300444325 a skos:Concept ;
    skos:definition "Style of American architecture inspired by built works of Spain and Latin America, blending elements of Moorish, Mediterranean, and Spanish Colonial elements. The style is particularly prevalent in Florida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Eclectic Style"@en .

aat:300444326 a skos:Concept ;
    skos:definition "Style of American architecture inspired by built works of the Spanish Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Renaissance Revival"@en .

aat:300444327 a skos:Concept ;
    skos:definition "Architectural style of North America that uses elements of Romanesque styles of Spain and Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish-Italian Romanesque Revival"@en .

aat:300444328 a skos:Concept ;
    skos:definition "A vernacular language is the local, native, or indigenous language of a country, district or other area, or of a given culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernacular languages"@en .

aat:300444329 a skos:Concept ;
    skos:definition "Culture and period of ancient Troy, associated with excavations at Hisarlık, Turkey. The nine major periods of ancient Troy are labeled I to IX, starting from the bottom with the oldest settlement, Troy I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy"@en .

aat:300444330 a skos:Concept ;
    skos:definition "Period of the first village on the site of ancient Troy, ca. 3000-2550 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy I"@en .

aat:300444331 a skos:Concept ;
    skos:definition "Period of the second city on the site of ancient Troy, ca. 2550-2300 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy II"@en .

aat:300444332 a skos:Concept ;
    skos:definition "Period of the third city on the site of ancient Troy, ca. 2300 -2200 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy III"@en .

aat:300444333 a skos:Concept ;
    skos:definition "Period of the fourth city on the site of ancient Troy, ca. 2200 -1950 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy IV"@en .

aat:300444334 a skos:Concept ;
    skos:definition "Period of the fifth city on the site of ancient Troy, ca. 1950-1750 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy V"@en .

aat:300444335 a skos:Concept ;
    skos:definition "Period of the sixth city on the site of ancient Troy, ca. 1750 -1300 BCE. Probably the period associated with the Troy of Homeric literature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy VI"@en .

aat:300444336 a skos:Concept ;
    skos:definition "Period of the seventh city on the site of ancient Troy, ca. 1300-1050 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy VII"@en .

aat:300444337 a skos:Concept ;
    skos:definition "Period of the eighth city on the site of ancient Troy, ca. 1300-1050 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy VIII"@en .

aat:300444338 a skos:Concept ;
    skos:definition "Period of the ninth city on the site of ancient Troy, ca. 700 BCE-500 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troy IX"@en .

aat:300444339 a skos:Concept ;
    skos:definition "Period and style of American architecture and arts 1876-1917, from the Centennial Exposition to the entry of USA into WWI. Characterized by renewed national self-confidence. references to Greek democracy, Roman law, and Renaissance humanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American Renaissance"@en .

aat:300444340 a skos:Concept ;
    skos:definition "European fantasy architectural style, late 18th-early 19th century, that references archaeologically correct Gothic and Rococo. Inspired by the manor Strawberry Hill designed by Horace Walpole, dated 1747-1790."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strawberry Hill Gothic"@en .

aat:300444341 a skos:Concept ;
    skos:definition "Early Tudor style and period when the influence of Gothic remained strong, particularly evident in domestic architecture, while in church architecture Renaissance motifs were appearing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tudor Gothic"@en .

aat:300444342 a skos:Concept ;
    skos:definition "Style that combines recognizable elements of two or more defined styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amalgam style"@en .

aat:300444344 a skos:Concept ;
    skos:definition "American architectural style of many public buildings 1933-1944, created in a relief program of the Great Depression and sponsored by the Public Works Administration (PWA) and the Works Progress Administration (WPA). Similar to Streamline Moderne, and may include elements of Beaux-Arts classicism and Art Deco,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "WPA Moderne style"@en .

aat:300444345 a skos:Concept ;
    skos:definition "Style of domestic architecture, particularly in North American 1940s-1950s. Characterized by having one-story and low-pitched roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranch style"@en .

aat:300444346 a skos:Concept ;
    skos:definition "Primary living quarters for a ranch, which is a large farm, especially in the western US and Canada, where cattle or other animals are bred and raised."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranch houses"@en .

aat:300444347 a skos:Concept ;
    skos:definition "An American architectural style of public buildings during the New Deal Works Project Administration, utilizing natural materials such as stone and weathered wood. Similar to National Park Service rustic style, but differing in its emphasis on demarcation between the building and the landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "WPA Rustic style"@en .

aat:300444348 a skos:Concept ;
    skos:definition "An American architectural style developed in the early and mid-20th century by the US National Park Service (NPS). Goals were to standardize buildings in their parks, with an emphasis on harmonizing the architecture with the natural environment and existing historical architecture of the site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "National Park Service rustic style"@en .

aat:300444349 a skos:Concept ;
    skos:definition "Style of interior design and architecture that brings together elements of various eras and movements in a harmonious way, juxtaposing styles, textures, and contrasting colors to create a cohesive whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eclectic Style"@en .

aat:300444350 a skos:Concept ;
    skos:definition "Revival architectural style that is inspired by the 17th-century architecture of Belgium. Structures are typically large and made of rubbed red brick, sandstone, or limestone, often distinguished by incorporating a stepped gable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flemish Renaissance Revival"@en .

aat:300444351 a skos:Concept ;
    skos:definition "Style that developed in Greece and Turkey in the 18th century, drawing upon European Rococo style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ottoman Rococo"@en .

aat:300444352 a skos:Concept ;
    skos:definition "Style of architecture and furniture that abides by or imitates rules set out in the Shaker Millennial Laws, which require simple forms that are undecorated by beadings, moldings, and cornices. Buildings were typically constructed of brick, wood, or limestone. The buildings reflect local vernacular styles and none of those responsible for the principal planning and construction had any formal architectural training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shaker Style"@en .

aat:300444353 a skos:Concept ;
    skos:definition "General term for art and architecture inspired by Venetian styles, which themselves encompass a cross-section of Byzantine, Venetian Renaissance, and other styles. The time periods when the revival styles may be found is great, from 17th through 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian Revival"@en .

aat:300444354 a skos:Concept ;
    skos:definition "Style of domestic architecture with a one- to one-and-a-half-story building having a low-pitched gable or hipped roof, with widely projecting, often bracketed eaves, dormers, and conspicuous front porches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bungalow style"@en .

aat:300444355 a skos:Concept ;
    skos:definition "North American architectural style inspired by Victorian style, but made simpler and more plain. Although relatively plain in contrast to Victorian styles, the buildings are embellished with decorative trim. The floorplans are more regular than in Victorian homes. Flourished between 1870 and 1910, though isolated examples continued to be built well into the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Folk Victorian"@en .

aat:300444356 a skos:Concept ;
    skos:definition "Buildings planned or used for multiple purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed-use buildings"@en .

aat:300444357 a skos:Concept ;
    skos:definition "Stands for holding turbans. Prime examples were created in the Ottoman Empire, where court officials and members of the elite classes wore elaborately shaped turbans that indicated rank and position, wound accordiing to precise clothing regulations. The turbans were placed on turban stands between wearings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turban stands"@en .

aat:300444359 a skos:Concept ;
    skos:definition "The process of preparing food, a dish, or a meal, typically by combining and heating ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking"@en .

aat:300444360 a skos:Concept ;
    skos:definition "Heavily armed and well-manned merchant ships of the Dutch East India Company, or Verenigde Oostindische Compagnia, VOC. These were specifically designed for the long roundtrip, or 'retour,' voyage from the Netherlands to the East Indies. These vessels were also repeatedly used as warships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retourships"@en .

aat:300444361 a skos:Concept ;
    skos:definition "Collectively describes plants or grasses which are cultivated as food crops. These may include wheat, rye, barley, oats, millet, rice, and maize. For the edible seeds of these plants use 'grain.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cereals"@en .

aat:300444363 a skos:Concept ;
    skos:definition "Narrow strips of deep-fried potato, generally eaten as side dish, or as a snack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French fries"@en .

aat:300444364 a skos:Concept ;
    skos:definition "Study of the origin and evolution of paper as a product and material: paper production, paper trade, the management of papermills and paper factories, raw materials, and the cultural importance of paper as an information carrier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper history"@en .

aat:300444365 a skos:Concept ;
    skos:definition "Small, primitive windmills designed for drainage of plots of land or at peat digging sites as they are easily moved. Most often identified as a Frisian design, these are found in other Dutch provinces, and Northern Germany. Characterized by a single shaft supporting the sails on one end and an Archimedean screw on the other, allowing for a gearless action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tjaskers"@en .

aat:300444366 a skos:Concept ;
    skos:definition "The act and discipline of composing drawings that visually communicate how something functions or is constructed. The need for precise communication in the preparation of a functional document distinguishes technical drawing from the expressive drawing of the visual arts. Technical drawing is used for architecture and engineering. There are two methods of technical drawing: manual or by instrument and computer aided design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical drawing"@en .

aat:300444367 a skos:Concept ;
    skos:definition "Collectively describes living beings that reside in the ocean. This term is often additionally used to describe legendary or mythological beings thought to live in oceans or seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea creatures"@en .

aat:300444368 a skos:Concept ;
    skos:definition "Religious or worldy communities of knights bound by rules of chivalry, with the main purpose of an ideal or charitable task. Originally these societies had a military and spiritual nature and members were elevated to nobility. Since the 18th century they became institutions for rewarding and acknowledging services to society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knighthoods"@en .

aat:300444370 a skos:Concept ;
    skos:definition "Technique of laying masonry of squared stones in courses of even height throughout the length of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "range work"@en .

aat:300444371 a skos:Concept ;
    skos:definition "Technique of laying masonry of squared stones in courses that are not continuously of even height, as distinguished from \"range work.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broken range work"@en .

aat:300444398 a skos:Concept ;
    skos:definition "Limestone having high luminosity and homogeneity of white or very light tones, often with small and uniform specks of other colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white limestone"@en .

aat:300444399 a skos:Concept ;
    skos:definition "Walls made of concrete masonry units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block walls"@en .

aat:300444400 a skos:Concept ;
    skos:definition "Weatherboarding having upper edges narrowed to fit into grooves or rabbets in its lower edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop siding"@en .

aat:300444401 a skos:Concept ;
    skos:definition "A flexible water-proofing emulsion coating used to prevent or stop leaks on roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofing compound"@en .

aat:300444402 a skos:Concept ;
    skos:definition "Culture of the West African kingdom located within present-day Benin that existed from approximately 1600 until 1904."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dahomey"@en .

aat:300444403 a skos:Concept ;
    skos:definition "Movement and style, particularly in Egypt, when rulers commissioned grand architectural projects and other fine artworks were produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mamluk Revival"@en .

aat:300444404 a skos:Concept ;
    skos:definition "In keeping with the current pragmatism of philosophy, references Swedish and other architecture of the 1940s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Empiricism"@en .

aat:300444405 a skos:Concept ;
    skos:definition "Longest-lived and most powerful of the northern Chinese dynasties that existed before the reunification of China under the Sui and Tang dynasties, 386-534/535 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wei"@en .

aat:300444406 a skos:Concept ;
    skos:definition "Buildings associated with academic institutions, including the schools, libraries, and other associated buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic buildings"@en .

aat:300444407 a skos:Concept ;
    skos:definition "Buildings housing academic enterprises that teach art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art schools"@en .

aat:300444408 a skos:Concept ;
    skos:definition "Two or more single family residences located on individual lots but attached by a common wall at a shared property line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attached houses"@en .

aat:300444409 a skos:Concept ;
    skos:definition "Buildings, stands, and other structures built upon the beach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach architecture"@en .

aat:300444411 a skos:Concept ;
    skos:definition "Buildings in which cookery is taught, often containing kitchens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking schools"@en .

aat:300444412 a skos:Concept ;
    skos:definition "Buildings in which nursing is taught and student nurses are trained"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing schools"@en .

aat:300444413 a skos:Concept ;
    skos:definition "Buildings, stands, and other structures in park."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "park buildings"@en .

aat:300444414 a skos:Concept ;
    skos:definition "Buildings housing academic enterprises that teach the theory and practice of architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural schools"@en .

aat:300444894 a skos:Concept ;
    skos:definition "Style of Benedictine monasteries and churches in North America, primarily using Romanesque Revival elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American Benedictine"@en .

aat:300444895 a skos:Concept ;
    skos:definition "Style and movement in England associated with the European Renaissance that started in Italy in the late 14th century. In England the style was evident 16th-early 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English Renaissance"@en .

aat:300444896 a skos:Concept ;
    skos:definition "Culture, and style of the Moravian Brethren, with a philosophy and style tending towards simplicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German Moravian"@en .

aat:300444897 a skos:Concept ;
    skos:definition "Christian society and sect that began in Germany in the 18th century as a reaction to Lutheranism, and migrated to the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Harmony Society"@en .

aat:300444898 a skos:Concept ;
    skos:definition "Central Asian culture who replaced the Shaybanids ca. 1600."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Janid"@en .

aat:300444899 a skos:Concept ;
    skos:definition "North American form of Neo-Classicism or Neo-Palladianism embodied in the architectural designs of U.S. President and polymath Thomas Jefferson, and those styles that imitated his works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jeffersonian"@en .

aat:300444900 a skos:Concept ;
    skos:definition "Culture and styles of the Central Asian polity that existed in the historical region of Khwarezm in Central Asia from 1511 to 1920."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khanate of Khiva"@en .

aat:300444901 a skos:Concept ;
    skos:definition "Style of fashion, decorative arts, and architecture that invoke elements of miliary design and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military style"@en .

aat:300444902 a skos:Concept ;
    skos:definition "Style of buildings that were constructed before 1939, arising during a population boom in Europe in the 1880s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pre-war style"@en .

aat:300444903 a skos:Concept ;
    skos:definition "Architectural style of North American incorporating elements of the Southern US states, often including antebellum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern"@en .

aat:300444904 a skos:Concept ;
    skos:definition "An alternative to a slab foundation, comprising a concrete pier reinforced with steel rebar to form a strong cage within the pier. The piers are set atop a concrete pad that also has been reinforced with steel rebar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pier and beam foundations"@en .

aat:300444905 a skos:Concept ;
    skos:definition "Fossil formed when plant material is buried by sediment and protected from decay due to oxygen and organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petrified wood"@en .

aat:300444906 a skos:Concept ;
    skos:definition "A dense, narrow pyramidal evergreen tree native to the mountains of Europe and Asia. Swiss stone pine has been used extensively for wooden sculptures and buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus cembra"@en .

aat:300444907 a skos:Concept ;
    skos:definition "The study of society as a complex arrangement of elements, including individuals and their beliefs, as they relate to a whole (e.g., a country)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "systems theory"@en .

aat:300444908 a skos:Concept ;
    skos:definition "Particles of silver that have a typical size of 10–100 nm and can exhibit a wide variety of shapes. The synthesis of AgNPs is commonly performed via the reduction of silver salts with reducing agents such as sodium borohydride in the presence of a colloidal stabilizer, including polyvinyl alcohol, bovine serum albumin, or citrate. Silver nanoparticle is known for its antimicrobial properties and exhibits chemical stability, good conductivity, and excellent optical properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver nanoparticles"@en .

aat:300444909 a skos:Concept ;
    skos:definition "An ancient, coarse-grain, white marble quarried from the Greek island of Naxos. Naxian marble was used for sculpture between the 7th and 6th centuries BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Naxian marble"@en .

aat:300444910 a skos:Concept ;
    skos:definition "Paint containing either liquid crystals or leuco dyes which change color depending on the temperature of the surface to which they have been applied or the immediate atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermochromic paint"@en .

aat:300444911 a skos:Concept ;
    skos:definition "A registered trademark for a milky white aqueous emulsion of ethylacrate/methyl methacrylate copolymer. Plextol® B-500 is used as a dispersant, thickening agent, and sizing agent in inks, paints, adhesives, textiles, and papermaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plextol (R) B-500"@en .

aat:300444912 a skos:Concept ;
    skos:definition "Films paid for by a company or an organization for promotional purposes or communication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponsored films"@en .

aat:300444913 a skos:Concept ;
    skos:definition "Volcanic rock produced by the largest known trachytic phreatoplinian eruption and composed of zeolites such as phillipsite and chabazite. Neapolitan yellow tuff represents the most used building stone of the historical monumental heritage of Naples and also constitutes a significant part of the city modern architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neapolitan yellow tuff"@en .

aat:300444914 a skos:Concept ;
    skos:definition "The black or brownish shell material of any of numerous bivalve molluscs found worldwide, belonging chiefly to the orders Mytiloida and Unionoida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mussel shell"@en .

aat:300444915 a skos:Concept ;
    skos:definition "Buildings that house businesses that sell antiques, which are artifacts created or produced in former periods and considered to have value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antique shops"@en .

aat:300444916 a skos:Concept ;
    skos:definition "Offices spaces occupied by architects and their associates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural offices"@en .

aat:300444917 a skos:Concept ;
    skos:definition "Studio spaces for those creating art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist studios"@en .

aat:300444918 a skos:Concept ;
    skos:definition "Buildings or complex strategically located and used for observing celestial bodies and events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical observatories"@en .

aat:300444919 a skos:Concept ;
    skos:definition "Vehicles accommodating a small public library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookmobiles"@en .

aat:300444920 a skos:Concept ;
    skos:definition "Offices or other spaces staffed and equipped to handle large numbers of telephone calls, using computer technology to assist in the management of calls and supply of information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "call centers"@en .

aat:300444921 a skos:Concept ;
    skos:definition "Buildings or spaces housing the meetings of chambers of commerce, which are associations formed to promote and protect the interests of the business community in a particular place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber of commerce buildings"@en .

aat:300444922 a skos:Concept ;
    skos:definition "Buildings where trade is conducted, often optimized for a gathering together of people for the purchase and sale produce and livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered markets"@en .

aat:300444923 a skos:Concept ;
    skos:definition "Spaces optimized to allow trade to be conducted, often designed for a gathering together of people for the purchase and sale produce and livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open air markets"@en .

aat:300444924 a skos:Concept ;
    skos:definition "Buildings housing academic enterprises that teach the theory and practice of engineering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineering schools"@en .

aat:300444925 a skos:Concept ;
    skos:definition "Builtings or structures designed to contain assemblies of interrelated equipment designed to provide heat to other buildings and structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating plants"@en .

aat:300444926 a skos:Concept ;
    skos:definition "Offices spaces occupied by lawyers, experts in law, and their associates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law offices"@en .

aat:300444927 a skos:Concept ;
    skos:definition "Structures serving as housing or temporary location of lifeguards, who are water safety experts with medical training who watch and assist bathers who get into difficulty at a beach, swimming pool, or other body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifeguard stations"@en .

aat:300444928 a skos:Concept ;
    skos:definition "Buildings that house businesses that sell alcoholic beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquor stores"@en .

aat:300444929 a skos:Concept ;
    skos:definition "Buildings that house museums with exhibitions and other holdings documenting the history and artifacts pertinent to the written word and other literature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literature museums"@en .

aat:300444930 a skos:Concept ;
    skos:definition "Villages, towns, or cities located on or near the water, around a marina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marina settlements"@en .

aat:300444931 a skos:Concept ;
    skos:definition "Buildings designed or used primarily for marriages and associated festivities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage halls"@en .

aat:300444932 a skos:Concept ;
    skos:definition "Spaces where doctors and other medical practitioners may meet and treat patients, generally located outside of hospital facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medical offices"@en .

aat:300444933 a skos:Concept ;
    skos:definition "Very large retail stores, often specializing in a particular genre of product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megastores"@en .

aat:300444934 a skos:Concept ;
    skos:definition "Centers, often in an educational facility, where multiple diciplines may be practiced or taught, such as audio and vidio technology, journalism, library science, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multimedia centers"@en .

aat:300444935 a skos:Concept ;
    skos:definition "Buildings and other facilities used for the Olympic games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Olympics complexes"@en .

aat:300444936 a skos:Concept ;
    skos:definition "Buildings or large rooms associated with a parish church, that are used by the congregation or by the local community for social or charitable activities, though not necessarily associated with the litergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parish halls"@en .

aat:300444937 a skos:Concept ;
    skos:definition "Studio spaces for those shooting photographs, printing, or otherwise creating photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographers studios"@en .

aat:300444938 a skos:Concept ;
    skos:definition "Buildings or complexes housing machinery and operations to sort mail and other postal items for distribution and delivery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postal sorting centers"@en .

aat:300444939 a skos:Concept ;
    skos:definition "Built works used to house radioactive waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radioactive waste repositories"@en .

aat:300444940 a skos:Concept ;
    skos:definition "Walkways raised over vehicular traffic or other obstacles, to allow satisfactory passage of pedestrians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raised walkways"@en .

aat:300444941 a skos:Concept ;
    skos:definition "Schools for children who may benefit from or require modifications of regular school practices or facilities, due to different social, mental, or physical needs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special education schools"@en .

aat:300444942 a skos:Concept ;
    skos:definition "Residential or commercial building developments purchased or built with the purpose of reselling or renting, having no confirmed buyers but speculating that there will be need or interest in the properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speculative developments"@en .

aat:300444943 a skos:Concept ;
    skos:definition "Buildings that use a frame structure of large posts and beams that are joined with pegs or by other types of decorative joinery; the beams may be visible in the finished structure, or hidden beneath the surface walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timber framed buildings"@en .

aat:300444944 a skos:Concept ;
    skos:definition "Museums administered by, and located on the premises of, a unversity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "university museums"@en .

aat:300444945 a skos:Concept ;
    skos:definition "Dwellings used by occupants on the weekends or other periods of time away from weekday life, such as country residences for those who work during the week in a city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weekend houses"@en .

aat:300444946 a skos:Concept ;
    skos:definition "Buildings or parts of buildings housing firms that specialize in advertising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising agencies"@en .

aat:300444947 a skos:Concept ;
    skos:definition "Period and culture of the loose federation of East Slavic and Finno-Ugric peoples in Eastern and Northern Europe from the late 9th to the mid-13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kievan Rus'"@en .

aat:300444948 a skos:Concept ;
    skos:definition "Style and culture of an Anatolian beylik of Erzincan, Kemah, Sebinkarahisar and Divrigi during12th-13th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mengujekid"@en .

aat:300444949 a skos:Concept ;
    skos:definition "Culture and style of the Iberian Christians who lived under Muslim rule in Al-Andalus following the conquest of the Christian Visigothic Kingdom by the Umayyad Caliphate, from the 7th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mozarab"@en .

aat:300444950 a skos:Concept ;
    skos:definition "Culture of the Mouride brotherhood found in Senegal and Gambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mouride"@en .

aat:300444951 a skos:Concept ;
    skos:definition "Moorish Revival architecture seen primarily on the Iberian Peninsula and in Ibero-America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Mudéjar"@en .

aat:300444952 a skos:Concept ;
    skos:definition "Culture and style of a people of early medieval eastern Europe, probably originally Norse from Sweden, settling and ruling along the river routes between the Baltic and Black Seas, dating 8th-11th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rus'"@en .

aat:300444953 a skos:Concept ;
    skos:definition "Central Asian culture of a Mongol tribe of the Urud-Manghud federation, 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manghit"@en .

aat:300444954 a skos:Concept ;
    skos:definition "Culture of an empire dating ca. 321-185 BCE, known as the first pan-Indian empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mauryan"@en .

aat:300444955 a skos:Concept ;
    skos:definition "Culture of the eastern Indian state of Odisha, on the Bay of Bengal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odishan"@en .

aat:300444956 a skos:Concept ;
    skos:definition "Muslim dynasty of Turkic origin that ruled over the Delhi sultanate in medieval India, beginning in 1320."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tughlug"@en .

aat:300444957 a skos:Concept ;
    skos:definition "Culture of a dynasty in the Indian subcontinent that originated from the Deccan, from mid-3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vakataka"@en .

aat:300444958 a skos:Concept ;
    skos:definition "Culture and period of a dynasty that reigned in Transoxania until ca. 771-1370 and in Turkestan 11th-17th century"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chaghatayid"@en .

aat:300444959 a skos:Concept ;
    skos:definition "Buildings for gatherings of a Sufi brotherhood, to serve as places for spiritual retreat, and as hospices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khanqahs"@en .

aat:300444961 a skos:Concept ;
    skos:definition "Towers, turrets, lighthouses, or similar structures in south and east Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minars"@en .

aat:300444962 a skos:Concept ;
    skos:definition "Grand hall or gallery having walls lined with mirrors; the best known are in the Baroque style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halls of mirrors"@en .

aat:300444963 a skos:Concept ;
    skos:definition "Buildings that house businesses that sell or make jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry shops"@en .

aat:300444964 a skos:Concept ;
    skos:definition "Distinctive citadels in India and Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kotlas"@en .

aat:300444965 a skos:Concept ;
    skos:definition "In southern Africa, enclosed areas in a traditional village used for assemblies, court cases, and meetings of the leaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kgotlas"@en .

aat:300444967 a skos:Concept ;
    skos:definition "Buildings that house businesses that sell shoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe stores"@en .

aat:300444968 a skos:Concept ;
    skos:definition "Caves dug or modified for human habitation, worship, or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-cut caves"@en .

aat:300444969 a skos:Concept ;
    skos:definition "Reservoirs for water storage, best known in India and Pakistan. step-well, sometimes with pavilions within; tank; stepped well"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vapis"@en .

aat:300444970 a skos:Concept ;
    skos:definition "The visible aspect of a thing, the way in which a thing exists or appears; usually emphasizes shape and configuration, but may also include color or other visible characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "form"@en .

aat:300444971 a skos:Concept ;
    skos:definition "The purpose or activity realized by a thing, the way in which a thing operates or the objective for which it is used. May be applied to people, other beings, or institutions as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "function"@en .

aat:300444972 a skos:Concept ;
    skos:definition "The status or condition of a thing, being, or information being open to general observation, view, or knowledge, or of activties existing, performed, or carried out without concealment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public"@en .

aat:300444973 a skos:Concept ;
    skos:definition "The status or condition of a thing, being, or information being available to only a chosen audience, but concealed or safeguarded from general view or knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private"@en .

aat:300444974 a skos:Concept ;
    skos:definition "General term for igneous rocks that are neither granitic nor of recent volcanic formation, such as dark-colored igneous rocks columnar in structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trap"@en .

aat:300444975 a skos:Concept ;
    skos:definition "Culture of a dynasty in the Indian subcontinent that originated from the Deccan, from mid-3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alupendra"@en .

aat:300444976 a skos:Concept ;
    skos:definition "Culture of a dynasty that ruled in parts of the present-day Rajasthan and surroundings in India; the area was then known as Sapadalaksha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cahamana"@en .

aat:300444977 a skos:Concept ;
    skos:definition "Culture of a dynasty that ruled in west central India 6th-7th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalachuri"@en .

aat:300444978 a skos:Concept ;
    skos:definition "Culture of the historical region in central eastern Georgia, traversed by the Kura river near modern Tbilisi; important region in Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kartli"@en .

aat:300444979 a skos:Concept ;
    skos:definition "Culture of a dynasty that ruled in what is now the Indian state of Tamil Nadu, including Tanjore, Trichy, and Pudukottai 600-900 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muttaraiyar"@en .

aat:300444980 a skos:Concept ;
    skos:definition "Period and culture under Pulakeshin II (r. 610-642 CE) of the Chalukya dynasty in peninsular India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pulakesin II"@en .

aat:300444981 a skos:Concept ;
    skos:definition "Culture of a dynasty that ruled parts of eastern India 6th-8th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sailodbhava"@en .

aat:300444982 a skos:Concept ;
    skos:definition "Culture of a dynasty that ruled in the Deccan region late second century BCE- early third century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Satavahana"@en .

aat:300444983 a skos:Concept ;
    skos:definition "Culture of the fourth dynasty of the Delhi Sultanate, 1414-1451; founded by Khizr Khan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sayyid dynasty"@en .

aat:300444984 a skos:Concept ;
    skos:definition "Culture of the dynasty that ruled the Jaunpur Sultanate; of Abyssinian origin, founded in 1394."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sharqi"@en .

aat:300444985 a skos:Concept ;
    skos:definition "Movement in architecture that uses structure as the fundamental expression, endorsing structural and material changes enabled by the industrial revolution; term was coined by Kenneth Frampton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Structural Classicism"@en .

aat:300444986 a skos:Concept ;
    skos:definition "Movement and style of the German Weimar Republic during the interwar period 1918-1933, when there was a renewed emphasis on arts and sciences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Weimar"@en .

aat:300444987 a skos:Concept ;
    skos:definition "Culture of a dynasty that ruled in the present-day Odisha in eastern India 9th-12th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Somavamsi"@en .

aat:300444988 a skos:Concept ;
    skos:definition "Culture of a religious group in Syria that had originated in Shiite Islam but separated from other Shiite groups in the 9th-10th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alawi"@en .

aat:300444989 a skos:Concept ;
    skos:definition "Period and culture from 3rd-1st centuries BCE, known for great advances in mathematics, science, astronomy, optics, and mechanics, born in Alexandria, Egypt but spread to Greece and beyond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alexandrian"@en .

aat:300444990 a skos:Concept ;
    skos:definition "Period and culture of Russia and across Eurasia and North America from 1721-1917."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian Empire"@en .

aat:300444992 a skos:Concept ;
    skos:definition "Culture of the Arab kingdom formed by emigrants from Yemen to the Levant region in early 3rd century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ghassanid"@en .

aat:300444993 a skos:Concept ;
    skos:definition "Culture of the Persianate Mongol Jalayir dynasty in Iraq and western Persia after the breakup of the Mongol khanate of Persia in the 1330s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jalayrid"@en .

aat:300444994 a skos:Concept ;
    skos:definition "Culture of the Crusader state established in the Southern Levant by Godfrey of Bouillon in 1099 after the First Crusade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kingdom of Jerusalem"@en .

aat:300444995 a skos:Concept ;
    skos:definition "Culture and period of the members of the House of Anjou. Included are those in France and those who occupied the throne of the Kingdom of Jerusalem in the 12th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angevin"@en .

aat:300444996 a skos:Concept ;
    skos:definition "Culture of a Berber sultanate mid-13th-15th centuries in present-day Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marinid"@en .

aat:300444997 a skos:Concept ;
    skos:definition "Styles of architecture and urban design in the Muslim world that have adapted the values of Islam as well as changes in materials and construction technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New-Islamic"@en .

aat:300444998 a skos:Concept ;
    skos:definition "Style and culture of the Novgorod Republic, a medieval Rus' state during 12th-15th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Novgorod"@en .

aat:300444999 a skos:Concept ;
    skos:definition "Basic reference to 'after the colonial\" condition, periods, and cultures of peoples, states, and societies that have been through a process of formal decolonization. Since the 1980s the term is used to also refer to the trend to question Western knowledge, categories, and assumptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post-Colonial"@en .

aat:300445000 a skos:Concept ;
    skos:definition "Culture of a Moroccan sultanate in 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sa'dian"@en .

aat:300445001 a skos:Concept ;
    skos:definition "Culture of an Iranian dynasty of Gilaki origin in Tabaristan 930-1090."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ziyarid"@en .

aat:300445002 a skos:Concept ;
    skos:definition "Culture of an Iranian princely family of Daylamite origin, active in 10th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Firuzanid"@en .

aat:300445003 a skos:Concept ;
    skos:definition "Culture of an Iranian people inhabiting the Daylam, which is mountainous area of northern Iran on the Caspian Sea ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daylamite"@en .

aat:300445004 a skos:Concept ;
    skos:definition "Period and culture under the rule of Recceswinth, Visigothic King of Hispania and Septimania in 7th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Recceswinth period"@en .

aat:300445005 a skos:Concept ;
    skos:definition "Reception rooms located at the entrance to the residence of a prominent Roman home, a prelate, ruler, or other official."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salutatoria"@en .

aat:300445006 a skos:Concept ;
    skos:definition "Principle of design proposing that the shape of a built work or object should serve and illustrate its intended purpose. This philosophy and maxim was coined by architect Louis Sullivan, and is associated with late 19th to early 20th century architecture and industrial design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "form follows function"@en .

aat:300445007 a skos:Concept ;
    skos:definition "The realm, group, or groups of ordinary people in general, or of a given community united by common ideas, ideology, or hobbies; distinguished from groups comprising the elite or a chosen few."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public"@en .

aat:300445008 a skos:Concept ;
    skos:definition "Division of primate taxonomy containing 3 infraorders of 6 families with 4 fossil families; included are lemurs, galagos and lorisids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strepsirrhini"@en .

aat:300445009 a skos:Concept ;
    skos:definition "Division of primate taxonomy containing 2 infraorders of 9 living families containing 41 living genera; 8 fossil families contain about 50 fossil genera; included are tarsiers, monkeys and apes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haplorhini"@en .

aat:300445010 a skos:Concept ;
    skos:definition "Group of primates of which Tarsiers (family Tarsiidae) are the only living members, however, they once ranged across Europe, northern Africa, Asia, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarsiiformes"@en .

aat:300445012 a skos:Concept ;
    skos:definition "Superfamily containing five families of primates that are found in the tropical regions of Mexico, Central and South America: Callitrichidae, Cebidae, Aotidae, Pitheciidae, and Atelidae. About 40 million years ago, the Simiiformes infraorder split into the parvorders Platyrrhini (New World monkeys in South America) and Catarrhini (apes and Old World monkeys in Africa)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platyrrhini"@en .

aat:300445014 a skos:Concept ;
    skos:definition "To go back or revert to a previous owner; the act or action of return."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "returning"@en .

aat:300445015 a skos:Concept ;
    skos:definition "Culture of the dynasty of 12th-13th-century Ethiopian kings who lived a nomadic military life and also left a legacy of important Christian monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zagwe"@en .

aat:300445016 a skos:Concept ;
    skos:definition "In the Middle East, refers to towers of various descriptions, often used for skyscrapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burj"@en .

aat:300445017 a skos:Concept ;
    skos:definition "In India, a grate, gate, bars, or other covering for an opening, which allows entry of light but keeps out animals, dust, people, objects, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jhanjhari"@en .

aat:300445018 a skos:Concept ;
    skos:definition "In India, large open-sided shelters, comprising upright poles supporting a roof usually made of bamboo matting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pandals"@en .

aat:300445019 a skos:Concept ;
    skos:definition "In India, a collection of huts, sometimes defined by the area upon which they stand as being at least one-sixth of an acre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basti"@en .

aat:300445020 a skos:Concept ;
    skos:definition "The legally recognized words or phrases under which a corporate body or institution is known and engages in action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate names"@en .

aat:300445021 a skos:Concept ;
    skos:definition "Numbers used to identify an individual publication within a classification or location in a library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book numbers"@en .

aat:300445022 a skos:Concept ;
    skos:definition "Identifying numbers associated with the sequence of pages in books or other documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "page numbers"@en .

aat:300445024 a skos:Concept ;
    skos:definition "Statement or account that describes the buyer in an acquisition event, listing characteristic features, or significant details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buyer description"@en .

aat:300445025 a skos:Concept ;
    skos:definition "Statement or account that describes the seller in an acquisition event, listing characteristic features, or significant details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seller description"@en .

aat:300445027 a skos:Concept ;
    skos:definition "A compound of iron and sulfate in which the ratio of iron (2+) to sulfate ions is 1:1. It is one of the main ingredients of iron-gall ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron sulfate"@en .

aat:300445030 a skos:Concept ;
    skos:definition "Large groups of stars, existing as two primary types: globular clusters are tight groups of hundreds to millions of old stars which are gravitationally bound; open clusters are loosely clustered groups of generally young stars, containing fewer than a few hundred members typically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "star clusters"@en .

aat:300445031 a skos:Concept ;
    skos:definition "Notes that are included in a document for the use of an administrator, editor, or other manager, rather than a general viewer, usually including details about the structure or function of the document."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internal notes"@en .

aat:300445032 a skos:Concept ;
    skos:definition "Describes people whose gender expression is other than conventional expectations of masculinity and femininity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender non-conforming people"@en .

aat:300445034 a skos:Concept ;
    skos:definition "Systems of writing or expressing numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "number systems"@en .

aat:300445040 a skos:Concept ;
    skos:definition "Works, either movable works or built works, that are known by name in literature or otherwise doscumented, but not firmly associated with the corresponding physical work. For works in collections for which the purpose and thus work type are unknown, use \"unidentified works.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unidentified named works"@en .

aat:300445041 a skos:Concept ;
    skos:definition "Works for which identification with a particular physical work, either movable work or architecture, is ambiguous. For example, the name \"Totocalco\" was associated with both a storehouse and an aviary in ancient Tenochtitlan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambiguously identified works"@en .

aat:300445042 a skos:Concept ;
    skos:definition "Building complexes focused on one or more pyramids, but containing other structures such as palace, temples, solar boat pits, and other features. The complex at Giza, Egypt, is an example."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramid complexes"@en .

aat:300445043 a skos:Concept ;
    skos:definition "Building complexes focused on a pyramid and temple. Examples occur at Pre-Columbian sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramid temple complexes"@en .

aat:300445044 a skos:Concept ;
    skos:definition "Structures that designate an entry point to an architectural construction or place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrance structures"@en .

aat:300445045 a skos:Concept ;
    skos:definition "Prints made by machines that operate using a stencil matrix that ink is pushed through onto a paper support, in a mechanized process similar to silkscreen printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duplicator prints"@en .

aat:300445046 a skos:Concept ;
    skos:definition "Trademarked term for a particular type of digital duplicating machine made by the Riso company that employs soy-based inks. Copies are created by scanning an image, burning it to a laser-etched stencil that is wrapped around a drum containing ink that rolls over continuously fed paper to create copies very rapidly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Risographs (TM)"@en .

aat:300445047 a skos:Concept ;
    skos:definition "Manmade islands composed of shells, usually shells that were discarded from human consumption of seafood over many years. Examples are in the Florida Keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial shell islands"@en .

aat:300445048 a skos:Concept ;
    skos:definition "Machines that make copies of print originals by scanning an image, or receiving a digital signal from a computer, and burning a 'master' or stencil onto a photosensitive polyester resin film bonded to thin fibrous paper, which is mounted on an ink drum, through which ink passes onto a paper support. For machines that make a similar type of print from a manually created stencil, and that do not have the scanning stage, use 'duplicators'. For similar machines that use a specific type of chemistry and ink combination, and that are manually operated, use 'mimeographs.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital duplicators"@en .

aat:300445074 a skos:Concept ;
    skos:definition "A ritual festival celebrating Nahua deities and one of the eighteen periods of twenty days in the Xiuhpohualli (solar Nahua calendar)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toxcatl"@en .

aat:300445245 a skos:Concept ;
    skos:definition "Series of steps or stairways having stone as the primary material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone stairways"@en .

aat:300445387 a skos:Concept ;
    skos:definition "Species of pine native to the mountains of southern Mexico and western Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus ayacahuite"@en .

aat:300445395 a skos:Concept ;
    skos:definition "Representations of speech, song, or other sound in two-dimensional visual works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speechscrolls"@en .

aat:300445396 a skos:Concept ;
    skos:definition "Glyphs or symbols that represent the name of a place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toponymic glyphs"@en .

aat:300445397 a skos:Concept ;
    skos:definition "Lines that represent the ground plane in an image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groundlines"@en .

aat:300445398 a skos:Concept ;
    skos:definition "A wooden war canoe. Described in the Florentine Codex, it was used on the lake of Texcoco and its canals by the Mexica during battles with the Spaniards. The term also refers to a quadrangular, canoe-shaped shield, part of the array of the detiy Totoltecatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acalchimalli"@en .

aat:300445399 a skos:Concept ;
    skos:definition "Large, round sprays of feathers worn as headdresses or back devices by warriors in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ahpanehecayotl"@en .

aat:300445400 a skos:Concept ;
    skos:definition "Having a whirlpool design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water designs"@en .

aat:300445401 a skos:Concept ;
    skos:definition "Paper adornments (clothing, banners, cut-out strips). Part of the array of sacrificed victims in Postclassic Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amatlatquitl"@en .

aat:300445402 a skos:Concept ;
    skos:definition "Hairstyle of Nahua women composed of two horn-like tufts wrapped around the head in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axtlacuilli"@en .

aat:300445403 a skos:Concept ;
    skos:definition "A double egret-feather device inserted in the hair. Part of the array of several deities such as Tezcatlipoca or Huitzilopochtli and worn by warriors of central Mexico during the Postclassic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aztaxelli"@en .

aat:300445404 a skos:Concept ;
    skos:definition "Wooden or bamboo structures attached to the back with a carrying strap connected to a front band. Used to transport goods in Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cacaxtli"@en .

aat:300445405 a skos:Concept ;
    skos:definition "Originally, those who managed the property such as a steward, tax collector and domestic concerns of a large household; now, by extension, applied to those who manage matters concerning personal service, stores, and catering for a variety of organizations and commercial businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calpixqui"@en .

aat:300445406 a skos:Concept ;
    skos:definition "A polysemous term used for the community centre of each tlaxilacalli (neighbourhood) in Mexico-Tenochtitlan during the postclassic period. It was used for events related to the population's identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calpulco"@en .

aat:300445407 a skos:Concept ;
    skos:definition "A term referring to the social relationship of a group, rather than its territorial demarcation, in regard to its support of community life in each tlaxilacalli (neighborhood) of Mexico-Tenochtitlan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calpolli"@en .

aat:300445408 a skos:Concept ;
    skos:definition "A woven jadeite collar. An attribute of Quetzalcoatl in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalchiuhcozcapetlatl"@en .

aat:300445409 a skos:Concept ;
    skos:definition "Cords decorated with jade beads. An attribute of Xiuhteuctli in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalchiuhcuecuextli"@en .

aat:300445410 a skos:Concept ;
    skos:definition "To greet one another with tears. A ceremonial activity and greeting ritual, common in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chochoquiztlahpaloa"@en .

aat:300445411 a skos:Concept ;
    skos:definition "Snake masks made of turquoisean attribute of Xiuhteuctli. Also designates a snake mask pattern on capes in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaxayacatl"@en .

aat:300445412 a skos:Concept ;
    skos:definition "Snake-shaped ear ornaments of postclassic central Mexico. One of the attributes of Huitzilopochtli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coanacochtli"@en .

aat:300445413 a skos:Concept ;
    skos:definition "In postclassic central Mexico, conical headdresses commonly integrated into the Cuextecatl (Huastec) warrior costume. These were worn by the deity Quetzalcoatl. In colonial sources, it is described by the conquistadors as a miter. This term is also occasionally applied in colonial sources to the xiuhuitzolli, or turquoise diadem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copilli"@en .

aat:300445414 a skos:Concept ;
    skos:definition "Leather leg bands worn around the calf by high-ranking military personnel in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotzehuatl"@en .

aat:300445416 a skos:Concept ;
    skos:definition "A general term in Mexico for ornaments worn at the neck such as a necklace or collar. By extension, the term refers to jewels, round beads, and items of jewelry. It also includes the concept of preciousness as in the difrasismo \"in cozcatl, in quetzalli\" (the necklace, the quetzal's feather), a metaphor referring to children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cozcatl"@en .

aat:300445417 a skos:Concept ;
    skos:definition "Literally, \"scraped\" in Nahuatl. Refers to the hairstyle of warriors in postclassic central Mexico, described in sources as brave men, full of fury. Does not appear to be associated with any particular military order or hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuachic"@en .

aat:300445418 a skos:Concept ;
    skos:definition "Standard carried on the shoulders of Nahua warriors in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuachpamitl"@en .

aat:300445419 a skos:Concept ;
    skos:definition "Nahua tlahuiztli (insignia) in the form of large umbrella-shaped feathered structures worn on a back-frame. These were prestigious gifts presented to nobles made in a variety of colors, and was frequently topped with an effigy head of the deity Xolotl; hence its name, \"Xolotl-head.\" This insignia also represents the altepetl of Tepeticpac, Tlaxcala."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuaxolotl"@en .

aat:300445420 a skos:Concept ;
    skos:definition "Skirts comprised of a large, rectangular cloth wrapped around the lower body and tied at the waist, worn by Indigenous women of Mesoamerica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cueitl"@en .

aat:300445421 a skos:Concept ;
    skos:definition "Describes a complete entry-level Nahua warrior's costume consisting of a feathered encasing body suit with a conical copilli headpiece. It was the most commonly depicted type in tribute rolls of the Triple Alliance and was made in a variety of colors. Usually decorated with a double rectangular figure known as \"hawk scratches\" and paired with the crescent-shaped yacameztli nose plate as well as other attributes associated with the Huastecs. It was not actually included in tribute from Huastec region, but from twenty other culturally and geographically diverse provinces of the Triple Alliance instead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cuextecatl"@en .

aat:300445422 a skos:Concept ;
    skos:definition "Feathered encasing body suits awarded to a Mexica warrior after taking his second captive in battle. The feathered suit was worn over ichcahuipilli (quilted cotton body armor) along with other elements of the Cuextecatl (Huastec) warrior costume. They were made in a variety of different colors, and frequently decorated with a motif consisting of pairs of black rectangles known as \"hawk scratches\" that are also associated with the Huastec region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuextecatl tlahuiztli"@en .

aat:300445423 a skos:Concept ;
    skos:definition "A category of Nahua chimalli (shield) designs that were usually paired with the Cuextecatl warrior costume. At least five basic designs are identified, the most common feature either the yacameztli (crescent-shaped nose plate) or the double rectangle motif known as \"hawk scratches\" that are both associated with the Huastec region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuexyoh chimalli"@en .

aat:300445424 a skos:Concept ;
    skos:definition "Songs or chanted poetry in Nahua culture, frequently performed during public ritual ceremonies as well as more private rituals and those related to healing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuicatl"@en .

aat:300445426 a skos:Concept ;
    skos:definition "Literally, a \"blood banner.\" Generally surmounted by a flint in the iconography of postclassic central Mexico, this red painted banner was an attribute of warriors and the deity Huitzilopochtli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ezpamitl"@en .

aat:300445427 a skos:Concept ;
    skos:definition "Amaranth, (genus Amaranthus), genus of 60–70 species of flowering plants in the family Amaranthaceae, distributed nearly worldwide and species are useful as food crops and are grown both for their leaves and for their edible seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huauhtli"@en .

aat:300445428 a skos:Concept ;
    skos:definition "A Mesoamerican upright tubular drum made of wood with a skin membrane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huehuetl"@en .

aat:300445429 a skos:Concept ;
    skos:definition "Moving downward, typically rapidly and freely without control, from a higher to a lower level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falling"@en .

aat:300445430 a skos:Concept ;
    skos:definition "Gold rings with thorns described as having the shape of toes hanging from the serpentine nacochtli (earspools) of Huitzilopochtli in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huitznahuayotl"@en .

aat:300445431 a skos:Concept ;
    skos:definition "Hard, sharpened wooden sticks used for loosening the soil for planting and weeding in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huitzoctli"@en .

aat:300445432 a skos:Concept ;
    skos:definition "Seats in postclassic central Mexico, usually made of mats made of thick reeds. Used as a metaphor for the power and authority of the ruler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icpalli"@en .

aat:300445433 a skos:Concept ;
    skos:definition "Fast, labored breathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panting"@en .

aat:300445434 a skos:Concept ;
    skos:definition "In Mexico, any food taken on a journey, and otherwise given or brought to be consumed away from one's house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ihtacatl"@en .

aat:300445435 a skos:Concept ;
    skos:definition "Obsidian-bladed weapons of postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maccuahuitl"@en .

aat:300445436 a skos:Concept ;
    skos:definition "In postclassic central Mexico, marks left by human hands, by a deity or a supernatural entity, or a sign that is interpretable as an omen. It may also be used to designate an edifying example and in the colonial period, it was used in particular to translate the sign of the cross."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machiyotl"@en .

aat:300445437 a skos:Concept ;
    skos:definition "Armbands worn on the upper arm made with precious feathers of postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machoncotl"@en .

aat:300445438 a skos:Concept ;
    skos:definition "The act of designating a place, object or person by gesturing with a finger or another object. Used in the art of rhetoric to draw attention to the subject being discussed, it can highlight, in iconography, the action of a person speaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger pointing"@en .

aat:300445439 a skos:Concept ;
    skos:definition "A Nahua constellation also known by two other Nahuatl terms, Yohualteuctli and Yacahuiztli. Scholars have argued for various identifications with known asterisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mamalhuaztli"@en .

aat:300445440 a skos:Concept ;
    skos:definition "The action of two people joining hands in postclassic central Mexico. Used in the colonial period to refer to marriage between two Christian converts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manepanoa"@en .

aat:300445441 a skos:Concept ;
    skos:definition "Jewels worn on the wrist in postclassic central Mexico. May also refer to a jewel in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maquiztli"@en .

aat:300445442 a skos:Concept ;
    skos:definition "Bracelets made out of coyote hair or skin, with cut paper hanging from it of postclassic central Mexico. Compared in colonial sources to a Christian maniple. Worn by Huitzilopochtli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matacaxtli"@en .

aat:300445443 a skos:Concept ;
    skos:definition "Armbands worn on the upper arm, usually made of gold, but also made from a range of other materials (wood, leather, etc.) in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matemecatl"@en .

aat:300445444 a skos:Concept ;
    skos:definition "Soldiers armed with a harquebus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harquebusiers"@en .

aat:300445445 a skos:Concept ;
    skos:definition "Leather bracelets with a large gemstone on top. Worn by the Mexica tlahtoani (ruler)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matzopetztli"@en .

aat:300445447 a skos:Concept ;
    skos:definition "Offerings to a deity, for the purpose of propitiation or homage, usually something of value, material or immaterial; human, animal, or other living agent or object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacrifices"@en .

aat:300445448 a skos:Concept ;
    skos:definition "The process of the cessation of life, while still living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dying"@en .

aat:300445449 a skos:Concept ;
    skos:definition "Small, fine, sprays of precipitation that may seem to float in the air as a mist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drizzles"@en .

aat:300445450 a skos:Concept ;
    skos:definition "The stamens, units of the male reproductive tract, of maize."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maize stamens"@en .

aat:300445451 a skos:Concept ;
    skos:definition "Oratories or altars in the form of a small pyramid frequently erected at crossroads and in marketplaces throughout Mesoamerica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "momoztli"@en .

aat:300445452 a skos:Concept ;
    skos:definition "Sitting, settling or reclining on a mattress or a seat. In postclassic Mexico, both linguistic and gestural expression signify the taking of power, the accession to a function of a ruler or the installation of a deity on the occasion of the ritual feast that was dedicated to him."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlalia"@en .

aat:300445453 a skos:Concept ;
    skos:definition "Concealing one's body or face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hiding"@en .

aat:300445454 a skos:Concept ;
    skos:definition "Designates an animal double and an individual who has the power to take on a second appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nahualli"@en .

aat:300445455 a skos:Concept ;
    skos:definition "Fruit of the prickly pear cactus (Opuntia ficus-indica)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prickly pears"@en .

aat:300445456 a skos:Concept ;
    skos:definition "The hide of jaguar (Panthera onca)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jaguar skins"@en .

aat:300445457 a skos:Concept ;
    skos:definition "Monstrous men with two heads but only one body, literally, \"one who has two heads\" in Nahuatl. One of the omens predicting the arrival of the Spaniards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ontetzontecomeh"@en .

aat:300445458 a skos:Concept ;
    skos:definition "Lightweight shields made of vegetal matter used in many central Mexican cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "otlachimalli"@en .

aat:300445459 a skos:Concept ;
    skos:definition "High-ranking military title in Tenochtitlan. Warriors were associated with a particular hairstyle, snail shell fringed necklaces and distinctive grid-like face paint. Not to be confused with the ethnic designation referring to populations in the mountains north of the Valley of Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otomitl"@en .

aat:300445460 a skos:Concept ;
    skos:definition "A kind of cage made of reeds or leather. It can also refer to a wicker trunk. Literally \"palm house\" in Nahuatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petlacalli"@en .

aat:300445461 a skos:Concept ;
    skos:definition "A brilliant feather ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petlacotl"@en .

aat:300445462 a skos:Concept ;
    skos:definition "Hand woven palm mats. Of various dimensions, the mats are used to cover the floor, to sit, to kneel, to lie down. The bodies of the deceased can be wrapped in them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed mats"@en .

aat:300445463 a skos:Concept ;
    skos:definition "Bodies whose heads have been cut off, as a result of the neck being severed. Taking place after the enemy had been defeated, this practice was common on the battlefield in central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decapitated bodies"@en .

aat:300445464 a skos:Concept ;
    skos:definition "Quetzal-feather head fan or quetzal feather device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quetzalahpanehcayotl"@en .

aat:300445465 a skos:Concept ;
    skos:definition "An upper armband with quetzal feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quetzalmachoncotl"@en .

aat:300445466 a skos:Concept ;
    skos:definition "Panaches worn on the head, made up of many quetzal feathers. Literally \"quetzal-feather hair\" in Nahuatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quetzaltzontli"@en .

aat:300445467 a skos:Concept ;
    skos:definition "A prepared foodstuff made from maize dough wrapped in a corn or banana leaf and steamed. Often with meat, or vegetable filling, and sometimes cheese after dairy was introduced to the Americas. Can also be sweet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tamales"@en .

aat:300445468 a skos:Concept ;
    skos:definition "To catch something or someone or to take prisoner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capturing"@en .

aat:300445469 a skos:Concept ;
    skos:definition "The action of cutting open a person's chest, a ritual killing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eltehtequi"@en .

aat:300445470 a skos:Concept ;
    skos:definition "A shield design of postclassic central Mexico composed of five tufts of down in a quincunx pattern, literally a \"people-destroyer shield\" in Nahuatl. Part of the array of Huitzilopochtli and other deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tehuehuelli chimalli"@en .

aat:300445471 a skos:Concept ;
    skos:definition "A title of Nahua warriors who took a prisoner during the war and lead young teenagers in ritual activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telpochyahqui"@en .

aat:300445472 a skos:Concept ;
    skos:definition "A Nahua warrior's hairstyle where the hair is worn gathered up at the crown of the head and tied so that it stood upright, literally \"stone-pillar\" (shaped) in Nahuatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temillotl"@en .

aat:300445473 a skos:Concept ;
    skos:definition "Launching projectiles (arrows or darts) with an atlatl or bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing arrows"@en .

aat:300445477 a skos:Concept ;
    skos:definition "An adornment in the form of a hammered gold disk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlacomalli"@en .

aat:300445478 a skos:Concept ;
    skos:definition "Large open spaces where a significant number of ritual and collective activities took place in postclassic central Mexico. Generally translated as \"patio\" or \"courtyard,\" in Mexico-Tenochtitlan the term probably refers to the plaza located in front of the Templo Mayor (Great Pyramid) inside the main ceremonial enclosure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teoithualco"@en .

aat:300445479 a skos:Concept ;
    skos:definition "Nahua priests. Literally, \"one who guards the deities\" in Nahuatl. Part of a complex group of ministers of worship, each of whom engaged in very specific tasks such as rites of incense, or sacrifice as well as activities related to the maintenance and offering of fire. All generally wore long hair, anointed their bodies with black charcoal pigment, and performed frequent penances such as fasting and self-sacrifice. Each type of priest had a specific name, while in the colonial period, missionaries used the term teopixqui to designate the office of a Christian priest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teopixqui"@en .

aat:300445480 a skos:Concept ;
    skos:definition "Launching rock projectiles in combat, hunting, or protest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing stones"@en .

aat:300445481 a skos:Concept ;
    skos:definition "A type of house built with stone walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tepanchantli"@en .

aat:300445482 a skos:Concept ;
    skos:definition "Mesoamerican slit drums made from a hollowed-out log with an opening cut in the form of an \"H\" on the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teponaztli"@en .

aat:300445483 a skos:Concept ;
    skos:definition "Seats with reed and cane backs, used by the tlahtoani (ruler) of Nahua altepemeh (polities)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tepotzohicpalli"@en .

aat:300445484 a skos:Concept ;
    skos:definition "Projectiles tipped with metal points, as shot with a crossbow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tepozmitl"@en .

aat:300445485 a skos:Concept ;
    skos:definition "Those employed in the use of crossbows, either as a member of a military unit or as an activity related to combat or hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tepoztlahuitoloani"@en .

aat:300445486 a skos:Concept ;
    skos:definition "A Nahuatl term describing metal and objects made from metal, usually copper or iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tepoztli"@en .

aat:300445487 a skos:Concept ;
    skos:definition "Strips of white bark paper used as adornment. Liquid rubber was poured on them and they were used to decorate ixiptlah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetehuitl"@en .

aat:300445488 a skos:Concept ;
    skos:definition "Exercising physical force on a body or thing to move it by force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pushing"@en .

aat:300445489 a skos:Concept ;
    skos:definition "Signs or signals perceived as forewarning of a future event, usually ominous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetzahuitl"@en .

aat:300445490 a skos:Concept ;
    skos:definition "Something milled such as flour, usually referring to ground maize meal. Literally, \"ground thing\" in Nahuatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textli"@en .

aat:300445492 a skos:Concept ;
    skos:definition "Large, rectangular items of woven material frequently decorated with a variety of designs made across Mesoamerica. Worn over the shoulders like a cloak, they were also a primary unit of trade used in the payment of tribute during the pre-Hispanic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilmahtli"@en .

aat:300445493 a skos:Concept ;
    skos:definition "A military leader in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiyahcauh"@en .

aat:300445494 a skos:Concept ;
    skos:definition "The action of sprinkling a liquid (water or blood) on objects or people as part of a ritual in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atzelhuia"@en .

aat:300445495 a skos:Concept ;
    skos:definition "Monstrous men described in the Florentine Codex as the fifth omen that heralded the arrival of the Spaniards to the Mexica. Literally, \"man (as) poisonous (or thorny) plants\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlacanetzolli"@en .

aat:300445496 a skos:Concept ;
    skos:definition "To clean a floor or another surface by action of brushing with a broom. Typically a domestic activity, in several cultures, it is also a ritual activity associated with religious practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlachpanaliztli"@en .

aat:300445497 a skos:Concept ;
    skos:definition "A platform of sticks where Huitzilopochtli's ixiptlah, made of dough of amaranth seed, was seated in postclassic central Mexico. Used during the installation of the deity, it was made of huitzitzillacotl or \"hummingbird sticks\" and nacaztlacotl \"ear sticks,\" describing the shape of the wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlacopehpechtli"@en .

aat:300445498 a skos:Concept ;
    skos:definition "Nahuatl term referring to the upper part of the human body, including the upper limbs, head and torso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlactli"@en .

aat:300445499 a skos:Concept ;
    skos:definition "Nahua designs composed of repeating figures of skulls and bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlacuahcualloh"@en .

aat:300445500 a skos:Concept ;
    skos:definition "Painted buildings, referring to the painted design on a tecpan (palace) in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlahcuilolcalli"@en .

aat:300445501 a skos:Concept ;
    skos:definition "A general term referring to texts, paintings, and other artforms in Nahua culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlahcuilolli"@en .

aat:300445502 a skos:Concept ;
    skos:definition "To carry something with a strap placed on the forehead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carrying with a tumpline"@en .

aat:300445503 a skos:Concept ;
    skos:definition "Leveling something by flattening it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flattening"@en .

aat:300445504 a skos:Concept ;
    skos:definition "Nahua altars or earthen platform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlalmomoztli"@en .

aat:300445505 a skos:Concept ;
    skos:definition "A burden carried on the shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlamamalli"@en .

aat:300445507 a skos:Concept ;
    skos:definition "Playing a resonant musical instrument with breath under pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitza"@en .

aat:300445509 a skos:Concept ;
    skos:definition "Ceremonial packages in which a symbolic object is wrapped in skins or textiles that gives concrete expression to the presence of a deity in postclassic central Mexico. Literally, \"wrapped thing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlaquimilolli"@en .

aat:300445511 a skos:Concept ;
    skos:definition "Playing a musical instrument by striking it with the hand or a stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tzotzona"@en .

aat:300445512 a skos:Concept ;
    skos:definition "Thin rounds of cooked dough typically made from nixtamalized cornmeal pressed into shape by hand or with a press. Traditionaly cooked on a 'comal', it is a staple of the Mesoamerican diet. The term in Nahuatl means \"cooked thing\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlaxcalli"@en .

aat:300445513 a skos:Concept ;
    skos:definition "Action of offering incense as an act of devotion or cleansing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlenamaquiliztli"@en .

aat:300445515 a skos:Concept ;
    skos:definition "One who has blisters, bumps or pustules on their skin. Characteristic of some contagious diseases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomonqui"@en .

aat:300445516 a skos:Concept ;
    skos:definition "Deep cylindrical basket made of palm leaves in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tompiyahtli"@en .

aat:300445517 a skos:Concept ;
    skos:definition "Ceremonial staffs associated with power. They symbolized the taking of command or the transfer of an office from one person to another in Mexico in the postclassic period, and their use has continued through the colonial period into the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topilli"@en .

aat:300445519 a skos:Concept ;
    skos:definition "A term that refers to the monuments erected by the ancestors of the Mexica. In the sources, it is used to emphasize the process of making places of worship belonging to a mythical age, such as Teotihuacan or Tula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tzacualli"@en .

aat:300445520 a skos:Concept ;
    skos:definition "Literally, \"skirt of sapote.\" An attribute of Xipe Totec. It was probably made of quetzalhuitztli, small green feathers of the quetzal bird, rather than sapote leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tzapocueitl"@en .

aat:300445521 a skos:Concept ;
    skos:definition "Coats made from nettles in postclassic central Mexico. Dyed black, lined in five places with eagle down balls, it was part of the array of Huitzilopochtli. Literally in nahuatl, \"nettle mantle\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tzitzicaztilmatli"@en .

aat:300445523 a skos:Concept ;
    skos:definition "Nahua hairstyle of young warriors, meaning \"jar-shaped.\" Long hair was combed up onto one side of the upper part of the head and tied with a cotton band called tochacatl. It identified warriors who had captured their first prisoner in the postclassic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tzotzocolli"@en .

aat:300445524 a skos:Concept ;
    skos:definition "Sleeveless tunics that open at the chest and reach below the waist of postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xicolli"@en .

aat:300445526 a skos:Concept ;
    skos:definition "Golden necklaces worn as adornment of high ranking nobles in postclassic central Mexico and part of the dance array of Nahua tlahtohqueh (rulers). They could also be given as gifts or wagered in gambling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlacozcatl"@en .

aat:300445528 a skos:Concept ;
    skos:definition "Golden armbands worn on the upper arm by tlahtohqueh (rulers) in postclassic central Mexico and also given as gifts of prestige."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlamatemecatl"@en .

aat:300445530 a skos:Concept ;
    skos:definition "Golden bells. The term also refers to a leg band with many bells. Part of the array of several Nahua deities including Huixtohcihuatl, Tezcatlipoca, and Quetzalcoatl in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlacoyolli"@en .

aat:300445531 a skos:Concept ;
    skos:definition "A Nahua insignia formed from two or three short banners made of beaten gold fastened to tall, vertical poles with quetzal-feather tufts attached to a wooden frame and carried as a back device. Part of the war costume of postclassic Nahua tlahtohqueh (rulers) and pipiltin (nobles), it was manufactured by amantecah (featherworkers) and presented to particularly brave warriors in postclassic central Mexico. It is also part of the array of Payinal, an aspect of the deity Huitzilopochtli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlapanitl"@en .

aat:300445532 a skos:Concept ;
    skos:definition "Crescent-shaped nose ornaments made from gold. Postclassic Nahuas of central Mexico associated this symbol with the Huastec region and with deities of octli (pulque), an alcoholic beverage made from fermented agave sap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlayacametztli"@en .

aat:300445533 a skos:Concept ;
    skos:definition "Style or culture of the inhabitants of Chalco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chalcatl"@en .

aat:300445534 a skos:Concept ;
    skos:definition "Shield design of the Spartan army consisting of a large letter lambda (Λ) painted in the center of the shield. The lambda refers to the first letter of either the Lacedaemon ethno-political group or the geographic region of Laconia. The shields feature prominently in the description of the Peloponnesian War by Herodotus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lambdas"@en .

aat:300445536 a skos:Concept ;
    skos:definition "Elite Nahua military insignia in the form of a whole quetzal bird covered with feathers and supported by a frame worn on the back. An item sent to Tenochtitlan from the tributary province of Tochtepec, they were worn by tlahtohqueh (rulers) and pipiltin (nobles) in postclassic central Mexico. They were also used to identify Tlaxcalan military units of Ocotelolco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quetzaltototl"@en .

aat:300445537 a skos:Concept ;
    skos:definition "Paper-thin golden diadems of various shapes worn by elite Nahua men and women in postclassic central Mexico. They also adorned the mortuary bundles of tlahtohqueh (rulers). They are mentioned among the golden items melted down by the Spanish during the invasion of Tenochtitlan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlaixcuaamatl"@en .

aat:300445538 a skos:Concept ;
    skos:definition "Hair binders with two feather tassels worn by Nahua elites in the postclassic period. These were insignia of tlahtohqueh (rulers) and given as prestigious gifts to nobles and warriors in recognition of their military achievements. Several varieties were made with speicific feathers: cuauhtlalpiloni with eagle feathers, quetzallapiloni with quetzal feathers, zacuantlalpiloni with zacuan feathers, and xolotlalpiloni with yellow parrot feathers. The same term may also be used for decorations hanging from capes, sandals and other costume items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlalpiloni"@en .

aat:300445539 a skos:Concept ;
    skos:definition "Inhabitants of Xochimilco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xochimilcas"@en .

aat:300445540 a skos:Concept ;
    skos:definition "Golden leg bands worn on the calf by Nahua tlahtohqueh (rulers) in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teocuitlacotzehuatl"@en .

aat:300445542 a skos:Concept ;
    skos:definition "Quetzal feather banners of postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quetzalpanitl"@en .

aat:300445543 a skos:Concept ;
    skos:definition "Architectural term that defines the stone edges of stairways on the pyramidal bases of temples of central Mexico. They were sometimes decorated with reliefs or capped with a serpent head in the postclassic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alfardas"@en .

aat:300445544 a skos:Concept ;
    skos:definition "Bed or mattress, used to sleep. This term also designates the base of a feathered work, in which other feathers are placed. Finally, it refers to any base layer used to install the ixiptlah of a deity, the central figure of a ritual in postclassic central Mexico. This foundation could be composed of various materials, including sacrificial persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pehpechtli"@en .

aat:300445545 a skos:Concept ;
    skos:definition "A very humble hut or dwelling generally constructed from poles with a thatched roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xahcalli"@en .

aat:300445546 a skos:Concept ;
    skos:definition "Ahtlatl of turquoise (in mosaic or color) in posclassic central Mexico. Also known as a xiuhcoatl. This device used to amplify the propulsive force of spears or darts, in hunting as in warfare, is associated mainly with Xiuhteuctli, but also with Huitzilopochtli and Tezcatlipoca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xiuhahtlatl"@en .

aat:300445547 a skos:Concept ;
    skos:definition "The military equipment of the Mexica soldiers in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yaotlatquitl"@en .

aat:300445548 a skos:Concept ;
    skos:definition "Rope made of zacate (grass) in central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zacamecatl"@en .

aat:300445550 a skos:Concept ;
    skos:definition "Light armor made from quilted cotton cloth in postclassic central Mexico. Typically a type of sleeveless vest worn on the upper body that was particularly effective protection from arrow strikes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ichcahuipilli"@en .

aat:300445551 a skos:Concept ;
    skos:definition "Nahua chimalli (shield) design composed of a large number of feather-down balls in postclassic central Mexico. Distinguished from tehuehuelli chimalli which featured only five of these down-balls in a quincunx pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ihhuiteteyoh chimalli"@en .

aat:300445553 a skos:Concept ;
    skos:definition "A thin or netted style of cape worn by Nahua men in the postclassic period that was typically made from maguey fibers. Also made from cotton or with designs embroidered or appliqued with precious materials such as quetzal feathers or turquoise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ayatl"@en .

aat:300445554 a skos:Concept ;
    skos:definition "A Postclassic Nahua garment design, literally of \"eyes on the edge.\" It was composed with white circles on a black background in a band at the hem. As a prestigious design added to capes, it was typically worn by tlahtohqueh (rulers) and pipiltin (high ranking noble men), and occasionally appeared on women's clothing. The design may also be correlated with the deity Tezcatlipoca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenixyoh"@en .

aat:300445555 a skos:Concept ;
    skos:definition "A thin or netted turquoise cape worn by Mexica tlahtohqueh (rulers) in the postclassic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teoxiuhayatl"@en .

aat:300445556 a skos:Concept ;
    skos:definition "An open star cluster visible to the naked eye and prominent in the sky during the winter in the Northern Hemisphere. Known to the ancient Greeks as the Pleiades, the star cluster is identified as a constellation by many cultures around the globe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Messier 45"@en .

aat:300445557 a skos:Concept ;
    skos:definition "A labret with a hanging ornament in the shape of the broad leaf of a type of aquatic plant. Worn by Otomí in postclassic central Mexico, while Nahua tlahtohqueh (rulers) wore a golden version for dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apatlactempilolli"@en .

aat:300445558 a skos:Concept ;
    skos:definition "General term for an ailment. Although often translated as smallpox, it can be used to refer to any widespread plague or pestilence. It is often the designation for the infectious illnessess that spread in Indigenous communities in Mesoamerica from contact with Europeans in the sixteenth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocoliztli"@en .

aat:300445559 a skos:Concept ;
    skos:definition "Small fluffy feathers close to the body of an adult eagle that have a fine texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuauhtlachcayotl"@en .

aat:300445561 a skos:Concept ;
    skos:definition "The various insignia of a Nahua tlahtoani (ruler) in postclassic central Mexico, including the xiuhhuitzolli (turquoise mosaic diadem) and the xiuhtilmahtli (turquoise cape), usually tenixyoh (\"with eyes on the edge\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlahtohcatlatquitl"@en .

aat:300445562 a skos:Concept ;
    skos:definition "Lesions on the skin such as pustules or blisters. It is a term that is often translated as smallpox because it was a term used by Nahuatl writers to describe certain epidemic diseases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xittomonalli"@en .

aat:300445563 a skos:Concept ;
    skos:definition "Nahua \"toe\" or \"claw\" military insignia rendered as an elongated droplet-like shape and topped by a feather crest, usually of quetzal feathers. Worn on a back frame, it was manufactured in yellow, green, and red varieties and paired with a feathered bodysuits of the same color. It was given to high-ranking warriors and as a tribute item in the postclassic period across central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xopilli"@en .

aat:300445564 a skos:Concept ;
    skos:definition "In postclassic central Mexico, a Mexica military commander whose role is both to start the war and to lead the fight. Associated with the Tlacateccatl warrior and more generally with Huitzilopochtli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yaotlahtoani"@en .

aat:300445565 a skos:Concept ;
    skos:definition "Denotes a rash or any pox-like outbreak on the skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zahuatl"@en .

aat:300445566 a skos:Concept ;
    skos:definition "A design consisting of star motifs in Nahua material culture or tlahcuilolli. Literally meaning \"full of stars,\" the designs may be composed of various types of stylized stars. Representations of stars in postclassic Nahua art most commonly appear as a pair of concentric cirlces with the outer ring divided into red and whilte halves, an image also understood to represent eyes (ixtli) and scrying mirrors (tezcatl)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cicitlalloh"@en .

aat:300445567 a skos:Concept ;
    skos:definition "General term for Nahua ornaments worn on the ear. The term refers to a wide variety of designs made from many materials, including simple earplugs and larger earflares to more complex pendant ornaments in the form of vegetal or animal elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nacochtli"@en .

aat:300445568 a skos:Concept ;
    skos:definition "A Nahua military insignia of postclassic central Mexico formed from a compressed fan of quetzal feathers worn as a back device. It was part of dance and war costumes of rulers, and paired with the xicalcoliuhqui (stepped-fret) design chimalli (shield). This insignia also designated troops from the altepetl of Quiyahuiztlan in Tlaxcala."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quetzalpatzactli"@en .

aat:300445569 a skos:Concept ;
    skos:definition "Hanging nose ornament in postclassic central Mexico. It could be worked in gold, decorated with stones or painted. Usually worn by slaves destined for sacrifice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yacapilolli"@en .

aat:300445571 a skos:Concept ;
    skos:definition "Nahua hairstyle of postclassic central Mexico in which some or all of the hair on the sides of the scalp is shaved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuachichictli"@en .

aat:300445572 a skos:Concept ;
    skos:definition "Gastropod shell used as a pendant worn by Otomi class warriors in postclassic central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chipolin"@en .

aat:300445573 a skos:Concept ;
    skos:definition "Style and culture of the inhabitants of Cuitlahuac."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cuitlahuacatl"@en .

aat:300445574 a skos:Concept ;
    skos:definition "Style and culture of inhabitants of Itztapalapan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Itztapalapanecatl"@en .

aat:300445575 a skos:Concept ;
    skos:definition "Style or culture of the inhabitants of Tenochtitlan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tenochcatl"@en .

aat:300445576 a skos:Concept ;
    skos:definition "Nahua warrior recognizable by his hairstyle characterized by a tonsure, associated with the Otomi rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlaotonxintli"@en .

aat:300445577 a skos:Concept ;
    skos:definition "Inhabitants of Xochimilco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xochimilcatl"@en .

aat:300445578 a skos:Concept ;
    skos:definition "Weather condition consisting of water in the form of particles floating in the atmosphere at or near the surface of the earth and approaching the form of drizzle. Distinguished from \"fog\" which consists of water vapor and \"haze\" which may also consist of particles other than water such as smoke or smog."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neblinas"@en .

aat:300445580 a skos:Concept ;
    skos:definition "An abundant motif in the art of the central highlands of Mexico since Teotihuacan period, generally consisting of a series of rings formed by two simple concentric circles. In pre-Hispanic palatial architecture, these rings are found in series in the upper zone or frieze of the tecpan façade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalchihuites"@en .

aat:300445582 a skos:Concept ;
    skos:definition "A body-encasing costume in the form of a jaguar with a quetzal-feather crest on the head. Worn by prestigious Mexica warriors of postclassic central Mexico. They are depicted in both Native and colonial documents in a variety of colors, indicating that they were likely constructed out of feathers as well as actual jaguar pelts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ocelotl tlahuiztli"@en .

aat:300445583 a skos:Concept ;
    skos:definition "A staff with a heart affixed to the top. Part of the array of the Nahua deities Chalmecacihuatl, Xochipilli, Ixtlilton, Macuilxochitl and the other Macuiltonalehqueh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yollohtopilli"@en .

aat:300445586 a skos:Concept ;
    skos:definition "Style or culture of an inhabitant of Tepotzohtlan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tepotzohtecatl"@en .

aat:300445587 a skos:Concept ;
    skos:definition "Style and culture of the inhabitants of Tlatelolco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tlatelolcatl"@en .

aat:300445627 a skos:Concept ;
    skos:definition "Centers offering connections for transportation lines, could include local and express bus lines, light rail, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transit centers"@en .

aat:300445628 a skos:Concept ;
    skos:definition "Short sections of road that allow vehicles to enter or exit a controlled-access roadway ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "access ramps"@en .

aat:300445629 a skos:Concept ;
    skos:definition "Structures offering light protection from sun and other weather for playing sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports shelters"@en .

aat:300445631 a skos:Concept ;
    skos:definition "Describes participants at The Bauhaus, founded in 1919 in the city of Weimar by German architect Walter Gropius (1883–1969). The term represents a kind of Bauhaus citizenship inclusive of faculty and students and reflects the idea of egalitarianism implicit in the institution. The term is not generally extended to those associated with the New Bauhaus in Chicago, with the exception of those associated with the original Bauhaus in Weimar, and later Dessau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bauhäusler"@en .

aat:300445632 a skos:Concept ;
    skos:definition "Painters who use their mouths to manipulate brushes or other tools to make paintings, due to paralysis or other loss of the use of limbs or hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouth painters"@en .

aat:300445633 a skos:Concept ;
    skos:definition "Painters who use their feet to manipulate brushes or other tools to make paintings, due to paralysis or other loss of conventional use of limbs or hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot painters"@en .

aat:300445634 a skos:Concept ;
    skos:definition "Heads of the temple in Sōkan, the Japanese system of ranking for Buddhist clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zasus"@en .

aat:300445635 a skos:Concept ;
    skos:definition "In Japanese domestic or nobles' architecture, a sitting or reception room or area having a raised floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jodan-no-ma"@en .

aat:300445636 a skos:Concept ;
    skos:definition "In Japanese samurai or domestic architecture, a sitting room. If it features a raised floor, prefer 'jodan-no-ma.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zashiki"@en .

aat:300445637 a skos:Concept ;
    skos:definition "Persons skilled in the creation of technical drawings who are preeminient in their field and teach or supervise others in the field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master drafters"@en .

aat:300445638 a skos:Concept ;
    skos:definition "Photographs that document the installation of an exhibition in a museum, gallery, or other venue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition installation photographs"@en .

aat:300445639 a skos:Concept ;
    skos:definition "The act or activity of making photographic images that document the installation of an exhibition in a museum, gallery, or other venue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition installation photography"@en .

aat:300445640 a skos:Concept ;
    skos:definition "An individual's concept of self as male, female, a combination of both, or neither. One's gender identity can be the same or different from a sex assigned at birth, and may be expressed by social or cultural distinctions and differences, rather than biological ones. For the concept of physiological traits that distinguish the males and females of a species, use \"sex.\" For the sum of an individual's sexual emotions, ideas, and behavior, use \"sexuality.\" For roles in society based on biology, use \"sex roles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender identity"@en .

aat:300445641 a skos:Concept ;
    skos:definition "Separate sections of large homes that contain the private rooms of the family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domestic wings"@en .

aat:300445642 a skos:Concept ;
    skos:definition "General term for rooms or other accomodations intended to provide basic conveniences for day-to-day life, such as sleeping, eating, and relaxing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living quarters"@en .

aat:300445643 a skos:Concept ;
    skos:definition "Rooms or other areas reserved for the private living activities of the family, particularly in large houses or other buildings in which many rooms are devoted to other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private family quarters"@en .

aat:300445644 a skos:Concept ;
    skos:definition "Friezes, particularly on architecture, that contain inscriptions, usually as both a didactic and an ornamental element. Examples are found on Islamic mosques and tombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epigraphic friezes"@en .

aat:300445645 a skos:Concept ;
    skos:definition "Businesses that sell home furnishings, carpets, draperies, or a variety of other goods to be used in the home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home goods stores"@en .

aat:300445646 a skos:Concept ;
    skos:definition "Buildings housing businesses that sell furniture, which is movable objects or equipment for sitting, reclining, or storage, such as chairs, beds, tables, and cabinets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture stores"@en .

aat:300445647 a skos:Concept ;
    skos:definition "Buildings housing businesses that sell home furnishings, carpets, draperies, or a variety of other goods to be used in the home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home goods stores"@en .

aat:300445648 a skos:Concept ;
    skos:definition "In Britain, the class of schools founded in the 16th century or earlier for the teaching of Latin. Subsequently, they became secondary schools of various degrees of importance, sometimes ranking little below the level of the 'public schools.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grammar schools"@en .

aat:300445649 a skos:Concept ;
    skos:definition "In Britain, buildings housing the class of schools founded in the 16th century or earlier for the teaching of Latin, later secondary schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grammar schools"@en .

aat:300445650 a skos:Concept ;
    skos:definition "Temples or shrines built over holy wells, places of pilgrimage and ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "well temples"@en .

aat:300445651 a skos:Concept ;
    skos:definition "Style of American architecture inspired by built works of the Italian Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian Renaissance Revival"@en .

aat:300445652 a skos:Concept ;
    skos:definition "Farms devoted to the rearing, keeping, or selling of chickens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicken farms"@en .

aat:300445653 a skos:Concept ;
    skos:definition "Traditional Japanese craft and process to repair ceramics using urushi lacquer and gold or silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kintsugi"@en .

aat:300445654 a skos:Concept ;
    skos:definition "Buildings housing churches that are under direct jurisdiction of the monarch rather than the ecclesiastical hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal churches"@en .

aat:300445655 a skos:Concept ;
    skos:definition "Those design architecture, but have not completed the requirements for architectural registration, including having a valid license."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unregistered architects"@en .

aat:300445656 a skos:Concept ;
    skos:definition "Those who envision and map out how exhibitons of artwork or other material culture appear in museums or other venues, coordinating with curators and other museum professionals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition designers"@en .

aat:300445657 a skos:Concept ;
    skos:definition "Generic term for a variety of languages, dialects and language groups, most of which are found in the lower Himalayas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pahari"@en .

aat:300445658 a skos:Concept ;
    skos:definition "The culture and style of a group of people of mixed ethnic heritage who speak Malayalam, in the Indian state of Karala and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malayali"@en .

aat:300445659 a skos:Concept ;
    skos:definition "General term for a group of vernacular Middle Indo-Aryan languages used in India from around the 3rd century BCE to the 8th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prakrit"@en .

aat:300445660 a skos:Concept ;
    skos:definition "Transliterated version of words in any of several vernacular Middle Indo-Aryan languages used in India from around the 3rd century BCE to the 8th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prakrit (transliterated)"@en .

aat:300445661 a skos:Concept ;
    skos:definition "Outdoor areas set aside for caskets or urns containing ashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gardens of rest"@en .

aat:300445662 a skos:Concept ;
    skos:definition "Gardens commemorating the dead, especially those killed in wars or those who have been cremated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gardens of remembrance"@en .

aat:300445663 a skos:Concept ;
    skos:definition "Gardens designed as quiet spaces where users can pray, often having inspirational sculptures or inscriptions; altars or other accessories may be included, at which services could be conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer gardens"@en .

aat:300445664 a skos:Concept ;
    skos:definition "Areas in buildings where gardening may take place, having beds or pots for maintaining green plants, such as vegetables and decorative or blooming plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor gardens"@en .

aat:300445665 a skos:Concept ;
    skos:definition "Gardens designed as quiet spaces for meditation, often having landscaping that includes paths, water features, and isolated spaces conducive to meditation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meditation gardens"@en .

aat:300445666 a skos:Concept ;
    skos:definition "Sections of new construction attached to an existing built work, with the function of adding an extension or increasing the floor area or height of an existing building beyond the original building envelope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "additions"@en .

aat:300445667 a skos:Concept ;
    skos:definition "MPEG-4 is an evolving coding standard for defining the compression of audio-visual objects, designed for use in broadcast, interactive and conversational environments. MPEG-4 absorbs many of the features of MPEG-1 and MPEG-2. MPEG-4 incorporates a variety of compression ratios that exchange picture quality for bandwidth and storage size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MPEG-4"@en .

aat:300445668 a skos:Concept ;
    skos:definition "Names adopted by monarchs, popes, or other rulers during their reigns and by which they are subsequently referenced in history. Since ancient times, some monarchs have chosen to use a different name from their original name when they accede to the monarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regnal names"@en .

aat:300445671 a skos:Concept ;
    skos:definition "Building complexes focused on one or more tombs, but also containing other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomb complexes"@en .

aat:300445672 a skos:Concept ;
    skos:definition "Monastic order founded in 1313, abiding by the Rule of Saint Benedict."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Olivetan"@en .

aat:300445673 a skos:Concept ;
    skos:definition "Particularly known in English architecture from Tudor period onwards; pavilion-like buildings for eating and other entertaining, often accessible through the gardens from the main residence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banqueting houses"@en .

aat:300445674 a skos:Concept ;
    skos:definition "In England, Wales, Ireland, Scandinavia, parts of the United States, and other places, subdivisions of a county or shire, each having its own court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hundreds"@en .

aat:300445682 a skos:Concept ;
    skos:definition "Caojia baiyan is found in Qing dynasty documents such as the Gongcheng zuofa 工程做法, Yuanmingyuan neigong zeli 圓明園內工則例, and Yangzhou huafang lu 揚州畫舫錄 . Literally meaning a “rough-frame verification assembly,” it refers to a trial assembly of the bracket-set construction in Qing dynasty official-style architecture. Once the trial assembly is complete and determined to be structurally sound, the bracket-set is dismantled for refinement, after which it is reassembled as the final building frame. In some texts, caojia baiyan could be abbreviated as caoyan 草驗. Caojia baiyan is found in Qing dynasty documents such as the Gongcheng zuofa (Gongbu 1773, 62.23b), Yuanmingyuan neigong zeli (Guan 1644-1911, 24), and Yangzhou huafang lu (Li 1795,17.7b). Literally meaning a \"rough-frame verification assembly,\" it refers to a trial assembly of the bracket-set construction in Qing dynasty official-style architecture (Pan and He 2005, 105). Once the trial assembly is complete and determined to be structurally sound, the bracket-set is dismantled for refinement, after which it is reassembled as the final building frame. In some texts, caojia baiyan could be abbreviated as caoyan (Ma 2003, 271).1 Caojia baiyan is found in Qing dynasty documents such as the Gongcheng zuofa Gongbu Yuanmingyuan neigong zeli Guan and Yangzhou huafang lu . Literally meaning a rough-frame verification assembly, it refers to a trial assembly of the bracket-set construction in Qing dynasty official-style architecture Pan and He Once the trial assembly is complete and determined to be structurally sound, the bracket-set is dismantled for refinement, after which it is reassembled as the final building frame. In some texts, caojia baiyan could be abbreviated as caoyan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cǎojià bǎiyàn"@en .

aat:300445684 a skos:Concept ;
    skos:definition "Courtyards or similary uncovered exterior spaces having a fountain as the focal point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fountain courts"@en .

aat:300445685 a skos:Concept ;
    skos:definition "Freestone from a quarry in Haslebury in Wiltshire, England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haslebury stone"@en .

aat:300445686 a skos:Concept ;
    skos:definition "Large gateway structures; typically, having a prominent entryway, separating one special area from external areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumental gates"@en .

aat:300445687 a skos:Concept ;
    skos:definition "Club facilities, particularly in universities, that function as dining halls and social centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eating clubs"@en .

aat:300445688 a skos:Concept ;
    skos:definition "Units indicating one-thousandth of a second (usually a second of time, less often a second of arc)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milliseconds"@en .

aat:300445689 a skos:Concept ;
    skos:definition "Standards to label individual frames of video or film with a timecode."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "SMPTE timecode"@en .

aat:300445691 a skos:Concept ;
    skos:definition "Regions within which a common standard time is used; in the modern era, refers to 24 divisions of the earth's surface, with boundaries which are fixed by international agreement and which coincide for the most part with lines of longitude spaced 15 degrees apart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time zones"@en .

aat:300445692 a skos:Concept ;
    skos:definition "The primary standard for time used by most of the world to regulates clocks and time. It is within about 1 second of mean solar time at 0 degree longitude; it is not adjusted for daylight saving time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coordinated Universal Time standard"@en .

aat:300445693 a skos:Concept ;
    skos:definition "Religious order of nuns, established under the rule of St. Augustine in 1572 from a company founded at Brescia in 1537, for the teaching of girls, nursing of the sick, and the sanctification of the lives of its members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursuline"@en .

aat:300445694 a skos:Concept ;
    skos:definition "Residential structures for an emperor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial residences"@en .

aat:300445695 a skos:Concept ;
    skos:definition "Refers to anyone who performs the transitory role of acquiring property or title through payment in any form. Distinct from the same activity performed in a professional or occupational capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buyers"@en .

aat:300445696 a skos:Concept ;
    skos:definition "Anyone who exchanges goods or services for payment of any kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sellers"@en .

aat:300445697 a skos:Concept ;
    skos:definition "Text that appears on the title page of documents, usually books or scholarly papers, inclusive of author, title, publication, or other information such as indications of patronage or mottoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "title page text"@en .

aat:300445698 a skos:Concept ;
    skos:definition "The action of going by, declining, or forgoing an opportunity or offer, such as the sale of an object or lot in an auction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passing"@en .

aat:300446173 a skos:Concept ;
    skos:definition "In Indian architecture, altar stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balikkals"@en .

aat:300446175 a skos:Concept ;
    skos:definition "In Indian architecture, a \"convolution of caterpillar\"; convolving/undulating pediment-border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illikāvalaṇa"@en .

aat:300446176 a skos:Concept ;
    skos:definition "In Indian architecture, a house of a divinity, or shrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dēvagṛha"@en .

aat:300446177 a skos:Concept ;
    skos:definition "In Indian architecture, \"kumbha at the base-root\"; an inverted cyma recta; lowest pīṭha moulding; padma (South Indian)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jāḍyakumbha"@en .

aat:300446178 a skos:Concept ;
    skos:definition "In Indian architecture, an element representing the \"liṅga exposed to sky\"; may be placed above the crowning āmalaka/āmalasāraka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ākāśaliṅga"@en .

aat:300446180 a skos:Concept ;
    skos:definition "In Indian architecture a \"pillar of respect\"; detached pillar erected before, near or in front of a Digambara Jaina temple; ceremonial pillar in a Jaina temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mānastambha"@en .

aat:300446181 a skos:Concept ;
    skos:definition "In Indian art and architecture, a \"royal ease\" sitting posture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahārājalīlāsana"@en .

aat:300446182 a skos:Concept ;
    skos:definition "A \"serrated leaf\" set within bangle-like design as decorative motif in Indian art and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaṅkaṇapatra"@en .

aat:300446183 a skos:Concept ;
    skos:definition "In Indian architecture, a \"thrown\"; projected cusped course in ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kṣipta"@en .

aat:300446184 a skos:Concept ;
    skos:definition "In Indian architecture, a figure of a female dancer showing abhinaya-expressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nāyikā"@en .

aat:300446185 a skos:Concept ;
    skos:definition "In Indian architecture, (inverted) dish-shaped maṇḍi-type; a banner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pāli"@en .

aat:300446186 a skos:Concept ;
    skos:definition "In Indian architecture, an (inverted) dish-shaped maṇḍi-type; banner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pālyākāra"@en .

aat:300446187 a skos:Concept ;
    skos:definition "In Indian architecture, an (inverted) dish-shaped maṇḍi-type; banner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pālyākāra maṇḍi"@en .

aat:300446188 a skos:Concept ;
    skos:definition "South Indian temple type; octagonal śikhara, \"southern\" temple-mode, mode of vimāna in southern style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Drāviḍa"@en .

aat:300446192 a skos:Concept ;
    skos:definition "In Indian architecture, a 16-sided column-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dvivajraka"@en .

aat:300446193 a skos:Concept ;
    skos:definition "Groups of 64 yōginī figures, that from around the 10th century, appear in open-air temples dedicated to them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "causaṭh Yōginis"@en .

aat:300446195 a skos:Concept ;
    skos:definition "In Indian architecture, a class of ceilings decorated with grouped pendentives; ceiling type bearing luma-pendentives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padmanābha"@en .

aat:300446196 a skos:Concept ;
    skos:definition "In Indian art or architecture, a conical crown formed by bejewelled rings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karaṇḍa"@en .

aat:300446197 a skos:Concept ;
    skos:definition "In Indian architecture, a decorative motif showing bell with a hanging chain dangling from a grāsa-mask."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grāsakīṅkaṇikā"@en .

aat:300446198 a skos:Concept ;
    skos:definition "In Indian architecture, a frieze of gagārakas; band bearing a hanging series of scout-badge shaped motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gagārapaṭṭi"@en .

aat:300446199 a skos:Concept ;
    skos:definition "In Indian architecture, a a Jaina temple with three sanctuaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trivihāra"@en .

aat:300446200 a skos:Concept ;
    skos:definition "A jāla-screen with floral motif inserted in the orifices as well as carved at the junctions of the uprights and cross-bars flower-segment (jālī design), jāla type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puṣpakaṇṭha"@en .

aat:300446201 a skos:Concept ;
    skos:definition "A motif showing a lion tearing off the dorsal part of an elephant; gajākrānta-siṁha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kari-kumbha-vidārī"@en .

aat:300446202 a skos:Concept ;
    skos:definition "A perforated screen made up of intertwining cobras (nāgas and nāginīs) in half human form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nāga-jāla"@en .

aat:300446204 a skos:Concept ;
    skos:definition "In Indian architecture, a square chamber on the upper storey; square miniature shrine; roofed chamber on a house-terrace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kūṭāgāra"@en .

aat:300446205 a skos:Concept ;
    skos:definition "In Indian architecture, a temple-type resembling a terraced stūpa (discussed in Viṣṇudharmōttarapurāṇa)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ēḍūka"@en .

aat:300446206 a skos:Concept ;
    skos:definition "In Indian architecture, a type of adhiṣṭhāna with prati-kaṇṭha moulding at its upper end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pratibandha"@en .

aat:300446208 a skos:Concept ;
    skos:definition "In Indian architecture, a type of grille metaphorically showing \"elephant-eyes in linkage.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hastinētra-jāla"@en .

aat:300446209 a skos:Concept ;
    skos:definition "In Indian architecture, a type of prāsāda having three sanctums trinity: usually Brahmā, Śiva, Viṣṇu but Sūrya sometimes replaces Brahmā."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripuruṣa"@en .

aat:300446210 a skos:Concept ;
    skos:definition "In Indian architecture, a vēdībhadra upapīṭha having six mouldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saḍaṅga-vēdībhadra"@en .

aat:300446211 a skos:Concept ;
    skos:definition "In Indian architecture, an abacus (pillar-part supporting pōtikā-capital/pillar-part above the capital)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phalaka"@en .

aat:300446212 a skos:Concept ;
    skos:definition "In Indian architecture, an acute-angled and pointed rathaka-buttress; pointed half-diamond shaped ratha in ground plan as well as in elevation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pallavī"@en .

