    skos:inScheme lev:aat ;
    skos:prefLabel "bhāraputra"@en .

aat:300446257 a skos:Concept ;
    skos:definition "In Indian architecture, an atlas; atlantid figure; bhāraputraka; bhāravāhaka at the pillar-bracket; weight-bearing atlantid figure at the pōtikā-bracket (or stambhaśīrṣa-bracket) of a pillar."@en ;
