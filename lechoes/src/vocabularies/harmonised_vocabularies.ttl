mimo:3188 a skos:Concept ;
    skos:altLabel "Fasil kemençe"@zh,
        "Kemenche"@zh,
        "Masinko"@zh,
        "Masinqo"@zh,
        "Massaneqo"@zh,
        "Pondyaki lyra"@zh ;
    skos:definition "The Masenqo (Amharic: ማሲንቆ; Tigrinya: ጭራ-ዋጣ (ዋጣ) is a single-stringed bowed lute commonly found in the musical traditions of Ethiopia. As with the krar, this instrument is used by Ethiopian minstrels called azmaris (\"singer\" in Amharic). Although it functions in a purely accompaniment capacity in songs, the masenqo requires considerable virtuosity, as azmaris accompany themselves while singing."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Masenqo"@ca,
        "Masenqo"@de,
        "Masenqo"@en,
        "Masenqo"@es,
